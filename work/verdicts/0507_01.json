   "ko": "모르겠지만――"
  },
  {
   "id": 6489,
   "key": "D0507.txt:491",
   "ko": "「위험해! 엘자!」"
  },
  {
   "id": 6490,
   "key": "D0507.txt:498",
   "ko": "="
  },
  {
   "id": 6491,
   "key": "D0507.txt:521",
   "ko": "회전하는 언월도가 거울이 되어 빔을 튕겨냈다!"
  },
  {
   "id": 6492,
   "key": "D0507.txt:522",
   "ko": "반사된 빔이 이번엔 거꾸로 엘자에게 다가온다!"
  },
  {
   "id": 6493,
   "key": "D0507.txt:525",
   "ko": "젠장… 그런 속셈이었나! ――늦지 않을까!?"
  },
  {
   "id": 6494,
   "key": "D0507.txt:542",
   "ko": "="
  },
  {
   "id": 6495,
   "key": "D0507.txt:543",
   "ko": "빔의 열기가 지지직 살갗을 태우는 게 느껴졌다｡"
  },
  {
   "id": 6496,
   "key": "D0507.txt:560",
   "ko": "안도할 틈도 없이 공기를 가르는 언월도 소리가 바로 코앞까지 다가왔다｡ 「놓는다!」"
  },
  {
   "id": 6497,
   "key": "D0507.txt:571",
   "ko": "「알겠로봇!」"
  },
  {
   "id": 6498,
   "key": "D0507.txt:581",
   "ko": "서로 튕겨 나가듯 갈라진다｡"
  },
  {
   "id": 6499,
   "key": "D0507.txt:582",
   "ko": "두 사람 사이를 언월도가 지나갔다｡ 엘자가 한쪽 무릎을 꿇고 착지한다｡"
  },
  {
   "id": 6500,
   "key": "D0507.txt:599",
   "ko": "나도 마기우스 윙을 펄럭이며 지면에 내려앉았다｡"
  },
  {
   "id": 6501,
   "key": "D0507.txt:605",
   "ko": "「또 구해 준 게냐… 무슨 생각이냐?」"
  },
  {
   "id": 6502,
   "key": "D0507.txt:611",
   "ko": "「아니､ 그래도 못 본 척 죽게 두면 뒷맛이 나쁘잖아」"
  },
  {
   "id": 6503,
   "key": "D0507.txt:620",
   "ko": "「살았로봇､ 마이 달링」"
  },
  {
   "id": 6504,
   "key": "D0507.txt:628",
   "ko": "「단숨에 격상이냐!?」"
  },
  {
   "id": 6505,
   "key": "D0507.txt:633",
   "ko": "「수렁이로구나」"
  },
  {
   "id": 6506,
   "key": "D0507.txt:654",
   "ko": "「젠장… 벌써 돌아왔잖아! 이쪽이야말로 수렁이라고!」"
  },
  {
   "id": 6507,
   "key": "D0507.txt:671",
   "ko": "황급히 궤도에서 몸을 날려 물러난다｡"
  },
  {
   "id": 6508,
   "key": "D0507.txt:672",
   "ko": "바로 옆을 언월도가 지나간다――그럴 줄 알았다｡"
  },
  {
   "id": 6509,
   "key": "D0507.txt:687",
   "ko": "언월도는 회전한 채로 눈앞에서 멈췄다｡"
  },
  {
   "id": 6510,
   "key": "D0507.txt:690",
   "ko": "…뭐지､ 이건? 뭔가가 지금까지와 다르다｡"
  },
  {
   "id": 6511,
   "key": "D0507.txt:693",
   "ko": "이건―― 「아차! 역회전이냐!」"
  },
  {
   "id": 6512,
   "key": "D0507.txt:716",
   "ko": "역회전으로 억지로 궤도를 바꿨잖아!"
  },
  {
   "id": 6513,
   "key": "D0507.txt:717",
   "ko": "피할 수 있는 거리가 아니다｡"
  },
  {
   "id": 6514,
   "key": "D0507.txt:718",
   "ko": "언월도의 일격이 옆구리에 꽂힌다｡"
  },
  {
   "id": 6515,
   "key": "D0507.txt:736",
   "ko": "「윽…!」"
  },
  {
   "id": 6516,
   "key": "D0507.txt:739",
   "ko": "역회전이라 칼날이 아니라 칼등으로 맞은 게 다행이었다｡ 하지만 언월도는 그 자리에서 곧장 뒤집혀､ 내리베려고 내 어깻죽지를 노린다!"
  },
  {
   "id": 6517,
   "key": "D0507.txt:758",
   "ko": "「다이쥬지 쿠로!」 「얕보지 마아아아아아!」"
  },
  {
   "id": 6519,
   "key": "D0507.txt:784",
   "ko": "「뭐…!?」"
  },
  {
   "id": 6520,
   "key": "D0507.txt:796",
   "ko": "칼날은 어깨 몇 센티 위에서 아슬아슬하게 멈춰 있었다｡"
  },
  {
   "id": 6521,
   "key": "D0507.txt:799",
   "ko": "나는 칼을 『합장』 모양으로 끼우고 있다――진검백인취라는 거다｡"
  },
  {
   "id": 6522,
   "key": "D0507.txt:802",
   "ko": "위험했다… 실패했으면 완전히 저세상행이었다｡"
  },
  {
   "id": 6523,
   "key": "D0507.txt:809",
   "ko": "「지금까지의 빚이다｡ 받아둬라!」"
  },
  {
   "id": 6524,
   "key": "D0507.txt:823",
   "ko": "칼날을 끼운 양 손바닥에 마력을 집중시킨다｡"
  },
  {
   "id": 6525,
   "key": "D0507.txt:849",
   "ko": "날카로운 소리를 내며 언월도는 산산조각 났다｡"
  },
  {
   "id": 6526,
   "key": "D0507.txt:850",
   "ko": "칼의 파편은 본래 모습인 종잇조각으로 돌아간다｡"
  },
  {
   "id": 6527,
   "key": "D0507.txt:851",
   "ko": "종잇조각은 바람을 타고 우리 주위를 떠다녔다｡"
  },
  {
   "id": 6528,
   "key": "D0507.txt:865",
   "ko": "「참으로 무모한 짓을 하는구나」"
  }
 ]
