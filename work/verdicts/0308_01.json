  {
   "id": 3273,
   "key": "D0308.txt:399",
   "ko": "이､ 이젠 틀린 건가?"
  },
  {
   "id": 3274,
   "key": "D0308.txt:413",
   "ko": "하지만 실신하기 직전､"
  },
  {
   "id": 3275,
   "key": "D0308.txt:414",
   "ko": "갑자기 몸을 압박하던 힘이 사라졌다｡"
  },
  {
   "id": 3276,
   "key": "D0308.txt:415",
   "ko": "그 틈에 나는 나이트건트의 팔에서 빠져나온다｡"
  },
  {
   "id": 3277,
   "key": "D0308.txt:420",
   "ko": "「하아…… 하아……! 왜 그래､ 갑자기?」"
  },
  {
   "id": 3278,
   "key": "D0308.txt:450",
   "ko": "「갸아아아아아아아아!」"
  },
  {
   "id": 3279,
   "key": "D0308.txt:456",
   "ko": "검광이 정수리에서 가랑이까지 꿰뚫고､"
  },
  {
   "id": 3280,
   "key": "D0308.txt:457",
   "ko": "나이트건트는 두 동강 났다｡"
  },
  {
   "id": 3281,
   "key": "D0308.txt:458",
   "ko": "="
