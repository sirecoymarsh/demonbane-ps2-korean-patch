  {
   "id": 3282,
   "key": "D0308.txt:460",
   "ko": "="
  },
  {
   "id": 3283,
   "key": "D0308.txt:474",
   "ko": "「이놈은 그때의……」"
  },
  {
   "id": 3284,
   "key": "D0308.txt:479",
   "ko": "「메타트론!?」 하얀 가면､ 하얀 갑주､"
  },
  {
   "id": 3285,
   "key": "D0308.txt:483",
   "ko": "빛의 날개를 펼친､ 그 이름에 걸맞은 모습｡"
  },
  {
   "id": 3286,
   "key": "D0308.txt:485",
   "ko": "아컴시티의 수호자｡"
  },
  {
   "id": 3287,
   "key": "D0308.txt:486",
   "ko": "현실에 등장한 정의의 히어로｡"
  },
  {
   "id": 3288,
   "key": "D0308.txt:487",
   "ko": "그것은 틀림없이､ 메타트론 본인이었다｡"
  },
  {
   "id": 3289,
   "key": "D0308.txt:490",
   "ko": "혹시､ 도와준 건가? 「아､ 고마워…… 엇?」"
  },
  {
   "id": 3290,
   "key": "D0308.txt:498",
   "ko": "감사 인사를 하려다､ 심상찮은 분위기를 눈치챘다｡"
  },
  {
   "id": 3291,
   "key": "D0308.txt:501",
   "ko": "메타트론은 말없이､ 이쪽을 내려다보고 있었다｡"
  },
  {
   "id": 3292,
   "key": "D0308.txt:502",
   "ko": "숨이 막힐 것 같은､ 무시무시한 위압감｡"
  },
  {
   "id": 3293,
   "key": "D0308.txt:507",
   "ko": "「……온당치 않구나｡ 적의가 느껴지는도다」 「말도 안 돼｡ 어째서――」"
  },
  {
   "id": 3294,
   "key": "D0308.txt:546",
   "ko": "「으아아악 큭!?」 충격｡"
  },
  {
   "id": 3295,
   "key": "D0308.txt:561",
   "ko": "얼굴을 붙잡힌 채､ 빌딩 벽면에 내동댕이쳐진다｡"
  },
  {
   "id": 3296,
   "key": "D0308.txt:563",
   "ko": "벽에 처박힌 나에게､ 얼굴을 들이미는 메타트론｡"
  },
  {
   "id": 3297,
   "key": "D0308.txt:564",
   "ko": "="
  },
  {
   "id": 3298,
   "key": "D0308.txt:570",
   "ko": "「어､ 어째서……!」"
  },
  {
   "id": 3299,
   "key": "D0308.txt:575",
   "ko": "「다이쥬지 쿠로…… 네크로노미콘을 놓아라」"
  },
  {
   "id": 3300,
   "key": "D0308.txt:581",
   "ko": "「뭐……!? 내 이름을……!? 게다가 알에 대해서까지……!」"
  },
  {
   "id": 3301,
   "key": "D0308.txt:587",
   "ko": "「어디까지 알고 있느냐､ 네놈!」"
  },
  {
   "id": 3302,
   "key": "D0308.txt:592",
   "ko": "="
  },
  {
   "id": 3303,
   "key": "D0308.txt:600",
   "ko": "얼굴을 쥔 힘이 강해진 것 같은 기분이 들었다｡"
  },
  {
   "id": 3304,
   "key": "D0308.txt:601",
   "ko": "="
  },
  {
   "id": 3305,
   "key": "D0308.txt:606",
   "ko": "="
  },
  {
   "id": 3306,
   "key": "D0308.txt:612",
   "ko": "「모르겠나」"
  },
  {
   "id": 3307,
   "key": "D0308.txt:617",
   "ko": "「이 몸을 노리다니…… 설마､ 그대도 『블랙로지』인가」"
  },
  {
   "id": 3308,
   "key": "D0308.txt:624",
   "ko": "「뭐……!? 바､ 바보 같은 소리 하지 마､ 알! 메타트론은 그놈들과 싸우는 정의의 편이라고!」"
  },
  {
   "id": 3309,
   "key": "D0308.txt:628",
   "ko": "그래｡ 메타트론은 아컴시티의 히어로다｡"
  },
  {
   "id": 3310,
   "key": "D0308.txt:630",
   "ko": "『블랙로지』에 떨며 살아가는 우리에게､ 이 하얀 천사는 희망이자 동경이다｡"
  },
  {
   "id": 3311,
   "key": "D0308.txt:632",
   "ko": "그것이 실은 『블랙로지』의 일원……이라니 그럴 리가 없다｡"
