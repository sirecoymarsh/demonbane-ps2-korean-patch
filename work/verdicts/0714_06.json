  {
   "id": 10913,
   "key": "D0714.txt:1950",
   "ko": "4개의 다리를 가진 거대한 원반｡ 그 아래로 늘어진 강철 목에는､ 거대한 인간의 얼굴이 있다｡"
  },
  {
   "id": 10914,
   "key": "D0714.txt:1953",
   "ko": "형태야 특수하지만､ 귀계신임에 틀림없다｡"
  },
  {
   "id": 10915,
   "key": "D0714.txt:1957",
   "ko": "그 위에､ 외투를 휘날리며 신사가 서 있다｡"
  },
  {
   "id": 10916,
   "key": "D0714.txt:1959",
   "ko": "아래에서는 인스머스를 도려낸 파괴의 빛이､ 천천히 그 기세를 잃어가고 있었다｡"
  },
  {
   "id": 10917,
   "key": "D0714.txt:1965",
   "ko": "「과연､ 저건 괴물이다｡ 괴물이고말고｡ 신조차 죽이는 터무니없는 괴물이지｡ 과연 과연｡ 그랜드 마스터가 눈여겨보는 것도 알겠군｡ 알겠어｡ 하지만 뭐 좋아――」"
  },
  {
   "id": 10918,
   "key": "D0714.txt:1972",
   "ko": "="
  },
  {
   "id": 10919,
   "key": "D0714.txt:1976",
   "ko": "="
  },
  {
   "id": 10920,
   "key": "D0714.txt:1991",
   "ko": "="
  },
  {
   "id": 10921,
   "key": "D0714.txt:1992",
   "ko": "="
  },
  {
   "id": 10922,
   "key": "D0714.txt:1995",
   "ko": "="
  },
  {
   "id": 10923,
   "key": "D0714.txt:2000",
   "ko": "="
  },
  {
   "id": 10924,
   "key": "D0714.txt:2005",
   "ko": "무너지는 소녀를 베스파시아누스가 안아 받치고､ 살며시 외투로 감싼다｡"
  },
  {
   "id": 10925,
   "key": "D0714.txt:2008",
   "ko": "="
  },
  {
   "id": 10926,
   "key": "D0714.txt:2013",
   "ko": "="
  },
  {
   "id": 10927,
   "key": "D0714.txt:2018",
   "ko": "비는 이미 약해지고 있다｡"
  },
  {
   "id": 10928,
   "key": "D0714.txt:2019",
   "ko": "먹구름 곳곳이 끊어지기 시작했다｡"
  },
  {
   "id": 10929,
   "key": "D0714.txt:2020",
   "ko": "비쳐드는 햇살이 귀계신을 비춘다｡"
  },
  {
   "id": 10930,
   "key": "D0714.txt:2026",
   "ko": "「이걸로 『C계획』의 열쇠 하나가 갖춰졌다｡ 발동의 날도 가깝다｡ 가깝다고｡ 그리고 또 하나의 열쇠도――」 「――『폭군』이여」"
  },
  {
   "id": 10931,
   "key": "D0714.txt:2057",
   "ko": "「대단해……대단하다고｡ 벌써 저 플라즈마체를 다룰 수 있게 되다니｡ 예측을 웃도는 성장이야」"
  },
  {
   "id": 10932,
   "key": "D0714.txt:2062",
   "ko": "짝짝､ 나이아의 박수가 아무도 없는 언덕에 울려 퍼졌다｡"
  },
  {
   "id": 10933,
   "key": "D0714.txt:2065",
   "ko": "비꼬듯 일그러진 입가를 혀가 핥는다｡ 조금 흥분한 건지､ 뺨이 발그레하다｡"
  },
  {
   "id": 10934,
   "key": "D0714.txt:2075",
   "ko": "「이번엔 정말로 어쩌면 어쩌면일지도 모르겠는걸」"
  },
  {
   "id": 10935,
   "key": "D0714.txt:2079",
   "ko": "「이번 게임은 나조차 다 예상 못 하겠어……힘내라고､ 쿠로 군」 문득､ 한 줄기 빛이 나이아를 비췄다｡"
  },
  {
   "id": 10936,
   "key": "D0714.txt:2091",
   "ko": "하늘을 올려다본다｡ 「어라어라､ 드디어 갠 모양이군」"
  },
  {
   "id": 10937,
   "key": "D0714.txt:2110",
   "ko": "두껍게 드리운 먹구름이 끊어지고､ 몇 줄기나 되는 햇살이 대지를 축복하듯 쏟아진다｡"
  },
  {
   "id": 10938,
   "key": "D0714.txt:2113",
   "ko": "힘차고､ 생명력이 넘치는､ 은혜의 태양｡ 틀림없는 한여름의 태양이었다｡"
  },
  {
   "id": 10939,
   "key": "D0714.txt:2117",
   "ko": "폭풍은 끝나고､ 다시 덥고 눈부신 여름이 온다｡"
  },
  {
   "id": 10940,
   "key": "D0714.txt:2120",
   "ko": "하지만､ 그것은――｡"
  },
  {
   "id": 10941,
   "key": "D0714.txt:2126",
   "ko": "「『눈』에 들어간 것뿐이야｡ 그저 정말로 아주 잠깐의 소강상태｡ 아주 조금만 허락된 안식의 나날」"
  },
  {
   "id": 10942,
   "key": "D0714.txt:2131",
   "ko": "「――온다｡ 터무니없이 커다란 폭풍이 온다｡ 크나큰 부조리의 폭풍이 온다」"
  },
  {
   "id": 10943,
   "key": "D0714.txt:2138",
   "ko": "「아아､ 아아､ 기쁘구나 즐겁구나｡ 세계는 이토록 슬픈 희극으로 가득 차 있어――」"
  },
  {
   "id": 10945,
   "key": "D0714.txt:2145",
   "ko": "="
  },
  {
   "id": 10946,
   "key": "D0714.txt:2148",
   "ko": "="
  },
  {
   "id": 10947,
   "key": "D0714.txt:2151",
   "ko": "그것이 설령､ 덧없이 사라져 가는､ 현세의 꿈이라 할지라도――"
  }
 ]
}