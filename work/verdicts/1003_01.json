{
 "packet": "1003_01",
 "items": [
  {
   "id": 20915,
   "key": "D1003al.txt:396",
   "ko": "「가앗! 크윽……」"
  },
  {
   "id": 20918,
   "key": "D1003al.txt:410",
   "ko": "「으……윽! 싫어어어어어어어어어어어!」"
  },
  {
   "id": 20919,
   "key": "D1003al.txt:420",
   "ko": "위험해……!"
  },
  {
   "id": 20920,
   "key": "D1003al.txt:421",
   "ko": "이 상태――우리는 그렇다 쳐도 공주님이 못 버틴다!"
  },
  {
   "id": 20921,
   "key": "D1003al.txt:437",
   "ko": "위험해……! 이 상태로는……오래 못 버틴다!!"
  },
  {
   "id": 20922,
   "key": "D1003al.txt:455",
   "ko": "결계를 무너뜨리려 거인 하나를 향해 발칸을 발사한다｡"
  },
  {
   "id": 20924,
   "key": "D1003al.txt:456",
   "ko": "수천 발의 총알 세례를 받고 조금이나마 결계의 구속력이 느슨해졌다｡"
  },
  {
   "id": 20925,
   "key": "D1003al.txt:468",
   "ko": "「크투가아아아아아아아아아아아아!」"
  },
  {
   "id": 20927,
   "key": "D1003al.txt:471",
   "ko": "그 얼마 안 되는 틈을 놓칠 수는 없다｡"
  },
  {
   "id": 20928,
   "key": "D1003al.txt:472",
   "ko": "새 탄창을 소환､ 마총을 거치지 않고 단숨에 막대한 마력을 주입한다!"
  },
  {
   "id": 20929,
   "key": "D1003al.txt:481",
   "ko": "오른손 등의 불꽃 낙인이 빛을 발한다｡"
  },
  {
   "id": 20930,
   "key": "D1003al.txt:482",
   "ko": "뿜어져 나온 마력이 마탄에 불을 붙였다｡"
  },
  {
   "id": 20931,
   "key": "D1003al.txt:483",
   "ko": "시야가 새하얗게 물든다｡"
  },
  {
   "id": 20932,
   "key": "D1003al.txt:492",
   "ko": "일확천금의 도박이었다｡ 결계는 부서지고 세 거인은 검은 안개가 되어 흩어진다｡"
  },
  {
   "id": 20933,
   "key": "D1003al.txt:498",
   "ko": "……탈출에는 성공했지만､ 폭발로 가장 큰 피해를 입은 건 데몬베인이다｡ 장갑은 녹아내리기 직전이고 구동계 반응도 나쁘다｡ 마술 회로도 3할 이상이 발광｡"
  },
  {
   "id": 20934,
   "key": "D1003al.txt:505",
   "ko": "땅이 울린다｡ 여느 때처럼 한기가 스쳐 지나갔다｡"
  },
  {
   "id": 20935,
   "key": "D1003al.txt:506",
   "ko": "어디지……어디서 오는 거지?"
  },
  {
   "id": 20936,
   "key": "D1003al.txt:510",
   "ko": "「아래다! 땅속에서다!」"
  },
  {
   "id": 20937,
   "key": "D1003al.txt:514",
   "ko": "「젠장!」"
  },
  {
   "id": 20939,
   "key": "D1003al.txt:521",
   "ko": "크라켄의 두 팔이 지면을 뚫고 데몬베인을 붙잡으려 다가왔다｡"
  },
  {
   "id": 20940,
   "key": "D1003al.txt:522",
   "ko": "뛰어 물러서려 하지만……안 돼! 반응이 굼뜨다!"
  },
  {
   "id": 20941,
   "key": "D1003al.txt:535",
   "ko": "먹이를 조이는 큰 뱀처럼 두 팔이 데몬베인을 포박했다｡"
  },
  {
   "id": 20942,
   "key": "D1003al.txt:536",
   "ko": "가해지는 압력에 데몬베인의 장갑이 삐걱거린다｡"
  },
  {
   "id": 20944,
   "key": "D1003al.txt:538",
   "ko": "……위험하다｡"
  },
  {
   "id": 20945,
   "key": "D1003al.txt:543",
   "ko": "「오라오라! 패배견 군한테 선물이다――!」"
  },
  {
   "id": 20946,
   "key": "D1003al.txt:557",
   "ko": "무수한 탄환에 얻어맞고 데몬베인의 기체는 차례차례 파괴되어 간다｡"
  },
  {
   "id": 20947,
   "key": "D1003al.txt:558",
   "ko": "얼굴의 절반이 폭산하고 남아 있던 오른팔도 찢겨 날아갔다｡"
  },
  {
   "id": 20948,
   "key": "D1003al.txt:568",
   "ko": "「가아아아아아아아!」"
  },
  {
   "id": 20953,
   "key": "D1003al.txt:584",
   "ko": "「이､ 이놈――읏!」"
  },
  {
   "id": 20955,
   "key": "D1003al.txt:596",
   "ko": "「아아아아아아아아앗!」"
  },
  {
   "id": 20956,
   "key": "D1003al.txt:608",
   "ko": "「아아아아아앗! 싫어어어어어어어어엇!」"
  },
  {
   "id": 20957,
   "key": "D1003al.txt:632",
   "ko": "「――마도 회로 손상률 74%｡ 마력 공급률 36%……계속 떨어지고 있어요｡ 위험해요｡ 활동 정지가 가까워지고 있어요」"
  },
  {
   "id": 20958,
   "key": "D1003al.txt:642",
   "ko": "「루리 아가씨! 루리 아가씨!」"
  },
  {
   "id": 20960,
   "key": "D1003al.txt:649",
   "ko": "「큭……! 뭐든 우리가 할 수 있는 건 없는 거예요!?」"
  },
  {
   "id": 20961,
   "key": "D1003al.txt:652",
   "ko": "「그저 손가락만 빨면서､ 멍청한 얼굴로 보고만 있으란 거예요!」"
  },
  {
   "id": 20962,
   "key": "D1003al.txt:656",
   "ko": "속수무책으로 유린당하는 데몬베인이 모니터에 투영된다｡"
  },
  {
   "id": 20963,
   "key": "D1003al.txt:657",
   "ko": "어지럽게 변화하는 데몬베인의 스테이터스 표시｡"
  },
  {
   "id": 20964,
   "key": "D1003al.txt:659",
   "ko": "어느 것이나 비참한 수치를 나타내며､ 지금도 현재진행형으로 절망을 가속시킨다｡"
  },
  {
   "id": 20965,
   "key": "D1003al.txt:661",
   "ko": "소냐는 콧물을 흘리며 얼굴을 일그러뜨린 채 울부짖고､ 마코토는 냉정한 표정을 가면 삼았지만 식은땀과 몸의 떨림을 억누르지 못한다｡"
  },
  {
   "id": 20966,
   "key": "D1003al.txt:663",
   "ko": "치아키는 욕설을 내뱉으며 장치를 두들기고 있었다｡"
  }
 ]
}