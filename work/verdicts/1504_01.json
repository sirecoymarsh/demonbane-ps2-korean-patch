{
 "packet": "1504_01",
 "items": [
  {
   "id": 42170,
   "key": "D1504al.txt:200",
   "ko": "「알겠다 로봇」"
  },
  {
   "id": 42171,
   "key": "D1504al.txt:205",
   "ko": "「……근데､ 왜 당신이 저한테 지시하는 건데요!」"
  },
  {
   "id": 42172,
   "key": "D1504al.txt:210",
   "ko": "「범인 안경은 범인답게 잠자코 일하라는 것이다아!」"
  },
  {
   "id": 42173,
   "key": "D1504al.txt:215",
   "ko": "「끼이이이이――――――잇! 더는 못 참겠어어――엇!」"
  },
  {
   "id": 42174,
   "key": "D1504al.txt:221",
   "ko": "「칫… 이래서 질투심 많은 범인은｡ 엘자… 이 범인 안경에게 타고난 재능의 차이라는 걸 가르쳐― 응?」"
  },
  {
   "id": 42175,
   "key": "D1504al.txt:231",
   "ko": "「로봇?」"
  },
  {
   "id": 42176,
   "key": "D1504al.txt:240",
   "ko": "「…뭐야｡ 알 아지프인가｡ 무슨 용건인 것이냐?」 「데몬베인 조정은 조금 더 걸리는 것이지만――」"
  },
  {
   "id": 42177,
   "key": "D1504al.txt:251",
   "ko": "「…알 짱? 무슨 일이야?」"
  },
  {
   "id": 42178,
   "key": "D1504al.txt:262",
   "ko": "「………………」"
  },
  {
   "id": 42179,
   "key": "D1504al.txt:267",
   "ko": "「…읏､ 뭐､ 뭐냐 말이다? 그러니까 지금 콕핏에 들어와 봤자 일에 방해가 되는 것이…」"
  },
  {
   "id": 42180,
   "key": "D1504al.txt:285",
   "ko": "「일단――전원 날아가라」 「부르그부베아바아아아앗!」"
  },
  {
   "id": 42181,
   "key": "D1504al.txt:309",
   "ko": "「뭔가 갑자기 부조리 로보오오오――옷!?」"
  },
  {
   "id": 42182,
   "key": "D1504al.txt:315",
   "ko": "「왜 저까지…!? 게부옥끅､ 부풋끅! 크하………………털썩」"
  },
  {
   "id": 42183,
   "key": "D1504al.txt:337",
   "ko": "「용서하거라」"
  },
  {
   "id": 42184,
   "key": "D1504al.txt:348",
   "ko": "――그래｡"
  },
  {
   "id": 42185,
   "key": "D1504al.txt:356",
   "ko": "더 이상 쿠로를 함께 데려갈 수는 없다｡"
  },
  {
   "id": 42186,
   "key": "D1504al.txt:357",
   "ko": "쿠로와 함께 싸우는 것은 여기까지다｡"
  },
  {
   "id": 42187,
   "key": "D1504al.txt:360",
   "ko": "쿠로는 인간이니까｡"
  },
  {
   "id": 42188,
   "key": "D1504al.txt:361",
   "ko": "인간은 인간의 세계에서 살아야 하니까｡"
  },
  {
   "id": 42189,
   "key": "D1504al.txt:363",
   "ko": "여기서부터는――인외의 영역｡"
  },
  {
   "id": 42190,
   "key": "D1504al.txt:364",
   "ko": "인외의 상대는 인외｡"
  },
  {
   "id": 42191,
   "key": "D1504al.txt:365",
   "ko": "인외끼리 결착을 지어야 한다｡"
  },
  {
   "id": 42192,
   "key": "D1504al.txt:368",
   "ko": "그러니까――"
  },
  {
   "id": 42193,
   "key": "D1504al.txt:374",
   "ko": "「――가자､ 데몬베인」"
  },
  {
   "id": 42194,
   "key": "D1504al.txt:411",
   "ko": "「저 바보! 대체 무슨 생각인 거야!」 젠장! 뭐가 어떻게 된 거야!?"
  },
  {
   "id": 42195,
   "key": "D1504al.txt:415",
   "ko": "아무 말도 없이 혼자 뛰쳐나가다니―― …설마!?"
  },
  {
   "id": 42196,
   "key": "D1504al.txt:423",
   "ko": "「저 녀석…! 설마 이 판국에 혼자서 싸울 셈인가!?」"
  },
  {
   "id": 42197,
   "key": "D1504al.txt:426",
   "ko": "농담이 아니야! 겨우 결심이 섰다는데"
  },
  {
   "id": 42198,
   "key": "D1504al.txt:427",
   "ko": "…겨우 내 마음을 깨달았는데､ 여기서 버려지면 그냥 완전 등신이잖아!"
  },
  {
   "id": 42199,
   "key": "D1504al.txt:429",
   "ko": "정말､ 제멋대로 굴기는!"
  },
  {
   "id": 42200,
   "key": "D1504al.txt:438",
   "ko": "「다이쥬지 씨 다이쥬지 씨 다이쥬지 씨이이! 어어어어어떡하죠오오오~~~~!」"
  },
  {
   "id": 42201,
   "key": "D1504al.txt:443",
   "ko": "「그런 거 뒤쫓는 게 당 연 하 잖 아 아아앗!」"
  },
  {
   "id": 42202,
   "key": "D1504al.txt:449",
   "ko": "「하와아아아~~앗! 하지만하지만하지만하지만하지만 어떻게요!?」"
  },
  {
   "id": 42203,
   "key": "D1504al.txt:454",
   "ko": "「전투기든 파괴 로봇이든 좋아! 빨리 출격 준비를…!」"
  },
  {
   "id": 42204,
   "key": "D1504al.txt:464",
   "ko": "「…앗」 「――――?」"
  },
  {
   "id": 42205,
   "key": "D1504al.txt:477",
   "ko": "등 뒤에 무언가가 내려앉는 기척을 느꼈다｡"
  },
  {
   "id": 42206,
   "key": "D1504al.txt:478",
   "ko": "소냐의 시선이 내 뒤로 향한다｡"
  },
  {
   "id": 42207,
   "key": "D1504al.txt:481",
   "ko": "뒤를 돌아보았다｡ 거기 있던 것은…"
  },
  {
   "id": 42208,
   "key": "D1504al.txt:491",
   "ko": "「정말이지… 끝까지 문제투성이로군」 「――메타트론!」"
  },
  {
   "id": 42209,
   "key": "D1504al.txt:501",
   "ko": "「잡아라｡ 나라면 따라잡을 수 있다」"
  }
 ]
}