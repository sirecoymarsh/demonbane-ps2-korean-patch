{
 "packet": "0753_00",
 "items": [
  {
   "id": 11389,
   "key": "D0753.txt:36",
   "ko": "「크윽……」"
  },
  {
   "id": 11390,
   "key": "D0753.txt:38",
   "ko": "뒷걸음질치며 자세를 잡는다――자세를 잡아 봤자 마기우스가 되지 못하는 나는 어차피 무력하지만｡"
  },
  {
   "id": 11391,
   "key": "D0753.txt:41",
   "ko": "절망감에 가까운 긴장감에 몸이 굳어 있었다｡"
  },
  {
   "id": 11392,
   "key": "D0753.txt:42",
   "ko": "이마를 타고 흐르는 땀의 차가움을 느낀다｡"
  },
  {
   "id": 11393,
   "key": "D0753.txt:46",
   "ko": "「이타콰……인가」"
  },
  {
   "id": 11394,
   "key": "D0753.txt:48",
   "ko": "눈앞에 그､ 구름 거인과 얼음 용의 형상을 하고 있던 이타콰가 있다｡"
  },
  {
   "id": 11395,
   "key": "D0753.txt:50",
   "ko": "……기척이 같으니 이타콰가 틀림없다｡"
  },
  {
   "id": 11396,
   "key": "D0753.txt:53",
   "ko": "어째서 굳이 그런 걸 확인해야만 하는가?"
  },
  {
   "id": 11397,
   "key": "D0753.txt:56",
   "ko": "――즉 이타콰가 또 다른 형태를 취하고 있기 때문이다｡"
  },
  {
   "id": 11398,
   "key": "D0753.txt:65",
   "ko": "「――――――」"
  },
  {
   "id": 11399,
   "key": "D0753.txt:70",
   "ko": "말 그대로 쿨 뷰티라고 불러야 하나｡"
  },
  {
   "id": 11400,
   "key": "D0753.txt:71",
   "ko": "허리를 곧게 편､ 늘씬한 장신의 미녀｡"
  },
  {
   "id": 11401,
   "key": "D0753.txt:74",
   "ko": "잘 벼린 칼날처럼 유연함과 강인함을 겸비한 몸｡ 꿰뚫을 듯 차가운 눈동자가 안경 너머에서 빛나고 있다｡"
  },
  {
   "id": 11402,
   "key": "D0753.txt:85",
   "ko": "칼날을 들이대는 듯､ 날카롭고 차가운 영압｡"
  },
  {
   "id": 11403,
   "key": "D0753.txt:88",
   "ko": "크윽…… 역시 페이지 몬스터 놈들､ 갈수록 성가셔지는군｡"
  },
  {
   "id": 11404,
   "key": "D0753.txt:93",
   "ko": "이타콰가 한 발 내디디며 나에게 다가온다｡"
  },
  {
   "id": 11405,
   "key": "D0753.txt:94",
   "ko": "발밑 바닥에 서리가 내려앉았다｡"
  },
  {
   "id": 11406,
   "key": "D0753.txt:97",
   "ko": "기세에 눌려 나는 한 발 물러선다｡"
  },
  {
   "id": 11407,
   "key": "D0753.txt:98",
   "ko": "이타콰가 다시 한 발 더｡ 나도 한 발 물러난다｡"
  },
  {
   "id": 11408,
   "key": "D0753.txt:101",
   "ko": "한 발 다가온다｡ 한 발 물러난다｡"
  },
  {
   "id": 11409,
   "key": "D0753.txt:102",
   "ko": "그걸 반복하다――등에 벽이 닿았다｡"
  },
  {
   "id": 11410,
   "key": "D0753.txt:108",
   "ko": "「……젠장!」"
  },
  {
   "id": 11411,
   "key": "D0753.txt:111",
   "ko": "애초에 여기는 어디지?"
  },
  {
   "id": 11412,
   "key": "D0753.txt:114",
   "ko": "어쩐지 고풍스러운 석조 회랑이었다｡"
  },
  {
   "id": 11413,
   "key": "D0753.txt:116",
   "ko": "창으로 비쳐 드는 빛이 너무 하얗고 너무 또렷하다｡ 주위의 어둠을 녹이지 않은 채 흑백의 콘트라스트를 그린다｡"
  },
  {
   "id": 11414,
   "key": "D0753.txt:119",
   "ko": "아컴시티에 이런 장소가 있었던가?"
  },
  {
   "id": 11415,
   "key": "D0753.txt:122",
   "ko": "……뭔가가 다르다｡ 기척이 다르다｡ 세계의 공기가 다르다｡"
  },
  {
   "id": 11416,
   "key": "D0753.txt:123",
   "ko": "마치 이세계 같은――"
  },
  {
   "id": 11417,
   "key": "D0753.txt:127",
   "ko": "「그래…… 이놈들 상대로 상식이 통할 리가 있나」"
  },
  {
   "id": 11418,
   "key": "D0753.txt:130",
   "ko": "어쨌든 엄청나게 궁지에 몰렸다는 건 아주 잘 알았다｡"
  },
  {
   "id": 11419,
   "key": "D0753.txt:138",
   "ko": "냉소를 띄우는 이타콰｡ 죽음을 연상시킬 만큼 오싹한 미소였다｡ 그러면서도 지독히 매혹적이었다｡"
  },
  {
   "id": 11420,
   "key": "D0753.txt:141",
   "ko": "걸음을 늦추지 않고 이타콰는 다가온다｡ 이 거리까지 좁혀지자 이제 공기가 아플 만큼 차갑다｡"
  },
  {
   "id": 11421,
   "key": "D0753.txt:144",
   "ko": "그리고 천천히 얼어붙은 오른손이 뻗어 왔다｡"
  },
  {
   "id": 11422,
   "key": "D0753.txt:147",
   "ko": "이 이상은 위험하다!"
  },
  {
   "id": 11423,
   "key": "D0753.txt:160",
   "ko": "바닥을 차고 옆으로 뛴다……"
  },
  {
   "id": 11424,
   "key": "D0753.txt:160",
   "ko": "다 꿰뚫어 보고 있었던 모양이다｡"
  },
  {
   "id": 11425,
   "key": "D0753.txt:170",
   "ko": "「끄윽!?」"
  },
  {
   "id": 11426,
   "key": "D0753.txt:173",
   "ko": "다리가 움직이지 않는다｡"
  },
  {
   "id": 11427,
   "key": "D0753.txt:174",
   "ko": "얼어붙은 바닥에 신발이 들러붙어 있다｡"
  },
  {
   "id": 11428,
   "key": "D0753.txt:177",
   "ko": "아차…… 또 비슷한 실수를!"
  }
 ]
}