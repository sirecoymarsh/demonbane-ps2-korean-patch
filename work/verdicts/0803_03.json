  {
   "id": 12613,
   "key": "D0803al.txt:550",
   "ko": "「――모르는 사람､ 같은 거 아니야」"
  },
  {
   "id": 12614,
   "key": "D0803al.txt:557",
   "ko": "="
  },
  {
