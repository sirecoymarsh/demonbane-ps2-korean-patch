  {
   "id": 10151,
   "key": "D0712le.txt:54",
   "ko": "「깜짝 놀랐잖아…… 갑자기 쓰러져 버리니까」"
  },
  {
   "id": 10152,
   "key": "D0712le.txt:59",
   "ko": "「엇? …… 아앗」"
  },
  {
   "id": 10153,
   "key": "D0712le.txt:62",
   "ko": "흐릿하던 의식이 또렷해진다｡"
  },
  {
   "id": 10154,
   "key": "D0712le.txt:64",
   "ko": "그래｡ 나는 그 연기를 들이마시고 몸이 이상해져서…… 그래서 라이카 씨를 끌어안았던 거다｡"
  },
  {
   "id": 10155,
   "key": "D0712le.txt:66",
   "ko": "어､ 어쩌자고 그런 짓을 해 버린 거야?"
  },
  {
   "id": 10156,
   "key": "D0712le.txt:71",
   "ko": "「저､ 저기､ 그…… 아､ 아､ 아우앗」"
  },
  {
   "id": 10157,
   "key": "D0712le.txt:76",
   "ko": "「몸､ 괜찮아?」"
  },
  {
   "id": 10158,
   "key": "D0712le.txt:81",
   "ko": "「어? 으､ 응…… 이제､ 괜찮은 것､ 같아」"
  },
  {
   "id": 10159,
   "key": "D0712le.txt:88",
   "ko": "「그래…… 다행이다」 「……어､ 어」"
  },
  {
   "id": 10162,
   "key": "D0712le.txt:100",
   "ko": "라이카 씨의 손을 빌려 일어난다｡ 아직 휘청거리는 나를 라이카 씨는 걱정스레 바라보고 있었다｡"
  },
  {
   "id": 10163,
   "key": "D0712le.txt:105",
   "ko": "「괜찮아｡ 조금 어지러울 뿐이야」"
  },
  {
   "id": 10164,
   "key": "D0712le.txt:108",
   "ko": "「근데 대체､ 왜 갑자기……」"
  },
  {
   "id": 10165,
   "key": "D0712le.txt:114",
   "ko": "「음…… 아마､ 이…… 연기 때문일 거야……」"
  },
  {
   "id": 10166,
   "key": "D0712le.txt:120",
   "ko": "……그런가｡ 이 달콤한 냄새가 나는 연기｡"
  },
  {
   "id": 10168,
   "key": "D0712le.txt:121",
   "ko": "이것이 아마 사람의 정신에 작용하는 것이겠지｡"
  },
  {
   "id": 10169,
   "key": "D0712le.txt:129",
   "ko": "「그러니까…… 그……」"
  },
  {
   "id": 10170,
   "key": "D0712le.txt:134",
   "ko": "「?」"
  },
  {
   "id": 10171,
   "key": "D0712le.txt:143",
   "ko": "「신경 안 써도､ 괜찮으니까」"
  },
  {
   "id": 10175,
   "key": "D0712le.txt:148",
   "ko": "「……읏!? 아…… 아니……」"
  },
  {
   "id": 10176,
   "key": "D0712le.txt:157",
   "ko": "「그､ 그럼､ 이 얘기는 이제 끝!」"
  },
  {
   "id": 10178,
   "key": "D0712le.txt:166",
   "ko": "「……한가하게 있을 때가 아니니까」"
  },
  {
   "id": 10183,
   "key": "D0712le.txt:171",
   "ko": "「……그랬지」"
  },
  {
   "id": 10184,
   "key": "D0712le.txt:176",
   "ko": "확실히､ 이런 데서 시간을 잡아먹고 있을 때가 아니었다｡"
  },
  {
   "id": 10185,
   "key": "D0712le.txt:178",
   "ko": "일단 마음을 다잡고 앞으로 나아가자｡"
  },
  {
   "id": 10186,
   "key": "D0712le.txt:179",
   "ko": "우리는 다시 걷기 시작했다｡"
  },
  {
   "id": 10187,
   "key": "D0712le.txt:195",
   "ko": "내 발소리가 신전 내부에 울려 퍼진다｡ 몇 개의 복도와 방을 지나자､ 아무래도 이 신전의 중심부인 듯한 곳에 다다랐다｡"
  },
  {
   "id": 10188,
