{
 "packet": "0907_03",
 "items": [
  {
   "id": 19442,
   "key": "D0907le.txt:256",
   "ko": "「하지만､ 다른 방법이 없다――」 「안 돼! 싸움은 혼자서 짊어지는 게 아니라고!」"
  },
  {
   "id": 19443,
   "key": "D0907le.txt:266",
   "ko": "「…………」 「게다가……우선은 나부터 쓰러뜨려야겠지」"
  },
  {
   "id": 19444,
   "key": "D0907le.txt:286",
   "ko": "――――읏!? 상공에서 검은 천사가 내려온다｡"
  },
  {
   "id": 19445,
   "key": "D0907le.txt:297",
   "ko": "……산달폰｡"
  },
  {
   "id": 19446,
   "key": "D0907le.txt:299",
   "ko": "메타트론과 꼭 닮은､ 하지만 『블랙로지』에 가담한､ 또 한 명의 장갑 전사｡"
  },
  {
   "id": 19447,
   "key": "D0907le.txt:300",
   "ko": "아무래도 깊은 인연이 있는 모양이지만……｡"
  },
  {
   "id": 19448,
   "key": "D0907le.txt:304",
   "ko": "「……역시 왔군､ 산달폰」"
  },
  {
   "id": 19449,
   "key": "D0907le.txt:309",
   "ko": "「어리석은 질문이군 메타트론｡ 이런 사태가 벌어지면 반드시 너는 움직인다｡ 그렇다면 내가 움직이는 것도 당연하지 않은가｡ 왜냐하면 너는――」"
  },
  {
   "id": 19450,
   "key": "D0907le.txt:313",
   "ko": "검은 가면 위로 산달폰은 자신의 오른쪽 눈을 만진다｡"
  },
  {
   "id": 19452,
   "key": "D0907le.txt:315",
   "ko": "……몸이 잘게 떨리고 있었다｡"
  },
  {
   "id": 19453,
   "key": "D0907le.txt:316",
   "ko": "격정을 억누르지 못하겠다는 듯이｡"
  },
  {
   "id": 19454,
   "key": "D0907le.txt:318",
   "ko": "그래도 억지로 감정을 눌러 죽인 목소리는､ 차갑고 무겁게 스며든다｡"
  },
  {
   "id": 19455,
   "key": "D0907le.txt:322",
   "ko": "「너는､ 나를 죽였으니까」 「엇?」"
  },
  {
   "id": 19456,
   "key": "D0907le.txt:333",
   "ko": "「놀랄 일이 아니다｡ 그자는 자기가 살아남기 위해서라면 누구든 죽이지｡ 아컴시티를 지키는 정의의 히어로라고? 웃기는군｡ 이놈은 훨씬 더 악랄한 물건이다」"
  },
  {
   "id": 19457,
   "key": "D0907le.txt:337",
   "ko": "「――정의를 사칭할 생각은 없다」"
  },
  {
   "id": 19458,
   "key": "D0907le.txt:341",
   "ko": "메타트론의 짧은 말에､ 산달폰이 시선을 되돌린다｡ 서로 노려보는 양자｡"
  },
  {
   "id": 19459,
   "key": "D0907le.txt:344",
   "ko": "부딪치는 투지가 불꽃을 튀긴다｡"
  },
  {
   "id": 19460,
   "key": "D0907le.txt:349",
   "ko": "「그렇지｡ 그랬었지､ 메타트론｡ 미안했다｡ 미안했어」"
  },
  {
   "id": 19461,
   "key": "D0907le.txt:353",
   "ko": "「뭘……이래 봬도 말이지､ 메타트론｡ 나는 너에게 감사하고 있다」"
  },
  {
   "id": 19462,
   "key": "D0907le.txt:362",
   "ko": "가면에 댄 손을 내리고､ 무술의 『형』을 취한다｡"
  },
  {
   "id": 19463,
   "key": "D0907le.txt:363",
   "ko": "움켜쥔 주먹을 메타트론을 향해 내민다｡"
  },
  {
   "id": 19464,
   "key": "D0907le.txt:367",
   "ko": "공기가､ 떨렸다｡"
  },
  {
   "id": 19465,
   "key": "D0907le.txt:369",
   "ko": "뿜어져 나오는 살의｡ 소용돌이치는 투지｡ 다가가는 것만으로 심장이 터질 것 같은､ 그런 엄청난 압박감｡"
  },
  {
   "id": 19466,
   "key": "D0907le.txt:388",
   "ko": "「윽……」"
  },
  {
   "id": 19467,
   "key": "D0907le.txt:392",
   "ko": "공주님의 안색이 눈에 띄게 창백해졌다｡"
  },
  {
   "id": 19468,
   "key": "D0907le.txt:394",
   "ko": "무리도 아니다……이런 살기에 노출되고도 태연할 수 있는 놈은 없다｡"
  },
  {
   "id": 19469,
   "key": "D0907le.txt:406",
   "ko": "지금까지 억눌러 온 격정을 드러내며､"
  },
  {
   "id": 19470,
   "key": "D0907le.txt:407",
   "ko": "산달폰이 포효한다｡"
  },
  {
   "id": 19471,
   "key": "D0907le.txt:419",
   "ko": "「너를 향한 분노가 나를 강하게 했다｡ 너를 향한 증오가 나를 강하게 했다｡ 너를 향한 살의가 나를 강하게 했다」"
  },
  {
   "id": 19472,
   "key": "D0907le.txt:425",
   "ko": "「네가! 네가! 너의 배신이! 나를 강하게 만든 것이다!」"
  },
  {
   "id": 19473,
   "key": "D0907le.txt:429",
   "ko": "「그리고――너를 죽임으로써 나는 완성된다｡ 더한 강함을､ 지고의 영역을 침범할 권리를 손에 넣을 수 있다!」"
  },
  {
   "id": 19474,
   "key": "D0907le.txt:433",
   "ko": "「내 손에 죽어라 메타트론! 너는 나의 양식이 되어라! 너는 나의 제물이 되어라!」"
  },
  {
   "id": 19475,
   "key": "D0907le.txt:439",
   "ko": "「나는 너를 잃어야만 한다!」"
  },
  {
   "id": 19477,
   "key": "D0907le.txt:444",
   "ko": "죽였다……배신……무슨 소리일까｡ 외부인인 나로서는 전혀 모르겠다｡"
  },
  {
   "id": 19478,
   "key": "D0907le.txt:447",
   "ko": "모르겠지만……이자가 메타트론을 몹시 원망한다는 것만은 전해졌다｡"
  },
  {
   "id": 19479,
   "key": "D0907le.txt:452",
   "ko": "「죽은 자는……얌전히 잠들어야 했다｡ 산달폰」"
  },
  {
   "id": 19480,
   "key": "D0907le.txt:456",
   "ko": "「지금의 너는 죽은 채로 꾸는 악몽이다｡ 꿈은……깨어나야만 한다」"
  },
  {
   "id": 19482,
   "key": "D0907le.txt:462",
   "ko": "「쾅!」"
  },
  {
   "id": 19483,
   "key": "D0907le.txt:477",
   "ko": "산달폰이 주먹을 뻗었다｡"
  },
  {
   "id": 19484,
   "key": "D0907le.txt:478",
   "ko": "공기를 매개로､ 충격이 전파된다｡"
  }
 ]
}