{
 "packet": "0710_05",
 "items": [
  {
   "id": 9396,
   "key": "D0710al.txt:1494",
   "ko": "「이､ 이봐…… 정신 차리지 못하겠느냐」 알의 목소리에 뇌가 저릿하다｡"
  },
  {
   "id": 9397,
   "key": "D0710al.txt:1503",
   "ko": "흐릿한 시야｡ 하지만 바로 코앞에 알의 얼굴｡"
  },
  {
   "id": 9398,
   "key": "D0710al.txt:1506",
   "ko": "그리고……알의 냄새｡"
  },
  {
   "id": 9399,
   "key": "D0710al.txt:1507",
   "ko": "달콤한 소녀의 냄새가 콧속을 간질인다｡ 나는……뭐가 뭔지 알 수 없어져서――"
  },
  {
   "id": 9400,
   "key": "D0710al.txt:1514",
   "ko": "「………………」 「뭐､ 뭐냐…… 무､ 무서운 얼굴을 하고서……」"
  },
  {
   "id": 9401,
   "key": "D0710al.txt:1524",
   "ko": "조금 겁먹은 듯한 눈으로 나를 마주 보는 알｡ 나는 아무 대답도 하지 않는다｡"
  },
  {
   "id": 9402,
   "key": "D0710al.txt:1527",
   "ko": "대답할 수 있을 만한 멀쩡한 상태가 아니다｡"
  },
  {
   "id": 9403,
   "key": "D0710al.txt:1529",
   "ko": "이끌리듯이 나는 얼굴을 가까이 가져간다｡ 두 사람의 거리가 순식간에 좁혀진다｡"
  },
  {
   "id": 9404,
   "key": "D0710al.txt:1534",
   "ko": "「무､ 무슨 말이라도 해보 ……응응읏!?」"
  },
  {
   "id": 9405,
   "key": "D0710al.txt:1540",
   "ko": "="
  },
  {
   "id": 9406,
   "key": "D0710al.txt:1543",
   "ko": "어째서 그런 짓을 했는지……나도 모르겠다｡"
  },
  {
   "id": 9407,
   "key": "D0710al.txt:1553",
   "ko": "그저 정신을 차려보니 나는 알과 입술을 겹치고 있었다｡"
  },
  {
   "id": 9408,
   "key": "D0710al.txt:1561",
   "ko": "「……읏!?」 갑작스러운 일에 허둥대는 알의 기척이 느껴졌다｡"
  },
  {
   "id": 9409,
   "key": "D0710al.txt:1567",
   "ko": "하지만 그런 건 아랑곳하지 않는다｡ 「응―응―응―!」"
  },
  {
   "id": 9410,
   "key": "D0710al.txt:1577",
   "ko": "알의 가녀린 가슴이 내 가슴팍에 눌린다｡ 고동을､ 느낀다｡"
  },
  {
   "id": 9411,
   "key": "D0710al.txt:1581",
   "ko": "내 고동과 알의 고동｡ 두 사람의 고동이 겹쳐 있다｡"
  },
  {
   "id": 9412,
   "key": "D0710al.txt:1619",
   "ko": "「쿠､ 쿠로오……읏」 심장이 더욱 미친 듯이 날뛰었다｡"
  },
  {
   "id": 9413,
   "key": "D0710al.txt:1626",
   "ko": "이젠 아무것도 생각할 수 없다｡ 나는……알이……알을……"
  },
  {
   "id": 9414,
   "key": "D0710al.txt:1635",
   "ko": "「응……응응응……읏」 「알……」"
  },
  {
   "id": 9415,
   "key": "D0710al.txt:1645",
   "ko": "「………………」 「……?」"
  },
  {
   "id": 9416,
   "key": "D0710al.txt:1656",
   "ko": "다시 입술을 가져가다가――알의 상태가 이상하다는 것을 깨달았다｡"
  },
  {
   "id": 9417,
   "key": "D0710al.txt:1663",
   "ko": "「~~~~~~읏읏!」 「아､ 알? 왜 그――」"
  },
  {
   "id": 9418,
   "key": "D0710al.txt:1670",
   "ko": "오싹｡ 타는 듯이 뜨겁던 몸에 소름이 돋았다｡"
  },
  {
   "id": 9419,
   "key": "D0710al.txt:1673",
   "ko": "순식간에 온몸의 열을 앗아간다｡ 하지만 늦었다｡"
  },
  {
   "id": 9420,
   "key": "D0710al.txt:1680",
   "ko": "「이､ 이､ 이……읏!」"
  },
  {
   "id": 9421,
   "key": "D0710al.txt:1685",
   "ko": "「자､ 잠깐……! 기다……!」"
  },
  {
   "id": 9422,
   "key": "D0710al.txt:1691",
   "ko": "「작작 좀! 하지 못하겠느냐아아아아아앗!」"
  },
  {
   "id": 9423,
   "key": "D0710al.txt:1709",
   "ko": "「각읏!? 기이~~~읏! ……%&*!?!!!!!?」"
  },
  {
   "id": 9424,
   "key": "D0710le.txt:21",
   "ko": "「……쿠로 군……」 ………………………………｡"
  },
  {
   "id": 9425,
   "key": "D0710le.txt:31",
   "ko": "「쿠로 군……쿠로 군! 괜찮아､ 쿠로 군……!?」"
  },
  {
   "id": 9426,
   "key": "D0710le.txt:37",
   "ko": "「…………음……아……?」 「아……정신 차렸다…… 다행이야아~~」"
  },
  {
   "id": 9427,
   "key": "D0710le.txt:61",
   "ko": "「아아……저기……여긴?」 「그 섬이야…… 어떻게든 떠밀려 온 것 같아」"
  },
  {
   "id": 9428,
   "key": "D0710le.txt:76",
   "ko": "몸을 일으켜 주위를 둘러본다｡"
  },
  {
   "id": 9429,
   "key": "D0710le.txt:77",
   "ko": "확실히 목표로 하던 섬인 것 같다｡"
  },
  {
   "id": 9430,
   "key": "D0710le.txt:79",
   "ko": "나는 모래사장에 떠밀려 온 듯한 모습으로 쓰러져 있었던 모양이다｡ 옆에는 라이카 씨만 있을 뿐｡ 공주님과 집사님､ 그리고 하필이면 알이 없다｡ 마기우스 스타일도 당연히 풀려버렸다｡"
  },
