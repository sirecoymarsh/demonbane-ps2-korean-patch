{
 "packet": "ep_ruri02a_09",
 "items": [
  {
   "id": 50893,
   "key": "ep_ruri02a.txt:1151",
   "ko": "「자기 탓이라고 한다면､ 끝까지 제대로 책임지세요! 당신､ 제 때는､ 나무라고､ 때리기까지 해 놓고……비겁해요!」"
  },
  {
   "id": 50894,
   "key": "ep_ruri02a.txt:1156",
   "ko": "「………………」 고정됐다｡"
  },
  {
   "id": 50895,
   "key": "ep_ruri02a.txt:1160",
   "ko": "마치 시간을 멈춘 것처럼､ 빛의 입자는､ 정지해 있다｡"
  },
  {
   "id": 50896,
   "key": "ep_ruri02a.txt:1164",
   "ko": "「자! 이 어리석은 반복을 끝내겠어요!」"
  },
  {
   "id": 50897,
   "key": "ep_ruri02a.txt:1167",
   "ko": "침묵｡"
  },
  {
   "id": 50898,
   "key": "ep_ruri02a.txt:1168",
   "ko": "시간이 멈춘 방에､ 내 목소리만이 울린다｡"
  },
  {
   "id": 50899,
   "key": "ep_ruri02a.txt:1174",
   "ko": "「언제까지 멍하니 있을 셈인가요､ 꾸물대지 말고 어서 하세요 서두르세요!」"
  },
  {
   "id": 50900,
   "key": "ep_ruri02a.txt:1177",
   "ko": "「싸우지 않는 당신에게 무슨 존재 의의가 있나요!? 재생지 재료도 못 될 벌레 먹은 헌책 아가씨 주제에!」"
  },
  {
   "id": 50901,
   "key": "ep_ruri02a.txt:1181",
   "ko": "시간이 멈춘 방에서―― 「……정말이지､ 그대는아아아!」"
  },
  {
   "id": 50902,
   "key": "ep_ruri02a.txt:1193",
   "ko": "빛의 입자는 증식하고――"
  },
  {
   "id": 50903,
   "key": "ep_ruri02a.txt:1198",
   "ko": "「가만있으니까 마음대로 지껄이는 게냐､ 계집아이이이――――!」"
  },
  {
   "id": 50904,
   "key": "ep_ruri02a.txt:1205",
   "ko": "――섬광이 폭발했다｡"
  },
  {
   "id": 50905,
   "key": "ep_ruri02a.txt:1217",
   "ko": "어디서 솟아났는지､ 흩날리며､ 바람도 없는데 소용돌이치는 종잇조각｡"
  },
  {
   "id": 50906,
   "key": "ep_ruri02a.txt:1218",
   "ko": "소용돌이 중앙､ 마도서의 단편이 겹겹이 포개어져､ 수렴한다｡"
  },
  {
   "id": 50907,
   "key": "ep_ruri02a.txt:1222",
   "ko": "몸을 빚어내는 종잇조각｡"
  },
  {
   "id": 50908,
   "key": "ep_ruri02a.txt:1223",
   "ko": "은빛 머리카락을 엮고､ 사지를 짜올리고､ 살갗은 질감을 얻어､ 사람의 형상을 이루어 간다｡"
  },
  {
   "id": 50909,
   "key": "ep_ruri02a.txt:1228",
   "ko": "소녀가 귀환했다｡ 이 기적 속에서､ 재생했다｡"
  },
  {
   "id": 50910,
   "key": "ep_ruri02a.txt:1230",
   "ko": "시시하다는 듯 나를 노려보며､ 퉁명스럽게 외친다｡"
  },
  {
   "id": 50911,
   "key": "ep_ruri02a.txt:1234",
   "ko": "「오너라! 요그 소토스의 고리를 파괴하는 게다! 이 세계에……쿠로에게､ 미래를……!」"
  },
  {
   "id": 50912,
   "key": "ep_ruri02a.txt:1239",
   "ko": "「네!」"
  },
  {
   "id": 50913,
   "key": "ep_ruri02a.txt:1243",
   "ko": "뻗어 온 알의 손을､ 꽉 붙잡는다｡"
  },
  {
   "id": 50914,
   "key": "ep_ruri02a.txt:1244",
   "ko": "나와 알의 몸이 허공에 떠올라､ 빛에 감싸였다｡"
  },
  {
   "id": 50915,
   "key": "ep_ruri02a.txt:1256",
   "ko": "내 안을 내달리는 술식｡"
  },
  {
   "id": 50916,
   "key": "ep_ruri02a.txt:1257",
   "ko": "내 모습은､ 그 검은 지령복 차림……마기우스 스타일로 바뀐다｡"
  },
  {
   "id": 50917,
   "key": "ep_ruri02a.txt:1261",
   "ko": "「도약한다!」 입자가 되어 무너져 가는 몸｡"
  },
  {
   "id": 50918,
   "key": "ep_ruri02a.txt:1266",
   "ko": "우리는 정보의 최소 단위로 분해되어､ 시간을､ 공간을 초월한다｡"
  },
  {
   "id": 50919,
   "key": "ep_ruri02a.txt:1268",
   "ko": "영겁의 접속점으로｡ 스스로의 꼬리를 삼키는､ 뱀의 턱으로｡"
  },
  {
   "id": 50920,
   "key": "ep_ruri02a.txt:1275",
   "ko": "다이쥬지 쿠로와 마스터 테리온이 싸우는､ 결전의 우주로――!"
  }
 ]
}