   "ko": "="
  },
  {
   "id": 19363,
   "key": "D0907al.txt:289",
   "ko": "「……그대」"
  },
  {
   "id": 19364,
   "key": "D0907al.txt:298",
   "ko": "="
  },
  {
   "id": 19365,
