  {
   "id": 364,
   "key": "D0103.txt:34",
   "ko": "「……………………」"
  },
  {
   "id": 365,
   "key": "D0103.txt:43",
   "ko": "「…………………………………………」"
  },
  {
   "id": 366,
   "key": "D0103.txt:57",
   "ko": "「……다아아아! 시끄러어어어!」"
  },
  {
   "id": 367,
   "key": "D0103.txt:63",
   "ko": "뭐야､ 뭐야!? 사람이 모처럼 늘어지게 늦잠을 만끽하고 있는데!? 뭔가 수금이라도 온 건가?"
  },
  {
   "id": 368,
   "key": "D0103.txt:66",
   "ko": "훗……그렇다면 헛수고였군! 지금의 나에겐 내고 싶어도 한 푼도 없으니까 말이다!"
  },
  {
   "id": 369,
   "key": "D0103.txt:76",
   "ko": "「………………」"
  },
  {
   "id": 370,
   "key": "D0103.txt:77",
   "ko": "(현실을 재인식하고 아침부터 우울해진 모양)"
  },
  {
   "id": 371,
   "key": "D0103.txt:92",
   "ko": "「네네네……지금 열어요」 「으이~､ 누구세요……」"
  },
  {
   "id": 372,
   "key": "D0103.txt:110",
   "ko": "「이곳이 다이쥬지 쿠로 님의 사무소가 맞으신지요」"
  },
  {
   "id": 373,
   "key": "D0103.txt:116",
   "ko": "문을 연 내 앞에､ 각 잡힌 검은 정장을 차려입은 장신의 남자가 서 있었다｡"
  },
  {
   "id": 374,
   "key": "D0103.txt:118",
   "ko": "똑바로 허리를 편 늘씬한 마른 체구｡ 하지만 허약한 인상은 전혀 없다｡"
  },
  {
   "id": 375,
   "key": "D0103.txt:121",
   "ko": "안경 너머로 빛나는 날카롭고 차가운 눈동자――잘 벼려진 칼을 연상시킨다｡"
  },
  {
   "id": 376,
   "key": "D0103.txt:123",
   "ko": "이 근처 주민들과는 너무나 동떨어진 차림새와 분위기에 당황하고 만다｡"
  },
  {
   "id": 377,
   "key": "D0103.txt:128",
   "ko": "「어……아니､ 그렇긴 한데요……저､ 무슨 일이시죠?」 「일 의뢰입니다」"
  },
  {
   "id": 378,
   "key": "D0103.txt:145",
   "ko": "대답은 남자가 아니라 뒤쪽에서 들려왔다｡"
  },
  {
   "id": 379,
   "key": "D0103.txt:146",
   "ko": "검은 옷의 남자가 앞을 양보하듯 한 걸음 물러선다｡"
  },
  {
   "id": 380,
   "key": "D0103.txt:157",
   "ko": "뒤에 있던 것은 남자보다도 더 이 자리에 어울리지 않는､ 그야말로 깊은 규방의 영애 같은 분위기의 여성이었다｡ 검고 맑은､ 의지가 강해 보이는 눈동자가 똑바로 나를 바라보고 있다｡"
  },
  {
   "id": 381,
   "key": "D0103.txt:159",
   "ko": "="
  },
  {
   "id": 382,
   "key": "D0103.txt:160",
   "ko": "="
  },
  {
   "id": 383,
   "key": "D0103.txt:165",
   "ko": "「그래요｡ 당신에게야말로 어울리는 일입니다｡ 다이쥬지 쿠로 씨」"
  },
  {
   "id": 384,
   "key": "D0103.txt:180",
   "ko": "갑작스러운 일에 한동안 당황했지만､ 어쨌든 안으로 들이고 자세한 이야기를 듣기로 했다｡"
  },
  {
   "id": 385,
   "key": "D0103.txt:182",
   "ko": "하지만……일 의뢰라고? 왜 이런 돈 많아 보이는 사람이 나 같은 삼류 탐정한테?"
  },
  {
   "id": 386,
   "key": "D0103.txt:184",
   "ko": "="
  },
  {
   "id": 387,
   "key": "D0103.txt:187",
   "ko": "예쁜 사람이다｡ 게다가 마치 영화에서 튀어나온 듯한 호사스러운 드레스｡ 이런 굉장한 드레스를 입는 신분의 사람은 만나본 적도 없다｡"
  },
  {
   "id": 388,
   "key": "D0103.txt:190",
   "ko": "잠시 후 아가씨 쪽에서 이야기를 꺼냈다｡ 차분한 어조――하지만 이어진 말에는 폭탄급 파괴력이 담겨 있었다｡"
  },
  {
   "id": 389,
   "key": "D0103.txt:199",
   "ko": "「자기소개가 아직이었네요｡ 제 이름은 하도 루리」"
  },
  {
   "id": 390,
   "key": "D0103.txt:203",
   "ko": "「그리고 이쪽은 집사인 윈필드입니다」"
  },
  {
   "id": 391,
   "key": "D0103.txt:209",
   "ko": "「………………」"
  },
  {
   "id": 392,
   "key": "D0103.txt:212",
   "ko": "순간､ 사고가 정지했다｡"
  },
  {
   "id": 393,
   "key": "D0103.txt:215",
   "ko": "="
  },
  {
   "id": 394,
   "key": "D0103.txt:218",
   "ko": "지금､ 뭐라고 했지?"
  },
  {
   "id": 395,
   "key": "D0103.txt:219",
   "ko": "하도 루리?"
  },
  {
   "id": 396,
   "key": "D0103.txt:220",
   "ko": "하도?"
  },
  {
   "id": 397,
   "key": "D0103.txt:223",
   "ko": "――『하도』?"
  },
  {
   "id": 398,
   "key": "D0103.txt:228",
   "ko": "「하도……라니､ 뭐어어어어어어엇!? 서､ 서서서서､ 설마!?」"
  },
  {
   "id": 399,
   "key": "D0103.txt:238",
   "ko": "="
  },
  {
   "id": 400,
   "key": "D0103.txt:243",
   "ko": "그렇게 말하며 건네받은 명함에는 분명히――"
  },
  {
   "id": 401,
   "key": "D0103.txt:245",
   "ko": "『하도 재벌 총수 하도 루리』"
  },
