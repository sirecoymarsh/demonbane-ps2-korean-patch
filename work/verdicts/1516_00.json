{
 "packet": "1516_00",
 "items": [
  {
   "id": 47522,
   "key": "D1516+nya.txt:16",
   "ko": "「자……이 쾌락을 함께……」"
  },
  {
   "id": 47524,
   "key": "D1516+nya.txt:20",
   "ko": "「읏읏!? 크……아아아아아아아아아아아!」"
  },
  {
   "id": 47529,
   "key": "D1516+nya.txt:23",
   "ko": "혼돈에 삼켜져――무너져 간다｡"
  },
  {
   "id": 47530,
   "key": "D1516+nya.txt:25",
   "ko": "세포 단위로 와해되어 간다｡"
  },
  {
   "id": 47535,
   "key": "D1516+nya.txt:26",
   "ko": "원자 단위로 붕괴되어 간다｡"
  },
  {
   "id": 47536,
   "key": "D1516+nya.txt:28",
   "ko": "고체의 껍질이 무너지고､ 영혼이 세계로 확산되어 간다｡"
  },
  {
   "id": 47537,
   "key": "D1516+nya.txt:29",
   "ko": "나라는 존재가､ 멸망당해 간다｡"
  },
  {
   "id": 47541,
   "key": "D1516+nya.txt:32",
   "ko": "하지만､ 그것은 세계의 근원으로 귀환하는 듯한｡"
  },
  {
   "id": 47544,
   "key": "D1516+nya.txt:34",
   "ko": "어머니의 자궁으로 회귀하는 듯한｡"
  },
  {
   "id": 47563,
   "key": "D1516+nya.txt:36",
   "ko": "자신의 모든 것을 내맡겨야만 얻을 수 있는､ 완벽한 안도감｡"
  },
  {
   "id": 47564,
   "key": "D1516+nya.txt:38",
   "ko": "그것은 분명 죽음과도 닮아 있다｡"
  },
  {
   "id": 47566,
   "key": "D1516+nya.txt:41",
   "ko": "――나는､ 다이쥬지 쿠로는､ 나이아라는 여자의 안으로 떨어져､ 녹았다｡"
  },
  {
   "id": 47571,
   "key": "D1516+nya.txt:46",
   "ko": "하지만､ 뒤에 오는 것은､ 안식과는 거리가 먼 지옥임을 알게 된다｡"
  },
  {
   "id": 47572,
   "key": "D1516.txt:24",
   "ko": "여기에는 아무것도 없었다｡"
  },
  {
   "id": 47577,
   "key": "D1516.txt:25",
   "ko": "동시에 가득 차 있었다｡"
  },
  {
   "id": 47579,
   "key": "D1516.txt:27",
   "ko": "허무이며､ 완전한 이곳에서､ 나는 떨어지고 있는 것인가､"
  },
  {
   "id": 47581,
   "key": "D1516.txt:28",
   "ko": "떠 있는 것인가｡"
  },
  {
   "id": 47583,
   "key": "D1516.txt:30",
   "ko": "그조차도 알 수 없다｡"
  },
  {
   "id": 47584,
   "key": "D1516.txt:32",
   "ko": "단서를 찾아 손을 뻗는다｡"
  },
  {
   "id": 47585,
   "key": "D1516.txt:33",
   "ko": "하지만 손끝에는 아무것도 닿지 않고､ 동시에 어디까지고 닿아버린다｡"
  },
  {
   "id": 47588,
   "key": "D1516.txt:35",
   "ko": "무언가를 찾아､ 눈을 부릅뜬다｡"
  },
  {
   "id": 47590,
   "key": "D1516.txt:36",
   "ko": "하지만 빛은커녕 어둠조차 보이지 않고､ 동시에 세계의 끝까지도 꿰뚫어 보고 만다｡"
  },
  {
   "id": 47598,
   "key": "D1516.txt:38",
   "ko": "여기는､ 세계와 자신을 가르는 경계조차 모호하다｡"
  },
  {
   "id": 47599,
   "key": "D1516.txt:39",
   "ko": "여기는､ 혼돈의 정원｡"
  },
  {
   "id": 47602,
   "key": "D1516.txt:41",
   "ko": "……자아의 결계를 강하게 유지해야 한다｡"
  },
  {
   "id": 47604,
   "key": "D1516.txt:42",
   "ko": "이대로라면 세계에 녹아버린다｡"
  },
  {
   "id": 47605,
   "key": "D1516.txt:43",
   "ko": "일렁이는 느슨한 세계 속에서､ 그럼에도 내 의식은 싸움의 격렬함 속에 있었다｡"
  },
  {
   "id": 47608,
   "key": "D1516.txt:48",
   "ko": "「안녕……쿠로 군」"
  },
  {
   "id": 47609,
   "key": "D1516.txt:51",
   "ko": "목소리가 들렸다｡"
  },
  {
   "id": 47613,
   "key": "D1516.txt:52",
   "ko": "급속도로 세계가 결정화된다｡"
  },
  {
   "id": 47614,
   "key": "D1516.txt:63",
   "ko": "검은 태양과 붉은 달이 뜨는 탁한 하늘｡"
  },
  {
   "id": 47615,
   "key": "D1516.txt:64",
   "ko": "정적을 실어 나르는､ 죽음의 냄새를 품은､ 바람｡"
  },
  {
   "id": 47616,
   "key": "D1516.txt:65",
   "ko": "어디까지고 펼쳐진 폐허｡"
  },
  {
   "id": 47617,
   "key": "D1516.txt:67",
   "ko": "고대의 유적처럼､ 그저 인간이 있었다는 것만을 알려주는 이곳은――아컴시티의 황혼의 모습이었다｡"
  },
  {
   "id": 47618,
   "key": "D1516.txt:69",
   "ko": "그리고 내 눈앞에 한 여자가 있다｡"
  },
  {
   "id": 47619,
   "key": "D1516.txt:76",
   "ko": "「나이아……」"
  },
  {
   "id": 47621,
   "key": "D1516.txt:78",
   "ko": "아니､ 저것은 여자가 아니고､ 나이아라는 이름도 아니다｡"
  },
  {
   "id": 47623,
   "key": "D1516.txt:81",
   "ko": "「……니알라토텝」"
  },
  {
   "id": 47624,
   "key": "D1516.txt:83",
   "ko": "여자의 모습이 무너지고､ 어둠빛 혼돈이 꿈틀거린다｡"
  },
  {
   "id": 47627,
   "key": "D1516.txt:84",
   "ko": "어둠 속､ 형형하게 빛나는 눈동자가 나를 붙들고 있었다｡"
  }
 ]
}