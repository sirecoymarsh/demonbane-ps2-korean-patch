  {
   "id": 15184,
   "key": "D0809ru.txt:102",
   "ko": "「…제가 너무 힘이 들어가 있었나 봐요」"
  },
  {
   "id": 15185,
   "key": "D0809ru.txt:107",
   "ko": "="
  },
  {
   "id": 15186,
   "key": "D0809ru.txt:113",
