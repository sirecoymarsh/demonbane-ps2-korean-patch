{
 "packet": "1106_03",
 "items": [
  {
   "id": 24187,
   "key": "D1106al.txt:617",
   "ko": "떨어지는 데몬베인｡"
  },
  {
   "id": 24188,
   "key": "D1106al.txt:618",
   "ko": "바로 아래에는 마침 크라켄이 있었다｡"
  },
  {
   "id": 24189,
   "key": "D1106al.txt:620",
   "ko": "각부 실드의 에너지를 폭렬시킨다｡"
  },
  {
   "id": 24190,
   "key": "D1106al.txt:622",
   "ko": "허공을 차고 데몬베인은 크라켄을 향해"
  },
  {
   "id": 24191,
   "key": "D1106al.txt:623",
   "ko": "급강하한다――!"
  },
  {
   "id": 24192,
   "key": "D1106al.txt:631",
   "ko": "「뭐어어어어어어어―――― 어어어어어엇!?」"
  },
  {
   "id": 24193,
   "key": "D1106al.txt:635",
   "ko": "머리 위를 올려다보는 크라켄｡"
  },
  {
   "id": 24194,
   "key": "D1106al.txt:636",
   "ko": "이제 와서 깨달아 봤자 늦었다고 멍청아아아아아아앗!"
  },
  {
   "id": 24195,
   "key": "D1106al.txt:648",
   "ko": "엄청난 충격이 데몬베인을 덮쳤다｡"
  },
  {
   "id": 24196,
   "key": "D1106al.txt:649",
   "ko": "온몸이 고통을 호소한다｡"
  },
  {
   "id": 24197,
   "key": "D1106al.txt:650",
   "ko": "멀어지는 의식을 어떻게든 붙잡았다｡"
  },
  {
   "id": 24198,
   "key": "D1106al.txt:652",
   "ko": "메인 모니터에는 데몬베인에 깔린 크라켄이 비치고 있다｡"
  },
  {
   "id": 24199,
   "key": "D1106al.txt:659",
   "ko": "「하､ 하는 짓이 엉망진창이로봇､ 달링!」"
  },
  {
   "id": 24200,
   "key": "D1106al.txt:664",
   "ko": "「내 파트너 할 거면 엉망진창인 건 포기해!」"
  },
  {
   "id": 24201,
   "key": "D1106al.txt:667",
   "ko": "애초에 엉망진창으로 못 하면 데우스 마키나를 이길 수 있겠냐……!"
  },
  {
   "id": 24202,
   "key": "D1106al.txt:668",
   "ko": "그래､ 이게 절호의 찬스다!"
  },
  {
   "id": 24203,
   "key": "D1106al.txt:670",
   "ko": "데몬베인의 몸을 일으켜 크라켄에 올라탄 자세로 나는 오른손바닥을 내리친다!"
  },
  {
   "id": 24204,
   "key": "D1106al.txt:678",
   "ko": "「히라니프라 시스템､ 액세스! 레무리아아아아아……!」"
  },
  {
   "id": 24205,
   "key": "D1106al.txt:684",
   "ko": "「나……나……나를 바보 취급 하지 마라아아아아아앗!」"
  },
  {
   "id": 24206,
   "key": "D1106al.txt:688",
   "ko": "「――!? 달링! 떨어지로봇!」"
  },
  {
   "id": 24207,
   "key": "D1106al.txt:694",
   "ko": "「뭐――!」"
  },
  {
   "id": 24208,
   "key": "D1106al.txt:702",
   "ko": "엘자의 외침과 오한이 스치는 것은 동시였다｡"
  },
  {
   "id": 24209,
   "key": "D1106al.txt:703",
   "ko": "크라켄 위에서 뛰어 물러나기보다 빠르게"
  },
  {
   "id": 24210,
   "key": "D1106al.txt:704",
   "ko": "놈에게서 발산된 에너지가 충격이 되어"
  },
  {
   "id": 24211,
   "key": "D1106al.txt:705",
   "ko": "데몬베인을 날려버린다｡"
  },
  {
   "id": 24213,
   "key": "D1106al.txt:709",
   "ko": "「큿……!?」"
  },
  {
   "id": 24214,
   "key": "D1106al.txt:719",
   "ko": "등부터 지면에 내동댕이쳐졌지만 곧바로 몸을 일으킨다｡"
  },
  {
   "id": 24215,
   "key": "D1106al.txt:724",
   "ko": "시선 앞에는 마력의 필드에 둘러싸인"
  },
  {
   "id": 24216,
   "key": "D1106al.txt:725",
   "ko": "크라켄이 서 있었다｡"
  },
  {
   "id": 24217,
   "key": "D1106al.txt:726",
   "ko": "마력 장벽인가! 젠장……방심했다!"
  },
  {
   "id": 24218,
   "key": "D1106al.txt:731",
   "ko": "「그르브아아아아 아아아아아아아아!」"
  },
  {
   "id": 24219,
   "key": "D1106al.txt:735",
   "ko": "칼리굴라의 분노의 포효와 함께 크라켄의 마력이 폭발적으로 증대되어 간다｡"
  },
  {
   "id": 24220,
   "key": "D1106al.txt:736",
   "ko": "아무런 기교도 없는 순수한 힘의 파동이 대기를 부르르 떨게 했다｡"
  },
  {
   "id": 24221,
   "key": "D1106al.txt:738",
   "ko": "이놈은 좀……위험하군｡"
  },
  {
   "id": 24222,
   "key": "D1106al.txt:739",
   "ko": "아까의 일격으로 마술 회로 일부에 혼란이 생겼어｡"
  },
  {
   "id": 24223,
   "key": "D1106al.txt:742",
   "ko": "「칫……역시 반응이 둔해!」"
  },
  {
   "id": 24224,
   "key": "D1106al.txt:745",
   "ko": "시스템이 제대로 복귀할 때까지"
  },
  {
   "id": 24227,
   "key": "D1106al.txt:746",
   "ko": "시간이 걸릴 것 같다｡"
  },
  {
   "id": 24228,
   "key": "D1106al.txt:747",
   "ko": "저 정도 마력에서 뿜어지는 공격을"
  },
  {
   "id": 24229,
   "key": "D1106al.txt:748",
   "ko": "지금 상태로 피할 수 있을까?"
  }
 ]
