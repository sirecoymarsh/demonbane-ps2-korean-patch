{
 "packet": "ep_ruri02a_08",
 "items": [
  {
   "id": 50853,
   "key": "ep_ruri02a.txt:1009",
   "ko": "지금､ 이 한순간만은､ 다이쥬지 쿠로로 돌아가는 것을 허락받고 싶다｡"
  },
  {
   "id": 50854,
   "key": "ep_ruri02a.txt:1010",
   "ko": "왜냐하면 그 녀석은､ 너와의 약속을 깬 것을､ 몹시 마음에 두고 있었으니까｡"
  },
  {
   "id": 50855,
   "key": "ep_ruri02a.txt:1011",
   "ko": "그리고 마침내､ 약속을 지킬 때가 찾아왔으니까｡"
  },
  {
   "id": 50856,
   "key": "ep_ruri02a.txt:1017",
   "ko": "그러니――지금만은―― 어머니 품에 안겨――아무것도 모른 채 웃는 너에게――"
  },
  {
   "id": 50857,
   "key": "ep_ruri02a.txt:1021",
   "ko": "「태어나 줘서､ 고맙다」 그런 감사와 함께――"
  },
  {
   "id": 50858,
   "key": "ep_ruri02a.txt:1024",
   "ko": "그때의 약속을 지키는､ 그 말을――"
  },
  {
   "id": 50859,
   "key": "ep_ruri02a.txt:1026",
   "ko": "내､ 소중한 공주님에게―― 「다녀왔다､ 루리」"
  },
  {
   "id": 50860,
   "key": "ep_ruri02a.txt:1045",
   "ko": "스스로의 몸을 끌어안고……나는 또다시 울음을 터뜨리고 있었다｡"
  },
  {
   "id": 50861,
   "key": "ep_ruri02a.txt:1046",
   "ko": "하지만､ 이번엔 절망의 눈물이 아니다｡"
  },
  {
   "id": 50862,
   "key": "ep_ruri02a.txt:1047",
   "ko": "슬프지만､ 괴롭지만､ 그래도 기쁨으로 가득한､ 감사의 눈물이었다｡"
  },
  {
   "id": 50863,
   "key": "ep_ruri02a.txt:1052",
   "ko": "그분은――약속을 지켜 주셨다｡"
  },
  {
   "id": 50864,
   "key": "ep_ruri02a.txt:1053",
   "ko": "아주 오래오래전에､ 이미 약속을 지켜 주셨던 것이다｡"
  },
  {
   "id": 50865,
   "key": "ep_ruri02a.txt:1055",
   "ko": "그리고､ 지켜 주고 계셨다｡"
  },
  {
   "id": 50866,
   "key": "ep_ruri02a.txt:1056",
   "ko": "오래오래､ 나를 계속 지켜 주셨다｡"
  },
  {
   "id": 50867,
   "key": "ep_ruri02a.txt:1057",
   "ko": "그분은､ 내가 태어난 뒤로､ 줄곧 지켜 주셨다｡"
  },
  {
   "id": 50868,
   "key": "ep_ruri02a.txt:1058",
   "ko": "할아버님은､ 돌아가신 뒤에도 줄곧､ 나를 계속 지켜 주셨다｡"
  },
  {
   "id": 50869,
   "key": "ep_ruri02a.txt:1060",
   "ko": "아아､ 지금이라면 말할 수 있다｡"
  },
  {
   "id": 50870,
   "key": "ep_ruri02a.txt:1061",
   "ko": "겨우 말할 수 있다｡ 그분에게｡"
  },
  {
   "id": 50871,
   "key": "ep_ruri02a.txt:1063",
   "ko": "상처투성이인 그분에게｡ 그럼에도 계속 싸운 그분에게｡"
  },
  {
   "id": 50872,
   "key": "ep_ruri02a.txt:1065",
   "ko": "오래오래､ 말하고 싶었던､ 그 말을｡"
  },
  {
   "id": 50873,
   "key": "ep_ruri02a.txt:1066",
   "ko": "오래오래､ 가슴에 품어 온､ 그 말을｡ 지금､ 마침내――"
  },
  {
   "id": 50874,
   "key": "ep_ruri02a.txt:1078",
   "ko": "스러져 가는 빛의 티끌에､ 비추어지며――"
  },
  {
   "id": 50875,
   "key": "ep_ruri02a.txt:1079",
   "ko": "스러져 가는 알의 잔재에､ 비추어지며――"
  },
  {
   "id": 50876,
   "key": "ep_ruri02a.txt:1080",
   "ko": "그､ 말을､ 「미안했노라……이 몸 탓에」"
  },
  {
   "id": 50877,
   "key": "ep_ruri02a.txt:1091",
   "ko": "갈라지는 듯한 속삭임｡"
  },
  {
   "id": 50878,
   "key": "ep_ruri02a.txt:1092",
   "ko": "하지만､ 분명히､ 똑똑히､ 이 귀로 들었다｡"
  },
  {
   "id": 50879,
   "key": "ep_ruri02a.txt:1094",
   "ko": "그 찰나｡ 나는､ 알의､ 마음을 알았다｡"
  },
  {
   "id": 50880,
   "key": "ep_ruri02a.txt:1105",
   "ko": "빛이､ 사라지고､……､――､ 「――아직이에요」"
  },
  {
   "id": 50881,
   "key": "ep_ruri02a.txt:1114",
   "ko": "그래､ 아직｡ 아직이다｡"
  },
  {
   "id": 50882,
   "key": "ep_ruri02a.txt:1116",
   "ko": "그 말을 하는 건､ 옳지 않다｡"
  },
  {
   "id": 50883,
   "key": "ep_ruri02a.txt:1117",
   "ko": "스러져 가는 것도､ 잘못됐다｡ 「아직､ 끝나지 않았어요」"
  },
  {
   "id": 50884,
   "key": "ep_ruri02a.txt:1127",
   "ko": "끝나지 않았다｡"
  },
  {
   "id": 50885,
   "key": "ep_ruri02a.txt:1128",
   "ko": "아직､ 아무것도 끝나지 않았다｡"
  },
  {
   "id": 50886,
   "key": "ep_ruri02a.txt:1129",
   "ko": "끝났다고 여기는 건､ 내 시간에서 보고 있으니까｡"
  },
  {
   "id": 50887,
   "key": "ep_ruri02a.txt:1130",
   "ko": "내 주관에 지나지 않으니까｡"
  },
  {
   "id": 50888,
   "key": "ep_ruri02a.txt:1132",
   "ko": "지금､ 이 괴이의 한복판에서……시간도 공간도 초월한 괴이 속에 있으면서､ 요그 소토스의 단말에 닿아 있으면서､ 그런 시점에 무슨 의미가 있을까?"
  },
  {
   "id": 50889,
   "key": "ep_ruri02a.txt:1134",
   "ko": "이제부터다｡ 운명을 바꾸는 건､ 이제부터다｡"
  },
  {
   "id": 50890,
   "key": "ep_ruri02a.txt:1136",
   "ko": "지금이라면……이런 기적에 감싸인 지금이라면､ 이 영원을 끝낼 수 있다……!"
  },
  {
   "id": 50891,
   "key": "ep_ruri02a.txt:1142",
   "ko": "「알! 계약을! 다시 한번､ 당신과의 계약을 바랍니다!」"
  },
  {
   "id": 50892,
   "key": "ep_ruri02a.txt:1145",
   "ko": "스러져 가는 빛은､"
  }
 ]
}