{
 "packet": "0204_02",
 "items": [
  {
   "id": 1835,
   "key": "D0204.txt:517",
   "ko": "「뭐냐､ 이자들은? 안색이 싹 변하여서는?」"
  },
  {
   "id": 1836,
   "key": "D0204.txt:523",
   "ko": "「너……돈이란 거 알아? 머니」"
  },
  {
   "id": 1837,
   "key": "D0204.txt:531",
   "ko": "「무례하구나｡ 이 몸을 시대에 뒤떨어진 세상 물정 모르는 마도서로 여기느냐」 「애초에 이 몸이 집필되던 무렵엔 이미 화폐의 개념이 존재하였느니라」"
  },
  {
   "id": 1838,
   "key": "D0204.txt:539",
   "ko": "「그럼 좀 내라고!? 물건을 샀으면!?」"
  },
  {
   "id": 1839,
   "key": "D0204.txt:544",
   "ko": "「받았다고 말하고 있지 않느냐」"
  },
  {
   "id": 1840,
   "key": "D0204.txt:549",
   "ko": "「네 눈에는 저 분노한 아저씨들 모습이 안 보이냐!」"
  },
  {
   "id": 1841,
   "key": "D0204.txt:557",
   "ko": "「흥｡ 아무래도 이토록 사랑스러운 이 몸에게 흑심을 품었던 모양이다만……안됐구나｡ 먹을 것 따위에 낚일 이 알 아지프가 아니니라!」"
  },
  {
   "id": 1842,
   "key": "D0204.txt:562",
   "ko": "「너､ 그렇게 제멋대로인 해석만으로 세상 살아갈 셈이냐!?」"
  },
  {
   "id": 1843,
   "key": "D0204.txt:570",
   "ko": "「어쩔 수 없구마……우리가 아가씨들한테 세상 무서운 걸 가르쳐 주꾸마」"
  },
  {
   "id": 1844,
   "key": "D0204.txt:575",
   "ko": "「형씨도 각오하그라!」"
  },
  {
   "id": 1845,
   "key": "D0204.txt:580",
   "ko": "「그러니까 오빠 아니라니까! 상관없는 사이라고!」"
  },
  {
   "id": 1846,
   "key": "D0204.txt:585",
   "ko": "「문답무용이다아아아아!」"
  },
  {
   "id": 1847,
   "key": "D0204.txt:599",
   "ko": "「흥! 짖지 마라､ 인간!」"
  },
  {
   "id": 1848,
   "key": "D0204.txt:620",
   "ko": "「그부오오오오!?」 「뭐､ 뭐야아아아!」"
  },
  {
   "id": 1849,
   "key": "D0204.txt:630",
   "ko": "해､ 해버렸어……이 녀석｡"
  },
  {
   "id": 1850,
   "key": "D0204.txt:639",
   "ko": "「마기우스의 힘을 쓸 것까지도 없다｡ 네놈들 같은 잡것들､ 이 몸이 한꺼번에 처리해 주마」"
  },
  {
   "id": 1851,
   "key": "D0204.txt:642",
   "ko": "「이 최강의 마도서 알 아지프에게 대든 것､ 후회하거라!」 「이봐 이봐 이봐! 더는……!」"
  },
  {
   "id": 1852,
   "key": "D0204.txt:652",
   "ko": "「우､ 우습게 보지 마라아아､ 이 빌어먹을 꼬맹이가아아아!」"
  },
  {
   "id": 1853,
   "key": "D0204.txt:661",
   "ko": "="
  },
  {
   "id": 1854,
   "key": "D0204.txt:679",
   "ko": "="
  },
  {
   "id": 1855,
   "key": "D0204.txt:684",
   "ko": "「아와와와와와……」"
  },
  {
   "id": 1856,
   "key": "D0204.txt:724",
   "ko": "……대참사였다｡"
  },
  {
   "id": 1857,
   "key": "D0204.txt:727",
   "ko": "유탄 아닌 유탄 충격파가 건물을 분쇄하고 폭염이 휘몰아치며､ 사람들은 비명을 지르며 도망친다｡ 아비규환의 지옥이었다｡"
  },
  {
   "id": 1858,
   "key": "D0204.txt:736",
   "ko": "「살…살려줘…… 갸아아아아아――!」"
  },
  {
   "id": 1859,
   "key": "D0204.txt:745",
   "ko": "「아――하하하하하! 하하하하하! 하――하하하하하!」"
  },
  {
   "id": 1860,
   "key": "D0204.txt:753",
   "ko": "사악했다｡ 흉악했다｡"
  },
  {
   "id": 1861,
   "key": "D0204.txt:754",
   "ko": "일단 『블랙로지』를 두고 이러쿵저러쿵할 처지는 아니었다｡"
  },
  {
   "id": 1862,
   "key": "D0204.txt:763",
   "ko": "「……응?」"
  },
  {
   "id": 1863,
   "key": "D0204.txt:766",
   "ko": "사이렌 소리다｡"
  },
  {
   "id": 1864,
   "key": "D0204.txt:767",
   "ko": "점점 가까워지고 있다……어､ 설마!"
  },
  {
   "id": 1865,
   "key": "D0204.txt:782",
   "ko": "「우오오오오!? 뭐야､ 이건!?」"
  },
  {
   "id": 1866,
   "key": "D0204.txt:791",
   "ko": "「겨､ 경찰이다! 거기 난동 부리는 여자! 저항을 멈추고 얌전히 투항해라! 그러지 않으면――」"
  },
  {
   "id": 1867,
   "key": "D0204.txt:799",
   "ko": "「경찰 왔다아아아아――――――――!?」"
  },
  {
   "id": 1868,
   "key": "D0204.txt:804",
   "ko": "「새로운 놈이냐!? 썩 물러가라!」"
  },
  {
   "id": 1869,
   "key": "D0204.txt:816",
   "ko": "「누오아아아아아아아아!?」 「갸아아아아아아아아!」"
  },
  {
   "id": 1870,
   "key": "D0204.txt:838",
   "ko": "「최악이다아아아아아아――――!」"
  },
  {
   "id": 1871,
   "key": "D0204.txt:848",
   "ko": "「윽……오､ 오､ 오……으윽」"
  },
  {
   "id": 1872,
   "key": "D0204.txt:853",
   "ko": "「커헉…… 체､ 체､ 체…………!」"
  },
  {
   "id": 1873,
   "key": "D0204.txt:860",
   "ko": "아아……이제 아무리 발버둥 쳐도 변명은 통하지 않겠지｡ 어쩌면 좋을까……｡"
  },
  {
   "id": 1874,
   "key": "D0204.txt:863",
   "ko": "뭐､ 어쨌든―― 「체､ 체､ 체…… 체포다아아아아아아아!」"
  }
 ]
