{
 "packet": "0756_01",
 "items": [
  {
   "id": 11669,
   "key": "D0756.txt:243",
   "ko": "「――――――」"
  },
  {
   "id": 11670,
   "key": "D0756.txt:246",
   "ko": "역시｡"
  },
  {
   "id": 11671,
   "key": "D0756.txt:247",
   "ko": "그런데､ 어떻게 된 거지?"
  },
  {
   "id": 11672,
   "key": "D0756.txt:252",
   "ko": "「기억에 없어……붙잡혀 간 뒤로는 지독하게 흐릿해서｡ 크투가랑 이타콰를 만난 것 같기도 한데……꿈일지도 모르고」"
  },
  {
   "id": 11673,
   "key": "D0756.txt:261",
   "ko": "「흠……뭐､ 좋다｡ 결과적으로는 모든 것이 잘 풀렸느니라」"
  },
  {
   "id": 11674,
   "key": "D0756.txt:274",
   "ko": "그리 말하며､ 손에 쥔 단편을 빛으로 바꾼다｡ 빛은 두 줄기 궤적을 나선으로 그리며､ 알의 가슴으로 빨려 들어간다｡"
  },
  {
   "id": 11675,
   "key": "D0756.txt:282",
   "ko": "「이타콰의 힘을 되찾고､ 크투가도 다시 이 몸의 곁으로 돌아왔다｡ 허나……또 하도가 만든 마도병기에 기대는 건 그만두는 편이 좋겠구나｡ 이번과 같은 꼴이 될지도 모르니」"
  },
  {
   "id": 11676,
   "key": "D0756.txt:288",
   "ko": "「그래……」"
  },
  {
   "id": 11677,
   "key": "D0756.txt:292",
   "ko": "석연치 않은 기분을 느끼면서도､ 일단 고개를 끄덕였다｡"
  },
  {
   "id": 11678,
   "key": "D0756.txt:295",
   "ko": "확실히､ 전부 원만하게 마무리됐다｡"
  },
  {
   "id": 11679,
   "key": "D0756.txt:296",
   "ko": "남은 수수께끼는 너무 많지만――"
  },
  {
   "id": 11680,
   "key": "D0756.txt:305",
   "ko": "「슬슬 하도의 무리가 데리러 올 게다｡ 어떠냐､ 일어설 수 있겠느냐?」"
  },
  {
   "id": 11681,
   "key": "D0756.txt:311",
   "ko": "「아､ 아아……그럭저럭……아얏!」"
  },
  {
   "id": 11682,
   "key": "D0756.txt:315",
   "ko": "몸을 일으키려고 두 손을 바닥에 짚다가……손등에 번진 통증에 나도 모르게､ 얼굴을 찡그린다｡"
  },
  {
   "id": 11683,
   "key": "D0756.txt:324",
   "ko": "「무슨 일이냐? 역시 힘든 게냐?」"
  },
  {
   "id": 11684,
   "key": "D0756.txt:330",
   "ko": "「그게 아니라……방금､ 손에 통증이……」"
  },
  {
   "id": 11685,
   "key": "D0756.txt:334",
   "ko": "대답하면서､ 손등을 본다｡"
  },
  {
   "id": 11686,
   "key": "D0756.txt:335",
   "ko": "그러자――"
  },
  {
   "id": 11687,
   "key": "D0756.txt:340",
   "ko": "「……뭐야､ 이건?」"
  },
  {
   "id": 11688,
   "key": "D0756.txt:350",
   "ko": "양손 등에 상처 자국이 있었다｡"
  },
  {
   "id": 11689,
   "key": "D0756.txt:351",
   "ko": "그냥 상처 자국이 아니다｡"
  },
  {
   "id": 11690,
   "key": "D0756.txt:353",
   "ko": "그것은……그 형태는､ 분명 어떤 의미를 지니고 있었다｡"
  },
  {
   "id": 11691,
   "key": "D0756.txt:355",
   "ko": "오른손 등｡"
  },
  {
   "id": 11692,
   "key": "D0756.txt:356",
   "ko": "인두를 갖다 댄 듯한 화상 자국｡"
  },
  {
   "id": 11693,
   "key": "D0756.txt:357",
   "ko": "생생하게 짓무른 붉은빛이､ 문양을 그리고 있었다｡"
  },
  {
   "id": 11694,
   "key": "D0756.txt:360",
   "ko": "이건 분명 『불』을 뜻하는 마술 문양｡"
  },
  {
   "id": 11695,
   "key": "D0756.txt:361",
   "ko": "화염의 낙인이다｡"
  },
  {
   "id": 11696,
   "key": "D0756.txt:364",
   "ko": "그리고 왼손 등｡"
  },
  {
   "id": 11697,
   "key": "D0756.txt:365",
   "ko": "깊게 새겨진 베인 상처｡"
  },
  {
   "id": 11698,
   "key": "D0756.txt:366",
   "ko": "피가 흐르지는 않지만､ 상처는 벌어진 채였다｡"
  },
  {
   "id": 11699,
   "key": "D0756.txt:369",
   "ko": "『바람』을 뜻하는 마술 문양｡"
  },
  {
   "id": 11700,
   "key": "D0756.txt:370",
   "ko": "바람의 각인이다｡"
  },
  {
   "id": 11701,
   "key": "D0756.txt:379",
   "ko": "「그건……?」"
  },
  {
   "id": 11702,
   "key": "D0756.txt:384",
   "ko": "모르겠다｡"
  },
  {
   "id": 11703,
   "key": "D0756.txt:385",
   "ko": "나는 고개를 가로저었다｡"
  },
  {
   "id": 11704,
   "key": "D0756.txt:387",
   "ko": "하지만 짐작은 할 수 있다｡"
  },
  {
   "id": 11705,
   "key": "D0756.txt:389",
   "ko": "불과 바람｡"
  },
  {
   "id": 11706,
   "key": "D0756.txt:390",
   "ko": "설마――크투가와 이타콰인가?"
  },
  {
   "id": 11707,
   "key": "D0756.txt:394",
   "ko": "알이 즐거운 듯한､ 아니면 반대로 언짢은 듯한､ 그런 미묘한 표정을 지었다｡"
  },
  {
   "id": 11708,
   "key": "D0756.txt:401",
   "ko": "「어째서인지는 모르겠으나､ 아무래도 어지간히 마음에 든 모양이로구나｡ 이래서야 다음에 소환할 땐 순순히 따라 줄지도 모르겠다」"
  }
 ]
}