{
 "packet": "0403_00",
 "items": [
  {
   "id": 4464,
   "key": "D0403.txt:32",
   "ko": "……지쳤다｡"
  },
  {
   "id": 4465,
   "key": "D0403.txt:33",
   "ko": "주로 정신적으로 완전히 지쳐 버렸다｡"
  },
  {
   "id": 4466,
   "key": "D0403.txt:36",
   "ko": "뭐랄까…… 저렇게 사는 세계가 전혀 다른 것 같은 사람들과 잘 지낼 수 있을지｡"
  },
  {
   "id": 4467,
   "key": "D0403.txt:38",
   "ko": "아니､ 메이드씨들의 저 강 건너편까지 다 건너가 버린 텐션은 사는 세계가 어떻고 할 차원의 문제가 아닌 것 같지만｡"
  },
  {
   "id": 4468,
   "key": "D0403.txt:42",
   "ko": "……어쨌든 이제 돌이킬 수는 없다｡"
  },
  {
   "id": 4469,
   "key": "D0403.txt:43",
   "ko": "정식으로､ 완전히､ 『블랙로지』에 싸움을 거는 세력의 일원이 됐다｡ 해주겠어｡"
  },
  {
   "id": 4470,
   "key": "D0403.txt:47",
   "ko": "끝까지 해주고말고!"
  },
  {
   "id": 4471,
   "key": "D0403.txt:62",
   "ko": "「……이렇게 기합을 넣어 봤자 지금으로선 헛스윙만 하고 있는 셈이지만」"
  },
  {
   "id": 4472,
   "key": "D0403.txt:66",
   "ko": "하도의 공주님에게 의뢰받을 것도 없이 페이지 찾기는 이미 시작했다｡"
  },
  {
   "id": 4473,
   "key": "D0403.txt:69",
   "ko": "하지만 아틀락 나차를 회수한 뒤 오늘까지 페이지 몬스터가 얽혀 있을 법한 괴사건의 기미는 없다｡"
  },
  {
   "id": 4474,
   "key": "D0403.txt:79",
   "ko": "「그리 요란한 움직임은 일어나지 않느니라」"
  },
  {
   "id": 4476,
   "key": "D0403.txt:88",
   "ko": "「애초에 실체화한 단편이 적은 게지｡ 이 몸에게서 막 떨어져 나온 단편은 그저 망망한 힘의 덩어리에 지나지 않는다」"
  },
  {
   "id": 4477,
   "key": "D0403.txt:92",
   "ko": "「거기서 제 성질과 그 자리에 소용돌이치는 상념에 맞추어 형상을 이루어 간다…… 시간이 걸리는 법이니라」"
  },
  {
   "id": 4478,
   "key": "D0403.txt:98",
   "ko": "「……과연」 뭐､ 납득은 간다｡"
  },
  {
   "id": 4479,
   "key": "D0403.txt:108",
   "ko": "납득은 가지만…… 초조하다｡"
  },
  {
   "id": 4480,
   "key": "D0403.txt:111",
   "ko": "이러고 있는 사이에도 그 황금빛 괴물이 기고만장해 있을 걸 생각하면 오장육부가 뒤집힌다｡"
  },
  {
   "id": 4481,
   "key": "D0403.txt:115",
   "ko": "하루라도 빨리 힘을 손에 넣어 그놈을――!"
  },
  {
   "id": 4482,
   "key": "D0403.txt:124",
   "ko": "「달아오르지 마라」"
  },
  {
   "id": 4483,
   "key": "D0403.txt:129",
   "ko": "「……읏」"
  },
  {
   "id": 4484,
   "key": "D0403.txt:134",
   "ko": "「이 몸이 완전해진들 그대의 힘이 미치지 못하면 아무 의미도 없다｡ 먼저 제 힘을､ 지식을､ 술을 갈고닦아라｡ 그것이 가장 빠른 지름길이니라」"
  },
  {
   "id": 4485,
   "key": "D0403.txt:141",
   "ko": "「아아……」"
  },
  {
   "id": 4486,
   "key": "D0403.txt:145",
   "ko": "……확실히 초조해해 봐야 소용없다｡"
  },
  {
   "id": 4487,
   "key": "D0403.txt:146",
   "ko": "그래｡ 그렇지｡"
  },
  {
   "id": 4488,
   "key": "D0403.txt:147",
   "ko": "아무래도 너무 달아오른 모양이다｡"
  },
  {
   "id": 4489,
   "key": "D0403.txt:150",
   "ko": "조금 마음을 가라앉히자｡"
  },
  {
   "id": 4490,
   "key": "D0403.txt:151",
   "ko": "의욕도 지나치면 독이 될 뿐이다｡"
  },
  {
   "id": 4491,
   "key": "D0403.txt:154",
   "ko": "끊임없이 생각하고 끊임없이 실천한다｡"
  },
  {
   "id": 4492,
   "key": "D0403.txt:155",
   "ko": "스스로를 강철처럼 계속 벼린다｡"
  },
  {
   "id": 4493,
   "key": "D0403.txt:157",
   "ko": "언제 어떤 때에 괴이와 마주하더라도 결코 겁먹지 않도록｡ 물러서지 않도록｡"
  },
  {
   "id": 4494,
   "key": "D0403.txt:160",
   "ko": "중요한 건 그거다｡"
  },
  {
   "id": 4495,
   "key": "D0403.txt:161",
   "ko": "그러니까――"
  },
  {
   "id": 4496,
   "key": "D0403.txt:182",
   "ko": "「배가 고파선 싸움을 못 하는 법｡ 늘 임전 태세를 갖춰 둔다는 뜻에서」"
  },
  {
   "id": 4497,
   "key": "D0403.txt:187",
   "ko": "「밥」"
  },
  {
   "id": 4498,
   "key": "D0403.txt:199",
   "ko": "「와아― 변함없는 안하무인이 단숨에 2배로 대증식이다아―」"
  },
  {
   "id": 4499,
   "key": "D0403.txt:205",
   "ko": "실례로군｡"
  },
  {
   "id": 4500,
   "key": "D0403.txt:206",
   "ko": "나랑 이 녀석을 한 묶음으로 취급하다니｡"
  },
  {
   "id": 4501,
   "key": "D0403.txt:216",
   "ko": "「밥벌레―! 뿌리 없는 풀―! 기생충―! 기둥서방―! 제비족―! 인간 실격―!」"
  },
  {
   "id": 4502,
   "key": "D0403.txt:223",
   "ko": "몰아붙이는 듯한 욕설의 무호흡 연타｡"
  },
  {
   "id": 4503,
   "key": "D0403.txt:224",
   "ko": "역시나군､ 시스터｡ 변함없이 사정없다｡"
  },
  {
   "id": 4504,
   "key": "D0403.txt:228",
   "ko": "하지만､ 그러나!"
  }
 ]
}