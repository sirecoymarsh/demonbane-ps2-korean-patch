{
 "packet": "0716_01",
 "items": [
  {
   "id": 11228,
   "key": "D0716.txt:264",
   "ko": "「……………………」"
  },
  {
   "id": 11229,
   "key": "D0716.txt:271",
   "ko": "침묵이 옥좌의 방을 감싼다｡ 마스터 테리온은 눈을 감고､ 온화한 표정으로 말을 이었다｡"
  },
  {
   "id": 11230,
   "key": "D0716.txt:278",
   "ko": "「걱정이 많구나｡ 우리 패에는 『무녀』와 중추 유닛도 있지 않느냐……」"
  },
  {
   "id": 11231,
   "key": "D0716.txt:312",
   "ko": "그때､ 승원을 격렬한 진동이 덮쳤다｡"
  },
  {
   "id": 11232,
   "key": "D0716.txt:313",
   "ko": "갑작스러운 사태에 승원 안은 소란스러워진다｡"
  },
  {
   "id": 11233,
   "key": "D0716.txt:318",
   "ko": "「무슨 일이냐! 무슨 일이 있었느냐!」"
  },
  {
   "id": 11234,
   "key": "D0716.txt:325",
   "ko": "옥좌의 방에 신도 하나가 들어와 보고했다｡"
  },
  {
   "id": 11235,
   "key": "D0716.txt:332",
   "ko": "「보､ 보고드립니다! 승､ 승원 최하층의 구속 결계 감옥을 부수고､ 죄인이……『폭군』이 탈옥했습니다!」"
  },
  {
   "id": 11236,
   "key": "D0716.txt:340",
   "ko": "「――――――읏!」"
  },
  {
   "id": 11237,
   "key": "D0716.txt:345",
   "ko": "「뭐라고!?」"
  },
  {
   "id": 11238,
   "key": "D0716.txt:351",
   "ko": "「……마스터」"
  },
  {
   "id": 11239,
   "key": "D0716.txt:356",
   "ko": "보고를 받은 일동 사이에 충격이 번진다｡"
  },
  {
   "id": 11240,
   "key": "D0716.txt:357",
   "ko": "하지만 마스터 테리온은 태연한 모습으로､ 옅은 미소마저 띠고 있었다｡"
  },
  {
   "id": 11241,
   "key": "D0716.txt:362",
   "ko": "「호오……『폭군』이 움직였는가」"
  },
  {
   "id": 11242,
   "key": "D0716.txt:375",
   "ko": "나는 세계를 안다｡"
  },
  {
   "id": 11243,
   "key": "D0716.txt:376",
   "ko": "운명을 안다｡"
  },
  {
   "id": 11244,
   "key": "D0716.txt:377",
   "ko": "절망을 안다｡"
  },
  {
   "id": 11245,
   "key": "D0716.txt:380",
   "ko": "세계가 무한한 뱀의 정원에 갇혀 있음을 안다｡"
  },
  {
   "id": 11246,
   "key": "D0716.txt:383",
   "ko": "운명이 뒤틀리고 일그러진 고리 안에 있음을 안다｡"
  },
  {
   "id": 11247,
   "key": "D0716.txt:386",
   "ko": "절망은､ 결코 다다를 수 없는 미래와 그것을 알지 못하는 자들에게 있음을 안다｡"
  },
  {
   "id": 11248,
   "key": "D0716.txt:395",
   "ko": "끝을 알 수 없는 영겁｡"
  },
  {
   "id": 11249,
   "key": "D0716.txt:396",
   "ko": "헤아릴 수 없는 영겁｡"
  },
  {
   "id": 11250,
   "key": "D0716.txt:397",
   "ko": "기이한 영겁｡"
  },
  {
   "id": 11251,
   "key": "D0716.txt:400",
   "ko": "고리를 부리는 짐승조차 사로잡혀 벗어날 수 없는 이 뇌옥에서､"
  },
  {
   "id": 11252,
   "key": "D0716.txt:401",
   "ko": "그런데도 나를 몰아세우는 것이 있음은 어째서 어째서 어째서｡"
  },
  {
   "id": 11253,
   "key": "D0716.txt:404",
   "ko": "――아아､ 그렇다｡"
  },
  {
   "id": 11254,
   "key": "D0716.txt:407",
   "ko": "그가 있기 때문이다｡"
  },
  {
   "id": 11255,
   "key": "D0716.txt:411",
   "ko": "그 또한 무한의 죄수에 지나지 않는다｡"
  },
  {
   "id": 11256,
   "key": "D0716.txt:412",
   "ko": "무한의 노예에 지나지 않는다｡"
  },
  {
   "id": 11257,
   "key": "D0716.txt:413",
   "ko": "무한의 광대에 지나지 않는다｡"
  },
  {
   "id": 11258,
   "key": "D0716.txt:416",
   "ko": "그럼에도 그는 오랜 세월､ 헤매는 일 없이 계속 싸운다｡"
  },
  {
   "id": 11259,
   "key": "D0716.txt:419",
   "ko": "그것은 세계를 알지 못하기 때문인가｡"
  },
  {
   "id": 11260,
   "key": "D0716.txt:420",
   "ko": "운명을 알지 못하기 때문인가｡"
  },
  {
   "id": 11261,
   "key": "D0716.txt:421",
   "ko": "절망을 알지 못하기 때문인가｡"
  },
  {
   "id": 11262,
   "key": "D0716.txt:429",
   "ko": "그럴지도 모른다｡ 허나 정말 그것뿐일까｡"
  },
  {
   "id": 11263,
   "key": "D0716.txt:433",
   "ko": "그렇다면 어찌하여､ 그는 지금도 여전히 존재하는가?"
  },
  {
   "id": 11264,
   "key": "D0716.txt:437",
   "ko": "이 무한한 연옥에서 마를 끊는 의지는 사라져 갔다｡"
  },
  {
   "id": 11265,
   "key": "D0716.txt:438",
   "ko": "사라졌다는 것조차 알지 못한 채 사라져 갔다｡"
  },
  {
   "id": 11266,
   "key": "D0716.txt:441",
   "ko": "문의 열쇠의 아이들을 막은 현자의 힘은 닿지 않으리라｡"
  },
  {
   "id": 11267,
   "key": "D0716.txt:444",
   "ko": "세라에노의 지식을 부리는 눈먼 현자는 어디에 봉인되어 있는가｡"
  }
 ]
}