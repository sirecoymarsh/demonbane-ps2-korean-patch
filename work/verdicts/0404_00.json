  {
   "id": 4651,
   "key": "D0404.txt:28",
   "ko": "="
  },
  {
   "id": 4652,
   "key": "D0404.txt:34",
   "ko": "「어머 싫어라……이것도 저주 아닐까요?」"
  },
  {
   "id": 4653,
   "key": "D0404.txt:45",
   "ko": "="
  },
  {
   "id": 4654,
   "key": "D0404.txt:51",
   "ko": "="
  },
  {
   "id": 4655,
   "key": "D0404.txt:58",
   "ko": "――믿을 수 있는 사람은 없다｡"
  },
  {
   "id": 4656,
   "key": "D0404.txt:64",
   "ko": "「여보……저､ 싫어요｡ 저런 섬뜩한 애를 맡다니」"
  },
  {
   "id": 4657,
   "key": "D0404.txt:72",
   "ko": "부모를 사고로 잃고 친척 집을 전전했다｡"
  },
  {
   "id": 4658,
   "key": "D0404.txt:73",
   "ko": "모두가 자신을 골칫덩이 취급했다｡"
  },
  {
   "id": 4659,
   "key": "D0404.txt:79",
   "ko": "「뭐냐､ 그 눈은! 밥이라도 먹여주는 걸 고맙게 여겨라!」"
  },
  {
   "id": 4660,
   "key": "D0404.txt:87",
   "ko": "이유는 있었다｡"
  },
  {
   "id": 4661,
   "key": "D0404.txt:93",
   "ko": "「악마야……이 애한테는 악마가 씌어 있는 거야!」"
  },
  {
   "id": 4662,
   "key": "D0404.txt:99",
   "ko": "그녀 주변에서는 이상한 일이 자주 일어났다｡"
  },
  {
   "id": 4663,
   "key": "D0404.txt:101",
   "ko": "창유리가 저절로 깨지거나 인형이 움직이기 시작하거나､ 자동차에 치일 뻔했을 때는 차가 제멋대로 공중에 떠올라 뒤집혔다｡"
  },
  {
   "id": 4664,
   "key": "D0404.txt:105",
   "ko": "그래서 누구나 그 애에게 닿는 것을 두려워했다｡ 「우리 애도 아닌걸……돌봐줄 이유가 없잖아」"
  },
  {
   "id": 4665,
   "key": "D0404.txt:118",
   "ko": "그렇게 미움받고 배척당한 끝에 마지막으로 흘러든 곳이――이 교회였다｡"
  },
  {
   "id": 4666,
   "key": "D0404.txt:136",
   "ko": "「앨리슨……이지? 처음 뵙겠어요､ 나는 라이카예요｡ 오늘부터 네 가족이에요｡ 잘 부탁해요?」"
  },
  {
   "id": 4667,
   "key": "D0404.txt:142",
   "ko": "수녀는 상냥한 사람이었다｡ 부모 외에는 처음으로 자신을 『인간』으로 대해준 사람이다｡"
  },
  {
   "id": 4668,
   "key": "D0404.txt:145",
   "ko": "하지만 믿을 수는 없다｡"
  },
  {
   "id": 4669,
   "key": "D0404.txt:146",
   "ko": "애초에 말이다｡"
  },
  {
   "id": 4670,
   "key": "D0404.txt:160",
   "ko": "「성부와 성자와 성령의 이름으로! 악마여､ 물러가라!」"
  },
  {
   "id": 4671,
   "key": "D0404.txt:169",
   "ko": "="
  },
  {
   "id": 4672,
   "key": "D0404.txt:171",
   "ko": "그 신부는 며칠이고 히스테릭하게 성경 구절을 계속 외워댔다｡ 그리고 신의 위광을 빌린 욕설까지도｡"
  },
  {
   "id": 4673,
   "key": "D0404.txt:173",
   "ko": "말하길､ 너는 악마라고｡"
  },
  {
   "id": 4674,
   "key": "D0404.txt:174",
   "ko": "저속하고 비열한 악령이라고｡"
  },
  {
   "id": 4675,
   "key": "D0404.txt:175",
   "ko": "나가라｡ 나가라｡ 이 계집아이의 몸에서 나가라｡"
  },
  {
   "id": 4676,
   "key": "D0404.txt:177",
   "ko": "――이 몸에 내 마음 말고 무엇이 들어차 있다는 거지? 악마를 쑤셔 넣으려 하는 건 너희들이야｡"
  },
  {
   "id": 4677,
   "key": "D0404.txt:180",
   "ko": "="
  },
  {
   "id": 4678,
   "key": "D0404.txt:183",
   "ko": "수녀도 똑같은 성직자다｡"
  },
  {
   "id": 4679,
   "key": "D0404.txt:184",
   "ko": "그 신부와 같은 신을 믿고 있으니까｡"
  },
  {
   "id": 4680,
   "key": "D0404.txt:187",
   "ko": "="
  },
  {
   "id": 4681,
   "key": "D0404.txt:188",
   "ko": "="
  },
