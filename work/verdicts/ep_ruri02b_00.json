   "ko": "="
  },
  {
   "id": 50943,
   "key": "ep_ruri02b.txt:65",
   "ko": "「그대가 말하는 방식! 마치 계집애에게서 도망치는 것 같아서､ 더욱더 불쾌하다!」"
  },
