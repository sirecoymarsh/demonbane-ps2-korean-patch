  {
   "id": 12532,
   "key": "D0803al.txt:185",
   "ko": "깔깔 시끄럽게 웃으며 내 몸 위에서 펄쩍펄쩍 뛰기까지 한다｡"
  },
  {
   "id": 12533,
   "key": "D0803al.txt:190",
   "ko": "「적당히 좀……!」"
  },
  {
   "id": 12534,
   "key": "D0803al.txt:197",
   "ko": "「아침부터 뭐냐､ 시끄럽구나!」"
  },
  {
   "id": 12535,
   "key": "D0803al.txt:203",
   "ko": "="
  },
  {
   "id": 12536,
   "key": "D0803al.txt:205",
   "ko": "="
  },
  {
   "id": 12537,
   "key": "D0803al.txt:206",
   "ko": "매섭게 이쪽을 노려보다가――움직임이 멈췄다｡"
  },
  {
   "id": 12538,
   "key": "D0803al.txt:212",
   "ko": "「……………………」"
  },
  {
   "id": 12539,
   "key": "D0803al.txt:217",
   "ko": "「……………………」"
  },
  {
   "id": 12540,
   "key": "D0803al.txt:222",
   "ko": "「?????」"
  },
  {
   "id": 12541,
   "key": "D0803al.txt:228",
   "ko": "――길고도 큰 침묵｡"
  },
  {
   "id": 12542,
   "key": "D0803al.txt:234",
   "ko": "「경고는 헛수고였던 모양이로구나｡ 결국 그대는 천성이 범죄자로다」"
  },
  {
   "id": 12543,
   "key": "D0803al.txt:240",
   "ko": "「매번 매번 피고인의 호소가 묵살되고 있잖아!? 이건 종교재판이라고! 이 이단심문관!」"
  },
  {
   "id": 12544,
   "key": "D0803al.txt:246",
   "ko": "「아핫♪」"
  },
  {
   "id": 12545,
   "key": "D0803al.txt:251",
   "ko": "「일단 좀 내려와!」"
  },
  {
   "id": 12546,
   "key": "D0803al.txt:256",
   "ko": "「네에」 엔네아를 소파에 앉힌 뒤 부엌으로 가서 아침 커피를 내린다｡"
  },
  {
   "id": 12547,
   "key": "D0803al.txt:272",
   "ko": "후후……겁먹었나｡ 하도 재벌에 고용된 지금､ 나에겐 이런 사치도 허용되는 거다｡ 에헴｡"
  },
  {
   "id": 12548,
   "key": "D0803al.txt:279",
   "ko": "「인스턴트지만 말이다」"
  },
  {
   "id": 12549,
   "key": "D0803al.txt:283",
   "ko": "「――말하지 마｡ 사람이 모처럼 부르주아 기분에 젖어 있는데」"
  },
  {
   "id": 12550,
   "key": "D0803al.txt:289",
   "ko": "「……꽤나 저렴한 가격의 부르주아지로구나､ 그건」"
  },
  {
   "id": 12551,
   "key": "D0803al.txt:294",
   "ko": "갓 내린 커피를 적당한 컵에 따라 사무실로 돌아왔다｡"
  },
  {
   "id": 12552,
   "key": "D0803al.txt:302",
   "ko": "건네받은 커피에 엔네아는 설탕과 우유를 콸콸 넣어 마신다｡"
  },
  {
   "id": 12553,
   "key": "D0803al.txt:305",
   "ko": "아무래도 단것을 좋아하는 모양｡ 하지만 저러면 커피색을 한 다른 무언가다｡"
  },
  {
   "id": 12554,
   "key": "D0803al.txt:309",
   "ko": "참고로 나는 설탕도 우유도 아까워서 블랙｡"
  },
  {
   "id": 12555,
   "key": "D0803al.txt:312",
   "ko": "알은 그냥 설탕과 우유를 넣는다고 할까､ 즉 우유를 사다 두는 건 전부 알을 위한 것이고 이 녀석의 제멋대로다｡"
  },
