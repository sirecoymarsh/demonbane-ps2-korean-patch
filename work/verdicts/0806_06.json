{
 "packet": "0806_06",
 "items": [
  {
   "id": 13433,
   "key": "D0806le.txt:430",
   "ko": "「……쿠로 군｡ 힘들 때는 언제든 기대도 돼」"
  },
  {
   "id": 13434,
   "key": "D0806le.txt:435",
   "ko": "「푸읏……!」 「뭐､ 뭐라……!」"
  },
  {
   "id": 13435,
   "key": "D0806le.txt:444",
   "ko": "느닷없이 조금 달콤한 목소리로 그런 말을 해오는 통에 나도 모르게 커피를 뿜고 말았다｡"
  },
  {
   "id": 13436,
   "key": "D0806le.txt:446",
   "ko": "가､ 갑자기 무슨 소리를 하는 거야｡ 이 사람은!?"
  },
  {
   "id": 13437,
   "key": "D0806le.txt:448",
   "ko": "보니 알도 굳어버려서 포크를 떨어뜨리고 말았다｡"
  },
  {
   "id": 13438,
   "key": "D0806le.txt:450",
   "ko": "그런 우리의 동요는 아랑곳없이 라이카 씨는"
  },
  {
   "id": 13439,
   "key": "D0806le.txt:455",
   "ko": "「그야……쿠로 군이 아무리 강하다 해도 싸우는 게 전혀 힘들지 않을 리는 없다고 생각하니까」"
  },
  {
   "id": 13441,
   "key": "D0806le.txt:459",
   "ko": "「그러니까 나는 쿠로 군이 기대줬으면 좋겠어｡ 에헤헤」"
  },
  {
   "id": 13442,
   "key": "D0806le.txt:463",
   "ko": "살짝 볼을 붉히며 무방비한 미소를 보인다｡"
  },
  {
   "id": 13446,
   "key": "D0806le.txt:465",
   "ko": "심장이 크게 뛰었다｡"
  },
  {
   "id": 13447,
   "key": "D0806le.txt:467",
   "ko": "젠장､ 모처럼 가라앉았는데……이러면 또 필요 이상으로 의식하게 되잖아!"
  },
  {
   "id": 13448,
   "key": "D0806le.txt:472",
   "ko": "「째릿~~~~~~~~~~」 ……어째선지 알의 시선이 험악하다｡"
  },
  {
   "id": 13449,
   "key": "D0806le.txt:478",
   "ko": "효과음까지 연출하면서 이쪽을 노려보고 있다｡"
  },
  {
   "id": 13450,
   "key": "D0806le.txt:480",
   "ko": "식은땀이 나기 시작했다､ 정말｡"
  },
  {
   "id": 13451,
   "key": "D0806le.txt:485",
   "ko": "「? 무슨 일 있어､ 쿠로 군?」"
  },
  {
   "id": 13452,
   "key": "D0806le.txt:490",
   "ko": "「아니……별거 아냐」"
  },
  {
   "id": 13453,
   "key": "D0806le.txt:495",
   "ko": "「글쎄다」"
  },
  {
   "id": 13454,
   "key": "D0806le.txt:499",
   "ko": "잠시 우리 태도를 수상해하던 라이카 씨였지만 이내 마음을 다잡는다｡"
  },
  {
   "id": 13455,
   "key": "D0806le.txt:501",
   "ko": "남의 심장을 두근거리게 하는 무적의 미소를 지으며 라이카 씨는 말을 이으려다――"
  },
  {
   "id": 13456,
   "key": "D0806le.txt:506",
   "ko": "「……나도 말이야｡ 사실 쿠로 군한테 여러모로 구원받고 있어｡ 있잖아､ 언제였더라? 처음 알게 됐을 무렵에도――」 우연이었을 터다｡"
  },
  {
   "id": 13457,
   "key": "D0806le.txt:513",
   "ko": "딱히 별생각 없이 시선을 창밖으로 돌렸을 뿐이다｡"
  },
  {
   "id": 13458,
   "key": "D0806le.txt:515",
   "ko": "하지만 라이카 씨의 시선은――밖에 못 박혔다｡"
  },
  {
   "id": 13459,
   "key": "D0806le.txt:517",
   "ko": "그 눈동자가 그녀가 바라보는 것을 비춰내고 있다｡"
  },
  {
   "id": 13460,
   "key": "D0806le.txt:519",
   "ko": "라이카 씨는､ 무언가를､ 발견해버린 것이다｡"
  },
  {
   "id": 13461,
   "key": "D0806le.txt:526",
   "ko": "갑자기 자리에서 일어선다｡"
  },
  {
   "id": 13462,
   "key": "D0806le.txt:528",
   "ko": "밀쳐낸 의자가 바닥에 쓰러졌다｡"
  },
  {
   "id": 13463,
   "key": "D0806le.txt:530",
   "ko": "가게 안에 울려 퍼진다｡ 모두의 시선이 라이카 씨에게 쏠렸다｡"
  },
  {
   "id": 13464,
   "key": "D0806le.txt:532",
   "ko": "하지만 라이카 씨는 그걸 알아채기는커녕 멍하니 굳어서｡ 「류……」"
  },
  {
   "id": 13465,
   "key": "D0806le.txt:541",
   "ko": "쉰 목소리로 무언가를 중얼거린 뒤―― 「엣……!?」"
  },
  {
   "id": 13466,
   "key": "D0806le.txt:548",
   "ko": "갑자기 달려나가 가게 밖으로 뛰쳐나가 버렸다｡"
  },
  {
   "id": 13467,
   "key": "D0806le.txt:550",
   "ko": "창밖으로 눈을 돌린다｡"
  },
  {
   "id": 13468,
   "key": "D0806le.txt:552",
   "ko": "무언가를 쫓듯이 라이카 씨는 달려간다｡ 「무､ 무엇이냐?」"
  },
  {
   "id": 13469,
   "key": "D0806le.txt:562",
   "ko": "「이､ 이봐 라이카 씨! 무슨 일이야!? 갑자기!」"
  },
  {
   "id": 13470,
   "key": "D0806le.txt:564",
   "ko": "이､ 이러고 있을 때가 아니야!"
  },
  {
   "id": 13471,
   "key": "D0806le.txt:566",
   "ko": "뛰쳐나간 라이카 씨를 쫓아 가게를 나간다……아､ 이런!"
  },
  {
   "id": 13472,
   "key": "D0806le.txt:569",
   "ko": "「으아아아아! 짐 짐! ……이걸 또 들어야 한다고!」"
  },
  {
   "id": 13473,
   "key": "D0806le.txt:571",
   "ko": "제기랄､ 농담이 아니라고 정말!"
  },
  {
   "id": 13474,
   "key": "D0806le.txt:573",
   "ko": "하지만 꾸물거릴 틈은 없다｡"
  },
  {
   "id": 13475,
   "key": "D0806le.txt:574",
   "ko": "각오를 다지고 짐을 들어 올려 이번에야말로 가게를 나가――"
  },
  {
   "id": 13476,
   "key": "D0806le.txt:579",
   "ko": "「……손님､ 계산 부탁드려도 될까요?」"
  }
 ]
}