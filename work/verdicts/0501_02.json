{
 "packet": "0501_02",
 "items": [
  {
   "id": 6060,
   "key": "D0501.txt:692",
   "ko": "명치를 강렬한 타격이 덮친다｡"
  },
  {
   "id": 6061,
   "key": "D0501.txt:693",
   "ko": "나는 공중을 날아 아스팔트에 내동댕이쳐졌다｡"
  },
  {
   "id": 6062,
   "key": "D0501.txt:697",
   "ko": "기침을 하면서도 즉시 몸을 일으킨다｡"
  },
  {
   "id": 6063,
   "key": "D0501.txt:698",
   "ko": "="
  },
  {
   "id": 6064,
   "key": "D0501.txt:699",
   "ko": "나를 후려친 자세 그대로､ 그놈은 서 있었다｡"
  },
  {
   "id": 6065,
   "key": "D0501.txt:711",
   "ko": "="
  },
  {
   "id": 6066,
   "key": "D0501.txt:717",
   "ko": "습격자의 정체는 마술 의식용인 듯한 의상을 걸친 소녀였다｡"
  },
  {
   "id": 6067,
   "key": "D0501.txt:720",
   "ko": "총을 닮은 정체 모를 무기를 두 자루 겨누고 있다｡"
  },
  {
   "id": 6068,
   "key": "D0501.txt:721",
   "ko": "아무래도 저걸로 명치를 얻어맞은 모양이다｡"
  },
  {
   "id": 6069,
   "key": "D0501.txt:722",
   "ko": "통파 같은 것인가｡ 하지만…… 이 녀석 빠르다｡ 너무 빠르다｡"
  },
  {
   "id": 6070,
   "key": "D0501.txt:728",
   "ko": "="
  },
  {
   "id": 6071,
   "key": "D0501.txt:734",
   "ko": "감정을 읽을 수 없는 차가운 눈동자가 나를 마주 바라본다｡"
  },
  {
   "id": 6072,
   "key": "D0501.txt:747",
   "ko": "…………?"
  },
  {
   "id": 6073,
   "key": "D0501.txt:749",
   "ko": "="
  },
  {
   "id": 6074,
   "key": "D0501.txt:750",
   "ko": "="
  },
  {
   "id": 6075,
   "key": "D0501.txt:756",
   "ko": "「후하하하하하! 어떠냐! 놀랐느냐､ 다이쥬지 쿠로! 저 아이야말로 이 몸의 최고 걸작인 것이다!」"
  },
  {
   "id": 6076,
   "key": "D0501.txt:765",
   "ko": "="
  },
  {
   "id": 6077,
   "key": "D0501.txt:766",
   "ko": "="
  },
  {
   "id": 6078,
   "key": "D0501.txt:772",
   "ko": "「저 여자､ 인간이 아니로구나 ――기계인형이냐」"
  },
  {
   "id": 6079,
   "key": "D0501.txt:779",
   "ko": "「――――! 아니､ 하지만､ 그런 말도 안 돼!?」"
  },
  {
   "id": 6080,
   "key": "D0501.txt:785",
   "ko": "「누하하하하하하하하하핫! 바로 그거인 것이다!」"
  },
  {
   "id": 6081,
   "key": "D0501.txt:790",
   "ko": "「이 몸의 오랜 연구의 성과! 피와 땀과 약간 애틋한 눈물의 결정! 최강의 전투 능력과 최고의 미를 겸비한､ 이 몸의 미학의 집대성!」"
  },
  {
   "id": 6082,
   "key": "D0501.txt:796",
   "ko": "「――그 이름도 인조인간 엘자!」 나도 모르게 말문이 막혔다｡"
  },
  {
   "id": 6083,
   "key": "D0501.txt:808",
   "ko": "="
  },
  {
   "id": 6084,
   "key": "D0501.txt:811",
   "ko": "……도저히 믿을 수가 없다｡"
  },
  {
   "id": 6085,
   "key": "D0501.txt:814",
   "ko": "="
  },
  {
   "id": 6086,
   "key": "D0501.txt:823",
   "ko": "「다이쥬지 쿠로――너를 쓰러뜨리는 로봇」"
  },
  {
   "id": 6087,
   "key": "D0501.txt:831",
   "ko": "="
  },
  {
   "id": 6088,
   "key": "D0501.txt:837",
   "ko": "="
  },
  {
   "id": 6089,
   "key": "D0501.txt:843",
   "ko": "「자､ 사랑스러운 엘자! 해치워 버리는 것이다!」 「오늘이야말로…… 오늘이야말로 설욕을 해주는 것이다!」"
  },
  {
   "id": 6090,
   "key": "D0501.txt:854",
   "ko": "「오케이! 렛츠 고!」 「큿……!」"
  },
  {
   "id": 6091,
   "key": "D0501.txt:888",
   "ko": "총알처럼 인조인간 엘자가 돌진해 온다｡"
  },
  {
   "id": 6092,
   "key": "D0501.txt:889",
   "ko": "다가오는 통파를 간발의 차로 오른팔로 막는다｡"
  },
  {
   "id": 6093,
   "key": "D0501.txt:890",
   "ko": "뼛속까지 저릿한 감각｡"
  },
  {
   "id": 6094,
   "key": "D0501.txt:910",
   "ko": "틈도 없이 다른 한 자루 통파가 내 턱을 노리고 호를 그린다｡ 몸을 크게 젖혀 피한다｡"
  },
  {
   "id": 6095,
   "key": "D0501.txt:916",
   "ko": "「세이야!」 「――……!」"
  },
  {
   "id": 6096,
   "key": "D0501.txt:939",
   "ko": "몸을 젖힌 기세를 죽이지 않고 백덤블링｡"
  },
  {
   "id": 6097,
   "key": "D0501.txt:940",
   "ko": "멀어지는 김에 엘자의 턱을 걷어차 올려 두었다｡"
  },
  {
   "id": 6098,
   "key": "D0501.txt:942",
   "ko": "거리를 두고 다시 마주 선다｡"
  },
  {
   "id": 6099,
   "key": "D0501.txt:952",
   "ko": "엘자가 가볍게 목을 돌린다｡"
  }
 ]
}