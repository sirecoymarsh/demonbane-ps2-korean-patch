 "items": [
  {
   "id": 1028,
   "key": "D0110.txt:23",
   "ko": "얼마나 계속 떨어졌을까…… 갑자기 격렬한 충격이 온몸을 덮쳐､ 겨우 구멍 바닥에 내동댕이쳐진 걸 알았다｡"
  },
  {
   "id": 1029,
   "key": "D0110.txt:28",
   "ko": "="
  },
  {
   "id": 1030,
   "key": "D0110.txt:31",
   "ko": "="
  },
  {
   "id": 1031,
   "key": "D0110.txt:46",
   "ko": "「안심하거라｡ 마술로 지켜주었으니 말이다｡ 큰 상처는 입지 않았을 게다」"
  },
  {
   "id": 1032,
   "key": "D0110.txt:53",
   "ko": "「으…… 크…… 어디까지 떨어진 거야､ 우리?」"
  },
  {
   "id": 1033,
   "key": "D0110.txt:73",
   "ko": "아무래도 엄청난 거리를 떨어진 모양이다｡"
  },
  {
   "id": 1034,
   "key": "D0110.txt:74",
   "ko": "="
  },
  {
   "id": 1035,
   "key": "D0110.txt:76",
   "ko": "="
  },
  {
   "id": 1036,
   "key": "D0110.txt:84",
   "ko": "공사 중이거나 아니면 도중에 폐기된 건지 짓다 만 느낌의 공간이었다｡"
  },
  {
   "id": 1037,
   "key": "D0110.txt:86",
   "ko": "="
  },
  {
   "id": 1038,
   "key": "D0110.txt:89",
   "ko": "지하철이나 대피 쉘터 개발치고는 너무나 깊다｡ 애초에 이 구역에서 지하 개발이 있다는 얘기 자체를 들어본 적이 없다｡"
  },
  {
   "id": 1039,
   "key": "D0110.txt:101",
   "ko": "「쿠로｡ 저쪽에 통로가 있다」"
  },
  {
   "id": 1040,
   "key": "D0110.txt:106",
   "ko": "정령이 가리키는 방향에､ 확실히 통로는 있었다｡"
  },
  {
   "id": 1041,
   "key": "D0110.txt:107",
   "ko": "어디로 이어져 있는 걸까? …… 뭐､ 어쨌든｡"
  },
  {
   "id": 1042,
   "key": "D0110.txt:115",
   "ko": "「여기 있어봤자 소용없고…… 나아갈 수밖에 없나」"
  },
  {
   "id": 1043,
   "key": "D0110.txt:124",
   "ko": "냉랭한 어스름 속을 나아간다｡"
  },
  {
   "id": 1044,
   "key": "D0110.txt:125",
   "ko": "구둣소리가 통로에 울려 퍼진다｡"
  },
  {
   "id": 1045,
   "key": "D0110.txt:127",
   "ko": "전방에서 희미하게 비쳐 드는 빛｡"
  },
  {
   "id": 1046,
   "key": "D0110.txt:128",
   "ko": "통로의 출구다｡"
  },
  {
   "id": 1047,
   "key": "D0110.txt:142",
   "ko": "통로를 빠져나오자､ 광대한 공간이 나타났다｡"
  },
  {
   "id": 1048,
   "key": "D0110.txt:144",
   "ko": "……넓다｡ 정말 넓다｡ 터무니없이 넓다｡ 천장도 바보같이 높다｡"
  },
  {
   "id": 1049,
   "key": "D0110.txt:147",
   "ko": "너무나 광대한 탓에､ 많은 조명으로도 공간에 서린 어둠을 다 밝히지 못한다｡"
  },
  {
   "id": 1050,
   "key": "D0110.txt:149",
   "ko": "보아하니 격납고라고 할 만한 곳이지만……"
  },
  {
   "id": 1051,
   "key": "D0110.txt:150",
   "ko": "이렇게 넓은 공간､ 게다가 이런 지하에 대체 뭘"
  },
  {
   "id": 1052,
   "key": "D0110.txt:151",
   "ko": "격납한다는 거야……?"
  },
  {
   "id": 1053,
   "key": "D0110.txt:156",
   "ko": "「……어?」 거기서 나는 겨우 그것의 존재를 알아차렸다｡"
  },
  {
   "id": 1054,
   "key": "D0110.txt:162",
   "ko": "찾기 어렵거나 숨겨져 있던 것은 아니다｡"
  },
  {
   "id": 1055,
   "key": "D0110.txt:163",
   "ko": "라기보다､ 이런 걸 숨길 방도가 없다｡"
  },
  {
   "id": 1056,
   "key": "D0110.txt:165",
   "ko": "그런데도 그것을 인식하지 못했던 건……"
  },
  {
   "id": 1057,
   "key": "D0110.txt:166",
   "ko": "그저 그것이 너무나도 거대했기 때문이다｡"
  },
  {
   "id": 1058,
   "key": "D0110.txt:171",
   "ko": "「뭐야…… 이건?」"
  },
  {
   "id": 1059,
   "key": "D0110.txt:183",
   "ko": "처음엔 그것의 전모를 전혀 파악할 수 없었다｡"
  },
  {
   "id": 1060,
   "key": "D0110.txt:191",
   "ko": "그 정도로 거대한――그것은 쇳덩어리였다｡ 쇠를 어떤 의지로 벼려낸､"
  },
  {
   "id": 1061,
   "key": "D0110.txt:201",
   "ko": "그것은 거대한 강철이었다｡"
  },
  {
   "id": 1062,
   "key": "D0110.txt:215",
   "ko": "공간의 넓이에､ 강철의 크기에 익숙해진 뇌가 겨우 그것의 형상을 파악하기 시작한다｡"
  },
  {
   "id": 1063,
   "key": "D0110.txt:242",
   "ko": "「이､ 이건…… 로봇!?」 지금껏 본 적 없는 타입의 로봇이었다｡"
  },
  {
   "id": 1064,
   "key": "D0110.txt:247",
   "ko": "『블랙로지』의 파괴 로봇과는 달리､ 늘씬한 폼의 인간형에 가까운 로봇이다｡ 하지만 왜 그런 로봇이 여기에?"
  },
  {
   "id": 1065,
   "key": "D0110.txt:250",
   "ko": "설마 이놈이 『블랙로지』의 신형이고､ 여기가 놈들의 비밀 기지라는 건 아니겠지……｡ 「호오! 이 느낌…… 귀계신인가!」"
  },
  {
   "id": 1067,
   "key": "D0110.txt:259",
   "ko": "「술자와 아이온 대신을 동시에 찾아내다니…… 마치 누군가가 이 몸의 운명에 개입하고 있는 것 같구나」 「……기계 장치의 신?」"
  },
  {
   "id": 1068,
   "key": "D0110.txt:269",
   "ko": "「모르느냐? 마도서 중에는 이 몸처럼 귀계신을 소환할 수 있는 것이 있느니라」"
  }
 ]
}