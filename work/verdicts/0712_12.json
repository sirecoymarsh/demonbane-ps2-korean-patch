 "items": [
  {
   "id": 10365,
   "key": "D0712ru.txt:76",
   "ko": "가능하면 맨몸으로 덤비고 싶진 않지만…… 만약 라이카 씨 일행이 붙잡혀 있다면､ 그런 소리 하고 있을 순 없지｡"
  },
  {
   "id": 10368,
   "key": "D0712ru.txt:81",
   "ko": "「조용히 가자…… 들키면､ 큰일이야」"
  },
  {
   "id": 10369,
   "key": "D0712ru.txt:86",
   "ko": "「……네､ 네에」"
  },
  {
   "id": 10370,
   "key": "D0712ru.txt:99",
   "ko": "그곳은 제단이 있는 방이었다｡ 휑하니 널찍한 공간､ 제단 위에 거대한､ 물고기 괴물 같은 조각상이 모셔져 있었다｡"
  },
  {
   "id": 10371,
   "key": "D0712ru.txt:103",
   "ko": "그 제단 주위､ 정신없이 기도를 올리고 있는 인스머스 주민들…… 아니､ 사람의 모습을 버린 저 꼴은､ 이미 완전히 반어인 그 자체다｡"
  },
  {
   "id": 10372,
   "key": "D0712ru.txt:106",
   "ko": "납치당한 것으로 보이는 관광객인 듯한 여성의 모습이 있다｡ 바닥에 내버려진 그 눈동자에､ 생기는 없다｡"
  },
  {
   "id": 10374,
   "key": "D0712ru.txt:109",
   "ko": "억누를 수 없는 분노가 치밀어 오르는 걸 느낀다｡"
  },
  {
   "id": 10375,
   "key": "D0712ru.txt:115",
   "ko": "「으윽……」"
  },
  {
   "id": 10376,
   "key": "D0712ru.txt:120",
   "ko": "공주님이 속이 안 좋은 듯､ 입가를 감싼다｡ 「괜찮냐?」"
  },
  {
   "id": 10377,
   "key": "D0712ru.txt:129",
   "ko": "「윽…… 죄､ 죄송해요 ……괜찮､ 아요……」"
  },
  {
   "id": 10378,
   "key": "D0712ru.txt:135",
   "ko": "「무리하진 마라」"
  },
  {
   "id": 10379,
   "key": "D0712ru.txt:138",
   "ko": "그늘에 숨은 채､ 안쪽 상황을 둘러본다｡"
  },
  {
   "id": 10380,
   "key": "D0712ru.txt:139",
   "ko": "라이카 씨나 알의 모습은 보이지 않지만……｡"
  },
  {
   "id": 10381,
   "key": "D0712ru.txt:149",
   "ko": "……뚝｡ 「응?」"
  },
  {
   "id": 10383,
   "key": "D0712ru.txt:165",
   "ko": "천장에서 떨어진 물방울이､ 뺨에 떨어졌다｡"
  },
  {
   "id": 10384,
   "key": "D0712ru.txt:175",
   "ko": "뚝｡ 뚝｡ 뚝｡"
  },
  {
   "id": 10387,
   "key": "D0712ru.txt:176",
   "ko": "연달아 몇 번이고 떨어져 내린다｡"
  },
  {
   "id": 10388,
   "key": "D0712ru.txt:179",
   "ko": "……그냥 물이 아니다｡"
  },
  {
   "id": 10390,
   "key": "D0712ru.txt:180",
   "ko": "어쩐지 끈적거리고､ 악취를 풍기고 있다……"
  },
  {
   "id": 10391,
   "key": "D0712ru.txt:188",
   "ko": "「히이익……! 다､ 다이쥬지 씨……!」"
  },
  {
   "id": 10392,
   "key": "D0712ru.txt:194",
   "ko": "「…………!?」"
  },
  {
   "id": 10393,
   "key": "D0712ru.txt:200",
   "ko": "공주님의 비명에､ 천장을 올려다본다｡"
  },
  {
   "id": 10394,
   "key": "D0712ru.txt:201",
   "ko": "바로 내 머리 위｡ 점액을 뚝뚝 흘리며――그놈이 있었다｡"
  },
  {
   "id": 10395,
   "key": "D0712ru.txt:204",
   "ko": "촉수의 빨판을 천장에 붙이고､ 거꾸로 매달린 채……!"
  },
  {
   "id": 10397,
   "key": "D0712ru.txt:210",
   "ko": "「꺄아아아아!」"
  },
  {
   "id": 10398,
   "key": "D0712ru.txt:228",
   "ko": "황급히 뛰어서 물러난다｡ 조금 전까지 내가 서 있던 자리에､ 그놈이 떨어져 내렸다｡"
  },
  {
   "id": 10401,
   "key": "D0712ru.txt:231",
   "ko": "인간과 문어를 억지로 합성시킨 듯한､ 기괴한 괴물이었다｡"
  },
  {
   "id": 10403,
   "key": "D0712ru.txt:238",
   "ko": "「문어 괴물이라고!?」"
  },
  {
   "id": 10404,
   "key": "D0712ru.txt:242",
   "ko": "무､ 뭐냐고､ 이놈들은!?"
  },
  {
   "id": 10405,
   "key": "D0712ru.txt:248",
   "ko": "「치이이잇…… 위험해!」"
  },
  {
   "id": 10406,
   "key": "D0712ru.txt:252",
   "ko": "『깊은 곳의 존재들』이 일제히 이쪽을 돌아본다｡"
  },
  {
   "id": 10408,
   "key": "D0712ru.txt:253",
   "ko": "완전히 들켜 버렸다｡"
  },
  {
   "id": 10409,
   "key": "D0712ru.txt:256",
   "ko": "마기우스 스타일도 아닌 지금､ 이 상황은 너무 위험하다!"
  },
  {
   "id": 10410,
   "key": "D0712ru.txt:262",
   "ko": "「아아앗! 다이쥬지 씨!」"
  },
  {
   "id": 10412,
   "key": "D0712ru.txt:267",
   "ko": "「우와아아아아앗!?」"
  },
  {
   "id": 10413,
   "key": "D0712ru.txt:277",
   "ko": "눈앞의 문어 괴인이､ 통나무처럼 굵은 촉수를 내리쳐 온다｡"
  },
  {
   "id": 10414,
   "key": "D0712ru.txt:279",
   "ko": "안 돼! 못 피한다!"
  },
  {
   "id": 10415,
   "key": "D0712ru.txt:286",
   "ko": "「다이쥬지 씨이이이잇!」"
  },
  {
   "id": 10416,
   "key": "D0712ru.txt:305",
   "ko": "촉수가 내리꽂히는 일은 없었다｡"
  },
  {
   "id": 10417,
   "key": "D0712ru.txt:306",
   "ko": "문어 괴인의 몸이 날아가､ 허공을 구른다｡"
  }
 ]
