  },
  {
   "id": 16979,
   "key": "D0816le.txt:733",
   "ko": "「………………니이이잇」"
  },
  {
   "id": 16980,
   "key": "D0816le.txt:737",
   "ko": "네임리스 원의 정수리 부분｡"
  },
  {
   "id": 16981,
   "key": "D0816le.txt:742",
   "ko": "저 탈옥수가――『폭군』이 서 있었다｡"
  },
  {
   "id": 16982,
   "key": "D0816le.txt:743",
   "ko": "이 녀석､ 아직 살아 있었나｡"
  },
  {
   "id": 16983,
   "key": "D0816le.txt:745",
   "ko": "……아 참､ 그렇지!"
  },
  {
   "id": 16984,
   "key": "D0816le.txt:751",
   "ko": "「……읏! 라이카 씨! 라이카 씨는!?」"
  },
  {
   "id": 16985,
   "key": "D0816le.txt:753",
   "ko": "="
  },
  {
   "id": 16986,
   "key": "D0816le.txt:755",
   "ko": "기체 내부나 다른 곳에 갇혀 있는 건지､ 아니면……｡"
  },
  {
   "id": 16987,
   "key": "D0816le.txt:759",
