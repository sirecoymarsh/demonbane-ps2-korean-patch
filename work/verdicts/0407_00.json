   "ko": "="
  },
  {
   "id": 4878,
   "key": "D0407.txt:34",
   "ko": "강렬한 마력의 폭발｡"
  },
  {
   "id": 4879,
   "key": "D0407.txt:35",
   "ko": "나한테도 똑똑히 느껴졌다｡"
  },
  {
   "id": 4880,
   "key": "D0407.txt:41",
   "ko": "「틀림없다…… 이 몸의 파편이다!」"
  },
  {
   "id": 4881,
   "key": "D0407.txt:47",
   "ko": "방금 전까지 잠잠했는데 갑자기라니!?"
  },
  {
   "id": 4882,
   "key": "D0407.txt:48",
   "ko": "="
  },
  {
   "id": 4883,
   "key": "D0407.txt:54",
   "ko": "「……교회 쪽이잖아」"
  },
  {
   "id": 4884,
   "key": "D0407.txt:58",
   "ko": "="
  },
  {
   "id": 4885,
   "key": "D0407.txt:59",
   "ko": "역시 그건 알의 파편과 관련이 있었던 건가?"
  },
  {
   "id": 4886,
   "key": "D0407.txt:68",
   "ko": "「확실히 묘한 기척은 있었다｡ 허나 파편이라면 이 몸이 놓칠 리가 없다｡ ――어째서지?」"
  },
  {
   "id": 4887,
   "key": "D0407.txt:77",
   "ko": "……수수께끼는 많지만 지금은 그걸 신경 쓸 때가 아니다｡ 만약 이 반응의 근원이 교회라면 라이카 씨네가 위험해!"
  },
  {
   "id": 4888,
   "key": "D0407.txt:82",
   "ko": "="
  },
  {
   "id": 4889,
   "key": "D0407.txt:91",
   "ko": "「알겠다!」"
  },
  {
   "id": 4890,
   "key": "D0407.txt:113",
   "ko": "변신은 순식간에 완료｡ 일일이 현관으로 나가는 건 시간 낭비다｡ 그대로 창문에서 몸을 던진다｡"
  },
  {
   "id": 4891,
   "key": "D0407.txt:119",
   "ko": "「마기우스 윙!」"
  },
  {
   "id": 4892,
   "key": "D0407.txt:134",
   "ko": "폭음을 울리며 단숨에 하늘을 날았다｡"
  },
  {
   "id": 4893,
   "key": "D0407.txt:135",
   "ko": "엄청난 기세로 뒤로 흘러가는 풍경｡"
  },
  {
   "id": 4894,
   "key": "D0407.txt:141",
   "ko": "="
  },
  {
   "id": 4895,
   "key": "D0407.txt:162",
   "ko": "교회에서 넘쳐나는 눈부신 빛과 굉음｡"
  },
  {
   "id": 4896,
   "key": "D0407.txt:163",
   "ko": "이변은 분명했다｡"
  },
  {
   "id": 4897,
   "key": "D0407.txt:180",
   "ko": "착지해 문을 걷어차고 안으로 뛰어들었다｡"
  },
  {
   "id": 4898,
   "key": "D0407.txt:198",
   "ko": "「라이카 씨! 꼬맹이들!」"
  },
  {
   "id": 4899,
   "key": "D0407.txt:207",
   "ko": "「쿠로 군!? 앨리슨이……!」 「뭐…… 뭐야 이거!?」"
  },
  {
   "id": 4900,
   "key": "D0407.txt:224",
   "ko": "조지와 콜린을 감싼 라이카 씨 너머､ 넘쳐나는 빛의 중심에 자그마한 인영이 있었다｡"
  },
  {
   "id": 4901,
   "key": "D0407.txt:236",
   "ko": "="
  },
  {
   "id": 4902,
   "key": "D0407.txt:242",
   "ko": "빛 속에서 앨리슨은 멍하니…… 초점 없는 눈동자로 서 있다｡ 그리고 그런 앨리슨을 둘러싼 괴이――!"
  },
  {
   "id": 4903,
   "key": "D0407.txt:265",
   "ko": "="
  },
  {
   "id": 4904,
   "key": "D0407.txt:267",
   "ko": "달걀 남자에､ 히죽히죽 웃는 고양이､ 시계 토끼…… 그런 기괴하기 짝이 없는 팬시한 괴물들이 하나같이 사악한 미소를 짓고 있다｡ 「쿠로…… 저 아이가 들고 있는 거울을 봐라」"
  },
  {
   "id": 4905,
   "key": "D0407.txt:283",
   "ko": "앨리슨의 손 안에는 예의 그 콤팩트가 있었다｡ 빛의 발생원은 아무래도 이놈인 것 같다｡"
  },
  {
   "id": 4906,
   "key": "D0407.txt:289",
   "ko": "「큿――――!?」 퐁!☆"
  },
  {
   "id": 4907,
   "key": "D0407.txt:316",
   "ko": "얼빠진 효과음과 함께 거울에서 빛의 알이 나타났다｡"
  },
  {
   "id": 4908,
   "key": "D0407.txt:317",
   "ko": "알이 터진다｡"
  },
  {
   "id": 4909,
   "key": "D0407.txt:331",
   "ko": "알 속에서 위험한 눈을 한 실크햇 아저씨가 태어났다｡ 찻잔을 한 손에 들고 능글맞은 미소를 짓고 있다｡"
  },
  {
   "id": 4910,
   "key": "D0407.txt:334",
   "ko": "이놈은……!?"
  },
  {
   "id": 4911,
   "key": "D0407.txt:341",
   "ko": "「그렇군…… 『니토크리스의 거울』에 관한 기술이로군!」"
  },
  {
   "id": 4912,
   "key": "D0407.txt:347",
   "ko": "「니토크리스?」 「전설에 이름 높은 고대 이집트의 여왕이다」"
  },
  {
   "id": 4913,
   "key": "D0407.txt:361",
   "ko": "「그 여괴는 마법의 거울을 통해 암흑계의 일단을 엿보았다 하는데――저 아이､ 실체화한 거울에 씌었구나」"
  },
  {
   "id": 4914,
   "key": "D0407.txt:371",
   "ko": "「씌었다니……!?」 「저 괴물들은?」"
  },
  {
   "id": 4915,
   "key": "D0407.txt:383",
   "ko": "「저건 허구와 현실의 경계를 흐리는 거울｡ 아이의 상상을 비추어 마력으로 실체화시키고 있다｡ 내버려두면 자꾸 늘어날 것이다」"
  }
 ]
}