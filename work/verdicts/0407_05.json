{
 "packet": "0407_05",
 "items": [
  {
   "id": 5077,
   "key": "D0407.txt:1739",
   "ko": "「꼬마들! 집 잘 부탁한다!」"
  },
  {
   "id": 5078,
   "key": "D0407.txt:1743",
   "ko": "두 사람은 눈물을 닦으며 힘차게 고개를 끄덕였다｡ 음､ 그거면 됐다｡"
  },
  {
   "id": 5079,
   "key": "D0407.txt:1753",
   "ko": "「슬슬 서두르지 않으면 소동이 커지느니라」"
  },
  {
   "id": 5080,
   "key": "D0407.txt:1759",
   "ko": "「알고 있어! 라이카 씨｡ 날아갈 테니까 업혀요」"
  },
  {
   "id": 5081,
   "key": "D0407.txt:1769",
   "ko": "「에엣? 아､ 네!」"
  },
  {
   "id": 5082,
   "key": "D0407.txt:1780",
   "ko": "몸을 숙인 나에게 머뭇머뭇 몸을 맡긴다｡"
  },
  {
   "id": 5083,
   "key": "D0407.txt:1781",
   "ko": "라이카 씨를 업고 나는 일어섰다｡"
  },
  {
   "id": 5084,
   "key": "D0407.txt:1790",
   "ko": "검은 날개를 펼친다｡ 조금 움직이기 힘들지만 날갯짓하는 데는 충분하겠지｡"
  },
  {
   "id": 5085,
   "key": "D0407.txt:1796",
   "ko": "「그럼 라이카 씨､ 꽉 잡아요!」"
  },
  {
   "id": 5086,
   "key": "D0407.txt:1802",
   "ko": "「엣……? 잠깐…… 꺄아아아아아아아아아아!?」"
  },
  {
   "id": 5087,
   "key": "D0407.txt:1821",
   "ko": "공중에 뜨자마자 나는 창문에서 화살처럼 날아갔다｡ 그대로 상공까지 단숨에 떠오른다｡"
  },
  {
   "id": 5088,
   "key": "D0407.txt:1835",
   "ko": "「꺄아아아아아아아아아아아아아아~~~~~~~……읏!」"
  },
  {
   "id": 5089,
   "key": "D0407.txt:1844",
   "ko": "길게 꼬리를 끄는 비명이 밤하늘에 울려 퍼졌다｡ 「「…………읏!?」」"
  },
  {
   "id": 5090,
   "key": "D0407.txt:1892",
   "ko": "라이카 씨는 다짜고짜 두 사람의 뺨을 후려쳤다｡"
  },
  {
   "id": 5091,
   "key": "D0407.txt:1895",
   "ko": "설마 라이카 씨에게 맞을 줄은 몰랐겠지｡ 두 사람은 무슨 일이 일어났는지 모르겠다는 듯이 멍하니 라이카 씨를 올려다보고 있었다｡"
  },
  {
   "id": 5092,
   "key": "D0407.txt:1898",
   "ko": "라이카 씨는 말없이 노려보다가――이윽고 슬픈 눈으로 타이르듯 말을 걸었다｡"
  },
  {
   "id": 5093,
   "key": "D0407.txt:1907",
   "ko": "「조지…… 콜린…… 어째서 앨리슨을 괴롭히는 거야?」"
  },
  {
   "id": 5094,
   "key": "D0407.txt:1913",
   "ko": "「「………………」」"
  },
  {
   "id": 5095,
   "key": "D0407.txt:1920",
   "ko": "꼬맹이들은 대답하지 않는다｡ 그저 불편한 듯 안절부절못하며 시선을 헤맨다｡"
  },
  {
   "id": 5096,
   "key": "D0407.txt:1928",
   "ko": "「앨리슨은 여기 온 지 얼마 안 됐으니까…… 여기서는 너희가 오빠니까…… 상냥하게 대해줘야 하는 거잖아」"
  },
  {
   "id": 5097,
   "key": "D0407.txt:1933",
   "ko": "「하지만……」"
  },
  {
   "id": 5098,
   "key": "D0407.txt:1939",
   "ko": "「앨리슨도…… 지금까지 혼자였어｡ 너희 둘이라면 그게 어떤 건지 알잖아?」"
  },
  {
   "id": 5099,
   "key": "D0407.txt:1945",
   "ko": "「…………!」 「윽윽!」"
  },
  {
   "id": 5100,
   "key": "D0407.txt:1958",
   "ko": "그 한마디에 두 사람의 얼굴에 순식간에 후회가 번져간다｡"
  },
  {
   "id": 5101,
   "key": "D0407.txt:1961",
   "ko": "그래｡ 이 녀석들도 앨리슨과 마찬가지로 맡아줄 곳 없는 고아다｡ 고독의 괴로움은 누구보다 잘 알고 있다｡"
  },
  {
   "id": 5102,
   "key": "D0407.txt:1967",
   "ko": "「……죄송해요」 「죄송해요」"
  },
  {
   "id": 5103,
   "key": "D0407.txt:1981",
   "ko": "="
  },
  {
   "id": 5104,
   "key": "D0407.txt:1991",
   "ko": "「사과할 거면 앨리슨한테 직접､ 알았지?」"
  },
  {
   "id": 5105,
   "key": "D0407.txt:1998",
   "ko": "="
  },
  {
   "id": 5106,
   "key": "D0407.txt:2009",
   "ko": "「쿠로､ 서두르자｡ 시간이 흐르면 일이 커지느니라」"
  },
  {
   "id": 5107,
   "key": "D0407.txt:2015",
   "ko": "「그래! 라이카 씨､ 나는 앨리슨을 데리러 갈 테니까……」"
  },
  {
   "id": 5108,
   "key": "D0407.txt:2024",
   "ko": "「저도 갈게요!」 「엣? 하지만 위험해……?」"
  },
  {
   "id": 5109,
   "key": "D0407.txt:2036",
   "ko": "「쿠로 군한테만 맡겨둘 순 없어｡ 왜냐면 앨리슨은 우리 가족이니까」"
  },
