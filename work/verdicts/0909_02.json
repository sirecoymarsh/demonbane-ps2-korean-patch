{
 "packet": "0909_02",
 "items": [
  {
   "id": 20066,
   "key": "D0909al.txt:558",
   "ko": "파괴 로봇을 붙잡은 채､ 반대쪽 주먹으로 파괴 로봇을 후려쳤다｡"
  },
  {
   "id": 20067,
   "key": "D0909al.txt:559",
   "ko": "데몬베인의 주먹은 파괴 로봇의 가슴 장갑을 손쉽게 꿰뚫고 등으로 튀어나왔다｡"
  },
  {
   "id": 20069,
   "key": "D0909al.txt:564",
   "ko": "「――우리는 마를 베는 검을 잡는다!」"
  },
  {
   "id": 20070,
   "key": "D0909al.txt:579",
   "ko": "폭염을 두르고､ 강철의 거인이 여기 서 있다｡"
  },
  {
   "id": 20074,
   "key": "D0909al.txt:580",
   "ko": "그래｡ 이래야만 이 녀석이지｡"
  },
  {
   "id": 20075,
   "key": "D0909al.txt:581",
   "ko": "그 이름이 말해주는 그대로의 이 녀석이다｡"
  },
  {
   "id": 20076,
   "key": "D0909al.txt:584",
   "ko": "너는｡ 네 이름은――"
  },
  {
   "id": 20077,
   "key": "D0909al.txt:590",
   "ko": "「그대､ 무구한 칼날! 데몬베인!」"
  },
  {
   "id": 20078,
   "key": "D0909al.txt:617",
   "ko": "「……우､ 웃기지 마」"
  },
  {
   "id": 20079,
   "key": "D0909al.txt:622",
   "ko": "「……쿠로」"
  },
  {
   "id": 20082,
   "key": "D0909al.txt:627",
   "ko": "세계의 이면을 밝혀내기 위해､ 사고는 가속한다｡"
  },
  {
   "id": 20083,
   "key": "D0909al.txt:628",
   "ko": "세계의 이음매를 꿰뚫어보기 위해､ 뇌가 고속으로 연산을 개시한다｡"
  },
  {
   "id": 20084,
   "key": "D0909al.txt:633",
   "ko": "「웃기지､ 마……! 저딴 놈 멋대로 하게 놔둘까 보냐……! 그야……저런 괴물을 때려눕히기 위해――!」"
  },
  {
   "id": 20085,
   "key": "D0909al.txt:636",
   "ko": "마스터 테리온의 법칙을 깨는 나의 법칙을 구축한다｡"
  },
  {
   "id": 20086,
   "key": "D0909al.txt:637",
   "ko": "내가 형성하는 마술의 그릇｡ 세계를 낳는 법칙｡"
  },
  {
   "id": 20087,
   "key": "D0909al.txt:640",
   "ko": "우리 마술사에게 절대의 법칙은 없다｡"
  },
  {
   "id": 20088,
   "key": "D0909al.txt:641",
   "ko": "모든 법칙에는､ 그것을 깨는 식이 존재한다｡"
  },
  {
   "id": 20091,
   "key": "D0909al.txt:644",
   "ko": "즉……!"
  },
  {
   "id": 20092,
   "key": "D0909al.txt:659",
   "ko": "「이 녀석은……데몬베인은 만들어졌으니까!」"
  },
  {
   "id": 20093,
   "key": "D0909al.txt:673",
   "ko": "……즉､ 이런 식으로､ 말이다｡"
  },
  {
   "id": 20094,
   "key": "D0909al.txt:675",
   "ko": "데몬베인을 못 박고 있던 검도 십자가도 빛이 되어 소멸한다｡"
  },
  {
   "id": 20095,
   "key": "D0909al.txt:676",
   "ko": "녹아내리듯 흩어지는 빛에 비춰져､ 데몬베인도 옅게 빛난다｡"
  },
  {
   "id": 20096,
   "key": "D0909al.txt:688",
   "ko": "「큭……」"
  },
  {
   "id": 20100,
   "key": "D0909al.txt:690",
   "ko": "해주의 부담으로 여기저기 혈관이 터졌다｡"
  },
  {
   "id": 20101,
   "key": "D0909al.txt:691",
   "ko": "눈 안쪽이 뜨겁다｡ 피눈물이 뺨을 타고 흐른다｡"
  },
  {
   "id": 20103,
   "key": "D0909al.txt:697",
   "ko": "「괜찮으냐､ 쿠로!?」"
  },
  {
   "id": 20105,
   "key": "D0909al.txt:702",
   "ko": "「아아……전혀､ 별거 아냐……! 기합 넣어야 하는 건……이제부터라고!」"
  },
  {
   "id": 20106,
   "key": "D0909al.txt:707",
   "ko": "「――그래､ 그 말대로다!」"
  },
  {
   "id": 20111,
   "key": "D0909al.txt:718",
   "ko": "자유로워진 데몬베인을 알아챈 파괴 로봇들이 또 우르르 다가온다｡"
  },
  {
   "id": 20113,
   "key": "D0909al.txt:721",
   "ko": "좋아……어차피 너희들 전부 고철로 만들어 제철소행이다｡"
  },
  {
   "id": 20114,
   "key": "D0909al.txt:729",
   "ko": "「나아가자､ 쿠로!」 「응!!」"
  },
  {
   "id": 20115,
   "key": "D0909al.txt:758",
   "ko": "「……울지 마､ 공주님」"
  },
  {
   "id": 20116,
   "key": "D0909al.txt:763",
   "ko": "「……아」"
  },
  {
   "id": 20118,
   "key": "D0909al.txt:768",
   "ko": "세계의 이면을 밝혀내기 위해､ 사고는 가속한다｡"
  },
  {
   "id": 20119,
   "key": "D0909al.txt:769",
   "ko": "세계의 이음매를 꿰뚫어보기 위해､ 뇌가 고속으로 연산을 개시한다｡"
  },
  {
   "id": 20120,
   "key": "D0909al.txt:774",
   "ko": "「저런 괴물을 상대하기 위해서 이 녀석은 만들어진 거야」"
  },
  {
