{
 "packet": "0756_02",
 "items": [
  {
   "id": 11709,
   "key": "D0756.txt:406",
   "ko": "그런 거였나?"
  },
  {
   "id": 11710,
   "key": "D0756.txt:407",
   "ko": "원래 그런 건가?"
  },
  {
   "id": 11711,
   "key": "D0756.txt:410",
   "ko": "쳇……또 머리가 뒤엉키기 시작했다｡"
  },
  {
   "id": 11712,
   "key": "D0756.txt:411",
   "ko": "그렇다면､ 그때 일은 역시 현실이었단 말인가?"
  },
  {
   "id": 11713,
   "key": "D0756.txt:417",
   "ko": "「어떻게 그 괴물을 길들였는지 이 몸으로서도 흥미가 있구나｡ 그대､ 어떻게 이 몸의 분신을 홀린 것이냐?」"
  },
  {
   "id": 11714,
   "key": "D0756.txt:422",
   "ko": "「홀렸다니 너……」"
  },
  {
   "id": 11715,
   "key": "D0756.txt:425",
   "ko": "나는 깊게 한숨을 내쉬었다｡"
  },
  {
   "id": 11716,
   "key": "D0756.txt:426",
   "ko": "정말이지……뭐가 뭔지､ 도무지 모르겠다｡"
  },
  {
   "id": 11717,
   "key": "D0756.txt:429",
   "ko": "그건 그저 그 둘이 일으킨 괴이일 뿐인가?"
  },
  {
   "id": 11718,
   "key": "D0756.txt:432",
   "ko": "아니면 그 외의 누군가｡"
  },
  {
   "id": 11719,
   "key": "D0756.txt:433",
   "ko": "내가 모르는 누군가가 얽혀 있는 걸까?"
  },
  {
   "id": 11720,
   "key": "D0756.txt:436",
   "ko": "그자는､ 내가 악전고투하는 꼴을 보며､ 웃고 있는 걸까｡"
  },
  {
   "id": 11721,
   "key": "D0756.txt:439",
   "ko": "모르겠다｡ 모르는 것투성이지만――무언가가"
  },
  {
   "id": 11722,
   "key": "D0756.txt:440",
   "ko": "움직이기 시작하려 하고 있다｡"
  },
  {
   "id": 11723,
   "key": "D0756.txt:443",
   "ko": "그런 예감이 들었다――"
  },
  {
   "id": 11724,
   "key": "D0756.txt:462",
   "ko": "「아하핫､ 하하하하핫､ 하하하하하하하」"
  },
  {
   "id": 11725,
   "key": "D0756.txt:472",
   "ko": "천진한 웃음소리가 울린다｡ 천진하기에 어딘가 위험한 것을 감춘､ 그런 웃음소리가 울린다｡"
  },
  {
   "id": 11726,
   "key": "D0756.txt:474",
   "ko": "아컴시티의 하늘에｡"
  },
  {
   "id": 11727,
   "key": "D0756.txt:475",
   "ko": "태양빛에 녹아들어｡"
  },
  {
   "id": 11728,
   "key": "D0756.txt:476",
   "ko": "상쾌한 공기를 타고｡"
  },
  {
   "id": 11729,
   "key": "D0756.txt:482",
   "ko": "「네크로노미콘의 단편에 개입하는 건 꽤나 힘들었지만……생각보다 잘됐네」"
  },
  {
   "id": 11730,
   "key": "D0756.txt:492",
   "ko": "아컴시티 전체를 내려다보는 시계탑｡"
  },
  {
   "id": 11731,
   "key": "D0756.txt:493",
   "ko": "거대한､ 지나치게 거대한 시계판의､ 긴바늘 위｡"
  },
  {
   "id": 11732,
   "key": "D0756.txt:495",
   "ko": "거기에 서 있는 그림자가 있다｡"
  },
  {
   "id": 11733,
   "key": "D0756.txt:497",
   "ko": "그림자가 웃는다｡ 끝없이 펼쳐진 푸른 하늘에､ 그러나 이 한 점에 서린 어둠｡"
  },
  {
   "id": 11734,
   "key": "D0756.txt:501",
   "ko": "어둠을 걷어 내는 빛이 그림자를 낳는､ 이율배반｡"
  },
  {
   "id": 11735,
   "key": "D0756.txt:502",
   "ko": "그런 모순의 틈새에서 꿈틀대는 어둠을 떨게 하며､ 그림자가 웃는다｡"
  },
  {
   "id": 11736,
   "key": "D0756.txt:508",
   "ko": "「제법 실력이 붙었잖아｡ 이제부터네｡ 더 더 노력해서 강해지면､ 쿠로는 분명――」"
  },
  {
   "id": 11737,
   "key": "D0756.txt:515",
   "ko": "어둠 속에서､ 그림자 속에서 눈동자가 빛난다｡"
  },
  {
   "id": 11738,
   "key": "D0756.txt:516",
   "ko": "온갖 감정을 소용돌이치게 한 눈동자가､ 형형하게｡"
  },
  {
   "id": 11739,
   "key": "D0756.txt:519",
   "ko": "시선 저편에는､ 하도가의 차에 올라타는 쿠로가 있다｡"
  },
  {
   "id": 11740,
   "key": "D0756.txt:523",
   "ko": "어떤 기대를 가둔 눈동자는､ 쿠로를､ 쿠로가 탄 자동차를､ 가만히 응시하고 있다｡"
  },
  {
   "id": 11741,
   "key": "D0756.txt:526",
   "ko": "시야에서 사라져도､ 계속 계속､ 응시하고 있다――"
  },
  {
   "id": 11742,
   "key": "D0756.txt:558",
   "ko": "디버그용 선택지"
  }
 ]
}