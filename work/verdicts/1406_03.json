  },
  {
   "id": 37692,
   "key": "D1406ru.txt:29",
   "ko": "――르뤼에｡"
  },
  {
   "id": 37693,
   "key": "D1406ru.txt:33",
   "ko": "="
  },
  {
   "id": 37694,
   "key": "D1406ru.txt:40",
   "ko": "="
  },
  {
   "id": 37695,
   "key": "D1406ru.txt:42",
   "ko": "="
  },
  {
   "id": 37696,
   "key": "D1406ru.txt:44",
   "ko": "두 명의 안티크로스는 각자의 데우스 마키나에 탄 채로､ 차례로 전해지는 보고를 정리하고 있었다｡"
  },
  {
   "id": 37697,
   "key": "D1406ru.txt:48",
   "ko": "「흠…… 르뤼에 해역에는 국제연합 함대가 집결하고 있는 모양이군」 「합중국 함대도 다수 보이는군｡ 그렇군､ 그렇군｡ 이건 아마 하도 놈들의 짓이겠지」"
  },
  {
   "id": 37698,
   "key": "D1406ru.txt:55",
   "ko": "="
  },
  {
   "id": 37699,
   "key": "D1406ru.txt:59",
   "ko": "="
  },
  {
   "id": 37700,
   "key": "D1406ru.txt:65",
   "ko": "「아니､ 그걸 쓰면 술식에 흐트러짐이 생긴다｡ 그래､ 남용할 것은 아니야」 「게다가 마음에 걸리는 일이 있어서 말이지」"
  },
  {
   "id": 37701,
   "key": "D1406ru.txt:73",
   "ko": "="
  },
  {
   "id": 37702,
   "key": "D1406ru.txt:77",
   "ko": "="
  },
  {
   "id": 37703,
   "key": "D1406ru.txt:81",
   "ko": "「확실히｡ 확실히 그 공간 전이만큼은 도무지 이해가 안 되는군…… 그 이후로 술식 등의 데이터에는 아무런 이상도 없는데 말이지」 「그건 마치――」"
  },
  {
   "id": 37704,
   "key": "D1406ru.txt:88",
   "ko": "="
  },
  {
   "id": 37705,
   "key": "D1406ru.txt:92",
   "ko": "="
  },
  {
   "id": 37706,
   "key": "D1406ru.txt:96",
   "ko": "「――그런가｡ 뭐､ 좋아｡ 어쨌든 원인이 아직 밝혀지지 않은 이상､ 크툴루에게 특수한 능력을 쓰게 해서는 안 돼」"
  },
  {
   "id": 37707,
   "key": "D1406ru.txt:100",
   "ko": "="
  },
  {
   "id": 37708,
   "key": "D1406ru.txt:104",
   "ko": "「후…… 여기가 어디라고 생각하는 건가､ 형제여」 「성지를 더럽히는 무리는 경건한 신도들에게 처분을 맡기면 되지 않겠나」"
  },
  {
   "id": 37709,
   "key": "D1406ru.txt:111",
   "ko": "「…… 그렇군 그렇군｡ 여기는 바다｡ 여기는 마해｡ 여기는 크툴루의 영역이지」 「알겠어｡ 알겠다고｡ 일단 파괴 로봇은 선행시켜 두지」"
  },
  {
   "id": 37710,
   "key": "D1406ru.txt:119",
   "ko": "「아아､ 부탁하지｡ 자…… 슬슬 보이겠군､ 르뤼에가……」 「그래｡ 마인에 의한 지구 통치가 드디어 시작되는 거다! 하하하하하!」"
  },
  {
   "id": 37711,
   "key": "D1406ru.txt:127",
   "ko": "="
  },
  {
   "id": 37712,
   "key": "D1406ru.txt:128",
   "ko": "="
  },
  {
   "id": 37713,
   "key": "D1406ru.txt:130",
   "ko": "="
  },
  {
   "id": 37714,
   "key": "D1406ru.txt:134",
   "ko": "(뭐､ 지금 정도는 꿈을 꾸게 해줘야 가엾지 않겠나｡ 하지만 말이지､ 형제?)"
  },
  {
   "id": 37715,
   "key": "D1406ru.txt:138",
   "ko": "(우리는､ 세계는､ 자네가 상상하는 것보다 훨씬､ 훠어어얼씬 높은 영역에 도달하려 하고 있지｡ 아름다운 세계에 도달하려 하고 있는 거야)"
  },
  {
   "id": 37716,
   "key": "D1406ru.txt:141",
   "ko": "(그래｡ 나는 신의 힘을 세계 정복 따위의 속된 수준에서 다루지 않아)"
  },
  {
   "id": 37717,
   "key": "D1406ru.txt:144",
   "ko": "(내가 지향하는 것은 더한 아름다움｡ 지고의 미――그곳으로 이끌어 줄 이가 바로 자네다､ 『C의 무녀』여……)"
  },
  {
   "id": 37718,
   "key": "D1406ru.txt:156",
   "ko": "「시이……C……씨이……쿠스루루루우……미코……무녀……」"
  },
  {
   "id": 37719,
   "key": "D1406ru.txt:163",
   "ko": "해저에서 흔들리는 해초와도 닮은 촉수 무리에 파묻혀､ 『르뤼에 이본』의 소녀와 『폭군』 또한 몸을 흔들며 떠다니고 있다｡"
  },
  {
   "id": 37720,
   "key": "D1406ru.txt:165",
   "ko": "흔들흔들｡ 흔들흔들｡ 「……읏……읏……」"
  },
  {
   "id": 37721,
   "key": "D1406ru.txt:174",
   "ko": "울부짖으며､ 흐느끼며､ 『르뤼에 이본』은 노래를 부른다｡"
  }
 ]
}