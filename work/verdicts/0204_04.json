  },
  {
   "id": 1934,
   "key": "D0204ab.txt:384",
   "ko": "「그､ 그래도……이런 곳에선 점을 봐도 돈이 안 되잖아? 게다가 이 근처는 위험해｡ 여자 혼자선 위험하다고?」"
  },
  {
   "id": 1935,
   "key": "D0204ab.txt:389",
   "ko": "「우와아! 날 걱정해 주는 거야｡ 기쁘네에」"
  },
  {
   "id": 1936,
   "key": "D0204ab.txt:400",
   "ko": "「우왓토옷! 자､ 잠깐……나이아 씨!?」"
  },
  {
   "id": 1937,
   "key": "D0204ab.txt:403",
   "ko": "나는 갑자기 끌어안겼다｡ 나이아 씨의 가슴에 얼굴을 파묻는 꼴이 된다｡"
  },
  {
   "id": 1938,
   "key": "D0204ab.txt:409",
