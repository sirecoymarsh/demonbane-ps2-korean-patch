  },
  {
   "id": 1939,
   "key": "D0204ab.txt:414",
   "ko": "「아앙♪ 그렇게 콧김을 거칠게 내면｡ 간지럽잖아아」"
  },
  {
   "id": 1940,
   "key": "D0204ab.txt:419",
   "ko": "「음음――! 괴로……! 괴로워……!」"
  },
  {
   "id": 1941,
   "key": "D0204ab.txt:424",
   "ko": "「응응? 왜 그러는 걸까?」"
  },
  {
   "id": 1942,
   "key": "D0204ab.txt:429",
   "ko": "「수……숨! 숨이! 괴로워……!」"
  },
  {
   "id": 1943,
   "key": "D0204ab.txt:434",
   "ko": "「……오우｡ 미안､ 미안」"
  },
  {
   "id": 1944,
   "key": "D0204ab.txt:444",
   "ko": "「큭……푸하아아아아! 하아앗､ 하앗､ 하아아……!」"
  },
  {
   "id": 1945,
   "key": "D0204ab.txt:448",
   "ko": "질식 직전에야 겨우 나이아 씨는 나를 놓아주었다｡"
  },
  {
   "id": 1946,
   "key": "D0204ab.txt:454",
   "ko": "「하아……하아……하아……큭! 다､ 당신 날 죽일 셈이야……!?」"
  },
  {
   "id": 1947,
   "key": "D0204ab.txt:460",
   "ko": "「참 매정하네에｡ 조금 장난 좀 친 것뿐이잖아」"
  },
  {
   "id": 1948,
   "key": "D0204ab.txt:465",
   "ko": "장난으로 죽으면 견딜 재간이 없다｡"
  },
  {
   "id": 1949,
   "key": "D0204ab.txt:470",
   "ko": "「뭐야 뭐야､ 그렇게 삐치지 않아도 되잖아아｡ 조금은 기분 좋았지? 이 녀석 이 녀석♪」"
  },
  {
   "id": 1950,
   "key": "D0204ab.txt:475",
   "ko": "「아니､ 뭐､ 그､ 확실히 꽤……라니 그 얘긴 제쳐 두고! ……왜 하필이면 이런 곳에서 장사를?」"
  },
  {
   "id": 1951,
   "key": "D0204ab.txt:480",
   "ko": "「음――……글쎄에｡ 기의 흐름이 좋다､ 라고 해 둘까」"
  },
  {
