  {
   "id": 24247,
   "key": "D1106al.txt:814",
   "ko": "멀리 있는 빌딩에 격돌한다｡"
  },
  {
   "id": 24248,
   "key": "D1106al.txt:815",
   "ko": "그 충격으로 빌딩은 두 동강 나 무너진다｡"
  },
  {
   "id": 24249,
   "key": "D1106al.txt:820",
   "ko": "「메타트론!」"
  },
  {
   "id": 24250,
   "key": "D1106al.txt:837",
   "ko": "「윈필드! 어떻게 안 될까요!?」"
  },
  {
   "id": 24251,
   "key": "D1106al.txt:845",
   "ko": "「다이쥬지 님! 승강기까지 후퇴해 주십시오! 일단 회수하겠습니다!」"
  },
  {
   "id": 24252,
   "key": "D1106al.txt:854",
   "ko": "「후퇴하라고 해도……」"
  },
  {
   "id": 24254,
   "key": "D1106al.txt:864",
   "ko": "「부르그와아아아아아아아아아아!」"
  },
  {
   "id": 24255,
   "key": "D1106al.txt:868",
   "ko": "「그걸 허락해 줄 상대냐고!」"
  },
  {
   "id": 24256,
   "key": "D1106al.txt:880",
   "ko": "「――――!?」 「……읏! 메타트론!」"
  },
  {
   "id": 24257,
   "key": "D1106al.txt:893",
   "ko": "빌딩 잔해에 반쯤 파묻힌 채로 메타트론은 크라켄의 눈동자를 쏘았다｡"
  },
  {
   "id": 24258,
   "key": "D1106al.txt:894",
   "ko": "눈부신 빔이 칼리굴라의 시야를 빼앗는다｡"
  },
  {
   "id": 24260,
   "key": "D1106al.txt:898",
   "ko": "「다이쥬지 씨! 지금이에요!」"
  },
  {
   "id": 24262,
   "key": "D1106al.txt:903",
   "ko": "「각부 실드 개방!」"
  },
  {
   "id": 24264,
   "key": "D1106al.txt:911",
   "ko": "말할 필요도 없었다｡"
  },
  {
   "id": 24265,
   "key": "D1106al.txt:912",
   "ko": "각부 실드의 에너지를 전개해 승강기까지의 거리를 단숨에 내달린다｡"
  },
  {
   "id": 24266,
   "key": "D1106al.txt:913",
   "ko": "데몬베인을 제대로 고정하기도 전에 승강기는 지하 기지를 향해 단숨에 하강했다｡"
  },
  {
   "id": 24267,
   "key": "D1106al.txt:925",
   "ko": "섬광에 타 버린 모니터가 겨우 회복된다｡"
  },
  {
   "id": 24268,
   "key": "D1106al.txt:926",
   "ko": "데몬베인의 모습은 없다｡"
  },
  {
   "id": 24269,
   "key": "D1106al.txt:930",
   "ko": "「젠장､ 도망쳤나」"
  },
  {
   "id": 24270,
   "key": "D1106al.txt:933",
   "ko": "――아니｡ 땅울림이 대지를 흔들고 있다｡"
  },
  {
   "id": 24271,
   "key": "D1106al.txt:935",
   "ko": "게다가 기계류의 구동음도 들린다｡"
  },
  {
   "id": 24272,
   "key": "D1106al.txt:936",
   "ko": "칼리굴라는 깨달았다｡ ――지하에서인가｡"
  },
  {
   "id": 24273,
   "key": "D1106al.txt:939",
   "ko": "일시 후퇴해 태세를 갖추고 나서 또 나올 작정이겠지｡"
  },
  {
   "id": 24274,
   "key": "D1106al.txt:939",
   "ko": "그렇다면 출현과 동시에 박살내면 그만이다｡"
  },
  {
   "id": 24275,
   "key": "D1106al.txt:941",
   "ko": "극한까지 높인 마력을 유지한 채 칼리굴라는 데몬베인이 올라오기를 기다렸다｡"
  },
  {
   "id": 24276,
   "key": "D1106al.txt:948",
   "ko": "몇 분의 시간이 흘렀다｡"
  },
  {
   "id": 24277,
   "key": "D1106al.txt:949",
   "ko": "크라켄은 미동도 없이 기다린다｡"
  },
  {
   "id": 24278,
   "key": "D1106al.txt:950",
   "ko": "돌연､ 고층 빌딩이 다시 둘로 갈라졌다｡"
  }
 ]
