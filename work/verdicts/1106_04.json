  {
   "id": 24230,
   "key": "D1106al.txt:755",
   "ko": "「다이쥬지 쿠로!」"
  },
  {
   "id": 24231,
   "key": "D1106al.txt:765",
   "ko": "메타트론의 캐논포가 포효한다｡"
  },
  {
   "id": 24234,
   "key": "D1106al.txt:770",
   "ko": "하지만 그것들은 크라켄을 감싼 마법 장벽 앞에서 허무하게 흩어졌다｡"
  },
  {
   "id": 24235,
   "key": "D1106al.txt:777",
   "ko": "「이런!」"
  },
  {
   "id": 24236,
   "key": "D1106al.txt:781",
   "ko": "메타트론은 두 자루의 빔 세이버를 겨누고 크라켄에게 돌격한다｡"
  },
  {
   "id": 24237,
   "key": "D1106al.txt:782",
   "ko": "안 돼……그건 너무 무모하다고!"
  },
  {
   "id": 24238,
   "key": "D1106al.txt:786",
   "ko": "「십자……읏!」"
  },
  {
   "id": 24239,
   "key": "D1106al.txt:794",
   "ko": "「시끄럽다! 가아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 24242,
   "key": "D1106al.txt:799",
   "ko": "「――――읏!? 으아아아아아아앗!」"
  },
  {
   "id": 24243,
   "key": "D1106al.txt:803",
   "ko": "칼리굴라가 한 번 호통치자"
  },
  {
   "id": 24244,
   "key": "D1106al.txt:804",
   "ko": "크라켄의 온몸에서 마력이 뿜어져 나왔다｡"
  },
  {
   "id": 24246,
   "key": "D1106al.txt:813",
   "ko": "메타트론의 작은 몸이 날아가"
