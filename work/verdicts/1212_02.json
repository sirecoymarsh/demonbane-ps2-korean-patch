{
 "packet": "1212_02",
 "items": [
  {
   "id": 29859,
   "key": "D1212le.txt:288",
   "ko": "일어서려 해도 힘이 들어가지 않는다｡"
  },
  {
   "id": 29860,
   "key": "D1212le.txt:294",
   "ko": "「큿……윽……으……」"
  },
  {
   "id": 29861,
   "key": "D1212le.txt:299",
   "ko": "「읏! 라이카 누나!」"
  },
  {
   "id": 29862,
   "key": "D1212le.txt:303",
   "ko": "「호호호호､ 꼴 좋네」 「……윽……읏!」"
  },
  {
   "id": 29863,
   "key": "D1212le.txt:316",
   "ko": "「좋아아､ 그 표정……물어뜯고 싶어지잖아､ 우후후후｡ 그래애｡ 살짝 맛만 볼까아」"
  },
  {
   "id": 29864,
   "key": "D1212le.txt:323",
   "ko": "미끈미끈､ 민달팽이처럼 라이카의 살갗을 기어가는 촉수｡"
  },
  {
   "id": 29865,
   "key": "D1212le.txt:324",
   "ko": "기분 나쁜 감촉에 혐오를 느끼며 라이카는 얼굴을 찌푸린다｡"
  },
  {
   "id": 29866,
   "key": "D1212le.txt:325",
   "ko": "광대의 가면이 그것을 비웃는다｡"
  },
  {
   "id": 29867,
   "key": "D1212le.txt:330",
   "ko": "「그､ 그만둬! 라이카 누나한테 손대지 마! 손대지 마아아아!」"
  },
  {
   "id": 29868,
   "key": "D1212le.txt:333",
   "ko": "소리치며 몸을 비틀고 날뛰는 조지｡"
  },
  {
   "id": 29869,
   "key": "D1212le.txt:334",
   "ko": "하지만 촉수 밧줄은 소년을 단단히 죄어 놓아주지 않는다｡"
  },
  {
   "id": 29870,
   "key": "D1212le.txt:340",
   "ko": "「우후후후후｡ 조급해하지 않아도 돼｡ 너희를 따돌릴 리가 없잖아」"
  },
  {
   "id": 29871,
   "key": "D1212le.txt:347",
   "ko": "「――!? 저 아이들에게 손을 댈 셈이야!?」"
  },
  {
   "id": 29872,
   "key": "D1212le.txt:352",
   "ko": "「그야 당연하지이……이런 건 다 같이 즐기는 거라구우」"
  },
  {
   "id": 29873,
   "key": "D1212le.txt:357",
   "ko": "「비､ 비겁한 놈!」"
  },
  {
   "id": 29874,
   "key": "D1212le.txt:364",
   "ko": "「히익! 시､ 싫어! 싫어어어어!」"
  },
  {
   "id": 29875,
   "key": "D1212le.txt:369",
   "ko": "「싫어어……기분 나빠아……」"
  },
  {
   "id": 29876,
   "key": "D1212le.txt:374",
   "ko": "「으으으으으――――읍!」"
  },
  {
   "id": 29877,
   "key": "D1212le.txt:380",
   "ko": "「후후후……자､ 너희 상대도 슬슬 올 거야」"
  },
  {
   "id": 29878,
   "key": "D1212le.txt:385",
   "ko": "「에……에에?」"
  },
  {
   "id": 29879,
   "key": "D1212le.txt:388",
   "ko": "잔해에 묻힌 대피소 입구｡"
  },
  {
   "id": 29880,
   "key": "D1212le.txt:390",
   "ko": "메타트론이 빔포로 뚫은 구멍에서 줄줄이 흘러들어 오는 자들이 있었다｡ 도망쳤을 터인 피난민｡"
  },
  {
   "id": 29881,
   "key": "D1212le.txt:392",
   "ko": "아니､ 다르다｡ 결정적으로 다르다｡"
  },
  {
   "id": 29882,
   "key": "D1212le.txt:393",
   "ko": "상태는 제각각이지만､ 그들에게는 공통된 결정적인 사항이 있었다｡"
  },
  {
   "id": 29883,
   "key": "D1212le.txt:399",
   "ko": "――그들은 틀림없이､ 한 사람도 남김없이､ 죽어 있었다｡"
  },
  {
   "id": 29884,
   "key": "D1212le.txt:402",
   "ko": "이것은 사자의 무리다｡"
  },
  {
   "id": 29885,
   "key": "D1212le.txt:403",
   "ko": "죽어서도 여전히 꿈틀거리는､ 시체의 무리다｡"
  },
  {
   "id": 29886,
   "key": "D1212le.txt:409",
   "ko": "「자아､ 『두근! 좀비투성이 절규 파티』의 시작이야아~!」"
  },
  {
   "id": 29887,
   "key": "D1212le.txt:413",
   "ko": "시체라고는 생각할 수 없는 민첩함으로､ 좀비들은 아이들에게 몰려든다｡"
  },
  {
   "id": 29888,
   "key": "D1212le.txt:415",
   "ko": "그 일심불란한 폭력은 산 자에 대한 질투인가｡"
  },
  {
   "id": 29889,
   "key": "D1212le.txt:416",
   "ko": "아니면 따뜻한 육체에 대한 동경인가｡"
  },
  {
   "id": 29890,
   "key": "D1212le.txt:423",
   "ko": "「싫어어어어어어어! 살려줘어어어어! 살려줘어어어어어!」"
  },
  {
   "id": 29891,
   "key": "D1212le.txt:428",
   "ko": "「우아아아아! 오지 마! 오지 마아아아아!」"
  },
  {
   "id": 29892,
   "key": "D1212le.txt:434",
   "ko": "「으에에에에에에엥! 삐에에에에에에에에!」"
  },
  {
   "id": 29893,
   "key": "D1212le.txt:439",
   "ko": "「조지! 콜린! 앨리슨!」"
  },
  {
   "id": 29894,
   "key": "D1212le.txt:445",
   "ko": "「자아아아､ 넌 내 상대를 해 줘야겠어」"
  },
  {
   "id": 29895,
   "key": "D1212le.txt:450",
   "ko": "「윽……큿……으윽……!」"
  },
  {
   "id": 29896,
   "key": "D1212le.txt:456",
   "ko": "밀려오는 사자를 앞에 두고도 라이카에게 공포는 없었다｡"
  },
  {
   "id": 29897,
   "key": "D1212le.txt:458",
   "ko": "있는 것은 그저 부조리에 대한 분노｡"
  },
  {
   "id": 29898,
   "key": "D1212le.txt:459",
   "ko": "무력한 자신에 대한 증오｡"
  }
 ]
}