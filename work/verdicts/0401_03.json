   "ko": "="
  },
  {
   "id": 4236,
   "key": "D0401.txt:1109",
   "ko": "잠시 후､ 어떤 문 앞에서 멈췄다｡"
  },
  {
   "id": 4237,
   "key": "D0401.txt:1110",
   "ko": "여기가 응접실인 모양이다｡"
  },
