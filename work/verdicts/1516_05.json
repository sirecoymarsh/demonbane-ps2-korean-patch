{
 "packet": "1516_05",
 "items": [
  {
   "id": 47962,
   "key": "D1516le.txt:350",
   "ko": "온 힘과 온 혼을 걸고 데몬베인에 개입한다｡"
  },
  {
   "id": 47963,
   "key": "D1516le.txt:351",
   "ko": "샤이닝 트라페조헤드론의 힘을 다른 벡터로…… 세계의 『바깥쪽』으로 향하게 한다｡"
  },
  {
   "id": 47964,
   "key": "D1516le.txt:359",
   "ko": "「――――!?」"
  },
  {
   "id": 47965,
   "key": "D1516le.txt:363",
   "ko": "「쿠로 구우우우우우운!」"
  },
  {
   "id": 47966,
   "key": "D1516le.txt:367",
   "ko": "「그으으으……아아아……아아아아아아아아아아아아!」"
  },
  {
   "id": 47967,
   "key": "D1516le.txt:371",
   "ko": "「데몬베이인!」"
  },
  {
   "id": 47968,
   "key": "D1516le.txt:393",
   "ko": "『바깥쪽』이 세계를 침식한다｡"
  },
  {
   "id": 47972,
   "key": "D1516le.txt:394",
   "ko": "『바깥쪽』은 데몬베인을､ 리베르 레기스를 삼켰다｡"
  },
  {
   "id": 47973,
   "key": "D1516le.txt:394",
   "ko": "아니､ 오히려 이 우주 영역째 잘라내어 끌어들인다｡"
  },
  {
   "id": 47974,
   "key": "D1516le.txt:396",
   "ko": "세계를 좀먹는 괴이 한복판에서 나는 보았다｡"
  },
  {
   "id": 47975,
   "key": "D1516le.txt:403",
   "ko": "신주가 무너져 간다｡"
  },
  {
   "id": 47977,
   "key": "D1516le.txt:404",
   "ko": "빛이 되어 무너져 간다｡"
  },
  {
   "id": 47979,
   "key": "D1516le.txt:405",
   "ko": "어둠이 되어 녹아간다｡"
  },
  {
   "id": 47982,
   "key": "D1516le.txt:406",
   "ko": "신의 영역에 존재하는 물질이 다시 혼돈의 정원으로 돌아간다｡"
  },
  {
   "id": 47983,
   "key": "D1516le.txt:410",
   "ko": "터지는 빛｡"
  },
  {
   "id": 47984,
   "key": "D1516le.txt:411",
   "ko": "썩어가는 어둠｡"
  },
  {
   "id": 47985,
   "key": "D1516le.txt:412",
   "ko": "불타는 어둠｡"
  },
  {
   "id": 47986,
   "key": "D1516le.txt:413",
   "ko": "얼어붙는 빛｡"
  },
  {
   "id": 47987,
   "key": "D1516le.txt:417",
   "ko": "그리고――"
  },
  {
   "id": 47988,
   "key": "D1516le.txt:427",
   "ko": "――6500만 년 전｡ 지구｡"
  },
  {
   "id": 47989,
   "key": "D1516le.txt:432",
   "ko": "이때 우주에서 갑자기 날아든 에너지가 우리 시대로 치면 멕시코 유카탄 반도를 직격해 대폭발을 일으켰다｡"
  },
  {
   "id": 47992,
   "key": "D1516le.txt:434",
   "ko": "그것은 지구의 생명에 내리쳐진 사신의 낫이자 주어진 진화의 황금이었다｡"
  },
  {
   "id": 47995,
   "key": "D1516le.txt:436",
   "ko": "폭발 중심부의 온도는 섭씨 6만 도｡"
  },
  {
   "id": 48003,
   "key": "D1516le.txt:437",
   "ko": "일체를 증발시킨다｡"
  },
  {
   "id": 48004,
   "key": "D1516le.txt:439",
   "ko": "지표에 뚫린 크레이터는 지름 170킬로미터｡"
  },
  {
   "id": 48006,
   "key": "D1516le.txt:440",
   "ko": "깊이는 맨틀층까지 이르렀다｡"
  },
  {
   "id": 48007,
   "key": "D1516le.txt:442",
   "ko": "대지진이 별을 뒤흔들고 전 세계를 해일이 덮친다｡"
  },
  {
   "id": 48008,
   "key": "D1516le.txt:444",
   "ko": "나아가 대량의 분진을 뿜어 올려 지구 전역을 뒤덮고――이후 백만 년에 이르는 빙하기를 초래하는 결과가 되었다｡"
  },
  {
   "id": 48010,
   "key": "D1516le.txt:446",
   "ko": "그 사실을 다이쥬지 쿠로는 알 도리가 없다｡"
  },
  {
   "id": 48013,
   "key": "D1516le.txt:458",
   "ko": "「……쿠로 군이､ 절망을 모르는 영웅이､ 신을 죽이는 칼날이､ 마침내 『빛나는 트라페조헤드론』의 힘에 닿았어」"
  },
  {
   "id": 48014,
   "key": "D1516le.txt:461",
   "ko": "「그렇다면 다음이야말로､ 다음이야말로 올지도 몰라｡ 억겁을 쌓아 올리며 애타게 그리던 염원의 때가 찾아올지도 몰라」"
  },
  {
   "id": 48015,
   "key": "D1516le.txt:464",
   "ko": "「마침내……마침내 마침내 마침내 마침내……!」"
  },
  {
   "id": 48018,
   "key": "D1516le.txt:467",
   "ko": "열에 들뜬 듯한 황홀이 어둠의 여자를 떨게 한다｡"
  },
  {
   "id": 48019,
   "key": "D1516le.txt:468",
   "ko": "환희의 웃음이 울려 퍼졌다｡"
  },
  {
   "id": 48020,
   "key": "D1516le.txt:472",
   "ko": "「그래……다음엔 끝낼 수 있을지도 몰라｡ 그러기 위해서라도 이제 한 번 더 반복하자｡ 시간의 나선을 오르게 하자」"
  },
  {
   "id": 48022,
   "key": "D1516le.txt:476",
   "ko": "「그래｡ 이번에야말로､ 이번에야말로 닿아｡ 그리운､ 꺼림칙한 저 혼돈에｡ 부글부글 끓어오르는､ 눈멀고 어리석은 혼돈의 바다로――」"
  },
  {
   "id": 48025,
   "key": "D1516le.txt:480",
   "ko": "「너와 함께｡ 있잖아､ 꼬마야……?」"
  },
  {
   "id": 48027,
   "key": "D1516le.txt:483",
   "ko": "어둠의 여자가 제 가슴을 끌어안는다｡"
  },
  {
   "id": 48028,
   "key": "D1516le.txt:484",
   "ko": "어느새 그 풍만한 젖가슴 사이에 그 병이――마인의 태아를 담은 병이 끼워져 있었다｡"
  },
  {
   "id": 48030,
   "key": "D1516le.txt:486",
   "ko": "희미하게 빛나는 액체에 물거품이 인다｡"
  }
 ]
}