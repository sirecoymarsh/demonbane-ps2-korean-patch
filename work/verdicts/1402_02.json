   "key": "D1402le.txt:226",
   "ko": "="
  },
  {
   "id": 36613,
   "key": "D1402le.txt:227",
   "ko": "아니……"
  },
  {
   "id": 36614,
   "key": "D1402le.txt:233",
   "ko": "「……절대로 저지해야만 합니다」"
  },
