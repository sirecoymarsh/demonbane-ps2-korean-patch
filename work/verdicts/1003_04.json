{
 "packet": "1003_04",
 "items": [
  {
   "id": 21059,
   "key": "D1003al.txt:1135",
   "ko": "파괴의 빛이 마침내 내부를 침식하기 시작했다｡"
  },
  {
   "id": 21061,
   "key": "D1003al.txt:1137",
   "ko": "기체를 짓눌러 도려내고 태우고､"
  },
  {
   "id": 21062,
   "key": "D1003al.txt:1138",
   "ko": "증발시키는 질량을 동반한 빛｡"
  },
  {
   "id": 21063,
   "key": "D1003al.txt:1139",
   "ko": "데몬베인을 꿰뚫고 분쇄하는 파괴의 망치｡"
  },
  {
   "id": 21064,
   "key": "D1003al.txt:1141",
   "ko": "빛이 가져오는 파괴가 쿠로 일행에게 닿는다――!"
  },
  {
   "id": 21065,
   "key": "D1003al.txt:1149",
   "ko": "「쿠로! 쿠로! 이놈……이런 곳에서――――!」"
  },
  {
   "id": 21066,
   "key": "D1003al.txt:1152",
   "ko": "밑바닥에서 쥐어짜낸 듯한 영혼의 절규｡"
  },
  {
   "id": 21067,
   "key": "D1003al.txt:1153",
   "ko": "절망이 빛의 속도로 알을 능욕한다｡"
  },
  {
   "id": 21069,
   "key": "D1003al.txt:1155",
   "ko": "그 절망마저 붕괴시키는 무자비한 멸망의 촉수에 붙들려――"
  },
  {
   "id": 21070,
   "key": "D1003al.txt:1156",
   "ko": "그 순간､ 알의 내부에서 무언가가 움직이기 시작했다｡"
  },
  {
   "id": 21071,
   "key": "D1003al.txt:1160",
   "ko": "「――――――――!?」 단절되었다――"
  },
  {
   "id": 21072,
   "key": "D1003al.txt:1170",
   "ko": "『혼돈에 대하여(검열됨)』"
  },
  {
   "id": 21073,
   "key": "D1003al.txt:1172",
   "ko": "강건하고도 강대한 무언가｡"
  },
  {
   "id": 21074,
   "key": "D1003al.txt:1173",
   "ko": "그것은 상자 안에 갇힌 우주――"
  },
  {
   "id": 21076,
   "key": "D1003al.txt:1177",
   "ko": "「아……아아아……아……읏!」"
  },
  {
   "id": 21077,
   "key": "D1003al.txt:1180",
   "ko": "그리고､ 빛이"
  },
  {
   "id": 21079,
   "key": "D1003al.txt:1182",
   "ko": "어둠이――"
  },
  {
   "id": 21086,
   "key": "D1003al.txt:1204",
   "ko": "「물러나아아아아아――――――!」"
  },
  {
   "id": 21087,
   "key": "D1003al.txt:1209",
   "ko": "「――――――읏읏!?」"
  },
  {
   "id": 21089,
   "key": "D1003al.txt:1215",
   "ko": "갑작스러운 변모였다｡"
  },
  {
   "id": 21090,
   "key": "D1003al.txt:1216",
   "ko": "열백의 포효와 함께 메타트론의 속도가 산달폰의 반응을 넘어섰다｡"
  },
  {
   "id": 21091,
   "key": "D1003al.txt:1230",
   "ko": "산달폰이 본 것은 내달리는 섬광뿐이었다｡"
  },
  {
   "id": 21092,
   "key": "D1003al.txt:1232",
   "ko": "산달폰의 시간이 정지한다｡"
  },
  {
   "id": 21094,
   "key": "D1003al.txt:1236",
   "ko": "메타트론은 산달폰을 신경 쓰지도 않는다｡"
  },
  {
   "id": 21095,
   "key": "D1003al.txt:1237",
   "ko": "그 바로 옆을 스쳐 지나､ 지금 막 절체절명의 위기에 직면한 데몬베인을 향해 질주한다｡"
  },
  {
   "id": 21096,
   "key": "D1003al.txt:1238",
   "ko": "밤하늘에 하얀 궤적이 새겨졌다｡"
  },
  {
   "id": 21097,
   "key": "D1003al.txt:1240",
   "ko": "홀로 남겨진 검은 천사｡"
  },
  {
   "id": 21099,
   "key": "D1003al.txt:1246",
   "ko": "「메타트론……어디까지 나를……우롱해야……직성이 풀리겠나!」"
  },
  {
   "id": 21100,
   "key": "D1003al.txt:1249",
   "ko": "떨리는 목소리에는 이미 원념마저 가득 차 있었다｡"
  },
  {
   "id": 21103,
   "key": "D1003al.txt:1253",
   "ko": "「나는……나는……네놈을……반드시읏」"
  },
  {
   "id": 21106,
   "key": "D1003al.txt:1257",
   "ko": "검은 장갑이――세로로 갈라졌다｡"
  },
  {
   "id": 21107,
   "key": "D1003al.txt:1260",
   "ko": "메타트론의 너무나 빨랐던 참격에 이제야 시간이 따라잡은 것이다｡"
  },
  {
   "id": 21108,
   "key": "D1003al.txt:1266",
   "ko": "선혈이 뿜어져 나오고 산달폰의 몸이 기울었다｡"
  },
  {
   "id": 21109,
   "key": "D1003al.txt:1270",
   "ko": "「반드시……죽…여､ 메타……트……」"
  },
  {
   "id": 21110,
   "key": "D1003al.txt:1273",
   "ko": "「……네……놈읏」"
  },
  {
   "id": 21112,
   "key": "D1003al.txt:1276",
   "ko": "날개가 출력을 잃었다｡"
  },
  {
   "id": 21113,
   "key": "D1003al.txt:1277",
   "ko": "원한을 하늘에 남기고 검은 천사가 땅으로 떨어진다｡"
  },
  {
   "id": 21115,
   "key": "D1003al.txt:1278",
   "ko": "흐르는 피가 휘날리며 실을 그린다｡"
  },
  {
   "id": 21117,
   "key": "D1003al.txt:1280",
   "ko": "메타트론이 사라진 방향｡"
  },
  {
   "id": 21119,
   "key": "D1003al.txt:1286",
   "ko": "섬광이 터졌다｡"
  }
 ]
}