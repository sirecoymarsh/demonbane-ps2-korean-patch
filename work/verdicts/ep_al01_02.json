   "ko": "="
  },
  {
   "id": 49112,
   "key": "ep_al01.txt:360",
   "ko": "「「으아아아아아아아아!?」」"
  },
  {
   "id": 49113,
   "key": "ep_al01.txt:372",
   "ko": "…이거 참｡"
