  {
   "id": 6229,
   "key": "D0501.txt:2123",
   "ko": "땅에 내동댕이쳐진 충격에 무심코 언월도를 놓쳐 버렸다｡"
  },
  {
   "id": 6230,
   "key": "D0501.txt:2133",
   "ko": "풀려난 언월도는 쏜살같이 날아간다｡"
  },
  {
   "id": 6232,
   "key": "D0501.txt:2139",
   "ko": "="
  },
  {
   "id": 6233,
   "key": "D0501.txt:2149",
   "ko": "뒤를 돌아본다……"
  },
  {
   "id": 6234,
   "key": "D0501.txt:2160",
   "ko": "엘자가 지나치게 거대하고 위험천만한 대포를 겨누고 있었다｡"
  },
  {
   "id": 6235,
   "key": "D0501.txt:2165",
   "ko": "「이봐 이봐……잠깐 기다려」"
  },
  {
   "id": 6236,
   "key": "D0501.txt:2170",
   "ko": "게다가 포신을 달리는 빛줄기……저건 마력의 반짝임｡"
  },
  {
   "id": 6237,
   "key": "D0501.txt:2171",
   "ko": "새겨진 마술 문자｡ 마도병기인가……!?"
  },
  {
   "id": 6238,
   "key": "D0501.txt:2178",
   "ko": "「――목표의 현존을 확인｡ 술식마포의 출력을 증폭한다 로봇」"
  },
  {
   "id": 6239,
   "key": "D0501.txt:2190",
   "ko": "엄청 위험한 소리를 지껄여댔다｡"
  },
  {
   "id": 6240,
   "key": "D0501.txt:2191",
   "ko": "포신을 달리는 빛이 불타오르듯 격렬해진다｡"
  },
  {
   "id": 6241,
   "key": "D0501.txt:2198",
   "ko": "「그러니까 기다리라고오오오오오오오오!」"
  },
  {
   "id": 6242,
   "key": "D0501.txt:2204",
   "ko": "「아니 그보다､ 도망치지 못하겠느냐아아――앗!」"
  },
  {
   "id": 6243,
   "key": "D0501.txt:2211",
   "ko": "하지만 무자비하게도 방아쇠는 당겨진다｡"
  },
  {
   "id": 6244,
   "key": "D0501.txt:2227",
   "ko": "「젠자아아아앙! 맨날 맨날 타거나 날아가거나 폭발하거나 그런 것뿐이잖아아아아아아아아아아!」"
  },
  {
   "id": 6245,
   "key": "D0501.txt:2248",
   "ko": "그리고 오늘도 힘차게 대폭발｡"
  }
