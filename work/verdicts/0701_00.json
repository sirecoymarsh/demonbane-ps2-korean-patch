  },
  {
   "id": 8108,
   "key": "D0701_ps2.txt:40",
   "ko": "빛에 쫓겨 간신히 남겨진､ 우리 신의 성역｡"
  },
  {
   "id": 8109,
   "key": "D0701_ps2.txt:43",
   "ko": "육지의 인간 놈들｡"
  },
  {
   "id": 8110,
   "key": "D0701_ps2.txt:44",
   "ko": "저주스러운 침략자 놈들｡"
  },
  {
   "id": 8111,
   "key": "D0701_ps2.txt:47",
   "ko": "저놈들을 떠올릴 때마다 오장육부가 끓어오른다｡"
  },
  {
   "id": 8112,
   "key": "D0701_ps2.txt:50",
   "ko": "옛날､ 이 땅은 낙원이었다｡"
  },
  {
   "id": 8113,
   "key": "D0701_ps2.txt:51",
   "ko": "썩은 내가 나고､ 미지근한 바람이 부는､ 안주의 땅이었다｡"
  },
  {
   "id": 8114,
   "key": "D0701_ps2.txt:54",
   "ko": "허나 이제는 잃어버리고 말았다｡"
  },
  {
   "id": 8115,
   "key": "D0701_ps2.txt:62",
   "ko": "――하도 코조｡"
  },
  {
   "id": 8116,
   "key": "D0701_ps2.txt:65",
   "ko": "그놈의 짓이다｡ 그놈이 이 땅에 와서 그 시설을 세운 뒤로､ 모든 것이 변해버렸다｡"
  },
  {
   "id": 8117,
   "key": "D0701_ps2.txt:68",
   "ko": "육지의 인간들이 모여들어､ 청정한 기운으로 이 땅을 씻어내버렸다｡"
  },
  {
   "id": 8118,
   "key": "D0701_ps2.txt:71",
   "ko": "원통하도다｡"
  },
  {
   "id": 8119,
   "key": "D0701_ps2.txt:72",
   "ko": "우리의 영역을 양의 기운으로 더럽히는 저것들｡"
  },
  {
   "id": 8120,
   "key": "D0701_ps2.txt:74",
   "ko": "원통하도다｡"
  },
  {
   "id": 8121,
   "key": "D0701_ps2.txt:75",
   "ko": "우리 신을 모독하는 인간 놈들｡"
  },
  {
   "id": 8122,
   "key": "D0701_ps2.txt:78",
   "ko": "저것들에게 다시 한 번 뼈저리게 알려주마｡"
  },
  {
   "id": 8123,
   "key": "D0701_ps2.txt:79",
   "ko": "우리의 분노를､ 우리 신의 심판을 뼈저리게 알려주마｡"
  },
  {
   "id": 8124,
   "key": "D0701_ps2.txt:92",
   "ko": "「싫어…… 살려…… 누구든…… 살려……」"
  },
  {
   "id": 8125,
   "key": "D0701_ps2.txt:100",
   "ko": "쉰 목소리로 도움을 청하는 여자가 보인다｡"
  },
  {
   "id": 8126,
   "key": "D0701_ps2.txt:101",
   "ko": "여자의 몸은 번들번들한 점액으로 뒤덮여 있다｡"
  },
  {
   "id": 8127,
   "key": "D0701_ps2.txt:105",
   "ko": "그 여자에게 몰려드는 그림자｡ 그림자｡ 그림자｡ 「무구르…… 군……」"
  },
  {
   "id": 8128,
   "key": "D0701_ps2.txt:119",
   "ko": "「……라……우가……르」 기이한 빛을 머금은 무수한 눈이 여자를 훑어본다｡"
  },
  {
   "id": 8129,
   "key": "D0701_ps2.txt:130",
   "ko": "무수한 팔이 제물을 향해 뻗어온다｡ 그림자가 여자를 삼켜간다｡"
  },
  {
   "id": 8130,
   "key": "D0701_ps2.txt:139",
   "ko": "「살려…… 줘……」 비명은 큰 방에 메아리치는 이형의 소리에 지워져버린다｡"
  },
  {
   "id": 8131,
   "key": "D0701_ps2.txt:167",
   "ko": "『의식』을 지켜보던 장로는 곁에 선 남자를 돌아보았다｡"
  },
  {
   "id": 8132,
   "key": "D0701_ps2.txt:177",
   "ko": "그 자리의 분위기와는 전혀 어울리지 않는 남자였다｡"
  },
  {
   "id": 8133,
   "key": "D0701_ps2.txt:180",
   "ko": "고급스러운 정장 위에 외투를 걸치고､ 턱에 기른 수염을 쓰다듬으며､ 온화한 미소를 띤 채 이쪽을 바라보고 있다｡"
  },
  {
   "id": 8134,
   "key": "D0701_ps2.txt:182",
   "ko": "무슨 생각을 하는지 알 수 없는､ 종잡을 수 없는 분위기가 있다｡"
  },
  {
   "id": 8135,
   "key": "D0701_ps2.txt:185",
   "ko": "허나 이 신사야말로 그들에게는 구원의 주인 것이다｡"
  },
  {
   "id": 8136,
   "key": "D0701_ps2.txt:192",
   "ko": "「네가 하는 말 믿어도 되는 거겠지?」"
  },
  {
   "id": 8137,
   "key": "D0701_ps2.txt:198",
   "ko": "장로가 상대의 속을 떠보듯 의심스럽게 묻는다｡ 어눌한 말투였다｡"
  },
  {
   "id": 8138,
   "key": "D0701_ps2.txt:202",
   "ko": "비유하자면 인간이 아닌 무언가가 인간과는 다른 발성 기관으로 억지로 인간의 목소리를 만들어내는 듯한､ 그런 위화감 있는 말투｡"
  },
  {
   "id": 8139,
   "key": "D0701_ps2.txt:206",
   "ko": "장로의 말에 신사는 우아하게 고개를 끄덕여 보였다｡"
  },
  {
   "id": 8140,
   "key": "D0701_ps2.txt:212",
   "ko": "「물론｡ 물론이고말고､ 장로｡ 우리의 연구는 완전하지｡ 완벽하고말고」"
  },
  {
   "id": 8141,
   "key": "D0701_ps2.txt:215",
   "ko": "「큰 배를 탄 셈 치고 있게나…… 아니､ 배가 없어도 빠져 죽지는 않으려나｡ 당신들은」"
  },
  {
   "id": 8142,
   "key": "D0701_ps2.txt:221",
   "ko": "「허나 어찌하여 육지의 인간이 우리에게 가담하지? 무슨 속셈이냐?」"
  }
 ]
