   "id": 1795,
   "key": "D0204.txt:305",
   "ko": "틈만 나면 이쪽을 속여 가짜를 떠넘기려는 점원들을 요리조리 피하면서 마도서를 찾아 돌아다닌다｡ 하지만"
  },
  {
   "id": 1796,
   "key": "D0204.txt:314",
   "ko": "……역시 그렇게 쉽게 찾아지는 건 아닌가｡"
  },
  {
   "id": 1797,
   "key": "D0204.txt:317",
   "ko": "뭔가 진전이 없다고 할까｡"
  },
  {
   "id": 1798,
   "key": "D0204.txt:318",
   "ko": "좀 더 방법을 바꿔봐야 하려나?"
  },
  {
   "id": 1799,
   "key": "D0204.txt:323",
   "ko": "「오오오……오오――」"
  },
  {
   "id": 1800,
   "key": "D0204.txt:328",
   "ko": "「………………」 돌아보니 알 아지프는 아직도 내 뒤를 쫄래쫄래 따라오고 있다｡"
  },
  {
   "id": 1801,
   "key": "D0204.txt:334",
   "ko": "처마 밑에 늘어선 노점을 눈을 반짝이며 신기한 듯 둘러보고 있었다｡"
  },
  {
   "id": 1802,
   "key": "D0204.txt:342",
   "ko": "「여전히 인간의 세계는 흥미롭도다｡ 잠시 눈을 뗀 사이에 용케도 이만큼이나 달라지는구나」"
  },
  {
   "id": 1803,
   "key": "D0204.txt:347",
   "ko": "「………………」"
  },
  {
   "id": 1804,
   "key": "D0204.txt:350",
   "ko": "그 모습은 겉보기 나이에 걸맞은 천진한 소녀로 보이지 않는 것도 아니다｡ 이런 뒷골목에 어울리는지는 별개로 치고 말이지만｡"
  },
  {
   "id": 1805,
   "key": "D0204.txt:353",
   "ko": "="
  },
  {
   "id": 1806,
   "key": "D0204.txt:361",
   "ko": "「왜 그러느냐､ 주인? 드디어 각오가 섰느냐?」"
  },
  {
   "id": 1807,
   "key": "D0204.txt:366",
   "ko": "「……웃기지 마」"
  },
  {
   "id": 1808,
   "key": "D0204.txt:375",
   "ko": "내뱉고는 다시 정면으로 고개를 돌려 걷기 시작한다｡"
  },
  {
   "id": 1809,
   "key": "D0204.txt:377",
   "ko": "="
  },
  {
   "id": 1810,
   "key": "D0204.txt:378",
   "ko": "="
  },
  {
   "id": 1811,
   "key": "D0204.txt:380",
   "ko": "="
  },
  {
   "id": 1812,
   "key": "D0204.txt:381",
   "ko": "="
  },
  {
   "id": 1813,
   "key": "D0204.txt:384",
   "ko": "의식하지 마……"
  },
  {
   "id": 1814,
   "key": "D0204.txt:389",
   "ko": "「………………」"
  },
  {
   "id": 1815,
   "key": "D0204.txt:394",
   "ko": "="
  },
  {
   "id": 1816,
   "key": "D0204.txt:396",
   "ko": "="
  },
  {
   "id": 1817,
   "key": "D0204.txt:397",
   "ko": "이대로 포기해 주지 않으면――"
  },
  {
   "id": 1818,
   "key": "D0204.txt:402",
   "ko": "「하후하후､ 우물우물…… 음､ 맛있도다 맛있도다」"
  },
  {
   "id": 1819,
   "key": "D0204.txt:411",
   "ko": "「……라니 뭘 처먹고 있는 거야､ 너어어어!?」"
  },
  {
   "id": 1820,
   "key": "D0204.txt:420",
   "ko": "「으응?」"
  },
  {
   "id": 1821,
   "key": "D0204.txt:428",
   "ko": "다시 한번 돌아보니 노점 음식을 잔뜩 입에 물고 있는 알 아지프가 있었다｡"
  },
  {
   "id": 1822,
   "key": "D0204.txt:437",
   "ko": "「우물우물……꿀꺽｡ 뭐냐､ 그대도 먹겠느냐?」"
  },
  {
   "id": 1823,
   "key": "D0204.txt:443",
   "ko": "「그런 얘기가 아니라! 너､ 그 음식 산더미는 어떻게 된 거야!?」"
  },
  {
   "id": 1824,
   "key": "D0204.txt:451",
   "ko": "「훗……이것 말이냐? 이건 말이다､ 아까부터 노점 옆을 지날 때마다 『아가씨 귀엽구나』라며 점원이 바쳐 준 것이니라」 「당연한 일이라 하나…… 이 몸의 미모도 참으로 죄가 많도다」"
  },
  {
   "id": 1825,
   "key": "D0204.txt:466",
   "ko": "「아니 그거 분명 그런 뜻이 아닐 거라고오오오!?」"
  },
  {
   "id": 1826,
   "key": "D0204.txt:471",
   "ko": "「손니이이임~~~~?」"
  },
  {
   "id": 1827,
   "key": "D0204.txt:476",
   "ko": "="
  },
  {
   "id": 1828,
   "key": "D0204.txt:481",
   "ko": "「……역시 그런 거냐」"
  },
  {
   "id": 1829,
   "key": "D0204.txt:490",
   "ko": "="
  },
  {
   "id": 1830,
   "key": "D0204.txt:495",
   "ko": "알의 등 뒤에서 관자놀이 혈관을 씰룩거리는 험상궂은 아저씨들 무리가 떡 버티고 서 있었다｡"
  },
  {
   "id": 1831,
   "key": "D0204.txt:500",
   "ko": "「곤란한데 말이야……무전취식은」"
  },
  {
   "id": 1832,
   "key": "D0204.txt:505",
   "ko": "「형씨……동생 단속은 제대로 해야지 안 그래?」"
  },
  {
   "id": 1833,
   "key": "D0204.txt:511",
   "ko": "아니､ 남매 아니다｡"
  },
  {
   "id": 1834,
   "key": "D0204.txt:512",
   "ko": "그보다 이런 동생은 싫다｡"
  }
 ]
