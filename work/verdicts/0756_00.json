{
 "packet": "0756_00",
 "items": [
  {
   "id": 11629,
   "key": "D0756.txt:13",
   "ko": "「……쿠로…… 쿠로……!」"
  },
  {
   "id": 11630,
   "key": "D0756.txt:19",
   "ko": "「…………엇､ 어?」"
  },
  {
   "id": 11631,
   "key": "D0756.txt:30",
   "ko": "내 이름을 부르는 소리에 눈을 뜬다｡"
  },
  {
   "id": 11632,
   "key": "D0756.txt:32",
   "ko": "눈꺼풀을 들어 올리는 것조차 귀찮았다｡"
  },
  {
   "id": 11633,
   "key": "D0756.txt:33",
   "ko": "눈의 초점이 좀처럼 맞지 않는다｡"
  },
  {
   "id": 11634,
   "key": "D0756.txt:35",
   "ko": "흐릿한 시야､ 하지만 누군가가 내 얼굴을 들여다보고 있다는 것만은 알겠다｡"
  },
  {
   "id": 11635,
   "key": "D0756.txt:41",
   "ko": "「에에이､ 칠칠치 못하구나! 정신 차리거라!」"
  },
  {
   "id": 11636,
   "key": "D0756.txt:47",
   "ko": "이 난폭한 말투｡"
  },
  {
   "id": 11637,
   "key": "D0756.txt:48",
   "ko": "틀림없다｡"
  },
  {
   "id": 11638,
   "key": "D0756.txt:50",
   "ko": "나는 몇 번이나 눈을 깜빡여 초점을 되찾는다｡"
  },
  {
   "id": 11639,
   "key": "D0756.txt:55",
   "ko": "「……알?」"
  },
  {
   "id": 11640,
   "key": "D0756.txt:64",
   "ko": "「어이구 참…… 이제야 깨어났느냐」"
  },
  {
   "id": 11641,
   "key": "D0756.txt:74",
   "ko": "……상황이 전혀 파악되지 않는다｡"
  },
  {
   "id": 11642,
   "key": "D0756.txt:76",
   "ko": "일어나려다…… 몸이 납덩이처럼 무거운 것을 깨닫는다｡"
  },
  {
   "id": 11643,
   "key": "D0756.txt:82",
   "ko": "「뭐､ 뭐야아……?」"
  },
  {
   "id": 11644,
   "key": "D0756.txt:90",
   "ko": "「무리하지 마라｡ 몸이 지쳐 있느니라」"
  },
  {
   "id": 11645,
   "key": "D0756.txt:95",
   "ko": "「어째서…… 앗」"
  },
  {
   "id": 11646,
   "key": "D0756.txt:101",
   "ko": "생각났다｡"
  },
  {
   "id": 11647,
   "key": "D0756.txt:104",
   "ko": "나는 이세계로 끌려가､ 거기서 인간화한 크투가와 이타콰를 만났다｡"
  },
  {
   "id": 11648,
   "key": "D0756.txt:107",
   "ko": "게다가 그 신기한 광경――"
  },
  {
   "id": 11649,
   "key": "D0756.txt:125",
   "ko": "어라? 뭐지?"
  },
  {
   "id": 11650,
   "key": "D0756.txt:126",
   "ko": "또렷하게 떠오르지 않는다｡"
  },
  {
   "id": 11651,
   "key": "D0756.txt:129",
   "ko": "뭔가 엄청난 것을 목격한 것 같은데……"
  },
  {
   "id": 11652,
   "key": "D0756.txt:136",
   "ko": "「괜찮으냐? 넋이 나간 듯하다만」"
  },
  {
   "id": 11653,
   "key": "D0756.txt:141",
   "ko": "「어……? 아아､ 걱정 마｡ 괜찮아」"
  },
  {
   "id": 11654,
   "key": "D0756.txt:144",
   "ko": "「그래서…… 여긴 어디야? 그 이상한 복도는……?」"
  },
  {
   "id": 11655,
   "key": "D0756.txt:154",
   "ko": "「……무슨 소리를 하는 게냐?」"
  },
  {
   "id": 11656,
   "key": "D0756.txt:159",
   "ko": "「………………」"
  },
  {
   "id": 11657,
   "key": "D0756.txt:164",
   "ko": "아무래도 어딘가의 폐건물인 듯하다｡"
  },
  {
   "id": 11658,
   "key": "D0756.txt:165",
   "ko": "부서진 벽 틈으로 아침 해가 비쳐 든다｡"
  },
  {
   "id": 11659,
   "key": "D0756.txt:176",
   "ko": "태양이 거리를 따뜻하게 비추고 있었다｡"
  },
  {
   "id": 11660,
   "key": "D0756.txt:179",
   "ko": "눈보라는 멎어 있다｡"
  },
  {
   "id": 11661,
   "key": "D0756.txt:180",
   "ko": "이타콰로 인한 이상 기후는 가라앉은 모양이다｡"
  },
  {
   "id": 11662,
   "key": "D0756.txt:192",
   "ko": "「어쩌다 이런 데에?」"
  },
  {
   "id": 11663,
   "key": "D0756.txt:200",
   "ko": "「묻고 싶은 건 이쪽이다｡ 그대를 찾아다니는데…… 갑자기 이곳에서 기척이 느껴졌으니 말이다｡ 게다가――」"
  },
  {
   "id": 11664,
   "key": "D0756.txt:206",
   "ko": "알이 내 눈앞에 종이 뭉치를 내민다｡"
  },
  {
   "id": 11665,
   "key": "D0756.txt:207",
   "ko": "틀림없다…… 이건 알의 단편이다｡"
  },
  {
   "id": 11666,
   "key": "D0756.txt:221",
   "ko": "「이타콰에게 끌려갔을 때､ 무슨 일이 있었느냐?」"
  },
  {
   "id": 11667,
   "key": "D0756.txt:225",
   "ko": "「달려와 보니 이타콰에 관한 기술과､ 덤으로 도망쳤을 터인 크투가에 관한 기술을 양손에 든 채 기절해 있는 그대가 있더구나」"
  },
  {
   "id": 11668,
   "key": "D0756.txt:236",
   "ko": "「과연 이 몸으로서도 무슨 영문인지――」"
  }
 ]
}