{
 "packet": "0203_01",
 "items": [
  {
   "id": 1723,
   "key": "D0203.txt:296",
   "ko": "한 권의 금빛으로 빛나는 마도서를 실체화시킨다｡"
  },
  {
   "id": 1724,
   "key": "D0203.txt:303",
   "ko": "고조되는 마력이 빛의 나선을 그리며､"
  },
  {
   "id": 1725,
   "key": "D0203.txt:304",
   "ko": "공간에 전광의 가지를 뻗는다｡ 「됐다､ 아우구스투스｡ 오랜 지인이다」"
  },
  {
   "id": 1726,
   "key": "D0203.txt:323",
   "ko": "「――오랜만이군……음?」"
  },
  {
   "id": 1727,
   "key": "D0203.txt:332",
   "ko": "="
  },
  {
   "id": 1728,
   "key": "D0203.txt:337",
   "ko": "="
  },
  {
   "id": 1729,
   "key": "D0203.txt:339",
   "ko": "="
  },
  {
   "id": 1730,
   "key": "D0203.txt:340",
   "ko": "="
  },
  {
   "id": 1731,
   "key": "D0203.txt:349",
   "ko": "「재치 없는 이름이로군」"
  },
  {
   "id": 1732,
   "key": "D0203.txt:354",
   "ko": "="
  },
  {
   "id": 1733,
   "key": "D0203.txt:359",
   "ko": "="
  },
  {
   "id": 1734,
   "key": "D0203.txt:361",
   "ko": "="
  },
  {
   "id": 1735,
   "key": "D0203.txt:367",
   "ko": "「한데 오늘은 무슨 일이냐」"
  },
  {
   "id": 1736,
   "key": "D0203.txt:372",
   "ko": "「응｡ 데몬베인의 조종자……알 아지프의 주인에 대한 정보를 주려고 말이야」"
  },
  {
   "id": 1737,
   "key": "D0203.txt:377",
   "ko": "「…………!」 「………………」"
  },
  {
   "id": 1738,
   "key": "D0203.txt:386",
   "ko": "「호오……그렇다면 이번에도 역시 그대가 판을 깔았느냐」"
  },
  {
   "id": 1739,
   "key": "D0203.txt:391",
   "ko": "="
  },
  {
   "id": 1740,
   "key": "D0203.txt:396",
   "ko": "그리 말하며 나이아는 마스터 테리온에게 다가가 몇 장의 자료를 건넸다｡ 소년은 제 머리카락을 만지작거리며 자료를 훑는다｡ 「사립탐정? 미스캐토닉의 마술사가 아니냐?」"
  },
  {
   "id": 1741,
   "key": "D0203.txt:409",
   "ko": "「어때? 재미있어 보이지?」 나이아는 장난스럽게 옆에서 소년을 끌어안았다｡"
  },
  {
   "id": 1742,
   "key": "D0203.txt:418",
   "ko": "『블랙로지』의 온 신도가 두려워하는 그랜드 마스터를 상대로､"
  },
  {
   "id": 1743,
   "key": "D0203.txt:419",
   "ko": "이 불손함｡ 허나 정작 소년은 개의치 않는 기색이다｡"
  },
  {
   "id": 1744,
   "key": "D0203.txt:422",
   "ko": "여전히 나른한 동작으로 나이아를 올려다본다｡ 「……실제로는 어떠하냐? 이번에는」"
  },
  {
   "id": 1745,
   "key": "D0203.txt:433",
   "ko": "「그야 지금까지에 비하면 마술사로서의 실력은 떨어지지」"
  },
  {
   "id": 1746,
   "key": "D0203.txt:437",
   "ko": "「하지만 말이야､ 그랜드 마스터? 그런 건 운명이라는 드라마의 주역이 될 자질과는 전혀 상관없는 일이라고 생각하지 않아?」"
  },
  {
   "id": 1747,
   "key": "D0203.txt:442",
   "ko": "「흠……이번에는 꽤나 저쪽 편에 빠져 있지 않느냐｡ 그렇군……」"
  },
  {
   "id": 1748,
   "key": "D0203.txt:454",
   "ko": "자료에서 눈을 떼고 마스터 테리온은 일어섰다｡"
  },
  {
   "id": 1749,
   "key": "D0203.txt:458",
   "ko": "밀쳐진 나이아는 불만스럽게 볼을 부풀린다｡"
  },
  {
   "id": 1750,
   "key": "D0203.txt:470",
   "ko": "「아우구스투스､ 뒤를 부탁한다」"
  },
  {
   "id": 1751,
   "key": "D0203.txt:475",
   "ko": "「……옛?」 「이런이런……그랜드 마스터､ 몸소 출진하시는 건가?」"
  },
  {
   "id": 1752,
   "key": "D0203.txt:486",
   "ko": "「이번에는 처음이니 말이다｡ 인사를 해야 하지 않겠느냐?」"
  },
  {
   "id": 1754,
   "key": "D0203.txt:497",
   "ko": "「게다가……나라고 놀이에 흥겨워지고 싶을 때도 있느니라」"
  }
 ]
}