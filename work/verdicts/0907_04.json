{
 "packet": "0907_04",
 "items": [
  {
   "id": 19485,
   "key": "D0907le.txt:480",
   "ko": "파괴의 파문이 대기를 내달리는 것보다 빠르게､ 메타트론은 그 궤도에서 벗어난다｡"
  },
  {
   "id": 19486,
   "key": "D0907le.txt:482",
   "ko": "충격은 뒤쪽 고층 빌딩으로 빨려 들어갔다｡"
  },
  {
   "id": 19487,
   "key": "D0907le.txt:483",
   "ko": "한 호흡의 정적｡"
  },
  {
   "id": 19488,
   "key": "D0907le.txt:493",
   "ko": "무거운 폭음을 울리며､ 빌딩 중간 층이 산산조각으로 부서진다｡"
  },
  {
   "id": 19490,
   "key": "D0907le.txt:494",
   "ko": "받침을 잃은 위층 부분이 지표로 떨어져､ 대지를 뒤흔들었다｡"
  },
  {
   "id": 19491,
   "key": "D0907le.txt:496",
   "ko": "……이거 또 상식 밖이군｡"
  },
  {
   "id": 19492,
   "key": "D0907le.txt:500",
   "ko": "「꿈!? 꿈이라고!? 그런가､ 그렇다면 메타트론! 그렇게 여기고 있어라!」"
  },
  {
   "id": 19493,
   "key": "D0907le.txt:504",
   "ko": "「하지만 말이다､ 이 몸뚱이를 태우는 불길의 뜨거움! 격렬함! 그것은 언젠가 너를 다 태워버릴 것이다!」"
  },
  {
   "id": 19494,
   "key": "D0907le.txt:508",
   "ko": "「너는 나라는 악몽에 잡아먹혀 죽어라!」"
  },
  {
   "id": 19495,
   "key": "D0907le.txt:517",
   "ko": "「죽은 자는 더 이상 괴로워하지 마라! 더 이상 괴롭히지 마라!」"
  },
  {
   "id": 19496,
   "key": "D0907le.txt:534",
   "ko": "충돌하는 하얀 천사의 무장과 검은 천사의 무술｡"
  },
  {
   "id": 19498,
   "key": "D0907le.txt:535",
   "ko": "폭음이 울려 퍼졌다｡ 상쇄｡ 서로 불발｡"
  },
  {
   "id": 19500,
   "key": "D0907le.txt:536",
   "ko": "곧바로 다음 공격이 뻗어 나온다｡"
  },
  {
   "id": 19501,
   "key": "D0907le.txt:542",
   "ko": "일격을 날릴 때마다､ 맞부딪칠 때마다 주위의 빌딩이 무너진다｡"
  },
  {
   "id": 19502,
   "key": "D0907le.txt:543",
   "ko": "두 천사는 지금､ 흡사 파괴의 폭풍으로 화했다｡"
  },
  {
   "id": 19503,
   "key": "D0907le.txt:545",
   "ko": "닿는 것 모조리 분쇄하며､ 두 천사의 싸움은 격화되어 간다……｡"
  },
  {
   "id": 19504,
   "key": "D0907le.txt:555",
   "ko": "「……라고 멍하니 구경할 때가 아니잖아! 메타트론! 거들어 주겠……」"
  },
  {
   "id": 19505,
   "key": "D0907le.txt:565",
   "ko": "「기다려라｡ 서로 죽이고 사랑하는 두 사람을 방해하는 건 멋없는 짓이지」"
  },
  {
   "id": 19506,
   "key": "D0907le.txt:569",
   "ko": "「게다가……자네에겐 내가 있지 않느냐｡ 그렇지､ 다이쥬지 쿠로」"
  },
  {
   "id": 19507,
   "key": "D0907le.txt:574",
   "ko": "――심장에 차가운 나이프가 박힌 듯한 오한｡"
  },
  {
   "id": 19508,
   "key": "D0907le.txt:591",
   "ko": "달빛조차 가려진 밤의 어둠에 떠오르는 붉은빛｡"
  },
  {
   "id": 19509,
   "key": "D0907le.txt:592",
   "ko": "어떤 어둠보다도 강하게 어둠의 색채를 호소하는 붉은빛｡"
  },
  {
   "id": 19510,
   "key": "D0907le.txt:594",
   "ko": "불길하고､ 신성한､ 붉은 거인이 천천히 강하해 온다｡"
  },
  {
   "id": 19511,
   "key": "D0907le.txt:596",
   "ko": "틀림없다――데우스 마키나다｡"
  },
  {
   "id": 19512,
   "key": "D0907le.txt:599",
   "ko": "파괴 로봇의 폭격이 멈춘다｡"
  },
  {
   "id": 19513,
   "key": "D0907le.txt:600",
   "ko": "파괴 로봇들은 물러나､ 붉은 귀계신을 위해 자리를 비웠다｡"
  },
  {
   "id": 19514,
   "key": "D0907le.txt:601",
   "ko": "그리고 그 붉은 귀계신의 손바닥에 올라､ 나를 내려다보는 두 개의 그림자｡"
  },
  {
   "id": 19515,
   "key": "D0907le.txt:615",
   "ko": "「저､ 저건…… 시､ 싫어요……」"
  },
  {
   "id": 19516,
   "key": "D0907le.txt:628",
   "ko": "「……마스터 테리온!?」"
  },
  {
   "id": 19517,
   "key": "D0907le.txt:632",
   "ko": "「그리고……『나코트 사본』인가」"
  },
  {
   "id": 19518,
   "key": "D0907le.txt:637",
   "ko": "금색 눈동자와 금색 머리카락을 지닌 소년｡"
  },
  {
   "id": 19520,
   "key": "D0907le.txt:638",
   "ko": "그와 짝을 이루는 어둠색 눈동자와 어둠색 머리카락을 지닌 소녀｡"
  },
  {
   "id": 19521,
   "key": "D0907le.txt:640",
   "ko": "틀림없어､ 그때의 『그놈』이다｡"
  },
  {
   "id": 19522,
   "key": "D0907le.txt:641",
   "ko": "그렇다면 이 데우스 마키나는……그때의 『팔』인가｡"
  },
  {
   "id": 19523,
   "key": "D0907le.txt:649",
   "ko": "「그렇다――이것이､ 나의 귀계신 리베르 레기스다」"
  },
  {
   "id": 19524,
   "key": "D0907le.txt:654",
   "ko": "금발 금안의 소년은 그때와 같은､ 소름 끼치는 비인간적인 미소를 띠고 말을 걸어왔다｡"
  },
  {
   "id": 19525,
   "key": "D0907le.txt:668",
   "ko": "「지난번엔 식솔이 폐를 끼쳤군……｡ 사죄의 뜻으로 이제 시작될 쇼의 특등석을 마련해 주지」"
  },
  {
   "id": 19526,
   "key": "D0907le.txt:674",
   "ko": "「이 자식이이이이이이!」"
  },
  {
   "id": 19527,
   "key": "D0907le.txt:687",
   "ko": "「호오? 『폭군』의 주법 병장인가､ 재미있군｡ 하지만――」"
  },
  {
   "id": 19528,
   "key": "D0907le.txt:701",
   "ko": "「오랜만이군……아마､ 그때의 여흥 자리 이후인가」"
  }
 ]
}