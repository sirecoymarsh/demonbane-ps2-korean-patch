   "ko": "="
  },
  {
   "id": 39725,
   "key": "D1412al.txt:83",
   "ko": "――아마도､ 이 우주에서､ 완전히｡"
  },
  {
   "id": 39726,
   "key": "D1412al.txt:94",
   "ko": "="
