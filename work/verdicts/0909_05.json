{
 "packet": "0909_05",
 "items": [
  {
   "id": 20221,
   "key": "D0909al.txt:1387",
   "ko": "그러나 파괴 로봇 대군세를 상대로 한 걸음도 물러서지 않고 싸우는 데몬베인의 모습을 보고､ 그들은 순수하게 생각했다｡"
  },
  {
   "id": 20222,
   "key": "D0909al.txt:1390",
   "ko": "의식하지 못한 채､ 말이 입에서 저절로 흘러나온다｡"
  },
  {
   "id": 20223,
   "key": "D0909al.txt:1395",
   "ko": "「이 얼마나……아름다운가」"
  },
  {
   "id": 20224,
   "key": "D0909al.txt:1412",
   "ko": "메타트론이 두 자루의 광인을 발생시켜 십자로 겨눴다｡"
  },
  {
   "id": 20225,
   "key": "D0909al.txt:1414",
   "ko": "그것을 본 산달폰의 움직임이 멈춘다｡"
  },
  {
   "id": 20226,
   "key": "D0909al.txt:1415",
   "ko": "목소리가 환희로 떨리는 것을 억누르지 못한다｡"
  },
  {
   "id": 20227,
   "key": "D0909al.txt:1424",
   "ko": "「드디어 각오를 굳혔는가?」"
  },
  {
   "id": 20228,
   "key": "D0909al.txt:1428",
   "ko": "「그래､ 너는 쓰러지지 않으면 구원받지 못하겠지｡ 그렇다면 내 손으로」"
  },
  {
   "id": 20229,
   "key": "D0909al.txt:1433",
   "ko": "「일격필살이라는 건가｡ 재밌군」 천지상하의 자세｡"
  },
  {
   "id": 20230,
   "key": "D0909al.txt:1445",
   "ko": "산달폰의 안에서 막대한 마력 에너지가 부풀어 오른다｡"
  },
  {
   "id": 20231,
   "key": "D0909al.txt:1453",
   "ko": "메타트론이 십자로 겨눈 광인 또한､ 산달폰의 힘에 호응하듯 빛을 더했다｡"
  },
  {
   "id": 20232,
   "key": "D0909al.txt:1461",
   "ko": "두 사람의 투기에 닿아 가까운 빌딩이 금이 가고 무너진다｡"
  },
  {
   "id": 20233,
   "key": "D0909al.txt:1462",
   "ko": "떨어지는 잔해마저 짙어지는 살기에 씹혀 부서져､ 티끌이 되어 바람에 사라진다｡"
  },
  {
   "id": 20234,
   "key": "D0909al.txt:1472",
   "ko": "「……큿!」 「……훗」"
  },
  {
   "id": 20235,
   "key": "D0909al.txt:1492",
   "ko": "뒤섞이고 튕겨나는 백과 흑의 투기는､ 임계점을 향해 고조되어 간다――"
  },
  {
   "id": 20236,
   "key": "D0909al.txt:1510",
   "ko": "「――9번 구획､ 파괴 로봇 섬멸!」"
  },
  {
   "id": 20237,
   "key": "D0909al.txt:1515",
   "ko": "「가라……! 가라아아아! 쿠로 군!」 「응 그래!」"
  },
  {
   "id": 20238,
   "key": "D0909al.txt:1533",
   "ko": "「쿠로! 상공､ 고철 인형 50!」 「아틀락 나차!」"
  },
  {
   "id": 20239,
   "key": "D0909al.txt:1551",
   "ko": "마술로 짜인 포박 웹이 밤하늘 가득 펼쳐져､ 날아드는 파괴 로봇 전부를 얽어맨다｡"
  },
  {
   "id": 20240,
   "key": "D0909al.txt:1555",
   "ko": "파괴 로봇들이 발버둥치는 틈에 크투가의 탄창을 빼고､ 이타콰의 실린더에서 탄환을 전부 던져버린다｡"
  },
  {
   "id": 20241,
   "key": "D0909al.txt:1563",
   "ko": "「쿠로? 무엇을――」 마총을 하늘 높이 던져 올린다｡"
  },
  {
   "id": 20242,
   "key": "D0909al.txt:1570",
   "ko": "마총이 떨어지는 사이에､ 나는 단 2발의 탄환을 데몬베인에게 쥐게 했다｡"
  },
  {
   "id": 20243,
   "key": "D0909al.txt:1573",
   "ko": "손가락 사이에 끼워진 탄환은"
  },
  {
   "id": 20244,
   "key": "D0909al.txt:1574",
   "ko": "『The minions of Cthugha』"
  },
  {
   "id": 20246,
   "key": "D0909al.txt:1575",
   "ko": "『Wendigo the Blackwood』｡"
  },
  {
   "id": 20247,
   "key": "D0909al.txt:1577",
   "ko": "크투가의 탄환과 이타콰의 탄환､ 각각 한 발씩｡"
  },
  {
   "id": 20248,
   "key": "D0909al.txt:1578",
   "ko": "짜 올린 술을 2개의 탄환에 흘려보낸다――"
  },
  {
   "id": 20249,
   "key": "D0909al.txt:1589",
   "ko": "「포말하우트로부터 오라――」"
  },
  {
   "id": 20250,
   "key": "D0909al.txt:1591",
   "ko": "또 하나―― 「바람을 타고 오라――」"
  },
  {
   "id": 20252,
   "key": "D0909al.txt:1607",
   "ko": "「……읏!?」 「이건……」"
  },
  {
   "id": 20254,
   "key": "D0909al.txt:1636",
   "ko": "강철 손가락에 끼워진 2종류의 마탄｡"
  },
  {
   "id": 20256,
   "key": "D0909al.txt:1637",
   "ko": "그 형상이 변모한다｡"
  },
  {
   "id": 20258,
   "key": "D0909al.txt:1638",
   "ko": "더 거대하게｡ 더 흉포하게｡ 더 불길하게｡"
  },
  {
   "id": 20259,
   "key": "D0909al.txt:1641",
   "ko": "탄각 표면에 고속으로 새겨지는 마술 문자｡"
  },
  {
   "id": 20260,
   "key": "D0909al.txt:1642",
   "ko": "신기를 발하며 옅게 빛난다｡"
  },
  {
   "id": 20261,
   "key": "D0909al.txt:1646",
   "ko": "「무엇을 할 셈이냐……?」 떨어져 내리는 2정의 마총｡"
  },
  {
   "id": 20262,
   "key": "D0909al.txt:1651",
   "ko": "공중에서 딱 정지한다｡ 마탄을 손에서 놓는다｡"
  },
  {
   "id": 20263,
   "key": "D0909al.txt:1664",
   "ko": "땅에 떨어지지 않고 빛이 되어 각각의 마총에 빨려 들어간다｡"
  },
  {
   "id": 20264,
   "key": "D0909al.txt:1664",
   "ko": "약실에 장전되는 마탄｡ 공중에 뜬 채인 마총을 양손에 잡는다｡"
  },
  {
   "id": 20265,
   "key": "D0909al.txt:1674",
   "ko": "손가락을 방아쇠에 걸고 서부극처럼 회전시킨다｡"
  }
 ]
}