  {
   "id": 4041,
   "key": "D0318.txt:83",
   "ko": "="
  },
  {
   "id": 4042,
   "key": "D0318.txt:98",
   "ko": "="
  },
  {
   "id": 4043,
   "key": "D0318.txt:104",
   "ko": "「메타트론……보고 있었나」"
  },
  {
   "id": 4044,
   "key": "D0318.txt:110",
   "ko": "="
  },
  {
   "id": 4045,
   "key": "D0318.txt:115",
   "ko": "「흥､ 고집불통인 놈이로다｡ 뭐､ 그대 따위 알 바 아니다만」 「싸우는 것은 쿠로의 의지｡ 그렇다면 쿠로의 가치는 이 몸이 정하겠노라」"
  },
  {
   "id": 4046,
   "key": "D0318.txt:125",
   "ko": "「인간 세계의 틀에서 벗어나지 못하는､ 왜소한 그대들이 나설 자리 따위 애초에 없느니라」"
  },
  {
   "id": 4047,
   "key": "D0318.txt:132",
   "ko": "「『블랙로지』와 싸우기에는､ 다이쥬지 쿠로｡ 너는 아직 너무 무르다」"
  },
  {
   "id": 4048,
   "key": "D0318.txt:137",
   "ko": "「예를 들면――」"
  },
  {
   "id": 4049,
   "key": "D0318.txt:157",
   "ko": "「……? 우와아아아아아!?」"
  },
  {
   "id": 4050,
   "key": "D0318.txt:162",
   "ko": "「――――읏!」 「메타트론!?」"
  },
  {
   "id": 4051,
   "key": "D0318.txt:195",
   "ko": "맹렬한 속도로 돌진해 온 메타트론은､ 어디선가 날아온 로켓탄과 우리 사이에 끼어들었다｡"
  },
  {
   "id": 4052,
   "key": "D0318.txt:198",
   "ko": "로켓탄이 명중해 폭발한다｡ 하지만 메타트론의 장갑은 티끌만큼도 흔들리지 않는다｡"
  },
  {
   "id": 4053,
   "key": "D0318.txt:235",
   "ko": "「누아아아아아아아!」"
  },
  {
   "id": 4054,
   "key": "D0318.txt:241",
   "ko": "폭연을 가르며 한 줄기 빔이 로켓탄이 날아온 지점을 쏜다｡ 기타 케이스를 멘 닥터 웨스트가 날아갔다｡"
  },
  {
   "id": 4055,
   "key": "D0318.txt:252",
   "ko": "「저놈､ 탈출해 있었더냐」"
  },
  {
   "id": 4056,
   "key": "D0318.txt:258",
   "ko": "「케홀! 케홀! 다이쥬지 쿠로! 알 아지프!」"
  },
  {
   "id": 4057,
   "key": "D0318.txt:263",
   "ko": "「오늘은 얌전히 물러나 주는 것이다! 하아아지만! 이런 게 이 몸의 실력이라고 얕보면 곤란하다구웃」"
  },
  {
   "id": 4058,
   "key": "D0318.txt:268",
   "ko": "「다음에야말로! 다음에야말로 네놈들의 데몬베인을 산산조각 내주는 것이다아앗! 젠자아아아아아아아아아아아앙!」"
  },
  {
   "id": 4059,
   "key": "D0318.txt:278",
   "ko": "악담을 남기고 맹렬한 속도로 도망쳐 갔다｡ ……어쩜 저리 도망치는 발이 빠른지｡"
  },
  {
   "id": 4060,
   "key": "D0318.txt:282",
   "ko": "어이없어하는 우리에게 메타트론이 말한다｡"
  },
  {
   "id": 4061,
   "key": "D0318.txt:288",
   "ko": "「이런 방심은 통하지 않는다」 …………｡"
  },
  {
   "id": 4062,
   "key": "D0318.txt:299",
   "ko": "「……확실히､ 아직 멀었을지도 모르지만 말이야」"
  },
  {
   "id": 4063,
   "key": "D0318.txt:306",
   "ko": "="
  },
  {
   "id": 4064,
   "key": "D0318.txt:308",
   "ko": "="
  },
  {
   "id": 4065,
   "key": "D0318.txt:320",
   "ko": "「당신도 태어난 그날부터 히어로였던 건 아니잖아? 나는 더 강해질 거야｡ 강해져서 저놈들을 쓰러뜨린다」 「그게 아마､ 어쩐지 모르게 내 마음을 좀먹고 있던……」"
  },
  {
   "id": 4066,
   "key": "D0318.txt:333",
   "ko": "내 가슴에 손을 얹는다｡"
