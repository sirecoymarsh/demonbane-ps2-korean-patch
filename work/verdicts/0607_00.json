   "ko": "="
  },
  {
   "id": 7339,
   "key": "D0607_ps2.txt:126",
   "ko": "그저 멍한 얼굴로 우두커니 서 있다｡"
  },
  {
   "id": 7340,
   "key": "D0607_ps2.txt:135",
