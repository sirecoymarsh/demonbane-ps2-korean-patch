   "ko": "="
  },
  {
   "id": 8323,
   "key": "D0702.txt:352",
   "ko": "="
  },
  {
   "id": 8324,
   "key": "D0702.txt:355",
   "ko": "="
  },
  {
   "id": 8325,
   "key": "D0702.txt:356",
   "ko": "="
  },
  {
   "id": 8326,
   "key": "D0702.txt:359",
   "ko": "="
  },
  {
   "id": 8327,
   "key": "D0702.txt:364",
   "ko": "「알! 일하러 돌아간다! 놀고 있을 때가 아니야!」 「하아~?」"
  },
  {
   "id": 8328,
   "key": "D0702.txt:376",
   "ko": "알은 불만스러운 듯 불복스러운 듯 못마땅한 듯､ 진심으로 귀찮아 죽겠다는 '못 해먹겠다~' 하는 표정으로､"
  },
  {
   "id": 8329,
   "key": "D0702.txt:378",
   "ko": "나를 노려보았다｡ ――이 녀석､ 철저하게 의욕이 없다｡"
  },
  {
   "id": 8330,
   "key": "D0702.txt:391",
   "ko": "「……어찌 된 것이냐､ 갑자기 진지해져서? 그토록 의욕 없어 보이더니만」"
  },
  {
   "id": 8331,
   "key": "D0702.txt:397",
   "ko": "「이제 슬슬 진지하게 안 하면 또 공주님한테 혼난다고」"
  },
  {
   "id": 8332,
   "key": "D0702.txt:407",
   "ko": "「음…… 어찌하여 그대는 저 계집애에게 약한 것이냐｡ 정신 차리지 않으면 앞으로도 계속 얕보이기만 할 것이다」"
  },
  {
   "id": 8333,
   "key": "D0702.txt:413",
   "ko": "="
  },
  {
   "id": 8334,
   "key": "D0702.txt:422",
   "ko": "「하찮구나｡ 세속의 굴레 따위에 얽매여서는」"
  },
  {
   "id": 8335,
   "key": "D0702.txt:429",
   "ko": "「이쪽은 애초부터 인간의 틀 안에서밖에 못 사는 범속한 몸이라고!」 「애초에 너도 이번 건이 신경 쓰인다고 했잖아?」"
  },
  {
   "id": 8336,
   "key": "D0702.txt:441",
   "ko": "「흥､ 대충은 짐작이 갔느니라」"
  },
  {
   "id": 8337,
   "key": "D0702.txt:446",
   "ko": "="
  },
  {
   "id": 8338,
   "key": "D0702.txt:450",
   "ko": "뭔가 지금 아무렇지 않게 중대한 말을 한 것 같은데｡"
  },
  {
   "id": 8339,
   "key": "D0702.txt:455",
   "ko": "「……라니､ 그게 무슨 뜻이야?」"
  },
  {
   "id": 8340,
   "key": "D0702.txt:464",
   "ko": "「모르겠느냐?」"
  },
  {
   "id": 8341,
   "key": "D0702.txt:471",
   "ko": "="
  },
  {
   "id": 8342,
   "key": "D0702.txt:474",
   "ko": "모르겠냐고 물어봐도……전혀 모르겠으니까 조사하려는 것 아닌가｡"
  },
  {
   "id": 8343,
   "key": "D0702.txt:481",
   "ko": "「테켈리-리」"
  },
  {
   "id": 8344,
   "key": "D0702.txt:487",
   "ko": "「「「와~이 와~이!」」」 어느새 던세이니와 뛰노는 꼬맹이들을 곁눈질하며､ 중얼거리듯 알은 말했다｡"
  },
  {
   "id": 8345,
   "key": "D0702.txt:502",
   "ko": "「주위에 감도는 어둠의 냄새로 안다｡ 이곳은 그저 바다가 아닐 것이다｡ 지금은 인간이 뿜는 양의 기운으로 정화되어 있다마는」 「어둠의 냄새? 이봐이봐…… 그게 무슨 뜻――」"
  },
  {
   "id": 8346,
   "key": "D0702.txt:525",
   "ko": "……뭔가 진심으로 아무래도 좋아졌다｡ 나는 어깨를 늘어뜨리고 과장되게 한숨을 쉬었다｡"
  },
  {
   "id": 8347,
   "key": "D0702.txt:536",
   "ko": "「뭐냐､ 벌써 지친 것이냐? 이 몸의 주인이면서 한심하구나」"
  },
  {
   "id": 8348,
   "key": "D0702.txt:543",
   "ko": "내버려 둬｡ 「테켈리-리」"
  },
  {
   "id": 8349,
   "key": "D0702.txt:561",
   "ko": "「「「와~이 와~이!」」」 꼬맹이들은 던세이니와 뛰놀고 있다｡"
  },
  {
   "id": 8350,
   "key": "D0702.txt:568",
   "ko": "쓸데없이 활기차서 대단히 부럽다｡ 퐁당､ 퐁당｡"
  },
  {
   "id": 8351,
   "key": "D0702.txt:589",
   "ko": "트로피컬한 색채의 비치볼이 우리 발밑까지 굴러왔다｡ 「음~?」"
  },
