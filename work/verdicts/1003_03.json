 "items": [
  {
   "id": 21012,
   "key": "D1003al.txt:862",
   "ko": "금빛 번쩍이는 데우스 마키나가 포구를 이쪽으로 향한다｡"
  },
  {
   "id": 21013,
   "key": "D1003al.txt:863",
   "ko": "아까 마스터 테리온을 날려버린 대구경 빔포다｡"
  },
  {
   "id": 21015,
   "key": "D1003al.txt:865",
   "ko": "위험하다……정말로 위험하다｡"
  },
  {
   "id": 21016,
   "key": "D1003al.txt:866",
   "ko": "지금의 데몬베인에는 저것에 대항할 수단이 없다……!"
  },
  {
   "id": 21017,
   "key": "D1003al.txt:870",
   "ko": "「――외통수다､ 다이쥬지 쿠로 군｡ 정의의 편 놀이는 여기서 끝이다」"
  },
  {
   "id": 21018,
   "key": "D1003al.txt:876",
   "ko": "조롱을 머금은 아우구스투스의 목소리가 유난히 머릿속에 울린다｡"
  },
  {
   "id": 21020,
   "key": "D1003al.txt:877",
   "ko": "젠장……이런 데서､ 이런 데서 당해줄 수는 없어……!"
  },
  {
   "id": 21021,
   "key": "D1003al.txt:882",
   "ko": "「사실은 너를 노리개로 삼고 싶어 하는 자도 몇 있는 모양이다만……」"
  },
  {
   "id": 21022,
   "key": "D1003al.txt:886",
   "ko": "「……흥」"
  },
  {
   "id": 21023,
   "key": "D1003al.txt:890",
   "ko": "「……켓」"
  },
  {
   "id": 21024,
   "key": "D1003al.txt:894",
   "ko": "「후후､ 뭐 그렇지」"
  },
  {
   "id": 21025,
   "key": "D1003al.txt:898",
   "ko": "「마술사를 상대로 여유를 많이 보이는 건 상책이 아니지｡ 하물며 상대가 그 마스터 오브 네크로노미콘이라면 더더욱」"
  },
  {
   "id": 21026,
   "key": "D1003al.txt:901",
   "ko": "「일단은 땅바닥을 기는 너를 감상하는 걸로 만족해 두지｡ 그럼 작별이다」"
  },
  {
   "id": 21027,
   "key": "D1003al.txt:913",
   "ko": "금빛 포대에서 격렬한 섬광이 넘쳐 나온다｡"
  },
  {
   "id": 21029,
   "key": "D1003al.txt:915",
   "ko": "여기까지인가!? 여기까지인 건가!?"
  },
  {
   "id": 21030,
   "key": "D1003al.txt:916",
   "ko": "바보 자식! 그런 걸 인정……인정할 수 있을까 보냐!"
  },
  {
   "id": 21031,
   "key": "D1003al.txt:918",
   "ko": "나는､ 나는……! 「네스 경부!」"
  },
  {
   "id": 21033,
   "key": "D1003al.txt:942",
   "ko": "「이봐 이봐 이봐! 이거 위험한 거 아냐!?」"
  },
  {
   "id": 21034,
   "key": "D1003al.txt:956",
   "ko": "「기､ 기다려라 이 멀대야! 데몬베인은 이 몸의 사냥감이란 말이다……!」"
  },
  {
   "id": 21035,
   "key": "D1003al.txt:961",
   "ko": "「달링!」"
  },
  {
   "id": 21037,
   "key": "D1003al.txt:985",
   "ko": "「다이쥬지 씨이이이이이이이잇!」"
  },
  {
   "id": 21038,
   "key": "D1003al.txt:1011",
   "ko": "「루리 아가씨이이이이――――――!」"
  },
  {
   "id": 21039,
   "key": "D1003al.txt:1030",
   "ko": "「……쿠로……야……읏!」"
  },
  {
   "id": 21040,
   "key": "D1003al.txt:1052",
   "ko": "――――――――――! 빛､"
  },
  {
   "id": 21041,
