  {
   "id": 1780,
   "key": "D0204.txt:170",
   "ko": "="
  },
  {
   "id": 1781,
   "key": "D0204.txt:178",
   "ko": "「뭐냐｡ 설마 아직도 마도서 찾기를 계속하고 있는 것이냐｡ 언제까지 그 계집애의 억지를 받아줄 셈인지」"
  },
  {
   "id": 1782,
   "key": "D0204.txt:186",
   "ko": "="
  },
  {
   "id": 1783,
   "key": "D0204.txt:194",
   "ko": "「무의미한 짓은 그만두어라､ 쿠로｡ 네가 헛되이 시간을 쓰는 동안에도 사태는 시시각각 진행되고 있느니라」"
  },
  {
   "id": 1784,
   "key": "D0204.txt:199",
   "ko": "「알 게 뭐야! 난 오늘 먹을 밥 하나에 필사적인 인간이라고!」 「너야말로 나 같은 거에 매달리지 말고､ 좀 더 사명감과 인류애로 가득 찬 정의의 히어로라도 찾아! 그게 서로한테 좋잖아?」"
  },
  {
   "id": 1785,
   "key": "D0204.txt:212",
   "ko": "「그리 쉽게 그런 게 찾아지겠느냐」 「마술의 재능이 있고､ 아직 『책』을 지니지 않았으며､ 게다가 사악함에 물들지 않은 인간…… 그대 정도밖에 없구나」"
  },
  {
   "id": 1786,
   "key": "D0204.txt:221",
   "ko": "「내가 사악함에 물들지 않았다는 근거가 어디 있어!? 이미 내 머릿속은 걸쭉하게 엉망진창이라고요!?」 「유치원 버스를 납치해서 채석장에서 대난동을 부린다는 악마 계획이 현재 진행 중｡ 뇌내에서」"
  },
  {
   "id": 1787,
   "key": "D0204.txt:233",
   "ko": "「악마 계획은 아무래도 좋다만…… 어쨌든 그대는 그대가 생각하는 것보다 강한 인간으로 보이는구나」 「의외로 그대 같은 범인이야말로 마술을 올바르게 다룰 수 있을지도 모르지」"
  },
  {
   "id": 1788,
   "key": "D0204.txt:248",
   "ko": "="
  },
  {
   "id": 1789,
   "key": "D0204.txt:258",
   "ko": "「그러니까 포기하지 않겠다고 말하고 있지 않느냐」"
  },
  {
   "id": 1790,
   "key": "D0204.txt:263",
   "ko": "="
  },
  {
   "id": 1791,
   "key": "D0204.txt:276",
   "ko": "="
  },
  {
   "id": 1792,
   "key": "D0204.txt:278",
   "ko": "고서점｡ 주술 가게｡ 오컬트 굿즈 숍에 점집｡ 그 근처 노점도 구석구석까지｡"
  },
  {
   "id": 1793,
   "key": "D0204.txt:280",
   "ko": "="
  },
  {
   "id": 1794,
   "key": "D0204.txt:293",
   "ko": "「아니 이거､ 이건 배교자 뒤코 슐레커가 쓴 악마의 교전､ 오오､ 이것이야말로 그 CRC가 하사받은 비교의 서가 틀림없습니다､ 이거 참 손님께서도 안목이 높으시군요」 「아뇨 아뇨､ 이건 팔 수는 없습니다｡ 다만 나리께서 정 그러시다면…… 이만한 액수를 내실 수 있다면 생각 못 할 것도 이래도 싼 편이지요 아 알겠습니다 그럼 특별히 이 가격으로……」"
  }
