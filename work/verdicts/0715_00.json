{
 "packet": "0715_00",
 "items": [
  {
   "id": 10948,
   "key": "D0715al.txt:17",
   "ko": "="
  },
  {
   "id": 10949,
   "key": "D0715al.txt:20",
   "ko": "이로써 인스머스를 시끄럽게 했던 사건은 해결되었다――"
  },
  {
   "id": 10950,
   "key": "D0715al.txt:20",
   "ko": "일단은､ 말이지만｡"
  },
  {
   "id": 10953,
   "key": "D0715al.txt:23",
   "ko": "수수께끼는 아직 남아 있다｡"
  },
  {
   "id": 10954,
   "key": "D0715al.txt:36",
   "ko": "『르뤼에 이본』｡"
  },
  {
   "id": 10955,
   "key": "D0715al.txt:38",
   "ko": "수신에 대해 기술된､ 알과 마찬가지로 실체를 가진 마도서｡"
  },
  {
   "id": 10956,
   "key": "D0715al.txt:41",
   "ko": "『블랙로지』는 그 책을 써서 무엇을 꾸미고 있었던 걸까｡ 그리고 그 책은 어떻게 된 걸까｡"
  },
  {
   "id": 10957,
   "key": "D0715al.txt:44",
   "ko": "다곤과 함께 멸망한 건가､ 아니면――｡"
  },
  {
   "id": 10958,
   "key": "D0715al.txt:56",
   "ko": "다곤의 소환은 실험이라고 했다｡"
  },
  {
   "id": 10960,
   "key": "D0715al.txt:58",
   "ko": "……신의 소환을 『실험』이라 부른다고? 그렇다면"
  },
  {
   "id": 10961,
   "key": "D0715al.txt:59",
   "ko": "『실전』은――대체 무슨 짓을 저지를 셈이지?"
  },
  {
   "id": 10962,
   "key": "D0715al.txt:62",
   "ko": "하도 저택 습격이라든가 이번 일이라든가……점점 상황이 수상해지고 있어｡"
  },
  {
   "id": 10964,
   "key": "D0715al.txt:66",
   "ko": "저놈들 움직임을 알 수 없는 게 답답하다｡"
  },
  {
   "id": 10965,
   "key": "D0715al.txt:67",
   "ko": "앞으로는 더욱 긴장을 늦추지 말아야겠지｡"
  },
  {
   "id": 10966,
   "key": "D0715al.txt:74",
   "ko": "게다가 이번엔 또 하나､ 문제가 떠올랐다｡"
  },
  {
   "id": 10968,
   "key": "D0715al.txt:77",
   "ko": "예전에 되찾은 크투가의 힘｡"
  },
  {
   "id": 10969,
   "key": "D0715al.txt:78",
   "ko": "그 힘을 해방한 일에 관한 전말이다｡"
  },
  {
   "id": 10970,
   "key": "D0715al.txt:87",
   "ko": "결국 우리는 크투가의 파워를 완전히는 제어하지 못했다｡"
  },
  {
   "id": 10971,
   "key": "D0715al.txt:89",
   "ko": "크투가의 에너지는 곤드라를 날려버리고､ 그것도 모자라 인스머스의 지형을 바꿔버렸다｡"
  },
  {
   "id": 10972,
   "key": "D0715al.txt:92",
   "ko": "지금 인스머스의 해안은 거대한 분화구로 파여 있다｡"
  },
  {
   "id": 10973,
   "key": "D0715al.txt:95",
   "ko": "분화구 표면은 매끈한 유리처럼 되어 있었다｡ 엄청난 열량이 대지를 녹인 것이다｡"
  },
  {
   "id": 10974,
   "key": "D0715al.txt:97",
   "ko": "열은 한동안 남아､ 아무도 다가갈 수 없을 정도였다｡"
  },
  {
   "id": 10975,
   "key": "D0715al.txt:104",
   "ko": "데몬베인 역시 무사하지 못했다｡"
  },
  {
   "id": 10976,
   "key": "D0715al.txt:106",
   "ko": "마법 금속인 히히이로카네로 덮인 장갑은 너무나도 쉽게 녹아 있었다｡"
  },
  {
   "id": 10977,
   "key": "D0715al.txt:109",
   "ko": "양팔은 완전히 녹아내리고､ 몸체 전면은 일그러지게 파인 채､ 겨우 형체를 남긴 정도였다｡"
  },
  {
   "id": 10978,
   "key": "D0715al.txt:112",
   "ko": "……오히려 전부 날아가지 않은 게 다행일 정도다｡"
  },
  {
   "id": 10979,
   "key": "D0715al.txt:115",
   "ko": "조금이라도 방어진의 힘이 약했다면､ 지금쯤 나도 알도 데몬베인도 이 세상에 없다｡"
  },
  {
   "id": 10980,
   "key": "D0715al.txt:117",
   "ko": "……저런 술법､ 도저히 쓸 수 있는 물건이 아니야｡ 너무 강력해서 제어가 전혀 안 돼――"
  },
  {
   "id": 10981,
   "key": "D0715al.txt:130",
   "ko": "「애초에 크투가의 힘은 전용 주법병장을 써서 제어했느니라｡ 허나 그것도 마스터 테리온과의 싸움에서 잃어버렸다만……」"
  },
  {
   "id": 10982,
   "key": "D0715al.txt:135",
   "ko": "「주법병장……어떤 건데?」"
  },
  {
   "id": 10983,
   "key": "D0715al.txt:140",
   "ko": "「총이니라」"
  },
  {
   "id": 10988,
   "key": "D0715al.txt:145",
   "ko": "「총?」"
  },
  {
   "id": 10989,
   "key": "D0715al.txt:150",
   "ko": "「그래……공격에 지향성을 부여함으로써 제어했던 게다」"
  },
  {
   "id": 10990,
   "key": "D0715al.txt:155",
   "ko": "「총､ 이라……」"
  },
  {
   "id": 10991,
   "key": "D0715al.txt:166",
   "ko": "뭐……그러니까｡"
  },
  {
   "id": 10992,
   "key": "D0715al.txt:167",
   "ko": "요컨대 현재로선 제대로 다룰 수 있는 물건이 아니라는 거다｡"
  },
  {
   "id": 10993,
   "key": "D0715al.txt:170",
   "ko": "당분간은 봉인해 둘 수밖에 없어｡"
  },
  {
   "id": 10994,
   "key": "D0715al.txt:171",
   "ko": "저걸 아컴시티에서 해버렸다간､ 거리가 통째로 증발해버릴지도 모른다｡"
  },
  {
   "id": 10995,
   "key": "D0715al.txt:174",
   "ko": "이래저래 문제가 산더미로군……｡"
  },
  {
   "id": 10996,
   "key": "D0715al.txt:176",
   "ko": "……뭐､ 좋아｡"
  }
 ]
}