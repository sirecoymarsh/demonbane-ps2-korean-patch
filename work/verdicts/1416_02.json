  {
   "id": 40717,
   "key": "D1416al.txt:587",
   "ko": "뿜어져 나온 피가 하늘에 호를 그렸다｡ 엔네아의 몸이 뒤로 넘어진다｡"
  },
  {
   "id": 40718,
   "key": "D1416al.txt:602",
   "ko": "나를 향한 마지막 미소가､ 망막에 새겨져 떠나지 않는다｡"
  },
  {
   "id": 40719,
   "key": "D1416al.txt:617",
   "ko": "「그대는……!」 흰 손을 중심으로 번져 가는 균열｡"
  },
  {
   "id": 40720,
   "key": "D1416al.txt:630",
   "ko": "그 안쪽에서 피에 젖은 금색을 보았다｡ 머리를 내밀고､ 상반신을 끌어내며､"
  },
  {
   "id": 40721,
   "key": "D1416al.txt:634",
   "ko": "그것은 엔네아의 태내에서 태어난다｡"
  },
  {
   "id": 40722,
   "key": "D1416al.txt:643",
   "ko": "작디작은､ 소녀의 몸｡"
  },
  {
   "id": 40723,
   "key": "D1416al.txt:644",
   "ko": "어미보다 명백히 큰 갓난아기｡ 아름답기까지 했다｡"
  },
  {
   "id": 40724,
   "key": "D1416al.txt:651",
   "ko": "="
  },
  {
   "id": 40725,
   "key": "D1416al.txt:652",
   "ko": "="
  },
  {
   "id": 40726,
   "key": "D1416al.txt:655",
   "ko": "혐오스러운 이형의 아름다움을 목격하고､ 위 속의 것을 전부 게워냈다｡"
  },
  {
   "id": 40727,
   "key": "D1416al.txt:659",
   "ko": "갓난아기가 기어 나온다｡"
  },
  {
   "id": 40728,
   "key": "D1416al.txt:660",
   "ko": "밀려 벌어진 엔네아의 몸은 한계에 다다르고――｡ 찢어졌다｡"
  },
  {
   "id": 40729,
   "key": "D1416al.txt:676",
   "ko": "갈라졌다｡ 터졌다｡"
  },
  {
   "id": 40730,
   "key": "D1416al.txt:680",
   "ko": "붉은　물보라　　　가"
  },
  {
   "id": 40731,
   "key": "D1416al.txt:681",
   "ko": "파편　　내려　　｡"
  },
  {
   "id": 40732,
   "key": "D1416al.txt:684",
   "ko": "그　파편　은　　전부､"
  },
  {
