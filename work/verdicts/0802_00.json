  {
   "id": 12274,
   "key": "D0802al.txt:37",
   "ko": "="
  },
  {
   "id": 12275,
   "key": "D0802al.txt:40",
   "ko": "비는 어느 정도 피를 씻어내 주겠지만､ 그것이 구원이 될 수 있느냐 묻는다면 부정할 수밖에 없다｡"
  },
  {
   "id": 12276,
   "key": "D0802al.txt:43",
   "ko": "참혹함의 극치｡ 처참함의 극치｡"
  },
  {
   "id": 12277,
   "key": "D0802al.txt:44",
   "ko": "쌓이고 쌓아 올려지는 참혹에 참혹｡"
  },
  {
   "id": 12278,
   "key": "D0802al.txt:45",
   "ko": "더욱 참혹｡ 또다시 참혹｡"
  },
  {
   "id": 12279,
   "key": "D0802al.txt:48",
   "ko": "지극히 단순하게 그것을 구현화하는 그것은 지극히 단순한 폭력｡ 순연한 폭력｡ 순수한 폭력｡"
  },
  {
   "id": 12280,
   "key": "D0802al.txt:69",
   "ko": "비조차 씻어내지 못하는 피 냄새 한가운데를 『블랙로지』의 신도들이 달린다｡"
  },
  {
   "id": 12281,
   "key": "D0802al.txt:89",
   "ko": "손에 든 기관총이 포효한다｡ 머즐 플래시와 함께 번쩍이는 빛｡ 기관총의 총구를 감싸듯 전개되는 마법진｡"
  },
  {
   "id": 12282,
   "key": "D0802al.txt:92",
   "ko": "폭우가 쏟아지고､ 탄우가 쏟아진다｡"
  },
  {
   "id": 12283,
   "key": "D0802al.txt:93",
   "ko": "포효하는 총구 앞에 선 인영을 향해｡"
  },
  {
   "id": 12284,
   "key": "D0802al.txt:106",
   "ko": "『폭군』｡"
  },
  {
   "id": 12285,
   "key": "D0802al.txt:109",
   "ko": "죄인의 무리인 『블랙로지』의 신도조차 아득히 뛰어넘는 업을 짊어진 대죄인｡ 불길하게도 저주스럽게도､ 세상 그 누구보다 폭력을 제어하고 예속시키고 행사하는 지배자｡ 그야말로 폭군｡ 폭군｡ 폭군｡"
  },
  {
   "id": 12286,
   "key": "D0802al.txt:122",
   "ko": "『폭군』이 전개하는 방어진을 총탄이 덮친다｡"
  },
  {
   "id": 12287,
   "key": "D0802al.txt:134",
   "ko": "총탄을 뒤집어쓸 때마다 방어진의 술식은 마술 문자가 되어 풀리고､ 자도자는 의미를 갖지 못할 수준까지 분해되어､ 불가지의 영역､ 혼돈의 진흙으로 돌아간다｡"
  },
  {
   "id": 12288,
   "key": "D0802al.txt:140",
   "ko": "쏘아지는 수천 발의 총탄은 모두 주술적 의례가 시행된 전용탄｡ 대『폭군』용으로――오직 그것만을 위해 커스터마이즈된 마탄､ 방어 결계에 개입해 술식을 고쳐 쓰고 무효화하는 독령탄이다｡"
  },
  {
   "id": 12289,
   "key": "D0802al.txt:153",
   "ko": "그 작은 몸을 무자비하게도､ 가차 없이､ 총탄이 파고든다｡"
  },
  {
   "id": 12290,
   "key": "D0802al.txt:177",
   "ko": "무너져 내린다｡ 피바다가 퍼져간다｡"
  },
  {
   "id": 12291,
   "key": "D0802al.txt:179",
   "ko": "비가 피를 씻어간다｡ 「………………」"
  },
  {
   "id": 12292,
   "key": "D0802al.txt:208",
   "ko": "「――――――」 조금 떨어진 곳에서 그 광경을 지켜보는 두 그림자가 있었다｡"
  },
  {
   "id": 12293,
   "key": "D0802al.txt:216",
   "ko": "시체의 바다에 선 거대한 체구｡"
  },
  {
   "id": 12294,
   "key": "D0802al.txt:217",
   "ko": "시체의 산에 걸터앉은 작은 체구｡"
  },
  {
   "id": 12295,
   "key": "D0802al.txt:220",
   "ko": "두 그림자의 입가에 들러붙은 미소｡"
  },
  {
   "id": 12296,
   "key": "D0802al.txt:221",
   "ko": "비웃고 있는 것이다｡ 기뻐하고 있는 것이다｡"
  },
  {
   "id": 12297,
   "key": "D0802al.txt:222",
   "ko": "이 처참한 광경을｡ 즉､ 이 폭력을｡"
  },
  {
   "id": 12298,
   "key": "D0802al.txt:230",
   "ko": "하지만 그 표정이 곧 흐려진다｡"
  },
  {
   "id": 12299,
   "key": "D0802al.txt:231",
   "ko": "동시에 신도들이 일제히 숨을 삼켰다｡"
  },
  {
   "id": 12300,
   "key": "D0802al.txt:244",
   "ko": "「「「…………읏!?」」」"
  },
  {
   "id": 12301,
   "key": "D0802al.txt:260",
   "ko": "원형조차 남지 않은 소녀의 시체가 상체를 일으켰다｡"
  },
  {
   "id": 12302,
   "key": "D0802al.txt:261",
   "ko": "턱이 없는 입으로 히죽 웃는다｡"
  },
  {
   "id": 12303,
   "key": "D0802al.txt:283",
   "ko": "느릿하게 들어 올리는､ 부러진 팔｡"
  },
  {
   "id": 12304,
   "key": "D0802al.txt:284",
   "ko": "그 손에 붉은 권총이 쥐여 있었다｡"
  },
  {
   "id": 12305,
   "key": "D0802al.txt:315",
   "ko": "대구경 총이 포효했다｡ 연속으로｡"
  },
  {
   "id": 12306,
   "key": "D0802al.txt:316",
   "ko": "기관총을 겨눈 신도 십수 명이 분쇄되었다｡"
  },
  {
   "id": 12307,
   "key": "D0802al.txt:337",
   "ko": "잠시 어안이 벙벙했던 신도들이 마침내 상황을 파악했다｡ 아니､ 이해하지 못한 채로도 거의 반사적으로 움직이고 있었다｡"
  },
  {
   "id": 12308,
   "key": "D0802al.txt:347",
   "ko": "「「「!?」」」"
  },
  {
   "id": 12309,
   "key": "D0802al.txt:363",
   "ko": "필살의 위력과 주력을 담은 수천 발의 총탄이 모조리 튕겨났다｡ 효력을 잃고 허무하게 땅을 구른다｡"
  },
  {
   "id": 12310,
   "key": "D0802al.txt:373",
   "ko": "「칫――벌써 『순응』해버렸잖아」"
  },
  {
   "id": 12311,
   "key": "D0802al.txt:384",
   "ko": "눈앞의 현실에 대응하지 못하고 신도들은 헛되이 총격을 계속한다｡ 총탄은 방어진에 튕겨나 불꽃을 흩뿌린다｡"
  },
  {
   "id": 12312,
   "key": "D0802al.txt:400",
   "ko": "그것마저도､ 멎었다｡"
  }
 ]
}