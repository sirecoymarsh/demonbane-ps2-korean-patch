  },
  {
   "id": 5457,
   "key": "D0411.txt:302",
   "ko": "「저것에 직격당해선 아니 된다!」"
  },
  {
   "id": 5458,
   "key": "D0411.txt:307",
   "ko": "「알고 있어! 다리 실드……해방!」"
  },
  {
   "id": 5459,
   "key": "D0411.txt:321",
   "ko": "시공 왜곡의 영향으로 주위 광경이 비디오테이프가 씹힌 것처럼 띄엄띄엄 흐트러졌다｡ 폭음을 울리며 데몬베인이 대지를 박찬다｡"
  },
  {
   "id": 5460,
   "key": "D0411.txt:353",
   "ko": "화염의 숨결이 아슬아슬하게 옆을 스쳐 지나갔다｡ 업화가 거리를 휩쓸고 빌딩이 용암처럼 녹아내린다｡"
  },
  {
   "id": 5461,
   "key": "D0411.txt:368",
   "ko": "「놈의 움직임을 멈추는 게다!」"
  },
  {
   "id": 5462,
   "key": "D0411.txt:382",
   "ko": "「알았어! 포박 결계 전개!」"
  },
  {
   "id": 5463,
   "key": "D0411.txt:402",
   "ko": "「아틀락 나차!」"
  },
  {
   "id": 5464,
   "key": "D0411.txt:405",
   "ko": "빛으로 엮인 거미줄이 사방팔방으로 꽃이 피듯 펼쳐졌다｡ 완만한 호를 그리며 재버워크에게 쏟아진다｡"
  },
  {
   "id": 5465,
   "key": "D0411.txt:427",
   "ko": "테와즈비이리리리､ 아이간도스헤스루아이스와이토오비이에스읏!"
  },
  {
   "id": 5466,
   "key": "D0411.txt:434",
   "ko": "차마 듣기 힘든 고통의 포효｡"
  },
  {
   "id": 5467,
   "key": "D0411.txt:435",
   "ko": "거미줄은 거미집을 이루어 재버워크를 그 자리에 꿰매었다｡"
  },
  {
   "id": 5468,
   "key": "D0411.txt:441",
   "ko": "「좋았어! 성공!」 「기뻐하기엔 이르다!」"
  },
  {
   "id": 5469,
   "key": "D0411.txt:459",
   "ko": "데에아이도기이레안데구아이무비이레､ 아인스에와비이이!"
