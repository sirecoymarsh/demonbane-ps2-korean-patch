{
 "packet": "0204_03",
 "items": [
  {
   "id": 1875,
   "key": "D0204.txt:877",
   "ko": "「도망칠 수밖에 없잖아아아아――!」"
  },
  {
   "id": 1876,
   "key": "D0204.txt:883",
   "ko": "「앗､ 이봐!」"
  },
  {
   "id": 1877,
   "key": "D0204ab.txt:21",
   "ko": "나는 억지로 알 아지프의 몸을 끌어안았다｡"
  },
  {
   "id": 1878,
   "key": "D0204ab.txt:29",
   "ko": "「자､ 잠깐……무엇을 하는 것이냐!」"
  },
  {
   "id": 1879,
   "key": "D0204ab.txt:34",
   "ko": "「말했잖아! 도망치는 게 당연하잖아､ 바보야!」"
  },
  {
   "id": 1880,
   "key": "D0204ab.txt:40",
   "ko": "「무슨 소리냐､ 쿠로｡ 이런 잡병 따위 몇이 뭉친들……아앙!」"
  },
  {
   "id": 1881,
   "key": "D0204ab.txt:45",
   "ko": "「됐으니까 얌전히 있으라고오오――!」"
  },
  {
   "id": 1882,
   "key": "D0204ab.txt:50",
   "ko": "「후냐아앗! 앗……이､ 이놈아아아아――!」"
  },
  {
   "id": 1883,
   "key": "D0204ab.txt:56",
   "ko": "날뛰는 알의 주먹과 팔꿈치에 맞아 아프지만 그런 걸 신경 쓸 겨를이 없다｡"
  },
  {
   "id": 1884,
   "key": "D0204ab.txt:58",
   "ko": "나는 불타는 거리를 뒤로한 채 전속력으로 도망쳤다｡"
  },
  {
   "id": 1885,
   "key": "D0204ab.txt:71",
   "ko": "「기다려어어어､ 놓칠 것 같으냐아아아!」 「여기는 스톤! 18구역에서 남녀 2인조 테러리스트와 조우! 지원을 요청한다!」"
  },
  {
   "id": 1886,
   "key": "D0204ab.txt:80",
   "ko": "「스톤 군……그､ 그보다､ 구､ 구급차……를……크윽」 우와아아아아!?"
  },
  {
   "id": 1887,
   "key": "D0204ab.txt:91",
   "ko": "뭔가 테러리스트 취급인데요!?"
  },
  {
   "id": 1888,
   "key": "D0204ab.txt:99",
   "ko": "「게게겍! 빨라! 벌써 몰려들었어!」"
  },
  {
   "id": 1889,
   "key": "D0204ab.txt:105",
   "ko": "="
  },
  {
   "id": 1890,
   "key": "D0204ab.txt:110",
   "ko": "「에잇! 그러니 이 몸을 내려놓아라! 저런 무리 따위 일 초도 걸리지 않고……햐아앗!?」"
  },
  {
   "id": 1891,
   "key": "D0204ab.txt:118",
   "ko": "「됐으니까 입 다물고 있으라고오오――――!」"
  },
  {
   "id": 1892,
   "key": "D0204ab.txt:123",
   "ko": "……아니､ 잠깐! 곰곰이 생각해 보니 이 녀석을 데리고 도망칠 이유가 하나도 없잖아!"
  },
  {
   "id": 1893,
   "key": "D0204ab.txt:128",
   "ko": "「아――､ 제기랄어어어! 왜 이렇게 골칫거리만 껴안는 거냐고､ 나는아아아!」"
  },
  {
   "id": 1894,
   "key": "D0204ab.txt:142",
   "ko": "「크으으…… 남의 말을 들으란 말이다아아――――!」"
  },
  {
   "id": 1895,
   "key": "D0204ab.txt:162",
   "ko": "나는 전력으로 달리기 시작했다｡"
  },
  {
   "id": 1896,
   "key": "D0204ab.txt:173",
   "ko": "「이놈아아아아! 어디로 가는 것이냐!?」"
  },
  {
   "id": 1897,
   "key": "D0204ab.txt:180",
   "ko": "이런 일에 어울려 줄 수 있겠냐!"
  },
  {
   "id": 1898,
   "key": "D0204ab.txt:183",
   "ko": "알과 피투성이 경관들과 폭염을 뿜는 장갑차와 불타오르는 거리와 그 밖의 온갖､ 못 본 걸로 하고 싶은 모든 것에 등을 돌리고 나는 달렸다｡"
  },
  {
   "id": 1899,
   "key": "D0204ab.txt:194",
   "ko": "「기다려라! 그대는 언제까지 현실에서 눈을 돌리고 계속 도망칠 셈이냐! 미래를 바라보고 싸워라 쿠로!」"
  },
  {
   "id": 1900,
   "key": "D0204ab.txt:202",
   "ko": "――네가 그런 폼 나는 대사를 내뱉을"
  },
  {
   "id": 1901,
   "key": "D0204ab.txt:203",
   "ko": "자격은 없다｡ 「큭……놓칠쏘냐､ 이 자식! ……우오오오!?」"
  },
  {
   "id": 1902,
   "key": "D0204ab.txt:225",
   "ko": "「우､ 움직이지 마! 이번엔 맞힌다!」"
  },
  {
   "id": 1903,
   "key": "D0204ab.txt:231",
   "ko": "「큭……인간 따위가 잔재주를!」"
  },
  {
   "id": 1904,
   "key": "D0204ab.txt:245",
   "ko": "「그갸아아아아아아아아!」"
  },
  {
   "id": 1905,
   "key": "D0204ab.txt:253",
   "ko": "「스톤 군――｡ 죽기 전에 나 좀 도와줘어――!」"
  },
  {
   "id": 1906,
   "key": "D0204ab.txt:262",
   "ko": "아아아아아아아아!"
  },
  {
   "id": 1907,
   "key": "D0204ab.txt:263",
   "ko": "아무것도 안 들려! 아무것도 안 들린다고오오오오!"
  },
  {
   "id": 1908,
   "key": "D0204ab.txt:282",
   "ko": "「하아､ 하아……뭔가……어제부터……달리기만､ 하네」"
  },
  {
   "id": 1909,
   "key": "D0204ab.txt:286",
   "ko": "일단은 도망쳐 살아남았다｡"
  },
  {
   "id": 1910,
   "key": "D0204ab.txt:287",
   "ko": "뭔가 멀리서 폭음이 끊임없이 들려오는 것 같지만 억지로 의식 밖으로 밀어낸다｡"
  },
  {
   "id": 1911,
   "key": "D0204ab.txt:294",
   "ko": "「……젠장､ 저 녀석이랑 어울리다간 목숨이 몇 개라도 모자라겠어」"
  },
  {
   "id": 1912,
   "key": "D0204ab.txt:298",
   "ko": "엉망으로 도망쳐 다닌 탓에 지금 어디쯤인지 알 수 없었다｡ 주위를 둘러본다｡"
  },
  {
   "id": 1913,
   "key": "D0204ab.txt:300",
   "ko": "……또다시 꽤 안쪽까지 들어와 버린 모양이다｡"
  },
  {
   "id": 1914,
   "key": "D0204ab.txt:301",
   "ko": "이 근처는 위험하다｡ 얼른 떠나기로 하자｡"
  }
 ]
}