   "ko": "="
  },
  {
   "id": 36184,
   "key": "D1401le.txt:101",
   "ko": "그에게는 그 나름의 망집이 있다｡"
  },
  {
   "id": 36185,
   "key": "D1401le.txt:104",
   "ko": "――폭렬하는 사악한 기운의 여파는 오만한 마술사에게 휘감기며 스며들어 간다｡"
  },
  {
   "id": 36186,
   "key": "D1401le.txt:123",
   "ko": "「결계의 마력값을 280퍼센트까지 상승시키세요!」"
  },
  {
   "id": 36187,
   "key": "D1401le.txt:131",
   "ko": "「그､ 그러면 술식이 폭주하는데요……!」"
  },
  {
   "id": 36188,
   "key": "D1401le.txt:137",
   "ko": "「상관없습니다! 어서!」"
  },
  {
   "id": 36189,
   "key": "D1401le.txt:144",
   "ko": "「――알겠습니다｡ 기지 내 전 마력을 결계 강화로 돌립니다」"
  },
