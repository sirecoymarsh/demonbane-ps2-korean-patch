{
 "packet": "0904_04",
 "items": [
  {
   "id": 18844,
   "key": "D0904al.txt:894",
   "ko": "무사할 터인데―― 「――――!」"
  },
  {
   "id": 18845,
   "key": "D0904al.txt:905",
   "ko": "모퉁이를 돌아 눈에 뛰어든 광경에 등골이 얼어붙는다｡"
  },
  {
   "id": 18846,
   "key": "D0904al.txt:911",
   "ko": "다이쥬지 쿠로의 사무소에 마침 파괴 로봇 한 대가 억센 팔을 내리치는 순간이었다｡"
  },
  {
   "id": 18847,
   "key": "D0904al.txt:916",
   "ko": "「아가씨――――――!」"
  },
  {
   "id": 18848,
   "key": "D0904al.txt:927",
   "ko": "천장을 가볍게 분쇄하며 파괴 로봇의 팔이 사무소를 꿰뚫었다｡"
  },
  {
   "id": 18850,
   "key": "D0904al.txt:928",
   "ko": "한 박자 늦게､ 폭발｡"
  },
  {
   "id": 18851,
   "key": "D0904al.txt:929",
   "ko": "폭염이 순식간에 사무소를 집어삼킨다｡"
  },
  {
   "id": 18853,
   "key": "D0904al.txt:931",
   "ko": "하지만 윈필드는 보았다｡"
  },
  {
   "id": 18854,
   "key": "D0904al.txt:932",
   "ko": "폭염 속에서 튀어나오는 사람 그림자를｡"
  },
  {
   "id": 18855,
   "key": "D0904al.txt:934",
   "ko": "검은 날개를 펼치고 하늘을 날아 파괴 로봇에게 강하한다――!"
  },
  {
   "id": 18858,
   "key": "D0904al.txt:942",
   "ko": "「이 자식드으으을! 남의 집을오오오오오!」"
  },
  {
   "id": 18859,
   "key": "D0904al.txt:944",
   "ko": "간발의 차로 공주님을 안고 마기우스 스타일로 변신｡"
  },
  {
   "id": 18860,
   "key": "D0904al.txt:945",
   "ko": "불길에 등을 그을리면서도 사무소에서 탈출했다｡"
  },
  {
   "id": 18861,
   "key": "D0904al.txt:949",
   "ko": "눈 아래에는 방금 막 사무소를 부순 파괴 로봇｡"
  },
  {
   "id": 18862,
   "key": "D0904al.txt:950",
   "ko": "아직 이쪽을 눈치챈 기색은 없다｡"
  },
  {
   "id": 18863,
   "key": "D0904al.txt:951",
   "ko": "이 자식……곱게 끝날 줄 알지 마라!"
  },
  {
   "id": 18864,
   "key": "D0904al.txt:956",
   "ko": "「다､ 다이쥬지 씨!」"
  },
  {
   "id": 18866,
   "key": "D0904al.txt:961",
   "ko": "파괴 로봇을 향해 일직선으로 강하한다｡"
  },
  {
   "id": 18867,
   "key": "D0904al.txt:962",
   "ko": "오른손등에 새겨진 낙인이 타오른다｡"
  },
  {
   "id": 18868,
   "key": "D0904al.txt:970",
   "ko": "「크투가!」 마총을 소환､ 콕핏 근처를 노리고 발포한다｡"
  },
  {
   "id": 18869,
   "key": "D0904al.txt:982",
   "ko": "노린 대로 탄환은 닫힌 해치에 착탄해 폭발｡"
  },
  {
   "id": 18870,
   "key": "D0904al.txt:983",
   "ko": "콕핏의 해치를 날려버린다｡"
  },
  {
   "id": 18873,
   "key": "D0904al.txt:986",
   "ko": "「꽉 붙잡고 있어､ 공주님!」"
  },
  {
   "id": 18875,
   "key": "D0904al.txt:991",
   "ko": "「네? 꺄아아아아악!」"
  },
  {
   "id": 18876,
   "key": "D0904al.txt:998",
   "ko": "단숨에 가속｡ 검은 날개로 공주님을 감싸고 콕핏 안으로 돌진했다｡"
  },
  {
   "id": 18877,
   "key": "D0904al.txt:999",
   "ko": "착지 충격으로 콕핏의 계기류가 박살난다｡"
  },
  {
   "id": 18878,
   "key": "D0904al.txt:1001",
   "ko": "그런데 이건…… 「무인!?」"
  },
  {
   "id": 18879,
   "key": "D0904al.txt:1010",
   "ko": "콕핏에는 아무의 그림자도 없었다｡"
  },
  {
   "id": 18880,
   "key": "D0904al.txt:1011",
   "ko": "모니터가 명멸하고 조종간은 저 혼자 움직이며 기체를 조종하고 있다｡"
  },
  {
   "id": 18881,
   "key": "D0904al.txt:1014",
   "ko": "「쳇……!」"
  },
  {
   "id": 18882,
   "key": "D0904al.txt:1017",
   "ko": "검은 날개를 펼쳐 칼날 모양으로 바꿔 닥치는 대로 콘솔을 부쉈다｡"
  },
  {
   "id": 18883,
   "key": "D0904al.txt:1018",
   "ko": "전원이 꺼지고 태엽 풀린 장난감처럼 파괴 로봇은 활동을 멈췄다｡"
  },
  {
   "id": 18884,
   "key": "D0904al.txt:1023",
   "ko": "「지금 거리에서 날뛰는 파괴 로봇은 전부 자동 조종인가요……」"
  },
  {
   "id": 18885,
   "key": "D0904al.txt:1026",
   "ko": "「경솔했어요……『블랙로지』의 과학력을 과소평가했습니다」"
  },
  {
   "id": 18886,
   "key": "D0904al.txt:1030",
   "ko": "애초에 파괴 로봇의 양산이 가능하다니｡ 이미 일개 범죄조직의 기술력을 훨씬 넘어섰다｡"
  },
  {
   "id": 18887,
   "key": "D0904al.txt:1033",
   "ko": "역시 이놈들､ 세계를 상대로 싸울 작정인 거다……!"
  },
  {
   "id": 18888,
   "key": "D0904al.txt:1038",
   "ko": "「아가씨! 다이쥬지 님! 알 아지프 님!」"
  },
  {
   "id": 18889,
   "key": "D0904al.txt:1047",
   "ko": "밖에서 들려온 목소리에 우리는 콕핏에서 나왔다｡"
  },
  {
   "id": 18890,
   "key": "D0904al.txt:1048",
   "ko": "차창에서 집사님이 이쪽을 올려다보며 목소리를 높이고 있다｡"
  },
  {
   "id": 18891,
   "key": "D0904al.txt:1053",
   "ko": "「윈필드인가요! 저희는 괜찮아요! 그보다 상황은……!」"
  }
 ]
}