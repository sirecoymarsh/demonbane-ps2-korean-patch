   "key": "D1310le.txt:747",
   "ko": "="
  },
  {
   "id": 34860,
   "key": "D1310le.txt:749",
   "ko": "그런 짓､ 하게 둘까 보냐!"
  },
  {
   "id": 34861,
   "key": "D1310le.txt:750",
