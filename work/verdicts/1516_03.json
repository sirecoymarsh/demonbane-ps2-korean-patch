  },
  {
   "id": 47801,
   "key": "D1516le.txt:102",
   "ko": "「무슨…… 무슨 일이 벌어지고 있는 거냐……?」"
  },
  {
   "id": 47803,
   "key": "D1516le.txt:106",
   "ko": "여기는 결전장｡"
  },
  {
   "id": 47804,
   "key": "D1516le.txt:107",
   "ko": "아니､ 일방적인 유린을 결전이라 부르지는 않는다､"
  },
  {
   "id": 47809,
   "key": "D1516le.txt:108",
   "ko": "여기는 처형장｡"
  },
  {
   "id": 47812,
   "key": "D1516le.txt:110",
   "ko": "――절대적인 권위로써､ 데몬베인이 마를 심판한다｡"
  },
  {
   "id": 47813,
   "key": "D1516le.txt:114",
   "ko": "「히라니프라 시스템이!?」"
  },
  {
   "id": 47814,
   "key": "D1516le.txt:120",
   "ko": "데몬베인이 저절로 움직이기 시작했다｡"
  },
  {
   "id": 47823,
   "key": "D1516le.txt:121",
   "ko": "오른손바닥을 내지른다｡"
  },
  {
   "id": 47824,
   "key": "D1516le.txt:126",
   "ko": "주위 광경마저 일그러뜨리며､ 집어삼키는 압도적인 어둠이 나타난다｡"
  },
  {
   "id": 47832,
   "key": "D1516le.txt:127",
   "ko": "――레무리아 임팩트｡"
  },
  {
   "id": 47833,
   "key": "D1516le.txt:128",
   "ko": "무한한 열량을 만들어내는､ 블랙홀이다｡"
  },
  {
   "id": 47837,
   "key": "D1516le.txt:130",
   "ko": "레무리아 임팩트의 에너지는､ 마침내 차원 그 자체를 일그러뜨리고 만다｡"
  },
  {
   "id": 47839,
   "key": "D1516le.txt:132",
   "ko": "눈앞에 차원의 균열이 내달렸다｡"
  },
  {
   "id": 47840,
   "key": "D1516le.txt:136",
   "ko": "균열 속으로､ 데몬베인이 팔을 집어넣는다｡"
  },
  {
   "id": 47841,
   "key": "D1516le.txt:137",
   "ko": "무언가를 붙잡은 모양이다｡ 그대로 그것을 균열에서 끌어낸다｡"
  },
  {
   "id": 47850,
   "key": "D1516le.txt:138",
   "ko": "그것의 전모가 드러났다｡"
  },
  {
   "id": 47851,
   "key": "D1516le.txt:146",
   "ko": "「………………뭐､ 뭐야?」"
  },
  {
   "id": 47853,
   "key": "D1516le.txt:149",
   "ko": "알 수 없다｡"
  },
  {
   "id": 47856,
   "key": "D1516le.txt:151",
   "ko": "뭐라고 표현하면 좋을까?"
  },
  {
   "id": 47857,
   "key": "D1516le.txt:152",
   "ko": "뒤틀린 신주｡"
  },
  {
   "id": 47858,
   "key": "D1516le.txt:152",
   "ko": "미쳐버린 신수｡"
  },
  {
   "id": 47861,
   "key": "D1516le.txt:152",
   "ko": "날 없는 신검……"
  },
  {
   "id": 47862,
   "key": "D1516le.txt:153",
   "ko": "어쨌든 이형의 물질이었다｡"
  },
  {
   "id": 47866,
   "key": "D1516le.txt:153",
   "ko": "인지의 범위에 존재하는 물질이 아니다｡"
  },
  {
   "id": 47867,
   "key": "D1516le.txt:156",
   "ko": "――왜냐하면 이것은､ 끓어오르는 혼돈을 엮어 만들어낸､ 신대의 물질이니까｡"
  },
  {
   "id": 47868,
   "key": "D1516le.txt:163",
   "ko": "데몬베인의 전장을 넘어설 만큼 길고 거대한 신주를 양손에 쥐고､ 휘두른다｡"
  },
  {
   "id": 47869,
   "key": "D1516le.txt:165",
   "ko": "광휘가､ 암흑이 궤적을 그리며､ 공간을 새겼다｡"
  },
  {
   "id": 47870,
   "key": "D1516le.txt:167",
   "ko": "데몬베인의 전방에 마법진이 떠오르고､ 그 중심을 꿰뚫듯이､ 신주를 겨눈다｡"
  },
  {
   "id": 47871,
   "key": "D1516le.txt:169",
   "ko": "신주의 창끝은､ 리베르 레기스를 겨누고 있다｡"
  },
  {
   "id": 47874,
   "key": "D1516le.txt:171",
   "ko": "리베르 레기스가 전율했다――그렇게 보였다｡"
