  },
  {
   "id": 3509,
   "key": "D0309_ps2.txt:721",
   "ko": "「윽…… 아…… 아그……」"
  },
  {
   "id": 3510,
   "key": "D0309_ps2.txt:737",
   "ko": "「키득키득……」 「으윽…… 크윽……」"
  },
  {
   "id": 3511,
   "key": "D0309_ps2.txt:750",
   "ko": "한순간､ 정신을 잃었던 모양이다｡ 나는 온몸이 거미줄투성이가 된 채"
  },
  {
   "id": 3512,
   "key": "D0309_ps2.txt:753",
   "ko": "땅바닥에 굴러 있었다｡ 실 틈새로 간신히 주위의 모습이 보인다｡"
  },
  {
   "id": 3513,
   "key": "D0309_ps2.txt:761",
   "ko": "거미 여자는､ 꼼짝도 못 하는 나를 즐거운 듯이 내려다보고 있었다｡ 최고의 먹잇감을 얻은 듯한､ 사나운 육식 짐승의 얼굴｡ 「크……윽」"
  },
  {
   "id": 3514,
   "key": "D0309_ps2.txt:769",
   "ko": "거미 여자는 쭈그려 앉아､ 내 몸에 손을 뻗는다――"
  },
  {
   "id": 3515,
   "key": "D0309_ps2.txt:774",
   "ko": "「멈춰라」 「――――!?」"
  },
  {
   "id": 3516,
   "key": "D0309_ps2.txt:784",
   "ko": "갑작스러운 목소리에､ 거미 여자는 당황해 뒤를 돌아본다｡ 하지만｡"
  },
  {
   "id": 3517,
   "key": "D0309_ps2.txt:799",
   "ko": "「늦었다!」 「아아아아아――앗!」"
  },
  {
   "id": 3518,
   "key": "D0309_ps2.txt:821",
   "ko": "충격파에 날아가는 거미 여자｡ 알이었다｡ 내가 기절하기 직전､ 마기우스 스타일을 해제하고 빠져나온 것이리라｡"
  },
  {
   "id": 3519,
   "key": "D0309_ps2.txt:829",
   "ko": "「괜찮으냐､ 쿠로? 기다리고 있거라｡ 지금 해주해 주마」"
  },
  {
   "id": 3520,
   "key": "D0309_ps2.txt:843",
   "ko": "말이 떨어지기 무섭게 내 몸이 옅은 빛에 감싸였다｡"
  },
  {
   "id": 3521,
   "key": "D0309_ps2.txt:844",
   "ko": "거미줄이 너덜너덜 삭아 무너져 내린다｡ 「큭…… 하아……! 하아…… 하아…… 사､ 살았다……」"
  },
  {
   "id": 3522,
   "key": "D0309_ps2.txt:855",
   "ko": "「자､ 다시 시작이다｡ 정신 차리라고」 「크……윽!」"
  },
  {
   "id": 3523,
   "key": "D0309_ps2.txt:875",
   "ko": "「도망친다!」 「알고 있어!」"
  },
  {
   "id": 3525,
   "key": "D0309_ps2.txt:890",
   "ko": "나는 다시 마기우스 스타일로 변신해､ 거미 여자의 등을 쫓아 대지를 박찼다｡"
  },
  {
   "id": 3526,
   "key": "D0309_ps2.txt:904",
   "ko": "「………………」 「…… 저､ 저기…… 누가､ 좀 도와……」"
  }
 ]
