   "ko": "="
  },
  {
   "id": 45394,
   "key": "D1508ru.txt:390",
   "ko": "「……가증스러운 여자」"
  },
  {
   "id": 45395,
   "key": "D1508ru.txt:396",
   "ko": "="
  },
