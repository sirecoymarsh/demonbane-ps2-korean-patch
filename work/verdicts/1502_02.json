  {
   "id": 41405,
   "key": "D1502al.txt:911",
   "ko": "『기둥』의 부상은､ 그 하나로 그치지 않았다｡"
  },
  {
   "id": 41406,
   "key": "D1502al.txt:914",
   "ko": "="
  },
  {
