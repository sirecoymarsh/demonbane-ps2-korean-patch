{
 "packet": "ep_ruri02a_02",
 "items": [
  {
   "id": 50613,
   "key": "ep_ruri02a.txt:320",
   "ko": "닳아 해져 가는 마음이 무섭다｡"
  },
  {
   "id": 50614,
   "key": "ep_ruri02a.txt:324",
   "ko": "「저는…… 그렇게 참을성 있는 편이 아니에요?」"
  },
  {
   "id": 50615,
   "key": "ep_ruri02a.txt:327",
   "ko": "손끝으로 펜을 굴리며 토라져 본다｡"
  },
  {
   "id": 50616,
   "key": "ep_ruri02a.txt:331",
   "ko": "「저를 어디의 누구라고 생각하는 건가요? 하도 재벌의 총수､ 하도 루리예요? 아주 대단한 사람이라고요? 황송할 지경이라고요? 그런 사람을､ 그런 사람을 이렇게나 기다리게 하다니…… 정말 겁도 없네요｡ 쿠로?」"
  },
  {
   "id": 50617,
   "key": "ep_ruri02a.txt:334",
   "ko": "혼자 투덜대고 있자니 부글부글 화가 치밀어 올랐다｡ 그래｡"
  },
  {
   "id": 50618,
   "key": "ep_ruri02a.txt:336",
   "ko": "어째서 나만 이런 마음을 겪어야 하는 거야｡"
  },
  {
   "id": 50619,
   "key": "ep_ruri02a.txt:340",
   "ko": "「돌아오면 찬찬히 교육을 해 드려야겠어요｡ 그 사람은…… 이쪽이 얌전하게 굴면 한없이 우쭐대서는｡ ……맞아요｡ 그랬지요｡ 그랬어요｡ 쿠로는 처음 만났을 때부터 제멋대로인 사람이었어요｡ 저에게 거스르는 게 얼마나 무서운 일인지 뼈저리게 알려 드리겠어요」"
  },
  {
   "id": 50620,
   "key": "ep_ruri02a.txt:348",
   "ko": "펜을 세게､ 세게…… 팔이 떨릴 만큼 세게 움켜쥐고 있었다｡"
  },
  {
   "id": 50621,
   "key": "ep_ruri02a.txt:350",
   "ko": "빠직､ 하고 불길한 소리가 난다｡"
  },
  {
   "id": 50622,
   "key": "ep_ruri02a.txt:352",
   "ko": "한바탕 화를 내고 나니 왠지 힘이 빠졌다｡"
  },
  {
   "id": 50623,
   "key": "ep_ruri02a.txt:353",
   "ko": "부서진 펜이 손바닥에서 떨어져 책상 위를 구른다｡"
  },
  {
   "id": 50624,
   "key": "ep_ruri02a.txt:360",
   "ko": "――뭘 이렇게 흥분하고 있는 거지､ 나는｡"
  },
  {
   "id": 50625,
   "key": "ep_ruri02a.txt:362",
   "ko": "어째서 저런 매정한 남자에게 그렇게까지 매달릴 필요가 있지?"
  },
  {
   "id": 50626,
   "key": "ep_ruri02a.txt:363",
   "ko": "그래､ 바보 같다｡"
  },
  {
   "id": 50627,
   "key": "ep_ruri02a.txt:364",
   "ko": "쿠로 따위 잊고 인생을 즐기면 되지 않은가｡"
  },
  {
   "id": 50628,
   "key": "ep_ruri02a.txt:371",
   "ko": "책상을 양손으로 내리치고 단숨에 몸을 일으킨다｡"
  },
  {
   "id": 50629,
   "key": "ep_ruri02a.txt:372",
   "ko": "스스로를 북돋우듯 주먹을 치켜들며 누구를 향한 것도 아닌 선언을 한다｡"
  },
  {
   "id": 50630,
   "key": "ep_ruri02a.txt:376",
   "ko": "「그래요! 저런 정도의 남자에게 묶여서 이 미모와 재능을 썩혀 두는 건 인류의 손실인걸요! 그래요! 이제 쿠로 따위 몰라요! 저런 남자､ 쓰레기처럼 휙 하고 내버려 주겠어요!」"
  },
  {
   "id": 50631,
   "key": "ep_ruri02a.txt:380",
   "ko": "뒤로 돌아｡ 등 뒤의 창문을 향해 걷기 시작한다｡"
  },
  {
   "id": 50632,
   "key": "ep_ruri02a.txt:382",
   "ko": "거리를 내려다보며 큰 소리로"
  },
  {
   "id": 50633,
   "key": "ep_ruri02a.txt:386",
   "ko": "「쿠로 바보야아아아아아아아아아아아아아아아아――――――!」"
  },
  {
   "id": 50634,
   "key": "ep_ruri02a.txt:389",
   "ko": "외쳤다｡ 있는 힘껏 외쳤다｡"
  },
  {
   "id": 50635,
   "key": "ep_ruri02a.txt:392",
   "ko": "누군가 들었다면 머리를 걱정했을 게 틀림없지만 아랑곳없이 외쳤다｡"
  },
  {
   "id": 50636,
   "key": "ep_ruri02a.txt:394",
   "ko": "숨이 이어지는 한 외쳤다｡"
  },
  {
   "id": 50637,
   "key": "ep_ruri02a.txt:395",
   "ko": "숨이 끊겨도 억지로 쥐어짜서 외쳤다｡"
  },
  {
   "id": 50638,
   "key": "ep_ruri02a.txt:397",
   "ko": "있는 힘껏 외쳤다｡"
  },
  {
   "id": 50639,
   "key": "ep_ruri02a.txt:398",
   "ko": "외치고､ 외치고､ 다 외치고――하지만｡"
  },
  {
   "id": 50640,
   "key": "ep_ruri02a.txt:402",
   "ko": "「…………으윽」 왠지 눈시울이 뜨겁다｡"
  },
  {
   "id": 50641,
   "key": "ep_ruri02a.txt:409",
   "ko": "「으윽…… 으으…… 아아……」"
  },
  {
   "id": 50642,
   "key": "ep_ruri02a.txt:412",
   "ko": "시야가 흐려져 아무것도 보이지 않는다｡"
  },
  {
   "id": 50643,
   "key": "ep_ruri02a.txt:416",
   "ko": "「으아아…… 으와아아아…… 아아아아……!」"
  },
  {
   "id": 50644,
   "key": "ep_ruri02a.txt:419",
   "ko": "뜨거운 물방울이 뺨을 타고 흐른다｡"
  },
  {
   "id": 50645,
   "key": "ep_ruri02a.txt:420",
   "ko": "한 방울 흐르고 나면 나머지는 무너지듯이 뚝뚝 뚝뚝､ 하고｡"
  },
  {
   "id": 50646,
   "key": "ep_ruri02a.txt:424",
   "ko": "「아아아아아! 와아아아아아! 으와아아아아앙!」"
  },
  {
   "id": 50647,
   "key": "ep_ruri02a.txt:427",
   "ko": "울음소리가 쉬었을 터인 목구멍에서 터져 나온다｡"
  },
  {
   "id": 50648,
   "key": "ep_ruri02a.txt:429",
   "ko": "울었다｡ 울었다｡"
  },
  {
   "id": 50649,
   "key": "ep_ruri02a.txt:431",
   "ko": "울다 쓰러졌다｡"
  },
  {
   "id": 50650,
   "key": "ep_ruri02a.txt:433",
   "ko": "마치 어린아이처럼 체면도 없이 계속 울었다｡"
  },
  {
   "id": 50651,
   "key": "ep_ruri02a.txt:435",
   "ko": "――잊을 수 있을 리가 없었다｡"
  },
  {
   "id": 50652,
   "key": "ep_ruri02a.txt:439",
   "ko": "「거짓말쟁이! 거짓말쟁이! 거짓말쟁이! ……거짓말쟁이이이――――――!」"
  }
 ]
}