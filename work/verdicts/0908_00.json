  {
   "id": 19795,
   "key": "D0908al_ps2.txt:207",
   "ko": "「그렇다면 묻겠습니다! 도대체 다른 어떤 방법이 있다는 겁니까!?」 「저 그랜드 마스터가 성서의 짐승이라면､ 저 사신은 그야말로 묵시록의 용! 설마 신의 원군을 기다리라는 겁니까!?」"
  },
  {
   "id": 19796,
   "key": "D0908al_ps2.txt:217",
   "ko": "「하､ 하지만……핵을 사용하면､ 아컴시티는……」"
  },
  {
   "id": 19797,
   "key": "D0908al_ps2.txt:222",
   "ko": "="
  },
  {
   "id": 19798,
   "key": "D0908al_ps2.txt:223",
   "ko": "="
  },
  {
   "id": 19799,
   "key": "D0908al_ps2.txt:228",
   "ko": "「대통령｡ 합중국 역사상 최대의 오점으로 이름을 남길 치욕､ 감수해 주십시오」"
  },
  {
   "id": 19800,
   "key": "D0908al_ps2.txt:233",
   "ko": "모두가 대통령의 말을 기다리고 있다｡"
  },
  {
   "id": 19801,
   "key": "D0908al_ps2.txt:234",
   "ko": "대통령은 눈을 감고 깊이 생각에 잠겨 있었다｡"
  },
  {
   "id": 19802,
   "key": "D0908al_ps2.txt:237",
   "ko": "다음에 눈을 떴을 때､ 거기엔 어떤 망설임도 떠오르지 않았다｡"
  },
  {
   "id": 19803,
   "key": "D0908al_ps2.txt:248",
   "ko": "「――좋다｡ 아컴시티 상공의 적 목표에 대한 핵무기 사용을 허가한다」"
  },
  {
   "id": 19804,
   "key": "D0908al_ps2.txt:267",
   "ko": "「……멋없는 짓이로다」"
  },
  {
   "id": 19805,
   "key": "D0908al_ps2.txt:288",
   "ko": "「다이쥬지 씨!」 「뭐､ 뭐야､ 갑자기?」"
  },
  {
   "id": 19806,
   "key": "D0908al_ps2.txt:296",
   "ko": "「크크크크크크､ 큰! 큰크크크크､ 큰일､ 큰일 났어요!! 해해해해해해……」"
  },
  {
   "id": 19807,
   "key": "D0908al_ps2.txt:303",
   "ko": "「에에이! 침착하게 말하지 못하겠느냐!」"
  },
  {
   "id": 19808,
   "key": "D0908al_ps2.txt:308",
   "ko": "「……방금 전､ 이 아컴시티를 향해 핵미사일이 발사되었습니다」"
  },
  {
   "id": 19809,
   "key": "D0908al_ps2.txt:313",
   "ko": "「뭐――――」 핵미사일｡"
  },
