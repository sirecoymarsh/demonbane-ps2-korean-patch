{
 "packet": "1504_06",
 "items": [
  {
   "id": 42371,
   "key": "D1504al.txt:1693",
   "ko": "하지만 어떠냐｡ 이걸로 너도 알았겠지?"
  },
  {
   "id": 42372,
   "key": "D1504al.txt:1697",
   "ko": "너는 그리 쉽게 사람과의 인연을 끊어낼 만큼 무정하지도 않고､ 냉철해지지도 못한다는 걸｡"
  },
  {
   "id": 42373,
   "key": "D1504al.txt:1700",
   "ko": "천 년간 자신을 속여온 거짓은 이미 벗겨져 떨어졌어｡ 이제 와서 거짓에 매달려 봤자 늦었다고｡"
  },
  {
   "id": 42374,
   "key": "D1504al.txt:1704",
   "ko": "요컨대 너는 지독하게 서툴고――"
  },
  {
   "id": 42375,
   "key": "D1504al.txt:1710",
   "ko": "「――지독하게 외로움을 타는 녀석이라고｡ 너는」"
  },
  {
   "id": 42376,
   "key": "D1504al.txt:1716",
   "ko": "「치이이이이이잇!」"
  },
  {
   "id": 42377,
   "key": "D1504al.txt:1736",
   "ko": "알의 마력이 부드럽게 나를 감싼다｡"
  },
  {
   "id": 42378,
   "key": "D1504al.txt:1737",
   "ko": "낙하 속도가 눈에 띄게 줄어들어 간다｡"
  },
  {
   "id": 42379,
   "key": "D1504al.txt:1754",
   "ko": "「쿠로…읏!」"
  },
  {
   "id": 42380,
   "key": "D1504al.txt:1759",
   "ko": "데몬베인의 손바닥이 나를 향해 뻗어졌다｡"
  },
  {
   "id": 42381,
   "key": "D1504al.txt:1760",
   "ko": "해수면까지는 이제 얼마 남지 않았다｡"
  },
  {
   "id": 42382,
   "key": "D1504le.txt:8",
   "ko": "「쿠로! 정신 차리거라! 큿!」"
  },
  {
   "id": 42383,
   "key": "D1504le.txt:12",
   "ko": "알이 상처에 매달려 필사적으로 마력을 흘려 넣는다｡"
  },
  {
   "id": 42384,
   "key": "D1504le.txt:14",
   "ko": "쿠로의 몸이 경련하며 목이 막힌다｡"
  },
  {
   "id": 42385,
   "key": "D1504le.txt:15",
   "ko": "기침과 동시에 또 피를 토해냈다｡"
  },
  {
   "id": 42386,
   "key": "D1504le.txt:17",
   "ko": "회복은 더디고 상황은 좋지 않다｡"
  },
  {
   "id": 42387,
   "key": "D1504le.txt:22",
   "ko": "필사적인 알을､ 몸을 일으킨 라이카는 아무것도 하지 않고 그저 공허한 눈으로 내려다보고 있다｡"
  },
  {
   "id": 42388,
   "key": "D1504le.txt:24",
   "ko": "그 곁에 에셀드레다가 다가섰다｡"
  },
  {
   "id": 42389,
   "key": "D1504le.txt:31",
   "ko": "「하하､ …꼴사납네요… 알 아지프…읏」"
  },
  {
   "id": 42390,
   "key": "D1504le.txt:34",
   "ko": "에셀드레다 역시 몇 번이고 기침하며――그럼에도 조소를 피와 함께 내장 밑바닥에서 토해내고 있다｡"
  },
  {
   "id": 42391,
   "key": "D1504le.txt:38",
   "ko": "「소중한 여인에게… 배신당한… 쓰디쓴 맛은 어떤가요? 다이쥬지… 쿠로…읏!」"
  },
  {
   "id": 42392,
   "key": "D1504le.txt:41",
   "ko": "에셀드레다의 미모가 처참한 미소로 일그러진다｡"
  },
  {
   "id": 42393,
   "key": "D1504le.txt:42",
   "ko": "검은 눈동자가 가학적인 열락으로 번들거리고 있었다｡"
  },
  {
   "id": 42394,
   "key": "D1504le.txt:44",
   "ko": "병에 담긴 태아를 들어 올린다｡"
  },
  {
   "id": 42395,
   "key": "D1504le.txt:48",
   "ko": "「이걸로는 끝내지 않아요…! 당신의 소중한 라이카는… 이 아이를… 잉태할 테니까…!」 「큿…!」"
  },
  {
   "id": 42396,
   "key": "D1504le.txt:55",
   "ko": "에셀드레다를 저지하고자 알은 술식을 달리게 한다｡"
  },
  {
   "id": 42397,
   "key": "D1504le.txt:62",
   "ko": "하지만 그때 리베르 레기스를 충격이 덮쳤다｡"
  },
  {
   "id": 42398,
   "key": "D1504le.txt:63",
   "ko": "격렬하게 흔들리는 리베르 레기스의 손바닥 위에서 알은 쿠로의 몸을 붙들고､ 튕겨나가지 않도록 필사적으로 기체에 매달렸다｡"
  },
  {
   "id": 42399,
   "key": "D1504le.txt:67",
   "ko": "「나코트 사본이이이이이!」"
  },
  {
   "id": 42400,
   "key": "D1504le.txt:70",
   "ko": "베스파시아누스의 포효가 울려 퍼진다｡"
  },
  {
   "id": 42401,
   "key": "D1504le.txt:71",
   "ko": "그때까지 침묵하던 사이크라노쉬가 기동해 리베르 레기스를 짓뭉개려 돌진한 것이다｡"
  },
  {
   "id": 42402,
   "key": "D1504le.txt:78",
   "ko": "두 거체가 충돌해 순간 눈이 멀 정도로 눈부신 불꽃을 흩뿌린다｡"
  },
  {
   "id": 42403,
   "key": "D1504le.txt:84",
   "ko": "「하하하하하! 이거 참､ 꽤나 시간이 걸렸군요､ 베스파시아누스 도사!」 「이대로 방관만 하실 줄 알았는데､ 후후」"
  },
  {
   "id": 42404,
   "key": "D1504le.txt:91",
   "ko": "「닥쳐라､ 하등한 정령 놈! 네놈에게… 네놈 따위에게 방해는 못 하게 한다! 못 하게 하고말고! 궁극의 마인은 내 손으로 완성되는 것이다!」"
  },
  {
   "id": 42405,
   "key": "D1504le.txt:99",
   "ko": "「의욕은 대단히 좋습니다! 하지만 이제 대역은 없어요! 어머어머､ 어쩌죠!?」"
  },
  {
   "id": 42406,
   "key": "D1504le.txt:114",
   "ko": "튕겨나듯 리베르 레기스는 뒤로 뛰었다｡"
  },
  {
   "id": 42407,
   "key": "D1504le.txt:115",
   "ko": "뛰어 물러나면서 금빛 검을 휘두른다｡"
  },
  {
   "id": 42408,
   "key": "D1504le.txt:120",
   "ko": "참격이 공간을 가르며 내달렸다｡"
  },
  {
   "id": 42409,
   "key": "D1504le.txt:121",
   "ko": "리베르 레기스의 두 배 가까이 되는 거체의､ 네 개인 다리 중 하나를 가볍게 절단한다｡"
  },
  {
   "id": 42410,
   "key": "D1504le.txt:131",
   "ko": "폭음이 울려 퍼졌다｡"
  }
 ]
}