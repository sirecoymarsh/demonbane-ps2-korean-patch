{
 "packet": "0904_03",
 "items": [
  {
   "id": 18800,
   "key": "D0904al.txt:694",
   "ko": "콕핏에는 아무의 그림자도 없었다｡"
  },
  {
   "id": 18801,
   "key": "D0904al.txt:695",
   "ko": "모니터가 명멸하고 조종간은 저 혼자 움직이며 기체를 조종하고 있다｡"
  },
  {
   "id": 18802,
   "key": "D0904al.txt:699",
   "ko": "나는 콕핏 안으로 파고들어 닥치는 대로 콘솔을 부순다｡"
  },
  {
   "id": 18805,
   "key": "D0904al.txt:701",
   "ko": "콘솔의 전원이 꺼지고 태엽 풀린 장난감처럼 파괴 로봇은 활동을 멈췄다｡"
  },
  {
   "id": 18806,
   "key": "D0904al.txt:705",
   "ko": "「쿠로 군! 괜찮아!?」"
  },
  {
   "id": 18807,
   "key": "D0904al.txt:720",
   "ko": "「이쪽은 괜찮아! 그보다 라이카 씨! 빨리 꼬맹이들 데리고 대피소로 피난해!」"
  },
  {
   "id": 18809,
   "key": "D0904al.txt:724",
   "ko": "「쿠､ 쿠로 군은……!?」"
  },
  {
   "id": 18810,
   "key": "D0904al.txt:738",
   "ko": "라이카 씨의 물음에 나는 굳어버렸다｡"
  },
  {
   "id": 18811,
   "key": "D0904al.txt:740",
   "ko": "어쩌지…… 싸우는 건가? 싸울 수 있나? 지금의 나로?"
  },
  {
   "id": 18812,
   "key": "D0904al.txt:743",
   "ko": "제 힘을 믿지 못하는 지금의 나는…… 싸워도 헛수고일지 모르는데､ 나는……｡"
  },
  {
   "id": 18813,
   "key": "D0904al.txt:745",
   "ko": "나는 대체……｡ 「쿠로!」"
  },
  {
   "id": 18814,
   "key": "D0904al.txt:754",
   "ko": "알의 질책이 날아들어 나는 생각의 굴레에서 빠져나왔다｡"
  },
  {
   "id": 18815,
   "key": "D0904al.txt:755",
   "ko": "고민하고 있을 때가 아니야……!"
  },
  {
   "id": 18816,
   "key": "D0904al.txt:758",
   "ko": "「내 걱정은 하지 마……! 그러니까 빨리!」"
  },
  {
   "id": 18817,
   "key": "D0904al.txt:769",
   "ko": "「저놈들 멋대로 하게 둘까 보냐! 닥치는 대로 철저하게 쓸어버리겠어!」"
  },
  {
   "id": 18818,
   "key": "D0904al.txt:774",
   "ko": "「……읏! 무､ 무리만은 하지 마!? 약속이야!? 알았지!?」"
  },
  {
   "id": 18819,
   "key": "D0904al.txt:778",
   "ko": "「맡겨둬! 가자､ 알!」 「응!」"
  },
  {
   "id": 18820,
   "key": "D0904al.txt:792",
   "ko": "마기우스 윙을 펄럭이며 아컴시티 상공을 난다｡"
  },
  {
   "id": 18821,
   "key": "D0904al.txt:794",
   "ko": "활활 타오르는 거리｡ 봉화처럼 치솟는 검은 연기｡"
  },
  {
   "id": 18822,
   "key": "D0904al.txt:795",
   "ko": "유린의 한계를 다하는 파괴 로봇의 대군!"
  },
  {
   "id": 18823,
   "key": "D0904al.txt:796",
   "ko": "얕보기는……이 빚､ 만 배로 갚아주마!"
  },
  {
   "id": 18824,
   "key": "D0904al.txt:799",
   "ko": "「증오의 하늘에서 내려와! 올바른 분노를 가슴에､ 우리는 마를 베는 검을 든다!」"
  },
  {
   "id": 18825,
   "key": "D0904al.txt:807",
   "ko": "「그대､ 무구한 칼날――데몬베인!」"
  },
  {
   "id": 18826,
   "key": "D0904al.txt:825",
   "ko": "「이놈들……! 대체 어디서!」"
  },
  {
   "id": 18827,
   "key": "D0904al.txt:830",
   "ko": "말하자마자 창밖 풍경이 흐물 일그러졌다｡"
  },
  {
   "id": 18828,
   "key": "D0904al.txt:834",
   "ko": "일그러진 공간에 균열이 생기고､ 그 안에서 파괴 로봇이 나타난다｡"
  },
  {
   "id": 18829,
   "key": "D0904al.txt:839",
   "ko": "「공간 전이!」"
  },
  {
   "id": 18830,
   "key": "D0904al.txt:844",
   "ko": "「윽……」"
  },
  {
   "id": 18831,
   "key": "D0904al.txt:846",
   "ko": "파괴 로봇이 사무소 쪽을 돌아봤다｡"
  },
  {
   "id": 18832,
   "key": "D0904al.txt:847",
   "ko": "이건―― 위험하다고 생각한 순간이었다｡"
  },
  {
   "id": 18834,
   "key": "D0904al.txt:850",
   "ko": "파괴 로봇이 사무소를 짓뭉개듯 팔을 내리친다!"
  },
  {
   "id": 18835,
   "key": "D0904al.txt:855",
   "ko": "「꺄아아아아아아아악!」"
  },
  {
   "id": 18836,
   "key": "D0904al.txt:860",
   "ko": "「진심이냐! 큭……위험해 공주님!」"
  },
  {
   "id": 18837,
   "key": "D0904al.txt:874",
   "ko": "「큭……! 성가시군요……!」"
  },
  {
   "id": 18838,
   "key": "D0904al.txt:884",
   "ko": "파괴 로봇이 날뛰는 파괴의 한복판을 윈필드가 모는 리무진이 질주한다｡"
  },
  {
   "id": 18839,
   "key": "D0904al.txt:886",
   "ko": "쏟아지는 잔해를 능숙한 핸들링으로 피하고､ 파괴 로봇의 가랑이 밑을 빠져나가､ 정면에서 밀려오는 불길을 드리프트로 피한다｡"
  },
  {
   "id": 18840,
   "key": "D0904al.txt:888",
   "ko": "타이어가 새된 비명을 지르며 삐걱였다｡"
  },
  {
   "id": 18841,
   "key": "D0904al.txt:890",
   "ko": "한눈팔지 않고 윈필드는 쿠로의 사무소로 향한다｡"
  },
  {
   "id": 18842,
   "key": "D0904al.txt:891",
   "ko": "눈치껏 자리를 비켜준 것이 이런 식으로 역효과가 날 줄이야｡"
  },
  {
   "id": 18843,
   "key": "D0904al.txt:893",
   "ko": "그래도 명색이 저 다이쥬지 쿠로의 곁에 있는 것이다｡"
  }
 ]
}