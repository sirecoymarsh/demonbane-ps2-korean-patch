  {
   "id": 47689,
   "key": "D1516.txt:274",
   "ko": "그 심장을 단숨에 꿰뚫는다｡"
  },
  {
   "id": 47690,
   "key": "D1516.txt:278",
   "ko": "「……쿠로?」"
  },
  {
   "id": 47691,
   "key": "D1516.txt:282",
   "ko": "「미안하군……나이아 씨｡ 나､ 당신 싫어하진 않았는데」"
  },
  {
   "id": 47693,
   "key": "D1516.txt:285",
   "ko": "입꼬리를 끌어올리며､ 웃는다｡"
  },
  {
   "id": 47699,
   "key": "D1516.txt:286",
   "ko": "절망의 벼랑 끝에서도､"
  },
  {
   "id": 47701,
   "key": "D1516.txt:287",
   "ko": "내 영혼은 여전히 투지를 잃지 않았다｡"
  },
  {
   "id": 47703,
   "key": "D1516.txt:288",
   "ko": "절망을 이해하면서도､"
  },
  {
   "id": 47706,
   "key": "D1516.txt:289",
   "ko": "절망에 굴복할 이유를 찾을 수 없었다｡"
  },
  {
   "id": 47709,
   "key": "D1516.txt:297",
   "ko": "「쿠로――!」"
  },
  {
   "id": 47710,
   "key": "D1516.txt:307",
   "ko": "저 녀석의 존재가､ 가슴 깊은 곳에서 늘 타오르고 있다면――"
  },
  {
   "id": 47711,
   "key": "D1516.txt:312",
   "ko": "「역시 마지막엔 『정의』가 이겨야､ 관객들이 납득할 거라고 보는데?」"
  },
  {
   "id": 47713,
   "key": "D1516.txt:315",
   "ko": "「각본 리테이크를 요구하겠어! 삼류 감독!」"
  },
  {
   "id": 47715,
   "key": "D1516.txt:324",
   "ko": "패배 따위 있을 리가 없다!"
  },
  {
   "id": 47716,
   "key": "D1516.txt:326",
   "ko": "온몸을､ 마도서로 짜인"
  },
  {
   "id": 47722,
   "key": "D1516.txt:327",
   "ko": "검은 보디슈트가 뒤덮어 간다｡"
  },
  {
   "id": 47724,
   "key": "D1516.txt:328",
   "ko": "마기우스 스타일이 된 나는､ 전력의 마술을 바르자이의 언월도를 통해 나이아의 몸속에 쏟아붓는다｡"
  },
  {
   "id": 47725,
   "key": "D1516.txt:330",
   "ko": "내 위에서 나이아의 몸이 불타오르기 시작했다｡"
  },
  {
   "id": 47730,
   "key": "D1516.txt:335",
   "ko": "「다이쥬지 쿠로――읏읏읏읏!」"
  },
  {
   "id": 47731,
   "key": "D1516.txt:339",
   "ko": "「인간을 얕보면 안 되지! 알겠냐? 신 님 아아아아아!」"
  },
  {
   "id": 47732,
   "key": "D1516.txt:355",
   "ko": "반대쪽 손에 든 『크투가』를 나이아의 턱에 들이대고､ 방아쇠를 당긴다｡"
  },
  {
   "id": 47734,
   "key": "D1516.txt:356",
   "ko": "총성이 허무의 거리에 울려 퍼졌다｡"
  },
  {
   "id": 47736,
   "key": "D1516.txt:376",
   "ko": "그와 함께 절망의 세계는､"
  },
  {
   "id": 47737,
   "key": "D1516.txt:377",
   "ko": "거울처럼 금이 가 산산이 부서진다｡"
  },
  {
   "id": 47738,
   "key": "D1516le.txt:8",
   "ko": "「무엇이냐……이 힘은……?」"
  },
  {
   "id": 47739,
   "key": "D1516le.txt:12",
   "ko": "「쿠로 군!? 왜 그래! 정신 차려!」"
  },
  {
   "id": 47740,
   "key": "D1516le.txt:19",
   "ko": "결정체의 빛을 받으며､ 악몽에서 깨어난다｡"
  },
  {
   "id": 47741,
   "key": "D1516le.txt:20",
   "ko": "하지만､ 눈을 떠도 의식은､ 아직 몽롱한 혼돈에 사로잡혀 있다｡"
  },
  {
   "id": 47743,
   "key": "D1516le.txt:21",
   "ko": "그러니､ 앞으로 일어날 일도――모든 것은 꿈속의 일 같은 것이다｡"
  },
  {
   "id": 47744,
   "key": "D1516le.txt:23",
   "ko": "그래｡ 세계를 침식하는､ 빛도 어둠도｡"
  },
  {
   "id": 47745,
   "key": "D1516le.txt:30",
   "ko": "지구의 푸름을 탐하며――"
  },
  {
   "id": 47747,
   "key": "D1516le.txt:55",
   "ko": "어둠이 모인다｡"
  },
