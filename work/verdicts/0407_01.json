  {
   "id": 4916,
   "key": "D0407.txt:389",
   "ko": "「무슨 이런 성가신……!」"
  },
  {
   "id": 4918,
   "key": "D0407.txt:400",
   "ko": "「온다! 의식을 집중하거라!」"
  },
  {
   "id": 4919,
   "key": "D0407.txt:411",
   "ko": "="
  },
  {
   "id": 4920,
   "key": "D0407.txt:425",
   "ko": "토끼가 뻐드렁니를 내밀고 달려든다｡"
  },
  {
   "id": 4921,
   "key": "D0407.txt:436",
   "ko": "="
  },
  {
   "id": 4922,
   "key": "D0407.txt:442",
   "ko": "="
  },
  {
   "id": 4923,
   "key": "D0407.txt:461",
   "ko": "라이카 씨네를 감싸며 앞으로 뛰쳐나간다｡ 달려드는 토끼를 마기우스 윙으로 때려 떨어뜨렸다｡"
  },
  {
   "id": 4924,
   "key": "D0407.txt:463",
   "ko": "="
  },
  {
   "id": 4925,
   "key": "D0407.txt:507",
   "ko": "하지만 곧바로 일어나 깡충깡충 맹렬한 속도로 내 주위를 뛰어다닌다｡"
  },
  {
   "id": 4926,
   "key": "D0407.txt:513",
   "ko": "「에잇! 성가시다고!」"
  },
  {
   "id": 4927,
   "key": "D0407.txt:522",
   "ko": "자킹｡ 토끼의 앞니가 놀랄 만큼 자랐다｡"
  },
  {
   "id": 4928,
   "key": "D0407.txt:540",
   "ko": "크게 도약해 앞니를 칼처럼 휘두르며 다가온다｡"
  },
  {
   "id": 4929,
   "key": "D0407.txt:541",
   "ko": "노리는 건 아무래도 내 목인 것 같다｡"
  },
  {
   "id": 4930,
   "key": "D0407.txt:553",
   "ko": "「장난하지 마､ 설치류!」 「게에에에――엣!」"
  },
  {
   "id": 4931,
   "key": "D0407.txt:587",
   "ko": "내리꽂히는 앞니에 카운터를 꽂아 넣는다｡"
  },
  {
   "id": 4932,
   "key": "D0407.txt:588",
   "ko": "섬뜩한 비명을 지르며 날아가는 토끼｡"
  },
  {
   "id": 4933,
   "key": "D0407.txt:594",
   "ko": "나사와 톱니바퀴를 흩뿌리며 교회 바닥을 몇 번이고 튕긴다｡ 그대로 불을 뿜으며 움직이지 않게 됐다｡"
  },
  {
   "id": 4934,
   "key": "D0407.txt:604",
   "ko": "「한 가지 충고하고 싶구나!」"
  },
  {
   "id": 4935,
   "key": "D0407.txt:609",
   "ko": "="
  },
  {
   "id": 4936,
   "key": "D0407.txt:615",
   "ko": "「토끼는 설치목이 아니라 중치목이다!」"
  },
  {
   "id": 4937,
   "key": "D0407.txt:621",
   "ko": "「세세하네!?」"
  },
  {
   "id": 4938,
   "key": "D0407.txt:632",
   "ko": "「쿠로 군!」"
  },
  {
   "id": 4939,
   "key": "D0407.txt:662",
   "ko": "="
  },
  {
   "id": 4940,
   "key": "D0407.txt:663",
   "ko": "="
  },
  {
   "id": 4941,
   "key": "D0407.txt:678",
   "ko": "달걀인간의 몸에 칼날이 박혔다｡"
  },
  {
   "id": 4942,
   "key": "D0407.txt:679",
   "ko": "흩뿌려지는 껍질과 흰자와 노른자｡ 질척하게 으깨져 그대로 움직이지 않게 됐다｡"
  },
  {
   "id": 4943,
   "key": "D0407.txt:691",
   "ko": "하지만 고양이 쪽은 날렵하게 검은 날개를 피하고 공중제비를 돌며 착지한다｡"
  },
  {
   "id": 4944,
   "key": "D0407.txt:694",
   "ko": "……히죽히죽 웃는 게 몹시 거슬린다｡"
  },
  {
   "id": 4945,
   "key": "D0407.txt:700",
   "ko": "「……앨리슨의 상상에서 태어난 거라면 왜 이렇게 섬뜩하고 공격적인 괴물뿐인 거지? 앨리슨의 마음이 비뚤어졌다는 건가……?」 「오히려 거울 쪽이 비틀고 있는 게지…… 아니､ 그뿐일까?」"
  },
  {
   "id": 4946,
   "key": "D0407.txt:734",
   "ko": "="
  },
