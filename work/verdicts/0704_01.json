{
 "packet": "0704_01",
 "items": [
  {
   "id": 8553,
   "key": "D0704+.txt:353",
   "ko": "「지､ 집사――! 다､ 당신까지――!」"
  },
  {
   "id": 8554,
   "key": "D0704+.txt:363",
   "ko": "「원한은 없사오나――이 살점 한 조각､ 피 한 방울까지 모두 하도에 바친 몸｡ 다이쥬지 님､ 각오하시지요」"
  },
  {
   "id": 8555,
   "key": "D0704+.txt:369",
   "ko": "「자､ 자유를! 아니면 죽음을! 갸아아아아아아아!」 도주 실패｡"
  },
  {
   "id": 8556,
   "key": "D0704+.txt:377",
   "ko": "그리고 절망｡ 「쿠로 군도 참 미련하게 버티네｡ 뭐､ 그렇게 무서워하지 말고」"
  },
  {
   "id": 8557,
   "key": "D0704+.txt:386",
   "ko": "「내가 쿠로 군을 완벽한 미인으로 다시 태어나게 해줄 테니까」"
  },
  {
   "id": 8558,
   "key": "D0704+.txt:391",
   "ko": "「방금 그 대사 어디에 안심할 구석이 있냐고!? 그리고 어째서 아무도 나를 이 궁지에서 구해주려 하지 않는 거야!?」 대답 예 1｡"
  },
  {
   "id": 8559,
   "key": "D0704+.txt:413",
   "ko": "「엣? 그치만……재밌어 보이는걸?」 「두근두근」"
  },
  {
   "id": 8560,
   "key": "D0704+.txt:429",
   "ko": "대답 예 2｡ 「어째서 이 몸이 숙적인 네놈을 도와줘야 한단 말이냐?」"
  },
  {
   "id": 8561,
   "key": "D0704+.txt:445",
   "ko": "「엘자는 달링이 여장 남자라도 전혀 신경 안 쓰는로봇」"
  },
  {
   "id": 8562,
   "key": "D0704+.txt:455",
   "ko": "대답 예 3｡ 「좋을 대로 살거라」"
  },
  {
   "id": 8563,
   "key": "D0704+.txt:477",
   "ko": "「인간도 아닌 놈들아아아아아아아!」"
  },
  {
   "id": 8564,
   "key": "D0704+.txt:483",
   "ko": "「이제 와서 무슨 소리냐」"
  },
  {
   "id": 8565,
   "key": "D0704+.txt:488",
   "ko": "「윈 님､ 놓지 말아 주세요｡ 자､ 너희들도 쿠로 군 단단히 붙잡아」 「알겠습니다」"
  },
  {
   "id": 8566,
   "key": "D0704+.txt:498",
   "ko": "「네네! 쿠로 씨 겟~｡ 실례하겠습니다~!」"
  },
  {
   "id": 8567,
   "key": "D0704+.txt:503",
   "ko": "「――남자 몸은 딱딱하고 작지도 않고……재미없어요」 「――하지만 일이니까｡ 일이니까요」"
  },
  {
   "id": 8568,
   "key": "D0704+.txt:513",
   "ko": "「우갸아아아아! 당신들､ 왜 그렇게 신이 나 있는 건데!?」"
  },
  {
   "id": 8569,
   "key": "D0704+.txt:518",
   "ko": "「바､ 바보야! 올라타지 말라고……앗､ 좀 말랑……」"
  },
  {
   "id": 8570,
   "key": "D0704+.txt:530",
   "ko": "「……라기보다 아프다고오오오――――! 지､ 집사아아! 아파! 아프다니까! 장난 아니라고!」"
  },
  {
   "id": 8571,
   "key": "D0704+.txt:543",
   "ko": "「그만……그만해……우기이이이이!?」"
  },
  {
   "id": 8572,
   "key": "D0704+.txt:549",
   "ko": "「가만있어 가만있어! 우무무! 쿠로 군､ 화장 참 잘 먹네……좀 질투 나는걸」"
  },
  {
   "id": 8573,
   "key": "D0704+.txt:555",
   "ko": "「우와아아아아아! 안 돼에에에에에!」 「비참하구나」"
  },
  {
   "id": 8574,
   "key": "D0704+.txt:566",
   "ko": "(오싹오싹오싹……!)"
  },
  {
   "id": 8575,
   "key": "D0704+.txt:579",
   "ko": "――한 시간쯤 뒤｡ 「이걸로 완성~…………이라기보다 잠깐」"
  },
  {
   "id": 8576,
   "key": "D0704+.txt:595",
   "ko": "(((멍~))) 「……이､ 이건」"
  },
  {
   "id": 8577,
   "key": "D0704+.txt:605",
   "ko": "(눈을 껌뻑껌뻑)"
  },
  {
   "id": 8578,
   "key": "D0704+.txt:610",
   "ko": "「「………………」」"
  },
  {
   "id": 8579,
   "key": "D0704+.txt:615",
   "ko": "「…………하웃」(휘청) 「아앗! 닥터!?」"
  },
  {
   "id": 8580,
   "key": "D0704+.txt:637",
   "ko": "(부들부들부들부들……!) 「……자､ 장난이 아니로구나」"
  },
  {
   "id": 8581,
   "key": "D0704+.txt:648",
   "ko": "「흑흑흑……훌쩍훌쩍훌쩍훌쩍……」 (((와､ 완벽해……!)))"
  },
  {
   "id": 8582,
   "key": "D0704+.txt:694",
   "ko": "「이야아아아아아아아아아아아아앙! 조오오오오오오오오오오오아아아아아아아아!」"
  },
  {
   "id": 8583,
   "key": "D0704+.txt:700",
   "ko": "「우와아아앗!? 노､ 놀라게 하지 마라!」"
  },
  {
   "id": 8584,
   "key": "D0704+.txt:707",
   "ko": "「머､ 멋져! 멋져 멋져 너무 멋져! 와~이! 와아아아이! 우와아아아아아아아아이!」"
  },
  {
   "id": 8585,
   "key": "D0704+.txt:717",
   "ko": "「이､ 이､ 이런 일이! 쿠로 군! 쿠로 군 쿠로 군 쿠로 군 쿠로 군 좀!」"
  },
  {
   "id": 8586,
   "key": "D0704+.txt:721",
   "ko": "「어디까지 나를……이 나를! 행복의､ 행복의 절정으로오오! ――몰아넣어야 직성이 풀리는 거야!」"
  },
  {
   "id": 8587,
   "key": "D0704+.txt:727",
   "ko": "「풀리는 거냐고 안 풀리는 거냐고!? 아아아아아아아아! 안 돼! 안 돼 안 돼 안 돼 안 돼! 안 된다면 안 돼!」"
  },
  {
   "id": 8589,
   "key": "D0704+.txt:734",
   "ko": "「죽어버려어어어! 라이카는 죽어버리고 말 거예요오오오오! 하느님――――――――!」"
  },
  {
   "id": 8590,
   "key": "D0704+.txt:745",
   "ko": "「우와아아앗!? 라이카 누나가 망가졌어~!」 「히끅……」"
  },
  {
   "id": 8591,
   "key": "D0704+.txt:752",
   "ko": "(무서워서 울음이 터질 것 같다)"
  },
  {
   "id": 8592,
   "key": "D0704+.txt:757",
   "ko": "「우와아아､ 쿠로 오빠 예뻐……」(아이다운､ 악의 없이 순진해서 더 잔혹한 감상)"
  },
  {
   "id": 8593,
   "key": "D0704+.txt:768",
   "ko": "「에에에에에잇! 나 내버려두고 신나 하지 마､ 거기!」"
  }
 ]
