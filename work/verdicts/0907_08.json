  {
   "id": 19661,
   "key": "D0907le.txt:1530",
   "ko": "「그랜드 마스터님!? 그랜드 마스터님……읏!」 신의 살은 『몽환심모』의 일체와 얽히고､ 이어지고､ 맺어지고､ 녹아들어､ 형성되어 간다｡"
  },
  {
   "id": 19662,
   "key": "D0907le.txt:1544",
   "ko": "신의 피､ 신의 내장､ 신의 뼈､ 신의 사지､ 신의 몸､ 신의 눈､ 신의 얼굴｡ 더욱 비대해지고､ 팽창한다｡"
  },
  {
   "id": 19663,
   "key": "D0907le.txt:1559",
   "ko": "「『나､ 매장할 수 없노라』!」 「큿……끝이 없로봇! 박사!」"
  },
  {
   "id": 19664,
   "key": "D0907le.txt:1574",
   "ko": "「우푸……우게에에에에에에에에엑!」"
  },
  {
   "id": 19665,
   "key": "D0907le.txt:1579",
   "ko": "「우왓! 더럽로봇! 이런 때에 왜 그러로봇､ 박사!?」"
  },
  {
   "id": 19666,
   "key": "D0907le.txt:1584",
   "ko": "「우풉…… 괘､ 괜찮은 것이다…… 그저 사기에 당했을 뿐인 것이다」"
  },
  {
   "id": 19667,
   "key": "D0907le.txt:1591",
   "ko": "「하지만……이런 것이……이런 끔찍한 것이 『C계획』의 정체란 말인가……읏!」"
  },
  {
   "id": 19668,
   "key": "D0907le.txt:1604",
   "ko": "그렇다､ 그러하다｡"
  },
  {
   "id": 19669,
   "key": "D0907le.txt:1606",
   "ko": "이형의 신｡"
  },
  {
   "id": 19670,
   "key": "D0907le.txt:1607",
   "ko": "잠든 신｡"
  },
  {
   "id": 19671,
   "key": "D0907le.txt:1608",
   "ko": "저주받은 신｡"
  },
  {
   "id": 19672,
   "key": "D0907le.txt:1610",
   "ko": "위대한 『C』!"
  },
  {
   "id": 19673,
   "key": "D0907le.txt:1611",
   "ko": "위대한 크툴루! 아컴시티의 상공에 출현한 그것은 비늘로 뒤덮이고､ 무수한 촉수를 뻗치고 있었다｡"
  },
