  {
   "id": 19152,
   "key": "D0906al.txt:80",
   "ko": "이치가 아니다｡"
  },
  {
   "id": 19160,
   "key": "D0906al.txt:81",
   "ko": "비논리적이고 부조리한 감정이다｡"
