   "ko": "="
  },
  {
   "id": 37097,
   "key": "D1404le.txt:157",
   "ko": "「그것들은 특별제다」"
  },
  {
   "id": 37098,
   "key": "D1404le.txt:160",
   "ko": "="
  },
  {
