  {
   "id": 18143,
   "key": "D0902al.txt:200",
   "ko": "우리의 구세주｡"
  },
  {
   "id": 18144,
   "key": "D0902al.txt:201",
   "ko": "우리의 구세주｡"
  },
  {
   "id": 18145,
   "key": "D0902al.txt:203",
   "ko": "마스터 테리온!"
  },
  {
   "id": 18147,
   "key": "D0902al.txt:204",
   "ko": "마스터 테리온! 마스터 테리온!"
  },
  {
   "id": 18148,
   "key": "D0902al.txt:215",
   "ko": "――옥좌의 소년은 여느 때와 같은 나른한 눈으로､ 눈 아래 펼쳐지는 광연을 내려다보고 있었다｡"
  },
  {
   "id": 18149,
   "key": "D0902al.txt:217",
   "ko": "연회의 열광에 비해 소년의 마음은 싸늘하게 식어 있다｡"
  },
  {
   "id": 18150,
   "key": "D0902al.txt:219",
   "ko": "이윽고 보는 것조차 귀찮아졌는지､ 자신의 긴 금발을 손에 쥐고 갈라진 머리카락을 찾는 데 몰두했다｡"
  },
  {
   "id": 18151,
   "key": "D0902al.txt:223",
   "ko": "「마스터」 검은 머리 소녀가 주인을 올려다본다｡"
  },
  {
   "id": 18152,
   "key": "D0902al.txt:230",
   "ko": "하지만 소년은 소녀를 보지 않는다｡"
  },
  {
   "id": 18153,
   "key": "D0902al.txt:233",
   "ko": "여전히 소년의 의식은 자신의 머리카락에 쏠린 채다｡"
  },
  {
   "id": 18154,
   "key": "D0902al.txt:236",
   "ko": "아니｡ 금색 눈동자는 그것조차 담고 있지 않다｡"
  },
  {
   "id": 18155,
   "key": "D0902al.txt:241",
   "ko": "깊고 깊은 금색｡ 그런데도 거기에 빛은 결코 없고｡"
  },
  {
   "id": 18156,
   "key": "D0902al.txt:244",
   "ko": "있는 것은 응어리진 어둠｡"
  },
  {
   "id": 18159,
   "key": "D0902al.txt:245",
   "ko": "진흙 같은 어둠｡"
  },
  {
   "id": 18160,
   "key": "D0902al.txt:246",
   "ko": "그리고 그 진창의 밑바닥에 가라앉은 증오｡"
  },
  {
   "id": 18162,
   "key": "D0902al.txt:249",
   "ko": "세계를 향한 증오｡ 어둡고 어둡게 타오르고 있다｡"
  },
  {
   "id": 18164,
   "key": "D0902al.txt:253",
   "ko": "남몰래､ 은밀하게｡ 「――――」"
  },
  {
   "id": 18166,
   "key": "D0902al.txt:265",
   "ko": "소녀는 조용히 눈을 감는다｡"
  },
  {
   "id": 18168,
   "key": "D0902al.txt:268",
   "ko": "소녀는 소년의 증오가 얼마나 뜨거운지 알고 있다｡"
  },
  {
   "id": 18169,
   "key": "D0902al.txt:269",
   "ko": "소년의 절망이 얼마나 깊은지 알고 있다｡"
  },
  {
   "id": 18170,
   "key": "D0902al.txt:272",
   "ko": "하지만 그것을 치유할 방법은 소녀에게 없다｡"
  },
  {
   "id": 18171,
   "key": "D0902al.txt:275",
   "ko": "아니｡ 그런 것은 애초에 이 우주에 존재하지 않는다｡"
  },
  {
   "id": 18172,
   "key": "D0902al.txt:276",
   "ko": "삼라만상 모든 것은 평등하게 무가치하며 무의미하다｡"
  },
  {
   "id": 18173,
   "key": "D0902al.txt:279",
   "ko": "물론――나 또한 그렇다｡"
  },
  {
   "id": 18174,
   "key": "D0902al.txt:282",
   "ko": "소녀의 가슴에 둔한 아픔이 스친다｡ 「…마스터」"
  },
  {
   "id": 18175,
   "key": "D0902al.txt:294",
   "ko": "그래도 자신의 존재 의의는 이 소년 안에밖에 없다｡ 일말의 의문도 갖지 않고､ 그저 소년을 위해 계속 존재한다｡"
  },
  {
   "id": 18176,
   "key": "D0902al.txt:297",
   "ko": "그것은 아득히 먼 날의 맹세다｡"
  },
  {
   "id": 18179,
   "key": "D0902al.txt:298",
   "ko": "시간의 기억에서조차 사라진 날의 맹세다｡"
  },
  {
   "id": 18180,
   "key": "D0902al.txt:301",
   "ko": "이제 그 눈동자는 소년의 모습밖에 비추지 않는다｡"
  },
  {
   "id": 18181,
   "key": "D0902al.txt:302",
   "ko": "그 귀에는 소년의 목소리밖에 닿지 않는다｡"
  },
  {
   "id": 18182,
   "key": "D0902al.txt:305",
   "ko": "그 살도 영혼도 한 조각 남김없이 소년에게 바치고､ 그래도 부족하다면 이 무가치한 우주 전부를 그나마의 심심풀이 위안으로 공물 삼으리라｡"
  },
  {
   "id": 18183,
   "key": "D0902al.txt:307",
   "ko": "아아､ 그것은 얼마나 저주스럽고도 순수한 광기의 사랑인가｡"
  },
  {
   "id": 18184,
   "key": "D0902al.txt:312",
   "ko": "「…아」"
  },
  {
   "id": 18185,
   "key": "D0902al.txt:317",
   "ko": "소년의 손바닥이 소녀의 머리카락을 쓰다듬었다｡"
  },
  {
   "id": 18188,
   "key": "D0902al.txt:319",
   "ko": "그저､ 그것뿐｡"
  }
 ]
}