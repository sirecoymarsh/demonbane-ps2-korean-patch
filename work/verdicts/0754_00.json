{
 "packet": "0754_00",
 "items": [
  {
   "id": 11524,
   "key": "D0754.txt:26",
   "ko": "이그나이이…… 이그나이이……"
  },
  {
   "id": 11525,
   "key": "D0754.txt:27",
   "ko": "에에에…… 야 야 야……"
  },
  {
   "id": 11526,
   "key": "D0754.txt:28",
   "ko": "야하아하아……"
  },
  {
   "id": 11527,
   "key": "D0754.txt:35",
   "ko": "시｡"
  },
  {
   "id": 11528,
   "key": "D0754.txt:50",
   "ko": "……위대한 사자여――"
  },
  {
   "id": 11529,
   "key": "D0754.txt:51",
   "ko": "일곱 태양의 세계에서 지구의 거처로―― 응가이 숲으로―― 오시라――"
  },
  {
   "id": 11530,
   "key": "D0754.txt:57",
   "ko": "플루트｡"
  },
  {
   "id": 11531,
   "key": "D0754.txt:71",
   "ko": "――숲의 검은 염소―― 천 마리 새끼를 밴―― 흉몽…… 흘러넘치리――"
  },
  {
   "id": 11532,
   "key": "D0754.txt:77",
   "ko": "사람 아닌 것들의 교성｡"
  },
  {
   "id": 11533,
   "key": "D0754.txt:92",
   "ko": "이아! 이아! 슈브 니구라스!"
  },
  {
   "id": 11534,
   "key": "D0754.txt:97",
   "ko": "날갯짓｡ 홍소｡ 영창｡ 합창｡"
  },
  {
   "id": 11535,
   "key": "D0754.txt:114",
   "ko": "정신을 차려 보니 나는 울창하고 어둡디어두운 숲속에 있었다｡"
  },
  {
   "id": 11536,
   "key": "D0754.txt:116",
   "ko": "숲 안쪽에서 짐승 같은 악마적인 음악이 흘러나온다｡"
  },
  {
   "id": 11537,
   "key": "D0754.txt:117",
   "ko": "그 꺼림칙한 음색에 맞춰､ 탁한 어둠이 꿈틀거리며 춤추고 있었다｡"
  },
  {
   "id": 11538,
   "key": "D0754.txt:120",
   "ko": "이그나이이｡"
  },
  {
   "id": 11539,
   "key": "D0754.txt:121",
   "ko": "이그나이이｡"
  },
  {
   "id": 11540,
   "key": "D0754.txt:136",
   "ko": "「끄으윽!」"
  },
  {
   "id": 11541,
   "key": "D0754.txt:140",
   "ko": "이윽고 숲 전체가 마치 살아 있는 것처럼 맥동하기 시작했다｡"
  },
  {
   "id": 11542,
   "key": "D0754.txt:142",
   "ko": "나무들의 술렁임에 뒤섞인 기이한 음악､ 쏙독새 울음소리､ 포효､ 고동｡ 소리의 홍수가 귀를 먹먹하게 한다｡"
  },
  {
   "id": 11543,
   "key": "D0754.txt:145",
   "ko": "나도 모르게 웅크렸다｡"
  },
  {
   "id": 11544,
   "key": "D0754.txt:156",
   "ko": "대지가 진동하고 있다｡"
  },
  {
   "id": 11545,
   "key": "D0754.txt:157",
   "ko": "숲의 맥동이 일대를 뒤흔들고 있는 것이다｡"
  },
  {
   "id": 11546,
   "key": "D0754.txt:160",
   "ko": "숲이 하나의 그림자 그림이 되어 꿈틀거린다｡"
  },
  {
   "id": 11547,
   "key": "D0754.txt:161",
   "ko": "그것은 외우주의 존재가 현실에 드리운 그림자｡"
  },
  {
   "id": 11548,
   "key": "D0754.txt:164",
   "ko": "부정형의 거대한 무언가가 비웃으며 떨고 있다｡"
  },
  {
   "id": 11549,
   "key": "D0754.txt:175",
   "ko": "그림자가 일어섰다｡"
  },
  {
   "id": 11550,
   "key": "D0754.txt:195",
   "ko": "그것은 무한히 늘어나는 촉수와 갈고리 발톱을 휘두르며 포효하는 얼굴 없는 괴물이었고､ 또한 불타는 세 개의 눈을 지닌 암흑이었으며､ 금빛 덩굴손을 뻗은 찬란한 거목이었다｡"
  },
  {
   "id": 11551,
   "key": "D0754.txt:198",
   "ko": "외우주의 그림자가 울부짖는다｡"
  },
  {
   "id": 11552,
   "key": "D0754.txt:199",
   "ko": "시공의 끝､ 세계의 중심에 닿으라는 듯 하늘을 우러러､ 단말마 같은 첫 울음을 터뜨린다｡"
  },
  {
   "id": 11553,
   "key": "D0754.txt:201",
   "ko": "그 소리에 내 영혼은 산산이 부서질 것만 같았다｡"
  },
  {
   "id": 11554,
   "key": "D0754.txt:223",
   "ko": "『프흥글루이 무글루우나프 크투가 포말하우트 응가아 구아 나프루타근 이아 크투가』"
  },
  {
   "id": 11555,
   "key": "D0754.txt:239",
   "ko": "「――――?」"
  },
  {
   "id": 11556,
   "key": "D0754.txt:243",
   "ko": "메아리치는 포효를 지우며､ 마음속에 울리는 주문｡"
  },
  {
   "id": 11557,
   "key": "D0754.txt:244",
   "ko": "구지배자 크투가에게 바치는 탄원｡"
  },
  {
   "id": 11558,
   "key": "D0754.txt:250",
   "ko": "「혼돈에 맞설 몇 안 되는 수단――」"
  },
  {
   "id": 11559,
   "key": "D0754.txt:256",
   "ko": "『프흥글루이 무글루우나프 크투가 포말하우트 응가아 구아 나프루타근 이아 크투가』"
  },
  {
   "id": 11560,
   "key": "D0754.txt:281",
   "ko": "하늘이 불탔다｡"
  },
  {
   "id": 11561,
   "key": "D0754.txt:282",
   "ko": "세계는 황혼｡"
  },
  {
   "id": 11562,
   "key": "D0754.txt:283",
   "ko": "붉게 타는 태양보다도 눈부시게 빛나는 별이 있다｡"
  },
  {
   "id": 11563,
   "key": "D0754.txt:286",
   "ko": "――포말하우트 별｡"
  }
 ]
}