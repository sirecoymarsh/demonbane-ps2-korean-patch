   "ko": "="
  },
  {
   "id": 9242,
   "key": "D0710al.txt:338",
   "ko": "="
  },
  {
   "id": 9243,
   "key": "D0710al.txt:343",
   "ko": "="
  },
  {
   "id": 9244,
   "key": "D0710al.txt:349",
