 "items": [
  {
   "id": 8715,
   "key": "D0704.txt:633",
   "ko": "（덜덜덜덜 부들부들부들）"
  },
  {
   "id": 8716,
   "key": "D0704.txt:638",
   "ko": "「콤플렉스 덩어리로구나､ 그대는」"
  },
  {
   "id": 8717,
   "key": "D0704.txt:643",
   "ko": "「지금의 다이쥬지 씨……굉장히 빛나고 계세요｡ 멋져……발그레」"
  },
  {
   "id": 8718,
   "key": "D0704.txt:649",
   "ko": "「자――다음은?」"
  },
  {
   "id": 8719,
   "key": "D0704.txt:654",
   "ko": "공격의 창끝을 돌리려고 공주님이 주위를 둘러본다｡ 빠직……｡"
  },
  {
   "id": 8720,
   "key": "D0704.txt:657",
   "ko": "전원의 움직임이 일제히 얼어붙는다｡"
  },
  {
   "id": 8721,
   "key": "D0704.txt:660",
   "ko": "탁한 눈동자가 전원을 노려본다｡ 그 시선은――하필이면 꼬맹이들에게서 멈췄다｡"
  },
  {
   "id": 8722,
   "key": "D0704.txt:665",
   "ko": "「……읏!」"
  },
  {
   "id": 8723,
   "key": "D0704.txt:670",
   "ko": "「자아……너희들은 어떻게 저를 즐겁게 해줄 건가요?」"
  },
  {
   "id": 8724,
   "key": "D0704.txt:676",
   "ko": "「아우아우아우……」"
  },
  {
   "id": 8725,
   "key": "D0704.txt:681",
   "ko": "「그､ 그럼! 저번에 배운 율동을 다 같이……」"
  },
  {
   "id": 8726,
   "key": "D0704.txt:686",
   "ko": "「――저를 얕보지 마세요､ 소년」 「히이이이익!」"
  },
  {
   "id": 8727,
   "key": "D0704.txt:700",
   "ko": "「어린애니까 봐줄 거라고 생각했나요? 바보 같기는」 「어린애니까 지금부터 제대로 조……교육해야 한다고 생각하지 않니? 그럼요､ 그렇고말고요 그렇고말고요!」"
  },
  {
   "id": 8728,
   "key": "D0704.txt:707",
   "ko": "「어린애라고 도망칠 수 있을 것 같아요!? 그런 어리광은 사회에 나가면 안 통해요!?」"
  },
  {
   "id": 8729,
   "key": "D0704.txt:713",
   "ko": "「우와아아아아아앙!」"
  },
  {
   "id": 8730,
   "key": "D0704.txt:718",
   "ko": "「으､ 으､ 으에에에엥! 으에에에에엥!」"
  },
  {
   "id": 8731,
   "key": "D0704.txt:724",
   "ko": "（덜덜덜덜덜덜덜덜덜덜덜덜……）"
  },
  {
   "id": 8732,
   "key": "D0704.txt:730",
   "ko": "「아､ 아이들만은! 아이들만은 봐주세요오~!」"
  },
  {
   "id": 8733,
   "key": "D0704.txt:737",
   "ko": "「……세상 물정 모르는 온실 속 아가씨가 사회의 혹독함을 논하는 게냐」"
  },
  {
   "id": 8734,
   "key": "D0704.txt:744",
   "ko": "「아아……큰어르신께서 돌아가신 뒤로 통 웃지 않으시던 루리 아가씨가､ 저렇게나 즐거워 보이시다니……」"
  },
  {
   "id": 8735,
   "key": "D0704.txt:749",
   "ko": "「저는……이 윈필드는……감개무량하옵니다……흑」"
  },
  {
   "id": 8736,
   "key": "D0704.txt:754",
   "ko": "「눈시울 훔치면서 감동하지 좀 마!? 잘못됐다니까! 저 사람 절대 잘못됐어! 그러니까 인간적으로 인도적으로 인류애적으로!」"
  },
  {
   "id": 8737,
   "key": "D0704.txt:759",
   "ko": "「그……뭐랄까……뭐､ 인생 여러 가지죠……쿠로 군」 「――겁먹은 앨리슨 ……하아하아」"
  },
  {
   "id": 8738,
   "key": "D0704.txt:770",
   "ko": "「기다려 주세요! ……알겠어요｡ 제가 한 꺼풀 벗어 드리죠!」"
  },
  {
   "id": 8739,
   "key": "D0704.txt:783",
   "ko": "오옷｡ 라이카 씨､ 당신 재주 같은 걸 부릴 줄 알았나……라니!"
  },
  {
   "id": 8740,
   "key": "D0704.txt:796",
   "ko": "「갑자기 뭘 벗고 있는 거야아아아!?」 「보면 알잖아! 한 꺼풀 벗고 있는 거야!」"
  },
  {
   "id": 8741,
   "key": "D0704.txt:807",
   "ko": "「취한 거지!? 당신도 완전무결하게 취한 거지!?」"
  },
  {
   "id": 8742,
   "key": "D0704.txt:813",
   "ko": "「………………」（얼굴 빨개짐）"
  },
  {
   "id": 8743,
   "key": "D0704.txt:818",
   "ko": "「………………」（얼굴 빨개짐）"
  },
  {
   "id": 8744,
   "key": "D0704.txt:823",
   "ko": "「그､ 그만하라니까! 애들 교육에 나쁘잖아!」"
  },
  {
   "id": 8745,
   "key": "D0704.txt:829",
   "ko": "「예술을 위해서예요!」"
  },
  {
   "id": 8746,
   "key": "D0704.txt:834",
   "ko": "「우왓､ 자기 입으로 말하네 이 사람｡ 아아아아! 그러니까 그만――――!」"
  },
  {
   "id": 8747,
   "key": "D0704.txt:848",
   "ko": "「라고 할 줄 알았지｡ 아쉽게도 수영복이었습니다―」"
  },
  {
   "id": 8748,
   "key": "D0704.txt:854",
   "ko": "「…………이봐」 「에헤헤헤~ 기대했지? 기대해버렸지? 이것 봐라 이것 봐아!」"
  },
  {
   "id": 8749,
   "key": "D0704.txt:865",
   "ko": "……새삼 느끼지만 성격 진짜 나쁘다｡ 이 사람｡"
  },
  {
   "id": 8750,
   "key": "D0704.txt:872",
   "ko": "「……어찌 실망한 얼굴을 하고 있느냐」"
  },
  {
   "id": 8751,
   "key": "D0704.txt:878",
   "ko": "「아､ 안 했거든!」 「………………」"
  },
  {
   "id": 8752,
   "key": "D0704.txt:888",
   "ko": "「………………」 （뾰로통）"
  },
  {
   "id": 8753,
   "key": "D0704.txt:904",
   "ko": "「………………………………」"
  },
  {
   "id": 8754,
   "key": "D0704.txt:909",
   "ko": "「웃·기·지· 마아아아아――――!」"
  }
 ]
