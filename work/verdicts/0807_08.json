   "key": "D0807ru.txt:183",
   "ko": "="
  },
  {
   "id": 13884,
   "key": "D0807ru.txt:190",
   "ko": "「………………」"
  },
  {
   "id": 13885,
   "key": "D0807ru.txt:193",
   "ko": "="
  },
  {
   "id": 13886,
   "key": "D0807ru.txt:195",
