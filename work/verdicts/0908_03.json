{
 "packet": "0908_03",
 "items": [
  {
   "id": 19894,
   "key": "D0908al_ps2.txt:760",
   "ko": "「미사일이 사라지다니､ 그런 어처구니없는 일이……」"
  },
  {
   "id": 19895,
   "key": "D0908al_ps2.txt:767",
   "ko": "술렁이던 작전회의실이 조용해졌다｡ 짐승의 으르렁거림｡"
  },
  {
   "id": 19896,
   "key": "D0908al_ps2.txt:770",
   "ko": "아니｡ 짐승을 닮은､ 짐승이 아닌 무언가의 으르렁거림｡"
  },
  {
   "id": 19897,
   "key": "D0908al_ps2.txt:772",
   "ko": "전원이 천장 구석을 주시한다｡"
  },
  {
   "id": 19898,
   "key": "D0908al_ps2.txt:773",
   "ko": "그 『모서리』에､ 개를 닮은､ 개가 아닌 『무언가』의 머리가 돋아나 있었다｡"
  },
  {
   "id": 19899,
   "key": "D0908al_ps2.txt:775",
   "ko": "이내 전신이 돋아났다｡"
  },
  {
   "id": 19900,
   "key": "D0908al_ps2.txt:776",
   "ko": "천장에서 떨어져､ 바닥 위에 그 괴물이 내려선다｡ 굶주려 앙상한､ 부정한 몸이었다｡"
  },
  {
   "id": 19901,
   "key": "D0908al_ps2.txt:781",
   "ko": "우주의 사악을 응축한 괴물의 몸｡ 한 마리가 아니다｡ 회의실 안의 『모서리』란 『모서리』에서 이 괴물들은 출현했다｡"
  },
  {
   "id": 19903,
   "key": "D0908al_ps2.txt:787",
   "ko": "「히익!」 누군가가 흘린 작은 비명｡"
  },
  {
   "id": 19904,
   "key": "D0908al_ps2.txt:792",
   "ko": "그것을 신호로 부정한 짐승들이 일제히 덮쳐든다｡"
  },
  {
   "id": 19905,
   "key": "D0908al_ps2.txt:799",
   "ko": "「꺄아아아아아아아아아아아!」"
  },
  {
   "id": 19906,
   "key": "D0908al_ps2.txt:812",
   "ko": "「하하하하……」"
  },
  {
   "id": 19909,
   "key": "D0908al_ps2.txt:815",
   "ko": "유쾌하고､ 유쾌하고､ 견딜 수가 없다｡"
  },
  {
   "id": 19910,
   "key": "D0908al_ps2.txt:817",
   "ko": "유쾌함이 극에 달해､ 마스터 테리온은 마침내 크툴루의 머리 위에서 스텝을 밟으며 춤추기 시작했다｡"
  },
  {
   "id": 19911,
   "key": "D0908al_ps2.txt:822",
   "ko": "게다가 노래한다｡"
  },
  {
   "id": 19912,
   "key": "D0908al_ps2.txt:823",
   "ko": "밝고､ 경쾌하며､ 조금은 애절한 노래｡"
  },
  {
   "id": 19913,
   "key": "D0908al_ps2.txt:824",
   "ko": "아컴시티의 밤에 마스터 테리온의 노래가 녹아든다｡"
  },
  {
   "id": 19914,
   "key": "D0908al_ps2.txt:833",
   "ko": "「그대의 걸음이 그대의 발걸음이 수놓는 불타는 듯한 밤 하지만 나는 오래도록 잊혀져 슬픔에 잠기지」"
  },
  {
   "id": 19915,
   "key": "D0908al_ps2.txt:837",
   "ko": "「가로등 아래 서 있는 건 누구지?」"
  },
  {
   "id": 19916,
   "key": "D0908al_ps2.txt:851",
   "ko": "「구벳 구루부 부붓!」"
  },
  {
   "id": 19917,
   "key": "D0908al_ps2.txt:855",
   "ko": "「살려､ 살려줘! 꺄아아아! 싫어어어! 아파! 아파 엄마아!」"
  },
  {
   "id": 19918,
   "key": "D0908al_ps2.txt:861",
   "ko": "「나､ 난 아무것도! 아무것도 안 했다고!? 도､ 돈이라면 내지! 도､ 돈이라면! 그러니까…… 그러니까…… 구베갸바라붓!」"
  },
  {
   "id": 19919,
   "key": "D0908al_ps2.txt:865",
   "ko": "「대통령님! 어서! 어서 피하십시오! 가아아아아아!」"
  },
  {
   "id": 19920,
   "key": "D0908al_ps2.txt:873",
   "ko": "「크윽……!」 「아아､ 사랑스러운 릴리 마를렌 아아､ 사랑스러운 릴리 마를렌」"
  },
  {
   "id": 19921,
   "key": "D0908al_ps2.txt:912",
   "ko": "「……………………」 「아…… 아아……」"
  },
  {
   "id": 19922,
   "key": "D0908al_ps2.txt:920",
   "ko": "「그런……」"
  },
  {
   "id": 19923,
   "key": "D0908al_ps2.txt:924",
   "ko": "「아무리 그래도…… 농담이겠죠?」"
  },
  {
   "id": 19924,
   "key": "D0908al_ps2.txt:929",
   "ko": "「핵조차도､ 저자에게는 통하지 않는 건가요……」"
  },
  {
   "id": 19925,
   "key": "D0908al_ps2.txt:933",
   "ko": "루리는 그 자리에 주저앉았다｡"
  },
  {
   "id": 19926,
   "key": "D0908al_ps2.txt:934",
   "ko": "마스터 테리온에 대한 외경이 가슴속을 잠식한다｡"
  },
  {
   "id": 19927,
   "key": "D0908al_ps2.txt:935",
   "ko": "영혼을 좀먹는 공포는､ 절망과 체념으로 변모해 간다｡"
  },
  {
   "id": 19928,
   "key": "D0908al_ps2.txt:937",
   "ko": "영혼의 밑바닥､ 마지막 보루에､ 할아버지의 얼굴이 있었다｡"
  },
  {
   "id": 19929,
   "key": "D0908al_ps2.txt:942",
   "ko": "「할아버님…… 당신은 이토록 깊은 절망과 싸우고 계셨군요」"
  },
  {
   "id": 19930,
   "key": "D0908al_ps2.txt:946",
   "ko": "무너져 간다｡ 마지막 강함이 무너져 간다｡"
  },
  {
   "id": 19931,
   "key": "D0908al_ps2.txt:960",
   "ko": "「이 조용한 곳에서 이 지구 위에서 나는 꿈꾼다 그대의 사랑스러운 입술을」"
  },
  {
   "id": 19932,
   "key": "D0908al_ps2.txt:964",
   "ko": "「안개가 걷히고 저 가로등 아래 설 수 있는 건 언제?」"
  },
  {
   "id": 19933,
   "key": "D0908al_ps2.txt:979",
   "ko": "마지막 강함이 산산조각 난다｡"
  },
  {
   "id": 19934,
   "key": "D0908al_ps2.txt:980",
   "ko": "허나 모든 것이 무너진 그 너머에､ 진정 마지막의 마지막에 매달릴 것이 있다｡"
  },
  {
   "id": 19935,
   "key": "D0908al_ps2.txt:982",
   "ko": "매달리고 싶은 사람이 있다｡ 모든 감정을 폭발시켜､ 눈물을 흘리며 그의 이름을 외쳤다｡"
  },
  {
   "id": 19936,
   "key": "D0908al_ps2.txt:989",
   "ko": "「데몬베인…… 다이쥬지 씨…… 쿠로 씨이이이이잉!」"
  }
 ]
}