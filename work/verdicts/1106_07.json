  {
   "id": 24394,
   "key": "D1106ru.txt:93",
   "ko": "HPL의 『아웃사이더 및 그 외의 이야기』｡"
  },
  {
   "id": 24396,
   "key": "D1106ru.txt:98",
   "ko": "시집 『아자토스 그 외의 공포』 etc.etc."
  },
  {
   "id": 24397,
   "key": "D1106ru.txt:104",
   "ko": "할아버지의 서재에 몰래 들어가고､ 정보를 모아가며 훑어본 그것들｡"
  },
  {
   "id": 24398,
   "key": "D1106ru.txt:106",
   "ko": "결국은､ 잘 알 수 없었다｡"
  },
  {
   "id": 24400,
   "key": "D1106ru.txt:107",
   "ko": "그 책들이 어떤 진실로 이어져 있는지조차｡"
  },
  {
   "id": 24401,
   "key": "D1106ru.txt:109",
   "ko": "다만 이 책들의 이면에､ 전율할 만한 괴이의 존재를 엿볼 수는 있었다｡"
  },
  {
   "id": 24402,
   "key": "D1106ru.txt:111",
   "ko": "그리고 『블랙로지』가 그런 사악한 괴이의 가장 깊은 곳에 존재한다는 것도｡"
  },
  {
   "id": 24403,
   "key": "D1106ru.txt:113",
   "ko": "나는 싸우고 싶었다｡"
  },
  {
   "id": 24407,
   "key": "D1106ru.txt:114",
   "ko": "뚜렷한 형태로､ 악과 싸운다는 실감을 원했다｡"
  },
  {
   "id": 24408,
   "key": "D1106ru.txt:116",
   "ko": "지금 생각하면､ 다이쥬지 쿠로의 싸움을 본 지금이라면､ 그건 풋내 나는 환상에 지나지 않았지만｡"
  },
  {
   "id": 24409,
   "key": "D1106ru.txt:118",
   "ko": "그것은､ 즉――"
  },
  {
   "id": 24410,
   "key": "D1106ru.txt:122",
   "ko": "「역시 대단하십니다｡ 할아버지」"
  },
  {
   "id": 24411,
   "key": "D1106ru.txt:125",
   "ko": "마도연구소에 있는 무기고｡"
  },
  {
   "id": 24412,
   "key": "D1106ru.txt:126",
   "ko": "일종의 이상한 광경이 펼쳐지고 있다｡"
  },
  {
   "id": 24413,
   "key": "D1106ru.txt:128",
   "ko": "수상쩍은 마도구가 넓은 방을 가득 메울 듯이 늘어서 있다｡"
  },
  {
   "id": 24414,
   "key": "D1106ru.txt:129",
   "ko": "일반인의 눈에는､ 최대한 호의적으로 해석해도 『악취미한 인테리어』로밖에 보이지 않으리라｡"
  },
  {
   "id": 24416,
   "key": "D1106ru.txt:131",
   "ko": "하지만 여기 늘어선 무구류는 모두 『힘』 있는 무구임에 틀림없다｡"
  },
  {
   "id": 24417,
   "key": "D1106ru.txt:133",
   "ko": "게다가 그런 수상한 마도구에 섞여､ 통일감 없이 분별없이 절조 없이 늘어선――총화기류｡"
  },
  {
   "id": 24418,
   "key": "D1106ru.txt:135",
   "ko": "위화감이 장난 아니었다｡"
  },
  {
   "id": 24420,
   "key": "D1106ru.txt:136",
   "ko": "하지만､ 그것들은 결코 고래의 무구와 방향을 달리하는 것이 아니다｡"
  },
  {
   "id": 24422,
   "key": "D1106ru.txt:138",
   "ko": "그것은 마술 이론을 현대 기술과 융합시키기 위해 제조된､ 엄청난 수의 시작품인 것이다｡"
  },
  {
   "id": 24423,
   "key": "D1106ru.txt:140",
   "ko": "이 정도의 설비와 물자가 있다면――｡"
  },
  {
   "id": 24425,
   "key": "D1106ru.txt:142",
   "ko": "결의를 새로이 하며 홀로 고개를 끄덕이고､ 나는 작업을 시작했다｡"
  }
