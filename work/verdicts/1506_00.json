{
 "packet": "1506_00",
 "items": [
  {
   "id": 43378,
   "key": "D1506le.txt:11",
   "ko": "「윽……아아아……아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 43438,
   "key": "D1506le.txt:15",
   "ko": "「――――!?」"
  },
  {
   "id": 43489,
   "key": "D1506le.txt:21",
   "ko": "아물지 않는 상처가 과거에서 길어 올린 선혈을 뿜어냈다｡"
  },
  {
   "id": 43514,
   "key": "D1506le.txt:22",
   "ko": "몸을 젖혀 머리 위를 올려다본다｡ 뿜어진 피가 하늘을 찌른다｡"
  },
  {
   "id": 43526,
   "key": "D1506le.txt:24",
   "ko": "보이는 것은 시공이 일그러진 무질서의 하늘｡ 붉은､ 붉은､ 핏방울｡"
  },
  {
   "id": 43529,
   "key": "D1506le.txt:25",
   "ko": "제 피에 젖은 채 하늘을 움켜쥐려 손을 뻗는다｡"
  },
  {
   "id": 43645,
   "key": "D1506le.txt:26",
   "ko": "쏟아지는 피의 비는 타오를 듯이 뜨겁다｡"
  },
  {
   "id": 43749,
   "key": "D1506le.txt:28",
   "ko": "그래――타오르고 있다｡"
  },
  {
   "id": 43764,
   "key": "D1506le.txt:29",
   "ko": "증오에､ 초조함에､ 타오르고 있다｡"
  },
  {
   "id": 43784,
   "key": "D1506le.txt:31",
   "ko": "자비로울 만큼 잔혹한 비가 다시 한 번 선서한다｡"
  },
  {
   "id": 43799,
   "key": "D1506le.txt:32",
   "ko": "그 무엇에도 침범당하지 않는 증오를｡"
  },
  {
   "id": 43813,
   "key": "D1506le.txt:33",
   "ko": "겁화로써 그를 태우는､ 달콤한 파멸의 증오를｡"
  },
  {
   "id": 43823,
   "key": "D1506le.txt:35",
   "ko": "그 증오만이､ 라이카에 대한 증오만이――"
  },
  {
   "id": 43846,
   "key": "D1506le.txt:36",
   "ko": "오직 그녀만이――그의 존재의 전부｡"
  },
  {
   "id": 43858,
   "key": "D1506le.txt:37",
   "ko": "지금도､ 예전에도 변함없이｡"
  },
  {
   "id": 43909,
   "key": "D1506le.txt:44",
   "ko": "「라이카아아아아아아아!」"
  },
  {
   "id": 43911,
   "key": "D1506le.txt:47",
   "ko": "검은 천사는 피바람을 두르고 밉고도 사랑스러운 그녀에게로 날아올랐다｡"
  },
  {
   "id": 43957,
   "key": "D1506le.txt:49",
   "ko": "리베르 레기스의 불후의 장갑이 땅을 박차는 류가의 다릿심에 짓밟혀 부서졌다｡"
  },
  {
   "id": 43974,
   "key": "D1506le.txt:51",
   "ko": "그 필멸의 주먹 간합 안에 라이카와 에셀드레다를 붙잡는다｡"
  },
  {
   "id": 43997,
   "key": "D1506le.txt:57",
   "ko": "「말도 안 돼! 내 정신 지배를 깨뜨렸다니!?」"
  },
  {
   "id": 44037,
   "key": "D1506le.txt:60",
   "ko": "아이와 모체를 지키기 위해 방어 결계를 짜는 에셀드레다｡"
  },
  {
   "id": 44040,
   "key": "D1506le.txt:61",
   "ko": "하지만 초고속 연산 능력을 자랑하는 그녀도 류가의 속도에는 당해내지 못했다｡"
  },
  {
   "id": 44052,
   "key": "D1506le.txt:67",
   "ko": "누구도､ 아무것도 하지 못한 채"
  },
  {
   "id": 44065,
   "key": "D1506le.txt:68",
   "ko": "붕괴의 파문은 풀려나와"
  },
  {
   "id": 44075,
   "key": "D1506le.txt:70",
   "ko": "그녀를､"
  },
  {
   "id": 44102,
   "key": "D1506le.txt:81",
   "ko": "그래｡"
  },
  {
   "id": 44114,
   "key": "D1506le.txt:82",
   "ko": "이때 나는 류가를 죽였다｡"
  },
  {
   "id": 44183,
   "key": "D1506le.txt:84",
   "ko": "피투성이 얼굴――오른쪽 눈은 뿜어져 나오는 피의 붉음에 잠기고､ 남겨진 오른쪽 눈만이 놀라움에 크게 뜨인 채 공포로 눈물을 쏟고 있었다｡"
  },
  {
   "id": 44205,
   "key": "D1506le.txt:86",
   "ko": "이것이 내 눈동자에 새겨진 죄의 형상｡"
  },
  {
   "id": 44238,
   "key": "D1506le.txt:87",
   "ko": "이때의 류가의 얼굴이야말로｡"
  },
  {
   "id": 44246,
   "key": "D1506le.txt:88",
   "ko": "이 붉은 광경이야말로｡"
  },
  {
   "id": 44256,
   "key": "D1506le.txt:90",
   "ko": "그리고 나는 주박에 걸린 듯 움직이지 못하는 류가에게 최후의 일격을｡"
  },
  {
   "id": 44257,
   "key": "D1506le.txt:92",
   "ko": "피웅덩이 속에서 나는 눈을 떴다｡"
  },
  {
   "id": 44267,
   "key": "D1506le.txt:94",
   "ko": "이 처참한 붉은 광경 속에서 유일하게 붉음에 더럽혀지지 않은 것은､ 얄궂게도 흰색｡"
  },
  {
   "id": 44310,
   "key": "D1506le.txt:96",
   "ko": "내가 두른 천사의 흰색｡"
  },
  {
   "id": 44340,
   "key": "D1506le.txt:101",
   "ko": "나는 도망쳤다｡"
  },
  {
   "id": 44399,
   "key": "D1506le.txt:102",
   "ko": "피 속에 잠긴 류가를 그대로 내버려둔 채｡"
  },
  {
   "id": 44406,
   "key": "D1506le.txt:103",
   "ko": "남매의 인연도 짓눌러 오는 죄와 공포 앞에서는 완전히 무의미했다｡"
  },
  {
   "id": 44420,
   "key": "D1506le.txt:105",
   "ko": "그저､ 그저 나는 살고 싶었다｡"
  },
  {
   "id": 44485,
   "key": "D1506le.txt:106",
   "ko": "나를 감싸고 있던 세계로부터｡"
  }
 ]
}