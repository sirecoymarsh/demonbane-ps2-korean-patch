  {
   "id": 45114,
   "key": "D1507le.txt:16",
   "ko": "「멈춰요､ 류가앗!」"
  },
  {
   "id": 45115,
   "key": "D1507le.txt:22",
   "ko": "="
  },
  {
   "id": 45116,
   "key": "D1507le.txt:25",
   "ko": "이걸로 끝낼 수 있어―― 「……아」"
  },
  {
   "id": 45117,
   "key": "D1507le.txt:45",
   "ko": "하지만――"
  },
  {
   "id": 45118,
   "key": "D1507le.txt:47",
   "ko": "그 사람은――"
  },
  {
   "id": 45119,
   "key": "D1507le.txt:49",
   "ko": "그 사람은 뭐라고 말해 줬더라?"
  },
  {
   "id": 45120,
   "key": "D1507le.txt:51",
   "ko": "나는―― 나에게는 아직――"
  },
  {
   "id": 45121,
   "key": "D1507le.txt:58",
   "ko": "「……쿠로､ 군」 「멈춰요､ 류가앗!」"
  },
  {
   "id": 45122,
   "key": "D1507le.txt:89",
   "ko": "「아아아아아아아아아아아아아아아아아아아아아아아아아아아아아아아――――!」 이걸로 끝낼 수 있어――"
  },
  {
   "id": 45123,
   "key": "D1507le.txt:105",
   "ko": "="
  },
  {
   "id": 45124,
   "key": "D1507le.txt:106",
   "ko": "그게 아니야｡ 그 사람이 말했어｡"
  },
  {
   "id": 45125,
   "key": "D1507le.txt:109",
   "ko": "나를 안아주는 그 사람이｡ 따뜻한 그 사람이｡"
  },
  {
   "id": 45126,
   "key": "D1507le.txt:115",
   "ko": "「……라이카 씨는 혼자가 아니야｡ 라이카 씨는､ 라이카 씨 혼자만의 것이 아니야」 혼자가､ 아니다｡"
  },
  {
   "id": 45127,
   "key": "D1507le.txt:119",
   "ko": "나는､ 혼자가､ 아니다｡"
  },
  {
   "id": 45128,
   "key": "D1507le.txt:130",
   "ko": "지금의 나에겐 지키고 싶은 소중한 사람들이 있어｡ 지금의 나에겐 지켜주는 상냥한 사람들이 있어｡"
  },
  {
   "id": 45129,
   "key": "D1507le.txt:137",
   "ko": "……멋대로 끝내버려선 안 돼｡ 또다시 죄에서 도망치려 해선 안 돼｡"
  },
  {
   "id": 45130,
   "key": "D1507le.txt:140",
   "ko": "싸우라고｡ 살아서､ 발버둥 치며､ 싸우라고､ 분명 그 사람이라면 말할 거야｡"
  },
