{
 "packet": "0712_05",
 "items": [
  {
   "id": 10007,
   "key": "D0712al.txt:1551",
   "ko": "「다이쥬지 씨!」"
  },
  {
   "id": 10008,
   "key": "D0712al.txt:1555",
   "ko": "「쿠로 군! 꺄악!」"
  },
  {
   "id": 10009,
   "key": "D0712al.txt:1566",
   "ko": "「구와아아악! 큭……!」"
  },
  {
   "id": 10010,
   "key": "D0712al.txt:1571",
   "ko": "공주님과 라이카 씨가 서 있는 근처까지､ 내던져졌다｡"
  },
  {
   "id": 10011,
   "key": "D0712al.txt:1574",
   "ko": "목을 맞은 아픔과､ 돌바닥에 내리꽂힌 아픔에､ 숨을 쉴 수가 없다｡"
  },
  {
   "id": 10012,
   "key": "D0712al.txt:1584",
   "ko": "「자､ 거기서 구경이나 하고 있게」"
  },
  {
   "id": 10013,
   "key": "D0712al.txt:1590",
   "ko": "「――――읏!?」"
  },
  {
   "id": 10014,
   "key": "D0712al.txt:1596",
   "ko": "베스파시아누스의 등 뒤､ 제단 위에서 일어나는 괴이를 알아챘다｡"
  },
  {
   "id": 10015,
   "key": "D0712al.txt:1598",
   "ko": "무심코 말을 잃고､ 그것을 올려다본다｡"
  },
  {
   "id": 10016,
   "key": "D0712al.txt:1605",
   "ko": "「조각상이……!」"
  },
  {
   "id": 10017,
   "key": "D0712al.txt:1623",
   "ko": "신상에 생명이 깃들었다｡"
  },
  {
   "id": 10018,
   "key": "D0712al.txt:1630",
   "ko": "금이 가는 돌 조각상｡ 균열 아래에서 녹색 빛이 새어 나온다｡ 균열이 넓어지고､ 무너져 내린다｡"
  },
  {
   "id": 10019,
   "key": "D0712al.txt:1650",
   "ko": "그 아래에서 거대한 비늘을 겹쳐 놓은 듯한､ 거대한 따개비나 조개껍데기를 포갠 듯한､ 그런 극도로 기이하게 발달한 외각이､ 모습을 드러냈다｡"
  },
  {
   "id": 10020,
   "key": "D0712al.txt:1653",
   "ko": "조각상 아래에서 나타난 그것은､ 그 거대한 몸집을 담지 못해､ 조각상을 무너뜨리며､ 점점 비대해져 간다―― 마치 번데기에서 탈피하는 곤충처럼｡"
  },
  {
   "id": 10021,
   "key": "D0712al.txt:1657",
   "ko": "탁한 빛깔의 눈이､ 희번덕 주위를 노려본다……!"
  },
  {
   "id": 10023,
   "key": "D0712al.txt:1664",
   "ko": "「～～～～～～～～～～읏!」"
  },
  {
   "id": 10024,
   "key": "D0712al.txt:1670",
   "ko": "구역질을 부르는 오한이 온몸을 헤집고 돌아다녔다｡"
  },
  {
   "id": 10025,
   "key": "D0712al.txt:1673",
   "ko": "그건 다른 모두도 마찬가지였으리라｡"
  },
  {
   "id": 10027,
   "key": "D0712al.txt:1674",
   "ko": "다들､ 떨리는 몸을 필사적으로 견디려 하고 있었다｡"
  },
  {
   "id": 10028,
   "key": "D0712al.txt:1681",
   "ko": "「칫…… 다곤이냐! 성가신 것이 나왔구나……!」"
  },
  {
   "id": 10029,
   "key": "D0712al.txt:1687",
   "ko": "「다､ 다곤?」"
  },
  {
   "id": 10030,
   "key": "D0712al.txt:1692",
   "ko": "「깊은 곳의 존재들의 두령이자 해신의 위대한 권속…… 고대 펠리시테인들에게는､ 반인반어의 신으로 신앙되었느니라――」"
  },
  {
   "id": 10031,
   "key": "D0712al.txt:1697",
   "ko": "「신이라기보다､ 저건 괴수예요!」"
  },
  {
   "id": 10033,
   "key": "D0712al.txt:1702",
   "ko": "절묘한 표현이었다｡"
  },
  {
   "id": 10034,
   "key": "D0712al.txt:1710",
   "ko": "「――――――읏!」 「크……읏! 으으으으!」"
  },
  {
   "id": 10035,
   "key": "D0712al.txt:1720",
   "ko": "「싫어어어어어!」 「아､ 아가씨……!」"
  },
  {
   "id": 10036,
   "key": "D0712al.txt:1731",
   "ko": "다곤의 포효가 신전 전체를 격진시켰다｡ 원초의 본능이 뒤흔들리고､ 공포와 혼란이 마음을 찢어 놓는다｡"
  },
  {
   "id": 10037,
   "key": "D0712al.txt:1734",
   "ko": "『깊은 곳의 존재들』의 환호성은 이어진다｡ 베스파시아누스 곁에 선 노인이､ 환희에 떨고 있었다｡"
  },
  {
   "id": 10038,
   "key": "D0712al.txt:1743",
   "ko": "「오오오오오! 우리의 신 다곤! 이걸로 다시 우리의 바다를 되찾을 수 있으리라!」"
  },
  {
   "id": 10039,
   "key": "D0712al.txt:1749",
   "ko": "「크스프…… 르이에! 이아! 이아! 자 우리의 신이여! 이 땅에 깃든 뭍의 인간들에게 부디 심판을!」"
  },
  {
   "id": 10040,
   "key": "D0712al.txt:1761",
   "ko": "「젠장…… 저놈들!」"
  },
  {
   "id": 10041,
   "key": "D0712al.txt:1766",
   "ko": "「기다려라…… 낌새가 이상하구나?」"
  },
  {
   "id": 10042,
   "key": "D0712al.txt:1771",
   "ko": "「엣?」"
  },
  {
   "id": 10043,
   "key": "D0712al.txt:1784",
   "ko": "환호성이 서서히 작아진다｡ 주위를 둘러보니､ 한 마리､ 또 한 마리 깊은 곳의 존재들이 쓰러져 간다｡"
  },
  {
   "id": 10044,
   "key": "D0712al.txt:1790",
   "ko": "「윽……!」 쓰러지는 『깊은 곳의 존재들』｡"
  },
  {
   "id": 10045,
   "key": "D0712al.txt:1805",
   "ko": "단숨에 말라붙어､ 순식간에 미라로 변해 간다｡"
  },
  {
   "id": 10047,
   "key": "D0712al.txt:1807",
   "ko": "이건……!?"
  },
  {
   "id": 10048,
   "key": "D0712al.txt:1813",
   "ko": "「어째서냐!? 어째서입니까! 다곤 님!?」"
  },
  {
   "id": 10049,
   "key": "D0712al.txt:1820",
   "ko": "지금껏 승리를 자랑하던 늙은이의 안색이 변했다｡"
  },
  {
   "id": 10050,
   "key": "D0712al.txt:1821",
   "ko": "제단을 올려다보며､ 자신의 신에게 묻는다｡"
  }
 ]
}