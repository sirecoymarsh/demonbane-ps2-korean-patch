{
 "packet": "1504_02",
 "items": [
  {
   "id": 42210,
   "key": "D1504al.txt:506",
   "ko": "「――읏! 그래､ 부탁한다!」"
  },
  {
   "id": 42211,
   "key": "D1504al.txt:509",
   "ko": "두말없이 나는 고개를 끄덕였다｡"
  },
  {
   "id": 42212,
   "key": "D1504al.txt:527",
   "ko": "앞을 가로막는 거대한 문｡ 요그 소토스의 문｡"
  },
  {
   "id": 42213,
   "key": "D1504al.txt:531",
   "ko": "너무나 거대하고 광대해서､ 전모는 물론이고 목표까지의 거리감조차 잡히지 않는다｡"
  },
  {
   "id": 42214,
   "key": "D1504al.txt:544",
   "ko": "그 수평선의 끝을 향해 데몬베인은 그저 오로지 계속 날아간다｡"
  },
  {
   "id": 42215,
   "key": "D1504al.txt:553",
   "ko": "문득 후방을 비추는 모니터로 눈을 돌렸다｡"
  },
  {
   "id": 42216,
   "key": "D1504al.txt:554",
   "ko": "겨자씨처럼 작아진 연합군의 함대｡"
  },
  {
   "id": 42217,
   "key": "D1504al.txt:557",
   "ko": "저 겨자씨 하나에 쿠로가 있는 것이다｡"
  },
  {
   "id": 42218,
   "key": "D1504al.txt:566",
   "ko": "――그만둬라｡ 미련이다｡"
  },
  {
   "id": 42219,
   "key": "D1504al.txt:569",
   "ko": "스스로를 다잡는다｡ 마음속으로 작별을 고하고 알은 다시 전방의 요그 소토스를 향해 돌아…서려 한､ 바로 그때｡"
  },
  {
   "id": 42220,
   "key": "D1504al.txt:579",
   "ko": "「――――?」"
  },
  {
   "id": 42221,
   "key": "D1504al.txt:590",
   "ko": "함대 쪽 방향｡ 밤하늘을 가르며 달리는 극소의 광점이 고속으로 데몬베인에 다가오고 있었다｡ 수상히 여겨 모니터의 영상을 확대｡"
  },
  {
   "id": 42222,
   "key": "D1504al.txt:593",
   "ko": "――얼어붙었다｡"
  },
  {
   "id": 42223,
   "key": "D1504al.txt:604",
   "ko": "모니터의 영상도､ 감지되는 마력의 기척도 같은 답을 이끌어냈다｡"
  },
  {
   "id": 42224,
   "key": "D1504al.txt:607",
   "ko": "하얀 장갑을 두르고 하늘을 질주하는 메타트론｡ 그리고 그 등에는――"
  },
  {
   "id": 42225,
   "key": "D1504al.txt:623",
   "ko": "「…쿠로」"
  },
  {
   "id": 42226,
   "key": "D1504al.txt:628",
   "ko": "그저 그 이름을 입에 담았을 뿐인데 알의 심장은 격렬하게 고동쳤다｡"
  },
  {
   "id": 42227,
   "key": "D1504al.txt:631",
   "ko": "모니터 속｡ 무시무시한 풍압을 견디면서도 똑바로 데몬베인을 바라보는 쿠로가 있다｡"
  },
  {
   "id": 42228,
   "key": "D1504al.txt:634",
   "ko": "쿠로의 시선이 알을 꿰뚫고 있다｡"
  },
  {
   "id": 42229,
   "key": "D1504al.txt:635",
   "ko": "가슴이 두근거린다｡"
  },
  {
   "id": 42230,
   "key": "D1504al.txt:636",
   "ko": "죄어드는 듯한 아픔을 느낀다｡"
  },
  {
   "id": 42231,
   "key": "D1504al.txt:640",
   "ko": "비취빛 눈동자가 흔들렸다｡"
  },
  {
   "id": 42232,
   "key": "D1504al.txt:641",
   "ko": "환희가 뒤섞인 망설임이 눈동자 안쪽에서 숨쉬기 시작했다｡"
  },
  {
   "id": 42233,
   "key": "D1504al.txt:649",
   "ko": "――안 된다｡"
  },
  {
   "id": 42234,
   "key": "D1504al.txt:652",
   "ko": "마음속에 생긴 충동을 억지로 봉인한다｡"
  },
  {
   "id": 42235,
   "key": "D1504al.txt:653",
   "ko": "고개를 몇 번이고 가로저었다｡"
  },
  {
   "id": 42236,
   "key": "D1504al.txt:656",
   "ko": "안 된다｡"
  },
  {
   "id": 42237,
   "key": "D1504al.txt:657",
   "ko": "여기서 흔들려선 안 된다｡"
  },
  {
   "id": 42238,
   "key": "D1504al.txt:664",
   "ko": "「멍청이 같으니… 일부러 쫓아오는 놈이 어디 있느냐」"
  },
  {
   "id": 42239,
   "key": "D1504al.txt:678",
   "ko": "메타트론을､ 쿠로를､ 쿠로의 시선을､ 자신의 마음을 뿌리치기 위해 알은 샨타크를 가속시킨다｡"
  },
  {
   "id": 42240,
   "key": "D1504al.txt:693",
   "ko": "「젠장할! 저 바보､ 속도를 더 올렸잖아!」"
  },
  {
   "id": 42241,
   "key": "D1504al.txt:697",
   "ko": "이걸로 알았다｡ 결정적이다｡"
  },
  {
   "id": 42242,
   "key": "D1504al.txt:698",
   "ko": "저 녀석의 의도는 확실히 알았다｡"
  },
  {
   "id": 42243,
   "key": "D1504al.txt:701",
   "ko": "저 여자… 정말로 혼자서 싸우러 갈 셈이다｡"
  },
  {
   "id": 42244,
   "key": "D1504al.txt:704",
   "ko": "열받았다｡"
  },
  {
   "id": 42245,
   "key": "D1504al.txt:705",
   "ko": "진심으로 열받았다｡"
  },
  {
   "id": 42246,
   "key": "D1504al.txt:706",
   "ko": "뼛속까지 열받았다｡"
  },
  {
   "id": 42247,
   "key": "D1504al.txt:710",
   "ko": "남을 실컷 휘둘러 놓고､ 실컷 잘난 척 지껄여 놓고､ 그런데 결국… 이러쿵저러쿵 해놓고 결국――!"
  },
  {
   "id": 42248,
   "key": "D1504al.txt:715",
   "ko": "「나를 믿지 않았다… 그런 거잖아! 장난치지 마､ 바보야!」 「너무 떠들면 혀 깨문다」"
  },
  {
   "id": 42249,
   "key": "D1504al.txt:732",
   "ko": "「부부그부옷!?」 「――늦었나」"
  }
 ]
}