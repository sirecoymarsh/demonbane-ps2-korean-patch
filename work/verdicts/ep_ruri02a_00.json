{
 "packet": "ep_ruri02a_00",
 "items": [
  {
   "id": 50533,
   "key": "ep_ruri02a.txt:10",
   "ko": "문은 닫혔다｡ 그 사람은 이긴 걸까｡"
  },
  {
   "id": 50534,
   "key": "ep_ruri02a.txt:12",
   "ko": "그렇게 믿고 싶다｡"
  },
  {
   "id": 50535,
   "key": "ep_ruri02a.txt:14",
   "ko": "세계를 뒤흔든 대사건은､ 하지만 누구도 모르는 곳에서 막을 내렸다｡"
  },
  {
   "id": 50536,
   "key": "ep_ruri02a.txt:15",
   "ko": "모든 것은 폭풍처럼 지나가､ 찾아온 평화도､ 그토록 처절했던 싸움의 나날도､ 실감이 나지 않는다｡"
  },
  {
   "id": 50537,
   "key": "ep_ruri02a.txt:16",
   "ko": "전 세계가 얼이 빠진 듯한 공기 속에서 인류는 일상을 되찾아 가고 있다｡"
  },
  {
   "id": 50538,
   "key": "ep_ruri02a.txt:18",
   "ko": "모든 것이 마치 꿈만 같아서――하지만､ 나는 그 사람의 싸움을 기억하고 있다｡"
  },
  {
   "id": 50539,
   "key": "ep_ruri02a.txt:19",
   "ko": "싸움의 격렬함을 기억하고 있다｡"
  },
  {
   "id": 50540,
   "key": "ep_ruri02a.txt:20",
   "ko": "그 싸움의 나날은 결코 환상이 아니다｡"
  },
  {
   "id": 50541,
   "key": "ep_ruri02a.txt:22",
   "ko": "그러니까 나는 계속 기다린다｡"
  },
  {
   "id": 50542,
   "key": "ep_ruri02a.txt:23",
   "ko": "싸움을 끝내고 내 곁으로 돌아올 그 사람을｡"
  },
  {
   "id": 50543,
   "key": "ep_ruri02a.txt:24",
   "ko": "내가 사랑하는 그 사람을｡"
  },
  {
   "id": 50544,
   "key": "ep_ruri02a.txt:26",
   "ko": "다이쥬지 쿠로를 계속 기다린다｡ 문이 닫히고 1일｡"
  },
  {
   "id": 50545,
   "key": "ep_ruri02a.txt:38",
   "ko": "나는 바다 위에서 하늘을 올려다보며 기다리고 있었다｡"
  },
  {
   "id": 50546,
   "key": "ep_ruri02a.txt:39",
   "ko": "그 사람이 내려오기를 기다리고 있었다｡"
  },
  {
   "id": 50547,
   "key": "ep_ruri02a.txt:40",
   "ko": "내려오면 그 사람을 껴안아 주자｡"
  },
  {
   "id": 50548,
   "key": "ep_ruri02a.txt:41",
   "ko": "다정하게 껴안고 어서 오라고 말을 걸어 주자｡"
  },
  {
   "id": 50549,
   "key": "ep_ruri02a.txt:53",
   "ko": "문이 닫히고 3일｡"
  },
  {
   "id": 50550,
   "key": "ep_ruri02a.txt:54",
   "ko": "나는 바다 위에서 하늘을 올려다보며 기다리고 있었다｡"
  },
  {
   "id": 50551,
   "key": "ep_ruri02a.txt:55",
   "ko": "그 사람이 내려오기를 기다리고 있었다｡"
  },
  {
   "id": 50552,
   "key": "ep_ruri02a.txt:56",
   "ko": "내려오면 그 사람 가슴에 뛰어들어 안기자｡"
  },
  {
   "id": 50553,
   "key": "ep_ruri02a.txt:57",
   "ko": "그 사람은 지칠 대로 지쳐서 상처투성이겠지만 봐주지 않겠다｡"
  },
  {
   "id": 50554,
   "key": "ep_ruri02a.txt:58",
   "ko": "나를 걱정시킨 벌이다｡"
  },
  {
   "id": 50555,
   "key": "ep_ruri02a.txt:59",
   "ko": "내 무게를 받아내게 하자｡ 문이 닫히고 7일｡"
  },
  {
   "id": 50556,
   "key": "ep_ruri02a.txt:71",
   "ko": "더 이상 바다에 머물 수는 없다｡"
  },
  {
   "id": 50557,
   "key": "ep_ruri02a.txt:72",
   "ko": "세계의 부흥은 이제 막 시작됐고､ 나에게는､ 하도 재벌에는 해야 할 일이 있다｡"
  },
  {
   "id": 50558,
   "key": "ep_ruri02a.txt:73",
   "ko": "나는 그 거리로 돌아가야 한다｡"
  },
  {
   "id": 50559,
   "key": "ep_ruri02a.txt:74",
   "ko": "하지만 괜찮다｡ 스스로에게 타이른다｡"
  },
  {
   "id": 50560,
   "key": "ep_ruri02a.txt:77",
   "ko": "왜냐하면… 그 사람이 돌아올 곳은 그 거리니까｡"
  },
  {
   "id": 50561,
   "key": "ep_ruri02a.txt:78",
   "ko": "그 사람이 사랑하는 거리｡ 내가 사랑하는 거리｡"
  },
  {
   "id": 50562,
   "key": "ep_ruri02a.txt:79",
   "ko": "대황금시대이자 대혼란시대이자 대암흑시대인 그 거리가 우리가 사는 세계니까｡"
  },
  {
   "id": 50563,
   "key": "ep_ruri02a.txt:80",
   "ko": "그러니까 그 사람은 분명 돌아온다｡"
  },
  {
   "id": 50564,
   "key": "ep_ruri02a.txt:90",
   "ko": "문이 닫히고 1개월｡ 부흥 작업은 계속된다｡"
  },
  {
   "id": 50565,
   "key": "ep_ruri02a.txt:92",
   "ko": "나날의 업무에 쫓겨 시간을 잊어버린다｡"
  },
  {
   "id": 50566,
   "key": "ep_ruri02a.txt:93",
   "ko": "그 사람을 떠올리지 않는 시간이 있다｡"
  },
  {
   "id": 50567,
   "key": "ep_ruri02a.txt:94",
   "ko": "그런 나 자신에게 진저리가 난다｡"
  },
  {
   "id": 50568,
   "key": "ep_ruri02a.txt:95",
   "ko": "그래도… 힘내야지｡ 이건 내 싸움이다｡"
  },
  {
   "id": 50569,
   "key": "ep_ruri02a.txt:97",
   "ko": "그 사람이 싸웠던 것처럼――나도 내 싸움에서 도망쳐선 안 된다｡"
  },
  {
   "id": 50570,
   "key": "ep_ruri02a.txt:98",
   "ko": "그러지 않으면 그 사람이 돌아왔을 때 얼굴을 들 수 없으니까｡"
  },
  {
   "id": 50571,
   "key": "ep_ruri02a.txt:108",
   "ko": "문이 닫히고 6개월｡"
  },
  {
   "id": 50572,
   "key": "ep_ruri02a.txt:109",
   "ko": "마음의 틈을 찔러 초조함이 나를 덮친다｡"
  }
 ]
}