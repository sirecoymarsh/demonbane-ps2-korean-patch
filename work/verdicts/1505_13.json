{
 "packet": "1505_13",
 "items": [
  {
   "id": 43167,
   "key": "D1505ru.txt:118",
   "ko": "「……?」"
  },
  {
   "id": 43168,
   "key": "D1505ru.txt:122",
   "ko": "「역시､ 저는 다이쥬지 씨가 미워요」"
  },
  {
   "id": 43169,
   "key": "D1505ru.txt:126",
   "ko": "「……읏」"
  },
  {
   "id": 43170,
   "key": "D1505ru.txt:130",
   "ko": "「이렇게나 제 마음을 차지해 버린 다이쥬지 씨가 미워요」 「……공주님」"
  },
  {
   "id": 43172,
   "key": "D1505ru.txt:138",
   "ko": "「저를 이렇게 만들어 놓고서…… 그런 저를 두고 가버리는 다이쥬지 씨가 미워요…… 죽이고 싶을 만큼」"
  },
  {
   "id": 43173,
   "key": "D1505ru.txt:141",
   "ko": "뭐라고 대답하면 좋을까?"
  },
  {
   "id": 43174,
   "key": "D1505ru.txt:142",
   "ko": "뭐라고 대답해야 하는 걸까?"
  },
  {
   "id": 43175,
   "key": "D1505ru.txt:144",
   "ko": "이런―― 약속이 용서받을 수 있을까｡"
  },
  {
   "id": 43177,
   "key": "D1505ru.txt:145",
   "ko": "거짓말이나 다름없는 약속이 용서받을 수 있을까｡"
  },
  {
   "id": 43178,
   "key": "D1505ru.txt:147",
   "ko": "하지만 정신을 차려 보니 나는 그 말을 입에 담고 있었다｡"
  },
  {
   "id": 43179,
   "key": "D1505ru.txt:150",
   "ko": "「――돌아올게」 「……엣?」"
  },
  {
   "id": 43180,
   "key": "D1505ru.txt:158",
   "ko": "「반드시 돌아올게｡ 공주님 곁으로」 「……………………」"
  },
  {
   "id": 43181,
   "key": "D1505ru.txt:165",
   "ko": "약속은――한없이 거짓말에 가까운 약속은､ 하지만 말로 형태를 갖춘 순간 맹세가 되었다｡"
  },
  {
   "id": 43182,
   "key": "D1505ru.txt:167",
   "ko": "그것은 한없이 거짓말에 가까운 약속이었지만――그 순간､ 궁상맞은 체념과 위선적인 자기희생은 타 없어지고､ 어디까지나 탐욕스럽게 사는 것에 매달리는､ 용암처럼 작열하는 투지가 솟구쳤다｡"
  },
  {
   "id": 43183,
   "key": "D1505ru.txt:169",
   "ko": "그것은 한없이 거짓말에 가까운 약속이었지만――그 순간､ 결코 어겨선 안 될､ 침범해선 안 될 성약이 되었다｡"
  },
  {
   "id": 43184,
   "key": "D1505ru.txt:171",
   "ko": "나는 다시 한 번 맹세했다｡"
  },
  {
   "id": 43185,
   "key": "D1505ru.txt:174",
   "ko": "「반드시､ 돌아올게」 「……다이쥬지 씨」"
  },
  {
   "id": 43186,
   "key": "D1505ru.txt:181",
   "ko": "내 가슴 속에서 공주님은 나를 올려다보았다｡"
  },
  {
   "id": 43187,
   "key": "D1505ru.txt:182",
   "ko": "그리고―― 「그렇다면 맹세의 증표를 주세요」"
  },
  {
   "id": 43188,
   "key": "D1505ru.txt:190",
   "ko": "「……증표?」 그리고――"
  },
  {
   "id": 43189,
   "key": "D1505ru.txt:197",
   "ko": "「………………읏읏읏!?」 불시의 습격이었다｡"
  },
  {
   "id": 43190,
   "key": "D1505ru.txt:200",
   "ko": "까치발을 한 공주님이 내 머리를 끌어당겨 강제로 입술을 눌러 왔다｡"
  },
  {
   "id": 43191,
   "key": "D1505ru.txt:209",
   "ko": "「음……!」 오랫동안――시간이 멈춘 게 아닌가 싶을 만큼 긴 시간､ 우리는 입술을 포개고 있었다｡"
  },
  {
   "id": 43192,
   "key": "D1505ru.txt:216",
   "ko": "달빛이 우리를 비추고 있다｡"
  },
  {
   "id": 43193,
   "key": "D1505ru.txt:217",
   "ko": "잔잔한 파도 소리가 귀에 들려온다｡"
  },
  {
   "id": 43194,
   "key": "D1505ru.txt:218",
   "ko": "고요한 밤바다의 정적이 우리를 감싸고 있었다｡"
  },
  {
   "id": 43195,
   "key": "D1505ru.txt:221",
   "ko": "이윽고 공주님이 천천히､ 아쉬워하듯 입술을 뗀다｡"
  },
  {
   "id": 43196,
   "key": "D1505ru.txt:222",
   "ko": "볼을 살짝 붉히며 미소 지었다｡"
  },
  {
   "id": 43197,
   "key": "D1505ru.txt:230",
   "ko": "「새끼손가락 약속 대신이에요…… 어기면 혼날 거예요?」 「……공주님」"
  },
  {
   "id": 43198,
   "key": "D1505ru.txt:239",
   "ko": "나는 다시 한 번 공주님을 꼭 안았다｡"
  },
  {
   "id": 43199,
   "key": "D1505ru.txt:240",
   "ko": "공주님의 부드러움과 온기를 느끼며 나는 맹세를 새로이 한다｡"
  },
  {
   "id": 43200,
   "key": "D1505ru.txt:244",
   "ko": "반드시다｡ 반드시 나는――이 온기 속으로 돌아온다｡"
  },
  {
   "id": 43201,
   "key": "D1505ru.txt:258",
   "ko": "서로 껴안은 두 사람에게서 딱 사각지대｡"
  },
  {
   "id": 43202,
   "key": "D1505ru.txt:259",
   "ko": "알은 그저 멍하니 그 자리에 선 채､ 껴안은 두 사람을 바라보고 있었다｡"
  },
  {
   "id": 43203,
   "key": "D1505ru.txt:261",
   "ko": "가슴 깊은 곳에서 무언가가 뜨겁게 타오르고 있었다｡ 어둡게､ 타오르고 있었다｡"
  }
 ]
}