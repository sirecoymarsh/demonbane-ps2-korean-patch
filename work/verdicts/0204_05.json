  {
   "id": 1961,
   "key": "D0204ab.txt:526",
   "ko": "게다가､ 게다가 말이다｡"
  },
  {
   "id": 1962,
   "key": "D0204ab.txt:527",
   "ko": "마지막엔 분명하게 『사령비법(네크로노미콘)』이란 이름까지 꺼내며｡ 이 사람……대체 뭐지?"
  },
  {
   "id": 1963,
   "key": "D0204ab.txt:532",
   "ko": "내 겁먹은 듯한 경계의 시선을 눈치챘는지 나이아 씨는 희미하게 심술궂은 미소를 지었다｡"
  },
  {
   "id": 1964,
   "key": "D0204ab.txt:534",
   "ko": "="
  },
  {
   "id": 1965,
   "key": "D0204ab.txt:540",
   "ko": "="
  },
  {
   "id": 1966,
   "key": "D0204ab.txt:545",
   "ko": "「당신은……」"
  },
  {
   "id": 1967,
   "key": "D0204ab.txt:550",
   "ko": "「아니､ 그렇게 무서운 눈으로 보지 마｡ 대단한 일은 아니야｡ 그때도 말했잖아｡ 『왠지 모르게 알 수 있다』고 말이지」 「고백하자면 난 그런 종류의 감――영감이라고 하면 될까? 그런 게 강하거든｡ 그래서 이런 취미에 빠져 버린 거고」"
  },
  {
   "id": 1968,
   "key": "D0204ab.txt:559",
   "ko": "="
  },
  {
   "id": 1969,
   "key": "D0204ab.txt:561",
   "ko": "맨 위의 카드를 손끝으로 톡톡 두드리며 치켜뜬 눈으로 나를 바라본다｡"
  },
  {
   "id": 1970,
   "key": "D0204ab.txt:567",
   "ko": "「어때? 하나 점쳐 보지 않을래?」 「아､ 값은 됐어｡ 너와 나 사이잖아｡ 서비스해 주지」"
  },
  {
   "id": 1971,
   "key": "D0204ab.txt:577",
   "ko": "「나는……」"
  },
  {
   "id": 1972,
   "key": "D0204ab.txt:580",
   "ko": "뭐지? 머리가 멍한 것 같은데｡"
  },
  {
   "id": 1973,
   "key": "D0204ab.txt:583",
   "ko": "전에도 그랬다｡ 이 사람과 이야기하고 있으면 분위기에 삼켜져 버린다고 할까､ 의식에 안개가 낀다고 할까……"
  },
  {
   "id": 1974,
   "key": "D0204ab.txt:586",
   "ko": "="
  },
  {
   "id": 1975,
   "key": "D0204ab.txt:592",
   "ko": "「……난､ 다른 마도서를 찾아야……」"
  },
  {
   "id": 1976,
   "key": "D0204ab.txt:597",
   "ko": "「원하든 원하지 않든 운명은 너를 놓아주지 않아」 「그래｡ 너는 최고위 마도서 『알 아지프』의 주인이 될 운명의 아이｡ 마술사의 왕｡ 검은 왕과 맞서는 하얀 왕……」"
  },
  {
   "id": 1977,
   "key": "D0204ab.txt:608",
   "ko": "="
  },
  {
   "id": 1978,
   "key": "D0204ab.txt:609",
   "ko": "작은 책상 위에서 우주를 형성한다｡"
  },
  {
   "id": 1979,
   "key": "D0204ab.txt:612",
   "ko": "세로로 이어지는 열 장의 카드｡ 그래 즉――생명의 나무｡"
  },
