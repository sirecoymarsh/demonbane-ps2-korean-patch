{
 "packet": "0902_04",
 "items": [
  {
   "id": 18282,
   "key": "D0902ru.txt:32",
   "ko": "「아､ 아뇨､ 그……………… ……네｡ 그럼……잠깐만 실례하겠습니다……」"
  },
  {
   "id": 18283,
   "key": "D0902ru.txt:39",
   "ko": "꾸벅 인사를 하고 조심조심 방 안으로 들어온다｡"
  },
  {
   "id": 18284,
   "key": "D0902ru.txt:40",
   "ko": "그동안 알은 지――――――――――긋이 차가운 시선을 공주님에게서 떼지 않았다｡"
  },
  {
   "id": 18285,
   "key": "D0902ru.txt:42",
   "ko": "……제발 성가신 짓만은 하지 말아 줘｡"
  },
  {
   "id": 18286,
   "key": "D0902ru.txt:43",
   "ko": "또 복잡해진다｡"
  },
  {
   "id": 18289,
   "key": "D0902ru.txt:54",
   "ko": "「……무슨 볼일이냐､ 계집애? 그대를 상대해 줄 만큼 우리는 한가하지 않다만?」"
  },
  {
   "id": 18290,
   "key": "D0902ru.txt:59",
   "ko": "……싸움 걸 마음이 만만한 느낌이었다｡"
  },
  {
   "id": 18293,
   "key": "D0902ru.txt:60",
   "ko": "뭔가 평소보다 노기를 품고 있는 것 같다｡"
  },
  {
   "id": 18294,
   "key": "D0902ru.txt:66",
   "ko": "「그러니까 저는 딱히……!」"
  },
  {
   "id": 18295,
   "key": "D0902ru.txt:71",
   "ko": "「지난번 답례를 아직 못 드렸기에 그래서 들른 것뿐이에요!」"
  },
  {
   "id": 18296,
   "key": "D0902ru.txt:75",
   "ko": "「지난번?」"
  },
  {
   "id": 18297,
   "key": "D0902ru.txt:77",
   "ko": "내가 되묻자 공주님은 뺨을 살짝 붉히고는 고개를 숙여버린다｡"
  },
  {
   "id": 18298,
   "key": "D0902ru.txt:82",
   "ko": "「네……그……어제 불러 주셨으니까요……」"
  },
  {
   "id": 18299,
   "key": "D0902ru.txt:86",
   "ko": "「아……」"
  },
  {
   "id": 18300,
   "key": "D0902ru.txt:91",
   "ko": "「……읏!」"
  },
  {
   "id": 18301,
   "key": "D0902ru.txt:95",
   "ko": "순간､ 알이 무시무시한 얼굴에 잔뜩 경련하는 미소를 붙였다｡"
  },
  {
   "id": 18302,
   "key": "D0902ru.txt:97",
   "ko": "……그러니까 무섭다니까｡"
  },
  {
   "id": 18303,
   "key": "D0902ru.txt:99",
   "ko": "하지만 공주님은 그런 알에겐 아랑곳없이､"
  },
  {
   "id": 18304,
   "key": "D0902ru.txt:100",
   "ko": "내 얼굴을 가만히 바라보며 수줍게 미소 지었다｡"
  },
  {
   "id": 18305,
   "key": "D0902ru.txt:106",
   "ko": "「다이쥬지 씨､ 어제는 정말 감사합니다｡ 정말､ 정말로 즐거웠어요」"
  },
  {
   "id": 18306,
   "key": "D0902ru.txt:110",
   "ko": "「아……아니……별로……」"
  },
  {
   "id": 18307,
   "key": "D0902ru.txt:112",
   "ko": "……역시 이 사람은 솔직하게 웃으면 귀엽다고 생각한다｡"
  },
  {
   "id": 18308,
   "key": "D0902ru.txt:113",
   "ko": "늘 가시 돋쳐 있었으니 더 그렇게 느끼는 건지도 모르지만｡"
  },
  {
   "id": 18309,
   "key": "D0902ru.txt:118",
   "ko": "「지――――――――――――――――――――긋」"
  },
  {
   "id": 18310,
   "key": "D0902ru.txt:124",
   "ko": "「테켈리 리」"
  },
  {
   "id": 18311,
   "key": "D0902ru.txt:129",
   "ko": "「우와악!? 아､ 아니､ 별､ 별거 안 했다고! 그보다……그보다 말이야! 어､ 오늘은 집사님은?」"
  },
  {
   "id": 18312,
   "key": "D0902ru.txt:133",
   "ko": "「네……나중에 데리러 오라고 일러 두었어요」"
  },
  {
   "id": 18313,
   "key": "D0902ru.txt:138",
   "ko": "「그､ 그렇군…… 뭐､ 뭐 일단 앉아､ 앉아｡ 어어､ 그래그래｡ 커피｡ 커피 타 올게｡ 응」"
  },
  {
   "id": 18314,
   "key": "D0902ru.txt:144",
   "ko": "「앗……그런､ 신경 쓰지 마세요……」"
  },
  {
   "id": 18315,
   "key": "D0902ru.txt:148",
   "ko": "「괜찮아 괜찮아」"
  },
  {
   "id": 18316,
   "key": "D0902ru.txt:152",
   "ko": "공주님에게 의자를 내주고 부엌으로 들어간다｡"
  },
  {
   "id": 18317,
   "key": "D0902ru.txt:154",
   "ko": "……알과 공주님을 둘만 두는 건 불안했지만､ 나로선 그 공기에서 한순간이라도 벗어나고 싶은 마음이 이겼다｡"
  },
  {
   "id": 18318,
   "key": "D0902ru.txt:156",
   "ko": "커피를 타면서――라고 해도 인스턴트지만――나는 몰래 한숨을 쉰다｡"
  },
  {
   "id": 18320,
   "key": "D0902ru.txt:159",
   "ko": "「후우――……이거 참」 알은 뭔가 엄청 험악한 느낌이고｡"
  },
  {
   "id": 18321,
   "key": "D0902ru.txt:162",
   "ko": "공주님 쪽도 서로 쑥스러워서 어색해지고｡"
  },
  {
   "id": 18323,
   "key": "D0902ru.txt:162",
   "ko": "그러면 알의 살기가 더 부풀어 오르고｡"
  },
  {
   "id": 18324,
   "key": "D0902ru.txt:164",
   "ko": "조금 간질간질하고 새콤달콤한 기분이며､ 무척 살벌하고 암담하게 소용돌이치는 공기며가 복잡하게 뒤섞여 숨이 막힐 것 같은……이라기보다 차라리 「상황､ 가스!」였다｡"
  },
  {
   "id": 18325,
   "key": "D0902ru.txt:167",
   "ko": "「…………………」"
  },
  {
   "id": 18327,
   "key": "D0902ru.txt:169",
   "ko": "커피가 내려지는 걸 멍하니 바라보며 생각에 잠긴다｡"
  },
  {
   "id": 18329,
   "key": "D0902ru.txt:174",
   "ko": "어제 데이트로 어쩐지 공주님을 가깝게 느끼게 된 건 틀림없다｡"
  }
 ]
}