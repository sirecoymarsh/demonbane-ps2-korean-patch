   "key": "D1501al.txt:260",
   "ko": "="
  },
  {
   "id": 40779,
   "key": "D1501al.txt:277",
   "ko": "「――윽윽윽! 크윽!」"
  },
  {
   "id": 40780,
   "key": "D1501al.txt:280",
   "ko": "충격이 나를 덮쳤다｡ 보이지 않는 힘에 콕핏에서 튕겨 나가､ 허공을 난다｡"
  },
  {
   "id": 40781,
   "key": "D1501al.txt:297",
   "ko": "="
  },
  {
   "id": 40782,
   "key": "D1501al.txt:316",
   "ko": "있는 대로의 마력을 주먹에 담아､ 내지른다｡"
  },
  {
   "id": 40783,
   "key": "D1501al.txt:317",
   "ko": "자도자가 마학 변화를 일으켜､ 공간을 폭쇄시켰다｡"
  },
  {
   "id": 40784,
   "key": "D1501al.txt:320",
   "ko": "고목으로 변한 네임리스 원의 상반신을 산산이 분쇄한다｡"
  },
  {
   "id": 40785,
   "key": "D1501al.txt:329",
   "ko": "「……훗」 나는 데몬베인 위에 착지｡ 마스터 테리온 또한 남겨진 네임리스 원의 하반신에 착지했다｡ 흐트러진 머리를 손가락으로 쓸어 넘기며､ 나를 올려다본다｡"
  },
  {
   "id": 40786,
   "key": "D1501al.txt:346",
   "ko": "「살아 있었다……는 것은 옳지 않다｡ 아까부터 말했듯 그대와 만나는 것은 이번이 처음이다」"
  },
  {
   "id": 40787,
   "key": "D1501al.txt:351",
   "ko": "「뭐､ 알아먹지도 못할 소릴 지껄이는 거야!」"
  }
 ]
