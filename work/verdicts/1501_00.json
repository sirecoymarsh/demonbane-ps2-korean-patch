 "items": [
  {
   "id": 40748,
   "key": "D1501al.txt:29",
   "ko": "하얀 꽃봉오리가 피워내는､ 붉은 꽃｡"
  },
  {
   "id": 40749,
   "key": "D1501al.txt:30",
   "ko": "붉은 꽃이 맺어내는､ 황금 열매｡"
  },
  {
   "id": 40750,
   "key": "D1501al.txt:31",
   "ko": "황금 열매가 흘려내는､ 악덕의 과즙｡"
  },
  {
   "id": 40751,
   "key": "D1501al.txt:50",
   "ko": "="
  },
  {
   "id": 40752,
   "key": "D1501al.txt:51",
   "ko": "="
  },
  {
   "id": 40753,
   "key": "D1501al.txt:52",
   "ko": "곪아､ 타락한 것이다｡"
  },
  {
   "id": 40754,
   "key": "D1501al.txt:69",
   "ko": "="
  },
  {
   "id": 40755,
   "key": "D1501al.txt:70",
   "ko": "인간의 탈을 쓴 이형이었다｡"
  },
  {
   "id": 40756,
   "key": "D1501al.txt:71",
   "ko": "그것은――바라지 않은 생명이었다｡"
  },
  {
   "id": 40757,
   "key": "D1501al.txt:88",
   "ko": "그것은――『짐승』이었다｡"
  },
  {
   "id": 40758,
   "key": "D1501al.txt:97",
   "ko": "="
  },
  {
   "id": 40759,
   "key": "D1501al.txt:112",
   "ko": "="
  },
  {
   "id": 40760,
   "key": "D1501al.txt:118",
   "ko": "――사고보다 먼저 육체와 영혼이 투쟁에 순응한다｡"
  },
  {
   "id": 40761,
   "key": "D1501al.txt:121",
   "ko": "마기우스 스타일이 마력을 끌어올린다｡ 소환한 두 자루 마총은 자동으로 터져 나온 핏물의 중심､ 황금빛으로 고인 어둠을 향했다｡"
  },
  {
   "id": 40762,
   "key": "D1501al.txt:138",
   "ko": "="
  },
  {
   "id": 40763,
   "key": "D1501al.txt:139",
   "ko": "="
  },
  {
   "id": 40764,
   "key": "D1501al.txt:150",
   "ko": "="
  },
  {
   "id": 40765,
   "key": "D1501al.txt:151",
   "ko": "="
  },
  {
   "id": 40766,
   "key": "D1501al.txt:171",
   "ko": "="
  },
  {
   "id": 40767,
   "key": "D1501al.txt:179",
   "ko": "고개를 든 그자는 이형의 미소 그대로､ 맑은 이형의 목소리로 조용히 말했다｡"
  },
  {
   "id": 40768,
   "key": "D1501al.txt:189",
   "ko": "「……처음 보는 사이로군｡ 다이쥬지 쿠로」"
  },
  {
   "id": 40769,
   "key": "D1501al.txt:195",
   "ko": "="
