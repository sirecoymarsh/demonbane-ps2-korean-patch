  },
  {
   "id": 8365,
   "key": "D0702.txt:694",
   "ko": "「게게――――에에! 다이쥬지 쿠로!?」"
  },
  {
   "id": 8366,
   "key": "D0702.txt:704",
   "ko": "「「『블랙로지』!?」」"
  },
  {
   "id": 8367,
   "key": "D0702.txt:710",
   "ko": "「그､ 그런데 정체가 들통났어!? 어째서지!?」"
  },
  {
   "id": 8368,
   "key": "D0702.txt:720",
   "ko": "「「모를까 보냐!」」"
  },
  {
   "id": 8369,
   "key": "D0702.txt:726",
   "ko": "「……저기｡ 아는 사이……인가요?」"
  },
  {
   "id": 8370,
   "key": "D0702.txt:733",
   "ko": "「아니､ 눈치 좀 채라고!?」"
  },
  {
   "id": 8371,
   "key": "D0702.txt:744",
   "ko": "「우와아아아! 보스으으으! 보스으으으!」"
  },
  {
   "id": 8372,
   "key": "D0702.txt:755",
   "ko": "「쿠로!」 「이 자식들아아아아! 게 섰거라!」"
  },
  {
   "id": 8373,
   "key": "D0702.txt:766",
   "ko": "「앗……잠깐､ 쿠로 군! 알 양!」"
  },
  {
   "id": 8374,
   "key": "D0702.txt:773",
   "ko": "복면 남자들을 쫓아 나와 알은 달려 나갔다｡"
  },
  {
   "id": 8375,
   "key": "D0702.txt:791",
   "ko": "괴사건이 일어나고 있는 이 인스머스에 『블랙로지』의 전투원｡ 단순한 우연일 리가 있겠나!"
  },
  {
   "id": 8376,
   "key": "D0702.txt:801",
   "ko": "「체념하거라!」"
  },
  {
   "id": 8377,
   "key": "D0702.txt:806",
   "ko": "「보스으으으으! 크크크크､ 큰일입니다! 다､ 다､ 다다다이쥬……」"
  },
  {
   "id": 8378,
   "key": "D0702.txt:815",
   "ko": "겨우 몰아붙인 그 앞에는――"
  },
  {
   "id": 8379,
   "key": "D0702.txt:833",
   "ko": "「뭐냐 뭐냐……허둥대기는｡ 대체 무엇이 어떻게 된 것이냐? 가지러 간 공은 어찌 된 것이……다…………」"
  },
  {
   "id": 8380,
   "key": "D0702.txt:844",
   "ko": "「헉」"
  },
  {
   "id": 8381,
   "key": "D0702.txt:855",
   "ko": "「「허걱」」 ――정면으로 눈이 마주쳤다｡"
  },
  {
   "id": 8382,
   "key": "D0702.txt:871",
   "ko": "「다이쥬지 쿠로오오!? 게다가 알 아지프으으!」"
  },
  {
   "id": 8383,
   "key": "D0702.txt:878",
   "ko": "="
  },
  {
   "id": 8384,
   "key": "D0702.txt:885",
   "ko": "서로 튕겨 나가듯 뛰어 물러나 자세를 잡았다｡"
  },
  {
   "id": 8385,
   "key": "D0702.txt:890",
   "ko": "「역시 네놈 짓이었나､ 닥터 웨스트! 남한테 폐 끼치는 것도 아랑곳없이 제멋대로 굴어대고! 오늘이라는 오늘은 못 봐준다!」"
  },
  {
   "id": 8386,
   "key": "D0702.txt:902",
   "ko": "「뭐냐 나타나자마자 다짜고짜 트집을 잡는 것이냐! 전혀 영문을 모르겠는 것이다!」"
  },
  {
   "id": 8387,
   "key": "D0702.txt:907",
   "ko": "「까불지 마 시치미 떼지 마 도망치지 마 증거는 다 나왔다 전부 네놈 짓이잖아 냉큼 자백해라 그리고 죽어어어어어!」"
  },
  {
   "id": 8388,
   "key": "D0702.txt:913",
   "ko": "「무슨 소리인 것이냐! 우리는 그저 위안 여행을 왔을 뿐인 것이다! 뭐든지 남 탓으로 돌리지 말라는 것이다!」"
  },
  {
   "id": 8389,
   "key": "D0702.txt:919",
   "ko": "「어어어어디 세상에 위안 여행이나 가는 악의 비밀결사가 있냐아아! 바보 소리도 작작 해라!」"
  },
  {
   "id": 8390,
   "key": "D0702.txt:928",
   "ko": "「악의 비밀결사는 위안 여행을 가면 안 된다는 법률이 어느 주에 있는 것이냐!? 언제 제정된 것이냐!?」"
  },
  {
   "id": 8391,
   "key": "D0702.txt:931",
   "ko": "「몇 년 몇 월 며칠 몇 시 몇 분 몇 초 지구가 몇 바퀴 돌았을 때냐!? 에햐햐햐햐!」"
