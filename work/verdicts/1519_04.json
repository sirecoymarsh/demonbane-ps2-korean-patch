  {
   "id": 48706,
   "key": "D1519al_b.txt:286",
   "ko": "그것은､ 그저 살아가는 기쁨으로 가득 찬 노래였다｡"
  },
  {
   "id": 48707,
   "key": "D1519al_b.txt:289",
   "ko": "끊어지지 않는､"
  },
  {
   "id": 48708,
   "key": "D1519al_b.txt:290",
   "ko": "지워 없앨 수 없는､"
  },
  {
   "id": 48709,
   "key": "D1519al_b.txt:291",
   "ko": "그것은､"
  },
  {
   "id": 48710,
   "key": "D1519al_b.txt:294",
   "ko": "그것은――생명 찬가였다｡"
  },
  {
   "id": 48711,
   "key": "D1519al_b.txt:302",
   "ko": "빛의 너머｡ 노래에 맞춰 춤추는 그림자를 본다｡"
  },
  {
   "id": 48712,
   "key": "D1519al_b.txt:304",
   "ko": "소녀 같은 그림자가､ 청년 같은 그림자가､ 혹은 그 둘 다가､ 모습을 바꾸어｡ 용모를 바꾸어｡ 흐름을 바꾸어｡"
  },
  {
   "id": 48713,
   "key": "D1519al_b.txt:309",
   "ko": "「이것은――?」"
  },
  {
   "id": 48714,
   "key": "D1519al_b.txt:314",
   "ko": "「그런……」"
  },
  {
   "id": 48715,
   "key": "D1519al_b.txt:320",
   "ko": "춤이 끝났다｡"
  },
  {
   "id": 48716,
   "key": "D1519al_b.txt:322",
   "ko": "두 개의 그림자｡ 남자와 여자의 그림자｡ 빛 너머､ 빛의 중심에서 우리를 향해 손을 뻗는다｡"
  },
  {
   "id": 48717,
   "key": "D1519al_b.txt:331",
   "ko": "="
  },
  {
   "id": 48718,
   "key": "D1519al_b.txt:332",
   "ko": "="
  },
  {
   "id": 48719,
   "key": "D1519al_b.txt:333",
   "ko": "="
  },
  {
   "id": 48720,
   "key": "D1519al_b.txt:336",
   "ko": "『옛 인장』｡"
  },
  {
   "id": 48721,
   "key": "D1519al_b.txt:344",
   "ko": "『옛 인장』이 풀리고､ 마술 문자의 선이 되어 이중 나선을 그린다｡"
  },
  {
   "id": 48722,
   "key": "D1519al_b.txt:348",
   "ko": "="
  },
  {
   "id": 48723,
   "key": "D1519al_b.txt:349",
   "ko": "="
  },
  {
   "id": 48724,
   "key": "D1519al_b.txt:350",
   "ko": "강대한 존재가 자아내져 간다｡"
  },
  {
   "id": 48725,
   "key": "D1519al_b.txt:351",
   "ko": "짜여져 간다｡"
  },
  {
   "id": 48726,
   "key": "D1519al_b.txt:354",
   "ko": "용맹하고､ 정밀하고､ 강인하고､ 무엇보다 아름다운 존재가――"
  },
  {
   "id": 48727,
   "key": "D1519al_b.txt:363",
   "ko": "압도적인 기척의 폭발과 함께 현현한다｡ 폭발하듯 탄생한다｡"
  },
  {
   "id": 48728,
   "key": "D1519al_b.txt:366",
   "ko": "그 존재를 눈앞에 두고､ 탄생의 과정을 모두 지켜보며､ 우리는 생각했다｡"
  },
