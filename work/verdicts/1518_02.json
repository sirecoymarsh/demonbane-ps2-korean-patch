{
 "packet": "1518_02",
 "items": [
  {
   "id": 48357,
   "key": "D1518.txt:216",
   "ko": "애초에 의미 따위 바라지도 않고｡ 그 결착 이후､ 데몬베인은 이 우주로"
  },
  {
   "id": 48358,
   "key": "D1518.txt:221",
   "ko": "내던져졌다｡"
  },
  {
   "id": 48359,
   "key": "D1518.txt:221",
   "ko": "손상은 심하고 마력은 고갈되어､"
  },
  {
   "id": 48360,
   "key": "D1518.txt:222",
   "ko": "이젠 꿈쩍도 하지 않는다｡ 데몬베인은"
  },
  {
   "id": 48361,
   "key": "D1518.txt:225",
   "ko": "마침내 그 역할을 다한 것이다｡"
  },
  {
   "id": 48362,
   "key": "D1518.txt:227",
   "ko": "지금 이 순간까지 용케도､ 이런 사람 부리기 아니 로봇 부리기 험한 주인에게､"
  },
  {
   "id": 48363,
   "key": "D1518.txt:229",
   "ko": "약한 소리 하나 뱉지 않고 함께해 준 것이다｡ ……수고했어､ 데몬베인｡"
  },
  {
   "id": 48364,
   "key": "D1518.txt:237",
   "ko": "그래서､ 우리는 어떻게 되는 걸까｡"
  },
  {
   "id": 48365,
   "key": "D1518.txt:239",
   "ko": "애초에 여기가 언제 어디의 우주인지도 모른다｡"
  },
  {
   "id": 48366,
   "key": "D1518.txt:240",
   "ko": "어떻게든 움직여 보려 해도 이 꼴이다｡"
  },
  {
   "id": 48367,
   "key": "D1518.txt:241",
   "ko": "그렇다는 건､ 이대로 앉아서 죽음을 기다릴 뿐인가｡"
  },
  {
   "id": 48368,
   "key": "D1518.txt:243",
   "ko": "아니…… 왠지､"
  },
  {
   "id": 48369,
   "key": "D1518.txt:244",
   "ko": "지금 이 상태의 나는 이젠 죽을 수도 없을 것 같은 기분이 든다｡"
  },
  {
   "id": 48370,
   "key": "D1518.txt:245",
   "ko": "그런 영역을 넘어서 버린 것 같다｡ 그렇다는 건､"
  },
  {
   "id": 48371,
   "key": "D1518.txt:248",
   "ko": "이대로 미래영겁､ 별의 바다를 계속 떠도는 건가……｡"
  },
  {
   "id": 48372,
   "key": "D1518.txt:250",
   "ko": "――그것도 괜찮다고 생각했다｡ 애초에､"
  },
  {
   "id": 48373,
   "key": "D1518.txt:253",
   "ko": "처음부터 원래 세계로 돌아갈 수 있다곤 생각도 안 했다｡ 각오하고 있던 일이다｡"
  },
  {
   "id": 48374,
   "key": "D1518.txt:255",
   "ko": "게다가…… 나는 알의 머리를 헝클어뜨리며 쓰다듬고 있었다｡"
  },
  {
   "id": 48375,
   "key": "D1518.txt:262",
   "ko": "「……윽! 뭐냐､ 갑자기! 남의 머리를 함부로……!」"
  },
  {
   "id": 48376,
   "key": "D1518.txt:266",
   "ko": "항의의 목소리를 내는 알에게 나는 웃어 보인다｡"
  },
  {
   "id": 48377,
   "key": "D1518.txt:269",
   "ko": "「아니､ 뭐､ 이렇게…… 착하지 착하지 해 주려고 말이야」 「어린애 취급하지 마라! 실제로도 정신적으로도 그대 쪽이 훨씬 애송이다!」"
  },
  {
   "id": 48378,
   "key": "D1518.txt:279",
   "ko": "크크크 하고 소리를 죽이며 나는 웃는다｡"
  },
  {
   "id": 48379,
   "key": "D1518.txt:280",
   "ko": "알은 뾰로통해져서 고개를 홱 돌렸다｡ 그래｡"
  },
  {
   "id": 48380,
   "key": "D1518.txt:284",
   "ko": "지금 내 곁에는 이 녀석이 있다｡ 그렇다면 그 이상 무엇을 바라겠는가?"
  },
  {
   "id": 48381,
   "key": "D1518.txt:287",
   "ko": "충분하다｡"
  },
  {
   "id": 48382,
   "key": "D1518.txt:288",
   "ko": "나는 천벌이 내릴 만큼 충분히 행복한 놈이다｡"
  },
  {
   "id": 48383,
   "key": "D1518.txt:294",
   "ko": "쓰다듬는 것을 멈추고 살며시 알을 끌어안는다｡"
  },
  {
   "id": 48384,
   "key": "D1518.txt:295",
   "ko": "알은 처음엔 놀란 눈치였지만､"
  },
  {
   "id": 48385,
   "key": "D1518.txt:296",
   "ko": "곧 조용히 내 가슴에 몸을 맡겼다｡"
  },
  {
   "id": 48386,
   "key": "D1518.txt:297",
   "ko": "="
  },
  {
   "id": 48387,
   "key": "D1518.txt:301",
   "ko": "「쿠로…… 그대는」"
  },
  {
   "id": 48388,
   "key": "D1518.txt:304",
   "ko": "침묵을 깨고 알이 진지한 목소리로 말을 건다｡"
  },
  {
   "id": 48389,
   "key": "D1518.txt:306",
   "ko": "="
  },
  {
   "id": 48390,
   "key": "D1518.txt:307",
   "ko": "="
  },
  {
   "id": 48391,
   "key": "D1518.txt:309",
   "ko": "="
  },
  {
   "id": 48392,
   "key": "D1518.txt:311",
   "ko": "그래서 그 말이 이어지기도 전에 나는 대답한다｡"
  },
