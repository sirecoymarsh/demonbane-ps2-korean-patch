  {
   "id": 10998,
   "key": "D0715al.txt:177",
   "ko": "일단 이걸로 파란만장했던 출장 겸 바캉스는 마무리됐다｡"
  },
  {
   "id": 10999,
   "key": "D0715al.txt:180",
   "ko": "나머지 일은 앞으로 천천히 생각해 나가자……"
  },
  {
   "id": 11000,
   "key": "D0715al.txt:191",
   "ko": "아니､ 잠깐｡"
  },
  {
   "id": 11001,
   "key": "D0715al.txt:192",
   "ko": "하나 더､ 큰 문제가 있었다｡"
  },
  {
   "id": 11002,
   "key": "D0715al.txt:195",
   "ko": "그건―― 「…………………………」"
  },
  {
   "id": 11004,
   "key": "D0715al.txt:237",
   "ko": "「…………………………」"
  },
  {
   "id": 11006,
   "key": "D0715al.txt:242",
   "ko": "（있잖아 있잖아､ 라이카 누나……저 둘､ 뭔가 이상해?）"
  },
  {
   "id": 11007,
   "key": "D0715al.txt:247",
   "ko": "「음~? 쿠로 군~､ 알 양~､ 어이｡ 왜 그래? 싸우기라도 했어?」"
  },
  {
   "id": 11008,
   "key": "D0715al.txt:252",
   "ko": "「으윽!?」 「으윽!?」"
  },
  {
   "id": 11009,
   "key": "D0715al.txt:261",
   "ko": "화들짝! 서로 전기에 감전된 것처럼 등을 쭉 폈다｡"
  },
  {
   "id": 11010,
   "key": "D0715al.txt:263",
   "ko": "입에서 나오는 건 횡설수설､ 정리되지 않은 말뿐이었다｡"
  },
  {
   "id": 11011,
   "key": "D0715al.txt:268",
   "ko": "「아아아아아아아무것도 아냐! 아무것도 아니고 그거야! 그렇지! 알!」"
  },
  {
   "id": 11012,
   "key": "D0715al.txt:274",
   "ko": "「아아아아아아아､ 그래! 그렇고말고 그렇고말고! 그거다 그거! 그래､ 아니､ 그거라기보다 그……음! 요컨대 아무 문제 없느니라!」"
  },
  {
   "id": 11013,
   "key": "D0715al.txt:279",
   "ko": "우리 기세에 눌린 건지､ 멍한 표정 그대로 라이카 씨는 입을 다물어 버렸다｡"
  },
  {
   "id": 11014,
   "key": "D0715al.txt:282",
   "ko": "안 되겠다……너무 부자연스러워､ 나｡"
  },
  {
   "id": 11016,
   "key": "D0715al.txt:283",
   "ko": "이제 그만 진정해……진정하자｡"
  },
  {
   "id": 11018,
   "key": "D0715al.txt:288",
   "ko": "="
  },
  {
   "id": 11020,
   "key": "D0715al.txt:293",
   "ko": "자세를 풀고､ 시트에 기댄다｡"
  },
  {
   "id": 11021,
   "key": "D0715al.txt:294",
   "ko": "슬쩍 옆에 있는 알의 얼굴을 들여다봤다｡"
  },
  {
   "id": 11022,
   "key": "D0715al.txt:297",
   "ko": "비취색 눈동자｡"
  },
  {
   "id": 11023,
   "key": "D0715al.txt:298",
   "ko": "덧없을 만큼 하얀 피부｡ 자그마한 몸｡"
  },
  {
   "id": 11024,
   "key": "D0715al.txt:302",
   "ko": "이제 진작에 익숙해졌을 터다｡ 하지만……그런 일이 있었던 이상 앞으로는 어쩔 수 없이 의식하게 된다｡"
  },
  {
   "id": 11025,
   "key": "D0715al.txt:307",
   "ko": "「……무엇이냐?」"
  },
  {
   "id": 11026,
   "key": "D0715al.txt:312",
   "ko": "내 시선을 눈치챈 건지､ 알이 돌아본다｡"
  },
  {
   "id": 11027,
   "key": "D0715al.txt:313",
   "ko": "황급히 시선을 돌렸다｡ 「아니……아무것도」"
  },
  {
   "id": 11028,
   "key": "D0715al.txt:323",
   "ko": "「그런가……」 둘 다 또 입을 다물어 버린다｡"
  },
  {
   "id": 11029,
   "key": "D0715al.txt:336",
   "ko": "거북하다거나 어색한 것과는 다르지만､ 어쩐지 기묘한 공기가 흐르고 있다｡"
  },
  {
   "id": 11030,
   "key": "D0715al.txt:339",
   "ko": "이런 식으로 다시 평소 생활로 돌아갈 수 있을까……불안하다｡"
  },
  {
   "id": 11031,
   "key": "D0715al.txt:345",
   "ko": "「……걱정 마라」"
  },
  {
   "id": 11033,
   "key": "D0715al.txt:349",
   "ko": "「엇……?」"
  },
  {
   "id": 11034,
   "key": "D0715al.txt:355",
   "ko": "남의 마음을 꿰뚫어 본 듯이 알이 말을 걸어왔다｡"
  },
  {
   "id": 11035,
   "key": "D0715al.txt:356",
   "ko": "눈은 내 쪽을 보지 않은 채였지만｡"
  },
  {
   "id": 11036,
   "key": "D0715al.txt:362",
   "ko": "「애초에 이 몸과 그대는 처음부터 기묘한 관계가 아니더냐｡ 그것이 좀 더 기묘해진들 별로 대단한 문제도 아니니라……」"
  },
  {
   "id": 11037,
   "key": "D0715al.txt:370",
   "ko": "아무렇지 않게 말해 버린다……그런 걸까｡"
  },
  {
   "id": 11038,
   "key": "D0715al.txt:372",
   "ko": "당황하는 나에게､ 알이 돌아봤다｡"
  },
  {
   "id": 11039,
   "key": "D0715al.txt:373",
   "ko": "부끄러운 듯한､ 기쁜 듯한､ 그런 조금은 복잡한 미소를 띠고서｡"
  },
  {
   "id": 11040,
   "key": "D0715al.txt:375",
   "ko": "――왠지､ 심장이 두근거렸다｡"
  },
  {
   "id": 11041,
   "key": "D0715al.txt:381",
   "ko": "「이 몸은 말이다｡ 그대와 함께 있는 것이 이래 봬도 제법 기분 좋으니라｡ 그것이 조금 간지러워졌을 뿐인 일｡ 그렇다면 쓸데없이 의식할 것도 없느니라｡ 응?」"
  },
  {
   "id": 11042,
   "key": "D0715al.txt:386",
   "ko": "「――――――――」"
  },
  {
   "id": 11044,
   "key": "D0715al.txt:396",
   "ko": "――나중에 돌이켜보면､ 나는 바로 이 순간､ 이 건방진 인외 소녀에게 당해버린 건지도 모른다｡"
  }
 ]
