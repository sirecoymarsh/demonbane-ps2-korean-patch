  {
   "id": 7022,
   "key": "D0604.txt:138",
   "ko": "="
  },
  {
   "id": 7023,
   "key": "D0604.txt:144",
   "ko": "「쉬시는 중에 죄송합니다｡ 다이쥬지 님과 알 아지프 님께서 면회를 오셨습니다만……」"
  },
  {
   "id": 7024,
   "key": "D0604.txt:153",
   "ko": "「……저는 피곤합니다｡ 오늘은 돌아가시라고 전해 주세요」"
  },
  {
   "id": 7025,
   "key": "D0604.txt:160",
   "ko": "「알겠습니다｡ 그렇게 전해 두겠습니다」"
  },
  {
   "id": 7026,
   "key": "D0604.txt:167",
   "ko": "윈필드의 기척이 문 앞에서 멀어졌다｡ 가볍게 한숨을 쉬고､"
  },
  {
   "id": 7027,
   "key": "D0604.txt:175",
   "ko": "책상 위에 놓인 사진 액자를 손에 든다｡"
  },
  {
   "id": 7028,
   "key": "D0604.txt:178",
   "ko": "찍혀 있는 것은 아직 어릴 적의 자신과､ 다정하게 미소 짓는 부모님､ 그리고 할아버지｡ ――아무 의심도 없이 행복했던 시절의 사진이다｡"
  },
  {
   "id": 7029,
   "key": "D0604.txt:184",
   "ko": "하지만 그 행복의 그늘에는､ 늘 부조리한 사악이 도사리고 있었다｡"
  },
  {
   "id": 7030,
   "key": "D0604.txt:187",
   "ko": "아버지도 어머니도 할아버지도､ 그것과 계속 싸워왔던 것이다｡"
  },
  {
   "id": 7031,
   "key": "D0604.txt:188",
   "ko": "남몰래､ 줄곧｡"
  },
  {
   "id": 7032,
   "key": "D0604.txt:191",
   "ko": "지금의 자신에게､ 이때의 할아버지들 같은 강함이 있을까? 부조리에 굴하지 않고 계속 싸울 수 있을까? 루리는 자문한다｡"
  },
  {
   "id": 7033,
   "key": "D0604.txt:196",
   "ko": "지난날의 기억을 되새기면서｡"
  },
  {
   "id": 7034,
   "key": "D0604.txt:218",
   "ko": "「……큭!?」 ――왔다!"
  },
  {
   "id": 7035,
   "key": "D0604.txt:224",
   "ko": "저도 모르게 등줄기가 빳빳하게､ 곧게 펴진다｡"
  },
  {
   "id": 7036,
   "key": "D0604.txt:225",
   "ko": "고동이 빨라지는 심장｡ 숨이 가쁘다｡"
  },
  {
   "id": 7037,
   "key": "D0604.txt:232",
   "ko": "문이 천천히 열리고――"
  },
  {
   "id": 7038,
   "key": "D0604.txt:244",
   "ko": "「오래 기다리셨습니다､ 다이쥬지 님」"
  },
  {
   "id": 7039,
   "key": "D0604.txt:250",
   "ko": "하지만 들어온 건 집사님 한 명뿐｡ 공주님의 모습은 없다｡"
  },
  {
   "id": 7040,
   "key": "D0604.txt:254",
   "ko": "안도한 건지､ 맥이 풀린 건지､ 왈칵 피로가 밀려왔다｡ 힘없이 소파에서 미끄러져 내린다｡"
  },
  {
   "id": 7041,
   "key": "D0604.txt:260",
   "ko": "「……후우~」"
  },
  {
   "id": 7042,
   "key": "D0604.txt:266",
   "ko": "「죄송합니다｡ 루리 아가씨께서는 오늘은 이만 쉬시겠다고 하십니다｡ 날을 다시 잡아 주셨으면 한다고 하십니다」"
  },
  {
   "id": 7043,
   "key": "D0604.txt:271",
   "ko": "「앗……그렇습니까」"
  },
  {
   "id": 7044,
   "key": "D0604.txt:276",
   "ko": "「흥……너무 힘을 주었구나」"
  }
 ]
