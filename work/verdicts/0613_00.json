  {
   "id": 7803,
   "key": "D0613.txt:21",
   "ko": "「나왔구나､ 데몬베인! 크후후후후…… 진짜 귀계신의 힘､ 똑똑히 알려주겠어!」"
  },
  {
   "id": 7804,
   "key": "D0613.txt:35",
   "ko": "「……쿠로……쿠로」"
  },
  {
   "id": 7805,
   "key": "D0613.txt:41",
   "ko": "「………………」"
  },
  {
   "id": 7806,
   "key": "D0613.txt:47",
   "ko": "「……쿠로……쿠로!」"
  },
  {
   "id": 7807,
   "key": "D0613.txt:53",
   "ko": "「음……아아……들리고 있어……」 「싸울 거면 정신을 차려라｡ 적은 귀계신이다｡ 한순간의 틈이 목숨을 앗아간다」"
  },
  {
   "id": 7808,
   "key": "D0613.txt:65",
   "ko": "="
  },
  {
   "id": 7809,
   "key": "D0613.txt:77",
   "ko": "="
  },
  {
   "id": 7810,
   "key": "D0613.txt:80",
   "ko": "귀계신…… 벨제뷰트라고 했던가｡ 이렇게 대치하는 것만으로도 보통 파괴 로봇과는 격이 다르다는 걸 알 수 있다｡"
  },
  {
   "id": 7811,
   "key": "D0613.txt:83",
   "ko": "="
  },
  {
   "id": 7812,
   "key": "D0613.txt:85",
   "ko": "아니､ 이겨야만 한다｡ 그러기 위한 데몬베인이다｡"
  },
  {
   "id": 7813,
   "key": "D0613.txt:91",
   "ko": "「쿠로｡ 5분이다｡ 5분 안에 결판을 내라｡ 그것이 그대 몸의 한계니라」"
  },
  {
   "id": 7814,
   "key": "D0613.txt:102",
   "ko": "="
  },
  {
   "id": 7815,
   "key": "D0613.txt:107",
   "ko": "「애초에 그런 부상으로 싸우려는 것 자체가 무리다」"
  },
  {
   "id": 7816,
   "key": "D0613.txt:112",
   "ko": "="
  },
  {
   "id": 7817,
   "key": "D0613.txt:138",
   "ko": "땅을 미끄러지듯 돌진해 온 벨제뷰트의 팔이 데몬베인을 꿰뚫는다｡"
  },
  {
   "id": 7818,
   "key": "D0613.txt:157",
   "ko": "="
  },
  {
   "id": 7819,
   "key": "D0613.txt:163",
   "ko": "「같은 수에 걸릴 거라 생각한 거야!?」"
  },
  {
   "id": 7820,
   "key": "D0613.txt:187",
   "ko": "벨제뷰트의 입(?)에서 무언가의 액체가 발사되었다｡"
  },
  {
   "id": 7821,
   "key": "D0613.txt:189",
   "ko": "거울에 의한 술적 교란으로 저놈에게는 데몬베인이 보이지 않을 터｡ 하지만 벨제뷰트의 공격은 이쪽의 위치를 정확히 포착하고 있었다｡"
  },
  {
   "id": 7822,
   "key": "D0613.txt:210",
   "ko": "액체가 쏟아진다｡ 연기를 내뿜으며 히히이로카네 장갑이 순식간에 부식된다｡"
  },
  {
   "id": 7823,
   "key": "D0613.txt:216",
   "ko": "="
  },
  {
   "id": 7824,
   "key": "D0613.txt:237",
   "ko": "="
  },
  {
   "id": 7825,
   "key": "D0613.txt:238",
   "ko": "뒤에 있는 저택의 일부가 녹아내린다｡"
  },
  {
   "id": 7826,
   "key": "D0613.txt:254",
   "ko": "「자자자､ 어떻게 된 거야!? 도망만 다녀서는 아무것도 못 하잖아!?」"
  },
  {
   "id": 7827,
   "key": "D0613.txt:281",
   "ko": "="
  },
  {
   "id": 7828,
   "key": "D0613.txt:282",
   "ko": "하지만 5분이 한계라면 일격으로 끝내야 한다｡ 결정적인 틈이 필요하다｡"
  },
  {
   "id": 7829,
   "key": "D0613.txt:287",
   "ko": "「시시한 싸움 하지 마!」"
  },
  {
   "id": 7830,
   "key": "D0613.txt:306",
   "ko": "벨제뷰트의 주먹이 데몬베인을 쳤다｡ 동시에 고압 전류를 흘려 넣은 듯한 충격이 덮친다｡"
  },
  {
   "id": 7831,
   "key": "D0613.txt:341",
   "ko": "="
  },
  {
   "id": 7832,
   "key": "D0613.txt:347",
   "ko": "="
  },
  {
   "id": 7833,
   "key": "D0613.txt:348",
   "ko": "="
  },
  {
   "id": 7834,
   "key": "D0613.txt:367",
   "ko": "「크윽…… 어찌 된 것이냐､ 데몬베인!?」"
  },
  {
   "id": 7835,
   "key": "D0613.txt:374",
   "ko": "「――배드 트립 와인!」 「호호호호호호! 별것 아니로군! 그럼 이걸로 끝내주겠어!」"
  },
  {
   "id": 7836,
   "key": "D0613.txt:398",
   "ko": "벨제뷰트가 양손을 치켜든다｡ 그 사이에 눈부시게 타오르는 광구가 생겨났다｡"
  },
  {
   "id": 7837,
   "key": "D0613.txt:406",
   "ko": "광구는 점점 빛을 더해간다……뭔가 위험한 기운인데!?"
  },
  {
   "id": 7838,
   "key": "D0613.txt:415",
   "ko": "「크윽…… 방금 그것으로 마술 회로가 장기에 오염됐다! 회복까지 시간이 걸린다!」"
  },
  {
   "id": 7839,
   "key": "D0613.txt:424",
   "ko": "「마지막이야! 자､ 스스로의 힘으로……」"
  },
  {
   "id": 7840,
   "key": "D0613.txt:452",
   "ko": "그때 옆에서 무수한 빔탄이 벨제뷰트를 덮쳤다｡ 광탄의 비를 뒤집어쓰고 집중이 끊겼는지 광구는 사라진다｡"
  },
  {
   "id": 7841,
   "key": "D0613.txt:458",
   "ko": "="
  },
  {
   "id": 7842,
   "key": "D0613.txt:476",
   "ko": "양팔을 개틀링 포로 변형시킨 메타트론의 모습이 있었다｡ 회전하는 총신에서 연달아 발사되는 빔탄이 벨제뷰트를 친다｡"
  }
