{
 "packet": "0601_00",
 "items": [
  {
   "id": 6831,
   "key": "D0601.txt:33",
   "ko": "하늘은 피에 젖어 있었다｡"
  },
  {
   "id": 6832,
   "key": "D0601.txt:36",
   "ko": "="
  },
  {
   "id": 6833,
   "key": "D0601.txt:37",
   "ko": "애도하고､ 아파하기 위해｡"
  },
  {
   "id": 6834,
   "key": "D0601.txt:39",
   "ko": "꺼림칙하고 덧없는､ 붉음과 검음의 흑백｡"
  },
  {
   "id": 6835,
   "key": "D0601.txt:47",
   "ko": "헌화에 둘러싸인 두 사람의 얼굴을､ 흙에 묻히는 두 개의 관을 끝까지 지켜보고도 상복 차림의 소녀는 눈물 한 방울 보이지 않았다｡"
  },
  {
   "id": 6836,
   "key": "D0601.txt:50",
   "ko": "꼿꼿이 등을 펴고､ 고고하게､ 갸륵하게 소녀는 배웅한다｡"
  },
  {
   "id": 6837,
   "key": "D0601.txt:51",
   "ko": "결코 눈을 돌리지 않고｡ 결코 무너지지 않고｡"
  },
  {
   "id": 6838,
   "key": "D0601.txt:53",
   "ko": "결코｡ 결코｡"
  },
  {
   "id": 6839,
   "key": "D0601.txt:62",
   "ko": "황혼에 홀로 남겨진､ 소녀의 검은 그림자｡"
  },
  {
   "id": 6840,
   "key": "D0601.txt:64",
   "ko": "누구에게도 보이지 않고､ 누구에게도 알려지지 않는､ 고독의 어둠 속｡"
  },
  {
   "id": 6841,
   "key": "D0601.txt:67",
   "ko": "드디어､ 드디어 소녀는 울며 무너질 권리를 얻었다｡"
  },
  {
   "id": 6842,
   "key": "D0601.txt:68",
   "ko": "묘비에 매달려 흐느껴 운다｡"
  },
  {
   "id": 6843,
   "key": "D0601.txt:72",
   "ko": "――흐르는 눈물은 분명 무덤 아래의 죽은 이를 적신다｡"
  },
  {
   "id": 6844,
   "key": "D0601.txt:75",
   "ko": "마음이 닿지 못해 우는 자와 마음을 남기고 떠나는 자와――더 아픈 쪽은 과연 어느 쪽일까｡"
  },
  {
   "id": 6845,
   "key": "D0601.txt:78",
   "ko": "문득 석양을 커다란 그림자가 가로막았다｡"
  },
  {
   "id": 6846,
   "key": "D0601.txt:79",
   "ko": "울어 부은 눈 그대로 소녀는 돌아본다｡"
  },
  {
   "id": 6847,
   "key": "D0601.txt:82",
   "ko": "="
  },
  {
   "id": 6848,
   "key": "D0601.txt:85",
   "ko": "그 얼굴에 새겨진 깊은 주름은 고뇌의 나날의 증표――"
  },
  {
   "id": 6849,
   "key": "D0601.txt:87",
   "ko": "주름투성이의――균열투성이의 얼굴에､ 그는 또 여느 때처럼 깊은 비애를 숨기고 있다｡ 완만한 절망을 부정하기라도 하듯이｡"
  },
  {
   "id": 6850,
   "key": "D0601.txt:90",
   "ko": "소녀만이 아는､ 애처로운､ 할아버지의 맨몸의 모습｡"
  },
  {
   "id": 6851,
   "key": "D0601.txt:92",
   "ko": "하지만 그것은 늙은 새가 홀로 비를 견디며 하늘로 날아오를 때를 조용히 기다리는 모습처럼 고고하고､ 아름답다｡"
  },
  {
   "id": 6852,
   "key": "D0601.txt:95",
   "ko": "할아버지가 입을 열었다｡"
  },
  {
   "id": 6853,
   "key": "D0601.txt:98",
   "ko": "="
  },
  {
   "id": 6854,
   "key": "D0601.txt:99",
   "ko": "소녀는 할아버지가 사과하는 이유를 모른다｡ 의미를 모른다｡"
  },
  {
   "id": 6855,
   "key": "D0601.txt:103",
   "ko": "――알고 있었던 일인데｡"
  },
  {
   "id": 6856,
   "key": "D0601.txt:104",
   "ko": "――헤아리고 있었을 텐데｡"
  },
  {
   "id": 6857,
   "key": "D0601.txt:107",
   "ko": "그런 말을 깊은 후회와 함께 토해내고 있었다｡"
  },
  {
   "id": 6858,
   "key": "D0601.txt:108",
   "ko": "="
  },
  {
   "id": 6859,
   "key": "D0601.txt:111",
   "ko": "="
  },
  {
   "id": 6860,
   "key": "D0601.txt:112",
   "ko": "어쩌면 그것은 물음이 아니라 저주였을지도 모른다｡"
  },
  {
   "id": 6861,
   "key": "D0601.txt:115",
   "ko": "잔혹한 세계에､ 부조리한 세계에､ 어린 소녀가 쏟아붓는 있는 힘껏의 증오｡ 너무나도 치졸하고 절절한 증오｡"
  },
  {
   "id": 6862,
   "key": "D0601.txt:118",
   "ko": "쏟아낸 증오는 소녀를 상처 입히고､"
  },
  {
   "id": 6863,
   "key": "D0601.txt:119",
   "ko": "눈물은 이제 멈출 길이 없다｡ 소녀의 증오를､"
  },
  {
   "id": 6864,
   "key": "D0601.txt:123",
   "ko": "세계가 비웃는 무력한 증오를､ 할아버지는 받아냈다｡"
  },
  {
   "id": 6865,
   "key": "D0601.txt:127",
   "ko": "="
  },
  {
   "id": 6866,
   "key": "D0601.txt:128",
   "ko": "="
  },
  {
   "id": 6867,
   "key": "D0601.txt:129",
   "ko": "="
  },
  {
   "id": 6868,
   "key": "D0601.txt:139",
   "ko": "빛바래는 일 없이 마음에 새겨져 있다――｡"
  },
  {
   "id": 6869,
   "key": "D0601.txt:184",
   "ko": "="
  },
  {
   "id": 6870,
   "key": "D0601.txt:200",
   "ko": "「……뭐냐､ 뭐냐? 또 어두워졌구나｡ 이번엔 무엇을 고민하고 있느냐?」"
  }
 ]
}