{
 "packet": "ep_ruri02a_01",
 "items": [
  {
   "id": 50573,
   "key": "ep_ruri02a.txt:110",
   "ko": "――그 사람은 돌아오지 않는다｡ 문이 닫히고 1년｡"
  },
  {
   "id": 50574,
   "key": "ep_ruri02a.txt:121",
   "ko": "사람들은 그토록 처절했던 싸움을 잊어 가고 있었다｡"
  },
  {
   "id": 50575,
   "key": "ep_ruri02a.txt:122",
   "ko": "무겁게 짓누르는 과거보다 내일을 살아가는 게 힘드니까｡ 소중하니까｡"
  },
  {
   "id": 50576,
   "key": "ep_ruri02a.txt:123",
   "ko": "내일을 바라보고 있으면 세계는 제대로 돌아간다｡"
  },
  {
   "id": 50577,
   "key": "ep_ruri02a.txt:124",
   "ko": "다만 나는､ 나만은 계속 기다린다｡"
  },
  {
   "id": 50578,
   "key": "ep_ruri02a.txt:125",
   "ko": "세계가 망각하는 기억의 틈새에서 그 사람을 계속 기다린다｡"
  },
  {
   "id": 50579,
   "key": "ep_ruri02a.txt:128",
   "ko": "문이 닫히고――――――――――"
  },
  {
   "id": 50580,
   "key": "ep_ruri02a.txt:135",
   "ko": "「…………………………거짓말쟁이」"
  },
  {
   "id": 50581,
   "key": "ep_ruri02a.txt:148",
   "ko": "「루리 아가씨､ 실례하겠습니다」"
  },
  {
   "id": 50582,
   "key": "ep_ruri02a.txt:154",
   "ko": "「무슨 일인가요､ 윈필드?」"
  },
  {
   "id": 50583,
   "key": "ep_ruri02a.txt:158",
   "ko": "「예､ 지난번 킹스포트 개발에 관한 건입니다만」"
  },
  {
   "id": 50584,
   "key": "ep_ruri02a.txt:162",
   "ko": "「어머? 그 건에 관해서는 전부 위임했을 텐데요」"
  },
  {
   "id": 50585,
   "key": "ep_ruri02a.txt:166",
   "ko": "「조금 성가신 문제가 생겨서요｡ 이것이 그 건에 관한 서류입니다」"
  },
  {
   "id": 50586,
   "key": "ep_ruri02a.txt:171",
   "ko": "「후우……｡ 알겠어요｡ 지금은 급한 일이 있으니 거기 놓아두세요｡ 나중에 훑어보겠어요」"
  },
  {
   "id": 50587,
   "key": "ep_ruri02a.txt:175",
   "ko": "「알겠습니다」 「………………」"
  },
  {
   "id": 50588,
   "key": "ep_ruri02a.txt:183",
   "ko": "「………………」 「……아직 무슨 일이라도?」"
  },
  {
   "id": 50589,
   "key": "ep_ruri02a.txt:193",
   "ko": "「아닙니다｡ 다만…… 요즘 아가씨께서 또 무리하고 계신 듯하여｡ 몸을 돌보지 않으시면 건강을 해치십니다」"
  },
  {
   "id": 50590,
   "key": "ep_ruri02a.txt:200",
   "ko": "「……바쁘게 움직이는 편이 마음이 편하거든요」"
  },
  {
   "id": 50591,
   "key": "ep_ruri02a.txt:204",
   "ko": "「아가씨…… 역시」"
  },
  {
   "id": 50592,
   "key": "ep_ruri02a.txt:208",
   "ko": "「――저는 계속 기다리겠어요｡ 그렇게 약속했으니까요｡ 제 쪽에서 어길 수는 없는 노릇이지요」"
  },
  {
   "id": 50593,
   "key": "ep_ruri02a.txt:213",
   "ko": "「…………예」"
  },
  {
   "id": 50594,
   "key": "ep_ruri02a.txt:219",
   "ko": "「……물러가도 좋아요､ 윈필드｡ 아､ 그렇지…… 조금 있다 차를 마실까요｡ 당신 말대로 숨 돌리는 것도 필요하겠네요」"
  },
  {
   "id": 50595,
   "key": "ep_ruri02a.txt:225",
   "ko": "「알겠습니다｡ 마침 오늘 아침에 최상급이 도착했으니까요」"
  },
  {
   "id": 50596,
   "key": "ep_ruri02a.txt:229",
   "ko": "「예…… 부탁해요」 「그럼 실례하겠습니다」"
  },
  {
   "id": 50597,
   "key": "ep_ruri02a.txt:247",
   "ko": "「우와와와와왓!?」"
  },
  {
   "id": 50598,
   "key": "ep_ruri02a.txt:255",
   "ko": "「당신들…… 엿듣고 있었지요?」"
  },
  {
   "id": 50599,
   "key": "ep_ruri02a.txt:261",
   "ko": "「아핫…… 아하하…… 아하하하하하､ 예요」"
  },
  {
   "id": 50600,
   "key": "ep_ruri02a.txt:267",
   "ko": "「하하…… 죄송해요｡ 그래도 역시 아가씨 상태가 신경 쓰여서요……」"
  },
  {
   "id": 50601,
   "key": "ep_ruri02a.txt:271",
   "ko": "「이런이런…… 어쩔 수 없는 사람들이군요」"
  },
  {
   "id": 50602,
   "key": "ep_ruri02a.txt:275",
   "ko": "「――아가씨는 아직도 다이쥬지 님을?」"
  },
  {
   "id": 50603,
   "key": "ep_ruri02a.txt:279",
   "ko": "「간단히 정리될 수 있는 일이 아니지요」"
  },
  {
   "id": 50604,
   "key": "ep_ruri02a.txt:283",
   "ko": "「하지만 다이쥬지 씨는 이제……｡ 애초에 돌아온다면 문이 사라졌을 때에……」"
  },
  {
   "id": 50605,
   "key": "ep_ruri02a.txt:288",
   "ko": "「저는 믿고 있습니다」 「예?」"
  },
  {
   "id": 50606,
   "key": "ep_ruri02a.txt:298",
   "ko": "「루리 아가씨께서 믿고 계시다면 저도 믿을 뿐입니다｡ 애초에 다이쥬지 님 자신이 상식이 통하는 분이 아니시니까요――」"
  },
  {
   "id": 50607,
   "key": "ep_ruri02a.txt:310",
   "ko": "「………………하아」"
  },
  {
   "id": 50608,
   "key": "ep_ruri02a.txt:313",
   "ko": "윈필드가 나간 것을 확인하고 나는 책상에 엎드렸다｡"
  },
  {
   "id": 50609,
   "key": "ep_ruri02a.txt:315",
   "ko": "뺨을 맥없이 책상에 맡긴 채 움직이지 못하고 있다｡"
  },
  {
   "id": 50610,
   "key": "ep_ruri02a.txt:316",
   "ko": "쌓인 피로가 중력에 이끌려 내 몸을 붙잡아 둔다｡"
  },
  {
   "id": 50611,
   "key": "ep_ruri02a.txt:318",
   "ko": "마음에 내려 쌓이는 나태와 우울｡"
  },
  {
   "id": 50612,
   "key": "ep_ruri02a.txt:319",
   "ko": "그리고 무엇보다 꺼림칙한――체념｡"
  }
 ]
}