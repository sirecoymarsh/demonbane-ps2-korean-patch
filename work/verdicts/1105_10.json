{
 "packet": "1105_10",
 "items": [
  {
   "id": 23995,
   "key": "D1105ru.txt:97",
   "ko": "주인을 잃을 때마다"
  },
  {
   "id": 23996,
   "key": "D1105ru.txt:98",
   "ko": "그 죽음을 지켜볼 때마다"
  },
  {
   "id": 23997,
   "key": "D1105ru.txt:99",
   "ko": "소녀는 지쳐갔다｡"
  },
  {
   "id": 23998,
   "key": "D1105ru.txt:100",
   "ko": "그런 자신도 깨닫지 못했다｡"
  },
  {
   "id": 23999,
   "key": "D1105ru.txt:102",
   "ko": "그리고 소녀는 이 시점에 이르러서도 여전히､ 자신을 속여넘길 수 있다고 믿고 있다｡"
  },
  {
   "id": 24000,
   "key": "D1105ru.txt:103",
   "ko": "가슴을 할퀴고 싶어질 만큼의 초조함에 타오르면서도､ 그럼에도 불구하고､ 사명에 따라 살아가는 자신의 모습에 매달린다｡"
  },
  {
   "id": 24001,
   "key": "D1105ru.txt:105",
   "ko": "그래서 깨닫지 못한다｡"
  },
  {
   "id": 24002,
   "key": "D1105ru.txt:106",
   "ko": "초조함의 또 다른 정체를｡"
  },
  {
   "id": 24003,
   "key": "D1105ru.txt:108",
   "ko": "죄책감보다도 절실하고 비통하게､ 소녀의 마음을 유린하는 그것｡"
  },
  {
   "id": 24004,
   "key": "D1105ru.txt:109",
   "ko": "다이쥬지 쿠로에 대한 마음｡"
  },
  {
   "id": 24005,
   "key": "D1105ru.txt:110",
   "ko": "그것은――"
  },
  {
   "id": 24006,
   "key": "D1105ru.txt:114",
   "ko": "「……진정해｡ 자신을 잃지 마､ 알 아지프」"
  },
  {
   "id": 24007,
   "key": "D1105ru.txt:118",
   "ko": "모든 초조함을 억지로 가두고､ 자물쇠를 걸고､ 소녀는 출구 없는 사고의 나선에서 빠져나왔다고 생각했다｡"
  },
  {
   "id": 24008,
   "key": "D1105ru.txt:119",
   "ko": "다시 한 번､ 확실히 쿠로의 얼굴을 눈에 새긴다｡"
  },
  {
   "id": 24009,
   "key": "D1105ru.txt:123",
   "ko": "「――쿠로」"
  },
  {
   "id": 24010,
   "key": "D1105ru.txt:126",
   "ko": "경의가 있다｡"
  },
  {
   "id": 24011,
   "key": "D1105ru.txt:127",
   "ko": "수많은 술사를､ 죽음으로 몰아넣은 자신이라도､"
  },
  {
   "id": 24012,
   "key": "D1105ru.txt:128",
   "ko": "자신의 주인을 부품으로밖에 여기지 않는 자신이라도､"
  },
  {
   "id": 24013,
   "key": "D1105ru.txt:129",
   "ko": "그래도 그들､ 사신과 싸우는 자들에 대한 경의는 있다｡"
  },
  {
   "id": 24014,
   "key": "D1105ru.txt:131",
   "ko": "그것이 그들에게 무의미하다 해도､ 경의를 표하는 것이 면죄부도､ 변명조차 되지 않는 행위라는 것을 뻔히 알고 있어도､ 그것은 중요한 일이다｡"
  },
  {
   "id": 24015,
   "key": "D1105ru.txt:132",
   "ko": "어긋나서는 안 되는､ 최소한의 영역이다｡"
  },
  {
   "id": 24016,
   "key": "D1105ru.txt:134",
   "ko": "다이쥬지 쿠로에 대해 경의가 있다면――그의 의지를 사라지게 해서는 안 된다｡"
  },
  {
   "id": 24017,
   "key": "D1105ru.txt:136",
   "ko": "그가､ 외도의 지식인 자신을 받아들이면서까지 하려고 했던 일｡"
  },
  {
   "id": 24018,
   "key": "D1105ru.txt:136",
   "ko": "『블랙로지』를 쓰러뜨리고､ 이 아컴시티를 지키는 것｡"
  },
  {
   "id": 24019,
   "key": "D1105ru.txt:136",
   "ko": "그의 눈에 비치는 세계를 지키는 것｡"
  },
  {
   "id": 24020,
   "key": "D1105ru.txt:138",
   "ko": "그 의지를 사라지게 해서는 안 된다｡"
  },
  {
   "id": 24021,
   "key": "D1105ru.txt:140",
   "ko": "그 의지를 대행하는 것은､ 다른 누구도 아닌､ 자신이 해야만 한다｡"
  },
  {
   "id": 24022,
   "key": "D1105ru.txt:149",
   "ko": "「미안하다｡ 이 몸이 못난 탓이다｡ 이제 더는 결코､ 그놈들에게 방심하지 않으리라｡ 맡겨 두어라」"
  },
  {
   "id": 24023,
   "key": "D1105ru.txt:155",
   "ko": "비취빛 눈동자가､ 전사의 의지를 품고､ 빛난다｡"
  },
  {
   "id": 24024,
   "key": "D1105ru.txt:159",
   "ko": "마지막으로 한 번 돌아보고､ 소녀는 쿠로에게 등을 돌리고､ 의무실을 뒤로했다｡"
  },
  {
   "id": 24025,
   "key": "D1105ru.txt:160",
   "ko": "그녀의 전장을 향해､ 걸어 나간다｡"
  }
 ]
}