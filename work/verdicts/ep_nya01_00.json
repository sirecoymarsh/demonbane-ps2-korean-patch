  {
   "id": 49921,
   "key": "ep_nya01.txt:142",
   "ko": "서걱서걱서걱서걱｡"
  },
  {
   "id": 49922,
   "key": "ep_nya01.txt:149",
   "ko": "「빨리 안 하면 지각한다?」"
  },
  {
   "id": 49923,
   "key": "ep_nya01.txt:152",
   "ko": "그 말이 맞았다｡"
  },
  {
   "id": 49924,
   "key": "ep_nya01.txt:153",
   "ko": "늦으면 큰일이다｡ 나는 양수 속에서 벌떡 일어나 학교 갈 준비를 했다｡"
  },
  {
   "id": 49925,
   "key": "ep_nya01.txt:159",
   "ko": "="
  },
  {
   "id": 49926,
   "key": "ep_nya01.txt:168",
   "ko": "「꺄앙! 오빠 변태☆」 여동생을 내쫓고 옷을 갈아입는다｡"
  },
  {
   "id": 49927,
   "key": "ep_nya01.txt:177",
   "ko": "커튼을 힘차게 열자､"
  },
  {
   "id": 49928,
   "key": "ep_nya01.txt:178",
   "ko": "극채색의 하늘이 뚝뚝 떨어지고 있었다｡ 바람이 달콤한 부패취를 실어온다｡"
  },
  {
   "id": 49929,
   "key": "ep_nya01.txt:180",
   "ko": "기분 좋은 봄 냄새였다｡"
  },
  {
   "id": 49930,
   "key": "ep_nya01.txt:181",
   "ko": "오늘도 날씨가 좋다｡"
  },
  {
   "id": 49931,
   "key": "ep_nya01.txt:192",
   "ko": "식탁에 앉았다｡"
  },
