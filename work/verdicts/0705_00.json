  },
  {
   "id": 8792,
   "key": "D0705.txt:103",
   "ko": "온천에 몸을 담근 채 데운 술을 기울이고 있는 건 다름 아닌 그 나이아 씨였다｡"
  },
  {
   "id": 8793,
   "key": "D0705.txt:106",
   "ko": "어째서 오늘은 이렇게 우연히도 아는 얼굴과 마주치는 거지!?"
  },
  {
   "id": 8794,
   "key": "D0705.txt:115",
   "ko": "「이거､ 이거 우연이군 우연｡ 쿠로 군도 휴가 왔나?」"
  },
  {
   "id": 8795,
   "key": "D0705.txt:121",
   "ko": "「……아니 나이아 씨! 어､ 어째서 이쪽으로 다가오는 거야!?」"
  },
  {
   "id": 8796,
   "key": "D0705.txt:127",
   "ko": "「응? 냐하하하하｡ 별로 상관없잖아｡ 너와 나 사이인데?」"
  },
  {
   "id": 8797,
   "key": "D0705.txt:137",
   "ko": "「어､ 어떤 사이야!? 우와왓､ 보통 껴안냐고!」"
  },
  {
   "id": 8798,
   "key": "D0705.txt:143",
   "ko": "「자자､ 그렇게 굳어지지 말고｡ 알몸의 교제라도 나눠보자고」"
  },
  {
   "id": 8799,
   "key": "D0705.txt:148",
   "ko": "「당신도 취한 거야!? 애초에 여기 남탕이잖아!?」"
  },
  {
   "id": 8800,
   "key": "D0705.txt:154",
   "ko": "="
  },
  {
   "id": 8801,
   "key": "D0705.txt:159",
   "ko": "="
  },
  {
   "id": 8802,
   "key": "D0705.txt:160",
   "ko": "="
  },
  {
   "id": 8803,
   "key": "D0705.txt:163",
   "ko": "="
  },
  {
   "id": 8804,
   "key": "D0705.txt:164",
   "ko": "="
  },
  {
   "id": 8805,
   "key": "D0705.txt:169",
   "ko": "「음~ 살결이 곱네｡ 쿠로 군?」"
  },
  {
   "id": 8806,
   "key": "D0705.txt:175",
   "ko": "「자､ 잠깐!?」 나이아 씨는 껴안은 채로 내 몸을 쓰다듬어 댄다｡"
  },
  {
   "id": 8807,
   "key": "D0705.txt:182",
   "ko": "귓가에서 키득키득､ 짓궂은 웃음소리를 흘렸다｡"
  },
  {
   "id": 8808,
   "key": "D0705.txt:187",
   "ko": "「우왓! 가､ 간지럽다니까! 아……아으윽! 응……아니､ 그러니까､ 그만――햐아아앗!?」 「이야아……좋은 소리로 우는구나｡ 자아……」"
  },
  {
   "id": 8809,
   "key": "D0705.txt:209",
   "ko": "「아우아앗! 나､ 나이아 씨! 노､ 농담에도 한도라는 게……!」"
  },
  {
   "id": 8810,
   "key": "D0705.txt:219",
   "ko": "「――아무래도 순조롭게 위계를 오르고 있는 모양이군」"
  }
 ]
