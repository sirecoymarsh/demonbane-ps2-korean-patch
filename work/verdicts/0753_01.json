{
 "packet": "0753_01",
 "items": [
  {
   "id": 11429,
   "key": "D0753.txt:187",
   "ko": "「커헉!」"
  },
  {
   "id": 11430,
   "key": "D0753.txt:190",
   "ko": "이타콰의 손이 내 목을 붙잡았다｡"
  },
  {
   "id": 11431,
   "key": "D0753.txt:191",
   "ko": "손가락에 힘을 주어 목을 죄어 온다｡"
  },
  {
   "id": 11432,
   "key": "D0753.txt:194",
   "ko": "하지만 그 자체는 견딜 만했다｡ 다소 괴롭긴 해도 이타콰에게는 이대로 목을 졸라 기절시키거나 부러뜨릴 의도는 없는 모양이다｡"
  },
  {
   "id": 11433,
   "key": "D0753.txt:196",
   "ko": "그보다 심각한 것은――"
  },
  {
   "id": 11434,
   "key": "D0753.txt:204",
   "ko": "차가움이었다｡"
  },
  {
   "id": 11435,
   "key": "D0753.txt:206",
   "ko": "온몸의 열이 단숨에 빼앗겼다｡"
  },
  {
   "id": 11436,
   "key": "D0753.txt:207",
   "ko": "냉기는 찌르듯이､ 아니 찢어발기듯이 몸을 괴롭힌다｡"
  },
  {
   "id": 11437,
   "key": "D0753.txt:210",
   "ko": "「으앗…… 크윽…… 카아앗……읏!」"
  },
  {
   "id": 11438,
   "key": "D0753.txt:213",
   "ko": "손끝에 서리가 들러붙어 있다｡ 붙잡힌 목은 얇은 얼음 막에 뒤덮여 버렸다｡"
  },
  {
   "id": 11439,
   "key": "D0753.txt:220",
   "ko": "멀쩡한 생물이라면 결코 살아 있을 수 없을 만큼의 저온｡ 하지만 이상하게도 내 몸은 죽음에 이르지 않는다｡"
  },
  {
   "id": 11440,
   "key": "D0753.txt:224",
   "ko": "다만…… 몸속으로 스며드는 냉기는 신체 기관을 빠르게 침식하며､ 내 육체를 인간과는 다른 완전히 이질적인 생물로 바꿔 놓으려 하고 있었다｡"
  },
  {
   "id": 11441,
   "key": "D0753.txt:227",
   "ko": "웃기지 마……! 괴물 놈들 동료 따위가 될까 보냐……!"
  },
  {
   "id": 11442,
   "key": "D0753.txt:232",
   "ko": "「으아앗……!」"
  },
  {
   "id": 11443,
   "key": "D0753.txt:235",
   "ko": "이타콰의 팔을 붙잡으려 한다…… 하지만 곱은 손은 마음대로 움직이지 않는다｡ 애초에 팔에 힘이 들어가지 않는다｡"
  },
  {
   "id": 11444,
   "key": "D0753.txt:238",
   "ko": "……좋지 않은 상황이다｡"
  },
  {
   "id": 11445,
   "key": "D0753.txt:247",
   "ko": "「――――훗」"
  },
  {
   "id": 11446,
   "key": "D0753.txt:258",
   "ko": "이타콰의 얼굴이 다가온다｡"
  },
  {
   "id": 11447,
   "key": "D0753.txt:259",
   "ko": "입술이 겹쳐진다｡"
  },
  {
   "id": 11448,
   "key": "D0753.txt:260",
   "ko": "냉기가 흘러 들어온다｡"
  },
  {
   "id": 11449,
   "key": "D0753.txt:263",
   "ko": "몸속을 눈보라가 관통했다｡"
  },
  {
   "id": 11450,
   "key": "D0753.txt:264",
   "ko": "몸의 골수까지 얼어붙는 감각｡"
  },
  {
   "id": 11451,
   "key": "D0753.txt:267",
   "ko": "의식이 멀어진다｡"
  },
  {
   "id": 11452,
   "key": "D0753.txt:268",
   "ko": "이건…… 위험하다……읏｡"
  },
  {
   "id": 11453,
   "key": "D0753.txt:274",
   "ko": "의식이 끊기기 직전이었다｡"
  },
  {
   "id": 11454,
   "key": "D0753.txt:279",
   "ko": "「――――읏!?」"
  },
  {
   "id": 11455,
   "key": "D0753.txt:296",
   "ko": "냉기를 몰아내듯 돌연 몸속 깊은 곳에서 솟아오르는 열기｡ 눈 깜짝할 새 온몸에 퍼져､ 냉기에 침식된 내 몸을 치유한다｡"
  },
  {
   "id": 11456,
   "key": "D0753.txt:299",
   "ko": "튕겨 나가듯 이타콰는 손을 놓았다｡"
  },
  {
   "id": 11457,
   "key": "D0753.txt:300",
   "ko": "나는 그 자리에 허물어진다｡"
  },
  {
   "id": 11458,
   "key": "D0753.txt:303",
   "ko": "……무슨 일이 일어난 거지?"
  },
  {
   "id": 11459,
   "key": "D0753.txt:304",
   "ko": "무엇이 나를 구한 거지?"
  },
  {
   "id": 11460,
   "key": "D0753.txt:308",
   "ko": "회랑 안쪽이 아지랑이로 일렁였다｡"
  },
  {
   "id": 11461,
   "key": "D0753.txt:309",
   "ko": "이타콰와는 정반대로 열기를 뿜는 존재가 다가오고 있다｡"
  },
  {
   "id": 11462,
   "key": "D0753.txt:322",
   "ko": "눈부신 빛이 그림자놀이 같은 세계를 물들인다｡ 하얀 불꽃에 휩싸인 한 마리 짐승이 어둠 속에서 모습을 드러낸다｡"
  },
  {
   "id": 11463,
   "key": "D0753.txt:324",
   "ko": "이건……!?"
  },
  {
   "id": 11464,
   "key": "D0753.txt:338",
   "ko": "「크투가!?」"
  },
  {
   "id": 11465,
   "key": "D0753.txt:341",
   "ko": "짐승의 모습이었다｡ 크기는 작고 광도도 낮다｡"
  },
  {
   "id": 11466,
   "key": "D0753.txt:342",
   "ko": "무엇보다 주위를 녹여 버릴 만한 고열은 내뿜지 않고 있다｡"
  },
  {
   "id": 11467,
   "key": "D0753.txt:345",
   "ko": "하지만 틀림없다｡"
  },
  {
   "id": 11468,
   "key": "D0753.txt:346",
   "ko": "이 마력의 기척…… 분명 크투가다｡"
  }
 ]
}