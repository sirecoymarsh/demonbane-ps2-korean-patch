{
 "packet": "0753_02",
 "items": [
  {
   "id": 11469,
   "key": "D0753.txt:347",
   "ko": "어째서 이런 곳에……?"
  },
  {
   "id": 11470,
   "key": "D0753.txt:357",
   "ko": "그래｡ 그때 마총이 폭발해서…… 혹시 그래서 풀려난 건가?"
  },
  {
   "id": 11471,
   "key": "D0753.txt:379",
   "ko": "지구상의 어떤 생명도 낼 수 없는 울부짖음이 회랑을 뒤흔든다｡"
  },
  {
   "id": 11472,
   "key": "D0753.txt:381",
   "ko": "불꽃의 짐승은 이타콰를 위협하듯 노려보고 있었다｡ 이타콰는 경계하는 것인지 굳은 채 움직이지 않는다｡"
  },
  {
   "id": 11473,
   "key": "D0753.txt:384",
   "ko": "그건 그렇고…… 이타콰에 크투가､ 인가｡"
  },
  {
   "id": 11474,
   "key": "D0753.txt:385",
   "ko": "어쩐지 상황은 악화 일로를 걷고 있는 것 같은데｡"
  },
  {
   "id": 11475,
   "key": "D0753.txt:388",
   "ko": "그래도 몸속 냉기가 사라진 건 크투가의 마력 덕분인 듯하다｡ 크투가는 어째서 나를 구한 거지?"
  },
  {
   "id": 11476,
   "key": "D0753.txt:394",
   "ko": "「――――읏」"
  },
  {
   "id": 11477,
   "key": "D0753.txt:400",
   "ko": "불리함을 깨달았는지 등을 돌려 달아나려는 이타콰｡ 하지만 크투가가 더 빨랐다｡"
  },
  {
   "id": 11478,
   "key": "D0753.txt:410",
   "ko": "「…………읏!?」"
  },
  {
   "id": 11479,
   "key": "D0753.txt:433",
   "ko": "이타콰의 퇴로를 타오르는 불길이 가로막았다｡"
  },
  {
   "id": 11480,
   "key": "D0753.txt:434",
   "ko": "회랑을 가득 메운 불의 벽이 앞을 막고 있다｡"
  },
  {
   "id": 11481,
   "key": "D0753.txt:437",
   "ko": "이타콰가 다음 행동에 옮기기 전에 짐승이 움직였다｡"
  },
  {
   "id": 11482,
   "key": "D0753.txt:438",
   "ko": "열파를 몰고 단숨에 이타콰에게까지 질주한다｡"
  },
  {
   "id": 11483,
   "key": "D0753.txt:441",
   "ko": "크투가에게서 뿜어져 나오는 열풍에 그을려 내 온몸에서 땀이 솟구쳤다｡"
  },
  {
   "id": 11484,
   "key": "D0753.txt:448",
   "ko": "「N'GAAA――――――iii!」"
  },
  {
   "id": 11485,
   "key": "D0753.txt:453",
   "ko": "「……아아아아앗!」"
  },
  {
   "id": 11486,
   "key": "D0753.txt:457",
   "ko": "불꽃의 짐승이 이타콰에게 달려든다｡"
  },
  {
   "id": 11487,
   "key": "D0753.txt:458",
   "ko": "여자를 쓰러뜨려 짓누르고 움직임을 봉한다｡"
  },
  {
   "id": 11488,
   "key": "D0753.txt:469",
   "ko": "하얀 불꽃이 솟구친다｡ 불꽃은 거세게 타올라 기둥이 되어 소용돌이치며 짐승과 여자를 삼켰다｡"
  },
  {
   "id": 11489,
   "key": "D0753.txt:474",
   "ko": "「아아아아――――앗!」"
  },
  {
   "id": 11490,
   "key": "D0753.txt:478",
   "ko": "나는 아무것도 하지 못한 채 그저 멍하니 불꽃을 바라볼 뿐이다｡ 이윽고 불꽃 속에서 흔들리듯 일어서는 사람 그림자를 보았다｡"
  },
  {
   "id": 11491,
   "key": "D0753.txt:483",
   "ko": "「어?」"
  },
  {
   "id": 11492,
   "key": "D0753.txt:490",
   "ko": "불꽃 속에서 나온 것은――이타콰가 아니었다｡"
  },
  {
   "id": 11493,
   "key": "D0753.txt:493",
   "ko": "여러 개의 광구를 거느리고 걷는､ 역시나 장신의 여자｡"
  },
  {
   "id": 11494,
   "key": "D0753.txt:495",
   "ko": "갈색 피부 위에 걸친 옷은 공격성을 상징하려는 것인지 군복처럼 보이기도 한다｡"
  },
  {
   "id": 11495,
   "key": "D0753.txt:497",
   "ko": "……아､ 이제 대충 짐작이 간다｡"
  },
  {
   "id": 11496,
   "key": "D0753.txt:498",
   "ko": "마력의 기척을 더듬으면 금방 알 수 있겠지｡"
  },
  {
   "id": 11497,
   "key": "D0753.txt:507",
   "ko": "「……후훗」"
  },
  {
   "id": 11498,
   "key": "D0753.txt:516",
   "ko": "정열적인 눈동자가 나를 응시하고 있다｡"
  },
  {
   "id": 11499,
   "key": "D0753.txt:517",
   "ko": "감정의 움직임에 맞추듯 주위의 화구가 밝게 어둡게 명멸한다｡"
  },
  {
   "id": 11500,
   "key": "D0753.txt:522",
   "ko": "「……크투가인가」"
  },
  {
   "id": 11501,
   "key": "D0753.txt:530",
   "ko": "「잘도 알아보았구나､ 주인이여」"
  },
  {
   "id": 11502,
   "key": "D0753.txt:534",
   "ko": "놀랐다｡ 설마 말을 할 줄이야｡"
  },
  {
   "id": 11503,
   "key": "D0753.txt:535",
   "ko": "예상을 비껴가도 한참 비껴간 느낌이다｡"
  },
  {
   "id": 11504,
   "key": "D0753.txt:543",
   "ko": "「놀랄 일이 아니다｡ 이 몸 또한 『알 아지프』의 일부｡ 어미의 영력을 근원으로 인격을 이루었을 따름이다」"
  },
  {
   "id": 11505,
   "key": "D0753.txt:548",
   "ko": "「어미……? 아､ 혹시 알 얘긴가」"
  },
  {
   "id": 11506,
   "key": "D0753.txt:553",
   "ko": "「그렇다｡ 어미가 주인으로 택한 사내｡ 흥미가 일어 말을 걸어 보았다」"
  },
  {
   "id": 11507,
   "key": "D0753.txt:557",
   "ko": "「허나…… 우리 같은 파편을 상대로 이토록 무참히 당해서야､ 『알 아지프』의 마스터 노릇은 못 하지 않겠느냐?」"
  },
  {
   "id": 11508,
   "key": "D0753.txt:562",
   "ko": "「칫…… 내버려 둬」"
  }
 ]
}