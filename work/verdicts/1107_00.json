{
 "packet": "1107_00",
 "items": [
  {
   "id": 24427,
   "key": "D1107al.txt:7",
   "ko": "하늘은 점점 밝아지고､ 동쪽부터 붉게 물들어 온다｡"
  },
  {
   "id": 24428,
   "key": "D1107al.txt:9",
   "ko": "아침이､ 가깝다｡"
  },
  {
   "id": 24432,
   "key": "D1107al.txt:11",
   "ko": "사신이 그림자를 드리운 절망의 거리에도 아침은 온다｡"
  },
  {
   "id": 24438,
   "key": "D1107al.txt:12",
   "ko": "만물에 똑같이 아침은 온다｡"
  },
  {
   "id": 24447,
   "key": "D1107al.txt:13",
   "ko": "그렇다｡"
  },
  {
   "id": 24448,
   "key": "D1107al.txt:14",
   "ko": "반드시､ 아침은 오는 것이다｡"
  },
  {
   "id": 24450,
   "key": "D1107al.txt:27",
   "ko": "「――자도자 반응 소멸 확인｡ 적기､ 완전히 승멸했습니다」"
  },
  {
   "id": 24451,
   "key": "D1107al.txt:31",
   "ko": "「해냈다아아아아――――――――――――――――앗!」"
  },
  {
   "id": 24452,
   "key": "D1107al.txt:34",
   "ko": "사령실에 환호성이 울려 퍼졌다｡"
  },
  {
   "id": 24453,
   "key": "D1107al.txt:35",
   "ko": "두말할 나위 없는 대승리｡"
  },
  {
   "id": 24456,
   "key": "D1107al.txt:36",
   "ko": "루리 일행의 마음에 다시 희망의 등불이 깃들었다｡"
  },
  {
   "id": 24484,
   "key": "D1107al.txt:39",
   "ko": "아직이다――아직 우리는 패하지 않았다!"
  },
  {
   "id": 24487,
   "key": "D1107al.txt:40",
   "ko": "메타트론이 있다｡"
  },
  {
   "id": 24491,
   "key": "D1107al.txt:41",
   "ko": "데몬베인이 부활했다｡"
  },
  {
   "id": 24494,
   "key": "D1107al.txt:42",
   "ko": "우리는――하도 재벌은――인류는､ 아직 싸울 수 있다!"
  },
  {
   "id": 24497,
   "key": "D1107al.txt:49",
   "ko": "「……윈필드」"
  },
  {
   "id": 24513,
   "key": "D1107al.txt:53",
   "ko": "「네､ 아가씨」"
  },
  {
   "id": 24516,
   "key": "D1107al.txt:57",
   "ko": "「마를 베는 검은､ 아직 여기에 있습니다」"
  },
  {
   "id": 24517,
   "key": "D1107al.txt:62",
   "ko": "「물론이옵니다｡ 패배도 절망도､ 저희에게는 아직 너무나 멉니다」"
  },
  {
   "id": 24519,
   "key": "D1107al.txt:75",
   "ko": "「흥……이 천재가 큰 부상을 참고 밤새워 조정한 것이란 말이다? 저 정도는 해줘야 당연한 것이다!」"
  },
  {
   "id": 24520,
   "key": "D1107al.txt:83",
   "ko": "「으――――읏! 허항히 홈 후하호효오오옷! (번역: 적당히 좀 풀라고요!)」"
  },
  {
   "id": 24521,
   "key": "D1107al.txt:96",
   "ko": "「그렇다……이런 곳에서 쓰러질 수는 없다｡ 우리는…… 나는…… 『블랙로지』를､ 산달폰을 멸할 때까지――」"
  },
  {
   "id": 24522,
   "key": "D1107al.txt:113",
   "ko": "「정말로 해냈로봇……달링! 데우스 마키나에게……안티크로스에게 이겼로봇!」"
  },
  {
   "id": 24523,
   "key": "D1107al.txt:117",
   "ko": "「당연하잖냐､ 바보야……읏」"
  },
  {
   "id": 24524,
   "key": "D1107al.txt:123",
   "ko": "왜냐하면――데몬베인에는､ 수많은 사람의 마음이 맡겨져 있으니까｡"
  },
  {
   "id": 24526,
   "key": "D1107al.txt:124",
   "ko": "공주님의｡"
  },
  {
   "id": 24532,
   "key": "D1107al.txt:125",
   "ko": "집사님의｡"
  },
  {
   "id": 24549,
   "key": "D1107al.txt:127",
   "ko": "메이드들의｡"
  },
  {
   "id": 24552,
   "key": "D1107al.txt:128",
   "ko": "라이카 씨와 꼬맹이들과……거리 모두의｡"
  },
  {
   "id": 24557,
   "key": "D1107al.txt:129",
   "ko": "그리고 분명､ 엔네아도……게다가､ 게다가……"
  },
  {
   "id": 24566,
   "key": "D1107al.txt:133",
   "ko": "「……알」"
  },
  {
   "id": 24574,
   "key": "D1107al.txt:135",
   "ko": "그래｡"
  },
  {
   "id": 24586,
   "key": "D1107al.txt:136",
   "ko": "지금도 우리는 함께 싸우고 있어……그렇지?"
  },
  {
   "id": 24607,
   "key": "D1107al.txt:137",
   "ko": "저기……알｡"
  },
  {
   "id": 24613,
   "key": "D1107al.txt:142",
   "ko": "눈부신 빛이､ 동쪽에서 쏟아져 들어왔다｡"
  },
  {
   "id": 24615,
   "key": "D1107al.txt:144",
   "ko": "……아침 해다｡"
  },
  {
   "id": 24624,
   "key": "D1107al.txt:146",
   "ko": "아침 해가 뜬다｡"
  },
  {
   "id": 24631,
   "key": "D1107al.txt:148",
   "ko": "아침 해는､ 사신의 위용을､"
  },
  {
   "id": 24637,
   "key": "D1107al.txt:149",
   "ko": "거리를 찢어놓은 상흔을 비춘다｡"
  },
  {
   "id": 24643,
   "key": "D1107al.txt:151",
   "ko": "악몽이 끝난 건 아니다｡"
  }
 ]
}