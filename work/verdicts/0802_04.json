  {
   "id": 12452,
   "key": "D0802ru.txt:189",
   "ko": "「이､ 의식하고 있는 게 당연하잖아요오!」"
  },
  {
   "id": 12453,
   "key": "D0802ru.txt:192",
   "ko": "――의식하지 않는 쪽이 이상했다｡ 얼굴을 새빨갛게 물들이고 책상에 엎드린다｡"
  },
  {
   "id": 12454,
   "key": "D0802ru.txt:200",
   "ko": "점점 더 커지는 쿠로의 존재를 감당하지 못한 채｡"
  },
  {
   "id": 12455,
   "key": "D0802ru.txt:219",
   "ko": "「저런 식으로､ 루리 님은､ 좋은 느낌으로 망가져 있어요」"
  },
  {
   "id": 12456,
   "key": "D0802ru.txt:223",
   "ko": "="
  },
  {
   "id": 12457,
   "key": "D0802ru.txt:228",
   "ko": "="
  },
  {
   "id": 12458,
   "key": "D0802ru.txt:235",
   "ko": "="
  },
  {
   "id": 12459,
   "key": "D0802ru.txt:242",
   "ko": "="
  },
  {
   "id": 12460,
   "key": "D0802ru.txt:246",
   "ko": "="
  },
  {
   "id": 12461,
   "key": "D0802ru.txt:251",
   "ko": "「……역시､ 다이쥬지 님의 일입니까」"
  },
  {
   "id": 12462,
   "key": "D0802ru.txt:262",
   "ko": "「우와아아아아!?」"
  },
  {
   "id": 12463,
   "key": "D0802ru.txt:266",
   "ko": "「조용히｡ 목소리가 큽니다」"
  },
  {
   "id": 12464,
   "key": "D0802ru.txt:271",
   "ko": "「……언제 오신 거예요!?」 「집사니까요」"
  },
  {
   "id": 12465,
   "key": "D0802ru.txt:283",
   "ko": "「대답이 안 된 것 같은데요!?」"
  },
  {
   "id": 12466,
   "key": "D0802ru.txt:289",
   "ko": "「그것보다 윈 님､ 쿠로 군의 일이라는 게 뭔데?」"
  },
  {
   "id": 12467,
   "key": "D0802ru.txt:296",
   "ko": "「아가씨가 변하신 것은 마침 인스머스 사건 이후부터입니다｡ 인스머스 때라고 하면……」"
  },
  {
   "id": 12468,
   "key": "D0802ru.txt:304",
   "ko": "「――다이쥬지 씨와 단둘이었지요」"
  },
  {
   "id": 12469,
   "key": "D0802ru.txt:311",
   "ko": "「………………」 「추궁할 필요가 있겠네」"
  },
  {
   "id": 12470,
   "key": "D0802ru.txt:319",
   "ko": "「……불결」 「심문하고 고문해서 마녀재판으로 화형이에요!」"
  },
  {
   "id": 12471,
   "key": "D0802ru.txt:330",
   "ko": "「뭐…… 보아하니 루리 아가씨도 싫지만은 않은 것 같던데」"
  },
  {
   "id": 12472,
   "key": "D0802ru.txt:337",
   "ko": "「무슨 말씀을 하시는 거예요! 그런 말 했다가 다이쥬지 씨가 하도 가에 이름을 올리게 되면요! 하물며 하도 재벌 총수 자리에 앉기라도 하면!」 「………………쳇」"
  },
  {
   "id": 12473,
   "key": "D0802ru.txt:346",
   "ko": "「너…… 그렇게 쿠로 군이 싫은 거야?」 「설마요오｡ 정말 좋아해요오」"
  }
 ]
}