{
 "packet": "0902_05",
 "items": [
  {
   "id": 18330,
   "key": "D0902ru.txt:176",
   "ko": "평소의 공주님은 보이지 않는､ 나이에 걸맞은――아니 그 이하의 표정을 잔뜩 봐 버렸으니까｡"
  },
  {
   "id": 18331,
   "key": "D0902ru.txt:178",
   "ko": "공주님은 그런 앳된 소녀의 얼굴을 하도 재벌 총수의 가면으로 감추고 싸우고 있는 거다……진심으로 대단한 일이라고 생각한다｡"
  },
  {
   "id": 18332,
   "key": "D0902ru.txt:180",
   "ko": "공주님은 내 쪽이 힘들다고 여기는 모양이지만､ 나에겐 딱히 짊어지고 싸울 게 없다｡"
  },
  {
   "id": 18333,
   "key": "D0902ru.txt:182",
   "ko": "하지만 공주님은 다르다｡"
  },
  {
   "id": 18336,
   "key": "D0902ru.txt:183",
   "ko": "공주님은 하도 코조라는 너무나 위대한 조부에게 물려받은､ 터무니없이 크고 무거운 것을 짊어지고 싸우고 있는 거다｡"
  },
  {
   "id": 18337,
   "key": "D0902ru.txt:185",
   "ko": "그 어린 나이에 말이다｡"
  },
  {
   "id": 18341,
   "key": "D0902ru.txt:187",
   "ko": "그 싸움의 가혹함은 분명 나와 비교도 안 될 거다｡"
  },
  {
   "id": 18343,
   "key": "D0902ru.txt:193",
   "ko": "「하도､ 루리……인가」"
  },
  {
   "id": 18344,
   "key": "D0902ru.txt:195",
   "ko": "……그런 공주님을 나는 어떻게 생각하고 있는 걸까｡"
  },
  {
   "id": 18345,
   "key": "D0902ru.txt:197",
   "ko": "호감을 갖고 있는 건 틀림없다､ 고 생각한다｡"
  },
  {
   "id": 18347,
   "key": "D0902ru.txt:199",
   "ko": "처음엔 험악한 느낌이었지만 요즘 들어 서로 이해하게 된 것 같다｡"
  },
  {
   "id": 18350,
   "key": "D0902ru.txt:201",
   "ko": "좋은 일이다｡"
  },
  {
   "id": 18352,
   "key": "D0902ru.txt:202",
   "ko": "이대로 잘 지낼 수 있으면 좋겠다｡"
  },
  {
   "id": 18353,
   "key": "D0902ru.txt:204",
   "ko": "……아니､ 켕기는 의미가 아니라｡"
  },
  {
   "id": 18355,
   "key": "D0902ru.txt:205",
   "ko": "좀 더､ 이렇게､ 서로 협력하는 관계로서의 얘기로｡"
  },
  {
   "id": 18356,
   "key": "D0902ru.txt:208",
   "ko": "「……누구한테 변명하는 거냐､ 나는」"
  },
  {
   "id": 18357,
   "key": "D0902ru.txt:210",
   "ko": "아무리 그래도 너무 의식한다｡"
  },
  {
   "id": 18358,
   "key": "D0902ru.txt:211",
   "ko": "그런 점 때문에 알에게 공연한 의심을 사는 건지도 모른다｡"
  },
  {
   "id": 18360,
   "key": "D0902ru.txt:216",
   "ko": "「좋아……정신 차려､ 나!」"
  },
  {
   "id": 18364,
   "key": "D0902ru.txt:218",
   "ko": "찰싹 제 뺨을 때리고 기합을 넣는다｡"
  },
  {
   "id": 18365,
   "key": "D0902ru.txt:220",
   "ko": "커피가 인원수만큼 내려진 걸 확인하고 쟁반에 올려 나른다｡"
  },
  {
   "id": 18368,
   "key": "D0902ru.txt:222",
   "ko": "쫄지 마｡ 정말로 켕기는 건 없으니까｡"
  },
  {
   "id": 18370,
   "key": "D0902ru.txt:223",
   "ko": "어디까지나 당당하고 의연하게｡ 밝고 상쾌하게｡"
  },
  {
   "id": 18371,
   "key": "D0902ru.txt:231",
   "ko": "「오래 기다렸어! 커피가 다 됐……다……」"
  },
  {
   "id": 18372,
   "key": "D0902ru.txt:237",
   "ko": "「시아아아――――――」 「후우우우――――――」"
  },
  {
   "id": 18373,
   "key": "D0902ru.txt:247",
   "ko": "「용호상박!?」"
  },
  {
   "id": 18375,
   "key": "D0902ru.txt:253",
   "ko": "뭘 멋대로 단숨에 가속도적으로 국제 긴장을 높이고 있는 거냐､ 이 녀석들!?"
  },
  {
   "id": 18376,
   "key": "D0902ru.txt:255",
   "ko": "그만큼 임계점 아슬아슬､ 일촉즉발의 공기였다｡"
  },
  {
   "id": 18378,
   "key": "D0902ru.txt:256",
   "ko": "투기와 살기로 배경이 일그러집니다 같은｡"
  },
  {
   "id": 18381,
   "key": "D0902ru.txt:257",
   "ko": "가까이 가기만 해도 심장이 폭발합니다 같은｡"
  },
  {
   "id": 18383,
   "key": "D0902ru.txt:259",
   "ko": "잠깐 눈 뗐더니 바로 이거냐!?"
  },
  {
   "id": 18385,
   "key": "D0902ru.txt:262",
   "ko": "「이､ 이봐 이봐! 뭐､ 뭘 그렇게 살벌하게 굴고 그러냐……」"
  },
  {
   "id": 18387,
   "key": "D0902ru.txt:266",
   "ko": "「부라릿」"
  },
  {
   "id": 18390,
   "key": "D0902ru.txt:270",
   "ko": "「째릿」"
  },
  {
   "id": 18391,
   "key": "D0902ru.txt:274",
   "ko": "「히익!?」 무시무시한 얼굴로 동시에 노려봤다｡"
  },
  {
   "id": 18392,
   "key": "D0902ru.txt:277",
   "ko": "지릴 것 같다｡"
  },
  {
   "id": 18394,
   "key": "D0902ru.txt:281",
   "ko": "「……저는 딱히 아무것도｡ 그저 알 아지프가 일방적으로 시비를 걸어왔을 뿐이에요」"
  },
  {
   "id": 18395,
   "key": "D0902ru.txt:285",
   "ko": "「흥……볼일도 없이 눌러앉으려는 계집애에게 사물의 도리를 가르치려 했을 뿐이니라」"
  },
  {
   "id": 18396,
   "key": "D0902ru.txt:288",
   "ko": "여느 때의 싸움인가……아니､ 「여느 때」인가?"
  },
  {
   "id": 18401,
   "key": "D0902ru.txt:289",
   "ko": "오늘은 특히 살벌한 공기가 팽팽하게 서려 계십니다만｡"
  }
 ]
}