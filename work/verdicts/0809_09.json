   "id": 14725,
   "key": "D0809al.txt:1757",
   "ko": "="
  },
  {
   "id": 14726,
   "key": "D0809al.txt:1758",
   "ko": "="
  },
  {
   "id": 14727,
   "key": "D0809al.txt:1760",
   "ko": "="
  },
  {
   "id": 14728,
   "key": "D0809al.txt:1765",
   "ko": "「그렇게 두진 않는다!」"
  },
  {
   "id": 14729,
   "key": "D0809al.txt:1776",
   "ko": "="
  },
  {
   "id": 14730,
   "key": "D0809al.txt:1784",
   "ko": "="
  },
  {
   "id": 14731,
   "key": "D0809al.txt:1790",
   "ko": "="
  },
  {
   "id": 14732,
   "key": "D0809al.txt:1795",
   "ko": "="
  },
  {
   "id": 14733,
   "key": "D0809al.txt:1799",
   "ko": "「――――!?」"
  },
  {
   "id": 14734,
   "key": "D0809al.txt:1801",
   "ko": "팟､ 붉은 꽃이､ 피었다｡ 튀어 오르는 피보라｡"
  },
  {
   "id": 14735,
   "key": "D0809al.txt:1803",
   "ko": "하지만､ 그것은 우리를 적시기 전에――"
  },
  {
   "id": 14736,
   "key": "D0809al.txt:1813",
   "ko": "풀어졌다｡"
  },
  {
   "id": 14737,
   "key": "D0809al.txt:1816",
   "ko": "무너져 내리는 몸이､ 뿜어져 나오는 선혈이､ 전부 전부､ 마도서의 페이지가 되어 흩어져 간다｡"
  },
  {
   "id": 14738,
   "key": "D0809al.txt:1819",
   "ko": "괴이는 그것만으로 그치지 않았다｡"
  },
  {
   "id": 14739,
   "key": "D0809al.txt:1824",
   "ko": "「어――? 아――아파… 우웃!?」"
  },
  {
   "id": 14740,
   "key": "D0809al.txt:1829",
   "ko": "「쿠로!? 무슨 일이냐!?」"
  },
  {
   "id": 14741,
   "key": "D0809al.txt:1833",
   "ko": "손을 감싸 쥐고 주저앉는 나를 보고 알이 당황했다｡"
  }
 ]
