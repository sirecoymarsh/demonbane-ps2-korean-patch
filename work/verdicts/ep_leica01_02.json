  },
  {
   "id": 49752,
   "key": "ep_leica01.txt:265",
   "ko": "온 힘을 다하는 기세로､ 쿠로 군은 힘차게 고개를 끄덕였다｡"
  },
  {
   "id": 49753,
   "key": "ep_leica01.txt:279",
