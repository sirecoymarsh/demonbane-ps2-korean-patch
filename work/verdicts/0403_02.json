  {
   "id": 4568,
   "key": "D0403.txt:673",
   "ko": "미움받고 있는 건가､ 내가?"
  },
  {
   "id": 4569,
   "key": "D0403.txt:674",
   "ko": "아니면 진심으로 무서워하는 건가?"
  },
  {
   "id": 4570,
   "key": "D0403.txt:677",
   "ko": "하지만 저 아이――앨리슨은 언제나 누구에게나 저런 느낌이다｡"
  },
  {
   "id": 4571,
   "key": "D0403.txt:679",
   "ko": "나는 그렇다 쳐도 꼬맹이들이나 라이카 씨에게조차 마음을 열지 않는 것처럼 보인다｡"
  },
  {
   "id": 4572,
   "key": "D0403.txt:681",
   "ko": "뭐､ 내성적인 성격…… 탓도 있겠지만｡"
  },
  {
   "id": 4573,
   "key": "D0403.txt:692",
   "ko": "「쿠로― 쟤는 그냥 내버려 두자」"
  },
  {
   "id": 4574,
   "key": "D0403.txt:697",
   "ko": "「하아? 무슨 소리야 너? 같이 사는 가족이잖냐」"
  },
  {
   "id": 4575,
   "key": "D0403.txt:703",
   "ko": "「그치만 앨리슨 쟤､ 말도 전혀 안 하고」"
  },
  {
   "id": 4576,
   "key": "D0403.txt:708",
   "ko": "「게다가 쟤､ 왠지 좀 으스스해……」"
  },
  {
   "id": 4577,
   "key": "D0403.txt:713",
   "ko": "「으스스하다고? 너도 참 심한 소리 하는구나」"
  },
  {
   "id": 4578,
   "key": "D0403.txt:717",
   "ko": "「그치만……」"
  },
  {
   "id": 4579,
   "key": "D0403.txt:723",
   "ko": "콜린은 겸연쩍은 듯 고개를 숙이면서도 말을 이었다｡"
  },
  {
   "id": 4580,
   "key": "D0403.txt:729",
   "ko": "「쟤 가까이에 있으면 가끔 이상한 느낌이 들어」"
