  {
   "id": 18098,
   "key": "D0902al.txt:44",
   "ko": "부디 우리의 제물을 굽어살피소서｡"
  },
  {
   "id": 18099,
   "key": "D0902al.txt:67",
   "ko": "――이곳은､ 제단이자 옥좌｡"
  },
  {
   "id": 18100,
   "key": "D0902al.txt:70",
   "ko": "어스름을 밝히는 것은 횃불의 불빛｡ 사그라들지 않고 타오르는 그 성화 속에서 이따금 이형의 그림자를 언뜻 보는 것은 과연 착각일까｡"
  },
  {
   "id": 18101,
   "key": "D0902al.txt:73",
   "ko": "이형의 불꽃에 비쳐､ 바닥을 적신 피바다가 번들번들 빛난다｡"
  },
  {
   "id": 18102,
   "key": "D0902al.txt:75",
   "ko": "뿜어져 나온 선혈이 하얀 몸을 새빨갛게 물들인다｡"
  },
  {
   "id": 18103,
   "key": "D0902al.txt:79",
   "ko": "실이 끊긴 인형처럼､ 제물이 된 처녀는 피바다에 잠겼다｡"
  },
  {
   "id": 18105,
   "key": "D0902al.txt:88",
   "ko": "가라앉아 있던 검은 안개가 내달렸다｡"
  },
  {
   "id": 18107,
   "key": "D0902al.txt:89",
   "ko": "순식간에 소녀의 시신을 뒤덮는다｡"
  },
  {
   "id": 18109,
   "key": "D0902al.txt:99",
   "ko": "그것은 땅을 기는 이매망량의 무리｡ 치키치키… 하고｡"
  },
  {
