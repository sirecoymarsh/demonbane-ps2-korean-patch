 "items": [
  {
   "id": 40828,
   "key": "D1501al.txt:625",
   "ko": "붉은 악마의 날개를 접은 칼날｡"
  },
  {
   "id": 40829,
   "key": "D1501al.txt:628",
   "ko": "진홍의 기신이 데몬베인과 대치하며 우뚝 솟는다｡"
  },
  {
   "id": 40830,
   "key": "D1501al.txt:633",
   "ko": "="
  },
  {
   "id": 40831,
   "key": "D1501al.txt:654",
   "ko": "어디선가 바람이 불었다｡"
  },
  {
   "id": 40832,
   "key": "D1501al.txt:655",
   "ko": "마도서의 종잇조각이 이계의 바람을 탄다｡"
  },
  {
   "id": 40833,
   "key": "D1501al.txt:658",
   "ko": "="
  },
  {
   "id": 40834,
   "key": "D1501al.txt:659",
   "ko": "="
  },
  {
   "id": 40835,
   "key": "D1501al.txt:672",
   "ko": "「――――!?」"
  },
  {
   "id": 40836,
   "key": "D1501al.txt:675",
   "ko": "="
  },
  {
   "id": 40837,
   "key": "D1501al.txt:686",
   "ko": "="
  },
  {
   "id": 40838,
   "key": "D1501al.txt:690",
   "ko": "="
  },
  {
   "id": 40839,
   "key": "D1501al.txt:696",
   "ko": "="
  },
  {
   "id": 40840,
   "key": "D1501al.txt:701",
   "ko": "="
  },
  {
   "id": 40841,
   "key": "D1501al.txt:706",
   "ko": "="
  },
  {
   "id": 40842,
   "key": "D1501al.txt:707",
   "ko": "검은 의복｡ 검은 긴 머리｡ 검은 눈동자｡"
  },
  {
   "id": 40843,
   "key": "D1501al.txt:708",
   "ko": "검은 소녀――"
  },
  {
   "id": 40844,
   "key": "D1501al.txt:713",
   "ko": "「『나코트 사본』!」"
  },
  {
   "id": 40845,
   "key": "D1501al.txt:719",
   "ko": "「――보다시피다」"
  },
  {
   "id": 40846,
   "key": "D1501al.txt:725",
   "ko": "="
  },
  {
   "id": 40847,
   "key": "D1501al.txt:737",
   "ko": "「……에셀드레다｡ 몸 상태는 어떠냐? 별일 없는가?」"
  },
  {
   "id": 40848,
   "key": "D1501al.txt:741",
   "ko": "「문제없습니다｡ 마음 써 주셔서 감사합니다」"
  },
  {
   "id": 40849,
   "key": "D1501al.txt:747",
   "ko": "두 사람은 입술을 포갠다｡ 포갠 채､ 이쪽을 보며 눈을 가늘게 떴다｡"
  },
  {
   "id": 40850,
   "key": "D1501al.txt:751",
   "ko": "="
  },
  {
   "id": 40851,
   "key": "D1501al.txt:757",
   "ko": "「자､ 이 광대극도 이윽고 종막을 맞이하려 하는군」"
  },
  {
   "id": 40852,
   "key": "D1501al.txt:773",
   "ko": "="
  },
  {
   "id": 40853,
   "key": "D1501al.txt:779",
   "ko": "「……알았다!」"
  },
  {
   "id": 40854,
   "key": "D1501al.txt:796",
   "ko": "열린 채로 있던 콕핏에 뛰어올랐다｡"
  },
  {
   "id": 40855,
   "key": "D1501al.txt:797",
   "ko": "빛의 속도로 데몬베인을 기동시킨다｡"
  },
  {
   "id": 40856,
   "key": "D1501al.txt:814",
   "ko": "마술 회로를 도는 마력이 고속 회전한다｡"
  },
  {
   "id": 40857,
   "key": "D1501al.txt:815",
   "ko": "수은의 피가 끓어오른다｡"
  },
  {
   "id": 40858,
   "key": "D1501al.txt:828",
   "ko": "데몬베인의 주먹을 치켜든다｡ 주먹에 집중된 마력이 밖으로 새어 나와､ 공간에 자전이 되어 방사된다｡"
  },
  {
   "id": 40859,
   "key": "D1501al.txt:831",
   "ko": "피 냄새 가득한 대기를 태우며 포효한다｡"
  },
  {
   "id": 40861,
   "key": "D1501al.txt:844",
   "ko": "「후후｡ 꽤나 적극적이구나､ 다이쥬지 쿠로」"
  },
  {
   "id": 40862,
   "key": "D1501al.txt:849",
   "ko": "「――에셀드레다!」 「예､ 마스터」"
  },
  {
   "id": 40863,
   "key": "D1501al.txt:870",
   "ko": "리베르 레기스의 흉부에 마법진이 빛난다｡"
  },
  {
   "id": 40864,
   "key": "D1501al.txt:871",
   "ko": "두 사람이 빛이 되어 마법진에 빨려 들어간다｡"
  },
  {
   "id": 40865,
   "key": "D1501al.txt:872",
   "ko": "기체 표면､ 무수한 마술 문자가 질주한다｡"
  },
  {
   "id": 40866,
   "key": "D1501al.txt:890",
   "ko": "기동한다｡ 포효한다｡ 날개를 접은 박쥐를 닮은 장갑 아래에서 주먹을 내지르며 덤벼든다｡"
  },
  {
   "id": 40867,
   "key": "D1501al.txt:893",
   "ko": "피 냄새 가득한 대기를 태우며 다가온다｡"
  },
  {
   "id": 40868,
   "key": "D1501al.txt:906",
   "ko": "「리베르 레기스――쳐라」"
  }
 ]
}