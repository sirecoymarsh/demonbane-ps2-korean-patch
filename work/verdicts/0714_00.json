  {
   "id": 10699,
   "key": "D0714.txt:219",
   "ko": "데몬베인을 조여오는 거대한 생물｡"
  },
  {
   "id": 10700,
   "key": "D0714.txt:220",
   "ko": "메인 모니터에 비친 그 괴물은――"
  },
  {
   "id": 10701,
   "key": "D0714.txt:238",
   "ko": "「――다곤!? 어째서!?」 틀림없다｡"
  },
  {
   "id": 10702,
   "key": "D0714.txt:244",
   "ko": "갑각화된 비늘로 덮인 체구｡"
  },
  {
   "id": 10703,
   "key": "D0714.txt:247",
   "ko": "촉완을 휘감고 온몸으로 짓누르듯이 데몬베인을 구속하고 있다｡ 흉악한 바다 마물의 얼굴이 코앞에 있었다｡"
  },
  {
   "id": 10704,
   "key": "D0714.txt:250",
   "ko": "하지만､ 그렇다면……아까 도망친 건 뭐지?"
  },
  {
   "id": 10705,
   "key": "D0714.txt:252",
   "ko": "설마 거기서 단숨에 데몬베인의 뒤로 돌아 들어온 건가? 그렇다면……무슨 속도야!"
  },
  {
   "id": 10706,
   "key": "D0714.txt:258",
   "ko": "「아니다! 이놈은 다곤이 아니니라!」"
  },
  {
   "id": 10707,
   "key": "D0714.txt:265",
   "ko": "="
  },
  {
   "id": 10708,
   "key": "D0714.txt:272",
   "ko": "무슨 뜻이냐고 묻기보다 빨랐다｡"
  },
  {
   "id": 10709,
   "key": "D0714.txt:275",
   "ko": "전방､ 바닷물을 밀어내며 폭발적인 기세로 돌진해 오는 거대한 그림자가 있다｡ 그 그림자 또한 마찬가지로……"
  },
  {
   "id": 10710,
   "key": "D0714.txt:292",
   "ko": "「뭐､ 뭐야 어째서!? 다곤이……두 마리이이이!?」"
  },
  {
   "id": 10711,
   "key": "D0714.txt:304",
   "ko": "「괘씸한 것! 짝을 불러들였구나!」"
