   "key": "D0812al.txt:52",
   "ko": "="
  },
  {
   "id": 16082,
   "key": "D0812al.txt:54",
   "ko": "그러기에 「주님은 어디에」 하고 부르는 소리도 없다｡"
  },
  {
   "id": 16083,
   "key": "D0812al.txt:62",
   "ko": "="
  },
  {
   "id": 16084,
   "key": "D0812al.txt:63",
   "ko": "="
  },
  {
   "id": 16085,
   "key": "D0812al.txt:65",
   "ko": "="
  },
  {
   "id": 16086,
   "key": "D0812al.txt:69",
   "ko": "「히히히히… 어､ 어쩐 일이야 아가씨｡ 그､ 그렇게 흠뻑 젖어서…｡ 아､ 아저씨가 따､ 따､ 따뜻하게 해줄까? 히히히히」"
  },
  {
   "id": 16087,
   "key": "D0812al.txt:73",
   "ko": "「게헤헤… 안 되겠는데｡ 아가씨 같은 미인이 이런 데를 어슬렁거리다니」"
  },
  {
   "id": 16088,
   "key": "D0812al.txt:80",
   "ko": "음흉한 웃음을 지으며 지저분한 남자 둘이 다가왔다｡"
  },
  {
   "id": 16089,
   "key": "D0812al.txt:82",
   "ko": "하지만 소녀의 눈동자는 그들을 힐끗 보지도 않는다｡ 개의치 않고――애초에 남자들의 존재를 알아채지 못한 듯이 그 옆을 지나치려 했다｡"
  },
  {
   "id": 16090,
   "key": "D0812al.txt:86",
   "ko": "「오오오､ 오오옷」"
  },
  {
   "id": 16091,
   "key": "D0812al.txt:89",
   "ko": "한쪽 남자가 소녀를 뒤에서 뒷팔 꺾기로 붙잡았다｡"
  },
  {
   "id": 16092,
   "key": "D0812al.txt:95",
   "ko": "「어､ 어이､ 매､ 매､ 매정하구만」"
  },
  {
   "id": 16093,
   "key": "D0812al.txt:99",
   "ko": "「게헤헤… 우리랑 놀자고｡ 어때､ 좋잖아?」"
  },
  {
   "id": 16095,
   "key": "D0812al.txt:107",
   "ko": "소녀는 미동도 하지 않는다｡"
  },
  {
   "id": 16096,
   "key": "D0812al.txt:108",
   "ko": "그저 차가운 눈동자가 다른 한 남자를 보았다｡"
  },
  {
   "id": 16097,
   "key": "D0812al.txt:109",
   "ko": "순간､ 남자는 움직일 수 없게 된다｡"
  },
  {
   "id": 16098,
   "key": "D0812al.txt:114",
   "ko": "="
  },
  {
   "id": 16099,
   "key": "D0812al.txt:118",
   "ko": "「어､ 어떻게 된…………어라?」"
  },
  {
   "id": 16100,
   "key": "D0812al.txt:121",
   "ko": "소녀를 뒷팔 꺾기로 잡고 있던 남자가 의아한 듯 동료의 모습을 살피려다가――드디어 자기 몸의 이상을 깨달았다｡"
  },
  {
   "id": 16101,
   "key": "D0812al.txt:125",
   "ko": "「어､ 어어라? 어라라､ 라?」"
  },
  {
   "id": 16102,
   "key": "D0812al.txt:129",
   "ko": "팔이､ 없었다｡"
  },
  {
   "id": 16103,
   "key": "D0812al.txt:130",
   "ko": "이상하게도 피는 전혀 뿜어져 나오지 않는다｡"
  },
  {
   "id": 16104,
   "key": "D0812al.txt:136",
   "ko": "소녀가 돌아보았다｡"
  },
  {
   "id": 16105,
   "key": "D0812al.txt:137",
   "ko": "그 얼굴은 화를 내고 있지 않았다｡"
  },
  {
   "id": 16106,
   "key": "D0812al.txt:138",
   "ko": "그저 몹시 상냥한 미소를 띠고 있었다｡"
  },
  {
   "id": 16107,
   "key": "D0812al.txt:140",
   "ko": "연민이다｡ 섬광｡ 아주 미미한 충격｡"
  },
  {
   "id": 16108,
   "key": "D0812al.txt:155",
   "ko": "그저､ 그뿐｡"
  },
  {
   "id": 16109,
   "key": "D0812al.txt:161",
   "ko": "남자는 자신에게 닥친 재난을 마지막까지 이해하지 못했다｡"
  },
  {
   "id": 16110,
   "key": "D0812al.txt:162",
   "ko": "실 끊긴 인형 같은 우스꽝스러운 움직임으로 그 자리에 무너져 내린다｡"
  }
 ]
}