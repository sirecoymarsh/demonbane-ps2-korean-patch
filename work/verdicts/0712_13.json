{
 "packet": "0712_13",
 "items": [
  {
   "id": 10418,
   "key": "D0712ru.txt:312",
   "ko": "「엇?」"
  },
  {
   "id": 10419,
   "key": "D0712ru.txt:317",
   "ko": "옆에서 문어 괴인을 후려쳐 날린 인물과 시선이 마주친다｡"
  },
  {
   "id": 10420,
   "key": "D0712ru.txt:324",
   "ko": "「흠…… 포르티시모로 정해졌군요」"
  },
  {
   "id": 10421,
   "key": "D0712ru.txt:330",
   "ko": "「윈필드!」"
  },
  {
   "id": 10423,
   "key": "D0712ru.txt:340",
   "ko": "「집사님!」"
  },
  {
   "id": 10425,
   "key": "D0712ru.txt:345",
   "ko": "「송구합니다｡ 늦었습니다､ 아가씨」"
  },
  {
   "id": 10427,
   "key": "D0712ru.txt:351",
   "ko": "「야호오､ 쿠로 군｡ 나도 있다구우」"
  },
  {
   "id": 10428,
   "key": "D0712ru.txt:357",
   "ko": "「라이카 씨! 집사님이랑 같이 있었던 거냐! 게다가――」"
  },
  {
   "id": 10429,
   "key": "D0712ru.txt:363",
   "ko": "「――!? 다이쥬지 씨! 아직……!」"
  },
  {
   "id": 10430,
   "key": "D0712ru.txt:377",
   "ko": "공주님이 비명을 질렀다｡"
  },
  {
   "id": 10433,
   "key": "D0712ru.txt:379",
   "ko": "집사님이 후려쳐 날린 문어 괴인이 일어나､ 다시 이쪽을 향해 돌진해 온다――!"
  },
  {
   "id": 10434,
   "key": "D0712ru.txt:384",
   "ko": "「이런…… 이래서 연체동물이란……!」"
  },
  {
   "id": 10435,
   "key": "D0712ru.txt:393",
   "ko": "문어 괴인은 표적을 나로 정한 모양이다｡ 겉보기와 달리 맹렬한 속도로 단숨에 거리를 좁히더니､ 또다시 촉수를 내리쳐――"
  },
  {
   "id": 10436,
   "key": "D0712ru.txt:399",
   "ko": "「쿠로!」"
  },
  {
   "id": 10437,
   "key": "D0712ru.txt:406",
   "ko": "완벽한 호흡이었다｡"
  },
  {
   "id": 10438,
   "key": "D0712ru.txt:417",
   "ko": "촉수가 닿기 직전､ 내 몸을 눈부신 빛이 감싼다｡"
  },
  {
   "id": 10440,
   "key": "D0712ru.txt:418",
   "ko": "마도서의 페이지가 몸을 뒤덮고､ 마기우스 스타일로｡"
  },
  {
   "id": 10441,
   "key": "D0712ru.txt:428",
   "ko": "동시에 나는 술식을 짜올린다｡ 불길이 내달리고､ 바르자이의 언월도가 소환되기까지､ 그저 한순간｡"
  },
  {
   "id": 10442,
   "key": "D0712ru.txt:439",
   "ko": "잘려나간 촉수가 점액을 흩뿌리며 허공을 난다｡"
  },
  {
   "id": 10443,
   "key": "D0712ru.txt:440",
   "ko": "그것이 떨어지기보다 빠르게､ 되돌린 칼날이 문어 괴인의 목을 베어 날렸다｡"
  },
  {
   "id": 10444,
   "key": "D0712ru.txt:443",
   "ko": "언월도를 휘두른 자세 그대로､ 내 어깨 위에 선 작은 기척에게 말을 건다｡"
  },
  {
   "id": 10445,
   "key": "D0712ru.txt:448",
   "ko": "「어이…… 너도 무사했냐――알」"
  },
  {
   "id": 10447,
   "key": "D0712ru.txt:457",
   "ko": "「떨어졌을 때는 어찌할 뻔했는지 아느냐? 참으로 손이 많이 가는구나」"
  },
  {
   "id": 10448,
   "key": "D0712ru.txt:463",
   "ko": "「알 아지프!」"
  },
  {
   "id": 10449,
   "key": "D0712ru.txt:469",
   "ko": "알에 라이카 씨에 집사님…… 이걸로 전원이다｡"
  },
  {
   "id": 10450,
   "key": "D0712ru.txt:470",
   "ko": "모두 무사했다｡ 이걸로 아무 걱정도 필요 없다｡"
  },
  {
   "id": 10451,
   "key": "D0712ru.txt:473",
   "ko": "이제 남은 건――! 「……………………」"
  },
  {
   "id": 10452,
   "key": "D0712ru.txt:486",
   "ko": "우리 앞에､ 우락부락한 체격의 사내들이 가로막아 섰다｡"
  },
  {
   "id": 10454,
   "key": "D0712ru.txt:489",
   "ko": "인스머스 상판이 아니다…… 뭐냐､ 이놈들?"
  },
  {
   "id": 10455,
   "key": "D0712ru.txt:490",
   "ko": "그런 내 의문은､ 곧바로 풀렸다｡"
  },
  {
   "id": 10457,
   "key": "D0712ru.txt:496",
   "ko": "「꺄앗!?」"
  },
  {
   "id": 10458,
   "key": "D0712ru.txt:508",
   "ko": "사내들의 모습이､ 순식간에 변해 간다｡"
  },
  {
   "id": 10460,
   "key": "D0712ru.txt:509",
   "ko": "근육이 부풀고､ 피부가 변질되고､ 골격이 소리를 내며 다시 짜여 간다｡"
  },
  {
   "id": 10462,
   "key": "D0712ru.txt:516",
   "ko": "어떤 자는 상어와 인간을 합성한 모습으로｡"
  },
  {
   "id": 10463,
   "key": "D0712ru.txt:524",
   "ko": "어떤 자는 거북과 인간을 합성한 모습으로｡"
  },
  {
   "id": 10464,
   "key": "D0712ru.txt:531",
   "ko": "아까 그 문어 괴인도｡"
  },
  {
   "id": 10465,
   "key": "D0712ru.txt:539",
   "ko": "저쪽에선 쓰러져 있던 여자가､ 불가사리 모습으로 변해 간다｡"
  },
  {
   "id": 10468,
   "key": "D0712ru.txt:545",
   "ko": "「이､ 이 사람들이……!」"
  },
  {
   "id": 10470,
   "key": "D0712ru.txt:549",
   "ko": "「그런 거였나……!」"
  },
  {
   "id": 10474,
   "key": "D0712ru.txt:555",
   "ko": "괴인들이 우리를 포위하고､ 슬금슬금 다가온다｡ 그 뒤에서는 『깊은 곳의 존재들』의 무리｡"
  }
 ]
}