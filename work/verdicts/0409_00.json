{
 "packet": "0409_00",
 "items": [
  {
   "id": 5182,
   "key": "D0409.txt:19",
   "ko": "="
  },
  {
   "id": 5183,
   "key": "D0409.txt:22",
   "ko": "앨리슨의 주변에는 온갖 괴기현상이 따라다녔다는 것｡ 그것이 원인이 되어 친족들에게 배척당했다는 것……"
  },
  {
   "id": 5184,
   "key": "D0409.txt:25",
   "ko": "="
  },
  {
   "id": 5185,
   "key": "D0409.txt:32",
   "ko": "「과연｡ 아까도 느꼈다만､ 저 아이에게는 마술의 재능이 갖춰져 있는 듯하구나」"
  },
  {
   "id": 5186,
   "key": "D0409.txt:38",
   "ko": "「앨리슨한테?」 「그 나이대…… 감수성이 강한 시절에는 특히 마력이 무의식의 형태로 드러나기 쉬우니라」"
  },
  {
   "id": 5187,
   "key": "D0409.txt:47",
   "ko": "「힘 있는 자는 그런 줄도 모르고 상상력만으로 술을…… 다른 세계의 법칙을 엮어내고 마느니라」 「동화――불안정하나마 유연성 있는 마술의 현현이다｡ 그대에게도 그런 경험은 없느냐?」"
  },
  {
   "id": 5188,
   "key": "D0409.txt:58",
   "ko": "「……전혀」"
  },
  {
   "id": 5189,
   "key": "D0409.txt:63",
   "ko": "「그런가｡ 대개는 인간의 사회와 상식의 틀 안에서 사는 동안 그런 힘도 기억마저도 잃어버리는 법이니라｡ 어린 시절의 꿈이라 여겨버리지｡ 그대도 그 부류이냐」"
  },
  {
   "id": 5190,
   "key": "D0409.txt:69",
   "ko": "="
  },
  {
   "id": 5191,
   "key": "D0409.txt:75",
   "ko": "「어쨌든 이 몸의 힘을 받고 있다고는 하나 저 정도의 힘…… 저 아이､ 상당한 재주의 소유자로다｡ 허나 도리도 모르면서 저리 폭주하는 것은 좋지 않구나」"
  },
  {
   "id": 5192,
   "key": "D0409.txt:82",
   "ko": "="
  },
  {
   "id": 5193,
   "key": "D0409.txt:88",
   "ko": "="
  },
  {
   "id": 5194,
   "key": "D0409.txt:106",
   "ko": "행선지는 기척을 쫓으면 금방 알 수 있다｡ 알의 파편의 마력에 이끌리듯 나는 날았다｡"
  },
  {
   "id": 5195,
   "key": "D0409.txt:108",
   "ko": "="
  },
  {
   "id": 5196,
   "key": "D0409.txt:120",
   "ko": "="
  },
  {
   "id": 5197,
   "key": "D0409.txt:125",
   "ko": "="
  },
  {
   "id": 5198,
   "key": "D0409.txt:130",
   "ko": "「그렇게나 쿠로 군이 떠안을 필요는 없다고 말했는데」"
  },
  {
   "id": 5199,
   "key": "D0409.txt:135",
   "ko": "「………………」 「어째서 그렇게까지 해서 위험한 일을 하는 거야?」"
  },
  {
   "id": 5200,
   "key": "D0409.txt:146",
   "ko": "「………………」 잠시 말을 고르다가…… 그러고서 대답했다｡"
  },
  {
   "id": 5201,
   "key": "D0409.txt:154",
   "ko": "「라이카 씨와 같아」"
  },
  {
   "id": 5202,
   "key": "D0409.txt:159",
   "ko": "「엣?」"
  },
  {
   "id": 5203,
   "key": "D0409.txt:164",
   "ko": "「라이카 씨가 앨리슨을 내버려 둘 수 없는 것처럼」"
  },
  {
   "id": 5204,
   "key": "D0409.txt:169",
   "ko": "「그건 당연한 일이고……」"
  },
  {
   "id": 5205,
   "key": "D0409.txt:175",
   "ko": "「나도 『블랙로지』의 개자식들이 제멋대로 구는 걸 두고 볼 수 없어｡ 지난번처럼 그놈들 때문에 라이카 씨네가 위험에 처하는 건 용납 못 해」"
  },
  {
   "id": 5206,
   "key": "D0409.txt:181",
   "ko": "「그렇다고……!」"
  },
  {
   "id": 5207,
   "key": "D0409.txt:186",
   "ko": "「뭐､ 내 경우엔…… 열받는 놈은 두들겨 팬다､ 그저 그뿐일지도 모르지만」"
  },
  {
   "id": 5208,
   "key": "D0409.txt:190",
   "ko": "「어째서 그렇게…… 굳이 싸우지 않으면……」"
  },
  {
   "id": 5209,
   "key": "D0409.txt:196",
   "ko": "「수다는 거기까지다! 보이는구나!」"
  },
  {
   "id": 5210,
   "key": "D0409.txt:218",
   "ko": "도로 폭 가득 늘어선 무장한 치안경찰 부대｡ 장갑차도 많다｡"
  },
  {
   "id": 5211,
   "key": "D0409.txt:247",
   "ko": "장갑차에 달린 라이트가 전방을 눈부실 만큼 비추고 있었다｡ 경관대의 고함소리가 들린다｡"
  },
  {
   "id": 5212,
   "key": "D0409.txt:253",
   "ko": "「멈춰라! 너희들은 완전히 포위됐다!」"
  },
  {
   "id": 5213,
   "key": "D0409.txt:259",
   "ko": "="
  },
  {
   "id": 5214,
   "key": "D0409.txt:265",
   "ko": "="
  },
  {
   "id": 5215,
   "key": "D0409.txt:271",
   "ko": "="
  },
  {
   "id": 5216,
   "key": "D0409.txt:277",
   "ko": "="
  },
  {
   "id": 5217,
   "key": "D0409.txt:282",
   "ko": "="
  },
  {
   "id": 5218,
   "key": "D0409.txt:289",
   "ko": "="
  },
  {
   "id": 5219,
   "key": "D0409.txt:290",
   "ko": "굳이 확인할 것도 없다｡"
  },
  {
   "id": 5220,
   "key": "D0409.txt:310",
   "ko": "행진하는 트럼프 병사｡ 독수리 머리와 날개를 가진 사자､ 그리폰｡ 전차만큼 거대한､ 눈물을 뚝뚝 흘려대는 바다거북…… 짝퉁｡"
  },
  {
   "id": 5221,
   "key": "D0409.txt:317",
   "ko": "「지각쟁이 토끼에 험프티 덤프티､ 체셔 고양이에 미친 모자장수､ 트럼프 병사､ 그리폰､ 가짜 바다거북…… 그렇군｡ 『이상한 나라의 앨리스』인가」"
  }
 ]
}