{
 "packet": "ep_ruri02a_03",
 "items": [
  {
   "id": 50653,
   "key": "ep_ruri02a.txt:442",
   "ko": "미웠다｡ 진심으로 미웠다｡"
  },
  {
   "id": 50654,
   "key": "ep_ruri02a.txt:444",
   "ko": "이렇게까지 내 마음을 부숴 놓은 그 사람이 미웠다｡ 미워서､"
  },
  {
   "id": 50655,
   "key": "ep_ruri02a.txt:447",
   "ko": "미워서､ 미워서――사랑스러웠다｡"
  },
  {
   "id": 50656,
   "key": "ep_ruri02a.txt:449",
   "ko": "어쩔 도리 없이 사랑스러웠다｡"
  },
  {
   "id": 50657,
   "key": "ep_ruri02a.txt:451",
   "ko": "이제 나를 제어할 수 없다｡"
  },
  {
   "id": 50658,
   "key": "ep_ruri02a.txt:452",
   "ko": "그러니 무너지는 대로 몸을 맡길 수밖에 없었다｡"
  },
  {
   "id": 50659,
   "key": "ep_ruri02a.txt:455",
   "ko": "무한히 솟아날 줄 알았던 눈물도 멎어 버린다｡ 눈물은 마르고 마음도 텅 비어､ 나는 그저 멍하니 바닥에 주저앉아 천장을 바라보고 있다｡"
  },
  {
   "id": 50660,
   "key": "ep_ruri02a.txt:458",
   "ko": "바라보고 있으면서도… 실은 아무것도 시야에 들어오지 않는다｡"
  },
  {
   "id": 50661,
   "key": "ep_ruri02a.txt:459",
   "ko": "그저 피로만이 지금의 나를 채우는 전부였다｡"
  },
  {
   "id": 50662,
   "key": "ep_ruri02a.txt:463",
   "ko": "「……더는 못 견디겠어요…… 쿠로……」"
  },
  {
   "id": 50663,
   "key": "ep_ruri02a.txt:466",
   "ko": "결정적인 무언가가 무너져 내리려던――그때｡"
  },
  {
   "id": 50664,
   "key": "ep_ruri02a.txt:467",
   "ko": "아무것도 비치지 않을 터인 시야 한구석에 빛을 발견했다｡ 나도 모르게 시선으로 빛을 좇는다｡"
  },
  {
   "id": 50665,
   "key": "ep_ruri02a.txt:473",
   "ko": "「어……?」 기묘한 광경이었다｡"
  },
  {
   "id": 50666,
   "key": "ep_ruri02a.txt:479",
   "ko": "미세한 빛의 티끌이 나선을 그리듯 춤추고 있었다｡"
  },
  {
   "id": 50667,
   "key": "ep_ruri02a.txt:480",
   "ko": "소용돌이치는 빛의 티끌은 점점 수와 광채를 더해 간다｡"
  },
  {
   "id": 50668,
   "key": "ep_ruri02a.txt:482",
   "ko": "빛이 방의 조명을 압도할 만큼 밝아지고 나는 그것이 뜻하는 바를 알았다｡"
  },
  {
   "id": 50669,
   "key": "ep_ruri02a.txt:483",
   "ko": "빛 하나하나는 마술 문자｡"
  },
  {
   "id": 50670,
   "key": "ep_ruri02a.txt:485",
   "ko": "나선을 그리는 마술 문자는 마술을 구성하는 복잡한 술식｡"
  },
  {
   "id": 50671,
   "key": "ep_ruri02a.txt:491",
   "ko": "「에에엣!?」 그리고 마술은 어떤 실체를 구축했다｡"
  },
  {
   "id": 50672,
   "key": "ep_ruri02a.txt:495",
   "ko": "그것은 먼저 작은 사람 형상을 본떠 육체를 짠다｡"
  },
  {
   "id": 50673,
   "key": "ep_ruri02a.txt:500",
   "ko": "하얀 피부｡ 비취색 눈동자｡"
  },
  {
   "id": 50674,
   "key": "ep_ruri02a.txt:502",
   "ko": "은발의 끝자락은 아직 다 구축되지 않았는지 마술 문자인 채로 이어져 빛난다｡"
  },
  {
   "id": 50675,
   "key": "ep_ruri02a.txt:503",
   "ko": "마술이 짜낸 그 소녀를 나는 잘 알고 있었다｡"
  },
  {
   "id": 50676,
   "key": "ep_ruri02a.txt:507",
   "ko": "「알!? 어째서!?」 비취색 눈동자가 나를 바라본다｡"
  },
  {
   "id": 50677,
   "key": "ep_ruri02a.txt:511",
   "ko": "공허했던 눈동자에 의지의 빛이 켜졌다｡"
  },
  {
   "id": 50678,
   "key": "ep_ruri02a.txt:512",
   "ko": "혼잣말처럼 알이 입을 열기 시작한다｡"
  },
  {
   "id": 50679,
   "key": "ep_ruri02a.txt:516",
   "ko": "「……간신히 돌아올 수 있었구나…… 허나 오래는 못 버틴다｡ 이미 인과가…… 분해되기 시작했다……」"
  },
  {
   "id": 50680,
   "key": "ep_ruri02a.txt:520",
   "ko": "말이 끝나기 무섭게 알의 몸이 유령처럼 투명하게 옅어져 간다｡"
  },
  {
   "id": 50681,
   "key": "ep_ruri02a.txt:521",
   "ko": "이따금 고장 난 모니터처럼 그 모습에 노이즈가 인다｡"
  },
  {
   "id": 50682,
   "key": "ep_ruri02a.txt:522",
   "ko": "무슨 일이 일어나고 있는지 파악할 수 없다｡"
  },
  {
   "id": 50683,
   "key": "ep_ruri02a.txt:526",
   "ko": "「또다시…… 윤회에 사로잡히기 전에…… 루리…… 그대에게 전할 것이 있어 왔노라」"
  },
  {
   "id": 50684,
   "key": "ep_ruri02a.txt:530",
   "ko": "「전할…… 것이요?」"
  },
  {
   "id": 50685,
   "key": "ep_ruri02a.txt:533",
   "ko": "무슨 일이 일어나고 있는지는 모르겠지만… 그것이 중요한 일이라는 건 알았다｡ 놓치지 않도록､ 흘려듣지 않도록 온 신경을 동원해 알의 일거수일투족을 지켜본다｡"
  },
  {
   "id": 50686,
   "key": "ep_ruri02a.txt:537",
   "ko": "「이 몸이 알아낸…… 윤회의 진실…… 그리고…… 쿠로의 일을……」"
  },
  {
   "id": 50687,
   "key": "ep_ruri02a.txt:540",
   "ko": "쿠로! 그 이름에 심장이 뛰어올랐다｡"
  },
  {
   "id": 50688,
   "key": "ep_ruri02a.txt:542",
   "ko": "몸을 내밀듯이 알에게 호소한다｡"
  },
  {
   "id": 50689,
   "key": "ep_ruri02a.txt:543",
   "ko": "필사적이었다｡"
  },
  {
   "id": 50690,
   "key": "ep_ruri02a.txt:547",
   "ko": "「쿠로는!? 쿠로는 어떻게 됐나요! 알! 가르쳐 줘요! 부탁이니까 가르쳐 줘요!」"
  },
  {
   "id": 50691,
   "key": "ep_ruri02a.txt:551",
   "ko": "내 외침이 닿고 있는 건지 아닌지｡"
  },
  {
   "id": 50692,
   "key": "ep_ruri02a.txt:552",
   "ko": "알은 여전히 혼잣말을 이어 가는 듯한 어조로 나를 향해 손을 뻗쳤다｡"
  }
 ]
}