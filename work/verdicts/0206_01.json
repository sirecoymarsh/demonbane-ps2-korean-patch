  {
   "id": 2177,
   "key": "D0206.txt:319",
   "ko": "="
  },
  {
   "id": 2178,
   "key": "D0206.txt:324",
   "ko": "「이 자식…… 뭐가 우습냐!」"
  },
  {
   "id": 2179,
   "key": "D0206.txt:329",
   "ko": "「쿠로! 그 사내는 위험하다!」"
  },
  {
   "id": 2180,
   "key": "D0206.txt:335",
   "ko": "그런 건 일일이 말하지 않아도 알고 있다｡"
  },
  {
   "id": 2181,
   "key": "D0206.txt:336",
   "ko": "알고는 있지만､ 여기서 물러나 버리면 그대로"
  },
  {
   "id": 2182,
   "key": "D0206.txt:337",
   "ko": "단숨에 공포에 삼켜져 버릴 것 같았다｡"
  },
  {
   "id": 2183,
   "key": "D0206.txt:339",
   "ko": "게다가…… 지금은 내가 이놈을 어떻게든 해야 해!"
  },
  {
   "id": 2184,
   "key": "D0206.txt:340",
   "ko": "라이카 씨와 꼬맹이들을 지킬 수 있는 건 나밖에 없어!"
  },
  {
   "id": 2185,
   "key": "D0206.txt:343",
   "ko": "나를 응시하는 빛 없는 금색 눈동자가 연민의 빛을 띤다｡ 마치 겁먹은 작은 동물을 달래듯이―― 놀라게 하지 않으려고 살며시 손짓하듯이､ 소년은 부드럽게 미소 지었다｡"
  },
  {
   "id": 2186,
   "key": "D0206.txt:352",
   "ko": "「처음 보는 건가…… 라고 해야 하나? 다이쥬지 쿠로｡ 하기야 나는 귀공에 대해 아마도 귀공 이상으로 잘 알고 있다만」"
  },
  {
   "id": 2187,
   "key": "D0206.txt:357",
   "ko": "「――――!? 네놈､ 내 이름을……!」"
  },
  {
   "id": 2188,
   "key": "D0206.txt:372",
   "ko": "놀라는 나에게 소년은 부드러운 미소를 머금은 채 살며시 손을 뻗는다｡ 그 손바닥 끝에 전기를 머금은 빛의 탄환이 생겨났다｡"
  },
  {
   "id": 2189,
   "key": "D0206.txt:378",
   "ko": "「꺄아아아아!」"
  },
  {
   "id": 2190,
   "key": "D0206.txt:383",
   "ko": "「우아아……읏! 쿠로!!」"
  },
  {
   "id": 2191,
   "key": "D0206.txt:388",
   "ko": "「아､ 아아아……읏!」"
  },
  {
   "id": 2192,
   "key": "D0206.txt:394",
   "ko": "꼬맹이들은 라이카 씨를 감싸 안듯이 하며"
  },
  {
   "id": 2193,
   "key": "D0206.txt:395",
   "ko": "떨고 있다｡"
  },
  {
   "id": 2195,
   "key": "D0206.txt:397",
   "ko": "나는…… 움직일 수 없다｡"
  },
  {
   "id": 2196,
   "key": "D0206.txt:399",
   "ko": "큰일이다…… 이 녀석들은…… 이 녀석들만은 지켜야 해!"
  },
  {
   "id": 2197,
   "key": "D0206.txt:405",
   "ko": "「――쿠로!」"
  },
  {
   "id": 2198,
   "key": "D0206.txt:415",
   "ko": "「불공평하니 이름을 밝혀두지｡ 나는 마스터 테리온｡ 마술의 진리를 구도하는 자다」"
  },
  {
   "id": 2199,
   "key": "D0206.txt:425",
   "ko": "「「꺄아아아아아아아아!」」 「치이이잇!」"
  },
  {
   "id": 2200,
   "key": "D0206.txt:468",
   "ko": "「……늦지 않았구나」"
  },
  {
   "id": 2201,
   "key": "D0206.txt:474",
   "ko": "간발의 차였다｡"
  },
  {
   "id": 2202,
   "key": "D0206.txt:475",
   "ko": "나는 다시 마기우스 스타일로 변신해 있었다｡"
  },
  {
   "id": 2203,
   "key": "D0206.txt:476",
   "ko": "온몸을 감싼 검은 날개가 발사된 광탄으로부터 나를 지킨다｡"
  },
  {
   "id": 2204,
   "key": "D0206.txt:482",
   "ko": "「미안하다!」"
  },
  {
   "id": 2205,
   "key": "D0206.txt:487",
   "ko": "「훗…… 이런 곳에서 모처럼의 술자를 죽게 놔둘 성싶으냐」"
  },
  {
   "id": 2206,
   "key": "D0206.txt:492",
   "ko": "알 덕분에 꼬맹이들도 무사하다｡ 하지만――"
  },
  {
