  },
  {
   "id": 50392,
   "key": "ep_ruri01.txt:797",
   "ko": "「보였느냐? 그 얼개가」"
  },
  {
   "id": 50393,
   "key": "ep_ruri01.txt:801",
   "ko": "="
  },
  {
