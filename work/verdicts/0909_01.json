{
 "packet": "0909_01",
 "items": [
  {
   "id": 20015,
   "key": "D0909al.txt:315",
   "ko": "「――이 몸이 그대를 강하게 하리라」"
  },
  {
   "id": 20017,
   "key": "D0909al.txt:327",
   "ko": "입술을 떼고､ 알은 선언한다｡"
  },
  {
   "id": 20018,
   "key": "D0909al.txt:329",
   "ko": "그것은 서약이다｡"
  },
  {
   "id": 20019,
   "key": "D0909al.txt:330",
   "ko": "알이 스스로에게 부과한､ 강철 같은 의지에 의한 성약이다｡"
  },
  {
   "id": 20020,
   "key": "D0909al.txt:336",
   "ko": "「혼자 떠안지 마라｡ 고통도 슬픔도 후회도 우리 둘이서 나누자꾸나」"
  },
  {
   "id": 20021,
   "key": "D0909al.txt:340",
   "ko": "「우리는 전우｡ 우리는 맹우｡ 우리는 비익의 새｡ 우리는 연리의 가지」"
  },
  {
   "id": 20022,
   "key": "D0909al.txt:348",
   "ko": "「함께 마를 베는 검을 들자｡ 함께 암흑을 답파하는 길을 가자」"
  },
  {
   "id": 20023,
   "key": "D0909al.txt:355",
   "ko": "「다이쥬지 쿠로｡ 내 주인이여｡ 이 몸은 그대를 경애하고 신앙하노라!」"
  },
  {
   "id": 20024,
   "key": "D0909al.txt:365",
   "ko": "――――――――――｡ 「……쿠로?」"
  },
  {
   "id": 20025,
   "key": "D0909al.txt:375",
   "ko": "「거참 너란 녀석은……」"
  },
  {
   "id": 20027,
   "key": "D0909al.txt:391",
   "ko": "세계의 이면을 파헤치기 위해､ 사고는 질주한다｡"
  },
  {
   "id": 20028,
   "key": "D0909al.txt:392",
   "ko": "세계의 이음매를 간파하기 위해､ 뇌가 고속으로 연산을 시작한다｡"
  },
  {
   "id": 20029,
   "key": "D0909al.txt:397",
   "ko": "「너 자신은 멋진 말 하고 있다고 생각하겠지만 말이야……」"
  },
  {
   "id": 20030,
   "key": "D0909al.txt:409",
   "ko": "마스터 테리온의 법칙을 깨는 내 법칙을 구축한다｡"
  },
  {
   "id": 20031,
   "key": "D0909al.txt:412",
   "ko": "내가 빚어내는 마술의 그릇｡"
  },
  {
   "id": 20032,
   "key": "D0909al.txt:413",
   "ko": "세계를 낳는 법칙｡"
  },
  {
   "id": 20033,
   "key": "D0909al.txt:416",
   "ko": "우리 마술사에게 절대의 법칙은 없다｡"
  },
  {
   "id": 20034,
   "key": "D0909al.txt:417",
   "ko": "모든 법칙에는 그것을 깨는 식이 존재한다｡"
  },
  {
   "id": 20035,
   "key": "D0909al.txt:420",
   "ko": "즉――!"
  },
  {
   "id": 20036,
   "key": "D0909al.txt:425",
   "ko": "「남을 끌어들인 장본인이 할 소리는 아니라고､ 그건!」"
  },
  {
   "id": 20037,
   "key": "D0909al.txt:445",
   "ko": "……즉､ 이런 식으로､ 다｡"
  },
  {
   "id": 20038,
   "key": "D0909al.txt:449",
   "ko": "데몬베인을 못 박고 있던 검도 십자가도 빛이 되어 소멸한다｡ 녹아내리듯 흩어지는 빛에 비쳐､ 데몬베인도 어슴푸레 빛난다｡"
  },
  {
   "id": 20040,
   "key": "D0909al.txt:463",
   "ko": "「크윽……」"
  },
  {
   "id": 20041,
   "key": "D0909al.txt:466",
   "ko": "해주에 따른 부담으로､ 여기저기 혈관이 터졌다｡"
  },
  {
   "id": 20042,
   "key": "D0909al.txt:467",
   "ko": "눈 안쪽이 뜨겁다｡ 피눈물이 뺨을 타고 흐른다｡"
  },
  {
   "id": 20043,
   "key": "D0909al.txt:469",
   "ko": "하지만…… 그게 어쨌다는 거지?"
  },
  {
   "id": 20044,
   "key": "D0909al.txt:472",
   "ko": "고통을 무시하고､ 나는 일어선다｡"
  },
  {
   "id": 20045,
   "key": "D0909al.txt:481",
   "ko": "자유로워진 데몬베인을 알아채고､ 파괴 로봇들이 일제히 이쪽을 돌아봤다｡"
  },
  {
   "id": 20047,
   "key": "D0909al.txt:483",
   "ko": "데몬베인의 손바닥으로 손짓하며 도발한다｡"
  },
  {
   "id": 20048,
   "key": "D0909al.txt:491",
   "ko": "「……좋아､ 나무인형들아｡ 진심으로 상대해 주지」"
  },
  {
   "id": 20050,
   "key": "D0909al.txt:496",
   "ko": "「쿠로!」"
  },
  {
   "id": 20051,
   "key": "D0909al.txt:501",
   "ko": "「네 콕핏으로 돌아가､ 알｡ 이렇게 된 거 끝까지 해보는 거다!」"
  },
  {
   "id": 20053,
   "key": "D0909al.txt:506",
   "ko": "「! ……아아､ 물론이고말고!」"
  },
  {
   "id": 20054,
   "key": "D0909al.txt:511",
   "ko": "알이 제 시트에 앉았다｡"
  },
  {
   "id": 20056,
   "key": "D0909al.txt:512",
   "ko": "정면의 모니터에 집중한다｡"
  },
  {
   "id": 20057,
   "key": "D0909al.txt:522",
   "ko": "지금 막 파괴 로봇이 팔을 치켜들고 후려치려 하고 있었다｡"
  },
  {
   "id": 20060,
   "key": "D0909al.txt:533",
   "ko": "「증오의 하늘로부터 강림하여……」"
  },
  {
   "id": 20061,
   "key": "D0909al.txt:536",
   "ko": "몸을 비틀어 파괴 로봇의 펀치를 피한다｡"
  },
  {
   "id": 20063,
   "key": "D0909al.txt:537",
   "ko": "쭉 뻗은 그 팔을 붙잡는다｡"
  },
  {
   "id": 20065,
   "key": "D0909al.txt:546",
   "ko": "「올바른 분노를 가슴에……」"
  }
 ]
}