{
 "packet": "0902_06",
 "items": [
  {
   "id": 18404,
   "key": "D0902ru.txt:290",
   "ko": "뭐가 뭔지｡"
  },
  {
   "id": 18406,
   "key": "D0902ru.txt:293",
   "ko": "「아､ 알았으니까 일단 진정해｡ 진정하고 커피를……」"
  },
  {
   "id": 18407,
   "key": "D0902ru.txt:298",
   "ko": "「부라릿」 「째릿」"
  },
  {
   "id": 18409,
   "key": "D0902ru.txt:306",
   "ko": "「커커커커피､ 여여여여기 놓아두겠습니다……!」"
  },
  {
   "id": 18414,
   "key": "D0902ru.txt:308",
   "ko": "이가 맞부딪칠 만큼 떨고 있었다｡"
  },
  {
   "id": 18415,
   "key": "D0902ru.txt:309",
   "ko": "눈가에 눈물이 맺혀 있었다｡"
  },
  {
   "id": 18416,
   "key": "D0902ru.txt:310",
   "ko": "그만큼 진심으로 무서웠다｡"
  },
  {
   "id": 18417,
   "key": "D0902ru.txt:314",
   "ko": "「쿠로……이런 놈에게 차를 낼 필요는 없다｡ 고귀한 태생의 어르신이시니 말이다」"
  },
  {
   "id": 18418,
   "key": "D0902ru.txt:317",
   "ko": "「서민의 음료 따위 입에 맞기는커녕 진흙을 들이켜는 것과 매한가지겠지」"
  },
  {
   "id": 18419,
   "key": "D0902ru.txt:321",
   "ko": "「당신이 저희를 어떤 눈으로 보든 딱히 흥미도 없습니다만」"
  },
  {
   "id": 18420,
   "key": "D0902ru.txt:324",
   "ko": "「이 하도 루리､ 많은 이들의 뒷받침으로 지금이 있다는 사실을 잊은 적은 단 한 번도 없습니다」"
  },
  {
   "id": 18421,
   "key": "D0902ru.txt:327",
   "ko": "「그러니 당신처럼 남을 깎아내리는 생각이 생길 리도 없지요」"
  },
  {
   "id": 18422,
   "key": "D0902ru.txt:330",
   "ko": "「진흙을 들이켜는 건 당신 쪽 아닌가요? 알 아지프」"
  },
  {
   "id": 18423,
   "key": "D0902ru.txt:334",
   "ko": "「흥……겉모습만이라면 얼마든지 꾸며댈 수 있느니라､ 계집애」"
  },
  {
   "id": 18425,
   "key": "D0902ru.txt:337",
   "ko": "「허나 시커멓게 더러운 뱃속만은 어찌할 도리가 없지만 말이다」"
  },
  {
   "id": 18426,
   "key": "D0902ru.txt:341",
   "ko": "「웃기시네요､ 겉모습을 꾸며대는 게 어느 쪽인가요､ 완전히 썩어 문드러진 좀먹은 헌책 씨」"
  },
  {
   "id": 18427,
   "key": "D0902ru.txt:344",
   "ko": "「아무리 인간인 척 잘 흉내 내 봐야 어차피 괴물｡ 당신이 인간의 무엇을 이해할 수 있다는 건가요」"
  },
  {
   "id": 18428,
   "key": "D0902ru.txt:350",
   "ko": "「네 이놈……!」"
  },
  {
   "id": 18429,
   "key": "D0902ru.txt:354",
   "ko": "「……흥!」"
  },
  {
   "id": 18431,
   "key": "D0902ru.txt:362",
   "ko": "……위험하다｡"
  },
  {
   "id": 18433,
   "key": "D0902ru.txt:363",
   "ko": "뭔가 마침내 진짜 살의가 감돌기 시작했다｡"
  },
  {
   "id": 18434,
   "key": "D0902ru.txt:364",
   "ko": "이 이상은 안 된다｡"
  },
  {
   "id": 18436,
   "key": "D0902ru.txt:366",
   "ko": "눈물을 닦고､"
  },
  {
   "id": 18437,
   "key": "D0902ru.txt:367",
   "ko": "겁먹은 몸을 다잡고､"
  },
  {
   "id": 18438,
   "key": "D0902ru.txt:368",
   "ko": "용기를 내어――"
  },
  {
   "id": 18439,
   "key": "D0902ru.txt:371",
   "ko": "「이､ 이봐……알도 공주님도 조､ 좀 심한 거 아냐? 자､ 자……빨리 안 마시면 커피도 식고､ 이쯤에서 한숨 돌리……」"
  },
  {
   "id": 18440,
   "key": "D0902ru.txt:377",
   "ko": "「다이쥬지 씨는 가만히 계세요!」"
  },
  {
   "id": 18441,
   "key": "D0902ru.txt:382",
   "ko": "「아니 그보다､ 누구 탓이라 여기는 게냐아아아!」"
  },
  {
   "id": 18442,
   "key": "D0902ru.txt:387",
   "ko": "「히익……!」"
  },
  {
   "id": 18443,
   "key": "D0902ru.txt:389",
   "ko": "비명은 그러나 소리가 되기를 거부하고 그저 숨을 삼키는 소리만이 새어 나왔다｡"
  },
  {
   "id": 18444,
   "key": "D0902ru.txt:390",
   "ko": "다리에 힘이 풀려 그 자리에 주저앉는다｡"
  },
  {
   "id": 18449,
   "key": "D0902ru.txt:392",
   "ko": "무릎이 후들거렸다｡"
  },
  {
   "id": 18450,
   "key": "D0902ru.txt:393",
   "ko": "맺힌 눈물은 이미 흘러넘쳐 시야가 엉망으로 일그러져 있었다｡"
  },
  {
   "id": 18451,
   "key": "D0902ru.txt:394",
   "ko": "죽고 싶지 않다고 진심으로 생각했다｡"
  },
  {
   "id": 18453,
   "key": "D0902ru.txt:397",
   "ko": "「훌쩍……훌쩍……」"
  },
  {
   "id": 18455,
   "key": "D0902ru.txt:403",
   "ko": "「테켈리 리」"
  },
  {
   "id": 18456,
   "key": "D0902ru.txt:407",
   "ko": "잘못된 방향으로 젤리 같은 물체의 촉수가 부드럽게 나를 감싸 안고 위로한다｡"
  },
  {
   "id": 18457,
   "key": "D0902ru.txt:409",
   "ko": "따뜻했다｡"
  },
  {
   "id": 18458,
   "key": "D0902ru.txt:410",
   "ko": "동시에 떨어질 데까지 떨어졌다고 생각했다｡"
  },
  {
   "id": 18459,
   "key": "D0902ru.txt:413",
   "ko": "「……마실래?」"
  }
 ]
}