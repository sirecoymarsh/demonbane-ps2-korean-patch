{
 "packet": "1416_01",
 "items": [
  {
   "id": 40677,
   "key": "D1416al.txt:242",
   "ko": "「…………자기한테 죄인의 생사를 정하고 심판할 권리가 있다고 생각하는 거야?」 심술궂은 미소를 지으며 물어온다｡"
  },
  {
   "id": 40678,
   "key": "D1416al.txt:249",
   "ko": "표정이 시시각각 바뀌는 건､ 역시 본바탕인 모양이다｡"
  },
  {
   "id": 40679,
   "key": "D1416al.txt:254",
   "ko": "「아니｡ 마음에 안 들어서 날려버렸을 뿐이야」"
  },
  {
   "id": 40680,
   "key": "D1416al.txt:259",
   "ko": "「그러니까 나도 아마､ 너랑 별반 다르지 않아」 이번에는 아까와 같은 미묘한"
  },
  {
   "id": 40681,
   "key": "D1416al.txt:264",
   "ko": "――하지만 다소 밝아진 얼굴로 「쿠로답네에」"
  },
  {
   "id": 40682,
   "key": "D1416al.txt:275",
   "ko": "하고､ 웃었다｡"
  },
  {
   "id": 40683,
   "key": "D1416al.txt:281",
   "ko": "「……훈훈해지는 건 그대 마음이다만､ 이러는 사이에도 세계는 위기다」"
  },
  {
   "id": 40684,
   "key": "D1416al.txt:287",
   "ko": "「우옷」"
  },
  {
   "id": 40685,
   "key": "D1416al.txt:303",
   "ko": "그러고 보니 크툴루는 현재진행형으로 대절찬 폭주 중이었다｡"
  },
  {
   "id": 40686,
   "key": "D1416al.txt:309",
   "ko": "「우옷､ 이 아니지 않느냐! 중요한 걸 잊지 마라!」"
  },
  {
   "id": 40687,
   "key": "D1416al.txt:315",
   "ko": "「잊은 건 아니라고｡ 그냥 잠깐 의식 밖으로 나가 있었을 뿐이야」"
  },
  {
   "id": 40688,
   "key": "D1416al.txt:322",
   "ko": "「내보내지 마라!」"
  },
  {
   "id": 40689,
   "key": "D1416al.txt:330",
   "ko": "여전한 우리를 보고､ 이번에야말로 엔네아는 「아하하」 하고 진짜 웃음을 지었다｡"
  },
  {
   "id": 40690,
   "key": "D1416al.txt:334",
   "ko": "="
  },
  {
   "id": 40691,
   "key": "D1416al.txt:337",
   "ko": "="
  },
  {
   "id": 40692,
   "key": "D1416al.txt:343",
   "ko": "="
  },
  {
   "id": 40693,
   "key": "D1416al.txt:348",
   "ko": "「뭐야? 갑자기」 의아해하는 나에게､"
  },
  {
   "id": 40694,
   "key": "D1416al.txt:352",
   "ko": "엔네아는 온화한､ 만족스러운 미소로"
  },
  {
   "id": 40695,
   "key": "D1416al.txt:358",
   "ko": "「쿠로는 정말 강해｡ 네로가 생각했던 것보다 훨씬」 「그러니까 네로가 아니라……」"
  },
  {
   "id": 40696,
   "key": "D1416al.txt:368",
   "ko": "나무라는 나에게､ 엔네아는 온화한､"
  },
  {
   "id": 40697,
   "key": "D1416al.txt:370",
   "ko": "만족스러운 미소로 「네로는 결심했다고 생각했어」"
  },
  {
   "id": 40698,
   "key": "D1416al.txt:383",
   "ko": "「네로는 네로를 멸할 수 없도록 저주받았지만､ 샤이닝 트라페조헤드론이라면 세계와의 『인연』을 끊고 저주를 무효화할 수 있어――」 「그러면 네로는 네로를 죽일 수 있을 터였어」"
  },
  {
   "id": 40699,
   "key": "D1416al.txt:398",
   "ko": "="
  },
  {
   "id": 40700,
   "key": "D1416al.txt:404",
   "ko": "「필요한 건 결심｡ 네로 자신을 멸하기 위한 용기｡ 그 강함을 네로는 쿠로에게서 나눠 받으려 했어」 「하지만 아니었어｡ 아니었네｡ 그런 건 강함이 아니야」"
  },
  {
   "id": 40701,
   "key": "D1416al.txt:414",
   "ko": "「진부하고 뻔한 설교지만､ 그런 건 도망일 뿐이었어……」 엔네아는 온화한､ 만족스러운 미소로 고하고――"
  },
  {
   "id": 40702,
   "key": "D1416al.txt:423",
   "ko": "나는 막막한 불안에 짓눌릴 것만 같다｡"
  },
  {
   "id": 40703,
   "key": "D1416al.txt:430",
   "ko": "「엔네아､ 너､ 아직……!」 내 외침은 도중에 가로막혔다｡"
  },
  {
   "id": 40704,
   "key": "D1416al.txt:450",
   "ko": "그녀의 입술에 내 입술이 겹쳐진다｡ 그것은 한순간이었지만､"
  },
  {
   "id": 40705,
   "key": "D1416al.txt:454",
   "ko": "지독히 긴 한순간으로 느껴졌다｡ 엔네아의 입술이､ 천천히 떨어진다｡"
  },
  {
   "id": 40706,
   "key": "D1416al.txt:470",
   "ko": "「만약 다음이 온다면 네로는 더더욱 강해질 거야」 「절망의 끝에서 발버둥 쳐도､ 아아､ 살아 있다고 자랑할 수 있을 만큼」"
  },
  {
   "id": 40707,
   "key": "D1416al.txt:483",
   "ko": "="
  },
  {
   "id": 40708,
   "key": "D1416al.txt:486",
   "ko": "="
  },
  {
   "id": 40709,
   "key": "D1416al.txt:489",
   "ko": "="
  },
  {
   "id": 40710,
   "key": "D1416al.txt:494",
   "ko": "하지만 뻗은 손가락은､ 한 걸음 앞에서"
  },
  {
   "id": 40711,
   "key": "D1416al.txt:496",
   "ko": "엔네아에게 닿지 못하고―― 「고마워､ 엔네아가 아주 좋아하는 쿠로」"
  },
  {
   "id": 40712,
   "key": "D1416al.txt:508",
   "ko": "「그리고……모처럼 사 준 옷 망쳐 버리겠네」"
  },
  {
   "id": 40713,
   "key": "D1416al.txt:517",
   "ko": "「――미안해」 ――얄미울 만큼 희고 가녀린 손이､ 엔네아의 배를 꿰뚫었다｡"
  },
  {
   "id": 40714,
   "key": "D1416al.txt:551",
   "ko": "「뭐……」 다섯 손가락이 잡을 곳을 찾아､ 부들거린다｡"
  },
  {
   "id": 40715,
   "key": "D1416al.txt:564",
   "ko": "엔네아의 배를 찢어발긴다｡ 다섯 손가락이 열 개로｡"
  },
  {
   "id": 40716,
   "key": "D1416al.txt:568",
   "ko": "오른손에 이어､ 왼손이 바깥 공기에 드러난다｡ 더욱더 엔네아를 찢어발겨 간다｡"
  }
 ]
}