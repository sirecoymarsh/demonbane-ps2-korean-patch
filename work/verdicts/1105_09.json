{
 "packet": "1105_09",
 "items": [
  {
   "id": 23955,
   "key": "D1105ru.txt:28",
   "ko": "지금까지 함께 싸워온 주인들｡"
  },
  {
   "id": 23956,
   "key": "D1105ru.txt:29",
   "ko": "마도서인 나를 조종하고､ 귀계신을 몰아 싸우는 술사들｡"
  },
  {
   "id": 23957,
   "key": "D1105ru.txt:30",
   "ko": "많은 술사가 사신의 세력과의 싸움에서､ 상처 입고 쓰러져갔다｡"
  },
  {
   "id": 23958,
   "key": "D1105ru.txt:33",
   "ko": "그 일에 의문도 후회도 고통도 없었다｡"
  },
  {
   "id": 23959,
   "key": "D1105ru.txt:34",
   "ko": "싸우는 것이 내 사명｡"
  },
  {
   "id": 23960,
   "key": "D1105ru.txt:35",
   "ko": "술사는 사명을 다하기 위한 도구｡"
  },
  {
   "id": 23961,
   "key": "D1105ru.txt:36",
   "ko": "귀계신의 부품 중 하나에 불과하다｡"
  },
  {
   "id": 23962,
   "key": "D1105ru.txt:38",
   "ko": "그들을 진정한 전사로 인정하려 해도､"
  },
  {
   "id": 23963,
   "key": "D1105ru.txt:39",
   "ko": "사악과 싸우는 강한 의지에 경의를 표하려 해도"
  },
  {
   "id": 23964,
   "key": "D1105ru.txt:40",
   "ko": "그 사실은 변하지 않는다｡"
  },
  {
   "id": 23965,
   "key": "D1105ru.txt:42",
   "ko": "이 외도의 대전 『알 아지프』는､ 스스로를 손에 쥔 술사의 시체를 쌓아 올리며､ 투쟁의 길을 가는 자이니까｡"
  },
  {
   "id": 23966,
   "key": "D1105ru.txt:44",
   "ko": "그러니까､ 다이쥬지 쿠로｡"
  },
  {
   "id": 23967,
   "key": "D1105ru.txt:45",
   "ko": "그 남자 또한 마찬가지｡"
  },
  {
   "id": 23968,
   "key": "D1105ru.txt:46",
   "ko": "투쟁의 길을 가기 위한､ 언젠가는 넘어서야 할､ 그저 통과점에 불과하다｡"
  },
  {
   "id": 23969,
   "key": "D1105ru.txt:47",
   "ko": "불과했어야 했다｡"
  },
  {
   "id": 23970,
   "key": "D1105ru.txt:48",
   "ko": "그런데｡"
  },
  {
   "id": 23971,
   "key": "D1105ru.txt:57",
   "ko": "「――――큿」"
  },
  {
   "id": 23972,
   "key": "D1105ru.txt:62",
   "ko": "중환자실｡"
  },
  {
   "id": 23973,
   "key": "D1105ru.txt:63",
   "ko": "잠든 쿠로를､ 창문 너머로 바라보고 있다｡"
  },
  {
   "id": 23974,
   "key": "D1105ru.txt:64",
   "ko": "지금 이 순간에도､ 다가오는 죽음의 그림자와 계속 싸우는 쿠로를､ 뚫어지게 지켜보고 있다｡"
  },
  {
   "id": 23975,
   "key": "D1105ru.txt:70",
   "ko": "가슴에 통증｡"
  },
  {
   "id": 23976,
   "key": "D1105ru.txt:71",
   "ko": "비명처럼 마음이 삐걱거린다｡"
  },
  {
   "id": 23977,
   "key": "D1105ru.txt:73",
   "ko": "그것은 초조함｡"
  },
  {
   "id": 23978,
   "key": "D1105ru.txt:74",
   "ko": "항상 몸을 태우는 투쟁에 대한 초조함｡"
  },
  {
   "id": 23979,
   "key": "D1105ru.txt:75",
   "ko": "그조차도 가볍게 능가하는 초조함｡"
  },
  {
   "id": 23980,
   "key": "D1105ru.txt:76",
   "ko": "천년의 초조함보다도､ 격렬하게 몸을 태우는 초조함｡"
  },
  {
   "id": 23981,
   "key": "D1105ru.txt:78",
   "ko": "뭐지､ 이 초조함은｡"
  },
  {
   "id": 23982,
   "key": "D1105ru.txt:79",
   "ko": "이 정도의 격정에､ 휩싸인 적은 지금까지 없었다｡"
  },
  {
   "id": 23983,
   "key": "D1105ru.txt:81",
   "ko": "그래서 초조함의 정체를 모른다｡"
  },
  {
   "id": 23984,
   "key": "D1105ru.txt:82",
   "ko": "알 수가 없다｡"
  },
  {
   "id": 23985,
   "key": "D1105ru.txt:83",
   "ko": "저항할 수가 없다――"
  },
  {
   "id": 23986,
   "key": "D1105ru.txt:85",
   "ko": "인정해버리면 편했을 것이다｡"
  },
  {
   "id": 23987,
   "key": "D1105ru.txt:86",
   "ko": "소녀는 초조함의 정체를 모르는 것이 아니다｡"
  },
  {
   "id": 23988,
   "key": "D1105ru.txt:87",
   "ko": "모르는 척､ 눈치채지 못한 척을 계속하고 있을 뿐이다｡"
  },
  {
   "id": 23989,
   "key": "D1105ru.txt:88",
   "ko": "지금까지도､ 천년의 유구함 속에서도 이 초조함은､ 소녀를 태워왔다｡"
  },
  {
   "id": 23990,
   "key": "D1105ru.txt:90",
   "ko": "단지､ 그것은 마음 깊숙이 조금 연기만 나고 있던 불꽃｡"
  },
  {
   "id": 23991,
   "key": "D1105ru.txt:91",
   "ko": "눈에 보이지 않게 계속 타오르다가… 깨달았을 때는 작열을 품고 있다｡"
  },
  {
   "id": 23992,
   "key": "D1105ru.txt:92",
   "ko": "마침내 외면할 수 없게 된 것뿐｡"
  },
  {
   "id": 23993,
   "key": "D1105ru.txt:94",
   "ko": "초조함의 정체는――죄책감｡"
  },
  {
   "id": 23994,
   "key": "D1105ru.txt:95",
   "ko": "천년의 유구함､ 오랜 세월 동안､ 소녀를 갉아먹고 있었다｡"
  }
 ]
}