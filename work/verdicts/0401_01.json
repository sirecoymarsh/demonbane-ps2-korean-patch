  },
  {
   "id": 4146,
   "key": "D0401.txt:336",
   "ko": "「그렇다｡ 그 일에 대해서다만……이 집에는 침대가 없느니라」"
  },
  {
   "id": 4147,
   "key": "D0401.txt:341",
   "ko": "「……소파에서 자는 데 익숙해져서 말이지｡ 요즘 계속 너한테 점거당하고 있지만」"
  },
  {
   "id": 4148,
   "key": "D0401.txt:351",
   "ko": "「이 몸은 섬세하니라｡ 언제까지고 이런 식으로는 잘 수 없다」"
  },
  {
   "id": 4149,
   "key": "D0401.txt:358",
   "ko": "「그럼 비켜｡ 거긴 내 자리라고」"
  },
  {
   "id": 4150,
   "key": "D0401.txt:367",
   "ko": "「말할 것도 없느니라｡ 자」"
  },
  {
   "id": 4151,
   "key": "D0401.txt:376",
   "ko": "딱! 하고 손가락을 튕긴다｡"
  },
  {
   "id": 4152,
   "key": "D0401.txt:377",
   "ko": "그것을 신호로 쇼고스가 움직이기 시작했다｡"
  },
  {
   "id": 4153,
   "key": "D0401.txt:384",
   "ko": "몸을 꿈틀거리며 변형해 간다｡ 그 메타모르포제 방식도 실로 악몽 같았다｡"
  },
  {
   "id": 4154,
   "key": "D0401.txt:387",
   "ko": "이윽고 꿈틀거림이 멎고……쇼고스는 마치 워터베드 같은 모습으로 변모해 있었다｡"
  },
  {
   "id": 4155,
   "key": "D0401.txt:389",
   "ko": "즉……그런 건가?"
  },
  {
   "id": 4156,
   "key": "D0401.txt:400",
   "ko": "「후훗｡ 이걸로 겨우 편히 잘 수 있겠구나」 「아니……정말로?」"
  },
  {
   "id": 4157,
   "key": "D0401.txt:412",
   "ko": "「응? 부러우냐? 허나 빌려주지 않을 것이다」"
  },
  {
   "id": 4159,
   "key": "D0401.txt:419",
   "ko": "「오히려 이쪽에서 전력으로 사양하겠어」"
  },
  {
   "id": 4160,
   "key": "D0401.txt:422",
   "ko": "……이제 아무래도 좋다｡ 이형은 이형끼리 실컷 어울려나 달라고 진심으로 생각했다｡"
  },
  {
   "id": 4161,
   "key": "D0401.txt:439",
   "ko": "「……이거 참」 익숙한 소파에 몸을 맡기고 한숨을 쉰다｡"
  },
  {
   "id": 4162,
   "key": "D0401.txt:443",
   "ko": "뭐､ 이걸로 오랜만에 기분 좋게 잘 수 있겠다｡"
  },
  {
   "id": 4163,
   "key": "D0401.txt:446",
   "ko": "……요즘､ 폭풍 같은 나날이다｡"
  },
  {
   "id": 4164,
   "key": "D0401.txt:449",
   "ko": "알의 단편……페이지 몬스터라고나 부를까｡"
  }
 ]
