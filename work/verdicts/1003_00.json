{
 "packet": "1003_00",
 "items": [
  {
   "id": 20872,
   "key": "D1003al.txt:24",
   "ko": "「바람이 온다!」"
  },
  {
   "id": 20873,
   "key": "D1003al.txt:30",
   "ko": "「치이이이이!」 「꺄아아아아!」"
  },
  {
   "id": 20874,
   "key": "D1003al.txt:72",
   "ko": "로드 비야키가 쏘는 진공 칼날을 빌딩을 방패 삼아 피한다｡ 잘게 썰린 빌딩 잔해가 데몬베인에 쏟아졌다｡"
  },
  {
   "id": 20875,
   "key": "D1003al.txt:89",
   "ko": "「오호호호호! 왜 그래､ 쿠로 군? 좀 더 놀아보자니까!」"
  },
  {
   "id": 20876,
   "key": "D1003al.txt:105",
   "ko": "정면에서는 벨제뷰트가 장기를 두른 양팔을 내밀며 다가온다｡"
  },
  {
   "id": 20877,
   "key": "D1003al.txt:110",
   "ko": "「니토크리스의 거울!」 「!?」"
  },
  {
   "id": 20878,
   "key": "D1003al.txt:132",
   "ko": "="
  },
  {
   "id": 20879,
   "key": "D1003al.txt:141",
   "ko": "="
  },
  {
   "id": 20880,
   "key": "D1003al.txt:162",
   "ko": "="
  },
  {
   "id": 20881,
   "key": "D1003al.txt:173",
   "ko": "="
  },
  {
   "id": 20882,
   "key": "D1003al.txt:174",
   "ko": "섬광이 벨제뷰트를 감싼다｡"
  },
  {
   "id": 20883,
   "key": "D1003al.txt:181",
   "ko": "「크윽……!?」"
  },
  {
   "id": 20884,
   "key": "D1003al.txt:225",
   "ko": "탄창을 갈아 끼운 크투가를 풀오토로 사격｡ 모든 탄환을 단숨에 토해낸다｡ 탄피에 섞인 이븐 가지의 분말이 마술 반응을 일으켜 폭발했다｡"
  },
  {
   "id": 20885,
   "key": "D1003al.txt:227",
   "ko": "폭염이 벨제뷰트를 삼킨다――"
  },
  {
   "id": 20886,
   "key": "D1003al.txt:243",
   "ko": "「…………읏!?」"
  },
  {
   "id": 20887,
   "key": "D1003al.txt:246",
   "ko": "오싹 한기가 스쳐 지나간다｡ 어느새 배후에 갑옷무사형 귀계신이 서 있었다｡"
  },
  {
   "id": 20888,
   "key": "D1003al.txt:251",
   "ko": "「귀계신 『황아』다｡ 소수를 다수로 짓밟는 짓은 좋아하지 않지만､ 각오해라」"
  },
  {
   "id": 20889,
   "key": "D1003al.txt:268",
   "ko": "소리도 없이 두 자루의 칼이 휘둘러진다｡"
  },
  {
   "id": 20891,
   "key": "D1003al.txt:269",
   "ko": "기체를 비틀지만 늦었다｡"
  },
  {
   "id": 20892,
   "key": "D1003al.txt:278",
   "ko": "이렇다 할 저항도 없이 데몬베인의 왼팔이 맥없이 잘려나간다｡"
  },
  {
   "id": 20893,
   "key": "D1003al.txt:280",
   "ko": "나는 비튼 기세 그대로 기체를 회전시켜､ 데우스 마키나――황아에게 돌려차기를 먹였다｡"
  },
  {
   "id": 20894,
   "key": "D1003al.txt:292",
   "ko": "「아틀란티스 스트라이크!」"
  },
  {
   "id": 20895,
   "key": "D1003al.txt:297",
   "ko": "「뭐라고!」"
  },
  {
   "id": 20897,
   "key": "D1003al.txt:308",
   "ko": "시공간 왜곡에 의한 역류 에너지가 황아의 거체를 날려버린다｡ 하지만 가드가 제때 들어갔나 보다｡"
  },
  {
   "id": 20898,
   "key": "D1003al.txt:313",
   "ko": "빌딩을 무너뜨리며 쓰러진 황아의 기체에는 그래도 눈에 띄는 손상이 보이지 않는다｡"
  },
  {
   "id": 20899,
   "key": "D1003al.txt:321",
   "ko": "「젠장……!」"
  },
  {
   "id": 20901,
   "key": "D1003al.txt:325",
   "ko": "「제법이군､ 다이쥬지 쿠로 군!」 「――――!?」"
  },
  {
   "id": 20902,
   "key": "D1003al.txt:341",
   "ko": "네 다리의 데우스 마키나가 상공에 떠 있다｡"
  },
  {
   "id": 20903,
   "key": "D1003al.txt:345",
   "ko": "기체 하부에 있는 사람 얼굴 같은 것이 알아들을 수 없을 만큼 고속으로 주문을 왼다｡ 마술이 구현화된다｡"
  },
  {
   "id": 20904,
   "key": "D1003al.txt:347",
   "ko": "삼방에서 충격파｡"
  },
  {
   "id": 20905,
   "key": "D1003al.txt:348",
   "ko": "거대 물질의 공간 전이｡"
  },
  {
   "id": 20906,
   "key": "D1003al.txt:357",
   "ko": "데몬베인의 주위를 삼방으로 둘러싸고 반인반기의 거인이 현현했다｡"
  },
  {
   "id": 20907,
   "key": "D1003al.txt:360",
   "ko": "「이놈들……!?」"
  },
  {
   "id": 20908,
   "key": "D1003al.txt:365",
   "ko": "「『에이본의 서』의 귀계신 사이크라노쉬､ 그 위력을 알아 두는 게 좋을 거다!」"
  },
  {
   "id": 20909,
   "key": "D1003al.txt:369",
   "ko": "「노래하라! 저주하라! 갈바! 오토! 비텔리우스!」"
  },
  {
   "id": 20910,
   "key": "D1003al.txt:373",
   "ko": "피눈물을 흘리며 세 거인이 포효한다｡"
  },
  {
   "id": 20911,
   "key": "D1003al.txt:374",
   "ko": "거인들 사이를 빛나는 마술 문자로 이어 삼각형의 링을 만들었다｡"
  },
  {
   "id": 20912,
   "key": "D1003al.txt:375",
   "ko": "포효는 그 링 안에서 반사된다｡"
  },
  {
   "id": 20913,
   "key": "D1003al.txt:383",
   "ko": "애석과 통곡으로 가득 찬 포효가 파괴의 파문이 되어 데몬베인을 덮치고､ 파멸의 저주가 되어 우리 영혼을 얼어붙게 한다｡"
  },
  {
   "id": 20914,
   "key": "D1003al.txt:391",
   "ko": "「아아아아아아아아아아!」"
  }
 ]
}