   "ko": "="
  },
  {
   "id": 45868,
   "key": "D1510le.txt:376",
   "ko": "그것은 산달폰의 힘에 대한 두려움이며――"
  },
  {
   "id": 45869,
   "key": "D1510le.txt:376",
