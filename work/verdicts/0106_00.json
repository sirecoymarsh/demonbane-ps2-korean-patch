  },
  {
   "id": 684,
   "key": "D0106.txt:98",
   "ko": "「……그대가､ 이 몸을?」"
  },
  {
   "id": 685,
   "key": "D0106.txt:102",
   "ko": "="
  },
  {
   "id": 686,
   "key": "D0106.txt:120",
   "ko": "="
  },
  {
   "id": 687,
   "key": "D0106.txt:130",
   "ko": "="
  },
  {
   "id": 688,
   "key": "D0106.txt:139",
   "ko": "「……술자 없이 무리를 했으니 말이다｡ 구성을 유지할 수 없게 된 모양이구나」 「후훗､ 게다가 아이온까지 잃어서는 꼴사납다고밖에 할 말이 없구나……」"
  },
  {
   "id": 689,
   "key": "D0106.txt:156",
   "ko": "「으음-､ 뭐가 뭔지 잘 모르겠지만､ 이대로면 안 좋잖아? 지금 병원에라도……」"
  },
  {
   "id": 690,
   "key": "D0106.txt:161",
   "ko": "「소용없다…… 이 몸이라면 괜찮다｡ 폐를 끼쳤구나…… 응?」"
  },
  {
   "id": 691,
   "key": "D0106.txt:171",
   "ko": "등에 떠 있는 날개 ――무언가의 마술 장치일까?――"
  },
  {
   "id": 692,
   "key": "D0106.txt:173",
   "ko": "를 파닥거리며 의아한 듯 내 얼굴을 들여다본다｡ 또다｡"
  },
  {
   "id": 693,
   "key": "D0106.txt:177",
   "ko": "또､ 그 빨려들 것 같은 비취색 눈동자｡"
  },
  {
   "id": 694,
   "key": "D0106.txt:178",
   "ko": "="
  },
  {
   "id": 695,
   "key": "D0106.txt:183",
   "ko": "「그대…… 음습한 어둠의 냄새가 나는구나｡ 마술사이냐?」"
  },
  {
   "id": 696,
   "key": "D0106.txt:189",
   "ko": "="
  },
  {
   "id": 697,
   "key": "D0106.txt:195",
   "ko": "="
  },
  {
   "id": 698,
   "key": "D0106.txt:204",
   "ko": "="
  },
  {
   "id": 699,
   "key": "D0106.txt:210",
   "ko": "「아니라니…… 그런 짓을 할 수 있는 건 마술사 말고는……」"
  },
  {
   "id": 700,
   "key": "D0106.txt:220",
   "ko": "「그런가…… 마술사가 아니라는 건 『책』을 지니고 있지 않다는 뜻인가」"
  },
  {
   "id": 701,
   "key": "D0106.txt:227",
   "ko": "「그것 참 잘됐구나｡ 보아하니 상당한 자질을 감추고 있도다｡ 실로 요행이로다」 「뭐､ 이리도 형편이 좋으면 누군가에게 놀아나고 있는 기분이 들지 않는 것도 아니다만…… 상관없겠지」"
  },
  {
   "id": 702,
   "key": "D0106.txt:244",
   "ko": "="
  },
  {
   "id": 703,
   "key": "D0106.txt:249",
   "ko": "="
  },
  {
   "id": 704,
   "key": "D0106.txt:265",
   "ko": "「…………………………」"
  },
  {
   "id": 705,
   "key": "D0106.txt:278",
   "ko": "「후하하하하하하! 잘 숨었다고 여겨도､ 이! 대! 천! 재! 인 이 몸 닥터어어어어 웨에에스트오오오! ……의 눈을 속이는 짓 따위 임파서블한 것이다!」 「제 어리석음과 무력함을 절묘한 배합으로 믹스한 후회에 눈물지으며､ 얌전히 오라를 받거라!」"
  },
  {
   "id": 706,
   "key": "D0106.txt:287",
   "ko": "「……확실히 내 인생에서 지금 이 순간에 필적할 후회를 맛본 적은 없군」"
  },
  {
   "id": 707,
   "key": "D0106.txt:297",
   "ko": "분명――닥터 웨스트라고 했던가､ 그 외에도 우르르 복면 남자들이 나타난다｡"
  }
