  {
   "id": 41554,
   "key": "D1502al.txt:1819",
   "ko": "="
  },
  {
   "id": 41555,
   "key": "D1502al.txt:1831",
   "ko": "크툴루와 동격 이상의 존재력을 내뿜는 것들｡"
  },
  {
   "id": 41556,
   "key": "D1502al.txt:1832",
   "ko": "그것도 무수히｡ 단 하나로 지구를 멸망시키기에 충분한 존재가 이렇게나……!"
  },
  {
   "id": 41557,
   "key": "D1502al.txt:1841",
   "ko": "「요그 소토스는 모든 시간과 시공에 존재하며､ 구지배자가 사는 외우주로 이어져 있다…… 알 아지프가 말한 대로다」 「만약 신들이 이곳에 문이 열린 것을 알면 어찌 될까?」"
  },
  {
   "id": 41558,
   "key": "D1502al.txt:1851",
   "ko": "「――노도와 같이 사신의 무리가 이 세계로 밀려들 것이다……」 ――――읏읏!?"
  },
  {
   "id": 41559,
   "key": "D1502al.txt:1876",
   "ko": "="
  },
  {
   "id": 41560,
   "key": "D1502al.txt:1895",
   "ko": "「하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하!」 「알겠느냐､ 다이쥬지 쿠로! 세계를 구하고 싶다면 나를 쫓아오너라! 세계의 끝､ 시간의 끝까지도!」"
  },
  {
   "id": 41561,
   "key": "D1502al.txt:1914",
   "ko": "「언제인지 모를 시간의 틈새､ 어디인지 모를 세계의 저편에서､ 나와 그대의 마지막 결착을 짓지 않겠느냐!」"
  },
  {
   "id": 41562,
   "key": "D1502al.txt:1928",
   "ko": "「자､ 이것이 최종 악장이다! 끝의 끝까지 이 나를! 신의 아들을 즐겁게 하라!」 「――신을 죽이는 칼날이여!」"
  },
  {
   "id": 41563,
   "key": "D1502al.txt:1978",
   "ko": "높은 웃음소리를 남기고､ 리베르 레기스가 날아오른다｡"
  },
  {
   "id": 41564,
   "key": "D1502al.txt:1979",
   "ko": "="
  },
  {
   "id": 41565,
   "key": "D1502al.txt:1981",
   "ko": "="
  },
  {
   "id": 41566,
   "key": "D1502al.txt:1997",
   "ko": "="
  },
  {
   "id": 41567,
   "key": "D1502al.txt:2013",
   "ko": "리베르 레기스의 뒤를 쫓으려고 샨타크의 출력을 최대로 개방하려 한다…… 하지만 그때 조종계의 주도권을 알에게 빼앗겼다｡ 출력이 저하된다｡"
  },
  {
   "id": 41568,
   "key": "D1502al.txt:2023",
   "ko": "「서두르지 마라､ 쿠로!」"
  },
  {
   "id": 41569,
   "key": "D1502al.txt:2028",
   "ko": "="
  },
  {
   "id": 41570,
   "key": "D1502al.txt:2046",
   "ko": "「멈춰라! 서두르지 말라 하지 않느냐!」 「어､ 어째서……!」"
  },
  {
   "id": 41571,
   "key": "D1502al.txt:2061",
   "ko": "「진정하거라､ 쿠로｡ 아무리 차원의 문이 열렸다 한들､ 당장 이형들이 밀려드는 것은 아니니라!」"
  },
  {
   "id": 41572,
   "key": "D1502al.txt:2065",
   "ko": "「그보다 그대는 신중히 결단해야 하느니라!」"
  },
  {
   "id": 41573,
   "key": "D1502al.txt:2072",
   "ko": "알의 진지한 시선이 똑바로 나를 붙잡고 놓아주지 않는다｡ 비취빛 눈동자 너머에 당황한 내 얼굴이 비치고 있었다｡"
  },
  {
   "id": 41574,
   "key": "D1502al.txt:2076",
   "ko": "어째선지 처음 알과 만났을 때가 떠오른다｡"
  },
  {
   "id": 41575,
   "key": "D1502al.txt:2079",
   "ko": "그때도 그랬다｡ 이렇게 빨려들 것 같은 깊은 눈동자가 나를 들여다보고 있었다……"
  },
  {
   "id": 41576,
   "key": "D1502al.txt:2086",
   "ko": "회상에 잠긴 나를 알의 목소리가 일깨운다｡"
  },
  {
   "id": 41577,
   "key": "D1502al.txt:2094",
   "ko": "「요그 소토스는 모든 시간과 시공에 이어져 있다…… 그건 알았느냐」"
  },
  {
   "id": 41578,
   "key": "D1502al.txt:2107",
   "ko": "「즉､ 저 문이 어디로 통하는지는 그 누구도 알지 못한다」 「저 문을 지나면 우리는 현재 과거 미래､ 온갖 우주를 떠돌게 되느니라」"
  },
  {
   "id": 41579,
   "key": "D1502al.txt:2115",
   "ko": "「그리고――」 거기서 한 박자 둔다｡"
  },
  {
   "id": 41580,
   "key": "D1502al.txt:2124",
   "ko": "이어서 자아낸 말은 충격이라기보다 절망이라기보다､ 그저 조용히 내 마음을 마비시킨다｡"
  },
  {
   "id": 41581,
   "key": "D1502al.txt:2139",
   "ko": "「――아마도 두 번 다시 이 세계로는 돌아오지 못하리라」"
  },
