  },
  {
   "id": 11756,
   "key": "D0801al.txt:181",
   "ko": "단말 마 홍소｡"
  },
  {
   "id": 11757,
   "key": "D0801al.txt:200",
   "ko": "모든 것은 물거품｡ 밤의 침묵에 삼켜져､ 사라져 간다｡"
  },
  {
   "id": 11758,
   "key": "D0801al.txt:214",
   "ko": "――비｡"
  },
  {
   "id": 11759,
   "key": "D0801al.txt:235",
   "ko": "비 내리는 하늘과 지상의 틈새를 메워버리는 폭우｡"
  },
  {
   "id": 11760,
   "key": "D0801al.txt:236",
   "ko": "피를 씻어 내린다｡"
  },
  {
   "id": 11761,
   "key": "D0801al.txt:238",
   "ko": "땅을 뚫는 무수한 빗방울에 얻어맞은 듯이､ 하늘에 무겁게 드리운 먹구름에 짓눌린 듯이､ 소녀는 땅바닥을 기고 있었다｡ 「――――｡ ……､ ……､ ――､ ――｡ …………｡ ――――」"
  },
  {
   "id": 11762,
   "key": "D0801al.txt:249",
   "ko": "소리 없는 신음｡ 헐떡임｡ 구토하듯이､ 경련하듯이､ 웃듯이､ 쓰러져､ 부들부들 떤다｡"
  },
  {
   "id": 11763,
   "key": "D0801al.txt:256",
   "ko": "골목에 네모나게 잘려 나온 하늘을 올려다본다｡"
  },
  {
   "id": 11764,
   "key": "D0801al.txt:257",
   "ko": "심연처럼 어둡고､ 깊은 칠흑의 구름｡"
  },
  {
   "id": 11765,
   "key": "D0801al.txt:258",
   "ko": "눈을 뜨고 있을 수 없을 만큼의 비｡"
  },
  {
   "id": 11766,
   "key": "D0801al.txt:264",
   "ko": "눈꺼풀을 감는다｡ 세계는 그저 어둠과､ 폭음 같은 빗소리｡"
  },
  {
   "id": 11767,
   "key": "D0801al.txt:268",
   "ko": "차가움｡ 체온을 앗아가는､ 빗방울의 감촉｡"
  },
  {
   "id": 11768,
   "key": "D0801al.txt:271",
   "ko": "지독하게､ 기분 좋다｡"
  },
  {
   "id": 11769,
   "key": "D0801al.txt:273",
   "ko": "온몸을 괴롭히는､ 삐걱대는 듯한 고통의 난무｡"
  },
  {
   "id": 11770,
   "key": "D0801al.txt:274",
   "ko": "마음을 좀먹는､ 공동 같은 피폐감｡ 온화하게､ 느릿하게､ 나태가 옭아맨다｡"
  },
  {
   "id": 11771,
   "key": "D0801al.txt:277",
   "ko": "내버려진 몸｡ 비를 계속 맞는 몸｡"
  },
  {
   "id": 11772,
   "key": "D0801al.txt:289",
   "ko": "다만―― 이만한 폭우에도 불구하고､ 티끌만큼도 젖지 않은 한 점이 있었다｡"
  },
  {
   "id": 11773,
   "key": "D0801al.txt:292",
   "ko": "마치､ 빗방울이 피해 가는 것처럼―― 아니｡"
  },
  {
   "id": 11774,
   "key": "D0801al.txt:293",
   "ko": "증발､ 하고 있는 것이다｡ 쏟아지는 비가 그것이 뿜어내는 열기에 하얀 증기가 되어 폭우 속으로 피어오르고 있다｡"
  },
  {
   "id": 11775,
   "key": "D0801al.txt:302",
   "ko": "둔한 빛을 머금은 붉음과､ 예리한 빛을 머금은 은빛과｡ 좌우에 쥐어진､ 흉악하면서도 장엄한､ 그것은 파괴의 상징｡ 살의의 결정｡"
  },
  {
   "id": 11776,
   "key": "D0801al.txt:305",
   "ko": "십자를 이루며 겹쳐져 있다｡"
  },
  {
   "id": 11777,
   "key": "D0801al.txt:307",
   "ko": "십자의 빛이 어스름 속에 망…… 하고 떠오른다――｡ ――주께서는 은혜의 곳간인 하늘을 여시어､ 때맞춰 비를 네 땅에 내리시고､ 네 손이 하는 모든 일에 복을 주시리라｡"
  },
  {
   "id": 11778,
   "key": "D0801al.txt:333",
   "ko": "비는 갑작스레､ 저녁 무렵부터 내리기 시작했다｡"
  },
  {
   "id": 11779,
   "key": "D0801al.txt:346",
   "ko": "하루치 조사며 수행이며가 끝나고 라이카씨한테 밥이나 얻어먹을까 하던 참이었다｡ 완전히 기습이었다｡ 정말､ 운도 없지｡ 처음엔 금방 그치겠거니 얕보고 있었는데､ 어찌 된 게 빗발은 잦아들기는커녕 오히려 한층 더 거세지기만 했다｡"
  },
  {
   "id": 11780,
   "key": "D0801al.txt:356",
   "ko": "어쩔 수 없다｡ 마음먹고 우리는 라이카씨의 교회까지의 거리를 내달렸다｡"
  },
  {
   "id": 11781,
   "key": "D0801al.txt:366",
   "ko": "고작 몇 분 거리｡"
  },
  {
   "id": 11782,
   "key": "D0801al.txt:367",
   "ko": "그것만으로도 팬티 속까지 흠뻑 젖었다｡"
  }
 ]
}