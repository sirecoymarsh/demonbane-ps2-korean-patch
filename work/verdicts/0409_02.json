   "ko": "="
  },
  {
   "id": 5291,
   "key": "D0409.txt:896",
   "ko": "="
  },
  {
   "id": 5292,
   "key": "D0409.txt:902",
   "ko": "「자､ 앨리슨…… 같이 돌아가자?」"
  },
  {
   "id": 5293,
   "key": "D0409.txt:915",
   "ko": "「야아아아아!」"
  },
  {
   "id": 5294,
   "key": "D0409.txt:931",
   "ko": "「――――!」 「라이카 씨!」"
  },
  {
   "id": 5295,
   "key": "D0409.txt:941",
   "ko": "「……괜찮아｡ 쿠로 군은 물러나 있어」"
  },
  {
