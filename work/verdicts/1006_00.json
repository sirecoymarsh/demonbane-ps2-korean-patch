  {
   "id": 21591,
   "key": "D1006al.txt:26",
   "ko": "그대는 이 몸의 지금까지 어떤 주인과도 달랐다｡"
  },
  {
   "id": 21592,
   "key": "D1006al.txt:28",
   "ko": "그대는 이 몸의 주인이 될 운명의 인간으로서는… 지독히도､ 평범하였다｡"
  },
  {
   "id": 21593,
   "key": "D1006al.txt:29",
   "ko": "어찌할 도리 없을 만치､ 그저 인간이었다｡"
  },
  {
   "id": 21594,
   "key": "D1006al.txt:30",
   "ko": "마인도 초인도 아닌､ 어디까지나 인간의 규격 안에 머무는､ 흔한 인간이었다｡"
  },
  {
   "id": 21595,
   "key": "D1006al.txt:32",
   "ko": "="
  },
  {
   "id": 21596,
   "key": "D1006al.txt:39",
   "ko": "정확히는､ 그대는 그저 인간이면서도､ 아주 조금 남들과는 어긋나 있었다｡"
  },
  {
   "id": 21597,
   "key": "D1006al.txt:41",
   "ko": "남들보다､ 아주 조금 마술에 밝았다｡"
  },
  {
   "id": 21598,
   "key": "D1006al.txt:42",
   "ko": "="
  },
  {
   "id": 21599,
   "key": "D1006al.txt:44",
   "ko": "마술에 통해 있으면서도 『서』를 지니지 않았고､ 사악에 물들지도 않았다｡"
  },
  {
   "id": 21600,
   "key": "D1006al.txt:45",
   "ko": "="
  },
  {
   "id": 21601,
   "key": "D1006al.txt:47",
   "ko": "허나 무엇보다도―― 그대는､ 남들보다 조금 지나치게 사람이 좋았다｡"
  },
  {
   "id": 21602,
   "key": "D1006al.txt:49",
   "ko": "미미한､ 아주 사소한 남들과의 차이로 보이겠지｡"
  },
  {
   "id": 21603,
   "key": "D1006al.txt:50",
   "ko": "그 아주 작은 것을､ 그대는 너무나도 겹쳐 쌓았다｡"
  },
  {
   "id": 21604,
   "key": "D1006al.txt:51",
   "ko": "그대는 그저 인간이면서도､ 인간을 넘어서 있었다｡"
  },
  {
   "id": 21605,
   "key": "D1006al.txt:53",
   "ko": "그것이 바로 그대이니라｡ 다이쥬지 쿠로｡"
  },
  {
   "id": 21606,
   "key": "D1006al.txt:60",
   "ko": "그리고､ 그대는 이 몸마저 바꾸어 버렸다｡"
  },
  {
   "id": 21607,
   "key": "D1006al.txt:61",
   "ko": "여태껏 이 몸과 주인들의 관계는､ 어디까지나 마도서와 마술사였다｡"
  },
  {
   "id": 21608,
   "key": "D1006al.txt:62",
   "ko": "이 몸에게 주인들이 소모품에 지나지 않았듯､ 주인들에게 이 몸은 무기에 지나지 않았다｡"
  },
  {
   "id": 21609,
   "key": "D1006al.txt:64",
   "ko": "물론､ 그에 불만은 없다｡"
  },
  {
   "id": 21610,
   "key": "D1006al.txt:65",
   "ko": "그것이 계약이었느니라｡"
  },
  {
   "id": 21611,
   "key": "D1006al.txt:66",
   "ko": "그리 선을 그었기에､ 이 몸들은 사악과 싸울 수 있었던 것이다｡"
  },
  {
   "id": 21612,
   "key": "D1006al.txt:73",
   "ko": "허나､ 다이쥬지 쿠로｡ 그대는 달랐다｡"
  },
  {
   "id": 21613,
   "key": "D1006al.txt:75",
   "ko": "그대는 이 몸을 인간으로 여겼다｡"
  },
  {
   "id": 21614,
   "key": "D1006al.txt:76",
   "ko": "이 몸을 동포로､ 아니､ 이는 입에 담기도 낯간지러울 만큼 진부한 말이나―― 그래｡ 다이쥬지 쿠로｡"
  },
  {
   "id": 21615,
   "key": "D1006al.txt:77",
   "ko": "그대는 이 몸을… 『가족』으로､ 맞아준 것이겠지｡"
  },
  {
   "id": 21616,
   "key": "D1006al.txt:79",
   "ko": "… 얼간이 같으니｡"
  },
  {
   "id": 21617,
   "key": "D1006al.txt:80",
   "ko": "천하의 얼간이로다｡"
  },
  {
   "id": 21618,
   "key": "D1006al.txt:81",
   "ko": "어느 세상에 마도서를､ 그리 대하는 마술사가 있단 말이냐｡"
  },
  {
   "id": 21619,
   "key": "D1006al.txt:83",
   "ko": "그대가 이 몸에게 준 것은､ 여태 이 몸이 모르던 온기로 가득했다｡"
  },
  {
   "id": 21620,
   "key": "D1006al.txt:84",
   "ko": "사람의 사랑을 모르는 이 몸을 온기로 채워 버렸다｡"
  },
  {
   "id": 21621,
   "key": "D1006al.txt:86",
   "ko": "그것은 이 몸에게 무한한 행복이자､ 동시에 무한한 형벌이기도 했다｡"
  },
  {
   "id": 21622,
   "key": "D1006al.txt:87",
   "ko": "유구를 살아가는 이 몸에게 이 온기는 참혹했다｡"
  },
  {
   "id": 21623,
   "key": "D1006al.txt:94",
   "ko": "아아… 그런가｡"
  },
  {
   "id": 21624,
   "key": "D1006al.txt:95",
   "ko": "그랬던 것인가｡"
  },
  {
   "id": 21625,
   "key": "D1006al.txt:97",
   "ko": "얼간이는 이 몸이었나｡"
  },
  {
   "id": 21626,
   "key": "D1006al.txt:98",
   "ko": "어찌하여､ 어찌하여､ 여태 깨닫지 못하였는가｡"
  },
  {
   "id": 21627,
   "key": "D1006al.txt:100",
   "ko": "이 몸은 이제 와서､ 잃어버린 주인들의 죽음을 슬퍼하고 있는 것인가｡"
  }
