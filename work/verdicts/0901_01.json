{
 "packet": "0901_01",
 "items": [
  {
   "id": 17801,
   "key": "D0901al.txt:384",
   "ko": "어떻게 하면 좋을지 모른다｡"
  },
  {
   "id": 17802,
   "key": "D0901al.txt:385",
   "ko": "="
  },
  {
   "id": 17803,
   "key": "D0901al.txt:389",
   "ko": "이형의 지식의 집대성인 자신｡ 그 지혜를 총동원해도 이 가슴의 통증을 멈출 수가 없다｡"
  },
  {
   "id": 17804,
   "key": "D0901al.txt:393",
   "ko": "싸우는 것 외의 방법을 모르는 자신이니까｡"
  },
  {
   "id": 17805,
   "key": "D0901al.txt:394",
   "ko": "투쟁｡ 파괴｡ 분쇄｡ 멸살｡ 그것이 자신의 삶을 채우는 전부니까｡"
  },
  {
   "id": 17806,
   "key": "D0901al.txt:398",
   "ko": "그 외에는 가진 것 없는 자신에게――쿠로와 보내는 이 시끌벅적하고도 기분 좋은 시간은 환상에 지나지 않는 걸까｡"
  },
  {
   "id": 17807,
   "key": "D0901al.txt:401",
   "ko": "사악의 암흑､ 투쟁의 섬광 틈새에서 보는 꿈――한때의 위안､ 단순한 장난에 지나지 않는 걸까｡"
  },
  {
   "id": 17808,
   "key": "D0901al.txt:404",
   "ko": "그래서 자신은 아무것도 할 수 없는 걸까｡"
  },
  {
   "id": 17809,
   "key": "D0901al.txt:407",
   "ko": "장난이기에――쿠로의 곁에 설 수 없다｡"
  },
  {
   "id": 17810,
   "key": "D0901al.txt:410",
   "ko": "자신 안에 있는 온기는――진짜가 아니니까｡ 「……읏｡ 괘씸하구나……」"
  },
  {
   "id": 17811,
   "key": "D0901al.txt:426",
   "ko": "가슴을 조이는 통증이 격렬해진다｡ 통증이 그녀를 침식한다｡"
  },
  {
   "id": 17812,
   "key": "D0901al.txt:430",
   "ko": "치명적인 균열을 일으킨다｡"
  },
  {
   "id": 17813,
   "key": "D0901al.txt:431",
   "ko": "근저를 위협한다｡ 허무의 손이 그녀의 영혼을 끌어내리려 한다｡"
  },
  {
   "id": 17814,
   "key": "D0901le.txt:11",
   "ko": "――하늘을 날고 싶다고､ 그는 말했다｡"
  },
  {
   "id": 17815,
   "key": "D0901le.txt:15",
   "ko": "파란､ 파란､ 끝없이 펼쳐지는､ 하늘｡ 하얀 벽에 둘러싸인 이 시설에서도 보이는 저 푸른 하늘은､ 어느새 마음의 구원이 되어 있었다｡"
  },
  {
   "id": 17816,
   "key": "D0901le.txt:19",
   "ko": "나에게도｡ 그리고､ 그에게도｡"
  },
  {
   "id": 17817,
   "key": "D0901le.txt:22",
   "ko": "하늘을 날고 싶다｡ 하늘은 자유니까｡"
  },
  {
   "id": 17818,
   "key": "D0901le.txt:25",
   "ko": "하늘은――하얗지 않으니까｡ 하늘을 나는 꿈은､ 현실도피의 소망｡"
  },
  {
   "id": 17819,
   "key": "D0901le.txt:28",
   "ko": "그런 말을 했던 건､ 스위스의 심리학자였던가｡"
  },
  {
   "id": 17820,
   "key": "D0901le.txt:28",
   "ko": "분명､ 그런 것이겠지｡"
  },
  {
   "id": 17821,
   "key": "D0901le.txt:29",
   "ko": "우리 역시､ 자신을 둘러싼､ 하얀 현실에서 도망치고 싶었다｡"
  },
  {
   "id": 17822,
   "key": "D0901le.txt:31",
   "ko": "점심시간｡ 오전 커리큘럼을 마치고､ 정원으로 나간다｡"
  },
  {
   "id": 17823,
   "key": "D0901le.txt:34",
   "ko": "꼼꼼하게――오히려 신경질적으로 다듬어진 잔디 위에 앉는다｡"
  },
  {
   "id": 17824,
   "key": "D0901le.txt:35",
   "ko": "앉아서､ 하늘을 올려다본다｡"
  },
  {
   "id": 17825,
   "key": "D0901le.txt:37",
   "ko": "그는 눕는다｡ 반듯이 누워서､ 하늘을 올려다본다｡"
  },
  {
   "id": 17826,
   "key": "D0901le.txt:40",
   "ko": "그것이 우리의､ 가장 좋아하는 것｡"
  },
  {
   "id": 17827,
   "key": "D0901le.txt:41",
   "ko": "특별한､ 우리만의､ 시간｡"
  },
  {
   "id": 17828,
   "key": "D0901le.txt:43",
   "ko": "그는 가는 손가락을 활짝 펴고､ 손바닥을 하늘로 치켜든다｡"
  },
  {
   "id": 17829,
   "key": "D0901le.txt:47",
   "ko": "="
  },
  {
   "id": 17830,
   "key": "D0901le.txt:50",
   "ko": "그는､ 언제나､ 꿈꾸듯이､ 그런 말을 한다｡ 치켜든 손을 뻗는다｡"
  },
  {
   "id": 17831,
   "key": "D0901le.txt:53",
   "ko": "팔꿈치를 쭉 곧게 펴고､ 어깨를 살짝 들고､ 손가락까지 뻗어서｡"
  },
  {
   "id": 17832,
   "key": "D0901le.txt:55",
   "ko": "하늘을 잡으려고､ 손을 뻗는다｡"
  },
  {
   "id": 17833,
   "key": "D0901le.txt:59",
   "ko": "="
  },
  {
   "id": 17834,
   "key": "D0901le.txt:62",
   "ko": "치켜든 손바닥을 바라보며､ 그렇게 중얼거린다｡"
  },
  {
   "id": 17835,
   "key": "D0901le.txt:63",
   "ko": "하늘을 잡을 수 있는 높이까지 도달하고 싶다고 그는 말한다｡"
  },
  {
   "id": 17836,
   "key": "D0901le.txt:65",
   "ko": "하늘을 날고 싶다고､ 그는 말한다｡ 비 오는 날은 싫다｡"
  },
  {
   "id": 17837,
   "key": "D0901le.txt:75",
   "ko": "무겁고 무거운 구름이 드리워､ 세상 어디에도､ 하늘이 없다｡"
  },
  {
   "id": 17838,
   "key": "D0901le.txt:77",
   "ko": "창밖을 보면､ 잿빛 세상｡"
  },
  {
   "id": 17839,
   "key": "D0901le.txt:78",
   "ko": "방 안을 보면､ 전등에 비친､ 더 강한 하양｡"
  },
  {
   "id": 17840,
   "key": "D0901le.txt:80",
   "ko": "최악､ 이다｡ 그때의 비는､ 며칠이나 계속됐다｡"
  }
 ]
}