  },
  {
   "id": 32843,
   "key": "D1306le.txt:71",
   "ko": "리베르 레기스｡ 상반신만을 부조처럼 밖으로 드러내고 있었다｡"
  },
  {
   "id": 32844,
   "key": "D1306le.txt:74",
