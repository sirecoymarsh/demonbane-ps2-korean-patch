  },
  {
   "id": 43142,
   "key": "D1505ru.txt:44",
   "ko": "「……뭔데?」"
  },
  {
   "id": 43143,
   "key": "D1505ru.txt:48",
   "ko": "="
  },
  {
   "id": 43144,
   "key": "D1505ru.txt:49",
   "ko": "="
  },
  {
   "id": 43145,
   "key": "D1505ru.txt:51",
   "ko": "요그 소토스의 문이 하늘을 지배하고 있는 것 외에는…… 바다는 그 르뤼에라고는 믿기지 않을 만큼 평온하다｡"
  },
  {
   "id": 43146,
   "key": "D1505ru.txt:53",
   "ko": "공주님은 한 번 입을 열었지만､ 다시 입을 다물어 버린다｡"
  },
  {
   "id": 43147,
   "key": "D1505ru.txt:54",
   "ko": "망설이는 듯한…… 아니､ 조용히 결심을 굳히는 듯한｡"
  },
  {
   "id": 43148,
   "key": "D1505ru.txt:55",
   "ko": "나는 별달리 조급해하지도 않고 계속 기다렸다｡"
  },
  {
   "id": 43149,
   "key": "D1505ru.txt:57",
   "ko": "길고 긴 침묵이 흐르고―― 공주님은 갑작스럽게､ 하지만 역시 조용히 고백하는 것이었다｡"
  },
  {
   "id": 43150,
   "key": "D1505ru.txt:61",
   "ko": "「저는 다이쥬지 씨를 사모하고 있어요」"
  },
  {
   "id": 43151,
   "key": "D1505ru.txt:65",
   "ko": "「………………」"
  },
  {
   "id": 43152,
   "key": "D1505ru.txt:69",
   "ko": "조용했지만 엄청난 충격이었다｡"
  },
  {
   "id": 43153,
   "key": "D1505ru.txt:70",
   "ko": "기습도 정도가 있다…… 아니､ 어쩌면 공주님의 모습에서 예감 정도는 하고 있었는지도 모른다｡"
  },
  {
   "id": 43154,
   "key": "D1505ru.txt:72",
   "ko": "격렬하게 동요했지만 당황하지는 않았다｡"
  },
  {
   "id": 43155,
   "key": "D1505ru.txt:73",
   "ko": "적어도 겉으로는｡ 아마도｡ 「……어째서?」"
  },
  {
   "id": 43156,
   "key": "D1505ru.txt:81",
   "ko": "아무렇지 않게 물은 셈이었지만 목소리가 떨리고 있었다｡"
  },
  {
   "id": 43157,
   "key": "D1505ru.txt:82",
   "ko": "왠지 목이 바싹 말라 있다｡"
  },
  {
   "id": 43158,
   "key": "D1505ru.txt:84",
   "ko": "그런 내 속마음을 아는지 모르는지､ 공주님은 키득키득 웃더니 가볍게 단언했다｡"
  },
  {
   "id": 43159,
   "key": "D1505ru.txt:88",
   "ko": "「모르겠어요」"
  },
  {
   "id": 43160,
   "key": "D1505ru.txt:92",
   "ko": "「모르겠다니……」"
  },
  {
   "id": 43161,
   "key": "D1505ru.txt:96",
   "ko": "「이상하죠｡ 그토록 싫어했던…… 미워하기까지 했던 당신인데｡ 하지만 깨닫고 보니 이렇게나 끌리고 있었어요」"
  },
  {
   "id": 43162,
   "key": "D1505ru.txt:101",
   "ko": "「………………」"
  },
  {
   "id": 43163,
   "key": "D1505ru.txt:105",
   "ko": "「싸우는 다이쥬지 씨의 모습에―― 아니､ 싸우면서도 웃을 수 있는 다이쥬지 씨의 모습에 저는 구원받아 왔어요」"
  },
  {
   "id": 43164,
   "key": "D1505ru.txt:108",
   "ko": "공주님도 내 등에 팔을 두른다｡"
  },
  {
   "id": 43165,
   "key": "D1505ru.txt:109",
   "ko": "꼭…… 하고 강한 힘으로｡"
  },
  {
   "id": 43166,
   "key": "D1505ru.txt:110",
   "ko": "그 가녀린 팔로､ 있는 힘껏｡ 「역시……」"
  }
 ]
}