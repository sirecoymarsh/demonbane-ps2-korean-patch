   "ko": "="
  },
  {
   "id": 26672,
   "key": "D1201ru.txt:330",
   "ko": "="
  },
  {
   "id": 26673,
   "key": "D1201ru.txt:333",
   "ko": "="
  },
  {
   "id": 26674,
   "key": "D1201ru.txt:334",
   "ko": "루리는 떨리는 목소리를 억누르지 못한 채､ 공포의 이름을 불렀다｡"
  },
  {
   "id": 26675,
   "key": "D1201ru.txt:340",
   "ko": "「……안티크로스!」"
  },
  {
   "id": 26676,
   "key": "D1201ru.txt:353",
   "ko": "그것은､ 죽음의 색채로 물든 피바람｡"
  },
  {
   "id": 26677,
   "key": "D1201ru.txt:360",
   "ko": "「끄아아아아악!」 「햐하하하핫!」"
  },
  {
   "id": 26678,
   "key": "D1201ru.txt:375",
   "ko": "「클라우디우스 녀석……분노에 정신이 나갔군｡ 성급하기는」"
  },
  {
   "id": 26679,
   "key": "D1201ru.txt:381",
   "ko": "「하지만 칼리굴라가 당한 이상､ 저놈들을 방치해 두는 건 득책이 아니지」"
  },
  {
   "id": 26680,
   "key": "D1201ru.txt:384",
   "ko": "「여기서는 뒷일을 위해서라도､ 철저하고 완벽하게 빈틈없이 후환 없이 하도 재벌과 데몬베인을 분쇄해 둬야 한다고 보지 않나? 아우구스투스」"
  },
  {
   "id": 26681,
   "key": "D1201ru.txt:390",
   "ko": "「그렇군｡ 하지만､ 저 꼴의 클라우디우스만으로는 미덥지 못하지……티투스」"
  },
  {
   "id": 26682,
   "key": "D1201ru.txt:398",
   "ko": "「애초에 그럴 셈이었다」"
  },
  {
   "id": 26683,
   "key": "D1201ru.txt:407",
   "ko": "그것은､ 어둠의 색채로 물든 피 묻은 칼｡"
  },
  {
   "id": 26684,
   "key": "D1201ru.txt:422",
   "ko": "「――하앗!」"
  },
  {
   "id": 26685,
   "key": "D1201ru.txt:435",
   "ko": "="
  },
  {
   "id": 26686,
   "key": "D1201ru.txt:443",
   "ko": "="
  },
  {
   "id": 26687,
   "key": "D1201ru.txt:449",
   "ko": "「……헤에､ 정말로 단숨에 밀어붙일 셈이구나」"
  },
  {
   "id": 26688,
   "key": "D1201ru.txt:453",
   "ko": "="
  },
  {
   "id": 26689,
   "key": "D1201ru.txt:458",
   "ko": "「정말이지､ 그땐 그랜드 마스터님이 방해했기 때문이잖아｡ 뭐､ 됐어｡ 실컷 날뛰면 되는 거지?」"
  },
  {
   "id": 26690,
   "key": "D1201ru.txt:463",
   "ko": "「그래､ 그거면 됐다｡ 네 마음대로 해라」"
  },
  {
   "id": 26691,
   "key": "D1201ru.txt:467",
   "ko": "「우후후｡ 침이 다 나오는걸」"
  },
  {
   "id": 26692,
   "key": "D1201ru.txt:477",
   "ko": "그것은､ 황홀의 색채로 물든 죽음의 냄새｡"
  },
  {
   "id": 26693,
   "key": "D1201ru.txt:483",
   "ko": "="
  },
  {
   "id": 26694,
   "key": "D1201ru.txt:491",
   "ko": "「좋은 목소리로 우는구나-｡ 나､ 부끄럽게도 흥분해 버리는걸」"
  },
