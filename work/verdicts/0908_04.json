 "items": [
  {
   "id": 19937,
   "key": "D0908al_ps2.txt:1001",
   "ko": "「아아､ 사랑스러운 릴리 마를렌 아아､ 사랑스러운 릴리 마를렌」"
  },
  {
   "id": 19938,
   "key": "D0908al_ps2.txt:1028",
   "ko": "「어떻게 이기라는 거야｡ 저런 괴물을……」"
  },
  {
   "id": 19939,
   "key": "D0908al_ps2.txt:1044",
   "ko": "「크윽…… 마스터 테리온……!」 「……………………」"
  },
  {
   "id": 19940,
   "key": "D0908al_ps2.txt:1069",
   "ko": "「아…… 아아……」 「그런……」"
  },
  {
   "id": 19941,
   "key": "D0908al_ps2.txt:1077",
   "ko": "「아무리 그래도…… 농담이겠죠?」"
  },
  {
   "id": 19942,
   "key": "D0908al_ps2.txt:1089",
   "ko": "「핵조차도､ 저자에게는 통하지 않는 건가요……」"
  },
  {
   "id": 19943,
   "key": "D0908al_ps2.txt:1094",
   "ko": "공주님은 그 자리에 주저앉아 버렸다｡"
  },
  {
   "id": 19944,
   "key": "D0908al_ps2.txt:1095",
   "ko": "제 몸을 끌어안는다｡ 몸의 떨림은 이미 경련처럼 격해져 있었다｡"
  },
  {
   "id": 19945,
   "key": "D0908al_ps2.txt:1099",
   "ko": "「할아버님…… 당신은 이토록 깊은 절망과 싸우고 계셨군요」"
  },
  {
   "id": 19946,
   "key": "D0908al_ps2.txt:1104",
   "ko": "영혼을 좀먹는 외경｡ 그건 나도 마찬가지다｡"
  },
  {
   "id": 19947,
   "key": "D0908al_ps2.txt:1119",
   "ko": "「이 조용한 곳에서 이 지구 위에서 나는 꿈꾼다 그대의 사랑스러운 입술을」"
  },
  {
   "id": 19948,
   "key": "D0908al_ps2.txt:1122",
   "ko": "「안개가 걷히고 저 가로등 아래 설 수 있는 건 언제?」"
  },
  {
   "id": 19949,
   "key": "D0908al_ps2.txt:1135",
   "ko": "필사적으로 긁어모은 용기도 부서질 것만 같다｡"
  },
  {
   "id": 19950,
   "key": "D0908al_ps2.txt:1137",
   "ko": "하지만､ 그래도 아슬아슬하게 나를 싸움에 붙들어 두는 것이 있다｡ 배신할 수 없는 것이 있다｡"
  },
  {
   "id": 19951,
   "key": "D0908al_ps2.txt:1152",
   "ko": "「아아､ 사랑스러운 릴리 마를렌 아아､ 사랑스러운 릴리 마를렌」"
  },
  {
   "id": 19952,
   "key": "D0908al_ps2.txt:1170",
   "ko": "「그런…… 어떻게…… 어떻게 저런 괴물을 이기라는 건가요? 할아버님…… 저는…… 저는……」"
  },
  {
   "id": 19953,
   "key": "D0908al_ps2.txt:1175",
   "ko": "눈물을 흘리며 겁에 질린 이 사람을､ 이토록 겁에 질리면서도 그럼에도 싸워 온 이 사람을､"
  },
  {
   "id": 19954,
   "key": "D0908al_ps2.txt:1177",
   "ko": "나는―― 「『블랙로지』! 마스터 테리온! 크툴루우우우!」"
  }
 ]
}