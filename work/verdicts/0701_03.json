   "ko": "="
  },
  {
   "id": 8255,
   "key": "D0701_ps2.txt:1080",
   "ko": "「그럼 다이쥬지 님｡ 건투를 빕니다」"
  },
  {
   "id": 8256,
   "key": "D0701_ps2.txt:1090",
