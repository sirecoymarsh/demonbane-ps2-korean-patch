  {
   "id": 48400,
   "key": "D1518.txt:341",
   "ko": "「……뭐가 우스우냐?」"
  },
  {
   "id": 48401,
   "key": "D1518.txt:345",
   "ko": "「아니､ 별거 아냐…… 자､ 이번엔 진짜 힘들었네」"
  },
  {
   "id": 48402,
   "key": "D1518.txt:348",
   "ko": "="
