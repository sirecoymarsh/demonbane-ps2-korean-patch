 "items": [
  {
   "id": 19811,
   "key": "D0908al_ps2.txt:321",
   "ko": "동요는 순식간에 우리에게도 전염된다｡"
  },
  {
   "id": 19812,
   "key": "D0908al_ps2.txt:324",
   "ko": "「해､ 해애애애애액!? 뭐､ 뭐야 그게!? 어째서 그런 게……!」"
  },
  {
   "id": 19813,
   "key": "D0908al_ps2.txt:328",
   "ko": "「쏜 것은 필시 합중국 정부이겠지요｡ 저 하늘에 떠 있는 괴물을 멸하기 위해――」"
  },
  {
   "id": 19814,
   "key": "D0908al_ps2.txt:332",
   "ko": "그러기 위해 아컴시티를 통째로 희생시키겠다는 거냐!"
  },
  {
   "id": 19815,
   "key": "D0908al_ps2.txt:333",
   "ko": "그런 말도 안 되는……!"
  },
  {
   "id": 19816,
   "key": "D0908al_ps2.txt:337",
   "ko": "「어쨌든요! 빨리 지하로 돌아가야 해요! 지하 시설이라면 어떻게든……!」"
  },
  {
   "id": 19817,
   "key": "D0908al_ps2.txt:344",
   "ko": "도망칠까……｡"
  },
  {
   "id": 19818,
   "key": "D0908al_ps2.txt:350",
   "ko": "그러고 싶은 마음은 굴뚝같지만､ 안타깝게도 이쪽은 십자가에 못 박힌 신세다｡ 발버둥 쳐도 꽂힌 황금빛 검은 꿈쩍도 하지 않는다｡"
  },
  {
   "id": 19820,
   "key": "D0908al_ps2.txt:353",
   "ko": "「젠장……!」"
  },
  {
   "id": 19821,
   "key": "D0908al_ps2.txt:372",
   "ko": "「다이쥬지 님!」"
  },
  {
   "id": 19822,
   "key": "D0908al_ps2.txt:376",
   "ko": "「윈필드! 무사했군요!」"
  },
  {
   "id": 19823,
   "key": "D0908al_ps2.txt:380",
   "ko": "「예｡ 허나 지금은 그런 이야기를 할 때가 아닙니다｡ 중대한 일이――」"
  },
  {
   "id": 19825,
   "key": "D0908al_ps2.txt:384",
   "ko": "「크크크크크크､ 크읏! 크크크크크､ 큰일､ 큰일이에요오오! 해해해해해해……」"
  },
  {
   "id": 19826,
   "key": "D0908al_ps2.txt:391",
   "ko": "「에잇! 진정하고 말하지 못하겠느냐!」"
  },
  {
   "id": 19827,
   "key": "D0908al_ps2.txt:396",
   "ko": "「……조금 전､ 이 아컴시티를 향해 핵미사일이 발사되었습니다」"
  },
  {
   "id": 19828,
   "key": "D0908al_ps2.txt:400",
   "ko": "「뭐――――」"
  },
  {
   "id": 19829,
   "key": "D0908al_ps2.txt:405",
   "ko": "핵미사일｡ 너무나도 현실감 없는 그 단어를 이해하는 데는 한참 시간이 걸렸다｡"
  },
  {
   "id": 19830,
   "key": "D0908al_ps2.txt:409",
   "ko": "동요는 순식간에 우리에게도 전염된다｡"
  },
  {
