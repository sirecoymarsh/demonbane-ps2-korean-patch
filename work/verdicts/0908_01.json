  {
   "id": 19839,
   "key": "D0908al_ps2.txt:447",
   "ko": "「……읏! 다이쥬지 씨……」"
  },
  {
   "id": 19840,
   "key": "D0908al_ps2.txt:451",
   "ko": "「크으으으윽､ 젠장!」"
  },
  {
   "id": 19841,
   "key": "D0908al_ps2.txt:464",
   "ko": "「……하하하」"
  },
  {
   "id": 19842,
   "key": "D0908al_ps2.txt:467",
   "ko": "필사적으로 발버둥 치는 우리 꼴을､ 마스터 테리온은 비웃는다｡"
  },
  {
   "id": 19843,
   "key": "D0908al_ps2.txt:468",
   "ko": "비웃음조차 아름다운 목소리로 지저귀는 것이 여간 괘씸하지 않았다｡"
  },
  {
   "id": 19844,
   "key": "D0908al_ps2.txt:470",
   "ko": "황금빛 야수가 고한다｡"
  },
  {
   "id": 19845,
   "key": "D0908al_ps2.txt:475",
   "ko": "「염려 말라､ 다이쥬지 쿠로｡ 인간의 병기 따위로 어찌 될 신도 아니다……만､ 다소 거슬리는 것은 사실이지｡ 어디」"
  },
  {
   "id": 19846,
   "key": "D0908al_ps2.txt:482",
   "ko": "리베르 레기스의 모습이 무너져 간다｡"
  },
  {
   "id": 19847,
   "key": "D0908al_ps2.txt:483",
   "ko": "무수한 기하학적 파츠로 분해되어､ 잘게 부서졌다"
  },
  {
   "id": 19848,
   "key": "D0908al_ps2.txt:484",
   "ko": "파츠는 안개가 걷히듯 공간에 녹아든다｡ 「순간이동도 자유자재로구나｡ 마인 놈」"
  },
  {
   "id": 19849,
   "key": "D0908al_ps2.txt:493",
   "ko": "「……뭘 하려는 거지?」"
  },
  {
   "id": 19850,
   "key": "D0908al_ps2.txt:508",
   "ko": "핵미사일의 궤도를 막고､ 공간이 휘어졌다｡"
  },
  {
   "id": 19851,
   "key": "D0908al_ps2.txt:509",
   "ko": "의미를 갖지 않는 기하학적 파츠의 무리가 급속히 구축되어､ 리베르 레기스의 모습을 만들어낸다｡"
  },
  {
   "id": 19852,
   "key": "D0908al_ps2.txt:513",
   "ko": "「후훗､ 인간에게는 너무 이른 헤르메스의 불이로군｡ 프로메테우스는 사슬에 묶여 새에게 내장을 쪼이는 벌을 받았거늘――」"
  }
