{
 "packet": "0901_02",
 "items": [
  {
   "id": 17841,
   "key": "D0901le.txt:83",
   "ko": "기분은 한없이 가라앉고､ 시험도 좋은 결과를 내지 못한다｡"
  },
  {
   "id": 17842,
   "key": "D0901le.txt:85",
   "ko": "푸른 하늘을 그리워하며 밖을 본다｡ 하지만 보이는 건 역시､ 잿빛 구름｡"
  },
  {
   "id": 17843,
   "key": "D0901le.txt:87",
   "ko": "비에 흐려진 세상｡ 푸른 하늘이 보일 기미는､ 조금도 없다｡"
  },
  {
   "id": 17844,
   "key": "D0901le.txt:90",
   "ko": "저 푸름을 바라며 하늘을 올라가도､ 저 베일 같은 비구름에 가로막혀､ 하늘에 도달할 수 없는 게 아닐까｡"
  },
  {
   "id": 17845,
   "key": "D0901le.txt:92",
   "ko": "푸른 하늘의 날은 이제 두 번 다시 오지 않는 게 아닐까｡ ……그런 강박관념 같은 불안과 공포가､ 어린 나를 덮친다｡"
  },
  {
   "id": 17846,
   "key": "D0901le.txt:95",
   "ko": "소리를 죽이고 우는 나에게､ 그는 말을 건넨다｡"
  },
  {
   "id": 17847,
   "key": "D0901le.txt:96",
   "ko": "조용한 열의를､ 가슴 깊이 품고서｡ 「괜찮아｡ 괜찮아｡ 언젠가 내가､ 여기서 라이카를 데리고 나갈 테니까」"
  },
  {
   "id": 17848,
   "key": "D0901le.txt:105",
   "ko": "내 손을 잡고 미소 짓는다｡ 꿈을 꾸는 듯한 얼굴로｡"
  },
  {
   "id": 17849,
   "key": "D0901le.txt:110",
   "ko": "「언젠가 내가､ 라이카를 저 푸른 하늘로 데려갈 테니까」"
  },
  {
   "id": 17850,
   "key": "D0901le.txt:113",
   "ko": "그에게 하늘은 이제 도피가 아니었다｡"
  },
  {
   "id": 17851,
   "key": "D0901le.txt:117",
   "ko": "="
  },
  {
   "id": 17852,
   "key": "D0901le.txt:120",
   "ko": "그에게 하늘은――강한 의지로 도달할､ 고귀한 목적이 되어 있었다｡"
  },
  {
   "id": 17853,
   "key": "D0901le.txt:124",
   "ko": "「――약속､ 할게」"
  },
  {
   "id": 17854,
   "key": "D0901le.txt:152",
   "ko": "="
  },
  {
   "id": 17855,
   "key": "D0901le.txt:157",
   "ko": "「………………」"
  },
  {
   "id": 17856,
   "key": "D0901le.txt:162",
   "ko": "「지――――잇」"
  },
  {
   "id": 17857,
   "key": "D0901le.txt:167",
   "ko": "「지이이이이이―잇」"
  },
  {
   "id": 17858,
   "key": "D0901le.txt:172",
   "ko": "「응시~……」 하룻밤이 지나고｡"
  },
  {
   "id": 17859,
   "key": "D0901le.txt:178",
   "ko": "어제 그만한 일이 있었는데도､ 라이카 씨는 집안일도 교회 일도 착실히 해내고 있다｡"
  },
  {
   "id": 17860,
   "key": "D0901le.txt:180",
   "ko": "하지만 상태는 분명히 이상했다｡ 그야 목숨이 위험하기도 했으니까 평소대로……라는 건 무리한 얘기일지도 모른다｡"
  },
  {
   "id": 17861,
   "key": "D0901le.txt:183",
   "ko": "하지만 원인은 그것뿐만은 아닐 거다｡"
  },
  {
   "id": 17862,
   "key": "D0901le.txt:188",
   "ko": "="
  },
  {
   "id": 17863,
   "key": "D0901le.txt:193",
   "ko": "「………………」"
  },
  {
   "id": 17864,
   "key": "D0901le.txt:198",
   "ko": "「지――――――――――잇」"
  },
  {
   "id": 17865,
   "key": "D0901le.txt:203",
   "ko": "「지이이이이이이이이이이이――――잇」"
  },
  {
   "id": 17866,
   "key": "D0901le.txt:208",
   "ko": "「응시~……」 혼자 있을 때면 저런 식으로 생각에 잠긴 얼굴을 한다｡"
  },
  {
   "id": 17867,
   "key": "D0901le.txt:213",
   "ko": "아마 어제 교회에 돌아왔을 때 만난 저 남자가 관련되어 있는 거겠지｡"
  },
  {
   "id": 17868,
   "key": "D0901le.txt:215",
   "ko": "저 녀석이 누구였는지……라이카 씨한테는 아무것도 못 물었다｡ 아니､ 물을 수 있는 분위기가 아니었다｡"
  },
  {
   "id": 17869,
   "key": "D0901le.txt:218",
   "ko": "꼬맹이들도 나와 같은 모양인지､ 그래서 지금도 이렇게 멀찍이서 라이카 씨의 모습을 살피고 있다｡ 음｡ 아무래도 옛 지인 같았는데……｡"
  },
  {
   "id": 17870,
   "key": "D0901le.txt:225",
   "ko": "「…………후우」 「앗､ 한숨」"
  },
  {
   "id": 17871,
   "key": "D0901le.txt:235",
   "ko": "「쿠로……라이벌 등장이네?」"
  },
  {
   "id": 17872,
   "key": "D0901le.txt:240",
   "ko": "「부부웃! 무､ 무､ 뭐어……읏!」"
  },
  {
   "id": 17873,
   "key": "D0901le.txt:242",
   "ko": "갑､ 갑자기 무슨 이상한 소리를 하는 거야､ 이 녀석은!?"
  },
  {
   "id": 17874,
   "key": "D0901le.txt:244",
   "ko": "당황하는 나를 즐기는 건지､ 콜린은 「훗훗훗」 하고 뻔뻔하게 웃어 보이고 있다｡"
  },
  {
   "id": 17875,
   "key": "D0901le.txt:249",
   "ko": "「저 한숨은 『사랑에 빠진 소녀』의 것이네」"
  },
  {
   "id": 17876,
   "key": "D0901le.txt:254",
   "ko": "「어디서 그런 건방진 대사를 배워 오는 거야……」"
  },
  {
   "id": 17877,
   "key": "D0901le.txt:259",
   "ko": "="
  },
  {
   "id": 17878,
   "key": "D0901le.txt:264",
   "ko": "="
  },
  {
   "id": 17879,
   "key": "D0901le.txt:269",
   "ko": "「괘､ 괜찮아! 쿠로 오빠! 오빠한테도 좋은 점은 있어어」"
  },
  {
   "id": 17880,
   "key": "D0901le.txt:274",
   "ko": "「오빠 『한테도』라니 뭐야!? 『한테도』라니!」"
  }
 ]
}