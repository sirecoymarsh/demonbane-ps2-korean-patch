   "ko": "="
  },
  {
   "id": 36365,
   "key": "D1401ru.txt:17",
   "ko": "『몽환심모』의 심장이다｡"
  },
  {
   "id": 36366,
   "key": "D1401ru.txt:29",
   "ko": "「푼그루이､ 무글루우나프､ 크 리토- 리토-､ 라 이라-､ 우가프나글､ 프타근…」"
  },
  {
   "id": 36367,
   "key": "D1401ru.txt:34",
   "ko": "="
  },
  {
   "id": 36368,
   "key": "D1401ru.txt:35",
   "ko": "="
  },
  {
   "id": 36369,
   "key": "D1401ru.txt:37",
   "ko": "="
  },
  {
   "id": 36370,
   "key": "D1401ru.txt:38",
   "ko": "="
  },
  {
   "id": 36371,
   "key": "D1401ru.txt:39",
   "ko": "="
  },
  {
   "id": 36372,
   "key": "D1401ru.txt:43",
   "ko": "「이아아､ 이아아､ 크토후루후 프타근 이아 라 이라-､ 치후이파､ 후루가구나루､ 이두､ 이아!」"
  },
  {
   "id": 36373,
   "key": "D1401ru.txt:49",
   "ko": "하지만 그 청렴한 무구한 성스러운 노랫소리에 맞춰､ 사신은 떠는 것이다｡ 몸부림치는 것이다｡"
  },
  {
   "id": 36374,
   "key": "D1401ru.txt:51",
   "ko": "="
  },
  {
   "id": 36375,
   "key": "D1401ru.txt:52",
   "ko": "="
  },
  {
   "id": 36376,
   "key": "D1401ru.txt:54",
   "ko": "심장은 더욱 고동을 빨리하며､ 거짓 그릇 전체에 작열하는 피를 보낸다｡"
  },
  {
   "id": 36377,
   "key": "D1401ru.txt:55",
   "ko": "심장 소리는､ 이제 폭음이었다｡"
  },
  {
   "id": 36378,
   "key": "D1401ru.txt:57",
   "ko": "광대한､ 끝없는 피의 바다를 격진시킨다｡"
  },
  {
   "id": 36379,
   "key": "D1401ru.txt:58",
   "ko": "피의 바다는 거칠게 날뛰며､ 폭풍이 되어､ 높은 파도를 일으킨다｡"
  },
  {
   "id": 36380,
   "key": "D1401ru.txt:60",
   "ko": "폭풍의 바다에 노래가 흐른다｡"
  },
  {
   "id": 36381,
   "key": "D1401ru.txt:64",
   "ko": "「라 루 류-､ 크토후루후 프타근… 라! 라!」"
  },
  {
   "id": 36382,
   "key": "D1401ru.txt:67",
   "ko": "격렬하게 고동치는 심장｡"
  },
  {
   "id": 36383,
   "key": "D1401ru.txt:68",
   "ko": "그 중간쯤에､ 부조처럼､ 피투성이의 하얀 거체가 묻혀 있다｡"
  },
  {
   "id": 36384,
   "key": "D1401ru.txt:70",
   "ko": "십자가에 못 박힌 성자와도 같은､ 그 모습｡"
  },
  {
   "id": 36385,
   "key": "D1401ru.txt:71",
   "ko": "인간이 만든 신｡ 귀계의 신｡"
  },
  {
   "id": 36386,
   "key": "D1401ru.txt:73",
   "ko": "――데우스 마키나｡"
  },
  {
   "id": 36387,
   "key": "D1401ru.txt:79",
   "ko": "하얀 데우스 마키나의 흉부가 열려 있다｡"
  },
  {
   "id": 36388,
   "key": "D1401ru.txt:80",
   "ko": "거기서 튀어나온 제단 같은 무대에､ 소녀의 모습이 있었다｡"
  },
  {
   "id": 36389,
   "key": "D1401ru.txt:82",
   "ko": "『르뤼에 이본』｡ 해신을 숭배하는 금단의 책에 깃든 정령｡"
  },
  {
   "id": 36390,
   "key": "D1401ru.txt:85",
   "ko": "신을 섬기는 기쁨에､ 소녀의 작은 몸은 떨리고 있다｡"
  },
  {
   "id": 36391,
   "key": "D1401ru.txt:86",
   "ko": "소녀를 감싸는 촉수 무리가､ 시에 맞춰 떨고 있었다｡"
  }
 ]
}