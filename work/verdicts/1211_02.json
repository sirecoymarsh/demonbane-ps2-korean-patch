  },
  {
   "id": 29664,
   "key": "D1211le.txt:348",
   "ko": "「유감이지만 걱정하고 있을 틈은 없는 모양이로군｡ 우리는 완성한 이놈을 메타트론에게 가져다주는 것이다!」"
  },
  {
   "id": 29665,
   "key": "D1211le.txt:352",
   "ko": "「네､ 부탁드립니다｡ 그리고…… 살았습니다､ 닥터｡ 감사드립니다」"
  },
  {
   "id": 29666,
   "key": "D1211le.txt:359",
   "ko": "「후후…… 됐다고､ 아가씨｡ 이것도 모두 『숙적』이라 쓰고 『친구』를 위해서다! 로큰롤 네버 다이!」"
  },
  {
   "id": 29667,
   "key": "D1211le.txt:363",
   "ko": "「그럼 이 몸은 간다! 하이요――――!」"
  },
  {
   "id": 29668,
   "key": "D1211le.txt:370",
   "ko": "「아와와와! 기다리라 로봇! 엘자도 탈 거라 로봇! 박사-!」"
  },
  {
   "id": 29669,
   "key": "D1211le.txt:374",
   "ko": "닥터 웨스트와 엘자를 태우고 폭음을 울리며 헌팅 호러는 달려갔다｡"
  },
  {
   "id": 29670,
   "key": "D1211le.txt:375",
   "ko": "그 뒷모습을 지켜보며 루리는 맹세한다｡"
  },
  {
   "id": 29671,
   "key": "D1211le.txt:377",
   "ko": "질 수는 없다고｡"
  },
  {
   "id": 29672,
   "key": "D1211le.txt:378",
   "ko": "마를 베는 검은 결코 부러뜨리게 하지 않겠다고｡ 「…………읏」"
  },
  {
   "id": 29673,
   "key": "D1211ru.txt:13",
   "ko": "외부의 위기도 모른 채 쿠로는 계속 잠들어 있다｡"
  },
  {
   "id": 29674,
   "key": "D1211ru.txt:14",
   "ko": "생사의 경계를 헤매고 있다｡"
  },
  {
   "id": 29675,
   "key": "D1211ru.txt:15",
   "ko": "그럴 터였다｡ 「…………읏읏」"
  },
  {
   "id": 29676,
   "key": "D1211ru.txt:20",
   "ko": "아주 조금｡"
  },
  {
   "id": 29677,
   "key": "D1211ru.txt:21",
   "ko": "아주 조금만､ 무언가에 반응한 듯 손가락 끝이 움직이고 있었다｡"
  },
  {
   "id": 29678,
   "key": "D1211ru.txt:23",
   "ko": "단지 그뿐인 반응｡"
  },
  {
   "id": 29679,
   "key": "D1211ru.txt:24",
   "ko": "그저 반사에 지나지 않는 반응이지만…… 무언가가 달랐다｡"
  },
  {
   "id": 29680,
   "key": "D1211ru.txt:26",
   "ko": "지금까지의 반죽음 상태와는 무언가가 크게 달랐다｡"
  },
  {
   "id": 29681,
   "key": "D1211ru.txt:30",
   "ko": "――다이쥬지 씨!"
  },
  {
   "id": 29682,
   "key": "D1211ru.txt:34",
   "ko": "「……아……아……」 작은､ 속삭임조차 되지 못할 만큼 작은 신음｡"
  },
  {
   "id": 29683,
   "key": "D1211ru.txt:37",
   "ko": "눈꺼풀이 조금 움직인 것처럼도 보였다｡"
  },
  {
   "id": 29684,
   "key": "D1211ru.txt:39",
   "ko": "하지만 그뿐｡"
  },
  {
   "id": 29685,
   "key": "D1211ru.txt:40",
   "ko": "결국은 그뿐인 것이다｡"
  },
  {
   "id": 29686,
   "key": "D1211ru.txt:42",
   "ko": "사신의 손은 여전히 엄청난 힘으로 쿠로를 명부의 심연으로 끌어내리려 하고 있다｡"
  },
  {
   "id": 29687,
   "key": "D1211ru.txt:43",
   "ko": "깊고 깊은 무명의 어둠으로―― 「――아니지｡ 어둠은 그런 걸 바라지 않아､ 쿠로 군」"
  },
  {
   "id": 29688,
   "key": "D1211ru.txt:60",
   "ko": "스며 나오는 어둠｡ 떠도는 어둠｡ 일렁이는 어둠｡ 광란하는 어둠｡ 불타오르는 어둠｡ 잠든 쿠로의 곁에 어둠이 모여들어 사람의 형상으로 자리 잡아간다｡"
  },
  {
   "id": 29689,
   "key": "D1211ru.txt:68",
   "ko": "「언제까지 잠들어 있을 셈이야? 네 소중한 사람들이 큰일 났는데｡ 서두르지 않으면 늦을지도 몰라?」"
  },
  {
   "id": 29690,
   "key": "D1211ru.txt:71",
   "ko": "시트를 걷어내고 붕대투성이인 가슴에 손가락을 기게 한다｡ 가슴팍을 손톱을 세워 긁는다｡"
  },
  {
   "id": 29691,
   "key": "D1211ru.txt:74",
   "ko": "="
  },
  {
   "id": 29692,
   "key": "D1211ru.txt:76",
   "ko": "="
  },
  {
   "id": 29693,
   "key": "D1211ru.txt:77",
   "ko": "="
  },
  {
   "id": 29694,
   "key": "D1211ru.txt:79",
   "ko": "="
  },
  {
   "id": 29695,
   "key": "D1211ru.txt:80",
   "ko": "마치 초조함에 사로잡힌 것 같다｡"
  },
  {
   "id": 29696,
   "key": "D1211ru.txt:84",
   "ko": "「――지금､ 넌 무슨 꿈을 꾸고 있는 거지? 죽음의 벼랑 끝에서｡ 어둠의 심연을 들여다보며」"
  },
  {
   "id": 29697,
   "key": "D1211ru.txt:88",
   "ko": "킥킥……｡"
  }
