   "key": "ep_ruri01.txt:384",
   "ko": "="
  },
  {
   "id": 50242,
   "key": "ep_ruri01.txt:386",
   "ko": "="
  },
  {
   "id": 50243,
   "key": "ep_ruri01.txt:387",
   "ko": "="
  },
  {
