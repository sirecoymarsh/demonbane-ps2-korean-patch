  {
   "id": 36393,
   "key": "D1401ru.txt:97",
   "ko": "제단을 삼키는 촉수 무리에 파묻혀､ 또 하나의 몸이 누워 있다｡"
  },
  {
   "id": 36394,
   "key": "D1401ru.txt:99",
   "ko": "소녀와 마찬가지로 자그마한 몸｡ 그 전신을 감싸는 구속구｡"
  },
  {
   "id": 36395,
   "key": "D1401ru.txt:100",
   "ko": "『폭군』이라 불린 소녀다｡"
  },
  {
   "id": 36398,
   "key": "D1401ru.txt:102",
   "ko": "『폭군』 또한 촉수에 구속되어､ 고통과 도취에 몸부림치고 있다｡"
  },
  {
   "id": 36399,
   "key": "D1401ru.txt:108",
   "ko": "「신님 신님 나의 신님 깊고 어두운 물밑에」"
  },
  {
   "id": 36400,
   "key": "D1401ru.txt:113",
   "ko": "「자장자장 자장자장 꿈을 꾸네 꿈을 꾸네 깨어남을 꿈꾸며､ 꿈을 꾸네」"
  },
  {
   "id": 36401,
   "key": "D1401ru.txt:119",
   "ko": "「아아､ 사랑스러운 당신､ 꿈꾸는 신님 닿아라 닿아라 부디 부탁이야 나의 마음 닿아줘 부탁이야」"
  },
  {
   "id": 36402,
   "key": "D1401ru.txt:125",
   "ko": "「사로잡힌 당신 사로잡힌 왕자님 사슬을 부수고 밖으로 나가자 감옥을 부수고 밖으로 나가자」"
  },
  {
   "id": 36403,
   "key": "D1401ru.txt:134",
   "ko": "「죽어 있는 거야? 죽어 있는 거야? 당신의 무덤을 찾아 두리번두리번 비밀의 마법을 외우자 멋진 마법을 외우자」"
  },
  {
   "id": 36404,
   "key": "D1401ru.txt:144",
   "ko": "「꿈에서 깨어나 잠에서 깨어나 죽음에서 깨어나 하지만 계속되는 거야 계속계속 이어지는 거야」"
  },
  {
   "id": 36405,
   "key": "D1401ru.txt:152",
   "ko": "「나의 행복 당신의 행복 당신과 나의 멋진 성 당신과 나의 멋진 왕국」"
  },
  {
   "id": 36406,
   "key": "D1401ru.txt:165",
   "ko": "「…………! 아아아아아――――――!」"
  },
  {
   "id": 36407,
   "key": "D1401ru.txt:169",
   "ko": "「~~~~~~!」"
  },
  {
   "id": 36408,
   "key": "D1401ru.txt:172",
   "ko": "갑작스러운 절규가 대광간에 울려 퍼졌다｡"
  },
  {
   "id": 36410,
   "key": "D1401ru.txt:175",
   "ko": "신의 심장이､ 한층 더 큰 고동의 폭음을 울린다｡"
  },
  {
   "id": 36411,
   "key": "D1401ru.txt:177",
   "ko": "폭발은 신의 피를 더욱 작열하게 끓어오르게 하고､ 말 그대로 폭발적인 기세로 전신에 힘을 보낸다｡"
  },
  {
   "id": 36412,
   "key": "D1401ru.txt:184",
   "ko": "넘쳐흐르는 사신의 힘｡"
  },
  {
   "id": 36413,
   "key": "D1401ru.txt:185",
   "ko": "전신에서 넘쳐 나오는 신기가 허공을 진감시켰다｡"
  },
  {
   "id": 36415,
   "key": "D1401ru.txt:187",
   "ko": "떨리던 촉수가 통일성을 얻어 동시에 움직였다｡"
  },
  {
   "id": 36416,
   "key": "D1401ru.txt:188",
   "ko": "용의 머리가 일제히 눈 아래의 아컴시티를 향해 턱을 벌린다｡"
  },
  {
   "id": 36417,
   "key": "D1401ru.txt:189",
   "ko": "비가 되어 쏟아지는 강산성의 침｡"
  },
  {
   "id": 36418,
   "key": "D1401ru.txt:196",
   "ko": "「자아… 조금만 놀아주지｡ 실컷 발버둥쳐 보아라! 데몬베인! 하도 재벌!」"
  },
  {
   "id": 36419,
   "key": "D1401ru.txt:207",
   "ko": "목구멍 안쪽에서 타오르는 파멸적인 에너지의 빛｡"
  },
  {
   "id": 36420,
   "key": "D1401ru.txt:218",
   "ko": "="
  },
  {
   "id": 36421,
   "key": "D1401ru.txt:219",
   "ko": "울려 퍼지는､ 몇 겹으로 겹쳐진､ 포효｡"
  },
  {
   "id": 36422,
   "key": "D1401ru.txt:220",
   "ko": "용의 머리를 닮은 무수한 촉수가 떤다｡ 포효한다｡ 불타오른다｡"
  },
  {
   "id": 36423,
   "key": "D1401ru.txt:222",
   "ko": "온몸이 휘발되어 나라는 존재가 소멸해 버릴 것 같은 감각｡"
  },
  {
