 "items": [
  {
   "id": 28978,
   "key": "D1210al.txt:10",
   "file": "D1210al.txt",
   "line": 10,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ははは……っ、ひゃ……ひゃははっ、へっへっ……ッ！」 「ヒャーハハハハハハハハハッ！ざぁまあねえなぁ、大十字九郎！」",
   "ko_candidate": "「하하하……큭､ 히야……히야하핫､ 헤헷……! 히야하하하하하하하하핫! 꼴좋다､ 다이쥬지 쿠로! 아-아! 간지 떨어져! 찌질하다고､ 이 자식아!」"
  },
  {
   "id": 28979,
   "key": "D1210al.txt:16",
   "file": "D1210al.txt",
   "line": 16,
   "speaker": "クラウディウス / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あーあ！　カッコ悪ぅ！　サムいんだよ、てめーはよぉ！」 「……くっ」",
   "ko_candidate": "「……큿」"
  },
  {
   "id": 28980,
   "key": "D1210al.txt:27",
   "file": "D1210al.txt",
   "line": 27,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ぅぅ……っ」",
   "ko_candidate": "「아……으으……읏」"
  },
  {
   "id": 28981,
   "key": "D1210al.txt:30",
   "file": "D1210al.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝ち誇るクラウディウスの哄笑が、激痛に眩む意識をさらに苛んだ。",
   "ko_candidate": "승리를 만끽하는 클라우디우스의 폭소가 격통으로 어지러운 의식을 더욱 괴롭혔다｡"
  },
  {
   "id": 28982,
   "key": "D1210al.txt:32",
   "file": "D1210al.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲鳴を上げる身体に鞭打って、操縦桿を握り、デモンベインを起き上がらせようとする。",
   "ko_candidate": "비명을 지르는 몸을 채찍질하며､ 조종간을 잡고 데몬베인을 일으키려 한다｡"
  },
  {
   "id": 28983,
   "key": "D1210al.txt:33",
   "file": "D1210al.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが主要の魔術回路にエラーが発生し、回復までには時間が掛かりそうだった。",
   "ko_candidate": "하지만 주요 마술 회로에 에러가 발생해 회복까지는 시간이 걸릴 것 같았다｡"
  },
  {
   "id": 28984,
   "key": "D1210al.txt:35",
   "file": "D1210al.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……ヤバいぜ……っ！",
   "ko_candidate": "젠장……위험하군……!"
  },
  {
   "id": 28985,
   "key": "D1210al.txt:40",
   "file": "D1210al.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーが地上に降りた。",
   "ko_candidate": "로드 비야키가 지상에 내려왔다｡"
  },
  {
   "id": 28986,
   "key": "D1210al.txt:41",
   "file": "D1210al.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "倒れるデモンベインの元へ、無防備のまま近寄ってくる。",
   "ko_candidate": "쓰러진 데몬베인 쪽으로 무방비 상태로 다가온다｡"
  },
  {
   "id": 28987,
   "key": "D1210al.txt:45",
   "file": "D1210al.txt",
   "line": 45,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これで終わりだなぁ？」",
   "ko_candidate": "「이걸로 끝이군?」"
  },
  {
   "id": 28988,
   "key": "D1210al.txt:52",
   "file": "D1210al.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを見下ろして、ロードビヤーキーはライフルを向けてきた。",
   "ko_candidate": "데몬베인을 내려다보며 로드 비야키가 라이플을 겨누어 왔다｡"
  },
  {
   "id": 28989,
   "key": "D1210al.txt:52",
   "file": "D1210al.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "銃口の先は――コクピット。",
   "ko_candidate": "총구의 끝은――콕핏｡"
  },
  {
   "id": 28990,
   "key": "D1210al.txt:54",
   "file": "D1210al.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……くそ……クソッ！",
   "ko_candidate": "젠장……젠장……젠장!"
  },
  {
   "id": 28991,
   "key": "D1210al.txt:55",
   "file": "D1210al.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここまで来て――終わっちまうのかよッ!?",
   "ko_candidate": "여기까지 와서――끝나버리는 건가!?"
  },
  {
   "id": 28992,
   "key": "D1210al.txt:59",
   "file": "D1210al.txt",
   "line": 59,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あばよ、インスタント野郎！ 地獄でカリグラに 詫びてきやがれ！」",
   "ko_candidate": "「안녕､ 인스턴트 자식아! 지옥에 가서 칼리굴라한테 사과나 해!」"
  },
  {
   "id": 28993,
   "key": "D1210al.txt:65",
   "file": "D1210al.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無慈悲にもトリガーが引か――",
   "ko_candidate": "무자비하게 방아쇠가 당겨――"
  },
  {
   "id": 28994,
   "key": "D1210al.txt:72",
   "file": "D1210al.txt",
   "line": 72,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――あれ？」",
   "ko_candidate": "「――어라?」"
  },
  {
   "id": 28995,
   "key": "D1210al.txt:79",
   "file": "D1210al.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無造作に、",
   "ko_candidate": "무심하게､"
  },
  {
   "id": 28996,
   "key": "D1210al.txt:84",
   "file": "D1210al.txt",
   "line": 84,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――えっ？」",
   "ko_candidate": "「――엣?」"
  },
  {
   "id": 28997,
   "key": "D1210al.txt:88",
   "file": "D1210al.txt",
   "line": 88,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――ロボ？」",
   "ko_candidate": "「――로봇?」"
  },
  {
   "id": 28998,
   "key": "D1210al.txt:95",
   "file": "D1210al.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ロードビヤーキーが、引き千切られた。",
   "ko_candidate": "로드 비야키가 찢겨나갔다｡"
  },
  {
   "id": 28999,
   "key": "D1210al.txt:97",
   "file": "D1210al.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体の上半身だけが、遠く遠く、吹き飛んでゆく。",
   "ko_candidate": "기체의 상반신만이 멀리멀리 날아가고 있다｡"
  },
  {
   "id": 29000,
   "key": "D1210al.txt:98",
   "file": "D1210al.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何が起こったのか、理解できなかった。",
   "ko_candidate": "무슨 일이 일어났는지 이해할 수 없었다｡"
  },
  {
   "id": 29001,
   "key": "D1210al.txt:108",
   "file": "D1210al.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビルを倒壊させ、ロードビヤーキーの上半身が大地に転がる。",
   "ko_candidate": "빌딩을 무너뜨리며 로드 비야키의 상반신이 대지에 굴러떨어진다｡"
  },
  {
   "id": 29002,
   "key": "D1210al.txt:109",
   "file": "D1210al.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目の前には、水銀の血を噴き出す下半身だけが、立ち尽くしている。",
   "ko_candidate": "눈앞에는 수은 같은 피를 뿜어내는 하반신만이 우두커니 서 있다｡"
  },
  {
   "id": 29003,
   "key": "D1210al.txt:114",
   "file": "D1210al.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――否。",
   "ko_candidate": "――아니｡"
  },
  {
   "id": 29004,
   "key": "D1210al.txt:115",
   "file": "D1210al.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけじゃない。",
   "ko_candidate": "그뿐만이 아니다｡"
  },
  {
   "id": 29005,
   "key": "D1210al.txt:123",
   "file": "D1210al.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺はようやく、 その背後に聳え立つ威容の存在に気付いた。",
   "ko_candidate": "나는 겨우 그 뒤에 우뚝 솟은 위용의 존재를 알아차렸다｡"
  },
  {
   "id": 29006,
   "key": "D1210al.txt:135",
   "file": "D1210al.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大だ。",
   "ko_candidate": "거대하다｡"
  },
  {
   "id": 29007,
   "key": "D1210al.txt:136",
   "file": "D1210al.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "途方になく巨大だ。",
   "ko_candidate": "엄청나게 거대하다｡"
  },
  {
   "id": 29008,
   "key": "D1210al.txt:137",
   "file": "D1210al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その全長は、デモンベインの悠に５倍はある。",
   "ko_candidate": "그 전장은 데몬베인의 족히 5배는 된다｡"
  },
  {
   "id": 29009,
   "key": "D1210al.txt:143",
   "file": "D1210al.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが何よりも、放たれる魔力――いや、もはや『神気』と呼んで良い――が、この存在に壮大で、圧倒的な気配を与えていた。",
   "ko_candidate": "하지만 무엇보다도 뿜어내는 마력――아니､ 이제는 『신기』라고 불러도 좋을――가 이 존재에게 웅장하고 압도적인 기색을 부여하고 있었다｡"
  },
  {
   "id": 29010,
   "key": "D1210al.txt:148",
   "file": "D1210al.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "高みから、デモンベインを見下ろす威容。",
   "ko_candidate": "높은 곳에서 데몬베인을 내려다보는 위용｡"
  },
  {
   "id": 29011,
   "key": "D1210al.txt:149",
   "file": "D1210al.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その無骨な腕で、ロードビヤーキーを粉砕した張本人。",
   "ko_candidate": "그 투박한 팔로 로드 비야키를 분쇄한 장본인｡"
  },
  {
   "id": 29012,
   "key": "D1210al.txt:150",
   "file": "D1210al.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白く輝く、神殿の如き姿。",
   "ko_candidate": "하얗게 빛나는 신전과 같은 모습｡"
  },
  {
   "id": 29013,
   "key": "D1210al.txt:152",
   "file": "D1210al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは異形のヒト型だった。",
   "ko_candidate": "그것은 기괴한 인간형이었다｡"
  },
  {
   "id": 29014,
   "key": "D1210al.txt:153",
   "file": "D1210al.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは荘厳な悪魔だった。",
   "ko_candidate": "그것은 장엄한 악마였다｡"
  },
  {
   "id": 29015,
   "key": "D1210al.txt:154",
   "file": "D1210al.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは歪んだ天使だった。",
   "ko_candidate": "그것은 일그러진 천사였다｡"
  },
  {
   "id": 29016,
   "key": "D1210al.txt:156",
   "file": "D1210al.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは恐らくは異界の神を模して造られた、異質な法則に基づいて動く存在だった。",
   "ko_candidate": "그것은 아마도 이계의 신을 본떠 만들어진､ 이질적인 법칙에 따라 움직이는 존재였다｡"
  },
  {
   "id": 29017,
   "key": "D1210al.txt:157",
   "file": "D1210al.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば、その意味することは一つである。",
   "ko_candidate": "그렇다면 그 의미하는 바는 하나다｡"
  }
 ]
}