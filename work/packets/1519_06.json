 "items": [
  {
   "id": 48775,
   "key": "D1519le.txt:169",
   "file": "D1519le.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生きていたのか……！",
   "ko_candidate": "살아있었던 건가…!"
  },
  {
   "id": 48776,
   "key": "D1519le.txt:170",
   "file": "D1519le.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "確かにこいつも尋常じゃない、恐るべき魔人であることは明らかだったが……よりによってこのタイミングで！　ドちくしょうがっ！",
   "ko_candidate": "확실히 이놈도 보통이 아닌､ 두려워해야 할 마인임이 분명 했지만… 하필이면 이 타이밍에! 젠장!"
  },
  {
   "id": 48777,
   "key": "D1519le.txt:174",
   "file": "D1519le.txt",
   "line": 174,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル……！」",
   "ko_candidate": "「알……!」"
  },
  {
   "id": 48778,
   "key": "D1519le.txt:177",
   "file": "D1519le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こちとらアルが居なけりゃ、マトモに戦うことが出来ない。",
   "ko_candidate": "이쪽은 알이 없으면 제대로 싸울 수가 없어｡"
  },
  {
   "id": 48779,
   "key": "D1519le.txt:178",
   "file": "D1519le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "這い寄って来る闇を蹴散らすようにして、デモンベインに向かって走る。",
   "ko_candidate": "기어오는 어둠을 걷어내듯 데몬베인을 향해 달린다｡"
  },
  {
   "id": 48780,
   "key": "D1519le.txt:180",
   "file": "D1519le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが闇は重く粘り、纏わりつき、俺の足を止めてしまう。",
   "ko_candidate": "하지만 어둠은 무겁고 끈적거려 달라붙어 내 발을 멈추게 한다｡"
  },
  {
   "id": 48781,
   "key": "D1519le.txt:184",
   "file": "D1519le.txt",
   "line": 184,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「翔ぶよ、九郎ちゃん！」",
   "ko_candidate": "「날 거예요､ 쿠로 군!」"
  },
  {
   "id": 48782,
   "key": "D1519le.txt:193",
   "file": "D1519le.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんが俺を抱きかかえて、飛翔する。",
   "ko_candidate": "라이카 씨가 나를 안아 들고 날아오른다｡"
  },
  {
   "id": 48783,
   "key": "D1519le.txt:194",
   "file": "D1519le.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが闇は空の罅割れからも滴り落ち、俺たちを絡め取った。",
   "ko_candidate": "하지만 어둠은 하늘의 틈새에서도 떨어져 우리를 휘감았다｡"
  },
  {
   "id": 48784,
   "key": "D1519le.txt:202",
   "file": "D1519le.txt",
   "line": 202,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまっ……！」",
   "ko_candidate": "「이런……!」"
  },
  {
   "id": 48785,
   "key": "D1519le.txt:205",
   "file": "D1519le.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声すら闇に塞がれた。",
   "ko_candidate": "목소리마저 어둠에 막혀버렸다｡"
  },
  {
   "id": 48786,
   "key": "D1519le.txt:207",
   "file": "D1519le.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇は俺たちを束縛するのみならず、身体に染み込み、毒のように力を奪ってゆく……！",
   "ko_candidate": "어둠은 우리를 속박할 뿐만 아니라 몸에 스며들어 독처럼 힘을 빼앗아 간다……!"
  },
  {
   "id": 48787,
   "key": "D1519le.txt:209",
   "file": "D1519le.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クソッタレ！",
   "ko_candidate": "젠장!"
  },
  {
   "id": 48788,
   "key": "D1519le.txt:215",
   "file": "D1519le.txt",
   "line": 215,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「折角、この領域まで昇り詰めたんだ。何としてもライカには、『仔』を受胎して貰わないとならない……」",
   "ko_candidate": "「힘들게 이 영역까지 올라왔는데｡ 어떻게든 라이카에게 『새끼』를 잉태하게 해야만 해……」"
  },
  {
   "id": 48789,
   "key": "D1519le.txt:219",
   "file": "D1519le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の中に、淡い光が浮かび上がる。",
   "ko_candidate": "어둠 속에 희미한 빛이 떠오른다｡"
  },
  {
   "id": 48790,
   "key": "D1519le.txt:225",
   "file": "D1519le.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まただ……またあの胎児だ。",
   "ko_candidate": "또다……또 그 태아다｡"
  },
  {
   "id": 48791,
   "key": "D1519le.txt:226",
   "file": "D1519le.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの怖気を震う異形の胎児が、ナイアの横に漂いながら、凝っとこちらを見つめている。",
   "ko_candidate": "소름 끼치는 기괴한 태아가 나이아의 옆에 떠다니며 뚫어지게 이쪽을 바라보고 있다｡"
  },
  {
   "id": 48792,
   "key": "D1519le.txt:227",
   "file": "D1519le.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不完全な、魔人の眸で。",
   "ko_candidate": "불완전한 마인의 눈동자로｡"
  },
  {
   "id": 48793,
   "key": "D1519le.txt:231",
   "file": "D1519le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故だ……何故、俺はこの眸を知っていると確信しているのだろう？",
   "ko_candidate": "왜지……왜 나는 이 눈동자를 알고 있다고 확신하는 걸까?"
  },
  {
   "id": 48794,
   "key": "D1519le.txt:232",
   "file": "D1519le.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吐き気を催す怖気と共に、既視感を覚えるのだろう。",
   "ko_candidate": "구역질이 날 것 같은 소름과 함께 기시감을 느끼는 걸까｡"
  },
  {
   "id": 48795,
   "key": "D1519le.txt:233",
   "file": "D1519le.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この眸は――",
   "ko_candidate": "이 눈동자는――"
  },
  {
   "id": 48796,
   "key": "D1519le.txt:234",
   "file": "D1519le.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この眸の、彩は――",
   "ko_candidate": "이 눈동자의 색은――"
  },
  {
   "id": 48797,
   "key": "D1519le.txt:247",
   "file": "D1519le.txt",
   "line": 247,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何も怖がる事はない。このまま僕に呑まれて、眠ってしまえば良いのさ。次に覚醒める時には総て終わっている。ライカは役目を果たし……」 「九郎君。君は次の輪廻のための、戦いが待っているのさ。だから今は眠れ……」",
   "ko_candidate": "「두려워할 필요 없어｡ 이대로 나에게 삼켜져 잠들면 돼｡ 다음에 깨어날 때는 모든 게 끝나 있을 거야｡ 라이카는 역할을 다하고…… 쿠로 군｡ 너에겐 다음 윤회를 위한 싸움이 기다리고 있어｡ 그러니 지금은 잠들어……」"
  },
  {
   "id": 48798,
   "key": "D1519le.txt:255",
   "file": "D1519le.txt",
   "line": 255,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「～～～～～～～～～っ！」",
   "ko_candidate": "「~~~~~~~~~읏!」"
  },
  {
   "id": 48799,
   "key": "D1519le.txt:266",
   "file": "D1519le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が意識までをも侵す。",
   "ko_candidate": "어둠이 의식마저 침식한다｡"
  },
  {
   "id": 48800,
   "key": "D1519le.txt:267",
   "file": "D1519le.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "微睡みが、緩やかな絶望の闇と共に、意思を奪ってゆく。",
   "ko_candidate": "미몽이 완만한 절망의 어둠과 함께 의지를 빼앗아 간다｡"
  },
  {
   "id": 48801,
   "key": "D1519le.txt:269",
   "file": "D1519le.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……こんなところで終わっちまうのかよ……。",
   "ko_candidate": "젠장……이런 곳에서 끝나버리는 건가……"
  },
  {
   "id": 48802,
   "key": "D1519le.txt:270",
   "file": "D1519le.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今までの戦いが全部、無駄になってしまうのか……。",
   "ko_candidate": "지금까지의 싸움이 전부 헛수고가 되어버리는 건가……"
  },
  {
   "id": 48803,
   "key": "D1519le.txt:271",
   "file": "D1519le.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな理不尽に……。",
   "ko_candidate": "이런 부조리에……"
  },
  {
   "id": 48804,
   "key": "D1519le.txt:271",
   "file": "D1519le.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちくしょ……おぉ……。",
   "ko_candidate": "제기랄……오오……"
  },
  {
   "id": 48805,
   "key": "D1519le.txt:276",
   "file": "D1519le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が、完全に闇に呑まれようとした、その時だった。",
   "ko_candidate": "의식이 완전히 어둠에 삼켜지려 했을 때였다｡"
  },
  {
   "id": 48806,
   "key": "D1519le.txt:277",
   "file": "D1519le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "稲妻の様に轟く咆吼が、俺を貫いた。",
   "ko_candidate": "번개처럼 울리는 포효가 나를 꿰뚫었다｡"
  },
  {
   "id": 48807,
   "key": "D1519le.txt:282",
   "file": "D1519le.txt",
   "line": 282,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎―――――――ッッッッ！」",
   "ko_candidate": "「쿠로――――――――읏!」"
  },
  {
   "id": 48808,
   "key": "D1519le.txt:292",
   "file": "D1519le.txt",
   "line": 292,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だぁ!?」",
   "ko_candidate": "「뭐야!?」"
  },
  {
   "id": 48809,
   "key": "D1519le.txt:295",
   "file": "D1519le.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然、俺たちを包み込む闇が、粉々に弾け飛んだ。",
   "ko_candidate": "갑자기 우리를 감싸고 있던 어둠이 산산조각 나 흩어졌다｡"
  },
  {
   "id": 48810,
   "key": "D1519le.txt:296",
   "file": "D1519le.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が飛沫を飛び散らせる。",
   "ko_candidate": "어둠이 물보라를 튀긴다｡"
  },
  {
   "id": 48811,
   "key": "D1519le.txt:298",
   "file": "D1519le.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちは束縛から解放され、闇に覆われている地表へと墜ちる。",
   "ko_candidate": "우리는 속박에서 풀려나 어둠에 덮인 지표로 떨어진다｡"
  },
  {
   "id": 48812,
   "key": "D1519le.txt:299",
   "file": "D1519le.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何があった？",
   "ko_candidate": "무슨 일이 있었지?"
  },
  {
   "id": 48813,
   "key": "D1519le.txt:301",
   "file": "D1519le.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "現状を確認しようと、周囲を見渡す。",
   "ko_candidate": "현 상황을 확인하려 주위를 둘러본다｡"
  },
  {
   "id": 48814,
   "key": "D1519le.txt:305",
   "file": "D1519le.txt",
   "line": 305,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃん！　あれを……！」",
   "ko_candidate": "「쿠로 군! 저것을……!」"
  }
 ]
}