 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "姫さん": "공주님",
  "アル": "알",
  "デモンベイン": "데몬베인",
  "ウィルバー・ウェイトリイ": "윌버 웨이틀리"
 },
 "items": [
  {
   "id": 32925,
   "key": "D1306ru.txt:101",
   "file": "D1306ru.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その答えが分かる。",
   "ko_candidate": "그 답을 알겠다｡"
  },
  {
   "id": 32926,
   "key": "D1306ru.txt:102",
   "file": "D1306ru.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怯えながらも戦う姫さんの瞳に、俺は答えを知る。",
   "ko_candidate": "두려워하면서도 싸우는 공주님의 눈동자에서､ 나는 답을 안다｡"
  },
  {
   "id": 32927,
   "key": "D1306ru.txt:104",
   "file": "D1306ru.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はもう答えを手に入れていた。",
   "ko_candidate": "나는 이미 답을 손에 넣었다｡"
  },
  {
   "id": 32928,
   "key": "D1306ru.txt:105",
   "file": "D1306ru.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺がアルと出逢ったときに。",
   "ko_candidate": "내가 알과 만났을 때｡"
  },
  {
   "id": 32929,
   "key": "D1306ru.txt:106",
   "file": "D1306ru.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインに乗ったときに。",
   "ko_candidate": "데몬베인에 탔을 때｡"
  },
  {
   "id": 32930,
   "key": "D1306ru.txt:108",
   "file": "D1306ru.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――魔を断つ剣を、手に執ったときに。",
   "ko_candidate": "… 마를 베는 검을 손에 쥐었을 때｡"
  },
  {
   "id": 32931,
   "key": "D1306ru.txt:111",
   "file": "D1306ru.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば、もうやることは決まっている。",
   "ko_candidate": "그렇다면 이제 할 일은 정해졌다｡"
  },
  {
   "id": 32932,
   "key": "D1306ru.txt:112",
   "file": "D1306ru.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、俺は姫さんを侵そうとするこの化け物を――違う。そうじゃない。こいつはウィルバー・ウェイトリイじゃない。",
   "ko_candidate": "지금､ 나는 공주님을 침범하려는 이 괴물을… 아니다｡ 그게 아니야｡ 이놈은 윌버 웨이틀리가 아니다｡"
  },
  {
   "id": 32933,
   "key": "D1306ru.txt:114",
   "file": "D1306ru.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつは……俺の恐怖。",
   "ko_candidate": "이놈은… 내 공포｡"
  },
  {
   "id": 32934,
   "key": "D1306ru.txt:115",
   "file": "D1306ru.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺そのものだ。",
   "ko_candidate": "나 자신이다｡"
  },
  {
   "id": 32935,
   "key": "D1306ru.txt:116",
   "file": "D1306ru.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "化け物なんて皮を被せて、逃げちゃいけない。",
   "ko_candidate": "괴물 같은 껍데기를 씌워서 도망쳐선 안 된다｡"
  },
  {
   "id": 32936,
   "key": "D1306ru.txt:118",
   "file": "D1306ru.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は俺を、真正面から……そう、姫さんのように真っ直ぐと見つめて、そして――これに打ち克つ！",
   "ko_candidate": "나는 나를 정면으로… 그래､ 공주님처럼 똑바로 바라보고､ 그리고… 이것을 극복한다! 나는 손에 든 언월도를 휘둘러…!"
  },
  {
   "id": 32937,
   "key": "D1306ru.txt:120",
   "file": "D1306ru.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は手に持った偃月刀を振り上げて……！",
   "ko_candidate": "기절에서 깨어나니 내 몸을 희롱하는 괴이｡"
  },
  {
   "id": 32938,
   "key": "D1306ru.txt:132",
   "file": "D1306ru.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "気絶から目覚めれば、私の躰を弄ぶ怪異。",
   "ko_candidate": "내 몸과 마음과 영혼을 유린하려는 괴이｡ 악몽에 출구는 없었다｡"
  },
  {
   "id": 32939,
   "key": "D1306ru.txt:133",
   "file": "D1306ru.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私の躰を心を魂を蹂躙しようとする怪異。",
   "ko_candidate": "정신을 잃어도 어둠에 빠진 의식이 도달하는 곳은 결국 악몽｡"
  },
  {
   "id": 32940,
   "key": "D1306ru.txt:135",
   "file": "D1306ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悪夢に出口は無かった。",
   "ko_candidate": "공포로 돌아갈 뿐이다｡"
  },
  {
   "id": 32941,
   "key": "D1306ru.txt:137",
   "file": "D1306ru.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気を失っても、闇に堕ちた意識が辿り着くのは結局、悪夢。",
   "ko_candidate": "마비되었던 공포가 지금､ 혐오감에 부추겨져 제방을 무너뜨리듯 밀려온다｡"
  },
  {
   "id": 32942,
   "key": "D1306ru.txt:138",
   "file": "D1306ru.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "恐怖に戻るだけだ。",
   "ko_candidate": "「아아… 아아아… 아아…!」 아프다｡"
  },
  {
   "id": 32943,
   "key": "D1306ru.txt:140",
   "file": "D1306ru.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "麻痺していたはずの恐怖が、今、嫌悪感に煽られて、堰を切ったように押し寄せてくる。",
   "ko_candidate": "역겹다｡ 무섭다｡"
  },
  {
   "id": 32944,
   "key": "D1306ru.txt:147",
   "file": "D1306ru.txt",
   "line": 147,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あぁ……ぁぁぁ……ぁぁ……っ！」",
   "ko_candidate": "아프다｡ 역겹다｡"
  },
  {
   "id": 32945,
   "key": "D1306ru.txt:151",
   "file": "D1306ru.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛い。",
   "ko_candidate": "무섭다｡"
  },
  {
   "id": 32946,
   "key": "D1306ru.txt:152",
   "file": "D1306ru.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "気持ち悪い。",
   "ko_candidate": "아프다｡ 역겹다｡"
  },
  {
   "id": 32947,
   "key": "D1306ru.txt:153",
   "file": "D1306ru.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
