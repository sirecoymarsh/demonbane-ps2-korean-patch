   "key": "D0405.txt:182",
   "file": "D0405.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どんなニーズで生産されているんだか。",
   "ko_candidate": "――섬뜩……"
  },
  {
