 },
 "items": [
  {
   "id": 29498,
   "key": "D1210le.txt:1239",
   "file": "D1210le.txt",
   "line": 1239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "決意は眩い閃光に包み込まれ、武装される。",
   "ko_candidate": "결의는 눈부신 섬광에 휩싸여 무장된다｡"
  },
  {
   "id": 29499,
   "key": "D1210le.txt:1240",
   "file": "D1210le.txt",
   "line": 1240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宣言する。",
   "ko_candidate": "선언한다｡"
  },
  {
   "id": 29500,
   "key": "D1210le.txt:1248",
   "file": "D1210le.txt",
   "line": 1248,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「変神！」",
   "ko_candidate": "「변신!」"
  },
  {
   "id": 29501,
   "key": "D1210le.txt:1251",
   "file": "D1210le.txt",
   "line": 1251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力の因子は、組み込まれている術式を読み取り、その情報を元に天使の姿を再構築する。",
   "ko_candidate": "마력의 인자는 내장된 술식을 읽어내고､ 그 정보를 바탕으로 천사의 모습을 재구축한다｡"
  },
  {
   "id": 29502,
   "key": "D1210le.txt:1252",
   "file": "D1210le.txt",
   "line": 1252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い装甲、光を燈す。",
   "ko_candidate": "하얀 장갑､ 빛을 밝힌다｡"
  },
  {
   "id": 29503,
   "key": "D1210le.txt:1253",
   "file": "D1210le.txt",
   "line": 1253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天使の翼、光を拡げる。",
   "ko_candidate": "천사의 날개､ 빛을 펼친다｡"
  },
  {
   "id": 29504,
   "key": "D1210le.txt:1260",
   "file": "D1210le.txt",
   "line": 1260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――メタトロン、再臨。",
   "ko_candidate": "――메타트론､ 재림｡"
  },
  {
   "id": 29505,
   "key": "D1210le.txt:1265",
   "file": "D1210le.txt",
   "line": 1265,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「でも満身創痍には変わりない……おいで、メタトロン。 軽ぅぅぅぅぅく遊んであげるわ」",
   "ko_candidate": "「하지만 만신창이인 건 변함없어…… 이리 와､ 메타트론｡ 가볍게 놀아줄게」"
  },
  {
   "id": 29506,
   "key": "D1210le.txt:1269",
   "file": "D1210le.txt",
   "line": 1269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの仮面が、怒りの仮面に切り替わる。",
   "ko_candidate": "티베리우스의 가면이 분노의 가면으로 바뀐다｡"
  },
  {
   "id": 29507,
   "key": "D1210le.txt:1270",
   "file": "D1210le.txt",
   "line": 1270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンはティベリウスの出方を注意深く観察しつつ、子ども達の頭に手を置いた。",
   "ko_candidate": "메타트론은 티베리우스의 행동을 주의 깊게 관찰하면서 아이들의 머리에 손을 얹었다｡"
  },
  {
   "id": 29508,
   "key": "D1210le.txt:1272",
   "file": "D1210le.txt",
   "line": 1272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲に包まれた掌は硬く、重く……だが、何処までも優しい。",
   "ko_candidate": "장갑에 싸인 손바닥은 딱딱하고 무겁지만…… 어디까지나 상냥하다｡"
  },
  {
   "id": 29509,
   "key": "D1210le.txt:1276",
   "file": "D1210le.txt",
   "line": 1276,
   "speaker": "メタトロン / コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大丈夫……みんなは、私が護るから」 「メタトロン……いや」",
   "ko_candidate": "「괜찮아…… 모두를 내가 지킬 테니까」"
  },
  {
   "id": 29510,
   "key": "D1210le.txt:1286",
   "file": "D1210le.txt",
   "line": 1286,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……姉ちゃん」",
   "ko_candidate": "「메타트론…… 아니」"
  },
  {
   "id": 29511,
   "key": "D1210le.txt:1291",
   "file": "D1210le.txt",
   "line": 1291,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカ、お姉ちゃん」",
   "ko_candidate": "「……누나」 「라이카､ 누나」"
  },
  {
   "id": 29512,
   "key": "D1210le.txt:1297",
   "file": "D1210le.txt",
   "line": 1297,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「キモイ三文芝居ね！　ジンマシンが出てきそうよっ！」",
   "ko_candidate": "「역겨운 삼류 연극이네! 두드러기가 날 것 같아!」"
  },
  {
   "id": 29513,
   "key": "D1210le.txt:1300",
   "file": "D1210le.txt",
   "line": 1300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉の鞭が腹を突き破り、襲いかかってくる。",
   "ko_candidate": "살로 된 채찍이 배를 뚫고 덮쳐온다｡"
  },
  {
   "id": 29514,
   "key": "D1210le.txt:1305",
   "file": "D1210le.txt",
   "line": 1305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白の天使は駈け出した。",
   "ko_candidate": "하얀 천사는 달려나갔다｡"
  },
  {
   "id": 29515,
   "key": "D1210le.txt:1314",
   "file": "D1210le.txt",
   "line": 1314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――私は、罪人だけど。",
   "ko_candidate": "――나는 죄인이지만｡"
  },
  {
   "id": 29516,
   "key": "D1210le.txt:1319",
   "file": "D1210le.txt",
   "line": 1319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "降り注ぐ鎌、鎌、鎌。",
   "ko_candidate": "쏟아지는 낫､ 낫､ 낫｡"
  },
  {
   "id": 29517,
   "key": "D1210le.txt:1320",
   "file": "D1210le.txt",
   "line": 1320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃を、肉の触手を掻い潜り、駈ける。",
   "ko_candidate": "칼날을､ 살로 된 촉수를 헤치고 달린다｡"
  },
  {
   "id": 29518,
   "key": "D1210le.txt:1323",
   "file": "D1210le.txt",
   "line": 1323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――それでもこの子達のために、この街のために、そして",
   "ko_candidate": "――그래도 이 아이들을 위해､ 이 거리를 위해､ 그리고"
  },
  {
   "id": 29519,
   "key": "D1210le.txt:1328",
   "file": "D1210le.txt",
   "line": 1328,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「!?　まだそれほどの動きを！」",
   "ko_candidate": "「!? 아직 그 정도의 움직임을!」"
  },
  {
   "id": 29520,
   "key": "D1210le.txt:1331",
   "file": "D1210le.txt",
   "line": 1331,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――私を愛してくれた九郎ちゃんのために。",
   "ko_candidate": "――나를 사랑해준 쿠로를 위해｡"
  },
  {
   "id": 29521,
   "key": "D1210le.txt:1334",
   "file": "D1210le.txt",
   "line": 1334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "既にティベリウスを、間合いの内に捉えていた。",
   "ko_candidate": "이미 티베리우스를 간격 안에 포착하고 있었다｡"
  },
  {
   "id": 29522,
   "key": "D1210le.txt:1337",
   "file": "D1210le.txt",
   "line": 1337,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームセイバーを抜く。",
   "ko_candidate": "빔 세이버를 뽑는다｡"
  },
  {
   "id": 29523,
   "key": "D1210le.txt:1338",
   "file": "D1210le.txt",
   "line": 1338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームセイバーが疾る。",
   "ko_candidate": "빔 세이버가 질주한다｡"
  },
  {
   "id": 29524,
   "key": "D1210le.txt:1343",
   "file": "D1210le.txt",
   "line": 1343,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬおあああああああ！」",
   "ko_candidate": "「누오아아아아아아아!」"
  },
  {
   "id": 29525,
   "key": "D1210le.txt:1355",
   "file": "D1210le.txt",
   "line": 1355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――私は、真実の『正義の味方』になる！",
   "ko_candidate": "――나는､ 진정한 『정의의 편』이 될 거야!"
  },
  {
   "id": 29526,
   "key": "D1210ru.txt:14",
   "file": "D1210ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マズル・フラッシュ。",
   "ko_candidate": "머즐 플래시｡"
  },
  {
   "id": 29527,
   "key": "D1210ru.txt:15",
   "file": "D1210ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声。",
   "ko_candidate": "총성｡"
  },
  {
   "id": 29528,
   "key": "D1210ru.txt:16",
   "file": "D1210ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕を突き抜ける反動。",
   "ko_candidate": "팔을 관통하는 반동｡"
  },
  {
   "id": 29529,
   "key": "D1210ru.txt:17",
   "file": "D1210ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "浮遊感。",
   "ko_candidate": "부유감｡"
  },
  {
   "id": 29530,
   "key": "D1210ru.txt:21",
   "file": "D1210ru.txt",
   "line": 21,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え？」",
   "ko_candidate": "「엣?」"
  },
  {
   "id": 29531,
   "key": "D1210ru.txt:29",
   "file": "D1210ru.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クトゥグアの反動は瑠璃の躰を浮かび上がらせた。",
   "ko_candidate": "크투가의 반동이 루리의 몸을 떠오르게 했다｡ 회전하는 시야｡"
  },
  {
   "id": 29532,
   "key": "D1210ru.txt:30",
   "file": "D1210ru.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "回転する視界。地面を転がっている事にようやく気付いた。",
   "ko_candidate": "땅바닥을 구르고 있다는 것을 겨우 깨달았다｡"
  },
  {
   "id": 29533,
   "key": "D1210ru.txt:33",
   "file": "D1210ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しばらく転がり続け、壁にぶつかってようやく止まる。",
   "ko_candidate": "한동안 계속 굴러가다가 벽에 부딪혀서야 겨우 멈췄다｡"
  },
  {
   "id": 29534,
   "key": "D1210ru.txt:35",
   "file": "D1210ru.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身があちこち痛むがそんなものには構っていられず、瑠璃は弾丸の行方を必死で確かめようとした。",
   "ko_candidate": "온몸이 여기저기 아프지만､ 그런 것에 신경 쓸 겨를도 없이 루리는 총알의 행방을 필사적으로 확인하려 했다｡"
  },
  {
   "id": 29535,
   "key": "D1210ru.txt:38",
   "file": "D1210ru.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――クラウディウスはどうなった？",
   "ko_candidate": "――클라우디우스는 어떻게 됐지? 소용돌이치는 불꽃의 폭풍｡"
  },
  {
   "id": 29536,
   "key": "D1210ru.txt:54",
   "file": "D1210ru.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "渦巻く炎の嵐。その中心、紅い炎に照らされて紅い血が飛び散った。破壊された右手を押さえ、クラウディウスが蹲っている。",
   "ko_candidate": "그 중심､ 불꽃의 붉은빛에 비추어 피의 붉은색이 튀었다｡ 날아간 오른손에서 솟구치는 선혈｡"
  },
  {
   "id": 29537,
   "key": "D1210ru.txt:68",
   "file": "D1210ru.txt",
   "line": 68,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「覇道瑠璃ィィィィィ――ッ！」",
   "ko_candidate": "손목을 누르며 클라우디우스는 쪼그리고 있다｡ 「하도 루리이이이이이――잇!」"
  }
 ]
}