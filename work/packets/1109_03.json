   "line": 203,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふむ！　了解したのであーる！　エルザ！　手伝えっ！」",
   "ko_candidate": "「흠! 알겠다능! 엘자! 도와줘!」"
  },
  {
