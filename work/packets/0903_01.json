 "items": [
  {
   "id": 18518,
   "key": "D0903al.txt:382",
   "file": "D0903al.txt",
   "line": 382,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何でもありません。最近、感情的になりやすくて。 アルも気持ちが昂ぶっていたのでしょう。すみません……」 「うーん……まあ、良いか」",
   "ko_candidate": "――때가 찼다｡"
  },
  {
   "id": 18519,
   "key": "D0903al.txt:390",
   "file": "D0903al.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それ以上の追求をやめて、治療に専念する。 途中、背中で",
   "ko_candidate": "『블랙로지』에게､ 그 말의 의미하는 바는 하나｡"
  },
  {
   "id": 18520,
   "key": "D0903al.txt:396",
   "file": "D0903al.txt",
   "line": 396,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……それはこっちの台詞だ…… 妾は所詮、ヒトではないから……」 アルの呟きを聴いた気がするが、やっぱり言葉までは聞き取れなかった。",
   "ko_candidate": "「자､ 각성이다――」"
  },
  {
   "id": 18521,
   "key": "D0903al.txt:402",
   "file": "D0903al.txt",
   "line": 402,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "なんとも微妙な静寂が、部屋を支配する。 「……良し。これで終わりっと」",
   "ko_candidate": "13번 봉쇄구역｡"
  },
  {
   "id": 18522,
   "key": "D0903al.txt:410",
   "file": "D0903al.txt",
   "line": 410,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ……ありがとうございます」 ソファから身を起こして、恭しく頭を下げる姫さん。",
   "ko_candidate": "『야케노』｡"
  },
  {
   "id": 18523,
   "key": "D0903al.txt:415",
   "file": "D0903al.txt",
   "line": 415,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何だかくすぐったい。 「いや、何だ。女の人なんだから、顔には気をつけないとな。 次、アル。傷を見せろ」",
   "ko_candidate": "마력로의 폭주로 인해 심각한 주술적 오염에 휩싸인 폐기구역｡"
  },
  {
   "id": 18524,
   "key": "D0903al.txt:425",
   "file": "D0903al.txt",
   "line": 425,
   "speaker": "アル / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「必要ない」 「なに拗ねてんだ、お前……良いから、見せろって」",
   "ko_candidate": "어떤 생명체도 존재할 수 없는､ 초고밀도의 원념과 주념이 소용돌이치는 죽은 세계｡"
  },
  {
   "id": 18525,
   "key": "D0903al.txt:435",
   "file": "D0903al.txt",
   "line": 435,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だから止めろと……だいたい、 この程度のは術で……んっ？」 駄々をこねるアルの動きが止まった。",
   "ko_candidate": "하지만 얼마나 무서운 일인가､ 일반인이라면 대기에 닿기만 해도 썩어 떨어져 죽음에 이르는 지옥의 한가운데에 우두커니 서 있는 인영이 있다｡"
  },
  {
   "id": 18526,
   "key": "D0903al.txt:442",
   "file": "D0903al.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どうしたのかと訝るより早く、俺も異変に気づく。 ２人同時に止まって押し黙るのを、妙に思った姫さんが訊ねてきた。",
   "ko_candidate": "13번 구역의 북부｡"
  },
  {
   "id": 18527,
   "key": "D0903al.txt:449",
   "file": "D0903al.txt",
   "line": 449,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの……どうかなされました？」 「何か……少し揺れてないか？」",
   "ko_candidate": "폐허가 된 빌딩의 옥상｡"
  },
  {
   "id": 18528,
   "key": "D0903al.txt:459",
   "file": "D0903al.txt",
   "line": 459,
   "speaker": "瑠璃 / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？　えーと、地震ですか？」 「それに、これは……魔力の気配。 それも広範囲に渡る……」",
   "ko_candidate": "밤하늘을 올려다보는 아우구스투스의 모습이 있다｡"
  },
  {
   "id": 18529,
   "key": "D0903al.txt:469",
   "file": "D0903al.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "トクンッ。 心臓が一度だけ高鳴った。",
   "ko_candidate": "「――시간이군｡ 그럼 여러분､ 시작하도록 하지」"
  },
  {
   "id": 18530,
   "key": "D0903al.txt:472",
   "file": "D0903al.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼けるみたいに、熱いものが胸に広がってゆく。",
   "ko_candidate": "누구에게랄 것도 없이 선언하고､ 오른손바닥을 들어올린다｡"
  },
  {
   "id": 18531,
   "key": "D0903al.txt:473",
   "file": "D0903al.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは何か不吉な予感を伴って、俺の全身に力を送る。 これから起こる何かに対して、躰が自然に身構えている？",
   "ko_candidate": "어둠을 가르며､ 황금빛 빛이 폭발했다｡"
  },
  {
   "id": 18532,
   "key": "D0903al.txt:476",
   "file": "D0903al.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そのことに気づいた、まさに瞬間だった。 強大な……強大過ぎる気配が迫る……いや、アーカムシティを覆っていく！",
   "ko_candidate": "섬광이 가라앉자､ 아우구스투스의 손 안에는 황금빛으로 은은하게 빛나는 1권의 마도서가 들려 있었다｡"
  },
  {
   "id": 18533,
   "key": "D0903al.txt:487",
   "file": "D0903al.txt",
   "line": 487,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なっ……!?　これは……っ！」",
   "ko_candidate": "「나의 마도서 『황금가지』!」"
  },
  {
   "id": 18534,
   "key": "D0903al.txt:513",
   "file": "D0903al.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "１３番封鎖区画。",
   "ko_candidate": "13번 구역 북동부｡"
  },
  {
   "id": 18535,
   "key": "D0903al.txt:514",
   "file": "D0903al.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "通称『第２焼野』。 試作型だった食神臓炉の暴走によって、深刻な呪的汚染に見舞われた廃棄区画。",
   "ko_candidate": "썩은 냄새가 감도는 어둠이 가득한､ 미로처럼 얽힌 골목의 그림자｡"
  },
  {
   "id": 18536,
   "key": "D0903al.txt:519",
   "file": "D0903al.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾重もの結界によって物理的にも心霊的にも隔離された区画だ。",
   "ko_candidate": "티베리우스가 부패한 몸을 얽히며､ 화려한 차림의 여자를 범하고 있다｡"
  },
  {
   "id": 18537,
   "key": "D0903al.txt:522",
   "file": "D0903al.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "如何なる生命も存在できない、超高密度の怨念呪念が渦巻く死せる世界。 だが何と恐るべき事か、一般人ならば大気に触れただけで腐れ落ち、死に到る地獄の只中に佇む人影がある。",
   "ko_candidate": "여자의 눈동자에 생기는 없다｡ 팔은 힘없이 축 늘어져 있다｡"
  },
  {
   "id": 18538,
   "key": "D0903al.txt:535",
   "file": "D0903al.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "１３番区画の北部。 廃墟と化したビルの屋上に、夜空を見上げるアウグストゥスの姿があった。",
   "ko_candidate": "입술에서는 피가 흘러내리고､ 벌어진 가슴 위로 수십 마리의 구더기가 기어다니고 있었다｡"
  },
  {
   "id": 18539,
   "key": "D0903al.txt:541",
   "file": "D0903al.txt",
   "line": 541,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――時間だな。 では諸君、始めるとしよう」 何処の誰にとも知れず宣言して、右掌をかざす。",
   "ko_candidate": "이미 몇 번이나 사정을 반복하며､ 티베리우스가 투덜거린다｡"
  },
  {
   "id": 18540,
   "key": "D0903al.txt:560",
   "file": "D0903al.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇夜を裂いて、金色の光が爆裂した。 光の正体は魔導書。一冊の古びた本が、アウグストゥスの手の中にある。",
   "ko_candidate": "「……정말이지､ <RUBY text=\"그랜드 마스터\">대도사</RUBY>님이 이런 일을 명하다니｡ 덕분에 파티에 참가할 수 없었잖아､ 정말」"
  },
  {
   "id": 18541,
   "key": "D0903al.txt:567",
   "file": "D0903al.txt",
   "line": 567,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「我が魔導書『金枝篇』！」 １３番区画北東部。",
   "ko_candidate": "연결된 채로､ 티베리우스가 주문을 외운다｡"
  },
  {
   "id": 18542,
   "key": "D0903al.txt:579",
   "file": "D0903al.txt",
   "line": 579,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腐臭漂う闇黒がわだかまる、迷路のように入り組んだ路地の影。 ティベリウスが腐敗した躰を、ぐったりと動かない女に絡ませている。",
   "ko_candidate": "――벌레!"
  },
  {
   "id": 18543,
   "key": "D0903al.txt:584",
   "file": "D0903al.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "女の瞳に生気は無い。",
   "ko_candidate": "――충!"
  },
  {
   "id": 18544,
   "key": "D0903al.txt:585",
   "file": "D0903al.txt",
   "line": 585,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腕は力なく垂れ下がっている。 唇からは血が零れ、はだけた胸の上を何十匹もの蛆が這っている。",
   "ko_candidate": "――요충!"
  },
  {
   "id": 18545,
   "key": "D0903al.txt:591",
   "file": "D0903al.txt",
   "line": 591,
   "speaker": "ティベリウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "女の肌に腐汁滴る舌を這わせ、ティベリウスはぼやいていた。 「……ったく、大導師様ったらこんな仕事を命じるなんて。お陰でパーティに参加出来なかったじゃないの、もうっ」",
   "ko_candidate": "여자의 두개골이､ 호박처럼 갈라진다｡"
  },
  {
   "id": 18546,
   "key": "D0903al.txt:602",
   "file": "D0903al.txt",
   "line": 602,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "躰を絡ませたまま、ティベリウスが呪文を唱える。",
   "ko_candidate": "피와 뇌장과 함께､ 주변 일대를 검게 물들일 정도의 파리 떼가"
  },
  {
   "id": 18547,
   "key": "D0903al.txt:611",
   "file": "D0903al.txt",
   "line": 611,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――虫！ ――蟲！ ――妖蛆！」 ほおずきのように裂ける。鮮血と共に、辺り一帯を黒く染め上げるほどの蝿の群れが噴き出す。",
   "ko_candidate": "뿜어져 나온다｡"
  },
  {
   "id": 18548,
   "key": "D0903al.txt:637",
   "file": "D0903al.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それと共に現出した蛆虫まみれの魔導書。",
   "ko_candidate": "그와 함께 나타난 구더기 투성이의 마도서｡"
  },
  {
   "id": 18549,
   "key": "D0903al.txt:643",
   "file": "D0903al.txt",
   "line": 643,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『妖蛆の秘密』――出番よん！」",
   "ko_candidate": "「『벌레의 신비』――출동이야!」"
  },
  {
   "id": 18550,
   "key": "D0903al.txt:658",
   "file": "D0903al.txt",
   "line": 658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "１３番区画南東部。",
   "ko_candidate": "13번 구역 남동부｡"
  },
  {
   "id": 18551,
   "key": "D0903al.txt:659",
   "file": "D0903al.txt",
   "line": 659,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩れたビルの瓦礫の上にカリグラの巨体が在った。",
   "ko_candidate": "무너진 빌딩의 잔해 위에 칼리굴라의 거대한 몸이 있었다｡"
  },
  {
   "id": 18552,
   "key": "D0903al.txt:662",
   "file": "D0903al.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "拳を固める。 腕にこめかみに血管が浮き出るほどに強く強く。",
   "ko_candidate": "주먹을 꽉 쥔다｡ 팔과 관자놀이에 혈관이 튀어나올 정도로 세게 세게｡"
  },
  {
   "id": 18553,
   "key": "D0903al.txt:666",
   "file": "D0903al.txt",
   "line": 666,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがて溜めていたものを全て吐き出すかのように拳を地面に叩きつけた。",
   "ko_candidate": "이윽고 모아두었던 것을 모두 토해내듯이 주먹을 땅에 내리쳤다｡"
  },
  {
   "id": 18554,
   "key": "D0903al.txt:685",
   "file": "D0903al.txt",
   "line": 685,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆砕。",
   "ko_candidate": "폭쇄｡"
  },
  {
   "id": 18555,
   "key": "D0903al.txt:686",
   "file": "D0903al.txt",
   "line": 686,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫は更に細かく砕け、空へと吹き飛んでいく。",
   "ko_candidate": "잔해는 더욱 잘게 부서져､ 하늘로 날아올랐다｡"
  },
  {
   "id": 18556,
   "key": "D0903al.txt:689",
   "file": "D0903al.txt",
   "line": 689,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き飛ぶ瓦礫に混じって１冊の魔導書が鈍い光を放ち、宙に浮いていた。",
   "ko_candidate": "날아오르는 잔해에 섞여 1권의 마도서가 둔탁한 빛을 발하며､ 공중에 떠 있었다｡"
  },
  {
   "id": 18557,
   "key": "D0903al.txt:694",
   "file": "D0903al.txt",
   "line": 694,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「征くゾ！　『水神クタアト』！」 １３番区画南部。",
   "ko_candidate": "「가자! 『수신 크타아트』!」"
  }
 ]
}