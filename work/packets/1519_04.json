 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "旧き印": "옛 인장",
  "リューガ": "류가",
  "ライカ": "라이카"
 },
 "items": [
  {
   "id": 48695,
   "key": "D1519al_b.txt:251",
   "file": "D1519al_b.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この光の向こうに――",
   "ko_candidate": "이 빛의 너머에――"
  },
  {
   "id": 48696,
   "key": "D1519al_b.txt:256",
   "file": "D1519al_b.txt",
   "line": 256,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………？」",
   "ko_candidate": "「…………?」"
  },
  {
   "id": 48697,
   "key": "D1519al_b.txt:261",
   "file": "D1519al_b.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――歌を、聴いた。",
   "ko_candidate": "――노래를､ 들었다｡"
  },
  {
   "id": 48698,
   "key": "D1519al_b.txt:271",
   "file": "D1519al_b.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "祈りが込められた、歌だった。",
   "ko_candidate": "기도가 담긴､ 노래였다｡"
  },
  {
   "id": 48699,
   "key": "D1519al_b.txt:272",
   "file": "D1519al_b.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "願いの託された、歌だった。",
   "ko_candidate": "소원이 맡겨진､ 노래였다｡"
  },
  {
   "id": 48700,
   "key": "D1519al_b.txt:273",
   "file": "D1519al_b.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誓いに絆された、歌だった。",
   "ko_candidate": "맹세로 맺어진､ 노래였다｡"
  },
  {
   "id": 48701,
   "key": "D1519al_b.txt:277",
   "file": "D1519al_b.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あるいは愛の歌の様に",
   "ko_candidate": "혹은 사랑의 노래처럼"
  },
  {
   "id": 48702,
   "key": "D1519al_b.txt:278",
   "file": "D1519al_b.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あるいは凱歌の様に",
   "ko_candidate": "혹은 개선가처럼"
  },
  {
   "id": 48703,
   "key": "D1519al_b.txt:279",
   "file": "D1519al_b.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あるいは子守唄の様に",
   "ko_candidate": "혹은 자장가처럼"
  },
  {
   "id": 48704,
   "key": "D1519al_b.txt:282",
   "file": "D1519al_b.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其れは、戦う誇りに満ちた、歌だった。",
   "ko_candidate": "그것은､ 싸우는 자부심으로 가득 찬､ 노래였다｡"
  },
  {
   "id": 48705,
   "key": "D1519al_b.txt:283",
   "file": "D1519al_b.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其れは、護る優しさに満ちた、歌だった。",
   "ko_candidate": "그것은､ 지키는 부드러움으로 가득 찬､ 노래였다｡"
  },
  {
   "id": 48706,
   "key": "D1519al_b.txt:286",
   "file": "D1519al_b.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "其れは、ただただ生きる喜びに満たされた歌だった。",
   "ko_candidate": "그것은､ 그저､ 살아가는 기쁨으로 가득 찬 노래였다｡ 끊어지지 않는､"
  },
  {
   "id": 48707,
   "key": "D1519al_b.txt:289",
   "file": "D1519al_b.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "途絶えることの無い、",
   "ko_candidate": "지워버릴 수 없는､ 그것은､"
  },
  {
   "id": 48708,
   "key": "D1519al_b.txt:290",
   "file": "D1519al_b.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "消し去ることの出来ない、",
   "ko_candidate": "그것은――생명 찬가였다｡"
  },
  {
   "id": 48709,
   "key": "D1519al_b.txt:291",
   "file": "D1519al_b.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其れは、",
   "ko_candidate": "빛의 너머｡"
  },
  {
   "id": 48710,
   "key": "D1519al_b.txt:294",
   "file": "D1519al_b.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "其れは――生命賛歌だった。",
   "ko_candidate": "노래에 맞춰､ 춤추는 그림자를 본다｡ 소녀 같은 그림자가"
  },
  {
   "id": 48711,
   "key": "D1519al_b.txt:302",
   "file": "D1519al_b.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光の向こう。歌に合わせて舞う影を見る。",
   "ko_candidate": "청년 같은 그림자가 혹은 그 둘 다가"
  },
  {
   "id": 48712,
   "key": "D1519al_b.txt:304",
   "file": "D1519al_b.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女の様な影が、青年の様な影が、あるいはその両方が、姿を変えて。容を変えて。流れを変えて。",
   "ko_candidate": "모습을 바꾸어｡ 용모를 바꾸어｡"
  },
  {
   "id": 48713,
   "key": "D1519al_b.txt:309",
   "file": "D1519al_b.txt",
   "line": 309,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これは――？」",
   "ko_candidate": "흐름을 바꾸어｡ 「이것은――?」"
  },
  {
   "id": 48714,
   "key": "D1519al_b.txt:314",
   "file": "D1519al_b.txt",
   "line": 314,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんな……」",
   "ko_candidate": "「그런……」 춤이 끝났다｡"
  },
  {
   "id": 48715,
   "key": "D1519al_b.txt:320",
   "file": "D1519al_b.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舞が終わった。",
   "ko_candidate": "두 개의 그림자｡"
  },
  {
   "id": 48716,
   "key": "D1519al_b.txt:322",
   "file": "D1519al_b.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "２つの影。男と女の影。光の向こう、光の中心、俺たちに向かって手を伸ばす。",
   "ko_candidate": "남자와 여자의 그림자｡ 빛 너머､ 빛의 중심에서 우리를 향해 손을 뻗는다｡"
  },
  {
   "id": 48717,
   "key": "D1519al_b.txt:331",
   "file": "D1519al_b.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、光に刻まれた印。",
   "ko_candidate": "그리고 빛에 새겨진 문양｡"
  },
  {
   "id": 48718,
   "key": "D1519al_b.txt:332",
   "file": "D1519al_b.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見慣れた印。",
   "ko_candidate": "익숙한 문양｡"
  },
  {
   "id": 48719,
   "key": "D1519al_b.txt:333",
   "file": "D1519al_b.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "五芒星形の印。",
   "ko_candidate": "오망성 형태의 문양｡"
  },
  {
   "id": 48720,
   "key": "D1519al_b.txt:336",
   "file": "D1519al_b.txt",
   "line": 336,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『旧き印』。",
   "ko_candidate": "『엘더 사인』｡"
  },
  {
   "id": 48721,
   "key": "D1519al_b.txt:344",
   "file": "D1519al_b.txt",
   "line": 344,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『旧き印』が解け、魔術文字の線となり、 二重螺旋を描く。",
   "ko_candidate": "『엘더 사인』이 풀리고､ 마술 문자의 선이 되어 이중 나선을 그린다｡"
  },
  {
   "id": 48722,
   "key": "D1519al_b.txt:348",
   "file": "D1519al_b.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は識った。",
   "ko_candidate": "나는 알아차렸다｡"
  },
  {
   "id": 48723,
   "key": "D1519al_b.txt:349",
   "file": "D1519al_b.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "二重螺旋の中央。",
   "ko_candidate": "이중 나선의 중앙｡"
  },
  {
   "id": 48724,
   "key": "D1519al_b.txt:350",
   "file": "D1519al_b.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "強大な存在が紡がれてゆく。",
   "ko_candidate": "강대한 존재가 자아내진다｡ 짜여져간다｡ 용맹하고､"
  },
  {
   "id": 48725,
   "key": "D1519al_b.txt:351",
   "file": "D1519al_b.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "編まれてゆく。",
   "ko_candidate": "정밀하고､ 강인하고､"
  },
  {
   "id": 48726,
   "key": "D1519al_b.txt:354",
   "file": "D1519al_b.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "勇壮で、精密で、強靭で、何より美しい存在が――",
   "ko_candidate": "무엇보다 아름다운 존재가､ 압도적인 기척의 폭발과 함께 현현한다｡"
  },
  {
   "id": 48727,
   "key": "D1519al_b.txt:363",
   "file": "D1519al_b.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "圧倒的な気配の爆裂と共に顕現する。爆誕する。",
   "ko_candidate": "폭발적으로 탄생한다｡ 그 존재를 목격하고､"
  },
  {
   "id": 48728,
   "key": "D1519al_b.txt:366",
   "file": "D1519al_b.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その存在を目の当たりにして、誕生の過程を総て見届けて、俺たちは想った。",
   "ko_candidate": "탄생의 과정을 모두 지켜보며､ 우리는 생각했다｡"
  },
  {
   "id": 48729,
   "key": "D1519al_b.txt:377",
   "file": "D1519al_b.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――神？",
   "ko_candidate": "――신?"
  },
  {
   "id": 48730,
   "key": "D1519al_b.txt:390",
   "file": "D1519al_b.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "では次に――御伽噺をしよう。",
   "ko_candidate": "그럼 다음은――동화이야기를 하자｡"
  },
  {
   "id": 48731,
   "key": "D1519le.txt:6",
   "file": "D1519le.txt",
   "line": 6,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガの放った拳はおそらくその生涯において、最速にして最強の一撃だったに違いない。",
   "ko_candidate": "류가가 날린 주먹은 아마도 그의 일생에서 가장 빠르고 강력한 일격이었을 것이다｡"
  },
  {
   "id": 48732,
   "key": "D1519le.txt:8",
   "file": "D1519le.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、ライカさんの疾る二刀の光刃は、それよりも僅かに迅かった。",
   "ko_candidate": "다만､ 라이카 씨의 질주하는 두 자루 빛의 칼날은 그보다 약간 더 빨랐다｡"
  },
  {
   "id": 48733,
   "key": "D1519le.txt:10",
   "file": "D1519le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝負の決したのは、その紙一重の差に過ぎなかった。",
   "ko_candidate": "승부가 갈린 것은 그 종이 한 장 차이에 불과했다｡"
  },
  {
   "id": 48734,
   "key": "D1519le.txt:12",
   "file": "D1519le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もライカさんも、塵になるリューガを最後まで見守っていた。",
   "ko_candidate": "나도 라이카 씨도 먼지가 되어가는 류가를 마지막까지 지켜보고 있었다｡"
  }
 ]
}