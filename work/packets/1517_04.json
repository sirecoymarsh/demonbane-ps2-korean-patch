{
 "packet": "1517_04",
 "scene": "1517",
 "anchor": {
  "hit": 17,
  "total": 19,
  "rate": 0.895
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リューガ": "류가",
  "ライカ": "라이카"
 },
 "items": [
  {
   "id": 48220,
   "key": "D1517le.txt:190",
   "file": "D1517le.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "驚いたような、困ったような、ひたすらに無防備な瞳をさらけ出す。",
   "ko_candidate": "놀란 듯､ 곤란한 듯､ 오로지 무방비한 눈동자를 드러낸다｡"
  },
  {
   "id": 48221,
   "key": "D1517le.txt:191",
   "file": "D1517le.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠い昔の、少年の瞳をさらけ出す。",
   "ko_candidate": "먼 옛날의 소년의 눈동자를 드러낸다｡"
  },
  {
   "id": 48222,
   "key": "D1517le.txt:193",
   "file": "D1517le.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "答えずに、瞳を閉じた。",
   "ko_candidate": "대답하지 않고 눈을 감았다｡"
  },
  {
   "id": 48223,
   "key": "D1517le.txt:194",
   "file": "D1517le.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ沈黙が、世界の黄昏を支配していた。",
   "ko_candidate": "그저 침묵만이 세계의 황혼을 지배하고 있었다｡"
  },
  {
   "id": 48224,
   "key": "D1517le.txt:195",
   "file": "D1517le.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傷が――自らの手で刻んだ、彼を殺した時のあの傷が、血を滲ませる。",
   "ko_candidate": "상처가――자신의 손으로 새긴､ 그를 죽였을 때의 그 상처가"
  },
  {
   "id": 48225,
   "key": "D1517le.txt:197",
   "file": "D1517le.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一筋の血が伝う。",
   "ko_candidate": "피를 배어나오게 한다｡"
  },
  {
   "id": 48226,
   "key": "D1517le.txt:199",
   "file": "D1517le.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その紅い涙が、リューガの最後の『少年』だったのだろうか。",
   "ko_candidate": "한 줄기 피가 흘러내린다｡ 그 붉은 눈물이 류가의 마지막 『소년』이었던 걸까｡"
  },
  {
   "id": 48227,
   "key": "D1517le.txt:200",
   "file": "D1517le.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再び開かれた瞳は、再び狂気に沈み――",
   "ko_candidate": "다시 뜨인 눈동자는 다시 광기에 빠져――"
  },
  {
   "id": 48228,
   "key": "D1517le.txt:200",
   "file": "D1517le.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが、何処までも清浄な輝きを秘めていた。",
   "ko_candidate": "하지만 어디까지나 청정한 빛을 감추고 있었다｡"
  },
  {
   "id": 48229,
   "key": "D1517le.txt:202",
   "file": "D1517le.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "澄んだ狂気が告げた。",
   "ko_candidate": "맑은 광기가 고했다｡"
  },
  {
   "id": 48230,
   "key": "D1517le.txt:206",
   "file": "D1517le.txt",
   "line": 206,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「己はきっと、ライカ以外の世界を、知らなかった」",
   "ko_candidate": "「나는 분명 라이카 외의 세계를 알지 못했다」"
  },
  {
   "id": 48231,
   "key": "D1517le.txt:210",
   "file": "D1517le.txt",
   "line": 210,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 48232,
   "key": "D1517le.txt:214",
   "file": "D1517le.txt",
   "line": 214,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「知る必要もなかった。 知りたくもなかった」 「そうだ。己は誰よりも未知に怯えていたんだ……だけど、そんな事すら知らずに済ませてきた」",
   "ko_candidate": "「알 필요도 없었다｡ 알고 싶지도 않았다｡ 그래｡ 나는 누구보다도 미지의 것을 두려워하고 있었어… 하지만､ 그런 것조차 모르고 지내왔다」"
  },
  {
   "id": 48233,
   "key": "D1517le.txt:221",
   "file": "D1517le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガを強い子だと思っていたのは、そんな彼を知らなかったからだ。",
   "ko_candidate": "류가를 강한 아이라고 생각했던 건､ 그런 그를 몰랐기 때문이다｡"
  },
  {
   "id": 48234,
   "key": "D1517le.txt:223",
   "file": "D1517le.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガは自らを狭い世界に閉じ込める事で、総ての恐怖から逃れていた。",
   "ko_candidate": "류가는 스스로를 좁은 세계에 가두는 것으로､ 모든 공포로부터 도망치고 있었다｡"
  },
  {
   "id": 48235,
   "key": "D1517le.txt:225",
   "file": "D1517le.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただ、それだけの事に過ぎなかった。",
   "ko_candidate": "단지､ 그뿐이었다｡"
  },
  {
   "id": 48236,
   "key": "D1517le.txt:229",
   "file": "D1517le.txt",
   "line": 229,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だから、姉さん。あんたが己にとって未知の存在になった時――己は為す術が無かった。畏れて怯えて泣いて憎んで――最後に辿り着いた答えが、壊す事だった」 「己は、それしか知らなかったから」",
   "ko_candidate": "「그래서､ 누나｡ 당신이 나에게 미지의 존재가 되었을 때――나는 어찌할 바를 몰랐다｡ 두려워하고 겁먹고 울고 미워하고――마지막에 도달한 답이､ 파괴하는 것이었다｡ 나는､ 그것밖에 몰랐으니까」"
  },
  {
   "id": 48237,
   "key": "D1517le.txt:235",
   "file": "D1517le.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かに、リューガは身構えた。",
   "ko_candidate": "조용히､ 류가는 자세를 잡았다｡"
  },
  {
   "id": 48238,
   "key": "D1517le.txt:236",
   "file": "D1517le.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あれほど烈しかった殺意も、今は無い。",
   "ko_candidate": "그토록 격렬했던 살의도､ 지금은 없다｡"
  },
  {
   "id": 48239,
   "key": "D1517le.txt:238",
   "file": "D1517le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ透明な狂気だけが其処に在る。",
   "ko_candidate": "단지 투명한 광기만이 그곳에 있다｡"
  },
  {
   "id": 48240,
   "key": "D1517le.txt:239",
   "file": "D1517le.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰にも気付かせなかった、凪の様な狂気だけが凍結している。",
   "ko_candidate": "누구도 눈치채지 못했던､ 잔잔한 바다와 같은 광기만이 얼어붙어 있다｡"
  },
  {
   "id": 48241,
   "key": "D1517le.txt:241",
   "file": "D1517le.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガの口許が、嗜虐に、自虐に、歪んだ。",
   "ko_candidate": "류가의 입가가､ 가학적으로､ 자학적으로､ 일그러졌다｡"
  },
  {
   "id": 48242,
   "key": "D1517le.txt:242",
   "file": "D1517le.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そっと、告げる。",
   "ko_candidate": "살며시､ 고한다｡"
  },
  {
   "id": 48243,
   "key": "D1517le.txt:246",
   "file": "D1517le.txt",
   "line": 246,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカ姉さん。これが貴方が 知らなかった、貴方が見なかった、己の狂気だ」",
   "ko_candidate": "「라이카 누나｡ 이것이 당신이 몰랐던､ 당신이 보지 않았던､ 나의 광기야」"
  },
  {
   "id": 48244,
   "key": "D1517le.txt:251",
   "file": "D1517le.txt",
   "line": 251,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……リューガ」",
   "ko_candidate": "「……류가」"
  },
  {
   "id": 48245,
   "key": "D1517le.txt:255",
   "file": "D1517le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカもまた身構える。",
   "ko_candidate": "라이카 역시 자세를 잡는다｡"
  },
  {
   "id": 48246,
   "key": "D1517le.txt:256",
   "file": "D1517le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両掌に光の刃が、二刀、煌いた。",
   "ko_candidate": "양 손바닥에 빛의 칼이､ 두 자루､ 번쩍였다｡"
  },
  {
   "id": 48247,
   "key": "D1517le.txt:258",
   "file": "D1517le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "きっと今この瞬間まで、先送りにしていた決断。",
   "ko_candidate": "분명 지금 이 순간까지､ 미뤄왔던 결단｡"
  },
  {
   "id": 48248,
   "key": "D1517le.txt:259",
   "file": "D1517le.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らを縛っていた迷い。",
   "ko_candidate": "스스로를 묶고 있던 망설임｡"
  },
  {
   "id": 48249,
   "key": "D1517le.txt:260",
   "file": "D1517le.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ようやく今、覚悟が決まった。",
   "ko_candidate": "드디어 지금､ 각오가 섰다｡"
  },
  {
   "id": 48250,
   "key": "D1517le.txt:266",
   "file": "D1517le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なのに――その瞳には、ただ虚ろな哀しみがある。",
   "ko_candidate": "그런데――그 눈에는､ 단지 공허한 슬픔만이 있다｡"
  },
  {
   "id": 48251,
   "key": "D1517le.txt:267",
   "file": "D1517le.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疲弊した、哀しみがある。",
   "ko_candidate": "지친､ 슬픔이 있다｡"
  },
  {
   "id": 48252,
   "key": "D1517le.txt:269",
   "file": "D1517le.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "二つの無知が在った。",
   "ko_candidate": "두 개의 무지가 있었다｡"
  },
  {
   "id": 48253,
   "key": "D1517le.txt:270",
   "file": "D1517le.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "臆病な無知。",
   "ko_candidate": "소심한 무지｡"
  },
  {
   "id": 48254,
   "key": "D1517le.txt:270",
   "file": "D1517le.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傲慢な無知。",
   "ko_candidate": "오만한 무지｡"
  },
  {
   "id": 48255,
   "key": "D1517le.txt:272",
   "file": "D1517le.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お互い震える躰を抱き合いながら、だが心は致命的に隔たっていた。",
   "ko_candidate": "서로 떨리는 몸을 끌어안으면서도､ 하지만 마음은 치명적으로 멀어져 있었다｡"
  },
  {
   "id": 48256,
   "key": "D1517le.txt:273",
   "file": "D1517le.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "致命的な無知が、致命的な罪を紡ぐ。",
   "ko_candidate": "치명적인 무지가､ 치명적인 죄를 자아낸다｡"
  },
  {
   "id": 48257,
   "key": "D1517le.txt:274",
   "file": "D1517le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去が流血する。",
   "ko_candidate": "과거가 피를 흘린다｡"
  },
  {
   "id": 48258,
   "key": "D1517le.txt:276",
   "file": "D1517le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう――戻れない。",
   "ko_candidate": "이제――돌아갈 수 없다｡"
  },
  {
   "id": 48259,
   "key": "D1517le.txt:282",
   "file": "D1517le.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空を求めた２人の天使。",
   "ko_candidate": "하늘을 바랐던 두 명의 천사｡"
  }
 ]
}