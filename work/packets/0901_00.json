 },
 "items": [
  {
   "id": 17761,
   "key": "D0901al.txt:48",
   "file": "D0901al.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――守れなかった。",
   "ko_candidate": "――지키지 못했다｡"
  },
  {
   "id": 17762,
   "key": "D0901al.txt:99",
   "file": "D0901al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は――無力だ。",
   "ko_candidate": "나는―― 무력하다｡"
  },
  {
   "id": 17763,
   "key": "D0901al.txt:153",
   "file": "D0901al.txt",
   "line": 153,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふむ、大した銃だなこれは。 鬼械神と同じ魔術理論を以てして造られておる」 「バルザイの偃月刀と同様に儀式の媒介として機能するうえに、この弾丸――」",
   "ko_candidate": "「흠､ 대단한 총이군 이건｡ 데우스 마키나와 같은 마술 이론으로 만들어졌어｡ 바르자이의 언월도와 마찬가지로 의식의 매개체로 기능할 뿐만 아니라､ 이 탄환――」"
  },
  {
   "id": 17764,
   "key": "D0901al.txt:166",
   "file": "D0901al.txt",
   "line": 166,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『クトゥグア』のマガジンから弾丸をひとつ抜き取る。片目をつむり、弾丸の細かいところまで観察。",
   "ko_candidate": "알은 『크투가』의 매거진에서 탄환 하나를 꺼냈다｡ 한쪽 눈을 감고 탄환의 세세한 부분까지 관찰한다｡"
  },
  {
   "id": 17765,
   "key": "D0901al.txt:167",
   "file": "D0901al.txt",
   "line": 167,
   "speaker": "アル",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "刻まれた魔術文字を見つける。 「ふん、手の込んだことだ。弾丸の一つ一つに洗礼を施してある」",
   "ko_candidate": "「흥､ 공들인 짓이군｡ 탄환 하나하나에 세례를 베풀었어｡ 『The minions of Cthugha』인가… 마력을 주입하면 폭렬탄도 되겠군」"
  },
  {
   "id": 17766,
   "key": "D0901al.txt:183",
   "file": "D0901al.txt",
   "line": 183,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『Ｔｈｅ　Ｍｉｎｉｏｎｓ ｏｆ　Ｃｔｈｕｇｈａ』か。 魔力を注ぎ込めば、 爆裂弾にもなるな」 今度は薬莢を取り外し、机の上に火薬をばらまく。",
   "ko_candidate": "이번엔 탄피를 분리해 책상 위에 화약을 뿌린다｡"
  },
  {
   "id": 17767,
   "key": "D0901al.txt:194",
   "file": "D0901al.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火薬を指ですくい、匂いを確かめる。",
   "ko_candidate": "화약을 손가락으로 집어 냄새를 확인한다｡"
  },
  {
   "id": 17768,
   "key": "D0901al.txt:202",
   "file": "D0901al.txt",
   "line": 202,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やはりな。火薬に『イブン・ガズイの粉薬』を混ぜておる」 「この粉薬はな、霊的存在の物質化を促す霊薬だ。弾丸それ自体に魔術的効果をもたらせている訳だな」",
   "ko_candidate": "「역시나｡ 화약에 『이븐 가지의 분말』을 섞었어｡ 이 분말은 말이지､ 영적 존재의 물질화를 촉진하는 영약이야｡ 탄환 그 자체에 마술적 효과를 부여한 거지」"
  },
  {
   "id": 17769,
   "key": "D0901al.txt:229",
   "file": "D0901al.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎の反応は無い。 窓の外をぼんやりと眺めている。",
   "ko_candidate": "말을 걸고 있는 쿠로의 반응은 전혀 없다｡"
  },
  {
   "id": 17770,
   "key": "D0901al.txt:232",
   "file": "D0901al.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だがその瞳は何も映してはいない。",
   "ko_candidate": "창문 틀에 걸터앉아 밤거리를 멍하니 바라보고 있을 뿐이다｡"
  },
  {
   "id": 17771,
   "key": "D0901al.txt:233",
   "file": "D0901al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そこにはただ、凍った虚無が在るのみ。",
   "ko_candidate": "상관않고 알은 계속한다｡"
  },
  {
   "id": 17772,
   "key": "D0901al.txt:236",
   "file": "D0901al.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれでもアルは、構わず続ける。",
   "ko_candidate": "이번엔 『이타콰』의 빈 탄피를 집어 관찰한다｡"
  },
  {
   "id": 17773,
   "key": "D0901al.txt:241",
   "file": "D0901al.txt",
   "line": 241,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こっちもだ。 『Ｗｅｎｄｉｇｏ ｔｈｅ　Ｂｌａｃｋｗｏｏｄ』」 「以前見た通り、こっちは自動追尾弾となっておる。敵を捕らえるまで追い続け、急所を仕留める」",
   "ko_candidate": "「이쪽도 마찬가지야｡ 『Wendigo the Blackwood』｡ 전에 본 대로 이쪽은 자동 추적탄이 되어 있어｡ 적을 포착할 때까지 쫓아가 급소를 명중시킨다」"
  },
  {
   "id": 17774,
   "key": "D0901al.txt:266",
   "file": "D0901al.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "言ってクトゥグアのマガジンと、イタクァの弾丸が装填されたスピードローダーを机の上に置く。",
   "ko_candidate": "말하고는 크투가의 매거진과 이타콰의 탄환이 장전된 스피드로더를 책상 위에 올려놓았다｡"
  },
  {
   "id": 17775,
   "key": "D0901al.txt:268",
   "file": "D0901al.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎は振り向きもしない。 アルは得意げに笑う。",
   "ko_candidate": "쿠로는 돌아보지도 않는다｡ 알은 득의양양하게 웃었다｡"
  },
  {
   "id": 17776,
   "key": "D0901al.txt:274",
   "file": "D0901al.txt",
   "line": 274,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「原料さえあれば同じものは造れる。覇道の小娘にでも頼んで調達してもらう事だ」",
   "ko_candidate": "「원료만 있다면 똑같은 걸 만들 수 있어｡ 하도의 계집애한테도 부탁해서 조달해달라고 하지」"
  },
  {
   "id": 17777,
   "key": "D0901al.txt:279",
   "file": "D0901al.txt",
   "line": 279,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………………………」",
   "ko_candidate": "「…………………………」 공기가 무겁다｡"
  },
  {
   "id": 17778,
   "key": "D0901al.txt:284",
   "file": "D0901al.txt",
   "line": 284,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これでクトゥグアの制御はおろかイタクァすら操る術を手に入れた。これを使わぬ手はないだろう」",
   "ko_candidate": "어색한 듯 얼굴을 찌푸리면서도 그래도 알은 대화를 이어간다｡ 「이걸로 크투가의 제어는 물론､ 이타콰조차 다루는 술법을 손에 넣었어｡ 이걸 쓰지 않을 이유가 없잖아」"
  },
  {
   "id": 17779,
   "key": "D0901al.txt:289",
   "file": "D0901al.txt",
   "line": 289,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………………………」",
   "ko_candidate": "「…………………………」"
  },
  {
   "id": 17780,
   "key": "D0901al.txt:294",
   "file": "D0901al.txt",
   "line": 294,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふっ。我等が手にしたのだから、即ちこの銃は我等の物と云う事だ」 「遠慮は要らぬ。 せいぜい利用させてもらおう」",
   "ko_candidate": "「흥､ 우리가 손에 넣은 거니까 즉 이 총은 우리 것이란 말이야｡ 사양은 필요 없어｡ 실컷 이용해 주자고」"
  },
  {
   "id": 17781,
   "key": "D0901al.txt:303",
   "file": "D0901al.txt",
   "line": 303,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 17782,
   "key": "D0901al.txt:308",
   "file": "D0901al.txt",
   "line": 308,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 17783,
   "key": "D0901al.txt:313",
   "file": "D0901al.txt",
   "line": 313,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 17784,
   "key": "D0901al.txt:318",
   "file": "D0901al.txt",
   "line": 318,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……九郎」",
   "ko_candidate": "「………………쿠로」"
  },
  {
   "id": 17785,
   "key": "D0901al.txt:330",
   "file": "D0901al.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ついにアルは押し黙ってしまった。",
   "ko_candidate": "침묵의 무게에 알은 마침내 입을 다물어 버렸다｡"
  },
  {
   "id": 17786,
   "key": "D0901al.txt:331",
   "file": "D0901al.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人分の沈黙が、狭い事務所に圧しかかる。",
   "ko_candidate": "두 사람 몫의 침묵이 좁은 사무실에 짓누른다｡"
  },
  {
   "id": 17787,
   "key": "D0901al.txt:332",
   "file": "D0901al.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歯痒くも、時間だけが過ぎていく。",
   "ko_candidate": "안타깝게도 시간만이 흘러간다｡"
  },
  {
   "id": 17788,
   "key": "D0901al.txt:341",
   "file": "D0901al.txt",
   "line": 341,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………っ」",
   "ko_candidate": "「…………읏」"
  },
  {
   "id": 17789,
   "key": "D0901al.txt:347",
   "file": "D0901al.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸をじわりじわりと締めつける、痛みがあった。",
   "ko_candidate": "가슴을 서서히 조여오는 통증이 있었다｡"
  },
  {
   "id": 17790,
   "key": "D0901al.txt:348",
   "file": "D0901al.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重い空気に実際、息苦しさを感じる。",
   "ko_candidate": "무거운 공기에 실제로 숨 막힘을 느낀다｡"
  },
  {
   "id": 17791,
   "key": "D0901al.txt:349",
   "file": "D0901al.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "居心地が悪い。",
   "ko_candidate": "거북하다｡"
  },
  {
   "id": 17792,
   "key": "D0901al.txt:353",
   "file": "D0901al.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "よもやこの棲家で、九郎の傍で、こんな不快な想いを抱く羽目になろうとは。",
   "ko_candidate": "하필이면 이곳에서､ 쿠로의 곁에서 이런 불쾌한 감정을 품게 될 되려고 하다니｡"
  },
  {
   "id": 17793,
   "key": "D0901al.txt:357",
   "file": "D0901al.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――否、それを云うならば。",
   "ko_candidate": "――아니､ 그렇게 말하자면｡"
  },
  {
   "id": 17794,
   "key": "D0901al.txt:360",
   "file": "D0901al.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今まで此処に感じていた「心地好い」と云う感情。",
   "ko_candidate": "지금까지 여기서 느꼈던 '기분 좋다'는 감정｡"
  },
  {
   "id": 17795,
   "key": "D0901al.txt:361",
   "file": "D0901al.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それ自体がイレギュラーな感情なのだ。",
   "ko_candidate": "그 자체가 비정상적인 감정인 거야｡"
  },
  {
   "id": 17796,
   "key": "D0901al.txt:364",
   "file": "D0901al.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "千年を超える悠久を、ただ邪悪との闘争のみで駈け抜けた己にとっては。",
   "ko_candidate": "천 년을 넘는 유구한 세월을､ 오직 투쟁과 사악함과 광기로만 달려온 나에게는｡"
  },
  {
   "id": 17797,
   "key": "D0901al.txt:373",
   "file": "D0901al.txt",
   "line": 373,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「く……っ」",
   "ko_candidate": "「크… 윽」"
  },
  {
   "id": 17798,
   "key": "D0901al.txt:379",
   "file": "D0901al.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心が、苦しい。",
   "ko_candidate": "마음이 괴롭다｡"
  },
  {
   "id": 17799,
   "key": "D0901al.txt:380",
   "file": "D0901al.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな想いは、千年の中で、初めての事だ。",
   "ko_candidate": "이런 감정은 천 년 동안 처음이다｡"
  },
  {
   "id": 17800,
   "key": "D0901al.txt:383",
   "file": "D0901al.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女には判らない。",
   "ko_candidate": "그래서――그녀는 모른다｡"
  }
 ]
}