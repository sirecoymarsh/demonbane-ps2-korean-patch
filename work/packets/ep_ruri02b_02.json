 },
 "items": [
  {
   "id": 51001,
   "key": "ep_ruri02b.txt:286",
   "file": "ep_ruri02b.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "冷たく、鋭く、心臓を貫く。",
   "ko_candidate": "차갑고 날카롭게 심장을 꿰뚫는다｡"
  },
  {
   "id": 51002,
   "key": "ep_ruri02b.txt:288",
   "file": "ep_ruri02b.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスは動かない。",
   "ko_candidate": "리베르 레기스는 움직이지 않는다｡"
  },
  {
   "id": 51003,
   "key": "ep_ruri02b.txt:289",
   "file": "ep_ruri02b.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "未だ動かない。",
   "ko_candidate": "아직도 움직이지 않는다｡"
  },
  {
   "id": 51004,
   "key": "ep_ruri02b.txt:291",
   "file": "ep_ruri02b.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "静かに――ただ緊張だけが高まってゆく。",
   "ko_candidate": "조용히―― 단지 긴장감만이 고조되어 간다｡"
  },
  {
   "id": 51005,
   "key": "ep_ruri02b.txt:292",
   "file": "ep_ruri02b.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "呼吸すらも憚られるほどの緊迫感の中、",
   "ko_candidate": "숨조차 쉬기 어려울 정도의 긴박감 속에서､"
  },
  {
   "id": 51006,
   "key": "ep_ruri02b.txt:292",
   "file": "ep_ruri02b.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが。",
   "ko_candidate": "하지만｡"
  },
  {
   "id": 51007,
   "key": "ep_ruri02b.txt:296",
   "file": "ep_ruri02b.txt",
   "line": 296,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………ははっ。ははははっ。 はははははははは……ッ！」",
   "ko_candidate": "「…………하하｡ 하하하하｡ 하하하하하하하……읏!」"
  },
  {
   "id": 51008,
   "key": "ep_ruri02b.txt:300",
   "file": "ep_ruri02b.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いとも容易く、それを打ち破る哄笑。",
   "ko_candidate": "너무나도 쉽게 그것을 깨뜨리는 폭소｡"
  },
  {
   "id": 51009,
   "key": "ep_ruri02b.txt:301",
   "file": "ep_ruri02b.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "抑え切れぬ嘲りと愉悦と、そして自嘲。",
   "ko_candidate": "억누를 수 없는 조롱과 환희､ 그리고 자조｡"
  },
  {
   "id": 51010,
   "key": "ep_ruri02b.txt:302",
   "file": "ep_ruri02b.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "解れ、零れ、溢れ、決壊する。",
   "ko_candidate": "풀어지고､ 흘러넘치고､ 넘쳐흐르고､ 결괴한다｡"
  },
  {
   "id": 51011,
   "key": "ep_ruri02b.txt:306",
   "file": "ep_ruri02b.txt",
   "line": 306,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははははははははははははははははははは！ 見たか、エセルドレーダ！　こいつは傑作だ！」",
   "ko_candidate": "「아하하하하하하하하하하하하하하하하하하! 보았느냐､ 에셀드레다! 이건 걸작이야!」"
  },
  {
   "id": 51012,
   "key": "ep_ruri02b.txt:312",
   "file": "ep_ruri02b.txt",
   "line": 312,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……マスター」",
   "ko_candidate": "「……마스터」"
  },
  {
   "id": 51013,
   "key": "ep_ruri02b.txt:316",
   "file": "ep_ruri02b.txt",
   "line": 316,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……何が可笑しい？」",
   "ko_candidate": "「……뭐가 우습지?」"
  },
  {
   "id": 51014,
   "key": "ep_ruri02b.txt:320",
   "file": "ep_ruri02b.txt",
   "line": 320,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あははははははは……！」",
   "ko_candidate": "「아하하하하하하……!」"
  },
  {
   "id": 51015,
   "key": "ep_ruri02b.txt:325",
   "file": "ep_ruri02b.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "止まらない哄笑。",
   "ko_candidate": "멈추지 않는 폭소｡"
  },
  {
   "id": 51016,
   "key": "ep_ruri02b.txt:326",
   "file": "ep_ruri02b.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だがリベル・レギスの機械仕掛けの眸の中、宿る金色の闇。",
   "ko_candidate": "하지만 리베르 레기스의 기계 장치의 눈동자 속､ 깃든 황금빛 어둠｡"
  },
  {
   "id": 51017,
   "key": "ep_ruri02b.txt:327",
   "file": "ep_ruri02b.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その奥に凍結された虚無を見た――そんな気がした。",
   "ko_candidate": "그 안쪽에 동결된 허무를 본 듯한 기분이 들었다｡"
  },
  {
   "id": 51018,
   "key": "ep_ruri02b.txt:331",
   "file": "ep_ruri02b.txt",
   "line": 331,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「余を呪縛し続けた永劫が、こうも容易く打ち破られるとは……これが喜劇でなくて何とする!? はははははははははッ！」",
   "ko_candidate": "「나를 계속 주박했던 영겁이､ 이렇게 쉽게 깨져버리다니……이게 희극이 아니면 뭐란 말인가!? 하하하하하하하하핫!」"
  },
  {
   "id": 51019,
   "key": "ep_ruri02b.txt:335",
   "file": "ep_ruri02b.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "永劫の果ての疲弊が融け込んだ聲で、嗤う。",
   "ko_candidate": "영겁의 끝의 피로가 녹아든 목소리로､ 비웃는다｡"
  },
  {
   "id": 51020,
   "key": "ep_ruri02b.txt:336",
   "file": "ep_ruri02b.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスが右掌を掲げた。",
   "ko_candidate": "리베르 레기스가 오른손바닥을 들어 올렸다｡"
  },
  {
   "id": 51021,
   "key": "ep_ruri02b.txt:340",
   "file": "ep_ruri02b.txt",
   "line": 340,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははははは！　ヒト如きが！　人如きが！　神のシナリオを打倒したか！　あははははははッ！」",
   "ko_candidate": "「아하하하하하! 인간 따위가! 인간 따위가! 신의 시나리오를 타도했다고! 아하하하하하하핫!」"
  },
  {
   "id": 51022,
   "key": "ep_ruri02b.txt:343",
   "file": "ep_ruri02b.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "壊れた聲で、嗤う。",
   "ko_candidate": "망가진 목소리로､ 비웃는다｡"
  },
  {
   "id": 51023,
   "key": "ep_ruri02b.txt:344",
   "file": "ep_ruri02b.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無音であるはずの宇宙を埋め尽くして、哄笑は轟き渡る。",
   "ko_candidate": "무음이어야 할 우주를 가득 채우며､ 폭소가 울려 퍼진다｡"
  },
  {
   "id": 51024,
   "key": "ep_ruri02b.txt:346",
   "file": "ep_ruri02b.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスの右掌が閃光った。",
   "ko_candidate": "리베르 레기스의 오른손바닥이 번쩍였다｡"
  },
  {
   "id": 51025,
   "key": "ep_ruri02b.txt:353",
   "file": "ep_ruri02b.txt",
   "line": 353,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎！」",
   "ko_candidate": "「쿠로!」"
  },
  {
   "id": 51026,
   "key": "ep_ruri02b.txt:357",
   "file": "ep_ruri02b.txt",
   "line": 357,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああ……」",
   "ko_candidate": "「아아……」"
  },
  {
   "id": 51027,
   "key": "ep_ruri02b.txt:362",
   "file": "ep_ruri02b.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインの右掌。",
   "ko_candidate": "데몬베인의 오른손바닥｡"
  },
  {
   "id": 51028,
   "key": "ep_ruri02b.txt:363",
   "file": "ep_ruri02b.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "必滅の術式が疾る。唸る。閃光る。",
   "ko_candidate": "필멸의 술식이 달린다｡ 웅웅거린다｡ 번쩍인다｡"
  },
  {
   "id": 51029,
   "key": "ep_ruri02b.txt:365",
   "file": "ep_ruri02b.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベイン、リベル・レギス、両機の右掌が放つ閃光が、宇宙の闇を裂いてせめぎ合う。",
   "ko_candidate": "데몬베인､ 리베르 레기스､ 양쪽 기체의 오른손바닥에서 뿜어져 나오는 섬광이､ 우주의 어둠을 가르며 맞부딪친다｡"
  },
  {
   "id": 51030,
   "key": "ep_ruri02b.txt:373",
   "file": "ep_ruri02b.txt",
   "line": 373,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「はは……大十字九郎。アル・アジフ。今度こそ、本当の終焉だ。そうだ……やっと終われる。終われるのだ」",
   "ko_candidate": "「하하……다이쥬지 쿠로｡ 알 아지프｡ 이번엔 정말 종언이다｡ 그래……드디어 끝낼 수 있어｡ 끝낼 수 있는 거야」"
  },
  {
   "id": 51031,
   "key": "ep_ruri02b.txt:376",
   "file": "ep_ruri02b.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "鈴を転がす様な少年の声は、何故か、枯れた老人の声のように聴こえた。",
   "ko_candidate": "방울을 굴리는 듯한 소년의 목소리가､ 왠지 메마른 노인의 목소리처럼 들렸다｡"
  },
  {
   "id": 51032,
   "key": "ep_ruri02b.txt:378",
   "file": "ep_ruri02b.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、それも一瞬。",
   "ko_candidate": "하지만､ 그것도 잠시｡"
  },
  {
   "id": 51033,
   "key": "ep_ruri02b.txt:379",
   "file": "ep_ruri02b.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "嘲りも自虐も疲弊も断絶し、残るはただ憎悪と殺意。",
   "ko_candidate": "조롱도 자학도 피로도 단절되고､ 남은 건 오직 증오와 살의뿐｡"
  },
  {
   "id": 51034,
   "key": "ep_ruri02b.txt:385",
   "file": "ep_ruri02b.txt",
   "line": 385,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「これだけでは終わらせない！ 大十字九郎！　アル・アジフ！ そして……覇道瑠璃ッッ！」",
   "ko_candidate": "「이것만으로는 끝내지 않겠어! 다이쥬지 쿠로! 알 아지프! 그리고…… 하도 루리잇!」"
  },
  {
   "id": 51035,
   "key": "ep_ruri02b.txt:391",
   "file": "ep_ruri02b.txt",
   "line": 391,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 51036,
   "key": "ep_ruri02b.txt:399",
   "file": "ep_ruri02b.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瘴気が迸る。",
   "ko_candidate": "장기가 뿜어져 나온다｡"
  },
  {
   "id": 51037,
   "key": "ep_ruri02b.txt:400",
   "file": "ep_ruri02b.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "宇宙すらも引き裂くような、衝撃波を伴って。",
   "ko_candidate": "우주마저 찢어버릴 듯한､ 충격파를 동반하며｡"
  },
  {
   "id": 51038,
   "key": "ep_ruri02b.txt:401",
   "file": "ep_ruri02b.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインを、防禦陣の五芒星形が護る。",
   "ko_candidate": "데몬베인을､ 방어진의 오망성 형태가 지킨다｡"
  },
  {
   "id": 51039,
   "key": "ep_ruri02b.txt:405",
   "file": "ep_ruri02b.txt",
   "line": 405,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「我が最愛なる怨敵よ！　我が絶望を我が渇望を我が羨望を知れ！ 余と共に来て貰うぞ、神殺し！」",
   "ko_candidate": "「나의 가장 사랑하는 원수여! 나의 절망을 나의 갈망을 나의 선망을 알아라! 나와 함께 가게 해주마､ 신을 죽인 자여!」"
  },
  {
   "id": 51040,
   "key": "ep_ruri02b.txt:409",
   "file": "ep_ruri02b.txt",
   "line": 409,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総ての想いを怨嗟とし、総ての願いを呪詛とする。",
   "ko_candidate": "모든 감정을 원한으로 삼고､ 모든 소원을 저주로 삼는다｡"
  }
 ]
}