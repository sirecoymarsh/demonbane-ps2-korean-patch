 },
 "items": [
  {
   "id": 11709,
   "key": "D0756.txt:406",
   "file": "D0756.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そういうことなのか？",
   "ko_candidate": ""
  },
  {
   "id": 11710,
   "key": "D0756.txt:407",
   "file": "D0756.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そういうものなのか？",
   "ko_candidate": ""
  },
  {
   "id": 11711,
   "key": "D0756.txt:410",
   "file": "D0756.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ちっ……また頭が混乱してきた。",
   "ko_candidate": ""
  },
  {
   "id": 11712,
   "key": "D0756.txt:411",
   "file": "D0756.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だとしたら、あの時のことはやっぱり現実なのか？",
   "ko_candidate": ""
  },
  {
   "id": 11713,
   "key": "D0756.txt:417",
   "file": "D0756.txt",
   "line": 417,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「どうやって、あの化物を手懐けたのか妾としても興味があるな。汝、どうやって妾の分身を誑かした？」",
   "ko_candidate": ""
  },
  {
   "id": 11714,
   "key": "D0756.txt:422",
   "file": "D0756.txt",
   "line": 422,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「たぶらかしたってお前……」",
   "ko_candidate": ""
  },
  {
   "id": 11715,
   "key": "D0756.txt:425",
   "file": "D0756.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺は深々とため息をついた。",
   "ko_candidate": ""
  },
  {
   "id": 11716,
   "key": "D0756.txt:426",
   "file": "D0756.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "まったく……何がなんだか、さっぱり分からん。",
   "ko_candidate": ""
  },
  {
   "id": 11717,
   "key": "D0756.txt:429",
   "file": "D0756.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あれはただ単にあの２人が起こした怪異なのか？",
   "ko_candidate": ""
  },
  {
   "id": 11718,
   "key": "D0756.txt:432",
   "file": "D0756.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それともそれ以外の誰か。",
   "ko_candidate": ""
  },
  {
   "id": 11719,
   "key": "D0756.txt:433",
   "file": "D0756.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺の知らない誰かが絡んでいるのだろうか？",
   "ko_candidate": ""
  },
  {
   "id": 11720,
   "key": "D0756.txt:436",
   "file": "D0756.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そいつは、俺が悪戦苦闘する姿を見て、笑っているのだろうか。",
   "ko_candidate": ""
  },
  {
   "id": 11721,
   "key": "D0756.txt:439",
   "file": "D0756.txt",
   "line": 439,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "分からない。分からないことだらけだが――何かが",
   "ko_candidate": ""
  },
  {
   "id": 11722,
   "key": "D0756.txt:440",
   "file": "D0756.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "動き出そうとしている。",
   "ko_candidate": ""
  },
  {
   "id": 11723,
   "key": "D0756.txt:443",
   "file": "D0756.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そんな予感があった――",
   "ko_candidate": ""
  },
  {
   "id": 11724,
   "key": "D0756.txt:462",
   "file": "D0756.txt",
   "line": 462,
   "speaker": "ネロ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「あははっ、はははははっ、 ははははははは」",
   "ko_candidate": ""
  },
  {
   "id": 11725,
   "key": "D0756.txt:472",
   "file": "D0756.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "無邪気な笑い声が響く。無邪気ゆえにどこか危険なものを潜ませる、そんな笑い声が響く。",
   "ko_candidate": ""
  },
  {
   "id": 11726,
   "key": "D0756.txt:474",
   "file": "D0756.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アーカムシティの空に。",
   "ko_candidate": ""
  },
  {
   "id": 11727,
   "key": "D0756.txt:475",
   "file": "D0756.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "太陽の光に融けて。",
   "ko_candidate": ""
  },
  {
   "id": 11728,
   "key": "D0756.txt:476",
   "file": "D0756.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "さわやかな空気に乗って。",
   "ko_candidate": ""
  },
  {
   "id": 11729,
   "key": "D0756.txt:482",
   "file": "D0756.txt",
   "line": 482,
   "speaker": "ネロ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ネクロノミコンの断片に介入するのは骨が折れたけど……思いのほか上手くいったね」",
   "ko_candidate": ""
  },
  {
   "id": 11730,
   "key": "D0756.txt:492",
   "file": "D0756.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アーカムシティ全体を見下ろす時計塔。",
   "ko_candidate": ""
  },
  {
   "id": 11731,
   "key": "D0756.txt:493",
   "file": "D0756.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "巨大な、巨大過ぎる時計盤の、長針の上。",
   "ko_candidate": ""
  },
  {
   "id": 11732,
   "key": "D0756.txt:495",
   "file": "D0756.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そこに立つ影がある。",
   "ko_candidate": ""
  },
  {
   "id": 11733,
   "key": "D0756.txt:497",
   "file": "D0756.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "影が笑う。何処までも広がる青空に、だがこの一点にわだかまる闇。",
   "ko_candidate": ""
  },
  {
   "id": 11734,
   "key": "D0756.txt:501",
   "file": "D0756.txt",
   "line": 501,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "闇を払う光が影を生む、二律背反。",
   "ko_candidate": ""
  },
  {
   "id": 11735,
   "key": "D0756.txt:502",
   "file": "D0756.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そんな矛盾の狭間に蠢く闇を震わせて、影が笑う。",
   "ko_candidate": ""
  },
  {
   "id": 11736,
   "key": "D0756.txt:508",
   "file": "D0756.txt",
   "line": 508,
   "speaker": "ネロ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「なかなかの腕になったじゃない。これからだね。もっともっと頑張って強くなれば、九郎はきっと――」",
   "ko_candidate": ""
  },
  {
   "id": 11737,
   "key": "D0756.txt:515",
   "file": "D0756.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "闇の中に、影の中に瞳が輝く。",
   "ko_candidate": ""
  },
  {
   "id": 11738,
   "key": "D0756.txt:516",
   "file": "D0756.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "様々な感情を渦巻かせた瞳が、爛々と。",
   "ko_candidate": ""
  },
  {
   "id": 11739,
   "key": "D0756.txt:519",
   "file": "D0756.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "視線の彼方には、覇道家の車に乗り込む九郎がいる。",
   "ko_candidate": ""
  },
  {
   "id": 11740,
   "key": "D0756.txt:523",
   "file": "D0756.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何かの期待を閉じ込めた瞳は、九郎を、九郎の乗った自動車を、凝っと見つめている。",
   "ko_candidate": ""
  },
  {
   "id": 11741,
   "key": "D0756.txt:526",
   "file": "D0756.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "視界から消えても、ずっとずっと、見つめ続けている――",
   "ko_candidate": ""
  },
  {
   "id": 11742,
   "key": "D0756.txt:558",
   "file": "D0756.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "デバック用選択肢",
   "ko_candidate": ""
  }
 ]
}