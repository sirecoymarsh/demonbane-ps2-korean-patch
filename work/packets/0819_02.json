   "line": 345,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「やあ、遅かったね……先ぱ……」",
   "ko_candidate": "「야아､ 늦었네……선배……」"
  },
  {
   "id": 17301,
   "key": "D0819le.txt:358",
   "file": "D0819le.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "再び砲口が煌いた。",
   "ko_candidate": "다시 포구가 빛났다｡"
  },
  {
   "id": 17302,
   "key": "D0819le.txt:359",
   "file": "D0819le.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "２発目のビームが、『暴君』を貫く。",
   "ko_candidate": "2발째의 빔이､ 『폭군』을 관통한다｡"
  },
  {
