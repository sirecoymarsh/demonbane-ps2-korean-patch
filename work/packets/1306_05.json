   "key": "D1306ru.txt:252",
   "file": "D1306ru.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟く、銃声。",
   "ko_candidate": "울리는 총성｡"
  },
  {
