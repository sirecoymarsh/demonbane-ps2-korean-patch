   "key": "D1306ru.txt:256",
   "file": "D1306ru.txt",
   "line": 256,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イハ、ヤヤヤヤ、 ヤハアアアアアアアａａａａ ＡＡＡａａａ――――！」",
   "ko_candidate": "「이하､ 야야야야､ 야하아아아아아아아아아아아아아아…!」"
