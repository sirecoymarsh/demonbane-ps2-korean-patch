 "items": [
  {
   "id": 16153,
   "key": "D0812al.txt:410",
   "file": "D0812al.txt",
   "line": 410,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そう……」",
   "ko_candidate": "「그래…」"
  },
  {
   "id": 16154,
   "key": "D0812al.txt:415",
   "file": "D0812al.txt",
   "line": 415,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「黙れ！」",
   "ko_candidate": "「닥쳐!」"
  },
  {
   "id": 16155,
   "key": "D0812al.txt:431",
   "file": "D0812al.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女の殺意が凝縮した。",
   "ko_candidate": "소녀의 살의가 응축되었다｡"
  },
  {
   "id": 16156,
   "key": "D0812al.txt:432",
   "file": "D0812al.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それはナイアを捉え爆ぜる。",
   "ko_candidate": "나이아의 머리가 날아간다｡"
  },
  {
   "id": 16157,
   "key": "D0812al.txt:434",
   "file": "D0812al.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "女の容が崩れる。 崩れゆく闇が哄笑する。",
   "ko_candidate": "하지만 아래턱만 남은 몸으로､ 나이아는 크게 웃는다｡"
  },
  {
   "id": 16158,
   "key": "D0812al.txt:440",
   "file": "D0812al.txt",
   "line": 440,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あははははははは！　だって、マスターテリオンは君の生まれ変わりなのだから！」",
   "ko_candidate": "혀를 늘어뜨린 채로｡ 「아하하하하하하! 마스터 테리온은 네 환생이니까! 그렇지… 『폭군』!」"
  },
  {
   "id": 16159,
   "key": "D0812al.txt:444",
   "file": "D0812al.txt",
   "line": 444,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだろ……『暴君』！」",
   "ko_candidate": "「~~~~~~읏!」"
  },
  {
   "id": 16160,
   "key": "D0812al.txt:449",
   "file": "D0812al.txt",
   "line": 449,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「～～～～～～～～ッッッッ！」",
   "ko_candidate": "나이아의 몸이 뒤집혀 터졌다｡ 하지만 튀는 것은 선혈도､ 내장도 아니다｡"
  },
  {
   "id": 16161,
   "key": "D0812al.txt:461",
   "file": "D0812al.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "粘つく闇が四散する。",
   "ko_candidate": "어둠이､ 끈적이는 어둠이 사방으로 흩어진다｡"
  },
  {
   "id": 16162,
   "key": "D0812al.txt:462",
   "file": "D0812al.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "四散して夜闇に融ける。",
   "ko_candidate": "흩어져 밤의 어둠에 녹아든다｡"
  },
  {
   "id": 16163,
   "key": "D0812al.txt:464",
   "file": "D0812al.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ナイアの哄笑だけが響き渡った。",
   "ko_candidate": "나이아의 웃음소리만이 울려 퍼졌다｡"
  },
  {
   "id": 16164,
   "key": "D0812al.txt:465",
   "file": "D0812al.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "伽藍に響く賛美歌の如く。",
   "ko_candidate": "가람에 울리는 찬미가처럼｡"
  },
  {
   "id": 16165,
   "key": "D0812al.txt:466",
   "file": "D0812al.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "天地に轟く雷鳴の如く。",
   "ko_candidate": "천지에 울리는 천둥소리처럼｡"
  },
  {
   "id": 16166,
   "key": "D0812al.txt:468",
   "file": "D0812al.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その声もまた、夜と雨に融けてゆく。",
   "ko_candidate": "그 목소리 또한 밤과 비에 녹아들어간다｡"
  },
  {
   "id": 16167,
   "key": "D0812al.txt:469",
   "file": "D0812al.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "夜闇と雨音に消される声が静かな口調で最後に、告げた。",
   "ko_candidate": "사라질 듯한 목소리가 조용한 어조로 마지막에 말했다｡"
  },
  {
   "id": 16168,
   "key": "D0812al.txt:474",
   "file": "D0812al.txt",
   "line": 474,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……ではご機嫌麗しゅう。異形のお方。人外のお方。僕の愛しの暴君閣下。最強のアンチクロス、最悪のアンチクロス、反逆のアンチクロス――ネロ」",
   "ko_candidate": "「…그럼 안녕히｡ 기괴한 분｡ 인외의 분｡ 내가 사랑하는 폭군 각하｡ 최강의 안티 크로스､ 최악의 안티 크로스､ 반역의 안티 크로스―― 네로」"
  },
  {
   "id": 16169,
   "key": "D0812al.txt:485",
   "file": "D0812al.txt",
   "line": 485,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「…………」 그래｡"
  },
  {
   "id": 16170,
   "key": "D0812al.txt:491",
   "file": "D0812al.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そう。少女は罪人。",
   "ko_candidate": "소녀는 죄인｡"
  },
  {
   "id": 16171,
   "key": "D0812al.txt:493",
   "file": "D0812al.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "罪人の瞳は光を捉えず、",
   "ko_candidate": "죄인의 눈동자는 빛을 담지 않고､"
  },
  {
   "id": 16172,
   "key": "D0812al.txt:494",
   "file": "D0812al.txt",
   "line": 494,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "罪人の心は光を信じず、",
   "ko_candidate": "죄인의 마음은 빛을 믿지 않으며､"
  },
  {
   "id": 16173,
   "key": "D0812al.txt:496",
   "file": "D0812al.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "故に「主は何処」と呼ぶ声も無く。",
   "ko_candidate": "그래서 '주님은 어디에'라고 부르는 소리도 없다｡"
  },
  {
   "id": 16174,
   "key": "D0812al.txt:498",
   "file": "D0812al.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彷徨う罪人。",
   "ko_candidate": "방황하는 죄인｡"
  },
  {
   "id": 16175,
   "key": "D0812al.txt:499",
   "file": "D0812al.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女の名は―― ネロ。",
   "ko_candidate": "소녀의 이름은――네로｡"
  },
  {
   "id": 16176,
   "key": "D0812al.txt:506",
   "file": "D0812al.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――ここに知恵がある。思慮深き者は、獣の数字を数えるが良い。その数字は人間を指しているからである。その数字とは６６６である。",
   "ko_candidate": "――여기에 지혜가 있다｡ 총명한 자는 짐승의 숫자를 세어보라｡ 그 숫자는 인간을 가리키고 있기 때문이다｡ 그 숫자는 666이다｡ ."
  },
  {
   "id": 16177,
   "key": "D0812le.txt:12",
   "file": "D0812le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マギウス・スタイルで、１４番区画郊外の上空を翔ける。夕方まで晴れ渡っていた空には、雨雲が立ち込め、夜の闇に重く圧し掛かる。",
   "ko_candidate": "마기우스 스타일로､ 14번 구획 교외의 상공을 날아간다｡ 저녁까지 맑게 개었던 하늘에는 비구름이 끼어､ 밤의 어둠에 무겁게 압박해온다｡"
  },
  {
   "id": 16178,
   "key": "D0812le.txt:13",
   "file": "D0812le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今にも泣き出しそうな空。",
   "ko_candidate": "금방이라도 울음을 터뜨릴 것 같은 하늘｡"
  },
  {
   "id": 16179,
   "key": "D0812le.txt:15",
   "file": "D0812le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "眼下の１４区画を見回す。",
   "ko_candidate": "아래의 14구획을 둘러본다｡"
  },
  {
   "id": 16180,
   "key": "D0812le.txt:16",
   "file": "D0812le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一番大きい建物……一番大きい建物……あれか！",
   "ko_candidate": "가장 큰 건물… 가장 큰 건물… 저거군!"
  },
  {
   "id": 16181,
   "key": "D0812le.txt:21",
   "file": "D0812le.txt",
   "line": 21,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「待て、九郎！　敵は罠を張っているはずだぞ！ 事は慎重に進めねばならん！」",
   "ko_candidate": "「기다려､ 쿠로! 적은 함정을 펼쳐놓고 있을 거야! 일은 신중하게 진행해야 해!」"
  },
  {
   "id": 16182,
   "key": "D0812le.txt:27",
   "file": "D0812le.txt",
   "line": 27,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だからって、ライカさんの身が危ねえんだぞ!?　ちんたらやっている時間はねえよ！」",
   "ko_candidate": "「그래도 라이카 씨의 목숨이 걸려있잖아!? 꾸물거릴 시간 없다고!」"
  },
  {
   "id": 16183,
   "key": "D0812le.txt:32",
   "file": "D0812le.txt",
   "line": 32,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アンチクロス並みの気配を発していた奴だ！ 間違いなく達人級！　思慮なく飛び込んでは……」",
   "ko_candidate": "「안티 크로스에 버금가는 기척을 내뿜던 녀석이야! 틀림없이 달인급이야! 경솔하게 뛰어들면…」"
  },
  {
   "id": 16184,
   "key": "D0812le.txt:41",
   "file": "D0812le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆音にも似た地響き。",
   "ko_candidate": "폭음과도 같은 땅울림｡"
  },
  {
   "id": 16185,
   "key": "D0812le.txt:42",
   "file": "D0812le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "建物の最上階から無数のカラスが一斉に飛び立った。",
   "ko_candidate": "건물의 최상층에서 무수한 까마귀들이 일제히 날아올랐다｡"
  },
  {
   "id": 16186,
   "key": "D0812le.txt:50",
   "file": "D0812le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "続けて烈風。",
   "ko_candidate": "이어서 열풍｡"
  },
  {
   "id": 16187,
   "key": "D0812le.txt:54",
   "file": "D0812le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "最上階は粉々になって砕け、瓦礫が舞い、血潮が舞う。",
   "ko_candidate": "최상층은 산산조각 나 부서지고､ 잔해가 날리며､ 핏줄기가 흩날린다｡"
  },
  {
   "id": 16188,
   "key": "D0812le.txt:59",
   "file": "D0812le.txt",
   "line": 59,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「!?　何が起こっている……？」",
   "ko_candidate": "「!? 무슨 일이 일어나고 있는 거지…?」"
  },
  {
   "id": 16189,
   "key": "D0812le.txt:64",
   "file": "D0812le.txt",
   "line": 64,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「チィィィィィッ！」",
   "ko_candidate": "「치이이이이익!」"
  },
  {
   "id": 16190,
   "key": "D0812le.txt:69",
   "file": "D0812le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "全速力で降下する。",
   "ko_candidate": "전속력으로 하강한다｡"
  },
  {
   "id": 16191,
   "key": "D0812le.txt:71",
   "file": "D0812le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "天井は綺麗に吹き飛び、吹き飛んだ瓦礫が地表に落ちて砕ける音が連続して聴こえる。",
   "ko_candidate": "천장은 깨끗이 날아가 버리고､ 날아간 잔해가 지표에 떨어져 부서지는 소리가 연속해서 들린다｡"
  },
  {
   "id": 16192,
   "key": "D0812le.txt:79",
   "file": "D0812le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "月光に照らされ、土煙と瓦礫と黒い羽根と血飛沫の只中に立つ影。",
   "ko_candidate": "월광에 비춰진 흙먼지와 잔해와 검은 깃털과 핏방울의 한가운데에 서 있는 그림자｡"
  }
 ]
}