 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ジョージ": "조지",
  "アーカム": "아컴"
 },
 "items": [
  {
   "id": 49709,
   "key": "ep_leica01.txt:125",
   "file": "ep_leica01.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私はただ泣き続けることしか出来なかった。",
   "ko_candidate": "이유도 모른 채 나는 그저 계속 울 수밖에 없었다｡"
  },
  {
   "id": 49710,
   "key": "ep_leica01.txt:130",
   "file": "ep_leica01.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "涙は、痺れを切らしたジョージが、",
   "ko_candidate": "눈물은 조지가 참다 못해 다시 방 앞으로"
  },
  {
   "id": 49711,
   "key": "ep_leica01.txt:131",
   "file": "ep_leica01.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "また部屋の前までやってくるまで続いた。",
   "ko_candidate": "올 때까지 계속되었다｡"
  },
  {
   "id": 49712,
   "key": "ep_leica01.txt:140",
   "file": "ep_leica01.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "朝ごはんの支度を済ませて、席に着く。",
   "ko_candidate": "아침밥 준비를 마치고 자리에 앉는다｡"
  },
  {
   "id": 49713,
   "key": "ep_leica01.txt:141",
   "file": "ep_leica01.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "みんなで神様にお祈りをしてから、仲良くごはん。",
   "ko_candidate": "모두 함께 신께 기도를 드리고 나서 사이좋게 밥을 먹는다｡"
  },
  {
   "id": 49714,
   "key": "ep_leica01.txt:143",
   "file": "ep_leica01.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……子どもたちの笑顔が見られることが、 私にとっては一番嬉しい。",
   "ko_candidate": "……아이들의 웃는 얼굴을 볼 수 있다는 게 내겐 가장 기쁜 일이야｡"
  },
  {
   "id": 49715,
   "key": "ep_leica01.txt:145",
   "file": "ep_leica01.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この子たちの境遇は、決して他人事ではなかったから。",
   "ko_candidate": "이 아이들의 처지는 결코 남의 일이 아니었으니까｡"
  },
  {
   "id": 49716,
   "key": "ep_leica01.txt:147",
   "file": "ep_leica01.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私も、この子たちと同じ孤児だった。",
   "ko_candidate": "나도 이 아이들과 같은 고아였으니까｡"
  },
  {
   "id": 49717,
   "key": "ep_leica01.txt:149",
   "file": "ep_leica01.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "教会のシスターに引き取られて育った私は、",
   "ko_candidate": "교회의 수녀님에게 맡겨져 자란 나는､ 나도 마찬가지로"
  },
  {
   "id": 49718,
   "key": "ep_leica01.txt:150",
   "file": "ep_leica01.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自分も同じように身寄りのない子どもたちを 引き取って育てようと、孤児院を始めた。",
   "ko_candidate": "의지할 곳 없는 아이들을 맡아 키우겠다고､ 고아원을 시작했다｡"
  },
  {
   "id": 49719,
   "key": "ep_leica01.txt:153",
   "file": "ep_leica01.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだまだ失敗も多くて、色々と大変だけど、",
   "ko_candidate": "아직 실는 많고､ 여러모로 힘들지만､ 그래도､"
  },
  {
   "id": 49720,
   "key": "ep_leica01.txt:154",
   "file": "ep_leica01.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それでも、この子たちの笑顔を見れば、 いくらだって頑張れる。",
   "ko_candidate": "이 아이들의 웃는 얼굴을 보면､ 얼마든지 힘을 낼 수 있어｡"
  },
  {
   "id": 49721,
   "key": "ep_leica01.txt:159",
   "file": "ep_leica01.txt",
   "line": 159,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「おかわりーっ」",
   "ko_candidate": "「더 주세요-」"
  },
  {
   "id": 49722,
   "key": "ep_leica01.txt:163",
   "file": "ep_leica01.txt",
   "line": 163,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「オレもっ、オレもっ」",
   "ko_candidate": "「나도､ 나도」"
  },
  {
   "id": 49723,
   "key": "ep_leica01.txt:167",
   "file": "ep_leica01.txt",
   "line": 167,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……朝からよく食べるなぁ」",
   "ko_candidate": "「……아침부터 잘도 먹는구나」"
  },
  {
   "id": 49724,
   "key": "ep_leica01.txt:171",
   "file": "ep_leica01.txt",
   "line": 171,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「はいはい。 ちょっと待っていてねえ」",
   "ko_candidate": "「알았어 알았어｡ 조금만 기다려」"
  },
  {
   "id": 49725,
   "key": "ep_leica01.txt:175",
   "file": "ep_leica01.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 49726,
   "key": "ep_leica01.txt:179",
   "file": "ep_leica01.txt",
   "line": 179,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――――――」",
   "ko_candidate": "「――――――――――」"
  },
  {
   "id": 49727,
   "key": "ep_leica01.txt:182",
   "file": "ep_leica01.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だけど、何だろう。",
   "ko_candidate": "하지만､ 뭘까｡"
  },
  {
   "id": 49728,
   "key": "ep_leica01.txt:183",
   "file": "ep_leica01.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今朝から続く、この喪失感は。",
   "ko_candidate": "오늘 아침부터 계속되는､ 이 상실감은｡"
  },
  {
   "id": 49729,
   "key": "ep_leica01.txt:184",
   "file": "ep_leica01.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何かが足りない……誰かが、足りない。",
   "ko_candidate": "뭔가가 부족해……누군가가､ 부족해｡"
  },
  {
   "id": 49730,
   "key": "ep_leica01.txt:186",
   "file": "ep_leica01.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何が足りないというのだろう？",
   "ko_candidate": "뭐가 부족하다는 걸까?"
  },
  {
   "id": 49731,
   "key": "ep_leica01.txt:187",
   "file": "ep_leica01.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私たちには、この子たちが居るのに……。",
   "ko_candidate": "우리에겐､ 이 아이들이 있는데……"
  },
  {
   "id": 49732,
   "key": "ep_leica01.txt:194",
   "file": "ep_leica01.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そのとき、礼拝堂の方で大きな物音がした。",
   "ko_candidate": "그때､ 예배당 쪽에서 큰 소리가 났다｡"
  },
  {
   "id": 49733,
   "key": "ep_leica01.txt:195",
   "file": "ep_leica01.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "次いでバサバサと鳥が羽ばたく音と。",
   "ko_candidate": "이어서 파닥파닥 새가 날갯짓하는 소리가｡"
  },
  {
   "id": 49734,
   "key": "ep_leica01.txt:199",
   "file": "ep_leica01.txt",
   "line": 199,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……？　何だろ？」",
   "ko_candidate": "「……? 뭘까?」"
  },
  {
   "id": 49735,
   "key": "ep_leica01.txt:203",
   "file": "ep_leica01.txt",
   "line": 203,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うっ……ドロボウさん？」",
   "ko_candidate": "「으……도둑이에요?」"
  },
  {
   "id": 49736,
   "key": "ep_leica01.txt:206",
   "file": "ep_leica01.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "礼拝堂に押し入って、盗むものなんて何もないと思う。",
   "ko_candidate": "예배당에 침입해서､ 훔칠 만한 건 아무것도 없다고 생각해｡"
  },
  {
   "id": 49737,
   "key": "ep_leica01.txt:207",
   "file": "ep_leica01.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど気になるのは確か。",
   "ko_candidate": "하지만 신경 쓰이는 건 사실이야｡"
  },
  {
   "id": 49738,
   "key": "ep_leica01.txt:211",
   "file": "ep_leica01.txt",
   "line": 211,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちょっとお姉ちゃん 見てくるから。ちゃんと 行儀良く食べなさいよぉー」",
   "ko_candidate": "「잠깐 누나가 보고 올 테니까｡ 얌전히 먹고 있어야 해-」"
  },
  {
   "id": 49739,
   "key": "ep_leica01.txt:218",
   "file": "ep_leica01.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "礼拝堂に続く扉を開ける。",
   "ko_candidate": "예배당으로 이어지는 문을 연다｡"
  },
  {
   "id": 49740,
   "key": "ep_leica01.txt:219",
   "file": "ep_leica01.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……なんか、大量の白い鳩が目に飛び込んでくる。",
   "ko_candidate": "……뭔가､ 대량의 흰 비둘기가 눈에 들어온다｡"
  },
  {
   "id": 49741,
   "key": "ep_leica01.txt:221",
   "file": "ep_leica01.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "特に多くの鳩が集まっている一点……",
   "ko_candidate": "특히 많은 비둘기가 모여 있는 한 지점……"
  },
  {
   "id": 49742,
   "key": "ep_leica01.txt:221",
   "file": "ep_leica01.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "鳩に埋め尽くされて、倒れているステキ青年さんがいる。",
   "ko_candidate": "비둘기에 파묻혀서､ 쓰러져 있는 멋진 청년이 있다｡"
  },
  {
   "id": 49743,
   "key": "ep_leica01.txt:223",
   "file": "ep_leica01.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "野垂れ死にが似合う男ナンバー１。",
   "ko_candidate": "길바닥에서 죽어도 어울릴 남자 넘버 1｡"
  },
  {
   "id": 49744,
   "key": "ep_leica01.txt:224",
   "file": "ep_leica01.txt",
   "line": 224,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "（アーカム・アドヴァタイザー調べ）",
   "ko_candidate": "(아캄 애드버타이저 조사) 「아……」"
  },
  {
   "id": 49745,
   "key": "ep_leica01.txt:228",
   "file": "ep_leica01.txt",
   "line": 228,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……」 ――心の空洞が、満たされる。",
   "ko_candidate": "――마음의 공허함이､ 채워진다｡"
  },
  {
   "id": 49746,
   "key": "ep_leica01.txt:245",
   "file": "ep_leica01.txt",
   "line": 245,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「パトラッシュがー。 パトラッシュがー」",
   "ko_candidate": "「파트라슈가-｡ 파트라슈가-」"
  },
  {
   "id": 49747,
   "key": "ep_leica01.txt:249",
   "file": "ep_leica01.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "弱々しく頭を上げる彼と、視線が合わさった。",
   "ko_candidate": "힘없이 고개를 드는 그와､ 시선이 마주쳤다｡"
  },
  {
   "id": 49748,
   "key": "ep_leica01.txt:250",
   "file": "ep_leica01.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "私は心底呆れたように溜息をついて、 彼に微笑みかける。",
   "ko_candidate": "나는 정말 어이없다는 듯이 한숨을 쉬고､ 그에게 미소를 지어 보인다｡"
  }
 ]
}