   "file": "D0715ru.txt",
   "line": 89,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふぅぅ……」",
   "ko_candidate": "「…………………………」"
  },
  {
   "id": 11155,
   "key": "D0715ru.txt:92",
   "file": "D0715ru.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "深く溜め息をつく。",
   "ko_candidate": "「…………………………」 「…………………………」"
  },
  {
   "id": 11156,
   "key": "D0715ru.txt:94",
   "file": "D0715ru.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "遠くに天を貫き、聳える摩天楼が見えてきた。",
   "ko_candidate": "「…………………………」 「…………………………」"
  },
  {
   "id": 11157,
   "key": "D0715ru.txt:95",
   "file": "D0715ru.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "観光バスはそろそろアーカムシティに辿り着くだろう。",
   "ko_candidate": "「…………………………」 뭐랄까…… 나와 공주님 사이에 묘한 긴장감이 감돌고 있었다｡"
  },
  {
   "id": 11158,
   "key": "D0715ru.txt:97",
   "file": "D0715ru.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうすれば、また俺たちの日常が始まる。",
   "ko_candidate": "이유는 굳이 확인할 필요도 없이 섬에서의 일임에 틀림없다｡"
