  {
   "id": 26550,
   "key": "D1201le.txt:231",
   "file": "D1201le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは、死の彩に染められた血風。",
   "ko_candidate": "피 냄새로 가득 찬다｡ 단말마로 가득 찬다｡"
  },
  {
   "id": 26551,
   "key": "D1201le.txt:238",
   "file": "D1201le.txt",
   "line": 238,
   "speaker": "警備兵Ａ / クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぎゃあああああ！」 「ヒャーハッハッハッ！」",
   "ko_candidate": "죽음으로 가득 찬다｡"
  },
  {
   "id": 26552,
   "key": "D1201le.txt:252",
   "file": "D1201le.txt",
   "line": 252,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クラウディウスめ……怒りに我を忘れているな。逸りおって」",
   "ko_candidate": "죽음의 색채로 물든 피바람이 휘몰아친다｡ 「꺄아아아아아!」"
  },
  {
   "id": 26553,
   "key": "D1201le.txt:258",
   "file": "D1201le.txt",
   "line": 258,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だがカリグラがやられた以上、連中を放置しておくのは得策ではない」",
   "ko_candidate": "「히야하하하!」 「클라우디우스 녀석… 분노에 자신을 잃고 있군｡ 흥분해서」"
  },
  {
   "id": 26554,
   "key": "D1201le.txt:261",
   "file": "D1201le.txt",
   "line": 261,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ここは後々の為にも、徹底的に完膚なきに万遍なく憂いなく覇道財閥を粉砕しておくべきとは思わぬかね？　アウグストゥス」",
   "ko_candidate": "「하지만 칼리굴라가 당한 이상､ 저들을 방치해 두는 건 득책이 아니야｡ 여기는 후일을 위해서라도､ 철저하게 완전무결하게 빈틈없이 하도재벌을 분쇄해 두어야 하지 않을까? 아우구스투스」"
  },
  {
   "id": 26555,
   "key": "D1201le.txt:267",
   "file": "D1201le.txt",
   "line": 267,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだな。だが、あの調子のクラウディウスだけでは心許ないな……ティトゥス」",
   "ko_candidate": "「그렇군｡ 하지만､ 저 상태의 클라우디우스만으로는 믿음직스럽지 않아… 티투스」 「원래부터 그럴 생각이었다」"
  },
  {
