  {
   "id": 26549,
   "key": "D1201le.txt:215",
   "file": "D1201le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴ら……本格的に潰しにかかってきたか！",
   "ko_candidate": "놈들… 본격적으로 박살내러 온 건가!"
