 },
 "items": [
  {
   "id": 25714,
   "key": "D1110ru.txt:339",
   "file": "D1110ru.txt",
   "line": 339,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「水妖の力…… 『水神クタアト』か！」",
   "ko_candidate": "「수요의 힘…… 『수신 크타아트』인가!」"
  },
  {
   "id": 25715,
   "key": "D1110ru.txt:350",
   "file": "D1110ru.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、デモンベインの戦いをモニタしていた司令室も、異変に気付いていた。",
   "ko_candidate": "물론 데몬베인의 전투를 모니터하고 있던 사령실도 이변을 눈치챘다｡"
  },
  {
   "id": 25716,
   "key": "D1110ru.txt:352",
   "file": "D1110ru.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マコトの感情の少ない、淡々とした声が、そうであって欲しくない結果を冷酷に告げる。",
   "ko_candidate": "마코토의 감정 없는 담담한 목소리가 그러길 바라지 않는 결과를 냉혹하게 알린다｡"
  },
  {
   "id": 25717,
   "key": "D1110ru.txt:357",
   "file": "D1110ru.txt",
   "line": 357,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――高密度の字祷子圧縮活動を確認。規模はデモンベイン・クラス。 間違いありません。『招喚』です」",
   "ko_candidate": "「――고밀도의 인과율자 압축 활동을 확인｡ 규모는 데몬베인 클래스｡ 틀림없습니다｡ 『소환』입니다」"
  },
  {
   "id": 25718,
   "key": "D1110ru.txt:371",
   "file": "D1110ru.txt",
   "line": 371,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こんなタイミングで、アンチクロスのデウス・マキナが顕れるとは！」 「まずいですね……今の、お嬢様が操縦するデモンベインでは話にならない！」",
   "ko_candidate": "「이런 타이밍에 안티크로스의 데우스 마키나가 나타나다니! 곤란하군요…… 지금의 아가씨가 조종하는 데몬베인으로는 말이 안 됩니다!」"
  },
  {
   "id": 25719,
   "key": "D1110ru.txt:380",
   "file": "D1110ru.txt",
   "line": 380,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マ、顕現化しますぅ！」",
   "ko_candidate": "「마､ 현현화합니다!」"
  },
  {
   "id": 25720,
   "key": "D1110ru.txt:384",
   "file": "D1110ru.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "モニタの向こう、天に噴き出る水柱が、捻じ曲がり、互いに交じり合って、１本の巨大な渦となる。",
   "ko_candidate": "모니터 너머 하늘로 솟구치는 물기둥이 뒤틀리고 서로 뒤섞여 하나의 거대한 소용돌이가 된다｡"
  },
  {
   "id": 25721,
   "key": "D1110ru.txt:386",
   "file": "D1110ru.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆砕した。",
   "ko_candidate": "폭발했다｡"
  },
  {
   "id": 25722,
   "key": "D1110ru.txt:388",
   "file": "D1110ru.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "スコールの如く、大雨が一帯に降り注ぐ。",
   "ko_candidate": "스콜과 같이 폭우가 일대에 쏟아진다｡"
  },
  {
   "id": 25723,
   "key": "D1110ru.txt:390",
   "file": "D1110ru.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の中心に、その巨体は実像を結んでいた。",
   "ko_candidate": "폭발의 중심에 그 거체는 실상을 이루고 있었다｡"
  },
  {
   "id": 25724,
   "key": "D1110ru.txt:395",
   "file": "D1110ru.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――クラーケン。",
   "ko_candidate": "――크라켄｡"
  },
  {
   "id": 25725,
   "key": "D1110ru.txt:396",
   "file": "D1110ru.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最凶最悪の魔導ロボット、鬼械神。",
   "ko_candidate": "최강최악의 마도 로봇､ 귀계신｡"
  },
  {
   "id": 25726,
   "key": "D1110ru.txt:406",
   "file": "D1110ru.txt",
   "line": 406,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お嬢様！　デウス・マキナです！　これ以上の戦闘は無謀です！ 今すぐ状況を放棄して、撤退して下さい！」",
   "ko_candidate": "「아가씨! 데우스 마키나입니다! 이 이상의 전투는 무모합니다! 지금 당장 상황을 포기하고 철수해 주세요!」"
  },
  {
   "id": 25727,
   "key": "D1110ru.txt:418",
   "file": "D1110ru.txt",
   "line": 418,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「果たして、奴がそれを許してくれるか――」",
   "ko_candidate": "「과연 놈이 그걸 허락해 줄까――」"
  },
  {
   "id": 25728,
   "key": "D1110ru.txt:422",
   "file": "D1110ru.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界を奪うほどに烈しい雨の向こう、不気味に佇む威容を睨みつけ、アルは引き攣った笑みを浮かべる。",
   "ko_candidate": "시야를 빼앗을 정도로 거센 비 너머 불길하게 우뚝 선 위용을 노려보며 알은 경련한 미소를 띤다｡"
  },
  {
   "id": 25729,
   "key": "D1110ru.txt:424",
   "file": "D1110ru.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風を唸らせ、押し寄せる轟音。",
   "ko_candidate": "바람을 울리며 밀려오는 굉음｡"
  },
  {
   "id": 25730,
   "key": "D1110ru.txt:430",
   "file": "D1110ru.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大蛇の如く伸びるクラーケンの腕が、迫っていた。",
   "ko_candidate": "큰뱀처럼 뻗어 나오는 크라켄의 팔이 다가오고 있었다｡"
  },
  {
   "id": 25731,
   "key": "D1110ru.txt:435",
   "file": "D1110ru.txt",
   "line": 435,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐるアァァァァああああアアアァァァァァッ！」",
   "ko_candidate": "「그르아아아아아아아아아아아아아앗!」"
  },
  {
   "id": 25732,
   "key": "D1110ru.txt:440",
   "file": "D1110ru.txt",
   "line": 440,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やはりな！」",
   "ko_candidate": "「역시!」"
  },
  {
   "id": 25733,
   "key": "D1110ru.txt:449",
   "file": "D1110ru.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初の腕を飛び退いてかわし、そこに迫ってきた２本目を、身を捩らせ、横回転してかわす。",
   "ko_candidate": "첫 번째 팔을 뛰어 물러나 피하고 거기로 다가온 두 번째를 몸을 비틀어 옆으로 회전하며 피한다｡"
  },
  {
   "id": 25734,
   "key": "D1110ru.txt:459",
   "file": "D1110ru.txt",
   "line": 459,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああああ！」",
   "ko_candidate": "「아아아아!」"
  },
  {
   "id": 25735,
   "key": "D1110ru.txt:462",
   "file": "D1110ru.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背中が僅かに掠り、火花を散らせた。",
   "ko_candidate": "등이 살짝 스쳐 불꽃을 튀겼다｡"
  },
  {
   "id": 25736,
   "key": "D1110ru.txt:463",
   "file": "D1110ru.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれて、デモンベインは大地を転がる。",
   "ko_candidate": "튕겨나가 데몬베인은 대지를 구른다｡"
  },
  {
   "id": 25737,
   "key": "D1110ru.txt:468",
   "file": "D1110ru.txt",
   "line": 468,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「きゃあああああああああ！」",
   "ko_candidate": "「꺄아아아아아아아아아!」"
  },
  {
   "id": 25738,
   "key": "D1110ru.txt:473",
   "file": "D1110ru.txt",
   "line": 473,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅぅぅ……！」",
   "ko_candidate": "「크으으으……!」"
  },
  {
   "id": 25739,
   "key": "D1110ru.txt:477",
   "file": "D1110ru.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "転がる勢いを利用して起き上がる。",
   "ko_candidate": "구르는 기세를 이용해 일어선다｡"
  },
  {
   "id": 25740,
   "key": "D1110ru.txt:479",
   "file": "D1110ru.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左手を突き、片膝立ちになって地面を滑り続けた。",
   "ko_candidate": "왼손을 짚고､ 한쪽 무릎을 세워 지면을 미끄러지듯 움직였다｡"
  },
  {
   "id": 25741,
   "key": "D1110ru.txt:481",
   "file": "D1110ru.txt",
   "line": 481,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "建物を踏み潰しながら、慣性を殺す。",
   "ko_candidate": "건물을 밟아 부수면서､ 관성을 죽인다｡"
  },
  {
   "id": 25742,
   "key": "D1110ru.txt:483",
   "file": "D1110ru.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街に轍の様な痕を抉って、デモンベインはようやく静止した。",
   "ko_candidate": "거리에 바퀴 자국 같은 흔적을 파며､ 데몬베인은 겨우 정지했다｡"
  },
  {
   "id": 25743,
   "key": "D1110ru.txt:491",
   "file": "D1110ru.txt",
   "line": 491,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「流石にきついな……」",
   "ko_candidate": "「역시 힘들군……」"
  },
  {
   "id": 25744,
   "key": "D1110ru.txt:496",
   "file": "D1110ru.txt",
   "line": 496,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぅ……ううぅぅ……」",
   "ko_candidate": "「으으……우으으으……」"
  },
  {
   "id": 25745,
   "key": "D1110ru.txt:502",
   "file": "D1110ru.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを襲った衝撃に、瑠璃は意識が眩みそうになった。",
   "ko_candidate": "데몬베인을 덮친 충격에､ 루리는 의식이 아찔해질 것 같았다｡"
  },
  {
   "id": 25746,
   "key": "D1110ru.txt:503",
   "file": "D1110ru.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吐き気が込み上げてくるのを必死に堪える。",
   "ko_candidate": "구토감이 치밀어 오르는 것을 필사적으로 참는다｡"
  },
  {
   "id": 25747,
   "key": "D1110ru.txt:508",
   "file": "D1110ru.txt",
   "line": 508,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お嬢様！　早く離脱を！　回収口まで戻って下さい！」",
   "ko_candidate": "「아가씨! 빨리 이탈하세요! 회수구까지 돌아가 주세요!」"
  },
  {
   "id": 25748,
   "key": "D1110ru.txt:513",
   "file": "D1110ru.txt",
   "line": 513,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……それしか無いか」",
   "ko_candidate": "「크……그것밖에 없나」"
  },
  {
   "id": 25749,
   "key": "D1110ru.txt:517",
   "file": "D1110ru.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心の中でアルは毒づいた。",
   "ko_candidate": "마음속으로 알은 욕설을 내뱉었다｡"
  },
  {
   "id": 25750,
   "key": "D1110ru.txt:519",
   "file": "D1110ru.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やはり、魔術師以外の人間を術者には出来ないか。",
   "ko_candidate": "역시､ 마술사 이외의 인간은 술자로 삼을 수 없는 건가｡"
  },
  {
   "id": 25751,
   "key": "D1110ru.txt:521",
   "file": "D1110ru.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この調子では術者無しで独りで戦った方が、まだしも良かったかも知れない。",
   "ko_candidate": "이 상태라면 술자 없이 혼자서 싸우는 편이 오히려 나았을지도 모른다｡"
  },
  {
   "id": 25752,
   "key": "D1110ru.txt:523",
   "file": "D1110ru.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "事実、アルは操縦系にかなり介入していた。",
   "ko_candidate": "사실､ 알은 조종계에 상당히 개입하고 있었다｡"
  },
  {
   "id": 25753,
   "key": "D1110ru.txt:525",
   "file": "D1110ru.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これではほとんど意味が無い。",
   "ko_candidate": "이래서는 거의 의미가 없다｡"
  }
 ]
}