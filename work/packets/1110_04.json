 "glossary": {
  "デモンベイン": "데몬베인",
  "マコト": "마코토",
  "アンチクロス": "안티크로스",
  "デウス・マキナ": "데우스 마키나",
  "お嬢様": "아가씨",
  "クラーケン": "크라켄",
  "鬼械神": "귀계신",
