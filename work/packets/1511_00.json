 "items": [
  {
   "id": 46022,
   "key": "D1511le.txt:11",
   "file": "D1511le.txt",
   "line": 11,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「でやあああああああああああ！」",
   "ko_candidate": "「데에에에에에에에에에에에!」"
  },
  {
   "id": 46023,
   "key": "D1511le.txt:14",
   "file": "D1511le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "解放された脚部シールドが、紫電を迸らせ、時空間を歪め、膨大なエネルギーを生み出し、デモンベインに、驚異の機動力を与える。",
   "ko_candidate": "해방된 다리부 실드가 자줏빛 번개를 내뿜으며 시공간을 왜곡하고､ 거대한 에너지를 만들어내어 데몬베인에 놀라운 기동력을 부여한다｡"
  },
  {
   "id": 46024,
   "key": "D1511le.txt:16",
   "file": "D1511le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスに突撃しながら、機体を捻り、回転させる。",
   "ko_candidate": "리베르 레기스에 돌격하면서 기체를 비틀어 회전시킨다｡"
  },
  {
   "id": 46025,
   "key": "D1511le.txt:17",
   "file": "D1511le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "描いた円の軌跡を、空間に刻みつけるが如く、銀光が後を追った。",
   "ko_candidate": "그린 원의 궤적을 공간에 새기듯 은빛 광채가 뒤를 쫓았다｡"
  },
  {
   "id": 46026,
   "key": "D1511le.txt:22",
   "file": "D1511le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光は、疾る刃の閃き。",
   "ko_candidate": "빛은 질주하는 칼날의 섬광｡"
  },
  {
   "id": 46027,
   "key": "D1511le.txt:30",
   "file": "D1511le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインの手には、瞬時に招喚されたバルザイの偃月刀が握られていた。",
   "ko_candidate": "데몬베인의 손에는 순식간에 소환된 바르자이의 언월도가 쥐어져 있었다｡"
  },
  {
   "id": 46028,
   "key": "D1511le.txt:32",
   "file": "D1511le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "回転の勢いを威力に加え、偃月刀がリベル・レギスを襲う。",
   "ko_candidate": "회전의 기세를 위력에 더해 언월도가 리베르 레기스를 덮친다｡"
  },
  {
   "id": 46029,
   "key": "D1511le.txt:36",
   "file": "D1511le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスが消えた。",
   "ko_candidate": "리베르 레기스가 사라졌다｡"
  },
  {
   "id": 46030,
   "key": "D1511le.txt:38",
   "file": "D1511le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃が虚しく、何もない空間を通り過ぎる。",
   "ko_candidate": "칼날이 헛되이 텅 빈 공간을 지나간다｡"
  },
  {
   "id": 46031,
   "key": "D1511le.txt:39",
   "file": "D1511le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴は何処へ!?",
   "ko_candidate": "놈은 어디로!?"
  },
  {
   "id": 46032,
   "key": "D1511le.txt:43",
   "file": "D1511le.txt",
   "line": 43,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！　上だ！」",
   "ko_candidate": "「쿠로! 위다!」"
  },
  {
   "id": 46033,
   "key": "D1511le.txt:47",
   "file": "D1511le.txt",
   "line": 47,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 46034,
   "key": "D1511le.txt:53",
   "file": "D1511le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影が、デモンベインの上に落ちる。",
   "ko_candidate": "그림자가 데몬베인 위로 떨어진다｡"
  },
  {
   "id": 46035,
   "key": "D1511le.txt:54",
   "file": "D1511le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳躍し、刃をかわしたリベル・レギスの機体が、頭上を舞っていた。",
   "ko_candidate": "도약해 칼날을 피한 리베르 레기스의 기체가 머리 위를 날고 있었다｡"
  },
  {
   "id": 46036,
   "key": "D1511le.txt:55",
   "file": "D1511le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつ、これだけの巨体と重量を操りながら、こんなに軽やかに！",
   "ko_candidate": "이놈､ 이 정도의 거대한 체구와 무게를 다루면서 이렇게 경쾌하게!"
  },
  {
   "id": 46037,
   "key": "D1511le.txt:64",
   "file": "D1511le.txt",
   "line": 64,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまっ……！」",
   "ko_candidate": "「아차……!」"
  },
  {
   "id": 46038,
   "key": "D1511le.txt:73",
   "file": "D1511le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスの鮮やかな飛び蹴りが、炸裂する。",
   "ko_candidate": "리베르 레기스의 화려한 날아차기가 터진다｡"
  },
  {
   "id": 46039,
   "key": "D1511le.txt:74",
   "file": "D1511le.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃がデモンベインを揺るがした。",
   "ko_candidate": "충격이 데몬베인을 뒤흔들었다｡"
  },
  {
   "id": 46040,
   "key": "D1511le.txt:81",
   "file": "D1511le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "建築物を薙ぎ倒しながら、大地を転がる。",
   "ko_candidate": "건축물을 쓸어넘기며 대지를 굴러간다｡"
  },
  {
   "id": 46041,
   "key": "D1511le.txt:82",
   "file": "D1511le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舞い上がる瓦礫が、雨のように降り注ぎ、地表を穿っていた。",
   "ko_candidate": "날아오른 잔해가 비처럼 쏟아지며 지표를 파고들었다｡"
  },
  {
   "id": 46042,
   "key": "D1511le.txt:86",
   "file": "D1511le.txt",
   "line": 86,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「痛ぅ……だ、大丈夫か、ライカさん!?」",
   "ko_candidate": "「아파……괜､ 괜찮으세요､ 라이카 씨!?」"
  },
  {
   "id": 46043,
   "key": "D1511le.txt:90",
   "file": "D1511le.txt",
   "line": 90,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「は、はい……っ」",
   "ko_candidate": "「네､ 네……」"
  },
  {
   "id": 46044,
   "key": "D1511le.txt:93",
   "file": "D1511le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起き上がろうとするが、ダメージで各部機関の反応が、やや鈍い。",
   "ko_candidate": "일어나려 하지만 데미지로 각 부위 기관의 반응이 다소 둔하다｡"
  },
  {
   "id": 46045,
   "key": "D1511le.txt:94",
   "file": "D1511le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クソッ！　機体を僅かに起こした状態のまま、俺は次の術を施行する。",
   "ko_candidate": "젠장! 기체를 겨우 일으킨 상태 그대로 나는 다음 술식을"
  },
  {
   "id": 46046,
   "key": "D1511le.txt:98",
   "file": "D1511le.txt",
   "line": 98,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クトゥグア！　イタクァ！」",
   "ko_candidate": "시행한다｡ 「크투가! 이타콰!」"
  },
  {
   "id": 46047,
   "key": "D1511le.txt:107",
   "file": "D1511le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両掌に顕現する、黒の魔銃、銀の魔銃。",
   "ko_candidate": "양 손바닥에 나타나는 검은 마총､ 은빛 마총｡"
  },
  {
   "id": 46048,
   "key": "D1511le.txt:118",
   "file": "D1511le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "着地したばかりのリベル・レギスに向かって、連射する。",
   "ko_candidate": "착지한 지 얼마 안 된 리베르 레기스를 향해 연사한다｡"
  },
  {
   "id": 46049,
   "key": "D1511le.txt:120",
   "file": "D1511le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マズル・フラッシュが異界の闇を灼き、連続する銃声が雷鳴の如く轟く。",
   "ko_candidate": "머즐 플래시가 이계의 어둠을 태우고 연속되는 총성이 천둥소리처럼 울린다｡"
  },
  {
   "id": 46050,
   "key": "D1511le.txt:122",
   "file": "D1511le.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音速で飛翔する弾丸の雨が、衝撃波で建築物を罅割れさせながら、リベル・レギスを襲った。",
   "ko_candidate": "음속으로 날아가는 탄환의 비가 충격파로 건축물을 갈라지게 하며 리베르 레기스를 덮쳤다｡"
  },
  {
   "id": 46051,
   "key": "D1511le.txt:124",
   "file": "D1511le.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスは動かない。",
   "ko_candidate": "리베르 레기스는 움직이지 않는다｡"
  },
  {
   "id": 46052,
   "key": "D1511le.txt:128",
   "file": "D1511le.txt",
   "line": 128,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「殺ァァァァ…………疾ッ！」",
   "ko_candidate": "「죽여어어어어…………달려라앗!」"
  },
  {
   "id": 46053,
   "key": "D1511le.txt:138",
   "file": "D1511le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "裂帛の鬼迫と共に、リベル・レギスの両手の動きが神速の領域に達する。",
   "ko_candidate": "찢어질 듯한 괴성과 함께 리베르 레기스의 양손 움직임이 신속의 영역에 도달한다｡"
  },
  {
   "id": 46054,
   "key": "D1511le.txt:140",
   "file": "D1511le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "発射された弾丸すら視認する俺の動体視力を以ってしても、その速度についてこれない。",
   "ko_candidate": "발사된 탄환조차 식별하는 내 동체시력으로도 그 속도를 따라갈 수 없다｡"
  },
  {
   "id": 46055,
   "key": "D1511le.txt:142",
   "file": "D1511le.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ気付けば沈黙が場を支配し、まったく無傷のリベル・レギスが立っている。",
   "ko_candidate": "그저 깨달아보니 침묵이 장을 지배하고 완전히 무상한 리베르 레기스가 서 있다｡"
  },
  {
   "id": 46056,
   "key": "D1511le.txt:148",
   "file": "D1511le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスが両掌を開いた。",
   "ko_candidate": "리베르 레기스가 양 손바닥을 펼쳤다｡"
  },
  {
   "id": 46057,
   "key": "D1511le.txt:149",
   "file": "D1511le.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "零れ落ちる数十発の銃弾。",
   "ko_candidate": "흘러떨어지는 수십 발의 탄환｡"
  },
  {
   "id": 46058,
   "key": "D1511le.txt:155",
   "file": "D1511le.txt",
   "line": 155,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……馬鹿なっ!?」",
   "ko_candidate": "「……말도 안 돼!?」"
  },
  {
   "id": 46059,
   "key": "D1511le.txt:158",
   "file": "D1511le.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "全部、受け止めたぁ!?",
   "ko_candidate": "전부 받아냈어!?"
  },
  {
   "id": 46060,
   "key": "D1511le.txt:159",
   "file": "D1511le.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冗談じゃない。クトゥグアもイタクァもただデカイだけの銃じゃねえぞ。",
   "ko_candidate": "농담이 아니야｡ 크투가도 이타콰도 그저 크기만 큰 총이 아니라고｡"
  },
  {
   "id": 46061,
   "key": "D1511le.txt:160",
   "file": "D1511le.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの弾丸の一発一発、術が施された魔弾なんだ。",
   "ko_candidate": "저 탄환 하나하나에 술식이 걸린 마탄이라고｡"
  }
 ]
}