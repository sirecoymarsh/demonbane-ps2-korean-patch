 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "大十字": "다이쥬지",
  "瑠璃": "루리",
  "お嬢様": "아가씨",
  "ウィンフィールド": "윈필드",
  "九郎": "쿠로",
  "覇道瑠璃": "하도 루리",
  "覇道財閥": "하도 재벌"
 },
 "items": [
  {
   "id": 50218,
   "key": "ep_ruri01.txt:287",
   "file": "ep_ruri01.txt",
   "line": 287,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「簡単に割り切れる事ではありませんよ」",
   "ko_candidate": "「쉽게 정리할 수 있는 일이 아니에요」"
  },
  {
   "id": 50219,
   "key": "ep_ruri01.txt:291",
   "file": "ep_ruri01.txt",
   "line": 291,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だけど大十字さんは、もう……。 だいたい戻ってくるなら、扉が消えた時に……」",
   "ko_candidate": "「하지만 다이쥬지 씨는 이제…… 애초에 돌아오실 거라면 문이 사라졌을 때 ……」"
  },
  {
   "id": 50220,
   "key": "ep_ruri01.txt:296",
   "file": "ep_ruri01.txt",
   "line": 296,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「私は信じておりますよ」",
   "ko_candidate": "「저는 믿고 있어요」"
  },
  {
   "id": 50221,
   "key": "ep_ruri01.txt:303",
   "file": "ep_ruri01.txt",
   "line": 303,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？」",
   "ko_candidate": "「엣?」"
  },
  {
   "id": 50222,
   "key": "ep_ruri01.txt:307",
   "file": "ep_ruri01.txt",
   "line": 307,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「瑠璃お嬢様が信じておいでなら、私も信じるだけです」 「そもそも大十字様自身、常識の通用する方ではありませんから――」",
   "ko_candidate": "「루리 아가씨께서 믿고 계시다면､ 저도 그저 믿을 뿐입니다｡ 애초에 다이쥬지님 자신이 상식이 통하는 분이 아니니까요――」"
  },
  {
   "id": 50223,
   "key": "ep_ruri01.txt:321",
   "file": "ep_ruri01.txt",
   "line": 321,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………はぁ」",
   "ko_candidate": "「………………하아」"
  },
  {
   "id": 50224,
   "key": "ep_ruri01.txt:324",
   "file": "ep_ruri01.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ウィンフィールドが出て行ったのを確認して、私は机に突っ伏した。",
   "ko_candidate": "윈필드가 나가는 것을 확인하고､ 나는 책상에 엎드렸다｡"
  },
  {
   "id": 50225,
   "key": "ep_ruri01.txt:326",
   "file": "ep_ruri01.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頬をだらしなく机に預けたまま、動けないでいる。",
   "ko_candidate": "볼을 무기력하게 책상에 기댄 채､ 움직이지 못하고 있다｡"
  },
  {
   "id": 50226,
   "key": "ep_ruri01.txt:327",
   "file": "ep_ruri01.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "堆積した疲労は、重力に魅かれて、私の躰を拘束する。",
   "ko_candidate": "쌓인 피로가 중력에 이끌려 내 몸을 구속한다｡"
  },
  {
   "id": 50227,
   "key": "ep_ruri01.txt:329",
   "file": "ep_ruri01.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "心に降り積もる怠惰と憂鬱。",
   "ko_candidate": "마음에 쌓이는 나태와 우울｡"
  },
  {
   "id": 50228,
   "key": "ep_ruri01.txt:330",
   "file": "ep_ruri01.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして何より忌まわしい――諦観。",
   "ko_candidate": "그리고 무엇보다 불길한――체념｡"
  },
  {
   "id": 50229,
   "key": "ep_ruri01.txt:331",
   "file": "ep_ruri01.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "擦り切れていく心が怖い。",
   "ko_candidate": "닳아 없어지는 마음이 무섭다｡"
  },
  {
   "id": 50230,
   "key": "ep_ruri01.txt:335",
   "file": "ep_ruri01.txt",
   "line": 335,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「わたくし……そんなに我慢強い方ではありませんよ？」",
   "ko_candidate": "「저는… 그렇게 참을성 있는 편이 아니에요?」"
  },
  {
   "id": 50231,
   "key": "ep_ruri01.txt:338",
   "file": "ep_ruri01.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "指先でペンを転がしながら、拗ねてみる。",
   "ko_candidate": "손가락으로 펜을 굴리면서 삐져본다｡"
  },
  {
   "id": 50232,
   "key": "ep_ruri01.txt:342",
   "file": "ep_ruri01.txt",
   "line": 342,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「わたくしを何処の誰だと思っていますか？　覇道財閥の総帥、覇道瑠璃ですわよ？ とっても偉いんですわよ？ 畏れ多いですわよ？」 「それを、それを、こんなにも待たせてしまうなんて……本当、怖いもの知らずですね。九郎？」",
   "ko_candidate": "「저를 누구라고 생각하시나요? 하도 재벌의 총수､ 하도 루리예요? 아주 대단한 사람이에요? 두려워할 만한 사람이에요? 그런데､ 그런데､ 이렇게나 기다리게 하다니… 정말､ 무서운 줄 모르는군요｡ 쿠로?」"
  },
  {
   "id": 50233,
   "key": "ep_ruri01.txt:350",
   "file": "ep_ruri01.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "独りぼやいていると、沸々と怒りが湧いてきた。",
   "ko_candidate": "혼자 중얼거리다 보니 부글부글 화가 치밀어 올랐다｡"
  },
  {
   "id": 50234,
   "key": "ep_ruri01.txt:351",
   "file": "ep_ruri01.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……そうよ。",
   "ko_candidate": "…그래요｡"
  },
  {
   "id": 50235,
   "key": "ep_ruri01.txt:352",
   "file": "ep_ruri01.txt",
   "line": 352,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "なんで私ばかり、こんな想いをしなければならないの。 「帰ってきたら、じっくりと教育して差し上げませんと」",
   "ko_candidate": "왜 나만 이런 마음을 가져야 하는 거야｡"
  },
  {
   "id": 50236,
   "key": "ep_ruri01.txt:359",
   "file": "ep_ruri01.txt",
   "line": 359,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの人は……こっちが、しおらしくしていれば、何処までも調子に乗ってっ」 「……そうそう。そうでした。そうでしたわ。九郎は初めて出会った頃から、自分勝手な人でしたわ」",
   "ko_candidate": "「돌아오면､ 천천히 교육해 드려야겠어요｡ 그 사람은… 이쪽이 얌전히 있으면､ 어디까지나 기고만장해져서｡ …그래요｡ 그랬죠｡ 그랬어요｡ 쿠로는 처음 만났을 때부터､ 제멋대로인 사람이었어요｡ 제게 거역하는 것이 얼마나 무서운 일인지､ 깨닫게 해드리겠어요」"
  },
  {
   "id": 50237,
   "key": "ep_ruri01.txt:365",
   "file": "ep_ruri01.txt",
   "line": 365,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「わたくしに逆らう事がどれだけ恐ろしいことなのか、思い知らせてあげますっ」 ペンを強く強く……腕が震えるほど、強く握り締めていた。",
   "ko_candidate": "펜을 세게 세게… 팔이 떨릴 정도로 세게 움켜쥐고 있었다｡"
  },
  {
   "id": 50238,
   "key": "ep_ruri01.txt:370",
   "file": "ep_ruri01.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ベキッと嫌な音を立てる。",
   "ko_candidate": "뻑 하고 싫은 소리를 낸다｡"
  },
  {
   "id": 50239,
   "key": "ep_ruri01.txt:372",
   "file": "ep_ruri01.txt",
   "line": 372,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ひとしきり怒ると、何だか力が抜けてきた。",
   "ko_candidate": "한바탕 화를 내고 나니､ 왠지 힘이 빠져왔다｡"
  },
  {
   "id": 50240,
   "key": "ep_ruri01.txt:373",
   "file": "ep_ruri01.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "壊れたペンは手のひらから落ちて、机の上を転がる。",
   "ko_candidate": "부서진 펜은 손바닥에서 떨어져 책상 위를 굴러간다｡"
  },
  {
   "id": 50241,
   "key": "ep_ruri01.txt:384",
   "file": "ep_ruri01.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――何を熱くなっているんだ、私は。",
   "ko_candidate": "――뭘 열을 올리고 있는 거야､ 나는｡"
  },
  {
   "id": 50242,
   "key": "ep_ruri01.txt:386",
   "file": "ep_ruri01.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何故、あんな薄情な男に其処まで拘る必要がある？",
   "ko_candidate": "왜 그런 무정한 남자에게 그토록 집착할 필요가 있어?"
  },
  {
   "id": 50243,
   "key": "ep_ruri01.txt:387",
   "file": "ep_ruri01.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうだ、馬鹿馬鹿しい。",
   "ko_candidate": "그래､ 바보 같아｡"
  },
  {
   "id": 50244,
   "key": "ep_ruri01.txt:388",
   "file": "ep_ruri01.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "九郎のことなど、忘れて、人生を楽しめば良いではないか。",
   "ko_candidate": "쿠로 따위는 잊어버리고､ 인생을 즐기면 되잖아｡"
  },
  {
   "id": 50245,
   "key": "ep_ruri01.txt:394",
   "file": "ep_ruri01.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "机を両手で叩いて、一気に身を起こす。",
   "ko_candidate": "책상을 양손으로 치며､ 단숨에 몸을 일으킨다｡"
  },
  {
   "id": 50246,
   "key": "ep_ruri01.txt:395",
   "file": "ep_ruri01.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自らを奮い立たせるように、握り拳を振り上げながら、誰に向けてでもなく宣言する。",
   "ko_candidate": "스스로를 격려하듯이､ 주먹을 들어 올리며､ 누구를 향해서도 아닌 듯 선언한다｡"
  },
  {
   "id": 50247,
   "key": "ep_ruri01.txt:399",
   "file": "ep_ruri01.txt",
   "line": 399,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうですわ！　あんな程度の男に縛られて、この美貌と才覚を腐らせておくのは人類の損失ですもの！」 「ええ！　もう九郎なんて知りません！　あんな男、ゴミのようにポポーイッと棄ててやりますわ！」",
   "ko_candidate": "「그래요! 그 정도 남자에게 얽매여､ 이 미모와 재주를 썩히는 건 인류의 손실이에요! 네! 이제 쿠로 따위 모르겠어요! 그런 남자､ 쓰레기처럼 휙 버려버릴 거예요!」"
  },
  {
   "id": 50248,
   "key": "ep_ruri01.txt:405",
   "file": "ep_ruri01.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "回れ右。",
   "ko_candidate": "뒤돌아선다｡"
  },
  {
   "id": 50249,
   "key": "ep_ruri01.txt:406",
   "file": "ep_ruri01.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "背後の窓に向かって、歩き出す。",
   "ko_candidate": "뒤쪽 창문을 향해 걸어간다｡"
  },
  {
   "id": 50250,
   "key": "ep_ruri01.txt:407",
   "file": "ep_ruri01.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "街を見下ろしながら、大声で",
   "ko_candidate": "거리를 내려다보며､ 큰 소리로"
  },
  {
   "id": 50251,
   "key": "ep_ruri01.txt:411",
   "file": "ep_ruri01.txt",
   "line": 411,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎の馬鹿ぁぁぁぁぁぁぁぁぁ――――――っ！」",
   "ko_candidate": "「쿠로 바보아아아아아아아아아――――――앗!」"
  },
  {
   "id": 50252,
   "key": "ep_ruri01.txt:416",
   "file": "ep_ruri01.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "叫んだ。",
   "ko_candidate": "외쳤다｡"
  },
  {
   "id": 50253,
   "key": "ep_ruri01.txt:417",
   "file": "ep_ruri01.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "力の限り叫んだ。",
   "ko_candidate": "있는 힘껏 외쳤다｡"
  },
  {
   "id": 50254,
   "key": "ep_ruri01.txt:419",
   "file": "ep_ruri01.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "誰かに聴かれていたら、脳の心配されるのは間違いなしだったけど、構わず叫んだ。",
   "ko_candidate": "누군가에게 들렸다면､ 정신 상태를 걱정받았을 게 틀림없지만､ 아랑곳하지 않고 외쳤다｡"
  },
  {
   "id": 50255,
   "key": "ep_ruri01.txt:421",
   "file": "ep_ruri01.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "息が続く限り叫んだ。",
   "ko_candidate": "숨이 이어지는 한 외쳤다｡"
  },
  {
   "id": 50256,
   "key": "ep_ruri01.txt:422",
   "file": "ep_ruri01.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "息が途切れても、無理矢理に振り絞って叫んだ。",
   "ko_candidate": "숨이 끊어져도､ 억지로 짜내어 외쳤다｡"
  },
  {
   "id": 50257,
   "key": "ep_ruri01.txt:424",
   "file": "ep_ruri01.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "力の限り、叫んだ。",
   "ko_candidate": "있는 힘껏､ 외쳤다｡"
  }
 ]
}