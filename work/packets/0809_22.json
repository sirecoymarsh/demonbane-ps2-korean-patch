 },
 "items": [
  {
   "id": 15222,
   "key": "D0809ru.txt:242",
   "file": "D0809ru.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何で俺は、戦っているんだろう……？",
   "ko_candidate": "왜 나는 싸우고 있는 걸까…?"
  },
  {
   "id": 15223,
   "key": "D0809ru.txt:244",
   "file": "D0809ru.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しばらく悩んで考えて……結局、出てきた答えは、いつもと同じだった。",
   "ko_candidate": "잠시 고민하고 생각해보니… 결국 나온 답은 언제나와 같았다｡"
  },
  {
   "id": 15224,
   "key": "D0809ru.txt:247",
   "file": "D0809ru.txt",
   "line": 247,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「後味悪ィ思いをしたくない……からかな？」",
   "ko_candidate": "「찝찝한 기분을 느끼고 싶지 않아서… 일까?」"
  },
  {
   "id": 15225,
   "key": "D0809ru.txt:253",
   "file": "D0809ru.txt",
   "line": 253,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……後味悪い？」",
   "ko_candidate": "「…찝찝한 기분?」"
  },
  {
   "id": 15226,
   "key": "D0809ru.txt:256",
   "file": "D0809ru.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "きょとんとする姫さんに、俺は頷いた。",
   "ko_candidate": "어리둥절한 공주에게 나는 고개를 끄덕였다｡"
  },
  {
   "id": 15227,
   "key": "D0809ru.txt:259",
   "file": "D0809ru.txt",
   "line": 259,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「結局さ。自分に出来ることがあって、だけどそれをしないでだ。そのせいで誰かが酷い目に遭ったりしたら……すげぇ後味悪ィだろ？」 「そういうのは嫌だなってさ。だってこの後、ずぅぅぅぅぅぅと、あの時ああしていれば、って後悔する羽目になるんだぜ？　俺には重過ぎるよ」",
   "ko_candidate": "「결국 말이야｡ 자신이 할 수 있는 일이 있는데 그걸 하지 않아서 말이야｡ 그 때문에 누군가가 심한 꼴을 당한다면… 엄청 찝찝하지 않겠어? 그런 건 싫다고｡ 그러면 이후에 계속 그때 그렇게 했더라면 하고 후회하게 될 텐데? 나로서는 너무 무거워」"
  },
  {
   "id": 15228,
   "key": "D0809ru.txt:267",
   "file": "D0809ru.txt",
   "line": 267,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんな理由だけで……？」 「んー……まあ、ちゃんと考えたら他にもあるんだろうけど」",
   "ko_candidate": "「그런 이유만으로…?」"
  },
  {
   "id": 15229,
   "key": "D0809ru.txt:274",
   "file": "D0809ru.txt",
   "line": 274,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だけど結局はそういうことになるんじゃないかな？」 「人間やっぱり、自分に出来る全力を尽くしたいって、思ったことのない奴ってのはそうそう居ねぇんじゃないかな？」",
   "ko_candidate": "「음- …뭐､ 제대로 생각해보면 다른 것도 있겠지｡ 하지만 결국은 그런 거 아닐까? 인간이란 역시 자신이 할 수 있는 최선을 다하고 싶다고 생각해본 적 없는 사람은 그리 많지 않을 거야」"
  },
  {
   "id": 15230,
   "key": "D0809ru.txt:281",
   "file": "D0809ru.txt",
   "line": 281,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 15231,
   "key": "D0809ru.txt:285",
   "file": "D0809ru.txt",
   "line": 285,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それが俺にはたまたま魔術で、『ブラックロッジ』と戦うことだった……ただ単にそれだけだと思うぜ」",
   "ko_candidate": "「그게 내게는 우연히 마술로､ '블랙로지'와 싸우는 일이었을 뿐… 단순히 그뿐이라고 생각해」"
  },
  {
   "id": 15232,
   "key": "D0809ru.txt:289",
   "file": "D0809ru.txt",
   "line": 289,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「死ぬかも知れないのにですか？　こんなに怖い事なのにですか？」",
   "ko_candidate": "「죽을지도 모르는데요? 이렇게 무서운 일인데요?」"
  },
  {
   "id": 15233,
   "key": "D0809ru.txt:293",
   "file": "D0809ru.txt",
   "line": 293,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だって……んなこと言ったら、姫さんだってそうじゃないか」",
   "ko_candidate": "「그렇지만… 그렇게 말하면 공주도 마찬가지잖아」"
  },
  {
   "id": 15234,
   "key": "D0809ru.txt:299",
   "file": "D0809ru.txt",
   "line": 299,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣…?」"
  },
  {
   "id": 15235,
   "key": "D0809ru.txt:302",
   "file": "D0809ru.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても驚愕に凍りつく姫さん。",
   "ko_candidate": "또다시 경악에 얼어붙는 공주｡"
  },
  {
   "id": 15236,
   "key": "D0809ru.txt:303",
   "file": "D0809ru.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やっぱり自分のことは気づき難いものなのだろうか？",
   "ko_candidate": "역시 자신의 일은 깨닫기 어려운 걸까?"
  },
  {
   "id": 15237,
   "key": "D0809ru.txt:304",
   "file": "D0809ru.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は力強く頷いて、答えた。",
   "ko_candidate": "나는 힘차게 고개를 끄덕이며 대답했다｡"
  },
  {
   "id": 15238,
   "key": "D0809ru.txt:307",
   "file": "D0809ru.txt",
   "line": 307,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だって姫さんだって、何もかも投げ捨てて逃げたいって言ってたのに……結局、今も戦ってるじゃないか。俺とは違う形だけど――ちゃんと『覇道瑠璃』として、戦い続けているじゃないか」",
   "ko_candidate": "「공주도 모든 걸 내던지고 도망가고 싶다고 했으면서… 결국 지금도 싸우고 있잖아｡ 나와는 다른 형태지만 - 제대로 '하도 루리'로서 계속 싸우고 있잖아」"
  },
  {
   "id": 15239,
   "key": "D0809ru.txt:311",
   "file": "D0809ru.txt",
   "line": 311,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――あ」",
   "ko_candidate": "「------아」"
  },
  {
   "id": 15240,
   "key": "D0809ru.txt:314",
   "file": "D0809ru.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの瞳が、更なる驚きに見開かれた。",
   "ko_candidate": "공주님의 눈동자가 더욱 놀라움에 크게 떠졌다｡"
  },
  {
   "id": 15241,
   "key": "D0809ru.txt:315",
   "file": "D0809ru.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その場で完全に硬直し……そのまま沈黙してしまう。",
   "ko_candidate": "그 자리에서 완전히 굳어버리고… 그대로 침묵해 버린다｡"
  },
  {
   "id": 15242,
   "key": "D0809ru.txt:318",
   "file": "D0809ru.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黙って見つめ合う俺たちを夕陽が照らす。",
   "ko_candidate": "말없이 서로를 바라보는 우리를 석양이 비춘다｡"
  },
  {
   "id": 15243,
   "key": "D0809ru.txt:319",
   "file": "D0809ru.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故だろう。夕陽に照らされる姫さんの頬が……心なしか、もっと濃い紅に染まった……そんな気がした。",
   "ko_candidate": "왜일까｡ 석양에 비치는 공주님의 뺨이… 기분 탓인지､ 더욱 짙은 홍조를 띤 것 같은… 그런 느낌이 들었다｡"
  }
 ]
}