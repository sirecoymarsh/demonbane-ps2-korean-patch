   "line": 363,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……今までの大導師の行動を思い返すが良い」",
   "ko_candidate": "「무슨 소리다?」"
  },
  {
   "id": 15836,
   "key": "D0811al.txt:365",
