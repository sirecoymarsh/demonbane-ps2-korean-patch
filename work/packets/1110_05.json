 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "瑠璃": "루리",
  "アル": "알",
  "デウス・マキナ": "데우스 마키나",
  "クラーケン": "크라켄",
  "術式": "술식",
  "魔力": "마력",
  "九郎": "쿠로",
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 25754,
   "key": "D1110ru.txt:532",
   "file": "D1110ru.txt",
   "line": 532,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「小娘、逃げるぞ。彼奴の隙を突くまでの間、もう少し我慢していろ」",
   "ko_candidate": "「꼬마､ 도망치자｡ 그놈의 틈을 노릴 때까지､ 조금만 더 참아라」"
  },
  {
   "id": 25755,
   "key": "D1110ru.txt:535",
   "file": "D1110ru.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの、総ての操作を受け持つ決心をした。",
   "ko_candidate": "데몬베인의､ 모든 조작을 맡기로 결심했다｡"
  },
  {
   "id": 25756,
   "key": "D1110ru.txt:537",
   "file": "D1110ru.txt",
   "line": 537,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞥もくれず、瑠璃に告げる。",
   "ko_candidate": "한 번의 눈길도 주지 않고､ 루리에게 말한다｡"
  },
  {
   "id": 25757,
   "key": "D1110ru.txt:539",
   "file": "D1110ru.txt",
   "line": 539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが。",
   "ko_candidate": "하지만｡"
  },
  {
   "id": 25758,
   "key": "D1110ru.txt:544",
   "file": "D1110ru.txt",
   "line": 544,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いえ」",
   "ko_candidate": "「아니요」"
  },
  {
   "id": 25759,
   "key": "D1110ru.txt:547",
   "file": "D1110ru.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "返って来たのは拒絶。",
   "ko_candidate": "돌아온 것은 거절이었다｡"
  },
  {
   "id": 25760,
   "key": "D1110ru.txt:555",
   "file": "D1110ru.txt",
   "line": 555,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「小娘？」",
   "ko_candidate": "「꼬마?」"
  },
  {
   "id": 25761,
   "key": "D1110ru.txt:562",
   "file": "D1110ru.txt",
   "line": 562,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……退きません。戦います」",
   "ko_candidate": "「……물러나지 않겠습니다｡ 싸우겠습니다」"
  },
  {
   "id": 25762,
   "key": "D1110ru.txt:567",
   "file": "D1110ru.txt",
   "line": 567,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「意地だけは立派だがな。もはや鍍金も剥がれ始めている。 やはり汝には無理だ」",
   "ko_candidate": "「고집만은 훌륭하군｡ 이제 도금도 벗겨지기 시작했어｡ 역시 네겐 무리다」"
  },
  {
   "id": 25763,
   "key": "D1110ru.txt:572",
   "file": "D1110ru.txt",
   "line": 572,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは苛立っていた。",
   "ko_candidate": "알은 초조해하고 있었다｡"
  },
  {
   "id": 25764,
   "key": "D1110ru.txt:573",
   "file": "D1110ru.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デウス・マキナを相手にして、言い争っている暇など一瞬たりとも無い。",
   "ko_candidate": "데우스 마키나를 상대로､ 말다툼할 시간 따위는 일순간도 없다｡"
  },
  {
   "id": 25765,
   "key": "D1110ru.txt:575",
   "file": "D1110ru.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "有無を言わさず、はっきりと宣告する。",
   "ko_candidate": "이유를 묻지 않고､ 분명히 선고한다｡"
  },
  {
   "id": 25766,
   "key": "D1110ru.txt:577",
   "file": "D1110ru.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これ以上の無駄は避けなければならないのだ。",
   "ko_candidate": "이 이상의 낭비는 피해야만 한다｡"
  },
  {
   "id": 25767,
   "key": "D1110ru.txt:579",
   "file": "D1110ru.txt",
   "line": 579,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが。",
   "ko_candidate": "하지만｡"
  },
  {
   "id": 25768,
   "key": "D1110ru.txt:583",
   "file": "D1110ru.txt",
   "line": 583,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いいえ。戦います」",
   "ko_candidate": "「아니에요｡ 싸우겠습니다」"
  },
  {
   "id": 25769,
   "key": "D1110ru.txt:588",
   "file": "D1110ru.txt",
   "line": 588,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「小娘！　いい加減にしろ！」",
   "ko_candidate": "「꼬마! 적당히 해라!」"
  },
  {
   "id": 25770,
   "key": "D1110ru.txt:592",
   "file": "D1110ru.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遂に切れたか、アルは瑠璃を振り向いて、一喝する。",
   "ko_candidate": "마침내 화가 났는지､ 알은 루리를 돌아보며､ 호통쳤다｡"
  },
  {
   "id": 25771,
   "key": "D1110ru.txt:593",
   "file": "D1110ru.txt",
   "line": 593,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞬間――",
   "ko_candidate": "그 순간――"
  },
  {
   "id": 25772,
   "key": "D1110ru.txt:597",
   "file": "D1110ru.txt",
   "line": 597,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何？」",
   "ko_candidate": "「……뭐지?」"
  },
  {
   "id": 25773,
   "key": "D1110ru.txt:600",
   "file": "D1110ru.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインが動いた。",
   "ko_candidate": "데몬베인이 움직였다｡"
  },
  {
   "id": 25774,
   "key": "D1110ru.txt:607",
   "file": "D1110ru.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀の柄を両手で握り、正眼に構える。",
   "ko_candidate": "바르자이의 언월도 손잡이를 양손으로 잡고､ 정면으로 겨눈다｡"
  },
  {
   "id": 25775,
   "key": "D1110ru.txt:609",
   "file": "D1110ru.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剣先は真っ直ぐと、クラーケンへ。",
   "ko_candidate": "검끝은 똑바로､ 크라켄을 향해｡"
  },
  {
   "id": 25776,
   "key": "D1110ru.txt:614",
   "file": "D1110ru.txt",
   "line": 614,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「小娘……汝」",
   "ko_candidate": "「꼬마……너」"
  },
  {
   "id": 25777,
   "key": "D1110ru.txt:618",
   "file": "D1110ru.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "術式に流される事無く、デモンベインに操られる事無く、それは真の意味で初めての、瑠璃の意思による操縦だった。",
   "ko_candidate": "술식에 휩쓸리지 않고､ 데몬베인에 조종당하지 않고､ 그것은 진정한 의미에서 처음으로､ 루리의 의지에 의한 조종이었다｡"
  },
  {
   "id": 25778,
   "key": "D1110ru.txt:620",
   "file": "D1110ru.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かな、澄み切った魔力の波動がデモンベインの隅々へ、偃月刀の剣先にまで行き渡る。",
   "ko_candidate": "고요한､ 맑디맑은 마력의 파동이 데몬베인의 구석구석으로､ 언월도의 검끝까지 퍼져나간다｡"
  },
  {
   "id": 25779,
   "key": "D1110ru.txt:622",
   "file": "D1110ru.txt",
   "line": 622,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳を閉じる。",
   "ko_candidate": "눈을 감는다｡"
  },
  {
   "id": 25780,
   "key": "D1110ru.txt:623",
   "file": "D1110ru.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞼の裏に灼きついた、倒れる九郎の姿。",
   "ko_candidate": "눈꺼풀 뒤에 새겨진､ 쓰러지는 쿠로의 모습｡"
  },
  {
   "id": 25781,
   "key": "D1110ru.txt:629",
   "file": "D1110ru.txt",
   "line": 629,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弱々しい命の鼓動。",
   "ko_candidate": "약한 생명의 고동｡"
  },
  {
   "id": 25782,
   "key": "D1110ru.txt:630",
   "file": "D1110ru.txt",
   "line": 630,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女がもたらした結果。",
   "ko_candidate": "그녀가 초래한 결과｡"
  },
  {
   "id": 25783,
   "key": "D1110ru.txt:632",
   "file": "D1110ru.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、灼きついている九郎の姿はそれだけでは無い。",
   "ko_candidate": "하지만､ 새겨진 쿠로의 모습은 그것뿐만이 아니다｡"
  },
  {
   "id": 25784,
   "key": "D1110ru.txt:636",
   "file": "D1110ru.txt",
   "line": 636,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「遠くから……わたくしはずっと見ていました」",
   "ko_candidate": "「멀리서……저는 줄곧 보고 있었습니다」"
  },
  {
   "id": 25785,
   "key": "D1110ru.txt:641",
   "file": "D1110ru.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――戦う大十字九郎の姿。",
   "ko_candidate": "――싸우는 다이쥬지 쿠로의 모습｡"
  },
  {
   "id": 25786,
   "key": "D1110ru.txt:645",
   "file": "D1110ru.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒き法衣に身を包み、駈ける九郎の姿。",
   "ko_candidate": "검은 법의를 걸치고､ 달리는 쿠로의 모습｡"
  },
  {
   "id": 25787,
   "key": "D1110ru.txt:646",
   "file": "D1110ru.txt",
   "line": 646,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを操り、駆ける九郎の姿。",
   "ko_candidate": "데몬베인을 조종하며､ 달리는 쿠로의 모습｡"
  },
  {
   "id": 25788,
   "key": "D1110ru.txt:650",
   "file": "D1110ru.txt",
   "line": 650,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……見ているだけでした」",
   "ko_candidate": "「……보고만 있었습니다」"
  },
  {
   "id": 25789,
   "key": "D1110ru.txt:655",
   "file": "D1110ru.txt",
   "line": 655,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を流しながら、なお戦う九郎の姿。",
   "ko_candidate": "피를 흘리면서도､ 여전히 싸우는 쿠로의 모습｡"
  },
  {
   "id": 25790,
   "key": "D1110ru.txt:656",
   "file": "D1110ru.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斃れ、起き上がり、なお戦う九郎の姿。",
   "ko_candidate": "쓰러지고､ 일어나､ 여전히 싸우는 쿠로의 모습｡"
  },
  {
   "id": 25791,
   "key": "D1110ru.txt:657",
   "file": "D1110ru.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 25792,
   "key": "D1110ru.txt:661",
   "file": "D1110ru.txt",
   "line": 661,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦いながら、傷つきながら、なお笑う、そんな九郎の強さ。",
   "ko_candidate": "싸우면서､ 상처 입으면서도､ 여전히 웃는､ 그런 쿠로의 강함｡"
  },
  {
   "id": 25793,
   "key": "D1110ru.txt:663",
   "file": "D1110ru.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "灼きついている。",
   "ko_candidate": "새겨져 있다｡"
  }
 ]
}