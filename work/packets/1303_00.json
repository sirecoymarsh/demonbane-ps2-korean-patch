 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "サンダルフォン": "산달폰",
  "メタトロン": "메타트론"
 },
 "items": [
  {
   "id": 31461,
   "key": "D1303al.txt:11",
   "file": "D1303al.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の刃が走る。",
   "ko_candidate": "빛의 칼날이 달린다｡"
  },
  {
   "id": 31462,
   "key": "D1303al.txt:12",
   "file": "D1303al.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "拳から衝撃が迸る。",
   "ko_candidate": "주먹에서 충격이 뿜어져 나온다｡"
  },
  {
   "id": 31463,
   "key": "D1303al.txt:20",
   "file": "D1303al.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "交差する光と闇。",
   "ko_candidate": "빛과 어둠이 교차한다｡"
  },
  {
   "id": 31464,
   "key": "D1303al.txt:28",
   "file": "D1303al.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "交差する白と黒。",
   "ko_candidate": "흰색과 검은색이 교차한다｡"
  },
  {
   "id": 31465,
   "key": "D1303al.txt:30",
   "file": "D1303al.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天使達の死闘の舞台は地上に移っていた。",
   "ko_candidate": "천사들의 사투의 무대는 지상으로 옮겨졌다｡"
  },
  {
   "id": 31466,
   "key": "D1303al.txt:32",
   "file": "D1303al.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "螺旋となって空へと昇る両雄。",
   "ko_candidate": "나선을 그리며 하늘로 오르는 두 영웅｡"
  },
  {
   "id": 31467,
   "key": "D1303al.txt:43",
   "file": "D1303al.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "極限まで高まった力と力が爆砕した。弾かれて、互いに違うビルの屋上に立ち、対峙する。",
   "ko_candidate": "극한까지 고조된 힘과 힘이 폭발했다｡ 튕겨나가 서로 다른 빌딩 옥상에 서서 대치한다｡"
  },
  {
   "id": 31468,
   "key": "D1303al.txt:47",
   "file": "D1303al.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンが左目を押さえながら呟いた。",
   "ko_candidate": "산달폰이 왼쪽 눈을 누르며 중얼거렸다｡"
  },
  {
   "id": 31469,
   "key": "D1303al.txt:51",
   "file": "D1303al.txt",
   "line": 51,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ははっ……傷が疼く。お前と対峙するたび、疼きが酷くなる」 「痛む……酷く痛むぞ……ッ！　なんて……なんて心地好い憎悪の疼きだ！」",
   "ko_candidate": "「하하……상처가 쑤신다｡ 너와 대치할 때마다 쑤시는 게 더 심해진다｡ 아파……엄청 아프다……! 이런……이런 기분 좋은 증오의 쑤심이라니!」"
  },
  {
   "id": 31470,
   "key": "D1303al.txt:72",
   "file": "D1303al.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの立つビルが、メタトロンのカノン砲に撃ち抜かれ、倒壊する。",
   "ko_candidate": "산달폰이 서 있던 빌딩이 메타트론의 캐논포에 맞아 무너진다｡"
  },
  {
   "id": 31471,
   "key": "D1303al.txt:77",
   "file": "D1303al.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンは即座に飛び立った。",
   "ko_candidate": "산달폰은 즉시 날아올랐다｡"
  },
  {
   "id": 31472,
   "key": "D1303al.txt:78",
   "file": "D1303al.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンも合わせて飛び立つ。",
   "ko_candidate": "메타트론도 함께 날아오른다｡"
  },
  {
   "id": 31473,
   "key": "D1303al.txt:82",
   "file": "D1303al.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "広がる黒の翼。",
   "ko_candidate": "펼쳐지는 검은 날개｡"
  },
  {
   "id": 31474,
   "key": "D1303al.txt:88",
   "file": "D1303al.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "広がる白の翼。",
   "ko_candidate": "펼쳐지는 흰 날개｡"
  },
  {
   "id": 31475,
   "key": "D1303al.txt:94",
   "file": "D1303al.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇を孕み、大気を震わせる黒の拳。",
   "ko_candidate": "어둠을 품고 대기를 진동시키는 검은 주먹｡"
  },
  {
   "id": 31476,
   "key": "D1303al.txt:100",
   "file": "D1303al.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光を放ち、大気を引き裂く白の剣。",
   "ko_candidate": "빛을 발하며 대기를 찢는 흰 검｡"
  },
  {
   "id": 31477,
   "key": "D1303al.txt:108",
   "file": "D1303al.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃の衝突。",
   "ko_candidate": "충격의 충돌｡"
  },
  {
   "id": 31478,
   "key": "D1303al.txt:109",
   "file": "D1303al.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両雄、体勢を崩し、錐揉みに大地に墜落する。",
   "ko_candidate": "두 영웅､ 자세가 무너져 회전하며 대지로 추락한다｡"
  },
  {
   "id": 31479,
   "key": "D1303al.txt:113",
   "file": "D1303al.txt",
   "line": 113,
   "speaker": "メタトロン＆サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ！」",
   "ko_candidate": "「큿!」"
  },
  {
   "id": 31480,
   "key": "D1303al.txt:122",
   "file": "D1303al.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "脇腹を裂かれたサンダルフォン。",
   "ko_candidate": "옆구리가 찢긴 산달폰｡"
  },
  {
   "id": 31481,
   "key": "D1303al.txt:123",
   "file": "D1303al.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲は切断され、その狭間から血が滴り落ちる。",
   "ko_candidate": "장갑이 절단되어 그 틈새로 피가 떨어진다｡"
  },
  {
   "id": 31482,
   "key": "D1303al.txt:132",
   "file": "D1303al.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鳩尾を撃たれたメタトロン。",
   "ko_candidate": "명치를 맞은 메타트론｡"
  },
  {
   "id": 31483,
   "key": "D1303al.txt:133",
   "file": "D1303al.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲の中心は窪み罅割れ、声も無くメタトロンは咳き込む。",
   "ko_candidate": "장갑의 중심이 움푹 패이고 갈라져 메타트론은 소리 없이 기침한다｡"
  },
  {
   "id": 31484,
   "key": "D1303al.txt:138",
   "file": "D1303al.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "立ち上がるのは同時。",
   "ko_candidate": "일어서는 것은 동시에｡"
  },
  {
   "id": 31485,
   "key": "D1303al.txt:144",
   "file": "D1303al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳を構える。",
   "ko_candidate": "주먹을 구성한다｡"
  },
  {
   "id": 31486,
   "key": "D1303al.txt:152",
   "file": "D1303al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剣を構える。",
   "ko_candidate": "검을 구성한다｡"
  },
  {
   "id": 31487,
   "key": "D1303al.txt:153",
   "file": "D1303al.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静止。",
   "ko_candidate": "정지｡"
  },
  {
   "id": 31488,
   "key": "D1303al.txt:155",
   "file": "D1303al.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ対峙するだけで、双方の負ったダメージはそれぞれの体力を消耗させる。",
   "ko_candidate": "단순히 대치하는 것만으로도 양측이 입은 데미지는 각자의 체력을 소모시킨다｡"
  },
  {
   "id": 31489,
   "key": "D1303al.txt:157",
   "file": "D1303al.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかし即座に仕掛けられるほどの隙を、お互い見い出すことが出来ない。 焦燥に駆り立てられながら、",
   "ko_candidate": "하지만 즉시 공격할 만한 틈을 서로 찾아낼 수 없다｡"
  },
  {
   "id": 31490,
   "key": "D1303al.txt:164",
   "file": "D1303al.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでもサンダルフォンは笑った。",
   "ko_candidate": "초조함에 휩싸이면서도 산달폰은 웃었다｡"
  },
  {
   "id": 31491,
   "key": "D1303al.txt:165",
   "file": "D1303al.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己の敵に語りかける。",
   "ko_candidate": "자신의 적에게 말을 건다｡"
  },
  {
   "id": 31492,
   "key": "D1303al.txt:169",
   "file": "D1303al.txt",
   "line": 169,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「愉しいな、メタトロン」",
   "ko_candidate": "「즐겁구나､ 메타트론」"
  },
  {
   "id": 31493,
   "key": "D1303al.txt:173",
   "file": "D1303al.txt",
   "line": 173,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「私は愉しくなどない」",
   "ko_candidate": "「나는 즐겁지 않다」"
  },
  {
   "id": 31494,
   "key": "D1303al.txt:178",
   "file": "D1303al.txt",
   "line": 178,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「相変わらずノリの悪い奴だ」",
   "ko_candidate": "「여전히 노리가 나쁜 녀석이군」"
  },
  {
   "id": 31495,
   "key": "D1303al.txt:182",
   "file": "D1303al.txt",
   "line": 182,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「戦いに愉悦を感じるほど下衆ではない」",
   "ko_candidate": "「싸움에 쾌감을 느낄 만큼 천박하지 않다」"
  },
  {
   "id": 31496,
   "key": "D1303al.txt:186",
   "file": "D1303al.txt",
   "line": 186,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「己を殺したお前が何を言うか」",
   "ko_candidate": "「자신을 죽인 네가 무슨 말을 하는가」"
  },
  {
   "id": 31497,
   "key": "D1303al.txt:189",
   "file": "D1303al.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "笑いは途切れ、殺意が濃度を増す。",
   "ko_candidate": "웃음은 끊기고 살의가 농도를 더한다｡"
  },
  {
   "id": 31498,
   "key": "D1303al.txt:198",
   "file": "D1303al.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "メタトロンは、それを正面から受け止めながらも、 怯えを見せなかった。",
   "ko_candidate": "메타트론은 그것을 정면으로 받아들이면서도 두려움을 보이지 않았다｡"
  },
  {
   "id": 31499,
   "key": "D1303al.txt:201",
   "file": "D1303al.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。怯えは無い。",
   "ko_candidate": "그래｡ 두려움은 없다｡"
  },
  {
   "id": 31500,
   "key": "D1303al.txt:202",
   "file": "D1303al.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在るのは苦みと、痛みと。",
   "ko_candidate": "있는 것은 쓰라림과 아픔과｡"
  }
 ]
}