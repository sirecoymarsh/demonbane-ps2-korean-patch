 "items": [
  {
   "id": 36656,
   "key": "D1402ru.txt:174",
   "file": "D1402ru.txt",
   "line": 174,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「哀しい悪足掻きだな！」",
   "ko_candidate": "「애처로운 발버둥이구나!」"
  },
  {
   "id": 36657,
   "key": "D1402ru.txt:182",
   "file": "D1402ru.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "四方八方より、迫り来る触腕。",
   "ko_candidate": "사방팔방에서 다가오는 촉수｡"
  },
  {
   "id": 36658,
   "key": "D1402ru.txt:186",
   "file": "D1402ru.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "横を通り過ぎるだけで爆風がデモンベインを吹き飛ばす。",
   "ko_candidate": "옆을 스쳐 지나가는 것만으로도 폭풍이 데몬베인을 날려버린다｡"
  },
  {
   "id": 36659,
   "key": "D1402ru.txt:188",
   "file": "D1402ru.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……こんなものに捕まったら、こっちは一発で粉微塵だ。",
   "ko_candidate": "…이런 것에 잡히면 이쪽은 한방에 산산조각 나겠지｡"
  },
  {
   "id": 36660,
   "key": "D1402ru.txt:189",
   "file": "D1402ru.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "たかが触腕の一本でも、この脅威。戦力差は絶望的だった。",
   "ko_candidate": "고작 촉수 하나로도 이런 위협｡ 전력 차는 절망적이었다｡"
  },
  {
   "id": 36661,
   "key": "D1402ru.txt:190",
   "file": "D1402ru.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが勝ち目がないワケではない。",
   "ko_candidate": "하지만 이길 가능성이 없는 건 아니다｡"
  },
  {
   "id": 36662,
   "key": "D1402ru.txt:198",
   "file": "D1402ru.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正面からやり合うのは無理でも――神を降ろした器",
   "ko_candidate": "정면으로 맞붙는 건 무리여도 - 신을 내린 그릇 『몽환심모』는"
  },
  {
   "id": 36663,
   "key": "D1402ru.txt:199",
   "file": "D1402ru.txt",
   "line": 199,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『夢幻心母』はあくまでヒトが造り出したものだ。 邪神の肉を纏ったあの城に突入して、中枢を破壊する。",
   "ko_candidate": "어디까지나 인간이 만들어낸 것이다｡"
  },
  {
   "id": 36664,
   "key": "D1402ru.txt:201",
   "file": "D1402ru.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうすれば神を祓うことが出来るはずなんだ。",
   "ko_candidate": "사신의 살을 두른 저 성에 돌입해서 중추를 파괴한다｡"
  },
  {
   "id": 36665,
   "key": "D1402ru.txt:203",
   "file": "D1402ru.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だから、何としてもクトゥルーの頭頂部、埋もれるように聳える、あの要塞に辿り着かなければ。",
   "ko_candidate": "그러면 신을 쫓아낼 수 있을 거야｡ 그러니까 어떻게든 크툴루의 정수리､ 파묻힌 듯 솟아오른､"
  },
  {
   "id": 36666,
   "key": "D1402ru.txt:204",
   "file": "D1402ru.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この猛攻をかわして――！",
   "ko_candidate": "저 요새에 도달해야 해｡"
  },
  {
   "id": 36667,
   "key": "D1402ru.txt:209",
   "file": "D1402ru.txt",
   "line": 209,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お遊びは此処までだ。 消えて無くなれ」",
   "ko_candidate": "이 맹공을 피해서-! 「장난은 여기까지다｡ 사라져버려라」"
  },
  {
   "id": 36668,
   "key": "D1402ru.txt:214",
   "file": "D1402ru.txt",
   "line": 214,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「------!?」"
  },
  {
   "id": 36669,
   "key": "D1402ru.txt:223",
   "file": "D1402ru.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触腕が退いた。",
   "ko_candidate": "촉수가 물러났다｡"
  },
  {
   "id": 36670,
   "key": "D1402ru.txt:224",
   "file": "D1402ru.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "神の躰から垂れ下がるように、蠢いていた竜の首は、まるで花びらが開くように一斉に横へ拡がる。",
   "ko_candidate": "신의 몸에서 늘어진 듯 꿈틀거리던 용의 머리가､ 마치 꽃잎이 피어나듯 일제히 옆으로 펼쳐진다｡"
  },
  {
   "id": 36671,
   "key": "D1402ru.txt:231",
   "file": "D1402ru.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、汚穢な花びらの中心に、それを見た。",
   "ko_candidate": "그리고 더러운 꽃잎의 중심에서 그것을 보았다｡"
  },
  {
   "id": 36672,
   "key": "D1402ru.txt:232",
   "file": "D1402ru.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空いっぱいに広がった、地獄の底へ続くかのような、深淵。",
   "ko_candidate": "하늘 가득 펼쳐진､ 지옥의 밑바닥으로 이어지는 듯한 심연｡"
  },
  {
   "id": 36673,
   "key": "D1402ru.txt:233",
   "file": "D1402ru.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔える紅に、穢れた緑にぬめる、口腔。",
   "ko_candidate": "타오르는 붉은빛､ 더러운 초록빛으로 번들거리는 구강｡"
  },
  {
   "id": 36674,
   "key": "D1402ru.txt:235",
   "file": "D1402ru.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "開け放たれた神の口を……！",
   "ko_candidate": "열린 신의 입을…!"
  },
  {
   "id": 36675,
   "key": "D1402ru.txt:240",
   "file": "D1402ru.txt",
   "line": 240,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……拙い！」",
   "ko_candidate": "「…서툴군!」"
  },
  {
   "id": 36676,
   "key": "D1402ru.txt:243",
   "file": "D1402ru.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "口腔からは、汚穢な緑色の臭気が溢れ出していた。",
   "ko_candidate": "구강에서는 더러운 초록빛 악취가 넘쳐나고 있었다｡"
  },
  {
   "id": 36677,
   "key": "D1402ru.txt:244",
   "file": "D1402ru.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐臭漂う吐息に、濃縮された瘴気が、ときおり爆炎と雷光を迸らせる。",
   "ko_candidate": "부패 냄새 나는 토식에 농축된 장기가 때때로 폭염과 번개를"
  },
  {
   "id": 36678,
   "key": "D1402ru.txt:246",
   "file": "D1402ru.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "圧倒的な神気が、叩きつけるように吹き荒んだ。",
   "ko_candidate": "내뿜는다｡ 압도적인 신기가 내리치듯 거세게 불어닥쳤다｡"
  },
  {
   "id": 36679,
   "key": "D1402ru.txt:248",
   "file": "D1402ru.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吐息に混じって分散していた宇宙的なエネルギーは、みるみる内に収縮して、絶対的な爆発力を蓄え始める。",
   "ko_candidate": "토식에 섞여 분산되어 있던 우주적 에너지가 눈 깜짝할 사이에 수축하여 절대적인 폭발력을 축적하기 시작한다｡"
  },
  {
   "id": 36680,
   "key": "D1402ru.txt:249",
   "file": "D1402ru.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな力が解き放たれたら今度こそ……！",
   "ko_candidate": "이런 힘이 풀려나면 이번엔 정말로…!"
  },
  {
   "id": 36681,
   "key": "D1402ru.txt:257",
   "file": "D1402ru.txt",
   "line": 257,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐ……あ……あああああああああああああああああああああ！」",
   "ko_candidate": "「크… 아… 아아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 36682,
   "key": "D1402ru.txt:260",
   "file": "D1402ru.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分の身をまったく省みず、クトゥルーに向かって全力飛行する。",
   "ko_candidate": "자신의 몸을 전혀 돌보지 않고 크툴루를 향해 전력 비행한다｡"
  },
  {
   "id": 36683,
   "key": "D1402ru.txt:261",
   "file": "D1402ru.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……間に合わない……！",
   "ko_candidate": "하지만… 미치지 못해…!"
  },
  {
