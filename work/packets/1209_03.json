 },
 "items": [
  {
   "id": 28899,
   "key": "D1209ru.txt:48",
   "file": "D1209ru.txt",
   "line": 48,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……くっ」",
   "ko_candidate": "「……큿」"
  },
  {
   "id": 28900,
   "key": "D1209ru.txt:52",
   "file": "D1209ru.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "オペレーターのメイド達もまた、各々に武器を執る。",
   "ko_candidate": "오퍼레이터 메이드들 또한 각자 무기를 든다｡"
  },
  {
   "id": 28901,
   "key": "D1209ru.txt:54",
   "file": "D1209ru.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが半死半生の有様とは言え、『ブラックロッジ』のアンチクロス。",
   "ko_candidate": "하지만 반죽음 상태라고는 해도､ 『블랙로지』의 안티 크로스｡"
  },
  {
   "id": 28902,
   "key": "D1209ru.txt:55",
   "file": "D1209ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィンフィールドを破ったティトゥスだ。",
   "ko_candidate": "윈필드를 쓰러뜨린 티투스다｡"
  },
  {
   "id": 28903,
   "key": "D1209ru.txt:57",
   "file": "D1209ru.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "単なる銃火器でどうにか出来る相手ではない……。",
   "ko_candidate": "단순한 총기로는 어떻게 할 수 있는 상대가 아니다……｡"
  },
  {
   "id": 28904,
   "key": "D1209ru.txt:64",
   "file": "D1209ru.txt",
   "line": 64,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 28905,
   "key": "D1209ru.txt:67",
   "file": "D1209ru.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスが、刀を再び構える。",
   "ko_candidate": "티투스가 다시 칼을 겨눈다｡"
  },
  {
   "id": 28906,
   "key": "D1209ru.txt:68",
   "file": "D1209ru.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "視線は真っ直ぐと、ウィンフィールドへ。",
   "ko_candidate": "시선은 곧장 윈필드를 향한다｡"
  },
  {
   "id": 28907,
   "key": "D1209ru.txt:70",
   "file": "D1209ru.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "止めを刺すつもりか。",
   "ko_candidate": "마지막 일격을 가하려는 건가｡"
  },
  {
   "id": 28908,
   "key": "D1209ru.txt:71",
   "file": "D1209ru.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "警備兵達は悲壮な覚悟と共に、 トリガーに指を掛けて――",
   "ko_candidate": "경비병들은 비장한 각오와 함께 방아쇠에 손가락을 걸고――"
  },
  {
   "id": 28909,
   "key": "D1209ru.txt:74",
   "file": "D1209ru.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの動きが其処で止まった。",
   "ko_candidate": "티투스의 움직임이 거기서 멈췄다｡"
  },
  {
   "id": 28910,
   "key": "D1209ru.txt:75",
   "file": "D1209ru.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り返らずに、声をかける。",
   "ko_candidate": "돌아보지 않고 말을 건넨다｡"
  },
  {
   "id": 28911,
   "key": "D1209ru.txt:79",
   "file": "D1209ru.txt",
   "line": 79,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「此処でお主が現れるか……何とも間が悪い」",
   "ko_candidate": "「여기서 당신이 나타나다니……참으로 타이밍이 나쁘군」"
  },
  {
   "id": 28912,
   "key": "D1209ru.txt:82",
   "file": "D1209ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "相手は、応えなかった。",
   "ko_candidate": "상대는 대답하지 않았다｡"
  },
  {
   "id": 28913,
   "key": "D1209ru.txt:84",
   "file": "D1209ru.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティトゥスが誰に話しかけたか疑問に思う暇すら、一同に与えず、白い影が疾走った。",
   "ko_candidate": "티투스가 누구에게 말을 건넸는지 의문을 품을 틈조차 일동에게 주지 않고､ 하얀 그림자가 질주했다｡"
  },
  {
   "id": 28914,
   "key": "D1209ru.txt:86",
   "file": "D1209ru.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光刃が煌く。",
   "ko_candidate": "빛의 칼날이 번쩍인다｡"
  },
  {
   "id": 28915,
   "key": "D1209ru.txt:99",
   "file": "D1209ru.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当に何処に、それだけの余力を残しているのだろうか？",
   "ko_candidate": "정말 어디에 그만한 여력을 남겨두고 있는 걸까?"
  },
  {
   "id": 28916,
   "key": "D1209ru.txt:100",
   "file": "D1209ru.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "満身創痍の剣士は、その一撃を跳び越えて、下の階へと降り立った。",
   "ko_candidate": "만신창이의 검사는 그 일격을 뛰어넘어 아래층으로 내려섰다｡"
  },
  {
   "id": 28917,
   "key": "D1209ru.txt:102",
   "file": "D1209ru.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭上を振り返る。",
   "ko_candidate": "머리 위를 돌아본다｡"
  },
  {
   "id": 28918,
   "key": "D1209ru.txt:103",
   "file": "D1209ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い仮面の、感情の見えない眸と、視線がぶつかった。",
   "ko_candidate": "하얀 가면의 감정이 보이지 않는 눈동자와 시선이 부딪쳤다｡"
  },
  {
   "id": 28919,
   "key": "D1209ru.txt:110",
   "file": "D1209ru.txt",
   "line": 110,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「メタトロン！」",
   "ko_candidate": "「메타트론!」"
  },
  {
   "id": 28920,
   "key": "D1209ru.txt:118",
   "file": "D1209ru.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソーニャの顔に安堵の表情が広がった。",
   "ko_candidate": "소냐의 얼굴에 안도의 표정이 퍼졌다｡"
  },
  {
   "id": 28921,
   "key": "D1209ru.txt:119",
   "file": "D1209ru.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンは二振りのビームセイバーを伸ばして、身構える。",
   "ko_candidate": "메타트론은 두 자루의 빔 세이버를 뽑아들고 자세를 잡는다｡"
  },
  {
   "id": 28922,
   "key": "D1209ru.txt:120",
   "file": "D1209ru.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの口元には、苦笑が浮かんだ。",
   "ko_candidate": "티투스의 입가에는 쓴웃음이 떠올랐다｡"
  },
  {
   "id": 28923,
   "key": "D1209ru.txt:124",
   "file": "D1209ru.txt",
   "line": 124,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……引き際か」",
   "ko_candidate": "「……물러날 때인가」"
  },
  {
   "id": 28924,
   "key": "D1209ru.txt:129",
   "file": "D1209ru.txt",
   "line": 129,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お前も逃げるのか」",
   "ko_candidate": "「너도 도망치는 건가」"
  },
  {
   "id": 28925,
   "key": "D1209ru.txt:132",
   "file": "D1209ru.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの口端から、血が伝う。",
   "ko_candidate": "티투스의 입가에서 피가 흘러내린다｡"
  },
  {
   "id": 28926,
   "key": "D1209ru.txt:133",
   "file": "D1209ru.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その血が滴り落ちるのを待つまでも無く、足元には既に血溜りができていた。",
   "ko_candidate": "그 피가 떨어지기를 기다릴 것도 없이 발밑에는 이미 핏자국이 생겨 있었다｡"
  },
  {
   "id": 28927,
   "key": "D1209ru.txt:135",
   "file": "D1209ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛に引き攣った笑みを浮かべたまま、ティトゥスは頷く。",
   "ko_candidate": "고통에 일그러진 웃음을 띤 채 티투스는 고개를 끄덕인다｡"
  },
  {
   "id": 28928,
   "key": "D1209ru.txt:139",
   "file": "D1209ru.txt",
   "line": 139,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「この躰でお主と戦う程、拙者は自惚れてはおらん」",
   "ko_candidate": "「이 몸으로 당신과 싸울 만큼 저는 자만하지 않소」"
  },
  {
   "id": 28929,
   "key": "D1209ru.txt:144",
   "file": "D1209ru.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言い捨て、出口に向かって一気に駆け出した。",
   "ko_candidate": "말을 내뱉고는 출구를 향해 단숨에 달려나갔다｡"
  },
  {
   "id": 28930,
   "key": "D1209ru.txt:150",
   "file": "D1209ru.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "警備兵達が一斉に機銃を掃射する。",
   "ko_candidate": "경비병들이 일제히 기관총을 난사한다｡"
  },
  {
   "id": 28931,
   "key": "D1209ru.txt:151",
   "file": "D1209ru.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが只の一発も、銃弾は当たらない。",
   "ko_candidate": "하지만 단 한 발도 총알은 맞지 않는다｡"
  },
  {
   "id": 28932,
   "key": "D1209ru.txt:161",
   "file": "D1209ru.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンの右腕が砲身に変わり、ビームを撃ち出した。",
   "ko_candidate": "메타트론의 오른팔이 포신으로 변해 빔을 발사했다｡"
  },
  {
   "id": 28933,
   "key": "D1209ru.txt:163",
   "file": "D1209ru.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスのすぐ足元で爆発、だが爆風に逆らわない様にして、ティトゥスは宙を舞う。出口に降り立ち、一度だけ振り返って、告げた。",
   "ko_candidate": "티투스의 바로 발밑에서 폭발､ 하지만 폭풍을 거스르지 않듯이 티투스는 공중을 날아오른다｡ 출구에 내려서서 한 번만 돌아보고 말했다｡"
  },
  {
   "id": 28934,
   "key": "D1209ru.txt:172",
   "file": "D1209ru.txt",
   "line": 172,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それに、お主はサンダルフォンめの獲物。横取りする訳にはいくまい。 では、去らば！」",
   "ko_candidate": "「게다가 당신은 산달폰 놈의 먹잇감｡ 가로채는 건 안 되겠지｡ 그럼､ 이만!」"
  },
  {
   "id": 28935,
   "key": "D1209ru.txt:178",
   "file": "D1209ru.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呆気に取られる一同を残して、ティトゥスは通路の先の暗闇へと消えた。",
   "ko_candidate": "어리둥절한 일동을 남겨두고 티투스는 통로 저편의 어둠 속으로 사라졌다｡"
  },
  {
   "id": 28936,
   "key": "D1209ru.txt:182",
   "file": "D1209ru.txt",
   "line": 182,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 28937,
   "key": "D1209ru.txt:189",
   "file": "D1209ru.txt",
   "line": 189,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「早く、彼の手当てを。まだ息がある」",
   "ko_candidate": "「빨리 그의 치료를｡ 아직 숨이 붙어있어」"
  },
  {
   "id": 28938,
   "key": "D1209ru.txt:193",
   "file": "D1209ru.txt",
   "line": 193,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あああああっ！　ウィンフィールド様ぁぁぁぁ！」",
   "ko_candidate": "「아아아아악! 윈필드 님아아아아!」"
  }
 ]
}