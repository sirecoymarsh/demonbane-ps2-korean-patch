 },
 "items": [
  {
   "id": 28067,
   "key": "D1207al.txt:239",
   "file": "D1207al.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左の刀。突き。",
   "ko_candidate": "왼쪽 칼｡ 찌르기｡"
  },
  {
   "id": 28068,
   "key": "D1207al.txt:240",
   "file": "D1207al.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咽喉笛を狙い、風を裂きて迫る兇刃。",
   "ko_candidate": "목구멍을 노리고 바람을 가르며 다가오는 흉칼｡"
  },
  {
   "id": 28069,
   "key": "D1207al.txt:241",
   "file": "D1207al.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "速い。",
   "ko_candidate": "빠르다｡"
  },
  {
   "id": 28070,
   "key": "D1207al.txt:242",
   "file": "D1207al.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迅い。",
   "ko_candidate": "신속하다｡"
  },
  {
   "id": 28071,
   "key": "D1207al.txt:244",
   "file": "D1207al.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先程よりも更に。",
   "ko_candidate": "아까보다 더욱｡"
  },
  {
   "id": 28072,
   "key": "D1207al.txt:245",
   "file": "D1207al.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "稲妻の速度で。",
   "ko_candidate": "번개의 속도로｡"
  },
  {
   "id": 28073,
   "key": "D1207al.txt:247",
   "file": "D1207al.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "遂にティトゥスの速度は、 ウィンフィールドの動体視力を超えた。",
   "ko_candidate": "마침내 티투스의 속도는 윈필드의 동체시력을 넘어섰다｡"
  },
  {
   "id": 28074,
   "key": "D1207al.txt:249",
   "file": "D1207al.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、ウィンフィールドの思考と反射速度は、",
   "ko_candidate": "하지만 윈필드의 사고와 반사 속도는 더욱 그것을 웃돈다｡"
  },
  {
   "id": 28075,
   "key": "D1207al.txt:250",
   "file": "D1207al.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更にそれを上回る。",
   "ko_candidate": "차가운 검기가 지나갔다｡"
  },
  {
   "id": 28076,
   "key": "D1207al.txt:252",
   "file": "D1207al.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷たい剣気が通り過ぎた。",
   "ko_candidate": "베어진 것은 뺨의 살 한 겹｡"
  },
  {
   "id": 28077,
   "key": "D1207al.txt:253",
   "file": "D1207al.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "裂かれたのは頬の皮一枚。 血飛沫が舞う。ただそれだけ。",
   "ko_candidate": "피가 튀었다｡ 그뿐이다｡"
  },
  {
   "id": 28078,
   "key": "D1207al.txt:255",
   "file": "D1207al.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、それだけなのだ。",
   "ko_candidate": "단지､ 그뿐인 것이다｡"
  },
  {
   "id": 28079,
   "key": "D1207al.txt:260",
   "file": "D1207al.txt",
   "line": 260,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（――貰いましたよ！）",
   "ko_candidate": "（――받아치겠습니다!）"
  },
  {
   "id": 28080,
   "key": "D1207al.txt:263",
   "file": "D1207al.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃の後の、僅かな、僅かな、隙。",
   "ko_candidate": "공격 후의 아주 작은､ 아주 작은 틈｡"
  },
  {
   "id": 28081,
   "key": "D1207al.txt:264",
   "file": "D1207al.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ほんの一瞬の、ゼロコンマ秒にも満たない、 ほんの刹那。",
   "ko_candidate": "단 일순간의､ 제로 콤마 초에도 미치지 못하는､ 아주 찰나｡"
  },
  {
   "id": 28082,
   "key": "D1207al.txt:267",
   "file": "D1207al.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、完全に無防備を曝した。",
   "ko_candidate": "하지만 완전히 무방비를 드러냈다｡"
  },
  {
   "id": 28083,
   "key": "D1207al.txt:268",
   "file": "D1207al.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神速の領域で、その隙は決定的だった。致命的だった。",
   "ko_candidate": "신속의 영역에서､ 그 틈은 결정적이었다｡ 치명적이었다｡"
  },
  {
   "id": 28084,
   "key": "D1207al.txt:270",
   "file": "D1207al.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必殺の威力を込めたアッパーが唸りを上げて、ティトゥスに迫る。",
   "ko_candidate": "필살의 위력을 담은 어퍼가 윙윙거리며 티투스에게 다가간다｡"
  },
  {
   "id": 28085,
   "key": "D1207al.txt:272",
   "file": "D1207al.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "かわせない。",
   "ko_candidate": "피할 수 없다｡"
  },
  {
   "id": 28086,
   "key": "D1207al.txt:273",
   "file": "D1207al.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "かわせる筈が無い。",
   "ko_candidate": "피할 수 있을 리가 없다｡"
  },
  {
   "id": 28087,
   "key": "D1207al.txt:274",
   "file": "D1207al.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今度こそ、 二度と起き上がる事の出来ない決定打になる――",
   "ko_candidate": "이번에야말로 두 번 다시 일어날 수 없는 결정타가 될 것이다――"
  },
  {
   "id": 28088,
   "key": "D1207al.txt:277",
   "file": "D1207al.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "筈だった。",
   "ko_candidate": "그럴 터였다｡"
  },
  {
   "id": 28089,
   "key": "D1207al.txt:281",
   "file": "D1207al.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "銀の光がウィンフィールドの眼前で煌めいた。",
   "ko_candidate": "은빛 광채가 윈필드의 눈앞에서 반짝였다｡{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 28090,
   "key": "D1207al.txt:285",
   "file": "D1207al.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "予期せぬ剣気が、",
   "ko_candidate": "예기치 못한 검기가､"
  },
  {
   "id": 28091,
   "key": "D1207al.txt:286",
   "file": "D1207al.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "予期せぬタイミングで、",
   "ko_candidate": "예기치 못한 타이밍에､"
  },
  {
   "id": 28092,
   "key": "D1207al.txt:287",
   "file": "D1207al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "予期せぬ方向から、飛来した。",
   "ko_candidate": "예기치 못한 방향에서 날아왔다｡"
  },
  {
   "id": 28093,
   "key": "D1207al.txt:289",
   "file": "D1207al.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その原因に、刹那の世界を走る思考は、 即座に気付いた。",
   "ko_candidate": "그 원인을 찰나의 세계를 달리는 사고는 즉시 깨달았다｡"
  },
  {
   "id": 28094,
   "key": "D1207al.txt:291",
   "file": "D1207al.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遅過ぎた。",
   "ko_candidate": "너무 늦었다｡"
  },
  {
   "id": 28095,
   "key": "D1207al.txt:303",
   "file": "D1207al.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其処に何かしらの感慨が生まれるよりも速く、ウィンフィールドの意識は、断絶した。",
   "ko_candidate": "거기에 무언가 감회가 생겨나기보다 더 빠르게､ 윈필드의 의식은 단절되었다｡"
  },
  {
   "id": 28096,
   "key": "D1207le.txt:12",
   "file": "D1207le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠くからの爆音が響き、避難所を僅かに震わせている。",
   "ko_candidate": "멀리서 들려오는 폭음이 울려 퍼지며､ 대피소를 약간 흔들어놓고 있다｡"
  },
  {
   "id": 28097,
   "key": "D1207le.txt:14",
   "file": "D1207le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "住人達は見えない敵の脅威に怯えながら、身を寄せ合う事しか出来ない。",
   "ko_candidate": "주민들은 보이지 않는 적의 위협에 겁에 질린 채､ 서로 몸을 맞대는 것밖에 할 수 없다｡"
  },
  {
   "id": 28098,
   "key": "D1207le.txt:16",
   "file": "D1207le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ジョージも、コリンも、アリスンも、幼いながら健気に、恐怖に堪えている。",
   "ko_candidate": "조지도､ 콜린도､ 앨리슨도､ 어린 나이에도 불구하고 용감하게 공포를 견디고 있다｡"
  },
  {
   "id": 28099,
   "key": "D1207le.txt:21",
   "file": "D1207le.txt",
   "line": 21,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカ姉ちゃん、またどこに行ったんだよぅ」",
   "ko_candidate": "「라이카 누나､ 또 어디로 간 거야」"
  },
  {
   "id": 28100,
   "key": "D1207le.txt:26",
   "file": "D1207le.txt",
   "line": 26,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こんどは九郎といっしょだから、だいじょうぶだって言ってたけど……」",
   "ko_candidate": "「이번엔 쿠로랑 같이 있으니까､ 괜찮다고 했는데……」"
  },
  {
   "id": 28101,
   "key": "D1207le.txt:31",
   "file": "D1207le.txt",
   "line": 31,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「でも……九郎お兄ちゃん、また戦っているのかも……」",
   "ko_candidate": "「하지만…… 쿠로 오빠､ 또 싸우고 있을지도……」"
  },
  {
   "id": 28102,
   "key": "D1207le.txt:35",
   "file": "D1207le.txt",
   "line": 35,
   "speaker": "ジョージ＆コリン＆アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 28103,
   "key": "D1207le.txt:38",
   "file": "D1207le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弱気になるのはいけないと、分かっていても不安が押し寄せる。",
   "ko_candidate": "약해지면 안 된다는 걸 알면서도 불안감이 밀려온다｡"
  },
  {
   "id": 28104,
   "key": "D1207le.txt:40",
   "file": "D1207le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無理もない。",
   "ko_candidate": "무리도 아니다｡"
  },
  {
   "id": 28105,
   "key": "D1207le.txt:41",
   "file": "D1207le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このような状況で、頼りにしているライカや九郎もこの場に居ない。",
   "ko_candidate": "이런 상황에서､ 의지하던 라이카와 쿠로도 이 자리에 없다｡"
  },
  {
   "id": 28106,
   "key": "D1207le.txt:43",
   "file": "D1207le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大人でも参ってしまうだろう状況で、子ども達はよく堪えていると言えた。",
   "ko_candidate": "어른들도 지쳐버릴 상황에서､ 아이들은 잘 견디고 있다고 할 수 있었다｡"
  }
 ]
}