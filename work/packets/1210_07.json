{
 "packet": "1210_07",
 "scene": "1210",
 "anchor": {
  "hit": 78,
  "total": 81,
  "rate": 0.963
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "サンダルフォン": "산달폰",
  "リューガ": "류가",
  "メタトロン": "메타트론"
 },
 "items": [
  {
   "id": 29258,
   "key": "D1210le.txt:403",
   "file": "D1210le.txt",
   "line": 403,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い装甲に薄っすらと光が走った。",
   "ko_candidate": "검은 갑옷에 희미하게 빛이 달렸다｡"
  },
  {
   "id": 29259,
   "key": "D1210le.txt:410",
   "file": "D1210le.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは徐々に光度を上げ、燃え上がり、サンダルフォンの躰に灼熱の十字架を灼きつける。",
   "ko_candidate": "그것은 점점 광도를 높이고 타오르며 산달폰의 몸에 작열의 십자가를 새긴다｡"
  },
  {
   "id": 29260,
   "key": "D1210le.txt:411",
   "file": "D1210le.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "十字の焔を刻まれ、黒い天使は悶え苦しむ。",
   "ko_candidate": "십자의 불꽃을 새겨져 검은 천사는 몸부림친다｡"
  },
  {
   "id": 29261,
   "key": "D1210le.txt:416",
   "file": "D1210le.txt",
   "line": 416,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬおおおおおおおおおおおおおお!?」",
   "ko_candidate": "「크오오오오오오오오오오오오오오!?」"
  },
  {
   "id": 29262,
   "key": "D1210le.txt:422",
   "file": "D1210le.txt",
   "line": 422,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……滅びろ。サンダルフォン」",
   "ko_candidate": "「……멸망하라｡ 산달폰」"
  },
  {
   "id": 29263,
   "key": "D1210le.txt:430",
   "file": "D1210le.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なおも苛烈に闇を灼く、十字架の刻印。",
   "ko_candidate": "여전히 가혹하게 어둠을 태우는 십자가의 각인｡"
  },
  {
   "id": 29264,
   "key": "D1210le.txt:431",
   "file": "D1210le.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの皮膚を裂き、肉を焼き、神経を断ち、躰を斬り裂いてゆく。",
   "ko_candidate": "산달폰의 피부를 찢고 살을 태우고 신경을 끊고 몸을 갈라놓는다｡"
  },
  {
   "id": 29265,
   "key": "D1210le.txt:436",
   "file": "D1210le.txt",
   "line": 436,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「がああああ……！　メタト……ロン！　ぐああああああああ！」",
   "ko_candidate": "「가아아아아……! 메타……트론! 크아아아아아아아아!」"
  },
  {
   "id": 29266,
   "key": "D1210le.txt:441",
   "file": "D1210le.txt",
   "line": 441,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「滅びて……消え去れ！」",
   "ko_candidate": "「멸망하고……사라져라!」"
  },
  {
   "id": 29267,
   "key": "D1210le.txt:444",
   "file": "D1210le.txt",
   "line": 444,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烈しく、無慈悲にサンダルフォンを侵す、裁きの光。",
   "ko_candidate": "격렬하고 무자비하게 산달폰을 침식하는 심판의 빛｡"
  },
  {
   "id": 29268,
   "key": "D1210le.txt:445",
   "file": "D1210le.txt",
   "line": 445,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛が脳内で乱舞し、意識をズタズタに蹂躙する。",
   "ko_candidate": "고통이 뇌내에서 난무하고 의식을 갈갈이 유린한다｡"
  },
  {
   "id": 29269,
   "key": "D1210le.txt:446",
   "file": "D1210le.txt",
   "line": 446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼け落ちる意識の中で――リューガは見た。",
   "ko_candidate": "타들어가는 의식 속에서――류가는 보았다｡"
  },
  {
   "id": 29270,
   "key": "D1210le.txt:460",
   "file": "D1210le.txt",
   "line": 460,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッアア！」",
   "ko_candidate": "「………아아!」"
  },
  {
   "id": 29271,
   "key": "D1210le.txt:463",
   "file": "D1210le.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死に逝く脳が、臨界を超えて、活動した。",
   "ko_candidate": "죽어가는 뇌가 임계를 넘어 활동했다｡"
  },
  {
   "id": 29272,
   "key": "D1210le.txt:464",
   "file": "D1210le.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アドレナリンがノルアドレナリンが、荒れ狂う激痛よりも烈しく、脳を灼く。",
   "ko_candidate": "아드레날린이 노르아드레날린이 광란하는 격통보다 더 격렬하게 뇌를 태운다｡"
  },
  {
   "id": 29273,
   "key": "D1210le.txt:466",
   "file": "D1210le.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンケフェリンがエンドルフィンが苦痛を溶かす。蕩けさす。",
   "ko_candidate": "엔케팔린이 엔돌핀이 고통을 녹인다｡ 녹여버린다｡"
  },
  {
   "id": 29274,
   "key": "D1210le.txt:468",
   "file": "D1210le.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "快感中枢がドーパミンを吐き散らし、加速された兇悪な快楽が駈け巡る。",
   "ko_candidate": "쾌감 중추가 도파민을 뿜어내고 가속된 흉악한 쾌락이 달린다｡"
  },
  {
   "id": 29275,
   "key": "D1210le.txt:470",
   "file": "D1210le.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が、弾けた。",
   "ko_candidate": "의식이 터졌다｡"
  },
  {
   "id": 29276,
   "key": "D1210le.txt:476",
   "file": "D1210le.txt",
   "line": 476,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「餓アアアアアァァァァァ！」",
   "ko_candidate": "「아아아아아아아아아아!」"
  },
  {
   "id": 29277,
   "key": "D1210le.txt:481",
   "file": "D1210le.txt",
   "line": 481,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――！　馬鹿な、まだ動け……」",
   "ko_candidate": "「――! 바보 같은､ 아직도 움직일 수……」"
  },
  {
   "id": 29278,
   "key": "D1210le.txt:485",
   "file": "D1210le.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一歩、踏み出した。",
   "ko_candidate": "한 걸음､ 내디뎠다｡"
  },
  {
   "id": 29279,
   "key": "D1210le.txt:486",
   "file": "D1210le.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけで広い避難所は激震した。",
   "ko_candidate": "그것만으로도 넓은 대피소는 격진했다｡"
  },
  {
   "id": 29280,
   "key": "D1210le.txt:490",
   "file": "D1210le.txt",
   "line": 490,
   "speaker": "ジョージ＆コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわああああ！」",
   "ko_candidate": "「우와아아아아!」"
  },
  {
   "id": 29281,
   "key": "D1210le.txt:495",
   "file": "D1210le.txt",
   "line": 495,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃああああ！」",
   "ko_candidate": "「꺄아아아아!」"
  },
  {
   "id": 29282,
   "key": "D1210le.txt:499",
   "file": "D1210le.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "踏み込んだ足元を中心に亀裂が走り、今度は避難所の床全体が陥没する。",
   "ko_candidate": "내디딘 발밑을 중심으로 균열이 생기고 이번에는 대피소의 바닥 전체가 함몰된다｡"
  },
  {
   "id": 29283,
   "key": "D1210le.txt:501",
   "file": "D1210le.txt",
   "line": 501,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――踏み込みと同時、ゆっくりと、今までの荒れ狂う乱打とは正逆を為す穏やかさで、大気すら震わさない程に無音の一撃が、メタトロンの隙に滑り込んだ。",
   "ko_candidate": "그리고――내디딤과 동시에 천천히､ 지금까지의 광란하는 난타와는 정반대를 이루는 온화함으로 대기조차 흔들리지 않을 정도로 무음의 일격이 메타트론의 틈새로 미끄러져 들어갔다｡"
  },
  {
   "id": 29284,
   "key": "D1210le.txt:503",
   "file": "D1210le.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆっくりと、これだけゆっくりとした一撃――あくまでメタトロンにはそう見えた――それをメタトロンはかわせない。",
   "ko_candidate": "천천히､ 이렇게나 천천히 한 일격――어디까지나 메타트론에게는 그렇게 보였다――그것을 메타트론은 피할 수 없다｡"
  },
  {
   "id": 29285,
   "key": "D1210le.txt:505",
   "file": "D1210le.txt",
   "line": 505,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの拳が触れる。",
   "ko_candidate": "산달폰의 주먹이 닿는다｡"
  },
  {
   "id": 29286,
   "key": "D1210le.txt:510",
   "file": "D1210le.txt",
   "line": 510,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――」",
   "ko_candidate": "「――――――――――」"
  },
  {
   "id": 29287,
   "key": "D1210le.txt:514",
   "file": "D1210le.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲鳴すら洩れない――破壊は速やかに進行した。",
   "ko_candidate": "비명조차 새어 나오지 않는다――파괴는 신속하게 진행되었다｡"
  },
  {
   "id": 29288,
   "key": "D1210le.txt:516",
   "file": "D1210le.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "体内を掻き混ぜる、衝撃の激流。",
   "ko_candidate": "체내를 휘젓는 충격의 격류｡"
  },
  {
   "id": 29289,
   "key": "D1210le.txt:517",
   "file": "D1210le.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掻き混ぜながら灼く、衝撃の焔。",
   "ko_candidate": "휘저으며 태우는 충격의 불꽃｡"
  },
  {
   "id": 29290,
   "key": "D1210le.txt:518",
   "file": "D1210le.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼きながら引き裂き貪る、衝撃の爪牙。",
   "ko_candidate": "태우며 찢어발기는 충격의 발톱｡"
  },
  {
   "id": 29291,
   "key": "D1210le.txt:527",
   "file": "D1210le.txt",
   "line": 527,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――っ……ぁ」",
   "ko_candidate": "「――――――――――……아」"
  },
  {
   "id": 29292,
   "key": "D1210le.txt:530",
   "file": "D1210le.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンが砕ける。",
   "ko_candidate": "메타트론이 부서진다｡"
  },
  {
   "id": 29293,
   "key": "D1210le.txt:531",
   "file": "D1210le.txt",
   "line": 531,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白の天使が砕け散る。",
   "ko_candidate": "흰 천사가 산산조각 난다｡"
  },
  {
   "id": 29294,
   "key": "D1210le.txt:532",
   "file": "D1210le.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白の装甲が四散する。",
   "ko_candidate": "흰 갑옷이 사방으로 흩어진다｡"
  },
  {
   "id": 29295,
   "key": "D1210le.txt:534",
   "file": "D1210le.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天使の似姿が崩れ落ちる。",
   "ko_candidate": "천사의 모습이 무너져 내린다｡"
  },
  {
   "id": 29296,
   "key": "D1210le.txt:539",
   "file": "D1210le.txt",
   "line": 539,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「メ……メタトロォォォォォォォンッッッッ！」",
   "ko_candidate": "「메……메타트로오오오오오오온!」"
  },
  {
   "id": 29297,
   "key": "D1210le.txt:544",
   "file": "D1210le.txt",
   "line": 544,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………え？」",
   "ko_candidate": "「………어?」"
  }
 ]
}