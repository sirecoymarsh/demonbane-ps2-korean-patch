 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アル": "알",
  "ライカ": "라이카",
  "九郎": "쿠로",
  "ブラックロッジ": "블랙로지",
  "メタトロン": "메타트론",
  "デモンベイン": "데몬베인"
 },
 "items": [
  {
   "id": 48927,
   "key": "D1520le.txt:171",
   "file": "D1520le.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの躰が、徐々に薄れていく。",
   "ko_candidate": "알의 몸이､ 점점 희미해져 간다｡"
  },
  {
   "id": 48928,
   "key": "D1520le.txt:172",
   "file": "D1520le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただでさえ白い肌は、完全に透き通っている。",
   "ko_candidate": "그렇지 않아도 하얀 피부는､ 완전히 투명해지고 있다｡"
  },
  {
   "id": 48929,
   "key": "D1520le.txt:173",
   "file": "D1520le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "儚い幻のように、アルの姿は頼りなく揺らめいていた。",
   "ko_candidate": "덧없는 환영처럼､ 알의 모습은 가냘프게 흔들리고 있었다｡"
  },
  {
   "id": 48930,
   "key": "D1520le.txt:176",
   "file": "D1520le.txt",
   "line": 176,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アルゥゥゥゥゥゥゥゥ――――！」",
   "ko_candidate": "「아르우우우우우우우우――――!」"
  },
  {
   "id": 48931,
   "key": "D1520le.txt:180",
   "file": "D1520le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "酷く切なげな翡翠の瞳が、俺を見つめ返す。",
   "ko_candidate": "몹시 애처로운 비취빛 눈동자가 나를 바라본다｡"
  },
  {
   "id": 48932,
   "key": "D1520le.txt:181",
   "file": "D1520le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "目尻に何かが光った。",
   "ko_candidate": "눈꼬리에 무언가가 반짝였다｡"
  },
  {
   "id": 48933,
   "key": "D1520le.txt:190",
   "file": "D1520le.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルは何かを叫ぼうとして――そのまま、朝陽を前にした霧のように消えてしまう。",
   "ko_candidate": "알은 뭔가를 외치려다가――{SE_PLAY(2,\"アル消滅3\",0,100,false);}그대로 아침 햇살 앞의 안개처럼 사라져버렸다｡"
  },
  {
   "id": 48934,
   "key": "D1520le.txt:192",
   "file": "D1520le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の頬を、雫が打った。",
   "ko_candidate": "내 뺨을 물방울이 때렸다｡"
  },
  {
   "id": 48935,
   "key": "D1520le.txt:198",
   "file": "D1520le.txt",
   "line": 198,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……アル……？」",
   "ko_candidate": "「……알……?」"
  },
  {
   "id": 48936,
   "key": "D1520le.txt:201",
   "file": "D1520le.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "堕ちながら、俺は呆然と、消えたアルの面影に囚われ続けた。",
   "ko_candidate": "추락하면서 나는 멍하니 사라진 알의 모습에 사로잡혀 있었다｡"
  },
  {
   "id": 48937,
   "key": "D1520le.txt:202",
   "file": "D1520le.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何が起きたんだ？",
   "ko_candidate": "무슨 일이 일어난 거지?"
  },
  {
   "id": 48938,
   "key": "D1520le.txt:203",
   "file": "D1520le.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こんな突然、ワケも分からないうちに、消えてしまって――",
   "ko_candidate": "이렇게 갑자기､ 이유도 모르는 채 사라져버리다니――"
  },
  {
   "id": 48939,
   "key": "D1520le.txt:205",
   "file": "D1520le.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――消える。",
   "ko_candidate": "――사라진다｡"
  },
  {
   "id": 48940,
   "key": "D1520le.txt:209",
   "file": "D1520le.txt",
   "line": 209,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ッッッッ！　ライカさんっっっっ！」",
   "ko_candidate": "「으으으으! 라이카 씨이이이이!」"
  },
  {
   "id": 48941,
   "key": "D1520le.txt:214",
   "file": "D1520le.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "全身を貫く恐怖に、俺はライカさんの姿を求める。",
   "ko_candidate": "온몸을 관통하는 공포에 나는 라이카 씨의 모습을 찾는다｡"
  },
  {
   "id": 48942,
   "key": "D1520le.txt:215",
   "file": "D1520le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "眼下、何処までも続く深淵に、淡く輝く白い影。",
   "ko_candidate": "아래쪽､ 끝없이 이어지는 심연에 희미하게 빛나는 하얀 그림자｡"
  },
  {
   "id": 48943,
   "key": "D1520le.txt:217",
   "file": "D1520le.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんが俺を見上げている。",
   "ko_candidate": "라이카 씨가 나를 올려다보고 있다｡"
  },
  {
   "id": 48944,
   "key": "D1520le.txt:218",
   "file": "D1520le.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけどその姿は、アルと同じように、あまりにも幽かで――",
   "ko_candidate": "하지만 그 모습은 알과 마찬가지로 너무나 희미해서――"
  },
  {
   "id": 48945,
   "key": "D1520le.txt:222",
   "file": "D1520le.txt",
   "line": 222,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ライカさん！　何で……何でだよ！」",
   "ko_candidate": "「라이카 씨! 왜……왜 이러는 거예요!」"
  },
  {
   "id": 48946,
   "key": "D1520le.txt:225",
   "file": "D1520le.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "半狂乱になって、手を伸ばす。",
   "ko_candidate": "반쯤 미친 듯이 손을 뻗는다｡"
  },
  {
   "id": 48947,
   "key": "D1520le.txt:226",
   "file": "D1520le.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど２人を隔てる距離はあまりに遠すぎた。",
   "ko_candidate": "하지만 둘을 가로막는 거리는 너무나 멀었다｡"
  },
  {
   "id": 48948,
   "key": "D1520le.txt:228",
   "file": "D1520le.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "深淵が、二人を別つ。",
   "ko_candidate": "심연이 둘을 갈라놓는다｡"
  },
  {
   "id": 48949,
   "key": "D1520le.txt:229",
   "file": "D1520le.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "湧き上がる恐怖は、怒りにも似ていた。",
   "ko_candidate": "솟구치는 공포는 분노와도 비슷했다｡"
  },
  {
   "id": 48950,
   "key": "D1520le.txt:233",
   "file": "D1520le.txt",
   "line": 233,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何なんだよ……！　何で、何でこんな……っ！ ここまで来て……！　こんな終わりってありかよ！　ちくしょうっ！」",
   "ko_candidate": "「뭐야 이게……! 왜､ 왜 이렇게……! 여기까지 와서……! 이런 끝이라니 말이 돼? 젠장!」"
  },
  {
   "id": 48951,
   "key": "D1520le.txt:238",
   "file": "D1520le.txt",
   "line": 238,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――九郎、ちゃん」",
   "ko_candidate": "「――――쿠로､ 군」"
  },
  {
   "id": 48952,
   "key": "D1520le.txt:246",
   "file": "D1520le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんの姿が……光に、散った。",
   "ko_candidate": "라이카 씨의 모습이……빛으로 흩어졌다｡"
  },
  {
   "id": 48953,
   "key": "D1520le.txt:247",
   "file": "D1520le.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや……違うのか……？",
   "ko_candidate": "아니……다른 건가……?"
  },
  {
   "id": 48954,
   "key": "D1520le.txt:248",
   "file": "D1520le.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "消えるのは……俺の方なのだろうか？",
   "ko_candidate": "사라지는 건……내 쪽인 걸까?"
  },
  {
   "id": 48955,
   "key": "D1520le.txt:249",
   "file": "D1520le.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "底知れない喪失感の中で、俺は聲を聴いた。",
   "ko_candidate": "끝없는 상실감 속에서 나는 목소리를 들었다｡"
  },
  {
   "id": 48956,
   "key": "D1520le.txt:253",
   "file": "D1520le.txt",
   "line": 253,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「総ては元に戻るだけさ。邪神の居ない、『ブラックロッジ』が結成されていない、メタトロンもデモンベインも存在しない、正しい世界に」 「空っぽな世界に……ね」",
   "ko_candidate": "「모든 것은 원래대로 돌아갈 뿐이야｡ 사신이 없고､ 『블랙로지』가 결성되지 않았으며､ 메타트론도 데몬베인도 존재하지 않는 올바른 세계로｡ 텅 빈 세계로……말이야」"
  },
  {
   "id": 48957,
   "key": "D1520le.txt:270",
   "file": "D1520le.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何を喪失ってしまうのだろう。",
   "ko_candidate": "무엇을 잃어버리는 걸까｡"
  },
  {
   "id": 48958,
   "key": "D1520le.txt:271",
   "file": "D1520le.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何を喪失ってしまったのだろう。",
   "ko_candidate": "무엇을 잃어버린 걸까｡"
  },
  {
   "id": 48959,
   "key": "D1520le.txt:273",
   "file": "D1520le.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分からない。",
   "ko_candidate": "모르겠다｡"
  },
  {
   "id": 48960,
   "key": "D1520le.txt:274",
   "file": "D1520le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただ、俺の今までの世界――みんなと、ライカさんと一緒に歩いてきた世界が、指の隙間から砂のように零れ落ちてゆく。",
   "ko_candidate": "다만､ 내 지금까지의 세계――모두와､ 라이카 씨와 함께 걸어온 세계가 손가락 틈새로 모래처럼 흘러내린다｡"
  },
  {
   "id": 48961,
   "key": "D1520le.txt:276",
   "file": "D1520le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは酷い孤独と恐怖だった。",
   "ko_candidate": "그것은 끔찍한 고독과 공포였다｡"
  },
  {
   "id": 48962,
   "key": "D1520le.txt:277",
   "file": "D1520le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、その恐怖すら、零れ落ちようとしている。",
   "ko_candidate": "하지만 그 공포조차 흘러내리려 하고 있다｡"
  },
  {
   "id": 48963,
   "key": "D1520le.txt:278",
   "file": "D1520le.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺が俺である証の総てが、喪失われてしまう――",
   "ko_candidate": "내가 나라는 증거의 모든 것이 상실되어 버린다――"
  },
  {
   "id": 48964,
   "key": "D1520le.txt:282",
   "file": "D1520le.txt",
   "line": 282,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「違う……総てが元に戻るだけだ。 輪廻が始まる前へと」",
   "ko_candidate": "「아니야……모든 것이 원래대로 돌아갈 뿐이다｡ 윤회가 시작되기 전으로」"
  },
  {
   "id": 48965,
   "key": "D1520le.txt:286",
   "file": "D1520le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……誰かの聲が聞こえる。",
   "ko_candidate": "……누군가의 목소리가 들린다｡"
  },
  {
   "id": 48966,
   "key": "D1520le.txt:287",
   "file": "D1520le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは何もかもが喪失われていく世界で、何より暖かく安らげるものだった。",
   "ko_candidate": "그것은 모든 것이 상실되어 가는 세계에서 그 무엇보다 따뜻하고 편안한 것이었다｡"
  }
 ]
}