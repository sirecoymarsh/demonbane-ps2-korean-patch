  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "覇道鋼造": "하도 코조",
  "大十字九郎": "다이쥬지 쿠로",
  "姫さん": "공주님",
  "瑠璃": "루리",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 50498,
   "key": "ep_ruri01.txt:1106",
   "file": "ep_ruri01.txt",
   "line": 1106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は病室の前に立った。",
   "ko_candidate": "나는 병실 앞에 섰다｡"
  },
  {
   "id": 50499,
   "key": "ep_ruri01.txt:1107",
   "file": "ep_ruri01.txt",
   "line": 1107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これから俺は再び、覇道鋼造になる。",
   "ko_candidate": "이제부터 나는 다시 하도 코조가 된다｡"
  },
  {
   "id": 50500,
   "key": "ep_ruri01.txt:1108",
   "file": "ep_ruri01.txt",
   "line": 1108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして最期まで、覇道鋼造であり続ける。",
   "ko_candidate": "그리고 마지막까지 하도 코조로 있을 것이다｡"
  },
  {
   "id": 50501,
   "key": "ep_ruri01.txt:1110",
   "file": "ep_ruri01.txt",
   "line": 1110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、今は。",
   "ko_candidate": "하지만 지금은｡"
  },
  {
   "id": 50502,
   "key": "ep_ruri01.txt:1111",
   "file": "ep_ruri01.txt",
   "line": 1111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今、この一瞬だけは、大十字九郎に戻ることを許して頂きたい。",
   "ko_candidate": "지금､ 이 순간만큼은 다이쥬지 쿠로로 돌아가는 것을 허락해 주셨으면 한다｡"
  },
  {
   "id": 50503,
   "key": "ep_ruri01.txt:1113",
   "file": "ep_ruri01.txt",
   "line": 1113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何故なら奴は、君との約束を破ったことを酷く気に病んでいたから。",
   "ko_candidate": "왜냐하면 그 녀석은 너와의 약속을 어긴 것을 몹시 마음 아파했으니까｡"
  },
  {
   "id": 50504,
   "key": "ep_ruri01.txt:1114",
   "file": "ep_ruri01.txt",
   "line": 1114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そしてようやく、約束を果たせる時がやって来たから。",
   "ko_candidate": "그리고 드디어 약속을 지킬 수 있는 때가 왔으니까｡"
  },
  {
   "id": 50505,
   "key": "ep_ruri01.txt:1121",
   "file": "ep_ruri01.txt",
   "line": 1121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから――今だけは――",
   "ko_candidate": "그러니까――지금만은――"
  },
  {
   "id": 50506,
   "key": "ep_ruri01.txt:1123",
   "file": "ep_ruri01.txt",
   "line": 1123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "母親の胸に抱かれ――何も知らずに笑う君に――",
   "ko_candidate": "어머니의 품에 안겨――아무것도 모르고 웃는 너에게――"
  },
  {
   "id": 50507,
   "key": "ep_ruri01.txt:1125",
   "file": "ep_ruri01.txt",
   "line": 1125,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「生まれてくれて、ありがとう」",
   "ko_candidate": "「태어나줘서 고마워」라는 감사와 함께――"
  },
  {
   "id": 50508,
   "key": "ep_ruri01.txt:1126",
   "file": "ep_ruri01.txt",
   "line": 1126,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "という感謝と共に―― あの時の約束を果たす、言葉を――",
   "ko_candidate": "그때의 약속을 지키는 말을――"
  },
  {
   "id": 50509,
   "key": "ep_ruri01.txt:1130",
   "file": "ep_ruri01.txt",
   "line": 1130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の、大事な姫さんに――",
   "ko_candidate": "나의 소중한 공주님에게――"
  },
  {
   "id": 50510,
   "key": "ep_ruri01.txt:1137",
   "file": "ep_ruri01.txt",
   "line": 1137,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ただいま、瑠璃」",
   "ko_candidate": "「다녀왔어､ 루리」"
  },
  {
   "id": 50511,
   "key": "ep_ruri01.txt:1147",
   "file": "ep_ruri01.txt",
   "line": 1147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自らの躰を抱いて……私はまた泣き出していた。",
   "ko_candidate": "자신의 몸을 안으며… 나는 또다시 울음을 터뜨리고 있었다｡"
  },
  {
   "id": 50512,
   "key": "ep_ruri01.txt:1148",
   "file": "ep_ruri01.txt",
   "line": 1148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、今度は絶望の涙ではない。",
   "ko_candidate": "하지만 이번엔 절망의 눈물이 아니다｡"
  },
  {
   "id": 50513,
   "key": "ep_ruri01.txt:1149",
   "file": "ep_ruri01.txt",
   "line": 1149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悲しいけど、苦しいけど、だけど喜びに満ちた、感謝の涙だった。",
   "ko_candidate": "슬프지만､ 괴롭지만､ 그래도 기쁨으로 가득 찬 감사의 눈물이었다｡"
  },
  {
   "id": 50514,
   "key": "ep_ruri01.txt:1156",
   "file": "ep_ruri01.txt",
   "line": 1156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの人は――約束を守ってくれた。",
   "ko_candidate": "그 사람은――약속을 지켜주었다｡"
  },
  {
   "id": 50515,
   "key": "ep_ruri01.txt:1157",
   "file": "ep_ruri01.txt",
   "line": 1157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "もうずっとずっと昔に、約束を守ってくれたんだ。",
   "ko_candidate": "이미 아주 오래전에､ 약속을 지켜주었던 거야｡"
  },
  {
   "id": 50516,
   "key": "ep_ruri01.txt:1159",
   "file": "ep_ruri01.txt",
   "line": 1159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、護っていてくれた。",
   "ko_candidate": "그리고 지켜주고 있었다｡"
  },
  {
   "id": 50517,
   "key": "ep_ruri01.txt:1160",
   "file": "ep_ruri01.txt",
   "line": 1160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ずっとずっと、私を護り続けてくれた。",
   "ko_candidate": "계속 계속､ 나를 지켜주고 있었다｡"
  },
  {
   "id": 50518,
   "key": "ep_ruri01.txt:1161",
   "file": "ep_ruri01.txt",
   "line": 1161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの人は、私が生まれてから、ずっと護ってくれていた。",
   "ko_candidate": "그 사람은 내가 태어난 이후로､ 줄곧 나를 지켜주고 있었다｡"
  },
  {
   "id": 50519,
   "key": "ep_ruri01.txt:1161",
   "file": "ep_ruri01.txt",
   "line": 1161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "お爺様は、死んだその後もずっと、私を護り続けてくれた。",
   "ko_candidate": "할아버지는 돌아가신 후에도 계속､ 나를 지켜주고 계셨다｡"
  },
  {
   "id": 50520,
   "key": "ep_ruri01.txt:1163",
   "file": "ep_ruri01.txt",
   "line": 1163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ああ、今なら言える。",
   "ko_candidate": "아아､ 이제야 말할 수 있어｡"
  },
  {
   "id": 50521,
   "key": "ep_ruri01.txt:1164",
   "file": "ep_ruri01.txt",
   "line": 1164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ようやく言える。",
   "ko_candidate": "드디어 말할 수 있어｡"
  },
  {
   "id": 50522,
   "key": "ep_ruri01.txt:1165",
   "file": "ep_ruri01.txt",
   "line": 1165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの人に。",
   "ko_candidate": "그 사람에게｡"
  },
  {
   "id": 50523,
   "key": "ep_ruri01.txt:1166",
   "file": "ep_ruri01.txt",
   "line": 1166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "傷だらけのあの人に。",
   "ko_candidate": "상처투성이인 그 사람에게｡"
  },
  {
   "id": 50524,
   "key": "ep_ruri01.txt:1168",
   "file": "ep_ruri01.txt",
   "line": 1168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それでも戦い続けたあの人に。",
   "ko_candidate": "그래도 계속 싸워온 그 사람에게｡"
  },
  {
   "id": 50525,
   "key": "ep_ruri01.txt:1170",
   "file": "ep_ruri01.txt",
   "line": 1170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ずっとずっと、言いたかった、あの言葉を。",
   "ko_candidate": "계속 계속､ 하고 싶었던 그 말을｡"
  },
  {
   "id": 50526,
   "key": "ep_ruri01.txt:1171",
   "file": "ep_ruri01.txt",
   "line": 1171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ずっとずっと、暖め続けていた、あの言葉を。",
   "ko_candidate": "계속 계속､ 마음속에 품어왔던 그 말을｡"
  },
  {
   "id": 50527,
   "key": "ep_ruri01.txt:1173",
   "file": "ep_ruri01.txt",
   "line": 1173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今、ようやく――",
   "ko_candidate": "이제､ 드디어――"
  },
  {
   "id": 50528,
   "key": "ep_ruri01.txt:1187",
   "file": "ep_ruri01.txt",
   "line": 1187,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「おかえりなさい……九郎」",
   "ko_candidate": "「어서 오세요…… 쿠로」"
  },
  {
   "id": 50529,
   "key": "ep_ruri01.txt:1202",
   "file": "ep_ruri01.txt",
   "line": 1202,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして、世界は、ひとまず、閉じる。",
   "ko_candidate": "그리고 세계는 일단 닫힌다｡"
  },
  {
   "id": 50530,
   "key": "ep_ruri01.txt:1203",
   "file": "ep_ruri01.txt",
   "line": 1203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど次こそは――",
   "ko_candidate": "하지만 다음에야말로――"
  },
  {
   "id": 50531,
   "key": "ep_ruri01.txt:1209",
   "file": "ep_ruri01.txt",
   "line": 1209,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「次こそ……か。良いだろう。やって見せておくれ。僕から未来を奪い返してみなよ……」",
   "ko_candidate": "「다음에야말로……인가｡ 좋아｡ 보여주시지｡ 나로부터 미래를 되찾아가 보라고……」"
  },
  {
   "id": 50532,
   "key": "ep_ruri01.txt:1212",
   "file": "ep_ruri01.txt",
   "line": 1212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "次こそは、必ず――。",
   "ko_candidate": "다음에야말로､ 반드시――｡"
  }
 ]
}