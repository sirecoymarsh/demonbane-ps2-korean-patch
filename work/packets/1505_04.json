{
 "packet": "1505_04",
 "scene": "1505",
 "anchor": {
  "hit": 40,
  "total": 43,
  "rate": 0.93
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "ライカ": "라이카",
  "アル・アジフ": "알 아지프",
  "リューガ": "류가",
  "エセルドレーダ": "에셀드레다",
  "ウェスパシアヌス": "베스파시아누스",
  "アンチクロス": "안티크로스",
  "ブラックロッジ": "블랙로지",
  "クトゥルー": "크툴루"
 },
 "items": [
  {
   "id": 42807,
   "key": "D1505al.txt:846",
   "file": "D1505al.txt",
   "line": 846,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "耳元で囁いた。",
   "ko_candidate": "귓가에 속삭였다｡"
  },
  {
   "id": 42808,
   "key": "D1505al.txt:851",
   "file": "D1505al.txt",
   "line": 851,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度こそ、ずっと一緒だな」",
   "ko_candidate": "「이번에야말로､ 계속 함께야」"
  },
  {
   "id": 42809,
   "key": "D1505al.txt:855",
   "file": "D1505al.txt",
   "line": 855,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言葉では応えず、アルは泣きながらただ、うんうんと何度も頷いた。",
   "ko_candidate": "말로는 대답하지 않고､ 알은 울면서 그저 응응하며 여러 번 고개를 끄덕였다｡"
  },
  {
   "id": 42810,
   "key": "D1505le.txt:11",
   "file": "D1505le.txt",
   "line": 11,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これで……邪魔者は居なくなった」",
   "ko_candidate": "「이걸로…… 방해꾼은 사라졌다」"
  },
  {
   "id": 42811,
   "key": "D1505le.txt:14",
   "file": "D1505le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂気に満ちた亀裂の笑みは、もう消え失せた。",
   "ko_candidate": "광기로 가득 찬 균열의 미소는 이미 사라져버렸다｡"
  },
  {
   "id": 42812,
   "key": "D1505le.txt:16",
   "file": "D1505le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胎児の瓶を優しく抱き留める。",
   "ko_candidate": "태아가 든 병을 부드럽게 안아든다｡"
  },
  {
   "id": 42813,
   "key": "D1505le.txt:17",
   "file": "D1505le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慈愛の瞳で、胎児を見下ろしている。",
   "ko_candidate": "자애로운 눈동자로 태아를 내려다보고 있다｡"
  },
  {
   "id": 42814,
   "key": "D1505le.txt:19",
   "file": "D1505le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔弾に撃たれた自らの傷も省みない。",
   "ko_candidate": "마탄에 맞은 자신의 상처는 아랑곳하지 않는다｡"
  },
  {
   "id": 42815,
   "key": "D1505le.txt:20",
   "file": "D1505le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ての愛は、ただ、腕の中の愛しい子へと向けられている。",
   "ko_candidate": "모든 사랑은 오직 팔 안의 사랑스러운 아이에게로만 향해 있다｡"
  },
  {
   "id": 42816,
   "key": "D1505le.txt:24",
   "file": "D1505le.txt",
   "line": 24,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もう少し……もう少しの辛抱です……」",
   "ko_candidate": "「조금만 더…… 조금만 더 참으세요……」"
  },
  {
   "id": 42817,
   "key": "D1505le.txt:27",
   "file": "D1505le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女が胎児に向ける、無償の愛。無限の愛。",
   "ko_candidate": "소녀가 태아에게 보내는 무상의 사랑｡ 무한한 사랑｡"
  },
  {
   "id": 42818,
   "key": "D1505le.txt:28",
   "file": "D1505le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはもう一つの狂気の容。",
   "ko_candidate": "그것은 또 다른 광기의 모습｡"
  },
  {
   "id": 42819,
   "key": "D1505le.txt:30",
   "file": "D1505le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓶を満たす液体の中、胎児は再び身を抱えて眸を閉じる。",
   "ko_candidate": "병을 채운 액체 속에서 태아는 다시 몸을 웅크리고 눈을 감는다｡"
  },
  {
   "id": 42820,
   "key": "D1505le.txt:31",
   "file": "D1505le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "産まれ落ちる瞬間を、夢の中で待ち望みながら。",
   "ko_candidate": "태어나는 순간을､ 꿈속에서 기다리면서｡"
  },
  {
   "id": 42821,
   "key": "D1505le.txt:32",
   "file": "D1505le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もしくは、拒絶しながら。",
   "ko_candidate": "혹은 거부하면서｡"
  },
  {
   "id": 42822,
   "key": "D1505le.txt:36",
   "file": "D1505le.txt",
   "line": 36,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ……ライカ」",
   "ko_candidate": "「자……라이카」"
  },
  {
   "id": 42823,
   "key": "D1505le.txt:40",
   "file": "D1505le.txt",
   "line": 40,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……！」",
   "ko_candidate": "「크윽……!」"
  },
  {
   "id": 42824,
   "key": "D1505le.txt:44",
   "file": "D1505le.txt",
   "line": 44,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガ。アル・アジフを見張りなさい」",
   "ko_candidate": "「류가｡ 알 아지프를 감시해」"
  },
  {
   "id": 42825,
   "key": "D1505le.txt:53",
   "file": "D1505le.txt",
   "line": 53,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 42826,
   "key": "D1505le.txt:57",
   "file": "D1505le.txt",
   "line": 57,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……おのれ」",
   "ko_candidate": "「……이 자식」"
  },
  {
   "id": 42827,
   "key": "D1505le.txt:60",
   "file": "D1505le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルとエセルドレーダの間を阻むように、黒の天使は舞い降りる。",
   "ko_candidate": "알과 에셀드레다 사이를 가로막듯이 검은 천사가 내려온다｡"
  },
  {
   "id": 42828,
   "key": "D1505le.txt:62",
   "file": "D1505le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "相も変わらず、その瞳にはあれほど熾烈に炎えていた意思の輝きは、微塵にも存在しない。",
   "ko_candidate": "여전히 그 눈동자에는 그토록 치열하게 불타올랐던 의지의 빛이 조금도 존재하지 않는다｡"
  },
  {
   "id": 42829,
   "key": "D1505le.txt:63",
   "file": "D1505le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ――",
   "ko_candidate": "단지――"
  },
  {
   "id": 42830,
   "key": "D1505le.txt:69",
   "file": "D1505le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――お前の憎悪を……！",
   "ko_candidate": "――네 증오를……! 「…………읏」"
  },
  {
   "id": 42831,
   "key": "D1505le.txt:76",
   "file": "D1505le.txt",
   "line": 76,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ」 右瞼から右頬を裂く古傷が、灼ける。",
   "ko_candidate": "오른쪽 눈꺼풀에서 오른쪽 뺨을 가르는 옛 상처가 타는 듯하다｡"
  },
  {
   "id": 42832,
   "key": "D1505le.txt:80",
   "file": "D1505le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僅かに、僅かに、血が滲んでいる。",
   "ko_candidate": "조금､ 조금 피가 배어나오고 있다｡"
  },
  {
   "id": 42833,
   "key": "D1505le.txt:87",
   "file": "D1505le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――ライカが刻んだ傷が。",
   "ko_candidate": "――라이카가 새긴 상처가｡"
  },
  {
   "id": 42834,
   "key": "D1505le.txt:89",
   "file": "D1505le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "癒える事の無い、傷痕が――",
   "ko_candidate": "치유될 수 없는 상처가――"
  },
  {
   "id": 42835,
   "key": "D1505le.txt:100",
   "file": "D1505le.txt",
   "line": 100,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『ムーンチャイルド計画』。",
   "ko_candidate": "『문 차일드 계획』｡"
  },
  {
   "id": 42836,
   "key": "D1505le.txt:102",
   "file": "D1505le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アンチクロスが一人ウェスパシアヌス――当時はまだその地位には無く、皇帝の名も冠されていないのだが――の元で進められたプロジェクト。",
   "ko_candidate": "안티 크로스가 혼자 베스파시아누스――당시에는 아직 그 지위에 있지 않았고､ 황제의 이름도 갖지 않았지만――의 밑에서 진행된 프로젝트｡"
  },
  {
   "id": 42837,
   "key": "D1505le.txt:104",
   "file": "D1505le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "人体を魔導兵器と融合させ、強壮たる超戦士を造り上げる計画――というのは表向き。",
   "ko_candidate": "인체를 마도병기와 융합시켜 강력한 초전사를 만들어내는 계획 ――이라는 것은 표면상의 이야기｡"
  },
  {
   "id": 42838,
   "key": "D1505le.txt:106",
   "file": "D1505le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "事実は『ブラックロッジ』の最終目的『Ｃ計画』の要、『Ｃの巫女』を生み出す為の計画だった。",
   "ko_candidate": "사실은 『블랙로지』의 최종 목적인 『C계획』의 핵심､ 『C의 무녀』를 만들어내기 위한 계획이었다｡"
  },
  {
   "id": 42839,
   "key": "D1505le.txt:108",
   "file": "D1505le.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "故にイレギュラーであるリューガを除いて、私を含む試験体は全員女性――神に捧げられる生贄は決まって女なのだ。",
   "ko_candidate": "그래서 이레귤러인 류가를 제외하고､ 나를 포함한 시험체는 모두 여성――신에게 바쳐지는 제물은 으레 여자니까｡"
  },
  {
   "id": 42840,
   "key": "D1505le.txt:110",
   "file": "D1505le.txt",
   "line": 110,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『Ｃ』との接触実験。",
   "ko_candidate": "『C』와의 접촉 실험｡"
  },
  {
   "id": 42841,
   "key": "D1505le.txt:111",
   "file": "D1505le.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "つまり、来るべきクトゥルーとの融合の為、選出した『Ｃの巫女』候補に、邪神の念波を浴びさせ、感応力を強化する実験である。",
   "ko_candidate": "즉､ 다가올 크툴루와의 융합을 위해 선출한 『C의 무녀』 후보에게 사신의 염파를 쬐어 감응력을 강화하는 실험이다｡"
  },
  {
   "id": 42842,
   "key": "D1505le.txt:113",
   "file": "D1505le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "私が候補に選ばれたのは、試験体１号である少女が、『Ｃ』との接触の結果、暴走。『施設』を瘴気で汚染、研究員及び警備兵１０７名を犠牲にした末に、『処分』されてから、数年経った日の事だった。",
   "ko_candidate": "내가 후보로 선택된 것은 시험체 1호인 소녀가 『C』와의 접촉 결과､ 폭주｡ 『시설』을 장기로 오염시키고 연구원 및 경비병 107명을 희생시킨 끝에 『처분』된 지 수년이 지난 날의 일이었다｡"
  },
  {
   "id": 42843,
   "key": "D1505le.txt:115",
   "file": "D1505le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、事の詳細は私達には知らされない。",
   "ko_candidate": "물론 사건의 상세 내용은 우리에게 알려지지 않았다｡"
  },
  {
   "id": 42844,
   "key": "D1505le.txt:117",
   "file": "D1505le.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "精神的魔術的霊的、その他諸々の要素が複雑に絡み合い、デリケートな構造を持つ試験体達に、無用な不安を与えぬ為だ。",
   "ko_candidate": "정신적 마술적 영적､ 그 외 여러 요소가 복잡하게 얽혀있어 섬세한 구조를 가진 시험체들에게 불필요한 불안을 주지 않기 위해서다｡"
  },
  {
   "id": 42845,
   "key": "D1505le.txt:119",
   "file": "D1505le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "１号はただ『事故死』したとだけ伝えられ……まったく通常通り、カリキュラムに従い、日々を消化するだけの生活が戻った。",
   "ko_candidate": "1호는 단지 『사고사』했다고만 전해졌고…… 완전히 평소처럼 커리큘럼에 따라 나날을 소화하는 생활로 돌아갔다｡"
  },
  {
   "id": 42846,
   "key": "D1505le.txt:121",
   "file": "D1505le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが詳細を告げられずとも、皆、分かっていた。",
   "ko_candidate": "하지만 상세 내용을 듣지 않아도 모두 알고 있었다｡"
  }
 ]
}