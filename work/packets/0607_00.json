 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "瑠璃": "루리",
  "ティベリウス": "티베리우스",
  "ブラックロッジ": "블랙로지",
  "アンチクロス": "안티크로스",
  "大導師": "그랜드 마스터",
  "お嬢様": "아가씨"
 },
 "items": [
  {
   "id": 7321,
   "key": "D0607_ps2.txt:28",
   "file": "D0607_ps2.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "瑠璃は自分の部屋から動いていない。",
   "ko_candidate": "루리는 자신의 방에서 움직이지 않았다｡"
  },
  {
   "id": 7322,
   "key": "D0607_ps2.txt:29",
   "file": "D0607_ps2.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "否――動けなかった。",
   "ko_candidate": "아니､ 움직일 수 없었다｡"
  },
  {
   "id": 7323,
   "key": "D0607_ps2.txt:32",
   "file": "D0607_ps2.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "冷たい汗が頬を伝い、顎から滴る。",
   "ko_candidate": "차가운 땀이 뺨을 타고 흘러 턱에서 떨어진다｡"
  },
  {
   "id": 7324,
   "key": "D0607_ps2.txt:33",
   "file": "D0607_ps2.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "膝が笑っていた。",
   "ko_candidate": "무릎이 떨리고 있었다｡"
  },
  {
   "id": 7325,
   "key": "D0607_ps2.txt:36",
   "file": "D0607_ps2.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "如何に毅然な態度を装おうと、 恐怖にはそうそう抗えたものではない。",
   "ko_candidate": "아무리 의연한 태도를 가장하려 해도､ 공포에는 그리 쉽게 저항할 수 없었다｡"
  },
  {
   "id": 7326,
   "key": "D0607_ps2.txt:54",
   "file": "D0607_ps2.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "銃声と爆音は続いている。",
   "ko_candidate": "총성과 폭음은 계속되고 있다｡"
  },
  {
   "id": 7327,
   "key": "D0607_ps2.txt:57",
   "file": "D0607_ps2.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どういう状況なのか、瑠璃に確かめる術はない。",
   "ko_candidate": "무엇이 어떤 상황인지､ 루리는 확인할 방법이 없다｡"
  },
  {
   "id": 7328,
   "key": "D0607_ps2.txt:58",
   "file": "D0607_ps2.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ待つだけの、拷問のような時間は続く。",
   "ko_candidate": "그저 기다리기만 하는､ 고문과도 같은 시간이 계속된다｡"
  },
  {
   "id": 7329,
   "key": "D0607_ps2.txt:66",
   "file": "D0607_ps2.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――ふと、銃声が止んだ。",
   "ko_candidate": "――문득､ 총성이 멈췄다｡"
  },
  {
   "id": 7330,
   "key": "D0607_ps2.txt:67",
   "file": "D0607_ps2.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "警備兵達の怒号や悲鳴も聞こえない。",
   "ko_candidate": "경비병들의 고함소리나 비명도 들리지 않는다｡"
  },
  {
   "id": 7331,
   "key": "D0607_ps2.txt:70",
   "file": "D0607_ps2.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あれだけ騒がしかった邸内は、一瞬で水を打ったように静まり返った。",
   "ko_candidate": "그토록 시끄러웠던 저택 안이 순식간에 물을 뿌린 듯 조용해졌다｡"
  },
  {
   "id": 7332,
   "key": "D0607_ps2.txt:79",
   "file": "D0607_ps2.txt",
   "line": 79,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何……？　どうなったの……？」",
   "ko_candidate": "「뭐지…? 어떻게 된 거지…?」"
  },
  {
   "id": 7333,
   "key": "D0607_ps2.txt:86",
   "file": "D0607_ps2.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "震えた声で呟く。 押し寄せてくる不安――静寂もまた拷問だった。",
   "ko_candidate": "떨리는 목소리로 중얼거린다｡"
  },
  {
   "id": 7334,
   "key": "D0607_ps2.txt:97",
   "file": "D0607_ps2.txt",
   "line": 97,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ぃっ！」 ドアの開く音が静寂を破った。",
   "ko_candidate": "밀려오는 불안――정적 또한 고문이었다｡"
  },
  {
   "id": 7335,
   "key": "D0607_ps2.txt:106",
   "file": "D0607_ps2.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "入ってきたのは警備兵の１人だった。",
   "ko_candidate": "잠시 후､ 문이 열리는 소리가 정적을 깼다｡"
  },
  {
   "id": 7336,
   "key": "D0607_ps2.txt:109",
   "file": "D0607_ps2.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "思わず安堵の吐息を漏らし…… それから慌てて、威厳を取り繕った。",
   "ko_candidate": "놀라 루리는 움찔 몸을 굳혔다｡ 하지만 들어온 것이 경비병 중 한 명인 것을 보고 안도감을 느끼는 동시에､ 위엄을 가장했다｡"
  },
  {
   "id": 7337,
   "key": "D0607_ps2.txt:119",
   "file": "D0607_ps2.txt",
   "line": 119,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「貴方、いったい何が起こったのですか？　報告しなさい」",
   "ko_candidate": "「당신､ 도대체 무슨 일이 일어난 거죠? 보고하세요」"
  },
  {
   "id": 7338,
   "key": "D0607_ps2.txt:125",
   "file": "D0607_ps2.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "警備兵は答えない。",
   "ko_candidate": "경비병은 대답하지 않는다｡"
  },
  {
   "id": 7339,
   "key": "D0607_ps2.txt:126",
   "file": "D0607_ps2.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただ呆けた顔で突っ立っている。",
   "ko_candidate": "그저 멍한 얼굴로 우뚝 서 있다｡ 루리는 짜증이 났다｡"
  },
  {
   "id": 7340,
   "key": "D0607_ps2.txt:135",
   "file": "D0607_ps2.txt",
   "line": 135,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「聞いているのですか！ 返事をしなさい！」",
   "ko_candidate": "「듣고 있는 거예요! 대답하세요!」"
  },
  {
   "id": 7341,
   "key": "D0607_ps2.txt:143",
   "file": "D0607_ps2.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "警備兵は答えない。",
   "ko_candidate": "경비병은 대답하지 않는다｡"
  },
  {
   "id": 7342,
   "key": "D0607_ps2.txt:144",
   "file": "D0607_ps2.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瞳がやけに虚ろで生気が無い。 しかし緊張していた瑠璃はそんなことにも気付かなかった。",
   "ko_candidate": "눈동자가 유난히 공허하고 생기가 없다｡ 하지만 긴장하고 있던 루리는 그런 것까지 눈치채지 못했다｡"
  },
  {
   "id": 7343,
   "key": "D0607_ps2.txt:155",
   "file": "D0607_ps2.txt",
   "line": 155,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いい加減になさい！ わたくしを馬鹿にしているの……」",
   "ko_candidate": "「이제 그만하세요! 저를 바보 취급하는 거예요…」"
  },
  {
   "id": 7344,
   "key": "D0607_ps2.txt:175",
   "file": "D0607_ps2.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ぶくっと。",
   "ko_candidate": "부글부글｡"
  },
  {
   "id": 7345,
   "key": "D0607_ps2.txt:176",
   "file": "D0607_ps2.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "警備兵の頭が膨れ上がった。",
   "ko_candidate": "경비병의 머리가 부풀어 올랐다｡"
  },
  {
   "id": 7346,
   "key": "D0607_ps2.txt:178",
   "file": "D0607_ps2.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そのせいで顔全体が引きつり、まるで出来損ないの福笑いのようになる。",
   "ko_candidate": "그 때문에 얼굴 전체가 일그러져､ 마치 실패한 복면 같았다｡"
  },
  {
   "id": 7347,
   "key": "D0607_ps2.txt:187",
   "file": "D0607_ps2.txt",
   "line": 187,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣……………?」"
  },
  {
   "id": 7348,
   "key": "D0607_ps2.txt:196",
   "file": "D0607_ps2.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瞬く間に全身が膨れ上がる。 警備兵の身体は２倍ほどの大きさになっていた。",
   "ko_candidate": "곧바로 전체가 부풀어 오른다｡ 경비병의 몸은 2배 정도의 크기가 되어 있었다｡"
  },
  {
   "id": 7349,
   "key": "D0607_ps2.txt:199",
   "file": "D0607_ps2.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "膨張が限界に達する――",
   "ko_candidate": "팽창이 한계에 도달한다｡"
  },
  {
   "id": 7350,
   "key": "D0607_ps2.txt:215",
   "file": "D0607_ps2.txt",
   "line": 215,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃあああああああああ！」 爆ぜた。",
   "ko_candidate": "피와 살점을 흩뿌리며､ 경비병의 몸은 사방으로 흩어졌다｡"
  },
  {
   "id": 7351,
   "key": "D0607_ps2.txt:222",
   "file": "D0607_ps2.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血飛沫が瑠璃の元まで飛んできて、頬を汚す。",
   "ko_candidate": "「꺄아아아아아아아!」 「우후후후후｡ 안녕하세요､ 루리 아가씨~」"
  },
  {
   "id": 7352,
   "key": "D0607_ps2.txt:228",
   "file": "D0607_ps2.txt",
   "line": 228,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うふふふふ。おこんばんわっ☆ 瑠璃お嬢ちゃま～ん」",
   "ko_candidate": "문에 다른 인영이 서 있다｡ 가면을 쓴 피투성이의 광대다｡"
  },
  {
   "id": 7353,
   "key": "D0607_ps2.txt:242",
   "file": "D0607_ps2.txt",
   "line": 242,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な、何者ですっ!?」 爆ぜた警備兵の背後に、道化師が立っていた。",
   "ko_candidate": "표정이 없어야 할 가면에 분명한 희열의 빛을 띠며､ 광대는 방 안으로 들어섰다｡"
  },
  {
   "id": 7354,
   "key": "D0607_ps2.txt:248",
   "file": "D0607_ps2.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "濃厚な死臭が瑠璃の部屋を充たしてゆく。 怯えながらも気丈に睨み返す瑠璃を見て、道化師はけたたましく嗤った。",
   "ko_candidate": "「누､ 누구세요!?」"
  },
  {
   "id": 7355,
   "key": "D0607_ps2.txt:255",
   "file": "D0607_ps2.txt",
   "line": 255,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イイわねイイわね 凄くイイわぁんっ！ 健気で素敵よ瑠璃お嬢ちゃあん？」",
   "ko_candidate": "울음을 터뜨릴 것 같은 걸 필사적으로 참으며､ 루리는 따져 묻는다｡ 케라케라케라 하고 광대가 웃었다｡"
  },
  {
   "id": 7356,
   "key": "D0607_ps2.txt:260",
   "file": "D0607_ps2.txt",
   "line": 260,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アタシの名前はティベリウス ――『ブラックロッジ』アンチ クロスが一、ティベリウスよん。 ヨロシクねんっ☆」",
   "ko_candidate": "「좋아 좋아 정말 좋아! 건강하고 멋져 루리 아가씨? 내 이름은 티베리우스―― 『블랙로지』 안티크로스 1､ 티베리우스야｡ 잘 부탁해☆」"
  },
  {
   "id": 7357,
   "key": "D0607_ps2.txt:269",
   "file": "D0607_ps2.txt",
   "line": 269,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アンチクロス……！」",
   "ko_candidate": "「안티크로스…!」"
  },
  {
   "id": 7358,
   "key": "D0607_ps2.txt:274",
   "file": "D0607_ps2.txt",
   "line": 274,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「今日は大導師様の御命令で瑠璃お嬢様のお命を頂戴しに来たワケなんだけど……」",
   "ko_candidate": "「오늘은 <RUBY text=\"그랜드 마스터\">대도사</RUBY>님의 명령으로 루리 아가씨의 목숨을 가지러 왔는데…」"
  },
  {
   "id": 7359,
   "key": "D0607_ps2.txt:280",
   "file": "D0607_ps2.txt",
   "line": 280,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………！」",
   "ko_candidate": "「……………!」"
  },
  {
   "id": 7360,
   "key": "D0607_ps2.txt:285",
   "file": "D0607_ps2.txt",
   "line": 285,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いやねぇ、そんなに怯えなくても大丈夫よぉ。こぉぉんなに可愛らしい瑠璃お嬢ちゃんを殺すだなんて、もったいな過ぎて出来るワケないじゃなぁい？」 「だからね、大導師様にお願いしたのよ。そしたら、ウチのボスったら太っ腹だからあっさり認めてくれたわ」",
   "ko_candidate": "「아니､ 그렇게 겁내지 않아도 괜찮아｡ 이이이렇게 귀여운 루리 아가씨를 죽인다니 너무 아까워서 할 수 없잖아? 그래서 말이야､ <RUBY text=\"그랜드 마스터\">대도사</RUBY>님께 부탁드렸어｡ 그랬더니､ 우리 보스가 너무 관대해서 쉽게 허락해 주셨어」"
  }
 ]
}