 },
 "items": [
  {
   "id": 40140,
   "key": "D1413le.txt:350",
   "file": "D1413le.txt",
   "line": 350,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「無駄だと言ったろう！」",
   "ko_candidate": "「헛수고라고 했잖나!」"
  },
  {
   "id": 40141,
   "key": "D1413le.txt:357",
   "file": "D1413le.txt",
   "line": 357,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！　ティマイオス！　クリティアス！」",
   "ko_candidate": "「큿……! 티마이오스! 크리티오스!」"
  },
  {
   "id": 40142,
   "key": "D1413le.txt:360",
   "file": "D1413le.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砲身の一つが、こちらに向かって大出力ビームを放つ。",
   "ko_candidate": "포신 하나가 이쪽을 향해 대출력 빔을 발사한다｡"
  },
  {
   "id": 40143,
   "key": "D1413le.txt:361",
   "file": "D1413le.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即座に空間反転エネルギーを開放して、その場より飛び退いた。",
   "ko_candidate": "즉시 공간반전 에너지를 개방하여 그 자리에서 뛰어올랐다｡"
  },
  {
   "id": 40144,
   "key": "D1413le.txt:362",
   "file": "D1413le.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "高熱に、血の海が蒸発する。",
   "ko_candidate": "고열에 피바다가 증발한다｡"
  },
  {
   "id": 40145,
   "key": "D1413le.txt:368",
   "file": "D1413le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳びながら、今度は『イタクァ』を放つ。",
   "ko_candidate": "뛰면서 이번에는 『이타콰』를 발사한다｡"
  },
  {
   "id": 40146,
   "key": "D1413le.txt:374",
   "file": "D1413le.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがこっちは魔法障壁を撃ち破るだけの威力を得られなかった。",
   "ko_candidate": "하지만 이쪽은 마법 장벽을 격파할 만한 위력을 얻지 못했다｡"
  },
  {
   "id": 40147,
   "key": "D1413le.txt:376",
   "file": "D1413le.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "虚しく喰い止められ、血の海に落ちる。",
   "ko_candidate": "헛되이 저지당하고 피바다에 떨어진다｡"
  },
  {
   "id": 40148,
   "key": "D1413le.txt:381",
   "file": "D1413le.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "つまりは、そういうことか！",
   "ko_candidate": "즉､ 그런 거로군!"
  },
  {
   "id": 40149,
   "key": "D1413le.txt:382",
   "file": "D1413le.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの防禦陣をどうにかしなければ……神獣弾を撃ち込むか？",
   "ko_candidate": "저 방어진을 어떻게든 해야……신수탄을 쏴 넣을까?"
  },
  {
   "id": 40150,
   "key": "D1413le.txt:384",
   "file": "D1413le.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがアレはそれほど弾数がない。",
   "ko_candidate": "하지만 그건 그다지 탄수가 많지 않다｡"
  },
  {
   "id": 40151,
   "key": "D1413le.txt:385",
   "file": "D1413le.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確実に仕留めなければ、逆にこっちの勝ち目が無くなる……。",
   "ko_candidate": "확실히 처치하지 않으면 오히려 이쪽의 승산이 없어진다……"
  },
  {
   "id": 40152,
   "key": "D1413le.txt:392",
   "file": "D1413le.txt",
   "line": 392,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ、私の前に傅け！　この地球皇帝アウグストゥスに平伏せよ！」 「脆弱な！　人間共よ！」",
   "ko_candidate": "「자､ 내 앞에 엎드려라! 이 지구황제 아우구스투스에게 굴복하라! 나약한! 인간들이여!」"
  },
  {
   "id": 40153,
   "key": "D1413le.txt:399",
   "file": "D1413le.txt",
   "line": 399,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チッ……！」",
   "ko_candidate": "「칫……!」"
  },
  {
   "id": 40154,
   "key": "D1413le.txt:403",
   "file": "D1413le.txt",
   "line": 403,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅ……！」",
   "ko_candidate": "「크윽……!」"
  },
  {
   "id": 40155,
   "key": "D1413le.txt:412",
   "file": "D1413le.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次々と放たれるビームの嵐。シャンタクと脚部シールドをフル稼働させ、曲芸じみた動きで回避し続ける。",
   "ko_candidate": "연이어 발사되는 빔의 폭풍｡ 샨타크와 다리부 실드를 풀가동시켜 곡예에 가까운 움직임으로 계속 회피한다｡"
  },
  {
   "id": 40156,
   "key": "D1413le.txt:414",
   "file": "D1413le.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンもまた同様に、網の目を縫うようにビームを掻い潜る。",
   "ko_candidate": "산달폰도 마찬가지로 그물코를 뚫듯이 빔을 빠져나간다｡"
  },
  {
   "id": 40157,
   "key": "D1413le.txt:416",
   "file": "D1413le.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "向こうは、一撃もらえば蒸発必至。デモンベインも直撃を喰らえば無事ではいられない。",
   "ko_candidate": "저쪽은 한 방 맞으면 증발 필사｡ 데몬베인도 직격탄을 맞으면 무사하지 못할 것이다｡"
  },
  {
   "id": 40158,
   "key": "D1413le.txt:417",
   "file": "D1413le.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こいつは、あまりにも分が悪いな……。",
   "ko_candidate": "이놈은 너무 불리하군……"
  },
  {
   "id": 40159,
   "key": "D1413le.txt:419",
   "file": "D1413le.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か無いか？",
   "ko_candidate": "뭔가 없나?"
  },
  {
   "id": 40160,
   "key": "D1413le.txt:420",
   "file": "D1413le.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの金ピカ野郎に、神獣を確実にブチ極める手段は。",
   "ko_candidate": "저 금빛 녀석에게 신수를 확실히 박아 넣을 방법은｡"
  },
  {
   "id": 40161,
   "key": "D1413le.txt:421",
   "file": "D1413le.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪神の力を突破する術は――！",
   "ko_candidate": "사신의 힘을 돌파할 술법은――!"
  },
  {
   "id": 40162,
   "key": "D1413le.txt:429",
   "file": "D1413le.txt",
   "line": 429,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「殺アアアアァァァァァァァ――――！」",
   "ko_candidate": "「죽여어어어어어어어어어어――――!」"
  },
  {
   "id": 40163,
   "key": "D1413le.txt:432",
   "file": "D1413le.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "二度も通じなかったというのに、サンダルフォンはまたしても特攻を仕掛ける。勝算もヘッタクレもない。",
   "ko_candidate": "두 번이나 통하지 않았는데도 산달폰은 또다시 특공을 감행한다｡ 승산도 아무것도 없다｡"
  },
  {
   "id": 40164,
   "key": "D1413le.txt:433",
   "file": "D1413le.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ闘争本能の駆り立てるままに、挑みかかる。",
   "ko_candidate": "그저 투쟁본능에 이끌리는 대로 달려든다｡"
  },
  {
   "id": 40165,
   "key": "D1413le.txt:440",
   "file": "D1413le.txt",
   "line": 440,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これだけやられても、まだ理解出来ないとは――ふははは、ケダモノ以下だな、サンダルフォン！」",
   "ko_candidate": "「이 정도 당하고도 아직 이해하지 못하다니――후하하하､ 짐승 이하로군､ 산달폰!」"
  },
  {
   "id": 40166,
   "key": "D1413le.txt:444",
   "file": "D1413le.txt",
   "line": 444,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再び障壁がハンティング・ホラーを阻み、魔力の火花がサンダルフォンを灼く。",
   "ko_candidate": "다시 장벽이 헌팅 호러를 막고 마력의 불꽃이 산달폰을 태운다｡"
  },
  {
   "id": 40167,
   "key": "D1413le.txt:448",
   "file": "D1413le.txt",
   "line": 448,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアアァァァ！　餓アアアアアァァァァァッ！」",
   "ko_candidate": "「아아아아아! 으아아아아아아아아아앗!」"
  },
  {
   "id": 40168,
   "key": "D1413le.txt:451",
   "file": "D1413le.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、今度は退かない。",
   "ko_candidate": "하지만 이번에는 물러서지 않는다｡"
  },
  {
   "id": 40169,
   "key": "D1413le.txt:453",
   "file": "D1413le.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を苛む激痛を意に介せず、スロットルを回す。",
   "ko_candidate": "온몸을 괴롭히는 격통을 아랑곳하지 않고 스로틀을 돌린다｡"
  },
  {
   "id": 40170,
   "key": "D1413le.txt:454",
   "file": "D1413le.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闘争の歓喜に打ち震えるかの如く、ハンティング・ホラーのエンジンが吼え猛る。",
   "ko_candidate": "투쟁의 환희에 전율하듯 헌팅 호러의 엔진이 포효한다｡"
  },
  {
   "id": 40171,
   "key": "D1413le.txt:460",
   "file": "D1413le.txt",
   "line": 460,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほう？　頑張るなぁ！」",
   "ko_candidate": "「호오? 열심히 하는군!」"
  },
  {
   "id": 40172,
   "key": "D1413le.txt:464",
   "file": "D1413le.txt",
   "line": 464,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアアアアアアアアァァァァ――――！」",
   "ko_candidate": "「아아아아아아아아아아아――――!」"
  },
  {
   "id": 40173,
   "key": "D1413le.txt:468",
   "file": "D1413le.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティング・ホラーが赤熱する。",
   "ko_candidate": "헌팅 호러가 적열한다｡"
  },
  {
   "id": 40174,
   "key": "D1413le.txt:469",
   "file": "D1413le.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機関部からは小爆発が相次ぎ、サンダルフォンの全身から噴き出る血は、紅い霧となって纏わりつく。",
   "ko_candidate": "기관부에서는 소폭발이 잇따르고 산달폰의 전신에서 분출하는 피는 붉은 안개가 되어 감싼다｡"
  },
  {
   "id": 40175,
   "key": "D1413le.txt:471",
   "file": "D1413le.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでも、サンダルフォンは止まらない。",
   "ko_candidate": "그래도 산달폰은 멈추지 않는다｡"
  },
  {
   "id": 40176,
   "key": "D1413le.txt:472",
   "file": "D1413le.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右瞼から頬までを走る傷が、炎える様に紅く輝く。",
   "ko_candidate": "오른쪽 눈꺼풀에서 뺨까지 이어지는 상처가 불타오르듯 붉게 빛난다｡"
  },
  {
   "id": 40177,
   "key": "D1413le.txt:476",
   "file": "D1413le.txt",
   "line": 476,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカァァァ……！」",
   "ko_candidate": "「라이카아아아……!」"
  },
  {
   "id": 40178,
   "key": "D1413le.txt:479",
   "file": "D1413le.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その咽喉から迸る言葉に、俺の心臓は一瞬、烈しく脈打った。",
   "ko_candidate": "그 목구멍에서 터져 나오는 말에 내 심장이 순간 격렬하게 고동쳤다｡"
  },
  {
   "id": 40179,
   "key": "D1413le.txt:481",
   "file": "D1413le.txt",
   "line": 481,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンはなおも搾り出す様な聲で",
   "ko_candidate": "산달폰은 여전히 짜내는 듯한 목소리로"
  }
 ]
}