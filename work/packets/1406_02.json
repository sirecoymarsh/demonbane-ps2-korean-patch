 "items": [
  {
   "id": 37642,
   "key": "D1406le.txt:299",
   "file": "D1406le.txt",
   "line": 299,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おい、どうした!?　応答しろ！　応答を……くそっ！」",
   "ko_candidate": "「연금술도 마술도 이해 못 하는､ 그 망할 사이비 도사가 4호에게 쓸데없는 짓을 하니까……!」"
  },
  {
   "id": 37643,
   "key": "D1406le.txt:303",
   "file": "D1406le.txt",
   "line": 303,
   "speaker": "研究員Ａ通信",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ティファレト層、突破されました！」",
   "ko_candidate": "「티파레트 층､ 돌파당했습니다!」"
  },
  {
   "id": 37644,
   "key": "D1406le.txt:307",
   "file": "D1406le.txt",
   "line": 307,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「残りの試験体を全部、迎撃に向かわせろ！　施設内で５号に対抗出来る戦力は彼女等しか居ない！」",
   "ko_candidate": "「남은 시험체를 전부 요격에 투입해! 시설 내에서 5호에 대항할 수 있는 전력은 그녀들뿐이야!」"
  },
  {
   "id": 37645,
   "key": "D1406le.txt:311",
   "file": "D1406le.txt",
   "line": 311,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こんな時に、我々の導師が居れば……！」",
   "ko_candidate": "「이런 때에 우리의 도사가 있었다면……!」"
  },
  {
   "id": 37646,
   "key": "D1406le.txt:314",
   "file": "D1406le.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溶けた意識の中、怒声は相変わらず、私の意識の中では意味を形成しない。",
   "ko_candidate": "녹아내린 의식 속에서 분노에 찬 목소리는 여전히 내 의식 속에서 의미를 형성하지 못한다｡"
  },
  {
   "id": 37647,
   "key": "D1406le.txt:315",
   "file": "D1406le.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それでも私は何となく理解していた。",
   "ko_candidate": "하지만､ 그래도 나는 어렴풋이 이해하고 있었다｡"
  },
  {
   "id": 37648,
   "key": "D1406le.txt:317",
   "file": "D1406le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かが、誰かが、私を白の牢獄から救い出しに来たのだということを。",
   "ko_candidate": "무언가가､ 누군가가､ 나를 하얀 감옥에서 구해내러 왔다는 것을｡"
  },
  {
   "id": 37649,
   "key": "D1406le.txt:319",
   "file": "D1406le.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが喜びも、その誰かに対する愛しさも、総ては意識の奥深く、カタチを作る事無く、封印され、断絶されている。",
   "ko_candidate": "하지만 기쁨도､ 그 누군가에 대한 사랑도､ 모든 것이 의식 깊숙이､ 형태를 이루지 못한 채､ 봉인되고､ 단절되어 있다｡"
  },
  {
   "id": 37650,
   "key": "D1406le.txt:323",
   "file": "D1406le.txt",
   "line": 323,
   "speaker": "研究員Ｄ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ああ……試験体……全滅です……っ！」",
   "ko_candidate": "「아…… 아아…… 시험체…… 전멸입니다……!」"
  },
  {
   "id": 37651,
   "key": "D1406le.txt:327",
   "file": "D1406le.txt",
   "line": 327,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、それ程までとは……」",
   "ko_candidate": "「그､ 그 정도까지라니……」"
  },
  {
   "id": 37652,
   "key": "D1406le.txt:331",
   "file": "D1406le.txt",
   "line": 331,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「儀式どころではない！　わ、我々も退避を……っ！」",
   "ko_candidate": "「의식은 고사하고! 우､ 우리도 대피를……!」"
  },
  {
   "id": 37653,
   "key": "D1406le.txt:335",
   "file": "D1406le.txt",
   "line": 335,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、そうだ！　４号を囮に使えば……術式を改竄して、外部から操作出来るか!?」",
   "ko_candidate": "「그､ 그래! 4호를 미끼로 쓰면…… 술식을 개찬해서 외부에서 조작할 수 있을까!?」"
  },
  {
   "id": 37654,
   "key": "D1406le.txt:339",
   "file": "D1406le.txt",
   "line": 339,
   "speaker": "研究員Ｄ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「や、やってみます……！」",
   "ko_candidate": "「해､ 해보겠습니다……!」"
  },
  {
   "id": 37655,
   "key": "D1406le.txt:343",
   "file": "D1406le.txt",
   "line": 343,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待て！　それだとＣとの接触に支障が出るやも……」",
   "ko_candidate": "「잠깐! 그러면 C와의 접촉에 지장이 생길지도……」"
  },
  {
   "id": 37656,
   "key": "D1406le.txt:347",
   "file": "D1406le.txt",
   "line": 347,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんな事を気にしている場合か！」",
   "ko_candidate": "「그런 걸 신경 쓸 때냐!」"
  },
  {
   "id": 37657,
   "key": "D1406le.txt:351",
   "file": "D1406le.txt",
   "line": 351,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だが、他の試験体ももう居ないのだぞ！　ここは４号も連れて……う、うわああああ！」",
   "ko_candidate": "「하지만 다른 시험체도 이제 없잖아! 여기서 4호도 데리고…… 우､ 우와아아아!」"
  },
  {
   "id": 37658,
   "key": "D1406le.txt:357",
   "file": "D1406le.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
