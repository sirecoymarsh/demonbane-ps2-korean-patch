 },
 "items": [
  {
   "id": 11429,
   "key": "D0753.txt:187",
   "file": "D0753.txt",
   "line": 187,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「がはあっ！」",
   "ko_candidate": ""
  },
  {
   "id": 11430,
   "key": "D0753.txt:190",
   "file": "D0753.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァの手が、俺の首を掴んだ。",
   "ko_candidate": ""
  },
  {
   "id": 11431,
   "key": "D0753.txt:191",
   "file": "D0753.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "指に力を込めて、咽喉を締め上げてくる。",
   "ko_candidate": ""
  },
  {
   "id": 11432,
   "key": "D0753.txt:194",
   "file": "D0753.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だが、それ自体は平気だった。多少苦しいがイタクァには、このまま絞め落としたり首をヘシ折ったりする意図はないらしい。",
   "ko_candidate": ""
  },
  {
   "id": 11433,
   "key": "D0753.txt:196",
   "file": "D0753.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それよりも深刻なのは――",
   "ko_candidate": ""
  },
  {
   "id": 11434,
   "key": "D0753.txt:204",
   "file": "D0753.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "冷たさだった。",
   "ko_candidate": ""
  },
  {
   "id": 11435,
   "key": "D0753.txt:206",
   "file": "D0753.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "全身の熱が一気に奪われた。",
   "ko_candidate": ""
  },
  {
   "id": 11436,
   "key": "D0753.txt:207",
   "file": "D0753.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "冷気は刺すように、むしろ裂くように、躰を痛めつける。",
   "ko_candidate": ""
  },
  {
   "id": 11437,
   "key": "D0753.txt:210",
   "file": "D0753.txt",
   "line": 210,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ああっ……くぅ……かぁぁっ……っ！」",
   "ko_candidate": ""
  },
  {
   "id": 11438,
   "key": "D0753.txt:213",
   "file": "D0753.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "指先に霜が貼りついている。掴まれた咽喉は、薄い氷の皮膜で覆われてしまっていた。",
   "ko_candidate": ""
  },
  {
   "id": 11439,
   "key": "D0753.txt:220",
   "file": "D0753.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "マトモな生き物ならば決して生きていられないほどの低温。だけど不思議と、俺の身体は死には至らない。",
   "ko_candidate": ""
  },
  {
   "id": 11440,
   "key": "D0753.txt:224",
   "file": "D0753.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ただ……体内に染み込む冷気は、身体の器官を速やかに侵略し、俺の肉体を人間とは別の、まったく異質な生物へと変貌させようとしていた。",
   "ko_candidate": ""
  },
  {
   "id": 11441,
   "key": "D0753.txt:227",
   "file": "D0753.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "馬鹿言え……！　化け物どものお仲間になんか、なってたまるかよ……！",
   "ko_candidate": ""
  },
  {
   "id": 11442,
   "key": "D0753.txt:232",
   "file": "D0753.txt",
   "line": 232,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ああッ……！」",
   "ko_candidate": ""
  },
  {
   "id": 11443,
   "key": "D0753.txt:235",
   "file": "D0753.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァの腕を掴もうとする……が、かじかんだ手は思うように動かない。そもそも腕に力が入らない。",
   "ko_candidate": ""
  },
  {
   "id": 11444,
   "key": "D0753.txt:238",
   "file": "D0753.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "……マズイ状況だ。",
   "ko_candidate": ""
  },
  {
   "id": 11445,
   "key": "D0753.txt:247",
   "file": "D0753.txt",
   "line": 247,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――ふっ」",
   "ko_candidate": ""
  },
  {
   "id": 11446,
   "key": "D0753.txt:258",
   "file": "D0753.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァの貌が迫る。",
   "ko_candidate": ""
  },
  {
   "id": 11447,
   "key": "D0753.txt:259",
   "file": "D0753.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "唇が重なる。",
   "ko_candidate": ""
  },
  {
   "id": 11448,
   "key": "D0753.txt:260",
   "file": "D0753.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "冷気が流し込まれる。",
   "ko_candidate": ""
  },
  {
   "id": 11449,
   "key": "D0753.txt:263",
   "file": "D0753.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "躰の中に吹雪が吹き抜けた。",
   "ko_candidate": ""
  },
  {
   "id": 11450,
   "key": "D0753.txt:264",
   "file": "D0753.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "躰の髄まで凍りつく感覚。",
   "ko_candidate": ""
  },
  {
   "id": 11451,
   "key": "D0753.txt:267",
   "file": "D0753.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "意識が遠くなる。",
   "ko_candidate": ""
  },
  {
   "id": 11452,
   "key": "D0753.txt:268",
   "file": "D0753.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "これは……マズイ……ッ。",
   "ko_candidate": ""
  },
  {
   "id": 11453,
   "key": "D0753.txt:274",
   "file": "D0753.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "意識が途絶える寸前だった。",
   "ko_candidate": ""
  },
  {
   "id": 11454,
   "key": "D0753.txt:279",
   "file": "D0753.txt",
   "line": 279,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――ッ!?」",
   "ko_candidate": ""
  },
  {
   "id": 11455,
   "key": "D0753.txt:296",
   "file": "D0753.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "冷気を追い払うように、突然、身体の奥から湧いてくる熱気。瞬く間に全身に広がり、冷気に侵された俺の身体を癒す。",
   "ko_candidate": ""
  },
  {
   "id": 11456,
   "key": "D0753.txt:299",
   "file": "D0753.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "弾かれたように、イタクァは手を離した。",
   "ko_candidate": ""
  },
  {
   "id": 11457,
   "key": "D0753.txt:300",
   "file": "D0753.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺はその場にくずおれる。",
   "ko_candidate": ""
  },
  {
   "id": 11458,
   "key": "D0753.txt:303",
   "file": "D0753.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "……何が起こった？",
   "ko_candidate": ""
  },
  {
   "id": 11459,
   "key": "D0753.txt:304",
   "file": "D0753.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何が俺を救ったんだ？",
   "ko_candidate": ""
  },
  {
   "id": 11460,
   "key": "D0753.txt:308",
   "file": "D0753.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "回廊の奥が、陽炎で揺らめいた。",
   "ko_candidate": ""
  },
  {
   "id": 11461,
   "key": "D0753.txt:309",
   "file": "D0753.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァとは正反対に、熱気を放つ存在が近づいて来ている。",
   "ko_candidate": ""
  },
  {
   "id": 11462,
   "key": "D0753.txt:322",
   "file": "D0753.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "眩しい光が影絵の世界を染める。白い焔に包まれた一匹の獣が闇の奥から、姿を現す。",
   "ko_candidate": ""
  },
  {
   "id": 11463,
   "key": "D0753.txt:324",
   "file": "D0753.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "こいつは……!?",
   "ko_candidate": ""
  },
  {
   "id": 11464,
   "key": "D0753.txt:338",
   "file": "D0753.txt",
   "line": 338,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「クトゥグア!?」",
   "ko_candidate": ""
  },
  {
   "id": 11465,
   "key": "D0753.txt:341",
   "file": "D0753.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "獣の姿だった。サイズは小さく、光度も低い。",
   "ko_candidate": ""
  },
  {
   "id": 11466,
   "key": "D0753.txt:342",
   "file": "D0753.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何より周囲を融解させるほどの高熱は発していない。",
   "ko_candidate": ""
  },
  {
   "id": 11467,
   "key": "D0753.txt:345",
   "file": "D0753.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だが、間違いない。",
   "ko_candidate": ""
  },
  {
   "id": 11468,
   "key": "D0753.txt:346",
   "file": "D0753.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "この魔力の気配……確かにクトゥグアだ。",
   "ko_candidate": ""
  }
 ]
}