 },
 "items": [
  {
   "id": 23303,
   "key": "D1104le.txt:57",
   "file": "D1104le.txt",
   "line": 57,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん……聞いてくれる？」 「私のこと。私達のこと。 ライカとリューガのこと。 そして、メタトロンと サンダルフォンのこと」",
   "ko_candidate": "「쿠로 군……들어줄래? 나에 대해서｡ 우리에 대해서｡ 라이카와 류가에 대해서｡ 그리고 메타트론과 산달폰에 대해서」"
  },
  {
   "id": 23304,
   "key": "D1104le.txt:68",
   "file": "D1104le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "向こうから話を切り出してきた。",
   "ko_candidate": "저쪽에서 먼저 말을 꺼냈다｡"
  },
  {
   "id": 23305,
   "key": "D1104le.txt:69",
   "file": "D1104le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "是非もない。俺は黙って頷いた。",
   "ko_candidate": "어쩔 수 없다｡ 나는 말없이 고개를 끄덕였다｡"
  },
  {
   "id": 23306,
   "key": "D1104le.txt:71",
   "file": "D1104le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんは目を瞑る。",
   "ko_candidate": "라이카 씨는 눈을 감는다｡"
  },
  {
   "id": 23307,
   "key": "D1104le.txt:73",
   "file": "D1104le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……初めて見る、ライカさんの表情。",
   "ko_candidate": "……처음 보는 라이카 씨의 표정｡"
  },
  {
   "id": 23308,
   "key": "D1104le.txt:74",
   "file": "D1104le.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "多分、彼女の隠していた素顔のひとつ。",
   "ko_candidate": "아마도 그녀가 숨기고 있던 본모습 중 하나일 것이다｡"
  },
  {
   "id": 23309,
   "key": "D1104le.txt:75",
   "file": "D1104le.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはまるで夢でも見ているかのようで――",
   "ko_candidate": "그것은 마치 꿈을 꾸고 있는 것 같아서――"
  },
  {
   "id": 23310,
   "key": "D1104le.txt:82",
   "file": "D1104le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……本当に夢だったら、どんなに良かったろう。",
   "ko_candidate": "……정말로 꿈이었다면 얼마나 좋았을까｡"
  },
  {
   "id": 23311,
   "key": "D1104le.txt:83",
   "file": "D1104le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それとも本当に夢だったら…… それは、とても悲しいことなのか。",
   "ko_candidate": "아니면 정말로 꿈이었다면……그것은 매우 슬픈 일일까｡"
  },
  {
   "id": 23312,
   "key": "D1104le.txt:86",
   "file": "D1104le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去への憧憬。",
   "ko_candidate": "과거에 대한 동경｡"
  },
  {
   "id": 23313,
   "key": "D1104le.txt:87",
   "file": "D1104le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去への憎悪。",
   "ko_candidate": "과거에 대한 증오｡"
  },
  {
   "id": 23314,
   "key": "D1104le.txt:89",
   "file": "D1104le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いずれにしても切実過ぎる。",
   "ko_candidate": "어느 쪽이든 너무나 절실하다｡"
  },
  {
   "id": 23315,
   "key": "D1104le.txt:90",
   "file": "D1104le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛切過ぎて……区別がつかない。",
   "ko_candidate": "너무나 통렬해서……구별이 되지 않는다｡"
  },
  {
   "id": 23316,
   "key": "D1104le.txt:92",
   "file": "D1104le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私は語る。",
   "ko_candidate": "나는 말한다｡"
  },
  {
   "id": 23317,
   "key": "D1104le.txt:93",
   "file": "D1104le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私の白い記憶を。",
   "ko_candidate": "나의 하얀 기억을｡"
  },
  {
   "id": 23318,
   "key": "D1104le.txt:94",
   "file": "D1104le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪いに等しい想いの強さで。",
   "ko_candidate": "저주에 가까운 마음의 강렬함으로｡"
  },
  {
   "id": 23319,
   "key": "D1104le.txt:95",
   "file": "D1104le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼を、大十字九郎を呑み込んでしまえと――",
   "ko_candidate": "그를､ 다이쥬지 쿠로를 삼켜버리라고――"
  },
  {
   "id": 23320,
   "key": "D1104le.txt:99",
   "file": "D1104le.txt",
   "line": 99,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「リューガが言ってた通り、 あの子は、私の弟。 私達はこの世界でただ２人きりの姉弟だった――」",
   "ko_candidate": "「류가가 말한 대로 그 아이는 내 동생이야｡ 우리는 이 세상에서 단 둘뿐인 남매였어――」"
  },
  {
   "id": 23321,
   "key": "D1104le.txt:109",
   "file": "D1104le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "親の顔は知らない。",
   "ko_candidate": "부모의 얼굴은 모른다｡"
  },
  {
   "id": 23322,
   "key": "D1104le.txt:110",
   "file": "D1104le.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから、リューガだけが私の唯１人の血縁。",
   "ko_candidate": "그래서 류가만이 내 유일한 혈연이었다｡"
  },
  {
   "id": 23323,
   "key": "D1104le.txt:111",
   "file": "D1104le.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "孤児院の頃からずっと２人寄り添い、生きてきた。",
   "ko_candidate": "고아원 시절부터 줄곧 둘이 의지하며 살아왔다｡"
  },
  {
   "id": 23324,
   "key": "D1104le.txt:112",
   "file": "D1104le.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "きっと世界に拠り所は、 互いの中にしか見い出せなかったから。",
   "ko_candidate": "아마도 세상에 의지할 곳은 서로에게서밖에 찾을 수 없었기 때문일 것이다｡"
  },
  {
   "id": 23325,
   "key": "D1104le.txt:120",
   "file": "D1104le.txt",
   "line": 120,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『施設』に引き取られてからも、 私達は２人一緒だった。",
   "ko_candidate": "『시설』에 인계된 후에도 우리는 둘이 함께였다｡"
  },
  {
   "id": 23326,
   "key": "D1104le.txt:122",
   "file": "D1104le.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "でも、もしかしたら孤児院の頃よりもずっと、 自分の居場所を実感出来ていたかも知れない。",
   "ko_candidate": "하지만 어쩌면 고아원 시절보다 훨씬 더 자신의 거처를 실감할 수 있었을지도 모른다｡"
  },
  {
   "id": 23327,
   "key": "D1104le.txt:125",
   "file": "D1104le.txt",
   "line": 125,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『施設』は、私を必要としてくれたから。",
   "ko_candidate": "『시설』은 나를 필요로 해주었으니까｡"
  },
  {
   "id": 23328,
   "key": "D1104le.txt:126",
   "file": "D1104le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが一方的に与えられるだけの、あまりにも安直な生の意味だったとしても、何も持たない私達には、それに縋るしかなかった。",
   "ko_candidate": "그것이 일방적으로 주어지는､ 너무나도 안이한 삶의 의미였다 해도､ 아무것도 가진 게 없는 우리에겐 그것에 매달릴 수밖에 없었다｡"
  },
  {
   "id": 23329,
   "key": "D1104le.txt:138",
   "file": "D1104le.txt",
   "line": 138,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『施設』の正体は、とある機関の 研究所。つまり…… 私達は実験体だったわけ」",
   "ko_candidate": "「『시설』의 정체는 어떤 기관의 연구소야｡ 그러니까…… 우리는 실험체였던 거네」"
  },
  {
   "id": 23330,
   "key": "D1104le.txt:144",
   "file": "D1104le.txt",
   "line": 144,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……っ」",
   "ko_candidate": "「……읏」"
  },
  {
   "id": 23331,
   "key": "D1104le.txt:146",
   "file": "D1104le.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思わず息を呑んだ。",
   "ko_candidate": "나도 모르게 숨을 삼켰다｡"
  },
  {
   "id": 23332,
   "key": "D1104le.txt:147",
   "file": "D1104le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まったく予測できなかったワケではないが……",
   "ko_candidate": "전혀 예측하지 못했던 건 아니지만……"
  },
  {
   "id": 23333,
   "key": "D1104le.txt:151",
   "file": "D1104le.txt",
   "line": 151,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ただ酷いことはされなかったよ。彼らの研究に適性を持つ人材が少なかったせいかな？　……私達は大事に扱われた。まるで病院の入院患者みたいに」",
   "ko_candidate": "「그래도 너무 심한 일은 당하지 않았어｡ 그들의 연구에 적성을 가진 인재가 적어서일까? ……우리는 소중하게 다뤄졌어｡ 마치 병원의 입원 환자처럼 말이야」"
  },
  {
   "id": 23334,
   "key": "D1104le.txt:159",
   "file": "D1104le.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い記憶はそこから始まる。",
   "ko_candidate": "하얀 기억은 거기서부터 시작된다｡"
  },
  {
   "id": 23335,
   "key": "D1104le.txt:161",
   "file": "D1104le.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しろい、ベッドと",
   "ko_candidate": "하얀､ 침대와 하얀､ 시트와"
  },
  {
   "id": 23336,
   "key": "D1104le.txt:163",
   "file": "D1104le.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しろい、シーツと",
   "ko_candidate": "하얀､ 천장과"
  },
  {
   "id": 23337,
   "key": "D1104le.txt:165",
   "file": "D1104le.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しろい、天井と",
   "ko_candidate": "하얀､ 벽과"
  },
  {
   "id": 23338,
   "key": "D1104le.txt:167",
   "file": "D1104le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しろい、かべと",
   "ko_candidate": "하얀､ 바닥과"
  },
  {
   "id": 23339,
   "key": "D1104le.txt:169",
   "file": "D1104le.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しろい、ゆかと",
   "ko_candidate": "하얀､ 커튼과――"
  },
  {
   "id": 23340,
   "key": "D1104le.txt:171",
   "file": "D1104le.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しろい、カーテンと――",
   "ko_candidate": "어디를 가도 하얀 방｡"
  },
  {
   "id": 23341,
   "key": "D1104le.txt:178",
   "file": "D1104le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処に行っても白い部屋。",
   "ko_candidate": "무엇을 하든 하얀 방｡"
  },
  {
   "id": 23342,
   "key": "D1104le.txt:184",
   "file": "D1104le.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何をするにも白い部屋。",
   "ko_candidate": "이동할 때는､ 하얀 복도｡"
  }
 ]
}