 },
 "items": [
  {
   "id": 30530,
   "key": "D1216le.txt:97",
   "file": "D1216le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マズいマズいマズい！",
   "ko_candidate": "서툴러 서툴러 서툴러!"
  },
  {
   "id": 30531,
   "key": "D1216le.txt:99",
   "file": "D1216le.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何だか良く分からないが……途轍もなく異様なことが起きようとしている！",
   "ko_candidate": "뭔지 잘 모르겠지만…… 엄청나게 이상한 일이 일어나려 하고 있어!"
  },
  {
   "id": 30532,
   "key": "D1216le.txt:100",
   "file": "D1216le.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんを、この怪異から救い出さないと！",
   "ko_candidate": "라이카 씨를 이 괴이에서 구해내야 해!"
  },
  {
   "id": 30533,
   "key": "D1216le.txt:102",
   "file": "D1216le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身が上げる悲鳴には聴く耳をもたず、俺は立ち上がる。",
   "ko_candidate": "온몸이 지르는 비명은 귀담아듣지 않고 나는 일어선다｡"
  },
  {
   "id": 30534,
   "key": "D1216le.txt:103",
   "file": "D1216le.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、遅かった。",
   "ko_candidate": "하지만 늦었다｡"
  },
  {
   "id": 30535,
   "key": "D1216le.txt:105",
   "file": "D1216le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が駈け出すより……そしてハンティング・ホラーがライカさんを蹂躙、制圧するよりも早かった。",
   "ko_candidate": "내가 달려나가는 것보다…… 그리고 헌팅 호러가 라이카 씨를 유린하고 제압하는 것보다 빨랐다｡"
  },
  {
   "id": 30536,
   "key": "D1216le.txt:114",
   "file": "D1216le.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光。",
   "ko_candidate": "섬광｡"
  },
  {
   "id": 30537,
   "key": "D1216le.txt:115",
   "file": "D1216le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃。",
   "ko_candidate": "충격｡"
  },
  {
   "id": 30538,
   "key": "D1216le.txt:116",
   "file": "D1216le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、爆音。",
   "ko_candidate": "그리고 폭음｡"
  },
  {
   "id": 30539,
   "key": "D1216le.txt:120",
   "file": "D1216le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちの立つ交差点が爆発した。",
   "ko_candidate": "우리가 서 있던 교차로가 폭발했다｡"
  },
  {
   "id": 30540,
   "key": "D1216le.txt:121",
   "file": "D1216le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビルの瓦礫が、ショーウィンドウのガラスが、圧し折れた信号機が、吹き飛ぶ。爆発の中で砕けていく。",
   "ko_candidate": "빌딩의 잔해가､ 쇼윈도의 유리가､ 부러진 신호등이 날아간다｡ 폭발 속에서 부서져간다｡"
  },
  {
   "id": 30541,
   "key": "D1216le.txt:124",
   "file": "D1216le.txt",
   "line": 124,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐあああああっ!?」",
   "ko_candidate": "「으아아아아앗!?」"
  },
  {
   "id": 30542,
   "key": "D1216le.txt:129",
   "file": "D1216le.txt",
   "line": 129,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ッ……！　防禦結界！」",
   "ko_candidate": "「윽……! 방어결계!」"
  },
  {
   "id": 30543,
   "key": "D1216le.txt:132",
   "file": "D1216le.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疲労困憊、満身創痍の身体は、為す術もなく舞い上げられる。",
   "ko_candidate": "피로에 지친 만신창이의 몸은 어찌할 도리 없이 휘날린다｡"
  },
  {
   "id": 30544,
   "key": "D1216le.txt:133",
   "file": "D1216le.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "辛うじてアルの張った結界が、俺を熱波と衝撃から護る。",
   "ko_candidate": "가까스로 알이 친 결계가 나를 열파와 충격에서 지켜준다｡"
  },
  {
   "id": 30545,
   "key": "D1216le.txt:138",
   "file": "D1216le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんもまた、爆風に吹き飛ばされ、宙を舞う。",
   "ko_candidate": "라이카 씨 또한 폭풍에 날려 공중을 날아간다｡"
  },
  {
   "id": 30546,
   "key": "D1216le.txt:139",
   "file": "D1216le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティング・ホラーとバラバラに飛ばされたことは、あるいは幸運だったのだろうか。",
   "ko_candidate": "헌팅 호러와 따로따로 날아간 것은 어쩌면 다행이었을까｡"
  },
  {
   "id": 30547,
   "key": "D1216le.txt:144",
   "file": "D1216le.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎の向こうに見える。",
   "ko_candidate": "폭염 너머로 보인다｡"
  },
  {
   "id": 30548,
   "key": "D1216le.txt:145",
   "file": "D1216le.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "招喚の魔法陣と、実体を結びつつある巨体。",
   "ko_candidate": "소환의 마법진과 실체를 이루어가는 거체｡"
  },
  {
   "id": 30549,
   "key": "D1216le.txt:147",
   "file": "D1216le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の腕をこちらに向けていた。",
   "ko_candidate": "강철 팔을 이쪽으로 향하고 있었다｡"
  },
  {
   "id": 30550,
   "key": "D1216le.txt:148",
   "file": "D1216le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲には空飛ぶ星型の機体を引き連れている。",
   "ko_candidate": "주위에는 날아다니는 별 모양의 기체를 거느리고 있다｡"
  },
  {
   "id": 30551,
   "key": "D1216le.txt:151",
   "file": "D1216le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "星型の方は良く分からないが、巨体の方には見覚えがある。",
   "ko_candidate": "별 모양 쪽은 잘 모르겠지만 거체 쪽은 본 적이 있다｡"
  },
  {
   "id": 30552,
   "key": "D1216le.txt:152",
   "file": "D1216le.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鬼械神。",
   "ko_candidate": "귀계신｡"
  },
  {
   "id": 30553,
   "key": "D1216le.txt:154",
   "file": "D1216le.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ローブを纏った、鋼鉄の巨人。",
   "ko_candidate": "로브를 두른 강철의 거인｡"
  },
  {
   "id": 30554,
   "key": "D1216le.txt:155",
   "file": "D1216le.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒金の魔術師。",
   "ko_candidate": "흑금의 마술사｡"
  },
  {
   "id": 30555,
   "key": "D1216le.txt:160",
   "file": "D1216le.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスが操りし、『妖蛆の秘密』の分身。",
   "ko_candidate": "티베리우스가 조종하는 『벌레의 신비』의 분신｡"
  },
  {
   "id": 30556,
   "key": "D1216le.txt:161",
   "file": "D1216le.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ベルゼビュート！",
   "ko_candidate": "벨제뷰트!"
  },
  {
   "id": 30557,
   "key": "D1216le.txt:166",
   "file": "D1216le.txt",
   "line": 166,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お―――――ほほほほほほっ！」",
   "ko_candidate": "「오――――――호호호호호호!」"
  },
  {
   "id": 30558,
   "key": "D1216le.txt:169",
   "file": "D1216le.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い影が、ベルゼビュートから飛び出した。",
   "ko_candidate": "검은 그림자가 벨제뷰트에서 튀어나왔다｡"
  },
  {
   "id": 30559,
   "key": "D1216le.txt:170",
   "file": "D1216le.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い影は爆炎の中を巧みに踊りながら、駈ける。",
   "ko_candidate": "검은 그림자는 폭염 속을 능숙하게 춤추듯 달린다｡"
  },
  {
   "id": 30560,
   "key": "D1216le.txt:171",
   "file": "D1216le.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして地面に落ちる寸前のライカさんを、抱き止める。",
   "ko_candidate": "그리고 땅에 떨어지기 직전의 라이카 씨를 안아 멈춘다｡"
  },
  {
   "id": 30561,
   "key": "D1216le.txt:173",
   "file": "D1216le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……いつの間に着替えたのか、魔法使いのような、道化師のような、ふざけたローブ。嘲笑を浮かべる仮面。",
   "ko_candidate": "……언제 갈아입었는지 마법사 같기도 하고 광대 같기도 한 어이없는 로브｡ 조소를 띤 가면｡"
  },
  {
   "id": 30562,
   "key": "D1216le.txt:174",
   "file": "D1216le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "活ける屍が嗤う。",
   "ko_candidate": "살아있는 시체가 웃는다｡"
  },
  {
   "id": 30563,
   "key": "D1216le.txt:180",
   "file": "D1216le.txt",
   "line": 180,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だかんだで漁夫の利って奴かしらぁん！」",
   "ko_candidate": "「이래저래 어부지리라는 거겠죠!」"
  },
  {
   "id": 30564,
   "key": "D1216le.txt:185",
   "file": "D1216le.txt",
