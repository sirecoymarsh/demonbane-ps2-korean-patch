 },
 "items": [
  {
   "id": 46489,
   "key": "D1512le.txt:329",
   "file": "D1512le.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "脚部シールドの機関を再び、フル稼働させる。",
   "ko_candidate": "다리 부분 실드의 기관을 다시 풀가동시킨다｡"
  },
  {
   "id": 46490,
   "key": "D1512le.txt:330",
   "file": "D1512le.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインの足許で歪む空間。",
   "ko_candidate": "데몬베인의 발밑에서 공간이 일그러진다｡"
  },
  {
   "id": 46491,
   "key": "D1512le.txt:331",
   "file": "D1512le.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "余剰エネルギーが紫電となって迸る。",
   "ko_candidate": "여분의 에너지가 자색 번개가 되어 튀어 오른다｡"
  },
  {
   "id": 46492,
   "key": "D1512le.txt:335",
   "file": "D1512le.txt",
   "line": 335,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「殺ァァァァァァァ…………ッ」",
   "ko_candidate": "「죽여어어어어어어…………읏」"
  },
  {
   "id": 46493,
   "key": "D1512le.txt:339",
   "file": "D1512le.txt",
   "line": 339,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「はあああああああ…………ッ」",
   "ko_candidate": "「하아아아아아아아…………읏」"
  },
  {
   "id": 46494,
   "key": "D1512le.txt:345",
   "file": "D1512le.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "時空の歪みは徐々に大きく、世界を包み込んでいく。",
   "ko_candidate": "시공의 일그러짐은 점점 커져 세계를 감싸 안는다｡"
  },
  {
   "id": 46495,
   "key": "D1512le.txt:346",
   "file": "D1512le.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……これほどの反作用は初めてのことだ。",
   "ko_candidate": "……이렇게 큰 반작용은 처음이다｡"
  },
  {
   "id": 46496,
   "key": "D1512le.txt:347",
   "file": "D1512le.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが今は、リベル・レギスに集中する。",
   "ko_candidate": "하지만 지금은 리베르 레기스에 집중한다｡"
  },
  {
   "id": 46497,
   "key": "D1512le.txt:349",
   "file": "D1512le.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "両機の魔力が臨界まで昂まり――一触即発の闘気に引き裂かれるように、世界は確かな容を失っていく。",
   "ko_candidate": "양쪽 기체의 마력이 임계까지 고조되고―일촉즉발의 투기에 찢기듯이､ 세계는 확실한 모습을 잃어간다｡"
  },
  {
   "id": 46498,
   "key": "D1512le.txt:353",
   "file": "D1512le.txt",
   "line": 353,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「違う！　これは脚部シールドの反作用ではない！　また時空震が迫っているのだ！　ヨグ＝ソトースめ！」",
   "ko_candidate": "「아니야! 이건 각부 실드의 반작용이 아니야! 또 시공진이 다가오고 있는 거야! 요그 소토스 녀석!」"
  },
  {
   "id": 46499,
   "key": "D1512le.txt:357",
   "file": "D1512le.txt",
   "line": 357,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じゃあ……！　また何処か、とんでもないところに！」",
   "ko_candidate": "「그럼……! 또 어딘가 엄청난 곳으로!」"
  },
  {
   "id": 46500,
   "key": "D1512le.txt:361",
   "file": "D1512le.txt",
   "line": 361,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎！　衝撃に備えろ！　九郎！」",
   "ko_candidate": "「쿠로! 충격에 대비해! 쿠로!」"
  },
  {
   "id": 46501,
   "key": "D1512le.txt:366",
   "file": "D1512le.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……アルの叫びは遠い。",
   "ko_candidate": "……알의 외침이 멀게 들린다｡"
  },
  {
   "id": 46502,
   "key": "D1512le.txt:367",
   "file": "D1512le.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の認識は――２つの闘気が爆発する瞬間を、ちょうど捉えていた。",
   "ko_candidate": "내 인식은―두 개의 투기가 폭발하는 순간을 정확히 포착하고 있었다｡"
  },
  {
   "id": 46503,
   "key": "D1512le.txt:368",
   "file": "D1512le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今だ――！",
   "ko_candidate": "지금이다―!"
  },
  {
   "id": 46504,
   "key": "D1512le.txt:377",
   "file": "D1512le.txt",
   "line": 377,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「餓アアアアアアアアアアアアアァァァァァァァッッ！」",
   "ko_candidate": "「아아아아아아아아아아아아아아아아아아악!」 「아틀란티스 스트라이크!」"
  },
  {
   "id": 46505,
   "key": "D1512le.txt:383",
   "file": "D1512le.txt",
   "line": 383,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アトランティス・ストラァァァァイク！」 寸分違わず同時に地を蹴り、異界の空を飛翔する両機。",
   "ko_candidate": "한 치의 오차도 없이 동시에 땅을 박차고､ 이계의 하늘을 비행하는 양쪽 기체｡"
  },
  {
   "id": 46506,
   "key": "D1512le.txt:398",
   "file": "D1512le.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "激突は瞬時に訪れた。",
   "ko_candidate": "격돌은 순식간에 찾아왔다｡"
  },
  {
   "id": 46507,
   "key": "D1512le.txt:399",
   "file": "D1512le.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "眼下いっぱいに大図書館を見下ろし、異形の月を背景に、２つの蹴りが交差する。",
   "ko_candidate": "눈 아래 가득 대도서관을 내려다보며､ 기괴한 달을 배경으로 두 개의 발차기가 교차한다｡"
  },
  {
   "id": 46508,
   "key": "D1512le.txt:408",
   "file": "D1512le.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その衝撃と共に、俺たちは再び時空を超えた。",
   "ko_candidate": "그 충격과 함께 우리는 다시 시공을 넘었다｡"
  },
  {
   "id": 46509,
   "key": "D1512ru.txt:10",
   "file": "D1512ru.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "地球を背負い、蒼く輝くデモンベインは――美しかった。",
   "ko_candidate": "지구를 짊어지고､ 푸르게 빛나는 데몬베인은――아름다웠다｡"
  },
  {
   "id": 46510,
   "key": "D1512ru.txt:11",
   "file": "D1512ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "見惚れるほどに美しかった。",
   "ko_candidate": "넋을 잃을 만큼 아름다웠다｡"
  },
  {
   "id": 46511,
   "key": "D1512ru.txt:13",
   "file": "D1512ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう。余は識っている。",
   "ko_candidate": "그래｡ 나는 알고 있다｡"
  },
  {
   "id": 46512,
   "key": "D1512ru.txt:14",
   "file": "D1512ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あのデウス・マキナは、大十字九郎は、アル・アジフは、間違いなく美しい。",
   "ko_candidate": "저 데우스 마키나는､ 다이쥬지 쿠로는､ 알 아지프는､ 틀림없이 아름답다｡"
  },
  {
   "id": 46513,
   "key": "D1512ru.txt:16",
   "file": "D1512ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは、ひたむきに、明日を信じて戦うものの美しさ。",
   "ko_candidate": "그것은､ 한결같이､ 내일을 믿고 싸우는 자의 아름다움｡"
  },
  {
   "id": 46514,
   "key": "D1512ru.txt:17",
   "file": "D1512ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは――絶望を識らぬ美しさ。",
   "ko_candidate": "그것은――절망을 모르는 아름다움｡"
  },
  {
   "id": 46515,
   "key": "D1512ru.txt:22",
   "file": "D1512ru.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの地球は、そんな英雄を祝福して、照らす。",
   "ko_candidate": "저 지구는､ 그런 영웅을 축복하며､ 비춘다｡"
  },
  {
   "id": 46516,
   "key": "D1512ru.txt:26",
   "file": "D1512ru.txt",
   "line": 26,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははは……」",
   "ko_candidate": "「아하하하하……」"
  },
  {
   "id": 46517,
   "key": "D1512ru.txt:31",
   "file": "D1512ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、その総ては仕組まれたものだ。",
   "ko_candidate": "하지만､ 그 모든 것은 꾸며진 것이다｡"
  },
  {
   "id": 46518,
   "key": "D1512ru.txt:32",
   "file": "D1512ru.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "宇宙を窮極の境地へと導く、ただその為だけに我等は居るのだ。",
   "ko_candidate": "우주를 궁극의 경지로 이끌기 위해､ 오직 그것만을 위해 우리는 존재하는 것이다｡"
  },
  {
   "id": 46519,
   "key": "D1512ru.txt:33",
   "file": "D1512ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大十字九郎。",
   "ko_candidate": "다이쥬지 쿠로｡"
  },
  {
   "id": 46520,
   "key": "D1512ru.txt:35",
   "file": "D1512ru.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総ては運命の奴隷。",
   "ko_candidate": "모든 것은 운명의 노예｡"
  },
  {
   "id": 46521,
   "key": "D1512ru.txt:36",
   "file": "D1512ru.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総ては運命へと捧げられる生贄。",
   "ko_candidate": "모든 것은 운명에 바쳐지는 제물｡"
  },
  {
   "id": 46522,
   "key": "D1512ru.txt:38",
   "file": "D1512ru.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "貴様等のその気高さも。",
   "ko_candidate": "네놈들의 그 고귀함도｡"
  },
  {
   "id": 46523,
   "key": "D1512ru.txt:39",
   "file": "D1512ru.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "美しさも。",
   "ko_candidate": "아름다움도｡"
  },
  {
   "id": 46524,
   "key": "D1512ru.txt:40",
   "file": "D1512ru.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総て。総て。",
   "ko_candidate": "모두｡ 모두｡"
  },
  {
   "id": 46525,
   "key": "D1512ru.txt:44",
   "file": "D1512ru.txt",
   "line": 44,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははははははははは……」",
   "ko_candidate": "「아하하하하하하하하하……」"
  },
  {
   "id": 46526,
   "key": "D1512ru.txt:47",
   "file": "D1512ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "教えてやろう。",
   "ko_candidate": "알려주마｡"
  },
  {
   "id": 46527,
   "key": "D1512ru.txt:48",
   "file": "D1512ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今から貴公等に絶望を教えてやろう。",
   "ko_candidate": "지금부터 너희들에게 절망을 가르쳐주마｡"
  },
  {
   "id": 46528,
   "key": "D1512ru.txt:50",
   "file": "D1512ru.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どれだけの無限を重ねても、この悦びだけは薄れる事はない。",
   "ko_candidate": "얼마나 많은 무한을 거듭해도､ 이 기쁨만은 옅어지지 않는다｡"
  }
 ]
}