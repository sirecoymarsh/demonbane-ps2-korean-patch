 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ウィンフィールド": "윈필드",
  "魔術師": "마술사",
  "瑠璃": "루리",
  "ティトゥス": "티투스",
  "ソーニャ": "소냐",
  "マコト": "마코토",
  "クラウディウス": "클라우디우스"
 },
 "items": [
  {
   "id": 27581,
   "key": "D1205le.txt:384",
   "file": "D1205le.txt",
   "line": 384,
   "speaker": "ウィンフィールド",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その光景を見ていたウィンフィールドは、溜息をついて肩を竦めた。 「やれやれ……これだから、魔術師は非常識で困りますな」",
   "ko_candidate": "「이런이런……이래서 마술사는 비상식적이라 곤란하군요」"
  },
  {
   "id": 27582,
   "key": "D1205le.txt:393",
   "file": "D1205le.txt",
   "line": 393,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「貴方が言えた義理ですか。貴方が……」",
   "ko_candidate": "「당신이 할 말입니까｡ 당신이……」"
  },
  {
   "id": 27583,
   "key": "D1205le.txt:396",
   "file": "D1205le.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緊張の糸が途切れた瑠璃が眉間を揉みながら、呻いた。",
   "ko_candidate": "긴장의 끈이 끊어진 루리가 미간을 문지르며 루리는 신음했다｡"
  },
  {
   "id": 27584,
   "key": "D1205le.txt:405",
   "file": "D1205le.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人は睨み合ったまま、互いの挙動を探り続ける。",
   "ko_candidate": "두 사람은 노려보며 서로의 행동을 계속 탐색한다｡"
  },
  {
   "id": 27585,
   "key": "D1205le.txt:414",
   "file": "D1205le.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先の後か、後の先か、それとも先の先か――高まり、ぶつかり合う２つの闘気。",
   "ko_candidate": "선의 후인가､ 후의 선인가､ 아니면 선의 선인가――고조되고 부딪치는 두 개의 투기｡"
  },
  {
   "id": 27586,
   "key": "D1205le.txt:415",
   "file": "D1205le.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緊張は極限まで張り詰めていた。",
   "ko_candidate": "긴장은 극한까지 팽팽해졌다｡"
  },
  {
   "id": 27587,
   "key": "D1205le.txt:424",
   "file": "D1205le.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まさに一触即発。",
   "ko_candidate": "말 그대로 일촉즉발｡"
  },
  {
   "id": 27588,
   "key": "D1205le.txt:425",
   "file": "D1205le.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、その状況下で不意にウィンフィールドは――微笑んだ。",
   "ko_candidate": "하지만 그런 상황에서 불현듯 윈필드는――미소 지었다｡"
  },
  {
   "id": 27589,
   "key": "D1205le.txt:430",
   "file": "D1205le.txt",
   "line": 430,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………？」",
   "ko_candidate": "「…………?」"
  },
  {
   "id": 27590,
   "key": "D1205le.txt:437",
   "file": "D1205le.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身の力を抜き、構えを解く。",
   "ko_candidate": "온몸의 힘을 빼고 자세를 풀었다｡"
  },
  {
   "id": 27591,
   "key": "D1205le.txt:442",
   "file": "D1205le.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だらんと、両腕をぶら下げた様な格好。",
   "ko_candidate": "축 늘어진 채 양팔을 늘어뜨린 듯한 모습｡"
  },
  {
   "id": 27592,
   "key": "D1205le.txt:443",
   "file": "D1205le.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "叩き付けられる闘気も、総ていなしてしまう。",
   "ko_candidate": "내뿜던 투기도 모두 거두어들인다｡"
  },
  {
   "id": 27593,
   "key": "D1205le.txt:445",
   "file": "D1205le.txt",
   "line": 445,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの表情が一瞬、怒りに翳った。",
   "ko_candidate": "티투스의 표정이 순간 분노로 물들었다｡"
  },
  {
   "id": 27594,
   "key": "D1205le.txt:449",
   "file": "D1205le.txt",
   "line": 449,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「拙者を愚弄しているのか……否、これは無為の構え」",
   "ko_candidate": "「소인을 우롱하는 것인가……아니､ 이는 무위의 자세」"
  },
  {
   "id": 27595,
   "key": "D1205le.txt:453",
   "file": "D1205le.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが、すぐに思い当たったようだ。",
   "ko_candidate": "하지만 곧 깨달은 듯하다｡"
  },
  {
   "id": 27596,
   "key": "D1205le.txt:455",
   "file": "D1205le.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。これもまた、闘法の一つ。",
   "ko_candidate": "그래｡ 이것 또한 전법의 하나｡"
  },
  {
   "id": 27597,
   "key": "D1205le.txt:456",
   "file": "D1205le.txt",
   "line": 456,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "構えを解き、闘志を消すことで、相手に次の行動を予測させない。",
   "ko_candidate": "자세를 풀고 투지를 없앰으로써 상대방에게 다음 행동을 예측하지 못하게 한다｡"
  },
  {
   "id": 27598,
   "key": "D1205le.txt:458",
   "file": "D1205le.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "武術を突き詰めた者が辿り着く、究極の構えだ。",
   "ko_candidate": "무술을 극한까지 파고든 자가 도달하는 궁극의 자세다｡"
  },
  {
   "id": 27599,
   "key": "D1205le.txt:469",
   "file": "D1205le.txt",
   "line": 469,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「この国にもそのような戦法を執る者が居るとはな。面白い、誘いに乗ろう」",
   "ko_candidate": "「이 나라에도 그런 전법을 쓰는 자가 있다니｡ 재밌군､ 유혹에 넘어가 주지」"
  },
  {
   "id": 27600,
   "key": "D1205le.txt:475",
   "file": "D1205le.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの闘気が冷たく研ぎ澄まされる。",
   "ko_candidate": "티투스의 투기가 차갑게 연마된다｡"
  },
  {
   "id": 27601,
   "key": "D1205le.txt:476",
   "file": "D1205le.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "濃密になっていく闘気に中てられて、気絶寸前に追い込まれる者も出てきた。",
   "ko_candidate": "짙어지는 투기에 맞아 기절 직전으로 몰리는 자들도 나오기 시작했다｡"
  },
  {
   "id": 27602,
   "key": "D1205le.txt:478",
   "file": "D1205le.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "よろめくソーニャの躰を、マコトが支える。",
   "ko_candidate": "비틀거리는 소냐의 몸을 마코토가 받쳐준다｡ 「……괜찮으세요?」"
  },
  {
   "id": 27603,
   "key": "D1205le.txt:486",
   "file": "D1205le.txt",
   "line": 486,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大丈夫ですか？」",
   "ko_candidate": "「아아……정말 감사합니다~」"
  },
  {
   "id": 27604,
   "key": "D1205le.txt:490",
   "file": "D1205le.txt",
   "line": 490,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……どうもありがとうございます～」",
   "ko_candidate": "「하지만……이게 무슨 살기야……」"
  },
  {
   "id": 27605,
   "key": "D1205le.txt:497",
   "file": "D1205le.txt",
   "line": 497,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うっ……く……っっ！」",
   "ko_candidate": "「으윽……크……읏!」"
  },
  {
   "id": 27606,
   "key": "D1205le.txt:506",
   "file": "D1205le.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は負けじと気を強く持って、二人の闘いを見守っていた。",
   "ko_candidate": "루리는 지지 않으려 마음을 굳게 먹고 두 사람의 싸움을 지켜보고 있었다｡"
  },
  {
   "id": 27607,
   "key": "D1205le.txt:507",
   "file": "D1205le.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闘気が今、凶器へと凝縮された。",
   "ko_candidate": "투기가 지금､ 흉기로 응축되었다｡"
  },
  {
   "id": 27608,
   "key": "D1205le.txt:508",
   "file": "D1205le.txt",
   "line": 508,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "解き放たれる。",
   "ko_candidate": "해방된다｡"
  },
  {
   "id": 27609,
   "key": "D1205le.txt:514",
   "file": "D1205le.txt",
   "line": 514,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「御首級！　頂戴！」",
   "ko_candidate": "「목! 받아라!」"
  },
  {
   "id": 27610,
   "key": "D1205le.txt:518",
   "file": "D1205le.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神速の走法と神速の斬撃！",
   "ko_candidate": "신속한 질주와 신속한 참격!"
  },
  {
   "id": 27611,
   "key": "D1205le.txt:520",
   "file": "D1205le.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかしウィンフィールドは微動だにせず――",
   "ko_candidate": "하지만 윈필드는 미동도 하지 않고―― 「오의――전휴부?무음」"
  },
  {
   "id": 27612,
   "key": "D1205le.txt:528",
   "file": "D1205le.txt",
   "line": 528,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「奥義――全休符・無音」",
   "ko_candidate": "쾅……! 「꺄아아아아악!」"
  },
  {
   "id": 27613,
   "key": "D1205ru.txt:10",
   "file": "D1205ru.txt",
   "line": 10,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "轟……ッ！ 「きゃあああああっ！」",
   "ko_candidate": "클라우디우스로부터 검은 바람이 불어 나왔다｡"
  },
  {
   "id": 27614,
   "key": "D1205ru.txt:25",
   "file": "D1205ru.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラウディウスから黒い風が吹き出した。",
   "ko_candidate": "독기를 품은 바람에 노출되어､ 루리는 몸의 중심부터 얼어붙는 듯한 감각에 유린당했다｡"
  },
  {
   "id": 27615,
   "key": "D1205ru.txt:27",
   "file": "D1205ru.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瘴気を孕んだ風に曝され、瑠璃は躰の芯から凍えるような感覚に蹂躙された。全身がどうしようもなく震え出し、膝が笑って動けない。",
   "ko_candidate": "온몸이 어쩔 수 없이 떨리기 시작하고､ 무릎이 풀려 움직일 수 없다｡ 겁에 질린 루리를､ 소년은 어린 나이의 앳된 얼굴에 광기 어린 표정을 지으며 조소했다｡"
  },
  {
   "id": 27616,
   "key": "D1205ru.txt:35",
   "file": "D1205ru.txt",
   "line": 35,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「よう……ブッ殺しに来たぜ？ どうされたい？ 微塵切りにしてやろうか？ 綺麗にスライスしてやるか？」 「オラ…… 肉屋に並べてやらァァァァァ！」",
   "ko_candidate": "「야… 죽이러 왔냐? 어떻게 해줄까? 가루로 만들어줄까? 깔끔하게 슬라이스해줄까? 팔다리 잘라내고 개처럼 기게 할까､ 아아――!?」"
  },
  {
   "id": 27617,
   "key": "D1205ru.txt:61",
   "file": "D1205ru.txt",
   "line": 61,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ッッ……ああッ！」",
   "ko_candidate": "「윽……아악!」"
  },
  {
   "id": 27618,
   "key": "D1205ru.txt:70",
   "file": "D1205ru.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い風が爆裂し、瑠璃の頬を浅く引き裂いた。",
   "ko_candidate": "검은 바람이 폭발하며､ 루리의 뺨을 얕게 찢었다｡"
  },
  {
   "id": 27619,
   "key": "D1205ru.txt:72",
   "file": "D1205ru.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "頬を血が伝う。",
   "ko_candidate": "뺨을 따라 피가 흐른다｡"
  },
  {
   "id": 27620,
   "key": "D1205ru.txt:73",
   "file": "D1205ru.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "下卑た視線が瑠璃を睨め回し……ふとその背後、窓ガラスの向こう側へと止まった。",
   "ko_candidate": "천박한 시선이 루리를 노려보다가… 문득 그 뒤편､ 창문 너머로 멈췄다｡"
  }
 ]
}