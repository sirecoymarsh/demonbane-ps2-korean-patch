 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "旧き印": "옛 인장",
  "魔力": "마력",
  "アル": "알",
  "デモンベイン": "데몬베인",
  "九郎": "쿠로",
  "ナイア": "나이아",
  "クトゥグア": "크투가"
 },
 "items": [
  {
   "id": 48815,
   "key": "D1519le.txt:313",
   "file": "D1519le.txt",
   "line": 313,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんと同時に俺も気づいた。",
   "ko_candidate": "라이카 씨와 동시에 나도 깨달았다｡"
  },
  {
   "id": 48816,
   "key": "D1519le.txt:314",
   "file": "D1519le.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天に刻まれた、燦々と輝く光の刻印。",
   "ko_candidate": "하늘에 새겨진 찬란히 빛나는 빛의 각인｡"
  },
  {
   "id": 48817,
   "key": "D1519le.txt:316",
   "file": "D1519le.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "五芒星形の印。",
   "ko_candidate": "오망성 모양의 문양｡"
  },
  {
   "id": 48818,
   "key": "D1519le.txt:317",
   "file": "D1519le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇はその輝きを避けて、のたうっている――！",
   "ko_candidate": "어둠은 그 빛을 피해 몸부림치고 있다――!"
  },
  {
   "id": 48819,
   "key": "D1519le.txt:320",
   "file": "D1519le.txt",
   "line": 320,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『旧き印』!?　まさか……！」",
   "ko_candidate": "「『엘더 사인』!? 설마……!」"
  },
  {
   "id": 48820,
   "key": "D1519le.txt:326",
   "file": "D1519le.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は下方へと視線を向けた。",
   "ko_candidate": "나는 아래쪽으로 시선을 돌렸다｡"
  },
  {
   "id": 48821,
   "key": "D1519le.txt:327",
   "file": "D1519le.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒れ狂う闇黒の海を割って、巨大な鋼鉄の腕が伸ばされている。",
   "ko_candidate": "거칠게 날뛰는 암흑의 바다를 가르며､ 거대한 강철 팔이 뻗어 있다｡"
  },
  {
   "id": 48822,
   "key": "D1519le.txt:328",
   "file": "D1519le.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "広げた掌に集まる魔力の輝き。",
   "ko_candidate": "펼친 손바닥에 모이는 마력의 빛｡"
  },
  {
   "id": 48823,
   "key": "D1519le.txt:329",
   "file": "D1519le.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の海の奥で、破邪の意志を湛える眸が輝いた。",
   "ko_candidate": "어둠의 바다 깊숙이､ 파사의 의지를 담은 눈동자가 빛났다｡"
  },
  {
   "id": 48824,
   "key": "D1519le.txt:333",
   "file": "D1519le.txt",
   "line": 333,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベイン！　アルか!?」",
   "ko_candidate": "「데몬베인! 알인가!?」"
  },
  {
   "id": 48825,
   "key": "D1519le.txt:337",
   "file": "D1519le.txt",
   "line": 337,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「応よ！　さあ、来い！　九郎！ ライカ！」",
   "ko_candidate": "「그렇다! 자､ 오너라! 쿠로! 라이카!」"
  },
  {
   "id": 48826,
   "key": "D1519le.txt:342",
   "file": "D1519le.txt",
   "line": 342,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はいっ！」",
   "ko_candidate": "「네!」"
  },
  {
   "id": 48827,
   "key": "D1519le.txt:350",
   "file": "D1519le.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "伸ばされた掌が、墜ちる俺たちを優しく包み込んだ。",
   "ko_candidate": "뻗은 손바닥이 떨어지는 우리를 부드럽게 감싸 안았다｡"
  },
  {
   "id": 48828,
   "key": "D1519le.txt:351",
   "file": "D1519le.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掌の上でライカさんは迫り来る闇を、ビーム砲で撃ち落とす。",
   "ko_candidate": "손바닥 위에서 라이카 씨는 다가오는 어둠을 빔포로 쏘아 떨어뜨린다｡"
  },
  {
   "id": 48829,
   "key": "D1519le.txt:352",
   "file": "D1519le.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの躰が浮上する。コクピットのハッチが開いた。",
   "ko_candidate": "데몬베인의 몸체가 떠오른다｡ 콕핏의 해치가 열렸다｡"
  },
  {
   "id": 48830,
   "key": "D1519le.txt:363",
   "file": "D1519le.txt",
   "line": 363,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良し！」",
   "ko_candidate": "「좋아!」"
  },
  {
   "id": 48831,
   "key": "D1519le.txt:366",
   "file": "D1519le.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんと一緒に、コクピットの中へと飛び降りる。",
   "ko_candidate": "라이카 씨와 함께 콕핏 안으로 뛰어내린다｡"
  },
  {
   "id": 48832,
   "key": "D1519le.txt:367",
   "file": "D1519le.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 48833,
   "key": "D1519le.txt:375",
   "file": "D1519le.txt",
   "line": 375,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「此処まで来て足掻くか！ デモンベイン！」",
   "ko_candidate": "「여기까지 와서 발버둥치는가! 데몬베인!」"
  },
  {
   "id": 48834,
   "key": "D1519le.txt:380",
   "file": "D1519le.txt",
   "line": 380,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「足掻くのが人間の性だ！ 無貌の神！」",
   "ko_candidate": "「발버둥치는 게 인간의 본성이다! 무모의 신!」"
  },
  {
   "id": 48835,
   "key": "D1519le.txt:384",
   "file": "D1519le.txt",
   "line": 384,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『無貌の神』。ナイアのことか。",
   "ko_candidate": "『무모의 신』｡ 나이아 말인가｡"
  },
  {
   "id": 48836,
   "key": "D1519le.txt:385",
   "file": "D1519le.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは奴の正体を識っているのか。",
   "ko_candidate": "알은 그자의 정체를 알고 있는 건가｡"
  },
  {
   "id": 48837,
   "key": "D1519le.txt:387",
   "file": "D1519le.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、そんなことはどうでも良い。",
   "ko_candidate": "하지만､ 그런 건 어찌 됐든 상관없다｡"
  },
  {
   "id": 48838,
   "key": "D1519le.txt:388",
   "file": "D1519le.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "肝心なのは……ナイアを斃し、この混沌と渦巻く闇から、クソッタレな時空の環から脱け出すことだけだ！",
   "ko_candidate": "중요한 건…… 나이아를 쓰러뜨리고､ 이 혼돈과 소용돌이치는 어둠에서､ 개자식 같은 시공의 고리에서 빠져나가는 것뿐이다!"
  },
  {
   "id": 48839,
   "key": "D1519le.txt:390",
   "file": "D1519le.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の意識と、デモンベインの回路とがリンクする。",
   "ko_candidate": "내 의식과 데몬베인의 회로가 연결된다｡"
  },
  {
   "id": 48840,
   "key": "D1519le.txt:391",
   "file": "D1519le.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔を断つ剣の、最後の雄叫びが、闇を震わせた。",
   "ko_candidate": "마를 베는 검의 마지막 포효가 어둠을 흔들었다｡"
  },
  {
   "id": 48841,
   "key": "D1519le.txt:395",
   "file": "D1519le.txt",
   "line": 395,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クトゥグアァァァァ！」",
   "ko_candidate": "「크투가아아아아!」"
  },
  {
   "id": 48842,
   "key": "D1519le.txt:401",
   "file": "D1519le.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "半壊しているデモンベインの動きは鈍い。",
   "ko_candidate": "반파된 데몬베인의 움직임은 둔하다｡"
  },
  {
   "id": 48843,
   "key": "D1519le.txt:402",
   "file": "D1519le.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが掲げた右掌にはしっかりと、黒い兇暴な魔銃が握られた。",
   "ko_candidate": "하지만 들어 올린 오른손에는 확실히 검은 흉폭한 마총이 쥐어졌다｡"
  },
  {
   "id": 48844,
   "key": "D1519le.txt:404",
   "file": "D1519le.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "立て続けに一発の弾丸を招喚する。",
   "ko_candidate": "연이어 한 발의 탄환을 소환한다｡"
  },
  {
   "id": 48845,
   "key": "D1519le.txt:405",
   "file": "D1519le.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "レバーを引き、空の薬室にただ一発、その弾丸だけを詰め込んだ。",
   "ko_candidate": "레버를 당겨 빈 약실에 단 한 발､ 그 탄환만을 채워 넣었다｡"
  },
  {
   "id": 48846,
   "key": "D1519le.txt:407",
   "file": "D1519le.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃身の表面に刻まれた紋様が炎えるように、紅く輝く。",
   "ko_candidate": "총신 표면에 새겨진 문양이 불타오르듯 붉게 빛난다｡"
  },
  {
   "id": 48847,
   "key": "D1519le.txt:408",
   "file": "D1519le.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃口の周囲を、幾重にも円形に囲む、魔術文字の列。",
   "ko_candidate": "총구 주위를 여러 겹으로 원형으로 둘러싼 마술 문자의 열｡"
  },
  {
   "id": 48848,
   "key": "D1519le.txt:412",
   "file": "D1519le.txt",
   "line": 412,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「よりにもよって、 クトゥグアだと……！」",
   "ko_candidate": "「하필이면､ 크투가라니……!」"
  },
  {
   "id": 48849,
   "key": "D1519le.txt:417",
   "file": "D1519le.txt",
   "line": 417,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「最後の神獣弾だ……貴様にくれてやる！」",
   "ko_candidate": "「마지막 신수탄이다…… 네놈에게 주겠다!」"
  },
  {
   "id": 48850,
   "key": "D1519le.txt:420",
   "file": "D1519le.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "撃鉄が下ろされる。",
   "ko_candidate": "방아쇠가 당겨진다｡"
  },
  {
   "id": 48851,
   "key": "D1519le.txt:430",
   "file": "D1519le.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マズル・フラッシュ――いや違う、プラズマの閃光が闇に呑まれる世界を灼き、銃声ではなく異形の神の咆吼が、比喩ではなく、闇を引き裂き木霊する。",
   "ko_candidate": "머즐 플래시――아니 다르다､ 플라즈마의 섬광이 어둠에 삼켜진다 세계를 태우고､ 총성이 아닌 기괴한 신의 포효가､ 비유가 아닌､"
  },
  {
   "id": 48852,
   "key": "D1519le.txt:435",
   "file": "D1519le.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "銃口より招喚された神獣は、太陽よりも烈しく焔え輝き、闇の中枢に向かって駈ける。",
   "ko_candidate": "어둠을 찢어발기며 메아리친다｡ 총구에서 소환된 신수는 태양보다도 격렬하게 불타오르며､"
  },
  {
   "id": 48853,
   "key": "D1519le.txt:441",
   "file": "D1519le.txt",
   "line": 441,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……ああああああ！」",
   "ko_candidate": "어둠의 중추를 향해 달려간다｡ 「크윽…… 아아아아아아!」"
  },
  {
   "id": 48854,
   "key": "D1519le.txt:446",
   "file": "D1519le.txt",
   "line": 446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光は触れる闇を悉く揮発させ、ナイアに牙を立てて襲いかかる。",
   "ko_candidate": "빛은 닿는 어둠을 모조리 증발시키고､ 나이아에게 이빨을 세우고 덮친다｡"
  }
 ]
}