{
 "packet": "0406_01",
 "scene": "0406",
 "anchor": {
  "hit": 4,
  "total": 7,
  "rate": 0.571
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アリスン": "앨리슨",
  "九郎": "쿠로",
  "ライカ": "라이카",
  "ジョージ": "조지"
 },
 "items": [
  {
   "id": 4846,
   "key": "D0406.txt:268",
   "file": "D0406.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "右往左往するアリスンの姿を、せせら笑う。",
   "ko_candidate": "그래서 조금은 혼내줘야 해｡ 자기들은 잘못이 없어｡"
  },
  {
   "id": 4847,
   "key": "D0406.txt:276",
   "file": "D0406.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――いい気味だ。",
   "ko_candidate": "잘못된 건―― 앨리슨 쪽이야｡"
  },
  {
   "id": 4848,
   "key": "D0406.txt:279",
   "file": "D0406.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎もライカも、アリスンばかり気にかける。無視するのはアリスンの方なのに、２人とも自分たちばかり叱るんだ。",
   "ko_candidate": "아이들 특유의 무지한 잔인함은 앨리슨의 약함을 눈앞에 두고 더욱 가속화되어 폭주한다｡ 죠지가 콤팩트를 받았다｡"
  },
  {
   "id": 4849,
   "key": "D0406.txt:282",
   "file": "D0406.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アリスンはずるい。女だからって特別に可愛がられているんだ。だから少しくらい、おしおきしてやらなくちゃいけない。",
   "ko_candidate": "뚜껑을 열고 있는 힘껏 들어올린다｡ 「에잇､ 이런 거울 깨버려!」"
  },
  {
   "id": 4850,
   "key": "D0406.txt:285",
   "file": "D0406.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自分たちは悪くない。",
   "ko_candidate": "바닥에 내리치려고 했다｡"
  },
  {
   "id": 4851,
   "key": "D0406.txt:286",
   "file": "D0406.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悪いのは――アリスンの方だ。",
   "ko_candidate": "경솔한 행동이었다｡"
  },
  {
   "id": 4852,
   "key": "D0406.txt:289",
   "file": "D0406.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "子どもゆえの無知な残酷さは、アリスンの弱さを目の前にして、さら加速し、暴走する。",
   "ko_candidate": "그들이 앨리슨에게서 느꼈던 섬뜩함――그것을 가볍게 여겨서는 안 되었던 것이다｡ 「――――――!」"
  },
  {
   "id": 4853,
   "key": "D0406.txt:292",
   "file": "D0406.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ジョージがコンパクトを受け取った。",
   "ko_candidate": "앨리슨의 내면에서 무언가가 터졌다｡"
  },
  {
   "id": 4854,
   "key": "D0406.txt:293",
   "file": "D0406.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ふたを開き、思いっきり振り上げる。",
   "ko_candidate": "아…똑같아｡ 항상 똑같아｡"
  },
  {
   "id": 4855,
   "key": "D0406.txt:307",
   "file": "D0406.txt",
   "line": 307,
   "speaker": "ジョージ / アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えーい、こんな鏡割っちゃえ！」 「――――――！」",
   "ko_candidate": "맞거나 괴롭힘 당할 때마다 어김없이 같은 감각이 그녀의 내면에서 솟아오른다｡"
  },
  {
   "id": 4856,
   "key": "D0406.txt:328",
   "file": "D0406.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アリスンの中で、何かが弾けた。 あっ……同じだ。",
   "ko_candidate": "스스로도 억누를 수 없을 정도로 부풀어 오르고 넘쳐흐른다｡"
  },
  {
   "id": 4857,
   "key": "D0406.txt:332",
   "file": "D0406.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつもと同じだ。 殴られたり、いじめられたときは決まって同じ感覚が湧いてくる。抑え切れないほどに膨れ上がり、溢れ出す。現実を侵し、猛威を振るうのだ。",
   "ko_candidate": "그리고 현실을 침식하고 맹위를 떨치는 것이다｡"
  },
  {
   "id": 4858,
   "key": "D0406.txt:340",
   "file": "D0406.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "でも、仕方ない。",
   "ko_candidate": "하지만 어쩔 수 없어｡"
  },
  {
   "id": 4859,
   "key": "D0406.txt:341",
   "file": "D0406.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "人間は、怖い。",
   "ko_candidate": "사람은 무서워｡"
  },
  {
   "id": 4860,
   "key": "D0406.txt:342",
   "file": "D0406.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "他人は、怖い。",
   "ko_candidate": "타인은 무서워｡"
  },
  {
   "id": 4861,
   "key": "D0406.txt:345",
   "file": "D0406.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "実際こうして、みんな私をいじめるから。",
   "ko_candidate": "실제로 이렇게 모두가 나를 괴롭히니까｡"
  },
  {
   "id": 4862,
   "key": "D0406.txt:346",
   "file": "D0406.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私だって痛いのは、辛いのは嫌なのに。",
   "ko_candidate": "나도 아프고 괴로운 건 싫은데｡"
  },
  {
   "id": 4863,
   "key": "D0406.txt:347",
   "file": "D0406.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何もされなければ、私だって何もしないのに。",
   "ko_candidate": "아무것도 당하지 않으면 나도 아무것도 하지 않을 텐데｡"
  },
  {
   "id": 4864,
   "key": "D0406.txt:350",
   "file": "D0406.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だから、私は悪くない。何も悪くない。",
   "ko_candidate": "그러니까 나는 잘못이 없어｡ 아무런 잘못도 없어｡"
  },
  {
   "id": 4865,
   "key": "D0406.txt:351",
   "file": "D0406.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "知らない。もうどうなったって知るもんか。",
   "ko_candidate": "모르겠어｡ 이제 어떻게 되든 알 게 뭐야｡"
  },
  {
   "id": 4866,
   "key": "D0406.txt:354",
   "file": "D0406.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――怖いのなんか、ぜんぶ、なくなっちゃえば良い。",
   "ko_candidate": "――무서운 것들은 전부 사라져버리면 좋아｡"
  },
  {
   "id": 4867,
   "key": "D0406.txt:357",
   "file": "D0406.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アリスンは、ついに自分の中で暴走するそれの手綱を離した。",
   "ko_candidate": "앨리슨은 마침내 자신의 내면에서 폭주하는 그것의 고삐를 놓아버렸다｡"
  },
  {
   "id": 4868,
   "key": "D0406.txt:378",
   "file": "D0406.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "床に叩きつけられるその瞬間、鏡が輝いた。",
   "ko_candidate": "그리고 이번에는 불행하게도 그것이 최대의 참사를 일으키는 방아쇠가 되었다｡"
  },
  {
   "id": 4869,
   "key": "D0406.txt:381",
   "file": "D0406.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何かの光を反射させたのではない。",
   "ko_candidate": "죠지가 내리친 콤팩트가 바닥에 닿는다｡"
  },
  {
   "id": 4870,
   "key": "D0406.txt:382",
   "file": "D0406.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自ら閃光を放ったのだ。",
   "ko_candidate": "그 순간｡ 거울이 빛났다｡"
  },
  {
   "id": 4871,
   "key": "D0406.txt:383",
   "file": "D0406.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あたかもアリスンの心と共鳴するかの如く。",
   "ko_candidate": "다른 빛을 반사하는 것이 아니라 스스로 섬광을 발했다｡"
  },
  {
   "id": 4872,
   "key": "D0406.txt:390",
   "file": "D0406.txt",
   "line": 390,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわああああっ！」",
   "ko_candidate": "마치 앨리슨의 마음과 공명하듯이｡ 「우와아아아앗!」"
  },
  {
   "id": 4873,
   "key": "D0406.txt:395",
   "file": "D0406.txt",
   "line": 395,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「え、え？　なに？　なにが…… きゃああああああああっ!?」",
   "ko_candidate": "「어､ 어? 뭐야? 뭐가… 꺄아아아아아아아앗!?」"
  },
  {
   "id": 4874,
   "key": "D0406.txt:427",
   "file": "D0406.txt",
   "line": 427,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「みんな！　どうしたの!? ――これは!?」",
   "ko_candidate": "「모두들! 무슨 일이야!? ――이건!?」"
  },
  {
   "id": 4875,
   "key": "D0406.txt:439",
   "file": "D0406.txt",
   "line": 439,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――ついに御伽の国は、解き放たれたのだ。",
   "ko_candidate": "――마침내 동화의 나라가 해방된 것이다｡"
  }
 ]
}