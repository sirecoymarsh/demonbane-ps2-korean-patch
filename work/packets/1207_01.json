 },
 "items": [
  {
   "id": 28027,
   "key": "D1207al.txt:140",
   "file": "D1207al.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闘いの歓喜に歪んでいた。",
   "ko_candidate": "싸움의 환희에 일그러져 있었다｡"
  },
  {
   "id": 28028,
   "key": "D1207al.txt:141",
   "file": "D1207al.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死合いの愉悦に溺れていた。",
   "ko_candidate": "사투의 열락에 빠져 있었다｡"
  },
  {
   "id": 28029,
   "key": "D1207al.txt:142",
   "file": "D1207al.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飢えた修羅が、此処に居る。",
   "ko_candidate": "굶주린 수라가 여기에 있다｡"
  },
  {
   "id": 28030,
   "key": "D1207al.txt:148",
   "file": "D1207al.txt",
   "line": 148,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……申し訳ございません。もう少しだけ掛かりそうです」 再び、ウィンフィールドは",
   "ko_candidate": "「……죄송합니다｡ 조금 더 시간이 걸릴 것 같습니다」"
  },
  {
   "id": 28031,
   "key": "D1207al.txt:152",
   "file": "D1207al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ファイティングポーズを取った。",
   "ko_candidate": "다시､ 윈필드는 파이팅 포즈를 취했다｡"
  },
  {
   "id": 28032,
   "key": "D1207al.txt:158",
   "file": "D1207al.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスも、二刀を十字に重ねて、構える。",
   "ko_candidate": "티투스도 두 자루의 칼을 십자로 교차시킨다｡"
  },
  {
   "id": 28033,
   "key": "D1207al.txt:160",
   "file": "D1207al.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぶつかり合い、弾け合い、混ざり合う２つの闘気が、司令室を震わせた。",
   "ko_candidate": "부딪치고､ 튕기고､ 뒤섞이는 두 개의 투기가 사령실을 흔들었다｡"
  },
  {
   "id": 28034,
   "key": "D1207al.txt:166",
   "file": "D1207al.txt",
   "line": 166,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  },
  {
   "id": 28035,
   "key": "D1207al.txt:170",
   "file": "D1207al.txt",
   "line": 170,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  },
  {
   "id": 28036,
   "key": "D1207al.txt:173",
   "file": "D1207al.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "互いに動かない。",
   "ko_candidate": "서로 움직이지 않는다｡"
  },
  {
   "id": 28037,
   "key": "D1207al.txt:175",
   "file": "D1207al.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重く静止した時間の中、闘争を決する総ての要因に神経を巡らせる。",
   "ko_candidate": "무겁게 정지한 시간 속에서､ 싸움을 결정짓는 모든 요인에 신경을 곤두세운다｡"
  },
  {
   "id": 28038,
   "key": "D1207al.txt:177",
   "file": "D1207al.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "筋肉の動き、",
   "ko_candidate": "근육의 움직임､"
  },
  {
   "id": 28039,
   "key": "D1207al.txt:177",
   "file": "D1207al.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心臓の鼓動、",
   "ko_candidate": "심장의 고동､"
  },
  {
   "id": 28040,
   "key": "D1207al.txt:177",
   "file": "D1207al.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の流れ、",
   "ko_candidate": "피의 흐름､"
  },
  {
   "id": 28041,
   "key": "D1207al.txt:178",
   "file": "D1207al.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼吸、",
   "ko_candidate": "호흡､"
  },
  {
   "id": 28042,
   "key": "D1207al.txt:178",
   "file": "D1207al.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気の流れ、",
   "ko_candidate": "대기의 흐름､"
  },
  {
   "id": 28043,
   "key": "D1207al.txt:178",
   "file": "D1207al.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力の流れ――",
   "ko_candidate": "힘의 흐름――"
  },
  {
   "id": 28044,
   "key": "D1207al.txt:180",
   "file": "D1207al.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティトゥスが、笑った。",
   "ko_candidate": "티투스가 웃었다｡"
  },
  {
   "id": 28045,
   "key": "D1207al.txt:183",
   "file": "D1207al.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血の雫を撒き散らしながら、疾走る。",
   "ko_candidate": "피방울을 흩뿌리며 질주한다｡"
  },
  {
   "id": 28046,
   "key": "D1207al.txt:187",
   "file": "D1207al.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "走るどころか、まともに動く事すらも怪しい躰が、疾風の如く。",
   "ko_candidate": "달리는 것은커녕､ 제대로 움직이는 것조차 의심스러운 몸이 질풍처럼｡"
  },
  {
   "id": 28047,
   "key": "D1207al.txt:187",
   "file": "D1207al.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一気に間合いを詰める。",
   "ko_candidate": "단숨에 간격을 좁힌다｡"
  },
  {
   "id": 28048,
   "key": "D1207al.txt:191",
   "file": "D1207al.txt",
   "line": 191,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（先程よりも速い！）",
   "ko_candidate": "（아까보다 더 빠르다!）"
  },
  {
   "id": 28049,
   "key": "D1207al.txt:203",
   "file": "D1207al.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人だけの時間が始まった。",
   "ko_candidate": "둘만의 시간이 시작되었다｡"
  },
  {
   "id": 28050,
   "key": "D1207al.txt:204",
   "file": "D1207al.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは刹那、人の目に留まらぬ刹那に閉ざされた世界。",
   "ko_candidate": "그것은 찰나､ 사람의 눈에 머물지 않는 찰나에 닫힌 세계｡"
  },
  {
   "id": 28051,
   "key": "D1207al.txt:205",
   "file": "D1207al.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那の中、２人の思考もまた同じ速度で疾走する。",
   "ko_candidate": "찰나 속에서 두 사람의 사고 또한 같은 속도로 질주한다｡"
  },
  {
   "id": 28052,
   "key": "D1207al.txt:209",
   "file": "D1207al.txt",
   "line": 209,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（２撃かわせば私の勝ちです！）",
   "ko_candidate": "（2타를 피하면 제가 이깁니다!）"
  },
  {
   "id": 28053,
   "key": "D1207al.txt:213",
   "file": "D1207al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超神速で迫る右の刀。袈裟斬り。",
   "ko_candidate": "초신속으로 다가오는 오른쪽 칼｡ 게사베기｡"
  },
  {
   "id": 28054,
   "key": "D1207al.txt:215",
   "file": "D1207al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "速い。",
   "ko_candidate": "빠르다｡"
  },
  {
   "id": 28055,
   "key": "D1207al.txt:216",
   "file": "D1207al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迅い。",
   "ko_candidate": "신속하다｡"
  },
  {
   "id": 28056,
   "key": "D1207al.txt:217",
   "file": "D1207al.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今までで一番。",
   "ko_candidate": "지금까지 중 가장｡"
  },
  {
   "id": 28057,
   "key": "D1207al.txt:219",
   "file": "D1207al.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思考の速度に躰が付いて来てくれるだろうか。",
   "ko_candidate": "사고의 속도를 몸이 따라올 수 있을까｡"
  },
  {
   "id": 28058,
   "key": "D1207al.txt:222",
   "file": "D1207al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上半身を逸らす。",
   "ko_candidate": "상체를 비틀어 피한다｡"
  },
  {
   "id": 28059,
   "key": "D1207al.txt:223",
   "file": "D1207al.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背広が斬られた。",
   "ko_candidate": "양복이 베어졌다｡"
  },
  {
   "id": 28060,
   "key": "D1207al.txt:224",
   "file": "D1207al.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけだ。かわした。",
   "ko_candidate": "그뿐이다｡ 피했다｡"
  },
  {
   "id": 28061,
   "key": "D1207al.txt:226",
   "file": "D1207al.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "斬られたネクタイが、ゆっくりと、落ちる。 ゆっくりと、",
   "ko_candidate": "베어진 넥타이가 천천히 떨어진다｡"
  },
  {
   "id": 28062,
   "key": "D1207al.txt:228",
   "file": "D1207al.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ゆっくりと、",
   "ko_candidate": "천천히､ 천천히､"
  },
  {
   "id": 28063,
   "key": "D1207al.txt:230",
   "file": "D1207al.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸の位置にあったそれは、",
   "ko_candidate": "가슴 위치에 있던 그것이､"
  },
  {
   "id": 28064,
   "key": "D1207al.txt:231",
   "file": "D1207al.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ゆっくりと、",
   "ko_candidate": "천천히､ 천천히､"
  },
  {
   "id": 28065,
   "key": "D1207al.txt:232",
   "file": "D1207al.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆっくりと、",
   "ko_candidate": "복근 위치로､"
  },
  {
   "id": 28066,
   "key": "D1207al.txt:233",
   "file": "D1207al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腹筋の位置へ、 其処で２撃目が来た。",
   "ko_candidate": "거기서 2타째가 왔다｡"
  }
