 },
 "items": [
  {
   "id": 36858,
   "key": "D1403le.txt:57",
   "file": "D1403le.txt",
   "line": 57,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……サンダルフォン！」",
   "ko_candidate": "「…산달폰!」"
  },
  {
   "id": 36859,
   "key": "D1403le.txt:62",
   "file": "D1403le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーから降りて、ティベリウスの首の間近に立つ。",
   "ko_candidate": "헌팅 호러에서 내려와 티베리우스의 목 가까이에 선다｡"
  },
  {
   "id": 36860,
   "key": "D1403le.txt:63",
   "file": "D1403le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "表情の無い天使の仮面は、何故か嗤っているように、ティベリウスには思えた。",
   "ko_candidate": "표정 없는 천사의 가면이 왠지 비웃고 있는 것처럼 티베리우스에게는 보였다｡"
  },
  {
   "id": 36861,
   "key": "D1403le.txt:67",
   "file": "D1403le.txt",
   "line": 67,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こ、この裏切り者！　アンタさえ邪魔しなければアタシは大十字九郎を……うぐぶぅ！」",
   "ko_candidate": "「이､ 이 배신자! 네가 방해만 하지 않았다면 내가 다이쥬지 쿠로를… 우그븝!」"
  },
  {
   "id": 36862,
   "key": "D1403le.txt:72",
   "file": "D1403le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無言でティベリウスの頭を踏みつける。",
   "ko_candidate": "무언으로 티베리우스의 머리를 짓밟는다｡"
  },
  {
   "id": 36863,
   "key": "D1403le.txt:73",
   "file": "D1403le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ミシミシと頭蓋骨が、圧力に悲鳴を上げる。",
   "ko_candidate": "미시미시 두개골이 압력에 비명을 지른다｡"
  },
  {
   "id": 36864,
   "key": "D1403le.txt:78",
   "file": "D1403le.txt",
   "line": 78,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「己の方こそ世話になった」",
   "ko_candidate": "「나 역시 신세를 졌다」"
  },
  {
   "id": 36865,
   "key": "D1403le.txt:82",
   "file": "D1403le.txt",
   "line": 82,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「い、いやねえサンダルフォンちゃんったら！　な、何、マジになってんのさ！」 「ほ、ほら、アレでしょ？　あんなのちょっとしたジョークじゃないのさ！　そんなに怒らなくても……」",
   "ko_candidate": "「아､ 아니 산달폰쨩! 뭐､ 뭐야､ 진심이야? 저､ 저거 말이야､ 그냥 농담이었잖아! 그렇게 화내지 않아도…」"
  },
  {
   "id": 36866,
   "key": "D1403le.txt:88",
   "file": "D1403le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その声の冷たさにサンダルフォンの殺気を敏感に読み取った。",
   "ko_candidate": "그 목소리의 차가움에서 산달폰의 살기를 민감하게 읽어냈다｡"
  },
  {
   "id": 36867,
   "key": "D1403le.txt:89",
   "file": "D1403le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "途端に弱気になるティベリウス。",
   "ko_candidate": "갑자기 약해지는 티베리우스｡"
  },
  {
   "id": 36868,
   "key": "D1403le.txt:91",
   "file": "D1403le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがサンダルフォンは、そんなティベリウスには構わず、",
   "ko_candidate": "하지만 산달폰은 그런 티베리우스는 상관하지 않고､"
  },
  {
   "id": 36869,
   "key": "D1403le.txt:97",
   "file": "D1403le.txt",
   "line": 97,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「確かに貴様如き、本気になる価値も無い」",
   "ko_candidate": "「확실히 너 같은 놈은 진지하게 상대할 가치도 없지」"
  },
  {
   "id": 36870,
   "key": "D1403le.txt:101",
   "file": "D1403le.txt",
   "line": 101,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だったら！」",
   "ko_candidate": "「그렇다면!」"
  },
  {
   "id": 36871,
   "key": "D1403le.txt:105",
   "file": "D1403le.txt",
   "line": 105,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だが」",
   "ko_candidate": "「하지만」"
  },
  {
   "id": 36872,
   "key": "D1403le.txt:113",
   "file": "D1403le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血溜まりの中から魔導書を拾い上げる。",
   "ko_candidate": "피웅덩이에서 마도서를 집어 든다｡"
  },
  {
   "id": 36873,
   "key": "D1403le.txt:114",
   "file": "D1403le.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの眸がはっきりと恐怖に凍りついた。",
   "ko_candidate": "티베리우스의 눈동자가 확실히 공포로 얼어붙었다｡"
  },
  {
   "id": 36874,
   "key": "D1403le.txt:115",
   "file": "D1403le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔導書を弄びながら、サンダルフォンは宣告する。",
   "ko_candidate": "마도서를 만지작거리며 산달폰이 선고한다｡"
  },
  {
   "id": 36875,
   "key": "D1403le.txt:119",
   "file": "D1403le.txt",
   "line": 119,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これ以上、貴様にウロチョロされるのは目障りだ。 それに貴様は……俺の手からライカを奪っていった」",
   "ko_candidate": "「더 이상 네가 설치는 것은 눈에 거슬린다｡ 게다가 너는… 내 손에서 라이카를 빼앗아갔지」"
  },
  {
   "id": 36876,
   "key": "D1403le.txt:124",
   "file": "D1403le.txt",
   "line": 124,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「待っ……！」",
   "ko_candidate": "「잠깐…!」"
  },
  {
   "id": 36877,
   "key": "D1403le.txt:128",
   "file": "D1403le.txt",
   "line": 128,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「滅びろ」",
   "ko_candidate": "「사라져라」"
  },
  {
   "id": 36878,
   "key": "D1403le.txt:136",
   "file": "D1403le.txt",
   "line": 136,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『気』が、迸った。",
   "ko_candidate": "『기』가 뿜어져 나왔다｡"
  },
  {
   "id": 36879,
   "key": "D1403le.txt:137",
   "file": "D1403le.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの手の中で、魔導書が燃える。",
   "ko_candidate": "산달폰의 손 안에서 마도서가 타오른다｡"
  },
  {
   "id": 36880,
   "key": "D1403le.txt:138",
   "file": "D1403le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鉄の表装すら飴細工の様に熔けていく。",
   "ko_candidate": "철제 표장조차 사탕처럼 녹아내린다｡"
  },
  {
   "id": 36881,
   "key": "D1403le.txt:139",
   "file": "D1403le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの仮面が絶叫を上げた。",
   "ko_candidate": "티베리우스의 가면이 절규를 질렀다｡"
  },
  {
   "id": 36882,
   "key": "D1403le.txt:143",
   "file": "D1403le.txt",
   "line": 143,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「止めてぇぇぇぇぇぇぇぇ！　いやぁぁぁぁぁぁぁ！　いやぁぁぁぁぁぁぁ！　火を消してぇぇぇぇぇ！　お願いよぉぉぉぉぉぉ！」 「……うぎゃああああああああああああああああ！」",
   "ko_candidate": "「그만해에에에에에에에! 싫어어어어어어어! 싫어어어어어어어! 불 꺼줘어어어어어! 제발이야아아아아아아! …우갸아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 36883,
   "key": "D1403le.txt:149",
   "file": "D1403le.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼応するように、ティベリウスの仮面が燃えた。",
   "ko_candidate": "호응하듯 티베리우스의 가면이 불탔다｡"
  },
  {
   "id": 36884,
   "key": "D1403le.txt:150",
   "file": "D1403le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐敗し爛れた頭が燃えた。",
   "ko_candidate": "부패하고 썩은 머리가 불탔다｡"
  },
  {
   "id": 36885,
   "key": "D1403le.txt:151",
   "file": "D1403le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滅びの炎の中に、断末魔の表情に引き攣ったティベリウスの貌が崩れてゆく。",
   "ko_candidate": "멸망의 불꽃 속에 단말마의 표정으로 일그러진 티베리우스의 얼굴이 무너져간다｡"
  },
  {
   "id": 36886,
   "key": "D1403le.txt:156",
   "file": "D1403le.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの足が、火の玉と化した頭を踏み砕く。",
   "ko_candidate": "산달폰의 발이 불덩이가 된 머리를 짓밟아 부순다｡"
  },
  {
   "id": 36887,
   "key": "D1403le.txt:162",
   "file": "D1403le.txt",
   "line": 162,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぁぁ……ぁ……ぁぁぁ……アタシガ……キエテユク……」",
   "ko_candidate": "「아아… 아… 아아아… 내가… 사라져간다…」"
  },
  {
   "id": 36888,
   "key": "D1403le.txt:165",
   "file": "D1403le.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "炎は肉片の一つ、骨の一欠けらすら徹底的に焼き尽くす。",
   "ko_candidate": "불꽃은 살점 하나､ 뼈 조각 하나까지 철저히 태워버린다｡"
  },
  {
   "id": 36889,
   "key": "D1403le.txt:166",
   "file": "D1403le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ては炎に昇華され――瘴気の残滓が、空気に散った。",
   "ko_candidate": "모든 것이 불꽃에 승화되어―장기의 잔재가 공기 중에 흩어졌다｡"
  },
  {
   "id": 36890,
   "key": "D1403le.txt:167",
   "file": "D1403le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不死を誇った魔術師の、呆気ない最期だった。",
   "ko_candidate": "불사를 자랑하던 마술사의 허무한 최후였다｡"
  },
  {
   "id": 36891,
   "key": "D1403le.txt:173",
   "file": "D1403le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瘴気の残滓に一瞥もくれず、サンダルフォンは再びハンティング・ホラーに跨った。",
   "ko_candidate": "장기의 잔재를 한 번 쳐다보지도 않고 산달폰은 다시 헌팅 호러에 올라탔다｡"
  },
  {
   "id": 36892,
   "key": "D1403le.txt:174",
   "file": "D1403le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線は遠く南西を見据えている。",
   "ko_candidate": "시선은 멀리 남서쪽을 응시하고 있다｡"
  },
  {
   "id": 36893,
   "key": "D1403le.txt:178",
   "file": "D1403le.txt",
   "line": 178,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ルルイエか……ふん。不愉快だ。苛々する」",
   "ko_candidate": "「르뤼에인가… 흥｡ 불쾌하군｡ 짜증 난다」"
  },
  {
   "id": 36894,
   "key": "D1403le.txt:187",
   "file": "D1403le.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンジン音が空っぽの空と、空っぽの大地に響き渡る。",
   "ko_candidate": "엔진 소리가 텅 빈 하늘과 텅 빈 대지에 울려 퍼진다｡"
  },
  {
   "id": 36895,
   "key": "D1403le.txt:189",
   "file": "D1403le.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クレーターに車輪の跡を抉り、ハンティング・ホラーは疾り出した。",
   "ko_candidate": "분화구에 바퀴 자국을 내며 헌팅 호러가 질주해 나갔다｡"
  },
  {
   "id": 36896,
   "key": "D1403le.txt:194",
   "file": "D1403le.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空気との摩擦熱が黒の天使と鋼鉄の獣を灼熱させ――スピードは可視領域を超える。",
   "ko_candidate": "공기와의 마찰열이 검은 천사와 강철의 짐승을 작열시키고―속도는 가시 영역을 넘어선다｡"
  },
  {
   "id": 36897,
   "key": "D1403le.txt:196",
   "file": "D1403le.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界を貫く爆音と共に、ハンティング・ホラーは姿を消した。",
   "ko_candidate": "세계를 관통하는 폭음과 함께 헌팅 호러의 모습이 사라졌다｡"
  }
 ]
}