 "items": [
  {
   "id": 10792,
   "key": "D0714.txt:1015",
   "file": "D0714.txt",
   "line": 1015,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "高速で迫る巨影は靄のようなものをまとっていた。",
   "ko_candidate": "고속으로 다가오는 거대한 그림자는 안개 같은 것을 두르고 있었다｡ 피다｡"
  },
  {
   "id": 10793,
   "key": "D0714.txt:1018",
   "file": "D0714.txt",
   "line": 1018,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血だ。その身体から流れ出る血が海ににじみ出ていた。大量の血を止め処なく流しながら、それでもゴンドラの速度は衰えた様子を見せない。",
   "ko_candidate": "그 체구에서 넘쳐나는 피가 바다에 번져나가고 있었다｡ 대량의 피를 멈출 수 없이 흘리면서도 곤드라의 속도는 줄어든 기색을 보이지 않는다｡"
  },
  {
   "id": 10794,
   "key": "D0714.txt:1024",
   "file": "D0714.txt",
   "line": 1024,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だけど、まったく効かなかったワケじゃねえだろ。 ……だったら、もう一度だ！」",
   "ko_candidate": "「하지만… 전혀 효과가 없었던 건 아니겠지｡ 그렇다면 한 번 더다!」 다시 언월도를 구사하고 마력을 순환시킨다｡"
  },
  {
   "id": 10795,
   "key": "D0714.txt:1038",
   "file": "D0714.txt",
   "line": 1038,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "再び偃月刀を構え、魔力を循環させる。",
   "ko_candidate": "해면에서 나오는 순간 확 베어버리겠어――!"
  },
  {
   "id": 10796,
   "key": "D0714.txt:1039",
   "file": "D0714.txt",
   "line": 1039,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "海面から出てきたところをブッタ斬ってやる。",
   "ko_candidate": "바다를 가르고 요란한 소리를 내며 바다괴물이 다가온다｡"
  },
  {
   "id": 10797,
   "key": "D0714.txt:1042",
   "file": "D0714.txt",
   "line": 1042,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……来やがれ、サカナ野郎！",
   "ko_candidate": "덤벼라､ 물고기 자식!"
  },
  {
   "id": 10798,
   "key": "D0714.txt:1043",
   "file": "D0714.txt",
   "line": 1043,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今度は陸の上だ。さっきのようにはいかねえぜ！",
   "ko_candidate": "이번엔 육지 위다… 아까처럼은 안 될 거야!"
  },
  {
   "id": 10799,
   "key": "D0714.txt:1063",
   "file": "D0714.txt",
   "line": 1063,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "眼前で海面が爆ぜた。",
   "ko_candidate": "눈앞에서 해면이 터졌다｡"
  },
  {
   "id": 10800,
   "key": "D0714.txt:1064",
   "file": "D0714.txt",
   "line": 1064,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "海魔の威容が、デモンベインに圧しかかる――！",
   "ko_candidate": "바다괴물의 위용이 압도하듯 덮쳐온다! 「세이야아아아아――――읏!」"
  },
  {
   "id": 10801,
   "key": "D0714.txt:1086",
   "file": "D0714.txt",
   "line": 1086,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「せいやァァァァァ――――ッッ！」",
   "ko_candidate": "――베다｡ 확실한 손맛이 있었다｡"
  },
  {
   "id": 10802,
   "key": "D0714.txt:1110",
   "file": "D0714.txt",
   "line": 1110,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "確かな手応えがあった。",
   "ko_candidate": "살을 베는 감촉이 조종간을 통해 전해져 오는 것 같았다｡"
  },
  {
   "id": 10803,
   "key": "D0714.txt:1114",
   "file": "D0714.txt",
   "line": 1114,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "肉を断つ感触が、操縦桿越しに伝わってきた。",
   "ko_candidate": "성대하게 피를 흩뿌리며 곤드라의 몸체는 두 동강이 나 대지에 떨어진다｡"
  },
  {
   "id": 10804,
   "key": "D0714.txt:1118",
   "file": "D0714.txt",
   "line": 1118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――勝った。",
   "ko_candidate": "――이겼다｡"
  },
  {
   "id": 10805,
   "key": "D0714.txt:1119",
   "file": "D0714.txt",
   "line": 1119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "安堵の息をもらし、緊張を解く――",
   "ko_candidate": "안도의 한숨을 내쉬며 긴장을 풀었다――"
  },
  {
   "id": 10806,
   "key": "D0714.txt:1130",
   "file": "D0714.txt",
   "line": 1130,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うつけ！　まだだ！」",
   "ko_candidate": "「멍청아! 아직이다!」"
  },
  {
   "id": 10807,
   "key": "D0714.txt:1136",
   "file": "D0714.txt",
   "line": 1136,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣…?」"
  },
  {
   "id": 10808,
   "key": "D0714.txt:1142",
   "file": "D0714.txt",
   "line": 1142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悪寒に気づいたときは遅かった。",
   "ko_candidate": "불길한 예감을 느꼈을 때는 이미 늦었다｡"
  },
  {
   "id": 10809,
   "key": "D0714.txt:1198",
   "file": "D0714.txt",
   "line": 1198,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「があああああっっ！」",
   "ko_candidate": "「가아아아아앗!」"
  },
  {
   "id": 10810,
   "key": "D0714.txt:1204",
   "file": "D0714.txt",
   "line": 1204,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あああああああ！」",
   "ko_candidate": "「아아아아아아!」"
  },
  {
   "id": 10811,
   "key": "D0714.txt:1210",
   "file": "D0714.txt",
   "line": 1210,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "左右より迫った４本の触腕。デモンベインの頭を、腕を、胴体を、脚を貫いた。",
   "ko_candidate": "좌우에서 다가온 4개의 촉완｡ 데몬베인의 머리와 팔과 몸통과 다리를 관통했다｡"
  },
  {
   "id": 10812,
   "key": "D0714.txt:1218",
   "file": "D0714.txt",
   "line": 1218,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "破損箇所が放電する。 噴き出す水銀の血。",
   "ko_candidate": "파손 부위에서 방전이 일어난다｡ 수은 같은 피가 뿜어져 나온다｡"
  },
  {
   "id": 10813,
   "key": "D0714.txt:1222",
   "file": "D0714.txt",
   "line": 1222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "砂浜を銀色に穢しながら、デモンベインは膝を突いた。",
   "ko_candidate": "모래사장을 은색으로 더럽히며 데몬베인은 무릎을 꿇었다｡"
  },
  {
   "id": 10814,
   "key": "D0714.txt:1238",
   "file": "D0714.txt",
   "line": 1238,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまった……迂闊……ッ！」",
   "ko_candidate": "「젠장… 방심했어…!」"
  },
  {
   "id": 10815,
   "key": "D0714.txt:1243",
   "file": "D0714.txt",
   "line": 1243,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……そうかッ、クソ……ッ！」",
   "ko_candidate": "「크… 그렇군､ 젠장…!」"
  },
  {
   "id": 10816,
   "key": "D0714.txt:1260",
   "file": "D0714.txt",
   "line": 1260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "膝を突いたデモンベインをダゴンとヒュドラ――分離した２体の海魔が嘲笑うように見下ろしていた。",
   "ko_candidate": "무릎 꿇은 데몬베인을 조롱하듯 다곤과 휴드라―― 분리된 두 마리의 바다괴물이 내려다보고 있었다｡"
  },
  {
   "id": 10817,
   "key": "D0714.txt:1263",
   "file": "D0714.txt",
   "line": 1263,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こいつら斬った瞬間に、元に戻りやがった……！",
   "ko_candidate": "이놈들 베는 순간 원래대로 돌아갔군…! 촉완이 빠져나간다｡"
  },
  {
   "id": 10818,
   "key": "D0714.txt:1274",
   "file": "D0714.txt",
   "line": 1274,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "触腕が引き抜かれる。だがダメージが大きく、起き上がることが出来ない。",
   "ko_candidate": "하지만 데미지가 커서 일어설 수가 없다｡"
  },
  {
   "id": 10819,
   "key": "D0714.txt:1289",
   "file": "D0714.txt",
   "line": 1289,
   "speaker": "アル",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "足掻くデモンベインの目の前で、ダゴンとヒュドラは再び融合した。 「拙いぞ、九郎……！」",
   "ko_candidate": "발버둥치는 데몬베인의 눈앞에서 다곤과 휴드라는 다시 융합했다｡"
  },
  {
   "id": 10820,
   "key": "D0714.txt:1301",
   "file": "D0714.txt",
   "line": 1301,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………ッッ！」",
   "ko_candidate": "「위험하다､ 쿠로…!」"
  },
  {
   "id": 10821,
   "key": "D0714.txt:1320",
   "file": "D0714.txt",
   "line": 1320,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "巨大な触腕を、馬鹿にしているのか、本当にゆっくりと振り上げた。",
   "ko_candidate": "「…읏!」 거대한 촉완을 비웃듯이 정말 천천히 들어 올렸다｡"
  },
  {
   "id": 10822,
   "key": "D0714.txt:1323",
   "file": "D0714.txt",
   "line": 1323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この巨体で触腕を振るえば、ボロボロのデモンベインなど簡単に粉砕できるだろう。",
   "ko_candidate": "이 거체로 촉완을 휘두르면 너덜너덜한 데몬베인 따위는 간단히 분쇄할 수 있을 것이다｡"
  },
  {
   "id": 10823,
   "key": "D0714.txt:1326",
   "file": "D0714.txt",
   "line": 1326,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……クソッタレ！ ここで万事休すか！？",
   "ko_candidate": "…젠장! 여기서 끝장나는 건가!?"
  },
  {
   "id": 10824,
   "key": "D0714.txt:1337",
   "file": "D0714.txt",
   "line": 1337,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――！　まだだ……っ！」",
   "ko_candidate": "「――――! 아직이다…!」"
  },
  {
   "id": 10825,
   "key": "D0714.txt:1343",
   "file": "D0714.txt",
   "line": 1343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうだ。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 10826,
   "key": "D0714.txt:1344",
   "file": "D0714.txt",
   "line": 1344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "打つ手がなくなったワケじゃない。",
   "ko_candidate": "손을 쓸 수 없게 된 건 아니야｡"
  },
  {
   "id": 10827,
   "key": "D0714.txt:1347",
   "file": "D0714.txt",
   "line": 1347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだ……試していないものがある！",
   "ko_candidate": "아직… 시도해보지 않은 게 있어!"
  },
  {
   "id": 10828,
   "key": "D0714.txt:1348",
   "file": "D0714.txt",
   "line": 1348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はコンソールと格闘するアルに向かって、叫んだ。",
   "ko_candidate": "나는 콘솔과 씨름하는 알을 향해 외쳤다｡"
  },
  {
   "id": 10829,
   "key": "D0714.txt:1359",
   "file": "D0714.txt",
   "line": 1359,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くっ…… 回路の復活はまだか……！？」",
   "ko_candidate": "「크… 회로의 부활은 아직인가……!?」"
  },
  {
   "id": 10830,
   "key": "D0714.txt:1366",
   "file": "D0714.txt",
   "line": 1366,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アルッ！」",
   "ko_candidate": "「알!」"
  },
  {
