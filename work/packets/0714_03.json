   "key": "D0714.txt:1371",
   "file": "D0714.txt",
   "line": 1371,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何だ！？　今、立て込んで――」",
   "ko_candidate": "「뭐야!? 지금､ 바쁘게――」"
  }
