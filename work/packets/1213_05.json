 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "ライカ": "라이카",
  "アリスン": "앨리슨",
  "ティベリウス": "티베리우스",
  "クトゥグア": "크투가",
  "イタクァ": "이타콰",
  "クラウディウス": "클라우디우스",
  "大十字": "다이쥬지",
  "マギウス・ウィング": "마기우스 윙"
 },
 "items": [
  {
   "id": 30115,
   "key": "D1213le.txt:676",
   "file": "D1213le.txt",
   "line": 676,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカお姉ちゃん！　九郎お兄ちゃん！」",
   "ko_candidate": "「라이카 누나! 쿠로 오빠!」"
  },
  {
   "id": 30116,
   "key": "D1213le.txt:679",
   "file": "D1213le.txt",
   "line": 679,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "去り際に、アリスンが振り返る。",
   "ko_candidate": "떠나는 길에 앨리슨이 돌아본다｡"
  },
  {
   "id": 30117,
   "key": "D1213le.txt:680",
   "file": "D1213le.txt",
   "line": 680,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不安そうな瞳が見つめていた。",
   "ko_candidate": "불안한 눈동자가 바라보고 있었다｡"
  },
  {
   "id": 30118,
   "key": "D1213le.txt:683",
   "file": "D1213le.txt",
   "line": 683,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大丈夫だ！　俺たちは絶対に……」",
   "ko_candidate": "「괜찮아! 우리는 절대로…」"
  },
  {
   "id": 30119,
   "key": "D1213le.txt:688",
   "file": "D1213le.txt",
   "line": 688,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「絶対に負けない！」",
   "ko_candidate": "「절대로 지지 않아!」"
  },
  {
   "id": 30120,
   "key": "D1213le.txt:691",
   "file": "D1213le.txt",
   "line": 691,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームセイバーの光が迅る。",
   "ko_candidate": "빔 세이버의 빛이 번쩍인다｡"
  },
  {
   "id": 30121,
   "key": "D1213le.txt:695",
   "file": "D1213le.txt",
   "line": 695,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――斬。",
   "ko_candidate": "――베기｡"
  },
  {
   "id": 30122,
   "key": "D1213le.txt:696",
   "file": "D1213le.txt",
   "line": 696,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの腕が切断される。",
   "ko_candidate": "티베리우스의 팔이 절단된다｡"
  },
  {
   "id": 30123,
   "key": "D1213le.txt:697",
   "file": "D1213le.txt",
   "line": 697,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "忌々しげな呻き声が零れた。",
   "ko_candidate": "못마땅한 신음 소리가 새어 나왔다｡"
  },
  {
   "id": 30124,
   "key": "D1213le.txt:699",
   "file": "D1213le.txt",
   "line": 699,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その光景を見守っていたアリスンは、やがて力強く頷いた。",
   "ko_candidate": "그 광경을 지켜보던 앨리슨은 이내 힘차게 고개를 끄덕였다｡"
  },
  {
   "id": 30125,
   "key": "D1213le.txt:704",
   "file": "D1213le.txt",
   "line": 704,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「絶対だよ……絶対だよ！　絶対に勝ってね！」",
   "ko_candidate": "「절대야… 절대야! 꼭 이겨야 해!」"
  },
  {
   "id": 30126,
   "key": "D1213le.txt:708",
   "file": "D1213le.txt",
   "line": 708,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう告げると、瓦礫に開いた穴の向こうへと姿を消した。",
   "ko_candidate": "그렇게 말하고는 잔해에 뚫린 구멍 너머로 모습을 감췄다｡"
  },
  {
   "id": 30127,
   "key": "D1213le.txt:709",
   "file": "D1213le.txt",
   "line": 709,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これで何の憂いも無く、全力を出せる！",
   "ko_candidate": "이제 아무런 걱정 없이 전력을 다할 수 있어!"
  },
  {
   "id": 30128,
   "key": "D1213le.txt:711",
   "file": "D1213le.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "撃ち尽くしたイタクァを口に咥え、代わりにクトゥグアを手に執る。",
   "ko_candidate": "다 쏜 이타콰를 입에 물고､ 대신 크투가를 손에 든다｡"
  },
  {
   "id": 30129,
   "key": "D1213le.txt:720",
   "file": "D1213le.txt",
   "line": 720,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音。",
   "ko_candidate": "폭음｡"
  },
  {
   "id": 30130,
   "key": "D1213le.txt:721",
   "file": "D1213le.txt",
   "line": 721,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの胸部に穴が開く。",
   "ko_candidate": "티베리우스의 가슴에 구멍이 뚫린다｡"
  },
  {
   "id": 30131,
   "key": "D1213le.txt:725",
   "file": "D1213le.txt",
   "line": 725,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に連射。",
   "ko_candidate": "더 연사한다｡"
  },
  {
   "id": 30132,
   "key": "D1213le.txt:726",
   "file": "D1213le.txt",
   "line": 726,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬でカートリッジは空になり、ティベリウスの躰は粉々に砕け散り、ただの血溜まりとなる。",
   "ko_candidate": "순식간에 카트리지가 비고､ 티베리우스의 몸은 산산조각 나 그저 핏자국이 되었다｡"
  },
  {
   "id": 30133,
   "key": "D1213le.txt:729",
   "file": "D1213le.txt",
   "line": 729,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、飛び散った鮮血は、ビデオの逆再生の如く、再び一点に集まり、渦を巻き、血溜まりの中から腕が生え、足が生え、臓腑が生え、頭が生えた。",
   "ko_candidate": "하지만 튀어 오른 선혈은 비디오 역재생처럼 다시 한 점으로 모이고､ 소용돌이치며､ 핏자국 속에서 팔이 자라고､ 다리가 자라고､ 내장이 자라고､ 머리가 자랐다｡"
  },
  {
   "id": 30134,
   "key": "D1213le.txt:730",
   "file": "D1213le.txt",
   "line": 730,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "依然、死を知らぬ屍体が其処に居る。",
   "ko_candidate": "이전과 같이 죽음을 모르는 시체가 그곳에 있다｡"
  },
  {
   "id": 30135,
   "key": "D1213le.txt:736",
   "file": "D1213le.txt",
   "line": 736,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……キリがねえ。",
   "ko_candidate": "…끝이 없군｡"
  },
  {
   "id": 30136,
   "key": "D1213le.txt:741",
   "file": "D1213le.txt",
   "line": 741,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クラウディウス！　こっちへいらっしゃい！」",
   "ko_candidate": "「클라우디우스! 이리 오너라!」"
  },
  {
   "id": 30137,
   "key": "D1213le.txt:745",
   "file": "D1213le.txt",
   "line": 745,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "屍人使いに命ぜられるまま、クラウディウスが飛来する。",
   "ko_candidate": "시체 조종자의 명령대로 클라우디우스가 날아온다｡"
  },
  {
   "id": 30138,
   "key": "D1213le.txt:746",
   "file": "D1213le.txt",
   "line": 746,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲を取り囲む風の結界。",
   "ko_candidate": "주위를 감싸는 바람의 결계｡"
  },
  {
   "id": 30139,
   "key": "D1213le.txt:748",
   "file": "D1213le.txt",
   "line": 748,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛翔のスピードに堪えられず、肉が剥がれ落ち、血が風に乗る。",
   "ko_candidate": "비행 속도를 견디지 못해 살이 떨어져 나가고､ 피가 바람에 실린다｡"
  },
  {
   "id": 30140,
   "key": "D1213le.txt:749",
   "file": "D1213le.txt",
   "line": 749,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血風と化すティベリウス。",
   "ko_candidate": "피바람이 되는 티베리우스｡"
  },
  {
   "id": 30141,
   "key": "D1213le.txt:754",
   "file": "D1213le.txt",
   "line": 754,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字……九郎……。殺。殺。殺……殺…………殺………………。 ――殺ッ！」",
   "ko_candidate": "「다이쥬지… 쿠로… 죽여｡ 죽여｡ 죽여… 죽여…… 죽여………… ――죽여앗!」"
  },
  {
   "id": 30142,
   "key": "D1213le.txt:758",
   "file": "D1213le.txt",
   "line": 758,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血風に怨念が宿る。",
   "ko_candidate": "피바람에 원념이 깃든다｡"
  },
  {
   "id": 30143,
   "key": "D1213le.txt:760",
   "file": "D1213le.txt",
   "line": 760,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……意志を持たないゾンビではない。そもそも意志の無い者に魔術を駆使出来ない。",
   "ko_candidate": "…의지가 없는 좀비가 아니다｡ 애초에 의지가 없는 자는 마술을 구사할 수 없다｡"
  },
  {
   "id": 30144,
   "key": "D1213le.txt:762",
   "file": "D1213le.txt",
   "line": 762,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "明らかな殺意は、純度を高め、鋭く研ぎ澄まされ、俺の精神に突き刺さる。",
   "ko_candidate": "명백한 살의는 순도를 높이고 날카롭게 연마되어 내 정신에 꽂힌다｡"
  },
  {
   "id": 30145,
   "key": "D1213le.txt:764",
   "file": "D1213le.txt",
   "line": 764,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突如、クラウディウスの姿が消える。",
   "ko_candidate": "돌연 클라우디우스의 모습이 사라진다｡"
  },
  {
   "id": 30146,
   "key": "D1213le.txt:765",
   "file": "D1213le.txt",
   "line": 765,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが突き刺さる殺意が、俺に回避行動を取らせた。",
   "ko_candidate": "하지만 꽂히는 살의가 나로 하여금 회피 행동을 취하게 했다｡"
  },
  {
   "id": 30147,
   "key": "D1213le.txt:767",
   "file": "D1213le.txt",
   "line": 767,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身を捩る。",
   "ko_candidate": "몸을 비튼다｡"
  },
  {
   "id": 30148,
   "key": "D1213le.txt:768",
   "file": "D1213le.txt",
   "line": 768,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音速で疾る、空間を引き裂くような紅い刃を俺は見た。",
   "ko_candidate": "음속으로 질주하는､ 공간을 찢는 듯한 붉은 칼날을 나는 보았다｡"
  },
  {
   "id": 30149,
   "key": "D1213le.txt:778",
   "file": "D1213le.txt",
   "line": 778,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぅぅああっ！」",
   "ko_candidate": "「크으으아앗!」"
  },
  {
   "id": 30150,
   "key": "D1213le.txt:780",
   "file": "D1213le.txt",
   "line": 780,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血風が、左腕を掠める。",
   "ko_candidate": "피바람이 왼팔을 스친다｡"
  },
  {
   "id": 30151,
   "key": "D1213le.txt:781",
   "file": "D1213le.txt",
   "line": 781,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皮は千切れ、肉は刻まれ、血が噴き出る。",
   "ko_candidate": "피부가 찢어지고､ 살이 잘리고､ 피가 솟구친다｡"
  },
  {
   "id": 30152,
   "key": "D1213le.txt:782",
   "file": "D1213le.txt",
   "line": 782,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血が兇風に煽られ、旋風を巻いた。",
   "ko_candidate": "피가 흉풍에 휘말려 회오리를 일으켰다｡"
  },
  {
   "id": 30153,
   "key": "D1213le.txt:784",
   "file": "D1213le.txt",
   "line": 784,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・ウィングがシュレッダーにかけられた紙屑の如く、刻まれる。",
   "ko_candidate": "마기우스 윙이 파쇄기에 걸린 종이 조각처럼 잘게 썰린다｡"
  },
  {
   "id": 30154,
   "key": "D1213le.txt:785",
   "file": "D1213le.txt",
   "line": 785,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛みのあまり、口に咥えたイタクァを落としてしまう。",
   "ko_candidate": "고통에 입에 물고 있던 이타콰를 떨어뜨리고 만다｡"
  }
 ]
}