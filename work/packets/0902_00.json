   "key": "D0902al.txt:73",
   "file": "D0902al.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "異形の炎に照らされて、床を濡らす血の海がぬらぬらと光る。",
   "ko_candidate": "육체｡ 육체｡"
