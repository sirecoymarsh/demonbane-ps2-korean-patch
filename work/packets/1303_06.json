 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "瑠璃": "루리",
  "九郎": "쿠로",
  "アル": "알",
  "クラウディウス": "클라우디우스",
