 },
 "items": [
  {
   "id": 31701,
   "key": "D1303ru.txt:323",
   "file": "D1303ru.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見渡す限り、焔える闇黒の海。",
   "ko_candidate": "둘러보는 한 타오르는 암흑의 바다｡"
  },
  {
   "id": 31702,
   "key": "D1303ru.txt:324",
   "file": "D1303ru.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃達は、まるで海の孤島に取り残されているかのようだった。",
   "ko_candidate": "루리 일행은 마치 바다의 고도에 남겨진 것 같았다｡"
  },
  {
   "id": 31703,
   "key": "D1303ru.txt:328",
   "file": "D1303ru.txt",
   "line": 328,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああっ……！」",
   "ko_candidate": "「아아…!」"
  },
  {
   "id": 31704,
   "key": "D1303ru.txt:334",
   "file": "D1303ru.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐ足許まで、闇黒が迫る。",
   "ko_candidate": "바로 발밑까지 암흑이 다가온다｡"
  },
  {
   "id": 31705,
   "key": "D1303ru.txt:335",
   "file": "D1303ru.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "焔の舌を、舐める様に、ちらつかせる。",
   "ko_candidate": "불꽃의 혀를 핥듯 깜빡인다｡"
  },
  {
   "id": 31706,
   "key": "D1303ru.txt:339",
   "file": "D1303ru.txt",
   "line": 339,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……第四の結印よ！」",
   "ko_candidate": "「…제4의 결인이여!」"
  },
  {
   "id": 31707,
   "key": "D1303ru.txt:345",
   "file": "D1303ru.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の足許で、五芒星形が輝く。",
   "ko_candidate": "루리의 발밑에서 오망성형이 빛난다｡"
  },
  {
   "id": 31708,
   "key": "D1303ru.txt:347",
   "file": "D1303ru.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その光を畏れるように、闇黒は遠ざかった。",
   "ko_candidate": "그 빛을 두려워하듯 암흑은 멀어졌다｡"
  },
  {
   "id": 31709,
   "key": "D1303ru.txt:348",
   "file": "D1303ru.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれでも、遠くで隙を窺いながら、身を悶えさせている。",
   "ko_candidate": "하지만 그래도 멀리서 틈을 엿보며 몸부림치고 있다｡"
  },
  {
   "id": 31710,
   "key": "D1303ru.txt:352",
   "file": "D1303ru.txt",
   "line": 352,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「長くは、持ちそうに 無いぞ……！」",
   "ko_candidate": "「오래 버티긴 힘들 것 같아…!」"
  },
  {
   "id": 31711,
   "key": "D1303ru.txt:357",
   "file": "D1303ru.txt",
   "line": 357,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うくぅ……っ！」",
   "ko_candidate": "「으크…!」"
  },
  {
   "id": 31712,
   "key": "D1303ru.txt:360",
   "file": "D1303ru.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒が激しく、のたうち、波打つ。",
   "ko_candidate": "암흑이 격렬하게 몸부림치며 파도친다｡"
  },
  {
   "id": 31713,
   "key": "D1303ru.txt:361",
   "file": "D1303ru.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は激動する闇黒の向こう、ただ九郎だけを見つめ続けている。",
   "ko_candidate": "루리는 격동하는 암흑 너머로 오직 쿠로만을 계속 바라보고 있다｡"
  },
  {
   "id": 31714,
   "key": "D1303ru.txt:363",
   "file": "D1303ru.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――劫ッ。",
   "ko_candidate": "――겁｡"
  },
  {
   "id": 31715,
   "key": "D1303ru.txt:365",
   "file": "D1303ru.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天井まで呑み込むほどの高波が昇った。",
   "ko_candidate": "천장까지 삼킬 듯한 높은 파도가 솟아올랐다｡"
  },
  {
   "id": 31716,
   "key": "D1303ru.txt:366",
   "file": "D1303ru.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "津波は闇黒の顎を開き、闇黒の焔を咽喉の奥に滾らせて、哄笑を轟かせながら、怒濤と九郎に押し寄せる。",
   "ko_candidate": "쓰나미는 암흑의 턱을 벌리고 암흑의 불꽃을 목구멍 안에서 들끓게 하며 폭소를 울리면서 성난 파도처럼 쿠로에게 밀려온다｡"
  },
  {
   "id": 31717,
   "key": "D1303ru.txt:370",
   "file": "D1303ru.txt",
   "line": 370,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ！　今度こそ……！」",
   "ko_candidate": "「――――! 이번엔 정말로…!」"
  },
  {
   "id": 31718,
   "key": "D1303ru.txt:374",
   "file": "D1303ru.txt",
   "line": 374,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「っ!? こら！　またか、汝はっ！」",
   "ko_candidate": "「! 이봐! 또냐､ 네가!」"
  },
  {
   "id": 31719,
   "key": "D1303ru.txt:384",
   "file": "D1303ru.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "印の上から、瑠璃は飛び出した。",
   "ko_candidate": "인장 위에서 루리가 뛰쳐나갔다｡"
  },
  {
   "id": 31720,
   "key": "D1303ru.txt:385",
   "file": "D1303ru.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "途端に、闇黒が迫り来る。",
   "ko_candidate": "순간 암흑이 다가온다｡"
  },
  {
   "id": 31721,
   "key": "D1303ru.txt:387",
   "file": "D1303ru.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは五芒星形の印を、瑠璃の前方に展開。",
   "ko_candidate": "알은 오망성형의 인장을 루리의 전방에 전개했다｡"
  },
  {
   "id": 31722,
   "key": "D1303ru.txt:389",
   "file": "D1303ru.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "押し寄せる闇黒を弾く。",
   "ko_candidate": "밀려오는 암흑을 튕겨낸다｡"
  },
  {
   "id": 31723,
   "key": "D1303ru.txt:391",
   "file": "D1303ru.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒を貫きながら、瑠璃は再び、マントを広げて飛翔する。",
   "ko_candidate": "암흑을 뚫으며 루리는 다시 망토를 펼쳐 날아오른다｡"
  },
  {
   "id": 31724,
   "key": "D1303ru.txt:395",
   "file": "D1303ru.txt",
   "line": 395,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「不用意に近づけば、先程の二の舞だぞ……！」",
   "ko_candidate": "「경솔하게 다가가면 아까처럼 될 거야…!」"
  },
  {
   "id": 31725,
   "key": "D1303ru.txt:402",
   "file": "D1303ru.txt",
   "line": 402,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………助ける」",
   "ko_candidate": "「…구할 거야」"
  },
  {
   "id": 31726,
   "key": "D1303ru.txt:405",
   "file": "D1303ru.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルに答える訳ではなく、瑠璃は呟いた。",
   "ko_candidate": "알에게 대답하는 것이 아니라 루리는 중얼거렸다｡"
  },
  {
   "id": 31727,
   "key": "D1303ru.txt:410",
   "file": "D1303ru.txt",
   "line": 410,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「助ける！　今度こそ、絶対に！」",
   "ko_candidate": "「구할 거야! 이번엔 반드시!」"
  },
  {
   "id": 31728,
   "key": "D1303ru.txt:413",
   "file": "D1303ru.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呟きに込められた決意は、怨念じみてすらいた。",
   "ko_candidate": "중얼거림에 담긴 결의는 원념에 가까웠다｡"
  },
  {
   "id": 31729,
   "key": "D1303ru.txt:417",
   "file": "D1303ru.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分が九郎を追い詰めたと云う事実。",
   "ko_candidate": "자신이 쿠로를 몰아붙였다는 사실｡"
  },
  {
   "id": 31730,
   "key": "D1303ru.txt:418",
   "file": "D1303ru.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ての状況は、自分が引き起こしたものだと云う事実。",
   "ko_candidate": "모든 상황은 자신이 일으킨 것이라는 사실｡"
  },
  {
   "id": 31731,
   "key": "D1303ru.txt:420",
   "file": "D1303ru.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それらが自責の念となり、己に対する呪詛となり、更にはその自責と呪詛と怨念の奥にある、瑠璃自身がまだはっきりと認識していない激情が、瑠璃を無謀へと駆り立てていた。",
   "ko_candidate": "그것들이 자책의 념이 되고 자신에 대한 저주가 되어､ 더 나아가 그 자책과 저주와 원념의 깊은 곳에 있는､ 루리 자신이 아직 명확히 인식하지 못한 격정이 루리를 무모함으로 몰아갔다｡"
  },
  {
   "id": 31732,
   "key": "D1303ru.txt:422",
   "file": "D1303ru.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎が迫り来る瑠璃を見つめる。",
   "ko_candidate": "쿠로가 다가오는 루리를 바라본다｡"
  },
  {
   "id": 31733,
   "key": "D1303ru.txt:423",
   "file": "D1303ru.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神速を超えて、偃月刀が瑠璃を斬り捨てる",
   "ko_candidate": "신속을 넘어 언월도가 루리를 베어 넘기려――했다｡"
  },
  {
   "id": 31734,
   "key": "D1303ru.txt:424",
   "file": "D1303ru.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――はずだった。 偃月刀を握る、九郎の右手に刻まれた焔の烙印が、闇黒の中で薄っすらと輝く。",
   "ko_candidate": "언월도를 쥔 쿠로의 오른손에 새겨진 불꽃의 낙인이 암흑 속에서 희미하게 빛난다｡"
  },
  {
   "id": 31735,
   "key": "D1303ru.txt:430",
   "file": "D1303ru.txt",
   "line": 430,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 31736,
   "key": "D1303ru.txt:433",
   "file": "D1303ru.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは瞬時に閃いた。",
   "ko_candidate": "알은 순식간에 떠올렸다｡"
  },
  {
   "id": 31737,
   "key": "D1303ru.txt:435",
   "file": "D1303ru.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔銃は!?",
   "ko_candidate": "마총은!?"
  },
  {
   "id": 31738,
   "key": "D1303ru.txt:437",
   "file": "D1303ru.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――見つけた。",
   "ko_candidate": "――찾았다｡"
  },
  {
   "id": 31739,
   "key": "D1303ru.txt:438",
   "file": "D1303ru.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの一撃を貰った時に、地面に落としていた。",
   "ko_candidate": "클라우디우스의 일격을 받았을 때 땅에 떨어뜨렸다｡"
  },
  {
   "id": 31740,
   "key": "D1303ru.txt:441",
   "file": "D1303ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルはクトゥグアを経由して、九郎の烙印に介入。",
   "ko_candidate": "알은 크투가를 경유해 쿠로의 낙인에 개입했다｡"
  }
 ]
}