{
 "packet": "1514_07",
 "scene": "1514",
 "anchor": {
  "hit": 54,
  "total": 63,
  "rate": 0.857
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "大十字九郎": "다이쥬지 쿠로",
  "デモンベイン": "데몬베인",
  "術式": "술식"
 },
 "items": [
  {
   "id": 47183,
   "key": "D1514ru.txt:31",
   "file": "D1514ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その事実を大十字九郎は知るべくも無い。",
   "ko_candidate": "그 사실을 다이쥬지 쿠로는 알 리가 없다｡"
  },
  {
   "id": 47184,
   "key": "D1514ru.txt:34",
   "file": "D1514ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、デモンベインは――",
   "ko_candidate": "그리고､ 데몬베인은――"
  },
  {
   "id": 47185,
   "key": "D1514ru.txt:46",
   "file": "D1514ru.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――妾は識っている。",
   "ko_candidate": "――첩은 알고 있다｡"
  },
  {
   "id": 47186,
   "key": "D1514ru.txt:54",
   "file": "D1514ru.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "押し寄せる破滅。",
   "ko_candidate": "밀려오는 파멸｡"
  },
  {
   "id": 47187,
   "key": "D1514ru.txt:55",
   "file": "D1514ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否、生温い。",
   "ko_candidate": "아니､ 미지근하다｡"
  },
  {
   "id": 47188,
   "key": "D1514ru.txt:57",
   "file": "D1514ru.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは否定。",
   "ko_candidate": "이는 부정｡"
  },
  {
   "id": 47189,
   "key": "D1514ru.txt:58",
   "file": "D1514ru.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "未来の否定。",
   "ko_candidate": "미래의 부정｡"
  },
  {
   "id": 47190,
   "key": "D1514ru.txt:59",
   "file": "D1514ru.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去の否定。",
   "ko_candidate": "과거의 부정｡"
  },
  {
   "id": 47191,
   "key": "D1514ru.txt:61",
   "file": "D1514ru.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時間と空間から隔絶された、断絶された、異形の角度へと引き摺り堕とす、存在の楔を引き剥がす、情報の崩壊。",
   "ko_candidate": "시간과 공간으로부터 격리된､ 단절된､ 기괴한 각도로 끌어내리는､ 존재의 쐐기를 벗겨내는､ 정보의 붕괴｡"
  },
  {
   "id": 47192,
   "key": "D1514ru.txt:65",
   "file": "D1514ru.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう――妾は、識っている。",
   "ko_candidate": "그래――첩은､ 알고 있다｡"
  },
  {
   "id": 47193,
   "key": "D1514ru.txt:66",
   "file": "D1514ru.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この力を、識っている。",
   "ko_candidate": "이 힘을､ 알고 있다｡"
  },
  {
   "id": 47194,
   "key": "D1514ru.txt:67",
   "file": "D1514ru.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遥かな永劫を通して――永劫の果ての永劫を通して、この力を識っていた。",
   "ko_candidate": "아득한 영겁을 통해――영겁의 끝의 영겁을 통해､ 이 힘을 알고 있었다｡"
  },
  {
   "id": 47195,
   "key": "D1514ru.txt:69",
   "file": "D1514ru.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶望が帳を下ろす。",
   "ko_candidate": "절망이 장막을 내린다｡"
  },
  {
   "id": 47196,
   "key": "D1514ru.txt:70",
   "file": "D1514ru.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此れに、捉まる訳にはいかない。",
   "ko_candidate": "이것에､ 사로잡힐 수는 없다｡"
  },
  {
   "id": 47197,
   "key": "D1514ru.txt:71",
   "file": "D1514ru.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此れに捉まれば――『滅び』すら遺せない。",
   "ko_candidate": "이것에 사로잡히면――『멸망』조차 남길 수 없다｡"
  },
  {
   "id": 47198,
   "key": "D1514ru.txt:73",
   "file": "D1514ru.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手段を講じろ。",
   "ko_candidate": "수단을 강구해라｡"
  },
  {
   "id": 47199,
   "key": "D1514ru.txt:74",
   "file": "D1514ru.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "術式を奔らせろ。",
   "ko_candidate": "술식을 달리게 해라｡"
  },
  {
   "id": 47200,
   "key": "D1514ru.txt:76",
   "file": "D1514ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宇宙の総てを計測してでも、この絶望の裏をかけ。",
   "ko_candidate": "우주의 모든 것을 측정해서라도､ 이 절망의 뒤를 쫓아라｡"
  },
  {
   "id": 47201,
   "key": "D1514ru.txt:77",
   "file": "D1514ru.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶望より遁れる法則を、世界を、何としてでも創り出せ。",
   "ko_candidate": "절망에서 벗어나는 법칙을､ 세계를､ 어떻게든 만들어 내라｡"
  },
  {
   "id": 47202,
   "key": "D1514ru.txt:78",
   "file": "D1514ru.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奇蹟を起こしてでも創り出せ。",
   "ko_candidate": "기적을 일으켜서라도 만들어 내라｡"
  },
  {
   "id": 47203,
   "key": "D1514ru.txt:80",
   "file": "D1514ru.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "囚われてはいけない。",
   "ko_candidate": "사로잡혀서는 안 된다｡"
  },
  {
   "id": 47204,
   "key": "D1514ru.txt:81",
   "file": "D1514ru.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "囚われさせてはいけない。",
   "ko_candidate": "사로잡히게 해서는 안 된다｡"
  },
  {
   "id": 47205,
   "key": "D1514ru.txt:83",
   "file": "D1514ru.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼を。",
   "ko_candidate": "그를｡"
  },
  {
   "id": 47206,
   "key": "D1514ru.txt:84",
   "file": "D1514ru.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "我が主を。",
   "ko_candidate": "내 주인을｡"
  },
  {
   "id": 47207,
   "key": "D1514ru.txt:85",
   "file": "D1514ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎を。",
   "ko_candidate": "다이쥬지 쿠로를｡"
  },
  {
   "id": 47208,
   "key": "D1514ru.txt:87",
   "file": "D1514ru.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "せめて、せめて、奴だけは。",
   "ko_candidate": "적어도､ 적어도､ 그 녀석만은｡"
  },
  {
   "id": 47209,
   "key": "D1514ru.txt:88",
   "file": "D1514ru.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何としても、在るべき世界へ――",
   "ko_candidate": "어떻게든､ 있어야 할 세계로――"
  },
  {
   "id": 47210,
   "key": "D1514ru.txt:94",
   "file": "D1514ru.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――大十字九郎。",
   "ko_candidate": "――다이쥬지 쿠로｡"
  },
  {
   "id": 47211,
   "key": "D1514ru.txt:100",
   "file": "D1514ru.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今までのどの主とも違っていた。",
   "ko_candidate": "지금까지의 어떤 주인과도 달랐다｡"
  },
  {
   "id": 47212,
   "key": "D1514ru.txt:102",
   "file": "D1514ru.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾の主となるべく運命の人間としては――酷く、凡人だった。",
   "ko_candidate": "첩의 주인이 될 운명의 인간으로서는――몹시､ 평범했다｡"
  },
  {
   "id": 47213,
   "key": "D1514ru.txt:103",
   "file": "D1514ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうしようもないほどに、只のヒトであった。",
   "ko_candidate": "어쩔 수 없을 정도로､ 그저 인간일 뿐이었다｡"
  },
  {
   "id": 47214,
   "key": "D1514ru.txt:104",
   "file": "D1514ru.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔人でも超人でもなく、あくまで人間の規格内でしかない、ありふれた人間であった。",
   "ko_candidate": "마인도 초인도 아닌､ 어디까지나 인간의 규격 내에서만､ 흔한 인간이었다｡"
  },
  {
   "id": 47215,
   "key": "D1514ru.txt:106",
   "file": "D1514ru.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてそれ故に、誰よりも強かった。",
   "ko_candidate": "그리고 그렇기에､ 누구보다도 강했다｡"
  },
  {
   "id": 47216,
   "key": "D1514ru.txt:109",
   "file": "D1514ru.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正しくは、汝は只の人間でありながら、ほんの少しだけ他人とはズレていた。",
   "ko_candidate": "정확히는､ 너는 그저 인간이면서도､ 아주 조금만 다른 사람들과는 어긋나 있었다｡"
  },
  {
   "id": 47217,
   "key": "D1514ru.txt:111",
   "file": "D1514ru.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "他人より、ほんの僅かに魔術に通じていた。",
   "ko_candidate": "다른 사람들보다､ 아주 조금 마술에 통달해 있었다｡"
  },
  {
   "id": 47218,
   "key": "D1514ru.txt:112",
   "file": "D1514ru.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それもある。",
   "ko_candidate": "그것도 있다｡"
  },
  {
   "id": 47219,
   "key": "D1514ru.txt:114",
   "file": "D1514ru.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術に通じていながら『書』を持たず、邪悪にも染まっていなかった。",
   "ko_candidate": "마술에 통달해 있으면서도 『서』를 갖지 않고､ 사악함에도 물들지 않았다｡"
  },
  {
   "id": 47220,
   "key": "D1514ru.txt:115",
   "file": "D1514ru.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それも大きい。",
   "ko_candidate": "그것도 크다｡"
  },
  {
   "id": 47221,
   "key": "D1514ru.txt:117",
   "file": "D1514ru.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが何よりも――汝は、他人よりも少しばかりお人好し過ぎた。",
   "ko_candidate": "하지만 무엇보다도―너는 다른 사람들보다 조금 더 인정이 많았다｡"
  },
  {
   "id": 47222,
   "key": "D1514ru.txt:122",
   "file": "D1514ru.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僅かな、ほんの些細な他人との違いに思える。",
   "ko_candidate": "아주 작은､ 사소한 차이로 보일 수 있다｡"
  }
 ]
}