 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "アル": "알"
 },
 "items": [
  {
   "id": 11863,
   "key": "D0801al.txt:815",
   "file": "D0801al.txt",
   "line": 815,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――出逢ったのだ。",
   "ko_candidate": "기이한 광경이었다｡"
  },
  {
   "id": 11864,
   "key": "D0801al.txt:821",
   "file": "D0801al.txt",
   "line": 821,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……おいおい」",
   "ko_candidate": "이런 폭우 속에､ 누더기를 걸치고､"
  },
  {
   "id": 11865,
   "key": "D0801al.txt:836",
   "file": "D0801al.txt",
   "line": 836,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎……此奴は……」",
   "ko_candidate": "눈을 감고､ 입술을 보라색으로 물들이고､"
  },
  {
   "id": 11866,
   "key": "D0801al.txt:844",
   "file": "D0801al.txt",
   "line": 844,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "襤褸をまとい、少女は独り凍えていた。",
   "ko_candidate": "덜덜 떨고 있는 소녀｡ 「쿠로… 이 녀석은…」"
  },
  {
   "id": 11867,
   "key": "D0801al.txt:847",
   "file": "D0801al.txt",
   "line": 847,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "雨に霞む夜闇に似た、空ろな瞳。 それが、あまりにも儚げで、弱々しくて。",
   "ko_candidate": "하지만 소녀는､ 잠든 듯한 그 얼굴에 희미하게나마 미소를 띠고 있었다｡"
  },
  {
   "id": 11868,
   "key": "D0801al.txt:853",
   "file": "D0801al.txt",
   "line": 853,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺には、その少女がまるで、か弱い捨て猫のように思えてしまったのだ。",
   "ko_candidate": "그 미소는 너무나도 덧없고､ 연약해서｡ 나는 소녀가 마치 연약한 버려진 고양이처럼 느껴졌다｡"
  },
  {
   "id": 11869,
   "key": "D0801al.txt:861",
   "file": "D0801al.txt",
   "line": 861,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから――",
   "ko_candidate": "그래서――"
  },
  {
   "id": 11870,
   "key": "D0801al.txt:903",
   "file": "D0801al.txt",
   "line": 903,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……相も変わらずお節介な奴だな、汝は」",
   "ko_candidate": "「……여전히 참견하기 좋아하는 녀석이구나､ 네놈은」"
  },
  {
   "id": 11871,
   "key": "D0801al.txt:908",
   "file": "D0801al.txt",
   "line": 908,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや……だから、さすがにほったらかしにしとくのは後味悪ィじゃねえかよ」",
   "ko_candidate": "「아니… 그래도､ 아무래도 그냥 내버려두는 건 찜찜하잖아」"
  },
  {
   "id": 11872,
   "key": "D0801al.txt:917",
   "file": "D0801al.txt",
   "line": 917,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その『後味悪ィ』で、いつもいつも災難に見舞われているようだが？」",
   "ko_candidate": "「그 『찜찜함』 때문에､ 매번 매번 재난을 당하고 있는 것 같은데?」"
  },
  {
   "id": 11873,
   "key": "D0801al.txt:923",
   "file": "D0801al.txt",
   "line": 923,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだよな。そのせいでクソ生意気な小娘の居候と悪の組織相手にドンパチやらかす理不尽な人生を背負い込むことになっちまったんだよ、チクショウ」",
   "ko_candidate": "「그렇지｡ 그 때문에 건방진 꼬마 얹혀살이랑､ 악의 조직을 상대로 총격전을 벌이는 이치에 맞지 않는 인생을 짊어지게 됐지､ 젠장」"
  },
  {
   "id": 11874,
   "key": "D0801al.txt:934",
   "file": "D0801al.txt",
   "line": 934,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "手にしたバスタオルを、少女に向かって投げる。",
   "ko_candidate": "나는 손에 든 목욕 타월을 소녀를 향해 던졌다｡"
  },
  {
   "id": 11875,
   "key": "D0801al.txt:935",
   "file": "D0801al.txt",
   "line": 935,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "バスタオルが少女の頭の上に被さった。",
   "ko_candidate": "소녀의 머리에 목욕 타월이 덮어씌워졌다｡"
  },
  {
   "id": 11876,
   "key": "D0801al.txt:940",
   "file": "D0801al.txt",
   "line": 940,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「身体を拭きな。風邪引くぜ？」",
   "ko_candidate": "「몸을 닦아｡ 감기 걸릴 거야?」"
  },
  {
   "id": 11877,
   "key": "D0801al.txt:944",
   "file": "D0801al.txt",
   "line": 944,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言っても、呆……と惚けたまま動こうとしない。",
   "ko_candidate": "말해도､ 멍… 하니 멍한 채로 움직이려 하지 않는다｡"
  },
  {
   "id": 11878,
   "key": "D0801al.txt:947",
   "file": "D0801al.txt",
   "line": 947,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やれやれと、俺は少女の頭をぐしゃぐしゃと拭いてやった。",
   "ko_candidate": "어쩔 수 없다는 듯이､ 나는 소녀의 머리를 쓱쓱 닦아주었다｡"
  },
  {
   "id": 11879,
   "key": "D0801al.txt:950",
   "file": "D0801al.txt",
   "line": 950,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭を拭かれている間も動かないで流されるままだ。",
   "ko_candidate": "머리를 닦이는 동안에도 움직이지 않고 그대로 있다｡"
  },
  {
   "id": 11880,
   "key": "D0801al.txt:951",
   "file": "D0801al.txt",
   "line": 951,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嫌がる素振りすら見せない。",
   "ko_candidate": "싫어하는 기색조차 보이지 않는다｡"
  },
  {
   "id": 11881,
   "key": "D0801al.txt:954",
   "file": "D0801al.txt",
   "line": 954,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さて……後、問題は……",
   "ko_candidate": "자､ 이제… 문제는…"
  },
  {
   "id": 11882,
   "key": "D0801al.txt:959",
   "file": "D0801al.txt",
   "line": 959,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………うっ」",
   "ko_candidate": "「……………윽」"
  },
  {
   "id": 11883,
   "key": "D0801al.txt:962",
   "file": "D0801al.txt",
   "line": 962,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線を下にずらして、すぐにそらす。",
   "ko_candidate": "시선을 아래로 내리고､ 곧바로 돌렸다｡"
  },
  {
   "id": 11884,
   "key": "D0801al.txt:963",
   "file": "D0801al.txt",
   "line": 963,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やっぱり……この格好のままはマズイよなぁ。",
   "ko_candidate": "누더기 옷의 틈새로 소녀의 가슴이 드러나 있었다｡"
  },
  {
   "id": 11885,
   "key": "D0801al.txt:969",
   "file": "D0801al.txt",
   "line": 969,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「すまん、アル。着替えと風呂手伝ってやってくれ」",
   "ko_candidate": "역시… 이 차림 그대로는 좋지 않겠지｡ 「미안､ 알｡ 갈아입히고 목욕 도와줘」"
  },
  {
   "id": 11886,
   "key": "D0801al.txt:978",
   "file": "D0801al.txt",
   "line": 978,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何で妾が……」",
   "ko_candidate": "「왜 내가…」"
  },
  {
   "id": 11887,
   "key": "D0801al.txt:983",
   "file": "D0801al.txt",
   "line": 983,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「俺がやるワケにはいかねえだろ……頼むよ」",
   "ko_candidate": "「내가 할 수는 없잖아… 부탁해」"
  },
  {
   "id": 11888,
   "key": "D0801al.txt:993",
   "file": "D0801al.txt",
   "line": 993,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ったく」",
   "ko_candidate": "「……정말」"
  },
  {
   "id": 11889,
   "key": "D0801al.txt:1003",
   "file": "D0801al.txt",
   "line": 1003,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "着替えと言っても、この家に彼女のサイズに合う服なんてあるはずがない。",
   "ko_candidate": "갈아입힌다고 해도､ 이 집에 그녀 사이즈에 맞는 옷이 있을 리가 없다｡"
  },
  {
   "id": 11890,
   "key": "D0801al.txt:1005",
   "file": "D0801al.txt",
   "line": 1005,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まあ、俺のシャツでも貸すしかないだろう。",
   "ko_candidate": "뭐､ 내 셔츠라도 빌려줘야겠지｡"
  },
  {
   "id": 11891,
   "key": "D0801al.txt:1006",
   "file": "D0801al.txt",
   "line": 1006,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サイズが合ってないがしょうがない。",
   "ko_candidate": "사이즈가 맞지 않지만 어쩔 수 없다｡"
  },
  {
   "id": 11892,
   "key": "D0801al.txt:1009",
   "file": "D0801al.txt",
   "line": 1009,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "部屋の端にいる少女を引っ張って、浴室の前まで連れてくる。 そのとき、少女の手首に目がいった……。",
   "ko_candidate": "나는 방 구석에 있는 소녀를 끌어당겨 안으로 들이려고 했다… 그때 소녀의 손목이 눈에 들어왔다｡"
  },
  {
   "id": 11893,
   "key": "D0801al.txt:1018",
   "file": "D0801al.txt",
   "line": 1018,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「…………………………」"
  },
  {
   "id": 11894,
   "key": "D0801al.txt:1023",
   "file": "D0801al.txt",
   "line": 1023,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どれ、汝はそっち向いてろ。犯罪者呼ばわりされたくなければな」",
   "ko_candidate": "「자､ 네놈은 저쪽을 보고 있어라｡ 성범죄자 취급당하고 싶지 않다면 말이야」"
  },
  {
   "id": 11895,
   "key": "D0801al.txt:1028",
   "file": "D0801al.txt",
   "line": 1028,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「…………………………」"
  },
  {
   "id": 11896,
   "key": "D0801al.txt:1040",
   "file": "D0801al.txt",
   "line": 1040,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "浴室へ入るのが気配で分かった。 シャワーの音を聞きながら、俺は待つ。",
   "ko_candidate": "알 일행에게서 등을 돌린다｡ 욕실로 들어가는 게 기척으로 알 수 있었다｡"
  },
  {
   "id": 11897,
   "key": "D0801al.txt:1045",
   "file": "D0801al.txt",
   "line": 1045,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溜息をついて、沈む気持ちを誤魔化す。",
   "ko_candidate": "샤워 소리를 들으며､ 나는 기다린다｡"
  },
  {
   "id": 11898,
   "key": "D0801al.txt:1047",
   "file": "D0801al.txt",
   "line": 1047,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しばらくして風呂場から出てきたアルが声を掛けてきた。",
   "ko_candidate": "한숨을 쉬며､ 가라앉는 기분을 달랜다｡ 잠시 후 욕실에서 나온 알이 말을 걸어왔다｡"
  },
  {
   "id": 11899,
   "key": "D0801al.txt:1053",
   "file": "D0801al.txt",
   "line": 1053,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎、もう良いぞ」",
   "ko_candidate": "「쿠로､ 이제 괜찮아」"
  },
  {
   "id": 11900,
   "key": "D0801al.txt:1058",
   "file": "D0801al.txt",
   "line": 1058,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おう……って下も、はかせてやれよ」",
   "ko_candidate": "「오… 아래도 입혀줘야지」"
  },
  {
   "id": 11901,
   "key": "D0801al.txt:1063",
   "file": "D0801al.txt",
   "line": 1063,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「面倒だ」",
   "ko_candidate": "「귀찮아」"
  },
  {
   "id": 11902,
   "key": "D0801al.txt:1069",
   "file": "D0801al.txt",
   "line": 1069,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「め、面倒って……マニアックな格好になっちまったじゃねえか」",
   "ko_candidate": "「귀､ 귀찮다니… 매니악한 차림이 되어버렸잖아」"
  }
 ]
}