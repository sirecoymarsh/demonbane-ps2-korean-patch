 },
 "items": [
  {
   "id": 27621,
   "key": "D1205ru.txt:75",
   "file": "D1205ru.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖に震える瑠璃の貌が、更に青ざめる。",
   "ko_candidate": "공포에 떠는 루리의 얼굴이 더욱 창백해진다｡"
  },
  {
   "id": 27622,
   "key": "D1205ru.txt:77",
   "file": "D1205ru.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "窓ガラスの向こう――集中治療室のベッドに眠る九郎の姿を認めた瞬間、クラウディウスの凶相はこれ以上に無いほど歪み、遂には哄笑になって溢れ出した。",
   "ko_candidate": "창문 너머――중환자실 침대에서 자고 있는 쿠로의 모습을 알아차린 순간､ 클라우디우스의 광기 어린 표정은 이 이상 없이 일그러지더니､ 마침내 폭소가 되어 터져 나왔다｡"
  },
  {
   "id": 27623,
   "key": "D1205ru.txt:84",
   "file": "D1205ru.txt",
   "line": 84,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ひゃひゃ……ヒャヒャヒャッ！　ヒャーハッハッハハハハハッ！　そーかい、そーかい！　大十字九郎もココにいたかい！　こいつぁ手間が省けるってモンだぜ！」",
   "ko_candidate": "「히야히야… 히야히야히약! 히야하하하하하하학! 그렇구나､ 그렇구나! 다이쥬지 쿠로도 여기 있었구나! 이거 수고가 덜어지는 거네!」"
  },
  {
   "id": 27624,
   "key": "D1205ru.txt:90",
   "file": "D1205ru.txt",
   "line": 90,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ！」",
   "ko_candidate": "「――――윽!」"
  },
  {
   "id": 27625,
   "key": "D1205ru.txt:96",
   "file": "D1205ru.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烈風が疾った。",
   "ko_candidate": "열풍이 질주했다｡"
  },
  {
   "id": 27626,
   "key": "D1205ru.txt:97",
   "file": "D1205ru.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "集中治療室を隔てるガラスが砕け散る。",
   "ko_candidate": "중환자실을 가로막는 유리가 산산조각 났다｡"
  },
  {
   "id": 27627,
   "key": "D1205ru.txt:102",
   "file": "D1205ru.txt",
   "line": 102,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「呑気に寝てんじゃねえよ……まあ、ボクの用事はすぐ済むからさぁ……終わったら、もう二度と起きなくて良いぜぇっ！」",
   "ko_candidate": "「한가하게 자고 있네… 뭐､ 내 용무는 금방 끝날 테니까… 끝나면､ 이제 두 번 다시 일어나지 않아도 돼!」"
  },
  {
   "id": 27628,
   "key": "D1205ru.txt:111",
   "file": "D1205ru.txt",
   "line": 111,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「크윽…!」"
  },
  {
   "id": 27629,
   "key": "D1205ru.txt:114",
   "file": "D1205ru.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "下唇を噛んで、瑠璃が動いた。",
   "ko_candidate": "아랫입술을 깨물며､ 루리가 움직였다｡"
  },
  {
   "id": 27630,
   "key": "D1205ru.txt:115",
   "file": "D1205ru.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "椅子の横に立て掛けていた偃月刀を手に取り、九郎とクラウディウスの間に立つ。",
   "ko_candidate": "의자 옆에 세워두었던 언월도를 손에 들고､ 쿠로와 클라우디우스 사이에 선다｡"
  },
  {
   "id": 27631,
   "key": "D1205ru.txt:119",
   "file": "D1205ru.txt",
   "line": 119,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何のつもりだ、てめぇ？」",
   "ko_candidate": "「…뭘 하려는 거야､ 너?」"
  },
  {
   "id": 27632,
   "key": "D1205ru.txt:124",
   "file": "D1205ru.txt",
   "line": 124,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「……………」"
  },
  {
   "id": 27633,
   "key": "D1205ru.txt:128",
   "file": "D1205ru.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黙って、偃月刀を構えた。",
   "ko_candidate": "말없이､ 언월도를 겨누었다｡"
  },
  {
   "id": 27634,
   "key": "D1205ru.txt:129",
   "file": "D1205ru.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの前に立ち塞がり、九郎を庇う。",
   "ko_candidate": "클라우디우스 앞을 가로막고､ 쿠로를 감싼다｡"
  },
  {
   "id": 27635,
   "key": "D1205ru.txt:130",
   "file": "D1205ru.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心底、馬鹿にした視線が、瑠璃を見上げる。",
   "ko_candidate": "정말로 바보 취급하는 시선이 루리를 올려다본다｡"
  },
  {
   "id": 27636,
   "key": "D1205ru.txt:134",
   "file": "D1205ru.txt",
   "line": 134,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒャハハッハ！　……アタマ足りねぇのかよ、お姉ちゃん？」 「なに？　何なの？ ヤリマスか？　ボクと一緒に遊びマスカ？　んん？　マジ？　本気？」",
   "ko_candidate": "「히야하하하! …머리가 모자란 거야､ 누나? 뭐야? 뭐야? 해볼 거야? 나랑 같이 놀아볼래? 응? 진짜? 진심이야?」"
  },
  {
   "id": 27637,
   "key": "D1205ru.txt:145",
   "file": "D1205ru.txt",
   "line": 145,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「……………」"
  },
  {
   "id": 27638,
   "key": "D1205ru.txt:148",
   "file": "D1205ru.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は答えない。",
   "ko_candidate": "루리는 대답하지 않는다｡"
  },
  {
   "id": 27639,
   "key": "D1205ru.txt:149",
   "file": "D1205ru.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は動かない。",
   "ko_candidate": "루리는 움직이지 않는다｡"
  },
  {
   "id": 27640,
   "key": "D1205ru.txt:150",
   "file": "D1205ru.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少年は不機嫌そうに眉を顰め、ガンを飛ばす。",
   "ko_candidate": "소년은 불쾌한 듯 눈썹을 찌푸리며､ 노려본다｡"
  },
  {
   "id": 27641,
   "key": "D1205ru.txt:154",
   "file": "D1205ru.txt",
   "line": 154,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「笑えねぇんだよ、オマエ？　偽善臭くてウゼぇんだよ？ あぁん？　いちいちイラつかせる女だなァ、オイッ！」",
   "ko_candidate": "「웃기지도 않아､ 너? 위선 냄새나서 짜증 나는데? 아아? 하나하나 짜증 나게 하는 여자네､ 이봐!」"
  },
  {
   "id": 27642,
   "key": "D1205ru.txt:158",
   "file": "D1205ru.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は答えない。",
   "ko_candidate": "루리는 대답하지 않는다｡"
  },
  {
   "id": 27643,
   "key": "D1205ru.txt:159",
   "file": "D1205ru.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は動かない。",
   "ko_candidate": "루리는 움직이지 않는다｡"
  },
  {
   "id": 27644,
   "key": "D1205ru.txt:160",
   "file": "D1205ru.txt",
   "line": 160,
   "speaker": "クラウディウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "真っ直ぐな瞳は、真っ直ぐにクラウディウスを捉えている。 「ザコはザコらしく、隅っこで震えてろっつんだよッ！」",
   "ko_candidate": "똑바른 눈동자는 똑바로 클라우디우스를 포착하고 있다｡"
  },
  {
   "id": 27645,
   "key": "D1205ru.txt:167",
   "file": "D1205ru.txt",
   "line": 167,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「無様に泣き叫んでションベン 漏らして命乞いして、愉快に殺 されるくらいしか、役に立たねぇ だろうがよぉ、てめーみたいのは よぉ！」 「気に入らねえな！」",
   "ko_candidate": "「잡것은 잡것답게､ 구석에서 떨고 있으라고! 볼품없이 울부짖고 오줌 싸고 목숨 구걸하고､ 유쾌하게 죽임당하는 정도밖에､ 쓸모없잖아､ 너 같은 건! 맘에 안 들어!」"
  },
  {
   "id": 27646,
   "key": "D1205ru.txt:179",
   "file": "D1205ru.txt",
   "line": 179,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ！」",
   "ko_candidate": "「………윽!」"
  },
  {
   "id": 27647,
   "key": "D1205ru.txt:188",
   "file": "D1205ru.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恫喝するように、風が迸った。",
   "ko_candidate": "협박하듯이､ 바람이 솟구쳤다｡"
  },
  {
   "id": 27648,
   "key": "D1205ru.txt:190",
   "file": "D1205ru.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の頬に、また新しい裂傷が走る。",
   "ko_candidate": "루리의 뺨에､ 또 새로운 열상이 생긴다｡"
  },
  {
   "id": 27649,
   "key": "D1205ru.txt:192",
   "file": "D1205ru.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い肌に幾筋もの、赤い筋。",
   "ko_candidate": "하얀 피부에 여러 줄의 붉은 선｡"
  },
  {
   "id": 27650,
   "key": "D1205ru.txt:194",
   "file": "D1205ru.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は――動かない。",
   "ko_candidate": "루리는――움직이지 않는다｡"
  },
  {
   "id": 27651,
   "key": "D1205ru.txt:196",
   "file": "D1205ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが遂にキレた。",
   "ko_candidate": "클라우디우스가 마침내 폭발했다｡"
  },
  {
   "id": 27652,
   "key": "D1205ru.txt:200",
   "file": "D1205ru.txt",
   "line": 200,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ッッッッ！　本当にウゼぇ！　ウザ過ぎだぜ、ブス女ッ！」 「そのスカしたツラ！ もうちょっとはマシに見れるよう、 整形してやらぁぁぁぁぁぁぁっ！」",
   "ko_candidate": "「윽! 정말 짜증 나! 짜증 나 죽겠어､ 못생긴 여자! 그 가식적인 얼굴! 조금이라도 나아 보이게､ 성형해주마아아아아아아악!」"
  },
  {
   "id": 27653,
   "key": "D1205ru.txt:209",
   "file": "D1205ru.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掲げる右腕に、荒れ狂う竜巻を纏った。",
   "ko_candidate": "들어 올린 오른팔에､ 광포한 회오리를 둘렀다｡"
  },
  {
   "id": 27654,
   "key": "D1205ru.txt:210",
   "file": "D1205ru.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金切り声を上げてうねる黒風、殺戮の刃は、今まさに瑠璃へと振り下ろされようとしていた。",
   "ko_candidate": "날카로운 비명을 지르며 휘감기는 검은 바람､ 살육의 칼날은 지금 막 루리에게 내리쳐지려 하고 있었다｡"
  },
  {
   "id": 27655,
   "key": "D1205ru.txt:215",
   "file": "D1205ru.txt",
   "line": 215,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くぅ……ううううぅぅっっ！」",
   "ko_candidate": "「크윽… 으으으으윽!」"
  },
  {
   "id": 27656,
   "key": "D1205ru.txt:218",
   "file": "D1205ru.txt",
   "line": 218,
   "speaker": "クラウディウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "身を強張らせ、手にした偃月刀の剣先は小刻みに震え、それでも瑠璃は退かない。兇風の勢いは極限まで高まり、遂に―― 「くたばりやが……！」",
   "ko_candidate": "몸을 굳게 하고､ 손에 든 언월도의 칼끝은 미세하게 떨리지만､ 그래도 루리는 물러서지 않는다｡ 흉포한 바람의 기세는 극한까지 높아지고､ 마침내――"
  },
  {
   "id": 27657,
   "key": "D1205ru.txt:232",
   "file": "D1205ru.txt",
   "line": 232,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くたばりやがれロボ―――― ッ！」",
   "ko_candidate": "「뒈져버려…!」 「뒈져버려 로봇――――!」"
  },
  {
   "id": 27658,
   "key": "D1205ru.txt:239",
   "file": "D1205ru.txt",
   "line": 239,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――っ!? どぐおおおっ！」",
   "ko_candidate": "「――――윽!? 으구우욱!」"
  },
  {
   "id": 27659,
   "key": "D1205ru.txt:244",
   "file": "D1205ru.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然の乱入者だった。",
   "ko_candidate": "갑작스러운 난입자였다｡"
  },
  {
   "id": 27660,
   "key": "D1205ru.txt:245",
   "file": "D1205ru.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トンファーの一撃が、クラウディウスのこめかみを捉えた。",
   "ko_candidate": "통파의 일격이 클라우디우스의 관자놀이를 포착했다｡"
  }
 ]
}