{
 "packet": "1305_00",
 "scene": "1305",
 "anchor": {
  "hit": 46,
  "total": 50,
  "rate": 0.92
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {},
 "items": [
  {
   "id": 32206,
   "key": "D1305al.txt:14",
   "file": "D1305al.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無言で剣を妾に託そうとする骸達。",
   "ko_candidate": "말없이 검을 첩에게 맡기려는 해골들｡"
  },
  {
   "id": 32207,
   "key": "D1305al.txt:15",
   "file": "D1305al.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "我が主達。",
   "ko_candidate": "나의 주군들｡"
  },
  {
   "id": 32208,
   "key": "D1305al.txt:17",
   "file": "D1305al.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――まだ、闘えと汝等は云うか。",
   "ko_candidate": "――아직도､ 싸우라고 그대들은 말하는가｡"
  },
  {
   "id": 32209,
   "key": "D1305al.txt:21",
   "file": "D1305al.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は首を横に振る。",
   "ko_candidate": "첩은 고개를 가로젓는다｡"
  },
  {
   "id": 32210,
   "key": "D1305al.txt:22",
   "file": "D1305al.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾にその力は無い。",
   "ko_candidate": "첩에게는 그런 힘이 없다｡"
  },
  {
   "id": 32211,
   "key": "D1305al.txt:23",
   "file": "D1305al.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "千年を越える悠久は、思いの他、妾の魂を疲弊させ、",
   "ko_candidate": "천 년을 넘는 유구함은､ 생각보다､ 첩의 영혼을 피폐하게 만들고､"
  },
  {
   "id": 32212,
   "key": "D1305al.txt:24",
   "file": "D1305al.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "消耗させていたらしい。",
   "ko_candidate": "소모시켰던 모양이다｡"
  },
  {
   "id": 32213,
   "key": "D1305al.txt:26",
   "file": "D1305al.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾の魂は、がらんどうだ。",
   "ko_candidate": "첩의 영혼은､ 텅 비어 있다｡"
  },
  {
   "id": 32214,
   "key": "D1305al.txt:27",
   "file": "D1305al.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "二度と剣を執ることは叶わない。",
   "ko_candidate": "두 번 다시 검을 들 수 없다｡"
  },
  {
   "id": 32215,
   "key": "D1305al.txt:29",
   "file": "D1305al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、なおも骸達は動かない。",
   "ko_candidate": "하지만､ 그래도 해골들은 움직이지 않는다｡"
  },
  {
   "id": 32216,
   "key": "D1305al.txt:30",
   "file": "D1305al.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "命無き眸で訴える。",
   "ko_candidate": "생명 없는 눈동자로 호소한다｡"
  },
  {
   "id": 32217,
   "key": "D1305al.txt:31",
   "file": "D1305al.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聲無き聲で訴える。",
   "ko_candidate": "소리 없는 목소리로 호소한다｡"
  },
  {
   "id": 32218,
   "key": "D1305al.txt:33",
   "file": "D1305al.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……無駄だ。",
   "ko_candidate": "……헛수고다｡"
  },
  {
   "id": 32219,
   "key": "D1305al.txt:34",
   "file": "D1305al.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無駄なのだ。",
   "ko_candidate": "헛된 일이다｡"
  },
  {
   "id": 32220,
   "key": "D1305al.txt:36",
   "file": "D1305al.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は汝等の様に強くはなかった。",
   "ko_candidate": "첩은 그대들처럼 강하지 않았다｡"
  },
  {
   "id": 32221,
   "key": "D1305al.txt:37",
   "file": "D1305al.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "汝等の強さに縋り、それを浪費し、磨耗させ、その 一片までも奪い尽くして、この路を進んだのだから。",
   "ko_candidate": "그대들의 강함에 매달려､ 그것을 낭비하고､ 마모시키고､ 그 한 조각까지도 빼앗아 버리며､ 이 길을 걸어왔으니까｡"
  },
  {
   "id": 32222,
   "key": "D1305al.txt:39",
   "file": "D1305al.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蟲が臓腑を貪り腐らせるかの如く。",
   "ko_candidate": "벌레가 내장을 탐하고 썩게 하듯이｡"
  },
  {
   "id": 32223,
   "key": "D1305al.txt:41",
   "file": "D1305al.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、汝等には正しく復讐の権利を有する。",
   "ko_candidate": "다만､ 그대들에게는 분명 복수할 권리가 있다｡"
  },
  {
   "id": 32224,
   "key": "D1305al.txt:42",
   "file": "D1305al.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば、その剣で妾を刺し貫け。",
   "ko_candidate": "그렇다면､ 그 검으로 첩을 꿰뚫어라｡"
  },
  {
   "id": 32225,
   "key": "D1305al.txt:43",
   "file": "D1305al.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは正義だ。",
   "ko_candidate": "그것이 정의다｡"
  },
  {
   "id": 32226,
   "key": "D1305al.txt:45",
   "file": "D1305al.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "汝等を未だ彷徨わせる、この根源を。",
   "ko_candidate": "그대들을 아직도 방황하게 하는､ 이 근원을｡"
  },
  {
   "id": 32227,
   "key": "D1305al.txt:46",
   "file": "D1305al.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾を滅ぼし、解き放たれろ。",
   "ko_candidate": "첩을 멸망시키고､ 해방되어라｡"
  },
  {
   "id": 32228,
   "key": "D1305al.txt:48",
   "file": "D1305al.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "汝等を縛る『死霊秘法』という呪いから。",
   "ko_candidate": "그대들을 묶는 『<RUBY text=\"네크로노미콘\">사령비법</RUBY>』이라는 저주로부터｡"
  },
  {
   "id": 32229,
   "key": "D1305al.txt:49",
   "file": "D1305al.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "汝等の還るべき場所に還る為に。",
   "ko_candidate": "그대들이 돌아가야 할 곳으로 돌아가기 위해｡"
  },
  {
   "id": 32230,
   "key": "D1305al.txt:59",
   "file": "D1305al.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "甲高い音を立てて、剣が地面を転がった。",
   "ko_candidate": "날카로운 소리를 내며､ 검이 땅을 굴러갔다｡"
  },
  {
   "id": 32231,
   "key": "D1305al.txt:60",
   "file": "D1305al.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "骸達はもう居ない。",
   "ko_candidate": "해골들은 이미 없다｡"
  },
  {
   "id": 32232,
   "key": "D1305al.txt:66",
   "file": "D1305al.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうか。",
   "ko_candidate": "그렇군｡"
  },
  {
   "id": 32233,
   "key": "D1305al.txt:67",
   "file": "D1305al.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ついぞ汝等にも見放されたか。",
   "ko_candidate": "마침내 그대들에게도 버림받았나｡"
  },
  {
   "id": 32234,
   "key": "D1305al.txt:69",
   "file": "D1305al.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "滅ぼす価値も、 縛られる意味も元より無かったという訳か。",
   "ko_candidate": "멸망시킬 가치도､ 묶여 있을 의미도 원래 없었다는 말인가｡"
  },
  {
   "id": 32235,
   "key": "D1305al.txt:71",
   "file": "D1305al.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "当然だ。とんだ道化だな、妾は。",
   "ko_candidate": "당연하다｡ 어이없는 광대로구나､ 첩은｡"
  },
  {
   "id": 32236,
   "key": "D1305al.txt:75",
   "file": "D1305al.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故か視界が歪んで曇る。",
   "ko_candidate": "왜인지 시야가 일그러지고 흐려진다｡"
  },
  {
   "id": 32237,
   "key": "D1305al.txt:77",
   "file": "D1305al.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣いていると気付いたのは、嗚咽が咽喉から溢れてからだ。",
   "ko_candidate": "울고 있다는 걸 깨달은 건､ 흐느낌이 목구멍에서 터져 나오고 나서다｡"
  },
  {
   "id": 32238,
   "key": "D1305al.txt:77",
   "file": "D1305al.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣き崩れる傍らで、あの穢れ無き刃は輝いている。",
   "ko_candidate": "울며 무너지는 곁에서､ 저 더럽혀지지 않은 칼날은 빛나고 있다｡"
  },
  {
   "id": 32239,
   "key": "D1305al.txt:78",
   "file": "D1305al.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ一点の曇りも無く、迷いも無い。",
   "ko_candidate": "단 하나의 흐림도 없이､ 망설임도 없이｡"
  },
  {
   "id": 32240,
   "key": "D1305al.txt:81",
   "file": "D1305al.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――妾とは、違う。",
   "ko_candidate": "――첩과는､ 다르다｡"
  },
  {
   "id": 32241,
   "key": "D1305al.txt:93",
   "file": "D1305al.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "夢は夢に相応しく連続性を持たない。",
   "ko_candidate": "꿈은 꿈답게 연속성이 없다｡"
  },
  {
   "id": 32242,
   "key": "D1305al.txt:95",
   "file": "D1305al.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暗く、狭い部屋。",
   "ko_candidate": "어둡고､ 좁은 방｡"
  },
  {
   "id": 32243,
   "key": "D1305al.txt:96",
   "file": "D1305al.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "閉ざされた部屋。",
   "ko_candidate": "닫힌 방｡"
  },
  {
   "id": 32244,
   "key": "D1305al.txt:98",
   "file": "D1305al.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが停滞は無く、穏やかに空気は流れ、闇には血が通っている。",
   "ko_candidate": "하지만 정체는 없고､ 고요히 공기가 흐르며､ 어둠에는 피가 통하고 있다｡"
  },
  {
   "id": 32245,
   "key": "D1305al.txt:99",
   "file": "D1305al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは人の息吹があるからだ。",
   "ko_candidate": "그것은 사람의 숨결이 있기 때문이다｡"
  }
 ]
}