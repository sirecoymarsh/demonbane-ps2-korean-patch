 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ダゴン": "다곤",
  "九郎": "쿠로",
  "デモンベイン": "데몬베인"
 },
 "items": [
  {
   "id": 10638,
   "key": "D0713.txt:1034",
   "file": "D0713.txt",
   "line": 1034,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "動けない今がチャンスだ！ トドメを……！",
   "ko_candidate": "움직일 수 없는 지금이 기회다! 마지막 일격을……!"
  },
  {
   "id": 10639,
   "key": "D0713.txt:1047",
   "file": "D0713.txt",
   "line": 1047,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………っ」",
   "ko_candidate": "「…………읏」"
  },
  {
   "id": 10640,
   "key": "D0713.txt:1058",
   "file": "D0713.txt",
   "line": 1058,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悪寒が走った。何だ……？",
   "ko_candidate": "오싹한 기분이 들었다｡"
  },
  {
   "id": 10641,
   "key": "D0713.txt:1059",
   "file": "D0713.txt",
   "line": 1059,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ダゴンの怒気に中てられたのか？",
   "ko_candidate": "뭐지……? 다곤의 분노에 맞은 건가?"
  },
  {
   "id": 10642,
   "key": "D0713.txt:1062",
   "file": "D0713.txt",
   "line": 1062,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ダゴンは動かない。",
   "ko_candidate": "다곤은 움직이지 않는다｡"
  },
  {
   "id": 10643,
   "key": "D0713.txt:1063",
   "file": "D0713.txt",
   "line": 1063,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "足掻くことも止めて、こっちを睨んでいる。",
   "ko_candidate": "발버둥치는 것도 그만두고､ 이쪽을 노려보고 있다｡"
  },
  {
   "id": 10644,
   "key": "D0713.txt:1066",
   "file": "D0713.txt",
   "line": 1066,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さっきまでとは違う、落ち着き払った様子が不気味だった。",
   "ko_candidate": "아까와는 다른､ 침착해 보이는 모습이 섬뜩했다｡"
  },
  {
   "id": 10645,
   "key": "D0713.txt:1091",
   "file": "D0713.txt",
   "line": 1091,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「く…………っ」",
   "ko_candidate": "「크…………읍」"
  },
  {
   "id": 10646,
   "key": "D0713.txt:1097",
   "file": "D0713.txt",
   "line": 1097,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "焦燥が胸の中で荒れ狂う。",
   "ko_candidate": "초조함이 가슴 속에서 거칠게 날뛴다｡"
  },
  {
   "id": 10647,
   "key": "D0713.txt:1099",
   "file": "D0713.txt",
   "line": 1099,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何だ……この圧しかかってくるようなプレッシャーは？　これが神の放つオーラというものだろうか？",
   "ko_candidate": "뭐지……이렇게 밀려오는 듯한 압박감은? 이게 신이 내뿜는 오라라는 건가?"
  },
  {
   "id": 10648,
   "key": "D0713.txt:1118",
   "file": "D0713.txt",
   "line": 1118,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "哭き叫ぶ空。荒れ狂う海。",
   "ko_candidate": "울부짖는 하늘｡ 거칠게 날뛰는 바다｡"
  },
  {
   "id": 10649,
   "key": "D0713.txt:1119",
   "file": "D0713.txt",
   "line": 1119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "遠くで、腹の底に響くような重い音が轟いている。",
   "ko_candidate": "멀리서､ 배 속까지 울리는 듯한 무거운 소리가 울려 퍼지고 있다｡"
  },
  {
   "id": 10650,
   "key": "D0713.txt:1120",
   "file": "D0713.txt",
   "line": 1120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "遠雷、か。",
   "ko_candidate": "원뢰인가｡"
  },
  {
   "id": 10651,
   "key": "D0713.txt:1137",
   "file": "D0713.txt",
   "line": 1137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "…………………………否。",
   "ko_candidate": "………………………………아니｡"
  },
  {
   "id": 10652,
   "key": "D0713.txt:1140",
   "file": "D0713.txt",
   "line": 1140,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "違う。雷なんかじゃない。",
   "ko_candidate": "다르다｡ 천둥 같은 게 아니야｡"
  },
  {
   "id": 10653,
   "key": "D0713.txt:1141",
   "file": "D0713.txt",
   "line": 1141,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何だか……どんどん大きくなっているぞ？",
   "ko_candidate": "뭔가､ 점점 커지고 있잖아?"
  },
  {
   "id": 10654,
   "key": "D0713.txt:1144",
   "file": "D0713.txt",
   "line": 1144,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これは……！",
   "ko_candidate": "이건……!"
  },
  {
   "id": 10655,
   "key": "D0713.txt:1151",
   "file": "D0713.txt",
   "line": 1151,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――っ！？」",
   "ko_candidate": "「――――읍읍읍!?」"
  },
  {
   "id": 10656,
   "key": "D0713.txt:1165",
   "file": "D0713.txt",
   "line": 1165,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "迫る音は、すぐに島全体を揺るがす大轟音となった。激震する大地。",
   "ko_candidate": "다가오는 소리는 곧 섬 전체를 뒤흔드는 큰 굉음이 되었다｡ 격렬하게 흔들리는 대지｡"
  },
  {
   "id": 10657,
   "key": "D0713.txt:1169",
   "file": "D0713.txt",
   "line": 1169,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "揺れる視界の向こう、ダゴンの背後――何処までも広がる大海。荒れ狂う海の、その水平線の彼方から、何かが押し寄せてくる。",
   "ko_candidate": "흔들리는 시야 너머､ 다곤의 뒤편､ 끝없이 펼쳐진 대해｡ 거칠게 날뛰는 바다의､ 그 수평선에서――무언가가 다가오고 있었다｡"
  },
  {
   "id": 10658,
   "key": "D0713.txt:1175",
   "file": "D0713.txt",
   "line": 1175,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「おいおい……ッ！」",
   "ko_candidate": "「이봐이봐……읏!」"
  },
  {
   "id": 10659,
   "key": "D0713.txt:1182",
   "file": "D0713.txt",
   "line": 1182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "咽喉の奥から何とか絞り出した声は、掠れていた。",
   "ko_candidate": "목구멍 안쪽에서 겨우 짜낸 목소리는 쉬어 있었다｡"
  },
  {
   "id": 10660,
   "key": "D0713.txt:1188",
   "file": "D0713.txt",
   "line": 1188,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「拙いぞ、九郎！」",
   "ko_candidate": "「위험해､ 쿠로!」 말할 필요도 없었다｡"
  },
  {
   "id": 10661,
   "key": "D0713.txt:1212",
   "file": "D0713.txt",
   "line": 1212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "言われるまでもなかった。",
   "ko_candidate": "광활한 바다의――수평선 끝에서 끝까지｡"
  },
  {
   "id": 10662,
   "key": "D0713.txt:1215",
   "file": "D0713.txt",
   "line": 1215,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "広大な海の、水平線の端から端までびっしりと埋め尽くし――洒落にならない規模の大津波が押し寄せていた。",
   "ko_candidate": "빽빽하게､ 가득 메워서｡ ――농담이 아닐 정도의 규모의 대쓰나미가 밀려오고 있었다｡"
  },
  {
   "id": 10663,
   "key": "D0713.txt:1222",
   "file": "D0713.txt",
   "line": 1222,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うわあああああああああああああ――――っ！？」",
   "ko_candidate": "「우와아아아아아아아아아아아아아아아아아아――――읍읍읍!?」"
  },
  {
   "id": 10664,
   "key": "D0713.txt:1229",
   "file": "D0713.txt",
   "line": 1229,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「この嵐―― 彼奴が喚びおったか！」",
   "ko_candidate": "「이 폭풍――그 녀석이 불러들인 건가!」 도망갈 곳은 없었다｡"
  },
  {
   "id": 10665,
   "key": "D0713.txt:1239",
   "file": "D0713.txt",
   "line": 1239,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大津波は海の果てから、この海岸までの距離を一気に駆け抜ける。",
   "ko_candidate": "다곤의 기괴한 눈동자가､ 비웃는､ 듯이 보였다｡ 대쓰나미는 바다 끝에서､ 이 해안까지의 거리를､ 단숨에 달려온다｡"
  },
  {
   "id": 10666,
   "key": "D0713.txt:1242",
   "file": "D0713.txt",
   "line": 1242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインの身長を超える水の壁が、高く高く眼前に聳えた。",
   "ko_candidate": "데몬베인의 키를 넘는 물의 벽이､ 높이 높이､ 눈앞에 솟아올랐다｡"
  },
  {
   "id": 10667,
   "key": "D0713.txt:1273",
   "file": "D0713.txt",
   "line": 1273,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――――――――――――――ッッ！」",
   "ko_candidate": "「――――――――――――――――――――――――――읍읍읍읍!」"
  },
  {
   "id": 10668,
   "key": "D0713.txt:1285",
   "file": "D0713.txt",
   "line": 1285,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "凄まじい衝撃が３６０度あらゆる角度から襲ってきた。怒り猛る龍のような水の奔流。",
   "ko_candidate": "――찰나､ 엄청난 충격이 360도 모든 각도에서､ 나를 덮쳤다｡ 분노에 찬 용과 같은 물의 급류｡"
  },
  {
   "id": 10669,
   "key": "D0713.txt:1288",
   "file": "D0713.txt",
   "line": 1288,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "圧倒的な重量を以って、叩きつけ、引きずり、掻き混ぜ、押し潰す。振り回し、引き裂き、撃ち砕き、爆裂する。",
   "ko_candidate": "압도적인 중량으로､ 내리치고､ 끌어당기고､ 휘저으며､ 짓눌렀다｡ 휘둘러､ 찢어내고､ 부숴버리고､ 폭발한다｡"
  },
  {
   "id": 10670,
   "key": "D0713.txt:1291",
   "file": "D0713.txt",
   "line": 1291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶え間ない容赦ない、ちっぽけな存在を嘲笑う、衝撃と蹂躙。",
   "ko_candidate": "끊임없이 용서 없이､ 보잘것없는 존재를 조롱하는､ 충격의 유린｡"
  },
  {
   "id": 10671,
   "key": "D0713.txt:1306",
   "file": "D0713.txt",
   "line": 1306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――意識が、弾けた。",
   "ko_candidate": "――의식이､ 터져버렸다｡"
  }
 ]
}