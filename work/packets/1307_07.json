  "rate": 0.938
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リューガ": "류가",
  "ハンティング・ホラー": "헌팅 호러",
  "デモンベイン": "데몬베인",
  "大十字": "다이쥬지",
  "姫さん": "공주님",
  "ウィルバー・ウェイトリイ": "윌버 웨이틀리"
 },
 "items": [
  {
   "id": 33297,
   "key": "D1307le.txt:459",
   "file": "D1307le.txt",
   "line": 459,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――」",
   "ko_candidate": "「――――」"
  },
  {
   "id": 33298,
   "key": "D1307le.txt:464",
   "file": "D1307le.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆらりと、躰を僅かに反らす。",
   "ko_candidate": "살짝 몸을 약간 젖힌다｡"
  },
  {
   "id": 33299,
   "key": "D1307le.txt:465",
   "file": "D1307le.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その擦れ擦れを高速で飛来する何かが通り過ぎた。",
   "ko_candidate": "그 스쳐 지나갈 듯한 곳을 고속으로 날아오는 무언가가 지나갔다｡"
  },
  {
   "id": 33300,
   "key": "D1307le.txt:466",
   "file": "D1307le.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガは振り返る。",
   "ko_candidate": "류가는 뒤돌아본다｡"
  },
  {
   "id": 33301,
   "key": "D1307le.txt:467",
   "file": "D1307le.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線の先、鋼鉄の獣は其処に鎮座していた。",
   "ko_candidate": "시선의 끝､ 강철의 짐승은 거기에 자리 잡고 있었다｡"
  },
  {
   "id": 33302,
   "key": "D1307le.txt:474",
   "file": "D1307le.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――ハンティング・ホラー。",
   "ko_candidate": "――헌팅 호러｡"
  },
  {
   "id": 33303,
   "key": "D1307le.txt:479",
   "file": "D1307le.txt",
   "line": 479,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何だ、貴様は？」",
   "ko_candidate": "「… 뭐냐､ 네 놈은?」"
  },
  {
   "id": 33304,
   "key": "D1307le.txt:482",
   "file": "D1307le.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魂無き――無い筈だ――鋼鉄に彼は語りかける。",
   "ko_candidate": "영혼 없는――없을 터다――강철에 그는 말을 건넨다｡"
  },
  {
   "id": 33305,
   "key": "D1307le.txt:484",
   "file": "D1307le.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷たく鋭い視線が、鈍く輝く装甲を貫いた。",
   "ko_candidate": "차갑고 날카로운 시선이 둔하게 빛나는 장갑을 꿰뚫었다｡"
  },
  {
   "id": 33306,
   "key": "D1307le.txt:485",
   "file": "D1307le.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しばらく睨み続け――視線をその後方に向ける。",
   "ko_candidate": "잠시 노려보다가――시선을 그 뒤쪽으로 향한다｡"
  },
  {
   "id": 33307,
   "key": "D1307le.txt:492",
   "file": "D1307le.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見えるのは、呪われたデモンベイン。",
   "ko_candidate": "보이는 것은 저주받은 데몬베인｡"
  },
  {
   "id": 33308,
   "key": "D1307le.txt:493",
   "file": "D1307le.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、その立ちはだかる絶望に、果敢と挑む小さな影。",
   "ko_candidate": "그리고 그 앞을 가로막는 절망에 과감히 도전하는 작은 그림자｡"
  },
  {
   "id": 33309,
   "key": "D1307le.txt:501",
   "file": "D1307le.txt",
   "line": 501,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――変神」",
   "ko_candidate": "「――변신」"
  },
  {
   "id": 33310,
   "key": "D1307le.txt:505",
   "file": "D1307le.txt",
   "line": 505,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那。",
   "ko_candidate": "찰나｡"
  },
  {
   "id": 33311,
   "key": "D1307le.txt:506",
   "file": "D1307le.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憎悪に狂う修羅は闇を纏い、黒き天使と変ずる。",
   "ko_candidate": "증오에 미친 수라는 어둠을 두르고 검은 천사로 변한다｡"
  },
  {
   "id": 33312,
   "key": "D1307le.txt:512",
   "file": "D1307le.txt",
   "line": 512,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良いだろう……貴様の思惑に踊らされてやる。 ちょうど、酷く苛ついていたところだ……」",
   "ko_candidate": "「좋아… 네 놈의 속셈대로 놀아주지｡ 마침 몹시 짜증나 있던 참이었거든…」"
  },
  {
   "id": 33313,
   "key": "D1307ru.txt:10",
   "file": "D1307ru.txt",
   "line": 10,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん？」",
   "ko_candidate": "「……다이쥬지 씨?」"
  },
  {
   "id": 33314,
   "key": "D1307ru.txt:13",
   "file": "D1307ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼びかける声に振り返る。",
   "ko_candidate": "부르는 소리에 뒤돌아본다｡"
  },
  {
   "id": 33315,
   "key": "D1307ru.txt:15",
   "file": "D1307ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんは、呆然と、俺を見上げていた。",
   "ko_candidate": "공주님은 멍하니 나를 올려다보고 있었다｡"
  },
  {
   "id": 33316,
   "key": "D1307ru.txt:16",
   "file": "D1307ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は苦笑を浮かべ、わざと溜め息をついて、言った。",
   "ko_candidate": "나는 쓴웃음을 지으며 일부러 한숨을 쉬고 말했다｡"
  },
  {
   "id": 33317,
   "key": "D1307ru.txt:20",
   "file": "D1307ru.txt",
   "line": 20,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ったく……姫さんは無茶をする」",
   "ko_candidate": "「정말……공주님은 무모한 짓을 하시는군요」"
  },
  {
   "id": 33318,
   "key": "D1307ru.txt:23",
   "file": "D1307ru.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウィルバー・ウェイトリイの屍体から離れ、へたれ込んだままの姫さんに手を差し伸べた。",
   "ko_candidate": "윌버 웨이틀리의 시체에서 떨어져 주저앉은 채로 있는 공주님에게 손을 내밀었다｡"
  },
  {
   "id": 33319,
   "key": "D1307ru.txt:24",
   "file": "D1307ru.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、姫さんは俺の手を取ろうとはせず、おずおずしている。",
   "ko_candidate": "하지만 공주님은 내 손을 잡으려 하지 않고 머뭇거리고 있다｡"
  },
  {
   "id": 33320,
   "key": "D1307ru.txt:28",
   "file": "D1307ru.txt",
   "line": 28,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……わ、わたくし……わたくしは……」",
   "ko_candidate": "「……저､ 저는……저는……」"
  },
  {
   "id": 33321,
   "key": "D1307ru.txt:31",
   "file": "D1307ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "消え入りそうな声。",
   "ko_candidate": "사라질 것 같은 목소리｡"
  },
  {
   "id": 33322,
   "key": "D1307ru.txt:32",
   "file": "D1307ru.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無視して、俺は続けた。",
   "ko_candidate": "무시하고 나는 계속했다｡"
  },
  {
   "id": 33323,
   "key": "D1307ru.txt:36",
   "file": "D1307ru.txt",
   "line": 36,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こんな危険な場所に、ノコノコやって来ちまうんだから」",
   "ko_candidate": "「이런 위험한 곳에 멋도 모르고 와버리다니」"
  },
  {
   "id": 33324,
   "key": "D1307ru.txt:40",
   "file": "D1307ru.txt",
   "line": 40,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だ、だって……！　わたくしは、大十字さんを……あ、あんな……あんな目に遭わせて……だから……だから……っ」",
   "ko_candidate": "「하､ 하지만……! 저는 다이쥬지 씨를……그､ 그런……그런 꼴을 당하게 해서……그래서……그래서……」"
  },
  {
   "id": 33325,
   "key": "D1307ru.txt:43",
   "file": "D1307ru.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの言いたいことは、実はもう気付いている。",
   "ko_candidate": "공주님이 하고 싶은 말은 사실 이미 알아차렸다｡"
  },
  {
   "id": 33326,
   "key": "D1307ru.txt:45",
   "file": "D1307ru.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この夢の世界で、さっき、姫さんの想いが流れ込んできたから。",
   "ko_candidate": "이 꿈의 세계에서 방금 공주님의 마음이 흘러들어왔기 때문에｡"
  },
  {
   "id": 33327,
   "key": "D1307ru.txt:47",
   "file": "D1307ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、黙って姫さんの瞳を見つめ続ける。",
   "ko_candidate": "나는 말없이 공주님의 눈동자를 계속 바라본다｡"
  },
  {
   "id": 33328,
   "key": "D1307ru.txt:48",
   "file": "D1307ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんも、言葉を失って、ただ俺の瞳を見つめ返すしかない。",
   "ko_candidate": "공주님도 말을 잃고 그저 내 눈동자를 바라볼 수밖에 없다｡"
  },
  {
   "id": 33329,
   "key": "D1307ru.txt:50",
   "file": "D1307ru.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの瞳が驚愕に見開かれた。",
   "ko_candidate": "공주님의 눈동자가 경악으로 크게 떠졌다｡"
  },
  {
   "id": 33330,
   "key": "D1307ru.txt:54",
   "file": "D1307ru.txt",
   "line": 54,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さんッッ！」",
   "ko_candidate": "「다이쥬지 씨!!」"
  },
  {
   "id": 33331,
   "key": "D1307ru.txt:58",
   "file": "D1307ru.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その叫びよりも速く、俺は動いた。",
   "ko_candidate": "그 외침보다 빠르게 나는 움직였다｡"
  },
  {
   "id": 33332,
   "key": "D1307ru.txt:59",
   "file": "D1307ru.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手に持った偃月刀は、既に床に突き刺している。",
   "ko_candidate": "손에 든 언월도는 이미 바닥에 꽂혀 있다｡"
  },
  {
   "id": 33333,
   "key": "D1307ru.txt:61",
   "file": "D1307ru.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "急速に天井まで飛び跳ねる影。俺の頭上に落ちてくる。",
   "ko_candidate": "급속히 천장까지 뛰어오르는 그림자｡ 내 머리 위로 떨어져 내린다｡"
  },
  {
   "id": 33334,
   "key": "D1307ru.txt:64",
   "file": "D1307ru.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "半ば銃弾に抉られている上に、真っ二つに裂けている頭。",
   "ko_candidate": "반쯤 총알에 뜯겨나간 데다 두 동강 난 머리｡"
  },
  {
   "id": 33335,
   "key": "D1307ru.txt:66",
   "file": "D1307ru.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膿とも脳漿とも付かない腐汁を撒き散らせて、手に握ったもう一本の偃月刀を、お返しとばかり俺の脳天に振り下ろしてくる。",
   "ko_candidate": "고름인지 뇌장인지 모를 부패액을 흩뿌리며 손에 쥔 또 다른 언월도를 보답이라도 하듯 내 정수리를 향해 내리꽂는다｡"
  },
  {
   "id": 33336,
   "key": "D1307ru.txt:69",
   "file": "D1307ru.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その時にはもう、両手に握った魔銃を構えていた。",
   "ko_candidate": "그때는 이미 양손에 쥔 마총을 겨누고 있었다｡"
  }
 ]
}