 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "ティベリウス": "티베리우스",
  "九郎": "쿠로",
  "大十字": "다이쥬지",
  "レムリア・インパクト": "레무리아 임팩트",
  "姫さん": "공주님",
  "エルザ": "엘자",
  "ダーリン": "달링",
  "ドクター・ウェスト": "닥터 웨스트",
  "ヒラニプラ・システム": "히라니프라 시스템"
 },
 "items": [
  {
   "id": 35776,
   "key": "D1313ru.txt:226",
   "file": "D1313ru.txt",
   "line": 226,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こんなものでは、全然、足りない」",
   "ko_candidate": "「이런 것으로는､ 전혀､ 부족해」"
  },
  {
   "id": 35777,
   "key": "D1313ru.txt:229",
   "file": "D1313ru.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨霊が爆炎となってデモンベインを呑み込んだ。",
   "ko_candidate": "원령이 폭염이 되어 데몬베인을 삼켰다｡"
  },
  {
   "id": 35778,
   "key": "D1313ru.txt:230",
   "file": "D1313ru.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てが闇黒に包まれる。",
   "ko_candidate": "모든 것이 암흑에 휩싸인다｡"
  },
  {
   "id": 35779,
   "key": "D1313ru.txt:237",
   "file": "D1313ru.txt",
   "line": 237,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お――ほほほほほほほほほほほほほほほほほっ！」",
   "ko_candidate": "「오――호호호호호호호호호호호호호호호호!」"
  },
  {
   "id": 35780,
   "key": "D1313ru.txt:240",
   "file": "D1313ru.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝利を確信したティベリウスの、何処か安堵に満ちた、哄笑を聴いた。",
   "ko_candidate": "승리를 확신한 티베리우스의､ 어딘가 안도로 가득 찬､ 폭소를 들었다｡"
  },
  {
   "id": 35781,
   "key": "D1313ru.txt:242",
   "file": "D1313ru.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憐れだな、お前。",
   "ko_candidate": "가련하구나､ 너｡"
  },
  {
   "id": 35782,
   "key": "D1313ru.txt:243",
   "file": "D1313ru.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当に憐れを誘う奴だよ。",
   "ko_candidate": "정말 연민을 자아내는 녀석이야｡"
  },
  {
   "id": 35783,
   "key": "D1313ru.txt:247",
   "file": "D1313ru.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――衝撃が、襲う。",
   "ko_candidate": "――충격이､ 덮친다｡"
  },
  {
   "id": 35784,
   "key": "D1313ru.txt:258",
   "file": "D1313ru.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の只中。",
   "ko_candidate": "폭발의 한가운데｡"
  },
  {
   "id": 35785,
   "key": "D1313ru.txt:259",
   "file": "D1313ru.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今まさに、デモンベインは爆発に苛まれている。",
   "ko_candidate": "지금 바로､ 데몬베인은 폭발에 시달리고 있다｡"
  },
  {
   "id": 35786,
   "key": "D1313ru.txt:261",
   "file": "D1313ru.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憤怒の爆風を叩きつけられ、怨嗟の爆炎に灼かれている。",
   "ko_candidate": "분노의 폭풍을 맞고､ 원한의 폭염에 타고 있다｡"
  },
  {
   "id": 35787,
   "key": "D1313ru.txt:263",
   "file": "D1313ru.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それほどの蹂躙に曝されても――デモンベインは無傷だった。",
   "ko_candidate": "하지만､ 그 정도의 유린을 당해도――데몬베인은 무상했다｡"
  },
  {
   "id": 35788,
   "key": "D1313ru.txt:264",
   "file": "D1313ru.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを護る五芒星形の輝きは、少しも衰えていなかった。",
   "ko_candidate": "데몬베인을 지키는 오망성 형태의 빛은､ 조금도 쇠하지 않았다｡"
  },
  {
   "id": 35789,
   "key": "D1313ru.txt:267",
   "file": "D1313ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この程度か。",
   "ko_candidate": "이 정도인가｡"
  },
  {
   "id": 35790,
   "key": "D1313ru.txt:268",
   "file": "D1313ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "他人を貪って力と永遠を手に入れた、お前の力は、だけどこんな程度か。",
   "ko_candidate": "타인을 탐해 힘과 영원을 손에 넣은､ 너의 힘은､ 하지만 이런 정도인가｡"
  },
  {
   "id": 35791,
   "key": "D1313ru.txt:270",
   "file": "D1313ru.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなくだらない、脆弱な力のために、多くの人間を犠牲にしたのか。",
   "ko_candidate": "이런 시시한､ 취약한 힘을 위해､ 많은 인간을 희생시킨 건가｡"
  },
  {
   "id": 35792,
   "key": "D1313ru.txt:272",
   "file": "D1313ru.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう良いよ。",
   "ko_candidate": "이제 됐어｡"
  },
  {
   "id": 35793,
   "key": "D1313ru.txt:273",
   "file": "D1313ru.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "疲れただろ、お前？",
   "ko_candidate": "지쳤지､ 너?"
  },
  {
   "id": 35794,
   "key": "D1313ru.txt:275",
   "file": "D1313ru.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もう終わりにしてやるよ。",
   "ko_candidate": "이제 끝내줄게｡"
  },
  {
   "id": 35795,
   "key": "D1313ru.txt:276",
   "file": "D1313ru.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺がお前を、否定してやる。",
   "ko_candidate": "내가 너를､ 부정해주지｡"
  },
  {
   "id": 35796,
   "key": "D1313ru.txt:278",
   "file": "D1313ru.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうしてやろう？",
   "ko_candidate": "어떻게 해줄까?"
  },
  {
   "id": 35797,
   "key": "D1313ru.txt:279",
   "file": "D1313ru.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやって、死なないお前を滅ぼしてやろう？",
   "ko_candidate": "어떻게､ 죽지 않는 너를 멸망시켜줄까?"
  },
  {
   "id": 35798,
   "key": "D1313ru.txt:281",
   "file": "D1313ru.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "安心しろ。",
   "ko_candidate": "안심해｡"
  },
  {
   "id": 35799,
   "key": "D1313ru.txt:282",
   "file": "D1313ru.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手段は無限にある。",
   "ko_candidate": "수단은 무한히 있어｡"
  },
  {
   "id": 35800,
   "key": "D1313ru.txt:283",
   "file": "D1313ru.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "喩えば……喩えば、だ。",
   "ko_candidate": "예를 들면… 예를 들면､ 말이다｡"
  },
  {
   "id": 35801,
   "key": "D1313ru.txt:289",
   "file": "D1313ru.txt",
   "line": 289,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「君が、混沌の悪夢の果てに垣間見た、アレが。癒すモノ、壊すモノ、変容るモノ、混沌の端末、星に結びつく戸口、異次元の存在へ達する道――即ち」",
   "ko_candidate": "「네가､ 혼돈의 악몽의 끝에 엿본､ 그것이｡ 치유하는 것､ 부수는 것､ 변화하는 것､ 혼돈의 말단､ 별에 이어지는 문､ 이차원의 존재에 이르는 길―― 즉」"
  },
  {
   "id": 35802,
   "key": "D1313ru.txt:294",
   "file": "D1313ru.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燦々と輝くあの――",
   "ko_candidate": "찬란히 빛나는 저――"
  },
  {
   "id": 35803,
   "key": "D1313ru.txt:301",
   "file": "D1313ru.txt",
   "line": 301,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！」",
   "ko_candidate": "「쿠로!」"
  },
  {
   "id": 35804,
   "key": "D1313ru.txt:305",
   "file": "D1313ru.txt",
   "line": 305,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 35805,
   "key": "D1313ru.txt:309",
   "file": "D1313ru.txt",
   "line": 309,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「またか!?　また意識が此処に無かったぞ！」",
   "ko_candidate": "「또인가!? 또 의식이 여기에 없었다고!」"
  },
  {
   "id": 35806,
   "key": "D1313ru.txt:313",
   "file": "D1313ru.txt",
   "line": 313,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「わ、悪ィ……やっぱ復活したばっかりで混乱してるみたいだ」",
   "ko_candidate": "「미､ 미안… 역시 부활한 지 얼마 안 돼서 혼란스러운 것 같아」"
  },
  {
   "id": 35807,
   "key": "D1313ru.txt:317",
   "file": "D1313ru.txt",
   "line": 317,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「弱音を吐くのは後、奴を片付けてからだ」",
   "ko_candidate": "「약한 소리는 나중에､ 놈을 처리하고 나서다」"
  },
  {
   "id": 35808,
   "key": "D1313ru.txt:321",
   "file": "D1313ru.txt",
   "line": 321,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……だけど、どうやって……」",
   "ko_candidate": "「아아… 하지만､ 어떻게…」"
  },
  {
   "id": 35809,
   "key": "D1313ru.txt:326",
   "file": "D1313ru.txt",
   "line": 326,
   "speaker": "瑠璃（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ナアカルコード暗号化。大十字さん、レムリア・インパクト、いつでも撃てます！」",
   "ko_candidate": "「나아칼 코드 암호화｡ 다이쥬지 씨､ 레무리아 임팩트､ 언제든 쏠 수 있습니다!」"
  },
  {
   "id": 35810,
   "key": "D1313ru.txt:334",
   "file": "D1313ru.txt",
   "line": 334,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「姫さん！　つーことは、今は司令室か！」",
   "ko_candidate": "「공주님! 그럼､ 지금은 사령실이군!」"
  },
  {
   "id": 35811,
   "key": "D1313ru.txt:338",
   "file": "D1313ru.txt",
   "line": 338,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふん……間に合ったようであるな」",
   "ko_candidate": "「후후… 제때 도착한 것 같구나」"
  },
  {
   "id": 35812,
   "key": "D1313ru.txt:342",
   "file": "D1313ru.txt",
   "line": 342,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ダーリン！　ちゃんと言いつけを守ったロボー！ えらい？　エルザえらい？」",
   "ko_candidate": "「달링! 제대로 분부를 지켰로봇! 대단해? 엘자 대단해?」"
  },
  {
   "id": 35813,
   "key": "D1313ru.txt:346",
   "file": "D1313ru.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通信に割り込む、ドクター・ウェストとエルザの声。",
   "ko_candidate": "통신에 끼어드는､ 닥터 웨스트와 엘자의 목소리｡"
  },
  {
   "id": 35814,
   "key": "D1313ru.txt:347",
   "file": "D1313ru.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サブモニターの中で、姫さんは頷いた。",
   "ko_candidate": "서브모니터 안에서､ 공주님은 고개를 끄덕였다｡"
  },
  {
   "id": 35815,
   "key": "D1313ru.txt:351",
   "file": "D1313ru.txt",
   "line": 351,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「色々と被害はありましたが、ヒラニプラ・システムに問題はありません。 思いっきり、やっちゃって下さいまし」",
   "ko_candidate": "「여러모로 피해는 있었지만､ 히라니프라 시스템에는 문제가 없습니다｡ 마음껏､ 해치워 주세요」"
  }
 ]
}