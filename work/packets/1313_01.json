 },
 "items": [
  {
   "id": 35736,
   "key": "D1313ru.txt:112",
   "file": "D1313ru.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの拳を重ねる。",
   "ko_candidate": "데몬베인의 주먹을 겹친다｡"
  },
  {
   "id": 35737,
   "key": "D1313ru.txt:113",
   "file": "D1313ru.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今にも押し寄せる威力を持った怨嗟。",
   "ko_candidate": "지금이라도 밀려올 위력을 지닌 원한｡"
  },
  {
   "id": 35738,
   "key": "D1313ru.txt:114",
   "file": "D1313ru.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが俺は怖れない。怖れる理由が無い。",
   "ko_candidate": "하지만 나는 두렵지 않다｡ 두려워할 이유가 없다｡"
  },
  {
   "id": 35739,
   "key": "D1313ru.txt:118",
   "file": "D1313ru.txt",
   "line": 118,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「てめぇはべらべら喋るなってぇのよ……」",
   "ko_candidate": "「네놈은 지껄이지 말라고…」"
  },
  {
   "id": 35740,
   "key": "D1313ru.txt:123",
   "file": "D1313ru.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳から魔力の光が溢れ出す。",
   "ko_candidate": "주먹에서 마력의 빛이 넘쳐난다｡"
  },
  {
   "id": 35741,
   "key": "D1313ru.txt:124",
   "file": "D1313ru.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両の拳で五芒星形を描く。",
   "ko_candidate": "양 주먹으로 오망성 형태를 그린다｡"
  },
  {
   "id": 35742,
   "key": "D1313ru.txt:125",
   "file": "D1313ru.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳に纏った光が、吹き荒む闇の中に、軌跡を描いた。",
   "ko_candidate": "주먹에 감긴 빛이､ 휘몰아치는 어둠 속에 궤적을 그렸다｡"
  },
  {
   "id": 35743,
   "key": "D1313ru.txt:129",
   "file": "D1313ru.txt",
   "line": 129,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「口が臭えっつっただろうがぁぁぁぁぁ！」",
   "ko_candidate": "「입이 냄새난다고 했잖아아아아아!」"
  },
  {
   "id": 35744,
   "key": "D1313ru.txt:133",
   "file": "D1313ru.txt",
   "line": 133,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『旧き印』！　脅威と敵意を祓い清めよ！」",
   "ko_candidate": "「『엘더 사인』! 위협과 적의를 물리치고 정화하라!」"
  },
  {
   "id": 35745,
   "key": "D1313ru.txt:141",
   "file": "D1313ru.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "五芒星形は、デモンベインの前面に展開。",
   "ko_candidate": "오망성 형태는 데몬베인의 전면에 전개｡"
  },
  {
   "id": 35746,
   "key": "D1313ru.txt:142",
   "file": "D1313ru.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちを護る強固な楯となる！",
   "ko_candidate": "우리를 지키는 견고한 방패가 된다!"
  },
  {
   "id": 35747,
   "key": "D1313ru.txt:145",
   "file": "D1313ru.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "断末魔の絶叫が、爆音となって轟く。",
   "ko_candidate": "단말마의 절규가､ 폭음이 되어 울린다｡"
  },
  {
   "id": 35748,
   "key": "D1313ru.txt:146",
   "file": "D1313ru.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃を叩きつけてくる。",
   "ko_candidate": "충격을 내리꽂는다｡"
  },
  {
   "id": 35749,
   "key": "D1313ru.txt:148",
   "file": "D1313ru.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、防禦陣は揺らがない。",
   "ko_candidate": "하지만､ 방어진은 흔들리지 않는다｡"
  },
  {
   "id": 35750,
   "key": "D1313ru.txt:149",
   "file": "D1313ru.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "微塵たりとも揺らがない。",
   "ko_candidate": "미진도 흔들리지 않는다｡"
  },
  {
   "id": 35751,
   "key": "D1313ru.txt:151",
   "file": "D1313ru.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "押し寄せる死。死。死。死。死。死。死。死。死。死。",
   "ko_candidate": "밀려오는 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡"
  },
  {
   "id": 35752,
   "key": "D1313ru.txt:152",
   "file": "D1313ru.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾風怒濤の凌辱の只中、だがデモンベインだけが熾烈なまでに清浄だ。",
   "ko_candidate": "질풍노도의 능욕의 한가운데､ 하지만 데몬베인만이 치열할 정도로 청정하다｡"
  },
  {
   "id": 35753,
   "key": "D1313ru.txt:156",
   "file": "D1313ru.txt",
   "line": 156,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「グッ……あ、アアああアアアア悪あああアア！」",
   "ko_candidate": "「크윽… 아､ 아아아아아아악!」"
  },
  {
   "id": 35754,
   "key": "D1313ru.txt:159",
   "file": "D1313ru.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの、焦りを窺わせる咆吼が、何処からともなく、この怨霊と蝿に満たされた空間に響き渡った。",
   "ko_candidate": "티베리우스의､ 초조함을 엿볼 수 있는 포효가､ 어디선가､ 이 원령과 파리로 가득 찬 공간에 울려 퍼졌다｡"
  },
  {
   "id": 35755,
   "key": "D1313ru.txt:162",
   "file": "D1313ru.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念が威力を増す。",
   "ko_candidate": "원념이 위력을 더한다｡"
  },
  {
   "id": 35756,
   "key": "D1313ru.txt:163",
   "file": "D1313ru.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瘴気の黒と防禦陣の白が、せめぎ合い、凌ぎ合う。",
   "ko_candidate": "장기의 검은색과 방어진의 흰색이､ 맞부딪치고､ 서로 겨룬다｡"
  },
  {
   "id": 35757,
   "key": "D1313ru.txt:164",
   "file": "D1313ru.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紫電が迸って空間を灼き、霊気が飛沫を散らして空間を濡らす。",
   "ko_candidate": "자줏빛 번개가 치솟아 공간을 태우고､ 영기가 물보라를 흩뿌려 공간을 적신다｡"
  },
  {
   "id": 35758,
   "key": "D1313ru.txt:169",
   "file": "D1313ru.txt",
   "line": 169,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「滅びろ……滅びロ……ホロビロォォォォォォォォォォォ！」",
   "ko_candidate": "「멸망해라… 멸망하라… 호로비로오오오오오오오오오오!」"
  },
  {
   "id": 35759,
   "key": "D1313ru.txt:173",
   "file": "D1313ru.txt",
   "line": 173,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「크윽…!」"
  },
  {
   "id": 35760,
   "key": "D1313ru.txt:176",
   "file": "D1313ru.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念が圧縮される。",
   "ko_candidate": "원념이 압축된다｡"
  },
  {
   "id": 35761,
   "key": "D1313ru.txt:177",
   "file": "D1313ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "防御陣の前で、小さな球体となったソレは、臨界を超えて、内側に向いていたエネルギーを掌を返すように外に向けた。",
   "ko_candidate": "방어진 앞에서､ 작은 구체가 된 그것은､ 임계를 넘어서､ 안쪽을 향하고 있던 에너지를 손바닥을 뒤집듯이 밖으로 향했다｡"
  },
  {
   "id": 35762,
   "key": "D1313ru.txt:179",
   "file": "D1313ru.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪いが爆発する。",
   "ko_candidate": "저주가 폭발한다｡"
  },
  {
   "id": 35763,
   "key": "D1313ru.txt:184",
   "file": "D1313ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念が撒き散らす瘴気は、腐敗の呪詛と化して世界を凌辱した。",
   "ko_candidate": "원념이 뿌리는 장기는､ 부패의 저주가 되어 세계를 능욕했다｡"
  },
  {
   "id": 35764,
   "key": "D1313ru.txt:185",
   "file": "D1313ru.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間を吹き飛ばし、大地を穢し、街を朽ちさせる。",
   "ko_candidate": "공간을 날려버리고､ 대지를 더럽히고､ 거리를 썩게 한다｡"
  },
  {
   "id": 35765,
   "key": "D1313ru.txt:187",
   "file": "D1313ru.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐敗の爆裂の直撃を受けているのは、無論、デモンベインだ。",
   "ko_candidate": "부패의 폭렬의 직격을 받고 있는 것은､ 물론､ 데몬베인이다｡"
  },
  {
   "id": 35766,
   "key": "D1313ru.txt:194",
   "file": "D1313ru.txt",
   "line": 194,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あは……ひぃはははは……うほほほほほほほほほほほほっ！ 腐れ腐れ腐れ腐れ腐れ腐れ爛れろ！　腐って妖蛆の苗床となれ！」 「アタシの糧となれぇぇぇぇぇぇ――――ッ！」",
   "ko_candidate": "「아하… 히히하하하… 우호호호호호호호호호호! 썩어라 썩어라 썩어라 썩어라 썩어라 썩어라 문드러져라! 썩어서 요충의 묘상이 되어라! 내 양식이 되어라아아아아아――――!」"
  },
  {
   "id": 35767,
   "key": "D1313ru.txt:201",
   "file": "D1313ru.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの馬鹿笑いが、断末魔の爆音を割いて、聴こえて来た。",
   "ko_candidate": "티베리우스의 바보 웃음이､ 단말마의 폭음을 가르며､ 들려왔다｡"
  },
  {
   "id": 35768,
   "key": "D1313ru.txt:202",
   "file": "D1313ru.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティベリウス……貴様……っ。",
   "ko_candidate": "티베리우스… 이 자식…"
  },
  {
   "id": 35769,
   "key": "D1313ru.txt:204",
   "file": "D1313ru.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、",
   "ko_candidate": "나는､"
  },
  {
   "id": 35770,
   "key": "D1313ru.txt:205",
   "file": "D1313ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、",
   "ko_candidate": "나는､"
  },
  {
   "id": 35771,
   "key": "D1313ru.txt:206",
   "file": "D1313ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は――この死ねない屍に、憐れみすら抱いていた。",
   "ko_candidate": "나는――이 죽지 못하는 시체에､ 연민마저 품고 있었다｡"
  },
  {
   "id": 35772,
   "key": "D1313ru.txt:208",
   "file": "D1313ru.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瘴気の爆風の中で俺は、呟いた。",
   "ko_candidate": "장기의 폭풍 속에서 나는､ 중얼거렸다｡"
  },
  {
   "id": 35773,
   "key": "D1313ru.txt:218",
   "file": "D1313ru.txt",
   "line": 218,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「足りない」",
   "ko_candidate": "「부족해」"
  },
  {
   "id": 35774,
   "key": "D1313ru.txt:221",
   "file": "D1313ru.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その呟きはティベリウスには届かなかったろう。",
   "ko_candidate": "그 중얼거림은 티베리우스에게는 닿지 않았을 것이다｡"
  },
  {
   "id": 35775,
   "key": "D1313ru.txt:222",
   "file": "D1313ru.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はさらに続けた。",
   "ko_candidate": "나는 더 이어갔다｡"
  }
 ]
}