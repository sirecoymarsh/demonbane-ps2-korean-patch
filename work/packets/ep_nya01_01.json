 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {},
 "items": [
  {
   "id": 49935,
   "key": "ep_nya01.txt:215",
   "file": "ep_nya01.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "みんな揃っていた。",
   "ko_candidate": "「거기」 목을 매달고 있었다｡"
  },
  {
   "id": 49936,
   "key": "ep_nya01.txt:218",
   "file": "ep_nya01.txt",
   "line": 218,
   "speaker": "九郎 / ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「母さんは？」 「そこに」",
   "ko_candidate": "이번 달에 들어 네 번째다｡"
  },
  {
   "id": 49937,
   "key": "ep_nya01.txt:240",
   "file": "ep_nya01.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ぎしりぎしりと、縛り首の立ち木がしなる。 ぶらりぶらりと、母さんが揺れている。",
   "ko_candidate": "삐걱삐걱､ 목매달린 나무가 휘어진다｡"
  },
  {
   "id": 49938,
   "key": "ep_nya01.txt:246",
   "file": "ep_nya01.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今月に入って、四度目だった。",
   "ko_candidate": "흔들흔들､ 엄마가 흔들리고 있다｡"
  },
  {
   "id": 49939,
   "key": "ep_nya01.txt:249",
   "file": "ep_nya01.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "母さんの足下で赤黒い塊が蠢いていた。",
   "ko_candidate": "엄마의 발밑에서 붉은 덩어리가 꿈틀거리고 있었다｡"
  },
  {
   "id": 49940,
   "key": "ep_nya01.txt:250",
   "file": "ep_nya01.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "不完全だった。",
   "ko_candidate": "불완전했다｡"
  },
  {
   "id": 49941,
   "key": "ep_nya01.txt:260",
   "file": "ep_nya01.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はそれを拾い上げ、４つの皿に均等に分けて、美味しくいただいた。",
   "ko_candidate": "나는 그것을 주워 들어 4개의 접시에 균등하게 나누어 맛있게 먹었다｡"
  },
  {
   "id": 49942,
   "key": "ep_nya01.txt:260",
   "file": "ep_nya01.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "よく煮込んだ重油のような味がした。",
   "ko_candidate": "잘 끓인 중유 같은 맛이 났다｡"
  },
  {
   "id": 49943,
   "key": "ep_nya01.txt:264",
   "file": "ep_nya01.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――俺は本を捜しに行かなければならない。",
   "ko_candidate": "――나는 책을 찾으러 가야 한다｡"
  },
  {
   "id": 49944,
   "key": "ep_nya01.txt:274",
   "file": "ep_nya01.txt",
   "line": 274,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いってきます」",
   "ko_candidate": "「다녀오겠습니다」"
  },
  {
   "id": 49945,
   "key": "ep_nya01.txt:281",
   "file": "ep_nya01.txt",
   "line": 281,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いってらっしゃい」",
   "ko_candidate": "「다녀오세요」 「다녀오세요」"
  },
  {
   "id": 49946,
   "key": "ep_nya01.txt:288",
   "file": "ep_nya01.txt",
   "line": 288,
   "speaker": "マスターテリオン / ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いってらっしゃい」 「お兄ちゃん、忘れ物。 はい、おべんとう」",
   "ko_candidate": "「오빠､ 깜빡한 거｡ 자､ 도시락」"
  },
  {
   "id": 49947,
   "key": "ep_nya01.txt:302",
   "file": "ep_nya01.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "妹から鳥かごを受け取って、俺は家を出た。",
   "ko_candidate": "여동생에게서 새장을 받아들고 나는 집을 나섰다｡"
  },
  {
   "id": 49948,
   "key": "ep_nya01.txt:313",
   "file": "ep_nya01.txt",
   "line": 313,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "げろげろ。げろげろ。",
   "ko_candidate": "개굴개굴｡ 개굴개굴｡"
  },
  {
   "id": 49949,
   "key": "ep_nya01.txt:315",
   "file": "ep_nya01.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "親子連れのカエル面の半魚人で賑わう街。",
   "ko_candidate": "개구리 얼굴의 반어인 부자가 북적이는 거리｡"
  },
  {
   "id": 49950,
   "key": "ep_nya01.txt:316",
   "file": "ep_nya01.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "露店では、渦巻きの頭を持った昆虫の香具師が、大声で客を呼び込んでいた。",
   "ko_candidate": "노점에서는 소용돌이 모양의 머리를 가진 곤충 행상인이 큰 소리로 손님을 불러들이고 있었다｡"
  },
  {
   "id": 49951,
   "key": "ep_nya01.txt:318",
   "file": "ep_nya01.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼は菌類だった。",
   "ko_candidate": "그는 균류였다｡"
  },
  {
   "id": 49952,
   "key": "ep_nya01.txt:323",
   "file": "ep_nya01.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "香具師が俺を呼び止めた。",
   "ko_candidate": "행상인이 나를 불러세웠다｡"
  },
  {
   "id": 49953,
   "key": "ep_nya01.txt:324",
   "file": "ep_nya01.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は露店を覗き込んだ。",
   "ko_candidate": "나는 노점을 들여다보았다｡"
  },
  {
   "id": 49954,
   "key": "ep_nya01.txt:325",
   "file": "ep_nya01.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "脳味噌が売られていた。",
   "ko_candidate": "뇌수가 팔리고 있었다｡"
  },
  {
   "id": 49955,
   "key": "ep_nya01.txt:329",
   "file": "ep_nya01.txt",
   "line": 329,
   "speaker": "ミ＝ゴの香具師",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あなたの脳味噌です」",
   "ko_candidate": "「당신의 뇌수입니다」"
  },
  {
   "id": 49956,
   "key": "ep_nya01.txt:334",
   "file": "ep_nya01.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "香具師は言った。",
   "ko_candidate": "행상인이 말했다｡"
  },
  {
   "id": 49957,
   "key": "ep_nya01.txt:338",
   "file": "ep_nya01.txt",
   "line": 338,
   "speaker": "ミ＝ゴの香具師",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「この中にあなたの宇宙が納まっているのです。だがあなたと云う存在は、この脳味噌から溢れ出てしまった」",
   "ko_candidate": "「이 안에 당신의 우주가 담겨 있습니다｡ 하지만 당신이라는 존재는 이 뇌수에서 넘쳐흘러버렸습니다」"
  },
  {
   "id": 49958,
   "key": "ep_nya01.txt:341",
   "file": "ep_nya01.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "漏れ出した個。",
   "ko_candidate": "새어나온 개｡"
  },
  {
   "id": 49959,
   "key": "ep_nya01.txt:342",
   "file": "ep_nya01.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "全に溶け込む個。",
   "ko_candidate": "전체에 녹아드는 개｡"
  },
  {
   "id": 49960,
   "key": "ep_nya01.txt:343",
   "file": "ep_nya01.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "個にして全。だが全は個に非ず。",
   "ko_candidate": "개이면서 전체｡ 하지만 전체는 개가 아니다｡"
  },
  {
   "id": 49961,
   "key": "ep_nya01.txt:344",
   "file": "ep_nya01.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "断絶された個を失った個。",
   "ko_candidate": "단절된 개를 잃어버린 개｡"
  },
  {
   "id": 49962,
   "key": "ep_nya01.txt:345",
   "file": "ep_nya01.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "生贄。",
   "ko_candidate": "제물｡"
  },
  {
   "id": 49963,
   "key": "ep_nya01.txt:349",
   "file": "ep_nya01.txt",
   "line": 349,
   "speaker": "ミ＝ゴの香具師",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ロード＝アイランド病院から持ち出した脳味噌もあります」",
   "ko_candidate": "「로드아일랜드 병원에서 가져온 뇌는 있습니다」"
  },
  {
   "id": 49964,
   "key": "ep_nya01.txt:352",
   "file": "ep_nya01.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "香具師はもう一つの脳味噌を取り出した。",
   "ko_candidate": "행상인은 또 다른 뇌수를 꺼냈다｡"
  },
  {
   "id": 49965,
   "key": "ep_nya01.txt:353",
   "file": "ep_nya01.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "薄灰色のプリンのようなソレが、ぷるぷる震えていた。",
   "ko_candidate": "연회색 푸딩 같은 그것이 부들부들 떨고 있었다｡"
  },
  {
   "id": 49966,
   "key": "ep_nya01.txt:365",
   "file": "ep_nya01.txt",
   "line": 365,
   "speaker": "ミ＝ゴの香具師",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「モルヒネと一緒に如何ですか？」",
   "ko_candidate": "「모르핀과 함께 어떠세요?」"
  },
  {
   "id": 49967,
   "key": "ep_nya01.txt:378",
   "file": "ep_nya01.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "学校に行かなければ、遅刻してしまう。",
   "ko_candidate": "학교에 가지 않으면 지각해버린다｡"
  },
  {
   "id": 49968,
   "key": "ep_nya01.txt:379",
   "file": "ep_nya01.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は汽車に乗った。",
   "ko_candidate": "나는 기차에 탔다｡"
  },
  {
   "id": 49969,
   "key": "ep_nya01.txt:380",
   "file": "ep_nya01.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "危うく乗り遅れるところだった。",
   "ko_candidate": "하마터면 놓칠 뻔했다｡ 달리는 기차｡"
  },
  {
   "id": 49970,
   "key": "ep_nya01.txt:386",
   "file": "ep_nya01.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "走る汽車。 窓の外には穏やかな焼け野の光景が広がっている。",
   "ko_candidate": "창밖으로는 평온한 <RUBY text=\"솔라스티드 히스2\">야케노</RUBY>의 광경이 펼쳐져 있다｡"
  },
  {
   "id": 49971,
   "key": "ep_nya01.txt:388",
   "file": "ep_nya01.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "緑色の雪が降っていた。",
   "ko_candidate": "초록색 눈이 내리고 있었다｡"
  },
  {
   "id": 49972,
   "key": "ep_nya01.txt:389",
   "file": "ep_nya01.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どろどろと、大地が溶けてゆく。",
   "ko_candidate": "질척질척､ 대지가 녹아내린다｡"
  },
  {
   "id": 49973,
   "key": "ep_nya01.txt:391",
   "file": "ep_nya01.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大地を失い、線路は捻じ曲がり、汽車は地の底へ下る。",
   "ko_candidate": "대지를 잃고 선로는 뒤틀리며 기차는 땅속으로 내려간다｡"
  },
  {
   "id": 49974,
   "key": "ep_nya01.txt:392",
   "file": "ep_nya01.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇黒と深淵。",
   "ko_candidate": "암흑과 심연｡"
  }
 ]
}