  {
   "id": 17370,
   "key": "D0820le.txt:25",
   "file": "D0820le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、ライカさんは……。",
   "ko_candidate": "하지만､ 라이카 씨는……"
