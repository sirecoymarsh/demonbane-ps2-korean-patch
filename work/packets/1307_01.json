   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスは、いつの間にか表に出ていた。",
   "ko_candidate": "티베리우스는 어느새 밖으로 나와 있었다｡"
  },
  {
   "id": 33058,
   "key": "D1307al.txt:121",
   "file": "D1307al.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベルゼビュートの頭頂部、磔にされた姫さんのすぐ側に寄っている。",
   "ko_candidate": "벨제뷰트의 정수리､ 십자가에 매달린 공주님 바로 옆에 다가가 있다｡"
  },
  {
   "id": 33059,
   "key": "D1307al.txt:123",
   "file": "D1307al.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "節くれ立った枯れ木のような指が、 姫さんの頬を撫でた。",
   "ko_candidate": "마디가 튀어나온 마른 나무 같은 손가락이 공주님의 뺨을 쓰다듬었다｡"
  },
  {
   "id": 33060,
   "key": "D1307al.txt:128",
   "file": "D1307al.txt",
   "line": 128,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ひぃ……っ！」",
   "ko_candidate": "「히이…!」"
  },
  {
   "id": 33061,
   "key": "D1307al.txt:132",
   "file": "D1307al.txt",
   "line": 132,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てめえ！」",
   "ko_candidate": "「이 자식!」"
  },
  {
   "id": 33062,
   "key": "D1307al.txt:137",
   "file": "D1307al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハッチを開き、外に伸びたステップを伝って、コクピットから身を乗り出す。",
   "ko_candidate": "해치를 열고 밖으로 뻗은 계단을 타고 콕핏에서 몸을 내밀었다｡"
  },
  {
   "id": 33063,
   "key": "D1307al.txt:137",
   "file": "D1307al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２挺の拳銃をティベリウスに向けた。",
   "ko_candidate": "두 자루의 권총을 티베리우스에게 겨눴다｡"
  },
  {
   "id": 33064,
   "key": "D1307al.txt:141",
   "file": "D1307al.txt",
   "line": 141,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しゃらくさいっ！」",
   "ko_candidate": "「귀찮군!」"
  },
  {
   "id": 33065,
   "key": "D1307al.txt:146",
   "file": "D1307al.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの腹から、臓腑の触手が伸びる。",
   "ko_candidate": "티베리우스의 배에서 내장의 촉수가 뻗어 나온다｡"
  },
  {
   "id": 33066,
   "key": "D1307al.txt:156",
   "file": "D1307al.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "触手は四肢を刺し貫き、俺の身動きを封じる。",
   "ko_candidate": "촉수는 내 어깨를 꿰뚫었다｡ 더 2개､ 3개､ 4개､ 5개｡"
  },
  {
   "id": 33067,
   "key": "D1307al.txt:161",
   "file": "D1307al.txt",
   "line": 161,
   "speaker": "九郎 / 瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐがああああああっ！　ああああああああっ！」 「大十字さんっ！」",
   "ko_candidate": "사지를 꿰뚫리고 나는 핀셋으로 꿰매진 곤충 표본 같은 모습이 된다｡"
  },
  {
   "id": 33068,
   "key": "D1307al.txt:170",
   "file": "D1307al.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんが悲鳴を上げる。",
   "ko_candidate": "상처에서 엄청난 피가 흘러나왔다｡"
  },
  {
   "id": 33069,
   "key": "D1307al.txt:171",
   "file": "D1307al.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティベリウスの視線が、そちらに向いた。",
   "ko_candidate": "「으가아아아아아! 아아아아아아!」 「다이쥬지 씨!」"
  },
  {
   "id": 33070,
   "key": "D1307al.txt:172",
   "file": "D1307al.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ヒィッと、小さく息を呑む姫さん。",
   "ko_candidate": "공주님이 비명을 지른다｡"
  },
  {
   "id": 33071,
   "key": "D1307al.txt:173",
   "file": "D1307al.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の下で、ティベリウスは舌なめずりする。",
   "ko_candidate": "티베리우스의 시선이 그쪽으로 향했다｡"
  },
  {
   "id": 33072,
   "key": "D1307al.txt:178",
   "file": "D1307al.txt",
   "line": 178,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さて……九郎ちゃんはそこで大人しくしているのよん？」",
   "ko_candidate": "히잇 하고 작게 숨을 삼키는 공주님｡ 가면 아래에서 티베리우스는 혀를 핥는다｡"
  },
  {
   "id": 33073,
   "key": "D1307al.txt:187",
   "file": "D1307al.txt",
   "line": 187,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ッッ！　いやあああああ！ いやぁぁぁぁぁ！」 「て、てめえはァァァァァァ！」",
   "ko_candidate": "「자… 쿠로 군은 거기서 얌전히 있어야 해? 이제부터 너를 위해 공개 레이프 쇼를 공개할 거니까앙!」"
  },
  {
   "id": 33074,
   "key": "D1307al.txt:198",
   "file": "D1307al.txt",
   "line": 198,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうよ！　そうそう、その顔よ 九郎ちゃん！」",
   "ko_candidate": "「!? 싫어어어어어! 싫어어어어어!」 「이､ 이 자식아아아아아아!」"
  },
  {
   "id": 33075,
   "key": "D1307al.txt:202",
   "file": "D1307al.txt",
   "line": 202,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アンタのそんな顔が見たくて、わざわざ、『おあずけ』してたんだからぁ！」 「もっともっと 悔しがってぇぇん！」",
   "ko_candidate": "「그래! 그래그래､ 그 표정이야 쿠로 군! 너의 그런 표정이 보고 싶어서 일부러 '참았던' 거라고앙! 더 더 분해해엥!」"
  },
  {
   "id": 33076,
   "key": "D1307al.txt:210",
   "file": "D1307al.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティベリウスの手が、 姫さんの服の胸元を乱暴に掴んだ。",
   "ko_candidate": "티베리우스의 손이 공주님의 옷 가슴팍을 난폭하게 움켜쥐었다｡"
  },
  {
   "id": 33077,
   "key": "D1307al.txt:213",
   "file": "D1307al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "野郎……ッ！　そう何度も好き勝手させると思うなっ！",
   "ko_candidate": "이 자식…! 그렇게 계속 마음대로 할 수 있을 거라고 생각하지 마!"
  },
  {
   "id": 33078,
   "key": "D1307al.txt:216",
   "file": "D1307al.txt",
   "line": 216,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬぬ……ぬおあああああ！」",
   "ko_candidate": "「으으… 으오오오오오!」"
  },
  {
   "id": 33079,
   "key": "D1307al.txt:221",
   "file": "D1307al.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渾身の力を込めて身体を動かす。",
   "ko_candidate": "온 힘을 다해 몸을 움직인다｡"
  },
  {
   "id": 33080,
   "key": "D1307al.txt:222",
   "file": "D1307al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "四肢を貫かれたままだが、 それでも辛うじて手首が動く。",
   "ko_candidate": "사지를 꿰뚫린 채지만 그래도 간신히 손목은 움직인다｡"
  },
  {
   "id": 33081,
   "key": "D1307al.txt:224",
   "file": "D1307al.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これなら……！",
   "ko_candidate": "이 정도면…!"
  },
  {
   "id": 33082,
   "key": "D1307al.txt:226",
   "file": "D1307al.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は手首を捻って角度を調整する。",
   "ko_candidate": "나는 손목을 비틀어 각도를 조정한다｡"
  },
  {
   "id": 33083,
   "key": "D1307al.txt:227",
   "file": "D1307al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無茶な持ち方だが……背に腹は代えられない。",
   "ko_candidate": "무리한 자세지만… 배보다 배꼽이 더 크다｡"
  },
  {
   "id": 33084,
   "key": "D1307al.txt:228",
   "file": "D1307al.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は迷わず手にしたクトゥグアの引鉄を引いた――！",
   "ko_candidate": "나는 주저 없이 손에 쥔 크투가의 방아쇠를 당겼다――!"
  },
  {
   "id": 33085,
   "key": "D1307al.txt:233",
   "file": "D1307al.txt",
   "line": 233,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……！」",
   "ko_candidate": "「뭐…!」"
  },
  {
   "id": 33086,
   "key": "D1307al.txt:243",
   "file": "D1307al.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "５０口径の弾丸が左腕を刺し貫く触手を粉微塵に粉砕する。",
   "ko_candidate": "50구경의 탄환이 왼팔을 꿰뚫은 촉수를 산산조각 냈다｡"
  },
  {
   "id": 33087,
   "key": "D1307al.txt:243",
   "file": "D1307al.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔にかかった肉片の腐臭が鼻を突いた。",
   "ko_candidate": "얼굴에 튄 살점의 부패 냄새가 코를 찔렀다｡"
  },
  {
   "id": 33088,
   "key": "D1307al.txt:246",
   "file": "D1307al.txt",
   "line": 246,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「く……ッ！　はぁ……はぁ……ッ！」",
   "ko_candidate": "「크…! 하아… 하아…!」"
  },
  {
   "id": 33089,
   "key": "D1307al.txt:248",
   "file": "D1307al.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヤバイくらいに右手の感覚が無い。",
   "ko_candidate": "위험할 정도로 오른손의 감각이 없다｡"
  },
  {
   "id": 33090,
   "key": "D1307al.txt:249",
   "file": "D1307al.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無茶な構えでクトゥグアほどの大威力の拳銃を撃ったせいだ。",
   "ko_candidate": "무리한 자세로 크투가 같은 대위력의 권총을 쏜 탓이다｡"
  },
  {
   "id": 33091,
   "key": "D1307al.txt:251",
   "file": "D1307al.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "きっと見るも無惨な状態になっていることだろうが、怖いので見ないでおく。",
   "ko_candidate": "분명 보기에도 처참한 상태가 되었겠지만､ 무서워서 보지 않기로 한다｡"
  },
  {
   "id": 33092,
   "key": "D1307al.txt:259",
   "file": "D1307al.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自由になった左手でイタクァを撃った。",
   "ko_candidate": "자유로워진 왼손으로 이타콰를 쏘았다｡"
  },
  {
   "id": 33093,
   "key": "D1307al.txt:260",
   "file": "D1307al.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反動を堪えて、一気に連射する。",
   "ko_candidate": "반동을 견디며 일제히 연사한다｡"
  },
  {
   "id": 33094,
   "key": "D1307al.txt:265",
   "file": "D1307al.txt",
   "line": 265,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぶあああああああああッ！」",
   "ko_candidate": "「그부아아아아아아아아!」"
  },
  {
   "id": 33095,
   "key": "D1307al.txt:268",
   "file": "D1307al.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３発は外れ、１発は腹に、そして２発が顔面に。",
   "ko_candidate": "3발은 빗나가고 1발은 배에､ 그리고 2발이 얼굴에｡"
  },
  {
   "id": 33096,
   "key": "D1307al.txt:269",
   "file": "D1307al.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面に亀裂が生じた。",
   "ko_candidate": "가면에 균열이 생겼다｡"
  }
 ]
