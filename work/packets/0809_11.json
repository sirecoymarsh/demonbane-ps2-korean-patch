 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "カリグラ": "칼리굴라",
  "クラウディウス": "클라우디우스",
  "アル": "알",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 14782,
   "key": "D0809al.txt:1940",
   "file": "D0809al.txt",
   "line": 1940,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反動が腕を突き抜けていく。",
   "ko_candidate": "반동이 팔을 관통한다｡"
  },
  {
   "id": 14783,
   "key": "D0809al.txt:1945",
   "file": "D0809al.txt",
   "line": 1945,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヴガるぶアアアアアアアアぁぁぁぁぁ!?」",
   "ko_candidate": "「브가르부아아아아아아아아아아 아아!?」 칼리굴라의 절규가 울려 퍼졌다｡"
  },
  {
   "id": 14784,
   "key": "D0809al.txt:1949",
   "file": "D0809al.txt",
   "line": 1949,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "カリグラの絶叫が響いた。",
   "ko_candidate": "섬광에 타버린 눈이 서서히 기능을 되찾는다｡"
  },
  {
   "id": 14785,
   "key": "D0809al.txt:1950",
   "file": "D0809al.txt",
   "line": 1950,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光に灼かれた目が徐々に機能を取り戻す。",
   "ko_candidate": "칼리굴라는 침을 흘리며 거품을 물고 몸부림치고 있었다｡"
  },
  {
   "id": 14786,
   "key": "D0809al.txt:1958",
   "file": "D0809al.txt",
   "line": 1958,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "カリグラは涎を撒き散らし、泡を吹きながら、もがき苦しんでいた。",
   "ko_candidate": "왼쪽 어깨에서 폭포처럼 쏟아지는 선혈｡ 아니――왼쪽 어깨는 존재하지 않는다｡"
  },
  {
   "id": 14787,
   "key": "D0809al.txt:1960",
   "file": "D0809al.txt",
   "line": 1960,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "兇暴な破壊力は魔術防禦も筋肉の鎧を易々と突破し、カリグラの腕を根元から吹き飛ばしていた。",
   "ko_candidate": "그리고 그 앞에 있어야 할 팔도｡ 흉포한 파괴력은 마술 방어도 근육의 갑옷도 쉽게 뚫고 칼리굴라의 팔을 뿌리째 날려버린 것이다｡"
  },
  {
   "id": 14788,
   "key": "D0809al.txt:1973",
   "file": "D0809al.txt",
   "line": 1973,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な……な……っ」 一方、クラウディウスは、あいにくと無傷だった。",
   "ko_candidate": "멀리 너덜너덜해진 왼팔이 굴러다니고 있다｡"
  },
  {
   "id": 14789,
   "key": "D0809al.txt:1977",
   "file": "D0809al.txt",
   "line": 1977,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラウディウスの眉間を貫く直前で、ソレは停止していた。",
   "ko_candidate": "「뭐… 뭐…」 한편 클라우디우스는 아쉽게도 무사했다｡"
  },
  {
   "id": 14790,
   "key": "D0809al.txt:1979",
   "file": "D0809al.txt",
   "line": 1979,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の結界に受け止められた、ソレは銃弾だ。",
   "ko_candidate": "클라우디우스의 미간을 관통하기 직전에 그것은 멈춰 있었다｡"
  },
  {
   "id": 14791,
   "key": "D0809al.txt:1980",
   "file": "D0809al.txt",
   "line": 1980,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今もなおクラウディウスを仕留めようと、高速で回転し、風の結界とせめぎ合っている。",
   "ko_candidate": "바람의 결계에 막힌 그것은 총알이다｡ 지금도 여전히 클라우디우스를 처치하려고 고속으로 회전하며 바람의 결계와 맞서고 있다｡"
  },
  {
   "id": 14792,
   "key": "D0809al.txt:1982",
   "file": "D0809al.txt",
   "line": 1982,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸の先端が、ほんの少しだけ眉間に触れてる。",
   "ko_candidate": "총알의 끝이 아주 조금 미간에 닿아있다｡"
  },
  {
   "id": 14793,
   "key": "D0809al.txt:1983",
   "file": "D0809al.txt",
   "line": 1983,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一滴の血が滴り、クラウディウスの、恐怖に凍りついた顔を伝った。",
   "ko_candidate": "한 방울의 피가 떨어져 클라우디우스의 공포에 얼어붙은 얼굴을 타고 흘렀다｡"
  },
  {
   "id": 14794,
   "key": "D0809al.txt:1987",
   "file": "D0809al.txt",
   "line": 1987,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な、何だよ……ッ！　何だよ、今の弾道は……!?」",
   "ko_candidate": "떨리는 목소리로 외친다｡ 「뭐､ 뭐야…! 뭐야､ 방금 그 탄도는…!?」"
  },
  {
   "id": 14795,
   "key": "D0809al.txt:1990",
   "file": "D0809al.txt",
   "line": 1990,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてアルも――",
   "ko_candidate": "그리고 알도――"
  },
  {
   "id": 14796,
   "key": "D0809al.txt:1996",
   "file": "D0809al.txt",
   "line": 1996,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それは……その『銃』は一体……ッ？」",
   "ko_candidate": "「그건… 그 『총』은 대체…?」"
  },
  {
   "id": 14797,
   "key": "D0809al.txt:2000",
   "file": "D0809al.txt",
   "line": 2000,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 14798,
   "key": "D0809al.txt:2002",
   "file": "D0809al.txt",
   "line": 2002,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もまた、呆然と自分の手の中に納まったソレを――二挺の拳銃を見た。",
   "ko_candidate": "나 또한 멍하니 내 손 안에 들어온 그것을――두 자루의 권총을 보았다｡"
  },
  {
   "id": 14799,
   "key": "D0809al.txt:2007",
   "file": "D0809al.txt",
   "line": 2007,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒と紅を基調とした、兇暴なフォルムの自動式拳銃。",
   "ko_candidate": "검정과 붉은색을 기조로 한 흉포한 형태의 자동식 권총｡"
  },
  {
   "id": 14800,
   "key": "D0809al.txt:2012",
   "file": "D0809al.txt",
   "line": 2012,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銀一色で造られた、流麗なフォルムの回転式拳銃。",
   "ko_candidate": "은색 일색으로 만들어진 유려한 형태의 회전식 권총｡"
  },
  {
   "id": 14801,
   "key": "D0809al.txt:2019",
   "file": "D0809al.txt",
   "line": 2019,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「呪法兵装！　しかも、極めて強力な――！」",
   "ko_candidate": "「주법 병장! 그것도 극히 강력한――!」"
  },
  {
   "id": 14802,
   "key": "D0809al.txt:2023",
   "file": "D0809al.txt",
   "line": 2023,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの砕け散った少女が、この銃に……？",
   "ko_candidate": "그 부서져 흩어진 소녀가 이 총에…?"
  },
  {
   "id": 14803,
   "key": "D0809al.txt:2033",
   "file": "D0809al.txt",
   "line": 2033,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何で『暴君』の魔銃が お前にッッ!?」",
   "ko_candidate": "「왜 『폭군』의 마총이 네게!?」"
  },
  {
   "id": 14804,
   "key": "D0809al.txt:2042",
   "file": "D0809al.txt",
   "line": 2042,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぶるグアガがガがガッ！　オ、オデの腕！　オデの腕ェェェェェェ！」",
   "ko_candidate": "「부르구아가가가갓! 오､ 오데 팔! 오데 팔에에에에에에!」"
  },
  {
   "id": 14805,
   "key": "D0809al.txt:2049",
   "file": "D0809al.txt",
   "line": 2049,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……っ!? お、おい、カリグラ！」",
   "ko_candidate": "「…앗!? 어､ 어이､ 칼리굴라!」"
  },
  {
   "id": 14806,
   "key": "D0809al.txt:2056",
   "file": "D0809al.txt",
   "line": 2056,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "叫ぶクラウディウスの横で、カリグラが暴れだした。",
   "ko_candidate": "외치는 클라우디우스 옆에서 칼리굴라가 날뛰기 시작했다｡"
  },
  {
   "id": 14807,
   "key": "D0809al.txt:2057",
   "file": "D0809al.txt",
   "line": 2057,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怒りに任せ、無差別に拳を振るう。",
   "ko_candidate": "분노에 맡겨 무차별적으로 주먹을 휘두른다｡"
  },
  {
   "id": 14808,
   "key": "D0809al.txt:2066",
   "file": "D0809al.txt",
   "line": 2066,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆砕拳に撃たれ、屋上の至る場所が吹き飛ぶ。",
   "ko_candidate": "폭쇄권에 맞아 옥상 곳곳이 날아간다｡"
  },
  {
   "id": 14809,
   "key": "D0809al.txt:2080",
   "file": "D0809al.txt",
   "line": 2080,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なっ……ヤバっ！」",
   "ko_candidate": "「뭐…엇… 위험해!」"
  },
  {
   "id": 14810,
   "key": "D0809al.txt:2085",
   "file": "D0809al.txt",
   "line": 2085,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわああああ!?　ちぃぃぃぃ！　落ち着け、脳筋バカッ！」",
   "ko_candidate": "「우와아아아아!? 치이이이이! 진정해､ 근육바보!」"
  },
  {
   "id": 14811,
   "key": "D0809al.txt:2091",
   "file": "D0809al.txt",
   "line": 2091,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「痛ェ！　痛え痛え痛え痛えェェェェ！　コロコロ殺コロ殺ブチブチブチブチ殺ォォォッ！」",
   "ko_candidate": "「아파! 아파 아파 아파에에에에! 죽여 죽여 부숴 죽여오오오오!」"
  },
  {
   "id": 14812,
   "key": "D0809al.txt:2097",
   "file": "D0809al.txt",
   "line": 2097,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シット！　理性を失ってやがるッ！」",
   "ko_candidate": "「우라질! 이성을 잃었어!」"
  },
  {
   "id": 14813,
   "key": "D0809al.txt:2101",
   "file": "D0809al.txt",
   "line": 2101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "毒つきながらクラウディウスは、無差別爆撃をかわすのに必死だった。",
   "ko_candidate": "욕설을 내뱉으며 클라우디우스는 무차별 폭격을 피하는 데 필사적이었다｡"
  },
  {
   "id": 14814,
   "key": "D0809al.txt:2106",
   "file": "D0809al.txt",
   "line": 2106,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――九郎！」",
   "ko_candidate": "「――쿠로!」"
  },
  {
   "id": 14815,
   "key": "D0809al.txt:2111",
   "file": "D0809al.txt",
   "line": 2111,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅぅぅぅ――！」",
   "ko_candidate": "「크으으으으――!」"
  },
  {
   "id": 14816,
   "key": "D0809al.txt:2119",
   "file": "D0809al.txt",
   "line": 2119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆撃はこっちにも飛んできた。",
   "ko_candidate": "폭격은 이쪽에도 날아왔다｡"
  },
  {
   "id": 14817,
   "key": "D0809al.txt:2120",
   "file": "D0809al.txt",
   "line": 2120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "激痛に悲鳴を上げる身体に鞭打って、その場所から飛び退く。",
   "ko_candidate": "격통에 비명을 지르는 몸에 채찍질하며 그 자리에서 뛰어든다｡"
  },
  {
   "id": 14818,
   "key": "D0809al.txt:2132",
   "file": "D0809al.txt",
   "line": 2132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳びながら、俺はリボルバーをカリグラに向けて、全弾撃ち込んだ。",
   "ko_candidate": "뛰면서 나는 리볼버를 칼리굴라에게 향해 전탄을 쏟아부었다｡"
  },
  {
   "id": 14819,
   "key": "D0809al.txt:2133",
   "file": "D0809al.txt",
   "line": 2133,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マズル・フラッシュ。",
   "ko_candidate": "머즐 플래시｡"
  },
  {
   "id": 14820,
   "key": "D0809al.txt:2134",
   "file": "D0809al.txt",
   "line": 2134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声は５つ。",
   "ko_candidate": "총성은 5개｡"
  },
  {
   "id": 14821,
   "key": "D0809al.txt:2136",
   "file": "D0809al.txt",
   "line": 2136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その時、意識が加速した。",
   "ko_candidate": "그때 의식이 가속되었다｡"
  }
 ]
}