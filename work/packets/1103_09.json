  {
   "id": 23108,
   "key": "D1103le.txt:993",
   "file": "D1103le.txt",
   "line": 993,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これはメタトロンに斬られた傷ではない。",
   "ko_candidate": "이건 메타트론에게 베인 상처가 아니다｡"
