  {
   "id": 23092,
   "key": "D1103le.txt:880",
   "file": "D1103le.txt",
   "line": 880,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何の理性も無い、隙だらけの一撃。",
   "ko_candidate": "어떤 이성도 없는､ 허점투성이의 일격｡"
  },
  {
   "id": 23093,
   "key": "D1103le.txt:882",
   "file": "D1103le.txt",
   "line": 882,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが、メタトロンのダメージは深く、まだ立ち上がることが出来ない……！ 「ライカさんっ!?」",
   "ko_candidate": "하지만 메타트론의 데미지가 깊어 아직 일어날 수 없다"
  },
  {
   "id": 23094,
   "key": "D1103le.txt:890",
   "file": "D1103le.txt",
   "line": 890,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「っっっっ！」",
   "ko_candidate": "…! 「라이카 씨!?」"
  },
  {
   "id": 23095,
   "key": "D1103le.txt:895",
   "file": "D1103le.txt",
   "line": 895,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカアアアアアアアアアアアアアァァァァァァァ！」",
   "ko_candidate": "「!」 「라이카아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 23096,
   "key": "D1103le.txt:908",
   "file": "D1103le.txt",
   "line": 908,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ほら、見てごらん。こんなにも、こんなにも、きれいな青空だよ……」",
   "ko_candidate": "「봐､ 이렇게､ 이렇게 아름다운 푸른 하늘이야…」"
  },
  {
   "id": 23097,
   "key": "D1103le.txt:921",
   "file": "D1103le.txt",
   "line": 921,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「試験体０１、霊圧値１０万を超えて暴走！　『狐憑き』です！」",
   "ko_candidate": "「시험체 01､ 영압값 10만을 넘어 폭주! 『여우 들림』입니다!」"
  },
  {
   "id": 23098,
   "key": "D1103le.txt:925",
   "file": "D1103le.txt",
   "line": 925,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「実験中止！　試験体０１を破棄する！ 第１２区画封鎖！」",
   "ko_candidate": "「실험 중지! 시험체 01을 폐기한다! 제12구획 봉쇄!」"
  },
  {
   "id": 23099,
   "key": "D1103le.txt:933",
   "file": "D1103le.txt",
   "line": 933,
   "speaker": "研究員Ｃ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待って！　置いてかないで……っ！ ぎぃやああぁぁぁ！」",
   "ko_candidate": "「기다려! 버리고 가지 마…! 끼야아아아아!」"
  },
  {
   "id": 23100,
   "key": "D1103le.txt:938",
   "file": "D1103le.txt",
   "line": 938,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「試験体０１、 第１２区画の封印を解読！ 第８層に侵食します！」",
   "ko_candidate": "「시험체 01､ 제12구획의 봉인을 해독! 제8층에 침식합니다!」"
  },
  {
   "id": 23101,
   "key": "D1103le.txt:944",
   "file": "D1103le.txt",
   "line": 944,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「呪装兵、第３種武装にて展開！ 急げ！　急げ！」",
   "ko_candidate": "「주장병､ 제3종 무장으로 전개! 서둘러! 서둘러!」"
