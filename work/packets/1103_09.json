  {
   "id": 23113,
   "key": "D1103le.txt:1005",
   "file": "D1103le.txt",
   "line": 1005,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の雨となって、辺りに撒き散らされる。",
   "ko_candidate": "피의 비가 되어 주변에 뿌려진다｡"
  },
  {
   "id": 23114,
   "key": "D1103le.txt:1007",
   "file": "D1103le.txt",
   "line": 1007,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故か。",
   "ko_candidate": "왜일까｡"
  },
  {
   "id": 23115,
   "key": "D1103le.txt:1012",
   "file": "D1103le.txt",
   "line": 1012,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガ!?」",
   "ko_candidate": "「류가!?」"
  },
  {
   "id": 23116,
   "key": "D1103le.txt:1016",
   "file": "D1103le.txt",
   "line": 1016,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故か――ライカさんはビームセイバーを捨てる。",
   "ko_candidate": "왜일까―― 라이카 씨는 빔 세이버를 버린다｡"
