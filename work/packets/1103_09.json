  {
   "id": 23117,
   "key": "D1103le.txt:1018",
   "file": "D1103le.txt",
   "line": 1018,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "手を差し伸べる。",
   "ko_candidate": "손을 내민다｡"
  },
  {
   "id": 23118,
   "key": "D1103le.txt:1019",
   "file": "D1103le.txt",
   "line": 1019,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガを救おうと、守ろうとするように。",
   "ko_candidate": "류가를 구하려는 듯､ 지키려는 듯｡"
  },
  {
   "id": 23119,
   "key": "D1103le.txt:1023",
   "file": "D1103le.txt",
   "line": 1023,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ガアァアッ！」",
   "ko_candidate": "「……가아아악!」"
  },
  {
   "id": 23120,
   "key": "D1103le.txt:1026",
   "file": "D1103le.txt",
   "line": 1026,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガは差し伸べられた手を、忌々しげに弾く。",
   "ko_candidate": "류가는 내밀어진 손을 혐오스럽다는 듯 쳐낸다｡"
  },
  {
   "id": 23121,
   "key": "D1103le.txt:1027",
   "file": "D1103le.txt",
   "line": 1027,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんに、救いの手に、酷く怯えたかのように。",
   "ko_candidate": "라이카 씨를､ 구원의 손길을､ 몹시 두려워하는 것처럼｡"
  },
  {
   "id": 23122,
   "key": "D1103le.txt:1033",
   "file": "D1103le.txt",
   "line": 1033,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカ……殺す……次こそ殺す。 憶えておくが良い。貴様は己に殺される為だけに存在するのだ！」",
   "ko_candidate": "「라이카……죽여……다음엔 반드시 죽여주마｡ 명심해 둬라｡ 네놈은 나에게 죽임을 당하기 위해서만 존재하는 것이다!」"
  },
  {
   "id": 23123,
   "key": "D1103le.txt:1043",
   "file": "D1103le.txt",
   "line": 1043,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "捨て台詞を残し、天井近くまで跳躍する。",
   "ko_candidate": "마지막 말을 남기고 천장 가까이까지 도약한다｡"
  },
  {
   "id": 23124,
   "key": "D1103le.txt:1046",
   "file": "D1103le.txt",
   "line": 1046,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ステンドグラスをぶち抜く。",
   "ko_candidate": "스테인드글라스를 부숴버린다｡"
  },
  {
   "id": 23125,
   "key": "D1103le.txt:1047",
   "file": "D1103le.txt",
   "line": 1047,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "割れる硝子の破片が、七色の光を散らして、礼拝堂内に降り注いだ。",
   "ko_candidate": "깨진 유리 파편이 칠색 빛을 흩뿌리며 예배당 안으로 쏟아져 내렸다｡"
  },
  {
   "id": 23126,
   "key": "D1103le.txt:1052",
   "file": "D1103le.txt",
   "line": 1052,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待って！」",
   "ko_candidate": "「기다려!」"
  },
  {
   "id": 23127,
   "key": "D1103le.txt:1056",
   "file": "D1103le.txt",
   "line": 1056,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静止の声も届かない。",
   "ko_candidate": "멈추라는 소리도 닿지 않는다｡"
  }
 ]
