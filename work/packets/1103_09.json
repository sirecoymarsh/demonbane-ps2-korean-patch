  {
   "id": 23111,
   "key": "D1103le.txt:1002",
   "file": "D1103le.txt",
   "line": 1002,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "貌を押さえて、リューガが暴れる。",
   "ko_candidate": "얼굴을 감싸쥐고 류가가 날뛴다｡"
