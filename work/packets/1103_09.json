  {
   "id": 23107,
   "key": "D1103le.txt:992",
   "file": "D1103le.txt",
   "line": 992,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "貌を流れる血が、堰を切ったように一気に噴出する。",
   "ko_candidate": "얼굴을 타고 흐르는 피가 둑이 터진 듯 한꺼번에 분출된다｡"
