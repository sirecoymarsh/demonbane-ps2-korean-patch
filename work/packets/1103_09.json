  {
   "id": 23102,
   "key": "D1103le.txt:958",
   "file": "D1103le.txt",
   "line": 958,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だいじょうぶ。だいじょうぶだよ」 「いつかボクが、ここからライカを連れ出してみせるから」",
   "ko_candidate": "「괜찮아｡ 괜찮아」"
  },
  {
   "id": 23103,
   "key": "D1103le.txt:965",
   "file": "D1103le.txt",
   "line": 965,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いつかボクが、ライカをあの青空に連れていくから」",
   "ko_candidate": "「언젠가 내가 여기서 라이카를 데리고 나갈 테니까」"
  },
  {
   "id": 23104,
   "key": "D1103le.txt:968",
   "file": "D1103le.txt",
   "line": 968,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やくそく、する」 「――やくそく、するよ」",
   "ko_candidate": "「언젠가 내가 라이카를 저 푸른 하늘로 데려갈 테니까」"
