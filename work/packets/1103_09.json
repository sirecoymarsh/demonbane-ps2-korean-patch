  {
   "id": 23106,
   "key": "D1103le.txt:991",
   "file": "D1103le.txt",
   "line": 991,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "拳が、振り下ろされることはなかった。",
