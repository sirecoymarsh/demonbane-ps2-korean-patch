 "items": [
  {
   "id": 34331,
   "key": "D1309le.txt:758",
   "file": "D1309le.txt",
   "line": 758,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お爺様は、こんなものとは比べ物にならない程の、絶望と恐怖の中に居たに違いない。",
   "ko_candidate": "할아버지는 이런 것과는 비교도 안 될 정도의 절망과 공포 속에 있었을 거야｡"
  },
  {
   "id": 34332,
   "key": "D1309le.txt:759",
   "file": "D1309le.txt",
   "line": 759,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでもあの人は――世界の王で在り続けた！",
   "ko_candidate": "그래도 그분은――세계의 왕으로 있었어!"
  },
  {
   "id": 34333,
   "key": "D1309le.txt:761",
   "file": "D1309le.txt",
   "line": 761,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の瞳に気高い魂が宿る。",
   "ko_candidate": "루리의 눈동자에 고귀한 영혼이 깃든다｡"
  },
  {
   "id": 34334,
   "key": "D1309le.txt:762",
   "file": "D1309le.txt",
   "line": 762,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "立ち上がったその躰は、もはや震えていなかった。",
   "ko_candidate": "일어선 그 몸은 이제 더 이상 떨리지 않았다｡"
  },
  {
   "id": 34335,
   "key": "D1309le.txt:773",
   "file": "D1309le.txt",
   "line": 773,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「喝――――――――ッ！」",
   "ko_candidate": "「흡――――――――!」"
  },
  {
   "id": 34336,
   "key": "D1309le.txt:778",
   "file": "D1309le.txt",
   "line": 778,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一喝と共に瑠璃の鬼迫が司令室を打った。",
   "ko_candidate": "일갈과 함께 루리의 귀신같은 기세가 사령실을 내리쳤다｡"
  },
  {
   "id": 34337,
   "key": "D1309le.txt:779",
   "file": "D1309le.txt",
   "line": 779,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正気に戻った職員達が一斉に瑠璃を振り返る。",
   "ko_candidate": "정신을 차린 직원들이 일제히 루리를 돌아본다｡"
  },
  {
   "id": 34338,
   "key": "D1309le.txt:780",
   "file": "D1309le.txt",
   "line": 780,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瑠璃は――覇道財閥総帥・覇道瑠璃は叫んだ。 「皆の者！　いつまでそうして震えているつもりか！」",
   "ko_candidate": "루리는､ 하도재벌 총수､ 하도 루리는 외쳤다｡"
  },
  {
   "id": 34339,
   "key": "D1309le.txt:791",
   "file": "D1309le.txt",
   "line": 791,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しかと瞳を開いて、見よ！　我等がデモンベインの姿を！　絶望に立ち向かう、迷いなき戦士の姿を！」 「これを目にして、それでもなお、お前達は恐怖の奴隷と成り果てるのか！」",
   "ko_candidate": "「여러분! 언제까지 그렇게 떨고만 있을 생각이냐! 눈을 똑바로 뜨고 보라! 우리의 데몬베인의 모습을! 절망에 맞서는 망설임 없는 전사의 모습을! 이를 보고도 너희들은 여전히 공포의 노예로 전락할 것인가!」"
  },
  {
   "id": 34340,
   "key": "D1309le.txt:799",
   "file": "D1309le.txt",
   "line": 799,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……デモンベイン」",
   "ko_candidate": "「……데몬베인」"
  },
  {
   "id": 34341,
   "key": "D1309le.txt:803",
   "file": "D1309le.txt",
   "line": 803,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……デモンベイン」",
   "ko_candidate": "「……데몬베인」"
  },
  {
   "id": 34342,
   "key": "D1309le.txt:807",
   "file": "D1309le.txt",
   "line": 807,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……デモンベイン！」",
   "ko_candidate": "「……데몬베인!」"
  },
  {
   "id": 34343,
   "key": "D1309le.txt:812",
   "file": "D1309le.txt",
   "line": 812,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "司令室の全員が、魔を断つ剣の銘を呼ぶ。",
   "ko_candidate": "사령실의 모든 사람이 마를 베는 검의 이름을 부른다｡"
  },
  {
   "id": 34344,
   "key": "D1309le.txt:813",
   "file": "D1309le.txt",
   "line": 813,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼等の声には生気が戻りつつあった。",
   "ko_candidate": "그들의 목소리에는 생기가 돌아오고 있었다｡"
  },
  {
   "id": 34345,
   "key": "D1309le.txt:818",
   "file": "D1309le.txt",
   "line": 818,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……わたくし達に絶望は在り得ません。　そう……あの言葉が地上に響き渡る限り――！」",
   "ko_candidate": "「……우리에게 절망은 있을 수 없습니다｡ 그래요… 저 말이 지상에 울려 퍼지는 한――!」"
  },
  {
   "id": 34346,
   "key": "D1309le.txt:835",
   "file": "D1309le.txt",
   "line": 835,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――正しき怒りと憎悪に応え！」",
   "ko_candidate": "「――올바른 분노와 증오에 응답하라!」"
  },
  {
   "id": 34347,
   "key": "D1309le.txt:842",
   "file": "D1309le.txt",
   "line": 842,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「我等は魔を断つ剣を執る！」",
   "ko_candidate": "「우리는 마를 베는 검을 든다!」"
  },
  {
   "id": 34348,
   "key": "D1309le.txt:850",
   "file": "D1309le.txt",
   "line": 850,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝、無垢なる刃―― デモンベイン！」",
   "ko_candidate": "「그대､ 무구한 칼날――데몬베인!」"
  },
  {
   "id": 34349,
   "key": "D1309ru.txt:7",
   "file": "D1309ru.txt",
   "line": 7,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……痛ぅ……」",
   "ko_candidate": "「크윽… 아파…」"
  },
  {
   "id": 34350,
   "key": "D1309ru.txt:10",
   "file": "D1309ru.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "酷い頭痛で、目が覚めた。",
   "ko_candidate": "심한 두통으로 눈을 떴다｡"
  },
  {
   "id": 34351,
   "key": "D1309ru.txt:11",
   "file": "D1309ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆっくりと起き上がって、辺りを見回す。",
   "ko_candidate": "천천히 일어나 주위를 둘러본다｡"
  },
  {
   "id": 34352,
   "key": "D1309ru.txt:14",
   "file": "D1309ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何がどうなってこうなったかはさっぱり分からないが、俺は通路の真ん中でぶっ倒れていて、同様に姫さんとアル、ドクター・ウェストやエルザ、しかもズタボロで血まみれで死にかけっぽいクラウディウスまで、倒れている。",
   "ko_candidate": "무엇이 어떻게 되어 이렇게 됐는지 전혀 모르겠지만､ 나는 통로 한가운데 쓰러져 있었고､ 마찬가지로 공주님과 알､ 닥터 웨스트와 엘자､ 심지어 너덜너덜하고 피투성이에 죽을 것 같은 클라우디우스까지 쓰러져 있다｡"
  },
  {
   "id": 34353,
   "key": "D1309ru.txt:16",
   "file": "D1309ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲もあちこち破壊されていて、なかなか素敵に殺伐としている。",
   "ko_candidate": "주변도 여기저기 파괴되어 있어､ 꽤나 멋지게 살벌한 분위기다｡"
  },
  {
   "id": 34354,
   "key": "D1309ru.txt:17",
   "file": "D1309ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……俺が最後に倒れてから、今まで何があった？",
   "ko_candidate": "…내가 마지막으로 쓰러진 후부터 지금까지 무슨 일이 있었지?"
  },
  {
   "id": 34355,
   "key": "D1309ru.txt:19",
   "file": "D1309ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さっぱり分からないが、尋常でない事態なのは間違いない。",
   "ko_candidate": "전혀 모르겠지만､ 심상치 않은 상황인 건 틀림없다｡"
  },
  {
   "id": 34356,
   "key": "D1309ru.txt:20",
   "file": "D1309ru.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は姫さんとアルの肩を揺さぶった。",
   "ko_candidate": "나는 공주님과 알의 어깨를 흔들었다｡"
  },
  {
   "id": 34357,
   "key": "D1309ru.txt:25",
   "file": "D1309ru.txt",
   "line": 25,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おい……姫さん、アル、起きろ！　何が起こってるんだ、おいっ！」",
   "ko_candidate": "「이봐… 공주님､ 알､ 일어나! 무슨 일이 일어난 거야､ 이봐!」"
  },
  {
   "id": 34358,
   "key": "D1309ru.txt:28",
   "file": "D1309ru.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの悪夢が俺の中だけでのことじゃないなら……あの後、闇に呑み込まれたときに、どうなったんだろうか？",
   "ko_candidate": "그 악몽이 나 혼자만의 일이 아니었다면… 그 후､ 어둠에 삼켜졌을 때 어떻게 됐을까?"
  },
  {
   "id": 34359,
   "key": "D1309ru.txt:29",
   "file": "D1309ru.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まさか姫さんだけ悪夢に取り残されたとか……",
   "ko_candidate": "설마 공주님만 악몽에 갇힌 건 아니겠지…"
  },
  {
   "id": 34360,
   "key": "D1309ru.txt:33",
   "file": "D1309ru.txt",
   "line": 33,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「う……んん……」",
   "ko_candidate": "「으… 음…」"
  },
  {
   "id": 34361,
   "key": "D1309ru.txt:36",
   "file": "D1309ru.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの躰がわずかに身じろぎ、口からうめき声が零れた。",
   "ko_candidate": "공주님의 몸이 살짝 움직이더니 입에서 신음 소리가 새어 나왔다｡"
  },
  {
   "id": 34362,
   "key": "D1309ru.txt:37",
   "file": "D1309ru.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄っすらと瞼が開いてゆく。",
   "ko_candidate": "희미하게 눈꺼풀이 열린다｡"
  },
  {
   "id": 34363,
   "key": "D1309ru.txt:38",
   "file": "D1309ru.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "良かった……安堵に胸を撫で下ろす。",
   "ko_candidate": "다행이야… 안도의 한숨을 내쉰다｡"
  },
  {
   "id": 34364,
   "key": "D1309ru.txt:42",
   "file": "D1309ru.txt",
   "line": 42,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………大十字さん？」",
   "ko_candidate": "「…다이쥬지 씨?」"
  },
  {
   "id": 34365,
   "key": "D1309ru.txt:46",
   "file": "D1309ru.txt",
   "line": 46,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大丈夫か、姫さん？」",
   "ko_candidate": "「괜찮으세요､ 공주님?」"
  },
  {
   "id": 34366,
   "key": "D1309ru.txt:51",
   "file": "D1309ru.txt",
   "line": 51,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えーと、わたくし、確か……図書館で……怪物が……あれ？」",
   "ko_candidate": "「음､ 저､ 분명… 도서관에서… 괴물이… 어라?」"
  },
  {
   "id": 34367,
   "key": "D1309ru.txt:54",
   "file": "D1309ru.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やっぱり。",
   "ko_candidate": "역시｡"
  },
  {
   "id": 34368,
   "key": "D1309ru.txt:55",
   "file": "D1309ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あれは俺独りの夢ではなかったらしい。",
   "ko_candidate": "그건 나 혼자만의 꿈이 아니었던 모양이다｡"
  },
  {
   "id": 34369,
   "key": "D1309ru.txt:56",
   "file": "D1309ru.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は頷き、姫さんに微笑みかける。",
   "ko_candidate": "나는 고개를 끄덕이며 공주님에게 미소 지었다｡"
  },
  {
   "id": 34370,
   "key": "D1309ru.txt:60",
   "file": "D1309ru.txt",
   "line": 60,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ。姫さんが助けてくれたんだよ。ありがとな」",
   "ko_candidate": "「네｡ 공주님이 절 구해주셨어요｡ 고마워요」"
  }
 ]
}