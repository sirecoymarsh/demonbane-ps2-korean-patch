 "items": [
  {
   "id": 8922,
   "key": "D0706le.txt:260",
   "file": "D0706le.txt",
   "line": 260,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こうしていると、楽じゃない？」",
   "ko_candidate": "정말 갑작스러운 일이라 나는 당황해버렸다｡ 「이렇게 있으면 편하지 않아?」"
  },
  {
   "id": 8923,
   "key": "D0706le.txt:265",
   "file": "D0706le.txt",
   "line": 265,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「まだ酔ってるな、ライカさんっ！？」",
   "ko_candidate": "「아직 취해 있군요､ 라이카 씨!?」"
  },
  {
   "id": 8924,
   "key": "D0706le.txt:270",
   "file": "D0706le.txt",
   "line": 270,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「文句を言わないっ」",
   "ko_candidate": "「불평하지 마」"
  },
  {
   "id": 8925,
   "key": "D0706le.txt:276",
   "file": "D0706le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんと背中合わせになって、身動きが取れなくなる俺。",
   "ko_candidate": "라이카 씨와 등을 맞대고 움직일 수 없게 된 나｡"
  },
  {
   "id": 8926,
   "key": "D0706le.txt:279",
   "file": "D0706le.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……ったく。仮にも男を相手に、なんて無防備なんだ。この人は。",
   "ko_candidate": "……정말이지､ 남자를 상대로 뭐 이리 무방비한 거야｡ 이 사람은｡"
  },
  {
   "id": 8927,
   "key": "D0706le.txt:282",
   "file": "D0706le.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いくら酔っているとはいえ、そこはつつしみをだなぁ……うんぬん。",
   "ko_candidate": "아무리 취했다고 해도 거기는 삼가야 하지……운운｡ 「확실히 아직 취해 있을지도」"
  },
  {
   "id": 8928,
   "key": "D0706le.txt:288",
   "file": "D0706le.txt",
   "line": 288,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「確かに、まだ酔っているかも」",
   "ko_candidate": "「……헉?」 「이렇게 기분 좋게 술 마신 건 오랜만이니까」"
  },
  {
   "id": 8929,
   "key": "D0706le.txt:293",
   "file": "D0706le.txt",
   "line": 293,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……へっ？」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 8930,
   "key": "D0706le.txt:298",
   "file": "D0706le.txt",
   "line": 298,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こんなに気持ち良く、 お酒飲めたのは久々だから」",
   "ko_candidate": "왠지 말을 걸 수 없게 되어 입을 다물어 버렸다｡ 둘 다 등을 맞댄 채 그저 가만히 있을 뿐이었다｡"
  },
  {
   "id": 8931,
   "key": "D0706le.txt:304",
   "file": "D0706le.txt",
   "line": 304,
   "speaker": "九郎 / ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」 「あっ」",
   "ko_candidate": "라이카 씨 쪽에서도 특별히 말을 걸지 않는다……고 생각했는데｡"
  },
  {
   "id": 8932,
   "key": "D0706le.txt:314",
   "file": "D0706le.txt",
   "line": 314,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………？」",
   "ko_candidate": "「앗」 「…………?」"
  },
  {
   "id": 8933,
   "key": "D0706le.txt:319",
   "file": "D0706le.txt",
   "line": 319,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎ちゃん、星」",
   "ko_candidate": "「쿠로 짱､ 별」"
  },
  {
   "id": 8934,
   "key": "D0706le.txt:325",
   "file": "D0706le.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう言われて、俺は夜空を見上げた。",
   "ko_candidate": "그렇게 말해서 나는 밤하늘을 올려다봤다｡"
  },
  {
   "id": 8935,
   "key": "D0706le.txt:330",
   "file": "D0706le.txt",
   "line": 330,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「へぇぇぇ～」",
   "ko_candidate": "「헤에에~」"
  },
  {
   "id": 8936,
   "key": "D0706le.txt:343",
   "file": "D0706le.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――頭上に広がる満天の星空。",
   "ko_candidate": "――머리 위로 펼쳐진 별이 가득한 하늘｡"
  },
  {
   "id": 8937,
   "key": "D0706le.txt:346",
   "file": "D0706le.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは圧倒されそうなくらいに、綺麗な空だった。",
   "ko_candidate": "그것은 압도될 정도로 아름다운 하늘이었다｡"
  },
  {
   "id": 8938,
   "key": "D0706le.txt:347",
   "file": "D0706le.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "夜も眠らないアーカムシティでは、こんな空にはお目にかかれないだろう。",
   "ko_candidate": "잠들지 않는 아캄시티에서는 이런 하늘을 볼 수 없을 것이다｡"
  },
  {
   "id": 8939,
   "key": "D0706le.txt:353",
   "file": "D0706le.txt",
   "line": 353,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……綺麗～」",
   "ko_candidate": "「……예뻐~」"
  },
  {
   "id": 8940,
   "key": "D0706le.txt:358",
   "file": "D0706le.txt",
   "line": 358,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 8941,
   "key": "D0706le.txt:363",
   "file": "D0706le.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そのまま２人、背中を合わせたまま――互いの背中に身を預けたまま、ずっと星空を見上げていた。",
   "ko_candidate": "그대로 둘이서 등을 맞댄 채――서로의 등에 몸을 기댄 채､ 계속 별하늘을 올려다보고 있었다｡ 별하늘 아래､ 여름의 조금은 기묘한 밤은 조용히 깊어간다｡"
  },
  {
   "id": 8942,
   "key": "D0706le.txt:366",
   "file": "D0706le.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "星空の下、夏の、ちょっとだけ奇妙な夜は、静かにふけてゆく。",
   "ko_candidate": "한동안 욕조에 몸을 담그고 멍하니 있었다｡ 그러자 입구 쪽에서 또 인영이 다가왔다｡"
  },
  {
   "id": 8943,
   "key": "D0706ru.txt:17",
   "file": "D0706ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しばらく湯船に浸かって、ぼーとしていた。",
   "ko_candidate": "……나이아 씨가 돌아온 건가? 아니､ 다르다｡"
  },
  {
   "id": 8944,
   "key": "D0706ru.txt:18",
   "file": "D0706ru.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "すると入り口の方からまた人影が近づいてきた。",
   "ko_candidate": "나이아 씨치고는……선이 가늘다｡ 이건……"
  },
  {
   "id": 8945,
   "key": "D0706ru.txt:26",
   "file": "D0706ru.txt",
   "line": 26,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……え？」",
   "ko_candidate": "「…………어?」"
  },
  {
   "id": 8946,
   "key": "D0706ru.txt:31",
   "file": "D0706ru.txt",
   "line": 31,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……はぁ？」",
   "ko_candidate": "「…………하아?」"
  },
  {
   "id": 8947,
   "key": "D0706ru.txt:36",
   "file": "D0706ru.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "湯煙が晴れて、目が合った。",
   "ko_candidate": "수증기가 걷히고 눈이 마주쳤다｡"
  },
  {
   "id": 8948,
   "key": "D0706ru.txt:37",
   "file": "D0706ru.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "お互いの顔が良く見える。",
   "ko_candidate": "서로의 얼굴이 잘 보인다｡"
  },
  {
   "id": 8949,
   "key": "D0706ru.txt:42",
   "file": "D0706ru.txt",
   "line": 42,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ひ、姫さんっ！？」",
   "ko_candidate": "「고､ 공주님!?」"
  },
  {
   "id": 8950,
   "key": "D0706ru.txt:47",
   "file": "D0706ru.txt",
   "line": 47,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あら、まあ」",
   "ko_candidate": "「어머､ 마아」"
  },
  {
   "id": 8951,
   "key": "D0706ru.txt:52",
   "file": "D0706ru.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "別に焦った風のなく、姫さんはのほほんと俺を見つめ返した。むしろ焦ってるのは俺の方だ。",
   "ko_candidate": "특별히 당황한 기색도 없이 공주님는 태연하게 나를 바라보았다｡ 오히려 당황한 건 나 쪽이다｡"
  },
  {
   "id": 8952,
   "key": "D0706ru.txt:57",
   "file": "D0706ru.txt",
   "line": 57,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや、何をのほほんと！？」",
   "ko_candidate": "「공주님､ 앞! 앞앞앞앞이!」 「……응?」"
  },
  {
   "id": 8953,
   "key": "D0706ru.txt:63",
   "file": "D0706ru.txt",
   "line": 63,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「？　……何でそんなに慌てているのです？」",
   "ko_candidate": "공주님는 앞을 가리지 않고 있다｡ 벌거벗은 상태였다｡"
  },
  {
   "id": 8955,
   "key": "D0706ru.txt:69",
   "file": "D0706ru.txt",
   "line": 69,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「～～～～っ！ ま、まだ酔っ払ってんな、あんた！？」",
   "ko_candidate": "하지만 당사자인 공주님는 신경 쓰는 기색이 없다｡ 「별로……보인다고 줄어드는 것도 아니잖아요」"
  },
  {
   "id": 8956,
   "key": "D0706ru.txt:76",
   "file": "D0706ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……ったく、さっきに続いてまたかよ！？",
   "ko_candidate": "「아직도 취해 있는 거야､ 당신은!?」 ……젠장､ 아까에 이어 또냐!?"
  },
  {
   "id": 8957,
   "key": "D0706ru.txt:77",
   "file": "D0706ru.txt",
   "line": 77,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "風呂の中ですら、安息の場所はないのかっ！？ 「大十字さん……」",
   "ko_candidate": "목욕탕 안에서조차 안식의 장소는 없는 건가!?"
  },
  {
   "id": 8958,
   "key": "D0706ru.txt:89",
   "file": "D0706ru.txt",
   "line": 89,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ば、馬鹿っ！　ち、近寄るな……っ！」",
   "ko_candidate": "「바､ 바보! 가､ 가까이 오지 마……!」"
  },
  {
   "id": 8959,
   "key": "D0706ru.txt:94",
   "file": "D0706ru.txt",
   "line": 94,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふふ……」",
   "ko_candidate": "「다이쥬지 씨……」"
  },
  {
   "id": 8960,
   "key": "D0706ru.txt:102",
   "file": "D0706ru.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "姫さんが湯船に浸かり、こっちに寄って来る。",
   "ko_candidate": "공주님가 욕조에 들어와 이쪽으로 다가온다｡"
  },
  {
   "id": 8961,
   "key": "D0706ru.txt:104",
   "file": "D0706ru.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "息が触れそうなくらい間近に、姫さんの上気した顔があった。",
   "ko_candidate": "숨결이 닿을 듯한 가까운 거리에 공주님의 상기된 얼굴이 바로 눈앞에 있었다｡"
  },
  {
   "id": 8962,
   "key": "D0706ru.txt:107",
   "file": "D0706ru.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  }
 ]
}