 },
 "items": [
  {
   "id": 50178,
   "key": "ep_ruri01.txt:92",
   "file": "ep_ruri01.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "でも……頑張らないと。",
   "ko_candidate": "하지만……열심히 해야 해｡"
  },
  {
   "id": 50179,
   "key": "ep_ruri01.txt:93",
   "file": "ep_ruri01.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これは私の戦いだ。",
   "ko_candidate": "이것은 나의 싸움이다｡"
  },
  {
   "id": 50180,
   "key": "ep_ruri01.txt:94",
   "file": "ep_ruri01.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの人が戦ったように――私も自分の戦いから逃げてはいけない。",
   "ko_candidate": "그 사람이 싸웠듯이――나도 내 싸움에서 도망치면 안 돼｡"
  },
  {
   "id": 50181,
   "key": "ep_ruri01.txt:96",
   "file": "ep_ruri01.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうでないと、あの人が帰って来た時、顔向けできないから。",
   "ko_candidate": "그렇지 않으면､ 그 사람이 돌아왔을 때､ 얼굴을 들 수 없으니까｡"
  },
  {
   "id": 50182,
   "key": "ep_ruri01.txt:104",
   "file": "ep_ruri01.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門が閉じて、６ヶ月。",
   "ko_candidate": "문이 닫힌 지､ 6개월｡"
  },
  {
   "id": 50183,
   "key": "ep_ruri01.txt:105",
   "file": "ep_ruri01.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "心の間隙を突いて、焦燥が私を襲う。",
   "ko_candidate": "마음의 틈을 파고들어､ 초조함이 나를 덮친다｡"
  },
  {
   "id": 50184,
   "key": "ep_ruri01.txt:106",
   "file": "ep_ruri01.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――あの人は、帰って来ない。",
   "ko_candidate": "――그 사람은､ 돌아오지 않는다｡"
  },
  {
   "id": 50185,
   "key": "ep_ruri01.txt:116",
   "file": "ep_ruri01.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門が閉じて、１年。",
   "ko_candidate": "문이 닫힌 지 1년｡"
  },
  {
   "id": 50186,
   "key": "ep_ruri01.txt:117",
   "file": "ep_ruri01.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "人々はあれほど壮絶だった戦いを、忘れつつあった。",
   "ko_candidate": "사람들은 그토록 장렬했던 전투를 잊어가고 있었다｡"
  },
  {
   "id": 50187,
   "key": "ep_ruri01.txt:119",
   "file": "ep_ruri01.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "重く圧し掛かる過去よりも、明日を生きる事が大変だから。",
   "ko_candidate": "무겁게 짓누르는 과거보다 내일을 살아가는 것이 더 중요하니까｡"
  },
  {
   "id": 50188,
   "key": "ep_ruri01.txt:120",
   "file": "ep_ruri01.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大切だから。",
   "ko_candidate": "소중하니까｡"
  },
  {
   "id": 50189,
   "key": "ep_ruri01.txt:121",
   "file": "ep_ruri01.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "明日を見つめていれば、世界は正しく機能する。",
   "ko_candidate": "내일을 바라보고 있으면 세상은 제대로 돌아간다｡"
  },
  {
   "id": 50190,
   "key": "ep_ruri01.txt:123",
   "file": "ep_ruri01.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ私は、私だけは待ち続ける。",
   "ko_candidate": "하지만 나는､ 나만은 계속 기다린다｡"
  },
  {
   "id": 50191,
   "key": "ep_ruri01.txt:124",
   "file": "ep_ruri01.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界が忘却する記憶の狭間で、あの人を、待ち続ける。",
   "ko_candidate": "세상이 잊어가는 기억의 틈새에서 그 사람을 계속 기다린다｡"
  },
  {
   "id": 50192,
   "key": "ep_ruri01.txt:130",
   "file": "ep_ruri01.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門が閉じて――――――――――",
   "ko_candidate": "문이 닫힌 지――――――――――"
  },
  {
   "id": 50193,
   "key": "ep_ruri01.txt:135",
   "file": "ep_ruri01.txt",
   "line": 135,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………………………嘘つき」",
   "ko_candidate": "「…………………………거짓말쟁이」"
  },
  {
   "id": 50194,
   "key": "ep_ruri01.txt:152",
   "file": "ep_ruri01.txt",
   "line": 152,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「瑠璃お嬢様、失礼します」",
   "ko_candidate": "「루리 아가씨､ 실례합니다」"
  },
  {
   "id": 50195,
   "key": "ep_ruri01.txt:158",
   "file": "ep_ruri01.txt",
   "line": 158,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何ですか、ウィンフィールド？」",
   "ko_candidate": "「무슨 일이죠､ 윈필드?」"
  },
  {
   "id": 50196,
   "key": "ep_ruri01.txt:162",
   "file": "ep_ruri01.txt",
   "line": 162,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ええ、以前のキングスポート開発についての件なのですが」",
   "ko_candidate": "「네､ 전에 킹스포트 개발에 관한 건인데요」"
  },
  {
   "id": 50197,
   "key": "ep_ruri01.txt:166",
   "file": "ep_ruri01.txt",
   "line": 166,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あら？　その件に関しては、総て委任した筈ですが」",
   "ko_candidate": "「어머? 그 건에 관해서는 모두 위임했을 텐데요」"
  },
  {
   "id": 50198,
   "key": "ep_ruri01.txt:170",
   "file": "ep_ruri01.txt",
   "line": 170,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「少々、厄介な問題が起きておりまして。これが、その件に関する書類です」",
   "ko_candidate": "「조금 골치 아픈 문제가 생겼습니다｡ 이게 그 건에 관한 서류입니다」"
  },
  {
   "id": 50199,
   "key": "ep_ruri01.txt:176",
   "file": "ep_ruri01.txt",
   "line": 176,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふぅ……。分かりました。今は急ぎの仕事が入ってますから、そこに置いておいて下さいな。後で目を通します」",
   "ko_candidate": "「휴……｡ 알겠어요｡ 지금은 급한 일이 있으니까 거기에 놓아두세요｡ 나중에 살펴볼게요」"
  },
  {
   "id": 50200,
   "key": "ep_ruri01.txt:180",
   "file": "ep_ruri01.txt",
   "line": 180,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「かしこまりました」",
   "ko_candidate": "「알겠습니다」"
  },
  {
   "id": 50201,
   "key": "ep_ruri01.txt:186",
   "file": "ep_ruri01.txt",
   "line": 186,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 50202,
   "key": "ep_ruri01.txt:190",
   "file": "ep_ruri01.txt",
   "line": 190,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 50203,
   "key": "ep_ruri01.txt:196",
   "file": "ep_ruri01.txt",
   "line": 196,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……まだ、何か？」",
   "ko_candidate": "「……아직 뭔가 있나요?」"
  },
  {
   "id": 50204,
   "key": "ep_ruri01.txt:200",
   "file": "ep_ruri01.txt",
   "line": 200,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いえ。ただ……ここ最近、またお嬢様は根を詰めているようで。御自愛して頂かないと、お身体に障ります」",
   "ko_candidate": "「아닙니다｡ 다만…… 요즘 아가씨께서 또 무리하시는 것 같아서요｡ 건강 관리를 하지 않으시면 몸에 해롭습니다」"
  },
  {
   "id": 50205,
   "key": "ep_ruri01.txt:206",
   "file": "ep_ruri01.txt",
   "line": 206,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……忙しく動き回っている方が、気持ちが楽なのですよ」",
   "ko_candidate": "「……바쁘게 움직이는 편이 마음이 편해요」"
  },
  {
   "id": 50206,
   "key": "ep_ruri01.txt:210",
   "file": "ep_ruri01.txt",
   "line": 210,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「お嬢様……やはり」",
   "ko_candidate": "「아가씨…… 역시」"
  },
  {
   "id": 50207,
   "key": "ep_ruri01.txt:214",
   "file": "ep_ruri01.txt",
   "line": 214,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――わたくしは待ち続けますわ。そう約束したのですから。 わたくしの方から違える訳には参りませんもの」",
   "ko_candidate": "「――저는 계속 기다리겠어요｡ 그렇게 약속 했으니까요｡ 제가 먼저 어길 수는 없잖아요」"
  },
  {
   "id": 50208,
   "key": "ep_ruri01.txt:219",
   "file": "ep_ruri01.txt",
   "line": 219,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………はっ」",
   "ko_candidate": "「…………하」"
  },
  {
   "id": 50209,
   "key": "ep_ruri01.txt:225",
   "file": "ep_ruri01.txt",
   "line": 225,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……下がって良いですよ、ウィンフィールド。 ああ、そうそう……もう少し経ったらお茶にしようかしら。 貴方の言う通り、息抜きは必要ですね」",
   "ko_candidate": "「……물러가도 좋아요､ 윈필드｡ 아､ 맞다…… 조금 있다 차라도 마실까요｡ 당신 말대로 휴식이 필요하네요」"
  },
  {
   "id": 50210,
   "key": "ep_ruri01.txt:230",
   "file": "ep_ruri01.txt",
   "line": 230,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「了解致しました。ちょうど今朝方、いつものが届きましたので」",
   "ko_candidate": "「알겠습니다｡ 마침 오늘 아침에 늘 먹던 게 도착했습니다」 「네…… 부탁해요」"
  },
  {
   "id": 50211,
   "key": "ep_ruri01.txt:234",
   "file": "ep_ruri01.txt",
   "line": 234,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ええ……よろしくね」",
   "ko_candidate": "「그럼 실례하겠습니다」"
  },
  {
   "id": 50212,
   "key": "ep_ruri01.txt:246",
   "file": "ep_ruri01.txt",
   "line": 246,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「では、失礼致します」",
   "ko_candidate": "「우와와와와와왓!?」"
  },
  {
   "id": 50213,
   "key": "ep_ruri01.txt:253",
   "file": "ep_ruri01.txt",
   "line": 253,
   "speaker": "チアキ＆ソーニャ＆マコト",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うわわわわわわっ!?」",
   "ko_candidate": "「당신들…… 엿듣고 있었군요?」"
  },
  {
   "id": 50214,
   "key": "ep_ruri01.txt:261",
   "file": "ep_ruri01.txt",
   "line": 261,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「貴女方…… 聞き耳を立ててましたね？」",
   "ko_candidate": "「아핫…… 아하하…… 아하하하하하､ 맞아요」"
  },
  {
   "id": 50215,
   "key": "ep_ruri01.txt:268",
   "file": "ep_ruri01.txt",
   "line": 268,
   "speaker": "ソーニャ / チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あはっ……あはは……あははははは、ですぅ」 「はは……すみません。だけどやっぱりお嬢様の様子が気になるので……」",
   "ko_candidate": "「하하…… 죄송합니다｡ 하지만 역시 아가씨의 상태가 걱정돼서요……」"
  },
  {
   "id": 50216,
   "key": "ep_ruri01.txt:278",
   "file": "ep_ruri01.txt",
   "line": 278,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「やれやれ…… 仕方のない人達ですね」",
   "ko_candidate": "「참 나…… 어쩔 수 없는 사람들이네요」"
  },
  {
   "id": 50217,
   "key": "ep_ruri01.txt:283",
   "file": "ep_ruri01.txt",
   "line": 283,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――お嬢様は、まだ大十字様の事を？」",
   "ko_candidate": "「――아가씨는 아직 다이쥬지 님을?」"
  }
 ]
}