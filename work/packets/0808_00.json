 },
 "items": [
  {
   "id": 13970,
   "key": "D0808al.txt:4",
   "file": "D0808al.txt",
   "line": 4,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――第七日目に、神は御自分の業を完成され、第七日目に、神は御自分の業を止め、安息なされた。",
   "ko_candidate": "――제7일에 하느님은 당신의 일을 완성하시고､ 제7일에 하느님은 당신의 일을 멈추고 쉬셨다｡"
  },
  {
   "id": 13971,
   "key": "D0808al.txt:12",
   "file": "D0808al.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一週間という期間は短いようで長くて、長いようで短い。",
   "ko_candidate": "일주일이라는 기간은 짧은 것 같으면서도 길고､ 긴 것 같으면서도 짧다｡"
  },
  {
   "id": 13972,
   "key": "D0808al.txt:14",
   "file": "D0808al.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺とアルとエンネアの奇妙な共同生活が始まって一週間。",
   "ko_candidate": "나와 알과 엔네아의 기묘한 공동생활이 시작된 지 일주일｡"
  },
  {
   "id": 13973,
   "key": "D0808al.txt:16",
   "file": "D0808al.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その一週間は昨日から今日、今日から明日を紡ぐのに全生命力を注ぎ込むような地獄すらも生温い、長い長い戦いの日々であった。",
   "ko_candidate": "그 일주일은 어제에서 오늘､ 오늘에서 내일로 이어지는 데 모든 생명력을 쏟아부어야 할 정도로 지옥조차 미지근한､ 길고 긴 싸움의 나날이었다｡"
  },
  {
   "id": 13974,
   "key": "D0808al.txt:18",
   "file": "D0808al.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがその一週間は、嵐の如く、迅雷の如く、光の如く、もの凄いスピードで駆け抜けていった。",
   "ko_candidate": "하지만 그 일주일은 폭풍처럼､ 번개처럼､ 빛처럼､ 엄청난 속도로 달려갔다｡"
  },
  {
   "id": 13975,
   "key": "D0808al.txt:23",
   "file": "D0808al.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "調査や修行のときも、エンネアは一緒に付いてきた。",
   "ko_candidate": "조사나 수행을 할 때도 엔네아는 함께 따라왔다｡"
  },
  {
   "id": 13976,
   "key": "D0808al.txt:25",
   "file": "D0808al.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不貞腐れ、悪態を吐くアル。",
   "ko_candidate": "뾰로통해서 욕설을 내뱉는 알｡"
  },
  {
   "id": 13977,
   "key": "D0808al.txt:26",
   "file": "D0808al.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それをからかいながら、さらりとかわすエンネア。",
   "ko_candidate": "그것을 놀리면서 가볍게 피하는 엔네아｡"
  },
  {
   "id": 13978,
   "key": "D0808al.txt:31",
   "file": "D0808al.txt",
   "line": 31,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こ、こ、こ、小娘ぇぇぇぇ――――――――――――っ！」",
   "ko_candidate": "「이､ 이､ 이､ 이 꼬마야아아아――――――――――――!」"
  },
  {
   "id": 13979,
   "key": "D0808al.txt:36",
   "file": "D0808al.txt",
   "line": 36,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「きゃああああぁぁぁ――――――――――――――――♪」",
   "ko_candidate": "「꺄아아아아아아――――――――――――――――♪」"
  },
  {
   "id": 13980,
   "key": "D0808al.txt:41",
   "file": "D0808al.txt",
   "line": 41,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぎゃあああああああああ――――――――ッッッッ！」",
   "ko_candidate": "「꺄아아아아아아아아아아아――――――――!」"
  },
  {
   "id": 13981,
   "key": "D0808al.txt:45",
   "file": "D0808al.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのたびに、アルが切れた。",
   "ko_candidate": "그때마다 알이 화를 냈다｡"
  },
  {
   "id": 13982,
   "key": "D0808al.txt:46",
   "file": "D0808al.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そのたびに、『俺が』吹き飛ばされた。",
   "ko_candidate": "그때마다 『내가』 날아갔다｡"
  },
  {
   "id": 13983,
   "key": "D0808al.txt:47",
   "file": "D0808al.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのたびに、死にかけた。",
   "ko_candidate": "그때마다 죽을 뻔했다｡"
  },
  {
   "id": 13984,
   "key": "D0808al.txt:58",
   "file": "D0808al.txt",
   "line": 58,
   "speaker": "ネス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぎゃああああああああああ!?」",
   "ko_candidate": "「꺄아아아아아아아아아!?」"
  },
  {
   "id": 13985,
   "key": "D0808al.txt:63",
   "file": "D0808al.txt",
   "line": 63,
   "speaker": "ストーン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐおおおおおおっ!?　た……逮捕、す…………がくっ」",
   "ko_candidate": "「으아아아아아아! 체… 체포､ 하… 으윽」{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 13986,
   "key": "D0808al.txt:67",
   "file": "D0808al.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "警官が巻き込まれることもあった。",
   "ko_candidate": "경찰관이 휘말리는 일도 있었다｡"
  },
  {
   "id": 13987,
   "key": "D0808al.txt:68",
   "file": "D0808al.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "当然、大事になって追われる羽目になった。",
   "ko_candidate": "당연히 큰일이 되어 쫓기게 되었다｡"
  },
  {
   "id": 13988,
   "key": "D0808al.txt:76",
   "file": "D0808al.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンネアの家事の手際はやはり見事だった。",
   "ko_candidate": "엔네아의 가사 솜씨는 역시 훌륭했다｡"
  },
  {
   "id": 13989,
   "key": "D0808al.txt:77",
   "file": "D0808al.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "テキパキと、俺から見れば魔法のように、炊事洗濯掃除、何でもこなす。",
   "ko_candidate": "테키파키하게､ 내가 보기에는 마법처럼､ 취사 세탁 청소､ 뭐든지 해낸다｡"
  },
  {
   "id": 13990,
   "key": "D0808al.txt:82",
   "file": "D0808al.txt",
   "line": 82,
   "speaker": "ダンセイニ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てけり・り」",
   "ko_candidate": "「테케리?리」"
  },
  {
   "id": 13991,
   "key": "D0808al.txt:85",
   "file": "D0808al.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンネアの後ろに引っ付いて、ダンセイニが家事を手伝っている。",
   "ko_candidate": "엔네아의 뒤에 붙어서 던세이니가 가사를 돕고 있다｡"
  },
  {
   "id": 13992,
   "key": "D0808al.txt:87",
   "file": "D0808al.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルはつまらなそうなツラで、その様子を眺めている。",
   "ko_candidate": "알은 재미없어 보이는 얼굴로 그 모습을 바라보고 있다｡"
  },
  {
   "id": 13993,
   "key": "D0808al.txt:89",
   "file": "D0808al.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はアルの八つ当たりの犠牲となって、いつもより倍近いノルマで、魔術知識を詰め込まされている。",
   "ko_candidate": "나는 알의 화풀이 희생양이 되어 평소보다 두 배 가까운 할당량으로 마술 지식을 주입당하고 있다｡"
  },
  {
   "id": 13994,
   "key": "D0808al.txt:97",
   "file": "D0808al.txt",
   "line": 97,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「其処！　発音が違う！　正しくはこうだ！　（以下、人間には発音不可能の不気味言語が続く）」",
   "ko_candidate": "「거기! 발음이 틀려! 정확히는 이렇다! (이하､ 인간은 발음 불가능한 불길한 언어가 이어짐)」"
  },
  {
   "id": 13995,
   "key": "D0808al.txt:101",
   "file": "D0808al.txt",
   "line": 101,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや、無理だっつーの！」",
   "ko_candidate": "「아니､ 무리라고!」"
  },
  {
   "id": 13996,
   "key": "D0808al.txt:111",
   "file": "D0808al.txt",
   "line": 111,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「らららー♪　わたしは～～っ、かわいい～～若奥様～～～～っ♪」",
   "ko_candidate": "「라라라~ ♪ 나는~~ 귀여운~~ 새댁이에요~~~♪」"
  },
  {
   "id": 13997,
   "key": "D0808al.txt:117",
   "file": "D0808al.txt",
   "line": 117,
   "speaker": "ダンセイニ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てけり・り～♪」",
   "ko_candidate": "「테케리?리~♪」"
  },
  {
   "id": 13998,
   "key": "D0808al.txt:122",
   "file": "D0808al.txt",
   "line": 122,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「其処！　不愉快な歌を作詞作曲合唱するでないっ！」",
   "ko_candidate": "「거기! 불쾌한 노래를 작사 작곡 합창하지 말라!」"
  },
  {
   "id": 13999,
   "key": "D0808al.txt:127",
   "file": "D0808al.txt",
   "line": 127,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いあ～！　しゅぶにぐら～♪」",
   "ko_candidate": "「이야~! 슈부니구라~♪」"
  },
  {
   "id": 14000,
   "key": "D0808al.txt:132",
   "file": "D0808al.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "寝るときですら平穏ではなかった。",
   "ko_candidate": "잘 때조차 평온하지 않았다｡"
  },
  {
   "id": 14001,
   "key": "D0808al.txt:137",
   "file": "D0808al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルはダンセイニの上。",
   "ko_candidate": "알은 던세이니 위｡"
  },
  {
   "id": 14002,
   "key": "D0808al.txt:138",
   "file": "D0808al.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エンネアはソファーの上。",
   "ko_candidate": "엔네아는 소파 위｡"
  },
  {
   "id": 14003,
   "key": "D0808al.txt:139",
   "file": "D0808al.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は……寝場所を追われ、床の上。",
   "ko_candidate": "나는… 잘 자리를 빼앗겨 바닥 위｡"
  },
  {
   "id": 14004,
   "key": "D0808al.txt:140",
   "file": "D0808al.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが定位置。",
   "ko_candidate": "그게 정위치｡"
  },
  {
   "id": 14005,
   "key": "D0808al.txt:144",
   "file": "D0808al.txt",
   "line": 144,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もぉ～、九郎ーっ。そんな床で寝てると身体を壊すよー。一緒に寝よーっ」",
   "ko_candidate": "「정말~､ 쿠로｡ 그렇게 바닥에서 자면 몸 상한다고｡ 같이 자자~」"
  },
  {
   "id": 14006,
   "key": "D0808al.txt:148",
   "file": "D0808al.txt",
   "line": 148,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な……っ!?」",
   "ko_candidate": "「뭐…!?」"
  },
  {
   "id": 14007,
   "key": "D0808al.txt:152",
   "file": "D0808al.txt",
   "line": 152,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いや……さすがにそれは……ほら、狭いし……」",
   "ko_candidate": "「아니… 아무래도 그건… 봐､ 좁잖아…」"
  },
  {
   "id": 14008,
   "key": "D0808al.txt:156",
   "file": "D0808al.txt",
   "line": 156,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大丈夫だよー。エンネアと抱き合って寝れば……ぽっ」",
   "ko_candidate": "「괜찮아｡ 엔네아랑 껴안고 자면… 으음」"
  },
  {
   "id": 14009,
   "key": "D0808al.txt:160",
   "file": "D0808al.txt",
   "line": 160,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何をたわけた事をぬかしておるか、汝はっ！」",
   "ko_candidate": "「무슨 어리석은 소리를 지껄이고 있느냐､ 네놈은!」"
  }
 ]
}