 },
 "items": [
  {
   "id": 35816,
   "key": "D1313ru.txt:355",
   "file": "D1313ru.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悪戯っぽく微笑む姫さんに向けて、俺も不敵な笑みで返した。",
   "ko_candidate": "장난기 어린 미소를 짓는 공주님을 향해､ 나도 뻔뻔한 웃음으로 답했다｡"
  },
  {
   "id": 35817,
   "key": "D1313ru.txt:361",
   "file": "D1313ru.txt",
   "line": 361,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……やるなら早くしろ！」",
   "ko_candidate": "「…할 거면 빨리 해!」"
  },
  {
   "id": 35818,
   "key": "D1313ru.txt:364",
   "file": "D1313ru.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少し苛立ったようなアルの叫び。",
   "ko_candidate": "약간 초조해한 듯한 알의 외침｡"
  },
  {
   "id": 35819,
   "key": "D1313ru.txt:365",
   "file": "D1313ru.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "分かったっつーの……焦るな！",
   "ko_candidate": "알았다고… 조급해하지 마!"
  },
  {
   "id": 35820,
   "key": "D1313ru.txt:371",
   "file": "D1313ru.txt",
   "line": 371,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「じゃあ征くぜぇぇぇぇ！　ヒラニプラ・システム……アクセス！」",
   "ko_candidate": "「그럼 가자아아아아! 히라니프라 시스템… 액세스!」"
  },
  {
   "id": 35821,
   "key": "D1313ru.txt:375",
   "file": "D1313ru.txt",
   "line": 375,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインが、爆裂する怨念の只中を疾走する……！",
   "ko_candidate": "데몬베인이､ 폭렬하는 원념의 한가운데를 질주한다…!"
  },
  {
   "id": 35822,
   "key": "D1313ru.txt:383",
   "file": "D1313ru.txt",
   "line": 383,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………ッ！」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 35823,
   "key": "D1313ru.txt:388",
   "file": "D1313ru.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐敗する爆発から、デモンベインは飛び出した。",
   "ko_candidate": "부패하는 폭발에서､ 데몬베인은 튀어나왔다｡"
  },
  {
   "id": 35824,
   "key": "D1313ru.txt:389",
   "file": "D1313ru.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨霊の飛沫を散らして、宙を舞う巨体。",
   "ko_candidate": "원령의 물보라를 흩뿌리며､ 허공을 나는 거체｡"
  },
  {
   "id": 35825,
   "key": "D1313ru.txt:398",
   "file": "D1313ru.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光り輝く右掌。闇夜に刻まれる光の残像。",
   "ko_candidate": "빛나는 오른손바닥｡ 어둔 밤에 새겨지는 빛의 잔상｡"
  },
  {
   "id": 35826,
   "key": "D1313ru.txt:408",
   "file": "D1313ru.txt",
   "line": 408,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――光射す世界に、汝ら闇黒、棲まう場所無し」",
   "ko_candidate": "「――빛 비치는 세계에､ 너희 암흑､ 살 곳 없다」"
  },
  {
   "id": 35827,
   "key": "D1313ru.txt:414",
   "file": "D1313ru.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眼下には、群がる無数の蝿が、ヒト型を造り出していた。",
   "ko_candidate": "눈 아래에는､ 모여드는 무수한 파리가､ 사람 형태를 만들어내고 있었다｡"
  },
  {
   "id": 35828,
   "key": "D1313ru.txt:415",
   "file": "D1313ru.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い靄のような巨人。その中心部に魔力の輝きが見える。",
   "ko_candidate": "검은 안개 같은 거인｡ 그 중심부에 마력의 빛이 보인다｡"
  },
  {
   "id": 35829,
   "key": "D1313ru.txt:417",
   "file": "D1313ru.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あそこが魔法陣で組まれた『コクピット』だ。",
   "ko_candidate": "저기가 마법진으로 짜인 『콕핏』이다｡"
  },
  {
   "id": 35830,
   "key": "D1313ru.txt:418",
   "file": "D1313ru.txt",
   "line": 418,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『核』があるのならば、この技で滅ぼせない道理はない！",
   "ko_candidate": "『핵』이 있다면､ 이 기술로 멸망시키지 못할 이유가 없다!"
  },
  {
   "id": 35831,
   "key": "D1313ru.txt:422",
   "file": "D1313ru.txt",
   "line": 422,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベインッッッッ！」",
   "ko_candidate": "「데몬베인!」"
  },
  {
   "id": 35832,
   "key": "D1313ru.txt:425",
   "file": "D1313ru.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い靄の巨人が、こっちを見上げた。",
   "ko_candidate": "검은 안개의 거인이､ 이쪽을 올려다봤다｡"
  },
  {
   "id": 35833,
   "key": "D1313ru.txt:426",
   "file": "D1313ru.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蝿の群れで造られた偽のヒト型なのだが、確かにそういう動作をした。",
   "ko_candidate": "파리 무리로 만들어진 가짜 사람 형태지만､ 확실히 그런 동작을 했다｡"
  },
  {
   "id": 35834,
   "key": "D1313ru.txt:428",
   "file": "D1313ru.txt",
   "line": 428,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、もう遅い。",
   "ko_candidate": "하지만､ 이미 늦었다｡"
  },
  {
   "id": 35835,
   "key": "D1313ru.txt:431",
   "file": "D1313ru.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚部シールドのエネルギーを解放して――宙を蹴る。",
   "ko_candidate": "다리부 실드의 에너지를 해방하고――허공을 찬다｡"
  },
  {
   "id": 35836,
   "key": "D1313ru.txt:433",
   "file": "D1313ru.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは蝿の巨人めがけて、急降下する！",
   "ko_candidate": "데몬베인은 파리 거인을 향해､ 급강하한다!"
  },
  {
   "id": 35837,
   "key": "D1313ru.txt:434",
   "file": "D1313ru.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "唸る右掌を突き出した。",
   "ko_candidate": "윙윙거리는 오른손바닥을 내밀었다｡"
  },
  {
   "id": 35838,
   "key": "D1313ru.txt:442",
   "file": "D1313ru.txt",
   "line": 442,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「渇かず飢えず、無に還れ――！」",
   "ko_candidate": "「목마르지 않고 배고프지 않으며､ 무로 돌아가라――!」"
  },
  {
   "id": 35839,
   "key": "D1313ru.txt:446",
   "file": "D1313ru.txt",
   "line": 446,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アタシが……アタシがこんなところで滅びるなんて……そんなことが許されてたまるかぁぁぁぁぁぁぁぁ！」",
   "ko_candidate": "「내가… 내가 이런 곳에서 멸망한다니… 그런 일이 용납될 리가 없어어어어어어어어!」"
  },
  {
   "id": 35840,
   "key": "D1313ru.txt:449",
   "file": "D1313ru.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスは絶叫しながら、再び怨霊の呪弾を生み出そうとした。",
   "ko_candidate": "티베리우스는 절규하며､ 다시 원령의 저주탄을 만들어내려 했다｡"
  },
  {
   "id": 35841,
   "key": "D1313ru.txt:450",
   "file": "D1313ru.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが既にデモンベインは、蝿の巨人の懐まで接近していた。",
   "ko_candidate": "하지만 이미 데몬베인은､ 파리 거인의 품까지 접근해 있었다｡"
  },
  {
   "id": 35842,
   "key": "D1313ru.txt:451",
   "file": "D1313ru.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右掌をコクピットへと押し当てる。",
   "ko_candidate": "오른손바닥을 콕핏에 밀어붙인다｡"
  },
  {
   "id": 35843,
   "key": "D1313ru.txt:457",
   "file": "D1313ru.txt",
   "line": 457,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ」",
   "ko_candidate": "「아」"
  },
  {
   "id": 35844,
   "key": "D1313ru.txt:460",
   "file": "D1313ru.txt",
   "line": 460,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "解き放たれる、崩壊の波紋。",
   "ko_candidate": "풀려나는､ 붕괴의 파문｡"
  },
  {
   "id": 35845,
   "key": "D1313ru.txt:464",
   "file": "D1313ru.txt",
   "line": 464,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「レムリア・インパクト！」",
   "ko_candidate": "「레무리아 임팩트!」"
  },
  {
   "id": 35846,
   "key": "D1313ru.txt:475",
   "file": "D1313ru.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "字祷子――魔力の源、情報の源を、激震させる。",
   "ko_candidate": "자도자――마력의 근원､ 정보의 근원을､ 격진시킨다｡"
  },
  {
   "id": 35847,
   "key": "D1313ru.txt:476",
   "file": "D1313ru.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振動する因子はその運動を無限に速め、無限の熱量を生み出した。",
   "ko_candidate": "진동하는 인자는 그 운동을 무한히 빠르게 하여､ 무한의 열량을 만들어냈다｡"
  },
  {
   "id": 35848,
   "key": "D1313ru.txt:477",
   "file": "D1313ru.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩壊が始まる。",
   "ko_candidate": "붕괴가 시작된다｡"
  },
  {
   "id": 35849,
   "key": "D1313ru.txt:481",
   "file": "D1313ru.txt",
   "line": 481,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……アアあ…… ア――――――!?」",
   "ko_candidate": "「아… 아아아… 아――――――!?」"
  },
  {
   "id": 35850,
   "key": "D1313ru.txt:485",
   "file": "D1313ru.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呑み込む。",
   "ko_candidate": "삼켜버린다｡"
  },
  {
   "id": 35851,
   "key": "D1313ru.txt:486",
   "file": "D1313ru.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩壊が、蝿の巨人を喰らい尽くす。",
   "ko_candidate": "붕괴가､ 파리 거인을 먹어치운다｡"
  },
  {
   "id": 35852,
   "key": "D1313ru.txt:487",
   "file": "D1313ru.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その存在の総てを否定すべく、無限熱量を以て、滅ぼし尽くす。",
   "ko_candidate": "그 존재의 모든 것을 부정하기 위해､ 무한 열량으로､ 멸망시켜버린다｡"
  },
  {
   "id": 35853,
   "key": "D1313ru.txt:488",
   "file": "D1313ru.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一切を無に還す。",
   "ko_candidate": "일체를 무로 돌린다｡"
  },
  {
   "id": 35854,
   "key": "D1313ru.txt:492",
   "file": "D1313ru.txt",
   "line": 492,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「昇華！」",
   "ko_candidate": "「승화!」"
  },
  {
   "id": 35855,
   "key": "D1313ru.txt:495",
   "file": "D1313ru.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昇滅させる。",
   "ko_candidate": "승멸시킨다｡"
  }
 ]
}