{
 "packet": "ep_al01_09",
 "scene": "ep_al01",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "魔導書": "마도서",
  "ネクロノミコン": "네크로노미콘"
 },
 "items": [
  {
   "id": 49386,
   "key": "ep_al01.txt:1538",
   "file": "ep_al01.txt",
   "line": 1538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "図書館の奥へ奥へと進む。",
   "ko_candidate": "도서관의 안쪽으로 안쪽으로 나아간다｡"
  },
  {
   "id": 49387,
   "key": "ep_al01.txt:1539",
   "file": "ep_al01.txt",
   "line": 1539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "妖気の流れに変化が生じた。",
   "ko_candidate": "요기의 흐름에 변화가 생겼다｡"
  },
  {
   "id": 49388,
   "key": "ep_al01.txt:1552",
   "file": "ep_al01.txt",
   "line": 1552,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "突然、何処からともなく、魔導書のページが嵐に乗って吹き荒れた。",
   "ko_candidate": "갑자기､ 어디선가､ 마도서의 페이지가 폭풍을 타고 휘몰아쳤다｡"
  },
  {
   "id": 49389,
   "key": "ep_al01.txt:1553",
   "file": "ep_al01.txt",
   "line": 1553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "妖気を孕む竜巻が、図書館を蹂躙する。",
   "ko_candidate": "요기를 품은 회오리가､ 도서관을 유린한다｡"
  },
  {
   "id": 49390,
   "key": "ep_al01.txt:1555",
   "file": "ep_al01.txt",
   "line": 1555,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "意に介さず、その只中に身を投じる。",
   "ko_candidate": "개의치 않고､ 그 한가운데로 몸을 던진다｡"
  },
  {
   "id": 49391,
   "key": "ep_al01.txt:1566",
   "file": "ep_al01.txt",
   "line": 1566,
   "speaker": "アル（回想）",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「時が来れば、我等は必ず巡り逢う」",
   "ko_candidate": "「때가 오면､ 우리는 반드시 만나게 된다」"
  },
  {
   "id": 49392,
   "key": "ep_al01.txt:1574",
   "file": "ep_al01.txt",
   "line": 1574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界はループしていた。",
   "ko_candidate": "세계는 순환하고 있었다｡"
  },
  {
   "id": 49393,
   "key": "ep_al01.txt:1575",
   "file": "ep_al01.txt",
   "line": 1575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺たちもループしていた。",
   "ko_candidate": "우리들도 순환하고 있었다｡"
  },
  {
   "id": 49394,
   "key": "ep_al01.txt:1576",
   "file": "ep_al01.txt",
   "line": 1576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だったら――例えばだ。",
   "ko_candidate": "그렇다면――예를 들어｡"
  },
  {
   "id": 49395,
   "key": "ep_al01.txt:1578",
   "file": "ep_al01.txt",
   "line": 1578,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "例えば――厳密な意味において、アブドゥル・アルハザードは『ネクロノミコン』の筆者では無いとしたら。",
   "ko_candidate": "예를 들어――엄밀한 의미에서､ 압둘 알하자드는 『네크로노미콘』의 저자가 아니라고 한다면｡"
  },
  {
   "id": 49396,
   "key": "ep_al01.txt:1580",
   "file": "ep_al01.txt",
   "line": 1580,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "例えば――何かの『書』を元にしたのだとしたら。",
   "ko_candidate": "예를 들어――어떤 『서』를 바탕으로 했다고 한다면｡"
  },
  {
   "id": 49397,
   "key": "ep_al01.txt:1581",
   "file": "ep_al01.txt",
   "line": 1581,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "例えば、それは――如何なる次元から、如何なる時間から来たとも知れぬ、窮極の魔導書だとしたら。",
   "ko_candidate": "예를 들어､ 그것이――어떤 차원에서､ 어떤 시간에서 왔는지도 모를､ 궁극의 마도서라고 한다면｡"
  },
  {
   "id": 49398,
   "key": "ep_al01.txt:1588",
   "file": "ep_al01.txt",
   "line": 1588,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "剣指を作り、五芒星形の印を宙に描く。",
   "ko_candidate": "검지를 만들어､ 오망성형의 인을 허공에 그린다｡"
  },
  {
   "id": 49399,
   "key": "ep_al01.txt:1589",
   "file": "ep_al01.txt",
   "line": 1589,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔法陣を光が奔り、爆砕した。",
   "ko_candidate": "마법진을 빛이 달려､ 폭쇄했다｡"
  },
  {
   "id": 49400,
   "key": "ep_al01.txt:1590",
   "file": "ep_al01.txt",
   "line": 1590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "荒れ狂うページの嵐の、中枢を穿つ。",
   "ko_candidate": "광포한 페이지의 폭풍의､ 중추를 뚫는다｡"
  },
  {
   "id": 49401,
   "key": "ep_al01.txt:1604",
   "file": "ep_al01.txt",
   "line": 1604,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "連鎖するが如く、より大きな爆発が、図書館を揺るがした。",
   "ko_candidate": "연쇄하듯､ 더 큰 폭발이､ 도서관을 뒤흔들었다｡"
  },
  {
   "id": 49402,
   "key": "ep_al01.txt:1613",
   "file": "ep_al01.txt",
   "line": 1613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "嵐が砕け――",
   "ko_candidate": "폭풍이 부서지고――"
  },
  {
   "id": 49403,
   "key": "ep_al01.txt:1614",
   "file": "ep_al01.txt",
   "line": 1614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "静寂に包まれた図書館に、魔導書の紙片が舞い散った。",
   "ko_candidate": "정적에 휩싸인 도서관에､ 마도서의 종이 조각이 흩날렸다｡"
  },
  {
   "id": 49404,
   "key": "ep_al01.txt:1616",
   "file": "ep_al01.txt",
   "line": 1616,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "はらり、はらりと。",
   "ko_candidate": "살랑､ 살랑｡"
  },
  {
   "id": 49405,
   "key": "ep_al01.txt:1617",
   "file": "ep_al01.txt",
   "line": 1617,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "花びらの様に。",
   "ko_candidate": "꽃잎처럼｡"
  },
  {
   "id": 49406,
   "key": "ep_al01.txt:1618",
   "file": "ep_al01.txt",
   "line": 1618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "酷く、幻想的な光景だった。",
   "ko_candidate": "몹시､ 환상적인 광경이었다｡"
  },
  {
   "id": 49407,
   "key": "ep_al01.txt:1625",
   "file": "ep_al01.txt",
   "line": 1625,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして――花と舞い散る断片の向こう。",
   "ko_candidate": "그리고――꽃처럼 흩날리는 파편 너머｡"
  },
  {
   "id": 49408,
   "key": "ep_al01.txt:1626",
   "file": "ep_al01.txt",
   "line": 1626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "図書館の最奥。",
   "ko_candidate": "도서관의 가장 안쪽｡"
  },
  {
   "id": 49409,
   "key": "ep_al01.txt:1633",
   "file": "ep_al01.txt",
   "line": 1633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "時が来れば、必ず――",
   "ko_candidate": "때가 오면､ 반드시――"
  },
  {
   "id": 49410,
   "key": "ep_al01.txt:1644",
   "file": "ep_al01.txt",
   "line": 1644,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "記憶の鍵が、解き放たれる。",
   "ko_candidate": "기억의 열쇠가､ 풀려난다｡"
  },
  {
   "id": 49411,
   "key": "ep_al01.txt:1645",
   "file": "ep_al01.txt",
   "line": 1645,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "パズルの、最後のパーツが、組み合わさる。",
   "ko_candidate": "퍼즐의 마지막 조각이 맞춰진다｡"
  },
  {
   "id": 49412,
   "key": "ep_al01.txt:1647",
   "file": "ep_al01.txt",
   "line": 1647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "居た。",
   "ko_candidate": "있었다｡"
  },
  {
   "id": 49413,
   "key": "ep_al01.txt:1648",
   "file": "ep_al01.txt",
   "line": 1648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "其処に、確かに、居た。",
   "ko_candidate": "그곳에､ 분명히､ 있었다｡"
  },
  {
   "id": 49414,
   "key": "ep_al01.txt:1650",
   "file": "ep_al01.txt",
   "line": 1650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの時と同じ――",
   "ko_candidate": "그때와 똑같이――"
  },
  {
   "id": 49415,
   "key": "ep_al01.txt:1651",
   "file": "ep_al01.txt",
   "line": 1651,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "初めての魔導書閲覧の日、",
   "ko_candidate": "처음으로 마도서를 열람한 날､"
  },
  {
   "id": 49416,
   "key": "ep_al01.txt:1652",
   "file": "ep_al01.txt",
   "line": 1652,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "初めて怪異と遭遇した、あの日。",
   "ko_candidate": "처음으로 괴이와 조우했던､ 그날｡"
  },
  {
   "id": 49417,
   "key": "ep_al01.txt:1653",
   "file": "ep_al01.txt",
   "line": 1653,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの時と、同じだった。",
   "ko_candidate": "그때와 똑같았다｡"
  },
  {
   "id": 49418,
   "key": "ep_al01.txt:1655",
   "file": "ep_al01.txt",
   "line": 1655,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "妖気に充ち、夢幻とたゆたう図書館の中、",
   "ko_candidate": "요기로 가득하고 몽환적으로 흔들리는 도서관 안에서､"
  },
  {
   "id": 49419,
   "key": "ep_al01.txt:1656",
   "file": "ep_al01.txt",
   "line": 1656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔導書の断片が華と舞い散る、幻想的な光景の真ん中で――",
   "ko_candidate": "마도서의 단편이 꽃처럼 흩날리는 환상적인 광경 한가운데서――"
  },
  {
   "id": 49420,
   "key": "ep_al01.txt:1658",
   "file": "ep_al01.txt",
   "line": 1658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は、その怪異と再会した。",
   "ko_candidate": "나는 그 괴이와 재회했다｡"
  },
  {
   "id": 49421,
   "key": "ep_al01.txt:1663",
   "file": "ep_al01.txt",
   "line": 1663,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ラテン語版が大学に保管されているのは知っていたけどさ……」",
   "ko_candidate": "「라틴어판이 대학에 보관되어 있다는 건 알고 있었지만……」"
  },
  {
   "id": 49422,
   "key": "ep_al01.txt:1672",
   "file": "ep_al01.txt",
   "line": 1672,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ」 振り返る怪異。",
   "ko_candidate": "「…………읏」"
  },
  {
   "id": 49423,
   "key": "ep_al01.txt:1677",
   "file": "ep_al01.txt",
   "line": 1677,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "靡く銀の髪。",
   "ko_candidate": "돌아보는 괴이｡"
  },
  {
   "id": 49424,
   "key": "ep_al01.txt:1678",
   "file": "ep_al01.txt",
   "line": 1678,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "暗がりでも映える白い肌。",
   "ko_candidate": "나부끼는 은빛 머리카락｡"
  },
  {
   "id": 49425,
   "key": "ep_al01.txt:1679",
   "file": "ep_al01.txt",
   "line": 1679,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、吸い込まれそうな翡翠の瞳。",
   "ko_candidate": "어둠 속에서도 빛나는 하얀 피부｡"
  }
 ]
}