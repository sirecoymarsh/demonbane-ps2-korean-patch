   "line": 1566,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……どうしました？ 何か不満でも？」",
   "ko_candidate": "「……왜 그러시죠? 뭔가 불만이라도?」"
  },
  {
   "id": 4304,
   "key": "D0401.txt:1572",
   "file": "D0401.txt",
   "line": 1572,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………………………………………」",
   "ko_candidate": "「…………………………………………」"
  },
  {
   "id": 4305,
