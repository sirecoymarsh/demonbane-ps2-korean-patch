   "file": "D0401.txt",
   "line": 1577,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……どうした？ 何を呆けておる？」",
   "ko_candidate": "「……왜 그래? 뭘 멍하니 있는 거야?」"
  },
  {
   "id": 4306,
   "key": "D0401.txt:1583",
