   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頬を、熱いものが、伝った。",
   "ko_candidate": "뺨을､ 뜨거운 것이､ 타고 흘렀다｡"
  },
  {
   "id": 4308,
   "key": "D0401.txt:1597",
   "file": "D0401.txt",
   "line": 1597,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「なっ……大十字さんっ？」",
   "ko_candidate": "「뭐……다이쥬지 씨!?」"
  },
  {
   "id": 4309,
   "key": "D0401.txt:1602",
