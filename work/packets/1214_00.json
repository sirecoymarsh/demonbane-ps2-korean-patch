 "items": [
  {
   "id": 30241,
   "key": "D1214le.txt:7",
   "file": "D1214le.txt",
   "line": 7,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎とクラウディウスを追って、翔ぼうとするライカ。",
   "ko_candidate": "다이쥬지 쿠로와 클라우디우스를 쫓아 날아오르려는 라이카｡"
  },
  {
   "id": 30242,
   "key": "D1214le.txt:9",
   "file": "D1214le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこに触手を放ちながら、飛びかかるティベリウス。",
   "ko_candidate": "그곳에 촉수를 뻗으며 덤벼드는 티베리우스｡"
  },
  {
   "id": 30243,
   "key": "D1214le.txt:10",
   "file": "D1214le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舌打ちしつつ、触手の嵐をかわす。",
   "ko_candidate": "혀를 차며 촉수의 폭풍을 피한다｡"
  },
  {
   "id": 30244,
   "key": "D1214le.txt:16",
   "file": "D1214le.txt",
   "line": 16,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だぁぁから、アンタの相手はアタシなのよッ！」",
   "ko_candidate": "「그러니까､ 네 상대는 나라고!」"
  },
  {
   "id": 30245,
   "key": "D1214le.txt:19",
   "file": "D1214le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカの心に焦りが生じる。",
   "ko_candidate": "라이카의 마음에 초조함이 생긴다｡"
  },
  {
   "id": 30246,
   "key": "D1214le.txt:21",
   "file": "D1214le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの妨害もあるが、今の状態では、まともな速度の飛行は不可能だ。それくらいにダメージは深刻だ。クラウディウスのスピードには付いていけない。",
   "ko_candidate": "티베리우스의 방해도 있지만､ 지금 상태로는 제대로 된 속도로 비행하는 것이 불가능하다｡ 그만큼 데미지가 심각하다｡ 클라우디우스의 속도를 따라갈 수 없다｡"
  },
  {
   "id": 30247,
   "key": "D1214le.txt:26",
   "file": "D1214le.txt",
   "line": 26,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（何とかしないと……九郎ちゃんが危ない！）",
   "ko_candidate": "（어떻게든 해야 해… 쿠로 군이 위험해!）"
  },
  {
   "id": 30248,
   "key": "D1214le.txt:30",
   "file": "D1214le.txt",
   "line": 30,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあさあさあさあさあ！　もっと足掻け！　足掻きなさいよっ！」",
   "ko_candidate": "「자아 자아 자아 자아 자아! 더 발버둥 쳐! 발버둥 쳐 봐!」"
  },
  {
   "id": 30249,
   "key": "D1214le.txt:35",
   "file": "D1214le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触手が咲き乱れる。",
   "ko_candidate": "촉수가 만발한다｡"
  },
  {
   "id": 30250,
   "key": "D1214le.txt:37",
   "file": "D1214le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "骨の雨が降る。",
   "ko_candidate": "뼈의 비가 내린다｡"
  },
  {
   "id": 30251,
   "key": "D1214le.txt:38",
   "file": "D1214le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "臓腑の鞭が轟音と共に振り下ろされる。",
   "ko_candidate": "내장의 채찍이 굉음과 함께 내리쳐진다｡"
  },
  {
   "id": 30252,
   "key": "D1214le.txt:40",
   "file": "D1214le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げ惑う間にも、全身が悲鳴を上げている。",
   "ko_candidate": "도망치는 사이에도 온몸이 비명을 지르고 있다｡"
  },
  {
   "id": 30253,
   "key": "D1214le.txt:41",
   "file": "D1214le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識を保つもの辛い。",
   "ko_candidate": "의식을 유지하는 것조차 힘들다｡"
  },
  {
   "id": 30254,
   "key": "D1214le.txt:42",
   "file": "D1214le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "このままでは――！",
   "ko_candidate": "이대로라면--!"
  },
  {
   "id": 30255,
   "key": "D1214le.txt:48",
   "file": "D1214le.txt",
   "line": 48,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ジェフリィィィィ・コォォォォムズッッッッ！」",
   "ko_candidate": "「제프리이이이 코오오오옴즈!」"
  },
  {
   "id": 30256,
   "key": "D1214le.txt:61",
   "file": "D1214le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意味不明な絶叫と共に、ロケット弾がティベリウスに直撃する。",
   "ko_candidate": "의미 불명의 절규와 함께 로켓탄이 티베리우스에게 직격한다｡"
  },
  {
   "id": 30257,
   "key": "D1214le.txt:62",
   "file": "D1214le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉片を撒き散らし、ティベリウスは地面を転がった。",
   "ko_candidate": "살점을 흩뿌리며 티베리우스는 땅을 굴렀다｡"
  },
  {
   "id": 30258,
   "key": "D1214le.txt:67",
   "file": "D1214le.txt",
   "line": 67,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、な、何なのっ!?」",
   "ko_candidate": "「뭐､ 뭐､ 뭐야 이건!?」"
  },
  {
   "id": 30259,
   "key": "D1214le.txt:79",
   "file": "D1214le.txt",
   "line": 79,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「我、埋葬にあたわず！」",
   "ko_candidate": "「나､ 매장할 수 없다!」"
  },
  {
   "id": 30260,
   "key": "D1214le.txt:88",
   "file": "D1214le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらに追撃。",
   "ko_candidate": "추가 공격｡"
  },
  {
   "id": 30261,
   "key": "D1214le.txt:89",
   "file": "D1214le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力の込められた砲撃が爆発。ティベリウスを呑み込んだ。",
   "ko_candidate": "마력이 담긴 포격이 폭발｡ 티베리우스를 삼켰다｡"
  },
  {
   "id": 30262,
   "key": "D1214le.txt:93",
   "file": "D1214le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆風から身を守りながら、ライカは背後を振り返る。",
   "ko_candidate": "폭풍으로부터 몸을 지키며 라이카는 뒤를 돌아본다｡"
  },
  {
   "id": 30263,
   "key": "D1214le.txt:102",
   "file": "D1214le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーに跨り、ギターケース型バズーカを構えたドクター・ウェストと、その背後に跨り、『我、埋葬にあたわず』を構えたエルザが居た。",
   "ko_candidate": "헌팅 호러에 올라탄 채 기타 케이스형 바주카를 든 닥터 웨스트와､ 그 뒤에 올라탄 채 『나､ 매장할 수 없다』를 든 엘자가 있었다｡"
  },
  {
   "id": 30264,
   "key": "D1214le.txt:111",
   "file": "D1214le.txt",
   "line": 111,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待たせたな、メタトロン！　ハンティング・ホラーの調整は完璧である！」",
   "ko_candidate": "「기다리게 했군､ 메타트론! 헌팅 호러의 조정은 완벽하다!」"
  },
  {
   "id": 30265,
   "key": "D1214le.txt:116",
   "file": "D1214le.txt",
   "line": 116,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ナイス・タイミングです！　神様っ！」",
   "ko_candidate": "「나이스 타이밍이에요! 신님!」"
  },
  {
   "id": 30266,
   "key": "D1214le.txt:119",
   "file": "D1214le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカは神に感謝した。",
   "ko_candidate": "라이카는 신에게 감사했다｡"
  },
  {
   "id": 30267,
   "key": "D1214le.txt:120",
   "file": "D1214le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "すぐさま、ハンティング・ホラーの元へと駈け寄る。",
   "ko_candidate": "곧바로 헌팅 호러 쪽으로 달려간다｡"
  },
  {
   "id": 30268,
   "key": "D1214le.txt:125",
   "file": "D1214le.txt",
   "line": 125,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「この……裏切り者どもがぁぁぁ……！」",
   "ko_candidate": "「이… 배신자들아아아…!」"
  },
  {
   "id": 30269,
   "key": "D1214le.txt:128",
   "file": "D1214le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の中から、炎に包まれたティベリウスが現れる。",
   "ko_candidate": "폭발 속에서 불길에 휩싸인 티베리우스가 나타난다｡"
  },
  {
   "id": 30270,
   "key": "D1214le.txt:129",
   "file": "D1214le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バイクから降り、ドクター・ウェストもエルザも、バズーカを構え直す。",
   "ko_candidate": "바이크에서 내린 닥터 웨스트와 엘자도 바주카를 다시 겨눈다｡"
  },
  {
   "id": 30271,
   "key": "D1214le.txt:130",
   "file": "D1214le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空いたバイクに、ライカは跨った。",
   "ko_candidate": "비어있는 바이크에 라이카가 올라탔다｡"
  },
  {
   "id": 30272,
   "key": "D1214le.txt:135",
   "file": "D1214le.txt",
   "line": 135,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……少しの間、時間稼ぎお願いできます？」",
   "ko_candidate": "「…잠시 동안 시간을 벌어주실 수 있나요?」"
  },
  {
   "id": 30273,
   "key": "D1214le.txt:139",
   "file": "D1214le.txt",
   "line": 139,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「良かろう。我輩のロックを見せてやるのである」",
   "ko_candidate": "「좋다｡ 내 록을 보여주마」"
  },
  {
   "id": 30274,
   "key": "D1214le.txt:147",
   "file": "D1214le.txt",
   "line": 147,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「レッツ・プレイ！」",
   "ko_candidate": "「렛츠 플레이!」"
  },
  {
   "id": 30275,
   "key": "D1214le.txt:154",
   "file": "D1214le.txt",
   "line": 154,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「腐殺ァァァァァァァァァァァァァ！」",
   "ko_candidate": "「부살아아아아아아아아아아아아!」"
  },
  {
   "id": 30276,
   "key": "D1214le.txt:157",
   "file": "D1214le.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの砲口が同時に火を噴く。",
   "ko_candidate": "두 개의 포구가 동시에 불을 뿜는다｡"
  },
  {
   "id": 30277,
   "key": "D1214le.txt:160",
   "file": "D1214le.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避難所を半壊させるほどの大爆発の中から、ライカを乗せたハンティング・ホラーは翔び出す。",
   "ko_candidate": "대피소를 반쯤 무너뜨릴 정도의 대폭발 속에서 라이카를 태운 헌팅 호러가 날아오른다｡"
  },
  {
   "id": 30278,
   "key": "D1214le.txt:162",
   "file": "D1214le.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが開けた天井の穴を通過する。",
   "ko_candidate": "클라우디우스가 열어놓은 천장의 구멍을 통과한다｡"
  },
  {
   "id": 30279,
   "key": "D1214le.txt:164",
   "file": "D1214le.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎がその後を追い、一帯を炎に包み込む。",
   "ko_candidate": "폭염이 그 뒤를 쫓아 일대를 불길로 휩싸버린다｡"
  }
 ]
}