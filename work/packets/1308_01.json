   "file": "D1308al.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう、無限の輪に囚われている。",
   "ko_candidate": "그래､ 무한의 고리에 갇혀 있다｡"
  },
  {
   "id": 33585,
   "key": "D1308al.txt:126",
   "file": "D1308al.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それでも我等は……",
   "ko_candidate": "하지만､ 그래도 우리는……"
  },
  {
   "id": 33586,
   "key": "D1308al.txt:127",
   "file": "D1308al.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否、だからこそ我等は……",
   "ko_candidate": "아니､ 그렇기에 우리는……"
  },
  {
   "id": 33587,
   "key": "D1308al.txt:133",
   "file": "D1308al.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、もう止そう。",
   "ko_candidate": "아니､ 이제 그만두자｡"
  },
  {
   "id": 33588,
   "key": "D1308al.txt:135",
   "file": "D1308al.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "終わる妾にとっては、もはや総てが関係の無い事だ。",
   "ko_candidate": "끝나가는 첩에게는､ 이제 모든 것이 무관한 일이다｡"
  },
  {
   "id": 33589,
   "key": "D1308al.txt:136",
   "file": "D1308al.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今更、何を――。",
   "ko_candidate": "이제 와서､ 무엇을――｡"
  },
  {
   "id": 33590,
   "key": "D1308al.txt:138",
   "file": "D1308al.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう瞳を開ける事も億劫だ。",
   "ko_candidate": "이제 눈을 뜨는 것조차 귀찮다｡"
  },
  {
   "id": 33591,
   "key": "D1308al.txt:139",
   "file": "D1308al.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸の空洞を侵す寒さは厳しく、痛痒ですらあるが仕方あるまい。",
   "ko_candidate": "가슴의 공허를 침범하는 추위는 혹독하고､ 아프기까지 하지만 어쩔 수 없겠지｡"
  },
  {
   "id": 33592,
   "key": "D1308al.txt:142",
   "file": "D1308al.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳を閉じて、総てを鎖そう。",
   "ko_candidate": "눈을 감고､ 모든 것을 잠그자｡"
  },
  {
   "id": 33593,
   "key": "D1308al.txt:144",
   "file": "D1308al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "果て無い闇の彼方。",
   "ko_candidate": "끝없는 어둠의 저편｡"
  },
  {
   "id": 33594,
   "key": "D1308al.txt:145",
   "file": "D1308al.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も無い場所へ。",
   "ko_candidate": "아무것도 없는 곳으로｡"
  },
  {
   "id": 33595,
   "key": "D1308al.txt:146",
   "file": "D1308al.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "完全な無へ。",
   "ko_candidate": "완전한 무로｡"
  },
  {
   "id": 33596,
   "key": "D1308al.txt:148",
   "file": "D1308al.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それで終わる。 終われるのだ――",
   "ko_candidate": "그걸로 끝난다｡{BGM_VOL(\"\",3000,0);}"
  },
  {
   "id": 33597,
   "key": "D1308al.txt:170",
   "file": "D1308al.txt",
   "line": 170,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何故」",
   "ko_candidate": "끝낼 수 있는 것이다―― 「……왜」"
  },
  {
   "id": 33598,
   "key": "D1308al.txt:174",
   "file": "D1308al.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鎖せなかった。",
   "ko_candidate": "사슬로 묶지 못했다｡"
  },
  {
   "id": 33599,
   "key": "D1308al.txt:178",
   "file": "D1308al.txt",
   "line": 178,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何故だ」",
   "ko_candidate": "「……왜지」"
  },
  {
   "id": 33600,
   "key": "D1308al.txt:181",
   "file": "D1308al.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "終わる事すら赦されないのか。",
   "ko_candidate": "끝내는 것조차 허락되지 않는 건가｡"
  },
  {
   "id": 33601,
   "key": "D1308al.txt:185",
   "file": "D1308al.txt",
   "line": 185,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何故、汝等は」",
   "ko_candidate": "「……왜､ 너희들은」"
  },
  {
   "id": 33602,
   "key": "D1308al.txt:188",
   "file": "D1308al.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛む。",
   "ko_candidate": "아프다｡"
  },
  {
   "id": 33603,
   "key": "D1308al.txt:189",
   "file": "D1308al.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸がやけに痛む。",
   "ko_candidate": "가슴이 유난히 아프다｡"
  },
  {
   "id": 33604,
   "key": "D1308al.txt:190",
   "file": "D1308al.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "穴が空いているからなのか。",
   "ko_candidate": "구멍이 뚫려 있어서인가｡"
  },
  {
   "id": 33605,
   "key": "D1308al.txt:191",
   "file": "D1308al.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛む胸を押さえ、妾は振り返る。",
   "ko_candidate": "아픈 가슴을 누르며､ 첩은 뒤돌아본다｡"
  },
  {
   "id": 33606,
   "key": "D1308al.txt:196",
   "file": "D1308al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "骸が",
   "ko_candidate": "시체가"
  },
  {
   "id": 33607,
   "key": "D1308al.txt:197",
   "file": "D1308al.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦士達が",
   "ko_candidate": "전사들이"
  },
  {
   "id": 33608,
   "key": "D1308al.txt:198",
   "file": "D1308al.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "我が主達が、妾を呼び止める。",
   "ko_candidate": "내 주군들이､ 첩을 불러 세운다｡"
  },
  {
   "id": 33609,
   "key": "D1308al.txt:200",
   "file": "D1308al.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其れは聲無き聲。",
   "ko_candidate": "그것은 소리 없는 소리｡"
  },
  {
   "id": 33610,
   "key": "D1308al.txt:201",
   "file": "D1308al.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "されど消えない聲。",
   "ko_candidate": "하지만 사라지지 않는 소리｡"
  },
  {
   "id": 33611,
   "key": "D1308al.txt:202",
   "file": "D1308al.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "消せない聲。",
   "ko_candidate": "지울 수 없는 소리｡"
  },
  {
   "id": 33612,
   "key": "D1308al.txt:206",
   "file": "D1308al.txt",
   "line": 206,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何故、 終わらせてはくれんのだ？」",
   "ko_candidate": "「왜､ 끝내게 해주지 않는 거지?」"
  },
  {
   "id": 33613,
   "key": "D1308al.txt:214",
   "file": "D1308al.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この場に留まり続けてなお、",
   "ko_candidate": "이곳에 계속 머물러 있으면서､"
  },
  {
   "id": 33614,
   "key": "D1308al.txt:215",
   "file": "D1308al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾に呪縛され続けてなお、",
   "ko_candidate": "첩에게 계속 주박되어 있으면서､"
  },
  {
   "id": 33615,
   "key": "D1308al.txt:216",
   "file": "D1308al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何故。何故。何故。",
   "ko_candidate": "왜｡ 왜｡ 왜｡"
  },
  {
   "id": 33616,
   "key": "D1308al.txt:218",
   "file": "D1308al.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目の前に血塗られた路が伸びる。",
   "ko_candidate": "눈앞에 피로 물든 길이 뻗어 있다｡"
  },
  {
   "id": 33617,
   "key": "D1308al.txt:219",
   "file": "D1308al.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾が歩んだ闘争の路。",
   "ko_candidate": "첩이 걸어온 투쟁의 길｡"
  },
  {
   "id": 33618,
   "key": "D1308al.txt:220",
   "file": "D1308al.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "命の華の輝きで、征く先を照らす修羅の路。",
   "ko_candidate": "생명의 꽃의 빛남으로､ 나아갈 길을 비추는 수라의 길｡"
  },
  {
   "id": 33619,
   "key": "D1308al.txt:222",
   "file": "D1308al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠くまで続いている。",
   "ko_candidate": "멀리까지 이어져 있다｡"
  },
  {
   "id": 33620,
   "key": "D1308al.txt:223",
   "file": "D1308al.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだまだ続いている。",
   "ko_candidate": "아직도 계속 이어져 있다｡"
  },
  {
   "id": 33621,
   "key": "D1308al.txt:225",
   "file": "D1308al.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――止めろ。",
   "ko_candidate": "――그만둬｡"
  },
  {
   "id": 33622,
   "key": "D1308al.txt:226",
   "file": "D1308al.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸が痛む。",
   "ko_candidate": "가슴이 아프다｡"
  },
  {
   "id": 33623,
   "key": "D1308al.txt:227",
   "file": "D1308al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛むのだ。",
   "ko_candidate": "아픈 거다｡"
  }
