   "file": "D0756.txt",
   "line": 159,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": ""
  },
  {
   "id": 11657,
   "key": "D0756.txt:164",
   "file": "D0756.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "どうも、どこかの廃ビルらしい。",
