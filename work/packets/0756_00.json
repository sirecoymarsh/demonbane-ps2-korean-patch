   "key": "D0756.txt:207",
   "file": "D0756.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "間違いない……こいつはアルの断片だ。",
   "ko_candidate": ""
  },
  {
   "id": 11666,
   "key": "D0756.txt:221",
   "file": "D0756.txt",
   "line": 221,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「イタクァに連れ去られた時、何があった？」",
   "ko_candidate": ""
  },
