   "file": "D0756.txt",
   "line": 192,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「どうしてこんなところに？」",
   "ko_candidate": ""
  },
  {
   "id": 11663,
   "key": "D0756.txt:200",
   "file": "D0756.txt",
   "line": 200,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「訊きたいのはこっちだ。汝を探してみれば……突然、此処に気配を感じたのだからな。それに――」",
