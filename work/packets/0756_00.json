   "key": "D0756.txt:206",
   "file": "D0756.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アルが俺の目の前に紙束を差し出す。",
