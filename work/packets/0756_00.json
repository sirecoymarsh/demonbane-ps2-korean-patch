  },
  {
   "id": 11649,
   "key": "D0756.txt:125",
   "file": "D0756.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あれ？　何だ？",
   "ko_candidate": ""
  },
  {
   "id": 11650,
   "key": "D0756.txt:126",
   "file": "D0756.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "はっきりと思い出せない。",
   "ko_candidate": ""
  },
  {
   "id": 11651,
   "key": "D0756.txt:129",
   "file": "D0756.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何かとんでもないものを目の当たりにした気がするんだが……",
   "ko_candidate": ""
  },
  {
   "id": 11652,
   "key": "D0756.txt:136",
   "file": "D0756.txt",
   "line": 136,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「大丈夫か？　呆としているようだが」",
   "ko_candidate": ""
  },
  {
   "id": 11653,
   "key": "D0756.txt:141",
   "file": "D0756.txt",
   "line": 141,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「え……？　ああ、心配ない。大丈夫だ」",
   "ko_candidate": ""
  },
  {
   "id": 11654,
   "key": "D0756.txt:144",
   "file": "D0756.txt",
   "line": 144,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「それで……ここは何処だ？ あの変な廊下は……？」",
