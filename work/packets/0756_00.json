   "key": "D0756.txt:64",
   "file": "D0756.txt",
   "line": 64,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「やれやれ…… ようやく目が覚めたか」",
   "ko_candidate": ""
  },
  {
   "id": 11641,
   "key": "D0756.txt:74",
   "file": "D0756.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "……状況が全く掴めない。",
   "ko_candidate": ""
  },
  {
   "id": 11642,
   "key": "D0756.txt:76",
   "file": "D0756.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "起き上がろうとして……身体が鉛みたいに重いのに気づく。",
   "ko_candidate": ""
  },
  {
   "id": 11643,
   "key": "D0756.txt:82",
   "file": "D0756.txt",
   "line": 82,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「な、何だぁ……？」",
   "ko_candidate": ""
  },
  {
   "id": 11644,
   "key": "D0756.txt:90",
   "file": "D0756.txt",
   "line": 90,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「無茶をするな。躰が疲弊している」",
   "ko_candidate": ""
  },
  {
   "id": 11645,
   "key": "D0756.txt:95",
   "file": "D0756.txt",
   "line": 95,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「何で……あっ」",
   "ko_candidate": ""
  },
  {
   "id": 11646,
   "key": "D0756.txt:101",
   "file": "D0756.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "思い出した。",
   "ko_candidate": ""
  },
  {
