   "key": "D0756.txt:165",
   "file": "D0756.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "壊れた壁の隙間から、朝陽が射し込んでくる。",
