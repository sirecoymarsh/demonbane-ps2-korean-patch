   "key": "D0756.txt:225",
   "file": "D0756.txt",
   "line": 225,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「駆けつけてみればイタクァに関する記述と、ついでに逃げたはずのクトゥグアに関する記述の両方を手に持ったまま、気絶している汝が居る」",
   "ko_candidate": ""
  },
  {
   "id": 11668,
   "key": "D0756.txt:236",
   "file": "D0756.txt",
   "line": 236,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「流石の妾にも何の事やら――」",
