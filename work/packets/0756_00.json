  {
   "id": 11655,
   "key": "D0756.txt:154",
   "file": "D0756.txt",
   "line": 154,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……何の話をしておる？」",
   "ko_candidate": ""
  },
  {
   "id": 11656,
