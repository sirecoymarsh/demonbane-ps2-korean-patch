 },
 "items": [
  {
   "id": 35952,
   "key": "D1401al.txt:142",
   "file": "D1401al.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは既に音の領域に留まっていなかったから。",
   "ko_candidate": "이미 소리의 영역에 머물러 있지 않았기 때문이다｡"
  },
  {
   "id": 35953,
   "key": "D1401al.txt:144",
   "file": "D1401al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音を超え、物理を超え、霊域を超えて、魂を破壊してくるような、凄まじい破滅の咆吼。",
   "ko_candidate": "소리를 넘어 물리를 넘어 영역을 넘어 영혼을 파괴하는 듯한 무시무시한 파멸의 포효｡"
  },
  {
   "id": 35954,
   "key": "D1401al.txt:146",
   "file": "D1401al.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空を仰ぐ。",
   "ko_candidate": "하늘을 올려다본다｡"
  },
  {
   "id": 35955,
   "key": "D1401al.txt:147",
   "file": "D1401al.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悍ましく、わななくのは、巨大な巨大な、竜の首の如き無数の触腕。",
   "ko_candidate": "무섭게 떨리는 것은 거대한 거대한､ 용의 머리와 같은 무수한 촉수｡"
  },
  {
   "id": 35956,
   "key": "D1401al.txt:153",
   "file": "D1401al.txt",
   "line": 153,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『夢幻心母』に宿った、街を覆い尽くすほどの巨体が脈動している。",
   "ko_candidate": "『몽환심모』에 깃든､ 도시를 뒤덮을 만큼 거대한 몸체가 맥동하고 있다｡"
  },
  {
   "id": 35957,
   "key": "D1401al.txt:154",
   "file": "D1401al.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な――広大な神の躰に、闇をもたらす躰に、まるで狂った月のような眸が啓いていた。",
   "ko_candidate": "거대한――광대한 신의 몸에､ 어둠을 가져오는 몸에､ 마치 미친 달과 같은 눈동자가 떠올랐다｡"
  },
  {
   "id": 35958,
   "key": "D1401al.txt:155",
   "file": "D1401al.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街を見下ろす。",
   "ko_candidate": "도시를 내려다본다｡"
  },
  {
   "id": 35959,
   "key": "D1401al.txt:157",
   "file": "D1401al.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その眸と視線が合ったとき、その一瞬、ココロが砕け散った。",
   "ko_candidate": "그 눈동자와 시선이 마주쳤을 때､ 그 순간 마음이 산산조각 났다｡"
  },
  {
   "id": 35960,
   "key": "D1401al.txt:158",
   "file": "D1401al.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一度死んで、だが魔術師としての精神力が必死に、自我の欠片を掻き集めた。",
   "ko_candidate": "한 번 죽었다가 마술사로서의 정신력이 필사적으로 자아의 파편을 긁어모았다｡"
  },
  {
   "id": 35961,
   "key": "D1401al.txt:160",
   "file": "D1401al.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "限界を超えてフル稼働する脳が、沸騰するように熱い。",
   "ko_candidate": "한계를 넘어 풀가동하는 뇌가 끓어오르듯 뜨겁다｡"
  },
  {
   "id": 35962,
   "key": "D1401al.txt:161",
   "file": "D1401al.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目からは血涙が伝い、鼻血が噴き出た。",
   "ko_candidate": "눈에서는 피눈물이 흐르고 코피가 터졌다｡"
  },
  {
   "id": 35963,
   "key": "D1401al.txt:164",
   "file": "D1401al.txt",
   "line": 164,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「が……アア……あ……」",
   "ko_candidate": "「크……아아……아……」"
  },
  {
   "id": 35964,
   "key": "D1401al.txt:171",
   "file": "D1401al.txt",
   "line": 171,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！　しっかりしろ…… おのれ！」",
   "ko_candidate": "「쿠로! 정신 차려……이 자식!」"
  },
  {
   "id": 35965,
   "key": "D1401al.txt:183",
   "file": "D1401al.txt",
   "line": 183,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……あ……あああ……！　こ、このプレッシャー……ああああ！」",
   "ko_candidate": "「……아……아아아……! 이､ 이 압박감……아아아아!」"
  },
  {
   "id": 35966,
   "key": "D1401al.txt:192",
   "file": "D1401al.txt",
   "line": 192,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……！ もう、邪神が動き出すのか！」",
   "ko_candidate": "「……! 벌써 사신이 움직이기 시작하는 건가!」"
  },
  {
   "id": 35967,
   "key": "D1401al.txt:206",
   "file": "D1401al.txt",
   "line": 206,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何が…… 何が起こってるんや!?」",
   "ko_candidate": "「뭐､ 뭐가……뭐가 일어나고 있는 거야!?」"
  },
  {
   "id": 35968,
   "key": "D1401al.txt:217",
   "file": "D1401al.txt",
   "line": 217,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これが……邪神……これが……旧支配者……これが……これが……！」",
   "ko_candidate": "「이것이……사신……이것이…… 그레이트 올드 원……이것이……이것이……!」"
  },
  {
   "id": 35969,
   "key": "D1401al.txt:228",
   "file": "D1401al.txt",
   "line": 228,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「瑠璃お嬢様ぁぁぁぁぁぁ！」",
   "ko_candidate": "「루리 아가씨이이이이이이!」"
  },
  {
   "id": 35970,
   "key": "D1401al.txt:233",
   "file": "D1401al.txt",
   "line": 233,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ!?　ソーニャ、それにマコトも！　あなた方無事だったのですね!?」",
   "ko_candidate": "「――――! 소냐､ 그리고 마코토도! 당신들 무사했군요!?」"
  },
  {
   "id": 35971,
   "key": "D1401al.txt:238",
   "file": "D1401al.txt",
   "line": 238,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――はい、それよりも早く退避を。此処は危険です！」",
   "ko_candidate": "「――네､ 그보다 빨리 대피하세요｡ 여긴 위험합니다!」"
  },
  {
   "id": 35972,
   "key": "D1401al.txt:243",
   "file": "D1401al.txt",
   "line": 243,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「で、ですがデモンベインが……」",
   "ko_candidate": "「하､ 하지만 데몬베인이……」"
  },
  {
   "id": 35973,
   "key": "D1401al.txt:253",
   "file": "D1401al.txt",
   "line": 253,
   "speaker": "瑠璃＆ウィンフィールド＆チアキ＆マコト＆ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 35974,
   "key": "D1401al.txt:270",
   "file": "D1401al.txt",
   "line": 270,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「遂に……遂に遂に遂に！　遂に！　『Ｃ計画』が成就する！ それも大導師によってではない！　私の手によってだ！」 「大いなるクトゥルーが！　強壮たるクトゥルーが！　旧支配者たるクトゥルーが、今、私の手中にある！」",
   "ko_candidate": "「드디어……드디어드디어드디어! 드디어! 『C계획』이 성취된다! 그것도 그랜드 마스터가 아닌! 내 손으로 말이다! 위대한 크툴루가! 강건한 크툴루가! 그레이트 올드 원인 크툴루가 지금 내 손안에 있다! 후하하하하하! 그래､ 이제 나는 신과 같은 영역에 서 있는 것이다!」"
  },
  {
   "id": 35975,
   "key": "D1401al.txt:277",
   "file": "D1401al.txt",
   "line": 277,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふはははははは！　そう、今や私は神と同じ領域に立っているのだ！」 氷解した愉悦は、もはや止めようもなく、哄笑となって溢れた。",
   "ko_candidate": "얼어붙었던 환희가 이제는 멈출 수 없이 폭소가 되어 넘쳐났다｡"
  },
  {
   "id": 35976,
   "key": "D1401al.txt:283",
   "file": "D1401al.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "濁流の如く流れ出す哄笑は、理性の仮面に隠した狂気の存在を暴かずにはいられぬ事を、果たしてアウグストゥスは気付いているのだろうか。",
   "ko_candidate": "격류처럼 흘러나오는 폭소는 이성의 가면에 숨긴 광기의 존재를 드러내지 않을 수 없음을､ 과연 아우구스투스는 깨닫고 있을까｡"
  },
  {
   "id": 35977,
   "key": "D1401al.txt:287",
   "file": "D1401al.txt",
   "line": 287,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「制御出来る！　制御出来るぞ！ 神の法則ですら、私は超越した！」",
   "ko_candidate": "「제어할 수 있어! 제어할 수 있다고! 신의 법칙조차 나는 초월했다!」"
  },
  {
   "id": 35978,
   "key": "D1401al.txt:292",
   "file": "D1401al.txt",
   "line": 292,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 35979,
   "key": "D1401al.txt:295",
   "file": "D1401al.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "漲る邪神の力。",
   "ko_candidate": "충만한 사신의 힘｡"
  },
  {
   "id": 35980,
   "key": "D1401al.txt:296",
   "file": "D1401al.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身から溢れ出る神気が、虚空を震撼させた。",
   "ko_candidate": "온몸에서 넘쳐나는 신기가 허공을 진동시켰다｡"
  },
  {
   "id": 35981,
   "key": "D1401al.txt:298",
   "file": "D1401al.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "わななく触腕が統一性を得て、同時に動いた。",
   "ko_candidate": "떨리는 촉수가 통일성을 얻어 동시에 움직였다｡"
  },
  {
   "id": 35982,
   "key": "D1401al.txt:300",
   "file": "D1401al.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜の首が一斉に、眼下のアーカムシティに向けて顎を開く。",
   "ko_candidate": "용의 머리가 일제히 발아래의 아캄시티를 향해 턱을 벌린다｡"
  },
  {
   "id": 35983,
   "key": "D1401al.txt:301",
   "file": "D1401al.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雨となって降り注ぐ強酸性の涎。",
   "ko_candidate": "비가 되어 쏟아지는 강산성의 침｡"
  },
  {
   "id": 35984,
   "key": "D1401al.txt:305",
   "file": "D1401al.txt",
   "line": 305,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ……少しだけ遊んでやる！ せいぜい足掻くが良い……デモンベイン！　覇道財閥！」",
   "ko_candidate": "「자……조금만 놀아주지! 최선을 다해 발버둥쳐 보아라……데몬베인! 하도 재벌!」"
  },
  {
   "id": 35985,
   "key": "D1401al.txt:309",
   "file": "D1401al.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "喉の奥で燃え滾る、破滅的なエネルギーの輝き。",
   "ko_candidate": "목구멍 안쪽에서 타오르는 파멸적인 에너지의 빛｡"
  },
  {
   "id": 35986,
   "key": "D1401al.txt:321",
   "file": "D1401al.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の空を眩く染め上げる、閃光閃光閃光閃光閃光閃光閃光閃光。",
   "ko_candidate": "어두운 하늘을 눈부시게 물들이는 섬광섬광섬광섬광섬광섬광섬광섬광｡"
  },
  {
   "id": 35987,
   "key": "D1401al.txt:322",
   "file": "D1401al.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟き渡る、幾重にも重なった咆吼咆吼咆吼咆吼咆吼咆吼咆吼咆吼。",
   "ko_candidate": "울려 퍼지는 겹겹이 겹친 포효포효포효포효포효포효포효포효｡"
  },
  {
   "id": 35988,
   "key": "D1401al.txt:324",
   "file": "D1401al.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜の首にも似た無数の触手が、わななく。吼える。炎える。",
   "ko_candidate": "용의 머리를 닮은 무수한 촉수가 떨린다｡ 포효한다｡ 불타오른다｡"
  },
  {
   "id": 35989,
   "key": "D1401al.txt:326",
   "file": "D1401al.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身が揮発して、俺という存在が消滅してしまうような感覚。",
   "ko_candidate": "온몸이 증발해 내가 존재 자체가 소멸해버릴 것 같은 감각｡"
  },
  {
   "id": 35990,
   "key": "D1401al.txt:327",
   "file": "D1401al.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "危機感が切実に訴える。",
   "ko_candidate": "위기감이 절실히 호소한다｡"
  },
  {
   "id": 35991,
   "key": "D1401al.txt:336",
   "file": "D1401al.txt",
   "line": 336,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クトゥルーが……撃ってくるのか！」",
   "ko_candidate": "「크툴루가……공격해 오는 건가!」"
  }
 ]
}