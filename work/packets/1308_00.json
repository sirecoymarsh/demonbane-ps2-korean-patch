{
 "packet": "1308_00",
 "scene": "1308",
 "anchor": {
  "hit": 17,
  "total": 19,
  "rate": 0.895
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {},
 "items": [
  {
   "id": 33544,
   "key": "D1308al.txt:14",
   "file": "D1308al.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "さて――戯れの夢もそろそろ終演だ。",
   "ko_candidate": "자､ 이제―― 장난스러운 꿈도 슬슬 막을 내릴 때가 되었다｡"
  },
  {
   "id": 33545,
   "key": "D1308al.txt:15",
   "file": "D1308al.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あとは帳の様な滅びを待つばかり。",
   "ko_candidate": "이제는 장막 같은 멸망을 기다릴 뿐｡"
  },
  {
   "id": 33546,
   "key": "D1308al.txt:16",
   "file": "D1308al.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その訪れは近い。",
   "ko_candidate": "그 순간은 가까워졌다｡"
  },
  {
   "id": 33547,
   "key": "D1308al.txt:18",
   "file": "D1308al.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は瞳を閉じている。",
   "ko_candidate": "첩은 눈을 감고 있다｡"
  },
  {
   "id": 33548,
   "key": "D1308al.txt:19",
   "file": "D1308al.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もはや何の想いも涌いてはこない。",
   "ko_candidate": "이제 어떤 감정도 솟아오르지 않는다｡"
  },
  {
   "id": 33549,
   "key": "D1308al.txt:21",
   "file": "D1308al.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛も",
   "ko_candidate": "고통도"
  },
  {
   "id": 33550,
   "key": "D1308al.txt:22",
   "file": "D1308al.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "哀しみも",
   "ko_candidate": "슬픔도"
  },
  {
   "id": 33551,
   "key": "D1308al.txt:23",
   "file": "D1308al.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "畏れも",
   "ko_candidate": "두려움도"
  },
  {
   "id": 33552,
   "key": "D1308al.txt:24",
   "file": "D1308al.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして虚しさすら。",
   "ko_candidate": "그리고 공허함조차도｡"
  },
  {
   "id": 33553,
   "key": "D1308al.txt:26",
   "file": "D1308al.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てが魂の疲弊に蝕まれていく。",
   "ko_candidate": "모든 것이 영혼의 피폐함에 잠식되어 간다｡"
  },
  {
   "id": 33554,
   "key": "D1308al.txt:28",
   "file": "D1308al.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滅びとは、こう云う事なのだろう。",
   "ko_candidate": "멸망이란､ 이런 것일 테지｡"
  },
  {
   "id": 33555,
   "key": "D1308al.txt:29",
   "file": "D1308al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死の恐怖に怯え、泣き叫ぶよりも、それは無惨な事なのかも知れない。",
   "ko_candidate": "죽음의 공포에 떨며 울부짖는 것보다､ 그것은 더 비참한 일일지도 모른다｡"
  },
  {
   "id": 33556,
   "key": "D1308al.txt:31",
   "file": "D1308al.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まあ、良い。",
   "ko_candidate": "뭐､ 좋아｡"
  },
  {
   "id": 33557,
   "key": "D1308al.txt:32",
   "file": "D1308al.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうでも、良い。",
   "ko_candidate": "어찌 되든､ 상관없어｡"
  },
  {
   "id": 33558,
   "key": "D1308al.txt:33",
   "file": "D1308al.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当に、酷く、疲れた。",
   "ko_candidate": "정말､ 너무나､ 지쳤다｡"
  },
  {
   "id": 33559,
   "key": "D1308al.txt:34",
   "file": "D1308al.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "このまま終わってしまおう。",
   "ko_candidate": "이대로 끝나버리자｡"
  },
  {
   "id": 33560,
   "key": "D1308al.txt:36",
   "file": "D1308al.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このまま、最初から何も無かったように、総てが零となってしまえば……。",
   "ko_candidate": "이대로､ 처음부터 아무것도 없었던 것처럼､ 모든 것이 제로가 되어버리면……"
  },
  {
   "id": 33561,
   "key": "D1308al.txt:67",
   "file": "D1308al.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……ただ、何だろう。",
   "ko_candidate": "……그런데､ 뭘까｡"
  },
  {
   "id": 33562,
   "key": "D1308al.txt:68",
   "file": "D1308al.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この寒さは。",
   "ko_candidate": "이 추위는｡"
  },
  {
   "id": 33563,
   "key": "D1308al.txt:69",
   "file": "D1308al.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸に大きな穴が空いているかのようだ。",
   "ko_candidate": "가슴에 커다란 구멍이 뚫린 것만 같다｡"
  },
  {
   "id": 33564,
   "key": "D1308al.txt:71",
   "file": "D1308al.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……寒い。",
   "ko_candidate": "……춥다｡"
  },
  {
   "id": 33565,
   "key": "D1308al.txt:72",
   "file": "D1308al.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "酷く、寒い。",
   "ko_candidate": "너무나､ 춥다｡"
  },
  {
   "id": 33566,
   "key": "D1308al.txt:74",
   "file": "D1308al.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから",
   "ko_candidate": "그래서"
  },
  {
   "id": 33567,
   "key": "D1308al.txt:75",
   "file": "D1308al.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あまりもの寒さに、堪え切れなかったから",
   "ko_candidate": "너무나 추워서､ 견딜 수 없어서"
  },
  {
   "id": 33568,
   "key": "D1308al.txt:79",
   "file": "D1308al.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾はもう一度だけ、",
   "ko_candidate": "첩은 다시 한 번만､"
  },
  {
   "id": 33569,
   "key": "D1308al.txt:80",
   "file": "D1308al.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳を、開いた。",
   "ko_candidate": "눈을､ 떴다｡"
  },
  {
   "id": 33570,
   "key": "D1308al.txt:85",
   "file": "D1308al.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深遠。",
   "ko_candidate": "심원｡"
  },
  {
   "id": 33571,
   "key": "D1308al.txt:87",
   "file": "D1308al.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深淵。",
   "ko_candidate": "심연｡"
  },
  {
   "id": 33572,
   "key": "D1308al.txt:89",
   "file": "D1308al.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "果て無い、限り無い星々の海。",
   "ko_candidate": "끝없는､ 한없는 별들의 바다｡"
  },
  {
   "id": 33573,
   "key": "D1308al.txt:91",
   "file": "D1308al.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宇宙を漂っている。",
   "ko_candidate": "우주를 떠돌고 있다｡"
  },
  {
   "id": 33574,
   "key": "D1308al.txt:92",
   "file": "D1308al.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最期に見る夢としては、少々色気に欠ける。",
   "ko_candidate": "마지막으로 보는 꿈치고는､ 약간 흥미가 떨어진다｡"
  },
  {
   "id": 33575,
   "key": "D1308al.txt:94",
   "file": "D1308al.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……何て、冷たい宇宙。",
   "ko_candidate": "……얼마나 차가운 우주인가｡"
  },
  {
   "id": 33576,
   "key": "D1308al.txt:95",
   "file": "D1308al.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "道理で寒い訳だ。",
   "ko_candidate": "이래서 추운 거구나｡"
  },
  {
   "id": 33577,
   "key": "D1308al.txt:97",
   "file": "D1308al.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宇宙はこんなにも広く、",
   "ko_candidate": "우주는 이토록 넓고､"
  },
  {
   "id": 33578,
   "key": "D1308al.txt:98",
   "file": "D1308al.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなにも孤独だ。",
   "ko_candidate": "이토록 고독하다｡"
  },
  {
   "id": 33579,
   "key": "D1308al.txt:99",
   "file": "D1308al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに――",
   "ko_candidate": "게다가――"
  },
  {
   "id": 33580,
   "key": "D1308al.txt:104",
   "file": "D1308al.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この無限の虚空の遥か彼方、 孤独の世界のすぐ裏側――",
   "ko_candidate": "이 무한한 허공의 저 멀리､ 고독한 세계의 바로 뒤편――"
  },
  {
   "id": 33581,
   "key": "D1308al.txt:106",
   "file": "D1308al.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蠢く怪異の存在を、迫る脅威の存在を、誰が識る。 誰が識る。",
   "ko_candidate": "꿈틀대는 괴이의 존재를､ 다가오는 위협의 존재를､ 누가 알겠는가｡ 누가 알겠는가｡"
  },
  {
   "id": 33582,
   "key": "D1308al.txt:113",
   "file": "D1308al.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう、邪悪に貪られている。",
   "ko_candidate": "그래､ 사악함에 잠식당하고 있다｡"
  },
  {
   "id": 33583,
   "key": "D1308al.txt:118",
   "file": "D1308al.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人智を超え、狂気をも超えた領域で、世界と怪異は侵し合い、犯し合い、冒し合い、幾星霜――それでもなお続く。なお巡る。未来永劫、過去永劫。",
   "ko_candidate": "인지를 넘어､ 광기마저 넘어선 영역에서､ 세계와 괴이는 서로를 침범하고､ 범하고､ 모독하며､ 오랜 세월―― 그래도 여전히 계속된다｡ 여전히 순환한다｡ 미래영겁､ 과거영겁｡"
  }
 ]
}