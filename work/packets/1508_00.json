 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リューガ": "류가",
  "魔力": "마력",
  "鬼械神": "귀계신",
  "エセルドレーダ": "에셀드레다",
  "デモンベイン": "데몬베인",
  "九郎": "쿠로",
  "アル": "알",
  "ライカ": "라이카",
  "ナコト写本": "나코트 사본",
  "術式": "술식",
  "旧き印": "옛 인장",
  "大十字": "다이쥬지",
  "サンダルフォン": "산달폰",
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 45247,
   "key": "D1508le.txt:9",
   "file": "D1508le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時を止めたように、静寂が続いた。",
   "ko_candidate": "마치 시간이 멈춘 듯 정적이 계속되었다｡"
  },
  {
   "id": 45248,
   "key": "D1508le.txt:11",
   "file": "D1508le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いや、時空の狂った領域では、本当に時は止まっているのかも知れない。",
   "ko_candidate": "아니､ 시공간이 뒤틀린 영역에서는 정말로 시간이 멈춰 있을지도 모른다｡"
  },
  {
   "id": 45249,
   "key": "D1508le.txt:13",
   "file": "D1508le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私は時の輪廻に囚われて、何処にも辿り着くことのない静寂の中に居るのかも知れない。永遠に。",
   "ko_candidate": "나는 시간의 윤회에 갇혀 어디에도 도달할 수 없는 정적 속에 있는 것일지도 모른다｡ 영원히｡"
  },
  {
   "id": 45250,
   "key": "D1508le.txt:15",
   "file": "D1508le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、時は動き出した。",
   "ko_candidate": "하지만 시간은 움직이기 시작했다｡"
  },
  {
   "id": 45251,
   "key": "D1508le.txt:19",
   "file": "D1508le.txt",
   "line": 19,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ッ！　これは……！」",
   "ko_candidate": "「……읏! 이건……!」"
  },
  {
   "id": 45252,
   "key": "D1508le.txt:22",
   "file": "D1508le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私の傍らに立つ、黒の少女が驚愕と嫌悪のない交ぜになった表情で、それを睨みつけていた。",
   "ko_candidate": "내 곁에 서 있는 검은 소녀가 경악과 혐오가 뒤섞인 표정으로 그것을 노려보고 있었다｡"
  },
  {
   "id": 45253,
   "key": "D1508le.txt:29",
   "file": "D1508le.txt",
   "line": 29,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 45254,
   "key": "D1508le.txt:32",
   "file": "D1508le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガと私たちの間を、巨大な鋼鉄の掌が阻んでいた。",
   "ko_candidate": "류가와 우리들 사이를 거대한 강철의 손바닥이 가로막고 있었다｡"
  },
  {
   "id": 45255,
   "key": "D1508le.txt:33",
   "file": "D1508le.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掌を手甲を包む魔力の光が、崩壊の一撃を総て受け止め切った。",
   "ko_candidate": "손바닥과 손등을 감싸는 마력의 빛이 붕괴의 일격을 모두 받아냈다｡"
  },
  {
   "id": 45256,
   "key": "D1508le.txt:35",
   "file": "D1508le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この力、この巨体。",
   "ko_candidate": "이 힘､ 이 거대한 몸체｡"
  },
  {
   "id": 45257,
   "key": "D1508le.txt:36",
   "file": "D1508le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今この場に、それを有する存在は、この紅の鬼械神の他には、ただ一つしかない。",
   "ko_candidate": "지금 이 자리에 그것을 가진 존재는 이 붉은 귀계신 외에는 단 하나밖에 없다｡"
  },
  {
   "id": 45258,
   "key": "D1508le.txt:38",
   "file": "D1508le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エセルドレーダが叫ぶ。",
   "ko_candidate": "에셀드레다가 외친다｡"
  },
  {
   "id": 45259,
   "key": "D1508le.txt:39",
   "file": "D1508le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人々の心に光を宿し、魔性の魂に滅びをもたらす、まさにその存在が冠するに、相応しい名を。",
   "ko_candidate": "사람들의 마음에 빛을 깃들게 하고､ 마성의 영혼에 멸망을 가져오는､ 바로 그 존재가 관에 쓰기에 걸맞은 이름을｡"
  },
  {
   "id": 45260,
   "key": "D1508le.txt:41",
   "file": "D1508le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "汝、魔を断つ剣――",
   "ko_candidate": "너､ 마를 베는 검――"
  },
  {
   "id": 45261,
   "key": "D1508le.txt:46",
   "file": "D1508le.txt",
   "line": 46,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベイン！」",
   "ko_candidate": "「데몬베인!」"
  },
  {
   "id": 45262,
   "key": "D1508le.txt:57",
   "file": "D1508le.txt",
   "line": 57,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てめえら……調子に乗るのも大概にしやがれ！」",
   "ko_candidate": "「너희들…… 기고만장한 것도 적당히 하라고!」"
  },
  {
   "id": 45263,
   "key": "D1508le.txt:61",
   "file": "D1508le.txt",
   "line": 61,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！　大丈夫なのか!?」",
   "ko_candidate": "「쿠로! 괜찮은 거야!?」"
  },
  {
   "id": 45264,
   "key": "D1508le.txt:64",
   "file": "D1508le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "よろよろと身を起こす俺の身体を、アルが支える。",
   "ko_candidate": "비틀거리며 몸을 일으키는 내 몸을 알이 부축한다｡"
  },
  {
   "id": 45265,
   "key": "D1508le.txt:65",
   "file": "D1508le.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正直、あまり大丈夫じゃないつーか、メチャクチャ痛い。",
   "ko_candidate": "솔직히 별로 괜찮지 않다기보다는 엄청 아프다｡"
  },
  {
   "id": 45266,
   "key": "D1508le.txt:66",
   "file": "D1508le.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけどそんな激痛を吹き飛ばすほどの力が、今、漲っている。",
   "ko_candidate": "하지만 그런 격통을 날려버릴 만한 힘이 지금 충만해 있다｡"
  },
  {
   "id": 45267,
   "key": "D1508le.txt:70",
   "file": "D1508le.txt",
   "line": 70,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんの――」",
   "ko_candidate": "「라이카 씨의――」"
  },
  {
   "id": 45268,
   "key": "D1508le.txt:74",
   "file": "D1508le.txt",
   "line": 74,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え？」",
   "ko_candidate": "「응?」"
  },
  {
   "id": 45269,
   "key": "D1508le.txt:78",
   "file": "D1508le.txt",
   "line": 78,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんの声が、聴こえた」",
   "ko_candidate": "「라이카 씨의 목소리가 들렸어」"
  },
  {
   "id": 45270,
   "key": "D1508le.txt:82",
   "file": "D1508le.txt",
   "line": 82,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 45271,
   "key": "D1508le.txt:85",
   "file": "D1508le.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。曖昧な意識の中で、確かに届いた。",
   "ko_candidate": "그래｡ 희미한 의식 속에서 분명히 들렸다｡"
  },
  {
   "id": 45272,
   "key": "D1508le.txt:86",
   "file": "D1508le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の名を呼ぶ、ライカさんの声が。",
   "ko_candidate": "내 이름을 부르는 라이카 씨의 목소리가｡"
  },
  {
   "id": 45273,
   "key": "D1508le.txt:88",
   "file": "D1508le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "心を砕かれ、『ナコト写本』の力に操られていた、ライカさんの――自分を取り戻し、戦おうとする意志が。",
   "ko_candidate": "마음이 부서지고 『나코트 사본』의 힘에 조종당하고 있던 라이카 씨의―― 자신을 되찾고 싸우려는 의지가｡"
  },
  {
   "id": 45274,
   "key": "D1508le.txt:92",
   "file": "D1508le.txt",
   "line": 92,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから……おちおち寝てられねえつーのよ！」",
   "ko_candidate": "「그러니까…… 편히 잘 수가 없다고!」"
  },
  {
   "id": 45275,
   "key": "D1508le.txt:99",
   "file": "D1508le.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "術式を組んで、魔術を走らせる。",
   "ko_candidate": "술식을 짜고 마술을 달리게 한다｡"
  },
  {
   "id": 45276,
   "key": "D1508le.txt:100",
   "file": "D1508le.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の前方に浮かぶ紋様。五芒星形の印。『旧き印』。",
   "ko_candidate": "내 앞에 떠오르는 문양｡ 오망성 형태의 인｡ 『엘더 사인』｡"
  },
  {
   "id": 45277,
   "key": "D1508le.txt:101",
   "file": "D1508le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "印はデモンベインの手甲にも輝き、俺の意に従い、動いていた。",
   "ko_candidate": "인은 데몬베인의 손등에도 빛나고 내 뜻에 따라 움직이고 있었다｡"
  },
  {
   "id": 45278,
   "key": "D1508le.txt:105",
   "file": "D1508le.txt",
   "line": 105,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字……九郎ッ！」",
   "ko_candidate": "「다이쥬지…… 쿠로읏!」"
  },
  {
   "id": 45279,
   "key": "D1508le.txt:109",
   "file": "D1508le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンは、拳を受け止められた体勢のまま、それでもデモンベインの掌を粉砕しようと、機械の翼からフレアを噴出させ、押し進もうとする。",
   "ko_candidate": "산달폰은 주먹을 받아낸 자세 그대로 그래도 데몬베인의 손바닥을 분쇄하려고 기계의 날개에서 플레어를 뿜어내며 밀고 나가려 한다｡"
  },
  {
   "id": 45280,
   "key": "D1508le.txt:112",
   "file": "D1508le.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凄まじいパワー……だが負けてはいられない。",
   "ko_candidate": "굉장한 파워…… 하지만 질 수는 없다｡"
  },
  {
   "id": 45281,
   "key": "D1508le.txt:113",
   "file": "D1508le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "せめぎ合う２つの魔力が衝突し、紫電を迸らせる。",
   "ko_candidate": "맞부딪치는 두 개의 마력이 충돌하여 자색 번개를 튀긴다｡"
  },
  {
   "id": 45282,
   "key": "D1508le.txt:119",
   "file": "D1508le.txt",
   "line": 119,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「邪魔をするな！ 大十字九郎ッ！」",
   "ko_candidate": "「방해하지 마! 다이쥬지 쿠로읏!」"
  },
  {
   "id": 45283,
   "key": "D1508le.txt:124",
   "file": "D1508le.txt",
   "line": 124,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てめえこそ邪魔すんな、根暗野郎！ グチャグチャドロドロ執念深く……いい加減にしやがれ！」",
   "ko_candidate": "「네놈이야말로 방해하지 마､ 음침한 녀석아! 질척질척 끈적끈적 집요하게…… 적당히 하라고!」"
  },
  {
   "id": 45284,
   "key": "D1508le.txt:129",
   "file": "D1508le.txt",
   "line": 129,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ウオオオオォォォォ！」",
   "ko_candidate": "「우오오오오오오오오!」"
  },
  {
   "id": 45285,
   "key": "D1508le.txt:133",
   "file": "D1508le.txt",
   "line": 133,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハアアアアァァァァ！」",
   "ko_candidate": "「하아아아아아아아아!」"
  },
  {
   "id": 45286,
   "key": "D1508le.txt:139",
   "file": "D1508le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "互いの臨界まで魔力が爆発した。",
   "ko_candidate": "서로의 임계까지 마력이 폭발했다｡"
  }
 ]
}