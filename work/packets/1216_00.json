{
 "packet": "1216_00",
 "scene": "1216",
 "anchor": {
  "hit": 6,
  "total": 6,
  "rate": 1.0
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "ライカ": "라이카",
  "ハンティング・ホラー": "헌팅 호러"
 },
 "items": [
  {
   "id": 30490,
   "key": "D1216le.txt:9",
   "file": "D1216le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "着地した瞬間、全身から力が抜けた。",
   "ko_candidate": "착지한 순간､ 온몸에서 힘이 빠졌다｡"
  },
  {
   "id": 30491,
   "key": "D1216le.txt:10",
   "file": "D1216le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膝を突いて、蹲る。",
   "ko_candidate": "무릎을 꿇고 쪼그리고 앉는다｡"
  },
  {
   "id": 30492,
   "key": "D1216le.txt:12",
   "file": "D1216le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身体中から噴き出た血が、何本もの糸を描いて、床に滴り落ちる。",
   "ko_candidate": "온몸에서 뿜어져 나온 피가 여러 줄기의 실을 그리며 바닥에 떨어진다｡"
  },
  {
   "id": 30493,
   "key": "D1216le.txt:13",
   "file": "D1216le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "皮膚のいたるところが裂け、ズタズタになっている。",
   "ko_candidate": "피부 곳곳이 찢어져 너덜너덜해졌다｡"
  },
  {
   "id": 30494,
   "key": "D1216le.txt:15",
   "file": "D1216le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肺が酸素を痛切に渇望していた。心臓の鼓動が耳を打った。",
   "ko_candidate": "폐가 산소를 절실히 갈망하고 있었다｡ 심장 박동이 귓가를 때렸다｡"
  },
  {
   "id": 30495,
   "key": "D1216le.txt:20",
   "file": "D1216le.txt",
   "line": 20,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やれやれ、酷い有様だな」",
   "ko_candidate": "「이런이런､ 처참한 꼴이군」"
  },
  {
   "id": 30496,
   "key": "D1216le.txt:23",
   "file": "D1216le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの言うとおり、身体はズタボロだった。",
   "ko_candidate": "알이 말한 대로 몸은 만신창이였다｡"
  },
  {
   "id": 30497,
   "key": "D1216le.txt:24",
   "file": "D1216le.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでも何とか偃月刀を杖に立ち上がり、周囲を見渡す。",
   "ko_candidate": "그래도 어떻게든 언월도를 지팡이 삼아 일어나 주위를 둘러본다｡"
  },
  {
   "id": 30498,
   "key": "D1216le.txt:25",
   "file": "D1216le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――ライカさんはどうした？",
   "ko_candidate": "――라이카 씨는 어떻게 됐지?"
  },
  {
   "id": 30499,
   "key": "D1216le.txt:27",
   "file": "D1216le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "見つけた。",
   "ko_candidate": "찾았다｡"
  },
  {
   "id": 30500,
   "key": "D1216le.txt:28",
   "file": "D1216le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やや離れた路上、スクランブル交差点の中央に、ハンティング・ホラーは停まっていた。だけど、何か様子が変だ。",
   "ko_candidate": "약간 떨어진 도로､ 스크램블 교차로 중앙에 헌팅 호러가 멈춰 있었다｡ 하지만 뭔가 모습이 이상하다｡"
  },
  {
   "id": 30501,
   "key": "D1216le.txt:30",
   "file": "D1216le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーに跨り、俯いたまま、動かない。",
   "ko_candidate": "헌팅 호러에 걸터앉아 고개를 숙인 채 움직이지 않는다｡"
  },
  {
   "id": 30502,
   "key": "D1216le.txt:31",
   "file": "D1216le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠目には分かり辛いが、身体が震えているようだった。",
   "ko_candidate": "멀리서 보기에는 알기 어렵지만 몸이 떨리는 것 같았다｡"
  },
  {
   "id": 30503,
   "key": "D1216le.txt:32",
   "file": "D1216le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……怪我でも負ったのか？",
   "ko_candidate": "……부상이라도 입은 건가?"
  },
  {
   "id": 30504,
   "key": "D1216le.txt:35",
   "file": "D1216le.txt",
   "line": 35,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ラ……」",
   "ko_candidate": "「라……」"
  },
  {
   "id": 30505,
   "key": "D1216le.txt:37",
   "file": "D1216le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "声をかけようとしたその時だった。",
   "ko_candidate": "말을 걸려던 그때였다｡"
  },
  {
   "id": 30506,
   "key": "D1216le.txt:38",
   "file": "D1216le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然、ライカさんは空を仰ぎ見るように、背中を反らせた。",
   "ko_candidate": "갑자기 라이카 씨가 하늘을 올려다보듯 등을 젖혔다｡"
  },
  {
   "id": 30507,
   "key": "D1216le.txt:39",
   "file": "D1216le.txt",
   "line": 39,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ああ……」と小さな悲鳴が洩れる。尋常な様子ではないのは明らかだった。",
   "ko_candidate": "「아……아아……」하고 작은 비명이 새어 나온다｡ 정상적인 모습이 아닌 것은 분명했다｡"
  },
  {
   "id": 30508,
   "key": "D1216le.txt:42",
   "file": "D1216le.txt",
   "line": 42,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさん！　……ぐっ！」",
   "ko_candidate": "「라이카 씨! ……윽!」"
  },
  {
   "id": 30509,
   "key": "D1216le.txt:44",
   "file": "D1216le.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駈け寄ろうとした瞬間、全身に激痛が走る。",
   "ko_candidate": "달려가려던 순간 온몸에 격통이 달린다｡"
  },
  {
   "id": 30510,
   "key": "D1216le.txt:47",
   "file": "D1216le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足がもつれ、そのまま顔面から地面に突っ込んだ。",
   "ko_candidate": "발이 엉키더니 그대로 얼굴부터 땅에 처박혔다｡"
  },
  {
   "id": 30511,
   "key": "D1216le.txt:48",
   "file": "D1216le.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強かに鼻を打ちつける。",
   "ko_candidate": "세게 코를 부딪친다｡"
  },
  {
   "id": 30512,
   "key": "D1216le.txt:53",
   "file": "D1216le.txt",
   "line": 53,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おいおい。大丈夫か？」",
   "ko_candidate": "「이봐이봐｡ 괜찮아?」"
  },
  {
   "id": 30513,
   "key": "D1216le.txt:57",
   "file": "D1216le.txt",
   "line": 57,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「俺は良い！　それよりライカさんがっ！」",
   "ko_candidate": "「나는 괜찮아! 그보다 라이카 씨가!」"
  },
  {
   "id": 30514,
   "key": "D1216le.txt:62",
   "file": "D1216le.txt",
   "line": 62,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわああああ……あああああああああっっっっ！」",
   "ko_candidate": "「우와아아아아……아아아아아아아아앗!」"
  },
  {
   "id": 30515,
   "key": "D1216le.txt:66",
   "file": "D1216le.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一際、甲高い悲鳴が上がった。",
   "ko_candidate": "한층 더 날카로운 비명이 올라왔다｡"
  },
  {
   "id": 30516,
   "key": "D1216le.txt:67",
   "file": "D1216le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "異常の正体は明らかだった。",
   "ko_candidate": "이상의 정체는 분명했다｡"
  },
  {
   "id": 30517,
   "key": "D1216le.txt:69",
   "file": "D1216le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーから金属的な光沢が無くなり、有機的な、甲虫の外骨格に似た生々しい彩を帯び始めた。",
   "ko_candidate": "헌팅 호러에서 금속성 광택이 사라지고 유기적인､ 딱정벌레의 외골격과 비슷한 생생한 색채를 띠기 시작했다｡"
  },
  {
   "id": 30518,
   "key": "D1216le.txt:71",
   "file": "D1216le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その殻の表面に浮かび上がる神経網。それはライカさんの皮膚の内に侵入し、網の目のように走る。",
   "ko_candidate": "그 껍질 표면에 떠오르는 신경망｡ 그것은 라이카 씨의 피부 안으로 침입해 그물망처럼 달린다｡"
  },
  {
   "id": 30519,
   "key": "D1216le.txt:76",
   "file": "D1216le.txt",
   "line": 76,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何だ……？　何が起こっておるのだ!?」",
   "ko_candidate": "「뭐지……? 무슨 일이 일어나고 있는 거지!?」"
  },
  {
   "id": 30520,
   "key": "D1216le.txt:81",
   "file": "D1216le.txt",
   "line": 81,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あああっ！」",
   "ko_candidate": "「아아앗!」"
  },
  {
   "id": 30521,
   "key": "D1216le.txt:84",
   "file": "D1216le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの躰が跳ねた。",
   "ko_candidate": "라이카 씨의 몸이 튀어 올랐다｡"
  },
  {
   "id": 30522,
   "key": "D1216le.txt:85",
   "file": "D1216le.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "口端から涎が流れる。",
   "ko_candidate": "입가에서 침이 흐른다｡"
  },
  {
   "id": 30523,
   "key": "D1216le.txt:86",
   "file": "D1216le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身が激しく痙攣している。",
   "ko_candidate": "온몸이 격렬하게 경련하고 있다｡"
  },
  {
   "id": 30524,
   "key": "D1216le.txt:88",
   "file": "D1216le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怪異はなおもライカさんを蹂躙し、侵攻する。",
   "ko_candidate": "괴이는 여전히 라이카 씨를 유린하며 진행한다｡"
  },
  {
   "id": 30525,
   "key": "D1216le.txt:90",
   "file": "D1216le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーから夜闇よりも黒い、闇が溢れ出した。",
   "ko_candidate": "헌팅 호러에서 밤보다도 검은 어둠이 넘쳐흘렀다｡"
  },
  {
   "id": 30526,
   "key": "D1216le.txt:91",
   "file": "D1216le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コップの水に落とした黒インクのように、空間に滲んで広がる。",
   "ko_candidate": "컵의 물에 떨어뜨린 검은 잉크처럼 공간에 번져 퍼진다｡"
  },
  {
   "id": 30527,
   "key": "D1216le.txt:93",
   "file": "D1216le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇に包まれたハンティング・ホラーの姿はまるで、１匹の巨大な、黒犬に見えた。",
   "ko_candidate": "어둠에 싸인 헌팅 호러의 모습은 마치 한 마리의 거대한 검은 개처럼 보였다｡"
  },
  {
   "id": 30528,
   "key": "D1216le.txt:94",
   "file": "D1216le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "犬の眼が開き嗤った――ような気がした。",
   "ko_candidate": "개의 눈이 열리고 웃었다――고 느꼈다｡"
  },
  {
   "id": 30529,
   "key": "D1216le.txt:96",
   "file": "D1216le.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――マズい。",
   "ko_candidate": "서툴러｡"
  }
 ]
}