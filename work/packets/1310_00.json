  {
   "id": 34609,
   "key": "D1310al.txt:29",
   "file": "D1310al.txt",
   "line": 29,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『気』で叩き墜とすつもりだ。",
   "ko_candidate": "『기』로 때려눕힐 작정이다｡"
