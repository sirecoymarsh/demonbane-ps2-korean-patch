   "ko_candidate": "「파아아아아…………읏! 뭐!?」"
  },
  {
   "id": 34611,
   "key": "D1310al.txt:44",
   "file": "D1310al.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
