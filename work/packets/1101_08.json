 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "ライカ": "라이카",
  "魔導書": "마도서",
  "アーミティッジ": "아미티지",
  "ミスカトニック": "미스캐토닉"
 },
 "items": [
  {
   "id": 22372,
   "key": "D1101le.txt:460",
   "file": "D1101le.txt",
   "line": 460,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アルたんっ！　アルたんっ！ おろおろおろおろおろ……」",
   "ko_candidate": "「알 양! 알 양! 오로오로오로오로오로……」"
  },
  {
   "id": 22373,
   "key": "D1101le.txt:469",
   "file": "D1101le.txt",
   "line": 469,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もぉぉぉ！ 何が何だかぁぁぁー！」",
   "ko_candidate": "「으으으! 뭐가 뭔지 모르겠어어어―!」"
  },
  {
   "id": 22374,
   "key": "D1101le.txt:473",
   "file": "D1101le.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……本当に何が何だか。",
   "ko_candidate": "……정말 뭐가 뭔지｡"
  },
  {
   "id": 22375,
   "key": "D1101le.txt:475",
   "file": "D1101le.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "色々なことが同時に起こり過ぎて、頭がパニックしている。",
   "ko_candidate": "여러 가지 일이 동시에 일어나서 머리가 패닉 상태다｡"
  },
  {
   "id": 22376,
   "key": "D1101le.txt:476",
   "file": "D1101le.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まったく、いったい、どうしちまったんだ。",
   "ko_candidate": "정말､ 도대체､ 어떻게 된 거야｡"
  },
  {
   "id": 22377,
   "key": "D1101le.txt:478",
   "file": "D1101le.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……ライカさん。",
   "ko_candidate": "……라이카 씨｡"
  },
  {
   "id": 22378,
   "key": "D1101ru.txt:11",
   "file": "D1101ru.txt",
   "line": 11,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうか……大学を辞めるのか」",
   "ko_candidate": "「그렇군……대학을 그만두는 건가」"
  },
  {
   "id": 22379,
   "key": "D1101ru.txt:14",
   "file": "D1101ru.txt",
   "line": 14,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……俺には荷が重すぎたよ」",
   "ko_candidate": "「그래……나에겐 짐이 너무 무거웠어」"
  },
  {
   "id": 22380,
   "key": "D1101ru.txt:17",
   "file": "D1101ru.txt",
   "line": 17,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「魔導書の閲覧まで、位階が進んでいたのにか？」",
   "ko_candidate": "「마도서 열람까지､ 계급이 올랐는데도 말이냐?」"
  },
  {
   "id": 22381,
   "key": "D1101ru.txt:20",
   "file": "D1101ru.txt",
   "line": 20,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから、だよ」",
   "ko_candidate": "「그래서 말이야」"
  },
  {
   "id": 22382,
   "key": "D1101ru.txt:23",
   "file": "D1101ru.txt",
   "line": 23,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何故だ、とは訊かない方が良さそうだな」",
   "ko_candidate": "「……왜인지는 묻지 않는 게 좋겠군」"
  },
  {
   "id": 22383,
   "key": "D1101ru.txt:26",
   "file": "D1101ru.txt",
   "line": 26,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「訊かなくたって、分かるだろうに」",
   "ko_candidate": "「묻지 않아도 알 거 아냐」"
  },
  {
   "id": 22384,
   "key": "D1101ru.txt:29",
   "file": "D1101ru.txt",
   "line": 29,
   "speaker": "アーミティッジ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……だが、お前は本当にそれで良いのか？　お前を支援した者達が、お前に何を望んでいたかは知らない。が、だからと言って、此処で逃げれば――」 「アーミティッジの爺さん」",
   "ko_candidate": "「……하지만､ 너는 정말 그걸로 괜찮은 거냐? 너를 지원한 사람들이 너에게 무엇을 바랐는지는 모르겠다｡ 하지만 그렇다고 해서､ 여기서 도망치면――」"
  },
  {
   "id": 22385,
   "key": "D1101ru.txt:35",
   "file": "D1101ru.txt",
   "line": 35,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「아미티지 할아버지」"
  },
  {
   "id": 22386,
   "key": "D1101ru.txt:38",
   "file": "D1101ru.txt",
   "line": 38,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あんたがダンウィッチで何を見たか。そいつは訊かないよ」",
   "ko_candidate": "「………………」 「당신이 던위치에서 무엇을 봤는지｡ 그건 묻지 않을게」"
  },
  {
   "id": 22387,
   "key": "D1101ru.txt:41",
   "file": "D1101ru.txt",
   "line": 41,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 22388,
   "key": "D1101ru.txt:44",
   "file": "D1101ru.txt",
   "line": 44,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だからもう、俺を巻き込むな」",
   "ko_candidate": "「그러니 이제､ 나를 끌어들이지 마」"
  },
  {
   "id": 22389,
   "key": "D1101ru.txt:47",
   "file": "D1101ru.txt",
   "line": 47,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……分かった」",
   "ko_candidate": "「……알겠다」"
  },
  {
   "id": 22390,
   "key": "D1101ru.txt:53",
   "file": "D1101ru.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "門を出る。",
   "ko_candidate": "문을 나선다｡"
  },
  {
   "id": 22391,
   "key": "D1101ru.txt:55",
   "file": "D1101ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最後に一度だけ、後ろを振り返った。",
   "ko_candidate": "마지막으로 한 번만､ 뒤를 돌아보았다｡"
  },
  {
   "id": 22392,
   "key": "D1101ru.txt:62",
   "file": "D1101ru.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "百年以上の歴史を誇る、旧くも立派な建造物。",
   "ko_candidate": "백 년 이상의 역사를 자랑하는､ 오래되고 훌륭한 건축물｡"
  },
  {
   "id": 22393,
   "key": "D1101ru.txt:63",
   "file": "D1101ru.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ミスカトニック大学。",
   "ko_candidate": "미스카토닉 대학｡"
  },
  {
   "id": 22394,
   "key": "D1101ru.txt:64",
   "file": "D1101ru.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう、構内に足を踏み入れることもないだろう。",
   "ko_candidate": "이제､ 교내에 발을 들여놓는 일도 없겠지｡"
  },
  {
   "id": 22395,
   "key": "D1101ru.txt:66",
   "file": "D1101ru.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして魔術に関わることも……そうだ。あんなものには、二度と関わりたくない。",
   "ko_candidate": "그리고 마술과 관련된 일도……그래｡ 그런 것들과는､ 두 번 다시 관련되고 싶지 않아｡"
  },
  {
   "id": 22396,
   "key": "D1101ru.txt:67",
   "file": "D1101ru.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アーミティッジの爺さんは、いつでも戻って来いとは言ってたけど。",
   "ko_candidate": "아미티지 할아버지는､ 언제든 돌아오라고 했지만｡"
  },
  {
   "id": 22397,
   "key": "D1101ru.txt:69",
   "file": "D1101ru.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夕焼けの校舎。",
   "ko_candidate": "석양에 물든 교사｡"
  },
  {
   "id": 22398,
   "key": "D1101ru.txt:70",
   "file": "D1101ru.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処か遠くで、哄笑のような、けたたましい鳥の啼き声が聴こえてくる。",
   "ko_candidate": "어디선가 멀리서､ 조소와 같은､ 귀청이 찢어질 듯한 새의 울음소리가 들려온다｡"
  },
  {
   "id": 22399,
   "key": "D1101ru.txt:73",
   "file": "D1101ru.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウィップアーウィル。伝承に曰く、死者の魂を攫う夜鷹と。",
   "ko_candidate": "휘푸어윌｡ 전설에 따르면､ 죽은 자의 영혼을 잡아채는 밤매라고｡"
  },
  {
   "id": 22400,
   "key": "D1101ru.txt:75",
   "file": "D1101ru.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ズキリとこめかみの辺りが痛んだ。",
   "ko_candidate": "관자놀이 부근이 욱신거렸다｡"
  },
  {
   "id": 22401,
   "key": "D1101ru.txt:76",
   "file": "D1101ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸にモヤモヤとした黒いものが、わだかまっている。",
   "ko_candidate": "가슴에 모호한 검은 것이､ 응어리져 있다｡"
  },
  {
   "id": 22402,
   "key": "D1101ru.txt:77",
   "file": "D1101ru.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なぜか酷く後味が悪かった。",
   "ko_candidate": "왠지 몹시 뒷맛이 나빴다｡"
  },
  {
   "id": 22403,
   "key": "D1101ru.txt:81",
   "file": "D1101ru.txt",
   "line": 81,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くそ……」",
   "ko_candidate": "「젠장……」"
  },
  {
   "id": 22404,
   "key": "D1101ru.txt:85",
   "file": "D1101ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大学に背を向けて歩き出す。",
   "ko_candidate": "대학에 등을 돌리고 걷기 시작한다｡"
  },
  {
   "id": 22405,
   "key": "D1101ru.txt:87",
   "file": "D1101ru.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今日はかなり冷え込んでいる。",
   "ko_candidate": "오늘은 꽤 추워졌다｡"
  },
  {
   "id": 22406,
   "key": "D1101ru.txt:89",
   "file": "D1101ru.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き抜ける風が、やたらと冷たい。",
   "ko_candidate": "불어오는 바람이､ 유난히 차갑다｡"
  },
  {
   "id": 22407,
   "key": "D1101ru.txt:91",
   "file": "D1101ru.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。心が、がらんどう、だから。",
   "ko_candidate": "그래｡ 마음이､ 텅 비어､ 있으니까｡"
  },
  {
   "id": 22408,
   "key": "D1101ru.txt:93",
   "file": "D1101ru.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心の穴に風が吹くから。",
   "ko_candidate": "마음의 구멍에 바람이 불어오니까｡"
  },
  {
   "id": 22409,
   "key": "D1101ru.txt:95",
   "file": "D1101ru.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空っぽになった心は、どうも恐怖と嫌悪だけでは、埋め尽くせないようだ。",
   "ko_candidate": "텅 비어버린 마음은､ 아무래도 공포와 혐오만으로는､ 채워지지 않는 것 같다｡"
  },
  {
   "id": 22410,
   "key": "D1101ru.txt:97",
   "file": "D1101ru.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腑抜けた心で考える。",
   "ko_candidate": "맥 빠진 마음으로 생각한다｡"
  },
  {
   "id": 22411,
   "key": "D1101ru.txt:99",
   "file": "D1101ru.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この後味の悪さが、すっきりする時は来るのだろうかと。",
   "ko_candidate": "이 뒷맛의 나쁨이､ 개운해질 때가 올까 하고｡"
  }
 ]
}