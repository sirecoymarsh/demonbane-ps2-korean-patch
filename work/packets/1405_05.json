 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "魔導書": "마도서",
  "ティベリウス": "티베리우스",
  "エセルドレーダ": "에셀드레다",
  "ナイア": "나이아",
  "ルルイエ": "르뤼에"
 },
 "items": [
  {
   "id": 37528,
   "key": "D1405ru.txt:125",
   "file": "D1405ru.txt",
   "line": 125,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さようなら」",
   "ko_candidate": "「안녕히」"
  },
  {
   "id": 37529,
   "key": "D1405ru.txt:132",
   "file": "D1405ru.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術が顕現した。",
   "ko_candidate": "마술이 현현했다｡"
  },
  {
   "id": 37530,
   "key": "D1405ru.txt:133",
   "file": "D1405ru.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "世界の在り方を書き換える式は、だが、何ら劇的な変化を見せなかった。",
   "ko_candidate": "세계의 존재 방식을 다시 쓰는 식은 하지만 어떤 극적인 변화도 보이지 않았다｡"
  },
  {
   "id": 37531,
   "key": "D1405ru.txt:135",
   "file": "D1405ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ少女の足元に落ちた魔導書。",
   "ko_candidate": "단지 소녀의 발밑에 떨어진 마도서｡"
  },
  {
   "id": 37532,
   "key": "D1405ru.txt:136",
   "file": "D1405ru.txt",
   "line": 136,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『妖蛆の秘密』が、戦慄いた。",
   "ko_candidate": "『벌레의 신비』가 전율했다｡"
  },
  {
   "id": 37533,
   "key": "D1405ru.txt:138",
   "file": "D1405ru.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "震え、蠢き、膨れ上がり――弾けた。",
   "ko_candidate": "떨리고 꿈틀거리며 부풀어 올라―― 터졌다｡"
  },
  {
   "id": 37534,
   "key": "D1405ru.txt:139",
   "file": "D1405ru.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蛆が飛び散る。魔導書が蛆になって解けてゆく。",
   "ko_candidate": "구더기가 튀어 오른다｡ 마도서가 구더기가 되어 녹아내린다｡"
  },
  {
   "id": 37535,
   "key": "D1405ru.txt:143",
   "file": "D1405ru.txt",
   "line": 143,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いやああぁぁぁうううううおお・お・お・お・お　お　お　お……ヲ」",
   "ko_candidate": "「이야아아아아우우우우우오?오?오?오?오 오 오 오…오」"
  },
  {
   "id": 37536,
   "key": "D1405ru.txt:148",
   "file": "D1405ru.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスにも同様の変化が生じた。",
   "ko_candidate": "티베리우스에게도 같은 변화가 일어났다｡"
  },
  {
   "id": 37537,
   "key": "D1405ru.txt:154",
   "file": "D1405ru.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐乱したティベリウスの頭部は、蒸気すら上げながら溶けてゆく。",
   "ko_candidate": "부패한 티베리우스의 머리는 증기마저 올리며 녹아내린다｡"
  },
  {
   "id": 37538,
   "key": "D1405ru.txt:155",
   "file": "D1405ru.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "逃げ場を求めて、大量の蛆虫があふれ出した。",
   "ko_candidate": "점액이 되어 떨어지는 부패액 속을 헤엄치며 대량의 구더기가 쏟아져 나온다｡"
  },
  {
   "id": 37539,
   "key": "D1405ru.txt:157",
   "file": "D1405ru.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全ての肉が崩れ落ち、単なる黄ばんだ頭蓋骨と成り果てる。",
   "ko_candidate": "모든 살이 썩어 떨어지고 단순한 누런 두개골로 변해버린다｡"
  },
  {
   "id": 37540,
   "key": "D1405ru.txt:162",
   "file": "D1405ru.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "骸骨から仮面が剥がれ落ちた。",
   "ko_candidate": "해골에서 가면이 벗겨져 떨어졌다｡"
  },
  {
   "id": 37541,
   "key": "D1405ru.txt:165",
   "file": "D1405ru.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地面にぶつかり、呆気なく、粉々に砕け散る。",
   "ko_candidate": "바닥에 부딪혀 허무하게도 산산조각 났다｡"
  },
  {
   "id": 37542,
   "key": "D1405ru.txt:166",
   "file": "D1405ru.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして頭蓋骨もまた、エセルドレーダの手の中で、灰になって崩れてゆく。",
   "ko_candidate": "그리고 두개골 또한 에셀드레다의 손 안에서 재가 되어 무너져 간다｡"
  },
  {
   "id": 37543,
   "key": "D1405ru.txt:168",
   "file": "D1405ru.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が総ての灰を浚う。",
   "ko_candidate": "바람이 모든 재를 쓸어간다｡"
  },
  {
   "id": 37544,
   "key": "D1405ru.txt:169",
   "file": "D1405ru.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も残らない。",
   "ko_candidate": "아무것도 남지 않는다｡"
  },
  {
   "id": 37545,
   "key": "D1405ru.txt:173",
   "file": "D1405ru.txt",
   "line": 173,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――星は正しい位置に付いた。 今度もまた、時は満ちた」",
   "ko_candidate": "「――별들이 올바른 위치에 자리 잡았다｡ 이번에도 또 때가 찼다」"
  },
  {
   "id": 37546,
   "key": "D1405ru.txt:179",
   "file": "D1405ru.txt",
   "line": 179,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 37547,
   "key": "D1405ru.txt:183",
   "file": "D1405ru.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷笑を止めて、エセルドレーダは無表情に背後を振り返った。",
   "ko_candidate": "냉소를 멈추고 에셀드레다는 무표정하게 뒤를 돌아보았다｡"
  },
  {
   "id": 37548,
   "key": "D1405ru.txt:184",
   "file": "D1405ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線の先に立っていたのは、少女と同様、黒を纏う女。",
   "ko_candidate": "시선의 끝에 서 있던 것은 소녀와 마찬가지로 검은 옷을 입은 여자｡"
  },
  {
   "id": 37549,
   "key": "D1405ru.txt:185",
   "file": "D1405ru.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の彩を纏う女だ。",
   "ko_candidate": "어둠의 색채를 두른 여자다｡"
  },
  {
   "id": 37550,
   "key": "D1405ru.txt:190",
   "file": "D1405ru.txt",
   "line": 190,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ナイア」",
   "ko_candidate": "「나이아」"
  },
  {
   "id": 37551,
   "key": "D1405ru.txt:196",
   "file": "D1405ru.txt",
   "line": 196,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ、エセルドレーダ。往くとしよう」 「決戦の地へ。血戦の地へ。時の果ての地へ。 過去と未来が交わる場所へ。渦巻く螺旋の頂上へ。運命の中心へ。 混沌を夢見る永劫の中枢へ。そう――」",
   "ko_candidate": "「자､ 에셀드레다｡ 가자｡ 결전의 땅으로｡ 혈전의 땅으로｡ 시간의 끝으로｡ 과거와 미래가 교차하는 장소로｡ 소용돌이치는 나선의 정상으로｡ 운명의 중심으로｡ 혼돈을 꿈꾸는 영겁의 중추로｡ 그래――」"
  },
  {
   "id": 37552,
   "key": "D1405ru.txt:202",
   "file": "D1405ru.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手を差し伸べて、闇の女が嗤う。",
   "ko_candidate": "손을 내밀며 어둠의 여자가 웃는다｡"
  },
  {
   "id": 37553,
   "key": "D1405ru.txt:203",
   "file": "D1405ru.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エセルドレーダの表情に、一瞬、僅かな嫌悪が宿る。",
   "ko_candidate": "에셀드레다의 표정에 순간 약간의 혐오가 깃든다｡"
  },
  {
   "id": 37554,
   "key": "D1405ru.txt:205",
   "file": "D1405ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれも凍りついた表情に呑まれ、溶けてゆく。",
   "ko_candidate": "하지만 그것도 얼어붙은 표정에 삼켜져 녹아간다｡"
  },
  {
   "id": 37555,
   "key": "D1405ru.txt:209",
   "file": "D1405ru.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処かで鍵が開く様な、小さな音が鳴った。",
   "ko_candidate": "어디선가 열쇠가 열리는 듯한 작은 소리가 울렸다｡"
  },
  {
   "id": 37556,
   "key": "D1405ru.txt:210",
   "file": "D1405ru.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が、溢れる。",
   "ko_candidate": "빛이 넘쳐난다｡"
  },
  {
   "id": 37557,
   "key": "D1405ru.txt:216",
   "file": "D1405ru.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光は、暁の薄闇を引き裂く様に乱舞して、２人を包み込んだ。",
   "ko_candidate": "섬광은 새벽의 어스름을 찢듯이 난무하며 두 사람을 감싸 안았다｡"
  },
  {
   "id": 37558,
   "key": "D1405ru.txt:217",
   "file": "D1405ru.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その器は、魂は、文字通り光の迅さで、総ての運命が結集する場所へと飛翔する。そう――",
   "ko_candidate": "그 그릇은､ 영혼은､ 말 그대로 빛의 속도로 모든 운명이 집결하는 장소로 비상한다｡ 그래――"
  },
  {
   "id": 37559,
   "key": "D1405ru.txt:224",
   "file": "D1405ru.txt",
   "line": 224,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ルルイエへ」",
   "ko_candidate": "「르뤼에로」"
  }
 ]
}