 "items": [
  {
   "id": 35266,
   "key": "D1311al.txt:921",
   "file": "D1311al.txt",
   "line": 921,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ！　始めよう！　創めよう！ だって待ち遠しい、 待ち遠しいんだ！」 「君達だって望んでいるんだろう!? 終われるんだ……君達にとっては、やっと終われるんだ！　そうさ、すぐにでも終わらせてあげるよ！」",
   "ko_candidate": "「자! 시작하자! 창조하자! {SetBacklog(\" \");}<voice name=\"ナイア\" class=\"ナイア\" src=\"voice/D13/1104209a\"> 기다려지니까､ 기다려지는 거야! 너희들도 바라고 있는 거지!? 끝낼 수 있어… 너희들에게는 드디어 끝낼 수 있는 거야! 그래､ 당장이라도 끝내줄게! 그래､ 너희들은 정말 훌륭한 아이들이었어!"
  },
  {
   "id": 35267,
   "key": "D1311al.txt:930",
   "file": "D1311al.txt",
   "line": 930,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そう、君達は本当に素晴らしい子達だった！ 嗚呼、愛しい……愛しいよ！」",
   "ko_candidate": "{SetBacklog(\" \");}<voice name=\"ナイア\" class=\"ナイア\" src=\"voice/D13/1104209d\"> 아아､ 사랑스러워… 사랑스러워!」"
  },
  {
   "id": 35268,
   "key": "D1311al.txt:934",
   "file": "D1311al.txt",
   "line": 934,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否。",
   "ko_candidate": "아니｡"
  },
  {
   "id": 35269,
   "key": "D1311al.txt:935",
   "file": "D1311al.txt",
   "line": 935,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛が悪に似ているのか。",
   "ko_candidate": "사랑이 악에 닮은 것인가｡"
  },
  {
   "id": 35270,
   "key": "D1311al.txt:937",
   "file": "D1311al.txt",
   "line": 937,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ともかくその邪悪は愛している。",
   "ko_candidate": "어쨌든 그 사악함은 사랑하고 있다｡"
  },
  {
   "id": 35271,
   "key": "D1311al.txt:938",
   "file": "D1311al.txt",
   "line": 938,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女の傀儡を愛している。",
   "ko_candidate": "그녀의 꼭두각시를 사랑하고 있다｡"
  },
  {
   "id": 35272,
   "key": "D1311al.txt:949",
   "file": "D1311al.txt",
   "line": 949,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字九郎！」",
   "ko_candidate": "「다이쥬지 쿠로!」"
  },
  {
   "id": 35273,
   "key": "D1311al.txt:952",
   "file": "D1311al.txt",
   "line": 952,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神を殺す刃を。",
   "ko_candidate": "신을 죽이는 칼날을｡"
  },
  {
   "id": 35274,
   "key": "D1311al.txt:963",
   "file": "D1311al.txt",
   "line": 963,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マスターテリオン！」",
   "ko_candidate": "「마스터 테리온!」"
  },
  {
   "id": 35275,
   "key": "D1311al.txt:966",
   "file": "D1311al.txt",
   "line": 966,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神を解き放つ鍵を。",
   "ko_candidate": "신을 풀어놓는 열쇠를｡"
  },
  {
   "id": 35276,
   "key": "D1311al.txt:975",
   "file": "D1311al.txt",
   "line": 975,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地球狂想曲最終楽章が幕を開ける。",
   "ko_candidate": "지구광상곡 최종악장의 막이 오른다｡"
  },
  {
   "id": 35277,
   "key": "D1311le.txt:13",
   "file": "D1311le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怨霊の慟哭が聴こえる。 だがその聲は弱々しい。",
   "ko_candidate": "【File13:BLADE RUNNER】closed<PRE>."
  },
  {
   "id": 35278,
   "key": "D1311le.txt:16",
   "file": "D1311le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瘴気が大気に溶けて四散し……聲もまた風に溶けて散ってゆく。",
   "ko_candidate": "원령의 통곡이 들린다｡ 하지만 그 소리는 약하다｡"
  },
  {
   "id": 35279,
   "key": "D1311le.txt:17",
   "file": "D1311le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ベルゼビュートは、何処にも居ない。",
   "ko_candidate": "장기가 대기에 녹아 사방으로 흩어지고… 소리 또한 바람에 녹아 흩어져간다｡"
  },
  {
   "id": 35280,
   "key": "D1311le.txt:19",
   "file": "D1311le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怨念の爆発は、無限大の熱量の中へと閉じ込められ、存在を消滅させられた。",
   "ko_candidate": "벨제뷰트는 어디에도 없다｡ 원념의 폭발은 무한대의 열량 속에 갇혀 존재를 소멸당했다｡"
  },
  {
   "id": 35281,
   "key": "D1311le.txt:32",
   "file": "D1311le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "レムリア・インパクトによって浄化された爆心地に、しかと大地を踏み締め、デモンベインは立つ。",
   "ko_candidate": "레무리아 임팩트에 의해 정화된 폭심지에 단단히 대지를 밟으며 데몬베인이 서 있다｡"
  },
  {
   "id": 35282,
   "key": "D1311le.txt:35",
   "file": "D1311le.txt",
   "line": 35,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――勝った」",
   "ko_candidate": "「――이겼다」"
  },
  {
   "id": 35283,
   "key": "D1311le.txt:53",
   "file": "D1311le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "司令室にも歓声が上がる。",
   "ko_candidate": "사령실에서도 환호성이 울려 퍼진다｡"
  },
  {
   "id": 35284,
   "key": "D1311le.txt:54",
   "file": "D1311le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの勇姿を見つめ、張り詰めていた瑠璃はようやく、表情を綻ばせた。",
   "ko_candidate": "데몬베인의 용맹한 모습을 바라보며 긴장하고 있던 루리는 마침내 표정을 풀었다｡"
  },
  {
   "id": 35285,
   "key": "D1311le.txt:60",
   "file": "D1311le.txt",
   "line": 60,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふう……間に合ったようですわね」",
   "ko_candidate": "「휴… 간신히 제때 도착한 것 같네요」"
  },
  {
   "id": 35286,
   "key": "D1311le.txt:68",
   "file": "D1311le.txt",
   "line": 68,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――残念ながら、間に合わなかったな。大十字九郎」",
   "ko_candidate": "「――안타깝게도 늦었다｡ 다이쥬지 쿠로」"
  },
  {
   "id": 35287,
   "key": "D1311le.txt:81",
   "file": "D1311le.txt",
   "line": 81,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「がっ……！」",
   "ko_candidate": "「윽…!」"
  },
  {
   "id": 35288,
   "key": "D1311le.txt:87",
   "file": "D1311le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空が墜ちてきたかと思った。",
   "ko_candidate": "하늘이 떨어져 내리는 줄 알았다｡"
  },
  {
   "id": 35289,
   "key": "D1311le.txt:88",
   "file": "D1311le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それほどの重圧が、世界に圧し寄せて来た。",
   "ko_candidate": "그만큼의 중압감이 세계를 압박해왔다｡"
  },
  {
   "id": 35290,
   "key": "D1311le.txt:90",
   "file": "D1311le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "このプレッシャー……この恐怖……この絶望感！",
   "ko_candidate": "이 압박감… 이 공포… 이 절망감!"
  },
  {
   "id": 35291,
   "key": "D1311le.txt:91",
   "file": "D1311le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さっきと……さっきと同じだ！　クトゥルーが吼えたときと――",
   "ko_candidate": "아까와… 아까와 똑같아! 크툴루가 포효했을 때와――"
  },
  {
   "id": 35292,
   "key": "D1311le.txt:94",
   "file": "D1311le.txt",
   "line": 94,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……」",
   "ko_candidate": "「아…」"
  },
  {
   "id": 35293,
   "key": "D1311le.txt:100",
   "file": "D1311le.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空を見上げる。",
   "ko_candidate": "상공을 올려다본다｡"
  },
  {
   "id": 35294,
   "key": "D1311le.txt:101",
   "file": "D1311le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "山が……醜怪で醜悪でおぞましく忌まわしく汚らわしい巨大で強大で絶大な邪悪の塊が――俺を見下ろしていた。",
   "ko_candidate": "산이… 추악하고 흉측하고 소름 끼치고 불길하고 더러운 거대하고 강대하고 절대적인 사악의 덩어리가――나를 내려다보고 있었다｡"
  },
  {
   "id": 35295,
   "key": "D1311le.txt:104",
   "file": "D1311le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――邪神の眸と、目が合ったのだ。",
   "ko_candidate": "――사신의 눈동자와 눈이 마주친 것이다｡"
  },
  {
   "id": 35296,
   "key": "D1311le.txt:108",
   "file": "D1311le.txt",
   "line": 108,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――――――――」",
   "ko_candidate": "「――――――――――――――――」"
  },
  {
   "id": 35297,
   "key": "D1311le.txt:112",
   "file": "D1311le.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の意識は、この瞬間、一度、粉微塵になった、と思う。",
   "ko_candidate": "내 의식은 이 순간 한 번 산산조각 났다고 생각한다｡"
  },
  {
   "id": 35298,
   "key": "D1311le.txt:114",
   "file": "D1311le.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕け散った意識の欠片を、魔術師の精神力が、必死に懸命に切実に掻き集め、繋ぎ合わせるまでの間の出来事を、俺は認識できない。",
   "ko_candidate": "부서진 의식의 파편을 마술사의 정신력이 필사적으로 열심히 절실하게 긁어모아 이어 붙이기까지의 사이에 일어난 일을 나는 인식할 수 없다｡"
  },
  {
   "id": 35299,
   "key": "D1311le.txt:116",
   "file": "D1311le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、砕け散る意識の断片は、それこそ断片的な映像を、脳にバラ撒いていった。",
   "ko_candidate": "다만 부서진 의식의 파편이 그야말로 파편적인 영상을 뇌에 흩뿌렸다｡"
  },
  {
   "id": 35300,
   "key": "D1311le.txt:118",
   "file": "D1311le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは――",
   "ko_candidate": "그것은――"
  },
  {
   "id": 35301,
   "key": "D1311le.txt:120",
   "file": "D1311le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大過ぎる邪神が蠢き――",
   "ko_candidate": "너무나 거대한 사신이 꿈틀거리고――"
  },
  {
   "id": 35302,
   "key": "D1311le.txt:122",
   "file": "D1311le.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "龍の首のような触腕の群れが、わななき、啓き――",
   "ko_candidate": "용의 머리와 같은 촉수의 무리가 떨리며 벌어지고――"
  },
  {
   "id": 35303,
   "key": "D1311le.txt:124",
   "file": "D1311le.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その奥に見える地獄の深淵の如き、口腔が――",
   "ko_candidate": "그 안쪽에 보이는 지옥의 심연과 같은 구강이――"
  },
  {
   "id": 35304,
   "key": "D1311le.txt:126",
   "file": "D1311le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宇宙的なエネルギーの爆発を――",
   "ko_candidate": "우주적인 에너지의 폭발을――"
  },
  {
   "id": 35305,
   "key": "D1311le.txt:132",
   "file": "D1311le.txt",
   "line": 132,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――――――九郎……！」",
   "ko_candidate": "「――――――――――――――쿠로…!」"
  }
 ]
}