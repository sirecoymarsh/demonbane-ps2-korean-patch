 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ドクター・ウェスト": "닥터 웨스트",
  "サンダルフォン": "산달폰",
  "ウェスト": "웨스트",
  "ブラックロッジ": "블랙로지",
  "エルザ": "엘자",
  "マスターテリオン": "마스터 테리온",
  "姫さん": "공주님",
  "アル": "알",
  "ダンセイニ": "던세이니"
 },
 "items": [
  {
   "id": 18478,
   "key": "D0903al.txt:15",
   "file": "D0903al.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪教の儀式を、冷ややかな目でそれを見つめる者もいた。",
   "ko_candidate": "연회의 열광에서 벗어나､ 차가운 눈으로 그것을 바라보는 자도 있었다｡"
  },
  {
   "id": 18479,
   "key": "D0903al.txt:19",
   "file": "D0903al.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――ドクター・ウェスト。",
   "ko_candidate": "――닥터 웨스트｡"
  },
  {
   "id": 18480,
   "key": "D0903al.txt:26",
   "file": "D0903al.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苛立ちをぶつけるかのように、ギターを掻き鳴らす。",
   "ko_candidate": "짜증을 부딪치듯이､ 기타를 긁어 울린다｡"
  },
  {
   "id": 18481,
   "key": "D0903al.txt:29",
   "file": "D0903al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "加速するビート。それは纏わりつく邪気を祓うかのように激しく、熱く――",
   "ko_candidate": "가속하는 비트｡ 하지만 그것도 이 열광을 상쇄하지는 못하고｡"
  },
  {
   "id": 18482,
   "key": "D0903al.txt:41",
   "file": "D0903al.txt",
   "line": 41,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「博士、五月蝿いロボ」 ごぎっ。",
   "ko_candidate": "더욱 짜증 나서､ 힘껏 현을 튕긴다｡"
  },
  {
   "id": 18483,
   "key": "D0903al.txt:53",
   "file": "D0903al.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "死を想起させるほどの生々しい粉砕音が、首の辺りから直接、ドクター・ウェストの鼓膜を震わせた。 首を危険な角度に曲げたまま、床にくずおれる。",
   "ko_candidate": "「박사､ 시끄러운 로봇」"
  },
  {
   "id": 18484,
   "key": "D0903al.txt:67",
   "file": "D0903al.txt",
   "line": 67,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おぅぐああ…… リンダ……ブレアぁああ……」 「……ん？」",
   "ko_candidate": "우두둑｡"
  },
  {
   "id": 18485,
   "key": "D0903al.txt:77",
   "file": "D0903al.txt",
   "line": 77,
   "speaker": "ウェスト",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ドクター・ウェストの視線が、柱に寄りかかる黒い影を捉えた。 「サンダルフォン、貴様であるか。どうした？　儀式には参加しないのであるか？」",
   "ko_candidate": "죽음을 연상시킬 정도의 생생한 분쇄음이､ 목 근처에서 직접､"
  },
  {
   "id": 18486,
   "key": "D0903al.txt:92",
   "file": "D0903al.txt",
   "line": 92,
   "speaker": "サンダルフォン / ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くだらん。己は乱痴気騒ぎには 興味ない」 「ほう、意見が合うな。我輩もこの美学の欠片もない下劣な戯れは好かんのである」",
   "ko_candidate": "닥터 웨스트의 고막을 진동시킨다｡"
  },
  {
   "id": 18487,
   "key": "D0903al.txt:103",
   "file": "D0903al.txt",
   "line": 103,
   "speaker": "サンダルフォン / ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「下劣なのはお前の存在自体だ」 「にゃにおう!?」",
   "ko_candidate": "엘자의 술식마포로 맞아､ 목이 위험한 각도로 꺾인 채로､ 그대로 바닥에 쓰러졌다｡"
  },
  {
   "id": 18488,
   "key": "D0903al.txt:116",
   "file": "D0903al.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "身を起こし、サンダルフォンに詰め寄ろうとする。 首は危険な方向に曲がったままだったが。",
   "ko_candidate": "엘자는 그런 창조주는 신경 쓰지 않고､ 아직 열기가 식지 않은 연회를 바라보고 있었다｡"
  },
  {
   "id": 18489,
   "key": "D0903al.txt:126",
   "file": "D0903al.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかしそのとき、異変に気づいた。",
   "ko_candidate": "「…………대단한 로봇」 왠지 얼굴이 붉다｡"
  },
  {
   "id": 18490,
   "key": "D0903al.txt:127",
   "file": "D0903al.txt",
   "line": 127,
   "speaker": "ウェスト",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "僧院が、揺れている。 「……何であるか？」",
   "ko_candidate": "닥터 웨스트는 엎드린 채로､ 시선을 움직인다｡"
  },
  {
   "id": 18491,
   "key": "D0903al.txt:142",
   "file": "D0903al.txt",
   "line": 142,
   "speaker": "サンダルフォン / ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――ほう、そろそろか」 「何？　……どわっ!?」",
   "ko_candidate": "그때 깨달았다｡ 눈을 감고､ 기둥에 기대어 있는 검은 그림자를｡"
  },
  {
   "id": 18492,
   "key": "D0903al.txt:160",
   "file": "D0903al.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "叩きつけるような揺れが僧院全体を襲う。 轟く爆音。破砕音。",
   "ko_candidate": "「산달폰､ 네놈이냐｡ 왜 그러나? 연회에는 참가하지 않는 것이냐?」"
  },
  {
   "id": 18493,
   "key": "D0903al.txt:168",
   "file": "D0903al.txt",
   "line": 168,
   "speaker": "ウェスト",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "信徒達が一斉に騒ぎ出す。揺れはすぐに、立っていられないほどの激しさになった。 「つっ……おっ！？　サンダルフォン！　いったい何が起こっているのであるか！？」",
   "ko_candidate": "「시시하군｡ 나는 난장판에는 흥미 없다」"
  },
  {
   "id": 18494,
   "key": "D0903al.txt:178",
   "file": "D0903al.txt",
   "line": 178,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「分からないのか、ウェスト？ 己達『ブラックロッジ』の最終目標だというのに」",
   "ko_candidate": "「호오､ 의견이 일치하는군｡ 나도 이 미학의 조각도 없는 천박한 장난은 좋아하지 않는다」"
  },
  {
   "id": 18495,
   "key": "D0903al.txt:185",
   "file": "D0903al.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ドクター・ウェストの表情が凍りつく。",
   "ko_candidate": "「천박한 건 네놈의 존재 자체다」 「뭐라고!?」"
  },
  {
   "id": 18496,
   "key": "D0903al.txt:186",
   "file": "D0903al.txt",
   "line": 186,
   "speaker": "ウェスト",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エルザは訳が分からずにきょとんとしていた。 「――ま、まさか」",
   "ko_candidate": "몸을 일으켜､ 산달폰에게 다가가려는 닥터 웨스트｡"
  },
  {
   "id": 18497,
   "key": "D0903al.txt:208",
   "file": "D0903al.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "壇上のマスターテリオンが諸手を広げて、信徒達の前に立つ。この激震の中、少年の華奢な躰は揺らぎともしない。 声高に叫ぶ。",
   "ko_candidate": "목은 위험한 방향으로 꺾인 채였지만｡"
  },
  {
   "id": 18498,
   "key": "D0903al.txt:212",
   "file": "D0903al.txt",
   "line": 212,
   "speaker": "マスターテリオン",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まるで神の王国の到来を告げる預言者のように。 「うろたえるな、皆の者。 ついに刻が満ちたのだ」",
   "ko_candidate": "하지만､ 그 전에 닥터 웨스트는 이변을 깨달았다｡"
  },
  {
   "id": 18499,
   "key": "D0903al.txt:231",
   "file": "D0903al.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大広間が鎮まり返る。",
   "ko_candidate": "수도원이､ 흔들리고 있다｡"
  },
  {
   "id": 18500,
   "key": "D0903al.txt:234",
   "file": "D0903al.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――刻が満ちた。 『ブラックロッジ』にとって、その言葉の意味するところは一つ。",
   "ko_candidate": "「……무엇이냐?」"
  },
  {
   "id": 18501,
   "key": "D0903al.txt:241",
   "file": "D0903al.txt",
   "line": 241,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ、覚醒よ――」",
   "ko_candidate": "「――호오､ 슬슬인가」"
  },
  {
   "id": 18502,
   "key": "D0903al.txt:273",
   "file": "D0903al.txt",
   "line": 273,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「う――――――ん…… 痛っ、痛たたたたた」 「あそこまで壮絶に 拳と拳で語り合えば、そりゃあな……」",
   "ko_candidate": "「뭐? ……으와!?」"
  },
  {
   "id": 18503,
   "key": "D0903al.txt:285",
   "file": "D0903al.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ソファーの上に姫さんを寝かせて、殴られた頬に濡れタオルを当てる。",
   "ko_candidate": "내리치듯 흔들림쬈?τ는원 전체를 덮친다｡"
  },
  {
   "id": 18504,
   "key": "D0903al.txt:288",
   "file": "D0903al.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気持ちが良いくらい、",
   "ko_candidate": "우렁찬 폭음｡ 파쇄음｡"
  },
  {
   "id": 18505,
   "key": "D0903al.txt:289",
   "file": "D0903al.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "綺麗に決まったクロスカウンターだった。",
   "ko_candidate": "난교에 빠져있던 신도들이 일제히 소란을 피운다｡"
  },
  {
   "id": 18506,
   "key": "D0903al.txt:294",
   "file": "D0903al.txt",
   "line": 294,
   "speaker": "九郎 / 瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちょい待ってな。救急箱を捜してくる」 「あ……いえ、そんな、お構いなく……」",
   "ko_candidate": "흔들림은 곧 서 있을 수 없을 정도로 격렬해졌다｡"
  },
  {
   "id": 18507,
   "key": "D0903al.txt:304",
   "file": "D0903al.txt",
   "line": 304,
   "speaker": "九郎 / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「顔に痕残すわけにはいかないだろ？ 良いから寝てろって」 「……妾も殴られたのだがな」",
   "ko_candidate": "「츳……옷!? 산달폰! 대체 무슨 일이 일어나고 있는 거냐!?」"
  },
  {
   "id": 18508,
   "key": "D0903al.txt:315",
   "file": "D0903al.txt",
   "line": 315,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いや……ちゃんと手当てしてやっから。絡むな」",
   "ko_candidate": "「모르겠나､ 웨스트? 우리 『블랙로지』의 최종 목표라는데」"
  },
  {
   "id": 18509,
   "key": "D0903al.txt:320",
   "file": "D0903al.txt",
   "line": 320,
   "speaker": "アル / ダンセイニ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふんっ」 「てけり・り」",
   "ko_candidate": "닥터 웨스트의 표정이 얼어붙는다｡"
  },
  {
   "id": 18510,
   "key": "D0903al.txt:329",
   "file": "D0903al.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルはそっぽを向いて鼻を鳴らし、ダンセイニの上に荒々しく腰を下ろす。 苦しそうな気配が、ダンセイニから伝わってきた。",
   "ko_candidate": "엘자는 영문을 모르고 어리둥절해 있었다｡"
  },
  {
   "id": 18511,
   "key": "D0903al.txt:331",
   "file": "D0903al.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……お互い苦労してるよな、俺ら。 救急箱を持ってきて、姫さんの頬に薬を塗る。",
   "ko_candidate": "「――설､ 설마」"
  },
  {
   "id": 18512,
   "key": "D0903al.txt:334",
   "file": "D0903al.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "染みるのか、ときおり苦しそうに、顔を引き攣らせる。",
   "ko_candidate": "단상의 마스터 테리온이 두 팔을 벌려､ 신도들 앞에 선다｡"
  },
  {
   "id": 18513,
   "key": "D0903al.txt:339",
   "file": "D0903al.txt",
   "line": 339,
   "speaker": "瑠璃 / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの……すみませんでした…… 何か、わざわざ迷惑をかけに、やって来たみたいで……」 「まったくだ」",
   "ko_candidate": "이 격렬한 땅울림 속에서､ 마스터 테리온의 몸은 흔들림 없이 서 있다｡"
  },
  {
   "id": 18514,
   "key": "D0903al.txt:350",
   "file": "D0903al.txt",
   "line": 350,
   "speaker": "九郎 / 瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いい加減にしろ、アル……。まあ、姫さんもほどほどにな。 それにしても、今日はやたらとヒートアップしてたみたいだけど。何でだ？」 「だって……」",
   "ko_candidate": "목소리 높여 외친다｡"
  },
  {
   "id": 18515,
   "key": "D0903al.txt:361",
   "file": "D0903al.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "姫さんはばつが悪そうに俯き、アルは不機嫌そうに顔を背けたまま。 やや間があって躊躇うように、姫さんが口を開く。",
   "ko_candidate": "마치 신의 왕국의 도래를 알리는 예언자처럼｡"
  },
  {
   "id": 18516,
   "key": "D0903al.txt:367",
   "file": "D0903al.txt",
   "line": 367,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アルは……いつも…… 一緒ですから……わたくし、 多分……嫉妬……」 「え？」",
   "ko_candidate": "「당황하지 마라､ 여러분｡ 드디어 때가 찼다」"
  },
  {
   "id": 18517,
   "key": "D0903al.txt:376",
   "file": "D0903al.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "姫さんの声は独り言のような呟きで、はっきりと聴こえない。 俺が尋ね返すと、姫さんは首を左右に振って。",
   "ko_candidate": "대광장이 조용해진다｡"
  }
 ]
}