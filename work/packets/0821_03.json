{
 "packet": "0821_03",
 "scene": "0821",
 "anchor": {
  "hit": 8,
  "total": 9,
  "rate": 0.889
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "マスターテリオン": "마스터 테리온"
 },
 "items": [
  {
   "id": 17615,
   "key": "D0821le.txt:340",
   "file": "D0821le.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らもまた虚無に閉じ込められたように。",
   "ko_candidate": "자신 또한 허무에 갇힌 것처럼｡"
  },
  {
   "id": 17616,
   "key": "D0821le.txt:342",
   "file": "D0821le.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の異形は続ける。",
   "ko_candidate": "황금빛 괴물은 계속한다｡"
  },
  {
   "id": 17617,
   "key": "D0821le.txt:343",
   "file": "D0821le.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其処にはやはり何の想いも宿りはせず――答えも、",
   "ko_candidate": "거기에는 역시 어떤 감정도 깃들지 않고―― 대답도､ 응답조차도"
  },
  {
   "id": 17618,
   "key": "D0821le.txt:344",
   "file": "D0821le.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "応えすらも望まず、ただただ一方的に、少年は問う。",
   "ko_candidate": "바라지 않고 그저 일방적으로 소년은 묻는다｡"
  },
  {
   "id": 17619,
   "key": "D0821le.txt:351",
   "file": "D0821le.txt",
   "line": 351,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「願いは叶ったのかな？」",
   "ko_candidate": "「소원은 이루어졌나요?」"
  },
  {
   "id": 17620,
   "key": "D0821le.txt:354",
   "file": "D0821le.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 17621,
   "key": "D0821le.txt:358",
   "file": "D0821le.txt",
   "line": 358,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「止めろ……」",
   "ko_candidate": "「그만둬…」"
  },
  {
   "id": 17622,
   "key": "D0821le.txt:361",
   "file": "D0821le.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの忌まわしい言葉で、呼びかける。",
   "ko_candidate": "그 저주스러운 말로 부른다｡"
  },
  {
   "id": 17623,
   "key": "D0821le.txt:362",
   "file": "D0821le.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即ち――",
   "ko_candidate": "즉――"
  },
  {
   "id": 17624,
   "key": "D0821le.txt:367",
   "file": "D0821le.txt",
   "line": 367,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「　　　」",
   "ko_candidate": "「　　　　」"
  },
  {
   "id": 17625,
   "key": "D0821le.txt:372",
   "file": "D0821le.txt",
   "line": 372,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その言葉で 呼ぶなぁぁぁぁぁぁ！」",
   "ko_candidate": "「그 말로 부르지 마아아아아아!」"
  },
  {
   "id": 17626,
   "key": "D0821le.txt:379",
   "file": "D0821le.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生命の温もりが失われた身体を、それでも突き動かす莫大な熱量。",
   "ko_candidate": "생명의 열기가 다한 몸을 그래도 움직이게 하는 열기가 있다｡"
  },
  {
   "id": 17627,
   "key": "D0821le.txt:381",
   "file": "D0821le.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "残る生命を燃焼させる――",
   "ko_candidate": "남은 생명을 연소시키는――"
  },
  {
   "id": 17628,
   "key": "D0821le.txt:381",
   "file": "D0821le.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憎悪。",
   "ko_candidate": "증오｡"
  },
  {
   "id": 17629,
   "key": "D0821le.txt:382",
   "file": "D0821le.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生理的嫌悪。",
   "ko_candidate": "생리적 혐오｡"
  },
  {
   "id": 17630,
   "key": "D0821le.txt:384",
   "file": "D0821le.txt",
   "line": 384,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『暴君』が『獣』に飛びかかる。 「かっ……」",
   "ko_candidate": "『폭군』은 『짐승』에게 달려든다｡"
  },
  {
   "id": 17631,
   "key": "D0821le.txt:401",
   "file": "D0821le.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "雨に混じって、血飛沫が地面を濡らした。",
   "ko_candidate": "비에 섞이는 붉은 물방울｡ 피의 비를 내린다｡"
  },
  {
   "id": 17632,
   "key": "D0821le.txt:412",
   "file": "D0821le.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マスターテリオンの手が『暴君』の腹をえぐった。",
   "ko_candidate": "「큭…」 마스터 테리온의 손이 『폭군』의 배를 파고들고 있었다｡"
  },
  {
   "id": 17633,
   "key": "D0821le.txt:413",
   "file": "D0821le.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "深く手をねじ込む。",
   "ko_candidate": "내장을 휘저으듯 더욱 손을 비틀어 넣는다｡"
  },
  {
   "id": 17634,
   "key": "D0821le.txt:419",
   "file": "D0821le.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――絶叫。",
   "ko_candidate": "――절규｡"
  },
  {
   "id": 17635,
   "key": "D0821le.txt:422",
   "file": "D0821le.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "表情の無いマスターテリオンの眸に初めて、彩が宿る。恍惚。陶然。愉悦。背徳。",
   "ko_candidate": "표정 없는 마스터 테리온의 눈동자에 처음으로 감정의 색채가 깃든다｡ 환희｡ 도취｡ 쾌락｡ 배덕｡"
  },
  {
   "id": 17636,
   "key": "D0821le.txt:425",
   "file": "D0821le.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "熱に浮かされた様に、蕩ける瞳。紅潮する頬。",
   "ko_candidate": "열에 들뜬 듯 녹아내리는 눈동자｡ 붉어지는 뺨｡"
  },
  {
   "id": 17637,
   "key": "D0821le.txt:426",
   "file": "D0821le.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "震える躰。涎を垂らす舌。",
   "ko_candidate": "절정에 이른 여자처럼 떨리는 몸｡ 침을 흘리는 혀｡"
  },
  {
   "id": 17638,
   "key": "D0821le.txt:431",
   "file": "D0821le.txt",
   "line": 431,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「死にたければ、 好きなだけ死ぬが良いさ」",
   "ko_candidate": "「죽고 싶다면 마음껏 죽어도 좋아」"
  },
  {
   "id": 17639,
   "key": "D0821le.txt:435",
   "file": "D0821le.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "路地の奥。降りしきる雨の向こうに霞む影。",
   "ko_candidate": "골목 안쪽｡ 쏟아지는 비 너머로 흐릿하게 보이는 그림자｡"
  },
  {
   "id": 17640,
   "key": "D0821le.txt:436",
   "file": "D0821le.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、闇。澱む闇。不定形の闇。",
   "ko_candidate": "아니､ 어둠｡ 고여 있는 어둠｡ 부정형의 어둠｡"
  },
  {
   "id": 17641,
   "key": "D0821le.txt:437",
   "file": "D0821le.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇のカタチの女。",
   "ko_candidate": "어둠의 형상을 한 여자｡"
  },
  {
   "id": 17642,
   "key": "D0821le.txt:444",
   "file": "D0821le.txt",
   "line": 444,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ナ……イア……るぁ……」",
   "ko_candidate": "「나… 이아… 르아…」 여자가 웃는다｡"
  },
  {
   "id": 17643,
   "key": "D0821le.txt:447",
   "file": "D0821le.txt",
   "line": 447,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "女が嗤う。 澱む闇が嗤う。",
   "ko_candidate": "고여 있는 어둠이 웃는다｡"
  },
  {
   "id": 17644,
   "key": "D0821le.txt:449",
   "file": "D0821le.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不定形の闇が嗤う。",
   "ko_candidate": "부정형의 어둠이 웃는다｡"
  },
  {
   "id": 17645,
   "key": "D0821le.txt:453",
   "file": "D0821le.txt",
   "line": 453,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「本当に必要なのは、君じゃあない。……分かっているだろう？」",
   "ko_candidate": "「정말로 필요한 건 너가 아니야｡ …알고 있겠지?」 마스터 테리온의 손이 빠져나온다｡"
  },
  {
   "id": 17646,
   "key": "D0821le.txt:463",
   "file": "D0821le.txt",
   "line": 463,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ァ――――――――――ッッ！」",
   "ko_candidate": "살을､ 내장을 끊어내는 소리｡ 마스터 테리온의 손에 창자가 감겨 끊어져 떨어졌다｡"
  },
  {
   "id": 17647,
   "key": "D0821le.txt:467",
   "file": "D0821le.txt",
   "line": 467,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ、そうそう。言っておくけどね。今回みたいなケースは初めてじゃない。今までにも……３３回くらいあったかな？　君は識らなかったようだけど」",
   "ko_candidate": "「아――――――――――악!」 「아､ 그래 그래｡ 말해두지만 말이야｡ 이번 같은 경우는 처음이 아니야｡ 지금까지… 33번 정도 있었나? 너는 모르고 있었던 것 같지만 말이야」"
  },
  {
   "id": 17648,
   "key": "D0821le.txt:470",
   "file": "D0821le.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶望。",
   "ko_candidate": "절망｡"
  },
  {
   "id": 17649,
   "key": "D0821le.txt:471",
   "file": "D0821le.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死の恐怖をも呑み込む、深い深い絶望。",
   "ko_candidate": "죽음의 공포마저 삼켜버리는 깊디깊은 절망｡"
  },
  {
   "id": 17650,
   "key": "D0821le.txt:472",
   "file": "D0821le.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ては、運命の奴隷。",
   "ko_candidate": "모든 것은 운명의 노예｡"
  },
  {
   "id": 17651,
   "key": "D0821le.txt:474",
   "file": "D0821le.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "終わらない。",
   "ko_candidate": "끝나지 않는다｡"
  },
  {
   "id": 17652,
   "key": "D0821le.txt:475",
   "file": "D0821le.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遁れられない。",
   "ko_candidate": "벗어날 수 없다｡"
  },
  {
   "id": 17653,
   "key": "D0821le.txt:476",
   "file": "D0821le.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "より致命的な結末を求めて、運命の螺旋は加速する。",
   "ko_candidate": "더욱 치명적인 결말을 향해 운명의 나선은 가속한다｡"
  },
  {
   "id": 17654,
   "key": "D0821le.txt:477",
   "file": "D0821le.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂狂と。",
   "ko_candidate": "미친 듯이｡"
  }
 ]
}