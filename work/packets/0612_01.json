 },
 "items": [
  {
   "id": 7748,
   "key": "D0612.txt:333",
   "file": "D0612.txt",
   "line": 333,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「また傷が開いたか！　だから応急処置だと言ったろうに！」",
   "ko_candidate": "「또 상처가 벌어졌군! 그래서 응급처치라고 했잖아!」"
  },
  {
   "id": 7749,
   "key": "D0612.txt:339",
   "file": "D0612.txt",
   "line": 339,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああ……さすがに意識が遠のいたぜ。もう少しで地面に激突しているところだった」",
   "ko_candidate": "「아아… 역시 의식이 멀어지는군｡ 조금만 더 있었으면 지면에 충돌할 뻔했어」"
  },
  {
   "id": 7750,
   "key": "D0612.txt:345",
   "file": "D0612.txt",
   "line": 345,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何を呑気に！ これ以上の出血は危険だぞ！」",
   "ko_candidate": "「뭘 태연하게! 이 이상의 출혈은 위험해!」"
  },
  {
   "id": 7751,
   "key": "D0612.txt:351",
   "file": "D0612.txt",
   "line": 351,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「つってもなあ……向こうさんは見逃しちゃくれねえだろ」",
   "ko_candidate": "「그래도 말이지… 저쪽에서는 그냥 보내주지 않을 거야」"
  },
  {
   "id": 7752,
   "key": "D0612.txt:364",
   "file": "D0612.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "背後に見えるベルゼビュートを顎で指して、毒づいた。",
   "ko_candidate": "뒤에 보이는 벨제뷰트를 턱으로 가리키며 쿠로는 중얼거렸다｡"
  },
  {
   "id": 7753,
   "key": "D0612.txt:366",
   "file": "D0612.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "瑠璃を降ろして、ベルゼビュートと対峙する。",
   "ko_candidate": "루리의 몸을 내려놓고 벨제뷰트와 대치한다｡"
  },
  {
   "id": 7754,
   "key": "D0612.txt:370",
   "file": "D0612.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――血まみれの背中が、瑠璃の目の前に晒される。",
   "ko_candidate": "피투성이의 등이 루리의 눈앞에 드러난다｡"
  },
  {
   "id": 7755,
   "key": "D0612.txt:376",
   "file": "D0612.txt",
   "line": 376,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ま、まだ戦おうとしているのですか、大十字さん！？」",
   "ko_candidate": "「아､ 아직 싸우려고 하는 겁니까､ 다이쥬지 씨!?」"
  },
  {
   "id": 7756,
   "key": "D0612.txt:382",
   "file": "D0612.txt",
   "line": 382,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「すまんな、またデモンベインを使わせてもらう」",
   "ko_candidate": "「미안해､ 또 데몬베인을 써야겠어」"
  },
  {
   "id": 7757,
   "key": "D0612.txt:388",
   "file": "D0612.txt",
   "line": 388,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんなことを言っているのではありませんわ！　この場は逃げるのです！」 「早く手当てしないと手遅れになりますよ!?」",
   "ko_candidate": "「그런 말을 하는 게 아닙니다! 여기서 도망쳐야 해요! 빨리 치료하지 않으면 늦어버립니다!?」"
  },
  {
   "id": 7758,
   "key": "D0612.txt:396",
   "file": "D0612.txt",
   "line": 396,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「このままじゃ俺の気が済まねえ」",
   "ko_candidate": "「이대로는 내 마음이 안 풀려」"
  },
  {
   "id": 7759,
   "key": "D0612.txt:402",
   "file": "D0612.txt",
   "line": 402,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そんなくだらん理由か!?」",
   "ko_candidate": "「그런 시시한 이유입니까!?」"
  },
  {
   "id": 7760,
   "key": "D0612.txt:415",
   "file": "D0612.txt",
   "line": 415,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「それだけじゃねえ。あんなイカれた奴ほっといて逃げてみろよ。何しでかすか分からないぜ？　だったらここで潰さなきゃな」",
   "ko_candidate": "「그것뿐만이 아니야｡ 저런 미친 놈을 그대로 두고 도망가 봐｡ 뭘 저지를지 모르잖아? 그렇다면 여기서 박살내야지」"
  },
  {
   "id": 7761,
   "key": "D0612.txt:424",
   "file": "D0612.txt",
   "line": 424,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そ、そんな、だ、駄目です！ だって血が！　血が、血が、 血が、そんなにたくさん！ 血が……っ！」 九郎の怪我を見て、瑠璃はすっかり取り乱してしまっていた。",
   "ko_candidate": "「그､ 그런､ 안､ 안 돼요! 피가! 피가､ 피가､ 피가､ 그렇게 많이! 피가…!」"
  },
  {
   "id": 7762,
   "key": "D0612.txt:458",
   "file": "D0612.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "九郎は困ったように頬を掻いた。",
   "ko_candidate": "쿠로의 부상을 보고 루리는 완전히 당황해버렸다｡"
  },
  {
   "id": 7763,
   "key": "D0612.txt:461",
   "file": "D0612.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それからまた、さっきと同じく瑠璃の頭をくしゃくしゃに撫でたのだった。",
   "ko_candidate": "쿠로는 난처한 듯 머리를 긁더니 또 아까처럼 루리의 머리를 헝클어뜨리듯 쓰다듬었다｡"
  },
  {
   "id": 7764,
   "key": "D0612.txt:473",
   "file": "D0612.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎は困ったように頬を掻いた。 それから子どもにするみたいに、瑠璃の頭を撫でたのだった。",
   "ko_candidate": "「앗…」"
  },
  {
   "id": 7765,
   "key": "D0612.txt:492",
   "file": "D0612.txt",
   "line": 492,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あっ……」",
   "ko_candidate": "「죽지 않아」"
  },
  {
   "id": 7766,
   "key": "D0612.txt:498",
   "file": "D0612.txt",
   "line": 498,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「死なねえよ」 根拠もなく断言する。",
   "ko_candidate": "근거도 없이 단언한다｡ 그뿐이다｡"
  },
  {
   "id": 7767,
   "key": "D0612.txt:506",
   "file": "D0612.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "再びベルゼビュートに向き直り、九郎は叫んだ。",
   "ko_candidate": "다시 벨제뷰트를 향해 쿠로는 외친다｡"
  },
  {
   "id": 7768,
   "key": "D0612.txt:513",
   "file": "D0612.txt",
   "line": 513,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やるぞ、アル！」",
   "ko_candidate": "「가자､ 알!」"
  },
  {
   "id": 7769,
   "key": "D0612.txt:518",
   "file": "D0612.txt",
   "line": 518,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「し、しかし……」",
   "ko_candidate": "「하､ 하지만…」"
  },
  {
   "id": 7770,
   "key": "D0612.txt:523",
   "file": "D0612.txt",
   "line": 523,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どのみちアレ相手に逃げ切れるとは思えねえよ！」",
   "ko_candidate": "「어차피 저놈을 상대로 도망칠 수 있을 거라고는 생각하지 않아!」"
  },
  {
   "id": 7771,
   "key": "D0612.txt:529",
   "file": "D0612.txt",
   "line": 529,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……分かった。だが無理だと判断したら、他の全てを見捨ててでも逃げるからな！」",
   "ko_candidate": "「…알겠다｡ 하지만 무리라고 판단하면 다른 모든 것을 버리고라도 도망칠 거야!」"
  },
  {
   "id": 7772,
   "key": "D0612.txt:535",
   "file": "D0612.txt",
   "line": 535,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「余計なことを考えるな！ いくぜ！」",
   "ko_candidate": "「쓸데없는 생각하지 마! 간다!」"
  },
  {
   "id": 7773,
   "key": "D0612.txt:551",
   "file": "D0612.txt",
   "line": 551,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……同じだ。",
   "ko_candidate": "…똑같아｡"
  },
  {
   "id": 7774,
   "key": "D0612.txt:553",
   "file": "D0612.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頭を撫でられながら、瑠璃は思った。",
   "ko_candidate": "또 머리를 쓰다듬으며 루리는 생각했다｡"
  },
  {
   "id": 7775,
   "key": "D0612.txt:557",
   "file": "D0612.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうだ、同じだ。",
   "ko_candidate": "그래､ 똑같아｡"
  },
  {
   "id": 7776,
   "key": "D0612.txt:558",
   "file": "D0612.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あのときと同じだ。",
   "ko_candidate": "그때와 똑같아｡"
  },
  {
   "id": 7777,
   "key": "D0612.txt:561",
   "file": "D0612.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あのとき……両親の葬儀の日。",
   "ko_candidate": "그때… 부모님의 장례식 날｡"
  },
  {
   "id": 7778,
   "key": "D0612.txt:572",
   "file": "D0612.txt",
   "line": 572,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "独り墓にすがりついて泣く自分と、彼女の悲しみを黙って受け止めてくれた祖父。",
   "ko_candidate": "모든 것이 끝난 후､ 혼자 무덤에 매달려 우는 자신과 그녀의 슬픔을 묵묵히 받아들여 준 할아버지｡"
  },
  {
   "id": 7779,
   "key": "D0612.txt:575",
   "file": "D0612.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの日、祖父に尋ねたのだ。",
   "ko_candidate": "그날､ 자신은 할아버지에게 물었던 것이다｡"
  },
  {
   "id": 7780,
   "key": "D0612.txt:577",
   "file": "D0612.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無力だった自分がありったけの力でぶつけた、無垢 で、痛切で、ちっぽけな憎悪の言葉。",
   "ko_candidate": "무력했던 자신이 있는 힘껏 부딪친､ 순수하고 절절하고 보잘것없는 증오의 말｡"
  },
  {
   "id": 7781,
   "key": "D0612.txt:581",
   "file": "D0612.txt",
   "line": 581,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは――",
   "ko_candidate": "그것은――"
  },
  {
   "id": 7782,
   "key": "D0612.txt:591",
   "file": "D0612.txt",
   "line": 591,
   "speaker": "少女瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なんで……なんで、 こんなにひどいことが許されるの ですか！？　神様は、この世には いないんですか！？」",
   "ko_candidate": "「왜… 왜 이런 끔찍한 일이 허용되는 겁니까!? 신은 이 세상에 없는 건가요!?」 할아버지는 그 증오도 받아들여 주셨다｡"
  },
  {
   "id": 7783,
   "key": "D0612.txt:607",
   "file": "D0612.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "祖父はその憎悪も受け止めてくれた。",
   "ko_candidate": "그리고 묵묵히 자신의 머리를 쓰다듬어 주셨던 것이다｡"
  },
  {
   "id": 7784,
   "key": "D0612.txt:610",
   "file": "D0612.txt",
   "line": 610,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして黙って、頭を撫でてくれたのだ。",
   "ko_candidate": "마디 굵은､ 하지만 크고 따뜻한 손바닥｡"
  },
  {
   "id": 7785,
   "key": "D0612.txt:613",
   "file": "D0612.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "節くれだった、だけれども大きく、暖かな手のひら。",
   "ko_candidate": "…닮았다｡ 쿠로의 손바닥의 온기는 그런 할아버지와 닮았다｡"
  },
  {
   "id": 7786,
   "key": "D0612.txt:616",
   "file": "D0612.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……似ている。",
   "ko_candidate": "왜일까? 모르겠다｡"
  },
  {
   "id": 7787,
   "key": "D0612.txt:619",
   "file": "D0612.txt",
   "line": 619,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎の手のひらは、そんな祖父の温もりと似ているのだ。 何故かは分からない……分からないが、瑠璃はそこに何か２人に共通する意志のようなものを感じ取った。",
   "ko_candidate": "다만 루리는 거기에 무언가､ 두 사람에게 공통된 의지 같은 것을 느꼈다｡"
  }
 ]
}