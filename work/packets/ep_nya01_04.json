   "ko_candidate": "앞으로｡"
  },
  {
   "id": 50059,
   "key": "ep_nya01.txt:662",
   "file": "ep_nya01.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "後ろに。",
   "ko_candidate": "뒤로｡"
  },
  {
   "id": 50060,
   "key": "ep_nya01.txt:663",
   "file": "ep_nya01.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "逆しまに。",
   "ko_candidate": "거꾸로｡"
  },
  {
   "id": 50061,
   "key": "ep_nya01.txt:664",
   "file": "ep_nya01.txt",
   "line": 664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それ以外の角度に。",
   "ko_candidate": "그 외의 각도로｡"
  },
  {
   "id": 50062,
   "key": "ep_nya01.txt:666",
   "file": "ep_nya01.txt",
   "line": 666,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "目指すは――",
   "ko_candidate": "목표는――"
  },
  {
   "id": 50063,
   "key": "ep_nya01.txt:673",
   "file": "ep_nya01.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔導書の紙片が舞い散る。",
   "ko_candidate": "마도서의 종이 조각이 흩날린다｡"
  },
  {
   "id": 50064,
   "key": "ep_nya01.txt:674",
   "file": "ep_nya01.txt",
   "line": 674,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "はらり、はらりと。",
   "ko_candidate": "팔랑､ 팔랑｡ 꽃잎처럼｡"
  },
  {
   "id": 50065,
   "key": "ep_nya01.txt:675",
   "file": "ep_nya01.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "花びらの様に。 酷く、幻想的な光景。",
   "ko_candidate": "끔찍하리만치 환상적인 광경｡"
  },
  {
   "id": 50066,
   "key": "ep_nya01.txt:678",
   "file": "ep_nya01.txt",
   "line": 678,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして――花と舞い散る断片の向こう。",
   "ko_candidate": "그리고―― 꽃처럼 흩날리는 파편 너머｡"
  },
  {
   "id": 50067,
   "key": "ep_nya01.txt:681",
   "file": "ep_nya01.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "図書館の最奥。",
   "ko_candidate": "도서관의 가장 안쪽｡"
  },
  {
   "id": 50068,
   "key": "ep_nya01.txt:690",
   "file": "ep_nya01.txt",
   "line": 690,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は、その少女の姿を見つけた。",
   "ko_candidate": "나는､ 그 소녀의 모습을 발견했다｡"
  },
  {
   "id": 50069,
   "key": "ep_nya01.txt:697",
   "file": "ep_nya01.txt",
   "line": 697,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル――――！」",
   "ko_candidate": "「알――――!」"
  },
  {
   "id": 50070,
   "key": "ep_nya01.txt:705",
   "file": "ep_nya01.txt",
   "line": 705,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は駈け出した。",
   "ko_candidate": "나는 달려나갔다｡"
  },
  {
   "id": 50071,
   "key": "ep_nya01.txt:706",
   "file": "ep_nya01.txt",
   "line": 706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "逃がしてはいけない。",
   "ko_candidate": "놓쳐선 안 된다｡"
  },
  {
   "id": 50072,
   "key": "ep_nya01.txt:707",
   "file": "ep_nya01.txt",
   "line": 707,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "見失ってはいけない。",
   "ko_candidate": "시야에서 놓쳐선 안 된다｡"
  },
  {
   "id": 50073,
   "key": "ep_nya01.txt:709",
   "file": "ep_nya01.txt",
   "line": 709,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "彼女だけが、",
   "ko_candidate": "그녀만이､"
  },
  {
   "id": 50074,
   "key": "ep_nya01.txt:710",
   "file": "ep_nya01.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼女の存在だけが、",
   "ko_candidate": "그녀의 존재만이､"
  },
  {
   "id": 50075,
   "key": "ep_nya01.txt:711",
   "file": "ep_nya01.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この悪夢で唯一、俺を救うのだから、",
   "ko_candidate": "이 악몽에서 유일하게 나를 구할 테니까､"
  },
  {
   "id": 50076,
   "key": "ep_nya01.txt:716",
   "file": "ep_nya01.txt",
   "line": 716,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無限とも思われた数歩を駈け抜け、手を伸ばす。",
   "ko_candidate": "무한할 것만 같던 걸음을 달려 지나､ 손을 뻗는다｡"
  },
  {
   "id": 50077,
   "key": "ep_nya01.txt:717",
   "file": "ep_nya01.txt",
   "line": 717,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "指先が、アルの躰に触れ――",
   "ko_candidate": "손끝이 알의 몸에 닿고――"
  },
  {
   "id": 50078,
   "key": "ep_nya01.txt:732",
   "file": "ep_nya01.txt",
   "line": 732,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 50079,
   "key": "ep_nya01.txt:736",
   "file": "ep_nya01.txt",
   "line": 736,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "砕け散る。",
   "ko_candidate": "부서져 흩어진다｡"
  },
  {
   "id": 50080,
   "key": "ep_nya01.txt:737",
   "file": "ep_nya01.txt",
   "line": 737,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの躰が、",
   "ko_candidate": "알의 몸이､"
  },
  {
   "id": 50081,
   "key": "ep_nya01.txt:738",
   "file": "ep_nya01.txt",
   "line": 738,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無数の魔導書の頁となって解け、散ってゆく。",
   "ko_candidate": "무수한 마도서의 페이지가 되어 녹아내리고､ 흩어져간다｡"
  },
  {
   "id": 50082,
   "key": "ep_nya01.txt:741",
   "file": "ep_nya01.txt",
   "line": 741,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あ……あああ…… ああああああああああああああああああ！」",
   "ko_candidate": "「아… 아아아… 아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 50083,
   "key": "ep_nya01.txt:747",
   "file": "ep_nya01.txt",
   "line": 747,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は必死になって、 アルだった紙切れを掻き集めようとした。",
   "ko_candidate": "나는 필사적으로 알이었던 종이 조각들을 긁어모으려 했다｡"
  },
  {
   "id": 50084,
   "key": "ep_nya01.txt:749",
   "file": "ep_nya01.txt",
   "line": 749,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが手を伸ばせば、紙片は、 するりと指の隙間から逃げてゆく。",
   "ko_candidate": "하지만 손을 뻗으면､ 종이 조각은 미끄럽게 손가락 틈새로 빠져나간다｡"
  },
  {
   "id": 50085,
   "key": "ep_nya01.txt:751",
   "file": "ep_nya01.txt",
   "line": 751,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は半狂乱になって、両手を振り回していた。",
   "ko_candidate": "나는 반광란이 되어 양손을 휘둘렀다｡"
  },
  {
   "id": 50086,
   "key": "ep_nya01.txt:753",
   "file": "ep_nya01.txt",
   "line": 753,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺には",
   "ko_candidate": "나에겐"
  },
  {
   "id": 50087,
   "key": "ep_nya01.txt:754",
   "file": "ep_nya01.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルが",
   "ko_candidate": "알이"
  },
  {
   "id": 50088,
   "key": "ep_nya01.txt:755",
   "file": "ep_nya01.txt",
   "line": 755,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルだけが――！",
   "ko_candidate": "알만이――!"
  },
  {
   "id": 50089,
   "key": "ep_nya01.txt:762",
   "file": "ep_nya01.txt",
   "line": 762,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「残念。ここまでだ」",
   "ko_candidate": "「안타깝군｡ 여기까지다」"
  },
  {
   "id": 50090,
   "key": "ep_nya01.txt:768",
   "file": "ep_nya01.txt",
   "line": 768,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "背後から聲が聴こえた。",
   "ko_candidate": "뒤에서 목소리가 들렸다｡"
  },
  {
   "id": 50091,
   "key": "ep_nya01.txt:769",
   "file": "ep_nya01.txt",
   "line": 769,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の心臓が凍りついた。",
   "ko_candidate": "내 심장이 얼어붙었다｡"
  },
  {
   "id": 50092,
   "key": "ep_nya01.txt:786",
   "file": "ep_nya01.txt",
   "line": 786,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎――君は僕のものだ」",
   "ko_candidate": "어깨에 기대어 있는 두 팔｡ 등에 밀착된 풍만한 가슴｡"
  },
  {
   "id": 50093,
   "key": "ep_nya01.txt:790",
   "file": "ep_nya01.txt",
   "line": 790,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「が……あ……あああああああ！」",
   "ko_candidate": "귓가에 속삭이는 뜨거운 숨결｡ 「쿠로―― 넌 내 거야」"
  },
  {
   "id": 50094,
   "key": "ep_nya01.txt:794",
   "file": "ep_nya01.txt",
   "line": 794,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「もう……そんなに怖がらなくても良いじゃないか。まあ、怯える君も可愛いけどね……」",
   "ko_candidate": "「으… 아… 아아아아아아아!」 「이제… 그렇게 무서워하지 않아도 돼｡ 뭐､ 겁에 질린 네 모습도 귀엽지만 말이야…」"
  }
 ]
}