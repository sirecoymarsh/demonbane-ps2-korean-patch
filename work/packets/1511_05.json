 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "リベル・レギス": "리베르 레기스",
  "アル": "알",
  "大十字九郎": "다이쥬지 쿠로",
  "魔力": "마력"
 },
 "items": [
  {
   "id": 46222,
   "key": "D1511ru.txt:430",
   "file": "D1511ru.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魂の奥底が必死になって警鐘を鳴らす。",
   "ko_candidate": "영혼의 깊은 곳에서 필사적으로 경종을 울린다｡"
  },
  {
   "id": 46223,
   "key": "D1511ru.txt:432",
   "file": "D1511ru.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが死にかけの心と躰に、その聲はあまりにも遠い。",
   "ko_candidate": "하지만 죽음 직전의 마음과 몸에는､ 그 소리가 너무나 멀다｡"
  },
  {
   "id": 46224,
   "key": "D1511ru.txt:433",
   "file": "D1511ru.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここで終わるのか――",
   "ko_candidate": "여기서 끝나는 건가――"
  },
  {
   "id": 46225,
   "key": "D1511ru.txt:438",
   "file": "D1511ru.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶望していた。",
   "ko_candidate": "절망하고 있었다｡"
  },
  {
   "id": 46226,
   "key": "D1511ru.txt:439",
   "file": "D1511ru.txt",
   "line": 439,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "諦めていた。",
   "ko_candidate": "포기하고 있었다｡"
  },
  {
   "id": 46227,
   "key": "D1511ru.txt:441",
   "file": "D1511ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "でも。",
   "ko_candidate": "하지만｡"
  },
  {
   "id": 46228,
   "key": "D1511ru.txt:443",
   "file": "D1511ru.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "でも、それでも、なお。",
   "ko_candidate": "하지만､ 그래도､ 여전히｡"
  },
  {
   "id": 46229,
   "key": "D1511ru.txt:447",
   "file": "D1511ru.txt",
   "line": 447,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――もう動かないと思っていたデモンベインの右腕は動いた。",
   "ko_candidate": "――이제 움직이지 않을 거라 생각했던 데몬베인의 오른팔이 움직였다｡"
  },
  {
   "id": 46230,
   "key": "D1511ru.txt:449",
   "file": "D1511ru.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動かしている意識はなかった。",
   "ko_candidate": "움직이고 있다는 의식은 없었다｡"
  },
  {
   "id": 46231,
   "key": "D1511ru.txt:450",
   "file": "D1511ru.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ何かが、遥か彼方から届いた何かが、内部から沸き起こった何かが、俺の意志とは別にデモンベインを突き動かしていた。",
   "ko_candidate": "단지 무언가가､ 아득히 먼 곳에서 도달한 무언가가､ 내부에서 솟아오른 무언가가､ 내 의지와는 별개로 데몬베인을 움직이고 있었다｡"
  },
  {
   "id": 46232,
   "key": "D1511ru.txt:454",
   "file": "D1511ru.txt",
   "line": 454,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……か……ああ……っ！」",
   "ko_candidate": "「아……카……아아……읏!」"
  },
  {
   "id": 46233,
   "key": "D1511ru.txt:457",
   "file": "D1511ru.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれはあまりにもささやかな抵抗。",
   "ko_candidate": "하지만 그것은 너무나도 미약한 저항｡"
  },
  {
   "id": 46234,
   "key": "D1511ru.txt:458",
   "file": "D1511ru.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その何かにどんな想いや意志が込められていたとしても、次のリベル・レギスの暴力を前にして、一切合切が無に還る。",
   "ko_candidate": "그 무언가에 어떤 마음이나 의지가 담겨 있었다 해도､ 다음 리베르 레기스의 폭력 앞에서､ 모든 것이 무로 돌아간다｡"
  },
  {
   "id": 46235,
   "key": "D1511ru.txt:460",
   "file": "D1511ru.txt",
   "line": 460,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何の意味も無く。",
   "ko_candidate": "아무런 의미도 없이｡"
  },
  {
   "id": 46236,
   "key": "D1511ru.txt:461",
   "file": "D1511ru.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただただ理不尽に。",
   "ko_candidate": "그저 부조리하게｡"
  },
  {
   "id": 46237,
   "key": "D1511ru.txt:463",
   "file": "D1511ru.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "放たれる強大無慈悲の滅意の波動。",
   "ko_candidate": "방출되는 강대무자비의 멸의의 파동｡"
  },
  {
   "id": 46238,
   "key": "D1511ru.txt:464",
   "file": "D1511ru.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避けられるはずもない。",
   "ko_candidate": "피할 수 있을 리가 없다｡"
  },
  {
   "id": 46239,
   "key": "D1511ru.txt:465",
   "file": "D1511ru.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "耐えられるはずもない。",
   "ko_candidate": "견딜 수 있을 리가 없다｡"
  },
  {
   "id": 46240,
   "key": "D1511ru.txt:467",
   "file": "D1511ru.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それなのに絶望すら跳ね除けて、胸の奥が熱い。",
   "ko_candidate": "그런데도 절망조차 물리치고､ 가슴속이 뜨겁다｡"
  },
  {
   "id": 46241,
   "key": "D1511ru.txt:468",
   "file": "D1511ru.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何故だ……何故……。",
   "ko_candidate": "왜일까… 왜…"
  },
  {
   "id": 46242,
   "key": "D1511ru.txt:470",
   "file": "D1511ru.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "答えも分からぬままに――",
   "ko_candidate": "답을 알지 못한 채로――"
  },
  {
   "id": 46243,
   "key": "D1511ru.txt:472",
   "file": "D1511ru.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界は――",
   "ko_candidate": "세계는――"
  },
  {
   "id": 46244,
   "key": "D1511ru.txt:474",
   "file": "D1511ru.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "終わ――――――",
   "ko_candidate": "끝나――――――"
  },
  {
   "id": 46245,
   "key": "D1511ru.txt:480",
   "file": "D1511ru.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "終わ――――――りなどしなかった。",
   "ko_candidate": "끝나지――――――않았다｡"
  },
  {
   "id": 46246,
   "key": "D1511ru.txt:489",
   "file": "D1511ru.txt",
   "line": 489,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滅意を遮る暖かな波動。",
   "ko_candidate": "절망을 가로막는 따뜻한 파동｡"
  },
  {
   "id": 46247,
   "key": "D1511ru.txt:491",
   "file": "D1511ru.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは酷く脆く崩壊寸前であり……それなのに何ものよりも強固だった。",
   "ko_candidate": "그것은 몹시 취약하고 붕괴 직전이었지만… 그럼에도 그 무엇보다 강고 했다｡"
  },
  {
   "id": 46248,
   "key": "D1511ru.txt:493",
   "file": "D1511ru.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "折れぬ想いが、切実なる決意が、ただそれだけがデモンベインを護る楯の総てだった。",
   "ko_candidate": "꺾이지 않는 마음이､ 절실한 결의가､ 단지 그것만이 데몬베인을 지키는 방패의 전부였다｡"
  },
  {
   "id": 46249,
   "key": "D1511ru.txt:499",
   "file": "D1511ru.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まず視界が戻る。",
   "ko_candidate": "먼저 시야가 돌아온다｡"
  },
  {
   "id": 46250,
   "key": "D1511ru.txt:500",
   "file": "D1511ru.txt",
   "line": 500,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこに映るのは黒龍の一撃を受け止める魔法障壁の輝き。",
   "ko_candidate": "거기에 비치는 것은 흑룡의 일격을 받아내는 마법 장벽의 빛남｡"
  },
  {
   "id": 46251,
   "key": "D1511ru.txt:502",
   "file": "D1511ru.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次に聴覚が戻る。",
   "ko_candidate": "다음으로 청각이 돌아온다｡"
  },
  {
   "id": 46252,
   "key": "D1511ru.txt:503",
   "file": "D1511ru.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聴いたのは、命を賭して何より大切なものを宣言する、聖なる咆吼。",
   "ko_candidate": "들은 것은､ 목숨을 걸고 그 무엇보다 소중한 것을 선언하는､ 성스러운 포효｡"
  },
  {
   "id": 46253,
   "key": "D1511ru.txt:507",
   "file": "D1511ru.txt",
   "line": 507,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……させぬ。させぬぞ！」",
   "ko_candidate": "「…못 해｡ 절대 못 해!」"
  },
  {
   "id": 46254,
   "key": "D1511ru.txt:511",
   "file": "D1511ru.txt",
   "line": 511,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……アル」",
   "ko_candidate": "「…알」"
  },
  {
   "id": 46255,
   "key": "D1511ru.txt:515",
   "file": "D1511ru.txt",
   "line": 515,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝等のようなくだらぬ連中に、我が主を……妾の愛する大十字九郎を殺させてなるものかァァァァァァ！」",
   "ko_candidate": "「너희 같은 시시한 무리에게､ 내 주인을… 이 몸이 사랑하는 다이쥬지 쿠로를 죽게 할 리가 없다아아아아아!」"
  },
  {
   "id": 46256,
   "key": "D1511ru.txt:519",
   "file": "D1511ru.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸の奥を灼いていた熱さは",
   "ko_candidate": "가슴 속을 태우고 있던 뜨거움은"
  },
  {
   "id": 46257,
   "key": "D1511ru.txt:522",
   "file": "D1511ru.txt",
   "line": 522,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あああ……」",
   "ko_candidate": "「아아아…」"
  },
  {
   "id": 46258,
   "key": "D1511ru.txt:524",
   "file": "D1511ru.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、無限の力となって全身を駈け巡る。",
   "ko_candidate": "지금､ 무한한 힘이 되어 온몸을 질주한다｡"
  },
  {
   "id": 46259,
   "key": "D1511ru.txt:532",
   "file": "D1511ru.txt",
   "line": 532,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あああああああああああああああああああッッッッ！」",
   "ko_candidate": "「아아아아아아아아아아아아아아아아아아악!」"
  },
  {
   "id": 46260,
   "key": "D1511ru.txt:535",
   "file": "D1511ru.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺とアルの咆吼が重なった。",
   "ko_candidate": "나와 알의 포효가 겹쳐졌다｡"
  },
  {
   "id": 46261,
   "key": "D1511ru.txt:536",
   "file": "D1511ru.txt",
   "line": 536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "融け合う２人の魂と魔力。",
   "ko_candidate": "융합하는 두 사람의 영혼과 마력｡"
  }
 ]
}