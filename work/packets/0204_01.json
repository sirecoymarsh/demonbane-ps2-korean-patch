  {
   "id": 1808,
   "key": "D0204.txt:375",
   "file": "D0204.txt",
   "line": 375,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "吐き捨てて、また正面を向き直り、歩き出す。",
   "ko_candidate": "내뱉고는 다시 정면을 향해 걷기 시작한다｡"
  },
  {
   "id": 1809,
   "key": "D0204.txt:377",
   "file": "D0204.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
