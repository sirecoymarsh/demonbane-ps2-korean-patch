{
 "packet": "1207_06",
 "scene": "1207",
 "anchor": {
  "hit": 50,
  "total": 51,
  "rate": 0.98
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "サンダルフォン": "산달폰",
  "リューガ": "류가",
  "メタトロン": "메타트론"
 },
 "items": [
  {
   "id": 28227,
   "key": "D1207le.txt:410",
   "file": "D1207le.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆっくりと。あくまでゆっくりと。",
   "ko_candidate": "천천히｡ 어디까지나 천천히｡"
  },
  {
   "id": 28228,
   "key": "D1207le.txt:412",
   "file": "D1207le.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その様は幽鬼の様で、現実感がない。",
   "ko_candidate": "그 모습은 유령 같아서､ 현실감이 없다｡"
  },
  {
   "id": 28229,
   "key": "D1207le.txt:414",
   "file": "D1207le.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし死の圧力は一歩ごとに、間違いなく強大になっていく。",
   "ko_candidate": "하지만 죽음의 압력은 한 걸음마다､ 틀림없이 강대해져 간다｡"
  },
  {
   "id": 28230,
   "key": "D1207le.txt:419",
   "file": "D1207le.txt",
   "line": 419,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うぇぇぇえあああっ！　やああああああ！　ライカお姉ちゃぁぁぁん！」",
   "ko_candidate": "「우에에에아아아! 야아아아아아! 라이카 누나이이이잉!」"
  },
  {
   "id": 28231,
   "key": "D1207le.txt:425",
   "file": "D1207le.txt",
   "line": 425,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだ。その恐怖が、絶望が、命の花弁を鮮烈に色づかせる。 奴の心に、深く深く、刃を立てる……」",
   "ko_candidate": "「그래｡ 그 공포가､ 절망이､ 생명의 꽃잎을 선명하게 물들인다｡ 그녀의 마음에､ 깊이 깊이､ 칼날을 세운다…」"
  },
  {
   "id": 28232,
   "key": "D1207le.txt:429",
   "file": "D1207le.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理不尽に、避けられない絶対のものとして、死は実体を結んでいく――。",
   "ko_candidate": "불합리하게､ 피할 수 없는 절대적인 것으로서､ 죽음은 실체를 이루어 간다――｡"
  },
  {
   "id": 28233,
   "key": "D1207le.txt:436",
   "file": "D1207le.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫を貫くビーム砲の一撃が、正確にサンダルフォンを狙う。",
   "ko_candidate": "잔해를 관통하는 빔포의 일격이､ 정확히 산달폰을 겨냥한다｡"
  },
  {
   "id": 28234,
   "key": "D1207le.txt:442",
   "file": "D1207le.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンは振り向きもせず、片手を振るい、その一撃を弾いた。",
   "ko_candidate": "산달폰은 뒤돌아보지도 않고､ 한 손을 휘둘러 그 일격을 튕겨냈다｡"
  },
  {
   "id": 28235,
   "key": "D1207le.txt:443",
   "file": "D1207le.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歓喜と侮辱が入り混じった声色で、語りかける。",
   "ko_candidate": "환희와 모욕이 뒤섞인 목소리로､ 말을 건넨다｡"
  },
  {
   "id": 28236,
   "key": "D1207le.txt:449",
   "file": "D1207le.txt",
   "line": 449,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「良いタイミングじゃないか。正義の味方」",
   "ko_candidate": "「좋은 타이밍이군｡ 정의의 편」"
  },
  {
   "id": 28237,
   "key": "D1207le.txt:452",
   "file": "D1207le.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皆の視線が一点に集中した。",
   "ko_candidate": "모두의 시선이 한 점에 집중되었다｡"
  },
  {
   "id": 28238,
   "key": "D1207le.txt:453",
   "file": "D1207le.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫を熔かし穿たれた穴の奥から、白い天使が姿を現す。",
   "ko_candidate": "잔해를 녹이고 뚫린 구멍 안쪽에서､ 하얀 천사가 모습을 드러낸다｡"
  },
  {
   "id": 28239,
   "key": "D1207le.txt:455",
   "file": "D1207le.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右腕を元に戻し、ビームサーベルを抜く。",
   "ko_candidate": "오른팔을 원래대로 돌리고､ 빔 세이버를 뽑는다｡"
  },
  {
   "id": 28240,
   "key": "D1207le.txt:460",
   "file": "D1207le.txt",
   "line": 460,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガ！」",
   "ko_candidate": "「류가!」"
  },
  {
   "id": 28241,
   "key": "D1207le.txt:471",
   "file": "D1207le.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンが翔ける。",
   "ko_candidate": "메타트론이 날아오른다｡"
  },
  {
   "id": 28242,
   "key": "D1207le.txt:479",
   "file": "D1207le.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームサーベルの光が空間に軌跡を描く。",
   "ko_candidate": "빔 세이버의 빛이 공간에 궤적을 그린다｡"
  },
  {
   "id": 28243,
   "key": "D1207le.txt:483",
   "file": "D1207le.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンが駈ける。",
   "ko_candidate": "산달폰이 달려든다｡"
  },
  {
   "id": 28244,
   "key": "D1207le.txt:492",
   "file": "D1207le.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇色の拳が空間に軌跡を描く。",
   "ko_candidate": "어둠색 주먹이 공간에 궤적을 그린다｡"
  },
  {
   "id": 28245,
   "key": "D1207le.txt:497",
   "file": "D1207le.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白と黒が衝突した。",
   "ko_candidate": "흰색과 검은색이 충돌했다｡"
  },
  {
   "id": 28246,
   "key": "D1207le.txt:498",
   "file": "D1207le.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間が激震する。",
   "ko_candidate": "공간이 격렬하게 흔들린다｡"
  },
  {
   "id": 28247,
   "key": "D1207le.txt:499",
   "file": "D1207le.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サーベルはサンダルフォンの肩口に入り、拳はメタトロンの胸部に叩き込まれた。",
   "ko_candidate": "세이버는 산달폰의 어깨에 박히고､ 주먹은 메타트론의 가슴에 꽂혔다｡"
  },
  {
   "id": 28248,
   "key": "D1207le.txt:504",
   "file": "D1207le.txt",
   "line": 504,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……貴様」",
   "ko_candidate": "「…네놈」"
  },
  {
   "id": 28249,
   "key": "D1207le.txt:511",
   "file": "D1207le.txt",
   "line": 511,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンがサーベルを更に深くめり込ませるべく、力を込める。",
   "ko_candidate": "메타트론이 세이버를 더 깊이 박기 위해､ 힘을 준다｡"
  },
  {
   "id": 28250,
   "key": "D1207le.txt:512",
   "file": "D1207le.txt",
   "line": 512,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームサーベルがより眩い光を放つ。",
   "ko_candidate": "빔 세이버가 더욱 눈부신 빛을 발한다｡"
  },
  {
   "id": 28251,
   "key": "D1207le.txt:517",
   "file": "D1207le.txt",
   "line": 517,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……くっ」",
   "ko_candidate": "「…큭」"
  },
  {
   "id": 28252,
   "key": "D1207le.txt:521",
   "file": "D1207le.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "対するサンダルフォンもまた、拳に力を込める。",
   "ko_candidate": "맞서는 산달폰 또한､ 주먹에 힘을 준다｡"
  },
  {
   "id": 28253,
   "key": "D1207le.txt:522",
   "file": "D1207le.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンの装甲に細かい罅が走る。",
   "ko_candidate": "메타트론의 장갑에 잔금이 간다｡"
  },
  {
   "id": 28254,
   "key": "D1207le.txt:528",
   "file": "D1207le.txt",
   "line": 528,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「破ッ！」",
   "ko_candidate": "「파앗!」"
  },
  {
   "id": 28255,
   "key": "D1207le.txt:531",
   "file": "D1207le.txt",
   "line": 531,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃がメタトロンの胸部を貫通した。",
   "ko_candidate": "충격이 메타트론의 가슴을 관통했다｡"
  },
  {
   "id": 28256,
   "key": "D1207le.txt:533",
   "file": "D1207le.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬、心臓が停止しかける。",
   "ko_candidate": "순간､ 심장이 멎을 뻔했다｡"
  },
  {
   "id": 28257,
   "key": "D1207le.txt:537",
   "file": "D1207le.txt",
   "line": 537,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがメタトロンの体内を走る魔術回路は、麻痺した身体機能を即座に回復させる。躰を駈け巡る激痛を捩り伏せ、サーベルを一気に押し込む。",
   "ko_candidate": "하지만 메타트론의 체내를 달리는 마술 회로는､ 마비된 신체 기능을 즉시 회복시킨다｡ 몸을 달리는 격통을 억누르고､ 세이버를 단숨에 밀어 넣는다｡"
  },
  {
   "id": 28258,
   "key": "D1207le.txt:542",
   "file": "D1207le.txt",
   "line": 542,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおおお！」",
   "ko_candidate": "「우오오오오오오!」"
  },
  {
   "id": 28259,
   "key": "D1207le.txt:547",
   "file": "D1207le.txt",
   "line": 547,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うぐがァァッ！　がああああああ！」",
   "ko_candidate": "「우그가아아! 가아아아아아아!」"
  },
  {
   "id": 28260,
   "key": "D1207le.txt:556",
   "file": "D1207le.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溜まらずメタトロンを殴り飛ばし、距離を取るサンダルフォン。",
   "ko_candidate": "참지 못하고 메타트론을 때려 날리고､ 거리를 벌리는 산달폰｡"
  },
  {
   "id": 28261,
   "key": "D1207le.txt:557",
   "file": "D1207le.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肩からは高熱で熔けかけた装甲が、蒸気を上げていた。",
   "ko_candidate": "어깨에서는 고열로 녹아내린 장갑이､ 증기를 내뿜고 있었다｡"
  },
  {
   "id": 28262,
   "key": "D1207le.txt:562",
   "file": "D1207le.txt",
   "line": 562,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「て、天使さんっ！」",
   "ko_candidate": "「천､ 천사님!」"
  },
  {
   "id": 28263,
   "key": "D1207le.txt:568",
   "file": "D1207le.txt",
   "line": 568,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――下がっていなさい」",
   "ko_candidate": "「――물러나 있어라」"
  },
  {
   "id": 28264,
   "key": "D1207le.txt:572",
   "file": "D1207le.txt",
   "line": 572,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起き上がりながら告げ、ビームサーベルを構え直す。",
   "ko_candidate": "일어서면서 말하고､ 빔 세이버를 다시 겨눈다｡"
  },
  {
   "id": 28265,
   "key": "D1207le.txt:573",
   "file": "D1207le.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "応えるように、サンダルフォンも武術の型を作る。",
   "ko_candidate": "응답하듯､ 산달폰도 무술의 자세를 취한다｡"
  },
  {
   "id": 28266,
   "key": "D1207le.txt:578",
   "file": "D1207le.txt",
   "line": 578,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度こそ殺してやる……殺してやるぞ、メタトロン！」",
   "ko_candidate": "「이번엔 정말 죽여주마… 죽여주겠어､ 메타트론!」"
  }
 ]
}