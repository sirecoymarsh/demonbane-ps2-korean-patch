 "items": [
  {
   "id": 11228,
   "key": "D0716.txt:264",
   "file": "D0716.txt",
   "line": 264,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 11229,
   "key": "D0716.txt:271",
   "file": "D0716.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "沈黙が玉座の間を包む。マスターテリオンは瞳を閉じ、穏やかな表情で続けた。",
   "ko_candidate": "침묵이 옥좌의 방을 감싼다｡ 마스터 테리온은 눈을 감고､ 온화한 표정으로 계속했다｡"
  },
  {
   "id": 11230,
   "key": "D0716.txt:278",
   "file": "D0716.txt",
   "line": 278,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「心配性だな。我々の手札には 『巫女』と中枢ユニットも有るだろう……」",
   "ko_candidate": "「걱정이 많구나｡ 우리의 패에는 『무녀』와 중추 유닛도 있지 않은가……」"
  },
  {
   "id": 11231,
   "key": "D0716.txt:312",
   "file": "D0716.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そのとき、僧院を激しい揺れが襲った。",
   "ko_candidate": "그때､ 승원을 격렬한 흔들림이 덮쳤다｡"
  },
  {
   "id": 11232,
   "key": "D0716.txt:313",
   "file": "D0716.txt",
   "line": 313,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "突然の事態に僧院内は騒然となる。",
   "ko_candidate": "갑작스러운 사태에 승원 내부는 소란스러워진다｡"
  },
  {
   "id": 11233,
   "key": "D0716.txt:318",
   "file": "D0716.txt",
   "line": 318,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どうした！　何があった！」",
   "ko_candidate": "「무슨 일이냐! 무슨 일이 있었나!」"
  },
  {
   "id": 11234,
   "key": "D0716.txt:325",
   "file": "D0716.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "玉座の間に１人の信徒が入室し、報告した。",
   "ko_candidate": "아우구스투스가 목소리를 높인다｡ 옥좌의 방에 한 명의 신도가 들어와 보고했다｡"
  },
  {
   "id": 11235,
   "key": "D0716.txt:332",
   "file": "D0716.txt",
   "line": 332,
   "speaker": "戦闘員Ｄ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ほ、報告します！　そ、僧院最下層の拘束結界牢を破り、罪人が……『暴君』が脱獄しましたっ！」",
   "ko_candidate": "「보､ 보고드립니다! 승､ 승원 최하층의 구속결계 감옥을 부수고､ 죄인이……『폭군』이 탈옥했습니다!」"
  },
  {
   "id": 11236,
   "key": "D0716.txt:340",
   "file": "D0716.txt",
   "line": 340,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――ッッ！」",
   "ko_candidate": "「――――――읏!」"
  },
  {
   "id": 11237,
   "key": "D0716.txt:345",
   "file": "D0716.txt",
   "line": 345,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なんとッ!?」",
   "ko_candidate": "「뭐라고!?」"
  },
  {
   "id": 11238,
   "key": "D0716.txt:351",
   "file": "D0716.txt",
   "line": 351,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……マスター」",
   "ko_candidate": "「……마스터」"
  },
  {
   "id": 11239,
   "key": "D0716.txt:356",
   "file": "D0716.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "報告を受けた一同の間に衝撃が走る。",
   "ko_candidate": "보고를 받은 일동 사이에 충격이 흐른다｡"
  },
  {
   "id": 11240,
   "key": "D0716.txt:357",
   "file": "D0716.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "たが、マスターテリオンは落ち着き払った様子で、薄ら笑みすら浮かべていた。",
   "ko_candidate": "하지만､ 마스터 테리온은 침착한 모습으로､ 옅은 미소마저 띠고 있다――｡"
  },
  {
   "id": 11241,
   "key": "D0716.txt:362",
   "file": "D0716.txt",
   "line": 362,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ほう……『暴君』が動いたのか」",
   "ko_candidate": "「호오……『폭군』이 움직였나」"
  },
  {
   "id": 11242,
   "key": "D0716.txt:375",
   "file": "D0716.txt",
   "line": 375,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私は世界を識る。",
   "ko_candidate": "나는 세계를 안다｡"
  },
  {
   "id": 11243,
   "key": "D0716.txt:376",
   "file": "D0716.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "運命を識る。",
   "ko_candidate": "운명을 안다｡"
  },
  {
   "id": 11244,
   "key": "D0716.txt:377",
   "file": "D0716.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶望を識る。",
   "ko_candidate": "절망을 안다｡"
  },
  {
   "id": 11245,
   "key": "D0716.txt:380",
   "file": "D0716.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界は無限の蛇の庭に閉ざされているのを識る。",
   "ko_candidate": "세계는 무한한 뱀의 정원에 갇혀 있음을 안다｡"
  },
  {
   "id": 11246,
   "key": "D0716.txt:383",
   "file": "D0716.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "運命は捩れ歪んだ輪の中に在るのを識る。",
   "ko_candidate": "운명은 비틀리고 일그러진 고리 안에 있음을 안다｡"
  },
  {
   "id": 11247,
   "key": "D0716.txt:386",
   "file": "D0716.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶望は、決して辿り着かない未来とそれを識らぬ人々にあるのを識る。",
   "ko_candidate": "절망은､ 결코 도달할 수 없는 미래와 그것을 모르는 사람들에게 있음을 안다｡"
  },
  {
   "id": 11248,
   "key": "D0716.txt:395",
   "file": "D0716.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "果て知らぬ永劫。",
   "ko_candidate": "끝없는 영겁｡"
  },
  {
   "id": 11249,
   "key": "D0716.txt:396",
   "file": "D0716.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "計り知れざる永劫。",
   "ko_candidate": "헤아릴 수 없는 영겁｡"
  },
  {
   "id": 11250,
   "key": "D0716.txt:397",
   "file": "D0716.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "怪異なる永劫。",
   "ko_candidate": "기이한 영겁｡"
  },
  {
   "id": 11251,
   "key": "D0716.txt:400",
   "file": "D0716.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "輪を操る獣ですら囚われ、逃れられぬこの牢獄で、",
   "ko_candidate": "고리를 조종하는 짐승조차 갇혀 벗어날 수 없는 이 감옥에서"
  },
  {
   "id": 11252,
   "key": "D0716.txt:401",
   "file": "D0716.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それでも私を突き動かすものがあるのは何故に何故に何故に。",
   "ko_candidate": "그래도 나를 움직이게 하는 것이 있는 것은 왜일까"
  },
  {
   "id": 11253,
   "key": "D0716.txt:404",
   "file": "D0716.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――嗚呼、そうだ。",
   "ko_candidate": "왜일까 왜일까｡"
  },
  {
   "id": 11254,
   "key": "D0716.txt:407",
   "file": "D0716.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼が居るからだ。",
   "ko_candidate": "――아아､ 그렇지｡"
  },
  {
   "id": 11255,
   "key": "D0716.txt:411",
   "file": "D0716.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "彼もまた無限の囚人に過ぎぬ。",
   "ko_candidate": "그가 있기 때문이다｡ 그 역시 무한의 죄수에 불과하다｡"
  },
  {
   "id": 11256,
   "key": "D0716.txt:412",
   "file": "D0716.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無限の奴隷に過ぎぬ。",
   "ko_candidate": "무한의 노예에 불과하다｡"
  },
  {
   "id": 11257,
   "key": "D0716.txt:413",
   "file": "D0716.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無限の道化に過ぎぬ。",
   "ko_candidate": "무한의 광대에 불과하다｡"
  },
  {
   "id": 11258,
   "key": "D0716.txt:416",
   "file": "D0716.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "されども、彼は幾星霜、迷う事なく闘い続ける。",
   "ko_candidate": "그럼에도､ 그는 오랜 세월､ 헤매지 않고 싸움을 계속한다｡"
  },
  {
   "id": 11259,
   "key": "D0716.txt:419",
   "file": "D0716.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは世界を識らぬ故か。",
   "ko_candidate": "그것은 세계를 모르기 때문인가｡"
  },
  {
   "id": 11260,
   "key": "D0716.txt:420",
   "file": "D0716.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "運命を識らぬ故か。",
   "ko_candidate": "운명을 모르기 때문인가｡"
  },
  {
   "id": 11261,
   "key": "D0716.txt:421",
   "file": "D0716.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶望を識らぬ故か。",
   "ko_candidate": "절망을 모르기 때문인가｡"
  },
  {
   "id": 11262,
   "key": "D0716.txt:429",
   "file": "D0716.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうかも知れない。 だが本当にただそれだけか。",
   "ko_candidate": "그럴지도 모른다｡ 하지만 정말로 단지 그뿐일까｡"
  },
  {
   "id": 11263,
   "key": "D0716.txt:433",
   "file": "D0716.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ならば何故、彼は今もなお在り続ける？",
   "ko_candidate": "그렇다면 왜､ 그는 지금도 여전히 존재하는 걸까?"
  },
  {
   "id": 11264,
   "key": "D0716.txt:437",
   "file": "D0716.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この無限の煉獄で魔を断つ意志は失われていった。",
   "ko_candidate": "이 무한한 연옥에서 마를 베는 의지는 사라져갔다｡"
  },
  {
   "id": 11265,
   "key": "D0716.txt:438",
   "file": "D0716.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "失われたことも識らずに失われていった。",
   "ko_candidate": "사라졌음을 모른 채 사라져갔다｡"
  },
  {
   "id": 11266,
   "key": "D0716.txt:441",
   "file": "D0716.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門の鍵の子らを止めた賢者の力は届くまい。",
   "ko_candidate": "문의 열쇠의 자식들을 막은 현자의 힘은 미치지 못할 것이다｡"
  },
  {
   "id": 11267,
   "key": "D0716.txt:444",
   "file": "D0716.txt",
   "line": 444,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "セラエノの知識を駆る盲目の賢者は何処に封じられているのか。",
   "ko_candidate": "세라에노의 지식을 구사하는 맹목의 현자는､ 어디에 봉인되어 있는 걸까｡"
  }
 ]
}