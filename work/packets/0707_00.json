   "file": "D0707.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ふんぐるい　むぐるうなふ　くするふ　るるいえ",
   "ko_candidate": "프응그르이 므그르우나프 크툴루 르뤼에 우가프나그르 프타근!"
  },
