 },
 "items": [
  {
   "id": 40248,
   "key": "D1414al.txt:5",
   "file": "D1414al.txt",
   "line": 5,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほら……このまま暴走すれば、クトゥルーは地球を覆い尽くすよ？ 全世界を瘴気で汚染して――そして、地球の歴史は、終わる」",
   "ko_candidate": "「봐봐… 이대로 폭주하면 크툴루가 지구를 뒤덮을 거야? 전 세계를 장기로 오염시키고… 그리고 지구의 역사는 끝나게 되는 거지」"
  },
  {
   "id": 40249,
   "key": "D1414al.txt:15",
   "file": "D1414al.txt",
   "line": 15,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なんてことを……エンネア」",
   "ko_candidate": "「무슨 말을… 엔네아」"
  },
  {
   "id": 40250,
   "key": "D1414al.txt:17",
   "file": "D1414al.txt",
   "line": 17,
   "speaker": "ネロ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "うなだれる俺に、だけど彼女の声は冷たい。 「何で？ だからさっきから言ってるよ？」",
   "ko_candidate": "고개를 떨구는 나에게､ 하지만 그녀의 목소리는 차갑다｡"
  },
  {
   "id": 40251,
   "key": "D1414al.txt:28",
   "file": "D1414al.txt",
   "line": 28,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こうするのがネロだって。良いんだよ？　ネロは別に、九郎が戦わないなら、それはそれで。そしたら全部壊しちゃうだけだもん」 「そうだよ。全部壊れてしまえば良いんだ……」",
   "ko_candidate": "「왜? 그래서 아까부터 말하고 있잖아? 이렇게 하는 게 네로라고｡ 괜찮아? 네로는 별로､ 쿠로가 싸우지 않는다면 그건 그거대로｡ 그러면 전부 부숴버리는 거야｡ 그래｡ 전부 부서져버리면 좋은 거야…」"
  },
  {
   "id": 40252,
   "key": "D1414al.txt:35",
   "file": "D1414al.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただその冷たさは、 冷酷な邪悪を装っているからではない。",
   "ko_candidate": "다만 그 차가움은 냉혹한 악을 가장하고 있어서가 아니다｡"
  },
  {
   "id": 40253,
   "key": "D1414al.txt:37",
   "file": "D1414al.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは喩えるならば、運命に絶望し諦観したものの 持つ、魂の芯が凍りついた、そんな冷たさだ。",
   "ko_candidate": "그것은 비유하자면､ 운명에 절망하고 체념한 자가 가진､ 영혼의 핵심이 얼어붙은 듯한 그런 차가움이다｡"
  },
  {
   "id": 40254,
   "key": "D1414al.txt:39",
   "file": "D1414al.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それがゆえに、深く俺の心を抉る。",
   "ko_candidate": "그렇기에 깊이 내 마음을 파고든다｡"
  },
  {
   "id": 40255,
   "key": "D1414al.txt:43",
   "file": "D1414al.txt",
   "line": 43,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どうするー九郎ー？ このままネロといっしょに 世界が終わるのを見てよっか？」 「お酒でも持ってきてさ。 壊れる世界を肴に……ってのも けっこーオツなもんだよね」",
   "ko_candidate": "「어떡할 거야､ 쿠로? 이대로 네로와 함께 세계가 끝나는 걸 볼까? 술이라도 가져와서｡ 무너지는 세상을 안주 삼아… 라는 것도 꽤 멋진 일이지｡ 그렇지｡ 이 속도로 배로 늘어난다면 지구가 멸망하는 데 1일도 걸리지 않을 거야｡ …정말 쉽게 부서지지｡ 아주 소중한 것도､ 조금은 마음에 드는 것도､ 싫은 것도… 아무런 구별 없이｡ 아무런 의미도 없이」"
  },
  {
   "id": 40256,
   "key": "D1414al.txt:53",
   "file": "D1414al.txt",
   "line": 53,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだなー。 このペースで倍々なら、 地球が亡びるのまで １日はいらないと思うな」 「……ほんとーに簡単に壊れるよ。 とても大切なものも、ちょっと だけお気に入りなものも、いやな ものだって――何の区別無く。 何の意味も無く」",
   "ko_candidate": "「쿠로…」"
  },
  {
   "id": 40257,
   "key": "D1414al.txt:71",
   "file": "D1414al.txt",
   "line": 71,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎……」 アルが俺に囁きかける。",
   "ko_candidate": "알이 내게 속삭인다｡"
  },
  {
   "id": 40258,
   "key": "D1414al.txt:75",
   "file": "D1414al.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言いたいことは、もう分かっていた。",
   "ko_candidate": "하고 싶은 말은 이미 알고 있었다｡"
  },
  {
   "id": 40259,
   "key": "D1414al.txt:79",
   "file": "D1414al.txt",
   "line": 79,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「戦うぞ」",
   "ko_candidate": "「싸우자」"
  },
  {
   "id": 40260,
   "key": "D1414al.txt:82",
   "file": "D1414al.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やっぱりだ。",
   "ko_candidate": "역시 그렇구나｡"
  },
  {
   "id": 40261,
   "key": "D1414al.txt:83",
   "file": "D1414al.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "当たり前だ。",
   "ko_candidate": "당연하지｡"
  },
  {
   "id": 40262,
   "key": "D1414al.txt:84",
   "file": "D1414al.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それでこそ、アルなのだから。",
   "ko_candidate": "그래야 알답지｡"
  },
  {
   "id": 40263,
   "key": "D1414al.txt:88",
   "file": "D1414al.txt",
   "line": 88,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「戦わなければ救われない者もいる」",
   "ko_candidate": "「싸우지 않으면 구원받지 못하는 자도 있어」"
  },
  {
   "id": 40264,
   "key": "D1414al.txt:91",
   "file": "D1414al.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は――",
   "ko_candidate": "나는…"
  },
  {
   "id": 40265,
   "key": "D1414al.txt:95",
   "file": "D1414al.txt",
   "line": 95,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いくら言葉を重ねたところで 何も救えはしない。 そう――敵さえも」",
   "ko_candidate": "「아무리 말을 거듭해봤자 아무것도 구할 수 없어｡ 그래… 적조차도」"
  },
  {
   "id": 40266,
   "key": "D1414al.txt:101",
   "file": "D1414al.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は――",
   "ko_candidate": "나는…"
  },
  {
   "id": 40267,
   "key": "D1414al.txt:108",
   "file": "D1414al.txt",
   "line": 108,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎」",
   "ko_candidate": "「…쿠로」"
  },
  {
   "id": 40268,
   "key": "D1414al.txt:111",
   "file": "D1414al.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "呟くエンネアの声はほっとしているようでもあり、 嬉しそうでもあった。",
   "ko_candidate": "중얼거리는 엔네아의 목소리는 안도하는 듯하면서도 기쁜 듯했다｡"
  },
  {
   "id": 40269,
   "key": "D1414al.txt:114",
   "file": "D1414al.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ネームレス・ワンは 戦闘体勢に入るデモンベインを見守っている。",
   "ko_candidate": "네임리스 원은 전투 태세에 들어가는 데몬베인을 지켜보고 있다｡"
  },
  {
   "id": 40270,
   "key": "D1414al.txt:122",
   "file": "D1414al.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "期待に応じ、 偃月刀の剣先を真っ直ぐに向けて身構えた。",
   "ko_candidate": "기대에 부응해 언월도의 검끝을 똑바로 향해 자세를 잡았다｡"
  },
  {
   "id": 40271,
   "key": "D1414al.txt:127",
   "file": "D1414al.txt",
   "line": 127,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やっとその気になった？」",
   "ko_candidate": "「드디어 그럴 마음이 들었어?」"
  },
  {
   "id": 40272,
   "key": "D1414al.txt:138",
   "file": "D1414al.txt",
   "line": 138,
   "speaker": "九郎 / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……だがな。 アル、エンネア。これだけは断言しておく」 「…………」",
   "ko_candidate": "「그래… 하지만 말이야｡ 알､ 엔네아｡ 이것만은 단언해두겠어」"
  },
  {
   "id": 40273,
   "key": "D1414al.txt:150",
   "file": "D1414al.txt",
   "line": 150,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……？　なになに？」",
   "ko_candidate": "「…」 「…? 뭐야 뭐야?」"
  },
  {
   "id": 40274,
   "key": "D1414al.txt:155",
   "file": "D1414al.txt",
   "line": 155,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「俺が……デモンベインが討ち滅ぼすのはエンネア、 お前じゃない。デモンベインは魔を断つ剣。 俺は此処に在る邪悪だけを、断つ！」",
   "ko_candidate": "「내가… 데몬베인이 쓰러뜨릴 건 엔네아､ 너가 아니야｡ 데몬베인은 마를 베는 검｡ 나는 여기 있는 악만을 베겠어!」"
  },
  {
   "id": 40275,
   "key": "D1414al.txt:159",
   "file": "D1414al.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宣言する俺に、アルの応えは――",
   "ko_candidate": "선언하는 나에게 알의 대답은…"
  },
  {
   "id": 40276,
   "key": "D1414al.txt:164",
   "file": "D1414al.txt",
   "line": 164,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだ。それで良い。 それでこそ汝だ、大十字九郎！」",
   "ko_candidate": "「그래｡ 그거면 돼｡ 그래야 너답지､ 다이쥬지 쿠로!」"
  },
  {
   "id": 40277,
   "key": "D1414al.txt:169",
   "file": "D1414al.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処までも優しかった。",
   "ko_candidate": "어디까지나 상냥했다｡"
  },
  {
   "id": 40278,
   "key": "D1414al.txt:174",
   "file": "D1414al.txt",
   "line": 174,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だからネロがその 邪悪そのものなんだよ！ 甘いこと考えていると秒殺だよ！」",
   "ko_candidate": "「그래서 네로가 그 악 그 자체라고! 달콤한 생각을 하고 있다간 초살당할 거야!」"
  },
  {
   "id": 40279,
   "key": "D1414al.txt:184",
   "file": "D1414al.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネームレス・ワンが片腕を突き出す。",
   "ko_candidate": "네임리스 원이 한쪽 팔을 내민다｡"
  },
  {
   "id": 40280,
   "key": "D1414al.txt:193",
   "file": "D1414al.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "盾状の腕表面に魔術文字が走り、変質。銃口を象る。",
   "ko_candidate": "방패 모양의 팔 표면에 마술 문자가 달리고 변질된다｡ 총구를 본뜬다｡"
  },
  {
   "id": 40281,
   "key": "D1414al.txt:198",
   "file": "D1414al.txt",
   "line": 198,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「魔術弾！」",
   "ko_candidate": "「마술탄!」"
  },
  {
   "id": 40282,
   "key": "D1414al.txt:208",
   "file": "D1414al.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "着弾。",
   "ko_candidate": "명중｡"
  },
  {
   "id": 40283,
   "key": "D1414al.txt:217",
   "file": "D1414al.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの虚像に数多もの弾痕が穿たれ、割れて、散る。",
   "ko_candidate": "데몬베인의 허상에 수많은 탄흔이 뚫리고 깨져 흩어진다｡"
  },
  {
   "id": 40284,
   "key": "D1414al.txt:218",
   "file": "D1414al.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲を光景を映し返す鏡の破片。",
   "ko_candidate": "주위의 광경을 비추는 거울의 파편｡"
  },
  {
   "id": 40285,
   "key": "D1414al.txt:226",
   "file": "D1414al.txt",
   "line": 226,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「上！　術種選択：魔砲弾！」",
   "ko_candidate": "「위! 술종선택: 마포탄!」"
  },
  {
   "id": 40286,
   "key": "D1414al.txt:232",
   "file": "D1414al.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見上げもせず、左腕を頭上に翳す。",
   "ko_candidate": "올려다보지도 않고 왼팔을 머리 위로 들어올린다｡"
  },
  {
   "id": 40287,
   "key": "D1414al.txt:237",
   "file": "D1414al.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃口は更に巨大で凶悪な砲口に変形。真っ直ぐにネームレス・ワンの頭上に跳んだデモンベインを向いている。",
   "ko_candidate": "총구는 더욱 거대하고 흉악한 포구로 변형된다｡ 똑바로 네임리스 원의 머리 위로 뛰어오른 데몬베인을 향하고 있다｡"
  }
 ]
