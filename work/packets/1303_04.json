 "items": [
  {
   "id": 31621,
   "key": "D1303ru.txt:70",
   "file": "D1303ru.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その中心で、深淵の眸の九郎は、ただ立ち尽くす。",
   "ko_candidate": "그 중심에서 심연의 눈동자를 한 쿠로는 그저 서 있을 뿐이다｡"
  },
  {
   "id": 31622,
   "key": "D1303ru.txt:72",
   "file": "D1303ru.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒が、彼を呑み込む。",
   "ko_candidate": "암흑이 그를 삼켜버린다｡"
  },
  {
   "id": 31623,
   "key": "D1303ru.txt:77",
   "file": "D1303ru.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――何処とも知れぬ世界に、引きずり落とそうとしている。",
   "ko_candidate": "――어딘지 모를 세계로 끌어내리려 하고 있다｡"
  },
  {
   "id": 31624,
   "key": "D1303ru.txt:81",
   "file": "D1303ru.txt",
   "line": 81,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 31625,
   "key": "D1303ru.txt:84",
   "file": "D1303ru.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悪寒が不気味なほどの実体を以って確信へと変わったとき、あれだけ苦痛と恐怖に震えていた瑠璃が、弾かれたように跳ね起きた。",
   "ko_candidate": "오싹한 느낌이 불길할 정도로 실체를 가지고 확신으로 변했을 때､ 그토록 고통과 공포에 떨고 있던 루리가 튕겨 오르듯 벌떡 일어났다｡"
  },
  {
   "id": 31626,
   "key": "D1303ru.txt:86",
   "file": "D1303ru.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬の逡巡も見せず、渦巻く闇黒の焔、闇黒に呑み込まれようとする九郎の元を目指して、駈ける。",
   "ko_candidate": "잠시의 망설임도 없이 소용돌이치는 암흑의 불꽃､ 암흑에 삼켜지려는 쿠로에게로 달려간다｡"
  },
  {
   "id": 31627,
   "key": "D1303ru.txt:94",
   "file": "D1303ru.txt",
   "line": 94,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「小娘!?　何を……！」",
   "ko_candidate": "「꼬마야!? 뭘…!」"
  },
  {
   "id": 31628,
   "key": "D1303ru.txt:98",
   "file": "D1303ru.txt",
   "line": 98,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さんを助けないと……！」",
   "ko_candidate": "「다이쥬지 씨를 구해야 해…!」"
  },
  {
   "id": 31629,
   "key": "D1303ru.txt:102",
   "file": "D1303ru.txt",
   "line": 102,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……っ！　いや、待て！　早まるな！」",
   "ko_candidate": "「…! 아니､ 기다려! 성급하게 굴지 마!」"
  },
  {
   "id": 31630,
   "key": "D1303ru.txt:105",
   "file": "D1303ru.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの制止の声も聞かず、瑠璃は走った。",
   "ko_candidate": "알의 제지하는 소리도 듣지 않고 루리는 달렸다｡"
  },
  {
   "id": 31631,
   "key": "D1303ru.txt:106",
   "file": "D1303ru.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔え猛る闇黒が、唸りを上げて、瑠璃に迫る。",
   "ko_candidate": "타오르는 암흑이 울부짖으며 루리에게 다가온다｡"
  },
  {
   "id": 31632,
   "key": "D1303ru.txt:111",
   "file": "D1303ru.txt",
   "line": 111,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「小娘！　くっ……！」",
   "ko_candidate": "「꼬마야! 크…!」"
  },
  {
   "id": 31633,
   "key": "D1303ru.txt:115",
   "file": "D1303ru.txt",
   "line": 115,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 31634,
   "key": "D1303ru.txt:119",
   "file": "D1303ru.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那、瑠璃の躰の表面を疾る魔術文字。",
   "ko_candidate": "순간､ 루리의 몸 표면을 달리는 마술 문자｡"
  },
  {
   "id": 31635,
   "key": "D1303ru.txt:120",
   "file": "D1303ru.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・スタイル化した司令服から、魔導書のページが無数に湧き出て、マントを瞬時に再生させた。",
   "ko_candidate": "마기우스 스타일로 변한 사령복에서 마도서의 페이지가 무수히 솟아나와 순식간에 망토를 재생시켰다｡"
  },
  {
   "id": 31636,
   "key": "D1303ru.txt:122",
   "file": "D1303ru.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マントが翼の様に広がる。",
   "ko_candidate": "망토가 날개처럼 펼쳐진다｡"
  },
  {
   "id": 31637,
   "key": "D1303ru.txt:123",
   "file": "D1303ru.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思いっきり、地を蹴って跳躍。",
   "ko_candidate": "있는 힘껏 땅을 박차고 도약｡"
  },
  {
   "id": 31638,
   "key": "D1303ru.txt:126",
   "file": "D1303ru.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒の焔に掴まる間際で、瑠璃は飛翔した。",
   "ko_candidate": "암흑의 불꽃에 붙잡힐 찰나､ 루리는 날아올랐다｡"
  },
  {
   "id": 31639,
   "key": "D1303ru.txt:127",
   "file": "D1303ru.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そのまま、九郎へと飛び込むように、滑空する。",
   "ko_candidate": "그대로 쿠로에게 뛰어들듯 활공한다｡"
  },
  {
   "id": 31640,
   "key": "D1303ru.txt:131",
   "file": "D1303ru.txt",
   "line": 131,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん！」",
   "ko_candidate": "「다이쥬지 씨!」"
  },
  {
   "id": 31641,
   "key": "D1303ru.txt:134",
   "file": "D1303ru.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎を闇黒の中から救い出そうと、手を伸ばす。",
   "ko_candidate": "쿠로를 암흑 속에서 구해내려 손을 뻗는다｡"
  },
  {
   "id": 31642,
   "key": "D1303ru.txt:135",
   "file": "D1303ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 31643,
   "key": "D1303ru.txt:139",
   "file": "D1303ru.txt",
   "line": 139,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?　避けろ、小娘！」",
   "ko_candidate": "「――――!? 피해､ 꼬마야!」"
  },
  {
   "id": 31644,
   "key": "D1303ru.txt:143",
   "file": "D1303ru.txt",
   "line": 143,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――っっ!?」",
   "ko_candidate": "「――――!!?」"
  },
  {
   "id": 31645,
   "key": "D1303ru.txt:147",
   "file": "D1303ru.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルが無理矢理、マントに働く魔力の流れを断った。",
   "ko_candidate": "알이 무리하게 망토에 작용하는 마력의 흐름을 끊었다｡"
  },
  {
   "id": 31646,
   "key": "D1303ru.txt:149",
   "file": "D1303ru.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "浮力を失い、失速する。瑠璃の身体が斜めに傾いだ。",
   "ko_candidate": "부력을 잃고 실속한다｡ 루리의 몸이 비스듬히 기울었다｡"
  },
  {
   "id": 31647,
   "key": "D1303ru.txt:150",
   "file": "D1303ru.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが命拾いとなった。",
   "ko_candidate": "그것이 목숨을 건졌다｡"
  },
  {
   "id": 31648,
   "key": "D1303ru.txt:155",
   "file": "D1303ru.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛翔する斬撃が、瑠璃の頭上を掠め、遥か遠くの壁面に炸裂。",
   "ko_candidate": "날아오는 참격이 루리의 머리 위를 스치고 저 멀리 벽면에서 폭발했다｡"
  },
  {
   "id": 31649,
   "key": "D1303ru.txt:157",
   "file": "D1303ru.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斜めに斬り上げるような、大きな亀裂を刻んだ。",
   "ko_candidate": "비스듬히 베어 올리듯 큰 균열을 새겼다｡"
  },
  {
   "id": 31650,
   "key": "D1303ru.txt:158",
   "file": "D1303ru.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数本の髪の毛が、舞い散る。",
   "ko_candidate": "몇 가닥의 머리카락이 흩날린다｡"
  },
  {
   "id": 31651,
   "key": "D1303ru.txt:160",
   "file": "D1303ru.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それらは全て一瞬のこと。",
   "ko_candidate": "그 모든 것이 순식간의 일이었다｡"
  },
  {
   "id": 31652,
   "key": "D1303ru.txt:161",
   "file": "D1303ru.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次の瞬間、瑠璃は地面に激突する勢いで、墜落した。",
   "ko_candidate": "다음 순간､ 루리는 땅에 부딪힐 기세로 추락했다｡"
  },
  {
   "id": 31653,
   "key": "D1303ru.txt:164",
   "file": "D1303ru.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが痛みに呻いている暇も無い。",
   "ko_candidate": "하지만 고통에 신음할 틈도 없다｡"
  },
  {
   "id": 31654,
   "key": "D1303ru.txt:166",
   "file": "D1303ru.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐさま身を起こし、九郎を見た。",
   "ko_candidate": "곧바로 몸을 일으켜 쿠로를 바라보았다｡"
  },
  {
   "id": 31655,
   "key": "D1303ru.txt:168",
   "file": "D1303ru.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "見えた光景は、瑠璃にとって、かなりショックなものだった。",
   "ko_candidate": "보인 광경은 루리에게 상당한 충격이었다｡"
  },
  {
   "id": 31656,
   "key": "D1303ru.txt:172",
   "file": "D1303ru.txt",
   "line": 172,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん……何故……」",
   "ko_candidate": "「다이쥬지 씨… 왜…」"
  },
  {
   "id": 31657,
   "key": "D1303ru.txt:175",
   "file": "D1303ru.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深淵を閉じ込めた眸には変わりは無いが、だが、九郎は瑠璃を見つめていた。",
   "ko_candidate": "심연을 가두어 놓은 듯한 눈동자는 변함없지만､ 쿠로는 루리를 바라보고 있었다｡"
  },
  {
   "id": 31658,
   "key": "D1303ru.txt:180",
   "file": "D1303ru.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "初めて、瑠璃を見ていた。",
   "ko_candidate": "처음으로 루리를 보고 있었다｡"
  },
  {
   "id": 31659,
   "key": "D1303ru.txt:181",
   "file": "D1303ru.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして九郎の右手には、抜き放たれたバルザイの偃月刀。",
   "ko_candidate": "그리고 쿠로의 오른손에는 뽑아든 바르자이의 언월도｡"
  },
  {
   "id": 31660,
   "key": "D1303ru.txt:183",
   "file": "D1303ru.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎は答えない。",
   "ko_candidate": "쿠로는 대답하지 않는다｡"
  }
 ]
}