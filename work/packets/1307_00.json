 },
 "items": [
  {
   "id": 33017,
   "key": "D1307al.txt:16",
   "file": "D1307al.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怨霊呪弾の一撃は、大地を腐らせ、爆ぜさせ、 クレーターを抉った。",
   "ko_candidate": "원령주탄의 일격은 대지를 부패시키고 폭발시켜 크레이터를 파냈다｡"
  },
  {
   "id": 33018,
   "key": "D1307al.txt:19",
   "file": "D1307al.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クレーターの中心、グシャグシャに溶けた土砂に 埋もれ、デモンベインは倒れている。",
   "ko_candidate": "크레이터의 중심､ 질척질척하게 녹은 토사에 묻혀 데몬베인은 쓰러져 있다｡"
  },
  {
   "id": 33019,
   "key": "D1307al.txt:21",
   "file": "D1307al.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "呪弾の衝撃が機体を半壊させ、 ヒヒイロカネの装甲は瘴気により腐蝕していた。",
   "ko_candidate": "주탄의 충격이 기체를 반파시키고､ 히히이로카네의 장갑은 장기로 인해 부식되어 있었다｡"
  },
  {
   "id": 33020,
   "key": "D1307al.txt:24",
   "file": "D1307al.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は――何とか生きている。",
   "ko_candidate": "나는―― 어떻게든 살아있다｡"
  },
  {
   "id": 33021,
   "key": "D1307al.txt:26",
   "file": "D1307al.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念に魂を引き裂かれそうだったが……それでも燃え滾った怒りが、死を退けた。",
   "ko_candidate": "원념에 영혼이 찢어질 것 같았지만… 그래도 불타오르는 분노가 죽음을 물리쳤다｡"
  },
  {
   "id": 33022,
   "key": "D1307al.txt:27",
   "file": "D1307al.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "躰は生気を失い酷く冷たかったが、ギリギリのところで持ち堪えている。",
   "ko_candidate": "몸은 생기를 잃고 몹시 차가웠지만､ 간신히 버티고 있다｡"
  },
  {
   "id": 33023,
   "key": "D1307al.txt:29",
   "file": "D1307al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……",
   "ko_candidate": "하지만…"
  },
  {
   "id": 33024,
   "key": "D1307al.txt:32",
   "file": "D1307al.txt",
   "line": 32,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「エルザ……エルザ……っ！」",
   "ko_candidate": "「엘자… 엘자…!」"
  },
  {
   "id": 33025,
   "key": "D1307al.txt:35",
   "file": "D1307al.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "返事は無い。",
   "ko_candidate": "대답이 없다｡"
  },
  {
   "id": 33026,
   "key": "D1307al.txt:37",
   "file": "D1307al.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エルザはぐったりと、 ナビゲート席にもたれ掛かっていた。",
   "ko_candidate": "엘자는 축 늘어진 채 내비게이트 좌석에 기대어 있었다｡"
  },
  {
   "id": 33027,
   "key": "D1307al.txt:40",
   "file": "D1307al.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳からは光が失われている。",
   "ko_candidate": "눈동자에서는 빛이 사라졌다｡"
  },
  {
   "id": 33028,
   "key": "D1307al.txt:41",
   "file": "D1307al.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身にまったく力が入ってないようだった。",
   "ko_candidate": "온몸에 전혀 힘이 들어가지 않는 것 같았다｡"
  },
  {
   "id": 33029,
   "key": "D1307al.txt:42",
   "file": "D1307al.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ピクリとも動かない。",
   "ko_candidate": "꼼짝도 하지 않는다｡"
  },
  {
   "id": 33030,
   "key": "D1307al.txt:44",
   "file": "D1307al.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "気絶しているのか、それとも――",
   "ko_candidate": "기절한 건지､ 아니면――"
  },
  {
   "id": 33031,
   "key": "D1307al.txt:47",
   "file": "D1307al.txt",
   "line": 47,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「エルザ……ッ！　起き……ろ……ッ！」",
   "ko_candidate": "「엘자…! 일어… 나…!」"
  },
  {
   "id": 33032,
   "key": "D1307al.txt:49",
   "file": "D1307al.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不吉な予感を振り払い、呼びかけ続ける。",
   "ko_candidate": "불길한 예감을 떨쳐내며 계속 부른다｡"
  },
  {
   "id": 33033,
   "key": "D1307al.txt:53",
   "file": "D1307al.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインは魔導書無しには起動しない。 そして、",
   "ko_candidate": "데몬베인은 마도서 없이는 작동하지 않는다｡"
  },
  {
   "id": 33034,
   "key": "D1307al.txt:54",
   "file": "D1307al.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔導書の役割を代行するのがエルザのシステム。",
   "ko_candidate": "그리고 마도서의 역할을 대행하는 것이 엘자의 시스템｡"
  },
  {
   "id": 33035,
   "key": "D1307al.txt:55",
   "file": "D1307al.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そのシステムが停止しているということは……",
   "ko_candidate": "그 시스템이 정지했다는 것은…"
  },
  {
   "id": 33036,
   "key": "D1307al.txt:58",
   "file": "D1307al.txt",
   "line": 58,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「エルザァァ……ァァァァ！」",
   "ko_candidate": "「엘자아아…아아아아!」"
  },
  {
   "id": 33037,
   "key": "D1307al.txt:62",
   "file": "D1307al.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザは目覚めない。",
   "ko_candidate": "엘자는 깨어나지 않는다｡"
  },
  {
   "id": 33038,
   "key": "D1307al.txt:63",
   "file": "D1307al.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クソ……！",
   "ko_candidate": "젠장…!"
  },
  {
   "id": 33039,
   "key": "D1307al.txt:64",
   "file": "D1307al.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は苛立ち、無駄と分かりながらも、操縦桿を動かす。",
   "ko_candidate": "나는 초조해하며 헛수고인 줄 알면서도 조종간을 움직인다｡"
  },
  {
   "id": 33040,
   "key": "D1307al.txt:70",
   "file": "D1307al.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは完全に沈黙したままだ。",
   "ko_candidate": "데몬베인은 완전히 침묵한 채다｡"
  },
  {
   "id": 33041,
   "key": "D1307al.txt:71",
   "file": "D1307al.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "指の一本すら動かせない。",
   "ko_candidate": "손가락 하나 움직일 수 없다｡"
  },
  {
   "id": 33042,
   "key": "D1307al.txt:73",
   "file": "D1307al.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メイン動力は停止。",
   "ko_candidate": "메인 동력은 정지｡"
  },
  {
   "id": 33043,
   "key": "D1307al.txt:74",
   "file": "D1307al.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "作動しているのは通信機にモニターにカメラに……つまり、魔術回路とは一切関係ない、些細な部分だけだ。",
   "ko_candidate": "작동하고 있는 것은 통신기에 모니터에 카메라에… 즉､ 마술 회로와는 전혀 관계없는 사소한 부분뿐이다｡"
  },
  {
   "id": 33044,
   "key": "D1307al.txt:77",
   "file": "D1307al.txt",
   "line": 77,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そんな……動け……動けよ……」",
   "ko_candidate": "「이럴 수가… 움직여… 움직이라고…」"
  },
  {
   "id": 33045,
   "key": "D1307al.txt:79",
   "file": "D1307al.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "また…… またこんなところで何も出来なくなっちまうのかよ？",
   "ko_candidate": "또… 또 이런 곳에서 아무것도 할 수 없게 되는 건가?"
  },
  {
   "id": 33046,
   "key": "D1307al.txt:82",
   "file": "D1307al.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺はまだ闘わなきゃいけないのに。",
   "ko_candidate": "나는 아직 싸워야 하는데｡"
  },
  {
   "id": 33047,
   "key": "D1307al.txt:84",
   "file": "D1307al.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうじゃないと、誰も救えないのに。",
   "ko_candidate": "그렇지 않으면 누구도 구할 수 없는데｡"
  },
  {
   "id": 33048,
   "key": "D1307al.txt:87",
   "file": "D1307al.txt",
   "line": 87,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベイン……！ くそっ！　エルザ！　返事をしてくれ！」",
   "ko_candidate": "「데몬베인…! 젠장! 엘자! 대답해 줘!」"
  },
  {
   "id": 33049,
   "key": "D1307al.txt:90",
   "file": "D1307al.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "叫び声と、ガチャガチャと操縦桿を動かす音だけが虚しく響き渡る。",
   "ko_candidate": "외치는 소리와 덜컹덜컹 조종간을 움직이는 소리만이 공허하게 울려 퍼진다｡"
  },
  {
   "id": 33050,
   "key": "D1307al.txt:92",
   "file": "D1307al.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふと、モニターの映像に巨大な何かの影が映った。",
   "ko_candidate": "문득 모니터 영상에 거대한 무언가의 그림자가 비쳤다｡"
  },
  {
   "id": 33051,
   "key": "D1307al.txt:93",
   "file": "D1307al.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインの前に立っている。",
   "ko_candidate": "데몬베인 앞에 서 있다｡"
  },
  {
   "id": 33052,
   "key": "D1307al.txt:94",
   "file": "D1307al.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが何なのか、わざわざ確かめるまでもない。",
   "ko_candidate": "그것이 무엇인지 굳이 확인할 필요도 없다｡"
  },
  {
   "id": 33053,
   "key": "D1307al.txt:104",
   "file": "D1307al.txt",
   "line": 104,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うふふふふ、これで王手詰ね。 九郎ちゃん」",
   "ko_candidate": "「우후후후､ 이걸로 체크메이트네｡ 쿠로 군」"
  },
  {
   "id": 33054,
   "key": "D1307al.txt:109",
   "file": "D1307al.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ベルゼビュートが俺を ――デモンベインを見下ろしていた。",
   "ko_candidate": "벨제뷰트가 나를―― 데몬베인을 내려다보고 있었다｡"
  },
  {
   "id": 33055,
   "key": "D1307al.txt:111",
   "file": "D1307al.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空ろな鬼械の眼が、不気味に輝いている。",
   "ko_candidate": "공허한 귀계의 눈이 불길하게 빛나고 있다｡"
  },
  {
   "id": 33056,
   "key": "D1307al.txt:114",
   "file": "D1307al.txt",
   "line": 114,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ティベリウス！」",
   "ko_candidate": "「…티베리우스!」"
  }
 ]
}