 },
 "items": [
  {
   "id": 38970,
   "key": "D1410ru.txt:406",
   "file": "D1410ru.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆風に押し飛ばされるデモンベイン。",
   "ko_candidate": "폭풍에 밀려나는 데몬베인｡"
  },
  {
   "id": 38971,
   "key": "D1410ru.txt:413",
   "file": "D1410ru.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "シャンタクを稼動させて、落下の速度を抑える。",
   "ko_candidate": "샨타크를 가동시켜 낙하 속도를 줄인다｡"
  },
  {
   "id": 38972,
   "key": "D1410ru.txt:414",
   "file": "D1410ru.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発が収まると、辺りは再び静寂に包まれた。",
   "ko_candidate": "폭발이 가라앉자 주변은 다시 정적에 휩싸였다｡"
  },
  {
   "id": 38973,
   "key": "D1410ru.txt:421",
   "file": "D1410ru.txt",
   "line": 421,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……斃したか？」",
   "ko_candidate": "「…쓰러뜨렸나?」"
  },
  {
   "id": 38974,
   "key": "D1410ru.txt:423",
   "file": "D1410ru.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "読みが正しければ、弾丸は幻影で姿を眩ませていたサイクラノーシュを撃ち抜いているはずだ。",
   "ko_candidate": "읽은 대로라면 탄환은 환영으로 모습을 감춘 사이크라노쉬를 관통했을 터다｡"
  },
  {
   "id": 38975,
   "key": "D1410ru.txt:428",
   "file": "D1410ru.txt",
   "line": 428,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「恐らくな。少なくともこの場にもう彼奴の気配は無い」",
   "ko_candidate": "「아마도｡ 적어도 이 자리에 더 이상 그놈의 기척은 없어」"
  },
  {
   "id": 38976,
   "key": "D1410ru.txt:432",
   "file": "D1410ru.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならこれ以上、気にしても仕方ないだろう。",
   "ko_candidate": "그렇다면 이 이상 신경 쓸 필요는 없겠지｡"
  },
  {
   "id": 38977,
   "key": "D1410ru.txt:433",
   "file": "D1410ru.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生きていたら生きていたで、そのときはそのときだ。",
   "ko_candidate": "살아있다면 살아있는 대로､ 그때는 그때다｡"
  },
  {
   "id": 38978,
   "key": "D1410ru.txt:435",
   "file": "D1410ru.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今はただ先を急ぐのみ。",
   "ko_candidate": "지금은 그저 앞으로 서두를 뿐｡"
  },
  {
   "id": 38979,
   "key": "D1410ru.txt:441",
   "file": "D1410ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どれほどの時間が経ったろうか。",
   "ko_candidate": "얼마나 시간이 지났을까｡"
  },
  {
   "id": 38980,
   "key": "D1410ru.txt:442",
   "file": "D1410ru.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "十数キロの距離を降って、ようやく最下層に辿り着いた。",
   "ko_candidate": "십여 킬로미터의 거리를 내려가 마침내 최하층에 도착했다｡"
  },
  {
   "id": 38981,
   "key": "D1410ru.txt:450",
   "file": "D1410ru.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眼下に広がるのは、何処までも紅い海。",
   "ko_candidate": "눈 아래로 펼쳐지는 것은 어디까지나 붉은 바다｡"
  },
  {
   "id": 38982,
   "key": "D1410ru.txt:451",
   "file": "D1410ru.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの爪先が水面に触れ、波紋を広げた。",
   "ko_candidate": "데몬베인의 발끝이 수면에 닿아 파문을 일으켰다｡"
  },
  {
   "id": 38983,
   "key": "D1410ru.txt:460",
   "file": "D1410ru.txt",
   "line": 460,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……まるで血の海だな」",
   "ko_candidate": "「…마치 피의 바다 같군」"
  },
  {
   "id": 38984,
   "key": "D1410ru.txt:465",
   "file": "D1410ru.txt",
   "line": 465,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「否。血そのものだ。外に出てみろ」",
   "ko_candidate": "「아니｡ 피 그 자체다｡ 밖으로 나가봐라」"
  },
  {
   "id": 38985,
   "key": "D1410ru.txt:470",
   "file": "D1410ru.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハッチを開いて、外の空気に触れる。",
   "ko_candidate": "해치를 열고 바깥 공기를 맡는다｡"
  },
  {
   "id": 38986,
   "key": "D1410ru.txt:477",
   "file": "D1410ru.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞬間、思わず口と鼻を塞いだ。",
   "ko_candidate": "순간 무의식적으로 입과 코를 막았다｡"
  },
  {
   "id": 38987,
   "key": "D1410ru.txt:479",
   "file": "D1410ru.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "むせ返るほどに生臭い、べっとりと纏わりつくような血の臭い。",
   "ko_candidate": "구역질이 날 정도로 비린내 나는､ 끈적끈적하게 달라붙는 듯한 피 냄새｡"
  },
  {
   "id": 38988,
   "key": "D1410ru.txt:482",
   "file": "D1410ru.txt",
   "line": 482,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ゲッ……胸糞悪ィ」",
   "ko_candidate": "「윽… 구역질 나」"
  },
  {
   "id": 38989,
   "key": "D1410ru.txt:487",
   "file": "D1410ru.txt",
   "line": 487,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「邪気が桁違いに濃厚になっている……おそらくはこの奥が中枢部」",
   "ko_candidate": "「사기가 차원이 다르게 농후해졌어… 아마도 이 안쪽이 중추부겠지」"
  },
  {
   "id": 38990,
   "key": "D1410ru.txt:491",
   "file": "D1410ru.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "延々と続く血の海の先を見つめる。",
   "ko_candidate": "끝없이 이어지는 피의 바다 끝을 바라본다｡"
  },
  {
   "id": 38991,
   "key": "D1410ru.txt:493",
   "file": "D1410ru.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅く煙るその先に、白い巨大な扉があった。",
   "ko_candidate": "붉게 연기 나는 그 끝에 하얀 거대한 문이 있었다｡"
  },
  {
   "id": 38992,
   "key": "D1410ru.txt:495",
   "file": "D1410ru.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間違いない。あの扉の向こうだ。あの向こうから凄まじい邪気が渦となって吹き荒れている。",
   "ko_candidate": "틀림없다｡ 저 문 너머다｡ 저 너머에서 엄청난 사기가 소용돌이치며 휘몰아치고 있다｡"
  },
  {
   "id": 38993,
   "key": "D1410ru.txt:497",
   "file": "D1410ru.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハッチを閉じて、デモンベインを進ませる。",
   "ko_candidate": "해치를 닫고 데몬베인을 전진시킨다｡"
  },
  {
   "id": 38994,
   "key": "D1410ru.txt:499",
   "file": "D1410ru.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一歩一歩が重い。叩きつけられるプレッシャーがデモンベインを軋ませる。",
   "ko_candidate": "한 걸음 한 걸음이 무겁다｡ 들이닥치는 압박이 데몬베인을 삐걱거리게 한다｡"
  },
  {
   "id": 38995,
   "key": "D1410ru.txt:501",
   "file": "D1410ru.txt",
   "line": 501,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……上等だ。",
   "ko_candidate": "…좋아｡"
  },
  {
   "id": 38996,
   "key": "D1410ru.txt:510",
   "file": "D1410ru.txt",
   "line": 510,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ここまで斃したデウス・マキナは５体。残るは……」",
   "ko_candidate": "「여기까지 쓰러뜨린 데우스 마키나는 5체｡ 남은 건…」"
  },
  {
   "id": 38997,
   "key": "D1410ru.txt:515",
   "file": "D1410ru.txt",
   "line": 515,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「金ピカの……アウグストゥスとか言う奴のデウス・マキナが残っているな」",
   "ko_candidate": "「금빛의… 아우구스투스라는 놈의 데우스 마키나가 남아있지」"
  },
  {
   "id": 38998,
   "key": "D1410ru.txt:517",
   "file": "D1410ru.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴はこの先に待っているのだろうか。",
   "ko_candidate": "놈은 이 앞에서 기다리고 있을까｡"
  },
  {
   "id": 38999,
   "key": "D1410ru.txt:519",
   "file": "D1410ru.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……良いだろう。これで最後だ。",
   "ko_candidate": "…좋아｡ 이걸로 마지막이다｡"
  },
  {
   "id": 39000,
   "key": "D1410ru.txt:521",
   "file": "D1410ru.txt",
   "line": 521,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『ブラックロッジ』も。",
   "ko_candidate": "『블랙로지』도｡ 크툴루도｡"
  },
  {
   "id": 39001,
   "key": "D1410ru.txt:522",
   "file": "D1410ru.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クトゥルーも。 クソふざけた理不尽を全部、纏めてぶっ飛ばしてやる。",
   "ko_candidate": "개같이 장난치는 불합리를 전부 한데 모아 날려버리겠어｡"
  },
  {
   "id": 39002,
   "key": "D1410ru.txt:525",
   "file": "D1410ru.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の海のすぐ真上に沿って、飛行する。",
   "ko_candidate": "피의 바다 바로 위를 따라 비행한다｡"
  },
  {
   "id": 39003,
   "key": "D1410ru.txt:532",
   "file": "D1410ru.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "濃度を増す邪気は遂には空間を歪ませるほどになっていた。",
   "ko_candidate": "농도를 더해가는 사기는 마침내 공간을 왜곡시킬 정도가 되었다｡"
  },
  {
   "id": 39004,
   "key": "D1410ru.txt:534",
   "file": "D1410ru.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分が今、真っ直ぐ進んでいるのか、曲がっているのか、更には昇っているか降っているのか逆様なのか、それすらも見失いそうになる。",
   "ko_candidate": "자신이 지금 똑바로 가고 있는지､ 휘어져 가고 있는지､ 더 나아가 올라가고 있는지 내려가고 있는지 거꾸로인지､ 그조차도 헷갈릴 것 같다｡"
  },
  {
   "id": 39005,
   "key": "D1410ru.txt:536",
   "file": "D1410ru.txt",
   "line": 536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全神経を研ぎ澄まして、幻覚に対抗する。",
   "ko_candidate": "모든 신경을 곤두세워 환각에 대항한다｡"
  },
  {
   "id": 39006,
   "key": "D1410ru.txt:538",
   "file": "D1410ru.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷汗が全身から噴き出した。",
   "ko_candidate": "식은땀이 온몸에서 뿜어져 나왔다｡"
  },
  {
   "id": 39007,
   "key": "D1410ru.txt:540",
   "file": "D1410ru.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがて紅く煙る視界の向こう、巨大な……デモンベインの全長の何倍にも及ぶ巨大な扉がそびえ立つのを認めた。",
   "ko_candidate": "이윽고 붉게 연기 나는 시야 너머､ 거대한… 데몬베인의 전장의 몇 배에 달하는 거대한 문이 우뚝 솟아있는 것을 확인했다｡"
  },
  {
   "id": 39008,
   "key": "D1410ru.txt:548",
   "file": "D1410ru.txt",
   "line": 548,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「間違いない……あの扉の向こうだ。邪気はあの奥から吹き荒れている」",
   "ko_candidate": "「틀림없어… 저 문 너머다｡ 사기는 저 안쪽에서 휘몰아치고 있어」"
  },
  {
   "id": 39009,
   "key": "D1410ru.txt:552",
   "file": "D1410ru.txt",
   "line": 552,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良し」",
   "ko_candidate": "「좋아」"
  }
 ]
}