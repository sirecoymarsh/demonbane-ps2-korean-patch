{
 "packet": "0100_02",
 "scene": "0100",
 "anchor": {
  "hit": 19,
  "total": 20,
  "rate": 0.95
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リベル・レギス": "리베르 레기스"
 },
 "items": [
  {
   "id": 82,
   "key": "D0100.txt:291",
   "file": "D0100.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その間、巨人の眸は正面を捉えたままで離さない。",
   "ko_candidate": "그 동안､ 거인의 눈동자는 정면을 포착한 채로 떼지 않는다｡"
  },
  {
   "id": 83,
   "key": "D0100.txt:296",
   "file": "D0100.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "亀裂は……消滅していた。",
   "ko_candidate": "균열은……소멸해 있었다｡"
  },
  {
   "id": 84,
   "key": "D0100.txt:301",
   "file": "D0100.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も無い。",
   "ko_candidate": "아무것도 없다｡"
  },
  {
   "id": 85,
   "key": "D0100.txt:302",
   "file": "D0100.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在るのはただ無限に広がる星の海。",
   "ko_candidate": "있는 것은 단지 무한히 펼쳐진 별의 바다｡"
  },
  {
   "id": 86,
   "key": "D0100.txt:303",
   "file": "D0100.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在りえてはならない怪異は、もはやその蔭すら残していなかった。",
   "ko_candidate": "있어서는 안 될 괴이는､ 이제 그 그림자조차 남기지 않았다｡"
  },
  {
   "id": 87,
   "key": "D0100.txt:305",
   "file": "D0100.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否。",
   "ko_candidate": "아니｡"
  },
  {
   "id": 88,
   "key": "D0100.txt:310",
   "file": "D0100.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "電光が、弾けている。",
   "ko_candidate": "번개가､ 튀고 있다｡"
  },
  {
   "id": 89,
   "key": "D0100.txt:311",
   "file": "D0100.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人が撃った雷光の、残滓か。",
   "ko_candidate": "거인이 쏜 번개의､ 잔재인가｡"
  },
  {
   "id": 90,
   "key": "D0100.txt:312",
   "file": "D0100.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その電光を纏って、紅い影がひとつ。",
   "ko_candidate": "그 번개를 두르고､ 붉은 그림자가 하나"
  },
  {
   "id": 91,
   "key": "D0100.txt:315",
   "file": "D0100.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅い影は――ヒト型だった。",
   "ko_candidate": "붉은 그림자는―― 인간의 형태를 띄고있었다¨"
  },
  {
   "id": 92,
   "key": "D0100.txt:316",
   "file": "D0100.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅い影もまた、鋼の巨人だった。",
   "ko_candidate": "붉은 그림자 또한､ 강철의 거인이었다｡"
  },
  {
   "id": 93,
   "key": "D0100.txt:317",
   "file": "D0100.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "欠けたる部位は無い。",
   "ko_candidate": "결함된 부위는 없다｡"
  },
  {
   "id": 94,
   "key": "D0100.txt:319",
   "file": "D0100.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "完全なヒト型。",
   "ko_candidate": "완전한 인간형｡"
  },
  {
   "id": 95,
   "key": "D0100.txt:319",
   "file": "D0100.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もしくは、完全な神型。",
   "ko_candidate": "혹은､ 완전한 신형｡"
  },
  {
   "id": 96,
   "key": "D0100.txt:320",
   "file": "D0100.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右掌を翳し、満身創痍の巨人を見下ろしている。",
   "ko_candidate": "오른손바닥을 들어 올려､ 만신창이가 된 거인을 내려다보고 있다｡"
  },
  {
   "id": 97,
   "key": "D0100.txt:321",
   "file": "D0100.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その表情の無い鉄仮面が、嘲笑った、かのようだった。",
   "ko_candidate": "그 표정 없는 철가면이 조소했다고 할 수 있었다｡"
  },
  {
   "id": 98,
   "key": "D0100.txt:326",
   "file": "D0100.txt",
   "line": 326,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「諦めよ」",
   "ko_candidate": "「포기해라」"
  },
  {
   "id": 99,
   "key": "D0100.txt:330",
   "file": "D0100.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無音である筈の宇宙に、紅の巨人の聲が響く。",
   "ko_candidate": "무음이어야 할 우주에､ 붉은 거인의 목소리가 울린다｡"
  },
  {
   "id": 100,
   "key": "D0100.txt:332",
   "file": "D0100.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鈴を転がす様に澄んで響く、少女のものとも少年のものとも取れない、中性的な聲。",
   "ko_candidate": "방울을 굴리는 듯 맑게 울리는､ 소녀의 것인지 소년의 것인지 알 수 없는､ 중성적인 목소리｡"
  },
  {
   "id": 101,
   "key": "D0100.txt:334",
   "file": "D0100.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聲は続ける。",
   "ko_candidate": "목소리는 계속된다｡"
  },
  {
   "id": 102,
   "key": "D0100.txt:336",
   "file": "D0100.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らを撃った巨人に向けて、まるで旧知の友に語りかけるかの様な穏やかさで。それは何処か、忌まわしい響きを持っていた。",
   "ko_candidate": "자신을 공격한 거인을 향해､ 마치 오랜 친구에게 말을 거는 듯한 온화함으로｡ 그것은 어딘가 불길한 울림을 지니고 있었다｡"
  },
  {
   "id": 103,
   "key": "D0100.txt:341",
   "file": "D0100.txt",
   "line": 341,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「如何に最強を誇る貴公とはいえ……術者無しでは、このリベル・レギスに敵う道理はあるまい」",
   "ko_candidate": "「아무리 최강을 자랑하는 당신이라 해도… 술사 없이는 이 리베르 레기스를 상대할 방법이 없을 것이다」"
  },
  {
   "id": 104,
   "key": "D0100.txt:345",
   "file": "D0100.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "鉄巨人は答えない。",
   "ko_candidate": "강철의 거인은 대답하지 않는다｡"
  },
  {
   "id": 105,
   "key": "D0100.txt:347",
   "file": "D0100.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし行動は何より雄弁だった。",
   "ko_candidate": "하지만 행동은 그 무엇보다 웅변적이었다｡"
  },
  {
   "id": 106,
   "key": "D0100.txt:356",
   "file": "D0100.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "第２射が放たれる。",
   "ko_candidate": "제2사가 발사된다｡"
  },
  {
   "id": 107,
   "key": "D0100.txt:363",
   "file": "D0100.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "続けて第３射、",
   "ko_candidate": "이어서 제3사､"
  },
  {
   "id": 108,
   "key": "D0100.txt:371",
   "file": "D0100.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "４射",
   "ko_candidate": "4사"
  },
  {
   "id": 109,
   "key": "D0100.txt:381",
   "file": "D0100.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "５射",
   "ko_candidate": "5사"
  },
  {
   "id": 110,
   "key": "D0100.txt:381",
   "file": "D0100.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……雷光の雨が紅の巨人に飛来する。",
   "ko_candidate": "…번개빛의 비가 붉은 거인에게 날아온다｡"
  },
  {
   "id": 111,
   "key": "D0100.txt:386",
   "file": "D0100.txt",
   "line": 386,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「無駄な事を」",
   "ko_candidate": "「헛수고를」"
  },
  {
   "id": 112,
   "key": "D0100.txt:395",
   "file": "D0100.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人が翳した掌に光が集う。",
   "ko_candidate": "붉은 거인이 들어 올린 손바닥에 빛이 모인다｡"
  },
  {
   "id": 113,
   "key": "D0100.txt:400",
   "file": "D0100.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "浮かび上がる光の文字。",
   "ko_candidate": "떠오르는 빛의 문자｡"
  },
  {
   "id": 114,
   "key": "D0100.txt:401",
   "file": "D0100.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "浮かび上がる紋様。",
   "ko_candidate": "떠오르는 문양｡"
  },
  {
   "id": 115,
   "key": "D0100.txt:403",
   "file": "D0100.txt",
   "line": 403,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人の前方に巨大な光の障壁が出現した。",
   "ko_candidate": "붉은 거인의 전방에 거대한 빛의 장벽이 출현했다｡"
  },
  {
   "id": 116,
   "key": "D0100.txt:404",
   "file": "D0100.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "障壁は雷光の雨の尽くを阻み、霧散させる。",
   "ko_candidate": "장벽은 번개빛의 비를 모두 막아내고､ 흩어지게 한다｡"
  },
  {
   "id": 117,
   "key": "D0100.txt:409",
   "file": "D0100.txt",
   "line": 409,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ン・カイの闇よ」",
   "ko_candidate": "「은카이의 어둠이여」"
  },
  {
   "id": 118,
   "key": "D0100.txt:414",
   "file": "D0100.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人の腕が割れた。",
   "ko_candidate": "붉은 거인의 팔이 갈라졌다｡"
  },
  {
   "id": 119,
   "key": "D0100.txt:416",
   "file": "D0100.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "割れたその先には黒い砲口が顎を開けている。",
   "ko_candidate": "갈라진 그 끝에는 검은 포구가 입을 벌리고 있다｡"
  },
  {
   "id": 120,
   "key": "D0100.txt:418",
   "file": "D0100.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砲身の外周を光の文字が疾る。",
   "ko_candidate": "포신의 외주를 빛의 문자가 달린다｡"
  },
  {
   "id": 121,
   "key": "D0100.txt:426",
   "file": "D0100.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "漆黒の宇宙より、なお深い闇の塊が連続して吐き出された。",
   "ko_candidate": "칠흑의 우주보다 더 깊은 어둠의 덩어리가 연속해서 토해져 나왔다｡"
  }
 ]
}