 },
 "items": [
  {
   "id": 34131,
   "key": "D1309al.txt:1046",
   "file": "D1309al.txt",
   "line": 1046,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうするつもりだ？」",
   "ko_candidate": "「어떻게 할 생각이냐?」"
  },
  {
   "id": 34132,
   "key": "D1309al.txt:1050",
   "file": "D1309al.txt",
   "line": 1050,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……どうすっかな、おい」",
   "ko_candidate": "「……어떻게 하지､ 야」"
  },
  {
   "id": 34133,
   "key": "D1309al.txt:1052",
   "file": "D1309al.txt",
   "line": 1052,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつもならこんなとき、あの人が助けてくれるんだが、今回は果たして……。",
   "ko_candidate": "평소라면 이럴 때 그 사람이 도와주시는데､ 이번엔 과연……。"
  },
  {
   "id": 34134,
   "key": "D1309le.txt:13",
   "file": "D1309le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎は結界だ。",
   "ko_candidate": "폭염은 결계다｡"
  },
  {
   "id": 34135,
   "key": "D1309le.txt:14",
   "file": "D1309le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒の炎で囲い、怨霊渦巻く爆発の只中に俺を閉じ込める。",
   "ko_candidate": "암흑의 불꽃으로 둘러싸고､ 원령이 소용돌이치는 폭발의 한가운데에 나를 가두어 버린다｡"
  },
  {
   "id": 34136,
   "key": "D1309le.txt:16",
   "file": "D1309le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉体をバラバラに引き千切るほどの爆圧が、肉体を襲う。",
   "ko_candidate": "육체를 산산조각 내버릴 정도의 폭압이 육체를 덮친다｡"
  },
  {
   "id": 34137,
   "key": "D1309le.txt:17",
   "file": "D1309le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "精神を粉々に打ち砕くほどの霊圧が、精神を襲う。",
   "ko_candidate": "정신을 산산조각 내버릴 정도의 영압이 정신을 덮친다｡"
  },
  {
   "id": 34138,
   "key": "D1309le.txt:19",
   "file": "D1309le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの衝撃に、俺という存在が消し飛ばされる前に、この刹那、術式を完成させるべく、思考を疾走させる。",
   "ko_candidate": "두 가지 충격에､ 내라는 존재가 날아가 버리기 전에､ 이 찰나､ 술식을 완성시키기 위해 사고를 질주시킨다｡"
  },
  {
   "id": 34139,
   "key": "D1309le.txt:20",
   "file": "D1309le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳にかかる負担に細胞が悲鳴をあげる。",
   "ko_candidate": "뇌에 가해지는 부담에 세포가 비명을 지른다｡"
  },
  {
   "id": 34140,
   "key": "D1309le.txt:22",
   "file": "D1309le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼き切れた。",
   "ko_candidate": "타들어갔다｡"
  },
  {
   "id": 34141,
   "key": "D1309le.txt:23",
   "file": "D1309le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両目と、鼻の奥で何かが弾けた。血涙と鼻血が顔を伝う。",
   "ko_candidate": "양쪽 눈과 코 안쪽에서 무언가가 터졌다｡ 피눈물과 코피가 얼굴을 타고 흐른다｡"
  },
  {
   "id": 34142,
   "key": "D1309le.txt:25",
   "file": "D1309le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを無視して、術を編み続ける。",
   "ko_candidate": "그것을 무시하고 술을 계속 짜낸다｡"
  },
  {
   "id": 34143,
   "key": "D1309le.txt:30",
   "file": "D1309le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身体能力を限界まで加速。例によって毛細血管が千切れ、血が迸った。",
   "ko_candidate": "신체 능력을 한계까지 가속｡ 예의 그대로 모세혈관이 터져 피가 뿜어져 나왔다｡"
  },
  {
   "id": 34144,
   "key": "D1309le.txt:42",
   "file": "D1309le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀を振るう。",
   "ko_candidate": "바르자이의 언월도를 휘두른다｡"
  },
  {
   "id": 34145,
   "key": "D1309le.txt:43",
   "file": "D1309le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀が噴き出る血飛沫を纏う。振るうたびに、鮮血が空間に紅い線を引く。",
   "ko_candidate": "언월도가 뿜어져 나오는 피보라를 두른다｡ 휘두를 때마다 선혈이 공간에 붉은 선을 그린다｡"
  },
  {
   "id": 34146,
   "key": "D1309le.txt:45",
   "file": "D1309le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血と剣の軌跡が描いた五芒星形。",
   "ko_candidate": "피와 검의 궤적이 그린 오망성형｡"
  },
  {
   "id": 34147,
   "key": "D1309le.txt:46",
   "file": "D1309le.txt",
   "line": 46,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『旧き印』。",
   "ko_candidate": "『엘더 사인』｡"
  },
  {
   "id": 34148,
   "key": "D1309le.txt:51",
   "file": "D1309le.txt",
   "line": 51,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおおおおおお！」",
   "ko_candidate": "「우오오오오오오오오오!」"
  },
  {
   "id": 34149,
   "key": "D1309le.txt:53",
   "file": "D1309le.txt",
   "line": 53,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『旧き印』は堅固な防禦結界となって、俺を護る。",
   "ko_candidate": "『엘더 사인』은 견고한 방어 결계가 되어 나를 지킨다｡"
  },
  {
   "id": 34150,
   "key": "D1309le.txt:54",
   "file": "D1309le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨霊の重爆が『旧き印』の輝きの前に浄化され霧散する。",
   "ko_candidate": "원령의 중폭이 『엘더 사인』의 빛 앞에서 정화되어 흩어진다｡"
  },
  {
   "id": 34151,
   "key": "D1309le.txt:56",
   "file": "D1309le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが霊圧は並大抵のものではなく、これで防ぎきれるものではない。",
   "ko_candidate": "하지만 영압은 보통이 아니어서 이것으로 막아내기엔 역부족이다｡"
  },
  {
   "id": 34152,
   "key": "D1309le.txt:58",
   "file": "D1309le.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は『旧き印』を纏ったまま、黒翼に魔力を結集。増幅。オーバードライブさせる。",
   "ko_candidate": "나는 『엘더 사인』을 두른 채 검은 날개에 마력을 집중한다｡ 증폭｡ 오버드라이브시킨다｡"
  },
  {
   "id": 34153,
   "key": "D1309le.txt:65",
   "file": "D1309le.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分の力で自分を吹き飛ばす勢いで、爆炎の障壁を突破した。",
   "ko_candidate": "자신의 힘으로 자신을 날려버릴 기세로 폭염의 장벽을 돌파했다｡"
  },
  {
   "id": 34154,
   "key": "D1309le.txt:67",
   "file": "D1309le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆砕する瘴気の波動を背中に感じる。",
   "ko_candidate": "폭쇄하는 장기의 파동을 등에 느낀다｡"
  },
  {
   "id": 34155,
   "key": "D1309le.txt:68",
   "file": "D1309le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "防禦と脱出に全力を注いだので、制御は効かない。",
   "ko_candidate": "방어와 탈출에 전력을 다했기에 제어가 되지 않는다｡"
  },
  {
   "id": 34156,
   "key": "D1309le.txt:78",
   "file": "D1309le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このまま地面へと激突する。",
   "ko_candidate": "이대로 지면으로 격돌한다｡"
  },
  {
   "id": 34157,
   "key": "D1309le.txt:79",
   "file": "D1309le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫が舞い上がった。",
   "ko_candidate": "잔해가 날아올랐다｡"
  },
  {
   "id": 34158,
   "key": "D1309le.txt:82",
   "file": "D1309le.txt",
   "line": 82,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「がはっ……！」",
   "ko_candidate": "「가핫……!」"
  },
  {
   "id": 34159,
   "key": "D1309le.txt:86",
   "file": "D1309le.txt",
   "line": 86,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「つぅ……無茶をする……が、良くぞ脱け出した」",
   "ko_candidate": "「츠……무모한 짓을 하다니……하지만 잘 빠져나왔어」"
  },
  {
   "id": 34160,
   "key": "D1309le.txt:94",
   "file": "D1309le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀を杖に立ち上がる。",
   "ko_candidate": "바르자이의 언월도를 지팡이 삼아 일어선다｡"
  },
  {
   "id": 34161,
   "key": "D1309le.txt:95",
   "file": "D1309le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビチャビチャと溢れる血飛沫が、地面を染めた。",
   "ko_candidate": "비챠비챠 넘치는 피보라가 지면을 물들였다｡"
  },
  {
   "id": 34162,
   "key": "D1309le.txt:100",
   "file": "D1309le.txt",
   "line": 100,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「へぇ～、やるじゃない」",
   "ko_candidate": "「헤에~ 제법이잖아」"
  },
  {
   "id": 34163,
   "key": "D1309le.txt:107",
   "file": "D1309le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨霊を纏うデモンベインが俺たちを見下ろしている。",
   "ko_candidate": "원령을 두른 데몬베인이 우리를 내려다보고 있다｡"
  },
  {
   "id": 34164,
   "key": "D1309le.txt:108",
   "file": "D1309le.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "五十メートルの巨体の影が、圧し掛かっている。",
   "ko_candidate": "50미터의 거체의 그림자가 압박해 온다｡"
  },
  {
   "id": 34165,
   "key": "D1309le.txt:112",
   "file": "D1309le.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……瘴気が濃度を増した。",
   "ko_candidate": "……장기가 농도를 더했다｡"
  },
  {
   "id": 34166,
   "key": "D1309le.txt:113",
   "file": "D1309le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "また、来る……！",
   "ko_candidate": "또 온다……!"
  },
  {
   "id": 34167,
   "key": "D1309le.txt:117",
   "file": "D1309le.txt",
   "line": 117,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ、悪足掻きよねぇ～。おほほほほほほほ！　そんなにボロボロになって、なんて無様なんでしょう！　まったく哀れを誘う子ねぇ！」",
   "ko_candidate": "「뭐､ 발버둥이네에~｡ 오호호호호호호! 그렇게 만신창이가 되어서､ 얼마나 볼품없는 거야! 정말 가련한 아이네에!」"
  },
  {
   "id": 34168,
   "key": "D1309le.txt:122",
   "file": "D1309le.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再び怨霊呪弾が顕現化する。",
   "ko_candidate": "다시 원령주탄이 현현화한다｡"
  },
  {
   "id": 34169,
   "key": "D1309le.txt:123",
   "file": "D1309le.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間を捻じ曲げ、生命を刈り取る致死量の瘴気をだだ漏れさせる。",
   "ko_candidate": "공간을 비틀고 생명을 앗아가는 치사량의 장기를 마구 새어나오게 한다｡"
  },
  {
   "id": 34170,
   "key": "D1309le.txt:124",
   "file": "D1309le.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "零れた怨霊の数匹が俺に纏わりつく。",
   "ko_candidate": "흘러나온 원령 몇 마리가 나에게 달라붙는다｡"
  }
 ]
}