 "items": [
  {
   "id": 50733,
   "key": "ep_ruri02a.txt:664",
   "file": "ep_ruri02a.txt",
   "line": 664,
   "speaker": "鋼造",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「昔付き合っていた……女さ……。根無し草に愛想が尽きたか、俺の許から逃げちまったけど……へへっ……未練だよなぁ……俺ときたら、今だにこんな写真、後生大事にしてやがる。 なあ、お前……その女に会ったら、俺の代わりに一言謝っといてくれよ……色々、迷惑、かけちまったからさ……っ。 アーカムってド田舎に住んでいる……すぐ見つかると思うが……」",
   "ko_candidate": ""
  },
  {
   "id": 50734,
   "key": "ep_ruri02a.txt:671",
   "file": "ep_ruri02a.txt",
   "line": 671,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……アーカム？」",
   "ko_candidate": ""
  },
  {
   "id": 50735,
   "key": "ep_ruri02a.txt:674",
   "file": "ep_ruri02a.txt",
   "line": 674,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その名を聞くと、そいつは大層、驚いたようだった。",
   "ko_candidate": ""
  },
  {
   "id": 50736,
   "key": "ep_ruri02a.txt:678",
   "file": "ep_ruri02a.txt",
   "line": 678,
   "speaker": "鋼造",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「何だよ……知ってるんか……まったく奇妙な縁だよな……。 だったら頼むわぁ……報酬は……そうだな。宝の地図、なんてどうだ？ 荷物ン中に……俺が調べた、金脈の、詳細なデータがある……。 ああ、一獲千金狙ってこれじゃあ……ザマぁねえな……ったく。 まっ……信じるか信じないかは……お前次第っと……げぶぉぐっ！」",
   "ko_candidate": ""
  },
  {
   "id": 50737,
   "key": "ep_ruri02a.txt:687",
   "file": "ep_ruri02a.txt",
   "line": 687,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "またしても血を吐き出す。 ただ……今度のはヤバイ。決定的だ。",
   "ko_candidate": "고정됐다｡"
  },
  {
   "id": 50738,
   "key": "ep_ruri02a.txt:689",
   "file": "ep_ruri02a.txt",
   "line": 689,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "血を吐くと同時に、全身の力が凄い勢いで抜けていくのを感じる。",
   "ko_candidate": ""
  },
  {
   "id": 50739,
   "key": "ep_ruri02a.txt:690",
   "file": "ep_ruri02a.txt",
   "line": 690,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "視界がどんどん暗くなっていく。",
   "ko_candidate": ""
  },
  {
   "id": 50740,
   "key": "ep_ruri02a.txt:694",
   "file": "ep_ruri02a.txt",
   "line": 694,
   "speaker": "鋼造",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ああ……クソ……もうお迎えかよ……ちくしょう、ちくしょう……ホントはよぉ……こんな死に方したかねぇんだよ……っ……ああー……真面目に、カタギやってりゃ良かったかなぁ……あ――あ……寒ぃ……寒すぎるぜ、クソ……あいつのカラダ……温かったよなぁ……何で別れちまったんだか……ああー……あああ……クソクソクソ、何か言い忘れてなかったかな……あークソ、おい、お前……頼んだぜ？　ホントにな？　ああ……寒ィ……泣けてくるなぁ……」",
   "ko_candidate": ""
  },
  {
   "id": 50741,
   "key": "ep_ruri02a.txt:697",
   "file": "ep_ruri02a.txt",
   "line": 697,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "意識が朦朧とする。",
   "ko_candidate": ""
  },
  {
   "id": 50742,
   "key": "ep_ruri02a.txt:698",
   "file": "ep_ruri02a.txt",
   "line": 698,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "躰の感覚が酷く遠い。 目も完全に見えなくなった。",
   "ko_candidate": "마치 시간을 멈춘 것처럼､ 빛의 입자는､ 정지해 있다｡"
  },
  {
   "id": 50743,
   "key": "ep_ruri02a.txt:700",
   "file": "ep_ruri02a.txt",
   "line": 700,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "独りになる――死ぬってのは、こんなにも寂しいものなのか。",
   "ko_candidate": ""
  },
  {
   "id": 50744,
   "key": "ep_ruri02a.txt:701",
   "file": "ep_ruri02a.txt",
   "line": 701,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ああ……嫌だ嫌だ……。",
   "ko_candidate": ""
  },
  {
   "id": 50745,
   "key": "ep_ruri02a.txt:705",
   "file": "ep_ruri02a.txt",
   "line": 705,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――――」 ただ、最期に。",
   "ko_candidate": "「자! 이 어리석은 반복을 끝내겠어요!」"
  },
  {
   "id": 50746,
   "key": "ep_ruri02a.txt:709",
   "file": "ep_ruri02a.txt",
   "line": 709,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺の死を看取るそいつが、訊いてきた質問は、しっかりと耳に届いた。",
   "ko_candidate": ""
  },
  {
   "id": 50747,
   "key": "ep_ruri02a.txt:710",
   "file": "ep_ruri02a.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それが俺の意識をギリギリまで繋ぎ止める。 そうだ……これは教えておかないと。",
   "ko_candidate": "침묵｡"
  },
  {
   "id": 50748,
   "key": "ep_ruri02a.txt:713",
   "file": "ep_ruri02a.txt",
   "line": 713,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "誰も知られずに死ぬことに変わりなくなっちまう。",
   "ko_candidate": ""
  },
  {
   "id": 50749,
   "key": "ep_ruri02a.txt:715",
   "file": "ep_ruri02a.txt",
   "line": 715,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "全力を振り絞って、何とか咽喉を震わせ、息も絶え絶えに声を出す。",
   "ko_candidate": ""
  },
  {
   "id": 50750,
   "key": "ep_ruri02a.txt:717",
   "file": "ep_ruri02a.txt",
   "line": 717,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺の最期の言葉は、ちゃんとそいつの耳に届いただろうか？",
   "ko_candidate": ""
  },
  {
   "id": 50751,
   "key": "ep_ruri02a.txt:721",
   "file": "ep_ruri02a.txt",
   "line": 721,
   "speaker": "鋼造",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「俺の名前は――――」 覇道　鋼造。",
   "ko_candidate": "시간이 멈춘 방에､ 내 목소리만이 울린다｡"
  },
  {
   "id": 50752,
   "key": "ep_ruri02a.txt:732",
   "file": "ep_ruri02a.txt",
   "line": 732,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――――――――何だって？」",
   "ko_candidate": ""
  },
  {
   "id": 50753,
   "key": "ep_ruri02a.txt:742",
   "file": "ep_ruri02a.txt",
   "line": 742,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「見えたか？　絡繰が」",
   "ko_candidate": ""
  },
  {
   "id": 50754,
   "key": "ep_ruri02a.txt:746",
   "file": "ep_ruri02a.txt",
   "line": 746,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……マスターテリオン」",
   "ko_candidate": ""
  },
  {
   "id": 50755,
   "key": "ep_ruri02a.txt:751",
   "file": "ep_ruri02a.txt",
   "line": 751,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "声に振り返る。",
   "ko_candidate": ""
  },
  {
   "id": 50756,
   "key": "ep_ruri02a.txt:752",
   "file": "ep_ruri02a.txt",
   "line": 752,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "宙に浮く紅の機体。その掌にマスターテリオンは立っている。",
   "ko_candidate": ""
  },
  {
   "id": 50757,
   "key": "ep_ruri02a.txt:753",
   "file": "ep_ruri02a.txt",
   "line": 753,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "亀裂の笑みに頬を引き裂いて、澱む金色の眸を愉悦で歪ませて、俺を見下ろしている。",
   "ko_candidate": ""
  },
  {
   "id": 50758,
   "key": "ep_ruri02a.txt:757",
   "file": "ep_ruri02a.txt",
   "line": 757,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「これが始まりだ。大十字九郎。余は再び、貴公の前に現れる。 再び、あの『ブラックロッジ』を引き連れて。 それまでに何をすれば良いか……貴公には解かる筈だ」",
   "ko_candidate": ""
  },
  {
   "id": 50759,
   "key": "ep_ruri02a.txt:762",
   "file": "ep_ruri02a.txt",
   "line": 762,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "靄のような闇が、心の奥にわだかまり、重く圧し掛かる。",
   "ko_candidate": ""
  },
  {
   "id": 50760,
   "key": "ep_ruri02a.txt:763",
   "file": "ep_ruri02a.txt",
   "line": 763,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "呆然と突っ立つ俺の姿に、マスターテリオンは哄笑する。",
   "ko_candidate": ""
  },
  {
   "id": 50761,
   "key": "ep_ruri02a.txt:767",
   "file": "ep_ruri02a.txt",
   "line": 767,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「あはははははは！　そうだ！　その貌だ！ 少しずつ絶望に貪られてゆく貴公の姿が！　この永劫を生きる余の、唯一の糧なのだ！　さあ、今度も愉しませろよ！ 今度の貴公は何処までやれるか？　何処まで運命の裏をかけるのか？ 『アル・アジフ』を失った貴公が！　いったい何処まで余に迫れるか!? あははは、こんなに刺激的な遊戯は無い！」",
   "ko_candidate": ""
  },
  {
   "id": 50762,
   "key": "ep_ruri02a.txt:781",
   "file": "ep_ruri02a.txt",
   "line": 781,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……貴様アアアァァァァァァ！」",
   "ko_candidate": ""
  },
  {
   "id": 50763,
   "key": "ep_ruri02a.txt:784",
   "file": "ep_ruri02a.txt",
   "line": 784,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "雄叫びを上げ、魔銃を招喚しようとする――が、マギウスになれない今の俺にその力は振るえない。",
   "ko_candidate": ""
  },
  {
   "id": 50764,
   "key": "ep_ruri02a.txt:785",
   "file": "ep_ruri02a.txt",
   "line": 785,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "空っぽの手が、虚しく突き出されるだけだ。",
   "ko_candidate": ""
  },
  {
   "id": 50765,
   "key": "ep_ruri02a.txt:789",
   "file": "ep_ruri02a.txt",
   "line": 789,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「あははははははは！　あはははははははは！　あははははははははは！」",
   "ko_candidate": ""
  },
  {
   "id": 50766,
   "key": "ep_ruri02a.txt:794",
   "file": "ep_ruri02a.txt",
   "line": 794,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "リベル・レギスが光になる。",
   "ko_candidate": ""
  },
  {
   "id": 50767,
   "key": "ep_ruri02a.txt:795",
   "file": "ep_ruri02a.txt",
   "line": 795,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "光となって砕けてゆく。",
   "ko_candidate": ""
  },
  {
   "id": 50768,
   "key": "ep_ruri02a.txt:796",
   "file": "ep_ruri02a.txt",
   "line": 796,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "砕けゆく光に、マスターテリオンの姿が消えてゆく。",
   "ko_candidate": ""
  },
  {
   "id": 50769,
   "key": "ep_ruri02a.txt:797",
   "file": "ep_ruri02a.txt",
   "line": 797,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "――瞬間転移。",
   "ko_candidate": ""
  },
  {
   "id": 50770,
   "key": "ep_ruri02a.txt:803",
   "file": "ep_ruri02a.txt",
   "line": 803,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「待ちやがれ！　ちくしょおぉぉぉぉぉぉぉぉぉ！」",
   "ko_candidate": ""
  },
  {
   "id": 50771,
   "key": "ep_ruri02a.txt:809",
   "file": "ep_ruri02a.txt",
   "line": 809,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「あははははははははははははははははははははははははははははははは！」",
   "ko_candidate": ""
  },
  {
   "id": 50772,
   "key": "ep_ruri02a.txt:815",
   "file": "ep_ruri02a.txt",
   "line": 815,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
