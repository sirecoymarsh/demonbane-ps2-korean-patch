 },
 "trusted": true,
 "note": "후보(팬패치)가 이 구간에서는 전혀 다른 장면 텍스트라 비웠다. 원문(jp)만 보고 새로 확정할 것.",
 "glossary": {
  "アル": "알",
  "ウェスト": "웨스트",
  "ドクター・ウェスト": "닥터 웨스트",
  "魔力": "마력",
  "デモンベイン": "데몬베인",
  "覇道": "하도",
  "ブラックロッジ": "블랙로지",
  "チアキ": "치아키",
  "エルザ": "엘자"
 },
 "items": [
  {
   "id": 24743,
   "key": "D1107ru.txt:44",
   "file": "D1107ru.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "嫌な予感がして、そしてその予感は正しいだろうと確信して、アルは音の方を振り向いた。",
   "ko_candidate": ""
  },
  {
   "id": 24745,
   "key": "D1107ru.txt:49",
   "file": "D1107ru.txt",
   "line": 49,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「今夜、独りぼっちかーい？　今夜、僕がいなくて寂しくないかーい？　別れたことを後悔しているか――いっっっ♪」",
   "ko_candidate": ""
  },
  {
   "id": 24748,
   "key": "D1107ru.txt:53",
   "file": "D1107ru.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "当然と言えば当然に、予感は大的中だった。",
   "ko_candidate": ""
  },
  {
   "id": 24749,
   "key": "D1107ru.txt:58",
   "file": "D1107ru.txt",
   "line": 58,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……ウェスト」",
   "ko_candidate": ""
  },
  {
   "id": 24750,
   "key": "D1107ru.txt:65",
   "file": "D1107ru.txt",
   "line": 65,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「君のハートは悲しみでいっぱいじゃないかーい？　もう一度、君の元へ戻って良いかーい？」",
   "ko_candidate": ""
  },
  {
   "id": 24751,
   "key": "D1107ru.txt:68",
   "file": "D1107ru.txt",
   "line": 68,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ねぇ、教えてくれっ♪　今夜、独りぼっちか――――いっっっ！」",
   "ko_candidate": ""
  },
  {
   "id": 24758,
   "key": "D1107ru.txt:73",
   "file": "D1107ru.txt",
   "line": 73,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「煩い。黙れ」",
   "ko_candidate": ""
  },
  {
   "id": 24763,
   "key": "D1107ru.txt:88",
   "file": "D1107ru.txt",
   "line": 88,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ぬおあああああああああっ！」",
   "ko_candidate": ""
  },
  {
   "id": 24764,
   "key": "D1107ru.txt:92",
   "file": "D1107ru.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "情け容赦ない魔力波の一撃が、ドクター・ウェストを吹き飛ばした。",
   "ko_candidate": ""
  },
  {
   "id": 24765,
   "key": "D1107ru.txt:94",
   "file": "D1107ru.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "血を噴き出し、首をあらぬ角度にへし曲げ、苦痛に悶絶しながら、それでもドクター・ウェストはギターを離さない。",
   "ko_candidate": ""
  },
  {
   "id": 24767,
   "key": "D1107ru.txt:99",
   "file": "D1107ru.txt",
   "line": 99,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「お゛お゛お゛お゛……ッ。そ、それでも我輩は歌い続ける……ッ。 この熱い想い、君に届けと……ッ」",
   "ko_candidate": ""
  },
  {
   "id": 24768,
   "key": "D1107ru.txt:105",
   "file": "D1107ru.txt",
   "line": 105,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「届けずとも良い。そんな気色悪いもの。 ……それよりも汝、医務室でくたばっていたのでは無いのか？」",
   "ko_candidate": ""
  },
  {
   "id": 24769,
   "key": "D1107ru.txt:115",
   "file": "D1107ru.txt",
   "line": 115,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「フン……甘く見るなである。あの程度で、この、神に選ばれた天才たる我輩をどうにか出来るものか」",
   "ko_candidate": ""
  },
  {
   "id": 24771,
   "key": "D1107ru.txt:118",
   "file": "D1107ru.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "白衣の埃を払いながら、平然と起き上がる。",
   "ko_candidate": ""
  },
  {
   "id": 24772,
   "key": "D1107ru.txt:119",
   "file": "D1107ru.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "相変わらず、しぶとかった。",
   "ko_candidate": ""
  },
  {
   "id": 24773,
   "key": "D1107ru.txt:124",
   "file": "D1107ru.txt",
   "line": 124,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「それで、こんな所で何をしておる？」",
   "ko_candidate": ""
  },
  {
   "id": 24775,
   "key": "D1107ru.txt:131",
   "file": "D1107ru.txt",
   "line": 131,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「見ての通りであるよ、ほれ」",
   "ko_candidate": ""
  },
  {
   "id": 24777,
   "key": "D1107ru.txt:134",
   "file": "D1107ru.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "超高速で走り回る作業ロボを指差す。",
   "ko_candidate": ""
  },
  {
   "id": 24778,
   "key": "D1107ru.txt:138",
   "file": "D1107ru.txt",
   "line": 138,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「なかなかに優れた修理システムではあるが、作業効率がいまいちだったからな。我輩がチョチョイと改良してやったのよ」",
   "ko_candidate": ""
  },
  {
   "id": 24781,
   "key": "D1107ru.txt:141",
   "file": "D1107ru.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "確かに作業ロボット達は、これだけの異常なスピードにも拘わらず、的確にデモンベインの修理を進めていた。",
   "ko_candidate": ""
  },
  {
   "id": 24782,
   "key": "D1107ru.txt:143",
   "file": "D1107ru.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "これがドクター・ウェストの仕業だと言うのか。",
   "ko_candidate": ""
  },
  {
   "id": 24783,
   "key": "D1107ru.txt:145",
   "file": "D1107ru.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だとしたらこの男は、本人が主張する通り、紛れも無い天才だろう。",
   "ko_candidate": ""
  },
  {
   "id": 24784,
   "key": "D1107ru.txt:149",
   "file": "D1107ru.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "半ば感心し、半ば呆れ返りながら、アルはドクター・ウェストの顔を真っ直ぐに見つめた。",
   "ko_candidate": ""
  },
  {
   "id": 24785,
   "key": "D1107ru.txt:151",
   "file": "D1107ru.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ドクター・ウェストの口端には、不敵な笑みが浮かぶ。",
   "ko_candidate": ""
  },
  {
   "id": 24787,
   "key": "D1107ru.txt:159",
   "file": "D1107ru.txt",
   "line": 159,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「しかし、良くそんな勝手な真似が出来たな。仮にも汝は『ブラックロッジ』の信徒。覇道の連中が見逃す筈は無いと思うが――」",
   "ko_candidate": ""
  },
  {
   "id": 24788,
   "key": "D1107ru.txt:164",
   "file": "D1107ru.txt",
   "line": 164,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ああ、そのことなら。ほれ」",
   "ko_candidate": ""
  },
  {
   "id": 24789,
   "key": "D1107ru.txt:169",
   "file": "D1107ru.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "今度は格納庫の隅の暗がりを指差す。",
   "ko_candidate": ""
  },
  {
   "id": 24790,
   "key": "D1107ru.txt:171",
   "file": "D1107ru.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "闇の向こうから、何やらくぐもった呻き声が聞こえてきた。",
   "ko_candidate": ""
  },
  {
   "id": 24791,
   "key": "D1107ru.txt:173",
   "file": "D1107ru.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "目を良く凝らせば、床に転がり、芋虫のように、もがき暴れる姿。",
   "ko_candidate": ""
  },
  {
   "id": 24792,
   "key": "D1107ru.txt:177",
   "file": "D1107ru.txt",
   "line": 177,
   "speaker": "チアキ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ん――っ！　んんん――っ！　ん――――っっ！」",
   "ko_candidate": ""
  },
  {
   "id": 24793,
   "key": "D1107ru.txt:180",
   "file": "D1107ru.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "チアキだった。",
   "ko_candidate": ""
  },
  {
   "id": 24794,
   "key": "D1107ru.txt:181",
   "file": "D1107ru.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "猿轡とロープでふん縛られていた。",
   "ko_candidate": ""
  },
  {
   "id": 24797,
   "key": "D1107ru.txt:182",
   "file": "D1107ru.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "芸術的なまでに見事な縛りっぷりだった。",
   "ko_candidate": ""
  },
  {
   "id": 24798,
   "key": "D1107ru.txt:187",
   "file": "D1107ru.txt",
   "line": 187,
   "speaker": "エルザ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「エルザが、 ふん縛っておいたロボー」",
   "ko_candidate": ""
  },
  {
   "id": 24799,
   "key": "D1107ru.txt:192",
   "file": "D1107ru.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "転がるチアキの横で、エルザが誇らしげに胸を張る。",
   "ko_candidate": ""
  },
  {
   "id": 24800,
   "key": "D1107ru.txt:194",
   "file": "D1107ru.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アルの視線がチアキから、エルザに移り、そしてゆっくりと再びドクター・ウェストの元へ。やっぱり誇らしげだった。",
   "ko_candidate": ""
  },
  {
   "id": 24801,
   "key": "D1107ru.txt:196",
   "file": "D1107ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "――もうツッコむ気力すら失われた。",
   "ko_candidate": ""
  },
  {
   "id": 24806,
   "key": "D1107ru.txt:201",
   "file": "D1107ru.txt",
   "line": 201,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……ウェスト。汝、何を企んでおる？」",
   "ko_candidate": ""
  },
  {
   "id": 24807,
   "key": "D1107ru.txt:209",
   "file": "D1107ru.txt",
   "line": 209,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「企む？　何のことであるか？」",
   "ko_candidate": ""
  },
  {
   "id": 24808,
   "key": "D1107ru.txt:212",
   "file": "D1107ru.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "再びエレキギターを爪弾きながら、ドクター・ウェストは訊ね返す。",
   "ko_candidate": ""
  }
 ]
}