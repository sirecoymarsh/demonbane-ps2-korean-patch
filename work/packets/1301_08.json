  },
  {
   "id": 30911,
   "key": "D1301ru.txt:76",
   "file": "D1301ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『グ＝ハーン断章』",
   "ko_candidate": "『이스테의 노래』"
  },
  {
   "id": 30912,
   "key": "D1301ru.txt:78",
   "file": "D1301ru.txt",
   "line": 78,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『断罪の書』",
   "ko_candidate": "『구=한 단장』"
  },
  {
   "id": 30913,
   "key": "D1301ru.txt:79",
   "file": "D1301ru.txt",
   "line": 79,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『黄衣の王』",
   "ko_candidate": "『단죄의 서』"
  },
  {
   "id": 30914,
   "key": "D1301ru.txt:80",
   "file": "D1301ru.txt",
   "line": 80,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ドール賛歌』",
   "ko_candidate": "『황의의 왕』"
  },
  {
   "id": 30915,
   "key": "D1301ru.txt:81",
   "file": "D1301ru.txt",
   "line": 81,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『ヴォイニッチ写本』",
   "ko_candidate": "『도올 찬가』 『보이니치 사본』"
  },
  {
   "id": 30916,
   "key": "D1301ru.txt:83",
   "file": "D1301ru.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……その前を通るだけでも俺は緊張し、圧倒され、何度もその場に蹲り、息を切らした。",
   "ko_candidate": "…그 앞을 지나가는 것만으로도 나는 긴장하고､ 압도당하고､ 여러 번 그 자리에 쪼그리고 앉아 숨을 헐떡였다｡"
  },
  {
   "id": 30917,
   "key": "D1301ru.txt:85",
   "file": "D1301ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "想像以上だった。",
   "ko_candidate": "상상 이상이었다｡"
  },
  {
   "id": 30918,
   "key": "D1301ru.txt:86",
   "file": "D1301ru.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔導書から放たれる……いや、むしろ迸るような妖気の濃厚さ。",
   "ko_candidate": "마도서에서 뿜어져 나오는… 아니､ 오히려 분출하는 듯한 요기의 농밀함｡"
  },
  {
   "id": 30919,
   "key": "D1301ru.txt:88",
   "file": "D1301ru.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなのを浴びているだけで、どうにかなってしまいそうだった。",
   "ko_candidate": "이런 것을 쬐고 있는 것만으로도 어떻게 될 것 같았다｡"
  },
  {
   "id": 30920,
   "key": "D1301ru.txt:89",
   "file": "D1301ru.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こんなことで『書』に目を通したら、どうなってしまうことやら……。",
   "ko_candidate": "이런 상태로 『서적』을 읽으면 어떻게 될지…"
  },
  {
   "id": 30921,
   "key": "D1301ru.txt:94",
   "file": "D1301ru.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでも俺は起き上がり、歩き続けた。",
   "ko_candidate": "그래도 나는 일어나 계속 걸었다｡"
  },
  {
   "id": 30922,
   "key": "D1301ru.txt:95",
   "file": "D1301ru.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなところで挫けてたまるものか。",
   "ko_candidate": "이런 곳에서 좌절할 수는 없다｡"
  },
  {
   "id": 30923,
   "key": "D1301ru.txt:96",
   "file": "D1301ru.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だって俺が閲覧を許された本は、あの世界最高位の禁書――",
   "ko_candidate": "왜냐하면 내가 열람을 허가받은 책은､ 세계 최고위의 금서､"
  },
  {
   "id": 30924,
   "key": "D1301ru.txt:103",
   "file": "D1301ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処かで夜鷹が啼いた。",
   "ko_candidate": "아랍의 미친 시인이 저술한､ 그…"
  },
  {
   "id": 30925,
   "key": "D1301ru.txt:104",
   "file": "D1301ru.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして、出遭ったのだ――あの怪異に。",
   "ko_candidate": "어디선가 올빼미가 울었다｡"
  }
 ]
}