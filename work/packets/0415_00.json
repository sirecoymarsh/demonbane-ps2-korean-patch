   "file": "D0415.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だいじょうぶ。",
   "ko_candidate": "괜찮아｡ 괜찮아｡"
  },
  {
   "id": 5907,
   "key": "D0415.txt:35",
   "file": "D0415.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だいじょうぶ。",
   "ko_candidate": "무서울 건 없어｡"
  },
  {
   "id": 5908,
   "key": "D0415.txt:36",
   "file": "D0415.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "怖いことなんかない。",
   "ko_candidate": "아니､ 무서워도 괜찮아｡"
  },
  {
   "id": 5909,
   "key": "D0415.txt:44",
   "file": "D0415.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや、怖くたってかまわない。",
   "ko_candidate": "쿠로 오빠가 가르쳐줬으니까｡"
  },
  {
   "id": 5910,
   "key": "D0415.txt:45",
   "file": "D0415.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎お兄ちゃんが教えてくれたから。 みんな、みんな戦っているって教えてくれたから。",
   "ko_candidate": "모두가､ 모두가 싸우고 있다고 가르쳐줬으니까｡"
  },
  {
   "id": 5911,
   "key": "D0415.txt:49",
   "file": "D0415.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、私も戦おう。",
   "ko_candidate": "그러니까､ 나도 싸우자｡"
  },
  {
   "id": 5912,
   "key": "D0415.txt:50",
   "file": "D0415.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "逃げるのは、もう、おしまいだ。",
   "ko_candidate": "도망치는 건､ 이제､ 끝이야｡"
  },
  {
   "id": 5913,
   "key": "D0415.txt:53",
   "file": "D0415.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それに――あのときの九郎お兄ちゃんより、こわいものなんて、多分いないと思う。",
   "ko_candidate": "게다가――그때의 쿠로 오빠보다 무서운 건､ 아마 없을 거라고 생각해｡"
  },
  {
   "id": 5914,
   "key": "D0415.txt:56",
   "file": "D0415.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、だいじょうぶ。",
   "ko_candidate": "그러니까､ 괜찮아｡"
  },
  {
   "id": 5915,
   "key": "D0415.txt:57",
   "file": "D0415.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "勇気を出して――",
   "ko_candidate": "용기를 내서――"
  },
  {
