 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "ティベリウス": "티베리우스",
  "アル": "알"
 },
 "items": [
  {
   "id": 35066,
   "key": "D1311al.txt:248",
   "file": "D1311al.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪いが爆発する。",
   "ko_candidate": "저주가 폭발한다｡"
  },
  {
   "id": 35067,
   "key": "D1311al.txt:253",
   "file": "D1311al.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念が撒き散らす瘴気は、腐敗の呪詛と化して世界を凌辱した。",
   "ko_candidate": "원념이 뿌리는 장기는 부패의 저주가 되어 세계를 능욕했다｡"
  },
  {
   "id": 35068,
   "key": "D1311al.txt:254",
   "file": "D1311al.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間を吹き飛ばし、大地を穢し、街を朽ちさせる。",
   "ko_candidate": "공간을 날려버리고､ 대지를 더럽히고､ 거리를 썩게 한다｡"
  },
  {
   "id": 35069,
   "key": "D1311al.txt:256",
   "file": "D1311al.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腐敗の爆裂の直撃を受けているのは、 無論、デモンベインだ。",
   "ko_candidate": "부패의 폭렬을 정면으로 맞고 있는 것은 물론 데몬베인이다｡"
  },
  {
   "id": 35070,
   "key": "D1311al.txt:265",
   "file": "D1311al.txt",
   "line": 265,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あは……ひぃはははは……うほほほほほほほほほほほほっ！ 腐れ腐れ腐れ腐れ腐れ腐れ爛れろ！　腐って妖蛆の苗床となれ！」 「アタシの糧となれぇぇぇぇぇぇ――――ッ！」",
   "ko_candidate": "「아하……히히하하하……우호호호호호호호호호호호! 썩어라 썩어라 썩어라 썩어라 썩어라 썩어라 문드러져라! 썩어서 요충의 모판이 되어라! 내 양식이 되어라아아아아아――――!」"
  },
  {
   "id": 35071,
   "key": "D1311al.txt:272",
   "file": "D1311al.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの馬鹿笑いが、断末魔の爆音を割いて、聴こえて来た。",
   "ko_candidate": "티베리우스의 바보 웃음이 단말마의 폭음을 가르며 들려왔다｡"
  },
  {
   "id": 35072,
   "key": "D1311al.txt:273",
   "file": "D1311al.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウス……貴様……っ。",
   "ko_candidate": "티베리우스……이 자식……"
  },
  {
   "id": 35073,
   "key": "D1311al.txt:277",
   "file": "D1311al.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は――",
   "ko_candidate": "나는――"
  },
  {
   "id": 35074,
   "key": "D1311al.txt:277",
   "file": "D1311al.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この死ねない屍に、憐れみすら抱いていた。",
   "ko_candidate": "이 죽지 못하는 시체에 연민마저 느꼈다｡"
  },
  {
   "id": 35075,
   "key": "D1311al.txt:279",
   "file": "D1311al.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瘴気の爆風の中で俺は、呟いた。",
   "ko_candidate": "장기의 폭풍 속에서 나는 중얼거렸다｡"
  },
  {
   "id": 35076,
   "key": "D1311al.txt:287",
   "file": "D1311al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――足りない。",
   "ko_candidate": "――부족해｡"
  },
  {
   "id": 35077,
   "key": "D1311al.txt:289",
   "file": "D1311al.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな程度では、全然足りない。",
   "ko_candidate": "이 정도로는 전혀 부족해｡"
  },
  {
   "id": 35078,
   "key": "D1311al.txt:290",
   "file": "D1311al.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こんなもので、 デモンベインを斃せると思っているのか。",
   "ko_candidate": "이런 걸로 데몬베인을 쓰러뜨릴 수 있다고 생각하는 건가｡"
  },
  {
   "id": 35079,
   "key": "D1311al.txt:296",
   "file": "D1311al.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨霊が爆炎となってデモンベインを呑み込んだ。",
   "ko_candidate": "원령이 폭염이 되어 데몬베인을 삼켜버렸다｡"
  },
  {
   "id": 35080,
   "key": "D1311al.txt:297",
   "file": "D1311al.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てが闇黒に包まれる。",
   "ko_candidate": "모든 것이 암흑에 휩싸인다｡"
  },
  {
   "id": 35081,
   "key": "D1311al.txt:301",
   "file": "D1311al.txt",
   "line": 301,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お――ほほほほほほほほほほほほほほほほほっ！」",
   "ko_candidate": "「오―호호호호호호호호호호호호호호호호!」"
  },
  {
   "id": 35082,
   "key": "D1311al.txt:304",
   "file": "D1311al.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝利を確信したティベリウスの、何処か安堵に満ちた、哄笑を聴いた。",
   "ko_candidate": "승리를 확신한 티베리우스의､ 어딘가 안도감이 가득한､ 폭소를 들었다｡"
  },
  {
   "id": 35083,
   "key": "D1311al.txt:306",
   "file": "D1311al.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憐れだな、お前。",
   "ko_candidate": "가련하구나､ 너｡"
  },
  {
   "id": 35084,
   "key": "D1311al.txt:307",
   "file": "D1311al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当に憐れを誘う奴だよ。",
   "ko_candidate": "정말 동정을 자아내는 녀석이야｡"
  },
  {
   "id": 35085,
   "key": "D1311al.txt:310",
   "file": "D1311al.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――衝撃が、襲う。",
   "ko_candidate": "――충격이､ 덮친다｡"
  },
  {
   "id": 35086,
   "key": "D1311al.txt:320",
   "file": "D1311al.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の只中。",
   "ko_candidate": "폭발의 한가운데｡"
  },
  {
   "id": 35087,
   "key": "D1311al.txt:321",
   "file": "D1311al.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今まさに、デモンベインは爆発に苛まれている。",
   "ko_candidate": "지금 바로､ 데몬베인은 폭발에 시달리고 있다｡"
  },
  {
   "id": 35088,
   "key": "D1311al.txt:323",
   "file": "D1311al.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "憤怒の爆風を叩きつけられ、 怨嗟の爆炎に灼かれている。",
   "ko_candidate": "분노의 폭풍을 맞아､ 원한의 폭염에 그을리고 있다｡"
  },
  {
   "id": 35089,
   "key": "D1311al.txt:326",
   "file": "D1311al.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それほどの蹂躙に曝されても――デモンベインは無傷だった。",
   "ko_candidate": "하지만､ 그 정도의 유린을 당해도――데몬베인은 무상했다｡"
  },
  {
   "id": 35090,
   "key": "D1311al.txt:327",
   "file": "D1311al.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを護る五芒星形の輝きは、少しも衰えていなかった。",
   "ko_candidate": "데몬베인을 지키는 오방성 모양의 빛은､ 조금도 쇠약해지지 않았다｡"
  },
  {
   "id": 35091,
   "key": "D1311al.txt:329",
   "file": "D1311al.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この程度か。",
   "ko_candidate": "이 정도인가｡"
  },
  {
   "id": 35092,
   "key": "D1311al.txt:329",
   "file": "D1311al.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "他人を貪って力と永遠を手に入れた、お前の力は、だけどこんな程度か。",
   "ko_candidate": "타인을 탐해 힘과 영원을 손에 넣은､ 네 힘은､ 하지만 이런 정도인가｡"
  },
  {
   "id": 35093,
   "key": "D1311al.txt:330",
   "file": "D1311al.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなくだらない、脆弱な力のために、多くの人間を犠牲にしたのか。",
   "ko_candidate": "이런 시시한､ 취약한 힘을 위해､ 많은 인간을 희생시킨 건가｡"
  },
  {
   "id": 35094,
   "key": "D1311al.txt:335",
   "file": "D1311al.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう良いよ。",
   "ko_candidate": "이제 됐어｡"
  },
  {
   "id": 35095,
   "key": "D1311al.txt:336",
   "file": "D1311al.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "疲れただろ、お前？",
   "ko_candidate": "지쳤겠지､ 너?"
  },
  {
   "id": 35096,
   "key": "D1311al.txt:338",
   "file": "D1311al.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もう終わりにしてやるよ。",
   "ko_candidate": "이제 끝내줄게｡"
  },
  {
   "id": 35097,
   "key": "D1311al.txt:339",
   "file": "D1311al.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺がお前を、否定してやる。",
   "ko_candidate": "내가 너를､ 부정해주지｡"
  },
  {
   "id": 35098,
   "key": "D1311al.txt:341",
   "file": "D1311al.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうしてやろう？",
   "ko_candidate": "어떻게 해줄까?"
  },
  {
   "id": 35099,
   "key": "D1311al.txt:342",
   "file": "D1311al.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやって、死なないお前を滅ぼしてやろう？",
   "ko_candidate": "어떻게､ 죽지 않는 너를 멸망시켜줄까?"
  },
  {
   "id": 35100,
   "key": "D1311al.txt:344",
   "file": "D1311al.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "安心しろ。",
   "ko_candidate": "안심해｡"
  },
  {
   "id": 35101,
   "key": "D1311al.txt:345",
   "file": "D1311al.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手段は無限にある。",
   "ko_candidate": "수단은 무한히 있어｡"
  },
  {
   "id": 35102,
   "key": "D1311al.txt:346",
   "file": "D1311al.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "喩えば……喩えば、だ。",
   "ko_candidate": "예를 들면……예를 들면､ 말이야｡"
  },
  {
   "id": 35103,
   "key": "D1311al.txt:351",
   "file": "D1311al.txt",
   "line": 351,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 35104,
   "key": "D1311al.txt:354",
   "file": "D1311al.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然、アルの躰が電撃に撃たれたように跳ね上がった。",
   "ko_candidate": "갑자기､ 알의 몸이 전격에 맞은 것처럼 펄쩍 뛰었다｡"
  },
  {
   "id": 35105,
   "key": "D1311al.txt:355",
   "file": "D1311al.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何が起こったのかは、分からない。",
   "ko_candidate": "무슨 일이 일어났는지는､ 모르겠다｡"
  }
 ]
}