  },
  {
   "id": 29961,
   "key": "D1213le.txt:166",
   "file": "D1213le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り返る。",
   "ko_candidate": "돌아본다｡"
  },
  {
   "id": 29962,
   "key": "D1213le.txt:168",
   "file": "D1213le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのまま、しばし静止。",
   "ko_candidate": "그대로 잠시 정지｡"
  },
  {
   "id": 29963,
   "key": "D1213le.txt:173",
   "file": "D1213le.txt",
   "line": 173,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「キサッマ……ァァァ！」",
   "ko_candidate": "「이 자식……아아아!」"
  },
  {
   "id": 29964,
   "key": "D1213le.txt:181",
   "file": "D1213le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斬り裂かれる臓腑の鞭。",
   "ko_candidate": "장기의 채찍에 균열이 생긴다｡"
  },
  {
   "id": 29965,
   "key": "D1213le.txt:182",
   "file": "D1213le.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "仮面の奥に隠れた眸が、隠し切れない憎悪を宿していた。",
   "ko_candidate": "더러운 피를 뿜으며 내장이 바닥에 쏟아진다｡ 피웅덩이에 잠긴 썩은 살점｡ 마치 하수구 같다｡"
  },
  {
   "id": 29966,
   "key": "D1213le.txt:189",
   "file": "D1213le.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "バルザイの偃月刀を地面に突き刺す。",
   "ko_candidate": "가면 뒤에 숨은 눈동자가 감추지 못한 증오를 담고 있었다｡"
  },
  {
   "id": 29967,
   "key": "D1213le.txt:192",
   "file": "D1213le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クトゥグアとイタクァの弾丸を、わざとらしくゆっくり、かったるそうに取り替える。",
   "ko_candidate": "바르자이의 언월도를 땅에 꽂는다｡ 크투가와 이타콰의 탄환을 일부러 천천히､ 귀찮은 듯이 교체한다｡"
  },
  {
   "id": 29968,
   "key": "D1213le.txt:197",
   "file": "D1213le.txt",
   "line": 197,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアアアアアアアアアア！」",
   "ko_candidate": "「아아아아아아아아아아!」"
  },
  {
   "id": 29969,
   "key": "D1213le.txt:214",
   "file": "D1213le.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアの吐き出す５０ＡＥが、ティベリウスの頭を柘榴のように弾けさせる。下顎から上の無い屍体が、仰向けに斃れる。",
   "ko_candidate": "크투가가 뱉어내는 50AE가 티베리우스의 머리를 석류처럼 터뜨린다｡ 아래턱부터 위가 없는 시체가 뒤로 쓰러진다｡"
  },
  {
   "id": 29970,
   "key": "D1213le.txt:220",
   "file": "D1213le.txt",
   "line": 220,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「吠えるな。息が臭ぇんだよ」",
   "ko_candidate": "「짖지 마｡ 숨이 냄새난다고」"
  },
  {
   "id": 29971,
   "key": "D1213le.txt:222",
   "file": "D1213le.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、これでこいつを殺せるワケがない。",
   "ko_candidate": "물론 이걸로 이놈을 죽일 수는 없다｡"
  },
  {
   "id": 29972,
   "key": "D1213le.txt:226",
   "file": "D1213le.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斃れたティベリウスに容赦なく弾丸の雨を降らせる。",
   "ko_candidate": "쓰러진 티베리우스에게 용서 없이 탄환의 비를 퍼붓는다｡"
  },
  {
   "id": 29973,
   "key": "D1213le.txt:227",
   "file": "D1213le.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声と共に血が飛び散り、肉片が千切れ飛ぶ。",
   "ko_candidate": "총성과 함께 피가 튀고 살점이 찢겨 날아간다｡"
  },
  {
   "id": 29974,
   "key": "D1213le.txt:229",
   "file": "D1213le.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの躰が激しい痙攣を起こしたみたいに飛び跳ねる。",
   "ko_candidate": "티베리우스의 몸이 격렬한 경련을 일으킨 것처럼 펄쩍 뛴다｡"
  },
  {
   "id": 29975,
   "key": "D1213le.txt:231",
   "file": "D1213le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "単なる肉片になっても、俺は銃撃を止めない。",
   "ko_candidate": "단순한 살점이 되어도 나는 총격을 멈추지 않는다｡"
  },
  {
   "id": 29976,
   "key": "D1213le.txt:233",
   "file": "D1213le.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸はアルがせっせと、忙しげに取り替えてくれる。",
   "ko_candidate": "탄환은 알이 부지런히､ 바쁘게 교체해 준다｡"
  },
  {
   "id": 29977,
   "key": "D1213le.txt:240",
   "file": "D1213le.txt",
   "line": 240,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほら……今のうちだ！　俺が奴を足止めしている間に！ Ｂ２を回って、直通エレベーターから階下へ行け！　あそこはまだ安全だ！」",
   "ko_candidate": "「자…… 지금이다! 내가 놈을 붙잡고 있는 동안에! B2를 돌아 직통 엘리베이터로 아래층으로 가! 거기는 아직 안전해!」"
  },
  {
   "id": 29978,
   "key": "D1213le.txt:246",
   "file": "D1213le.txt",
   "line": 246,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「で、でも足が震えて……」",
   "ko_candidate": "「하､ 하지만 다리가 떨려서……」"
  },
  {
   "id": 29979,
   "key": "D1213le.txt:250",
   "file": "D1213le.txt",
   "line": 250,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「立て！　立って走れ！」",
   "ko_candidate": "「일어나! 일어나서 뛰어!」"
  },
  {
   "id": 29980,
   "key": "D1213le.txt:255",
   "file": "D1213le.txt",
   "line": 255,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅ……！」",
   "ko_candidate": "「크윽……!」"
  },
  {
   "id": 29981,
   "key": "D1213le.txt:258",
   "file": "D1213le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まず真っ先にジョージが跳ね起きる。",
   "ko_candidate": "먼저 죠지가 벌떡 일어난다｡"
  },
  {
   "id": 29982,
   "key": "D1213le.txt:259",
   "file": "D1213le.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コリンを蹴飛ばして気合を入れさせ、アリスンの腕を引っ張った。",
   "ko_candidate": "콜린을 발로 차서 정신 차리게 하고 앨리슨의 팔을 잡아당겼다｡"
  },
  {
   "id": 29983,
   "key": "D1213le.txt:260",
   "file": "D1213le.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それぞれ、何とか自力で起き上がる。",
   "ko_candidate": "각자 어떻게든 스스로 일어선다｡"
  },
  {
   "id": 29984,
   "key": "D1213le.txt:265",
   "file": "D1213le.txt",
   "line": 265,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くぅ……！ ほら！　いそげっ！」",
   "ko_candidate": "「크윽……! 자! 서둘러!」"
  },
  {
   "id": 29985,
   "key": "D1213le.txt:269",
   "file": "D1213le.txt",
   "line": 269,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほら！　ライカさんも早く！」",
   "ko_candidate": "「자! 라이카 씨도 빨리!」"
  },
  {
   "id": 29986,
   "key": "D1213le.txt:274",
   "file": "D1213le.txt",
   "line": 274,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いえ……私はまだ戦える……！」",
   "ko_candidate": "「아니요…… 저는 아직 싸울 수 있어요……!」"
  },
  {
   "id": 29987,
   "key": "D1213le.txt:277",
   "file": "D1213le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう言うライカさんだが、全身ボロボロで、立ち上がるのもやっとだった。",
   "ko_candidate": "그렇게 말하는 라이카 씨지만 온몸이 만신창이라 겨우 일어설 수 있을 정도였다｡"
  },
  {
   "id": 29988,
   "key": "D1213le.txt:280",
   "file": "D1213le.txt",
   "line": 280,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「無茶言うな！　とりあえずこの場は俺に任せてだなぁ……」",
   "ko_candidate": "「무리하지 마! 일단 이 상황은 나한테 맡기고 말이지……」"
  },
  {
   "id": 29989,
   "key": "D1213le.txt:282",
   "file": "D1213le.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの右腕がビーム砲に変形する。",
   "ko_candidate": "라이카 씨의 오른팔이 빔포로 변형된다｡"
  },
  {
   "id": 29990,
   "key": "D1213le.txt:285",
   "file": "D1213le.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砲口をこっちに向けられたことに驚く間もなく、何かが天井を突き破って、避難所の内部へと躍り込んだ。",
   "ko_candidate": "포구를 이쪽으로 향한 것에 놀랄 틈도 없이 무언가가 천장을 뚫고 대피소 내부로 뛰어들었다｡"
  },
  {
   "id": 29991,
   "key": "D1213le.txt:286",
   "file": "D1213le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは兇風を纏う影。",
   "ko_candidate": "그것은 흉풍을 두른 그림자｡"
  },
  {
   "id": 29992,
   "key": "D1213le.txt:287",
   "file": "D1213le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "明らかに俺を狙って、突撃してきた。",
   "ko_candidate": "분명히 나를 노리고 돌진해 왔다｡"
  },
  {
   "id": 29993,
   "key": "D1213le.txt:290",
   "file": "D1213le.txt",
   "line": 290,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だっ!?」",
   "ko_candidate": "「뭐지!?」"
  },
  {
   "id": 29994,
   "key": "D1213le.txt:295",
   "file": "D1213le.txt",
   "line": 295,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「退いて、九郎ちゃん！」",
   "ko_candidate": "「물러나､ 쿠로짱!」"
  }
 ]
}