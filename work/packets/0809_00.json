 "items": [
  {
   "id": 14340,
   "key": "D0809al.txt:14",
   "file": "D0809al.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――何が原因で、あなた方の間に戦いや争いが起こるのでしょう。",
   "ko_candidate": "――무엇이 원인이 되어､ 당신들 사이에 싸움과 분쟁이 일어나는 것일까요｡"
  },
  {
   "id": 14341,
   "key": "D0809al.txt:15",
   "file": "D0809al.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あなた方の躰の中で、争う欲望が原因ではありませんか。",
   "ko_candidate": "당신들의 몸 안에서､ 다투는 욕망이 원인이 아닙니까｡"
  },
  {
   "id": 14342,
   "key": "D0809al.txt:35",
   "file": "D0809al.txt",
   "line": 35,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！」",
   "ko_candidate": "「쿠로!」"
  },
  {
   "id": 14343,
   "key": "D0809al.txt:40",
   "file": "D0809al.txt",
   "line": 40,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぅぅぅぅ――――っ！」",
   "ko_candidate": "「그으으으으――――읏!」"
  },
  {
   "id": 14344,
   "key": "D0809al.txt:44",
   "file": "D0809al.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆発に吹き飛ばされる寸前、俺はマギウス・スタイルとなり、エンネアを抱きかかえて跳んだ。窓ガラスを突き破り外に出る。",
   "ko_candidate": "폭발에 날아갈 찰나､ 나는 마기우스 스타일이 되어､ 엔네아를 끌어안고､ 뛰었다｡ 창문 유리를 깨고､ 밖으로 나온다｡"
  },
  {
   "id": 14345,
   "key": "D0809al.txt:46",
   "file": "D0809al.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "衝撃が大気を引き千切り、蹂躙しながら迫る。",
   "ko_candidate": "충격이 대기를 찢어내고､ 유린하며 다가온다｡ 뒤쫓아오는 폭풍과 폭염에 등이 타오른다｡"
  },
  {
   "id": 14346,
   "key": "D0809al.txt:47",
   "file": "D0809al.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "追ってくる爆風と爆炎に背中を灼かれる。",
   "ko_candidate": "마기우스 윙으로 온몸을 감싸고､ 땅을 굴렀다｡ 폭음이 귀를 찢는다｡"
  },
  {
   "id": 14347,
   "key": "D0809al.txt:59",
   "file": "D0809al.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マギウス・ウィングで全身を包み込み、地面を転がった。爆音が耳を劈く。熱い空気がビシバシ震えていた。",
   "ko_candidate": "뜨거운 공기가 파르르 떨리고 있었다｡ 「으으으으으읏! 괜찮아､ 엔네아!?」"
  },
  {
   "id": 14348,
   "key": "D0809al.txt:65",
   "file": "D0809al.txt",
   "line": 65,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「～～～～～ッッッ！　大丈夫か、エンネア!?」",
   "ko_candidate": "「……응」 검은 날개를 펴고､ 일어선다｡"
  },
  {
   "id": 14349,
   "key": "D0809al.txt:72",
   "file": "D0809al.txt",
   "line": 72,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……うん」 黒翼を開き、起き上がる。",
   "ko_candidate": "{SE_PLAY(1,\"툉꼿キック\",0,100,false);}"
  },
  {
   "id": 14350,
   "key": "D0809al.txt:77",
   "file": "D0809al.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こんっ。",
   "ko_candidate": "콩｡"
  },
  {
   "id": 14351,
   "key": "D0809al.txt:78",
   "file": "D0809al.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空から降ってきた何かが、頭の上に落ちてきた。",
   "ko_candidate": "하늘에서 떨어진 무언가가､ 머리 위에 떨어졌다｡"
  },
  {
   "id": 14352,
   "key": "D0809al.txt:83",
   "file": "D0809al.txt",
   "line": 83,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………？」",
   "ko_candidate": "「…………?」 퍽｡"
  },
  {
   "id": 14353,
   "key": "D0809al.txt:88",
   "file": "D0809al.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ぼてんっ。 弾かれて、地面を転がる。",
   "ko_candidate": "{SE_PLAY(1,\"物音\",0,100,false);}"
  },
  {
   "id": 14354,
   "key": "D0809al.txt:90",
   "file": "D0809al.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ソレが何であるかを理解するのに、しばらくかかった。",
   "ko_candidate": "튕겨나가､ 땅을 굴러간다｡ 그것이 무엇인지 이해하는 데､ 잠시 시간이 걸렸다｡"
  },
  {
   "id": 14355,
   "key": "D0809al.txt:95",
   "file": "D0809al.txt",
   "line": 95,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――――――――ッ!?」",
   "ko_candidate": "「――――――――――읏!?」 사람의､ 팔｡"
  },
  {
   "id": 14356,
   "key": "D0809al.txt:99",
   "file": "D0809al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――何だよ、これ？",
   "ko_candidate": "가게 메뉴를 손에 든 채로､ 웨이트리스의 팔이었다｡"
  },
  {
   "id": 14357,
   "key": "D0809al.txt:102",
   "file": "D0809al.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人間の、腕。",
   "ko_candidate": "――뭐야､ 이거?"
  },
  {
   "id": 14358,
   "key": "D0809al.txt:103",
   "file": "D0809al.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "店のメニューを手に持ったままの、腕だ。",
   "ko_candidate": "왜､ 이런 게 굴러다니는 거야? 팔꿈치부터 아래는……어떻게 된 거야?"
  },
  {
   "id": 14359,
   "key": "D0809al.txt:113",
   "file": "D0809al.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "街は悲鳴と、炎が轟々と燃える音で満たされていた。俺たちがさっきまでいた喫茶店は木っ端微塵に吹き飛び、爆炎が煙を上げながら渦を巻き天に昇っている。",
   "ko_candidate": "거리는 비명과､ 불길이 요란하게 타오르는 소리로 가득 찼다｡ 우리가 방금 전까지 있던 카페는 산산조각 나 날아가고､ 폭염이 연기를 올리며 소용돌이치며､ 하늘로 올라가고 있다｡"
  },
  {
   "id": 14360,
   "key": "D0809al.txt:116",
   "file": "D0809al.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎の向こう、揺らめく２つのシルエットがあった。",
   "ko_candidate": "폭염 너머､ 흔들리는 두 개의 실루엣이 있었다｡"
  },
  {
   "id": 14361,
   "key": "D0809al.txt:117",
   "file": "D0809al.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大男の影と、小さな少年の影。さっきの２人組だ。",
   "ko_candidate": "큰 남자의 그림자와､ 작은 소년의 그림자｡ 아까 그 두 사람이다｡"
  },
  {
   "id": 14362,
   "key": "D0809al.txt:119",
   "file": "D0809al.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆっくりと炎の中から姿を現す。",
   "ko_candidate": "천천히 불길 속에서 모습을 드러낸다｡"
  },
  {
   "id": 14363,
   "key": "D0809al.txt:120",
   "file": "D0809al.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凶悪な笑みをその口元に張りつかせていた。",
   "ko_candidate": "흉악한 미소가､ 그 입가에 붙어 있었다｡"
  },
  {
   "id": 14364,
   "key": "D0809al.txt:125",
   "file": "D0809al.txt",
   "line": 125,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何なんだよ……何なんだよ、てめえらァァァッ!?」",
   "ko_candidate": "「뭐야……뭐야､ 너희들아아아앗!?」 「흥……」"
  },
  {
   "id": 14365,
   "key": "D0809al.txt:133",
   "file": "D0809al.txt",
   "line": 133,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふんっ……」",
   "ko_candidate": "「히야핫핫핫……」"
  },
  {
   "id": 14366,
   "key": "D0809al.txt:144",
   "file": "D0809al.txt",
   "line": 144,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒャハッハッハッ……」 連中は答えない。",
   "ko_candidate": "놈들은 대답하지 않는다｡"
  },
  {
   "id": 14367,
   "key": "D0809al.txt:151",
   "file": "D0809al.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘲りのこもった笑い声を上げるだけだ。",
   "ko_candidate": "조롱이 담긴 웃음소리만 올릴 뿐이다｡"
  },
  {
   "id": 14368,
   "key": "D0809al.txt:152",
   "file": "D0809al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "野郎……ッ！",
   "ko_candidate": "이 자식들……읏!"
  },
  {
   "id": 14369,
   "key": "D0809al.txt:157",
   "file": "D0809al.txt",
   "line": 157,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「早まるな！　落ち着け、九郎！」",
   "ko_candidate": "「서두르지 마! 진정해､ 쿠로!」"
  },
  {
   "id": 14370,
   "key": "D0809al.txt:162",
   "file": "D0809al.txt",
   "line": 162,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「큿……!」"
  },
  {
   "id": 14371,
   "key": "D0809al.txt:164",
   "file": "D0809al.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駆け出しそうになるのを、何とか抑えた。",
   "ko_candidate": "달려나가려는 것을､ 어떻게든 억눌렀다｡"
  },
  {
   "id": 14372,
   "key": "D0809al.txt:165",
   "file": "D0809al.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "分かっている……理性を失ったまま突っ込んで勝てる相手じゃない。",
   "ko_candidate": "알고 있어……이성을 잃은 채 돌진해서､ 이길 수 있는 상대가 아니다｡"
  },
  {
   "id": 14373,
   "key": "D0809al.txt:167",
   "file": "D0809al.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "このプレッシャー……そして『魔力』！",
   "ko_candidate": "이 압박감……그리고 『마력』!"
  },
  {
   "id": 14374,
   "key": "D0809al.txt:168",
   "file": "D0809al.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こいつら――！",
   "ko_candidate": "이놈들――!"
  },
  {
   "id": 14375,
   "key": "D0809al.txt:174",
   "file": "D0809al.txt",
   "line": 174,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒャハッ……『アル・アジフ』と大十字九郎のおまけ付きじゃねえの。 ボクらってラッキー？」",
   "ko_candidate": "「히야핫……『알 아지프』와 다이쥬지 쿠로의 덤이라니｡ 우리 운이 좋은 걸?」 키득거리는 꼬마를 타이르듯이､ 큰 남자는 조용히 말했다｡"
  },
  {
   "id": 14376,
   "key": "D0809al.txt:180",
   "file": "D0809al.txt",
   "line": 180,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「浮かれ過ぎダ。あんま油断するジャない」",
   "ko_candidate": "「들뜨지 마｡ 너무 방심하지 마」"
  },
  {
   "id": 14377,
   "key": "D0809al.txt:186",
   "file": "D0809al.txt",
   "line": 186,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ケッ……何ビビってんのよ。デカブツ」",
   "ko_candidate": "「켓……뭘 겁먹고 있어｡ 덩치」"
  },
  {
   "id": 14378,
   "key": "D0809al.txt:195",
   "file": "D0809al.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガキの方が大男より前に出た。ポケットに突っ込んでいた手を外に出し、ダラダラと振っている。",
   "ko_candidate": "꼬마 쪽이 큰 남자보다 앞으로 나왔다｡ 주머니에 넣고 있던 손을 밖으로 꺼내､ 흐늘흐늘 흔들고 있다｡"
  },
  {
   "id": 14379,
   "key": "D0809al.txt:197",
   "file": "D0809al.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――危機感が脳髄を焼いた。",
   "ko_candidate": "――위기감이 뇌수를 태웠다｡"
  }
 ]
