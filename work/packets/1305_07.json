  "rate": 0.92
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "大十字": "다이쥬지"
 },
 "items": [
  {
   "id": 32486,
   "key": "D1305le.txt:471",
   "file": "D1305le.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不幸中の幸い……と言って良いものか。",
   "ko_candidate": "불행 중 다행… 이라고 해야 할까｡"
  },
  {
   "id": 32487,
   "key": "D1305le.txt:475",
   "file": "D1305le.txt",
   "line": 475,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから……攻撃には、アタシの『妖蛆の秘密』の武装で代用するしかないってぇワケね。それはそれで愉快であるけど……」",
   "ko_candidate": "「그래서… 공격은 아타시의 『벌레의 신비』의 무장으로 대용할 수밖에 없다는 거지｡ 그것도 그것대로 유쾌하긴 하지만…」"
  },
  {
   "id": 32488,
   "key": "D1305le.txt:483",
   "file": "D1305le.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突如、デモンベインから一気に噴き出す思念の嵐。",
   "ko_candidate": "돌연 데몬베인에서 일시에 뿜어져 나오는 사념의 폭풍｡"
  },
  {
   "id": 32489,
   "key": "D1305le.txt:484",
   "file": "D1305le.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨嗟。憎悪。無念。嫉妬。慟哭。憤怒。",
   "ko_candidate": "원한｡ 증오｡ 무념｡ 질투｡ 통곡｡ 분노｡"
  },
  {
   "id": 32490,
   "key": "D1305le.txt:485",
   "file": "D1305le.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒れ狂い、吹き荒み、破滅を孕む質量を得て、俺の魂を、肉体を圧迫する。",
   "ko_candidate": "거칠게 날뛰고 휘몰아치며 파멸을 품은 질량을 얻어 내 영혼을､ 육체를 압박한다｡"
  },
  {
   "id": 32491,
   "key": "D1305le.txt:487",
   "file": "D1305le.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念の波動に押され、十数メートル後ろに吹き飛ばされた。",
   "ko_candidate": "원념의 파동에 밀려 십여 미터 뒤로 날아갔다｡"
  },
  {
   "id": 32492,
   "key": "D1305le.txt:488",
   "file": "D1305le.txt",
   "line": 488,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『妖蛆の秘密』の怨霊兵器だ……！",
   "ko_candidate": "『벌레의 신비』의 원령 무기다…!"
  },
  {
   "id": 32493,
   "key": "D1305le.txt:492",
   "file": "D1305le.txt",
   "line": 492,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「正義のロボットが、こういう武器を使ってる姿って、けっこーショックよねえ……」",
   "ko_candidate": "「정의의 로봇이 이런 무기를 쓰는 모습이라니､ 꽤나 충격적이지…」"
  },
  {
   "id": 32494,
   "key": "D1305le.txt:496",
   "file": "D1305le.txt",
   "line": 496,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……くっ」",
   "ko_candidate": "「…큭」"
  },
  {
   "id": 32495,
   "key": "D1305ru.txt:7",
   "file": "D1305ru.txt",
   "line": 7,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "粘液にまみれた山羊の貌が、嘲笑を浮かべる。",
   "ko_candidate": "점액으로 뒤덮인 염소의 얼굴이 조소를 띠고 있다｡"
  },
  {
   "id": 32496,
   "key": "D1305ru.txt:8",
   "file": "D1305ru.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溶けかけの躰をわななかせて、嗤う。",
   "ko_candidate": "녹아내리는 몸을 떨면서 웃는다｡"
  },
  {
   "id": 32497,
   "key": "D1305ru.txt:14",
   "file": "D1305ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深呼吸を一回。",
   "ko_candidate": "심호흡을 한 번｡"
  },
  {
   "id": 32498,
   "key": "D1305ru.txt:15",
   "file": "D1305ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吸って、吐いて、吸って。",
   "ko_candidate": "들이쉬고､ 내쉬고､ 들이쉬고｡"
  },
  {
   "id": 32499,
   "key": "D1305ru.txt:16",
   "file": "D1305ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "止める。",
   "ko_candidate": "멈춘다｡"
  },
  {
   "id": 32500,
   "key": "D1305ru.txt:18",
   "file": "D1305ru.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "裂帛の気合と共に、肺にため込んだ息を吐き出す。",
   "ko_candidate": "기합과 함께 폐에 모아둔 숨을 내뱉는다｡"
  },
  {
   "id": 32501,
   "key": "D1305ru.txt:22",
   "file": "D1305ru.txt",
   "line": 22,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヤアアァァ！」",
   "ko_candidate": "「야아아아아!」"
  },
  {
   "id": 32502,
   "key": "D1305ru.txt:31",
   "file": "D1305ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剣を振り上げ、地を蹴った。",
   "ko_candidate": "검을 들어 올리고 땅을 박차고 나아갔다｡"
  },
  {
   "id": 32503,
   "key": "D1305ru.txt:33",
   "file": "D1305ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私の動きに煽られ、宙を漂う紙片が、渦を巻いて、",
   "ko_candidate": "내 움직임에 휘말려 공중을 떠도는 종이 조각이 소용돌이치며､"
  },
  {
   "id": 32504,
   "key": "D1305ru.txt:34",
   "file": "D1305ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふわりと舞い上がる。",
   "ko_candidate": "살랑살랑 날아오른다｡"
  },
  {
   "id": 32505,
   "key": "D1305ru.txt:36",
   "file": "D1305ru.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駈ける。",
   "ko_candidate": "달린다｡"
  },
  {
   "id": 32506,
   "key": "D1305ru.txt:37",
   "file": "D1305ru.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この怪物を、大十字さんを侵す恐怖を斃して、彼を救い出す！",
   "ko_candidate": "이 괴물을､ 다이쥬지 씨를 침범하는 공포를 쓰러뜨리고､ 그를 구해내겠어!"
  },
  {
   "id": 32507,
   "key": "D1305ru.txt:39",
   "file": "D1305ru.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間合いに入った。",
   "ko_candidate": "간격에 들어섰다｡"
  },
  {
   "id": 32508,
   "key": "D1305ru.txt:40",
   "file": "D1305ru.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私は偃月刀を振り下ろして――",
   "ko_candidate": "나는 언월도를 내리치려고 했다――"
  },
  {
   "id": 32509,
   "key": "D1305ru.txt:42",
   "file": "D1305ru.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界の隅で何かが光った。",
   "ko_candidate": "시야 구석에서 무언가가 빛났다｡"
  },
  {
   "id": 32510,
   "key": "D1305ru.txt:43",
   "file": "D1305ru.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "危ないと思っても、もう動作は止まらない。",
   "ko_candidate": "위험하다고 생각했지만､ 이미 동작은 멈출 수 없다｡"
  },
  {
   "id": 32511,
   "key": "D1305ru.txt:44",
   "file": "D1305ru.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "祈るような想いで、この一撃に託す。",
   "ko_candidate": "기도하는 마음으로 이 일격에 모든 것을 건다｡"
  },
  {
   "id": 32512,
   "key": "D1305ru.txt:48",
   "file": "D1305ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "甲高い、金属同士がぶつかり合う音が、耳を劈いた。",
   "ko_candidate": "날카로운､ 금속끼리 부딪히는 소리가 귀를 찢었다｡"
  },
  {
   "id": 32513,
   "key": "D1305ru.txt:52",
   "file": "D1305ru.txt",
   "line": 52,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 32514,
   "key": "D1305ru.txt:55",
   "file": "D1305ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り下ろした私の偃月刀を受け止める、もう一本の偃月刀。",
   "ko_candidate": "내리친 내 언월도를 받아내는､ 또 다른 언월도｡"
  },
  {
   "id": 32515,
   "key": "D1305ru.txt:57",
   "file": "D1305ru.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溶けかけたこの怪物は、粘液の中から新しい腕を生やしていた。",
   "ko_candidate": "녹아내리던 이 괴물은 점액 속에서 새로운 팔을 자라나게 했다｡"
  },
  {
   "id": 32516,
   "key": "D1305ru.txt:59",
   "file": "D1305ru.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その手に握られた、バルザイの偃月刀。",
   "ko_candidate": "그 손에 쥐어진 바르자이의 언월도｡"
  },
  {
   "id": 32517,
   "key": "D1305ru.txt:63",
   "file": "D1305ru.txt",
   "line": 63,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「큿……!」"
  },
  {
   "id": 32518,
   "key": "D1305ru.txt:66",
   "file": "D1305ru.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれた偃月刀の軌道を変え、肩口を狙う。",
   "ko_candidate": "튕겨나간 언월도의 궤도를 바꿔 어깨를 노린다｡"
  },
  {
   "id": 32519,
   "key": "D1305ru.txt:70",
   "file": "D1305ru.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怪物の偃月刀も素早く動き、またもや私の一撃を弾いた。",
   "ko_candidate": "괴물의 언월도도 재빨리 움직여 또다시 내 일격을 튕겨냈다｡"
  },
  {
   "id": 32520,
   "key": "D1305ru.txt:72",
   "file": "D1305ru.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛び散る火花。",
   "ko_candidate": "튀어 오르는 불꽃｡"
  },
  {
   "id": 32521,
   "key": "D1305ru.txt:76",
   "file": "D1305ru.txt",
   "line": 76,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こ、このぉ……！」",
   "ko_candidate": "「이､ 이놈……!」"
  },
  {
   "id": 32522,
   "key": "D1305ru.txt:80",
   "file": "D1305ru.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここで退くわけにいかない。",
   "ko_candidate": "여기서 물러설 수는 없다｡"
  },
  {
   "id": 32523,
   "key": "D1305ru.txt:81",
   "file": "D1305ru.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "畳みかけるように攻撃を繰り返す。",
   "ko_candidate": "연이어 공격을 퍼붓는다｡"
  },
  {
   "id": 32524,
   "key": "D1305ru.txt:84",
   "file": "D1305ru.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胴。逆胴。面。突き。あるいは相手の刀を叩き落すため、小手も狙う。",
   "ko_candidate": "몸통｡ 역몸통｡ 머리｡ 찌르기｡ 혹은 상대의 칼을 떨어뜨리기 위해 손목도 노린다｡"
  },
  {
   "id": 32525,
   "key": "D1305ru.txt:85",
   "file": "D1305ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "面胴小手小手面胴小手面々面小手面小手胴突き面々胴……",
   "ko_candidate": "머리몸통손목손목머리몸통손목머리머리머리손목머리손목몸통찌르기머리머리몸통……"
  }
 ]
}