  {
   "id": 30666,
   "key": "D1301al.txt:378",
   "file": "D1301al.txt",
   "line": 378,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「く……ぅぅッッ」",
   "ko_candidate": "「크……으으!」"
