 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "エルザ": "엘자",
  "姫さん": "공주님",
  "大十字": "다이쥬지",
  "マギウス・ウィング": "마기우스 윙",
  "ロードビヤーキー": "로드 비야키",
  "アンチクロス": "안티크로스",
  "魔力": "마력"
 },
 "items": [
  {
   "id": 35426,
   "key": "D1311ru.txt:432",
   "file": "D1311ru.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "わざわざデモンベインの方から、やって来てくれたのだ。",
   "ko_candidate": "일부러 데몬베인 쪽에서､ 와 준 거다｡"
  },
  {
   "id": 35427,
   "key": "D1311ru.txt:434",
   "file": "D1311ru.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今は戦わなければ。悩むのはその後からで充分だ。",
   "ko_candidate": "지금은 싸워야 한다｡ 고민하는 건 그 후에 해도 충분하다｡"
  },
  {
   "id": 35428,
   "key": "D1311ru.txt:438",
   "file": "D1311ru.txt",
   "line": 438,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良し、征こう！　エルザ！　姫さんたちを安全な場所まで頼む！」",
   "ko_candidate": "「좋아､ 가자! 엘자! 공주님들을 안전한 곳까지 부탁해!」"
  },
  {
   "id": 35429,
   "key": "D1311ru.txt:442",
   "file": "D1311ru.txt",
   "line": 442,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「了解ロボ！」",
   "ko_candidate": "「알겠로봇!」"
  },
  {
   "id": 35430,
   "key": "D1311ru.txt:447",
   "file": "D1311ru.txt",
   "line": 447,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん！」",
   "ko_candidate": "「다이쥬지 씨!」"
  },
  {
   "id": 35431,
   "key": "D1311ru.txt:450",
   "file": "D1311ru.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの元へ飛び立とうとする俺を、姫さんが呼び止めた。",
   "ko_candidate": "데몬베인에게로 날아오르려는 나를､ 공주님이 불러 세웠다｡"
  },
  {
   "id": 35432,
   "key": "D1311ru.txt:452",
   "file": "D1311ru.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り返ると姫さんは、少し躊躇うような、怯んだ表情を浮かべてから、やがて俺を見つめ返して、",
   "ko_candidate": "돌아보니 공주님은､ 잠시 망설이는 듯한､ 겁먹은 표정을 지었다가､ 이내 나를 바라보며､"
  },
  {
   "id": 35433,
   "key": "D1311ru.txt:459",
   "file": "D1311ru.txt",
   "line": 459,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えっ……と、あの、その……」",
   "ko_candidate": "「저……어､ 그､ 저기……」"
  },
  {
   "id": 35434,
   "key": "D1311ru.txt:462",
   "file": "D1311ru.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はすかさず、笑顔で答えた。",
   "ko_candidate": "나는 재빨리､ 웃는 얼굴로 대답했다｡"
  },
  {
   "id": 35435,
   "key": "D1311ru.txt:466",
   "file": "D1311ru.txt",
   "line": 466,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「頑張るよ」",
   "ko_candidate": "「힘낼게」"
  },
  {
   "id": 35436,
   "key": "D1311ru.txt:471",
   "file": "D1311ru.txt",
   "line": 471,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 35437,
   "key": "D1311ru.txt:474",
   "file": "D1311ru.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんは少しの間だけ、ぽかんとしていた後、やはり満面の笑顔で返してくれた。",
   "ko_candidate": "공주님은 잠시 동안만､ 멍하니 있다가､ 역시 환한 미소로 답해 주었다｡"
  },
  {
   "id": 35438,
   "key": "D1311ru.txt:481",
   "file": "D1311ru.txt",
   "line": 481,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……はいっ！　頑張って下さいませっ！」",
   "ko_candidate": "「……네! 힘내세요!」"
  },
  {
   "id": 35439,
   "key": "D1311ru.txt:485",
   "file": "D1311ru.txt",
   "line": 485,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ええいっ！　何をしておる！　早くせんかっ！」",
   "ko_candidate": "「이크! 뭘 하고 있는 거냐! 빨리 하지 않겠느냐!」"
  },
  {
   "id": 35440,
   "key": "D1311ru.txt:489",
   "file": "D1311ru.txt",
   "line": 489,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわっと！ ……分かった、分かった。耳元で叫ぶなっ。 なに怒ってんだよ、お前はっ」",
   "ko_candidate": "「우와! ……알았어､ 알았다고｡ 귓가에서 소리 지르지 마｡ 뭘 화내는 거야､ 너는」"
  },
  {
   "id": 35441,
   "key": "D1311ru.txt:495",
   "file": "D1311ru.txt",
   "line": 495,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふんっ！」",
   "ko_candidate": "「흥!」"
  },
  {
   "id": 35442,
   "key": "D1311ru.txt:499",
   "file": "D1311ru.txt",
   "line": 499,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ったく。じゃあ、征くぜ！　憎悪の空より来たりて――」",
   "ko_candidate": "「……정말｡ 그럼､ 간다! 증오의 하늘로부터 강림하여――」"
  },
  {
   "id": 35443,
   "key": "D1311ru.txt:502",
   "file": "D1311ru.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地を蹴り、マギウス・ウィングを羽ばたかせる。",
   "ko_candidate": "땅을 박차고､ 마기우스 윙을 펄럭인다｡"
  },
  {
   "id": 35444,
   "key": "D1311ru.txt:514",
   "file": "D1311ru.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "急加速。",
   "ko_candidate": "급가속｡"
  },
  {
   "id": 35445,
   "key": "D1311ru.txt:515",
   "file": "D1311ru.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "凄まじいスピードで、デモンベインの元まで舞い上がる。",
   "ko_candidate": "엄청난 속도로､ 데몬베인에게로 날아오른다｡"
  },
  {
   "id": 35446,
   "key": "D1311ru.txt:519",
   "file": "D1311ru.txt",
   "line": 519,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「正しき怒りに応え――」",
   "ko_candidate": "「올바른 분노에 응답하여――」"
  },
  {
   "id": 35447,
   "key": "D1311ru.txt:523",
   "file": "D1311ru.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちの躰が光の粒子となって、崩れてゆく。",
   "ko_candidate": "우리의 몸이 빛의 입자가 되어､ 부서져 간다｡"
  },
  {
   "id": 35448,
   "key": "D1311ru.txt:524",
   "file": "D1311ru.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの胸の前に、魔法陣が浮かび上がった。",
   "ko_candidate": "데몬베인의 가슴 앞에､ 마법진이 떠올랐다｡"
  },
  {
   "id": 35449,
   "key": "D1311ru.txt:528",
   "file": "D1311ru.txt",
   "line": 528,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「我等は魔を断つ剣を執る！」",
   "ko_candidate": "「우리는 마를 베는 검을 든다!」"
  },
  {
   "id": 35450,
   "key": "D1311ru.txt:533",
   "file": "D1311ru.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "輝く五芒星に、光と化した俺たちは吸い込まれた。",
   "ko_candidate": "빛나는 오망성에､ 빛이 된 우리는 빨려 들어갔다｡"
  },
  {
   "id": 35451,
   "key": "D1311ru.txt:534",
   "file": "D1311ru.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬の間を置いて、俺たちはそれぞれ、自分の操縦席で再構成された。",
   "ko_candidate": "잠깐의 시간이 흐른 뒤､ 우리는 각자 자신의 조종석에서 재구성되었다｡"
  },
  {
   "id": 35452,
   "key": "D1311ru.txt:542",
   "file": "D1311ru.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "円になって俺を囲む、モニターやコンソールパネル、操縦桿。",
   "ko_candidate": "원형으로 나를 둘러싼 모니터와 콘솔 패널､ 조종간｡"
  },
  {
   "id": 35453,
   "key": "D1311ru.txt:548",
   "file": "D1311ru.txt",
   "line": 548,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正面のメインモニターには、今まさに凶風を纏い、攻撃態勢に入るロードビヤーキーが映し出されていた。",
   "ko_candidate": "정면의 메인 모니터에는 지금 막 흉풍을 두르고 공격 태세에 들어간 로드 비야키가 비춰지고 있었다｡"
  },
  {
   "id": 35454,
   "key": "D1311ru.txt:552",
   "file": "D1311ru.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーが放つ殺気、闘気、瘴気。",
   "ko_candidate": "로드 비야키가 뿜어내는 살기､ 투기､ 장기｡"
  },
  {
   "id": 35455,
   "key": "D1311ru.txt:553",
   "file": "D1311ru.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凄まじいプレッシャーだ。死にかけの術者が操っているとは思えない。",
   "ko_candidate": "엄청난 압박감이다｡ 죽어가는 술사가 조종하고 있다고는 믿기지 않는다｡"
  },
  {
   "id": 35456,
   "key": "D1311ru.txt:554",
   "file": "D1311ru.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さすがはアンチクロス。恐るべき敵だ。",
   "ko_candidate": "역시 안티 크로스｡ 무서운 적이다｡"
  },
  {
   "id": 35457,
   "key": "D1311ru.txt:556",
   "file": "D1311ru.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――俺には分かる。",
   "ko_candidate": "하지만―― 나는 알 수 있다｡"
  },
  {
   "id": 35458,
   "key": "D1311ru.txt:557",
   "file": "D1311ru.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今の俺の力は、あいつらを超越している。",
   "ko_candidate": "지금의 내 힘은 그들을 초월하고 있다｡"
  },
  {
   "id": 35459,
   "key": "D1311ru.txt:559",
   "file": "D1311ru.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自惚れでもなく、楽観でもない。",
   "ko_candidate": "자만도 아니고､ 낙관도 아니다｡"
  },
  {
   "id": 35460,
   "key": "D1311ru.txt:560",
   "file": "D1311ru.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ単にこれは、事実を確認しているに過ぎない。",
   "ko_candidate": "단순히 이는 사실을 확인하고 있을 뿐이다｡"
  },
  {
   "id": 35461,
   "key": "D1311ru.txt:563",
   "file": "D1311ru.txt",
   "line": 563,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐに証明できる。",
   "ko_candidate": "곧바로 증명할 수 있다｡"
  },
  {
   "id": 35462,
   "key": "D1311ru.txt:564",
   "file": "D1311ru.txt",
   "line": 564,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の中で荒れ狂う魔力の強大さ。",
   "ko_candidate": "내 안에서 거세게 몰아치는 마력의 강대함｡"
  },
  {
   "id": 35463,
   "key": "D1311ru.txt:565",
   "file": "D1311ru.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを制御する意志の強靭さ。",
   "ko_candidate": "그것을 제어하는 의지의 강인함｡"
  },
  {
   "id": 35464,
   "key": "D1311ru.txt:567",
   "file": "D1311ru.txt",
   "line": 567,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この２つを威力として編み上げ、ただ奴にぶつければ良いだけだ。",
   "ko_candidate": "이 두 가지를 위력으로 엮어 그저 놈에게 부딪히면 그만이다｡"
  },
  {
   "id": 35465,
   "key": "D1311ru.txt:569",
   "file": "D1311ru.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やってやる。",
   "ko_candidate": "해주마｡"
  }
 ]
}