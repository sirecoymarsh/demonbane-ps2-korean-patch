 "items": [
  {
   "id": 40949,
   "key": "D1501al.txt:1635",
   "file": "D1501al.txt",
   "line": 1635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界を読み取り、術式を解いて、答えを導け。",
   "ko_candidate": "세계를 읽어내고 술식을 풀어서 답을 도출해｡"
  },
  {
   "id": 40950,
   "key": "D1501al.txt:1638",
   "file": "D1501al.txt",
   "line": 1638,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば……自ずと……！",
   "ko_candidate": "그러면…… 저절로……!"
  },
  {
   "id": 40951,
   "key": "D1501al.txt:1649",
   "file": "D1501al.txt",
   "line": 1649,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――見えた！」",
   "ko_candidate": "「――보였다!」"
  },
  {
   "id": 40952,
   "key": "D1501al.txt:1653",
   "file": "D1501al.txt",
   "line": 1653,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "常に激変する情報、容を変える術式。",
   "ko_candidate": "항상 격변하는 정보､ 모습을 바꾸는 술식｡"
  },
  {
   "id": 40953,
   "key": "D1501al.txt:1654",
   "file": "D1501al.txt",
   "line": 1654,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが基軸になる部分は一緒だ。",
   "ko_candidate": "하지만 기축이 되는 부분은 같다｡"
  },
  {
   "id": 40954,
   "key": "D1501al.txt:1657",
   "file": "D1501al.txt",
   "line": 1657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "解読したその箇所、わずかな隙に、この結界を破壊する新たな法則を乱暴に雪崩れ込ませる！",
   "ko_candidate": "해독한 그 부분에､ 미세한 틈에､ 이 결계를 파괴할 새로운 법칙을､ 내 마술을 난폭하게 눈사태처럼 밀어 넣는다!"
  },
  {
   "id": 40955,
   "key": "D1501al.txt:1673",
   "file": "D1501al.txt",
   "line": 1673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ガラスが砕け散るような音を、心の中で聴いた。",
   "ko_candidate": "유리가 산산조각 나는 듯한 소리를 마음속으로 들었다｡"
  },
  {
   "id": 40956,
   "key": "D1501al.txt:1676",
   "file": "D1501al.txt",
   "line": 1676,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あれほどデモンベインを強烈に呪縛していた魔力は、嘘のように跡形も無く消滅していた。",
   "ko_candidate": "그토록 데몬베인을 강렬하게 주박하고 있던 마력은 거짓말처럼 흔적도 없이 소멸해 있었다｡"
  },
  {
   "id": 40957,
   "key": "D1501al.txt:1686",
   "file": "D1501al.txt",
   "line": 1686,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「全く…… いつまでも世話を焼かせる！」",
   "ko_candidate": "「정말…… 언제까지나 신경 써야 하는군!」"
  },
  {
   "id": 40958,
   "key": "D1501al.txt:1708",
   "file": "D1501al.txt",
   "line": 1708,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「るせえ！　ほっとけ！ そんなことより追いかけるぞ！ ――シャンタク！」",
   "ko_candidate": "「시끄러! 내버려 둬! 그런 것보다 쫓아가자! ――샨타크!」"
  },
  {
   "id": 40959,
   "key": "D1501le.txt:10",
   "file": "D1501le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幻舞する極彩色の光。",
   "ko_candidate": "환상적으로 춤추는 극채색의 빛｡"
  },
  {
   "id": 40960,
   "key": "D1501le.txt:11",
   "file": "D1501le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血に濡れる白い肌。",
   "ko_candidate": "피에 젖은 하얀 피부｡"
  },
  {
   "id": 40961,
   "key": "D1501le.txt:12",
   "file": "D1501le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血と光の中に広がる、黒い髪。",
   "ko_candidate": "피와 빛 속에 펼쳐지는 검은 머리카락｡"
  },
  {
   "id": 40962,
   "key": "D1501le.txt:13",
   "file": "D1501le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死と殺戮の殻より孵る揚羽蝶。",
   "ko_candidate": "죽음과 살육의 껍질에서 부화하는 호랑나비｡"
  },
  {
   "id": 40963,
   "key": "D1501le.txt:16",
   "file": "D1501le.txt",
   "line": 16,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ナコト写本』の精霊――エセルドレーダ。",
   "ko_candidate": "『나코트 사본』의 정령――에셀드레다｡"
  },
  {
   "id": 40964,
   "key": "D1501le.txt:20",
   "file": "D1501le.txt",
   "line": 20,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「がは……あ……がが……っ！」",
   "ko_candidate": "「가하… 아… 가가…!」"
  },
  {
   "id": 40965,
   "key": "D1501le.txt:24",
   "file": "D1501le.txt",
   "line": 24,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「喜んで良いですよ、導師。 貴方の言う通り……その子は確かに、確かに『暴君』を超える魔人です」 「貴方の念願は叶いました。ただ……」",
   "ko_candidate": "「기뻐하셔도 좋아요､ 도사님｡ 당신 말씀대로… 그 아이는 확실히､ 확실히 『폭군』을 뛰어넘는 마인입니다｡ 당신의 염원은 이루어졌어요｡ 다만…」"
  },
  {
   "id": 40966,
   "key": "D1501le.txt:35",
   "file": "D1501le.txt",
   "line": 35,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐああああああ――――ッ！」",
   "ko_candidate": "「구아아아아아아――――!」"
  },
  {
   "id": 40967,
   "key": "D1501le.txt:42",
   "file": "D1501le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕をねじるエセルドレーダ。",
   "ko_candidate": "에셀드레다가 가슴을 관통한 팔을 비틀었다｡"
  },
  {
   "id": 40968,
   "key": "D1501le.txt:43",
   "file": "D1501le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウェスパシアヌスは悲鳴と共に血を吐き出す。",
   "ko_candidate": "베스파시아누스는 비명과 함께 피를 토해냈다｡"
  },
  {
   "id": 40969,
   "key": "D1501le.txt:45",
   "file": "D1501le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "底冷えする嘲笑を浮かべて、エセルドレーダは囁いた。",
   "ko_candidate": "몸서리치는 조소와 함께 입가를 살짝 일그러뜨리며 에셀드레다가 속삭였다｡"
  },
  {
   "id": 40970,
   "key": "D1501le.txt:53",
   "file": "D1501le.txt",
   "line": 53,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それは決して、貴方の力ではないのですが。だって総ては――運命の奴隷だもの」",
   "ko_candidate": "「그것은 결코 당신의 힘이 아니라는 거예요｡ 왜냐하면 모든 것은―― 운명의 노예니까요」"
  },
  {
   "id": 40971,
   "key": "D1501le.txt:60",
   "file": "D1501le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "苦痛を長引かせるべく、残酷にゆっくりと腕を引き抜いた。",
   "ko_candidate": "고통을 오래 끌기 위해 잔인하게 천천히 팔을 빼냈다｡ 더욱 격렬하게 피가 솟구쳤다｡"
  },
  {
   "id": 40972,
   "key": "D1501le.txt:67",
   "file": "D1501le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仰向けに倒れ込むウェスパシアヌスの躰。",
   "ko_candidate": "뒤로 쓰러지는 베스파시아누스의 몸｡"
  },
  {
   "id": 40973,
   "key": "D1501le.txt:68",
   "file": "D1501le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血柱が天を突いた。",
   "ko_candidate": "피기둥이 하늘을 찔렀다｡"
  },
  {
   "id": 40974,
   "key": "D1501le.txt:69",
   "file": "D1501le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鮮血がなおも黒い少女を染めてゆく。",
   "ko_candidate": "선혈이 여전히 검은 소녀를 물들여 갔다｡"
  },
  {
   "id": 40975,
   "key": "D1501le.txt:74",
   "file": "D1501le.txt",
   "line": 74,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ナコト写本ッ！」",
   "ko_candidate": "「나코트 사본!」"
  },
  {
   "id": 40976,
   "key": "D1501le.txt:80",
   "file": "D1501le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの叫びに、エセルドレーダが振り向いた。",
   "ko_candidate": "알의 외침에 에셀드레다가 돌아보았다｡"
  },
  {
   "id": 40977,
   "key": "D1501le.txt:81",
   "file": "D1501le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の無い昏い瞳は、だが夜の湖畔の如く静かに澄み渡っている。",
   "ko_candidate": "빛 없는 어두운 눈동자는 그러나 밤의 호숫가처럼 조용히 맑게 빛나고 있었다｡"
  },
  {
   "id": 40978,
   "key": "D1501le.txt:85",
   "file": "D1501le.txt",
   "line": 85,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ご機嫌麗しゅう。アル・アジフ。私は酷く目覚めが良いわ。 だって、こんなにも血の匂いに充たされているから」",
   "ko_candidate": "「안녕하세요｡ 알 아지프｡ 저는 굉장히 기분 좋게 깨어났어요｡ 왜냐하면 이렇게나 피 냄새로 가득 차 있으니까요」"
  },
  {
   "id": 40979,
   "key": "D1501le.txt:91",
   "file": "D1501le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインに向き直る、サイクラノーシュ。",
   "ko_candidate": "데몬베인을 향해 돌아서는 사이크라노슈｡"
  },
  {
   "id": 40980,
   "key": "D1501le.txt:92",
   "file": "D1501le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちとエセルドレーダは、真正面から対峙する。",
   "ko_candidate": "우리와 에셀드레다는 정면으로 대치한다｡"
  },
  {
   "id": 40981,
   "key": "D1501le.txt:93",
   "file": "D1501le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄らと、可憐な微笑を浮かべる。",
   "ko_candidate": "희미하게 아름다운 미소를 띠었다｡"
  },
  {
   "id": 40982,
   "key": "D1501le.txt:99",
   "file": "D1501le.txt",
   "line": 99,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……本当にたくさんの妖気を食べさせてくれて。お陰でようやく自分の容を取り戻せたわ。有り難う」",
   "ko_candidate": "「…정말 많은 요기를 먹게 해줘서｡ 덕분에 드디어 자신의 모습을 되찾을 수 있었어요｡ 고마워요」"
  },
  {
   "id": 40983,
   "key": "D1501le.txt:103",
   "file": "D1501le.txt",
   "line": 103,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうか……汝、アンチクロス共の魔力を喰らって、力を蓄えたな？」 「……なんて、迂闊な」",
   "ko_candidate": "「그렇군… 너､ 안티크로스들의 마력을 먹어치우고 힘을 축적했구나? …뭐라니､ 경솔했어」"
  },
  {
   "id": 40984,
   "key": "D1501le.txt:109",
   "file": "D1501le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……そういうことか。",
   "ko_candidate": "…그런 거였군｡"
  },
  {
   "id": 40985,
   "key": "D1501le.txt:110",
   "file": "D1501le.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーに感じた不吉の影は気のせいじゃなかった。",
   "ko_candidate": "헌팅 호러에서 느낀 불길한 그림자는 기분 탓이 아니었다｡"
  },
  {
   "id": 40986,
   "key": "D1501le.txt:112",
   "file": "D1501le.txt",
   "line": 112,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ナコト写本』は魂を失ったワケじゃなかった。",
   "ko_candidate": "『나코트 사본』은 영혼을 잃은 게 아니었다｡"
  },
  {
   "id": 40987,
   "key": "D1501le.txt:113",
   "file": "D1501le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "息を潜ませ、虎視眈々と機会を窺っていたんだ……！",
   "ko_candidate": "숨을 죽이고 호시탐탐 기회를 노리고 있었던 거야…!"
  },
  {
   "id": 40988,
   "key": "D1501le.txt:117",
   "file": "D1501le.txt",
   "line": 117,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ……仕上げは、私、自らの手で。そう、この子は他の誰にも好きにはさせない」",
   "ko_candidate": "「자… 마무리는 제가 직접 손으로｡ 그래요､ 이 아이는 다른 누구도 마음대로 할 수 없어요」"
  }
 ]
}