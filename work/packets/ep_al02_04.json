 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "デウス・マキナ": "데우스 마키나",
  "魔導書": "마도서",
  "魔力": "마력"
 },
 "items": [
  {
   "id": 49619,
   "key": "ep_al02.txt:648",
   "file": "ep_al02.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デウス・マキナ。",
   "ko_candidate": "데우스 마키나｡"
  },
  {
   "id": 49620,
   "key": "ep_al02.txt:650",
   "file": "ep_al02.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "禁断の魔導書によって成し遂げる驚嘆すべき奇跡を、闇の男は一瞬にして実現させた。",
   "ko_candidate": "금단의 마도서로 이루어낸 경탄할 만한 기적을､ 어둠의 남자는 순식간에 실현시켰다｡"
  },
  {
   "id": 49621,
   "key": "ep_al02.txt:655",
   "file": "ep_al02.txt",
   "line": 655,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その機体の内に秘めた圧倒的な魔力が、",
   "ko_candidate": "그 기체 안에 숨겨진 압도적인 마력이 사악함을 극복하는 두 사람을"
  },
  {
   "id": 49622,
   "key": "ep_al02.txt:656",
   "file": "ep_al02.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "邪悪を相克する２人を威圧する。",
   "ko_candidate": "위압한다｡"
  },
  {
   "id": 49623,
   "key": "ep_al02.txt:657",
   "file": "ep_al02.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "常人ならば、ただそれだけで魂魄を破壊される瘴気を浴びて、だが２人は不敵に微笑んでいた。",
   "ko_candidate": "보통 사람이라면 그것만으로도 영혼이 파괴될 장기를 뒤집어쓰고､ 하지만 두 사람은 뻔뻔하게 미소 짓고 있었다｡"
  },
  {
   "id": 49624,
   "key": "ep_al02.txt:663",
   "file": "ep_al02.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "男が剣指を作り、宙に結印を刻む。",
   "ko_candidate": "남자가 검지를 만들어 허공에 결인을 새긴다｡"
  },
  {
   "id": 49625,
   "key": "ep_al02.txt:664",
   "file": "ep_al02.txt",
   "line": 664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "剣指を追って、光が魔法陣を描いた。",
   "ko_candidate": "검지를 따라 빛이 마법진을 그렸다｡"
  },
  {
   "id": 49626,
   "key": "ep_al02.txt:665",
   "file": "ep_al02.txt",
   "line": 665,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "五芒星形の印。",
   "ko_candidate": "오망성형의 인｡"
  },
  {
   "id": 49627,
   "key": "ep_al02.txt:667",
   "file": "ep_al02.txt",
   "line": 667,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "６体のデウス・マキナと、闇黒を纏う異形を前に、 男は高らかと聖句を詠み上げる。",
   "ko_candidate": "6체의 데우스 마키나와 어둠을 두른 이형을 앞에 두고､ 남자는 우렁차게 성구를 읊조린다｡"
  },
  {
   "id": 49628,
   "key": "ep_al02.txt:670",
   "file": "ep_al02.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この苛烈な闘争の永劫の中、 無限の数を重ねて唱えた、魔を断つ誓い。",
   "ko_candidate": "이 가혹한 투쟁의 영겁 속에서 무한한 수를 거듭해 외친､ 마를 베는 맹세｡"
  },
  {
   "id": 49629,
   "key": "ep_al02.txt:673",
   "file": "ep_al02.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今回もまた、変わる事無く。",
   "ko_candidate": "이번에도 또､ 변함없이｡"
  },
  {
   "id": 49630,
   "key": "ep_al02.txt:675",
   "file": "ep_al02.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、これからもなお――",
   "ko_candidate": "그리고､ 앞으로도 여전히――"
  },
  {
   "id": 49631,
   "key": "ep_al02.txt:685",
   "file": "ep_al02.txt",
   "line": 685,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「憎悪の空より来たりて――」",
   "ko_candidate": "「증오의 하늘로부터 내려와――」"
  },
  {
   "id": 49632,
   "key": "ep_al02.txt:695",
   "file": "ep_al02.txt",
   "line": 695,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「正しき怒りを胸に――」",
   "ko_candidate": "「올바른 분노를 가슴에 품고――」"
  },
  {
   "id": 49633,
   "key": "ep_al02.txt:705",
   "file": "ep_al02.txt",
   "line": 705,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「我等は魔を断つ剣を執る！」",
   "ko_candidate": "「우리는 마를 베는 검을 든다!」"
  },
  {
   "id": 49634,
   "key": "ep_al02.txt:712",
   "file": "ep_al02.txt",
   "line": 712,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇の男が吼えた。",
   "ko_candidate": "어둠의 남자가 포효했다｡"
  },
  {
   "id": 49635,
   "key": "ep_al02.txt:717",
   "file": "ep_al02.txt",
   "line": 717,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「然らば、私もまた苛烈なる憎悪を以って、お前達を愛し抜こう！」 「魅せてみよ！ この、盲目にして痴愚なる 神の夢――泡沫の宇宙で、 何処まで生き足掻く事が出来るか ……この私に魅せてみよ！」",
   "ko_candidate": "「그렇다면､ 나 또한 가혹한 증오를 가지고､ 너희들을 사랑해 주마! 보여다오! 이 맹목적이고 어리석은 신의 꿈――물거품 같은 우주에서 어디까지 살아 발버둥 칠 수 있는지 ……나에게 보여다오! 신의 시나리오마저 뛰어넘는 궁극의 파괴자! 신을 죽이는 칼날!"
  },
  {
   "id": 49636,
   "key": "ep_al02.txt:727",
   "file": "ep_al02.txt",
   "line": 727,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「神のシナリオすら超える窮極の破壊者！　神殺しの刃！ そう、お前達はヒトが創りし神！」 闇の男の躰が崩れ、",
   "ko_candidate": "그래､ 너희들은 인간이 만든 신!」"
  },
  {
   "id": 49637,
   "key": "ep_al02.txt:737",
   "file": "ep_al02.txt",
   "line": 737,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇黒の焔となって、世界を覆っていく。",
   "ko_candidate": "어둠의 남자의 몸이 무너져 어둠의 불꽃이 되어 세계를 뒤덮어 간다｡"
  },
  {
   "id": 49638,
   "key": "ep_al02.txt:738",
   "file": "ep_al02.txt",
   "line": 738,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "６体のデウス・マキナが、爆音を轟かせ、 一斉に襲い掛かる。",
   "ko_candidate": "6체의 데우스 마키나가 폭음을 울리며 일제히 덮쳐온다｡"
  },
  {
   "id": 49639,
   "key": "ep_al02.txt:781",
   "file": "ep_al02.txt",
   "line": 781,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その中央、七度目の爆砕が、世界を震撼させる。",
   "ko_candidate": "그 중앙､ 일곱 번째 폭쇄가 세계를 뒤흔든다｡"
  },
  {
   "id": 49640,
   "key": "ep_al02.txt:790",
   "file": "ep_al02.txt",
   "line": 790,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "善と悪とが激突する、世界の中枢で――",
   "ko_candidate": "선과 악이 격돌하는 세계의 중추에서――"
  },
  {
   "id": 49641,
   "key": "ep_al02.txt:791",
   "file": "ep_al02.txt",
   "line": 791,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "世界を呑み込み、 迫り来る衝撃を、直前にしながら――",
   "ko_candidate": "세계를 삼켜버리고 다가오는 충격을 목전에 두고서도――"
  },
  {
   "id": 49642,
   "key": "ep_al02.txt:793",
   "file": "ep_al02.txt",
   "line": 793,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それでも少女は詩を詠い続ける。",
   "ko_candidate": "그래도 소녀는 시를 읊어 나간다｡"
  },
  {
   "id": 49643,
   "key": "ep_al02.txt:798",
   "file": "ep_al02.txt",
   "line": 798,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "祈りの様に",
   "ko_candidate": "기도하듯이"
  },
  {
   "id": 49644,
   "key": "ep_al02.txt:799",
   "file": "ep_al02.txt",
   "line": 799,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "願いの様に",
   "ko_candidate": "소원을 빌듯이"
  },
  {
   "id": 49645,
   "key": "ep_al02.txt:800",
   "file": "ep_al02.txt",
   "line": 800,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "誓いの様に",
   "ko_candidate": "맹세하듯이"
  },
  {
   "id": 49646,
   "key": "ep_al02.txt:804",
   "file": "ep_al02.txt",
   "line": 804,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "歌い、詠い、謳い続ける。",
   "ko_candidate": "노래하고､ 읊고､ 계속해서 노래한다｡"
  },
  {
   "id": 49647,
   "key": "ep_al02.txt:805",
   "file": "ep_al02.txt",
   "line": 805,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "微笑みながら、",
   "ko_candidate": "미소 지으며､"
  },
  {
   "id": 49648,
   "key": "ep_al02.txt:806",
   "file": "ep_al02.txt",
   "line": 806,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "恋焦がれながら、",
   "ko_candidate": "사랑에 애태우며､"
  },
  {
   "id": 49649,
   "key": "ep_al02.txt:809",
   "file": "ep_al02.txt",
   "line": 809,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "御伽噺を――。",
   "ko_candidate": "동화이야기를――｡"
  },
  {
   "id": 49650,
   "key": "ep_al02.txt:820",
   "file": "ep_al02.txt",
   "line": 820,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いつか悪い神様たちは想うでしょう。",
   "ko_candidate": "언젠가 나쁜 신들은 생각하겠죠｡"
  },
  {
   "id": 49651,
   "key": "ep_al02.txt:821",
   "file": "ep_al02.txt",
   "line": 821,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "宇宙の果ての寒い場所に閉じ込められながら、",
   "ko_candidate": "우주 끝의 추운 곳에 갇힌 채､ 고민하겠죠｡"
  },
  {
   "id": 49652,
   "key": "ep_al02.txt:822",
   "file": "ep_al02.txt",
   "line": 822,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悩むでしょう。",
   "ko_candidate": "화내면서､ 탄식하면서､"
  },
  {
   "id": 49653,
   "key": "ep_al02.txt:824",
   "file": "ep_al02.txt",
   "line": 824,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "怒りながら、",
   "ko_candidate": "증오하면서､"
  },
  {
   "id": 49654,
   "key": "ep_al02.txt:825",
   "file": "ep_al02.txt",
   "line": 825,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "嘆きながら、",
   "ko_candidate": "질투하면서､"
  },
  {
   "id": 49655,
   "key": "ep_al02.txt:826",
   "file": "ep_al02.txt",
   "line": 826,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "憎みながら、 妬みながら、",
   "ko_candidate": "그리고―― 동경하면서｡"
  },
  {
   "id": 49656,
   "key": "ep_al02.txt:829",
   "file": "ep_al02.txt",
   "line": 829,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして――憧れながら。",
   "ko_candidate": "왜 이렇게 되어버린 걸까?"
  },
  {
   "id": 49657,
   "key": "ep_al02.txt:831",
   "file": "ep_al02.txt",
   "line": 831,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "なぜ、こんなことになってしまったんだろう？",
   "ko_candidate": "이 세상엔 착한 신 따위는 없었을 텐데｡"
  },
  {
   "id": 49658,
   "key": "ep_al02.txt:832",
   "file": "ep_al02.txt",
   "line": 832,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この世界には善い神様なんて居なかったはずなのに。 いったい誰が、何が、どんな願いが、宇宙の真理すらも捻じ曲げて、善い神様を創り出すのだろう？",
   "ko_candidate": "도대체 누가､ 무엇이､ 어떤 소원이 우주의 진리마저 비틀어 착한 신을 만들어낸 걸까?"
  }
 ]
}