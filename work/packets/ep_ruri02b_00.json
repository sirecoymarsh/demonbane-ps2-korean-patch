 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "大十字九郎": "다이쥬지 쿠로",
  "アル": "알",
  "九郎": "쿠로",
  "術式": "술식",
  "アル・アジフ": "알 아지프",
  "ナイア": "나이아",
  "覇道瑠璃": "하도 루리",
  "魔導書": "마도서",
  "瑠璃": "루리"
 },
 "items": [
  {
   "id": 50921,
   "key": "ep_ruri02b.txt:9",
   "file": "ep_ruri02b.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――それよりも……本当に良いのかい？",
   "ko_candidate": "――그보다도……정말 괜찮은 거야?"
  },
  {
   "id": 50922,
   "key": "ep_ruri02b.txt:11",
   "file": "ep_ruri02b.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――大十字九郎を元の世界に、戻してしまって……だよ。",
   "ko_candidate": "――다이쥬지 쿠로를 원래 세계로､ 돌려보내 버리고……말이야｡"
  },
  {
   "id": 50923,
   "key": "ep_ruri02b.txt:13",
   "file": "ep_ruri02b.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――大十字九郎が帰る場所は、あの女の許なのに。",
   "ko_candidate": "――다이쥬지 쿠로가 돌아갈 곳은､ 그 여자의 곁인데｡"
  },
  {
   "id": 50924,
   "key": "ep_ruri02b.txt:15",
   "file": "ep_ruri02b.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――大十字九郎の心は、君の傍に無い。",
   "ko_candidate": "――다이쥬지 쿠로의 마음은､ 네 곁에 없어｡"
  },
  {
   "id": 50925,
   "key": "ep_ruri02b.txt:17",
   "file": "ep_ruri02b.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どんなに遠くても、どんなに離れても、時すら隔たっていても、彼の心は、いつだってあの娘の傍に。",
   "ko_candidate": "아무리 멀어도､ 아무리 떨어져 있어도､ 시간조차 떨어져 있어도､ 그의 마음은､ 언제나 그 아이의 곁에｡"
  },
  {
   "id": 50926,
   "key": "ep_ruri02b.txt:19",
   "file": "ep_ruri02b.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――君は、こんなに彼の傍に居るのに……独りだ。",
   "ko_candidate": "――너는､ 이렇게 그의 곁에 있는데……혼자야｡"
  },
  {
   "id": 50927,
   "key": "ep_ruri02b.txt:20",
   "file": "ep_ruri02b.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今までと変わりなく、ずっとずっと。永遠に永遠に。",
   "ko_candidate": "지금까지와 다름없이､ 계속 계속｡ 영원히 영원히｡"
  },
  {
   "id": 50928,
   "key": "ep_ruri02b.txt:21",
   "file": "ep_ruri02b.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "君が、大十字九郎と出逢う前と同じに。",
   "ko_candidate": "네가､ 다이쥬지 쿠로와 만나기 전과 똑같이｡"
  },
  {
   "id": 50929,
   "key": "ep_ruri02b.txt:23",
   "file": "ep_ruri02b.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――だけど。",
   "ko_candidate": "――하지만｡"
  },
  {
   "id": 50930,
   "key": "ep_ruri02b.txt:25",
   "file": "ep_ruri02b.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――彼を永遠の道連れにすれば。",
   "ko_candidate": "――그를 영원한 동반자로 삼는다면｡"
  },
  {
   "id": 50931,
   "key": "ep_ruri02b.txt:30",
   "file": "ep_ruri02b.txt",
   "line": 30,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「成程。そいつは確かに妙案だな」",
   "ko_candidate": "「과연｡ 그거 확실히 묘안이군」"
  },
  {
   "id": 50932,
   "key": "ep_ruri02b.txt:37",
   "file": "ep_ruri02b.txt",
   "line": 37,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 50933,
   "key": "ep_ruri02b.txt:40",
   "file": "ep_ruri02b.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "焔える闇が、たじろいだ。",
   "ko_candidate": "불타오르는 어둠이､ 움찔했다｡"
  },
  {
   "id": 50934,
   "key": "ep_ruri02b.txt:41",
   "file": "ep_ruri02b.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "疑問が、不審が、不理解が、だだ漏れになって、闇を揺らがせる。",
   "ko_candidate": "의문이､ 의심이､ 이해할 수 없음이､ 그대로 새어나와､ 어둠을 흔들어 놓는다｡"
  },
  {
   "id": 50935,
   "key": "ep_ruri02b.txt:42",
   "file": "ep_ruri02b.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その存在が、僅かに不確かなものとなった。",
   "ko_candidate": "그 존재가､ 약간 불확실한 것이 되었다｡"
  },
  {
   "id": 50936,
   "key": "ep_ruri02b.txt:44",
   "file": "ep_ruri02b.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そんな闇黒を嘲笑うかの如く、アルは不敵に笑う。",
   "ko_candidate": "그런 암흑을 조롱하듯이､ 알은 뻔뻔하게 웃는다｡"
  },
  {
   "id": 50937,
   "key": "ep_ruri02b.txt:48",
   "file": "ep_ruri02b.txt",
   "line": 48,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだ。妾は九郎に好意を抱いておる……慕っておるさ愛しておるさときめいておるさ」 「成程、成程。確かにあんな小娘に横取りされるのは酷く不快だ……だがな！」",
   "ko_candidate": "「그래｡ 나는 쿠로에게 호감을 갖고 있어……사모하고 있어 사랑하고 있어 설레고 있어｡ 과연､ 과연｡ 확실히 저런 계집애한테 가로채이는 건､ 몹시 불쾌해……하지만 말이야!」"
  },
  {
   "id": 50938,
   "key": "ep_ruri02b.txt:55",
   "file": "ep_ruri02b.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "紡ぎ出す。",
   "ko_candidate": "짜내어 간다｡"
  },
  {
   "id": 50939,
   "key": "ep_ruri02b.txt:56",
   "file": "ep_ruri02b.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "術式を紡ぎ出す。",
   "ko_candidate": "술식을 짜내어 간다｡"
  },
  {
   "id": 50940,
   "key": "ep_ruri02b.txt:57",
   "file": "ep_ruri02b.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総てを解き放つ為に。",
   "ko_candidate": "모든 것을 풀어놓기 위해｡"
  },
  {
   "id": 50941,
   "key": "ep_ruri02b.txt:59",
   "file": "ep_ruri02b.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この忌まわしい輪廻の蛇を、運命の螺旋を、混沌の策謀を撃ち破る為に。",
   "ko_candidate": "이 저주받은 윤회의 뱀을､ 운명의 나선을､ 혼돈의 책략을 부수기 위해｡"
  },
  {
   "id": 50942,
   "key": "ep_ruri02b.txt:61",
   "file": "ep_ruri02b.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "限界を超えて、かくも強壮な、壮麗な、優美な、威風堂々の、一世一代の大魔術を、今こそ未来へと――！",
   "ko_candidate": "한계를 넘어서､ 이토록 강건한､ 장려한､ 우아한､ 위풍당당한､ 일생일대의 대마술을､ 지금이야말로 미래로――!"
  },
  {
   "id": 50943,
   "key": "ep_ruri02b.txt:65",
   "file": "ep_ruri02b.txt",
   "line": 65,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「汝の云うやり方！　まるで小娘から逃げるようで、なおの事、不快だ！」",
   "ko_candidate": "「네가 말하는 방식! 마치 계집애에게서 도망치는 것 같아서､ 더욱더､ 불쾌해!」"
  },
  {
   "id": 50944,
   "key": "ep_ruri02b.txt:72",
   "file": "ep_ruri02b.txt",
   "line": 72,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル・アジフ！ 君はァァァァァ！」",
   "ko_candidate": "「알 아지프! 너는아아아아!」"
  },
  {
   "id": 50945,
   "key": "ep_ruri02b.txt:77",
   "file": "ep_ruri02b.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "否定された焔える闇の存在が揺らぐ。",
   "ko_candidate": "부정된 불타오르는 어둠의 존재가 흔들린다｡"
  },
  {
   "id": 50946,
   "key": "ep_ruri02b.txt:79",
   "file": "ep_ruri02b.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "其れは霧散では無く収束。",
   "ko_candidate": "그것은 흩어짐이 아닌 수렴｡"
  },
  {
   "id": 50947,
   "key": "ep_ruri02b.txt:80",
   "file": "ep_ruri02b.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "混沌は混沌であるからこそ意味を為す。",
   "ko_candidate": "혼돈은 혼돈이기에 의미를 이룬다｡"
  },
  {
   "id": 50948,
   "key": "ep_ruri02b.txt:82",
   "file": "ep_ruri02b.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "存在を固定されれば――存在が揺らぐ。力を失う。",
   "ko_candidate": "존재가 고정되면――존재가 흔들린다｡ 힘을 잃는다｡"
  },
  {
   "id": 50949,
   "key": "ep_ruri02b.txt:84",
   "file": "ep_ruri02b.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇黒は、単なる女となって、固定された。",
   "ko_candidate": "암흑은､ 단순한 여자가 되어､ 고정되었다｡"
  },
  {
   "id": 50950,
   "key": "ep_ruri02b.txt:86",
   "file": "ep_ruri02b.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ナイア。",
   "ko_candidate": "나이아｡"
  },
  {
   "id": 50951,
   "key": "ep_ruri02b.txt:87",
   "file": "ep_ruri02b.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、それは仮の名。",
   "ko_candidate": "하지만､ 그것은 가명｡"
  },
  {
   "id": 50952,
   "key": "ep_ruri02b.txt:89",
   "file": "ep_ruri02b.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その真の姿は、無貌の――",
   "ko_candidate": "그 진정한 모습은､ 형언할 수 없는――"
  },
  {
   "id": 50953,
   "key": "ep_ruri02b.txt:93",
   "file": "ep_ruri02b.txt",
   "line": 93,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「妾は、正々堂々、真正面から、あの小娘を排除してやる！ 覇道瑠璃！　此れが最強の魔導書たる妾『アル・アジフ』の宣戦布告だ！」",
   "ko_candidate": "「나는､ 정정당당､ 정면에서､ 저 계집애를 제거해 주마! 하도 루리! 이것이 최강의 마도서인 나 『알 아지프』의 선전포고다!」"
  },
  {
   "id": 50954,
   "key": "ep_ruri02b.txt:101",
   "file": "ep_ruri02b.txt",
   "line": 101,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「Ｙ!?ｇｎＡ！！!?Ｉ？？Ｌｈィィィィィィィィ！」",
   "ko_candidate": "「Y!?gnA!!!?I??Lh이이이이이이이이!」"
  },
  {
   "id": 50955,
   "key": "ep_ruri02b.txt:104",
   "file": "ep_ruri02b.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ナイアが吼える。",
   "ko_candidate": "나이아가 포효한다｡"
  },
  {
   "id": 50956,
   "key": "ep_ruri02b.txt:105",
   "file": "ep_ruri02b.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この世ならざる言葉で咆吼する。",
   "ko_candidate": "이 세상의 것이 아닌 말로 포효한다｡"
  },
  {
   "id": 50957,
   "key": "ep_ruri02b.txt:106",
   "file": "ep_ruri02b.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "焔の様な闇を纏わせ、牙を剥き出しにして、アルに襲いかかる――",
   "ko_candidate": "불꽃 같은 어둠을 두르고､ 이빨을 드러내며､ 알에게 달려든다――"
  },
  {
   "id": 50958,
   "key": "ep_ruri02b.txt:111",
   "file": "ep_ruri02b.txt",
   "line": 111,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いあぁぁぁぁしゅぶにぐらぁぁぁあああああ！」",
   "ko_candidate": "「이아아아아슈부니구라아아아아아아아아!」 나이아의 몸이 세로로 양단되었다｡"
  },
  {
   "id": 50959,
   "key": "ep_ruri02b.txt:124",
   "file": "ep_ruri02b.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ナイアの躰が唐竹割りに両断された。",
   "ko_candidate": "오른쪽 반신과 왼쪽 반신이 눈물겹게 헤어지며､ 암흑을 선혈처럼 뿜어내며､"
  },
  {
   "id": 50960,
   "key": "ep_ruri02b.txt:132",
   "file": "ep_ruri02b.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "偃月刀を振り下ろした体勢のまま、瑠璃は不敵に微笑み返した。",
   "ko_candidate": "여자는 쓰러진다｡ 나이아의 시체 앞､ 언월도를 내리친 자세 그대로､ 루리는 뻔뻔하게 미소 지어 보였다｡"
  }
 ]
}