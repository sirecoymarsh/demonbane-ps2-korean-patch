 "items": [
  {
   "id": 49975,
   "key": "ep_nya01.txt:393",
   "file": "ep_nya01.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "汽車は何処までも下り続け、昇り続けた。",
   "ko_candidate": "기차는 어디까지나 내려가고 올라갔다｡"
  },
  {
   "id": 49976,
   "key": "ep_nya01.txt:394",
   "file": "ep_nya01.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "地球は、丸い。",
   "ko_candidate": "지구는 둥글다｡"
  },
  {
   "id": 49977,
   "key": "ep_nya01.txt:399",
   "file": "ep_nya01.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ようやく、汽車は、終点に着いた。",
   "ko_candidate": "드디어 기차는 종점에 도착했다｡"
  },
  {
   "id": 49978,
   "key": "ep_nya01.txt:400",
   "file": "ep_nya01.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "駅員のアナウンスが流れる。",
   "ko_candidate": "역무원의 안내방송이 흘러나온다｡"
  },
  {
   "id": 49979,
   "key": "ep_nya01.txt:404",
   "file": "ep_nya01.txt",
   "line": 404,
   "speaker": "駅員",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「終点ー。終点ー。 原始の卵。宇宙卵。無精卵」",
   "ko_candidate": "「종점-｡ 종점-｡ 원시의 알｡ 우주알｡ 무정란」"
  },
  {
   "id": 49980,
   "key": "ep_nya01.txt:414",
   "file": "ep_nya01.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "汽車を降りると、そこは教会だった。",
   "ko_candidate": "기차에서 내리자 그곳은 교회였다｡"
  },
  {
   "id": 49981,
   "key": "ep_nya01.txt:415",
   "file": "ep_nya01.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "教会ではシスターと子どもたちが泣いていた。",
   "ko_candidate": "교회에서는 수녀와 아이들이 울고 있었다｡"
  },
  {
   "id": 49982,
   "key": "ep_nya01.txt:416",
   "file": "ep_nya01.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "紅い涙を流し、黄色い鼻汁を垂らし、耳から白い汁を滴らせていた。",
   "ko_candidate": "붉은 눈물을 흘리고 노란 콧물을 흘리며 귀에서 하얀 액체를 떨어뜨리고 있었다｡"
  },
  {
   "id": 49983,
   "key": "ep_nya01.txt:418",
   "file": "ep_nya01.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は訊ねた。",
   "ko_candidate": "나는 물었다｡"
  },
  {
   "id": 49984,
   "key": "ep_nya01.txt:421",
   "file": "ep_nya01.txt",
   "line": 421,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どうしたのですか」",
   "ko_candidate": "「무슨 일입니까」"
  },
  {
