 },
 "items": [
  {
   "id": 26787,
   "key": "D1202al.txt:405",
   "file": "D1202al.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちを直前にしてエルザは壁に向かって跳ぶ。",
   "ko_candidate": "우리 바로 앞에서 엘자는 벽을 향해 뛴다｡"
  },
  {
   "id": 26788,
   "key": "D1202al.txt:406",
   "file": "D1202al.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらに壁を足場にして三角跳び。",
   "ko_candidate": "더 나아가 벽을 발판 삼아 삼각 점프｡"
  },
  {
   "id": 26789,
   "key": "D1202al.txt:408",
   "file": "D1202al.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "横合いから、クラウディウスに殴りかかる！",
   "ko_candidate": "옆에서 클라우디우스에게 주먹을 날린다!"
  },
  {
   "id": 26790,
   "key": "D1202al.txt:415",
   "file": "D1202al.txt",
   "line": 415,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちっ、うぜぇ！」",
   "ko_candidate": "「치､ 귀찮아!」"
  },
  {
   "id": 26791,
   "key": "D1202al.txt:419",
   "file": "D1202al.txt",
   "line": 419,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロォォォボロボロボロボロボ ロボロボロボロボロボロボロ ボォォォォ！」",
   "ko_candidate": "「로오오오봇로봇로봇로봇로봇로봇로봇로봇로봇로봇로봇로봇로오오오!」"
  },
  {
   "id": 26792,
   "key": "D1202al.txt:430",
   "file": "D1202al.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トンファーの一撃をケンダマで弾き返す。",
   "ko_candidate": "톤파의 일격을 켄다마로 튕겨낸다｡"
  },
  {
   "id": 26793,
   "key": "D1202al.txt:434",
   "file": "D1202al.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その隙に俺は偃月刀を振るう。エルザももう片方のトンファーを振るう。",
   "ko_candidate": "그 틈에 나는 언월도를 휘두른다｡ 엘자도 다른 한쪽의 톤파를 휘두른다｡"
  },
  {
   "id": 26794,
   "key": "D1202al.txt:440",
   "file": "D1202al.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "連打。連打。連打。",
   "ko_candidate": "연타｡ 연타｡ 연타｡"
  },
  {
   "id": 26795,
   "key": "D1202al.txt:441",
   "file": "D1202al.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３つの攻撃を、ケンダマ一つで捌くクラウディウス。",
   "ko_candidate": "3개의 공격을､ 켄다마 하나로 막아내는 클라우디우스｡"
  },
  {
   "id": 26796,
   "key": "D1202al.txt:442",
   "file": "D1202al.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそんなんでいつまで保つ!?",
   "ko_candidate": "하지만 그런 식으로 언제까지 버틸 수 있을까!?"
  },
  {
   "id": 26797,
   "key": "D1202al.txt:443",
   "file": "D1202al.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザの援護を受けて、俺も偃月刀を振るう速度を限界まで上げた。",
   "ko_candidate": "엘자의 지원을 받아､ 나도 언월도를 휘두르는 속도를 한계까지 올렸다｡"
  },
  {
   "id": 26798,
   "key": "D1202al.txt:449",
   "file": "D1202al.txt",
   "line": 449,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「チィィィィィ！」",
   "ko_candidate": "「치이이이이이!」"
  },
  {
   "id": 26799,
   "key": "D1202al.txt:453",
   "file": "D1202al.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だんだんクラウディウスの動きが鈍くなる",
   "ko_candidate": "점점 클라우디우스의 움직임이 둔해진다―― 찬스다!"
  },
  {
   "id": 26800,
   "key": "D1202al.txt:454",
   "file": "D1202al.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――チャンスだ！ 俺は偃月刀を弾かれた勢いもそのままに身体を回転させ、遠心力のついた必殺の一撃を解き放つ！",
   "ko_candidate": "나는 언월도가 튕겨진 기세 그대로 몸을 회전시켜､{SE_PLAY(1,\"갖郎かわす\",0,85,false);}원심력이 실린 필살의 일격을 해방한다!"
  },
  {
   "id": 26801,
   "key": "D1202al.txt:468",
   "file": "D1202al.txt",
   "line": 468,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はぁぁぁぁぁぁぁぁぁぁっ！」",
   "ko_candidate": "「하아아아아아아아아아앗!」"
  },
  {
   "id": 26802,
   "key": "D1202al.txt:472",
   "file": "D1202al.txt",
   "line": 472,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「バカか！ んな大雑把な動き……ぐぶっ！」",
   "ko_candidate": "「바보냐! 그런 대충한 움직임……{SE_PLAY(1,\"갖郎Mキック뿡中\",0,85,false);}그붓!」"
  },
  {
   "id": 26803,
   "key": "D1202al.txt:482",
   "file": "D1202al.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺のオーバーアクションに気を取られた隙を突いて、エルザが踵落としを放った。",
   "ko_candidate": "내 오버액션에 정신이 팔린 틈을 타서､ 엘자가 발꿈치 내리찍기를 날렸다｡"
  },
  {
   "id": 26804,
   "key": "D1202al.txt:483",
   "file": "D1202al.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの肩に、踵がめり込む。",
   "ko_candidate": "클라우디우스의 어깨에､ 발꿈치가 박힌다｡"
  },
  {
   "id": 26805,
   "key": "D1202al.txt:484",
   "file": "D1202al.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これで――お終いだ！",
   "ko_candidate": "이걸로―― 끝이다!"
  },
  {
   "id": 26806,
   "key": "D1202al.txt:496",
   "file": "D1202al.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀の一撃がクラウディウスの首を刎ねると思った、その一瞬だった。",
   "ko_candidate": "언월도의 일격이 클라우디우스의 목을 베어낼 거라고 생각한､ 그 순간이었다｡"
  },
  {
   "id": 26807,
   "key": "D1202al.txt:503",
   "file": "D1202al.txt",
   "line": 503,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ッッ!?　消え――!?」",
   "ko_candidate": "「읏!? 사라――!?」"
  },
  {
   "id": 26808,
   "key": "D1202al.txt:506",
   "file": "D1202al.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処に行った!?",
   "ko_candidate": "어디로 갔지!?"
  },
  {
   "id": 26809,
   "key": "D1202al.txt:510",
   "file": "D1202al.txt",
   "line": 510,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……結局マギウスでもねえ、てめえの動きなんざその程度だよ」",
   "ko_candidate": "「……결국 마기우스도 아니고､ 네놈의 움직임이란 게 그 정도구나」"
  },
  {
   "id": 26810,
   "key": "D1202al.txt:514",
   "file": "D1202al.txt",
   "line": 514,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッッ!?」",
   "ko_candidate": "「…………읏!?」"
  },
  {
   "id": 26811,
   "key": "D1202al.txt:517",
   "file": "D1202al.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声が聴こえてきた方を向いて、言葉を失った。",
   "ko_candidate": "목소리가 들려온 쪽을 향해､ 말을 잃었다｡"
  },
  {
   "id": 26812,
   "key": "D1202al.txt:518",
   "file": "D1202al.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り切った偃月刀の上――クラウディウスが爪先立ちで立っている！",
   "ko_candidate": "휘두른 언월도 위에―― 클라우디우스가 발끝으로 서 있다!"
  },
  {
   "id": 26813,
   "key": "D1202al.txt:520",
   "file": "D1202al.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかも、刀を持つ俺には まったく重さを感じさせなかった。",
   "ko_candidate": "게다가､ 칼을 든 나에게는 전혀 무게를 느끼게 하지 않았다｡"
  },
  {
   "id": 26814,
   "key": "D1202al.txt:522",
   "file": "D1202al.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なんて奴だっ！",
   "ko_candidate": "뭐야 이 녀석!"
  },
  {
   "id": 26815,
   "key": "D1202al.txt:526",
   "file": "D1202al.txt",
   "line": 526,
   "speaker": "クラウディウス / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「蝿が止まるっつーのか、こーゆーのって？ おらぁぁぁぁ！　おままごとは終わりなんだよ！」 「がああああっ！」",
   "ko_candidate": "「파리가 앉는다는 게､ 이런 거냐? {SE_PLAY(1,\"カマイタチ츠젼\",0,85,false);} 오라아아아아! 소꿉놀이는 끝난 거야!」"
  },
  {
   "id": 26816,
   "key": "D1202al.txt:545",
   "file": "D1202al.txt",
   "line": 545,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ダーリン!? きゃああああああ！」",
   "ko_candidate": "「가아아아앗!」 「달링!? 꺄아아아아아아!」"
  },
  {
   "id": 26817,
   "key": "D1202al.txt:556",
   "file": "D1202al.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの全身から吹き出した烈風が、俺とエルザを弾き飛ばす。",
   "ko_candidate": "클라우디우스의 전신에서 뿜어져 나온 열풍이､ 나와 엘자를 튕겨 날린다｡"
  },
  {
   "id": 26818,
   "key": "D1202al.txt:558",
   "file": "D1202al.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同時に放たれた無数のカマイタチが、俺たちの身体を何度も切り刻んだ。",
   "ko_candidate": "동시에 쏘아진 무수한 카마이타치가､ 우리의 몸을 여러 번 베어냈다｡"
  },
  {
   "id": 26819,
   "key": "D1202al.txt:560",
   "file": "D1202al.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "吹き飛ばされ壁に激突した衝撃と、全身に負った裂傷の痛みで、身体が言うことを聞かない……！",
   "ko_candidate": "날아가 벽에 부딪힌 충격과､ 전신에 입은 열상의 고통으로､ 몸이 말을 듣지 않는다……!"
  },
  {
   "id": 26820,
   "key": "D1202al.txt:566",
   "file": "D1202al.txt",
   "line": 566,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おら……こんなもんじゃ済まさねえぞ。刻んで刻んでミンチにしてやるよッ！」",
   "ko_candidate": "「이봐……이 정도로는 끝나지 않을 거야｡ 잘게 잘게 다져서 다진 고기로 만들어 주지､ 임포 자식!」"
  },
  {
   "id": 26821,
   "key": "D1202al.txt:569",
   "file": "D1202al.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "くっ……！",
   "ko_candidate": "큿……!"
  },
  {
   "id": 26822,
   "key": "D1202al.txt:570",
   "file": "D1202al.txt",
   "line": 570,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力の入らない四肢を踏ん張らせて、何とか立ち上がろうとする俺を、クラウディウスは小馬鹿にした視線で見下していた。",
   "ko_candidate": "힘이 들어가지 않는 사지를 버티게 해서､ 어떻게든 일어나려는 나를､ 클라우디우스는 얕잡아보는 시선으로 내려다보고 있었다｡"
  },
  {
   "id": 26823,
   "key": "D1202al.txt:576",
   "file": "D1202al.txt",
   "line": 576,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「無駄な足掻きは止めろっつーの！」",
   "ko_candidate": "「쓸데없는 발버둥은 그만두라고!」"
  },
  {
   "id": 26824,
   "key": "D1202al.txt:587",
   "file": "D1202al.txt",
   "line": 587,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「がああああっ！」",
   "ko_candidate": "「가아아아앗!」"
  },
  {
   "id": 26825,
   "key": "D1202al.txt:590",
   "file": "D1202al.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ベーゴマで両腕を撃たれ、 俺は顔から床に突っ込んで倒れた。",
   "ko_candidate": "팽이로 양팔을 맞고､ 나는 얼굴부터 바닥에 처박혀 쓰러졌다｡"
  },
  {
   "id": 26826,
   "key": "D1202al.txt:592",
   "file": "D1202al.txt",
   "line": 592,
   "speaker": "クラウディウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラウディウスの嗤い声が響く。 「ヒャハハハハッ！　でもこれで辻褄が合ったぜ」",
   "ko_candidate": "클라우디우스의 비웃음소리가 울린다｡"
  }
 ]
}