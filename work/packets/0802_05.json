   "line": 380,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……ウィンフィールド様？」",
   "ko_candidate": "「……총수가 되신 다이쥬지님이라…」"
