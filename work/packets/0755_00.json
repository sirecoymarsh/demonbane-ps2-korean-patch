 "items": [
  {
   "id": 11578,
   "key": "D0755.txt:34",
   "file": "D0755.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "――――。",
   "ko_candidate": ""
  },
  {
   "id": 11579,
   "key": "D0755.txt:37",
   "file": "D0755.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "光が止むと、俺は再びあの回廊にいた。だが意識には未だ、あの冥い森を消し去った閃光が灼きついたままだ。",
   "ko_candidate": ""
  },
  {
   "id": 11580,
   "key": "D0755.txt:40",
   "file": "D0755.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "クトゥグアの力。",
   "ko_candidate": ""
  },
  {
   "id": 11581,
   "key": "D0755.txt:41",
   "file": "D0755.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それ自体はインスマウスの件で充分に知っている。",
   "ko_candidate": ""
  },
  {
   "id": 11582,
   "key": "D0755.txt:44",
   "file": "D0755.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だが今の光景は。",
   "ko_candidate": ""
  },
  {
   "id": 11583,
   "key": "D0755.txt:45",
   "file": "D0755.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの冥い森を揺るがす強壮なる闇黒は何だったのか。",
   "ko_candidate": ""
  },
  {
   "id": 11584,
   "key": "D0755.txt:54",
   "file": "D0755.txt",
   "line": 54,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「Ny■■ら■■■t■ぷ」",
   "ko_candidate": ""
  },
  {
   "id": 11585,
   "key": "D0755.txt:60",
   "file": "D0755.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "クトゥグアが人間の言葉ではない、異質な単語を口にした。",
   "ko_candidate": ""
  },
  {
   "id": 11586,
   "key": "D0755.txt:63",
   "file": "D0755.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だがそれは電波のノイズのようなものに遮られ、はっきりとは聴こえない。",
   "ko_candidate": ""
  },
  {
   "id": 11587,
   "key": "D0755.txt:72",
   "file": "D0755.txt",
   "line": 72,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ふん……検閲か、早いな。そろそろ此処にも白血球プログラムが押し寄せてくる」",
   "ko_candidate": ""
  },
  {
   "id": 11588,
   "key": "D0755.txt:78",
   "file": "D0755.txt",
   "line": 78,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――検閲？」",
   "ko_candidate": ""
  },
  {
   "id": 11589,
   "key": "D0755.txt:80",
   "file": "D0755.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何の話だと問いただそうとしたその時だった。",
   "ko_candidate": ""
  },
  {
   "id": 11590,
   "key": "D0755.txt:101",
   "file": "D0755.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "前方で焔が爆ぜた。",
   "ko_candidate": ""
  },
  {
   "id": 11591,
   "key": "D0755.txt:102",
   "file": "D0755.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "白い劫火の向こうから、冷たい光が奔る。",
   "ko_candidate": ""
  },
  {
   "id": 11592,
   "key": "D0755.txt:108",
   "file": "D0755.txt",
   "line": 108,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「イタクァ？ ……術式を灼き切れなかったか」",
   "ko_candidate": ""
  },
  {
   "id": 11593,
   "key": "D0755.txt:124",
   "file": "D0755.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "焔から飛び出たイタクァは女性体ではなく、氷のドラゴンの姿だった。",
   "ko_candidate": ""
  },
  {
   "id": 11594,
   "key": "D0755.txt:126",
   "file": "D0755.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "翼を広げ、烈風を引き連れ、飛翔する。",
   "ko_candidate": ""
  },
  {
   "id": 11595,
   "key": "D0755.txt:127",
   "file": "D0755.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "開け放たれた顎の標的は俺だった。",
   "ko_candidate": ""
  },
  {
   "id": 11596,
   "key": "D0755.txt:133",
   "file": "D0755.txt",
   "line": 133,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――」",
   "ko_candidate": ""
  },
  {
   "id": 11597,
   "key": "D0755.txt:137",
   "file": "D0755.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その牙で俺を引き裂くのに、瞬きほどの時間も必要としないだろう。",
   "ko_candidate": ""
  },
  {
   "id": 11598,
   "key": "D0755.txt:140",
   "file": "D0755.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それなのに俺は酷く落ち着いていた。",
   "ko_candidate": ""
  },
  {
   "id": 11599,
   "key": "D0755.txt:141",
   "file": "D0755.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "迫るイタクァに向かい、右手を突き出す。",
   "ko_candidate": ""
  },
  {
   "id": 11600,
   "key": "D0755.txt:147",
   "file": "D0755.txt",
   "line": 147,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……ほう」",
   "ko_candidate": ""
  },
  {
   "id": 11601,
   "key": "D0755.txt:161",
   "file": "D0755.txt",
   "line": 161,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そうだ。それで良い。我が主よ」",
   "ko_candidate": ""
  },
  {
   "id": 11602,
   "key": "D0755.txt:166",
   "file": "D0755.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "加速する意識の中を、加速する術式が奔る。",
   "ko_candidate": ""
  },
  {
   "id": 11603,
   "key": "D0755.txt:167",
   "file": "D0755.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "複雑な法則を内包された式は圧縮され、瞬時に世界を書き換え、顕現する。",
   "ko_candidate": ""
  },
  {
   "id": 11604,
   "key": "D0755.txt:170",
   "file": "D0755.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "クトゥグアの躰から焔が噴き出した。",
   "ko_candidate": ""
  },
  {
   "id": 11605,
   "key": "D0755.txt:184",
   "file": "D0755.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "焔は螺旋を描き、光り輝き、魔術文字となって崩れ、今度は二重螺旋を描いて俺の掌に集束、結晶する。",
   "ko_candidate": ""
  },
  {
   "id": 11606,
   "key": "D0755.txt:188",
   "file": "D0755.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その容は――",
   "ko_candidate": ""
  },
  {
   "id": 11607,
   "key": "D0755.txt:203",
   "file": "D0755.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァの怯む気配が伝わった。",
   "ko_candidate": ""
  },
  {
   "id": 11608,
   "key": "D0755.txt:204",
   "file": "D0755.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺の指がクトゥグアの引鉄を捉える。",
   "ko_candidate": ""
  },
  {
   "id": 11609,
   "key": "D0755.txt:226",
   "file": "D0755.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "閃光が目を灼き、『銃声』が耳を劈いた。",
   "ko_candidate": ""
  },
  {
   "id": 11610,
   "key": "D0755.txt:247",
   "file": "D0755.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "光の中で俺は、粒子になって崩れていくイタクァの姿を視た――",
   "ko_candidate": ""
  },
  {
   "id": 11611,
   "key": "D0755.txt:267",
   "file": "D0755.txt",
   "line": 267,
   "speaker": "ネロ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……破られたか」",
   "ko_candidate": ""
  },
  {
   "id": 11612,
   "key": "D0755.txt:290",
   "file": "D0755.txt",
   "line": 290,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――見事だ。白き王」",
   "ko_candidate": ""
  },
  {
   "id": 11613,
   "key": "D0755.txt:295",
   "file": "D0755.txt",
   "line": 295,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そう。 汝はそうでなければならない」",
   "ko_candidate": ""
  },
  {
   "id": 11614,
   "key": "D0755.txt:301",
   "file": "D0755.txt",
   "line": 301,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「…………」",
   "ko_candidate": ""
  },
  {
   "id": 11615,
   "key": "D0755.txt:306",
   "file": "D0755.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "クトゥグアとイタクァ。",
   "ko_candidate": ""
  },
  {
   "id": 11616,
   "key": "D0755.txt:307",
   "file": "D0755.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "２人が俺の足元に跪いている。",
   "ko_candidate": ""
  },
  {
   "id": 11617,
   "key": "D0755.txt:315",
   "file": "D0755.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "２人同時に俺の手を掴む。",
   "ko_candidate": ""
  }
