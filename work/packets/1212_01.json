 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "メタトロン": "메타트론"
 },
 "items": [
  {
   "id": 29819,
   "key": "D1212le.txt:147",
   "file": "D1212le.txt",
   "line": 147,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――っ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 29820,
   "key": "D1212le.txt:153",
   "file": "D1212le.txt",
   "line": 153,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「き、きゃあああああああ！」",
   "ko_candidate": "「끼､ 꺄아아아아아아아!」"
  },
  {
   "id": 29821,
   "key": "D1212le.txt:158",
   "file": "D1212le.txt",
   "line": 158,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な、なんだっ!?　なんなんだよぉ！」",
   "ko_candidate": "「뭐､ 뭐야!? 뭐냐고오!」"
  },
  {
   "id": 29822,
   "key": "D1212le.txt:163",
   "file": "D1212le.txt",
   "line": 163,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわああああああああんっ！」",
   "ko_candidate": "「우와아아아아아아아앙!」"
  },
  {
   "id": 29823,
   "key": "D1212le.txt:167",
   "file": "D1212le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気付いたときにはもう遅い。",
   "ko_candidate": "깨달았을 때는 이미 늦었다｡"
  },
  {
   "id": 29824,
   "key": "D1212le.txt:168",
   "file": "D1212le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斬り落とした数十本の肉の鞭。",
   "ko_candidate": "잘라낸 수십 개의 육편｡"
  },
  {
   "id": 29825,
   "key": "D1212le.txt:171",
   "file": "D1212le.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それらは各々、地面を這い、自立して動き回り、子ども達を束縛する。",
   "ko_candidate": "그것들은 각자 바닥을 기어 자립하여 움직이며 아이들을 속박한다｡"
  },
  {
   "id": 29826,
   "key": "D1212le.txt:172",
   "file": "D1212le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触手が蛇の如く、子ども達を締め上げる。",
   "ko_candidate": "촉수가 뱀처럼 아이들을 옥죄어 온다｡"
  },
  {
   "id": 29827,
   "key": "D1212le.txt:176",
   "file": "D1212le.txt",
   "line": 176,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「貴様！」",
   "ko_candidate": "「네놈!」"
  },
  {
   "id": 29828,
   "key": "D1212le.txt:182",
   "file": "D1212le.txt",
   "line": 182,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おおっとん……動かない方が良いわよん？　あんなちっちゃな子どもの首の骨ヘシ折ることくらい、ワケないんだから」",
   "ko_candidate": "「어이쿠……움직이지 않는 게 좋을 거야? 저런 작은 아이의 목뼈 부러뜨리는 건 식은 죽 먹기니까」"
  },
  {
   "id": 29829,
   "key": "D1212le.txt:187",
   "file": "D1212le.txt",
   "line": 187,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒィッ……！」",
   "ko_candidate": "「히익……!」"
  },
  {
   "id": 29830,
   "key": "D1212le.txt:190",
   "file": "D1212le.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触手が、子ども達の首に絡みつく。",
   "ko_candidate": "촉수가 아이들의 목에 감긴다｡"
  },
  {
   "id": 29831,
   "key": "D1212le.txt:191",
   "file": "D1212le.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の下でライカは歯噛みする。",
   "ko_candidate": "가면 아래에서 라이카는 이를 갈았다｡"
  },
  {
   "id": 29832,
   "key": "D1212le.txt:192",
   "file": "D1212le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人質を取られては、どうする事も出来ない。",
   "ko_candidate": "인질을 잡혔으니 어찌할 도리가 없다｡"
  },
  {
   "id": 29833,
   "key": "D1212le.txt:197",
   "file": "D1212le.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燃える屍体が、起き上がる。",
   "ko_candidate": "불타는 시체가 일어선다｡"
  },
  {
   "id": 29834,
   "key": "D1212le.txt:198",
   "file": "D1212le.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くるりと１回転。",
   "ko_candidate": "빙글 한 바퀴 돈다｡"
  },
  {
   "id": 29835,
   "key": "D1212le.txt:203",
   "file": "D1212le.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "たちまち劫火は消えて、失せた。",
   "ko_candidate": "순식간에 겁화는 사라져 버렸다｡"
  },
  {
   "id": 29836,
   "key": "D1212le.txt:204",
   "file": "D1212le.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "立ち上がったのは、焼け焦げた骸骨。",
   "ko_candidate": "일어선 것은 새까맣게 탄 해골｡"
  },
  {
   "id": 29837,
   "key": "D1212le.txt:205",
   "file": "D1212le.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顎の骨をカタカタ鳴らして、けたたましく嗤う。",
   "ko_candidate": "턱뼈를 덜컥덜컥 울리며 귀에 거슬리게 웃는다｡"
  },
  {
   "id": 29838,
   "key": "D1212le.txt:210",
   "file": "D1212le.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "指を鳴らす。",
   "ko_candidate": "손가락을 울린다｡"
  },
  {
   "id": 29839,
   "key": "D1212le.txt:211",
   "file": "D1212le.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを合図に再生が始まった。",
   "ko_candidate": "그것을 신호로 재생이 시작되었다｡"
  },
  {
   "id": 29840,
   "key": "D1212le.txt:215",
   "file": "D1212le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "胸骨の奥、がらんどうな空間に、赤黒い心臓が突如と現出する。大動脈、大静脈を生やし、細かく分岐し更に分岐し……張り巡らされる血管の網。",
   "ko_candidate": "흉골 안쪽､ 무의 공간에､ 텅 빈 곳에､ 검붉은 심장이 갑자기 나타난다｡ 대동맥､ 대정맥을 자라나게 하고 잘게 분기하고 더 분기하고……얽히고설킨 혈관의 그물｡"
  },
  {
   "id": 29841,
   "key": "D1212le.txt:217",
   "file": "D1212le.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血を送り込む。 またしても虚無から湧いてくる内臓。",
   "ko_candidate": "피를 보내 넣는다｡ 또다시 허무에서 솟아나는 내장｡"
  },
  {
   "id": 29842,
   "key": "D1212le.txt:219",
   "file": "D1212le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "内臓と骨を固めるように湧いてくる筋肉。",
   "ko_candidate": "그 주위나 뼈 주위를 굳히듯 솟아나는 근육｡"
  },
  {
   "id": 29843,
   "key": "D1212le.txt:220",
   "file": "D1212le.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅い筋肉の上を塗り潰していく皮膚。",
   "ko_candidate": "붉은 근육 위를 덮어가는 피부｡"
  },
  {
   "id": 29844,
   "key": "D1212le.txt:224",
   "file": "D1212le.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "完全な肉体が組み上がろうとした、その矢先――腐乱する。",
   "ko_candidate": "완전한 인간이 조립되려고 하고 있었다――그 찰나｡ 부패한다｡"
  },
  {
   "id": 29845,
   "key": "D1212le.txt:229",
   "file": "D1212le.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腐臭を発し、皮膚が膿み、筋肉は爛れ、肉汁が飛ぶ。剥がれ落ちる腐肉。骨を覗かせる。",
   "ko_candidate": "썩은 냄새를 풍기며 피부가 곪고 근육이 문드러지며 육즙을 튀긴다｡ 떨어져 나가는 썩은 살｡ 뼈를 들여다보게 한다｡"
  },
  {
   "id": 29846,
   "key": "D1212le.txt:232",
   "file": "D1212le.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "膿んだ皮膚の表面、爛れた肉の内側。 蟲が湧く。蛆が湧く。",
   "ko_candidate": "곪은 피부 표면､ 문드러진 살 안쪽｡ 벌레가 생긴다｡ 구더기가 생긴다｡"
  },
  {
   "id": 29847,
   "key": "D1212le.txt:234",
   "file": "D1212le.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "新鮮な身体は、だがその姿を一瞬と留めることなく腐乱した屍体と化した。",
   "ko_candidate": "완전한 인간은 그러나 그 모습을 한순간도 유지하지 못하고 부패한 시체로 변했다｡"
  },
  {
   "id": 29848,
   "key": "D1212le.txt:237",
   "file": "D1212le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "屍体が蛆の湧く両掌で顔を覆う。顔を揉みくちゃにして掻き回すようなジェスチャー。",
   "ko_candidate": "시체가 구더기가 생긴 양손으로 얼굴을 가린다｡ 얼굴을 구겨 헤집는 듯한 제스처｡"
  },
  {
   "id": 29849,
   "key": "D1212le.txt:239",
   "file": "D1212le.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手が下ろされた時は、その顔に嘲笑を浮かべる道化の仮面がはめられていた。",
   "ko_candidate": "손이 내려졌을 때는 그 얼굴에 조소를 띠는 광대의 가면이 씌워져 있었다｡"
  },
  {
   "id": 29850,
   "key": "D1212le.txt:246",
   "file": "D1212le.txt",
   "line": 246,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふぅーん？　この程度じゃ全然、殺し切れないわよぉ？」",
   "ko_candidate": "「후후운? 이 정도로는 전혀 죽일 수 없다구?」"
  },
  {
   "id": 29851,
   "key": "D1212le.txt:251",
   "file": "D1212le.txt",
   "line": 251,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「큿……!」"
  },
  {
   "id": 29852,
   "key": "D1212le.txt:255",
   "file": "D1212le.txt",
   "line": 255,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほぉぉぉら……動くんじゃないわよ……と！」",
   "ko_candidate": "「호오오오라……움직이면 안 돼……잇!」"
  },
  {
   "id": 29853,
   "key": "D1212le.txt:263",
   "file": "D1212le.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一本の巨大な鞭に束ねられた臓腑が腹を突き破り、動けないメタトロンに向かって振り下ろされた。",
   "ko_candidate": "한 묶음의 거대한 채찍으로 묶인 내장이 배를 뚫고 나와 움직일 수 없는 메타트론을 향해 내리쳐졌다｡"
  },
  {
   "id": 29854,
   "key": "D1212le.txt:268",
   "file": "D1212le.txt",
   "line": 268,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃあああっ！」",
   "ko_candidate": "「꺄아아악!」"
  },
  {
   "id": 29855,
   "key": "D1212le.txt:271",
   "file": "D1212le.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃は凄まじく、その一撃でメタトロンの装甲に罅が入る。",
   "ko_candidate": "충격은 엄청나서 그 일격으로 메타트론의 장갑에 금이 간다｡"
  },
  {
   "id": 29856,
   "key": "D1212le.txt:283",
   "file": "D1212le.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に２度、３度。",
   "ko_candidate": "더욱이 2번､ 3번｡"
  },
  {
   "id": 29857,
   "key": "D1212le.txt:284",
   "file": "D1212le.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面が砕け、装甲が剥がれ落ち、ライカはその場に崩れ落ちた。",
   "ko_candidate": "가면이 부서지고 장갑이 벗겨져 떨어지며 라이카는 그 자리에 쓰러졌다｡"
  },
  {
   "id": 29858,
   "key": "D1212le.txt:287",
   "file": "D1212le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "額が割れ、新しい傷から血を吹く。",
   "ko_candidate": "이마가 갈라져 새로운 상처에서 피를 뿜는다｡"
  }
 ]
}