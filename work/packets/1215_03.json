 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ハンティング・ホラー": "헌팅 호러",
  "ライカ": "라이카",
  "ロードビヤーキー": "로드 비야키",
  "魔力": "마력",
  "大十字九郎": "다이쥬지 쿠로",
  "メタトロン": "메타트론",
  "九郎ちゃん": "쿠로 군",
  "鬼械神": "귀계신",
  "ドクター・ウェスト": "닥터 웨스트"
 },
 "items": [
  {
   "id": 30400,
   "key": "D1215le.txt:441",
   "file": "D1215le.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが攻撃が激化すれば、その分、速く巧みに、ハンティング・ホラーを操るだけのことだった。",
   "ko_candidate": "하지만 공격이 격화되면 그만큼 빠르고 교묘하게 헌팅 호러를 조종할 뿐이었다｡"
  },
  {
   "id": 30401,
   "key": "D1215le.txt:442",
   "file": "D1215le.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの操縦はキレを増していく。",
   "ko_candidate": "라이카 씨의 조종은 날카로워진다｡"
  },
  {
   "id": 30402,
   "key": "D1215le.txt:447",
   "file": "D1215le.txt",
   "line": 447,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――ふふ」",
   "ko_candidate": "「--후후」"
  },
  {
   "id": 30403,
   "key": "D1215le.txt:450",
   "file": "D1215le.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄く、不敵に嗤うライカさんの貌を背後から盗み見た。",
   "ko_candidate": "희미하게 불경스럽게 웃는 라이카 씨의 얼굴을 뒤에서 훔쳐봤다｡"
  },
  {
   "id": 30404,
   "key": "D1215le.txt:452",
   "file": "D1215le.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "獲物を追い詰める獣の悦びが、伝播していた。",
   "ko_candidate": "사냥감을 몰아세우는 짐승의 기쁨이 전해졌다｡"
  },
  {
   "id": 30405,
   "key": "D1215le.txt:453",
   "file": "D1215le.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その冷笑に、先ほど感じた不安が、より濃く胸にわだかまる。",
   "ko_candidate": "그 냉소에 아까 느낀 불안이 더욱 짙게 가슴에 맺힌다｡"
  },
  {
   "id": 30406,
   "key": "D1215le.txt:456",
   "file": "D1215le.txt",
   "line": 456,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もはや慣性の法則を無視した動きで、ハンティング・ホラーは疾走する。",
   "ko_candidate": "이제 관성의 법칙을 무시한 움직임으로 헌팅 호러는 질주한다｡"
  },
  {
   "id": 30407,
   "key": "D1215le.txt:457",
   "file": "D1215le.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "徐々に、焦らすように、ロードビヤーキーに接近する。",
   "ko_candidate": "서서히､ 초조하게 만들듯이 로드 비야키에 접근한다｡"
  },
  {
   "id": 30408,
   "key": "D1215le.txt:463",
   "file": "D1215le.txt",
   "line": 463,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「堕あぁあアアぁぁあああ！」",
   "ko_candidate": "「떨어져어어어어어어어!」"
  },
  {
   "id": 30409,
   "key": "D1215le.txt:466",
   "file": "D1215le.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ピント外れの一撃が撃たれたところで、ハンティング・ホラーの動きが急変した。",
   "ko_candidate": "초점이 맞지 않는 일격이 발사된 순간､ 헌팅 호러의 움직임이 급변했다｡"
  },
  {
   "id": 30410,
   "key": "D1215le.txt:471",
   "file": "D1215le.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は知覚を順応させている暇もない。",
   "ko_candidate": "이번에는 지각을 적응시킬 여유도 없다｡"
  },
  {
   "id": 30411,
   "key": "D1215le.txt:477",
   "file": "D1215le.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気付けば衝撃。ロードビヤーキーのライフルを粉砕していた。",
   "ko_candidate": "정신을 차려보니 충격｡ 로드 비야키의 라이플을 분쇄하고 있었다｡"
  },
  {
   "id": 30412,
   "key": "D1215le.txt:478",
   "file": "D1215le.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "残留していた魔力弾が暴発し、閃光がロードビヤーキーを包み込む。",
   "ko_candidate": "남아있던 마력탄이 폭발하며 섬광이 로드 비야키를 감싼다｡"
  },
  {
   "id": 30413,
   "key": "D1215le.txt:479",
   "file": "D1215le.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音が虚空に轟いた。",
   "ko_candidate": "폭음이 허공에 울려 퍼졌다｡"
  },
  {
   "id": 30414,
   "key": "D1215le.txt:487",
   "file": "D1215le.txt",
   "line": 487,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ギギャアアアアア！　あ……あ……ああ……！ 大十字九郎！　メタトロン！」",
   "ko_candidate": "「기기야아아아아! 아… 아… 아아…! 다이쥬지 쿠로! 메타트론!」"
  },
  {
   "id": 30415,
   "key": "D1215le.txt:491",
   "file": "D1215le.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その暴発でロードビヤーキーの右腕が吹き飛んだ。",
   "ko_candidate": "그 폭발로 로드 비야키의 오른팔이 날아갔다｡"
  },
  {
   "id": 30416,
   "key": "D1215le.txt:492",
   "file": "D1215le.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "千切れたワイヤーを波打たせて、死んだ街の闇に飲み込まれるように右腕は墜ちる。",
   "ko_candidate": "끊어진 와이어를 파도치듯 휘날리며 죽은 거리의 어둠에 삼켜지듯 오른팔이 떨어진다｡"
  },
  {
   "id": 30417,
   "key": "D1215le.txt:499",
   "file": "D1215le.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ドーンと墜落音。",
   "ko_candidate": "쿵 하고 추락 소리｡"
  },
  {
   "id": 30418,
   "key": "D1215le.txt:500",
   "file": "D1215le.txt",
   "line": 500,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫を巻き上げる、盛大な土煙が上がった。",
   "ko_candidate": "잔해를 휘감는 성대한 먼지 구름이 올라왔다｡"
  },
  {
   "id": 30419,
   "key": "D1215le.txt:507",
   "file": "D1215le.txt",
   "line": 507,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃん……一気に行くよ」",
   "ko_candidate": "「쿠로 군… 단숨에 갈게」"
  },
  {
   "id": 30420,
   "key": "D1215le.txt:512",
   "file": "D1215le.txt",
   "line": 512,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？　……うぐぐぐぅぅああ!?」",
   "ko_candidate": "「엣? …우구구구우우아아!?」"
  },
  {
   "id": 30421,
   "key": "D1215le.txt:514",
   "file": "D1215le.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても、動体視力を遥かに超越した走行に突入する。",
   "ko_candidate": "또다시 동체시력을 훨씬 뛰어넘는 주행에 돌입한다｡"
  },
  {
   "id": 30422,
   "key": "D1215le.txt:515",
   "file": "D1215le.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――今回は辛うじて感覚の加速が間に合った。",
   "ko_candidate": "--이번에는 간신히 감각의 가속이 따라잡았다｡"
  },
  {
   "id": 30423,
   "key": "D1215le.txt:516",
   "file": "D1215le.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だからしっかりとこの眼で捉え、躰で感じ取る。",
   "ko_candidate": "그래서 확실히 이 눈으로 포착하고 몸으로 느낀다｡"
  },
  {
   "id": 30424,
   "key": "D1215le.txt:521",
   "file": "D1215le.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "前方から右肩を貫通する。",
   "ko_candidate": "전방에서 오른쪽 어깨를 관통한다｡"
  },
  {
   "id": 30425,
   "key": "D1215le.txt:522",
   "file": "D1215le.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "後方より左腕を引き千切る。",
   "ko_candidate": "후방에서 왼팔을 잡아뜯는다｡"
  },
  {
   "id": 30426,
   "key": "D1215le.txt:529",
   "file": "D1215le.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左腕が墜ちるよりも速く、両脚を引き裂く。",
   "ko_candidate": "왼팔이 떨어지기도 전에 양 다리를 찢어버린다｡"
  },
  {
   "id": 30427,
   "key": "D1215le.txt:530",
   "file": "D1215le.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "首を貫通する。もう一度。",
   "ko_candidate": "목을 관통한다｡ 한 번 더｡"
  },
  {
   "id": 30428,
   "key": "D1215le.txt:531",
   "file": "D1215le.txt",
   "line": 531,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳ねられた首が宙を舞う。",
   "ko_candidate": "튕겨진 머리가 허공을 날아다닌다｡"
  },
  {
   "id": 30429,
   "key": "D1215le.txt:533",
   "file": "D1215le.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腹部を貫く。１回。２回。３回。４回。５、６、７、８、９、１０――",
   "ko_candidate": "복부를 관통한다｡ 1회｡ 2회｡ 3회｡ 4회｡ 5､ 6､ 7､ 8､ 9､ 10--"
  },
  {
   "id": 30430,
   "key": "D1215le.txt:535",
   "file": "D1215le.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何度も鬼械神の基部を抉った。",
   "ko_candidate": "몇 번이고 귀계신의 기부를 파냈다｡"
  },
  {
   "id": 30431,
   "key": "D1215le.txt:536",
   "file": "D1215le.txt",
   "line": 536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水銀が噴き出すよりも遥かに速く、機体を貫通し、表に出た。",
   "ko_candidate": "수은이 뿜어져 나오기도 전에 훨씬 빠르게 기체를 관통하고 표면으로 나왔다｡"
  },
  {
   "id": 30432,
   "key": "D1215le.txt:538",
   "file": "D1215le.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "骨格フレームを粉砕した。",
   "ko_candidate": "골격 프레임을 분쇄했다｡"
  },
  {
   "id": 30433,
   "key": "D1215le.txt:539",
   "file": "D1215le.txt",
   "line": 539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このちっぽけな暴力の前に、鬼械神が手も足も出せない。",
   "ko_candidate": "이 조그마한 폭력 앞에 귀계신이 손도 발도 못 쓴다｡"
  },
  {
   "id": 30434,
   "key": "D1215le.txt:541",
   "file": "D1215le.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "信じ難い光景だった。",
   "ko_candidate": "믿기 힘든 광경이었다｡"
  },
  {
   "id": 30435,
   "key": "D1215le.txt:542",
   "file": "D1215le.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いくらドクター・ウェストの自信作とはいえ……これは異常すぎる！",
   "ko_candidate": "아무리 닥터 웨스트의 자신작이라고 해도… 이건 너무 비정상적이야!"
  },
  {
   "id": 30436,
   "key": "D1215le.txt:545",
   "file": "D1215le.txt",
   "line": 545,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が慄いている間にも、凌辱は続く。",
   "ko_candidate": "내가 전율하는 동안에도 능욕은 계속된다｡"
  },
  {
   "id": 30437,
   "key": "D1215le.txt:547",
   "file": "D1215le.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何度も何度も何度も何度も何度も貫き、蹂躙し、鬼械神はただの鉄屑と化していく。",
   "ko_candidate": "몇 번이고 몇 번이고 몇 번이고 몇 번이고 몇 번이고 꿰뚫고 유린하며 귀계신은 그저 고철 덩어리로 변해간다｡"
  },
  {
   "id": 30438,
   "key": "D1215le.txt:549",
   "file": "D1215le.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕けた魔導金属と機械の破片と水銀が舞う闇を、自らが発する光で引き裂き、疾走するハンティング・ホラーの姿は、夢幻じみていた。",
   "ko_candidate": "부서진 마도금속과 기계의 파편과 수은이 날아다니는 어둠을､ 스스로 발하는 빛으로 가르며 질주하는 헌팅 호러의 모습은 몽환적이었다｡"
  },
  {
   "id": 30439,
   "key": "D1215le.txt:551",
   "file": "D1215le.txt",
   "line": 551,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悪夢じみていた。",
   "ko_candidate": "악몽 같았다｡"
  }
 ]
}