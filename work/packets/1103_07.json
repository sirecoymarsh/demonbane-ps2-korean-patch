 "items": [
  {
   "id": 23008,
   "key": "D1103le.txt:596",
   "file": "D1103le.txt",
   "line": 596,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガァァァァァァァァァッッッッ！」",
   "ko_candidate": "라이카 씨와―― 산달폰이｡ 「류가아아아아아아아아앗!」"
  },
  {
   "id": 23009,
   "key": "D1103le.txt:601",
   "file": "D1103le.txt",
   "line": 601,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "激昂の叫びと共に、右腕のビーム砲を突きつける。",
   "ko_candidate": "격앙된 외침과 함께 오른팔의 빔포를 들이댄다｡"
  },
  {
   "id": 23010,
   "key": "D1103le.txt:605",
   "file": "D1103le.txt",
   "line": 605,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砲口を真っ直ぐに見つめて、サンダルフォンは笑う。",
   "ko_candidate": "포구를 똑바로 바라보며 산달폰은 웃는다｡"
  },
  {
   "id": 23011,
   "key": "D1103le.txt:606",
   "file": "D1103le.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "低い声で。重い声で。暗い声で。",
   "ko_candidate": "낮은 목소리로｡ 무거운 목소리로｡ 어두운 목소리로｡"
  },
  {
   "id": 23012,
   "key": "D1103le.txt:607",
   "file": "D1103le.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "人間としてのタガが外れた、鬼の聲で。 嘲笑する。",
   "ko_candidate": "인간으로서의 한계를 벗어난 귀신의 목소리로｡"
  },
  {
   "id": 23013,
   "key": "D1103le.txt:610",
   "file": "D1103le.txt",
   "line": 610,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "哄笑する。",
   "ko_candidate": "조소한다｡"
  },
  {
   "id": 23014,
   "key": "D1103le.txt:611",
   "file": "D1103le.txt",
   "line": 611,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂笑する。",
   "ko_candidate": "폭소한다｡"
  },
  {
   "id": 23015,
   "key": "D1103le.txt:615",
   "file": "D1103le.txt",
   "line": 615,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだ！　それが貴様だ、メタトロン！　いや、ライカ・クルセイド！」 「あの時も、 貴様は己に殺意を向けた！」",
   "ko_candidate": "광소한다｡"
  },
  {
   "id": 23016,
   "key": "D1103le.txt:622",
   "file": "D1103le.txt",
   "line": 622,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「逃げ延びる為に！　生き延びる為に！ 総てを裏切ったのだ！」 「そうだ！　そうだとも！　己は決して忘れはしない！　貴様の冷酷な殺意を忘れはしない！　貴様の昏い渇望を忘れはしない！　己は……己は……」",
   "ko_candidate": "「그래! 그게 네 놈이다､ 메타트론! 아니､ 라이카 크루세이드! 그때도 네 놈은 나에게 살의를 품었지! 도망치기 위해서! 살아남기 위해서! 모든 것을 배신했다! 그래! 그렇다고! 나는 결코 잊지 않을 것이다! 네놈의 냉혹한 살의를 잊지 않을 것이다! 네놈의 어두운 갈망을 잊지 않을 것이다! 나는… 나는…」"
  },
  {
   "id": 23017,
   "key": "D1103le.txt:629",
   "file": "D1103le.txt",
   "line": 629,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右目の上を横断する傷痕を撫でる。",
   "ko_candidate": "오른쪽 눈 위를 가로지르는 상처를 쓰다듬는다｡"
  },
  {
   "id": 23018,
   "key": "D1103le.txt:633",
   "file": "D1103le.txt",
   "line": 633,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「己を殺した貴様を忘れはしない！」",
   "ko_candidate": "「나를 죽인 네놈을 잊지 않을 것이다!」"
  },
  {
   "id": 23019,
   "key": "D1103le.txt:638",
   "file": "D1103le.txt",
   "line": 638,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわぁぁぁぁぁぁぁぁぁぁぁ！」",
   "ko_candidate": "「우와아아아아아아아아아아아아아!」"
  },
  {
   "id": 23020,
   "key": "D1103le.txt:642",
   "file": "D1103le.txt",
   "line": 642,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄暗闇を裂いて、一筋の光が狂天使を撃つ。",
   "ko_candidate": "어스름한 어둠을 가르며､ 한 줄기 빛이 광천사를 쏘아 맞춘다｡"
  },
  {
   "id": 23021,
   "key": "D1103le.txt:646",
   "file": "D1103le.txt",
   "line": 646,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避けようともせず、真っ向からそれを受け止めるリューガ。",
   "ko_candidate": "피하려고도 하지 않고､ 정면으로 그것을 받아들이는 류가｡"
  },
  {
   "id": 23022,
   "key": "D1103le.txt:651",
   "file": "D1103le.txt",
   "line": 651,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い装甲の上で破壊の光が爆ぜて、躍る。",
   "ko_candidate": "검은 장갑 위에서 파괴의 빛이 터져 춤춘다｡"
  },
  {
   "id": 23023,
   "key": "D1103le.txt:655",
   "file": "D1103le.txt",
   "line": 655,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハハハハハハハハハッ！」",
   "ko_candidate": "「하하하하하하하하핫!」"
  },
  {
   "id": 23024,
   "key": "D1103le.txt:658",
   "file": "D1103le.txt",
   "line": 658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームを浴びながら、それに全く怯む事なく、腰を沈め、右脇に拳を添える。",
   "ko_candidate": "빔을 맞으면서도､ 전혀 주눅 들지 않고､ 허리를 낮추고､ 오른쪽 겨드랑이에 주먹을 댄다｡"
  },
  {
   "id": 23025,
   "key": "D1103le.txt:660",
   "file": "D1103le.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何やら強大な気配が、リューガの体内を渦巻き拳に収縮していく。",
   "ko_candidate": "무언가 강대한 기운이 류가의 체내를 소용돌이치며 주먹으로 수축해 간다｡"
  },
  {
   "id": 23026,
   "key": "D1103le.txt:662",
   "file": "D1103le.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ものすげぇ、やばそうだ。",
   "ko_candidate": "엄청나게 위험해 보인다｡"
  },
  {
   "id": 23027,
   "key": "D1103le.txt:665",
   "file": "D1103le.txt",
   "line": 665,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそっ！」",
   "ko_candidate": "「젠장!」"
  },
  {
   "id": 23028,
   "key": "D1103le.txt:671",
   "file": "D1103le.txt",
   "line": 671,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアを抜く。",
   "ko_candidate": "크투가를 뽑는다｡"
  },
  {
   "id": 23029,
   "key": "D1103le.txt:673",
   "file": "D1103le.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・スタイルになれない状態で撃っても、通用しそうにないが……気を散らすくらいにはなるだろう。",
   "ko_candidate": "마기우스 스타일이 되지 않은 상태로 쏴도 통할 것 같지 않지만… 주의를 분산시키는 정도는 될 것이다｡"
  },
  {
   "id": 23030,
   "key": "D1103le.txt:675",
   "file": "D1103le.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剥き出しの顔を狙って、引鉄を引く。",
   "ko_candidate": "드러난 얼굴을 겨냥해 방아쇠를 당긴다｡"
  },
  {
   "id": 23031,
   "key": "D1103le.txt:686",
   "file": "D1103le.txt",
   "line": 686,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「つっ……！」",
   "ko_candidate": "「츳…!」"
  },
  {
   "id": 23032,
   "key": "D1103le.txt:690",
   "file": "D1103le.txt",
   "line": 690,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紙一重のところでかわされた。リューガの頬に薄っすらと血が伝う。",
   "ko_candidate": "아슬아슬하게 피했다｡ 류가의 뺨에 희미하게 피가 흐른다｡"
  },
  {
   "id": 23033,
   "key": "D1103le.txt:691",
   "file": "D1103le.txt",
   "line": 691,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間を置かず第２射目。",
   "ko_candidate": "잠시 후 두 번째 사격｡"
  },
  {
   "id": 23034,
   "key": "D1103le.txt:695",
   "file": "D1103le.txt",
   "line": 695,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "またしてもギリギリでかわされる。",
   "ko_candidate": "또다시 간신히 피한다｡"
  },
  {
   "id": 23035,
   "key": "D1103le.txt:699",
   "file": "D1103le.txt",
   "line": 699,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "第３射。またしても……と言うか、弾丸の動きを完全に見切られているじゃねえか、あの野郎っ！",
   "ko_candidate": "세 번째 사격｡ 또다시… 라기보다는､ 총알의 움직임을 완전히 간파하고 있잖아､ 그 녀석!"
  },
  {
   "id": 23036,
   "key": "D1103le.txt:704",
   "file": "D1103le.txt",
   "line": 704,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「目障りだ！」",
   "ko_candidate": "「눈에 거슬려!」"
  },
  {
   "id": 23037,
   "key": "D1103le.txt:708",
   "file": "D1103le.txt",
   "line": 708,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやら、攻撃の矛先はこっちに向いたらしい。",
   "ko_candidate": "어쩌면 공격의 화살이 이쪽으로 향한 것 같다｡"
  },
  {
   "id": 23038,
   "key": "D1103le.txt:711",
   "file": "D1103le.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガが床を蹴る――それだけで、教会全部が震動した。",
   "ko_candidate": "류가가 바닥을 박차는 것만으로도 교회 전체가 진동했다｡"
  },
  {
   "id": 23039,
   "key": "D1103le.txt:712",
   "file": "D1103le.txt",
   "line": 712,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして瞬く暇もない一瞬で、奴は俺の懐に飛び込んでくる……！",
   "ko_candidate": "그리고 눈 깜짝할 사이에 그자는 내 품으로 뛰어든다…!"
  },
  {
   "id": 23040,
   "key": "D1103le.txt:716",
   "file": "D1103le.txt",
   "line": 716,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金属同士が激しく衝突する音。",
   "ko_candidate": "금속끼리 격렬하게 충돌하는 소리｡"
  },
  {
   "id": 23041,
   "key": "D1103le.txt:717",
   "file": "D1103le.txt",
   "line": 717,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火花が暗い礼拝堂を一瞬、照らす。",
   "ko_candidate": "불꽃이 어두운 예배당을 순간 비춘다｡"
  },
  {
   "id": 23042,
   "key": "D1103le.txt:719",
   "file": "D1103le.txt",
   "line": 719,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はまったく反応すら出来なかったというのに、メタトロンは間に割り込み、リューガの一撃を受け止めていた。",
   "ko_candidate": "나는 전혀 반응조차 할 수 없었는데､ 메타트론은 사이에 끼어들어 류가의 일격을 받아냈다｡"
  },
  {
   "id": 23043,
   "key": "D1103le.txt:721",
   "file": "D1103le.txt",
   "line": 721,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔が触れ合いそうなほどの近距離で、２人の天使は競り合う。",
   "ko_candidate": "얼굴이 맞닿을 듯한 근거리에서 두 천사가 겨룬다｡"
  },
  {
   "id": 23044,
   "key": "D1103le.txt:726",
   "file": "D1103le.txt",
   "line": 726,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほう……随分、必死だな。そうか、今はそいつに御執心か」",
   "ko_candidate": "「호오… 꽤나 필사적이군｡ 그렇군､ 지금은 그자에게 집착하고 있나」"
  },
  {
   "id": 23045,
   "key": "D1103le.txt:730",
   "file": "D1103le.txt",
   "line": 730,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう訊ねるリューガの表情は穏やかだ。",
   "ko_candidate": "그렇게 묻는 류가의 표정은 온화하다｡"
  },
  {
   "id": 23046,
   "key": "D1103le.txt:731",
   "file": "D1103le.txt",
   "line": 731,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さっきまで狂笑していた男と同じ人物だとは思えない。",
   "ko_candidate": "방금 전까지 광소를 지었던 남자와 같은 사람이라고는 생각되지 않는다｡"
  },
  {
   "id": 23047,
   "key": "D1103le.txt:733",
   "file": "D1103le.txt",
   "line": 733,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうなのだ。",
   "ko_candidate": "그렇다｡"
  }
 ]
}