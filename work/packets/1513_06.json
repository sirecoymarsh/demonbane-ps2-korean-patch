 "items": [
  {
   "id": 46788,
   "key": "D1513ru.txt:572",
   "file": "D1513ru.txt",
   "line": 572,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この滅びから、遁れられる物質は存在しない。",
   "ko_candidate": "이 멸망에서 벗어날 수 있는 물질은 존재하지 않는다｡"
  },
  {
   "id": 46789,
   "key": "D1513ru.txt:573",
   "file": "D1513ru.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "罪人の十字架の存在を、宇宙より跡形も無く抹消する。",
   "ko_candidate": "죄인의 십자가의 존재를 우주에서 흔적도 없이 지워버린다｡"
  },
  {
   "id": 46790,
   "key": "D1513ru.txt:579",
   "file": "D1513ru.txt",
   "line": 579,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何……ッ！？」",
   "ko_candidate": "「뭐……!?」"
  },
  {
   "id": 46791,
   "key": "D1513ru.txt:593",
   "file": "D1513ru.txt",
   "line": 593,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リベル・レギスは即座に十字架を手離し、昇滅に巻き込まれるのを避けた。デモンベインとの距離が大きく開く。",
   "ko_candidate": "리베르 레기스는 즉시 십자가를 놓아버리고 승멸에 휘말리는 것을 피했다｡ 데몬베인과의 거리가 크게 벌어진다｡"
  },
  {
   "id": 46792,
   "key": "D1513ru.txt:599",
   "file": "D1513ru.txt",
   "line": 599,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「小賢しい！」",
   "ko_candidate": "「영악하군!」"
  },
  {
   "id": 46793,
   "key": "D1513ru.txt:613",
   "file": "D1513ru.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リベル・レギスの腕が開き、黒い砲口が顎をのぞかせる。砲口の周囲を疾走する、魔術文字。",
   "ko_candidate": "리베르 레기스의 팔이 접혔다｡ 검은 포구가 턱을 내밀었다｡"
  },
  {
   "id": 46794,
   "key": "D1513ru.txt:621",
   "file": "D1513ru.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇の塊を吐き出した。 数は１１。",
   "ko_candidate": "포구 주위를 질주하는 마술 문자｡"
  },
  {
   "id": 46795,
   "key": "D1513ru.txt:623",
   "file": "D1513ru.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "星の光すら捻じ曲げて、闇の塊が迫る。",
   "ko_candidate": "어둠의 덩어리를 토해냈다｡ 숫자는 11｡"
  },
  {
   "id": 46796,
   "key": "D1513ru.txt:636",
   "file": "D1513ru.txt",
   "line": 636,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「重力弾だ！　捕まったら、 根こそぎ抉られるぞ！」",
   "ko_candidate": "별빛마저 비틀며 어둠의 덩어리가 다가온다｡ 「중력탄이다! 잡히면 뿌리째 뽑힐 거야!」"
  },
  {
   "id": 46797,
   "key": "D1513ru.txt:646",
   "file": "D1513ru.txt",
   "line": 646,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チ……ッ！」",
   "ko_candidate": "「치……!」"
  },
  {
   "id": 46798,
   "key": "D1513ru.txt:670",
   "file": "D1513ru.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "シャンタクを巧みに操って、重力弾を躱す躱す躱す躱す躱す躱す――防御陣を展開。五芒星形が輝く。",
   "ko_candidate": "샨타크를 능숙하게 조종하며 중력탄을 피하고 피하고 피하고 피하고 피하고―― 방어진을 전개한다｡ 오망성형이 빛난다｡"
  },
  {
   "id": 46799,
   "key": "D1513ru.txt:671",
   "file": "D1513ru.txt",
   "line": 671,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "『旧き印』を呑み込む重力弾。相殺。",
   "ko_candidate": "『엘더 사인』을 삼키는 중력탄｡ 상쇄｡"
  },
  {
   "id": 46800,
   "key": "D1513ru.txt:688",
   "file": "D1513ru.txt",
   "line": 688,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――最後の一発に捕まった。",
   "ko_candidate": "――마지막 한 발에 잡혔다｡"
  },
  {
   "id": 46801,
   "key": "D1513ru.txt:705",
   "file": "D1513ru.txt",
   "line": 705,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまった！」",
   "ko_candidate": "「아차!」"
  },
  {
   "id": 46802,
   "key": "D1513ru.txt:710",
   "file": "D1513ru.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "圧縮された重力が、デモンベインを押し潰す。",
   "ko_candidate": "압축된 중력이 데몬베인을 짓누른다｡"
  },
  {
   "id": 46803,
   "key": "D1513ru.txt:711",
   "file": "D1513ru.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "直撃は免れたものの……",
   "ko_candidate": "직격은 면했지만……"
  },
  {
   "id": 46804,
   "key": "D1513ru.txt:726",
   "file": "D1513ru.txt",
   "line": 726,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――！？」",
   "ko_candidate": "「――!?」"
  },
  {
   "id": 46805,
   "key": "D1513ru.txt:735",
   "file": "D1513ru.txt",
   "line": 735,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "シャンタクの出力が、みるみる低下する。",
   "ko_candidate": "샨타크의 출력이 눈 깜짝할 새에 떨어진다｡"
  },
  {
   "id": 46806,
   "key": "D1513ru.txt:736",
   "file": "D1513ru.txt",
   "line": 736,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "翼の一部が、重力弾によって綺麗にえぐり取られていた。これではマトモには飛べない……！",
   "ko_candidate": "날개의 일부가 중력탄에 의해 깔끔하게 도려내어졌다｡ 이래서는 제대로 날 수 없어……!"
  },
  {
   "id": 46807,
   "key": "D1513ru.txt:742",
   "file": "D1513ru.txt",
   "line": 742,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やられたか！　おのれ！」",
   "ko_candidate": "「당했나! 이런!」"
  },
  {
   "id": 46808,
   "key": "D1513ru.txt:757",
   "file": "D1513ru.txt",
   "line": 757,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「’ＥＨ－Ｙ－ＹＡ－ＹＡ－ＹＡＨＡＡＨ－Ｅ’ＹＡＹＡＹＡＡＡＡＡＡＡＡＡａａａａａａａａａａａａａａａ！」",
   "ko_candidate": "「'EH-Y-YA-YA-YAHAAH-E'YAYAYAAAAAAAAAAAaaaaaaaaaaaaaa!'」"
  },
  {
   "id": 46809,
   "key": "D1513ru.txt:771",
   "file": "D1513ru.txt",
   "line": 771,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リベル・レギスが再び突撃してきた。だがシャンタクが破壊された今、それをかわす術は無い。",
   "ko_candidate": "리베르 레기스가 다시 돌격해왔다｡ 하지만 샨타크가 파괴된 지금､ 그것을 피할 방법이 없다｡"
  },
  {
   "id": 46810,
   "key": "D1513ru.txt:776",
   "file": "D1513ru.txt",
   "line": 776,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "宇宙を奔る紅の拳が、デモンベインの顔面に突き刺さる。",
   "ko_candidate": "우주를 달리는 붉은 주먹이 데몬베인의 얼굴에 꽂힌다｡"
  },
  {
   "id": 46811,
   "key": "D1513ru.txt:799",
   "file": "D1513ru.txt",
   "line": 799,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「がっ……ぐああっ！」",
   "ko_candidate": "「윽……크아악!」"
  },
  {
   "id": 46812,
   "key": "D1513ru.txt:805",
   "file": "D1513ru.txt",
   "line": 805,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははははは！ この程度で済ますかよ！！」",
   "ko_candidate": "「아하하하하하! 이 정도로 끝낼 줄 알았나!!」"
  },
  {
   "id": 46813,
   "key": "D1513ru.txt:835",
   "file": "D1513ru.txt",
   "line": 835,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "間を置かず、連続して叩き込まれる拳、拳、拳の弾幕。あまりにも迅過ぎる乱舞。捌き切るだけで精一杯だった。",
   "ko_candidate": "간격을 두지 않고 연속해서 날아드는 주먹､ 주먹､ 주먹의 탄막｡ 너무나도 빠른 난무｡ 막아내기에 급급했다｡"
  },
  {
   "id": 46814,
   "key": "D1513ru.txt:848",
   "file": "D1513ru.txt",
   "line": 848,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "高速思考する反射神経が加熱し、脳を灼く。",
   "ko_candidate": "고속으로 사고하는 반사신경이 가열되어 뇌를 태운다｡"
  },
  {
   "id": 46815,
   "key": "D1513ru.txt:849",
   "file": "D1513ru.txt",
   "line": 849,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "血圧が上昇し、眼球の奥で毛細血管が破裂する。",
   "ko_candidate": "혈압이 상승하고 안구 속에서 모세혈관이 터진다｡"
  },
  {
   "id": 46816,
   "key": "D1513ru.txt:850",
   "file": "D1513ru.txt",
   "line": 850,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "頬を伝う熱い血涙。",
   "ko_candidate": "뺨을 타고 흐르는 뜨거운 피눈물｡"
  },
  {
   "id": 46817,
   "key": "D1513ru.txt:856",
   "file": "D1513ru.txt",
   "line": 856,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――灼熱する脳内を裂くように冷たい、それは悪寒。",
   "ko_candidate": "――작열하는 뇌 속을 가르듯 차가운､ 그것은 오한｡"
  },
  {
   "id": 46818,
   "key": "D1513ru.txt:873",
   "file": "D1513ru.txt",
   "line": 873,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスの右掌を疾走する破滅の術式。",
   "ko_candidate": "리베르 레기스의 오른손바닥을 질주하는 파멸의 술식｡"
  },
  {
   "id": 46819,
   "key": "D1513ru.txt:874",
   "file": "D1513ru.txt",
   "line": 874,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "静かに世界が停止する。 苛烈過ぎるがゆえに、白く炎える焔。",
   "ko_candidate": "조용히 세계가 정지한다｡ 너무나 격렬해 하얗게 타오르는 불꽃｡"
  },
  {
   "id": 46820,
   "key": "D1513ru.txt:888",
   "file": "D1513ru.txt",
   "line": 888,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "形作られた手刀。",
   "ko_candidate": "형성된 수도｡"
  },
  {
   "id": 46821,
   "key": "D1513ru.txt:889",
   "file": "D1513ru.txt",
   "line": 889,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶対零度を纏って、闇を裂く！",
   "ko_candidate": "절대영도를 두르고 어둠을 가른다!"
  },
  {
   "id": 46822,
   "key": "D1513ru.txt:903",
   "file": "D1513ru.txt",
   "line": 903,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハイパーボリア ・ゼロドライブ！」",
   "ko_candidate": "「하이퍼보리아 제로드라이브!」"
  },
  {
   "id": 46823,
   "key": "D1513ru.txt:919",
   "file": "D1513ru.txt",
   "line": 919,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「させるかぁぁぁぁぁぁ！」",
   "ko_candidate": "「시킬 것 같아아아아아아!」"
  },
  {
   "id": 46824,
   "key": "D1513ru.txt:934",
   "file": "D1513ru.txt",
   "line": 934,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "真横から掌底をリベル・レギスの腕に叩き込んだ。",
   "ko_candidate": "옆에서 손바닥으로 리베르 레기스의 오른팔을 내리쳤다｡"
  },
  {
   "id": 46825,
   "key": "D1513ru.txt:935",
   "file": "D1513ru.txt",
   "line": 935,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "手刀がそれて、肩をほんのわずかに掠める。",
   "ko_candidate": "오른손 수도가 빗나가 어깨를 아주 살짝 스친다｡"
  },
  {
   "id": 46826,
   "key": "D1513ru.txt:936",
   "file": "D1513ru.txt",
   "line": 936,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それだけで肩部の半分が瘴滅した。 それに次いで――",
   "ko_candidate": "그것만으로도 어깨 부분의 절반이 소멸했다｡"
  },
  {
   "id": 46827,
   "key": "D1513ru.txt:964",
   "file": "D1513ru.txt",
   "line": 964,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………あああ！」",
   "ko_candidate": "「…………아아아!」"
  }
 ]
