 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "イタクァ": "이타콰",
  "アーカムシティ": "아컴시티"
 },
 "items": [
  {
   "id": 11389,
   "key": "D0753.txt:36",
   "file": "D0753.txt",
   "line": 36,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ぐっ……」",
   "ko_candidate": ""
  },
  {
   "id": 11390,
   "key": "D0753.txt:38",
   "file": "D0753.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "後ずさりながら、身構える――身構えたところでマギウスになれない俺はどうにも無力なんだが。",
   "ko_candidate": ""
  },
  {
   "id": 11391,
   "key": "D0753.txt:41",
   "file": "D0753.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "絶望感に近い緊張感に身体が強張っていた。",
   "ko_candidate": ""
  },
  {
   "id": 11392,
   "key": "D0753.txt:42",
   "file": "D0753.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "額から伝う汗の冷たさを感じる。",
   "ko_candidate": ""
  },
  {
   "id": 11393,
   "key": "D0753.txt:46",
   "file": "D0753.txt",
   "line": 46,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「イタクァ……か」",
   "ko_candidate": ""
  },
  {
   "id": 11394,
   "key": "D0753.txt:48",
   "file": "D0753.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "目の前にあの、雲の巨人と氷の竜を模っていたイタクァがいる。",
   "ko_candidate": ""
  },
  {
   "id": 11395,
   "key": "D0753.txt:50",
   "file": "D0753.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "……気配が一緒だから、イタクァのはずだ。",
   "ko_candidate": ""
  },
  {
   "id": 11396,
   "key": "D0753.txt:53",
   "file": "D0753.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何故いちいち、そんなことを確認しなければならないのか？",
   "ko_candidate": ""
  },
  {
   "id": 11397,
   "key": "D0753.txt:56",
   "file": "D0753.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "――つまりイタクァはまた別の形態を模っているからである。",
   "ko_candidate": ""
  },
  {
   "id": 11398,
   "key": "D0753.txt:65",
   "file": "D0753.txt",
   "line": 65,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――――」",
   "ko_candidate": ""
  },
  {
   "id": 11399,
   "key": "D0753.txt:70",
   "file": "D0753.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "文字通り、クールビューティーと呼ぶべきか。",
   "ko_candidate": ""
  },
  {
   "id": 11400,
   "key": "D0753.txt:71",
   "file": "D0753.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "背筋が真っ直ぐした、スラリとした長身の美女。",
   "ko_candidate": ""
  },
  {
   "id": 11401,
   "key": "D0753.txt:74",
   "file": "D0753.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "優れた刃物のように、しなやかさと強靭さを兼ね揃えた躰。射抜くような冷たい瞳が、眼鏡の向こうで輝いている。",
   "ko_candidate": ""
  },
  {
   "id": 11402,
   "key": "D0753.txt:85",
   "file": "D0753.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "刃を突き立てるように、鋭く冷たい霊圧感。",
   "ko_candidate": ""
  },
  {
   "id": 11403,
   "key": "D0753.txt:88",
   "file": "D0753.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "くっ……やっぱりページモンスターの連中、どんどん厄介になっていくぜ。",
   "ko_candidate": ""
  },
  {
   "id": 11404,
   "key": "D0753.txt:93",
   "file": "D0753.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァが一歩足を踏み出し、俺に近寄る。",
   "ko_candidate": ""
  },
  {
   "id": 11405,
   "key": "D0753.txt:94",
   "file": "D0753.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "足許の床に霜が下りた。",
   "ko_candidate": ""
  },
  {
   "id": 11406,
   "key": "D0753.txt:97",
   "file": "D0753.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "気圧されて、俺は一歩退く。",
   "ko_candidate": ""
  },
  {
   "id": 11407,
   "key": "D0753.txt:98",
   "file": "D0753.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァがさらにもう一歩。俺も一歩下がる。",
   "ko_candidate": ""
  },
  {
   "id": 11408,
   "key": "D0753.txt:101",
   "file": "D0753.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "一歩近寄る。一歩下がる。",
   "ko_candidate": ""
  },
  {
   "id": 11409,
   "key": "D0753.txt:102",
   "file": "D0753.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それを繰り返して――背中に壁がぶつかった。",
   "ko_candidate": ""
  },
  {
   "id": 11410,
   "key": "D0753.txt:108",
   "file": "D0753.txt",
   "line": 108,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……くそ！」",
   "ko_candidate": ""
  },
  {
   "id": 11411,
   "key": "D0753.txt:111",
   "file": "D0753.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だいたいにして、ここはどこだ？",
   "ko_candidate": ""
  },
  {
   "id": 11412,
   "key": "D0753.txt:114",
   "file": "D0753.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何だか古風な石造りの回廊だった。",
   "ko_candidate": ""
  },
  {
   "id": 11413,
   "key": "D0753.txt:116",
   "file": "D0753.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "窓から差し込む光が白すぎて、はっきりとし過ぎている。周囲の闇を溶かすことなく、白と黒のコンストラストを描く。",
   "ko_candidate": ""
  },
  {
   "id": 11414,
   "key": "D0753.txt:119",
   "file": "D0753.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アーカムシティにこんな場所があるのだろうか？",
   "ko_candidate": ""
  },
  {
   "id": 11415,
   "key": "D0753.txt:122",
   "file": "D0753.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "……何かが違う。気配が違う。世界の空気が違う。",
   "ko_candidate": ""
  },
  {
   "id": 11416,
   "key": "D0753.txt:123",
   "file": "D0753.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "まるで異世界のような――",
   "ko_candidate": ""
  },
  {
   "id": 11417,
   "key": "D0753.txt:127",
   "file": "D0753.txt",
   "line": 127,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そうだよ……こいつら相手に常識が通用するものか」",
   "ko_candidate": ""
  },
  {
   "id": 11418,
   "key": "D0753.txt:130",
   "file": "D0753.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何にせよ、すっげぇ追い詰められていることは、よぅく分かった。",
   "ko_candidate": ""
  },
  {
   "id": 11419,
   "key": "D0753.txt:138",
   "file": "D0753.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "冷笑を浮かべるイタクァ。死を連想させるほどゾッとする笑みだった。そのくせ、酷く蟲惑的だった。",
   "ko_candidate": ""
  },
  {
   "id": 11420,
   "key": "D0753.txt:141",
   "file": "D0753.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "歩調を変えずイタクァは迫ってくる。この距離まで近づくと、もはや空気が痛いくらいに冷たい。",
   "ko_candidate": ""
  },
  {
   "id": 11421,
   "key": "D0753.txt:144",
   "file": "D0753.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして、ゆっくりと凍える右手が差し出された。",
   "ko_candidate": ""
  },
  {
   "id": 11422,
   "key": "D0753.txt:147",
   "file": "D0753.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "これ以上はマズイ！",
   "ko_candidate": ""
  },
  {
   "id": 11423,
   "key": "D0753.txt:160",
   "file": "D0753.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "床を蹴って、横に跳ぶ……",
   "ko_candidate": ""
  },
  {
   "id": 11424,
   "key": "D0753.txt:160",
   "file": "D0753.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "お見通しだったらしい。",
   "ko_candidate": ""
  },
  {
   "id": 11425,
   "key": "D0753.txt:170",
   "file": "D0753.txt",
   "line": 170,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ぐうっ!?」",
   "ko_candidate": ""
  },
  {
   "id": 11426,
   "key": "D0753.txt:173",
   "file": "D0753.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "足が動かない。",
   "ko_candidate": ""
  },
  {
   "id": 11427,
   "key": "D0753.txt:174",
   "file": "D0753.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "凍った床に、靴が貼りついている。",
   "ko_candidate": ""
  },
  {
   "id": 11428,
   "key": "D0753.txt:177",
   "file": "D0753.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "しまった……また似たようなミスをっ！",
   "ko_candidate": ""
  }
 ]
}