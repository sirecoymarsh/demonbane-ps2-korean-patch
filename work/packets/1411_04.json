 "items": [
  {
   "id": 39219,
   "key": "D1411le.txt:678",
   "file": "D1411le.txt",
   "line": 678,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吼え猛るリューガの凶相が曝け出される。",
   "ko_candidate": "포효하는 류가의 광기 어린 얼굴이 드러난다｡"
  },
  {
   "id": 39220,
   "key": "D1411le.txt:680",
   "file": "D1411le.txt",
   "line": 680,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "古傷が灼熱し、世界の総てを染めつくさんと鮮血を迸らせる。",
   "ko_candidate": "옛 상처가 작열하며､ 세상의 모든 것을 물들이려 선혈을 뿜어낸다｡"
  },
  {
   "id": 39221,
   "key": "D1411le.txt:681",
   "file": "D1411le.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血涙の如く、血が頬を滴る。",
   "ko_candidate": "피눈물처럼､ 피가 뺨을 타고 흐른다｡"
  },
  {
   "id": 39222,
   "key": "D1411le.txt:685",
   "file": "D1411le.txt",
   "line": 685,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な……何とぉぉぉぉぉぉぉ！」",
   "ko_candidate": "「뭐… 뭐라고오오오오오오!」"
  },
  {
   "id": 39223,
   "key": "D1411le.txt:693",
   "file": "D1411le.txt",
   "line": 693,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "３体の巨人の頭が、リューガの殺意に貫かれ、弾けて、飛んだ。 咆吼が止んだ。",
   "ko_candidate": "3체의 거인의 머리가､ 류가의 살의에 꿰뚫리고､ 터져서､ 날아갔다｡"
  },
  {
   "id": 39224,
   "key": "D1411le.txt:696",
   "file": "D1411le.txt",
   "line": 696,
   "speaker": "リューガ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "結界が、消える。 「鬼殺ァァァァァァァァ――――――ッ！」",
   "ko_candidate": "수은 같은 피와､ 하얀 뼈와､ 회색 뇌장과､ 녹슨 기계를 흩뿌리며､ 포효가 멎었다｡"
  },
  {
   "id": 39225,
   "key": "D1411le.txt:710",
   "file": "D1411le.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "刹那、ハンティング・ホラーは閃と化した。",
   "ko_candidate": "결계가､ 사라진다｡ 「귀살아아아아아아아아――――――!」"
  },
  {
   "id": 39226,
   "key": "D1411le.txt:711",
   "file": "D1411le.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間を一閃の殺意が切断する。",
   "ko_candidate": "찰나､ 헌팅 호러는 섬광이 되었다｡"
  },
  {
   "id": 39227,
   "key": "D1411le.txt:713",
   "file": "D1411le.txt",
   "line": 713,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "閃の迅ったその軌道に、魔術によって姿を消していた、サイクラノーシュが存在していた。",
   "ko_candidate": "공간을 일섬의 살의가 절단한다｡ 섬광이 지나간 그 궤도에､ 마술로 모습을 감추고 있던､ 사이크라노쉬가 존재하고 있었다｡"
  },
  {
   "id": 39228,
   "key": "D1411le.txt:714",
   "file": "D1411le.txt",
   "line": 714,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "純然無垢な殺意の刃が、サイクラノーシュを貫く。",
   "ko_candidate": "순수무구한 살의의 칼날이 사이크라노쉬를 꿰뚫는다｡"
  },
  {
   "id": 39229,
   "key": "D1411le.txt:718",
   "file": "D1411le.txt",
   "line": 718,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……！」",
   "ko_candidate": "「뭐……!」"
  },
  {
   "id": 39230,
   "key": "D1411le.txt:726",
   "file": "D1411le.txt",
   "line": 726,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機械仕掛けの神の心臓が、無限より汲み上げた魔力が爆裂する。",
   "ko_candidate": "기계 장치의 신의 심장이､ 무한으로부터 퍼 올린 마력이 폭발한다｡"
  },
  {
   "id": 39231,
   "key": "D1411le.txt:727",
   "file": "D1411le.txt",
   "line": 727,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大爆発が『夢幻心母』を揺るがした。",
   "ko_candidate": "대폭발이 『몽환심모』를 뒤흔들었다｡"
  },
  {
   "id": 39232,
   "key": "D1411le.txt:744",
   "file": "D1411le.txt",
   "line": 744,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "シャフトの最下層。",
   "ko_candidate": "샤프트의 최하층｡"
  },
  {
   "id": 39233,
   "key": "D1411le.txt:745",
   "file": "D1411le.txt",
   "line": 745,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ広い空間は何処までも続く血の海に、浸っていた。",
   "ko_candidate": "그저 넓은 공간은 어디까지나 이어지는 피의 바다에 잠겨 있었다｡"
  },
  {
   "id": 39234,
   "key": "D1411le.txt:747",
   "file": "D1411le.txt",
   "line": 747,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "むせ返るような血臭が空気を満たす。",
   "ko_candidate": "숨 막힐 듯한 피 냄새가 공기를 채운다｡"
  },
  {
   "id": 39235,
   "key": "D1411le.txt:748",
   "file": "D1411le.txt",
   "line": 748,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅い紅い水面の上に、ハンティング・ホラーは静止していた。",
   "ko_candidate": "붉디붉은 수면 위에 헌팅 호러는 정지해 있었다｡"
  },
  {
   "id": 39236,
   "key": "D1411le.txt:750",
   "file": "D1411le.txt",
   "line": 750,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の獣に跨ったまま、リューガは喘いでいる。",
   "ko_candidate": "강철의 짐승에 걸터앉은 채､ 류가는 헐떡이고 있다｡"
  },
  {
   "id": 39237,
   "key": "D1411le.txt:751",
   "file": "D1411le.txt",
   "line": 751,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "酸素が足りず、肺が、心臓が悲鳴を上げている。",
   "ko_candidate": "산소가 부족해 폐가､ 심장이 비명을 지르고 있다｡"
  },
  {
   "id": 39238,
   "key": "D1411le.txt:753",
   "file": "D1411le.txt",
   "line": 753,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "些細な事だ。",
   "ko_candidate": "사소한 일이다｡"
  },
  {
   "id": 39239,
   "key": "D1411le.txt:754",
   "file": "D1411le.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "納まる事無く血を滴らす古傷の、灼ける痛みに比べれば。",
   "ko_candidate": "가라앉을 줄 모르고 피를 흘리는 옛 상처의 타는 듯한 고통에 비하면｡"
  },
  {
   "id": 39240,
   "key": "D1411le.txt:758",
   "file": "D1411le.txt",
   "line": 758,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカ」",
   "ko_candidate": "「……라이카」"
  },
  {
   "id": 39241,
   "key": "D1411le.txt:761",
   "file": "D1411le.txt",
   "line": 761,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "搾り出すような、掠れた聲。",
   "ko_candidate": "짜내는 듯한､ 쉰 목소리｡"
  },
  {
   "id": 39242,
   "key": "D1411le.txt:765",
   "file": "D1411le.txt",
   "line": 765,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカぁぁああ！」",
   "ko_candidate": "「라이카아아아!」"
  },
  {
   "id": 39243,
   "key": "D1411le.txt:768",
   "file": "D1411le.txt",
   "line": 768,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはまるで地の底より、木霊を響かせ、轟くようで。",
   "ko_candidate": "그것은 마치 땅의 밑바닥에서 메아리치며 울리는 것 같았다｡"
  },
  {
   "id": 39244,
   "key": "D1411le.txt:772",
   "file": "D1411le.txt",
   "line": 772,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカぁぁぁぁぁあああぁぁぁああああ――――――！」",
   "ko_candidate": "「라이카아아아아아아아아아아아아―――――!」"
  },
  {
   "id": 39245,
   "key": "D1411le.txt:775",
   "file": "D1411le.txt",
   "line": 775,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "つまりは、それだけが、彼に残された総てだった。",
   "ko_candidate": "결국､ 그것만이 그에게 남겨진 전부였다｡"
  },
  {
   "id": 39246,
   "key": "D1411le.txt:776",
   "file": "D1411le.txt",
   "line": 776,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――とうの昔から。",
   "ko_candidate": "――아주 오래전부터｡"
  },
  {
   "id": 39247,
   "key": "D1411ru.txt:8",
   "file": "D1411ru.txt",
   "line": 8,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおおおおおお！」",
   "ko_candidate": "「우오오오오오오오오오!」"
  },
  {
   "id": 39248,
   "key": "D1411ru.txt:13",
   "file": "D1411ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空薬莢が派手な水飛沫を上げながら、血の海に落ちる。",
   "ko_candidate": "빈 탄피가 화려한 물보라를 일으키며 피바다에 떨어진다｡"
  },
  {
   "id": 39249,
   "key": "D1411ru.txt:15",
   "file": "D1411ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マズル・フラッシュが視界を灼いた。",
   "ko_candidate": "머즐 플래시가 시야를 태웠다｡"
  },
  {
   "id": 39250,
   "key": "D1411ru.txt:17",
   "file": "D1411ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴のデウス・マキナに、銃弾の雨を降らせる。",
   "ko_candidate": "놈의 데우스 마키나에 총알비를 퍼붓는다｡"
  },
  {
   "id": 39251,
   "key": "D1411ru.txt:19",
   "file": "D1411ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 39252,
   "key": "D1411ru.txt:30",
   "file": "D1411ru.txt",
   "line": 30,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……その程度で、このレガシー・オブ・ゴールドを撃ち破れるとでも？」",
   "ko_candidate": "「……그 정도로 이 레거시 오브 골드를 격파할 수 있을 거라고?」"
  },
  {
   "id": 39253,
   "key": "D1411ru.txt:36",
   "file": "D1411ru.txt",
   "line": 36,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……!?」",
   "ko_candidate": "「뭐……!?」"
  },
  {
   "id": 39254,
   "key": "D1411ru.txt:40",
   "file": "D1411ru.txt",
   "line": 40,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だって!?」",
   "ko_candidate": "「뭐라고!?」"
  },
  {
   "id": 39255,
   "key": "D1411ru.txt:47",
   "file": "D1411ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアとイタクァの大火力を浴びながら、だが金色のデウス・マキナは傷一つ負う事なく、燦々と輝いていた。",
   "ko_candidate": "크투가와 이타콰의 대화력을 맞으면서도､ 황금색 데우스 마키나는 상처 하나 입지 않고 찬란히 빛나고 있었다｡"
  },
  {
   "id": 39256,
   "key": "D1411ru.txt:50",
   "file": "D1411ru.txt",
   "line": 50,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「馬鹿な！　いくら何でも無傷ってことは……！」",
   "ko_candidate": "「말도 안 돼! 아무리 그래도 무상처라니……!」"
  },
  {
   "id": 39257,
   "key": "D1411ru.txt:56",
   "file": "D1411ru.txt",
   "line": 56,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「つくづく御目出度い連中だな」",
   "ko_candidate": "「정말 눈 뜨고 코 베이는 녀석들이군」"
  },
  {
   "id": 39258,
   "key": "D1411ru.txt:59",
   "file": "D1411ru.txt",
   "line": 59,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふはははははは！　今のレガシー・オブ・ゴールドをデウス・マキナ如きと一緒に考えるな！」 「ふははは……はははははは……ははははははははッ！」",
   "ko_candidate": "「후하하하하하! 지금의 레거시 오브 골드를 데우스 마키나 따위와 같이 생각하지 마! 후하하……하하하하하……하하하하하하하핫!」"
  }
 ]
}