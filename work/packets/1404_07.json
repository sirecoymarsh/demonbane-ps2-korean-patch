 "items": [
  {
   "id": 37245,
   "key": "D1404ru.txt:285",
   "file": "D1404ru.txt",
   "line": 285,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……？　何で赤くなるの？」",
   "ko_candidate": "「아니… 좀 부끄러워서」"
  },
  {
   "id": 37246,
   "key": "D1404ru.txt:290",
   "file": "D1404ru.txt",
   "line": 290,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや……ちょいと照れた」",
   "ko_candidate": "「왜?」 「아니､ 이쪽 사정이야」"
  },
  {
   "id": 37247,
   "key": "D1404ru.txt:295",
   "file": "D1404ru.txt",
   "line": 295,
   "speaker": "ライカ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なんで？」 「いや、こっちの事情」",
   "ko_candidate": "…어디서 들어본 대사라고 생각했는데､ 당연하지｡"
  },
  {
   "id": 37248,
   "key": "D1404ru.txt:302",
   "file": "D1404ru.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……どっかで聞いた台詞だと思ったが、当たり前だ。",
   "ko_candidate": "내가 직접 공주님에게 비슷한 말을 했잖아｡"
  },
  {
   "id": 37249,
   "key": "D1404ru.txt:303",
   "file": "D1404ru.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が自分で、姫さんに似たようなことを言ったんじゃないか。",
   "ko_candidate": "정말､ 공주님한테 잘난 척하며 설교해놓고 이러면 꼴사납네｡"
  },
  {
   "id": 37250,
   "key": "D1404ru.txt:305",
   "file": "D1404ru.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ったく、姫さんに偉そうに説教しといて、これじゃあ格好がつかないな。 思わず苦笑する。",
   "ko_candidate": "나도 모르게 쓴웃음을 짓는다｡"
  },
  {
   "id": 37251,
   "key": "D1404ru.txt:311",
   "file": "D1404ru.txt",
   "line": 311,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「う～～～～っ。何か馬鹿にされているような気がするっ」",
   "ko_candidate": "「으~~~~~｡ 뭔가 바보 취급당하는 것 같아」"
  },
  {
   "id": 37252,
   "key": "D1404ru.txt:316",
   "file": "D1404ru.txt",
   "line": 316,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ、悪ィ、悪ィ……ありがと、ライカさん。ちょいと気が楽になったよ」",
   "ko_candidate": "「아､ 미안､ 미안… 고마워､ 라이카 씨｡ 좀 마음이 편해졌어」"
  },
  {
   "id": 37253,
   "key": "D1404ru.txt:321",
   "file": "D1404ru.txt",
   "line": 321,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ん、分かれば、よろしいっ」",
   "ko_candidate": "「…응､ 알아주면 됐어」"
  },
  {
   "id": 37254,
   "key": "D1404ru.txt:324",
   "file": "D1404ru.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、２人で笑った。",
   "ko_candidate": "말하고 둘이서 웃었다｡"
  },
  {
   "id": 37255,
   "key": "D1404ru.txt:326",
   "file": "D1404ru.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心なしか、この部屋に入ってきたときにあったギクシャクしたような空気が、多少、和らいでいるような気がする。",
   "ko_candidate": "기분 탓인지､ 이 방에 들어왔을 때 있었던 어색한 듯한 분위기가 조금 누그러진 것 같은 기분이 든다｡"
  },
  {
   "id": 37256,
   "key": "D1404ru.txt:329",
   "file": "D1404ru.txt",
   "line": 329,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うん……とにかく、みんな無事で良かった。じゃあ、俺は自分の出来ることを、もうちょっとばかし頑張るとするよ」",
   "ko_candidate": "「응… 어쨌든 모두 무사해서 다행이야｡ 그럼､ 난 내가 할 수 있는 일을 조금 더 열심히 하도록 할게」"
  },
  {
   "id": 37257,
   "key": "D1404ru.txt:334",
   "file": "D1404ru.txt",
   "line": 334,
   "speaker": "ライカ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎ちゃん……その、今の状況はどうなっているの？」 「………………」",
   "ko_candidate": "「…쿠로… 그､ 지금 상황은 어떻게 되고 있어?」"
  },
  {
   "id": 37258,
   "key": "D1404ru.txt:340",
   "file": "D1404ru.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やはり、そこに触れないはずが無いか。",
   "ko_candidate": "「…」 역시､ 거기에 언급하지 않을 리가 없지｡"
  },
  {
   "id": 37259,
   "key": "D1404ru.txt:341",
   "file": "D1404ru.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何と答えるべきか、俺は言葉に詰まる。",
   "ko_candidate": "뭐라고 대답해야 할지､ 나는 말문이 막힌다｡"
  },
  {
   "id": 37260,
   "key": "D1404ru.txt:343",
   "file": "D1404ru.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "代わりにアルが、至極、単刀直入に答えた。",
   "ko_candidate": "대신 알이 지극히 단도직입적으로 대답했다｡"
  },
  {
   "id": 37261,
   "key": "D1404ru.txt:348",
   "file": "D1404ru.txt",
   "line": 348,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「邪神との――『ブラックロッジ』との最終決戦だ。 今度の戦いで、総てが決する」",
   "ko_candidate": "「사신과의 - 『블랙로지』와의 최종 결전이다｡ 이번 싸움으로 모든 것이 결정된다」"
  },
  {
   "id": 37262,
   "key": "D1404ru.txt:353",
   "file": "D1404ru.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "単刀直入で単純明快がゆえに、有無を言わせぬ迫力があった。",
   "ko_candidate": "단도직입적이고 단순명쾌하기에､ 거부할 수 없는 박력이 있었다｡"
  },
  {
   "id": 37263,
   "key": "D1404ru.txt:354",
   "file": "D1404ru.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ガキんちょどもが、不安そうな瞳で俺を見上げている。",
   "ko_candidate": "꼬마들이 불안한 눈동자로 나를 올려다보고 있다｡"
  },
  {
   "id": 37264,
   "key": "D1404ru.txt:359",
   "file": "D1404ru.txt",
   "line": 359,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎……勝つよね？」",
   "ko_candidate": "「쿠로… 이길 거지?」"
  },
  {
   "id": 37265,
   "key": "D1404ru.txt:363",
   "file": "D1404ru.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝てるか？",
   "ko_candidate": "이길 수 있을까?"
  },
  {
   "id": 37266,
   "key": "D1404ru.txt:364",
   "file": "D1404ru.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥルーに。旧支配者に。邪神に。",
   "ko_candidate": "크툴루를｡ 구지배자를｡ 사신을｡"
  },
  {
   "id": 37267,
   "key": "D1404ru.txt:366",
   "file": "D1404ru.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……答えは簡単だ。考えるまでもない。",
   "ko_candidate": "…대답은 간단해｡ 생각할 것도 없어｡"
  },
  {
   "id": 37268,
   "key": "D1404ru.txt:368",
   "file": "D1404ru.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝てなきゃ終わりなんだ。",
   "ko_candidate": "이기지 못하면 끝이야｡"
  },
  {
   "id": 37269,
   "key": "D1404ru.txt:369",
   "file": "D1404ru.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "じゃあ、勝つしかないだろう。",
   "ko_candidate": "그럼､ 이길 수밖에 없잖아｡"
  },
  {
   "id": 37270,
   "key": "D1404ru.txt:372",
   "file": "D1404ru.txt",
   "line": 372,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あんな蛸の化け物、切り刻んで食卓に並べてやるよ」",
   "ko_candidate": "「저런 문어 괴물､ 토막 내서 식탁에 올려줄게」"
  },
  {
   "id": 37271,
   "key": "D1404ru.txt:377",
   "file": "D1404ru.txt",
   "line": 377,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「絶対……だよな？」",
   "ko_candidate": "「절대… 맞지?」"
  },
  {
   "id": 37272,
   "key": "D1404ru.txt:381",
   "file": "D1404ru.txt",
   "line": 381,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……絶対でなきゃならんだろう。まったく厄介な名前のロボットを引き受けちまったよ」",
   "ko_candidate": "「응… 절대여야만 하겠지｡ 정말 귀찮은 이름의 로봇을 맡아버렸네」"
  },
  {
   "id": 37273,
   "key": "D1404ru.txt:383",
   "file": "D1404ru.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベイン。",
   "ko_candidate": "데몬베인｡"
  },
  {
   "id": 37274,
   "key": "D1404ru.txt:384",
   "file": "D1404ru.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔と云うのならば、喩え神とて斬らねばなるまい。",
   "ko_candidate": "마라고 한다면､ 비유하자면 신이라도 베어야 할 것이다｡"
  },
  {
   "id": 37275,
   "key": "D1404ru.txt:386",
   "file": "D1404ru.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まったく、本当に、心底、難儀なことで。",
   "ko_candidate": "정말､ 진짜로､ 뼛속까지 난처한 일이야｡"
  },
  {
   "id": 37276,
   "key": "D1404ru.txt:401",
   "file": "D1404ru.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "集中治療室。",
   "ko_candidate": "중환자실｡"
  },
  {
   "id": 37277,
   "key": "D1404ru.txt:402",
   "file": "D1404ru.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は姫さんと一緒に執事さんの見舞いに来ていた。",
   "ko_candidate": "나는 공주님과 함께 집사님의 문병을 왔다｡"
  },
  {
   "id": 37278,
   "key": "D1404ru.txt:407",
   "file": "D1404ru.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼吸器を付け、全身に巻かれた包帯も痛々しい執事さんが、ベッドに横たわっている。",
   "ko_candidate": "인공호흡기를 달고､ 온몸에 감긴 붕대도 가슴 아픈 집사님이 침대에 누워 있다｡"
  },
  {
   "id": 37279,
   "key": "D1404ru.txt:408",
   "file": "D1404ru.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "危険な状態は既に抜けていて、横に設置された心電図の装置は、規則正しいリズムを刻んでいる。",
   "ko_candidate": "위험한 상태는 이미 벗어났고､ 옆에 설치된 심전도 장치는 규칙적인 리듬을 새기고 있다｡"
  },
  {
   "id": 37280,
   "key": "D1404ru.txt:410",
   "file": "D1404ru.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "執事さんがこんな目に遭ったのも、俺の不始末のせいだ。",
   "ko_candidate": "집사님이 이런 꼴이 된 것도 내 불찰 때문이다｡"
  },
  {
   "id": 37281,
   "key": "D1404ru.txt:411",
   "file": "D1404ru.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "つくづく不甲斐ない。",
   "ko_candidate": "정말 무능하기 짝이 없다｡"
  },
  {
   "id": 37282,
   "key": "D1404ru.txt:415",
   "file": "D1404ru.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふと心電図にわずかな変化が生じる。",
   "ko_candidate": "문득 심전도에 미세한 변화가 생긴다｡"
  },
  {
   "id": 37283,
   "key": "D1404ru.txt:416",
   "file": "D1404ru.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かあったのか……と思えば、執事さんが目を開けて、こっちを見ていた。",
   "ko_candidate": "무슨 일이 있나… 하고 보니､ 집사님이 눈을 뜨고 이쪽을 보고 있었다｡"
  },
  {
   "id": 37284,
   "key": "D1404ru.txt:421",
   "file": "D1404ru.txt",
   "line": 421,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ウィンフィールド！」",
   "ko_candidate": "「…윈필드!」"
  }
 ]
}