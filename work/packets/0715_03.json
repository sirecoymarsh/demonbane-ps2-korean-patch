   "key": "D0715le.txt:270",
   "file": "D0715le.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうすれば、また俺たちの日常が始まる。",
