   "key": "D0715le.txt:226",
   "file": "D0715le.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺とライカさんの視線が交わる。",
   "ko_candidate": "나와 라이카 씨의 시선이 마주친다｡"
  },
  {
   "id": 11100,
   "key": "D0715le.txt:229",
   "file": "D0715le.txt",
