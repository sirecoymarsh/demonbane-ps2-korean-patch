  {
   "id": 11105,
   "key": "D0715le.txt:251",
   "file": "D0715le.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それっきりライカさんは視線を前に戻して、俺の方を見ることはなかった。",
