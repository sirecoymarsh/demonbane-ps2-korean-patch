   "id": 11121,
   "key": "D0715le.txt:305",
   "file": "D0715le.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は三度目の溜め息をついた。",
   "ko_candidate": "좋든 나쁘든､ 그리 쉽게 변하지는 않을 거야｡ ――아직은｡"
