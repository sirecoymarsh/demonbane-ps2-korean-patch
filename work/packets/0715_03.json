   "key": "D0715le.txt:248",
   "file": "D0715le.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "優しく微笑んだ。",
   "ko_candidate": "부드럽게 미소 지었다｡"
