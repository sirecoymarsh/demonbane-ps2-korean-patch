 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ライカ": "라이카",
  "リューガ": "류가"
 },
 "items": [
  {
   "id": 48477,
   "key": "D1518le.txt:131",
   "file": "D1518le.txt",
   "line": 131,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……ライカ」",
   "ko_candidate": "「……라이카」"
  },
  {
   "id": 48478,
   "key": "D1518le.txt:135",
   "file": "D1518le.txt",
   "line": 135,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おはよう。リューガ」",
   "ko_candidate": "「안녕｡ 류가」"
  },
  {
   "id": 48479,
   "key": "D1518le.txt:138",
   "file": "D1518le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "はっきりとは見えないが、彼女は微笑んだようだった。",
   "ko_candidate": "뚜렷하게 보이진 않지만､ 그녀는 미소 지은 것 같았다｡"
  },
  {
   "id": 48480,
   "key": "D1518le.txt:139",
   "file": "D1518le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頭に柔らかい感触……どうやら膝枕をされているらしい。",
   "ko_candidate": "머리에 부드러운 감촉…… 아무래도 무릎베개를 해주고 있는 모양이다｡"
  },
  {
   "id": 48481,
   "key": "D1518le.txt:143",
   "file": "D1518le.txt",
   "line": 143,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そうか……いつの間にか、寝てしまっていたようだね」",
   "ko_candidate": "「그렇구나…… 어느새 잠들어 버린 모양이네」"
  },
  {
   "id": 48482,
   "key": "D1518le.txt:147",
   "file": "D1518le.txt",
   "line": 147,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ぽかぽかと、良い陽気だったから」",
   "ko_candidate": "「포근하고 좋은 날씨였으니까」"
  },
  {
   "id": 48483,
   "key": "D1518le.txt:150",
   "file": "D1518le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうだったろうか。",
   "ko_candidate": "그랬었나｡"
  },
  {
   "id": 48484,
   "key": "D1518le.txt:151",
   "file": "D1518le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "寝惚けているので、よく思い出せない。",
   "ko_candidate": "잠결이라 잘 기억이 나지 않는다｡"
  },
  {
   "id": 48485,
   "key": "D1518le.txt:153",
   "file": "D1518le.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "身体を起こそうとして、うまく動かないことに気づく。",
   "ko_candidate": "몸을 일으키려고 하다가 잘 움직이지 않는다는 걸 깨닫는다｡"
  },
  {
   "id": 48486,
   "key": "D1518le.txt:154",
   "file": "D1518le.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカはそっと、僕の身体を押さえる。",
   "ko_candidate": "라이카는 살며시 내 몸을 누른다｡"
  },
  {
   "id": 48487,
   "key": "D1518le.txt:158",
   "file": "D1518le.txt",
   "line": 158,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「疲れてるみたいだから無理はいけないよ。 ここのところ、『授業』も大変になってきたし……」",
   "ko_candidate": "「피곤해 보이니까 무리하면 안 돼｡ 요즘 『수업』도 힘들어지고 있고……」"
  },
  {
   "id": 48488,
   "key": "D1518le.txt:163",
   "file": "D1518le.txt",
   "line": 163,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……ああ」",
   "ko_candidate": "「……아아」"
  },
  {
   "id": 48489,
   "key": "D1518le.txt:166",
   "file": "D1518le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "言われるままに、再び頭をライカの膝の上へ。",
   "ko_candidate": "말대로 다시 머리를 라이카의 무릎 위에｡"
  },
  {
   "id": 48490,
   "key": "D1518le.txt:167",
   "file": "D1518le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空を見上げる。",
   "ko_candidate": "하늘을 올려다본다｡"
  },
  {
   "id": 48491,
   "key": "D1518le.txt:168",
   "file": "D1518le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やっぱり、視界がぼやけている。",
   "ko_candidate": "역시 시야가 흐릿하다｡"
  },
  {
   "id": 48492,
   "key": "D1518le.txt:169",
   "file": "D1518le.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカの言うとおり、こいつはよっぽど疲れているらしい。",
   "ko_candidate": "라이카의 말대로 이놈은 꽤나 피곤한 모양이다｡"
  },
  {
   "id": 48493,
   "key": "D1518le.txt:173",
   "file": "D1518le.txt",
   "line": 173,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「もう少し、休んでましょう。 それで日が暮れたら――」",
   "ko_candidate": "「조금 더 쉬어요｡ 그러다 해가 지면――」"
  },
  {
   "id": 48494,
   "key": "D1518le.txt:177",
   "file": "D1518le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一瞬、息を飲み込み、言葉を詰まらせるがすぐに",
   "ko_candidate": "순간 숨을 들이마시며 말을 더듬다가 곧"
  },
  {
   "id": 48495,
   "key": "D1518le.txt:181",
   "file": "D1518le.txt",
   "line": 181,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「一緒に帰りましょ？」",
   "ko_candidate": "「함께 돌아갈까요?」"
  },
  {
   "id": 48496,
   "key": "D1518le.txt:185",
   "file": "D1518le.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "長い沈黙が、２人を包み込む。",
   "ko_candidate": "긴 침묵이 둘을 감싼다｡"
  },
  {
   "id": 48497,
   "key": "D1518le.txt:186",
   "file": "D1518le.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "たった２人きりの姉弟を、優しく包み込む。",
   "ko_candidate": "단 둘뿐인 남매를 상냥하게 감싼다｡"
  },
  {
   "id": 48498,
   "key": "D1518le.txt:187",
   "file": "D1518le.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "願わくば、このまま時間を閉じ込めて――",
   "ko_candidate": "원한다면 이대로 시간을 가두어――"
  },
  {
   "id": 48499,
   "key": "D1518le.txt:189",
   "file": "D1518le.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今だけは",
   "ko_candidate": "지금만은"
  },
  {
   "id": 48500,
   "key": "D1518le.txt:190",
   "file": "D1518le.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今だけは",
   "ko_candidate": "지금만은"
  },
  {
   "id": 48501,
   "key": "D1518le.txt:192",
   "file": "D1518le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 48502,
   "key": "D1518le.txt:205",
   "file": "D1518le.txt",
   "line": 205,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いや、帰れない」",
   "ko_candidate": "「아니､ 돌아갈 수 없어」"
  },
  {
   "id": 48503,
   "key": "D1518le.txt:209",
   "file": "D1518le.txt",
   "line": 209,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……え？」",
   "ko_candidate": "「……엣?」"
  },
  {
   "id": 48504,
   "key": "D1518le.txt:212",
   "file": "D1518le.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リューガは、はっきりと拒絶の意を見せた。",
   "ko_candidate": "류가는 분명히 거절의 뜻을 보였다｡"
  },
  {
   "id": 48505,
   "key": "D1518le.txt:213",
   "file": "D1518le.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "戸惑い、凍りつく私を、射抜くような視線で見上げている。",
   "ko_candidate": "당황하여 얼어붙은 나를 꿰뚫는 듯한 시선으로 올려다보고 있다｡"
  },
  {
   "id": 48506,
   "key": "D1518le.txt:214",
   "file": "D1518le.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リューガが、告げた。",
   "ko_candidate": "류가가 말했다｡"
  },
  {
   "id": 48507,
   "key": "D1518le.txt:218",
   "file": "D1518le.txt",
   "line": 218,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「己は最期まで、己で在り続ける」",
   "ko_candidate": "「나는 마지막까지 나로 있을 거야」"
  },
  {
   "id": 48508,
   "key": "D1518le.txt:222",
   "file": "D1518le.txt",
   "line": 222,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ッ!?　リューガ……」",
   "ko_candidate": "「……읏!? 류가……」"
  },
  {
   "id": 48509,
   "key": "D1518le.txt:230",
   "file": "D1518le.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この子は――",
   "ko_candidate": "이 아이는――"
  },
  {
   "id": 48510,
   "key": "D1518le.txt:234",
   "file": "D1518le.txt",
   "line": 234,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「姉さん……貴方の優しさで、己を穢すな」",
   "ko_candidate": "「누나…… 당신의 상냥함으로 나를 더럽히지 마」"
  },
  {
   "id": 48511,
   "key": "D1518le.txt:238",
   "file": "D1518le.txt",
   "line": 238,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガぁぁぁ……っ」",
   "ko_candidate": "「류가아아아……읏」"
  },
  {
   "id": 48512,
   "key": "D1518le.txt:241",
   "file": "D1518le.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この子は最期まで――過去の想い出に逃げようとしない。",
   "ko_candidate": "이 아이는 마지막까지―― 과거의 추억으로 도망치려 하지 않는다｡"
  },
  {
   "id": 48513,
   "key": "D1518le.txt:242",
   "file": "D1518le.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自らの狂気に、殉ずるつもりなのだ。",
   "ko_candidate": "자신의 광기에 순교할 작정인 것이다｡"
  },
  {
   "id": 48514,
   "key": "D1518le.txt:246",
   "file": "D1518le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リューガが手を伸ばし、私の首を掴まえた。",
   "ko_candidate": "류가가 손을 뻗어 내 목을 움켜쥐었다｡"
  },
  {
   "id": 48515,
   "key": "D1518le.txt:250",
   "file": "D1518le.txt",
   "line": 250,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「青空に辿り着くのは己だけだ。 ライカ。己は貴方を連れて行かない」",
   "ko_candidate": "「푸른 하늘에 도달하는 건 나뿐이야｡ 라이카｡ 나는 당신을 데려가지 않아」"
  },
  {
   "id": 48516,
   "key": "D1518le.txt:255",
   "file": "D1518le.txt",
   "line": 255,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リュー……ガ……ッ！」",
   "ko_candidate": "「류…가…읏!」"
  }
 ]
}