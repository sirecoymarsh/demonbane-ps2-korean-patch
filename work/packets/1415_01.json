 "items": [
  {
   "id": 40584,
   "key": "D1415al.txt:161",
   "file": "D1415al.txt",
   "line": 161,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何をするつもりだ、何を」",
   "ko_candidate": "「……무엇을 하려는 거지､ 무엇을」"
  },
  {
   "id": 40585,
   "key": "D1415al.txt:168",
   "file": "D1415al.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネームレス・ワンから発せられる敵意が少しだけ緩んだ。",
   "ko_candidate": "네임리스 원에게서 발산되는 적의가 조금 누그러졌다｡"
  },
  {
   "id": 40586,
   "key": "D1415al.txt:169",
   "file": "D1415al.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聞こえてきたのは、呆れたような、笑っているかのような、そんなエンネアの穏やかな声。",
   "ko_candidate": "들려온 것은､ 어이없다는 듯한､ 웃고 있는 듯한､ 그런 엔네아의 온화한 목소리｡"
  },
  {
   "id": 40587,
   "key": "D1415al.txt:174",
   "file": "D1415al.txt",
   "line": 174,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ってば本当に……」",
   "ko_candidate": "「쿠로 정말……」"
  },
  {
   "id": 40588,
   "key": "D1415al.txt:178",
   "file": "D1415al.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、それも一瞬。",
   "ko_candidate": "하지만､ 그것도 잠시｡"
  },
  {
   "id": 40589,
   "key": "D1415al.txt:185",
   "file": "D1415al.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凄まじい高密度の敵意が叩きつけられる。",
   "ko_candidate": "엄청난 고밀도의 적의가 내리꽂힌다｡"
  },
  {
   "id": 40590,
   "key": "D1415al.txt:186",
   "file": "D1415al.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵意は魔力と通じて、実際に質量を持つ。",
   "ko_candidate": "적의는 마력과 통해､ 실제로 질량을 가진다｡"
  },
  {
   "id": 40591,
   "key": "D1415al.txt:187",
   "file": "D1415al.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵意そのものが敵を破壊し得る力と化す。",
   "ko_candidate": "적의 그 자체가 적을 파괴할 수 있는 힘으로 변한다｡"
  },
  {
   "id": 40592,
   "key": "D1415al.txt:192",
   "file": "D1415al.txt",
   "line": 192,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これで終わりだよ、九郎！」",
   "ko_candidate": "「이걸로 끝이야､ 쿠로!」"
  },
  {
   "id": 40593,
   "key": "D1415al.txt:200",
   "file": "D1415al.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その敵意にデモンベインは反応した。",
   "ko_candidate": "그 적의에 데몬베인이 반응했다｡"
  },
  {
   "id": 40594,
   "key": "D1415al.txt:204",
   "file": "D1415al.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こちらの制御を振り払い、トラペゾヘドロンを真っ直ぐにネームレス・ワンに向け、駈ける。",
   "ko_candidate": "이쪽의 제어를 뿌리치고､ 트라페조헤드론을 똑바로 네임리스 원을 향해､ 달린다｡"
  },
  {
   "id": 40595,
   "key": "D1415al.txt:205",
   "file": "D1415al.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "異形の闇と光を引き連れ、絶対的権限を持つ断罪者が、冷酷無慈悲の死刑執行人が征く。",
   "ko_candidate": "기괴한 어둠과 빛을 이끌고､ 절대적 권한을 가진 단죄자가､ 냉혹무자비한 사형집행인이 나아간다｡"
  },
  {
   "id": 40596,
   "key": "D1415al.txt:208",
   "file": "D1415al.txt",
   "line": 208,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くそっ！　やめろォォォォォォォ！」",
   "ko_candidate": "「젠장! 그만둬어어어어어어어!」"
  },
  {
   "id": 40597,
   "key": "D1415al.txt:215",
   "file": "D1415al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分に突進してくるその破壊神を、自分の咽喉を貫かんとするその魔を斬る刃を、ネロは満ち足りた顔で、いやむしろ愛しげな表情すら浮かべて、見つめていた。",
   "ko_candidate": "자신에게 돌진해 오는 그 파괴신을､ 자신의 목구멍을 꿰뚫으려 하는 그 마를 베는 칼날을､ 네로는 만족스러운 얼굴로､ 아니 오히려 사랑스러운 표정마저 띠우고､ 바라보고 있었다｡"
  },
  {
   "id": 40598,
   "key": "D1415al.txt:218",
   "file": "D1415al.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両腕を広げる。",
   "ko_candidate": "두 팔을 벌린다｡"
  },
  {
   "id": 40599,
   "key": "D1415al.txt:219",
   "file": "D1415al.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己を滅ぼすものの総てを享け入れる為に。",
   "ko_candidate": "자신을 멸하는 모든 것을 받아들이기 위해｡"
  },
  {
   "id": 40600,
   "key": "D1415al.txt:221",
   "file": "D1415al.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これでようやく終われる。",
   "ko_candidate": "이걸로 드디어 끝낼 수 있어｡"
  },
  {
   "id": 40601,
   "key": "D1415al.txt:222",
   "file": "D1415al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何もかもがこれで終わる。",
   "ko_candidate": "모든 것이 이걸로 끝나｡"
  },
  {
   "id": 40602,
   "key": "D1415al.txt:224",
   "file": "D1415al.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この狂った運命の輪も、邪悪のシナリオに犯された世界も、そしてそんな絶望に弄ばれていた自分自身も、ようやくこれで終わる。",
   "ko_candidate": "이 미친 운명의 수레바퀴도､ 사악한 시나리오에 범해진 세계도､ 그리고 그런 절망에 농락당하고 있던 자신 자신도､ 드디어 이걸로 끝나｡"
  },
  {
   "id": 40603,
   "key": "D1415al.txt:226",
   "file": "D1415al.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 40604,
   "key": "D1415al.txt:227",
   "file": "D1415al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限に続くと思われた、この邪悪の輪廻。",
   "ko_candidate": "무한히 계속될 것 같았던､ 이 사악의 윤회｡"
  },
  {
   "id": 40605,
   "key": "D1415al.txt:235",
   "file": "D1415al.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを撃ち砕くのが、この青年だ。",
   "ko_candidate": "그것을 부수는 것이､ 이 청년이다｡"
  },
  {
   "id": 40606,
   "key": "D1415al.txt:241",
   "file": "D1415al.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "運命の只中にありながら神の思惑を超える、 それが大十字九郎だ。",
   "ko_candidate": "운명의 한가운데에 있으면서도 신의 생각을 뛰어넘는､ 그것이 다이쥬지 쿠로다｡"
  },
  {
   "id": 40607,
   "key": "D1415al.txt:251",
   "file": "D1415al.txt",
   "line": 251,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎を甘く見たね、『顔無し』」",
   "ko_candidate": "「쿠로를 얕봤네､ 『얼굴 없는 자』」"
  },
  {
   "id": 40608,
   "key": "D1415al.txt:254",
   "file": "D1415al.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かに瞳を閉じる。",
   "ko_candidate": "조용히 눈을 감는다｡"
  },
  {
   "id": 40609,
   "key": "D1415al.txt:255",
   "file": "D1415al.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネロは己の刻が始まって以来、初めて勝利を確信した。",
   "ko_candidate": "네로는 자신의 시간이 시작된 이래､ 처음으로 승리를 확신했다｡"
  },
  {
   "id": 40610,
   "key": "D1415al.txt:259",
   "file": "D1415al.txt",
   "line": 259,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これが九郎の強さ！ これが人間の強さなんだよ！ ナイアルラ……！」",
   "ko_candidate": "「이것이 쿠로의 강함! 이것이 인간의 강함이야! 나이아라……!」"
  },
  {
   "id": 40611,
   "key": "D1415al.txt:265",
   "file": "D1415al.txt",
   "line": 265,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「違うよ。大十字九郎の強さを甘く見ているのは、君の方さ。ネロ」",
   "ko_candidate": "「아니야｡ 다이쥬지 쿠로의 강함을 얕보고 있는 건､ 네 쪽이야｡ 네로」"
  },
  {
   "id": 40612,
   "key": "D1415al.txt:276",
   "file": "D1415al.txt",
   "line": 276,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――っ!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 40613,
   "key": "D1415al.txt:279",
   "file": "D1415al.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネームレス・ワンの右腕が宙を舞った。",
   "ko_candidate": "네임리스 원의 오른팔이 허공을 날았다｡"
  },
  {
   "id": 40614,
   "key": "D1415al.txt:281",
   "file": "D1415al.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トラペゾヘドロンがネームレス・ワンを撃ち抜こうとした瞬間、俺は渾身の力でデモンベインの腕を振るった。",
   "ko_candidate": "트라페조헤드론이 네임리스 원을 꿰뚫으려 한 순간､ 나는 온 힘을 다해 데몬베인의 팔을 휘둘렀다｡"
  },
  {
   "id": 40615,
   "key": "D1415al.txt:283",
   "file": "D1415al.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トラペゾヘドロンの矛先が逸れ、ネームレス・ワンの右腕を引き千切った。",
   "ko_candidate": "트라페조헤드론의 창끝이 빗나가､ 네임리스 원의 오른팔을 찢어냈다｡"
  },
  {
   "id": 40616,
   "key": "D1415al.txt:288",
   "file": "D1415al.txt",
   "line": 288,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……限界だ！」",
   "ko_candidate": "「……한계다!」"
  },
  {
   "id": 40617,
   "key": "D1415al.txt:293",
   "file": "D1415al.txt",
   "line": 293,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おらァァァァァァァ！」",
   "ko_candidate": "「으랏아아아아아아아!」"
  },
  {
   "id": 40618,
   "key": "D1415al.txt:301",
   "file": "D1415al.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宙を舞う右腕に俺はトラペゾヘドロンを突き出す。",
   "ko_candidate": "허공을 나는 오른팔에 나는 트라페조헤드론을 내밀었다｡"
  },
  {
   "id": 40619,
   "key": "D1415al.txt:303",
   "file": "D1415al.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "極限の魔力が鬼械神の右腕を撃ち抜いた。",
   "ko_candidate": "극한의 마력이 귀계신의 오른팔을 꿰뚫었다｡"
  },
  {
   "id": 40620,
   "key": "D1415al.txt:307",
   "file": "D1415al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "猛り狂う光と闇が溢れ、右腕を貪り尽くす。",
   "ko_candidate": "맹렬히 날뛰는 빛과 어둠이 넘쳐나､ 오른팔을 탐식한다｡"
  },
  {
   "id": 40621,
   "key": "D1415al.txt:312",
   "file": "D1415al.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トラペゾヘドロンの暴走は止まらない。",
   "ko_candidate": "트라페조헤드론의 폭주는 멈추지 않는다｡"
  },
  {
   "id": 40622,
   "key": "D1415al.txt:315",
   "file": "D1415al.txt",
   "line": 315,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「でぇぇぇぇぇぇぇぇい！」",
   "ko_candidate": "「데에에에에에에에에!」"
  },
  {
   "id": 40623,
   "key": "D1415al.txt:323",
   "file": "D1415al.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "続いてトラペゾヘドロンを振り上げ、ネームレス・ワンの左腕を殴り飛ばす。",
   "ko_candidate": "이어서 트라페조헤드론을 들어 올려､ 네임리스 원의 왼팔을 때려 날렸다｡"
  }
 ]
}