 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "カリグラ": "칼리굴라",
  "術式": "술식",
  "マギウス・ウィング": "마기우스 윙",
  "魔力": "마력",
  "デウス・マキナ": "데우스 마키나",
  "鬼械神": "귀계신",
  "クラーケン": "크라켄"
 },
 "items": [
  {
   "id": 14822,
   "key": "D0809al.txt:2137",
   "file": "D0809al.txt",
   "line": 2137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "加速する全感覚は、一気に音速の領域に追いつく。",
   "ko_candidate": "가속하는 모든 감각은 단숨에 음속의 영역에 도달한다｡"
  },
  {
   "id": 14823,
   "key": "D0809al.txt:2138",
   "file": "D0809al.txt",
   "line": 2138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は見た。",
   "ko_candidate": "나는 보았다｡"
  },
  {
   "id": 14824,
   "key": "D0809al.txt:2144",
   "file": "D0809al.txt",
   "line": 2144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラに飛来する５発の弾丸。",
   "ko_candidate": "칼리굴라에게 날아가는 5발의 총알｡"
  },
  {
   "id": 14825,
   "key": "D0809al.txt:2145",
   "file": "D0809al.txt",
   "line": 2145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "直進する弾丸の群れに変化が生じた。",
   "ko_candidate": "직진하는 총알 무리에 변화가 생겼다｡"
  },
  {
   "id": 14826,
   "key": "D0809al.txt:2147",
   "file": "D0809al.txt",
   "line": 2147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "５発の弾丸全てが、弾道を変える。",
   "ko_candidate": "5발의 총알 모두가 탄도를 바꾼다｡"
  },
  {
   "id": 14827,
   "key": "D0809al.txt:2148",
   "file": "D0809al.txt",
   "line": 2148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "直角に曲がり、あるいは滑らかなカーブを描き、あるいは螺旋を描きながら、カリグラの眉間を、心臓を、咽喉を、眼を、コメカミを目指す――！",
   "ko_candidate": "직각으로 꺾이거나 매끄러운 곡선을 그리거나 나선을 그리며 칼리굴라의 미간을､ 심장을､ 목구멍을､ 눈을､ 관자놀이를 겨냥한다――!"
  },
  {
   "id": 14828,
   "key": "D0809al.txt:2150",
   "file": "D0809al.txt",
   "line": 2150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはまるで弾丸一発一発が自らの意志を持っているかのようだった。",
   "ko_candidate": "그것은 마치 총알 한 발 한 발이 스스로의 의지를 가진 것 같았다｡"
  },
  {
   "id": 14829,
   "key": "D0809al.txt:2150",
   "file": "D0809al.txt",
   "line": 2150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "急所を破壊せんと、鋼鉄の牙を剥く！",
   "ko_candidate": "급소를 파괴하려고 강철의 이빨을 드러낸다!"
  },
  {
   "id": 14830,
   "key": "D0809al.txt:2155",
   "file": "D0809al.txt",
   "line": 2155,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（自動追尾弾なのか――！）",
   "ko_candidate": "（자동 추적탄인가――!）"
  },
  {
   "id": 14831,
   "key": "D0809al.txt:2161",
   "file": "D0809al.txt",
   "line": 2161,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ガアアアあああアアアアアアアア！」",
   "ko_candidate": "「가아아아아아아아아아아아아아!」"
  },
  {
   "id": 14832,
   "key": "D0809al.txt:2166",
   "file": "D0809al.txt",
   "line": 2166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラを護る防御陣が強度を増す。",
   "ko_candidate": "칼리굴라를 지키는 방어진이 강도를 높인다｡"
  },
  {
   "id": 14833,
   "key": "D0809al.txt:2167",
   "file": "D0809al.txt",
   "line": 2167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３発がその防御陣に阻まれ、粉々に砕け散った。",
   "ko_candidate": "3발이 그 방어진에 막혀 산산조각 났다｡"
  },
  {
   "id": 14834,
   "key": "D0809al.txt:2169",
   "file": "D0809al.txt",
   "line": 2169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突破した２発の内の片方は、カリグラのどうやら硬質化しているらしい肌によって、弾かれた。",
   "ko_candidate": "뚫고 나온 2발 중 하나는 칼리굴라의 어쩐지 경질화된 듯한 피부에 튕겨났다｡"
  },
  {
   "id": 14835,
   "key": "D0809al.txt:2171",
   "file": "D0809al.txt",
   "line": 2171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――残る一発が、その右目に突き刺さった。",
   "ko_candidate": "하지만――남은 한 발이 그의 오른쪽 눈에 꽂혔다｡"
  },
  {
   "id": 14836,
   "key": "D0809al.txt:2179",
   "file": "D0809al.txt",
   "line": 2179,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアアアＡＡＡＡＡＡアアア――！」",
   "ko_candidate": "「아아아아ＡＡＡＡＡＡ아아아――!」"
  },
  {
   "id": 14837,
   "key": "D0809al.txt:2184",
   "file": "D0809al.txt",
   "line": 2184,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やったか!?」",
   "ko_candidate": "「해냈나!?」"
  },
  {
   "id": 14838,
   "key": "D0809al.txt:2188",
   "file": "D0809al.txt",
   "line": 2188,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「否――まだだ！」",
   "ko_candidate": "「아니――아직이다!」"
  },
  {
   "id": 14839,
   "key": "D0809al.txt:2194",
   "file": "D0809al.txt",
   "line": 2194,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ガアアアＡＡＡＡあああああぐがあアアアＡＡＡああアアアア！」",
   "ko_candidate": "「가아아아ＡＡＡＡ아아아아구가아아아ＡＡＡ아아아아아!」"
  },
  {
   "id": 14840,
   "key": "D0809al.txt:2198",
   "file": "D0809al.txt",
   "line": 2198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理性を失い、暴走しながら、だがカリグラは複雑な術式を編み上げていく。",
   "ko_candidate": "이성을 잃고 폭주하면서도 칼리굴라는 복잡한 술식을 짜올리고 있다｡"
  },
  {
   "id": 14841,
   "key": "D0809al.txt:2199",
   "file": "D0809al.txt",
   "line": 2199,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この感じ……押し潰されそうな重圧感は、まさか……。",
   "ko_candidate": "이 느낌… 짓눌릴 것 같은 중압감은 설마… ――지진｡"
  },
  {
   "id": 14842,
   "key": "D0809al.txt:2202",
   "file": "D0809al.txt",
   "line": 2202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――地響き。",
   "ko_candidate": "점점 커진다｡"
  },
  {
   "id": 14843,
   "key": "D0809al.txt:2203",
   "file": "D0809al.txt",
   "line": 2203,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だんだん大きくなる。 大地の底で巨大な龍がうねっているかのようだ……。",
   "ko_candidate": "대지의 밑바닥에서 거대한 용이 꿈틀거리는 것 같다…"
  },
  {
   "id": 14844,
   "key": "D0809al.txt:2209",
   "file": "D0809al.txt",
   "line": 2209,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――来る！」",
   "ko_candidate": "「――온다!」"
  },
  {
   "id": 14845,
   "key": "D0809al.txt:2214",
   "file": "D0809al.txt",
   "line": 2214,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「マギウス・ウィング！」",
   "ko_candidate": "「마기우스 윙!」"
  },
  {
   "id": 14846,
   "key": "D0809al.txt:2216",
   "file": "D0809al.txt",
   "line": 2216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒翼から魔力を一気に噴出して、空へ飛び上がった。",
   "ko_candidate": "검은 날개에서 마력을 한꺼번에 분출하여 하늘로 날아올랐다｡"
  },
  {
   "id": 14847,
   "key": "D0809al.txt:2225",
   "file": "D0809al.txt",
   "line": 2225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それからやや遅れて、さっきまでいたビルが、崩壊した。",
   "ko_candidate": "그리고 조금 늦게､ 방금 전까지 있던 빌딩이 무너졌다｡"
  },
  {
   "id": 14848,
   "key": "D0809al.txt:2228",
   "file": "D0809al.txt",
   "line": 2228,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………っっ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 14849,
   "key": "D0809al.txt:2230",
   "file": "D0809al.txt",
   "line": 2230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地を割って、巨大な水柱が噴き上がった。",
   "ko_candidate": "대지를 가르며 거대한 물기둥이 솟아올랐다｡"
  },
  {
   "id": 14850,
   "key": "D0809al.txt:2231",
   "file": "D0809al.txt",
   "line": 2231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水柱がビルを呑み込み、粉砕する。",
   "ko_candidate": "물기둥이 빌딩을 삼켜 분쇄한다｡"
  },
  {
   "id": 14851,
   "key": "D0809al.txt:2232",
   "file": "D0809al.txt",
   "line": 2232,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その重力に逆らい荒れ狂う水流の只中に巨大な影。輝く２つの瞳。 やっぱり――！",
   "ko_candidate": "그 중력에 거스르며 광포하게 흐르는 물줄기 한가운데에 거대한 그림자｡ 빛나는 두 개의 눈동자｡"
  },
  {
   "id": 14852,
   "key": "D0809al.txt:2239",
   "file": "D0809al.txt",
   "line": 2239,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デウス・マキナ！」",
   "ko_candidate": "역시――! 「데우스 마키나!」"
  },
  {
   "id": 14853,
   "key": "D0809al.txt:2251",
   "file": "D0809al.txt",
   "line": 2251,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『水神クタアト』が 鬼械神クラーケン！　壊せ壊せ コワセコワセェェェェェェェ！」",
   "ko_candidate": "「『수신 크타아트』가 귀계신 크라켄! 부숴라 부숴라 부숴버려어어어어어어어!」"
  },
  {
   "id": 14854,
   "key": "D0809al.txt:2265",
   "file": "D0809al.txt",
   "line": 2265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水柱が爆砕した。",
   "ko_candidate": "물기둥이 폭발했다｡"
  },
  {
   "id": 14855,
   "key": "D0809al.txt:2274",
   "file": "D0809al.txt",
   "line": 2274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な質量が顕現し、衝撃波が迸った。",
   "ko_candidate": "거대한 질량이 현현하며 충격파가 튀어나왔다｡"
  },
  {
   "id": 14856,
   "key": "D0809al.txt:2276",
   "file": "D0809al.txt",
   "line": 2276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街の一角にスコールの如き豪雨が降り注ぐ。",
   "ko_candidate": "거리의 한 구석에 스콜과 같은 폭우가 쏟아진다｡"
  },
  {
   "id": 14857,
   "key": "D0809al.txt:2285",
   "file": "D0809al.txt",
   "line": 2285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の中心――霧を纏って、鋼鉄の巨人が聳え立っていた。",
   "ko_candidate": "폭발의 중심――안개를 두르고 강철의 거인이 우뚝 서 있었다｡"
  },
  {
   "id": 14858,
   "key": "D0809al.txt:2286",
   "file": "D0809al.txt",
   "line": 2286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その無骨で剛健なフォルム。",
   "ko_candidate": "그 투박하고 강건한 폼｡"
  },
  {
   "id": 14859,
   "key": "D0809al.txt:2287",
   "file": "D0809al.txt",
   "line": 2287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体内で渦巻く、圧倒的なパワーをヒシヒシと感じた。",
   "ko_candidate": "기체 내부에서 소용돌이치는 압도적인 파워가 피부에 와닿았다｡"
  },
  {
   "id": 14860,
   "key": "D0809al.txt:2289",
   "file": "D0809al.txt",
   "line": 2289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体の前に浮かび上がる魔法陣に、光と化したカリグラが吸い込まれる。",
   "ko_candidate": "기체 앞에 떠오르는 마법진에 빛이 된 칼리굴라가 빨려 들어간다｡"
  },
  {
   "id": 14861,
   "key": "D0809al.txt:2290",
   "file": "D0809al.txt",
   "line": 2290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地を響かせながら、鬼械神クラーケンがゆっくりと起動した……！",
   "ko_candidate": "대지를 울리며 귀계신 크라켄이 천천히 가동되었다……!"
  }
 ]
}