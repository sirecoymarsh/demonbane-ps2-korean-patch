 "items": [
  {
   "id": 30846,
   "key": "D1301le.txt:459",
   "file": "D1301le.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これ以上の絶望を阻止するために……そして、何よりライカさんをこんな連中に好きにされてたまるものか！",
   "ko_candidate": "이 이상의 절망을 막기 위해서……그리고 무엇보다 라이카 씨를 이런 녀석들 마음대로 하게 둘 수는 없다!"
  },
  {
   "id": 30847,
   "key": "D1301le.txt:462",
   "file": "D1301le.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀を……構える。",
   "ko_candidate": "바르자이의 언월도를……구사한다｡"
  },
  {
   "id": 30848,
   "key": "D1301le.txt:463",
   "file": "D1301le.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぐらり。",
   "ko_candidate": "휘청｡"
  },
  {
   "id": 30849,
   "key": "D1301le.txt:464",
   "file": "D1301le.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身体が傾ぐが、何とか踏み止まる。",
   "ko_candidate": "몸이 기울지만 어떻게든 버틴다｡"
  },
  {
   "id": 30850,
   "key": "D1301le.txt:465",
   "file": "D1301le.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……根性出せ、大十字九郎！",
   "ko_candidate": "젠장……정신 차려､ 다이쥬지 쿠로!"
  },
  {
   "id": 30851,
   "key": "D1301le.txt:473",
   "file": "D1301le.txt",
   "line": 473,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「へええぇぇ？　この状況でまだ戦う気なの、九郎ちゃん？」 「でも無駄無駄よぉん。メタトロンちゃんは、身も心もクトゥルー様に捧げちゃうんだからぁ☆」",
   "ko_candidate": "「헤에에? 이 상황에서도 아직 싸울 생각이야､ 쿠로 군? 하지만 헛수고야｡ 메타트론 양은 몸도 마음도 크툴루 님께 바치게 될 거니까☆」"
  },
  {
   "id": 30852,
   "key": "D1301le.txt:480",
   "file": "D1301le.txt",
   "line": 480,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「させる……か！」",
   "ko_candidate": "「시켜줄……까!」"
  },
  {
   "id": 30853,
   "key": "D1301le.txt:485",
   "file": "D1301le.txt",
   "line": 485,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お、おい、こら！　そんな無謀な……！」",
   "ko_candidate": "「어､ 이봐､ 이 자식! 그런 무모한……!」"
  },
  {
   "id": 30854,
   "key": "D1301le.txt:489",
   "file": "D1301le.txt",
   "line": 489,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おほほほほほほほほほほ！」",
   "ko_candidate": "「오호호호호호호호호호!」"
  },
  {
   "id": 30855,
   "key": "D1301le.txt:495",
   "file": "D1301le.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駈け出そうとする俺を狙って、星型が不可視の魔力弾を放つ。",
   "ko_candidate": "달려나가려는 나를 겨냥해 별 모양이 비가시의 마력탄을 쏜다｡"
  },
  {
   "id": 30856,
   "key": "D1301le.txt:496",
   "file": "D1301le.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反射的に急停止、すぐ前方で爆発が起きた。",
   "ko_candidate": "반사적으로 급정지､ 바로 앞에서 폭발이 일어났다｡"
  },
  {
   "id": 30857,
   "key": "D1301le.txt:497",
   "file": "D1301le.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆風に吹き飛ばされ、アスファルトの上を転がり、跳ねる。",
   "ko_candidate": "폭풍에 날아가 아스팔트 위를 구르고 튄다｡"
  },
  {
   "id": 30858,
   "key": "D1301le.txt:507",
   "file": "D1301le.txt",
   "line": 507,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぅああ！」",
   "ko_candidate": "「크으아아!」"
  },
  {
   "id": 30859,
   "key": "D1301le.txt:513",
   "file": "D1301le.txt",
   "line": 513,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……殺しはしないわよ？　せいぜいメタトロンちゃんがボロボロにされていくのを想像して、悔しがりなさい！」 「おーほほほほほほほほほほ！」",
   "ko_candidate": "「……죽이진 않을 거야? 메타트론 양이 너덜너덜해지는 걸 상상하면서 자○ 발기나 해! 오호호호호호호호호호!」"
  },
  {
   "id": 30860,
   "key": "D1301le.txt:520",
   "file": "D1301le.txt",
   "line": 520,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ま、待ちやがれぇぇぇぇッッ！」",
   "ko_candidate": "「기､ 기다려어어어어어어!」"
  },
  {
   "id": 30861,
   "key": "D1301le.txt:523",
   "file": "D1301le.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体が淡く輝き始める。",
   "ko_candidate": "기체가 희미하게 빛나기 시작한다｡"
  },
  {
   "id": 30862,
   "key": "D1301le.txt:524",
   "file": "D1301le.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光に包まれ、光に崩れ、光の粒子そのものとなって、空間にわだかまる。",
   "ko_candidate": "빛에 휩싸이고 빛에 무너지며 빛의 입자 그 자체가 되어 공간에 맺힌다｡"
  },
  {
   "id": 30863,
   "key": "D1301le.txt:526",
   "file": "D1301le.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光。",
   "ko_candidate": "섬광｡"
  },
  {
   "id": 30864,
   "key": "D1301le.txt:527",
   "file": "D1301le.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の粒子は群れをなし、一条の光線となって、上空のクトゥルーへと吸い込まれていく。",
   "ko_candidate": "빛의 입자는 무리를 이루어 한 줄기 광선이 되어 상공의 크툴루에게 빨려 들어간다｡"
  },
  {
   "id": 30865,
   "key": "D1301le.txt:529",
   "file": "D1301le.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "後には、何も残らない。",
   "ko_candidate": "뒤에는 아무것도 남지 않는다｡"
  },
  {
   "id": 30866,
   "key": "D1301le.txt:530",
   "file": "D1301le.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静寂が空の無い街に重く圧し掛かる。",
   "ko_candidate": "정적이 하늘 없는 거리에 무겁게 내려앉는다｡"
  },
  {
   "id": 30867,
   "key": "D1301le.txt:534",
   "file": "D1301le.txt",
   "line": 534,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ち、ちくしょおォォォォォォォォォォォォォォ――――――ッ！」",
   "ko_candidate": "「이､ 이 자식아아아아아아아아아아아아아아――――――!」"
  },
  {
   "id": 30868,
   "key": "D1301le.txt:538",
   "file": "D1301le.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳を地面に打ちつける。",
   "ko_candidate": "주먹을 땅에 내리친다｡"
  },
  {
   "id": 30869,
   "key": "D1301le.txt:539",
   "file": "D1301le.txt",
   "line": 539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アスファルトが砕けて散った。",
   "ko_candidate": "아스팔트가 부서져 흩어졌다｡"
  },
  {
   "id": 30870,
   "key": "D1301le.txt:541",
   "file": "D1301le.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳の痛みも、だが心で滾る怒りと無力感に比べれば、生温いものだった。",
   "ko_candidate": "주먹의 아픔도､ 하지만 마음에서 끓어오르는 분노와 무력감에 비하면 미지근한 것이었다｡"
  },
  {
   "id": 30871,
   "key": "D1301le.txt:544",
   "file": "D1301le.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさん……！",
   "ko_candidate": "라이카 씨……!"
  },
  {
   "id": 30872,
   "key": "D1301ru.txt:9",
   "file": "D1301ru.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――当時の俺は自惚れていたと思う。",
   "ko_candidate": "당시의 나는 자만했던 것 같다｡"
  },
  {
   "id": 30873,
   "key": "D1301ru.txt:11",
   "file": "D1301ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ミスカトニック大学に入学してからと云うもの、何もかもが順調だった。",
   "ko_candidate": "미스카토닉 대학에 입학하고 나서는､ 모든 것이 순조로웠다｡"
  },
  {
   "id": 30874,
   "key": "D1301ru.txt:13",
   "file": "D1301ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "元々、多少の知識があった。",
   "ko_candidate": "원래 약간의 지식이 있었다｡"
  },
  {
   "id": 30875,
   "key": "D1301ru.txt:14",
   "file": "D1301ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから大学の講義は、思いの他、すんなりと理解することが出来た。",
   "ko_candidate": "그래서 대학 강의는 생각보다 쉽게 이해할 수 있었다｡"
  },
  {
   "id": 30876,
   "key": "D1301ru.txt:16",
   "file": "D1301ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実際、筋は良かった方だと思う。",
   "ko_candidate": "실제로 재능은 좋은 편이었다고 생각한다｡"
  },
  {
   "id": 30877,
   "key": "D1301ru.txt:17",
   "file": "D1301ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『そっちの方面』では有名な教授達の薫陶も受け、俺は凄い勢いで、知識を身に着けていった。",
   "ko_candidate": "『그쪽 분야』에서 유명한 교수들의 가르침도 받아､ 나는 엄청난 기세로 지식을 습득해 갔다｡"
  },
  {
   "id": 30878,
   "key": "D1301ru.txt:19",
   "file": "D1301ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この調子ならば……すぐにでも、上位の段階へ進める。",
   "ko_candidate": "이 기세라면… 곧 상위 단계로 진급할 수 있을 것이다｡"
  },
  {
   "id": 30879,
   "key": "D1301ru.txt:21",
   "file": "D1301ru.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうすれば『図書館』の利用も許されるし、其処に収められた『書』に触れることが出来る。",
   "ko_candidate": "그렇게 되면 『도서관』 이용도 허가되고､ 거기에 보관된 『서적』에 접할 수 있게 된다｡"
  },
  {
   "id": 30880,
   "key": "D1301ru.txt:23",
   "file": "D1301ru.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして、いずれは自らの『書』を手に入れて、俺は――本物の魔術師になるのだ。",
   "ko_candidate": "그리고 언젠가는 자신만의 『서적』을 손에 넣어､ 나는―― 진정한 마술사가 되는 것이다｡"
  },
  {
   "id": 30881,
   "key": "D1301ru.txt:26",
   "file": "D1301ru.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は大十字九郎。",
   "ko_candidate": "나는 다이쥬지 쿠로｡"
  },
  {
   "id": 30882,
   "key": "D1301ru.txt:27",
   "file": "D1301ru.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ミスカトニック大学、陰秘学科の『学徒』である。",
   "ko_candidate": "미스카토닉 대학､ 은비학과의 『학도』이다｡"
  },
  {
   "id": 30883,
   "key": "D1301ru.txt:29",
   "file": "D1301ru.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "陰秘学科が教えるのは、魔術。",
   "ko_candidate": "음비학과가 가르치는 것은 마술｡"
  },
  {
   "id": 30884,
   "key": "D1301ru.txt:30",
   "file": "D1301ru.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の真理に到達する為の理論。",
   "ko_candidate": "세계의 진리에 도달하기 위한 이론｡"
  },
  {
   "id": 30885,
   "key": "D1301ru.txt:31",
   "file": "D1301ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界を手中に収める為の理論。",
   "ko_candidate": "세계를 손아귀에 넣기 위한 이론｡"
  }
 ]
}