 },
 "items": [
  {
   "id": 26502,
   "key": "D1201le.txt:41",
   "file": "D1201le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さすがにデウス・マキナを招喚できる規模の魔導書はないと思うが。",
   "ko_candidate": "아무래도 데우스 마키나를 소환할 수 있는 규모의 마도서는 없을 거라고 생각하지만｡"
  },
  {
   "id": 26503,
   "key": "D1201le.txt:47",
   "file": "D1201le.txt",
   "line": 47,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎。これを」",
   "ko_candidate": "「쿠로｡ 이걸」"
  },
  {
   "id": 26504,
   "key": "D1201le.txt:50",
   "file": "D1201le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "布に包まれた長い棒状の何かを持って、アルが図書館に入ってくる。",
   "ko_candidate": "천에 싸인 긴 막대 모양의 무언가를 들고､ 알이 도서관에 들어온다｡"
  },
  {
   "id": 26505,
   "key": "D1201le.txt:51",
   "file": "D1201le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを手にとって、布を剥いだ。",
   "ko_candidate": "그것을 손에 들고､ 천을 벗겼다｡"
  },
  {
   "id": 26506,
   "key": "D1201le.txt:58",
   "file": "D1201le.txt",
   "line": 58,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これは……バルザイの偃月刀!?」",
   "ko_candidate": "「이건… 바르자이의 언월도!?」"
  },
  {
   "id": 26507,
   "key": "D1201le.txt:63",
   "file": "D1201le.txt",
   "line": 63,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「武器庫の方にあった。ふむ、やはり此処は相当に面白い。 覇道鋼造とはどのような男であったのだろうな？　興味が湧いてきた」",
   "ko_candidate": "「무기고 쪽에 있었어｡ 흠､ 역시 여기는 상당히 흥미롭군｡ 하도 코조는 어떤 남자였을까? 흥미가 생겼어」"
  },
  {
   "id": 26508,
   "key": "D1201le.txt:66",
   "file": "D1201le.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "バルザイの偃月刀までもが……。",
   "ko_candidate": "바르자이의 언월도까지…"
  },
  {
   "id": 26509,
   "key": "D1201le.txt:67",
   "file": "D1201le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まったく、本当に謎の多い人物だ。",
   "ko_candidate": "정말､ 정말로 수수께끼가 많은 인물이야｡"
  },
  {
   "id": 26510,
   "key": "D1201le.txt:68",
   "file": "D1201le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "でも、まあ……",
   "ko_candidate": "하지만､ 뭐…"
  },
  {
   "id": 26511,
   "key": "D1201le.txt:73",
   "file": "D1201le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "片手にバルザイの偃月刀を取り、振るう。",
   "ko_candidate": "한 손에 바르자이의 언월도를 들고､ 휘두른다｡"
  },
  {
   "id": 26512,
   "key": "D1201le.txt:78",
   "file": "D1201le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斬り下ろしから、手首を返して斬り上げ。",
   "ko_candidate": "내리찍기에서､ 손목을 돌려 올려치기｡"
  },
  {
   "id": 26513,
   "key": "D1201le.txt:82",
   "file": "D1201le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "袈裟。",
   "ko_candidate": "게사｡"
  },
  {
   "id": 26514,
   "key": "D1201le.txt:82",
   "file": "D1201le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逆袈裟。",
   "ko_candidate": "역게사｡"
  },
  {
   "id": 26515,
   "key": "D1201le.txt:82",
   "file": "D1201le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "袈裟。",
   "ko_candidate": "게사｡"
  },
  {
   "id": 26516,
   "key": "D1201le.txt:87",
   "file": "D1201le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左右の水平斬り。",
   "ko_candidate": "좌우 수평 베기｡"
  },
  {
   "id": 26517,
   "key": "D1201le.txt:91",
   "file": "D1201le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのまま４回転、下から順に昇るように４連撃。",
   "ko_candidate": "그대로 4회전､ 아래에서 순서대로 올라가듯 4연격｡"
  },
  {
   "id": 26518,
   "key": "D1201le.txt:95",
   "file": "D1201le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "５回転目には両足が地面を離れ跳躍。そのまま空中にて５撃目。",
   "ko_candidate": "5회전째에는 양 발이 땅에서 떨어져 도약｡ 그대로 공중에서 5격째｡"
  },
  {
   "id": 26519,
   "key": "D1201le.txt:97",
   "file": "D1201le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――着地。",
   "ko_candidate": "그리고―― 착지｡"
  },
  {
   "id": 26520,
   "key": "D1201le.txt:98",
   "file": "D1201le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緊……ッ",
   "ko_candidate": "찌이…잉"
  },
  {
   "id": 26521,
   "key": "D1201le.txt:98",
   "file": "D1201le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "と空気が鋭くなったような、そんな感覚。",
   "ko_candidate": "하고 공기가 날카로워진 듯한､ 그런 감각｡"
  },
  {
   "id": 26522,
   "key": "D1201le.txt:101",
   "file": "D1201le.txt",
   "line": 101,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「使えるもんは有り難く使わせてもらうぜ。大旦那様」",
   "ko_candidate": "「쓸 수 있는 건 고맙게 쓰겠습니다｡ 대주인님」"
  },
  {
   "id": 26523,
   "key": "D1201le.txt:106",
   "file": "D1201le.txt",
   "line": 106,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……こんな場所で暴れるな。危険だろう」",
   "ko_candidate": "「…이런 장소에서 날뛰지 마｡ 위험하잖아」"
  },
  {
   "id": 26524,
   "key": "D1201le.txt:114",
   "file": "D1201le.txt",
   "line": 114,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そっちの具合はどんなもんだ？」",
   "ko_candidate": "「그쪽 상태는 어떤가?」"
  },
  {
   "id": 26525,
   "key": "D1201le.txt:119",
   "file": "D1201le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "図書館を出て、錬金術研究所を覗く。",
   "ko_candidate": "도서관을 나와 연금술 연구소를 들여다본다｡"
  },
  {
   "id": 26526,
   "key": "D1201le.txt:120",
   "file": "D1201le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最終調整だろうか。ドクター・ウェストは、ハンティング・ホラーにライカさんを跨がせたまま、色々と機器類を弄くっている。",
   "ko_candidate": "최종 조정일까｡ 닥터 웨스트는 헌팅 호러에 라이카 씨를 태운 채､ 여러 가지 기기류를 만지작거리고 있다｡"
  },
  {
   "id": 26527,
   "key": "D1201le.txt:122",
   "file": "D1201le.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ときおりエルザに指示を出し、パーツだの工具だの大きくて妖しげな計算機などを持ってこさせる。",
   "ko_candidate": "때때로 엘자에게 지시를 내리고､ 부품이나 공구나 크고 이상한 계산기 등을 가져오게 한다｡"
  },
  {
   "id": 26528,
   "key": "D1201le.txt:130",
   "file": "D1201le.txt",
   "line": 130,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もう少しである。やはり『ナコト写本』とハンティング・ホラーとの術式交換の際、ラグが生じているのである。ここら辺をピッタリと適合させんとなぁ」",
   "ko_candidate": "「조금만 더다｡ 역시 『나코트 사본』과 헌팅 호러와의 술식 교환 시､ 래그가 발생하고 있다구｡ 이 부분을 딱 맞게 적합시켜야 하는데」"
  },
  {
   "id": 26529,
   "key": "D1201le.txt:135",
   "file": "D1201le.txt",
   "line": 135,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「しかし、『ナコト写本』を武器に転用しようとは……なかなかに突拍子もないアイデアだな」",
   "ko_candidate": "「하지만､ 『나코트 사본』을 무기로 전용하려고 하다니… 꽤나 엉뚱한 아이디어군」"
  },
  {
   "id": 26530,
   "key": "D1201le.txt:140",
   "file": "D1201le.txt",
   "line": 140,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「理論的にはデウス・マキナと魔導兵器の関係に近いのである。 理屈さえ分かれば、応用はなんぼでも利くものであるよ」",
   "ko_candidate": "「이론적으로는 데우스 마키나와 마도병기의 관계에 가깝다구｡ 이치만 알면､ 응용은 얼마든지 가능한 법이지」"
  },
  {
   "id": 26531,
   "key": "D1201le.txt:148",
   "file": "D1201le.txt",
   "line": 148,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ、何でも良い。そいつならデウス・マキナへの対抗手段になるのは証明済みだ。頼んだぜ、ドクター。それと……ライカさんも無理しない程度にな」",
   "ko_candidate": "「뭐､ 뭐든 좋아｡ 그게 데우스 마키나에 대한 대항 수단이 된다는 건 증명됐으니까｡ 부탁해､ 닥터｡ 그리고… 라이카 씨도 무리하지 않는 선에서」"
  },
  {
   "id": 26532,
   "key": "D1201le.txt:154",
   "file": "D1201le.txt",
   "line": 154,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ありがとう……九郎ちゃん」",
   "ko_candidate": "「고마워… 쿠로 군」"
  },
  {
   "id": 26533,
   "key": "D1201le.txt:159",
   "file": "D1201le.txt",
   "line": 159,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふむ……汝等、以前にも増して仲が良くなっているなぁ？」",
   "ko_candidate": "「흠… 너희들､ 전보다 더 사이가 좋아진 것 같구나?」"
  },
  {
   "id": 26534,
   "key": "D1201le.txt:163",
   "file": "D1201le.txt",
   "line": 163,
   "speaker": "九郎＆メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うっ」",
   "ko_candidate": "「윽」"
  },
  {
   "id": 26535,
   "key": "D1201le.txt:168",
   "file": "D1201le.txt",
   "line": 168,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「２人、同時ロボか」",
   "ko_candidate": "「둘 다､ 동시에 로봇이냐」"
  },
  {
   "id": 26536,
   "key": "D1201le.txt:171",
   "file": "D1201le.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……相変わらず勘の鋭い奴め。",
   "ko_candidate": "…여전히 감이 예리한 녀석 같으니｡"
  },
  {
   "id": 26537,
   "key": "D1201le.txt:172",
   "file": "D1201le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここはあえて、トボける。",
   "ko_candidate": "여기는 일부러､ 시치미를 떼자｡"
  },
  {
   "id": 26538,
   "key": "D1201le.txt:175",
   "file": "D1201le.txt",
   "line": 175,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「気のせい。気のせいだっつーの。そんなことより……」",
   "ko_candidate": "「기분 탓이야｡ 기분 탓이라고｡ 그것보다…」"
  },
  {
   "id": 26539,
   "key": "D1201le.txt:179",
   "file": "D1201le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突如と赤く明滅する照明。",
   "ko_candidate": "갑자기 붉게 명멸하는 조명｡"
  },
  {
   "id": 26540,
   "key": "D1201le.txt:180",
   "file": "D1201le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "けたたましく鳴り響くアラームの音。",
   "ko_candidate": "귀청이 터질 듯 울려 퍼지는 알람 소리｡"
  },
  {
   "id": 26541,
   "key": "D1201le.txt:184",
   "file": "D1201le.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また敵襲か!?",
   "ko_candidate": "또 적습인가!?"
  }
 ]
}