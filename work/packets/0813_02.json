 "items": [
  {
   "id": 16551,
   "key": "D0813ru.txt:184",
   "file": "D0813ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この聲……忘れてなるものか！",
   "ko_candidate": "이 목소리… 잊을 리가 없다!"
  },
  {
   "id": 16552,
   "key": "D0813ru.txt:187",
   "file": "D0813ru.txt",
   "line": 187,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マスターテリオン！」",
   "ko_candidate": "「마스터 테리온!」"
  },
  {
   "id": 16553,
   "key": "D0813ru.txt:192",
   "file": "D0813ru.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溺れる囚人の前方。空中に吹き荒れる魔導書の紙片。",
   "ko_candidate": "익사하는 죄수의 전방｡ 공중에 휘날리는 마도서의 종이 조각｡"
  },
  {
   "id": 16554,
   "key": "D0813ru.txt:193",
   "file": "D0813ru.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渦を巻く紙吹雪の中央に、２つの影が顕現した。",
   "ko_candidate": "소용돌이치는 종이 조각의 중앙에 두 개의 그림자가 나타났다｡"
  },
  {
   "id": 16555,
   "key": "D0813ru.txt:195",
   "file": "D0813ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒の少女を抱き締める、金色の闇。",
   "ko_candidate": "검은 소녀를 끌어안은 황금빛 어둠｡"
  },
  {
   "id": 16556,
   "key": "D0813ru.txt:196",
   "file": "D0813ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聖書の獣の名を冠する少年、マスターテリオン！",
   "ko_candidate": "성서의 짐승의 이름을 관에 쓴 소년､ 마스터 테리온!"
  },
  {
   "id": 16557,
   "key": "D0813ru.txt:200",
   "file": "D0813ru.txt",
   "line": 200,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「テリ……オンッッ！」",
   "ko_candidate": "「테리… 온!」"
  },
  {
   "id": 16558,
   "key": "D0813ru.txt:205",
   "file": "D0813ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溺れながらも囚人が叫んだ。",
   "ko_candidate": "익사하면서도 죄수가 외쳤다｡"
  },
  {
   "id": 16559,
   "key": "D0813ru.txt:206",
   "file": "D0813ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その叫びには悲痛な憎悪と、苛烈な絶望がある。",
   "ko_candidate": "그 외침에는 비통한 증오와 격렬한 절망이 담겨 있다｡"
  },
  {
   "id": 16560,
   "key": "D0813ru.txt:221",
   "file": "D0813ru.txt",
   "line": 221,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あれが……マスターテリオン」",
   "ko_candidate": "「저게… 마스터 테리온」"
  },
  {
   "id": 16561,
   "key": "D0813ru.txt:224",
   "file": "D0813ru.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鳥肌が立っているのが、否応になく意識される。",
   "ko_candidate": "소름이 돋고 있다는 게 싫어도 의식된다｡"
  },
  {
   "id": 16562,
   "key": "D0813ru.txt:225",
   "file": "D0813ru.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚がガクガクに震えている。",
   "ko_candidate": "다리가 덜덜 떨리고 있다｡"
  },
  {
   "id": 16563,
   "key": "D0813ru.txt:227",
   "file": "D0813ru.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "モニター越しでも分かった。",
   "ko_candidate": "모니터를 통해서도 알 수 있었다｡"
  },
  {
   "id": 16564,
   "key": "D0813ru.txt:229",
   "file": "D0813ru.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この少年が持つ、邪悪にして強大過ぎる気配を。",
   "ko_candidate": "이 소년이 지닌 사악하고 너무나 강대한 기운을｡"
  },
  {
   "id": 16565,
   "key": "D0813ru.txt:231",
   "file": "D0813ru.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これが恐らくは、祖父の人生を覆った絶望。",
   "ko_candidate": "이것이 아마도 할아버지의 인생을 뒤덮은 절망｡"
  },
  {
   "id": 16566,
   "key": "D0813ru.txt:232",
   "file": "D0813ru.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎を襲う恐怖。",
   "ko_candidate": "다이쥬지 쿠로를 덮친 공포｡"
  },
  {
   "id": 16567,
   "key": "D0813ru.txt:234",
   "file": "D0813ru.txt",
   "line": 234,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『黒き聖域』の中枢。",
   "ko_candidate": "『검은 성역』의 중추｡"
  },
  {
   "id": 16568,
   "key": "D0813ru.txt:235",
   "file": "D0813ru.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真なる悪。",
   "ko_candidate": "진정한 악｡"
  },
  {
   "id": 16569,
   "key": "D0813ru.txt:236",
   "file": "D0813ru.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "獣！　獣！　獣！",
   "ko_candidate": "짐승! 짐승! 짐승!"
  },
  {
   "id": 16570,
   "key": "D0813ru.txt:240",
   "file": "D0813ru.txt",
   "line": 240,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さんは……あの人は……」",
   "ko_candidate": "「다이쥬지 씨는… 그 사람은…」"
  },
  {
   "id": 16571,
   "key": "D0813ru.txt:243",
   "file": "D0813ru.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目頭が熱くなる。",
   "ko_candidate": "눈가가 뜨거워진다｡"
  },
  {
   "id": 16572,
   "key": "D0813ru.txt:244",
   "file": "D0813ru.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "涙が溜まり、視界が歪む。",
   "ko_candidate": "눈물이 고이고 시야가 흐려진다｡"
  },
  {
   "id": 16573,
   "key": "D0813ru.txt:246",
   "file": "D0813ru.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、それでも、涙を流すことだけはしなかった。",
   "ko_candidate": "하지만 그래도 눈물을 흘리는 것만큼은 하지 않았다｡"
  },
  {
   "id": 16574,
   "key": "D0813ru.txt:248",
   "file": "D0813ru.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その最後の一線だけは死守した。",
   "ko_candidate": "그 마지막 한 선만큼은 사수했다｡"
  },
  {
   "id": 16575,
   "key": "D0813ru.txt:249",
   "file": "D0813ru.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "死守しなければならなかった。",
   "ko_candidate": "사수해야만 했다｡"
  },
  {
   "id": 16576,
   "key": "D0813ru.txt:251",
   "file": "D0813ru.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その資格は自分にはないから。",
   "ko_candidate": "그럴 자격이 자신에게는 없으니까｡"
  },
  {
   "id": 16577,
   "key": "D0813ru.txt:252",
   "file": "D0813ru.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの獣と対峙するのは、自分ではない。",
   "ko_candidate": "저 짐승과 대치하는 건 자신이 아니다｡"
  },
  {
   "id": 16578,
   "key": "D0813ru.txt:253",
   "file": "D0813ru.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎なのだから。",
   "ko_candidate": "다이쥬지 쿠로니까｡"
  },
  {
   "id": 16579,
   "key": "D0813ru.txt:255",
   "file": "D0813ru.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だから――なお、悲しかった。",
   "ko_candidate": "그래서- 더욱 슬펐다｡"
  },
  {
   "id": 16580,
   "key": "D0813ru.txt:259",
   "file": "D0813ru.txt",
   "line": 259,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こんな恐怖を相手に……それでも……『後味が悪い』からって……っ。 なんて人なんですか……貴方は……！」",
   "ko_candidate": "「이런 공포를 상대로… 그래도… '뒷맛이 나쁘다'고 해서… 도대체 어떤 사람이세요… 당신은…!」 「…그랜드 마스터!」"
  },
  {
   "id": 16581,
   "key": "D0813ru.txt:271",
   "file": "D0813ru.txt",
   "line": 271,
   "speaker": "カリグラ / クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……グランど・まスたーッ！」 「大導師！」",
   "ko_candidate": "「<RUBY text=\"그랜드 마스터\">대도사</RUBY>님!」"
  },
  {
   "id": 16582,
   "key": "D0813ru.txt:280",
   "file": "D0813ru.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "横たわる機体の上で大男が、空に浮かぶ彼等の導師に対して、跪いた。",
   "ko_candidate": "쓰러진 기체 위에서 거구의 남자가 공중에 떠 있는 그들의 도사를 향해 무릎을 꿇었다｡"
  },
  {
   "id": 16583,
   "key": "D0813ru.txt:282",
   "file": "D0813ru.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう１人クラウディウスの方も、コクピットから飛び出し、恭しく跪く。",
   "ko_candidate": "다른 한 명인 클라우디우스 쪽도 콕핏에서 뛰쳐나와 공손히 무릎을 꿇는다｡"
  },
  {
   "id": 16584,
   "key": "D0813ru.txt:283",
   "file": "D0813ru.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声から予想される通りの、小柄な少年だった。",
   "ko_candidate": "목소리로 예상되는 대로의 작은 체구의 소년이었다｡"
  },
  {
   "id": 16585,
   "key": "D0813ru.txt:285",
   "file": "D0813ru.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マスターテリオンは空から２人を見下ろして、何の感情も無い……と云うより、明らかに気怠そうな声で告げる。",
   "ko_candidate": "마스터 테리온은 공중에서 두 사람을 내려다보며 아무런 감정도 없는… 라기보다는 명백히 권태로운 목소리로 고한다｡"
  },
  {
   "id": 16586,
   "key": "D0813ru.txt:290",
   "file": "D0813ru.txt",
   "line": 290,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「御苦労。貴公等は退くが良い。後は余に任せよ」",
   "ko_candidate": "「수고했다｡ 너희들은 물러나도 좋다｡ 나머지는 내게 맡겨라」"
  },
  {
   "id": 16587,
   "key": "D0813ru.txt:295",
   "file": "D0813ru.txt",
   "line": 295,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……で、デスガ……」",
   "ko_candidate": "「하… 하지만…」"
  },
  {
   "id": 16588,
   "key": "D0813ru.txt:300",
   "file": "D0813ru.txt",
   "line": 300,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「二度言わせるな。貴公等は充分に任務を果たしたのだ。問題ない」",
   "ko_candidate": "「두 번 말하게 하지 마라｡ 너희들은 충분히 임무를 완수했다｡ 문제없다」"
  },
  {
   "id": 16589,
   "key": "D0813ru.txt:305",
   "file": "D0813ru.txt",
   "line": 305,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……はいっ」",
   "ko_candidate": "「……네」"
  },
  {
   "id": 16590,
   "key": "D0813ru.txt:310",
   "file": "D0813ru.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人が頷くと同時、２体のデウス・マキナは光の粒子となって薄れてゆく。",
   "ko_candidate": "두 사람이 고개를 끄덕이자 동시에､ 두 대의 데우스 마키나가 빛의 입자가 되어 희미해져 간다｡"
  }
 ]
}