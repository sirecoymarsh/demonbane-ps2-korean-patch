 "items": [
  {
   "id": 37125,
   "key": "D1404le.txt:280",
   "file": "D1404le.txt",
   "line": 280,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「申し訳なく思っております。貴方を、こんな事に巻き込んで……」",
   "ko_candidate": "「죄송스럽게 생각합니다｡ 당신을 이런 일에 휘말리게 해서…」"
  },
  {
   "id": 37126,
   "key": "D1404le.txt:286",
   "file": "D1404le.txt",
   "line": 286,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何言ってるんだよ姫さん。俺たちが勝手に居座っただけじゃないか。 『何処ぞの馬の骨』にデモンベインを奪われた姫さんは、被害者だよ」",
   "ko_candidate": "「무슨 소리야 공주님｡ 우리가 멋대로 들어와 있었을 뿐이잖아｡ 『어디서 굴러온 건지 모를 놈』에게 데몬베인을 빼앗긴 공주님은 피해자야」"
  },
  {
   "id": 37127,
   "key": "D1404le.txt:290",
   "file": "D1404le.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、笑う。",
   "ko_candidate": "말하고 웃는다｡"
  },
  {
   "id": 37128,
   "key": "D1404le.txt:294",
   "file": "D1404le.txt",
   "line": 294,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだ。自惚れるなよ、小娘。妾は妾の仕事をこなすだけだ。 汝の都合など知った事か」",
   "ko_candidate": "「그래｡ 자만하지 마라､ 꼬마 아가씨｡ 나는 나의 일을 할 뿐이다｡ 네 사정 따위 알 바 아니다」"
  },
  {
   "id": 37129,
   "key": "D1404le.txt:298",
   "file": "D1404le.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "続いて、アルも笑った。",
   "ko_candidate": "이어서 알도 웃었다｡"
  },
  {
   "id": 37130,
   "key": "D1404le.txt:300",
   "file": "D1404le.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんが、弱々しい笑みを返した。",
   "ko_candidate": "공주님이 힘없는 미소를 지었다｡"
  },
  {
   "id": 37131,
   "key": "D1404le.txt:306",
   "file": "D1404le.txt",
   "line": 306,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「わたくしには、もう貴方がたに未来を託すより術はありません」 「これを……ナアカル・コードの解除キーです。これでわたくしの承認無しに、いつでもレムリア・インパクトを撃つ事が出来ます」",
   "ko_candidate": "「저에게는 이제 당신들에게 미래를 맡길 수밖에 없습니다｡ 이것을… 나아칼 코드의 해제 키입니다｡ 이걸로 제 승인 없이 언제든 레무리아 임팩트를 쏠 수 있습니다」"
  },
  {
   "id": 37132,
   "key": "D1404le.txt:313",
   "file": "D1404le.txt",
   "line": 313,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ん……確かに受け取ったよ」",
   "ko_candidate": "「음… 확실히 받았어」"
  },
  {
   "id": 37133,
   "key": "D1404le.txt:316",
   "file": "D1404le.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "名の通り、まんま古風な鍵を象った解除キーを受け取る。",
   "ko_candidate": "말 그대로 고풍스러운 열쇠 모양의 해제 키를 받는다｡"
  },
  {
   "id": 37134,
   "key": "D1404le.txt:317",
   "file": "D1404le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの……姫さんの爺さんの、覇道家の願いが込められた鍵。",
   "ko_candidate": "공주님의… 공주님의 할아버지의､ 하도가의 염원이 담긴 열쇠｡"
  },
  {
   "id": 37135,
   "key": "D1404le.txt:323",
   "file": "D1404le.txt",
   "line": 323,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「夜明けと同時に、覇道財閥の全戦力を投じて、ルルイエに向かいます。 大十字様、アル・アジフ様……」",
   "ko_candidate": "「새벽과 동시에 하도 재벌의 모든 전력을 투입해 르뤼에로 향합니다｡ 다이쥬지 님､ 알 아지프 님…」"
  },
  {
   "id": 37136,
   "key": "D1404le.txt:328",
   "file": "D1404le.txt",
   "line": 328,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうか、世界の未来をよろしくお願い致します」",
   "ko_candidate": "「부디 세계의 미래를 잘 부탁드립니다」"
  },
  {
   "id": 37137,
   "key": "D1404le.txt:331",
   "file": "D1404le.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人は深々と頭を下げた。",
   "ko_candidate": "두 사람은 깊이 고개를 숙였다｡"
  },
  {
   "id": 37138,
   "key": "D1404le.txt:348",
   "file": "D1404le.txt",
   "line": 348,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うっ……」",
   "ko_candidate": "「으…」"
  },
  {
   "id": 37139,
   "key": "D1404le.txt:351",
   "file": "D1404le.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ガキんちょどもが、避難している部屋に入ると……当然と言うか、案の定と言うか、重苦しくて悲痛な空気に、圧倒されそうになった。",
   "ko_candidate": "꼬마들이 피난하고 있는 방에 들어가자… 당연하다고 할까､ 예상대로라고 할까､ 무거운 공기와 비통한 분위기에 압도될 뻔했다｡"
  },
  {
   "id": 37140,
   "key": "D1404le.txt:355",
   "file": "D1404le.txt",
   "line": 355,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎お兄ちゃん」",
   "ko_candidate": "「…쿠로 오빠」"
  },
  {
   "id": 37141,
   "key": "D1404le.txt:358",
   "file": "D1404le.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アリスンがどんよりと面を上げる。",
   "ko_candidate": "앨리슨이 무겁게 고개를 든다｡"
  },
  {
   "id": 37142,
   "key": "D1404le.txt:359",
   "file": "D1404le.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣き続けていたのだろうか、目が真っ赤に充血していた。",
   "ko_candidate": "계속 울고 있었던 걸까､ 눈이 새빨갛게 충혈되어 있었다｡"
  },
  {
   "id": 37143,
   "key": "D1404le.txt:360",
   "file": "D1404le.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ジョージもコリンも似たようなものだった。",
   "ko_candidate": "죠지도 콜린도 비슷한 상태였다｡"
  },
  {
   "id": 37144,
   "key": "D1404le.txt:364",
   "file": "D1404le.txt",
   "line": 364,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……暗いな、汝等」",
   "ko_candidate": "「…어둡구나､ 너희들」"
  },
  {
   "id": 37145,
   "key": "D1404le.txt:368",
   "file": "D1404le.txt",
   "line": 368,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だって……」",
   "ko_candidate": "「그야…」"
  },
  {
   "id": 37146,
   "key": "D1404le.txt:372",
   "file": "D1404le.txt",
   "line": 372,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――大丈夫さ」",
   "ko_candidate": "「--괜찮아」"
  },
  {
   "id": 37147,
   "key": "D1404le.txt:375",
   "file": "D1404le.txt",
   "line": 375,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アリスンの頭を撫でながら、告げる。",
   "ko_candidate": "앨리슨의 머리를 쓰다듬으며 말한다｡"
  },
  {
   "id": 37148,
   "key": "D1404le.txt:376",
   "file": "D1404le.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガキんちょどもの視線が集中した。",
   "ko_candidate": "꼬마들의 시선이 집중됐다｡"
  },
  {
   "id": 37149,
   "key": "D1404le.txt:380",
   "file": "D1404le.txt",
   "line": 380,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんはメタトロンなんだから。『ブラックロッジ』になんかに負けねえよ」",
   "ko_candidate": "「라이카 씨는 메타트론이니까｡ 『블랙로지』 따위에게 지지 않아」"
  },
  {
   "id": 37150,
   "key": "D1404le.txt:386",
   "file": "D1404le.txt",
   "line": 386,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……」",
   "ko_candidate": "「아…」"
  },
  {
   "id": 37151,
   "key": "D1404le.txt:389",
   "file": "D1404le.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戸惑うような、躊躇うような沈黙があった。",
   "ko_candidate": "당황스러운 듯､ 망설이는 듯한 침묵이 있었다｡"
  },
  {
   "id": 37152,
   "key": "D1404le.txt:390",
   "file": "D1404le.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "わずかに俯くアリスンに、俺は訊ねる。",
   "ko_candidate": "살짝 고개를 숙이는 앨리슨에게 나는 묻는다｡"
  },
  {
   "id": 37153,
   "key": "D1404le.txt:394",
   "file": "D1404le.txt",
   "line": 394,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ショックだったか？」",
   "ko_candidate": "「…충격이었어?」"
  },
  {
   "id": 37154,
   "key": "D1404le.txt:400",
   "file": "D1404le.txt",
   "line": 400,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ん……」",
   "ko_candidate": "「응…」"
  },
  {
   "id": 37155,
   "key": "D1404le.txt:403",
   "file": "D1404le.txt",
   "line": 403,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "困ったように口噤む。",
   "ko_candidate": "난처한 듯 입을 다문다｡"
  },
  {
   "id": 37156,
   "key": "D1404le.txt:404",
   "file": "D1404le.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はさらに訊ねる。",
   "ko_candidate": "나는 더 묻는다｡"
  },
  {
   "id": 37157,
   "key": "D1404le.txt:408",
   "file": "D1404le.txt",
   "line": 408,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんが嫌いなったか？」",
   "ko_candidate": "「라이카 씨가 싫어졌어?」"
  },
  {
   "id": 37158,
   "key": "D1404le.txt:416",
   "file": "D1404le.txt",
   "line": 416,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「違うよ……！」",
   "ko_candidate": "「아니야…!」"
  },
  {
   "id": 37159,
   "key": "D1404le.txt:419",
   "file": "D1404le.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぶんぶん首を横に振り、力いっぱい否定する。",
   "ko_candidate": "고개를 좌우로 흔들며 힘껏 부정한다｡"
  },
  {
   "id": 37160,
   "key": "D1404le.txt:420",
   "file": "D1404le.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アリスンだけではない。他の２人も同様だった。",
   "ko_candidate": "앨리슨뿐만이 아니다｡ 다른 두 명도 마찬가지였다｡"
  },
  {
   "id": 37161,
   "key": "D1404le.txt:426",
   "file": "D1404le.txt",
   "line": 426,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「嫌いになったりしないっ！　だってライカお姉ちゃんは、ライカお姉ちゃんだもの！」",
   "ko_candidate": "「싫어지지 않았어! 라이카 누나는 라이카 누나니까!」"
  },
  {
   "id": 37162,
   "key": "D1404le.txt:430",
   "file": "D1404le.txt",
   "line": 430,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ん……そうだな」",
   "ko_candidate": "「응… 그렇지」"
  },
  {
   "id": 37163,
   "key": "D1404le.txt:433",
   "file": "D1404le.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アリスンの答えを聞いて、俺は微笑んだ。",
   "ko_candidate": "앨리슨의 대답을 듣고 나는 미소 지었다｡"
  },
  {
   "id": 37164,
   "key": "D1404le.txt:434",
   "file": "D1404le.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心なしか重苦しい雰囲気がいくらか和らいだ気がする。",
   "ko_candidate": "기분 탓인지 무거운 분위기가 조금 누그러진 것 같다｡"
  }
 ]
}