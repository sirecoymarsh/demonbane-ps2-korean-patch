 "items": [
  {
   "id": 25472,
   "key": "D1109ru.txt:508",
   "file": "D1109ru.txt",
   "line": 508,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "着地。",
   "ko_candidate": "착지｡"
  },
  {
   "id": 25473,
   "key": "D1109ru.txt:509",
   "file": "D1109ru.txt",
   "line": 509,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "近くの崩れかけていたビルが、土煙を上げて倒壊した。",
   "ko_candidate": "근처의 무너져가던 빌딩이 먼지를 일으키며 무너졌다｡"
  },
  {
   "id": 25474,
   "key": "D1109ru.txt:513",
   "file": "D1109ru.txt",
   "line": 513,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……うっ……」",
   "ko_candidate": "「크……으읏……」"
  },
  {
   "id": 25475,
   "key": "D1109ru.txt:520",
   "file": "D1109ru.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この一瞬だけで、瑠璃は疲労困憊していた。",
   "ko_candidate": "이 한순간만으로도 루리는 피로에 지쳐있었다｡"
  },
  {
   "id": 25476,
   "key": "D1109ru.txt:522",
   "file": "D1109ru.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "精力を根こそぎ奪われるような感覚。",
   "ko_candidate": "정력을 송두리째 빼앗기는 듯한 감각｡"
  },
  {
   "id": 25477,
   "key": "D1109ru.txt:523",
   "file": "D1109ru.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身から噴き出る汗。手足が異様に重たい。",
   "ko_candidate": "온몸에서 뿜어져 나오는 땀｡ 손발이 이상하게 무겁다｡"
  },
  {
   "id": 25478,
   "key": "D1109ru.txt:524",
   "file": "D1109ru.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が遠い。",
   "ko_candidate": "의식이 멀어진다｡"
  },
  {
   "id": 25479,
   "key": "D1109ru.txt:529",
   "file": "D1109ru.txt",
   "line": 529,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あれだけ吠えたのだ……今更、逃げようだのと、調子の良い事を考えてはおるまいな？」",
   "ko_candidate": "「그렇게 큰소리쳤으면서…… 이제 와서 도망가겠다느니､ 그런 좋은 소리는 하지 않겠지?」"
  },
  {
   "id": 25480,
   "key": "D1109ru.txt:537",
   "file": "D1109ru.txt",
   "line": 537,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「つっ……」",
   "ko_candidate": "「츳……」"
  },
  {
   "id": 25481,
   "key": "D1109ru.txt:540",
   "file": "D1109ru.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "下唇を噛み締める。",
   "ko_candidate": "아랫입술을 깨문다｡"
  },
  {
   "id": 25482,
   "key": "D1109ru.txt:541",
   "file": "D1109ru.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重たい腕を無理に持ち上げた。",
   "ko_candidate": "무거운 팔을 억지로 들어올렸다｡"
  },
  {
   "id": 25483,
   "key": "D1109ru.txt:545",
   "file": "D1109ru.txt",
   "line": 545,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大丈夫ですわ。 初めてだから、少し驚いただけ。 大丈夫、戦えます！」",
   "ko_candidate": "「……괜찮아요｡ 처음이라서 조금 놀랐을 뿐이에요｡ 괜찮아요､ 싸울 수 있어요!」"
  },
  {
   "id": 25484,
   "key": "D1109ru.txt:552",
   "file": "D1109ru.txt",
   "line": 552,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良くぞ言った。雑兵相手に 手間取っている暇は無い。 一気に片を付けるぞ」",
   "ko_candidate": "「잘 말했다｡ 잡병 상대로 시간 낭비할 여유는 없다｡ 단숨에 해치우자」"
  },
  {
   "id": 25485,
   "key": "D1109ru.txt:559",
   "file": "D1109ru.txt",
   "line": 559,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何を……」",
   "ko_candidate": "「무엇을……」"
  },
  {
   "id": 25486,
   "key": "D1109ru.txt:564",
   "file": "D1109ru.txt",
   "line": 564,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「呪法武装を招喚する」",
   "ko_candidate": "「주법무장을 소환한다」"
  },
  {
   "id": 25487,
   "key": "D1109ru.txt:569",
   "file": "D1109ru.txt",
   "line": 569,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 25488,
   "key": "D1109ru.txt:572",
   "file": "D1109ru.txt",
   "line": 572,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の表情が、明らかに緊張で強張った。",
   "ko_candidate": "루리의 표정이 확연히 긴장으로 굳어졌다｡"
  },
  {
   "id": 25489,
   "key": "D1109ru.txt:574",
   "file": "D1109ru.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少し動いただけでも、この苦痛。",
   "ko_candidate": "조금만 움직여도 이런 고통｡"
  },
  {
   "id": 25490,
   "key": "D1109ru.txt:575",
   "file": "D1109ru.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これで招喚などと高位な術を行使すれば、 どうなるものか――",
   "ko_candidate": "이 상태로 소환 같은 고위 술을 행사하면 어떻게 될지……"
  },
  {
   "id": 25491,
   "key": "D1109ru.txt:584",
   "file": "D1109ru.txt",
   "line": 584,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「バルザイの偃月刀を抜くぞ」",
   "ko_candidate": "「바르자이의 언월도를 뽑겠다」"
  },
  {
   "id": 25492,
   "key": "D1109ru.txt:589",
   "file": "D1109ru.txt",
   "line": 589,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……はい！」",
   "ko_candidate": "「……네!」"
  },
  {
   "id": 25493,
   "key": "D1109ru.txt:596",
   "file": "D1109ru.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げ道は無かった。",
   "ko_candidate": "도망갈 길은 없었다｡"
  },
  {
   "id": 25494,
   "key": "D1109ru.txt:597",
   "file": "D1109ru.txt",
   "line": 597,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覚悟を決めるしかない。",
   "ko_candidate": "각오를 다지는 수밖에 없다｡"
  },
  {
   "id": 25495,
   "key": "D1109ru.txt:602",
   "file": "D1109ru.txt",
   "line": 602,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「偃月刀を持って来ておったな、小娘？　其れを憑代とする」 「その方が直接に招喚するよりは式を組み易いし、汝への負担も少ない」",
   "ko_candidate": "「언월도를 가져왔지､ 꼬마야? 그것을 매개체로 삼겠다｡ 그 편이 직접 소환하는 것보다 식을 짜기 쉽고､ 네게 가해지는 부담도 적다｡ 검을 손에 쥐어라」"
  },
  {
   "id": 25496,
   "key": "D1109ru.txt:608",
   "file": "D1109ru.txt",
   "line": 608,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「剣を手に執れ」",
   "ko_candidate": "「네!」"
  },
  {
   "id": 25497,
   "key": "D1109ru.txt:614",
   "file": "D1109ru.txt",
   "line": 614,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はい！」 言われるがままに、腰に下げていた偃月刀を握った。",
   "ko_candidate": "말대로 허리에 차고 있던 언월도를 잡았다｡"
  },
  {
   "id": 25498,
   "key": "D1109ru.txt:618",
   "file": "D1109ru.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刀身に刻まれた魔術文字が、仄かに紅く炎えていた。",
   "ko_candidate": "도신에 새겨진 마술 문자가 희미하게 붉게 타오르고 있었다｡"
  },
  {
   "id": 25499,
   "key": "D1109ru.txt:626",
   "file": "D1109ru.txt",
   "line": 626,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――我に傅き、我に仕え、我が秘術に力を与え、火の秘文字の刻まれし刃が霊験灼かに、我が命に背く諸々の霊を悉く恐怖せしめると共に」 「魔術の実践に必要な円、図、記号を描く助けと為れ。ヴーアの無敵の印に於いて――」",
   "ko_candidate": "「――내게 따르고､ 내게 복종하며､ 내 비술에 힘을 주어､ 불의 비문자가 새겨진 칼날이 영험하게､ 내 명령에 거역하는 모든 영을 모조리 두려워하게 함과 동시에､ 마술의 실천에 필요한 원､ 도형､ 기호를 그리는 데 도움이 되어라｡ 부어의 무적의 인장에 있어서――」"
  },
  {
   "id": 25500,
   "key": "D1109ru.txt:634",
   "file": "D1109ru.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "謡う様な、アルの呪文。",
   "ko_candidate": "노래하듯 읊조리는 알의 주문｡"
  },
  {
   "id": 25501,
   "key": "D1109ru.txt:635",
   "file": "D1109ru.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀を包み込む光が、輝きを増した。",
   "ko_candidate": "언월도를 감싸는 빛이 더욱 밝아졌다｡"
  },
  {
   "id": 25502,
   "key": "D1109ru.txt:636",
   "file": "D1109ru.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手に握った柄が熱い。",
   "ko_candidate": "손에 쥔 칼자루가 뜨겁다｡"
  },
  {
   "id": 25503,
   "key": "D1109ru.txt:640",
   "file": "D1109ru.txt",
   "line": 640,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……ううっ！」",
   "ko_candidate": "「크……으으읏!」"
  },
  {
   "id": 25504,
   "key": "D1109ru.txt:645",
   "file": "D1109ru.txt",
   "line": 645,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「力を与えよ！　力を与えよ！　力を与えよ！」",
   "ko_candidate": "「힘을 주어라! 힘을 주어라! 힘을 주어라!」"
  },
  {
   "id": 25505,
   "key": "D1109ru.txt:650",
   "file": "D1109ru.txt",
   "line": 650,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃああぁっ！」",
   "ko_candidate": "「꺄아아앗!」"
  },
  {
   "id": 25506,
   "key": "D1109ru.txt:656",
   "file": "D1109ru.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀が焔に包まれた。",
   "ko_candidate": "언월도가 불꽃에 휩싸였다｡"
  },
  {
   "id": 25507,
   "key": "D1109ru.txt:657",
   "file": "D1109ru.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄暗いコクピットが紅蓮に染まる。",
   "ko_candidate": "어두컴컴한 콕핏이 붉게 물들었다｡"
  },
  {
   "id": 25508,
   "key": "D1109ru.txt:659",
   "file": "D1109ru.txt",
   "line": 659,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逆流する術式が、魔力の波紋が、烈しく瑠璃を苛んだ。",
   "ko_candidate": "역류하는 술식이､ 마력의 파문이､ 격렬하게 루리를 괴롭혔다｡"
  },
  {
   "id": 25509,
   "key": "D1109ru.txt:666",
   "file": "D1109ru.txt",
   "line": 666,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うぅぅぅ…… ぐっ……あああっ！」",
   "ko_candidate": "「으으으……크읏……아아앗!」"
  },
  {
   "id": 25510,
   "key": "D1109ru.txt:675",
   "file": "D1109ru.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃が持つ偃月刀が焔に包まれると同時、デモンベインの傍らでも怪異が生じる。",
   "ko_candidate": "루리가 들고 있는 언월도가 불꽃에 휩싸임과 동시에､ 데몬베인 곁에서도 괴이한 일이 일어난다｡"
  },
  {
   "id": 25511,
   "key": "D1109ru.txt:676",
   "file": "D1109ru.txt",
   "line": 676,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜闇を追い払って焔が虚空に炎える。",
   "ko_candidate": "밤의 어둠을 몰아내고 불꽃이 허공에 타오른다｡"
  }
 ]
}