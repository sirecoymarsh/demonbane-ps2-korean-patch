 "items": [
  {
   "id": 32366,
   "key": "D1305al.txt:535",
   "file": "D1305al.txt",
   "line": 535,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『Ａｌ　Ａｚｉｆ』",
   "ko_candidate": "『Al Azif』"
  },
  {
   "id": 32367,
   "key": "D1305le.txt:26",
   "file": "D1305le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の怨嗟の聲が爆音となって、地下基地に轟く。",
   "ko_candidate": "무수한 원한의 목소리가 폭음이 되어 지하 기지에 울려 퍼진다｡"
  },
  {
   "id": 32368,
   "key": "D1305le.txt:27",
   "file": "D1305le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨嗟は護法の術を組み込まれた施設の建材をも侵し、",
   "ko_candidate": "원한은 수호의 술식이 새겨진 시설의 건축 자재마저 침식하고､"
  },
  {
   "id": 32369,
   "key": "D1305le.txt:28",
   "file": "D1305le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "施設内に染み出す。",
   "ko_candidate": "시설 내부로 스며든다｡"
  },
  {
   "id": 32370,
   "key": "D1305le.txt:30",
   "file": "D1305le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上層部で爆音の如き、断末魔。断末魔の如き爆音。",
   "ko_candidate": "상층부에서 폭음과 같은 단말마｡ 단말마와 같은 폭음｡"
  },
  {
   "id": 32371,
   "key": "D1305le.txt:37",
   "file": "D1305le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨霊の霊圧が、現実世界に影響を及ぼし、",
   "ko_candidate": "원령의 영압이 현실 세계에 영향을 미쳐､"
  },
  {
   "id": 32372,
   "key": "D1305le.txt:38",
   "file": "D1305le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上層部を吹き飛ばしたのだ。",
   "ko_candidate": "상층부를 날려버린 것이다｡"
  },
  {
   "id": 32373,
   "key": "D1305le.txt:42",
   "file": "D1305le.txt",
   "line": 42,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「死霊使いお得意の怨霊呪弾か！　直撃はなくとも吐き散らされた呪詛で、精神力の脆い者なら狂死するぞ！」",
   "ko_candidate": "「사령술사 특기의 원령주탄인가! 직격은 없어도 뿜어져 나온 저주로 정신력이 약한 자라면 미쳐 죽을 거다!」"
  },
  {
   "id": 32374,
   "key": "D1305le.txt:51",
   "file": "D1305le.txt",
   "line": 51,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「野郎……！」",
   "ko_candidate": "「이 자식…!」"
  },
  {
   "id": 32375,
   "key": "D1305le.txt:53",
   "file": "D1305le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの兵器の強さの根源は、即ち受けた怨念の量に比例する。",
   "ko_candidate": "저 무기의 강함의 근원은 즉 받은 원념의 양에 비례한다｡"
  },
  {
   "id": 32376,
   "key": "D1305le.txt:54",
   "file": "D1305le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "術者が殺した分だけ、鬼械神の放つ一撃は、その威力を増すのだ。",
   "ko_candidate": "술자가 죽인 만큼､ 귀계신이 내뿜는 일격은 그 위력을 더하는 것이다｡"
  },
  {
   "id": 32377,
   "key": "D1305le.txt:55",
   "file": "D1305le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反吐が出るほど、下衆な武装だ。",
   "ko_candidate": "구역질이 날 정도로 천박한 무장이다｡"
  },
  {
   "id": 32378,
   "key": "D1305le.txt:59",
   "file": "D1305le.txt",
   "line": 59,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぅぅぅぅぅぅ！」",
   "ko_candidate": "「크으으으으으!」"
  },
  {
   "id": 32379,
   "key": "D1305le.txt:70",
   "file": "D1305le.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "第２撃目が放たれる。",
   "ko_candidate": "제2격이 발사된다｡"
  },
  {
   "id": 32380,
   "key": "D1305le.txt:71",
   "file": "D1305le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨嗟の聲は更に大きく、断末魔の爆音は耳を劈かんばかりだ。",
   "ko_candidate": "원한의 목소리는 더욱 커지고､ 단말마의 폭음은 귀를 찢을 듯하다｡"
  },
  {
   "id": 32381,
   "key": "D1305le.txt:72",
   "file": "D1305le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……こうしてはいられない！",
   "ko_candidate": "…이대로 있을 순 없어!"
  },
  {
   "id": 32382,
   "key": "D1305le.txt:75",
   "file": "D1305le.txt",
   "line": 75,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「征くぞ、アル！」",
   "ko_candidate": "「가자､ 알!」"
  },
  {
   "id": 32383,
   "key": "D1305le.txt:79",
   "file": "D1305le.txt",
   "line": 79,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……やるしかないか！」",
   "ko_candidate": "「큭… 어쩔 수 없나!」"
  },
  {
   "id": 32384,
   "key": "D1305le.txt:89",
   "file": "D1305le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティングホラーに跨った俺を、旋風に舞う魔導書のページが囲んだ。",
   "ko_candidate": "헌팅 호러에 올라탄 나를 회오리치는 마도서의 페이지가 둘러쌌다｡"
  },
  {
   "id": 32385,
   "key": "D1305le.txt:90",
   "file": "D1305le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "閃光と共に、ページはボディスーツに化して、俺の躰を包む。マギウス・スタイルになった俺の肩に、小さくなったアルが乗る。",
   "ko_candidate": "섬광과 함께 페이지는 바디슈트로 변해 내 몸을 감싼다｡ 마기우스 스타일이 된 내 어깨에 작아진 알이 올라탄다｡"
  },
  {
   "id": 32386,
   "key": "D1305le.txt:97",
   "file": "D1305le.txt",
   "line": 97,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「カタパルトを起動させろ！」",
   "ko_candidate": "「카타펄트를 가동시켜!」"
  },
  {
   "id": 32387,
   "key": "D1305le.txt:101",
   "file": "D1305le.txt",
   "line": 101,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「い、いやだが、しかし……っ！」",
   "ko_candidate": "「싫､ 싫지만､ 하지만…!」"
  },
  {
   "id": 32388,
   "key": "D1305le.txt:105",
   "file": "D1305le.txt",
   "line": 105,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「早くしろ！」",
   "ko_candidate": "「빨리 해!」"
  },
  {
   "id": 32389,
   "key": "D1305le.txt:109",
   "file": "D1305le.txt",
   "line": 109,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ええい！　ったく強引であるなっ！」",
   "ko_candidate": "「에잇! 정말 강압적이구나!」"
  },
  {
   "id": 32390,
   "key": "D1305le.txt:120",
   "file": "D1305le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "虚数展開カタパルト内の魔術回路が作動し、強大な魔導エネルギーが巡り出す。",
   "ko_candidate": "허수전개 카타펄트 내의 마술 회로가 작동하고､ 강대한 마도 에너지가 흐르기 시작한다｡"
  },
  {
   "id": 32391,
   "key": "D1305le.txt:121",
   "file": "D1305le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カタパルト起動。同時に俺たちは、無限の可能性となって、総ての時空上に拡散された。",
   "ko_candidate": "카타펄트 가동｡ 동시에 우리는 무한한 가능성이 되어 모든 시공간 위로 확산되었다｡"
  },
  {
   "id": 32392,
   "key": "D1305le.txt:133",
   "file": "D1305le.txt",
   "line": 133,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何処にでも存在し得る」ハンティングホラーは、アーカムシティ上空で実数「１」となって、実体を得る。",
   "ko_candidate": "「어디에나 존재할 수 있는」 헌팅 호러는 아캄시티 상공에서 실수 「1」이 되어 실체를 얻는다｡"
  },
  {
   "id": 32393,
   "key": "D1305le.txt:134",
   "file": "D1305le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正面には、怨霊呪弾を掲げるデモンベインの巨体が、不吉な影となって聳えていた。",
   "ko_candidate": "정면에는 원령주탄을 들어 올린 데몬베인의 거체가 불길한 그림자가 되어 우뚝 서 있었다｡"
  },
  {
   "id": 32394,
   "key": "D1305le.txt:137",
   "file": "D1305le.txt",
   "line": 137,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ティベリウス！」",
   "ko_candidate": "「티베리우스!」"
  },
  {
   "id": 32395,
   "key": "D1305le.txt:143",
   "file": "D1305le.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインが振り返る。",
   "ko_candidate": "데몬베인이 돌아본다｡"
  },
  {
   "id": 32396,
   "key": "D1305le.txt:144",
   "file": "D1305le.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動かぬ鋼鉄の貌に、それでも今は邪悪の彩を見い出さずにはいられなかった。",
   "ko_candidate": "움직이지 않는 강철의 얼굴에､ 그래도 지금은 사악함의 색채를 발견하지 않을 수 없었다｡"
  },
  {
   "id": 32397,
   "key": "D1305le.txt:145",
   "file": "D1305le.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの内で、ティベリウスが哄笑する。",
   "ko_candidate": "데몬베인 안에서 티베리우스가 크게 웃는다｡"
  },
  {
   "id": 32398,
   "key": "D1305le.txt:149",
   "file": "D1305le.txt",
   "line": 149,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おほほほほほ！　どぉ、九郎ちゃぁん？」 「このデモンベイン……折角だから、あの時、回収して修復して、再利用させてもらう事にしたわよぉん」",
   "ko_candidate": "「오호호호호! 어때､ 쿠로 짜앙? 이 데몬베인… 모처럼이니까､ 그때 회수해서 수리해서 재사용하기로 했다구욧」"
  },
  {
   "id": 32399,
   "key": "D1305le.txt:156",
   "file": "D1305le.txt",
   "line": 156,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てめぇは……ァ！」",
   "ko_candidate": "「네 녀석은…아!」"
  },
  {
   "id": 32400,
   "key": "D1305le.txt:160",
   "file": "D1305le.txt",
   "line": 160,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあて、じゃ思い知らせてあげるわ。アンタらの言う『魔の断つ剣』も、所詮はただの兵器」 「血に穢れた殺しの道具だってことをねぇ！」",
   "ko_candidate": "「자､ 그럼 알려줄게｡ 너희가 말하는 『마를 베는 검』도 결국 그저 무기일 뿐｡ 피에 물든 살인 도구라는 걸 말이야!」"
  },
  {
   "id": 32401,
   "key": "D1305le.txt:167",
   "file": "D1305le.txt",
   "line": 167,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クソッタレ！」",
   "ko_candidate": "「젠장!」"
  },
  {
   "id": 32402,
   "key": "D1305le.txt:173",
   "file": "D1305le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティングホラーのスロットルを回す。",
   "ko_candidate": "헌팅 호러의 스로틀을 돌린다｡"
  },
  {
   "id": 32403,
   "key": "D1305le.txt:174",
   "file": "D1305le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "タイヤで虚空を踏み締めて、鋼鉄の獣が駈け出す。",
   "ko_candidate": "타이어로 허공을 밟으며 강철의 짐승이 달려나간다｡"
  },
  {
   "id": 32404,
   "key": "D1305le.txt:175",
   "file": "D1305le.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインに向かって突撃する。",
   "ko_candidate": "데몬베인을 향해 돌격한다｡"
  },
  {
   "id": 32405,
   "key": "D1305le.txt:177",
   "file": "D1305le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴に操られるくらいなら、いっそ俺の手でもう一度破壊してやる……！",
   "ko_candidate": "녀석에게 조종당하느니 차라리 내 손으로 다시 한 번 파괴해 주겠어…!"
  }
 ]
}