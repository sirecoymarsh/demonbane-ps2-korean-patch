 "items": [
  {
   "id": 1955,
   "key": "D0204ab.txt:501",
   "file": "D0204ab.txt",
   "line": 501,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「えっ？　ああ、そうだ。本のことでナイアさんに相談したかったんだ。魔導書のことなんだけど――」",
   "ko_candidate": "「엇? 아아､ 그래｡ 책 일로 나이아 씨에게 상담하고 싶었어｡ 마도서 일인데――」"
  },
  {
   "id": 1956,
   "key": "D0204ab.txt:506",
   "file": "D0204ab.txt",
   "line": 506,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふむ…… 君の魔導書は見つかったかい？」",
   "ko_candidate": "「흠… 네 마도서는 찾았니?」"
  },
  {
   "id": 1957,
   "key": "D0204ab.txt:515",
   "file": "D0204ab.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その言葉に、はっとなった。",
   "ko_candidate": "그 말에､ 흠칫 놀랐다｡"
  },
  {
   "id": 1958,
   "key": "D0204ab.txt:516",
   "file": "D0204ab.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "記憶が瞬時に再生される。",
   "ko_candidate": "기억이 순식간에 재생된다｡"
  },
  {
   "id": 1959,
   "key": "D0204ab.txt:518",
   "file": "D0204ab.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "甦る記憶は何故か、悪夢のように具合が悪かった。",
   "ko_candidate": "되살아나는 기억은､ 왜인지 악몽처럼､ 기분이 나빴다｡"
  },
  {
   "id": 1960,
   "key": "D0204ab.txt:524",
   "file": "D0204ab.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この人は……最初に逢ったあの時、俺が魔導書に選ばれる、みたいなことを言っていた。",
   "ko_candidate": "이 사람은… 처음 만났을 때､ 내가 마도서에 선택될 거라고､ 그런 말을 했었다｡"
  },
  {
   "id": 1961,
   "key": "D0204ab.txt:526",
   "file": "D0204ab.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しかも、しかもだ。",
   "ko_candidate": "게다가､ 게다가 말이야｡"
  },
  {
   "id": 1962,
   "key": "D0204ab.txt:527",
   "file": "D0204ab.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "最後にはっきりと『死霊秘法』の名前まで出して。 この人……何者なんだ？",
   "ko_candidate": "마지막엔 확실히 『<RUBY text=\"네크로노미콘\">사령비법</RUBY>』이란 이름까지 말하고｡"
  },
  {
   "id": 1963,
   "key": "D0204ab.txt:532",
   "file": "D0204ab.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺の、怯えるような警戒の視線に気付いたか、ナイアさんは薄っすらと意地の悪そうな笑みを浮かべた。",
   "ko_candidate": "이 사람… 대체 누구지? 내가 겁에 질린 듯한 경계의 시선을 보내자､ 나이아 씨는 희미하게 심술궂은 미소를 지었다｡"
  },
  {
   "id": 1964,
   "key": "D0204ab.txt:534",
   "file": "D0204ab.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "紅い唇の奥、口腔の暗闇の中に、なお紅い舌が蠢いている。",
   "ko_candidate": "붉은 입술 안쪽､ 구강의 어둠 속에서 더욱 붉은 혀가 꿈틀거리고 있다｡"
  },
  {
   "id": 1965,
   "key": "D0204ab.txt:540",
   "file": "D0204ab.txt",
   "line": 540,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「フフ……その様子だと、どうやら見事、魔導書に選ばれたようだね？　違うかな……？」",
   "ko_candidate": "「후후… 그 모습을 보니､ 아무래도 멋지게 마도서에 선택된 것 같군? 틀렸나…?」"
  },
  {
   "id": 1966,
   "key": "D0204ab.txt:545",
   "file": "D0204ab.txt",
   "line": 545,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あんたは……」",
   "ko_candidate": "「당신은…」"
  },
  {
   "id": 1967,
   "key": "D0204ab.txt:550",
   "file": "D0204ab.txt",
   "line": 550,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや、そんなに怖い目で見ないでおくれよ。大した事じゃない。あの時も言ったじゃないか。『何となく分かる』ってね」 「白状すると、僕はその手の勘――霊感って言えば良いのかな？　そういうのが強いんだよ。だから、こんな趣味に気触れちゃう訳で」",
   "ko_candidate": "「아니､ 그렇게 무서운 눈으로 보지 말게｡ 대단한 일은 아니야｡ 그때도 말했잖아｡ 『왠지 모르게 알 수 있다』고 말이야｡ 고백하자면､ 난 그런 종류의 감-영감이라고 하면 될까? 그런 게 강해｡ 그래서 이런 취미에 빠진 거지」"
  },
  {
   "id": 1968,
   "key": "D0204ab.txt:559",
   "file": "D0204ab.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "念入りにシャッフルされたタロットが、再び机の上に積まれた。",
   "ko_candidate": "꼼꼼히 셔플된 타로가 다시 책상 위에 쌓였다｡"
  },
  {
   "id": 1969,
   "key": "D0204ab.txt:561",
   "file": "D0204ab.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一番上のカードをトントンと指先で叩き、上目使いに俺を見つめる。",
   "ko_candidate": "맨 위의 카드를 톡톡 손가락으로 두드리며､ 올려다보며 나를 바라본다｡"
  },
  {
   "id": 1970,
   "key": "D0204ab.txt:567",
   "file": "D0204ab.txt",
   "line": 567,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どうだい？ 一つ占っていかないかい？」 「ああ、お代は良いよ。君と僕との仲だ。サービスしとこうじゃないか」",
   "ko_candidate": "「어때? 한 번 점을 봐볼래? 아､ 비용은 괜찮아｡ 너와 나의 사이잖아｡ 서비스해주지」"
  },
  {
   "id": 1971,
   "key": "D0204ab.txt:577",
   "file": "D0204ab.txt",
   "line": 577,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「俺は……」",
   "ko_candidate": "「나는…」 뭘까?"
  },
  {
   "id": 1972,
   "key": "D0204ab.txt:580",
   "file": "D0204ab.txt",
   "line": 580,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何だろう？ 頭がボーッとしているような。",
   "ko_candidate": "머리가 멍한 것 같아｡"
  },
  {
   "id": 1973,
   "key": "D0204ab.txt:583",
   "file": "D0204ab.txt",
   "line": 583,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "前もそうだった。 この人と話していると雰囲気に呑み込まれてしまうというか、意識に霞がかかるというか……",
   "ko_candidate": "뭘까? 이 사람과 이야기하고 있으면､ 전에도 그랬지､ 분위기에 휩쓸려 버리는 것 같달까…"
  },
  {
   "id": 1974,
   "key": "D0204ab.txt:586",
   "file": "D0204ab.txt",
   "line": 586,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "駄目だ……しっかりしなきゃ。",
   "ko_candidate": "안 돼… 정신 차려야 해｡"
  },
  {
   "id": 1975,
   "key": "D0204ab.txt:592",
   "file": "D0204ab.txt",
   "line": 592,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……俺は、別の魔導書を探さなきゃ……」",
   "ko_candidate": "「그보다… 난 다른 마도서를 찾아야…」"
  },
  {
   "id": 1976,
   "key": "D0204ab.txt:597",
   "file": "D0204ab.txt",
   "line": 597,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「望もうが望むまいが、運命は君を逃してはくれない」 「そう。君は最高位の魔導書 『アル・アジフ』の主人と為るべき、 運命の子。魔術師の王。黒き王と 対峙する白き王……」",
   "ko_candidate": "「원하든 원하지 않든､ 운명은 너를 놓아주지 않을 거야｡ 그래｡ 너는 최고위의 마도서 『알 아지프』의 주인이 될､ 운명의 아이｡ 마술사의 왕｡ 검은 왕과 대치하는 하얀 왕…」"
  },
  {
   "id": 1977,
   "key": "D0204ab.txt:608",
   "file": "D0204ab.txt",
   "line": 608,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "タロットカードが次々と、めくられていく。",
   "ko_candidate": "타로 카드가 차례차례 넘겨진다｡"
  },
  {
   "id": 1978,
   "key": "D0204ab.txt:609",
   "file": "D0204ab.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "小さな机の上で、宇宙を形成する。",
   "ko_candidate": "타로 카드는 작은 책상 위에서 우주를 형성한다｡"
  },
  {
   "id": 1979,
   "key": "D0204ab.txt:612",
   "file": "D0204ab.txt",
   "line": 612,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "縦に連なる十枚のカード。そう即ち――生命の樹。",
   "ko_candidate": "세로로 이어지는 열 장의 카드｡ 그러니까-생명의 나무｡"
  },
  {
   "id": 1980,
   "key": "D0204ab.txt:618",
   "file": "D0204ab.txt",
   "line": 618,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「王冠＝世界」",
   "ko_candidate": "「왕관=세계」"
  },
