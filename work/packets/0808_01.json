   "line": 205,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……遠慮しとく」",
   "ko_candidate": "「순수하게 무서워서야!」"
  },
  {
   "id": 14020,
   "key": "D0808al.txt:210",
   "file": "D0808al.txt",
   "line": 210,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な……ッ!? 何が気に入らない!?」",
   "ko_candidate": "「야~이 야~이! 차였다 차였다~~!」 「으으으으으으으으…!」"
  },
  {
   "id": 14021,
   "key": "D0808al.txt:214",
   "file": "D0808al.txt",
