   "line": 187,
   "speaker": "ダンセイニ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てけり・り」",
   "ko_candidate": "「아니､ 손짓해도」"
  },
  {
   "id": 14016,
   "key": "D0808al.txt:191",
