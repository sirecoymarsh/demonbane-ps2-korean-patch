   "line": 191,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや、手招きされても」",
   "ko_candidate": "「빨리 와!」 「테케리?리」(불길하게 꿈틀거린다｡ 수용 태세 만전)"
  },
  {
   "id": 14017,
