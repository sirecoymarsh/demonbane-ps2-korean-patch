   "line": 195,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「早く来いっ！」",
   "ko_candidate": "「…사양할게」"
  },
  {
   "id": 14018,
   "key": "D0808al.txt:200",
