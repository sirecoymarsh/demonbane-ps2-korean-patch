 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リューガ": "류가",
  "ライカ": "라이카"
 },
 "items": [
  {
   "id": 33137,
   "key": "D1307le.txt:59",
   "file": "D1307le.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭が割れる。",
   "ko_candidate": "머리가 갈라진다｡"
  },
  {
   "id": 33138,
   "key": "D1307le.txt:60",
   "file": "D1307le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳が灼けつく。",
   "ko_candidate": "뇌가 타오른다｡"
  },
  {
   "id": 33139,
   "key": "D1307le.txt:62",
   "file": "D1307le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まただ。",
   "ko_candidate": "또다｡"
  },
  {
   "id": 33140,
   "key": "D1307le.txt:63",
   "file": "D1307le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また始まった。",
   "ko_candidate": "또 시작됐다｡"
  },
  {
   "id": 33141,
   "key": "D1307le.txt:64",
   "file": "D1307le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また、記憶の暴走だ。",
   "ko_candidate": "또､ 기억의 폭주다｡"
  },
  {
   "id": 33142,
   "key": "D1307le.txt:66",
   "file": "D1307le.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見知らぬ過去が実体を伴って、刃を突き立ててくる。",
   "ko_candidate": "낯선 과거가 실체를 동반하여 칼날을 꽂아 넣는다｡"
  },
  {
   "id": 33143,
   "key": "D1307le.txt:68",
   "file": "D1307le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭を押さえ蹲り、リューガは絶叫した。",
   "ko_candidate": "머리를 누르고 쪼그리고 앉아､ 류가는 절규했다｡"
  },
  {
   "id": 33144,
   "key": "D1307le.txt:70",
   "file": "D1307le.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの時からだ。",
   "ko_candidate": "그때부터다｡"
  },
  {
   "id": 33145,
   "key": "D1307le.txt:71",
   "file": "D1307le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカにトドメを刺そうとしたあの時。",
   "ko_candidate": "라이카에게 최후의 일격을 가하려 했던 그때｡"
  },
  {
   "id": 33146,
   "key": "D1307le.txt:73",
   "file": "D1307le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "記憶のフラッシュ・バック。",
   "ko_candidate": "기억의 플래시백｡"
  },
  {
   "id": 33147,
   "key": "D1307le.txt:74",
   "file": "D1307le.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ストロボのように脳裏に残像を灼きつけている。",
   "ko_candidate": "스트로보처럼 뇌리에 잔상을 새기고 있다｡"
  },
  {
   "id": 33148,
   "key": "D1307le.txt:76",
   "file": "D1307le.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思考が纏まらない。",
   "ko_candidate": "생각이 정리되지 않는다｡"
  },
  {
   "id": 33149,
   "key": "D1307le.txt:77",
   "file": "D1307le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これでは機能の制御を、自らの管轄下に置けない。",
   "ko_candidate": "이래서는 기능의 제어를､ 자신의 관할 하에 둘 수 없다｡"
  },
  {
   "id": 33150,
   "key": "D1307le.txt:79",
   "file": "D1307le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから、あんな腐乱死体如きに遅れを取る。",
   "ko_candidate": "그래서 그런 부패한 시체 따위에게 뒤처지는 것이다｡"
  },
  {
   "id": 33151,
   "key": "D1307le.txt:80",
   "file": "D1307le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こうして無様を晒しつつ、逃げ回る羽目になる。",
   "ko_candidate": "이렇게 초라한 모습을 보이며 도망다닐 수밖에 없다｡"
  },
  {
   "id": 33152,
   "key": "D1307le.txt:82",
   "file": "D1307le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "おのれおのれおのれおのれおのれ。",
   "ko_candidate": "이 몸이 이 몸이 이 몸이 이 몸이 이 몸이｡"
  },
  {
   "id": 33153,
   "key": "D1307le.txt:83",
   "file": "D1307le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故、この己が鼠の真似事をしなければならない！",
   "ko_candidate": "왜､ 이 내가 쥐의 흉내를 내야 하는 것인가!"
  },
  {
   "id": 33154,
   "key": "D1307le.txt:94",
   "file": "D1307le.txt",
   "line": 94,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「がガッ！　グヴァらバ……ハァァァァぐっあああッッ！」",
   "ko_candidate": "「가악! 그우바라바……하아아아아크으아아악!!」"
  },
  {
   "id": 33155,
   "key": "D1307le.txt:97",
   "file": "D1307le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "熱い。",
   "ko_candidate": "뜨겁다｡"
  },
  {
   "id": 33156,
   "key": "D1307le.txt:98",
   "file": "D1307le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "熱い熱い熱い熱い熱い。",
   "ko_candidate": "뜨겁다 뜨겁다 뜨겁다 뜨겁다 뜨겁다｡"
  },
  {
   "id": 33157,
   "key": "D1307le.txt:99",
   "file": "D1307le.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼熱する記憶の刃が、脳細胞を死滅させる。",
   "ko_candidate": "작열하는 기억의 칼날이 뇌세포를 사멸시킨다｡"
  },
  {
   "id": 33158,
   "key": "D1307le.txt:101",
   "file": "D1307le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳細胞の断末魔が、神経細胞に伝播し、ズタズタに引き裂いていく。",
   "ko_candidate": "뇌세포의 단말마가 신경세포에 전파되어 갈기갈기 찢어놓는다｡"
  },
  {
   "id": 33159,
   "key": "D1307le.txt:103",
   "file": "D1307le.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この記憶は何だ。",
   "ko_candidate": "이 기억은 뭐지｡"
  },
  {
   "id": 33160,
   "key": "D1307le.txt:104",
   "file": "D1307le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故、己を追い詰める。",
   "ko_candidate": "왜､ 나를 몰아세우는 거지｡"
  },
  {
   "id": 33161,
   "key": "D1307le.txt:105",
   "file": "D1307le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故、己の邪魔をする。",
   "ko_candidate": "왜､ 나의 방해를 하는 거지｡"
  },
  {
   "id": 33162,
   "key": "D1307le.txt:107",
   "file": "D1307le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何が――何が何が何が何が何が！　この己の前に立ち塞がる！",
   "ko_candidate": "무엇이――무엇이 무엇이 무엇이 무엇이 무엇이! 이 내 앞을 가로막는 거지!"
  },
  {
   "id": 33163,
   "key": "D1307le.txt:114",
   "file": "D1307le.txt",
   "line": 114,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアアアァァァァァァァ――――――ッ！」",
   "ko_candidate": "「아아아아아아아아아아아――――――악!」"
  },
  {
   "id": 33164,
   "key": "D1307le.txt:123",
   "file": "D1307le.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言われずとも分かる。",
   "ko_candidate": "말하지 않아도 알겠어｡"
  },
  {
   "id": 33165,
   "key": "D1307le.txt:124",
   "file": "D1307le.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分からないはずがない。",
   "ko_candidate": "모를 리가 없지｡"
  },
  {
   "id": 33166,
   "key": "D1307le.txt:126",
   "file": "D1307le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僕らが学んでいるのは全て、殺しの講義。",
   "ko_candidate": "우리가 배우고 있는 것은 모두 살인의 강의｡"
  },
  {
   "id": 33167,
   "key": "D1307le.txt:127",
   "file": "D1307le.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼らは僕らを兵器として精製するつもりなのだ。",
   "ko_candidate": "그들은 우리를 무기로 정제할 생각인 거야｡"
  },
  {
   "id": 33168,
   "key": "D1307le.txt:129",
   "file": "D1307le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "息を吸うように殺し、吸った息を吐くように壊す。",
   "ko_candidate": "숨 쉬듯이 죽이고､ 내쉰 숨처럼 파괴한다｡"
  },
  {
   "id": 33169,
   "key": "D1307le.txt:131",
   "file": "D1307le.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "当然に自然に、殺戮をこなす人間兵器。",
   "ko_candidate": "당연하고 자연스럽게 살육을 해내는 인간병기｡"
  },
  {
   "id": 33170,
   "key": "D1307le.txt:133",
   "file": "D1307le.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "命の森を荒野と変えて、死の平穏をもたらす戦鬼。",
   "ko_candidate": "생명의 숲을 황야로 바꾸고､ 죽음의 평온을 가져오는 전귀｡"
  },
  {
   "id": 33171,
   "key": "D1307le.txt:135",
   "file": "D1307le.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渇いた社会に血の河を流し、死に絶えた世界を潤す祭司。",
   "ko_candidate": "메마른 사회에 피의 강을 흘려､ 죽어가는 세상을 적시는 제사장｡"
  },
  {
   "id": 33172,
   "key": "D1307le.txt:136",
   "file": "D1307le.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そういうモノに、僕たちは成る。",
   "ko_candidate": "그런 것들로､ 우리는 변한다｡"
  },
  {
   "id": 33173,
   "key": "D1307le.txt:138",
   "file": "D1307le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのことに痛みはあるのか。",
   "ko_candidate": "그것에 고통이 있을까｡"
  },
  {
   "id": 33174,
   "key": "D1307le.txt:139",
   "file": "D1307le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "罪悪感を、哀しみを感じるだろうか。",
   "ko_candidate": "죄책감을､ 슬픔을 느낄까｡"
  },
  {
   "id": 33175,
   "key": "D1307le.txt:141",
   "file": "D1307le.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "多分、答えは否だ。",
   "ko_candidate": "아마도 답은 아니다｡"
  },
  {
   "id": 33176,
   "key": "D1307le.txt:142",
   "file": "D1307le.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僕たちが居て良い場所がここしかないのなら……そうするより他はない。",
   "ko_candidate": "우리가 있어도 좋은 곳이 여기밖에 없다면… 그렇게 할 수밖에 없어｡"
  }
 ]
}