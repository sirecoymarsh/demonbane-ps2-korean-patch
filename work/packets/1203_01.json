 "items": [
  {
   "id": 26989,
   "key": "D1203le.txt:172",
   "file": "D1203le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気を抜けば、偃月刀を奪われてしまう。",
   "ko_candidate": "방심하면 언월도를 빼앗길 것이다｡"
  },
  {
   "id": 26990,
   "key": "D1203le.txt:179",
   "file": "D1203le.txt",
   "line": 179,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「よぉ……待っていたぜ、インスタント野郎……っ」 「てめぇらはカリグラ殺したんだ……楽に死ねると思ってんじゃねえぞっ！」",
   "ko_candidate": "「야……기다리고 있었다고､ 인스턴트 자식…… 너희들이 칼리굴라를 죽였지……쉽게 죽을 수 있을 거라 생각하지 마!」"
  },
  {
   "id": 26991,
   "key": "D1203le.txt:186",
   "file": "D1203le.txt",
   "line": 186,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それはこっちの台詞だ、クソガキ！　好き勝手ワガママしたい放題、やってくれて！」 「世間知らずの坊やに社会の厳しさってもんを教育してやるぜ！」",
   "ko_candidate": "「그건 내 대사다､ 망할 가키! 마음대로 제멋대로 하고 싶은 대로 해놓고! 세상 물정 모르는 꼬마에게 사회의 엄격함이란 걸 가르쳐 주마!」"
  },
  {
   "id": 26992,
   "key": "D1203le.txt:193",
   "file": "D1203le.txt",
   "line": 193,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬかせや！」",
   "ko_candidate": "「헛소리 마!」"
  },
  {
   "id": 26993,
   "key": "D1203le.txt:197",
   "file": "D1203le.txt",
   "line": 197,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「粋がるな！」",
   "ko_candidate": "「까불지 마!」"
  },
  {
   "id": 26994,
   "key": "D1203le.txt:204",
   "file": "D1203le.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアの銃口を向けようとするが、クラウディウスの左手から放たれたヨーヨーによって弾かれ、床を転がる。",
   "ko_candidate": "크투가의 총구를 겨누려 하지만､ 클라우디우스의 왼손에서 날아온 요요에 맞아 바닥을 굴러간다｡"
  },
  {
   "id": 26995,
   "key": "D1203le.txt:209",
   "file": "D1203le.txt",
   "line": 209,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまった！」",
   "ko_candidate": "「젠장!」"
  },
  {
   "id": 26996,
   "key": "D1203le.txt:214",
   "file": "D1203le.txt",
   "line": 214,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハッーハッ！　そう上手くはいかねえってことよ！」",
   "ko_candidate": "「핫-하! 그렇게 쉽게는 안 된다고!」"
  },
  {
   "id": 26997,
   "key": "D1203le.txt:218",
   "file": "D1203le.txt",
   "line": 218,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………あれ？」",
   "ko_candidate": "「……………어라?」"
  },
  {
   "id": 26998,
   "key": "D1203le.txt:221",
   "file": "D1203le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ケンダマにかかる抵抗の無さに、戸惑うクラウディウス。",
   "ko_candidate": "켄다마에 걸리는 저항의 부재에 당황하는 클라우디우스｡"
  },
  {
   "id": 26999,
   "key": "D1203le.txt:222",
   "file": "D1203le.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はバルザイの偃月刀をあっさり手放していた。",
   "ko_candidate": "나는 바르자이의 언월도를 너무나 쉽게 놓아버렸다｡"
  },
  {
   "id": 27000,
   "key": "D1203le.txt:225",
   "file": "D1203le.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀は吊り上げられた魚のように宙を跳ねる。",
   "ko_candidate": "언월도는 낚아챈 물고기처럼 허공을 뛴다｡"
  },
  {
   "id": 27001,
   "key": "D1203le.txt:228",
   "file": "D1203le.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空いた右手にイタクァを招喚し、握る。",
   "ko_candidate": "빈 오른손에 이타콰를 소환해 쥔다｡"
  },
  {
   "id": 27002,
   "key": "D1203le.txt:234",
   "file": "D1203le.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが我に返る前に、イタクァの引鉄を６回引く。",
   "ko_candidate": "클라우디우스가 정신을 차리기 전에 이타콰의 방아쇠를 6번 당긴다｡"
  },
  {
   "id": 27003,
   "key": "D1203le.txt:235",
   "file": "D1203le.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンマーが６回撃鉄され、６発の弾丸を吐き出す。",
   "ko_candidate": "해머가 6번 격발되어 6발의 총알을 토해낸다｡"
  },
  {
   "id": 27004,
   "key": "D1203le.txt:245",
   "file": "D1203le.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "銃口から迸るフレア。瞬くマズル・フラッシュ。",
   "ko_candidate": "총구에서 뿜어져 나오는 섬광｡ 번쩍이는 머즐 플래시｡"
  },
  {
   "id": 27005,
   "key": "D1203le.txt:255",
   "file": "D1203le.txt",
   "line": 255,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………クッ!?」",
   "ko_candidate": "「……………큭!?」"
  },
  {
   "id": 27006,
   "key": "D1203le.txt:258",
   "file": "D1203le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が渦巻き、防禦陣を形成する。",
   "ko_candidate": "바람이 소용돌이치며 방어진을 형성한다｡"
  },
  {
   "id": 27007,
   "key": "D1203le.txt:263",
   "file": "D1203le.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウス本体を狙った３発は、質量を持つ風によって止められた。",
   "ko_candidate": "클라우디우스 본체를 겨냥한 3발은 질량을 가진 바람에 의해 멈춰졌다｡"
  },
  {
   "id": 27008,
   "key": "D1203le.txt:265",
   "file": "D1203le.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが残る３発は軌道を変え、１発はケンダマを持ったクラウディウスの手を撃ち抜き、１発は偃月刀を縛る光の糸を断ち切り、１発は偃月刀を弾いた。",
   "ko_candidate": "하지만 나머지 3발은 궤도를 바꿔 1발은 켄다마를 쥔 클라우디우스의 손을 관통하고､ 1발은 언월도를 묶은 빛의 실을 끊어내고､ 1발은 언월도를 튕겨냈다｡"
  },
  {
   "id": 27009,
   "key": "D1203le.txt:276",
   "file": "D1203le.txt",
   "line": 276,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くぎゃあああああっ！」",
   "ko_candidate": "「크갸아아아아악!」"
  },
  {
   "id": 27010,
   "key": "D1203le.txt:280",
   "file": "D1203le.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ケンダマを取りこぼす。",
   "ko_candidate": "켄다마를 놓쳐버린다｡"
  },
  {
   "id": 27011,
   "key": "D1203le.txt:281",
   "file": "D1203le.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀は回転しながら、俺の元に落ちてきた。",
   "ko_candidate": "언월도는 회전하며 내게로 떨어져왔다｡"
  },
  {
   "id": 27012,
   "key": "D1203le.txt:282",
   "file": "D1203le.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "撃ち尽くしたイタクァを投げ捨て、偃月刀の柄を両手でしかと捉えた。",
   "ko_candidate": "다 쏜 이타콰를 던져버리고 언월도의 손잡이를 양손으로 꽉 잡았다｡"
  },
  {
   "id": 27013,
   "key": "D1203le.txt:291",
   "file": "D1203le.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "床を蹴り、一足飛びにクラウディウスの懐に潜り込む。",
   "ko_candidate": "바닥을 차고 단숨에 클라우디우스의 품으로 파고든다｡"
  },
  {
   "id": 27014,
   "key": "D1203le.txt:299",
   "file": "D1203le.txt",
   "line": 299,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっそがァァァァァァァ！」",
   "ko_candidate": "「젠장할아아아아아아!」"
  },
  {
   "id": 27015,
   "key": "D1203le.txt:306",
   "file": "D1203le.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスを囲む風の結界がより強固になり、竜巻と化した。",
   "ko_candidate": "클라우디우스를 감싸는 바람의 결계가 더욱 강해져 회오리바람으로 변했다｡"
  },
  {
   "id": 27016,
   "key": "D1203le.txt:307",
   "file": "D1203le.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触れるものをズタズタに引き裂く、風のミキサーだ。",
   "ko_candidate": "닿는 것을 갈가리 찢어발기는 바람의 믹서다｡"
  },
  {
   "id": 27017,
   "key": "D1203le.txt:312",
   "file": "D1203le.txt",
   "line": 312,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！」",
   "ko_candidate": "「쿠로!」"
  },
  {
   "id": 27018,
   "key": "D1203le.txt:322",
   "file": "D1203le.txt",
   "line": 322,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「でやあああああああああ！」",
   "ko_candidate": "「데야아아아아아아아아!」"
  },
  {
   "id": 27019,
   "key": "D1203le.txt:351",
   "file": "D1203le.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳びながら、大上段に刀を構え、ありったけの魔力を込めて振り下ろす！",
   "ko_candidate": "뛰어오르며 칼을 크게 치켜들고 있는 힘껏 마력을 실어 내리친다!"
  },
  {
   "id": 27020,
   "key": "D1203le.txt:355",
   "file": "D1203le.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀の刃が白く炎上する。爆裂する烈光。",
   "ko_candidate": "언월도의 칼날이 하얗게 불타오른다｡ 폭발하는 열광｡"
  },
  {
   "id": 27021,
   "key": "D1203le.txt:356",
   "file": "D1203le.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烈光が偃月刀の太刀筋を描く。",
   "ko_candidate": "열광이 언월도의 칼날 궤적을 그린다｡"
  },
  {
   "id": 27022,
   "key": "D1203le.txt:357",
   "file": "D1203le.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の刃は空間を縦に引き裂く――！",
   "ko_candidate": "빛의 칼날이 공간을 세로로 갈라버린다――!"
  },
  {
   "id": 27023,
   "key": "D1203le.txt:364",
   "file": "D1203le.txt",
   "line": 364,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ…… なああああああああ!?」",
   "ko_candidate": "「으……으아아아아아아아아!?」"
  },
  {
   "id": 27024,
   "key": "D1203ru.txt:8",
   "file": "D1203ru.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "作戦司令室。",
   "ko_candidate": "작전사령실｡"
  },
  {
   "id": 27025,
   "key": "D1203ru.txt:12",
   "file": "D1203ru.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地下施設の中枢にまで、敵は侵攻してきた。",
   "ko_candidate": "지하시설의 중추까지 적이 침공해 왔다｡"
  },
  {
   "id": 27026,
   "key": "D1203ru.txt:13",
   "file": "D1203ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "外敵の侵入を阻む為、厚く閉ざされたゲートが、人の通れるほどの長方形に切断される。",
   "ko_candidate": "외적의 침입을 막기 위해 두껍게 닫혀 있던 게이트가 사람이 통과할 수 있을 정도의 직사각형으로 절단된다｡"
  },
  {
   "id": 27027,
   "key": "D1203ru.txt:20",
   "file": "D1203ru.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重い音を立てて、壁が倒れた。",
   "ko_candidate": "무거운 소리를 내며 벽이 쓰러졌다｡"
  },
  {
   "id": 27028,
   "key": "D1203ru.txt:28",
   "file": "D1203ru.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その向こう、闘争の愉悦を瞳の奥に湛えて、黒のサムライは立っていた。",
   "ko_candidate": "그 너머､ 투쟁의 열락을 눈동자 깊숙이 담고 검은 사무라이가 서 있었다｡"
  }
 ]
}