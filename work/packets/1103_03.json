 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "ライカ": "라이카",
  "覇道財閥": "하도 재벌",
  "クトゥルー": "크툴루",
  "アーカムシティ": "아컴시티",
  "メタトロン": "메타트론",
  "アンチクロス": "안티크로스",
  "大導師": "그랜드 마스터"
 },
 "items": [
  {
   "id": 22848,
   "key": "D1103le.txt:69",
   "file": "D1103le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "良し、と笑って、３人の肩を叩いてやってから、俺はまた避難所を出た。",
   "ko_candidate": "좋아､ 하고 웃으며 세 사람의 어깨를 두드려주고 나서､ 나는 다시 대피소를 나섰다｡"
  },
  {
   "id": 22849,
   "key": "D1103le.txt:76",
   "file": "D1103le.txt",
   "line": 76,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ー！　ライカお姉ちゃんのこと、おねがいだよ！　きっとだよ！」",
   "ko_candidate": "「쿠로―! 라이카 누나 부탁해! 꼭이야!」"
  },
  {
   "id": 22850,
   "key": "D1103le.txt:80",
   "file": "D1103le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背中にガキんちょどもの声を聞きながら、俺は走る。",
   "ko_candidate": "등 뒤로 꼬마들의 목소리를 들으며 나는 달린다｡"
  },
  {
   "id": 22851,
   "key": "D1103le.txt:82",
   "file": "D1103le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……多分、別の避難所には居ない。",
   "ko_candidate": "……아마도 다른 대피소에는 없을 거야｡"
  },
  {
   "id": 22852,
   "key": "D1103le.txt:83",
   "file": "D1103le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それならば素直にここに戻ってくるはずだ。",
   "ko_candidate": "그랬다면 순순히 여기로 돌아왔을 테니까｡"
  },
  {
   "id": 22853,
   "key": "D1103le.txt:84",
   "file": "D1103le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だとしたら、外しかない。",
   "ko_candidate": "그렇다면 밖밖에 없어｡"
  },
  {
   "id": 22854,
   "key": "D1103le.txt:86",
   "file": "D1103le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "格納庫近くにある、覇道財閥の関係者専用の昇降機に乗り込み、地上に出た。",
   "ko_candidate": "격납고 근처에 있는 하도 재벌의 관계자 전용 승강기에 올라타 지상으로 나왔다｡"
  },
  {
   "id": 22855,
   "key": "D1103le.txt:91",
   "file": "D1103le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処だ？　何処にいる、ライカさん!?",
   "ko_candidate": "어디지? 어디 있어､ 라이카 씨!?"
  },
  {
   "id": 22856,
   "key": "D1103le.txt:114",
   "file": "D1103le.txt",
   "line": 114,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はあ……はあ……何処にもいねえじゃねえかよ……！」",
   "ko_candidate": "「하아……하아……어디에도 없잖아……!」"
  },
  {
   "id": 22857,
   "key": "D1103le.txt:116",
   "file": "D1103le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思い当たる場所を駈けずり回ってみたが、それらしい人影は見当たらない。",
   "ko_candidate": "생각나는 장소를 뛰어다녀 봤지만､ 그럴 듯한 인영은 보이지 않는다｡"
  },
  {
   "id": 22858,
   "key": "D1103le.txt:118",
   "file": "D1103le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だいたいにして、この街は広すぎる。",
   "ko_candidate": "대체로 이 도시는 너무 넓다｡"
  },
  {
   "id": 22859,
   "key": "D1103le.txt:119",
   "file": "D1103le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人ひとり捜すのは至難の業どころか、海に放った魚を見つけるようなもんだ。",
   "ko_candidate": "사람 한 명을 찾는 건 지난한 일은 고사하고､ 바다에 던진 물고기를 찾는 것과 같다｡"
  },
  {
   "id": 22860,
   "key": "D1103le.txt:121",
   "file": "D1103le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに、心配なのは――",
   "ko_candidate": "게다가 걱정되는 건――"
  },
  {
   "id": 22861,
   "key": "D1103le.txt:126",
   "file": "D1103le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空を見上げる。",
   "ko_candidate": "상공을 올려다본다｡"
  },
  {
   "id": 22862,
   "key": "D1103le.txt:128",
   "file": "D1103le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アーカムシティの夜空を完全に包み込む、クトゥルーの威容。",
   "ko_candidate": "아캄시티의 밤하늘을 완전히 감싸는 크툴루의 위용｡"
  },
  {
   "id": 22863,
   "key": "D1103le.txt:130",
   "file": "D1103le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大……という言葉すら充分ではない。",
   "ko_candidate": "거대……라는 말조차 충분하지 않다｡"
  },
  {
   "id": 22864,
   "key": "D1103le.txt:131",
   "file": "D1103le.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "山脈一つが空に浮いているようなものだ。",
   "ko_candidate": "산맥 하나가 하늘에 떠 있는 것 같다｡"
  },
  {
   "id": 22865,
   "key": "D1103le.txt:133",
   "file": "D1103le.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界を押し潰そうとする肉の塊。",
   "ko_candidate": "세계를 짓누르려는 살덩어리｡"
  },
  {
   "id": 22866,
   "key": "D1103le.txt:136",
   "file": "D1103le.txt",
   "line": 136,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まさか……本当に１人で、アレに乗り込んだんじゃないだろうな……」",
   "ko_candidate": "「설마……정말로 혼자서 저기에 들어간 건 아니겠지……」"
  },
  {
   "id": 22867,
   "key": "D1103le.txt:138",
   "file": "D1103le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いくらメタトロンとはいえ、それは無謀だ。",
   "ko_candidate": "아무리 메타트론이라고 해도 그건 무모해｡"
  },
  {
   "id": 22868,
   "key": "D1103le.txt:140",
   "file": "D1103le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アンチクロスが勢揃いしていることに加え、大導師の死で混乱しているとはいえ、万全の迎撃体制が引かれているだろう要塞。",
   "ko_candidate": "안티 크로스가 총집결한 데다､ 그랜드 마스터의 죽음으로 혼란스럽다고는 해도 만반의 요격 체제가 갖춰져 있을 요새｡"
  },
  {
   "id": 22869,
   "key": "D1103le.txt:142",
   "file": "D1103le.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして今は眠っているが、クトゥルーが完全に覚醒したら……。",
   "ko_candidate": "그리고 지금은 자고 있지만､ 크툴루가 완전히 깨어난다면……"
  },
  {
   "id": 22870,
   "key": "D1103le.txt:144",
   "file": "D1103le.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駄目だ。どう考えても自殺行為だ。",
   "ko_candidate": "안 돼｡ 아무리 생각해도 자살 행위야｡"
  },
  {
   "id": 22871,
   "key": "D1103le.txt:146",
   "file": "D1103le.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷静だったメタトロン。",
   "ko_candidate": "냉정했던 메타트론｡"
  },
  {
   "id": 22872,
   "key": "D1103le.txt:147",
   "file": "D1103le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暴走する俺は、何度も窮地を救われている。",
   "ko_candidate": "폭주하는 나는 몇 번이나 위기에서 구해졌다｡"
  },
  {
   "id": 22873,
   "key": "D1103le.txt:148",
   "file": "D1103le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だったら今回だって、そんな無茶はしないと信じたい。",
   "ko_candidate": "그렇다면 이번에도 그런 무모한 짓은 하지 않을 거라고 믿고 싶어｡"
  },
  {
   "id": 22874,
   "key": "D1103le.txt:150",
   "file": "D1103le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵地に殴り込むことはしない。",
   "ko_candidate": "적지에 쳐들어가지는 않을 거야｡"
  },
  {
   "id": 22875,
   "key": "D1103le.txt:151",
   "file": "D1103le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "状況の手懸かりになりそうな場所を調べている訳でもない。",
   "ko_candidate": "상황의 실마리가 될 만한 장소를 조사하고 있는 것도 아니고｡"
  },
  {
   "id": 22876,
   "key": "D1103le.txt:153",
   "file": "D1103le.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "と、するならば何処に？",
   "ko_candidate": "그렇다면 어디에?"
  },
  {
   "id": 22877,
   "key": "D1103le.txt:156",
   "file": "D1103le.txt",
   "line": 156,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカさん」",
   "ko_candidate": "「……라이카 씨」"
  },
  {
   "id": 22878,
   "key": "D1103le.txt:162",
   "file": "D1103le.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正体がバレたときや、逃げ出すとき一瞬だけ見えた、辛そうな表情が思い起こされる。",
   "ko_candidate": "정체가 탄로났을 때나 도망칠 때 잠깐 보였던 괴로운 표정이 떠오른다｡"
  },
  {
   "id": 22879,
   "key": "D1103le.txt:167",
   "file": "D1103le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何だか酷く、胸を締めつけられる。",
   "ko_candidate": "왠지 가슴이 몹시 아파온다｡"
  },
  {
   "id": 22880,
   "key": "D1103le.txt:168",
   "file": "D1103le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなに自分の正体を、知られたくなかったのだろうか……。",
   "ko_candidate": "그렇게까지 자신의 정체를 알리고 싶지 않았던 걸까……"
  },
  {
   "id": 22881,
   "key": "D1103le.txt:171",
   "file": "D1103le.txt",
   "line": 171,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……そうだ」",
   "ko_candidate": "「……그래」"
  },
  {
   "id": 22882,
   "key": "D1103le.txt:173",
   "file": "D1103le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふと、思いつく。",
   "ko_candidate": "문득 떠오른다｡"
  },
  {
   "id": 22883,
   "key": "D1103le.txt:175",
   "file": "D1103le.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "根拠は無いが、ある意味、最初に探すべきだったかも知れない。",
   "ko_candidate": "근거는 없지만､ 어떤 의미에서는 가장 먼저 찾아봤어야 했을지도 모른다｡"
  },
  {
   "id": 22884,
   "key": "D1103le.txt:179",
   "file": "D1103le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はその場所目指して、駈け出した。",
   "ko_candidate": "나는 그 장소를 향해 달려나갔다｡"
  },
  {
   "id": 22885,
   "key": "D1103le.txt:192",
   "file": "D1103le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この区画は都心部から外れていることもあって、それほどの被害を受けていない。",
   "ko_candidate": "이 구역은 도심에서 벗어나 있어서 그다지 큰 피해를 입지 않았다｡"
  },
  {
   "id": 22886,
   "key": "D1103le.txt:194",
   "file": "D1103le.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの教会も窓ガラスが割れているとか、小さな損傷はあるものの、無事に建っている。",
   "ko_candidate": "라이카 씨의 교회도 창문이 깨지는 등 작은 손상은 있지만､ 무사히 서 있다｡"
  },
  {
   "id": 22887,
   "key": "D1103le.txt:201",
   "file": "D1103le.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "礼拝堂の扉を開く。",
   "ko_candidate": "예배당 문을 연다｡"
  }
 ]
}