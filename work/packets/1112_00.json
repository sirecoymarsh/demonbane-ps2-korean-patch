 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "エルザ": "엘자",
  "アーカムシティ": "아컴시티",
  "ライカ": "라이카",
  "アル": "알",
  "メタトロン": "메타트론",
  "ハンティング・ホラー": "헌팅 호러"
 },
 "items": [
  {
   "id": 26215,
   "key": "D1112le.txt:10",
   "file": "D1112le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空は徐々に明るくなり、東の方から赤く染まってくる。",
   "ko_candidate": "하늘은 서서히 밝아지며､ 동쪽에서부터 붉게 물들어간다｡"
  },
  {
   "id": 26216,
   "key": "D1112le.txt:12",
   "file": "D1112le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "朝が、近い。",
   "ko_candidate": "아침이 가까워졌다｡"
  },
  {
   "id": 26217,
   "key": "D1112le.txt:15",
   "file": "D1112le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪神が陰を落とす絶望の街にも朝は来る。",
   "ko_candidate": "사신이 그림자를 드리운 절망의 거리에도 아침은 온다｡"
  },
  {
   "id": 26218,
   "key": "D1112le.txt:16",
   "file": "D1112le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "万物に等しく朝は来る。",
   "ko_candidate": "만물에 똑같이 아침은 온다｡"
  },
  {
   "id": 26219,
   "key": "D1112le.txt:18",
   "file": "D1112le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。",
   "ko_candidate": "그렇다｡"
  },
  {
   "id": 26220,
   "key": "D1112le.txt:19",
   "file": "D1112le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必ず、朝は来るのだ。",
   "ko_candidate": "반드시､ 아침은 오는 것이다｡"
  },
  {
   "id": 26221,
   "key": "D1112le.txt:24",
   "file": "D1112le.txt",
   "line": 24,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「とりあえずは、勝ったな」",
   "ko_candidate": "「일단은､ 이겼군」"
  },
  {
   "id": 26222,
   "key": "D1112le.txt:28",
   "file": "D1112le.txt",
   "line": 28,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ああ」",
   "ko_candidate": "「……그래」"
  },
  {
   "id": 26223,
   "key": "D1112le.txt:33",
   "file": "D1112le.txt",
   "line": 33,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「と、とりあえずそろそろ地面に降ろしてロボ」",
   "ko_candidate": "「그､ 그러니까 이제 슬슬 땅에 내려줘 로봇」"
  },
  {
   "id": 26224,
   "key": "D1112le.txt:37",
   "file": "D1112le.txt",
   "line": 37,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あっ、悪ィ、忘れてた」",
   "ko_candidate": "「아､ 미안｡ 잊고 있었어」"
  },
  {
   "id": 26225,
   "key": "D1112le.txt:42",
   "file": "D1112le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地面にそっと降り立ち、脇に抱えたエルザを降ろす。",
   "ko_candidate": "땅에 살며시 내려앉아 옆구리에 끼고 있던 엘자를 내려준다｡"
  },
  {
   "id": 26226,
   "key": "D1112le.txt:43",
   "file": "D1112le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眩い光が、東から射し込んできた。",
   "ko_candidate": "눈부신 빛이 동쪽에서 쏟아져 들어왔다｡"
  },
  {
   "id": 26227,
   "key": "D1112le.txt:45",
   "file": "D1112le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……朝陽だ。",
   "ko_candidate": "……아침 해다｡"
  },
  {
   "id": 26228,
   "key": "D1112le.txt:47",
   "file": "D1112le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "朝陽が昇る。",
   "ko_candidate": "아침 해가 떠오른다｡"
  },
  {
   "id": 26229,
   "key": "D1112le.txt:49",
   "file": "D1112le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "朝陽は、邪神の威容を、街を引き裂いた傷痕を照らし出す。",
   "ko_candidate": "아침 해는 사신의 위용을､ 거리를 갈라놓은 상흔을 비춰낸다｡"
  },
  {
   "id": 26230,
   "key": "D1112le.txt:51",
   "file": "D1112le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悪夢が終わったワケではない。",
   "ko_candidate": "악몽이 끝난 건 아니다｡"
  },
  {
   "id": 26231,
   "key": "D1112le.txt:52",
   "file": "D1112le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次の悪夢がある。次の戦いがある。",
   "ko_candidate": "다음 악몽이 있다｡ 다음 싸움이 있다｡"
  },
  {
   "id": 26232,
   "key": "D1112le.txt:53",
   "file": "D1112le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 26233,
   "key": "D1112le.txt:57",
   "file": "D1112le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い躰を朝陽の彩で輝かせ、暁の天使が俺の傍らに降り立った。",
   "ko_candidate": "하얀 몸을 아침 해의 색채로 빛내며､ 새벽의 천사가 내 곁에 내려앉았다｡"
  },
  {
   "id": 26234,
   "key": "D1112le.txt:59",
   "file": "D1112le.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線が合う。",
   "ko_candidate": "시선이 마주친다｡"
  },
  {
   "id": 26235,
   "key": "D1112le.txt:60",
   "file": "D1112le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は微笑んで、親指を立てた。",
   "ko_candidate": "나는 미소 지으며 엄지손가락을 들어 올렸다｡"
  },
  {
   "id": 26236,
   "key": "D1112le.txt:61",
   "file": "D1112le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "応えて、アーカムシティの守護天使も親指を立てた。",
   "ko_candidate": "화답하듯､ 아캄시티의 수호천사도 엄지손가락을 들어 올렸다｡"
  },
  {
   "id": 26237,
   "key": "D1112le.txt:64",
   "file": "D1112le.txt",
   "line": 64,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やったな、ライカさん」",
   "ko_candidate": "「해냈군､ 라이카 씨」"
  },
  {
   "id": 26238,
   "key": "D1112le.txt:69",
   "file": "D1112le.txt",
   "line": 69,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカ？」",
   "ko_candidate": "「……라이카?」"
  },
  {
   "id": 26239,
   "key": "D1112le.txt:72",
   "file": "D1112le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肩の上のアルが、怪訝そうに顔をしかめる。",
   "ko_candidate": "어깨 위의 알이 의아한 듯 얼굴을 찌푸린다｡"
  },
  {
   "id": 26240,
   "key": "D1112le.txt:73",
   "file": "D1112le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうか……こいつ、あのとき昏睡していたから、知らないのか。",
   "ko_candidate": "그렇지……이 녀석､ 그때 혼수상태였으니까 모르는 건가｡"
  },
  {
   "id": 26241,
   "key": "D1112le.txt:78",
   "file": "D1112le.txt",
   "line": 78,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……目覚めたばかりで、何も分からん。詳しく説明しろ」",
   "ko_candidate": "「……막 깨어나서 아무것도 모르겠다｡ 자세히 설명해라」"
  },
  {
   "id": 26242,
   "key": "D1112le.txt:82",
   "file": "D1112le.txt",
   "line": 82,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「んー、あー、色々あったんだよ。色々」",
   "ko_candidate": "「음-､ 아-､ 여러 가지가 있었지｡ 여러 가지」"
  },
  {
   "id": 26243,
   "key": "D1112le.txt:87",
   "file": "D1112le.txt",
   "line": 87,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だからその『色々』を説明しろと言っておる」",
   "ko_candidate": "「그러니까 그 『여러 가지』를 설명하라고 하고 있다」"
  },
  {
   "id": 26244,
   "key": "D1112le.txt:91",
   "file": "D1112le.txt",
   "line": 91,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さて、どうするかなー」",
   "ko_candidate": "「자､ 어떻게 할까나-」"
  },
  {
   "id": 26245,
   "key": "D1112le.txt:96",
   "file": "D1112le.txt",
   "line": 96,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝ぇ！　何かやましい事でもあるのか!?　言え！　言わぬか！」",
   "ko_candidate": "「네놈! 뭔가 꺼림칙한 일이라도 있는 것이냐!? 말해라! 말하지 않겠느냐!」"
  },
  {
   "id": 26246,
   "key": "D1112le.txt:99",
   "file": "D1112le.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やましいことか……確かに少しあるが。",
   "ko_candidate": "꺼림칙한 일인가……확실히 조금은 있지만｡"
  },
  {
   "id": 26247,
   "key": "D1112le.txt:101",
   "file": "D1112le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルをからかいながら、横目でメタトロンの様子を盗み見る。",
   "ko_candidate": "알을 놀리면서 옆눈으로 메타트론의 모습을 훔쳐본다｡"
  },
  {
   "id": 26248,
   "key": "D1112le.txt:103",
   "file": "D1112le.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンは静かにこちらを見守っていた。",
   "ko_candidate": "메타트론은 조용히 이쪽을 지켜보고 있었다｡"
  },
  {
   "id": 26249,
   "key": "D1112le.txt:104",
   "file": "D1112le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の下のライカさんは、きっと微笑んでいるに違いない。",
   "ko_candidate": "가면 아래의 라이카 씨는 분명 미소 짓고 있을 것이다｡"
  },
  {
   "id": 26250,
   "key": "D1112le.txt:121",
   "file": "D1112le.txt",
   "line": 121,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふっ……一時期はどうなるかと思ったであるな」",
   "ko_candidate": "「훗……한때는 어떻게 될지 걱정했었 지만 말이야」"
  },
  {
   "id": 26251,
   "key": "D1112le.txt:127",
   "file": "D1112le.txt",
   "line": 127,
   "speaker": "チアキ（通信） / ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『どうなるかと思った』じゃないでしょーに！　施設の装置は無断使用するわ、あんな中途半端な武器を使わせるわ！　この変態白衣！」 「変態!?　またしても我輩を変態と呼ぶか!?」",
   "ko_candidate": "「『어떻게 될지 걱정했다』가 아니라구요! 시설의 장치는 무단으로 사용하질 않나､ 그런 어중간한 무기를 쓰게 하질 않나! 이 변태 백의!」"
  },
  {
   "id": 26252,
   "key": "D1112le.txt:138",
   "file": "D1112le.txt",
   "line": 138,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ふふーん、そーかそーか。あー嫌だ嫌だ。才能への嫉妬は」 「まあ貴様の様な凡人脳味噌では、百年経っても我輩には追いつけないであろうから、気持ちは分からんでもなぁい！」",
   "ko_candidate": "「변태!? 또다시 나를 변태라 부르는가!? ……후후응､ 그래그래｡ 아- 싫다 싫어｡ 재능에 대한 질투는｡ 뭐 네놈 같은 범인 뇌로는 백 년이 지나도 나를 따라잡지 못할 테니까､ 그 마음은 이해 못 할 바도 아니지!」"
  },
  {
   "id": 26253,
   "key": "D1112le.txt:146",
   "file": "D1112le.txt",
   "line": 146,
   "speaker": "チアキ（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なっ……何ほざいとる！　脳味噌沸いてるのか、ワレぇい！」",
   "ko_candidate": "「뭐……뭐라 지껄이는 거야! 뇌에 물이 찼나､ 이 자식아!」"
  },
  {
   "id": 26254,
   "key": "D1112le.txt:150",
   "file": "D1112le.txt",
   "line": 150,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「不完全ではあったが、結局は我輩のハンティング・ホラーが勝負を決めたようなものであるからして！」 「貴様如きでは、これ程の偉大な発明は、１兆億年経とうとも無理であろうな！　だが、そう嘆き悲しむなであーる！」",
   "ko_candidate": "「불완전하긴 했지만､ 결국엔 내 헌팅 호러가 승부를 결정지은 거나 마찬가지니까! 네놈 따위로는 이 정도의 위대한 발명은 1조억 년이 지나도 불가능할 거야! 하지만 그렇게 한탄하지 말거라! 에햐햐햐햐햐햐햐햐!」"
  }
 ]
}