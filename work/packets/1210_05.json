 "items": [
  {
   "id": 29178,
   "key": "D1210le.txt:84",
   "file": "D1210le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンのビームサーベルが幾重にも残像を残す。",
   "ko_candidate": "메타트론의 빔 세이버가 여러 겹으로 잔상을 남긴다｡"
  },
  {
   "id": 29179,
   "key": "D1210le.txt:85",
   "file": "D1210le.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは光の翼が拡がっていく様に見えなくもない。",
   "ko_candidate": "그것은 빛의 날개가 펼쳐지는 것처럼 보이기도 한다｡"
  },
  {
   "id": 29180,
   "key": "D1210le.txt:88",
   "file": "D1210le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、その総ての斬撃をサンダルフォンは、かわし、防ぎ、弾き飛ばし、腕に巻きつけるようにして、逸らす。",
   "ko_candidate": "하지만､ 그 모든 참격을 산달폰은 피하고､ 막고､ 튕겨내고､ 팔에 감아 돌리듯 빗나가게 한다｡"
  },
  {
   "id": 29181,
   "key": "D1210le.txt:96",
   "file": "D1210le.txt",
   "line": 96,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「遅い！」",
   "ko_candidate": "「느리다!」"
  },
  {
   "id": 29182,
   "key": "D1210le.txt:102",
   "file": "D1210le.txt",
   "line": 102,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐっ……！」",
   "ko_candidate": "「크윽……!」"
  },
  {
   "id": 29183,
   "key": "D1210le.txt:106",
   "file": "D1210le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斬撃の合間を縫って、影が迅る。",
   "ko_candidate": "참격의 틈을 타고 그림자가 번쩍인다｡"
  },
  {
   "id": 29184,
   "key": "D1210le.txt:107",
   "file": "D1210le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右の前蹴りが水月に突き刺さる。",
   "ko_candidate": "오른쪽 앞차기가 명치에 꽂힌다｡"
  },
  {
   "id": 29185,
   "key": "D1210le.txt:111",
   "file": "D1210le.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけに留まらない。水月を踏み台にして、左の蹴りがメタトロンの顔面を捉えた。",
   "ko_candidate": "그것뿐만이 아니다｡ 명치를 발판 삼아 왼쪽 차기가 메타트론의 얼굴을 포착했다｡"
  },
  {
   "id": 29186,
   "key": "D1210le.txt:112",
   "file": "D1210le.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "床の上を滑りながら、吹き飛ぶメタトロン。",
   "ko_candidate": "바닥 위를 미끄러지며 날아가는 메타트론｡"
  },
  {
   "id": 29187,
   "key": "D1210le.txt:113",
   "file": "D1210le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "摩擦によって、火花が散っていた。",
   "ko_candidate": "마찰로 인해 불꽃이 튀고 있었다｡"
  },
  {
   "id": 29188,
   "key": "D1210le.txt:115",
   "file": "D1210le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "追撃を加えようと、サンダルフォンが地を蹴る。",
   "ko_candidate": "추격을 가하려 산달폰이 땅을 박차고 나간다｡"
  },
  {
   "id": 29189,
   "key": "D1210le.txt:116",
   "file": "D1210le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンは起き上がれない。",
   "ko_candidate": "메타트론은 일어날 수 없다｡"
  },
  {
   "id": 29190,
   "key": "D1210le.txt:121",
   "file": "D1210le.txt",
   "line": 121,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「メタトロンっ！」",
   "ko_candidate": "「메타트론!」"
  },
  {
   "id": 29191,
   "key": "D1210le.txt:124",
   "file": "D1210le.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "倒れたまま、左腕を持ち上げ、サンダルフォンに向ける。",
   "ko_candidate": "쓰러진 채 왼팔을 들어올려 산달폰을 향한다｡"
  },
  {
   "id": 29192,
   "key": "D1210le.txt:125",
   "file": "D1210le.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬、何かが煌いた。",
   "ko_candidate": "순간､ 무언가가 반짝였다｡"
  },
  {
   "id": 29193,
   "key": "D1210le.txt:131",
   "file": "D1210le.txt",
   "line": 131,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――ッ!?」",
   "ko_candidate": "「……!?」"
  },
  {
   "id": 29194,
   "key": "D1210le.txt:134",
   "file": "D1210le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左掌を顔の前に翳す。",
   "ko_candidate": "왼손바닥을 얼굴 앞에 가린다｡"
  },
  {
   "id": 29195,
   "key": "D1210le.txt:135",
   "file": "D1210le.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突撃が止まった。",
   "ko_candidate": "돌격이 멈췄다｡"
  },
  {
   "id": 29196,
   "key": "D1210le.txt:141",
   "file": "D1210le.txt",
   "line": 141,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「貴様……」",
   "ko_candidate": "「네놈……」"
  },
  {
   "id": 29197,
   "key": "D1210le.txt:144",
   "file": "D1210le.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの掌には数十本の針が、突き刺さっていた。",
   "ko_candidate": "산달폰의 손바닥에는 수십 개의 바늘이 꽂혀 있었다｡"
  },
  {
   "id": 29198,
   "key": "D1210le.txt:145",
   "file": "D1210le.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この隙にメタトロンは起き上がる。",
   "ko_candidate": "이 틈에 메타트론은 일어선다｡"
  },
  {
   "id": 29199,
   "key": "D1210le.txt:148",
   "file": "D1210le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その左手にはもう１本のビームサーベルが握られていた。",
   "ko_candidate": "그 왼손에는 또 하나의 빔 세이버가 쥐어져 있었다｡"
  },
  {
   "id": 29200,
   "key": "D1210le.txt:149",
   "file": "D1210le.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームサーベルの二刀流。",
   "ko_candidate": "빔 세이버의 이도류｡"
  },
  {
   "id": 29201,
   "key": "D1210le.txt:151",
   "file": "D1210le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵を十字に断罪する、２筋の光。",
   "ko_candidate": "적을 십자로 단죄하는 2줄기의 빛｡"
  },
  {
   "id": 29202,
   "key": "D1210le.txt:157",
   "file": "D1210le.txt",
   "line": 157,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「朝は来るよ、サンダルフォン。万物に等しく、朝は来るのだ」 「それは祝福の朝とは限らない。罪を忘れ、眠る安らぎの夜を終わらせ、現実を呼び起こす、連綿と続く苦痛なのかも知れない」",
   "ko_candidate": "「아침은 온다､ 산달폰｡ 만물에 똑같이 아침은 오는 것이다｡ 그것이 축복의 아침이라고는 할 수 없다｡ 죄를 잊고 잠드는 평온한 밤을 끝내고 현실을 일깨우는､ 연면히 이어지는 고통일지도 모른다｡ 하지만､ 산달폰｡ 사람은 그래도 산다｡ 아침과 함께 걸어 나간다｡ 나도 이 죄와 고통과 함께 아침을 향해 간다｡ ……밤에 남겨진 너에겐､ 단순한 악몽이 되어버린 너에겐 이룰 수 없는 일이다｡ 너는 이제 어디에도 도달할 수 없다」"
  },
  {
   "id": 29203,
   "key": "D1210le.txt:163",
   "file": "D1210le.txt",
   "line": 163,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だが、サンダルフォン。人はそれでも生きる。朝と共に歩き出す」 「私もこの罪と苦痛と共に朝を往く。……夜に取り残されたお前には、唯の悪夢と化したお前には、叶わない事だ」",
   "ko_candidate": "교차시킨 빛의 검을 들어 올린다｡"
  },
  {
   "id": 29204,
   "key": "D1210le.txt:169",
   "file": "D1210le.txt",
   "line": 169,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お前はもう、何処にも辿り着けない」 交差させた光の剣を掲げる。",
   "ko_candidate": "빛나는 십자가를 들어 올린다｡"
  },
  {
   "id": 29205,
   "key": "D1210le.txt:173",
   "file": "D1210le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光り輝く十字架を掲げる。 厳粛な、傲慢ですらある審判者の権威を以って、メタトロンは宣告する。",
   "ko_candidate": "엄숙한､ 오만하기까지 한 심판자의 권위를 가지고 메타트론은 선고한다｡"
  },
  {
   "id": 29206,
   "key": "D1210le.txt:177",
   "file": "D1210le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵を断罪すべく。",
   "ko_candidate": "적을 단죄하기 위해｡"
  },
  {
   "id": 29207,
   "key": "D1210le.txt:178",
   "file": "D1210le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己の過去を断罪すべく。",
   "ko_candidate": "자신의 과거를 단죄하기 위해｡"
  },
  {
   "id": 29208,
   "key": "D1210le.txt:186",
   "file": "D1210le.txt",
   "line": 186,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「……………」"
  },
  {
   "id": 29209,
   "key": "D1210le.txt:189",
   "file": "D1210le.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンは応えない。",
   "ko_candidate": "산달폰은 대답하지 않는다｡"
  },
  {
   "id": 29210,
   "key": "D1210le.txt:190",
   "file": "D1210le.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ニードルの突き刺さった掌を固め、拳を作る。",
   "ko_candidate": "바늘이 꽂힌 손바닥을 굳게 쥐어 주먹을 만든다｡"
  },
  {
   "id": 29211,
   "key": "D1210le.txt:192",
   "file": "D1210le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲の隙間から、血が滴った。",
   "ko_candidate": "장갑의 틈새로 피가 떨어졌다｡"
  },
  {
   "id": 29212,
   "key": "D1210le.txt:193",
   "file": "D1210le.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "震えている。抑え切れない激情に震えている。",
   "ko_candidate": "떨리고 있다｡ 억누를 수 없는 격정에 떨리고 있다｡"
  },
  {
   "id": 29213,
   "key": "D1210le.txt:195",
   "file": "D1210le.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは怒りか、憎悪か、むしろ歓喜か、もしくは哀哭か、それとも。",
   "ko_candidate": "그것은 분노인가､ 증오인가､ 오히려 환희인가､ 아니면 애곡인가､ 그도 아니면｡"
  },
  {
   "id": 29214,
   "key": "D1210le.txt:196",
   "file": "D1210le.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それとも――",
   "ko_candidate": "그도 아니면――"
  },
  {
   "id": 29215,
   "key": "D1210le.txt:207",
   "file": "D1210le.txt",
   "line": 207,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうか……またしても独りで往くか」",
   "ko_candidate": "「그런가……또다시 혼자서 가는가」"
  },
  {
   "id": 29216,
   "key": "D1210le.txt:212",
   "file": "D1210le.txt",
   "line": 212,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「独りではない。私の周りには――」",
   "ko_candidate": "「혼자가 아니다｡ 내 주위에는――」"
  },
  {
   "id": 29217,
   "key": "D1210le.txt:215",
   "file": "D1210le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "子ども達をそっと盗み見る。",
   "ko_candidate": "아이들을 살짝 훔쳐본다｡"
  }
 ]
}