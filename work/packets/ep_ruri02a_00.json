{
 "packet": "ep_ruri02a_00",
 "scene": "ep_ruri02a",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "大十字九郎": "다이쥬지 쿠로",
  "覇道財閥": "하도 재벌"
 },
 "items": [
  {
   "id": 50533,
   "key": "ep_ruri02a.txt:10",
   "file": "ep_ruri02a.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "門は、閉じた。 あの人は勝ったのだろうか。",
   "ko_candidate": "사라져가는 빛의 먼지에 비춰지면서――"
  },
  {
   "id": 50534,
   "key": "ep_ruri02a.txt:12",
   "file": "ep_ruri02a.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そう、信じたい。",
   "ko_candidate": ""
  },
  {
   "id": 50535,
   "key": "ep_ruri02a.txt:14",
   "file": "ep_ruri02a.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "世界を巻き込んだ大事件は、だが誰にも知らない場所で、幕を閉じた。",
   "ko_candidate": ""
  },
  {
   "id": 50536,
   "key": "ep_ruri02a.txt:15",
   "file": "ep_ruri02a.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "総ては嵐の様に過ぎ去り、訪れた平和にも、あれほど壮絶だった戦いの日々も、実感が失われている。",
   "ko_candidate": ""
  },
  {
   "id": 50537,
   "key": "ep_ruri02a.txt:16",
   "file": "ep_ruri02a.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "全世界が呆けたような空気の中、人類は日常を取り戻しつつある。",
   "ko_candidate": ""
  },
  {
   "id": 50538,
   "key": "ep_ruri02a.txt:18",
   "file": "ep_ruri02a.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "総てはまるで夢の様で――だけど、私はあの人の戦いを憶えている。",
   "ko_candidate": ""
  },
  {
   "id": 50539,
   "key": "ep_ruri02a.txt:19",
   "file": "ep_ruri02a.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "戦いの激しさを憶えている。",
   "ko_candidate": ""
  },
  {
   "id": 50540,
   "key": "ep_ruri02a.txt:20",
   "file": "ep_ruri02a.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの戦いの日々は、決して幻では無い。",
   "ko_candidate": ""
  },
  {
   "id": 50541,
   "key": "ep_ruri02a.txt:22",
   "file": "ep_ruri02a.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だから、私は待ち続ける。",
   "ko_candidate": ""
  },
  {
   "id": 50542,
   "key": "ep_ruri02a.txt:23",
   "file": "ep_ruri02a.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "戦い終わり、私の許に帰って来る、あの人を。",
   "ko_candidate": ""
  },
  {
   "id": 50543,
   "key": "ep_ruri02a.txt:24",
   "file": "ep_ruri02a.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "私が愛する、あの人を。",
   "ko_candidate": ""
  },
  {
   "id": 50544,
   "key": "ep_ruri02a.txt:26",
   "file": "ep_ruri02a.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大十字九郎を、待ち続ける。 門が閉じて、１日。",
   "ko_candidate": "사라져가는 알의 잔해에 비춰지면서――"
  },
  {
   "id": 50545,
   "key": "ep_ruri02a.txt:38",
   "file": "ep_ruri02a.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "私は海上で、空を見上げて、待っていた。",
   "ko_candidate": ""
  },
  {
   "id": 50546,
   "key": "ep_ruri02a.txt:39",
   "file": "ep_ruri02a.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "彼が降りてくるのを、待っていた。",
   "ko_candidate": ""
  },
  {
   "id": 50547,
   "key": "ep_ruri02a.txt:40",
   "file": "ep_ruri02a.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "降りてきたら、あの人を抱き締めよう。",
   "ko_candidate": ""
  },
  {
   "id": 50548,
   "key": "ep_ruri02a.txt:41",
   "file": "ep_ruri02a.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "優しく抱き締めて、おかえりなさい、と声をかけてあげよう。",
   "ko_candidate": ""
  },
  {
   "id": 50549,
   "key": "ep_ruri02a.txt:53",
   "file": "ep_ruri02a.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "門が閉じて、３日。",
   "ko_candidate": ""
  },
  {
   "id": 50550,
   "key": "ep_ruri02a.txt:54",
   "file": "ep_ruri02a.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "私は海上で、空を見上げて、待っていた。",
   "ko_candidate": ""
  },
  {
   "id": 50551,
   "key": "ep_ruri02a.txt:55",
   "file": "ep_ruri02a.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "彼が降りてくるのを、待っていた。",
   "ko_candidate": ""
  },
  {
   "id": 50552,
   "key": "ep_ruri02a.txt:56",
   "file": "ep_ruri02a.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "降りてきたら、あの人に胸に飛び込んで、抱きつこう。",
   "ko_candidate": ""
  },
  {
   "id": 50553,
   "key": "ep_ruri02a.txt:57",
   "file": "ep_ruri02a.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの人は疲れ切っていて、傷だらけに違いないけど、容赦はしない。",
   "ko_candidate": ""
  },
  {
   "id": 50554,
   "key": "ep_ruri02a.txt:58",
   "file": "ep_ruri02a.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "私を心配させた報いだ。",
   "ko_candidate": ""
  },
  {
   "id": 50555,
   "key": "ep_ruri02a.txt:59",
   "file": "ep_ruri02a.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "私の重さを、受け止めてもらおう。 門が閉じて、７日。",
   "ko_candidate": "그､ 말､"
  },
  {
   "id": 50556,
   "key": "ep_ruri02a.txt:71",
   "file": "ep_ruri02a.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "これ以上、海に留まる事は出来ない。",
   "ko_candidate": ""
  },
  {
   "id": 50557,
   "key": "ep_ruri02a.txt:72",
   "file": "ep_ruri02a.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "世界の復興は始まったばかりで、私には、覇道財閥にはやるべき事がある。",
   "ko_candidate": ""
  },
  {
   "id": 50558,
   "key": "ep_ruri02a.txt:73",
   "file": "ep_ruri02a.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "私はあの街に帰らなければならない。",
   "ko_candidate": ""
  },
  {
   "id": 50559,
   "key": "ep_ruri02a.txt:74",
   "file": "ep_ruri02a.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だけど、大丈夫。 自分に言い聞かせる。",
   "ko_candidate": "「미안했어……내 탓이야」"
  },
  {
   "id": 50560,
   "key": "ep_ruri02a.txt:77",
   "file": "ep_ruri02a.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だって……あの人の帰る場所は、あの街なのだから。",
   "ko_candidate": ""
  },
  {
   "id": 50561,
   "key": "ep_ruri02a.txt:78",
   "file": "ep_ruri02a.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの人が愛する街。私が愛する街。",
   "ko_candidate": ""
  },
  {
   "id": 50562,
   "key": "ep_ruri02a.txt:79",
   "file": "ep_ruri02a.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "大黄金時代で大混乱時代で大暗黒時代の、あの街が、私達の生きる世界だから。",
   "ko_candidate": ""
  },
  {
   "id": 50563,
   "key": "ep_ruri02a.txt:80",
   "file": "ep_ruri02a.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だから、あの人は、きっと帰って来る。",
   "ko_candidate": ""
  },
  {
   "id": 50564,
   "key": "ep_ruri02a.txt:90",
   "file": "ep_ruri02a.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "門が閉じて、１ヶ月。 復興作業は続く。",
   "ko_candidate": "갈라지는 듯한 속삭임｡"
  },
  {
   "id": 50565,
   "key": "ep_ruri02a.txt:92",
   "file": "ep_ruri02a.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "日々の仕事に忙殺され、時間を忘れてしまう。",
   "ko_candidate": ""
  },
  {
   "id": 50566,
   "key": "ep_ruri02a.txt:93",
   "file": "ep_ruri02a.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの人の事を、思い出さない時間がある。",
   "ko_candidate": ""
  },
  {
   "id": 50567,
   "key": "ep_ruri02a.txt:94",
   "file": "ep_ruri02a.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そんな自分に、うんざりする。",
   "ko_candidate": ""
  },
  {
   "id": 50568,
   "key": "ep_ruri02a.txt:95",
   "file": "ep_ruri02a.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "でも……頑張らないと。 これは私の戦いだ。",
   "ko_candidate": "하지만､ 분명히､ 확실하게､ 이 귀로 들었다｡"
  },
  {
   "id": 50569,
   "key": "ep_ruri02a.txt:97",
   "file": "ep_ruri02a.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの人が戦ったように――私も自分の戦いから逃げてはいけない。",
   "ko_candidate": ""
  },
  {
   "id": 50570,
   "key": "ep_ruri02a.txt:98",
   "file": "ep_ruri02a.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そうでないと、あの人が帰って来た時、顔向けできないから。",
   "ko_candidate": ""
  },
  {
   "id": 50571,
   "key": "ep_ruri02a.txt:108",
   "file": "ep_ruri02a.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "門が閉じて、６ヶ月。",
   "ko_candidate": ""
  },
  {
   "id": 50572,
   "key": "ep_ruri02a.txt:109",
   "file": "ep_ruri02a.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "心の間隙を突いて、焦燥が私を襲う。",
   "ko_candidate": ""
  }
 ]
}