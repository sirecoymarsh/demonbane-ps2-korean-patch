 "items": [
  {
   "id": 41931,
   "key": "D1503al.txt:723",
   "file": "D1503al.txt",
   "line": 723,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ソーニャ！　何があった!?」",
   "ko_candidate": "「큰､ 큰일이에요! 데몬베인이 멋대로……!」"
  },
  {
   "id": 41932,
   "key": "D1503al.txt:728",
   "file": "D1503al.txt",
   "line": 728,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「た、大変なんです！ デモンベインが勝手に……！」",
   "ko_candidate": "「보면 알잖아! 그러니까､ 왜 데몬베인이……! ――――――――읏!?」"
  },
  {
   "id": 41933,
   "key": "D1503al.txt:734",
   "file": "D1503al.txt",
   "line": 734,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「見りゃ分かるっ！ だから、どうしてデモンベインが……！ ――――――――ッ！？」",
   "ko_candidate": "타카라부네 위에서､ 데몬베인은 샨타크의 날개를 펼쳤다｡ 충격과 섬광｡"
  },
  {
   "id": 41934,
   "key": "D1503al.txt:749",
   "file": "D1503al.txt",
   "line": 749,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "タカラブネの上で、デモンベインはシャンタクの翼を広げた。",
   "ko_candidate": "바다가 격렬히 요동치고､ 함선이 심하게 흔들렸다｡"
  },
  {
   "id": 41935,
   "key": "D1503al.txt:765",
   "file": "D1503al.txt",
   "line": 765,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃と閃光。艦が激しく揺れる。",
   "ko_candidate": "타카라부네는 거의 전복될 뻔했다｡"
  },
  {
   "id": 41936,
   "key": "D1503al.txt:766",
   "file": "D1503al.txt",
   "line": 766,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "タカラブネに至っては、もう少しで横転するところだった。",
   "ko_candidate": "그리고､ 데몬베인은―― 「뭐……! 기다려! 어디로……!?」"
  },
  {
   "id": 41937,
   "key": "D1503al.txt:769",
   "file": "D1503al.txt",
   "line": 769,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、デモンベインは――",
   "ko_candidate": "제지의 목소리가 들릴 리가 없다｡"
  },
  {
   "id": 41938,
   "key": "D1503al.txt:774",
   "file": "D1503al.txt",
   "line": 774,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な……っ！　待て！　何処へ……ッ!?」 制止の声も届くはずがない。爆音で海を震わせ、魔力のフレアで夜空を刻み、デモンベインは飛翔した。あっという間に小さくなってしまう。",
   "ko_candidate": "폭음으로 바다를 흔들고､ 마력의 플레어로 밤하늘을 새기며､ 데몬베인은 비상했다｡"
  },
  {
   "id": 41939,
   "key": "D1503al.txt:814",
   "file": "D1503al.txt",
   "line": 814,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "取り残された俺は、呆然とすることしか出来ない。",
   "ko_candidate": "순식간에､ 데몬베인은 작아져 버린다｡ 남겨진 나는､ 멍하니 바라볼 수밖에 없다｡"
  },
  {
   "id": 41940,
   "key": "D1503al.txt:819",
   "file": "D1503al.txt",
   "line": 819,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、な、な……何で？」",
   "ko_candidate": "「뭐､ 뭐､ 뭐……왜?」"
  },
  {
   "id": 41941,
   "key": "D1503al.txt:823",
   "file": "D1503al.txt",
   "line": 823,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんなの決まり切ってるじゃないですか！　アルさんが勝手にデモンベインを動かしちゃったんですよぉぉぉっ！」",
   "ko_candidate": "「그런 건 정해져 있잖아요! 알 씨가 멋대로 데몬베인을 움직여 버린 거예요오오오!」"
  },
  {
   "id": 41942,
   "key": "D1503al.txt:831",
   "file": "D1503al.txt",
   "line": 831,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬、思考が停止した。",
   "ko_candidate": "순간､ 사고가 정지했다｡"
  },
  {
   "id": 41943,
   "key": "D1503al.txt:836",
   "file": "D1503al.txt",
   "line": 836,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な……なななななな……っ！ 何だってぇぇぇぇ――――っ！？」",
   "ko_candidate": "「뭐……뭐뭐뭐뭐뭐……! 뭐라고오오오오――――!?」"
  },
  {
   "id": 41944,
   "key": "D1503le.txt:20",
   "file": "D1503le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歪む時空。",
   "ko_candidate": "왜곡된 시공간｡"
  },
  {
   "id": 41945,
   "key": "D1503le.txt:21",
   "file": "D1503le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒ぶる次元。",
   "ko_candidate": "격동하는 차원｡"
  },
  {
   "id": 41946,
   "key": "D1503le.txt:22",
   "file": "D1503le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "可逆性を帯びた時間が螺旋を描く。",
   "ko_candidate": "가역성을 띤 시간이 나선을 그린다｡"
  },
  {
   "id": 41947,
   "key": "D1503le.txt:24",
   "file": "D1503le.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逆流する。",
   "ko_candidate": "역류한다｡"
  },
  {
   "id": 41948,
   "key": "D1503le.txt:25",
   "file": "D1503le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛翔する。",
   "ko_candidate": "비상한다｡"
  },
  {
   "id": 41949,
   "key": "D1503le.txt:26",
   "file": "D1503le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の総てが、あらゆる因果が狂い出した。",
   "ko_candidate": "세계의 모든 것이､ 모든 인과가 미쳐버렸다｡"
  },
  {
   "id": 41950,
   "key": "D1503le.txt:27",
   "file": "D1503le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒れ狂う時の奔流に、『夢幻心母』は翻弄されている。",
   "ko_candidate": "격렬히 흐르는 시간의 급류에､ 『몽환심모』는 휘둘리고 있다｡"
  },
  {
   "id": 41951,
   "key": "D1503le.txt:36",
   "file": "D1503le.txt",
   "line": 36,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何だ何だ何だ!?　何だってんだよっ！」",
   "ko_candidate": "「뭐야 뭐야 뭐야!? 대체 뭐란 말이야!」"
  },
  {
   "id": 41952,
   "key": "D1503le.txt:40",
   "file": "D1503le.txt",
   "line": 40,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヨグ＝ソトースに呑み込まれた！ 気を付けろ！　油断すると、在らざる時空の角度に滑り落ちるぞ！」",
   "ko_candidate": "「요그 소토스에게 삼켜졌어! 조심해! 방심하면 존재하지 않는 시공간의 각도로 미끄러져 떨어질 거야!」"
  },
  {
   "id": 41953,
   "key": "D1503le.txt:45",
   "file": "D1503le.txt",
   "line": 45,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「気をつければ何とかなんのかよ、それは！」",
   "ko_candidate": "「조심하면 어떻게든 되는 거냐､ 그게!」"
  },
  {
   "id": 41954,
   "key": "D1503le.txt:51",
   "file": "D1503le.txt",
   "line": 51,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さて発条は動き出した。いい加減、仕上げに入ろう」",
   "ko_candidate": "「자､ 태엽은 움직이기 시작했다｡ 이제 마무리에 들어가자」"
  },
  {
   "id": 41955,
   "key": "D1503le.txt:56",
   "file": "D1503le.txt",
   "line": 56,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どういうことだっ！　何でこんな真似を！」",
   "ko_candidate": "「무슨 소리야! 왜 이런 짓을 하는 거야!」"
  },
  {
   "id": 41956,
   "key": "D1503le.txt:62",
   "file": "D1503le.txt",
   "line": 62,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「言っただろう。これが甘美なる破滅へと還る術なのさ」 「遍く宇宙は総て、在るべき場所に還る。あの盲目にして痴愚なる、煮え滾る混沌へと」",
   "ko_candidate": "「말했잖아｡ 이것이 감미로운 파멸로 돌아가는 방법이라고｡ 온 우주는 모두 있어야 할 곳으로 돌아간다｡ 그 맹목적이고 어리석은､ 끓어오르는 혼돈으로」"
  },
  {
   "id": 41957,
   "key": "D1503le.txt:69",
   "file": "D1503le.txt",
   "line": 69,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから何を……！」",
   "ko_candidate": "「그래서 뭘…!」"
  },
  {
   "id": 41958,
   "key": "D1503le.txt:73",
   "file": "D1503le.txt",
   "line": 73,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「貴方も、アル・アジフも、私も、ライカ・クルセイドも、リューガも、デモンベインも、リベル・レギスも……」 「否、この宇宙自体がその為だけに存在している、運命が操る駒に過ぎない……そう言ってるのよ――大十字九郎」",
   "ko_candidate": "「당신도､ 알 아지프도､ 나도､ 라이카 크루세이드도､ 류가도､ 데몬베인도､ 리베르 레기스도… 아니､ 이 우주 자체가 그것을 위해서만 존재하는､ 운명이 조종하는 말에 불과해… 그렇게 말하고 있는 거야――다이쥬지 쿠로」"
  },
  {
   "id": 41959,
   "key": "D1503le.txt:79",
   "file": "D1503le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "運命？　運命だと？",
   "ko_candidate": "운명? 운명이라고?"
  },
  {
   "id": 41960,
   "key": "D1503le.txt:80",
   "file": "D1503le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "さっきから、そればっかりだ。",
   "ko_candidate": "아까부터 그것뿐이야｡"
  },
  {
   "id": 41961,
   "key": "D1503le.txt:82",
   "file": "D1503le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何から何まで全部、俺らはカミサマの掌で踊らされているだけってか？　ざけんなっ！",
   "ko_candidate": "뭐부터 뭐까지 전부､ 우리는 신의 손바닥에서 춤추고 있을 뿐이라고? 농담하지 마!"
  },
  {
   "id": 41962,
   "key": "D1503le.txt:86",
   "file": "D1503le.txt",
   "line": 86,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「運命だの何だの、んなワケの分かんねえ曖昧適当極まる代物で、ハイソウデスカって納得できるほど、こちとら人間が出来てねえよ！」 「ゴチャゴチャ考えるのは止めだ……こうなったら、区別無く分別無く、てめえら全部まとめて片してやる！　覚悟しやがれ！」",
   "ko_candidate": "「운명이니 뭐니､ 그런 이해할 수 없는 애매모호한 것으로､ 네 그렇습니까 하고 납득할 수 있을 만큼､ 난 인간이 되어 있지 않아! 이것저것 생각하는 건 그만두자… 이렇게 된 이상､ 구별 없이 분별 없이､ 너희 전부 한꺼번에 처리해 주겠어! 각오해!」"
  },
  {
   "id": 41963,
   "key": "D1503le.txt:93",
   "file": "D1503le.txt",
   "line": 93,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……魔術師らしい思慮深さというものが無いのか、汝には」",
   "ko_candidate": "「…마술사다운 사려 깊음이라는 게 없는 건가､ 너에게는」"
  },
  {
   "id": 41964,
   "key": "D1503le.txt:99",
   "file": "D1503le.txt",
   "line": 99,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はははははっ、まったく、本当に君らしい。 それでこそ大十字九郎だよ」",
   "ko_candidate": "「하하하하하､ 정말､ 너답기 그지없어｡ 그래야 다이쥬지 쿠로지」"
  },
  {
   "id": 41965,
   "key": "D1503le.txt:104",
   "file": "D1503le.txt",
   "line": 104,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……てめえもだ。借りは纏めて反させてもらうからな」",
   "ko_candidate": "「…너도 마찬가지야｡ 빚은 한꺼번에 갚아주겠어」"
  },
  {
   "id": 41966,
   "key": "D1503le.txt:110",
   "file": "D1503le.txt",
   "line": 110,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「怖いな……ゾクゾクッと来るね」",
   "ko_candidate": "「무섭군… 오싹오싹하네」"
  },
  {
   "id": 41967,
   "key": "D1503le.txt:115",
   "file": "D1503le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても鋭い殺意と憎悪の視線。",
   "ko_candidate": "또다시 날카로운 살의와 증오의 시선｡"
  },
  {
   "id": 41968,
   "key": "D1503le.txt:116",
   "file": "D1503le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "睨み殺さんばかりの形相で、エセルドレーダは俺と向かい合う。",
   "ko_candidate": "노려 죽일 듯한 표정으로､ 에셀드레다는 나와 마주선다｡"
  },
  {
   "id": 41969,
   "key": "D1503le.txt:125",
   "file": "D1503le.txt",
   "line": 125,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「またそれか……貴様はまたそれか……大十字九郎！」",
   "ko_candidate": "「또 그거냐… 네놈은 또 그러는 거냐… 다이쥬지 쿠로!」"
  },
  {
   "id": 41970,
   "key": "D1503le.txt:129",
   "file": "D1503le.txt",
   "line": 129,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカさんから離れろ、エセルドレーダ」",
   "ko_candidate": "「…라이카 씨에게서 떨어져､ 에셀드레다」"
  }
 ]
}