 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "破壊ロボ": "파괴 로봇",
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 49146,
   "key": "ep_al01.txt:564",
   "file": "ep_al01.txt",
   "line": 564,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "不敵な笑みを浮かべて、破壊ロボを見つめる。",
   "ko_candidate": "뻔뻔한 미소를 지으며､ 파괴 로봇을 바라본다｡"
  },
  {
   "id": 49147,
   "key": "ep_al01.txt:571",
   "file": "ep_al01.txt",
   "line": 571,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――大十字九郎ってんだ。憶えときな」",
   "ko_candidate": "「――다이쥬지 쿠로라고 한다｡ 기억해 둬」"
  },
  {
   "id": 49148,
   "key": "ep_al01.txt:576",
   "file": "ep_al01.txt",
   "line": 576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただそれだけで、倒れた破壊ロボに背を向け、再び歩き出す。",
   "ko_candidate": "그저 그뿐으로､ 쓰러진 파괴 로봇에 등을 돌리고､ 다시 걸어간다｡"
  },
  {
   "id": 49149,
   "key": "ep_al01.txt:576",
   "file": "ep_al01.txt",
   "line": 576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "妙な沈黙を、置き去りにして。",
   "ko_candidate": "묘한 침묵을､ 뒤로 한 채｡"
  },
  {
   "id": 49150,
   "key": "ep_al01.txt:589",
   "file": "ep_al01.txt",
   "line": 589,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「こ、こ、これは…… 宿敵の予感?」",
   "ko_candidate": "「이､ 이､ 이건……숙적의 예감!?」"
  },
  {
   "id": 49151,
   "key": "ep_al01.txt:597",
   "file": "ep_al01.txt",
   "line": 597,
   "speaker": "エルザ / ネス＆ストーン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「恋の予感?」 「……嬉しそうだな、お前ら」",
   "ko_candidate": "「사랑의 예감!?{SE_VOL(1,1000,0);}」"
  },
  {
   "id": 49152,
   "key": "ep_al01.txt:624",
   "file": "ep_al01.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "事務所に戻り、電気をつける。",
   "ko_candidate": "「……기뻐 보이네､ 너희들」 사무실로 돌아와 전기를 켠다｡"
  },
  {
   "id": 49153,
   "key": "ep_al01.txt:625",
   "file": "ep_al01.txt",
   "line": 625,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "拳銃の入ったホルスターをソファーに放って、ふと思い出した。",
   "ko_candidate": "권총이 들어있는 홀스터를 소파에 던지고､ 문득 생각났다｡"
  },
  {
   "id": 49154,
   "key": "ep_al01.txt:626",
   "file": "ep_al01.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "台所へ行き棚の中を漁ってみた。",
   "ko_candidate": "부엌으로 가서 선반 안을 뒤져봤다｡"
  },
  {
   "id": 49155,
   "key": "ep_al01.txt:629",
   "file": "ep_al01.txt",
   "line": 629,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ……何だ。やっぱりあるじゃんか」",
   "ko_candidate": "「아……뭐야｡ 역시 있잖아」"
  },
  {
   "id": 49156,
   "key": "ep_al01.txt:631",
   "file": "ep_al01.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "インスタントコーヒーが１パックだけ。",
   "ko_candidate": "인스턴트커피가 1팩만｡"
  },
  {
   "id": 49157,
   "key": "ep_al01.txt:631",
   "file": "ep_al01.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつの買い置きかは忘れたが、まあ、よっぽど古くなきゃ大丈夫だろう。",
   "ko_candidate": "언제 사둔 건지는 잊었지만､ 뭐､ 아주 오래되지만 않았다면 괜찮 겠지｡"
  },
  {
   "id": 49158,
   "key": "ep_al01.txt:631",
   "file": "ep_al01.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今夜はちょっとだけ贅沢が出来そうだ。",
   "ko_candidate": "오늘 밤은 조금 사치를 부릴 수 있을 것 같다｡"
  },
  {
   "id": 49159,
   "key": "ep_al01.txt:633",
   "file": "ep_al01.txt",
   "line": 633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "マグカップにコーヒーを注いで、事務所に戻る。",
   "ko_candidate": "머그컵에 커피를 따라､ 사무실로 돌아온다｡"
  },
  {
   "id": 49160,
   "key": "ep_al01.txt:635",
   "file": "ep_al01.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "机の上に散らかっているのを少し退かして、カップを置き、積み上げられた本から、一番上の一冊を手に取る。",
   "ko_candidate": "책상 위에 어질러진 것들을 조금 치우고､ 컵을 놓은 뒤､ 쌓여있는 책에서 맨 위의 한 권을 집어든다｡"
  },
  {
   "id": 49161,
   "key": "ep_al01.txt:638",
   "file": "ep_al01.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "コーヒーを飲みながら、本に目を通していく。",
   "ko_candidate": "커피를 마시면서､ 책을 훑어본다｡"
  },
  {
   "id": 49162,
   "key": "ep_al01.txt:640",
   "file": "ep_al01.txt",
   "line": 640,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "読んでいるのは、まあ要するに、 魔術理論に関する教本だ。",
   "ko_candidate": "읽고 있는 건､ 뭐 요컨대､ 마술 이론에 관한 교본이다｡"
  },
  {
   "id": 49163,
   "key": "ep_al01.txt:642",
   "file": "ep_al01.txt",
   "line": 642,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大学を辞めてから、結構なブランクがある。",
   "ko_candidate": "대학을 그만둔 뒤로､ 꽤 긴 공백이 있다｡"
  },
  {
   "id": 49164,
   "key": "ep_al01.txt:643",
   "file": "ep_al01.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その分を埋め合わさなきゃならない。",
   "ko_candidate": "그만큼을 메워야 한다｡"
  },
  {
   "id": 49165,
   "key": "ep_al01.txt:645",
   "file": "ep_al01.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "日中は日中で、代筆や本の管理の仕事で、日銭を稼いでいる。",
   "ko_candidate": "낮에는 낮대로､ 대필이나 책 관리 일로 일당을 벌고 있다｡"
  },
  {
   "id": 49166,
   "key": "ep_al01.txt:645",
   "file": "ep_al01.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "探偵業の方は……言うまでもなく、大御礼・開店休業中だ。",
   "ko_candidate": "탐정 일은……말할 것도 없이､ 대대적인 휴업 중이다｡"
  },
  {
   "id": 49167,
   "key": "ep_al01.txt:645",
   "file": "ep_al01.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まあ、それは仕方ない。",
   "ko_candidate": "뭐､ 그건 어쩔 수 없다｡"
  },
  {
   "id": 49168,
   "key": "ep_al01.txt:647",
   "file": "ep_al01.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "仕事から戻れば、教本を開いて、勉強する。",
   "ko_candidate": "일에서 돌아오면､ 교본을 펴고､ 공부한다｡"
  },
  {
   "id": 49169,
   "key": "ep_al01.txt:648",
   "file": "ep_al01.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "真夜中まで勉強したら、少しだけ眠る。",
   "ko_candidate": "한밤중까지 공부하고､ 잠깐 잔다｡"
  },
  {
   "id": 49170,
   "key": "ep_al01.txt:650",
   "file": "ep_al01.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "最近はその繰り返しだ。大変ではあるが、充実はしている。",
   "ko_candidate": "최근엔 그 반복이다｡ 힘들긴 하지만､ 충실하다｡"
  },
  {
   "id": 49171,
   "key": "ep_al01.txt:650",
   "file": "ep_al01.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こういう当たり前の生活が、当たり前の苦労が、今はとても尊い。",
   "ko_candidate": "이런 당연한 생활이､ 당연한 고생이､ 지금은 매우 소중하다｡"
  },
  {
   "id": 49172,
   "key": "ep_al01.txt:652",
   "file": "ep_al01.txt",
   "line": 652,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だから今の生活に、 取り分けて不満などあろうはずもなかった。",
   "ko_candidate": "그래서 지금의 생활에､ 특별히 불만 같은 건 있을 리가 없었다｡"
  },
  {
   "id": 49173,
   "key": "ep_al01.txt:654",
   "file": "ep_al01.txt",
   "line": 654,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ１つ……",
   "ko_candidate": "단 하나……"
  },
  {
   "id": 49174,
   "key": "ep_al01.txt:663",
   "file": "ep_al01.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――心の間隙を突いて襲ってくる喪失感を除いては。",
   "ko_candidate": "――마음의 틈을 파고들어 덮쳐오는 상실감만 빼면｡"
  },
  {
   "id": 49175,
   "key": "ep_al01.txt:672",
   "file": "ep_al01.txt",
   "line": 672,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 49176,
   "key": "ep_al01.txt:674",
   "file": "ep_al01.txt",
   "line": 674,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "本を閉じて、コーヒーを啜り、事務所の中を見回す。",
   "ko_candidate": "책을 덮고､ 커피를 홀짝이며､ 사무실 안을 둘러본다｡"
  },
  {
   "id": 49177,
   "key": "ep_al01.txt:675",
   "file": "ep_al01.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あちこちに本が積まれている、 雑然とした小さな部屋だ。",
   "ko_candidate": "여기저기에 책이 쌓여 있는､ 어수선한 작은 방이다｡"
  },
  {
   "id": 49178,
   "key": "ep_al01.txt:676",
   "file": "ep_al01.txt",
   "line": 676,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど。",
   "ko_candidate": "하지만｡"
  },
  {
   "id": 49179,
   "key": "ep_al01.txt:679",
   "file": "ep_al01.txt",
   "line": 679,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――案外、無駄に広いよな。ここも」",
   "ko_candidate": "「――의외로､ 쓸데없이 넓네｡ 여기도」"
  },
  {
   "id": 49180,
   "key": "ep_al01.txt:694",
   "file": "ep_al01.txt",
   "line": 694,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 49181,
   "key": "ep_al01.txt:701",
   "file": "ep_al01.txt",
   "line": 701,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 49182,
   "key": "ep_al01.txt:707",
   "file": "ep_al01.txt",
   "line": 707,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 49183,
   "key": "ep_al01.txt:719",
   "file": "ep_al01.txt",
   "line": 719,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………………………だああああ！　うるさいっ！」",
   "ko_candidate": "「…………………………으아아아아! 시끄러워!」"
  },
  {
   "id": 49184,
   "key": "ep_al01.txt:721",
   "file": "ep_al01.txt",
   "line": 721,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何だ、何だ!?　人がせっかく惰眠を貪り尽くしているところを!?",
   "ko_candidate": "뭐야､ 뭐야!? 사람이 겨우 게으름을 실컷 부리고 있는데!?"
  },
  {
   "id": 49185,
   "key": "ep_al01.txt:723",
   "file": "ep_al01.txt",
   "line": 723,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今日は仕事は休みだし、事務所は休業中だし、俺にしては殊勝なことに水道代電気代その他もろもろ、真面目に納めている！",
   "ko_candidate": "오늘은 일도 쉬는 날이고､ 사무실도 휴업 중이고､ 나로서는 특별히 성실하 게 수도세 전기세 기타 등등､ 착실히 납부하고 있다고!"
  }
 ]
}