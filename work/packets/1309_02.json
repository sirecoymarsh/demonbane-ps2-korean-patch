 "items": [
  {
   "id": 33971,
   "key": "D1309al.txt:338",
   "file": "D1309al.txt",
   "line": 338,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どう！　これがアタシの！ ベルゼビュートの力よ！」 「所詮、 紛い物のアンタに勝ち目なんて ハナっから無かったのよん！」",
   "ko_candidate": "「오호호… 오호호호호호､ 오-호호호호호호호! 어때! 이게 내가! 벨제뷰트의 힘이야! 소껍데기인 너한텐 이길 가망이 처음부터 없었다고!」"
  },
  {
   "id": 33972,
   "key": "D1309al.txt:348",
   "file": "D1309al.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝利を確信したティベリウスが高らかと哄笑する。",
   "ko_candidate": "승리를 확신한 티베리우스가 높이 웃음을 터뜨린다｡"
  },
  {
   "id": 33973,
   "key": "D1309al.txt:349",
   "file": "D1309al.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "晴れやかだ。",
   "ko_candidate": "상쾌하다｡"
  },
  {
   "id": 33974,
   "key": "D1309al.txt:350",
   "file": "D1309al.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実に晴れやかな気分だ。",
   "ko_candidate": "정말 상쾌한 기분이다｡"
  },
  {
   "id": 33975,
   "key": "D1309al.txt:352",
   "file": "D1309al.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咽喉に刺さっていた魚の小骨が取れたときのように清々しい。",
   "ko_candidate": "목구멍에 박혔던 생선 가시가 빠졌을 때처럼 개운하다｡"
  },
  {
   "id": 33976,
   "key": "D1309al.txt:352",
   "file": "D1309al.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まったく本当につまらないモノに、てこずっていたものだ。",
   "ko_candidate": "정말 시시한 것에 애를 먹었었군｡"
  },
  {
   "id": 33977,
   "key": "D1309al.txt:354",
   "file": "D1309al.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、これでようやく、せいせいした。",
   "ko_candidate": "하지만､ 이제야 겨우 후련해졌다｡"
  },
  {
   "id": 33978,
   "key": "D1309al.txt:355",
   "file": "D1309al.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう何の憂いも無い。",
   "ko_candidate": "이제 아무런 근심도 없다｡"
  },
  {
   "id": 33979,
   "key": "D1309al.txt:359",
   "file": "D1309al.txt",
   "line": 359,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「愉快よ。実に愉快よ……さあ、この気分の良さを瑠璃お嬢様にもお裾分けしてあげないとねん……」",
   "ko_candidate": "「즐겁군｡ 정말 즐거워… 자､ 이 기분 좋은 걸 루리 아가씨에게도 나눠줘야겠지…」"
  },
  {
   "id": 33980,
   "key": "D1309al.txt:363",
   "file": "D1309al.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "舌なめずりして、 厭らしく腐った顔を歪めるティベリウス。",
   "ko_candidate": "혀를 핥으며 역겹게 썩은 얼굴을 일그러뜨리는 티베리우스｡"
  },
  {
   "id": 33981,
   "key": "D1309al.txt:365",
   "file": "D1309al.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそこで違和感に気付いた。",
   "ko_candidate": "하지만 그때 위화감을 느꼈다｡"
  },
  {
   "id": 33982,
   "key": "D1309al.txt:369",
   "file": "D1309al.txt",
   "line": 369,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 33983,
   "key": "D1309al.txt:372",
   "file": "D1309al.txt",
   "line": 372,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覇道瑠璃が先程から黙ったままだ。",
   "ko_candidate": "하도 루리가 아까부터 계속 침묵하고 있다｡"
  },
  {
   "id": 33984,
   "key": "D1309al.txt:373",
   "file": "D1309al.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "泣き叫ぶ訳でもない。恐怖に怯える訳でもない。 放心しているのか、",
   "ko_candidate": "울부짖지도 않는다｡ 공포에 떨지도 않는다｡"
  },
  {
   "id": 33985,
   "key": "D1309al.txt:376",
   "file": "D1309al.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それともついに気が触れてしまったのか――。",
   "ko_candidate": "멍해진 건가､ 아니면 드디어 미쳐버린 건가―｡"
  },
  {
   "id": 33986,
   "key": "D1309al.txt:379",
   "file": "D1309al.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その時だ。",
   "ko_candidate": "그때였다｡"
  },
  {
   "id": 33987,
   "key": "D1309al.txt:381",
   "file": "D1309al.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスもようやく瑠璃と同じものを見た。",
   "ko_candidate": "티베리우스도 드디어 루리와 같은 것을 보았다｡"
  },
  {
   "id": 33988,
   "key": "D1309al.txt:387",
   "file": "D1309al.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い爆炎の向こう。",
   "ko_candidate": "검은 폭염의 저편｡"
  },
  {
   "id": 33989,
   "key": "D1309al.txt:388",
   "file": "D1309al.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何も存在するはずのない向こうに、 彼はそれを見つけた。",
   "ko_candidate": "아무것도 존재하지 않아야 할 저편에서､ 그는 그것을 발견했다｡"
  },
  {
   "id": 33990,
   "key": "D1309al.txt:393",
   "file": "D1309al.txt",
   "line": 393,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な…………ッ？」",
   "ko_candidate": "「뭐………¨읏?」"
  },
  {
   "id": 33991,
   "key": "D1309al.txt:405",
   "file": "D1309al.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……やたらと静かだ。",
   "ko_candidate": "……유난히 조용하다｡"
  },
  {
   "id": 33992,
   "key": "D1309al.txt:406",
   "file": "D1309al.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も聞こえやしない。何も感じやしない。",
   "ko_candidate": "아무것도 들리지 않는다｡ 아무것도 느껴지지 않는다｡"
  },
  {
   "id": 33993,
   "key": "D1309al.txt:408",
   "file": "D1309al.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は死んでしまったのか？",
   "ko_candidate": "나는 죽어버린 걸까?"
  },
  {
   "id": 33994,
   "key": "D1309al.txt:410",
   "file": "D1309al.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうか……結局、どうもならなかったか。",
   "ko_candidate": "그런가… 결국､ 어쩔 수 없었나｡"
  },
  {
   "id": 33995,
   "key": "D1309al.txt:411",
   "file": "D1309al.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺には魔を断つ剣を振るう器などなかったということか。 すまない……すまない、みんな。",
   "ko_candidate": "나에겐 마를 베는 검을 휘두를 그릇 따위는 없었다는 건가｡"
  },
  {
   "id": 33996,
   "key": "D1309al.txt:414",
   "file": "D1309al.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が弱かったばっかりに……。",
   "ko_candidate": "미안해… 미안해､ 모두들｡"
  },
  {
   "id": 33997,
   "key": "D1309al.txt:416",
   "file": "D1309al.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……なんてことだ。",
   "ko_candidate": "내가 약했기 때문에…"
  },
  {
   "id": 33998,
   "key": "D1309al.txt:417",
   "file": "D1309al.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "死んでも、こんなに悔しいなんて。",
   "ko_candidate": "……이런 젠장｡ 죽어서도､ 이렇게 분하다니｡"
  },
  {
   "id": 33999,
   "key": "D1309al.txt:419",
   "file": "D1309al.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……『ブラックロッジ』に殺された人達も、こんなに悔しい想いをしたのだろうか。",
   "ko_candidate": "……『블랙로지』에게 죽임을 당한 사람들도､ 이렇게 분한 마음이었을까｡"
  },
  {
   "id": 34000,
   "key": "D1309al.txt:421",
   "file": "D1309al.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だとしたら、死んでも、とても安らげそうにない。",
   "ko_candidate": "그렇다면､ 죽어서도､ 도저히 편히 쉴 수 없을 것 같다｡"
  },
  {
   "id": 34001,
   "key": "D1309al.txt:423",
   "file": "D1309al.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それにしてもここは何処だろう？",
   "ko_candidate": "그나저나 여긴 어디지?"
  },
  {
   "id": 34002,
   "key": "D1309al.txt:424",
   "file": "D1309al.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……死んでしまったのなら、あの世に決まっているか。",
   "ko_candidate": "……죽어버렸다면､ 저승이겠지｡"
  },
  {
   "id": 34003,
   "key": "D1309al.txt:425",
   "file": "D1309al.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうも、それっぽい。",
   "ko_candidate": "뭐､ 그런 것 같다｡"
  },
  {
   "id": 34004,
   "key": "D1309al.txt:436",
   "file": "D1309al.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だって、ほら……あいつの顔が、見える。",
   "ko_candidate": "왜냐하면､ 봐… 그 녀석의 얼굴이､ 보인다｡"
  },
  {
   "id": 34005,
   "key": "D1309al.txt:438",
   "file": "D1309al.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……………………あいつ？",
   "ko_candidate": "…………………………그 녀석?"
  },
  {
   "id": 34006,
   "key": "D1309al.txt:446",
   "file": "D1309al.txt",
   "line": 446,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「勝手に死なすな。それと勝手に死ぬな。無責任過ぎるぞ」 その声に、",
   "ko_candidate": "「마음대로 죽게 하지 마｡ 그리고 마음대로 죽지 마｡ 너무 무책임하잖아」"
  },
  {
   "id": 34007,
   "key": "D1309al.txt:451",
   "file": "D1309al.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ようやく朦朧とした意識がはっきりと覚醒する。",
   "ko_candidate": "그 목소리에､ 드디어 몽롱했던 의식이 또렷이 깨어난다｡"
  },
  {
   "id": 34008,
   "key": "D1309al.txt:452",
   "file": "D1309al.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呆然と、開けっ放しになったハッチの外を見つめる。",
   "ko_candidate": "멍하니､ 열어젖힌 채로 있는 해치 밖을 바라본다｡"
  },
  {
   "id": 34009,
   "key": "D1309al.txt:456",
   "file": "D1309al.txt",
   "line": 456,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ま、まさか……」",
   "ko_candidate": "「설､ 설마…」"
  },
  {
   "id": 34010,
   "key": "D1309al.txt:458",
   "file": "D1309al.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "信じられないものを見た。",
   "ko_candidate": "믿을 수 없는 것을 보았다｡"
  }
 ]
}