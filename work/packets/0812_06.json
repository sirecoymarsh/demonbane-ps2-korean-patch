 "items": [
  {
   "id": 16313,
   "key": "D0812le.txt:635",
   "file": "D0812le.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "直撃は免れるものの、髪は断ち斬られた。",
   "ko_candidate": "직격은 면했지만､ 머리카락은 잘려나갔다｡"
  },
  {
   "id": 16314,
   "key": "D0812le.txt:639",
   "file": "D0812le.txt",
   "line": 639,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "落ちるライカさんの躰を『暴君』が再びキャッチする。",
   "ko_candidate": "떨어지는 라이카 씨의 몸을 『폭군』이 다시 잡는다｡"
  },
  {
   "id": 16315,
   "key": "D0812le.txt:641",
   "file": "D0812le.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちっ……せっかくのチャンスを！",
   "ko_candidate": "치… 좋은 기회를!"
  },
  {
   "id": 16316,
   "key": "D0812le.txt:646",
   "file": "D0812le.txt",
   "line": 646,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああん……またしても私達の絆は引き裂かれる運命……」",
   "ko_candidate": "「아앙… 또다시 우리의 인연은 갈라질 운명…」"
  },
  {
   "id": 16317,
   "key": "D0812le.txt:652",
   "file": "D0812le.txt",
   "line": 652,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……意外と余裕だな。あの女」",
   "ko_candidate": "「…의외로 여유롭네｡ 저 여자」"
  },
  {
   "id": 16318,
   "key": "D0812le.txt:658",
   "file": "D0812le.txt",
   "line": 658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自由落下に身を任せる。",
   "ko_candidate": "자유낙하에 몸을 맡긴다｡"
  },
  {
   "id": 16319,
   "key": "D0812le.txt:659",
   "file": "D0812le.txt",
   "line": 659,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "すぐ下の階の床が迫った。",
   "ko_candidate": "바로 아래 층의 바닥이 다가왔다｡"
  },
  {
   "id": 16320,
   "key": "D0812le.txt:669",
   "file": "D0812le.txt",
   "line": 669,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "４人同時に着地する。そしてすぐに身構える。",
   "ko_candidate": "4명이 동시에 착지한다｡ 그리고 곧바로 자세를 잡는다｡"
  },
  {
   "id": 16321,
   "key": "D0812le.txt:670",
   "file": "D0812le.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "また、振り出しか……そう思ったが、どうも様子が違う。",
   "ko_candidate": "또 원점이군… 그렇게 생각했지만､ 뭔가 상황이 다르다｡"
  },
  {
   "id": 16322,
   "key": "D0812le.txt:675",
   "file": "D0812le.txt",
   "line": 675,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……カリグラ？」",
   "ko_candidate": "「…칼리굴라?」"
  },
  {
   "id": 16323,
   "key": "D0812le.txt:679",
   "file": "D0812le.txt",
   "line": 679,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "カリグラが右目を押さえて、蹲っている。",
   "ko_candidate": "칼리굴라가 오른쪽 눈을 누르며 쪼그리고 있다｡"
  },
  {
   "id": 16324,
   "key": "D0812le.txt:681",
   "file": "D0812le.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さっきので目を撃たれたか。指の合間から、血が滴っていた。",
   "ko_candidate": "아까 그걸로 눈을 맞았나｡ 손가락 사이로 피가 떨어지고 있었다｡"
  },
  {
   "id": 16325,
   "key": "D0812le.txt:683",
   "file": "D0812le.txt",
   "line": 683,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "口からは、その巨体には似合わず、嗚咽のような呻き声が洩れている。",
   "ko_candidate": "입에서는 그 거대한 체구와는 어울리지 않게 흐느낌 같은 신음 소리가 새어 나온다｡"
  },
  {
   "id": 16326,
   "key": "D0812le.txt:688",
   "file": "D0812le.txt",
   "line": 688,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ウ……あ……アア…… うグゥ……」",
   "ko_candidate": "「우… 아… 아아… 우그으…」"
  },
  {
   "id": 16327,
   "key": "D0812le.txt:693",
   "file": "D0812le.txt",
   "line": 693,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「や、ヤベぇ！」",
   "ko_candidate": "「야､ 야베에!」"
  },
  {
   "id": 16328,
   "key": "D0812le.txt:697",
   "file": "D0812le.txt",
   "line": 697,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "クラウディウスがやたらと焦っていた。",
   "ko_candidate": "클라우디우스가 유난히 당황하고 있었다｡"
  },
  {
   "id": 16329,
   "key": "D0812le.txt:699",
   "file": "D0812le.txt",
   "line": 699,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……何があったんだ？",
   "ko_candidate": "…무슨 일이 있었던 거지?"
  },
  {
   "id": 16330,
   "key": "D0812le.txt:701",
   "file": "D0812le.txt",
   "line": 701,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう思った矢先だった。膨れ上がる狂暴な魔力を感じたのは。",
   "ko_candidate": "그렇게 생각한 찰나였다｡ 부풀어 오르는 광폭한 마력을 느낀 것은｡"
  },
  {
   "id": 16331,
   "key": "D0812le.txt:704",
   "file": "D0812le.txt",
   "line": 704,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「な、何だっ!?」",
   "ko_candidate": "「뭐､ 뭐야!?」"
  },
  {
   "id": 16332,
   "key": "D0812le.txt:709",
   "file": "D0812le.txt",
   "line": 709,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「目がァァァァァ！　目がああああああ！　オデの目ぐわぁぁぁああ！」",
   "ko_candidate": "「눈이이이이! 눈이아아아아아! 오데의 눈구와아아아아!」"
  },
  {
   "id": 16333,
   "key": "D0812le.txt:714",
   "file": "D0812le.txt",
   "line": 714,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "叫びながら拳を振るう。",
   "ko_candidate": "소리치며 주먹을 휘두른다｡"
  },
  {
   "id": 16334,
   "key": "D0812le.txt:723",
   "file": "D0812le.txt",
   "line": 723,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "狙いも何もない一撃は壁を粉々に爆砕する。",
   "ko_candidate": "조준도 없는 일격은 벽을 산산조각 내며 폭파한다｡"
  },
  {
   "id": 16335,
   "key": "D0812le.txt:725",
   "file": "D0812le.txt",
   "line": 725,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さらに振るう。無差別に振るう。",
   "ko_candidate": "계속해서 휘두른다｡ 무차별적으로 휘두른다｡"
  },
  {
   "id": 16336,
   "key": "D0812le.txt:729",
   "file": "D0812le.txt",
   "line": 729,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "部屋を破壊する魔力の衝撃波。俺も『暴君』もそして仲間であるクラウディウスでさえ、爆発に巻き込まれないよう逃げ回るのに精一杯だった。",
   "ko_candidate": "방을 파괴하는 마력의 충격파｡ 나도 『폭군』도 그리고 동료인 클라우디우스조차 폭발에 휘말리지 않도록 도망치는 데 정신이 없었다｡"
  },
  {
   "id": 16337,
   "key": "D0812le.txt:734",
   "file": "D0812le.txt",
   "line": 734,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ぶるぐばラばぁぁぁぁアアアアアア！」",
   "ko_candidate": "「부루구바라바아아아아아아아아!」"
  },
  {
   "id": 16338,
   "key": "D0812le.txt:738",
   "file": "D0812le.txt",
   "line": 738,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「い、いきなりブチ切れやがったぞ!?」",
   "ko_candidate": "「갑､ 갑자기 부숴버렸잖아!?」"
  },
  {
   "id": 16339,
   "key": "D0812le.txt:743",
   "file": "D0812le.txt",
   "line": 743,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……怪我で自分を見失っておるな」",
   "ko_candidate": "「…부상으로 자신을 잃고 있구나」"
  },
  {
   "id": 16340,
   "key": "D0812le.txt:748",
   "file": "D0812le.txt",
   "line": 748,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何を悠長な口ぶりでっ！」",
   "ko_candidate": "「뭘 그렇게 여유 있는 말투로!」"
  },
  {
   "id": 16341,
   "key": "D0812le.txt:760",
   "file": "D0812le.txt",
   "line": 760,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無論、あっという間にこのフロアも崩壊し、俺達はまた下の階へと落ちる……と思ったら、破壊の衝撃波は、下の階、その下の階、さらにその下の階まで貫通し、粉微塵にする。",
   "ko_candidate": "물론､ 순식간에 이 층도 무너지고 우리는 또 아래층으로 떨어진다… 라고 생각했는데､ 파괴의 충격파는 아래층､ 그 아래층､ 더 아래층까지 관통해 산산조각 낸다｡"
  },
  {
   "id": 16342,
   "key": "D0812le.txt:762",
   "file": "D0812le.txt",
   "line": 762,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "このままじゃ建物自体が無くなっちまいそうだ。",
   "ko_candidate": "이대로라면 건물 자체가 없어질 것 같다｡"
  },
  {
   "id": 16343,
   "key": "D0812le.txt:771",
   "file": "D0812le.txt",
   "line": 771,
   "speaker": "クラウディウス / カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「や、やめろカリグラ！　ボクも居るんだぞ！ 巻き込む気か、豚のケツがっ！」 「がああああああアアアアあああああッ！」",
   "ko_candidate": "「그､ 그만해 칼리굴라! 나도 있다고! 휘말릴 셈이냐､ 돼지 엉덩이 자식아!」"
  },
  {
   "id": 16344,
   "key": "D0812le.txt:788",
   "file": "D0812le.txt",
   "line": 788,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「きゃあああああああ！」",
   "ko_candidate": "「가아아아아아아아아아아악!」"
  },
  {
   "id": 16345,
   "key": "D0812le.txt:796",
   "file": "D0812le.txt",
   "line": 796,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クッ！　大人しく……しろぉぉぉぉぉ！」",
   "ko_candidate": "「꺄아아아아아아!」 「큿! 얌전히… 있어어어어어!」"
  },
  {
   "id": 16346,
   "key": "D0812le.txt:799",
   "file": "D0812le.txt",
   "line": 799,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自由落下の中、自動拳銃をカリグラに向ける。",
   "ko_candidate": "자유낙하 중에 자동 권총을 칼리굴라를 향해 겨눈다｡"
  },
  {
   "id": 16347,
   "key": "D0812le.txt:807",
   "file": "D0812le.txt",
   "line": 807,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆音の如き銃声。閃光弾の如きマズル・フラッシュ。",
   "ko_candidate": "폭음 같은 총성｡ 섬광탄 같은 머즐 플래시｡"
  },
  {
   "id": 16348,
   "key": "D0812le.txt:808",
   "file": "D0812le.txt",
   "line": 808,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鼓膜を痺れさせ、網膜を灼く。",
   "ko_candidate": "고막을 저리게 하고 망막을 태운다｡"
  },
  {
   "id": 16349,
   "key": "D0812le.txt:815",
   "file": "D0812le.txt",
   "line": 815,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「なあああああ!?」",
   "ko_candidate": "「나아아아아!?」"
  },
  {
   "id": 16350,
   "key": "D0812le.txt:817",
   "file": "D0812le.txt",
   "line": 817,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "反動の大きさに、空中でひっくり返る羽目になった。",
   "ko_candidate": "반동의 크기에 공중에서 뒤집힐 뻔했다｡"
  },
  {
   "id": 16351,
   "key": "D0812le.txt:818",
   "file": "D0812le.txt",
   "line": 818,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しかしそれでも弾丸は真っ直ぐと飛び、カリグラを撃ち抜く！",
   "ko_candidate": "하지만 그래도 총알은 똑바로 날아가 칼리굴라를 관통한다!"
  },
  {
   "id": 16352,
   "key": "D0812le.txt:820",
   "file": "D0812le.txt",
   "line": 820,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "肉が爆ぜる音。",
   "ko_candidate": "살이 터지는 소리｡"
  }
 ]
}