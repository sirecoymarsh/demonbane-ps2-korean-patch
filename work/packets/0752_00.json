   "key": "D0752.txt:100",
   "file": "D0752.txt",
   "line": 100,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「だ、大十字さんがさらわれたですってぇぇぇっ！？」",
   "ko_candidate": ""
  },
  {
