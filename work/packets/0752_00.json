   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "爆発による都市区画の被害状況を受けながら、ネスは嘆息する。",
   "ko_candidate": ""
  },
  {
