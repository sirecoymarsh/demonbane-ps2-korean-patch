   "key": "D0752.txt:43",
   "file": "D0752.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あれほどの爆発であったにもかかわらず、見た目にはそれほど大きな破損箇所はないようだった。",
   "ko_candidate": ""
  },
  {
   "id": 11372,
   "key": "D0752.txt:48",
