   "key": "D0752.txt:75",
   "file": "D0752.txt",
   "line": 75,
   "speaker": "ストーン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「くぅぅぅっ！　治安警察の威厳はどこに行ってしまったのでありますかっ！」",
   "ko_candidate": ""
  },
  {
   "id": 11378,
   "key": "D0752.txt:80",
   "file": "D0752.txt",
   "line": 80,
   "speaker": "ネス",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「んなもん、覇道と関係なしに、最初ッからねえよ。まっ、厄介事は全部引き受けてくれた方が俺ぁ楽だね」",
   "ko_candidate": ""
  },
  {
   "id": 11379,
   "key": "D0752.txt:85",
   "file": "D0752.txt",
   "line": 85,
   "speaker": "ストーン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「警部～～～～ッッ！」",
   "ko_candidate": ""
  },
  {
