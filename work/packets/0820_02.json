 "items": [
  {
   "id": 17446,
   "key": "D0820le.txt:344",
   "file": "D0820le.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そんな不思議な印象の青年だった。",
   "ko_candidate": "그런 신기한 인상의 청년이었다｡"
  },
  {
   "id": 17447,
   "key": "D0820le.txt:350",
   "file": "D0820le.txt",
   "line": 350,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何だ？　知り合いか？」",
   "ko_candidate": "「뭐지? 아는 사람이야?」"
  },
  {
   "id": 17448,
   "key": "D0820le.txt:356",
   "file": "D0820le.txt",
   "line": 356,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――――――」",
   "ko_candidate": "「――――――――――」"
  },
  {
   "id": 17449,
   "key": "D0820le.txt:361",
   "file": "D0820le.txt",
   "line": 361,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ライカさん？」",
   "ko_candidate": "「라이카 씨?」"
  },
  {
   "id": 17450,
   "key": "D0820le.txt:363",
   "file": "D0820le.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんの視線は青年に釘づけになったまま、",
   "ko_candidate": "라이카 씨의 시선은 청년에게 못박힌 채､ 얼어붙어 있다｡"
  },
  {
   "id": 17451,
   "key": "D0820le.txt:364",
   "file": "D0820le.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "凍りついている。 瞬き一つしない。",
   "ko_candidate": "눈 한 번 깜빡이지 않는다｡"
  },
  {
   "id": 17452,
   "key": "D0820le.txt:368",
   "file": "D0820le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何やら、やたらと驚いているみたいだが。",
   "ko_candidate": "뭔가､ 몹시 놀라고 있는 것 같은데｡"
  },
  {
   "id": 17453,
   "key": "D0820le.txt:376",
   "file": "D0820le.txt",
   "line": 376,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ！　ライカ姉ちゃん！ おそいぞー！」",
   "ko_candidate": "「아! 라이카 누나! 늦었어~!」"
  },
  {
   "id": 17454,
   "key": "D0820le.txt:381",
   "file": "D0820le.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガキんちょどもが、こっちに気付き、 ワーッと駈け寄ってくる。",
   "ko_candidate": "꼬맹이들이 이쪽을 알아채고 와아 하고 달려온다｡"
  },
  {
   "id": 17455,
   "key": "D0820le.txt:383",
   "file": "D0820le.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "青年は演奏をやめ、ゆっくりとこちらを向いた。",
   "ko_candidate": "청년은 연주를 멈추고 천천히 이쪽을 향했다｡"
  },
  {
   "id": 17456,
   "key": "D0820le.txt:389",
   "file": "D0820le.txt",
   "line": 389,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「やあ……久しぶりだね」",
   "ko_candidate": "「안녕… 오랜만이네」"
  },
  {
   "id": 17457,
   "key": "D0820le.txt:392",
   "file": "D0820le.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "軽く微笑みを浮かべて、静かな口調で語りかける。",
   "ko_candidate": "살짝 미소를 지으며 조용한 어조로 말을 건넨다｡"
  },
  {
   "id": 17458,
   "key": "D0820le.txt:393",
   "file": "D0820le.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "久しぶり……やっぱりライカさんの知り合いなのか。",
   "ko_candidate": "오랜만… 역시 라이카 씨의 지인인가｡"
  },
  {
   "id": 17459,
   "key": "D0820le.txt:395",
   "file": "D0820le.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんが小刻みに震えている。",
   "ko_candidate": "라이카 씨가 미세하게 떨고 있다｡"
  },
  {
   "id": 17460,
   "key": "D0820le.txt:396",
   "file": "D0820le.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ずいぶんと動揺しているようだった。",
   "ko_candidate": "꽤나 동요하고 있는 것 같았다｡"
  },
  {
   "id": 17461,
   "key": "D0820le.txt:401",
   "file": "D0820le.txt",
   "line": 401,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ、あなた……何で……っ？」",
   "ko_candidate": "「아､ 당신… 왜…?」"
  },
  {
   "id": 17462,
   "key": "D0820le.txt:408",
   "file": "D0820le.txt",
   "line": 408,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「冷たいな……２人でゆっくりと話す機会が久しくなかったから、わざわざ会いに来たのに。でも……」",
   "ko_candidate": "「차갑네… 둘이서 천천히 이야기할 기회가 오랜만이라서､ 일부러 만나러 왔는데｡ 하지만…」"
  },
  {
   "id": 17463,
   "key": "D0820le.txt:411",
   "file": "D0820le.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "椅子から起き上がり、こっちに向かって歩いてくる。",
   "ko_candidate": "의자에서 일어나 이쪽으로 걸어온다｡"
  },
  {
   "id": 17464,
   "key": "D0820le.txt:413",
   "file": "D0820le.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "背筋はピンと真っ直ぐに伸び、歩いても頭が上下しない。どうも見た目通り、武道の類を嗜んでいるっぽい。",
   "ko_candidate": "등줄기는 꼿꼿이 펴고､ 걸어도 머리가 위아래로 움직이지 않는다｡"
  },
  {
   "id": 17465,
   "key": "D0820le.txt:415",
   "file": "D0820le.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "青年はライカさんの目の前で止まった。",
   "ko_candidate": "아무래도 겉모습대로 무도를 익힌 것 같다｡"
  },
  {
   "id": 17466,
   "key": "D0820le.txt:419",
   "file": "D0820le.txt",
   "line": 419,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「もう、随分と 遅くなってしまった。 見たところ、ずぶ濡れの ようだし……またの機会にするよ」",
   "ko_candidate": "청년은 라이카 씨의 눈앞에서 멈췄다｡ 「이제 꽤 늦어버렸네｡ 보아하니 흠뻑 젖은 것 같고… 다음 기회로 하지」"
  },
  {
   "id": 17467,
   "key": "D0820le.txt:427",
   "file": "D0820le.txt",
   "line": 427,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……リューガッ！」",
   "ko_candidate": "「…류가!」"
  },
  {
   "id": 17468,
   "key": "D0820le.txt:431",
   "file": "D0820le.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リューガ。",
   "ko_candidate": "류가｡"
  },
  {
   "id": 17469,
   "key": "D0820le.txt:432",
   "file": "D0820le.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それがこの青年の名前らしい。",
   "ko_candidate": "그게 이 청년의 이름인 것 같다｡"
  },
  {
   "id": 17470,
   "key": "D0820le.txt:434",
   "file": "D0820le.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ライカさんが何かを言おうとする前に、青年は俺の方を見て語りかけてきた。",
   "ko_candidate": "라이카 씨가 뭔가 말하려고 하기 전에､ 청년은 내 쪽을 보고 말을 걸어왔다｡"
  },
  {
   "id": 17471,
   "key": "D0820le.txt:440",
   "file": "D0820le.txt",
   "line": 440,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「こっちは友達かな？　やあ、彼女が世話になってるようだね」",
   "ko_candidate": "「이쪽은 친구인가? 안녕､ 그녀가 신세를 지고 있는 것 같네」"
  },
  {
   "id": 17472,
   "key": "D0820le.txt:444",
   "file": "D0820le.txt",
   "line": 444,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あ……いや、こちらこそ」",
   "ko_candidate": "「아… 아뇨､ 저야말로」"
  },
  {
   "id": 17473,
   "key": "D0820le.txt:446",
   "file": "D0820le.txt",
   "line": 446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "状況に流されて、何とも気が抜けた返事をしてしまう。",
   "ko_candidate": "상황에 휩쓸려 어쩐지 맥 빠진 대답을 해버렸다｡"
  },
  {
   "id": 17474,
   "key": "D0820le.txt:447",
   "file": "D0820le.txt",
   "line": 447,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "挨拶を済ますと、青年は俺たちの横を通り過ぎる。",
   "ko_candidate": "인사를 마치자 청년은 우리 옆을 지나간다｡"
  },
  {
   "id": 17475,
   "key": "D0820le.txt:454",
   "file": "D0820le.txt",
   "line": 454,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ、ばいばーい。 お兄ちゃんっ」",
   "ko_candidate": "「아､ 바이바이｡ 오빠」"
  },
  {
   "id": 17476,
   "key": "D0820le.txt:460",
   "file": "D0820le.txt",
   "line": 460,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「また、ハーモニカ吹いてね」",
   "ko_candidate": "「또 하모니카 불어줘」"
  },
  {
   "id": 17477,
   "key": "D0820le.txt:464",
   "file": "D0820le.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "軽く手を振って、子どもたちに応える。",
   "ko_candidate": "가볍게 손을 흔들며 아이들에게 응답한다｡"
  },
  {
   "id": 17478,
   "key": "D0820le.txt:466",
   "file": "D0820le.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "扉に手を触れる。",
   "ko_candidate": "문에 손을 댄다｡"
  },
  {
   "id": 17479,
   "key": "D0820le.txt:471",
   "file": "D0820le.txt",
   "line": 471,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガ！」",
   "ko_candidate": "「류가!」"
  },
  {
   "id": 17480,
   "key": "D0820le.txt:475",
   "file": "D0820le.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "振り返り、ライカさんが叫んだ。",
   "ko_candidate": "돌아보자 라이카 씨가 외쳤다｡"
  },
  {
   "id": 17481,
   "key": "D0820le.txt:477",
   "file": "D0820le.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただならぬ様子に、 この場に居る者全員が黙ってしまう。",
   "ko_candidate": "심상치 않은 모습에 이 자리에 있는 사람 모두가 입을 다물어 버린다｡"
  },
  {
   "id": 17482,
   "key": "D0820le.txt:480",
   "file": "D0820le.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しんっ……と静まり返る礼拝堂。",
   "ko_candidate": "쥐 죽은 듯 조용해진 예배당｡"
  },
  {
   "id": 17483,
   "key": "D0820le.txt:485",
   "file": "D0820le.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "扉を開ける音だけが響く。",
   "ko_candidate": "문을 여는 소리만이 울린다｡"
  },
  {
   "id": 17484,
   "key": "D0820le.txt:490",
   "file": "D0820le.txt",
   "line": 490,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「じゃあな。 また、会おう……ライカ」",
   "ko_candidate": "「그럼 가지｡ 또 만나자… 라이카」"
  },
  {
   "id": 17485,
   "key": "D0820le.txt:497",
   "file": "D0820le.txt",
   "line": 497,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あ……おい、外はまだ雨……」",
   "ko_candidate": "「아… 저기､ 밖은 아직 비가…」"
  }
 ]
