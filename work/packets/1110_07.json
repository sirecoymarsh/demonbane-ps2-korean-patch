 },
 "items": [
  {
   "id": 25834,
   "key": "D1110ru.txt:835",
   "file": "D1110ru.txt",
   "line": 835,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "落下の勢いまでを利用した斬撃が、上空より振り下ろされる。",
   "ko_candidate": "낙하의 기세까지 이용한 참격이 상공에서 내리꽂힌다｡"
  },
  {
   "id": 25835,
   "key": "D1110ru.txt:836",
   "file": "D1110ru.txt",
   "line": 836,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鈍重かつ、両腕を伸ばした状態で隙が生じているクラーケンは、それをかわせない。",
   "ko_candidate": "둔중하고 양팔을 뻗은 상태로 틈이 생긴 크라켄은 그것을 피할 수 없다｡"
  },
  {
   "id": 25836,
   "key": "D1110ru.txt:841",
   "file": "D1110ru.txt",
   "line": 841,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烈しい火花が閃光となって、瑠璃の視界を染めた。",
   "ko_candidate": "격렬한 불꽃이 섬광이 되어 루리의 시야를 물들였다｡"
  },
  {
   "id": 25837,
   "key": "D1110ru.txt:842",
   "file": "D1110ru.txt",
   "line": 842,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重い爆音が轟く。",
   "ko_candidate": "무거운 폭음이 울린다｡"
  },
  {
   "id": 25838,
   "key": "D1110ru.txt:847",
   "file": "D1110ru.txt",
   "line": 847,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアアアあああああアアあ！」",
   "ko_candidate": "「아아아아아아아아아아아!」"
  },
  {
   "id": 25839,
   "key": "D1110ru.txt:856",
   "file": "D1110ru.txt",
   "line": 856,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀は見事にクラーケンの頭部を捉えていた。",
   "ko_candidate": "바르자이의 언월도는 훌륭하게 크라켄의 머리 부분을 포착했다｡"
  },
  {
   "id": 25840,
   "key": "D1110ru.txt:858",
   "file": "D1110ru.txt",
   "line": 858,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "半ばまで刃が喰い込み、機械の眸を破壊した。",
   "ko_candidate": "절반까지 칼날이 파고들어 기계의 눈동자를 파괴했다｡"
  },
  {
   "id": 25841,
   "key": "D1110ru.txt:860",
   "file": "D1110ru.txt",
   "line": 860,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "放電し、水銀の血が噴き出て、炎を噴く。",
   "ko_candidate": "방전하며 수은 같은 피가 뿜어져 나오고 불꽃을 토한다｡"
  },
  {
   "id": 25842,
   "key": "D1110ru.txt:861",
   "file": "D1110ru.txt",
   "line": 861,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 25843,
   "key": "D1110ru.txt:868",
   "file": "D1110ru.txt",
   "line": 868,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぐぐ……ぐっ！」",
   "ko_candidate": "「그그그……윽!」"
  },
  {
   "id": 25844,
   "key": "D1110ru.txt:873",
   "file": "D1110ru.txt",
   "line": 873,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「く……っ！」",
   "ko_candidate": "「크……읏!」"
  },
  {
   "id": 25845,
   "key": "D1110ru.txt:877",
   "file": "D1110ru.txt",
   "line": 877,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、そこまで。",
   "ko_candidate": "하지만､ 거기까지였다｡"
  },
  {
   "id": 25846,
   "key": "D1110ru.txt:878",
   "file": "D1110ru.txt",
   "line": 878,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこで止まってしまった。",
   "ko_candidate": "거기서 멈추고 말았다｡"
  },
  {
   "id": 25847,
   "key": "D1110ru.txt:880",
   "file": "D1110ru.txt",
   "line": 880,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これ以上は威力が足りなくて、クラーケンの装甲を破壊できない。",
   "ko_candidate": "이 이상은 위력이 부족해서 크라켄의 장갑을 파괴할 수 없다｡"
  },
  {
   "id": 25848,
   "key": "D1110ru.txt:888",
   "file": "D1110ru.txt",
   "line": 888,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アああ……アアアアア！ キサマァァァァァァ！」",
   "ko_candidate": "「아아아……아아아아아! 이 자식아아아아아아!」"
  },
  {
   "id": 25849,
   "key": "D1110ru.txt:899",
   "file": "D1110ru.txt",
   "line": 899,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やはり硬いな……これが限界！」",
   "ko_candidate": "「역시 단단하군……이게 한계다!」"
  },
  {
   "id": 25850,
   "key": "D1110ru.txt:903",
   "file": "D1110ru.txt",
   "line": 903,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アトランティス・ ストライク……ッ！」",
   "ko_candidate": "「아틀란티스 스트라이크!」"
  },
  {
   "id": 25851,
   "key": "D1110ru.txt:915",
   "file": "D1110ru.txt",
   "line": 915,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即座に繰り出されたデモンベインの蹴り。",
   "ko_candidate": "즉시 내질러진 데몬베인의 발차기｡"
  },
  {
   "id": 25852,
   "key": "D1110ru.txt:916",
   "file": "D1110ru.txt",
   "line": 916,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラーケンの脇腹部分に命中し、空間歪曲エネルギーを爆裂させた。",
   "ko_candidate": "크라켄의 옆구리 부분에 명중하여 공간 왜곡 에너지를 폭발시켰다｡"
  },
  {
   "id": 25853,
   "key": "D1110ru.txt:920",
   "file": "D1110ru.txt",
   "line": 920,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間が弾け飛び、超重量の機体が宙を舞った。",
   "ko_candidate": "공간이 튀어 오르고 초중량의 기체가 공중을 날았다｡"
  },
  {
   "id": 25854,
   "key": "D1110ru.txt:925",
   "file": "D1110ru.txt",
   "line": 925,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「グオオおおおオオ――ッッ!?」",
   "ko_candidate": "「구오오오오오오오――읏읏!?」"
  },
  {
   "id": 25855,
   "key": "D1110ru.txt:935",
   "file": "D1110ru.txt",
   "line": 935,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背中から墜落し、大地を轟かせる。",
   "ko_candidate": "등에서 추락하여 대지를 울린다｡"
  },
  {
   "id": 25856,
   "key": "D1110ru.txt:936",
   "file": "D1110ru.txt",
   "line": 936,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "伸び切った腕が跳ねて、地面を何度も抉る。",
   "ko_candidate": "뻗은 팔이 튀어 올라 지면을 여러 번 파낸다｡"
  },
  {
   "id": 25857,
   "key": "D1110ru.txt:941",
   "file": "D1110ru.txt",
   "line": 941,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "倒れたクラーケンを見下ろし、デモンベインは再び偃月刀を正眼に構える。",
   "ko_candidate": "쓰러진 크라켄을 내려다보며 데몬베인은 다시 언월도를 정면으로 겨눈다｡"
  },
  {
   "id": 25858,
   "key": "D1110ru.txt:946",
   "file": "D1110ru.txt",
   "line": 946,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ほう…… 少しはマシになったか？」",
   "ko_candidate": "「호오……조금은 나아졌나?」"
  },
  {
   "id": 25859,
   "key": "D1110ru.txt:951",
   "file": "D1110ru.txt",
   "line": 951,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不敵に笑うアルに、瑠璃もまた滝の様に噴き出る冷や汗で、ずぶ濡れになりながらも、口端を吊り上げて返した。笑みと呼ぶには引き攣ってはいたが。",
   "ko_candidate": "뻔뻔하게 웃는 알에게 루리도 또한 폭포처럼 쏟아지는 식은땀으로 흠뻑 젖으면서도 입꼬리를 올려 대답했다｡ 웃음이라고 하기엔 경련하고 있었지만｡"
  },
  {
   "id": 25860,
   "key": "D1110ru.txt:958",
   "file": "D1110ru.txt",
   "line": 958,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どれだけ長く……デモンベインに、接し続けたと……思います、か？ 本気になれば……こ、このくらい……っ！」",
   "ko_candidate": "「얼마나 오래……데몬베인과 접해……왔다고……생각하시나요? 진심을 내면……이､ 이 정도는……읏!」"
  },
  {
   "id": 25861,
   "key": "D1110ru.txt:963",
   "file": "D1110ru.txt",
   "line": 963,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膝が笑っている。",
   "ko_candidate": "무릎이 떨리고 있다｡"
  },
  {
   "id": 25862,
   "key": "D1110ru.txt:965",
   "file": "D1110ru.txt",
   "line": 965,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、今度は倒れない。",
   "ko_candidate": "하지만 이번엔 쓰러지지 않는다｡"
  },
  {
   "id": 25863,
   "key": "D1110ru.txt:966",
   "file": "D1110ru.txt",
   "line": 966,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の意志で倒れない。",
   "ko_candidate": "강철 같은 의지로 쓰러지지 않는다｡"
  },
  {
   "id": 25864,
   "key": "D1110ru.txt:967",
   "file": "D1110ru.txt",
   "line": 967,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "敵を真っ直ぐに見据える。モニターの向こうでは、 ちょうどクラーケンが起き上がろうとしていた。",
   "ko_candidate": "적을 똑바로 노려본다｡ 모니터 너머로는 마침 크라켄이 일어나려 하고 있었다｡"
  },
  {
   "id": 25865,
   "key": "D1110ru.txt:973",
   "file": "D1110ru.txt",
   "line": 973,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐ……グ……オオ……おお！」",
   "ko_candidate": "「그……그……오오……오오!」"
  },
  {
   "id": 25866,
   "key": "D1110ru.txt:978",
   "file": "D1110ru.txt",
   "line": 978,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「効いておる。一気に畳みかけるぞ！」",
   "ko_candidate": "「효과가 있다｡ 일거에 몰아붙이자!」"
  },
  {
   "id": 25867,
   "key": "D1110ru.txt:983",
   "file": "D1110ru.txt",
   "line": 983,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はぁっ、はぁっ…… ええっ！　やあああああ！」",
   "ko_candidate": "「하앗､ 하앗……에엣! 야아아아아아!」"
  },
  {
   "id": 25868,
   "key": "D1110ru.txt:991",
   "file": "D1110ru.txt",
   "line": 991,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの足許が爆発し、弾丸の様に駆け出す。",
   "ko_candidate": "데몬베인의 발밑이 폭발하고 총알처럼 달려나간다｡"
  },
  {
   "id": 25869,
   "key": "D1110ru.txt:992",
   "file": "D1110ru.txt",
   "line": 992,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渾身の力を込めて、斬撃を繰り出す。",
   "ko_candidate": "혼신의 힘을 담아 참격을 날린다｡"
  },
  {
   "id": 25870,
   "key": "D1110ru.txt:993",
   "file": "D1110ru.txt",
   "line": 993,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀が風を裂いて、唸る。",
   "ko_candidate": "바르자이의 언월도가 바람을 가르며 윙윙거린다｡"
  },
  {
   "id": 25871,
   "key": "D1110ru.txt:994",
   "file": "D1110ru.txt",
   "line": 994,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇を裂いて、閃が奔る。",
   "ko_candidate": "어둠을 가르고 섬광이 달린다｡"
  },
  {
   "id": 25872,
   "key": "D1110ru.txt:998",
   "file": "D1110ru.txt",
   "line": 998,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はぁぁぁぁぁぁ――――ッ！」",
   "ko_candidate": "「하아아아아아아――――읏!」"
  },
  {
   "id": 25873,
   "key": "D1110ru.txt:1002",
   "file": "D1110ru.txt",
   "line": 1002,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「が……ギガ……が、ががぁぁ……オアアアアアアァァァァァァ！」",
   "ko_candidate": "「가……기가……가､ 가가아아……오아아아아아아아아아아아아!」"
  }
 ]
