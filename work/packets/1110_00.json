 },
 "items": [
  {
   "id": 25554,
   "key": "D1110le.txt:8",
   "file": "D1110le.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "８割方の破壊ロボを片付けた頃だった。",
   "ko_candidate": "파괴 로봇을 8할 정도 처리했을 무렵이었다｡"
  },
  {
   "id": 25555,
   "key": "D1110le.txt:9",
   "file": "D1110le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地を揺さぶる、連続した地響き。",
   "ko_candidate": "대지를 뒤흔드는 연속된 지진｡"
  },
  {
   "id": 25556,
   "key": "D1110le.txt:11",
   "file": "D1110le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地下に大量の水が流れているような、巨大な長い龍がのたうっているような、そんな重い振動。",
   "ko_candidate": "지하에 대량의 물이 흐르는 듯한､ 거대한 긴 용이 몸부림치는 듯한､ 그런 무거운 진동｡"
  },
  {
   "id": 25557,
   "key": "D1110le.txt:12",
   "file": "D1110le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……強大な魔力を感じる。この気配には憶えがある！",
   "ko_candidate": "……강대한 마력을 느낀다｡ 이 기척은 기억이 난다!"
  },
  {
   "id": 25558,
   "key": "D1110le.txt:18",
   "file": "D1110le.txt",
   "line": 18,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何が起こっているロボ か!?」",
   "ko_candidate": "「무､ 무슨 일이 일어나고 있는 로봇!?」"
  },
  {
   "id": 25559,
   "key": "D1110le.txt:23",
   "file": "D1110le.txt",
   "line": 23,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさん！　来るぞ！」",
   "ko_candidate": "「라이카 씨! 온다!」"
  },
  {
   "id": 25560,
   "key": "D1110le.txt:31",
   "file": "D1110le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地面を突き破り、巨大な水柱が噴出する。",
   "ko_candidate": "지면을 뚫고 거대한 물기둥이 솟아오른다｡"
  },
  {
   "id": 25561,
   "key": "D1110le.txt:32",
   "file": "D1110le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "高層ビルの背丈も越えるほどの水柱。",
   "ko_candidate": "고층 빌딩의 높이를 넘어서는 물기둥｡"
  },
  {
   "id": 25562,
   "key": "D1110le.txt:33",
   "file": "D1110le.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかも１つじゃない。２つ３つ４つ５つ６つ……",
   "ko_candidate": "게다가 하나가 아니다｡ 둘 셋 넷 다섯 여섯……"
  },
  {
   "id": 25563,
   "key": "D1110le.txt:34",
   "file": "D1110le.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水柱に囲まれた大地に、魔法円が描かれる。",
   "ko_candidate": "물기둥에 둘러싸인 대지에 마법진이 그려진다｡"
  },
  {
   "id": 25564,
   "key": "D1110le.txt:36",
   "file": "D1110le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ちっ……早速、お出ましか！",
   "ko_candidate": "치……벌써 등장하는 건가!"
  },
  {
   "id": 25565,
   "key": "D1110le.txt:37",
   "file": "D1110le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水柱ってんだから、間違いない。奴だ！",
   "ko_candidate": "물기둥이라니､ 틀림없다｡ 그 녀석이다!"
  },
  {
   "id": 25566,
   "key": "D1110le.txt:40",
   "file": "D1110le.txt",
   "line": 40,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アンチクロスのカリグラ……クラーケンか！」",
   "ko_candidate": "「안티 크로스의 칼리굴라……크라켄인가!」"
  },
  {
   "id": 25567,
   "key": "D1110le.txt:45",
   "file": "D1110le.txt",
   "line": 45,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……デウス・マキナ！」",
   "ko_candidate": "「……데우스 마키나!」"
  },
  {
   "id": 25568,
   "key": "D1110le.txt:54",
   "file": "D1110le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンと九郎の戦いをモニタしていた司令室も、異変に気付いていた。",
   "ko_candidate": "메타트론과 쿠로의 전투를 모니터하고 있던 사령실도 이변을 눈치챘다｡"
  },
  {
   "id": 25569,
   "key": "D1110le.txt:56",
   "file": "D1110le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マコトの感情の少ない、淡々とした声が、そうであって欲しくない結果を冷酷に告げる。",
   "ko_candidate": "마코토의 감정 없는 담담한 목소리가 그러길 바라지 않는 결과를 냉혹하게 알린다｡"
  },
  {
   "id": 25570,
   "key": "D1110le.txt:66",
   "file": "D1110le.txt",
   "line": 66,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――高密度の字祷子圧縮活動を確認。規模はデモンベイン・クラス。 間違いありません。『招喚』です」",
   "ko_candidate": "「――고밀도의 인과율자 압축 활동을 확인｡ 규모는 데몬베인 클래스｡ 틀림없습니다｡ 『소환』입니다」"
  },
  {
   "id": 25571,
   "key": "D1110le.txt:72",
   "file": "D1110le.txt",
   "line": 72,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……デモンベインを失った状態で、鬼械神と対峙する事になるとは」",
   "ko_candidate": "「……데몬베인을 잃은 상태에서 귀계신과 대치하게 되다니」"
  },
  {
   "id": 25572,
   "key": "D1110le.txt:77",
   "file": "D1110le.txt",
   "line": 77,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あんな破壊ロボじゃ、話にならへん！」",
   "ko_candidate": "「저런 파괴 로봇으로는 이야기가 안 돼!」"
  },
  {
   "id": 25573,
   "key": "D1110le.txt:82",
   "file": "D1110le.txt",
   "line": 82,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マ、顕現化しますぅ！」",
   "ko_candidate": "「마､ 현현화합니다!」"
  },
  {
   "id": 25574,
   "key": "D1110le.txt:85",
   "file": "D1110le.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "モニタの向こう、天に噴き出る水柱が、捻じ曲がり、互いに交じり合って、１本の巨大な渦となる。",
   "ko_candidate": "모니터 너머､ 하늘로 솟구치는 물기둥이 뒤틀리고 서로 뒤섞여 하나의 거대한 소용돌이가 된다｡"
  },
  {
   "id": 25575,
   "key": "D1110le.txt:89",
   "file": "D1110le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆砕する。",
   "ko_candidate": "폭발한다｡"
  },
  {
   "id": 25576,
   "key": "D1110le.txt:90",
   "file": "D1110le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "スコールの如く降り注ぐ雨が、燃え盛る街を消火していく。",
   "ko_candidate": "스콜처럼 쏟아지는 비가 불타오르는 거리를 소화해 나간다｡"
  },
  {
   "id": 25577,
   "key": "D1110le.txt:92",
   "file": "D1110le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆砕の中心に、その巨体は実像を結んでいた。",
   "ko_candidate": "폭발의 중심에 그 거대한 몸체가 실체를 드러냈다｡"
  },
  {
   "id": 25578,
   "key": "D1110le.txt:97",
   "file": "D1110le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――鬼械神クラーケン。",
   "ko_candidate": "――귀계신 크라켄｡"
  },
  {
   "id": 25579,
   "key": "D1110le.txt:98",
   "file": "D1110le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最凶最悪の魔導ロボの一。",
   "ko_candidate": "최강최악의 마도 로봇 중 하나｡"
  },
  {
   "id": 25580,
   "key": "D1110le.txt:103",
   "file": "D1110le.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃が通信機のマイクを手に取る。",
   "ko_candidate": "루리가 통신기의 마이크를 손에 든다｡"
  },
  {
   "id": 25581,
   "key": "D1110le.txt:104",
   "file": "D1110le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この状況を、あの２人に押しつけるのは、あまりにも酷だ。",
   "ko_candidate": "이 상황을 저 둘에게 떠맡기는 건 너무나도 가혹하다｡"
  },
  {
   "id": 25582,
   "key": "D1110le.txt:106",
   "file": "D1110le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦うべきは彼らだけじゃない。",
   "ko_candidate": "싸워야 할 건 그들뿐만이 아니다｡"
  },
  {
   "id": 25583,
   "key": "D1110le.txt:107",
   "file": "D1110le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分もなのだ。任せっきりにはしておけない。",
   "ko_candidate": "자신도 그렇다｡ 맡겨만 둘 수는 없다｡"
  },
  {
   "id": 25584,
   "key": "D1110le.txt:111",
   "file": "D1110le.txt",
   "line": 111,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん、聴いておりますか？ メタトロンと一緒に撤退して下さい。 これ以上は無理です」",
   "ko_candidate": "「다이쥬지 씨､ 듣고 계십니까? 메타트론과 함께 철수해 주세요｡ 이 이상은 무리입니다」"
  },
  {
   "id": 25585,
   "key": "D1110le.txt:121",
   "file": "D1110le.txt",
   "line": 121,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……って、言ってるけど」",
   "ko_candidate": "「……라고 말하고 있지만」"
  },
  {
   "id": 25586,
   "key": "D1110le.txt:126",
   "file": "D1110le.txt",
   "line": 126,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうロボ！　これ以上は無理ロボ！　撤退するロボ！」",
   "ko_candidate": "「그렇다 로봇! 이 이상은 무리 로봇! 철수한다 로봇!」"
  },
  {
   "id": 25587,
   "key": "D1110le.txt:130",
   "file": "D1110le.txt",
   "line": 130,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうする、ライカさん？」",
   "ko_candidate": "「어떡할까요､ 라이카 씨?」"
  },
  {
   "id": 25588,
   "key": "D1110le.txt:135",
   "file": "D1110le.txt",
   "line": 135,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 25589,
   "key": "D1110le.txt:145",
   "file": "D1110le.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんは答えない。",
   "ko_candidate": "라이카 씨는 대답하지 않는다｡"
  },
  {
   "id": 25590,
   "key": "D1110le.txt:146",
   "file": "D1110le.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、黙ってビーム砲をクラーケンへと向ける。",
   "ko_candidate": "그저 묵묵히 빔포를 크라켄을 향해 겨눈다｡"
  },
  {
   "id": 25591,
   "key": "D1110le.txt:150",
   "file": "D1110le.txt",
   "line": 150,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やっぱりな。姫さん、こちら大十字。撤退は無しだ。 ここで奴を何とかする」",
   "ko_candidate": "「역시 그렇군｡ 공주님､ 여기는 다이쥬지입니다｡ 철수는 없습니다｡ 여기서 녀석을 어떻게든 해결하겠습니다」"
  },
  {
   "id": 25592,
   "key": "D1110le.txt:156",
   "file": "D1110le.txt",
   "line": 156,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボォォォォォォォ――――!?」",
   "ko_candidate": "「로봇오오오오오오오――――!?」"
  },
  {
   "id": 25593,
   "key": "D1110le.txt:159",
   "file": "D1110le.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "当然と言えば当然だが、通信機の向こうからも、姫さんの焦った声が聴こえてきた。",
   "ko_candidate": "당연하다면 당연하지만､ 통신기 너머에서도 공주님의 초조한 목소리가 들려왔다｡"
  }
 ]
}