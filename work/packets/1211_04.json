 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ドクター・ウェスト": "닥터 웨스트",
  "大十字九郎": "다이쥬지 쿠로",
  "クラウディウス": "클라우디우스"
 },
 "items": [
  {
   "id": 29738,
   "key": "D1211ru.txt:184",
   "file": "D1211ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心拍数が跳ね上がり、咽喉や舌はからからに渇き、手足は痺れている。",
   "ko_candidate": "심박수가 치솟고､ 목구멍과 혀는 바싹 말라､ 손발은 저리다｡"
  },
  {
   "id": 29739,
   "key": "D1211ru.txt:186",
   "file": "D1211ru.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "山羊ヅラの男は、一歩一歩、こっちに近づいてくる。",
   "ko_candidate": "염소 얼굴의 남자는､ 한 걸음 한 걸음､ 이쪽으로 다가온다｡"
  },
  {
   "id": 29740,
   "key": "D1211ru.txt:190",
   "file": "D1211ru.txt",
   "line": 190,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「んがい……んぐあぐああ……ぶぐ、しょごぐ、いはあ……よほぐそほとほとお……よほぐそほとほとお……」",
   "ko_candidate": "「응가이… 응구아구아아… 부구､ 쇼고구､ 이하아… 요호구소호토토오… 요호구소호토토오…」"
  },
  {
   "id": 29741,
   "key": "D1211ru.txt:193",
   "file": "D1211ru.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その呟きは、地球上の如何なる言語にも当てはまらないと、断言できる。",
   "ko_candidate": "그 중얼거림은､ 지구상의 어떤 언어에도 해당하지 않는다고､ 단언할 수 있다｡"
  },
  {
   "id": 29742,
   "key": "D1211ru.txt:195",
   "file": "D1211ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは間違いなく、人間の言葉ではなかった。",
   "ko_candidate": "그것은 틀림없이､ 인간의 말이 아니었다｡"
  },
  {
   "id": 29743,
   "key": "D1211ru.txt:196",
   "file": "D1211ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聴いてはいけない、言語だった。",
   "ko_candidate": "들어서는 안 되는､ 언어였다｡"
  },
  {
   "id": 29744,
   "key": "D1211ru.txt:199",
   "file": "D1211ru.txt",
   "line": 199,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あああ……ああああ……ああああ……！」",
   "ko_candidate": "「아아아… 아아아아… 아아아아…!」"
  },
  {
   "id": 29745,
   "key": "D1211ru.txt:202",
   "file": "D1211ru.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "山羊ヅラの、ひょろ長い躰が、蠢いた。",
   "ko_candidate": "염소 얼굴의､ 홀쭉하고 길쭉한 몸이､ 꿈틀거렸다｡"
  },
  {
   "id": 29746,
   "key": "D1211ru.txt:203",
   "file": "D1211ru.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脈動している。",
   "ko_candidate": "맥동하고 있다｡"
  },
  {
   "id": 29747,
   "key": "D1211ru.txt:204",
   "file": "D1211ru.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身が大きく波打っている。",
   "ko_candidate": "온몸이 크게 물결치고 있다｡"
  },
  {
   "id": 29748,
   "key": "D1211ru.txt:206",
   "file": "D1211ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何で……何で、こんなものが、こんな存在が、現実にいるんだ？",
   "ko_candidate": "왜… 왜､ 이런 것이､ 이런 존재가､ 현실에 있는 거지?"
  },
  {
   "id": 29749,
   "key": "D1211ru.txt:207",
   "file": "D1211ru.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな怪異が……人の世界を侵す、理不尽が――！",
   "ko_candidate": "이런 괴이가… 인간 세상을 침범하는､ 이치에 맞지 않는 것이――!"
  },
  {
   "id": 29750,
   "key": "D1211ru.txt:211",
   "file": "D1211ru.txt",
   "line": 211,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「よおおうぐそほほほとおおおおほおおとおおおおおあふふふ！ よぉぉぉぉぐそぉぉぉおおおとほほほおおとととすうぅぅ！」",
   "ko_candidate": "「요오오오오우구소호호호호호토오오오오호오오토오오오오아후후후! 요오오오오구소오오오오오오오오오토호호호오오오오토토토수우우우!」"
  },
  {
   "id": 29751,
   "key": "D1211ru.txt:218",
   "file": "D1211ru.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "男の服が千切れ飛んだ。",
   "ko_candidate": "남자의 옷이 찢어져 날아갔다｡"
  },
  {
   "id": 29752,
   "key": "D1211ru.txt:219",
   "file": "D1211ru.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒトの容を破って、ヒトの器から溢れて、異形が、怪異が膨張する！",
   "ko_candidate": "사람의 모습을 깨고､ 사람의 그릇에서 넘쳐나､ 기형이､ 괴이가 팽창한다!"
  },
  {
   "id": 29753,
   "key": "D1211ru.txt:220",
   "file": "D1211ru.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その姿は――！",
   "ko_candidate": "그 모습은――!"
  },
  {
   "id": 29754,
   "key": "D1211ru.txt:227",
   "file": "D1211ru.txt",
   "line": 227,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわあああああああああああああああああああああああああ！」",
   "ko_candidate": "「우와아아아아아아아아아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 29755,
   "key": "D1211ru.txt:232",
   "file": "D1211ru.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――何処かで、ウィップアーウィルが甲高い嬌声を上げた。",
   "ko_candidate": "――어디선가､ 휘프어윌이 날카로운 교성을 질렀다｡"
  },
  {
   "id": 29756,
   "key": "D1211ru.txt:245",
   "file": "D1211ru.txt",
   "line": 245,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬおおおおお……だ、誰か……誰か、助け……たす……もはや、ここまでか……総員退艦……我輩は艦と運命を共にする……」",
   "ko_candidate": "「누오오오오… 누､ 누군가… 누군가､ 도와… 도와… 이제､ 여기까지인가… 전원 퇴함… 나는 함선과 운명을 함께할 것이다…」"
  },
  {
   "id": 29757,
   "key": "D1211ru.txt:248",
   "file": "D1211ru.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ドクター・ウェストはバイクの下敷きになったまま、未だ身動きを取れないでいた。",
   "ko_candidate": "닥터 웨스트는 할리의 밑에 깔린 채､ 아직도 몸을 움직일 수"
  },
  {
   "id": 29758,
   "key": "D1211ru.txt:252",
   "file": "D1211ru.txt",
   "line": 252,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「んん？」",
   "ko_candidate": "없었다｡ 「음?」"
  },
  {
   "id": 29759,
   "key": "D1211ru.txt:255",
   "file": "D1211ru.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが故に、異変に気付く事が出来た。",
   "ko_candidate": "그래서､ 이변을 알아차릴 수 있었다｡"
  },
  {
   "id": 29760,
   "key": "D1211ru.txt:256",
   "file": "D1211ru.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎が眠る集中治療室。",
   "ko_candidate": "다이쥬지 쿠로가 잠든 집중치료실｡"
  },
  {
   "id": 29761,
   "key": "D1211ru.txt:257",
   "file": "D1211ru.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そちらの方から、何やら気配が感じられたのだ。",
   "ko_candidate": "그쪽에서､ 무언가 기운이 느껴졌다｡"
  },
  {
   "id": 29762,
   "key": "D1211ru.txt:259",
   "file": "D1211ru.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなはずはない。",
   "ko_candidate": "그럴 리가 없다｡"
  },
  {
   "id": 29763,
   "key": "D1211ru.txt:260",
   "file": "D1211ru.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "集中治療室には、医務室を通ってからでしか行く事が出来ない。",
   "ko_candidate": "집중치료실은､ 의무실을 통해서만 갈 수 있다｡"
  },
  {
   "id": 29764,
   "key": "D1211ru.txt:261",
   "file": "D1211ru.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスとの交戦後、この部屋には誰もいないはずだ。",
   "ko_candidate": "클라우디우스와의 교전 후､ 이 방에는 아무도 없어야 한다｡"
  },
  {
   "id": 29765,
   "key": "D1211ru.txt:263",
   "file": "D1211ru.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気のせいか。",
   "ko_candidate": "기분 탓일까｡"
  },
  {
   "id": 29766,
   "key": "D1211ru.txt:264",
   "file": "D1211ru.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう考えるべきだろう。",
   "ko_candidate": "그렇게 생각해야 할 것이다｡"
  },
  {
   "id": 29767,
   "key": "D1211ru.txt:265",
   "file": "D1211ru.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人影を見た訳ではなく、音を聴いた訳でもない。",
   "ko_candidate": "인영을 본 것도 아니고､ 소리를 들은 것도 아니다｡"
  },
  {
   "id": 29768,
   "key": "D1211ru.txt:267",
   "file": "D1211ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが何故か、確信を持って、何かが居ると感じることが出来る。",
   "ko_candidate": "하지만 왜인지､ 확신을 가지고､ 무언가가 있다고 느낄 수 있다｡"
  },
  {
   "id": 29769,
   "key": "D1211ru.txt:268",
   "file": "D1211ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それ程に濃厚な、それは存在感の強さだった。",
   "ko_candidate": "그만큼 농후한､ 그것은 존재감의 강함이었다｡"
  },
  {
   "id": 29770,
   "key": "D1211ru.txt:272",
   "file": "D1211ru.txt",
   "line": 272,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何がいったい……」",
   "ko_candidate": "「대체 무엇이…」"
  },
  {
   "id": 29771,
   "key": "D1211ru.txt:275",
   "file": "D1211ru.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バイクを押し退けて、何とか集中治療室を覗き込もうとする。",
   "ko_candidate": "할리를 밀어내고､ 어떻게든 집중치료실을 들여다보려 한다｡"
  },
  {
   "id": 29772,
   "key": "D1211ru.txt:276",
   "file": "D1211ru.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その時だった。",
   "ko_candidate": "그때였다｡"
  },
  {
   "id": 29773,
   "key": "D1211ru.txt:286",
   "file": "D1211ru.txt",
   "line": 286,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわああああああああああああああああああああああああああ！」",
   "ko_candidate": "「우와아아아아아아아아아아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 29774,
   "key": "D1211ru.txt:289",
   "file": "D1211ru.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "木霊する絶叫。",
   "ko_candidate": "메아리치는 절규｡"
  },
  {
   "id": 29775,
   "key": "D1211ru.txt:290",
   "file": "D1211ru.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膨れ上がる、強大な気配。",
   "ko_candidate": "부풀어 오르는､ 강대한 기운｡"
  },
  {
   "id": 29776,
   "key": "D1211ru.txt:294",
   "file": "D1211ru.txt",
   "line": 294,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――大十字九郎!?」",
   "ko_candidate": "「――다이쥬지 쿠로!?」"
  },
  {
   "id": 29777,
   "key": "D1211ru.txt:299",
   "file": "D1211ru.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何処からか、夜鷹の啼き声が聴こえて来る――そんな気がした。",
   "ko_candidate": "어디선가､ 올빼미의 울음소리가 들려오는 것 같았다――그런 기분이 들었다｡ 그럴 리가 없는데도｡"
  }
 ]
}