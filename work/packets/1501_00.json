 },
 "items": [
  {
   "id": 40748,
   "key": "D1501al.txt:29",
   "file": "D1501al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白いつぼみが咲かす、紅い華。",
   "ko_candidate": "하얀 살의 꽃봉오리가 붉은 꽃을 피워내고､"
  },
  {
   "id": 40749,
   "key": "D1501al.txt:30",
   "file": "D1501al.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅い華が実らす、金の果実。",
   "ko_candidate": "붉은 꽃이 황금빛 열매를 맺어내고､"
  },
  {
   "id": 40750,
   "key": "D1501al.txt:31",
   "file": "D1501al.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金の果実が滴らせる、悪徳の果汁。",
   "ko_candidate": "황금빛 열매가 악덕의 과즙을 흘려내고､"
  },
  {
   "id": 40751,
   "key": "D1501al.txt:50",
   "file": "D1501al.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "産まれたのだ。",
   "ko_candidate": "태어났다｡"
  },
  {
   "id": 40752,
   "key": "D1501al.txt:51",
   "file": "D1501al.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "産まれ落ちたのだ。",
   "ko_candidate": "태어나 떨어졌다｡"
  },
  {
   "id": 40753,
   "key": "D1501al.txt:52",
   "file": "D1501al.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膿まれ、堕ちたのだ。",
   "ko_candidate": "태어나 타락했다｡"
  },
  {
   "id": 40754,
   "key": "D1501al.txt:69",
   "file": "D1501al.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソレは邪悪だった。",
   "ko_candidate": "그것은 사악했다｡"
  },
  {
   "id": 40755,
   "key": "D1501al.txt:70",
   "file": "D1501al.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒトの皮を被った異形だった。",
   "ko_candidate": "그것은 인간의 가죽을 뒤집어쓴 괴물이었다｡"
  },
  {
   "id": 40756,
   "key": "D1501al.txt:71",
   "file": "D1501al.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソレは――望まれぬ命だった。",
   "ko_candidate": "그것은 원치 않는 생명이었다｡"
  },
  {
   "id": 40757,
   "key": "D1501al.txt:88",
   "file": "D1501al.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ソレは――『獣』だった。",
   "ko_candidate": "그것은―짐승이었다｡"
  },
  {
   "id": 40758,
   "key": "D1501al.txt:97",
   "file": "D1501al.txt",
   "line": 97,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「～～～～～～ッ！」",
   "ko_candidate": "「으으으으으윽!」"
  },
  {
   "id": 40759,
   "key": "D1501al.txt:112",
   "file": "D1501al.txt",
   "line": 112,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！？」",
   "ko_candidate": "「쿠로!?」"
  },
  {
   "id": 40760,
   "key": "D1501al.txt:118",
   "file": "D1501al.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――思考よりも先に肉体と魂が闘争に順応する。",
   "ko_candidate": "―생각보다 먼저 몸이 전투에 적응한다｡ 순식간에 마기우스 스타일로｡"
  },
  {
   "id": 40761,
   "key": "D1501al.txt:121",
   "file": "D1501al.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マギウス・スタイルが魔力を汲み上げる。招喚した２挺の魔銃は自動的に爆ぜる血溜まりの中心、金色に澱む闇に向けられた。",
   "ko_candidate": "소환한 2정의 마총은 자동으로 터져 나온 핏덩이의 중심､ 황금빛으로 고인 어둠을 향해 겨눠졌다｡"
  },
  {
   "id": 40762,
   "key": "D1501al.txt:138",
   "file": "D1501al.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咆吼と共に引鉄を引く。",
   "ko_candidate": "포효와 함께 방아쇠를 당긴다｡"
  },
  {
   "id": 40763,
   "key": "D1501al.txt:139",
   "file": "D1501al.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声が木霊する。",
   "ko_candidate": "총성이 울려 퍼진다｡"
  },
  {
   "id": 40764,
   "key": "D1501al.txt:150",
   "file": "D1501al.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒト型の闇が仰け反った。",
   "ko_candidate": "인간 형태의 어둠이 뒤로 젖혀졌다｡"
  },
  {
   "id": 40765,
   "key": "D1501al.txt:151",
   "file": "D1501al.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、それだけだった。",
   "ko_candidate": "단지､ 그뿐이었다｡"
  },
  {
   "id": 40766,
   "key": "D1501al.txt:171",
   "file": "D1501al.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術防禦に阻まれ、弾丸はそいつの皮膚に摩擦熱による火傷の点だけを残し、コクピットに転がった。",
   "ko_candidate": "마술 방어에 막혀 총알은 그자의 피부에 마찰열로 인한 화상 자국만을 남기고 콕핏에 굴러떨어졌다｡"
  },
  {
   "id": 40767,
   "key": "D1501al.txt:179",
   "file": "D1501al.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "面を上げたそいつは異形の笑顔もそのままに、澄んだ異形の声色で、静かに言った。",
   "ko_candidate": "고개를 든 그자는 기괴한 미소 그대로､ 맑은 괴물의 목소리로 조용히 말했다｡{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 40768,
   "key": "D1501al.txt:189",
   "file": "D1501al.txt",
   "line": 189,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……はじめまして、だな。 大十字九郎」",
   "ko_candidate": "「……처음 뵙겠군｡ 다이쥬지 쿠로」"
  },
  {
   "id": 40769,
   "key": "D1501al.txt:195",
   "file": "D1501al.txt",
   "line": 195,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マスターテリオン！」",
   "ko_candidate": "「마스터 테리온!」"
  },
  {
   "id": 40770,
   "key": "D1501al.txt:216",
   "file": "D1501al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀を抜き放ち、斬りつける。",
   "ko_candidate": "바르자이의 언월도를 뽑아들고 베어 내린다｡"
  },
  {
   "id": 40771,
   "key": "D1501al.txt:217",
   "file": "D1501al.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剣閃が血臭満ちる大気を裂いて、迅る。",
   "ko_candidate": "검광이 피 냄새 가득한 대기를 가르며 날아간다｡"
  },
  {
   "id": 40772,
   "key": "D1501al.txt:227",
   "file": "D1501al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渾身の斬撃をマスターテリオンは２本の指で挟み、受け止めた。",
   "ko_candidate": "온 힘을 다한 일격을 마스터 테리온은 두 손가락으로 집어 받아냈다｡"
  },
  {
   "id": 40773,
   "key": "D1501al.txt:233",
   "file": "D1501al.txt",
   "line": 233,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「く……っ！」",
   "ko_candidate": "「크……윽!」"
  },
  {
   "id": 40774,
   "key": "D1501al.txt:242",
   "file": "D1501al.txt",
   "line": 242,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……初対面だと云うのに、 随分な挨拶だな」",
   "ko_candidate": "「……첫 대면이라는데 꽤나 무례한 인사로군」"
  },
  {
   "id": 40775,
   "key": "D1501al.txt:248",
   "file": "D1501al.txt",
   "line": 248,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ッッッッ！　いけしゃあしゃあと……！ 生きていやがったのか、てめえ！」",
   "ko_candidate": "「……윽윽윽윽! 뻔뻔하게……! 살아있었던 거냐､ 이 자식!」"
  },
  {
   "id": 40776,
   "key": "D1501al.txt:254",
   "file": "D1501al.txt",
   "line": 254,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふっ……」",
   "ko_candidate": "「훗……」"
  },
  {
   "id": 40777,
   "key": "D1501al.txt:259",
   "file": "D1501al.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃を掴む指を放した。",
   "ko_candidate": "칼날을 잡은 손가락을 놓았다｡"
  },
  {
   "id": 40778,
   "key": "D1501al.txt:260",
   "file": "D1501al.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掌を俺の正面にかざす。",
   "ko_candidate": "손바닥을 내 정면에 들이민다｡"
  },
  {
   "id": 40779,
   "key": "D1501al.txt:277",
   "file": "D1501al.txt",
   "line": 277,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――ッッッ！　ぐぅっッ！」",
   "ko_candidate": "「―윽윽윽! 크윽!」 충격이 나를 덮쳤다｡"
  },
  {
   "id": 40780,
   "key": "D1501al.txt:280",
   "file": "D1501al.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "衝撃が俺を襲った。不可視の力でコクピットから吹き飛ばされ、宙を舞う。",
   "ko_candidate": "보이지 않는 힘에 콕핏에서 밀려나 더 멀리 날아가 공중을 날았다｡ 마기우스 윙을 펼쳐 공중에서 자세를 바로잡았다｡"
  },
  {
   "id": 40781,
   "key": "D1501al.txt:297",
   "file": "D1501al.txt",
   "line": 297,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふざけるなッッッッ！」",
   "ko_candidate": "「장난하지 마아아아!」"
  },
  {
   "id": 40782,
   "key": "D1501al.txt:316",
   "file": "D1501al.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ありったけの魔力を拳に込めて、突き出す。",
   "ko_candidate": "있는 힘껏 마력을 주먹에 담아 내지른다｡ 뿜어져 나온 마력파가 공간에서 폭발했다｡"
  },
  {
   "id": 40783,
   "key": "D1501al.txt:317",
   "file": "D1501al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "字祷子が魔学変化を起こし、空間を爆砕させた。",
   "ko_candidate": "말라비틀어진 네임리스 원의 상반신을 산산조각 냈다｡ 「……훗」"
  },
  {
   "id": 40784,
   "key": "D1501al.txt:320",
   "file": "D1501al.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "枯木と化したネームレス・ワンの上半身を粉々に粉砕する。",
   "ko_candidate": "나는 데몬베인 위에 착지했다｡ 마스터 테리온 또한 남겨진 네임리스 원의 하반신에"
  },
  {
   "id": 40785,
   "key": "D1501al.txt:329",
   "file": "D1501al.txt",
   "line": 329,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……フッ」 俺はデモンベインの上に着地。マスターテリオンもまた残されたネームレス・ワンの下半身に着地した。乱れた髪を指で梳きながら、俺を見上げる。",
   "ko_candidate": "착지했다｡ 흐트러진 머리카락을 손가락으로 쓸어 넘기며 나를 올려다본다｡"
  },
  {
   "id": 40786,
   "key": "D1501al.txt:346",
   "file": "D1501al.txt",
   "line": 346,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「生きていた……というのは正しくない。先程から申している通り貴公と逢うのは、これが初めて」",
   "ko_candidate": "「살아있었다……라는 말은 정확하지 않아｡ 방금 전부터 말하고 있듯이､ 자네와 만나는 건 이번이 처음이야」 「뭐､ 무슨 알 수 없는 소리를 지껄이는 거야!」"
  },
  {
   "id": 40787,
   "key": "D1501al.txt:351",
   "file": "D1501al.txt",
   "line": 351,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何、ワケわかんねえことホザいてやがる！」",
   "ko_candidate": "「쿠로､ 진정해! 저놈의 계략에 말려들고 있어!」"
  }
 ]
}