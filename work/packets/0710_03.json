 "items": [
  {
   "id": 9316,
   "key": "D0710al.txt:894",
   "file": "D0710al.txt",
   "line": 894,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「があああああ！　……痛ぅッ！」",
   "ko_candidate": "「가아아아구웃! ……아파아아앗!」"
  },
  {
   "id": 9317,
   "key": "D0710al.txt:899",
   "file": "D0710al.txt",
   "line": 899,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しっかりしろ！　また来るぞ！」",
   "ko_candidate": "「정신 차려! 또 온다!」"
  },
  {
   "id": 9318,
   "key": "D0710al.txt:914",
   "file": "D0710al.txt",
   "line": 914,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今ので調子に乗ったのか、触手をわななかせ、こっちに突進してくる。渾身の力を込めた触手の一撃が、空気を唸らせて迫る！",
   "ko_candidate": "아까 그걸로 기세가 오른 건지 촉수를 떨며 이쪽으로 돌진해온다｡ 혼신의 힘을 실은 촉수의 일격이 공기를 가르며 다가온다!"
  },
  {
   "id": 9319,
   "key": "D0710al.txt:920",
   "file": "D0710al.txt",
   "line": 920,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……なめるな、タコ助！」",
   "ko_candidate": "「……얕보지 마､ 문어 자식!」"
  },
  {
   "id": 9320,
   "key": "D0710al.txt:925",
   "file": "D0710al.txt",
   "line": 925,
   "speaker": "蛸怪人",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――ッ！？」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 9321,
   "key": "D0710al.txt:935",
   "file": "D0710al.txt",
   "line": 935,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "壁をも打ち砕く一撃を跳んでかわし、振り下ろされた触手の上に着地する。",
   "ko_candidate": "벽마저 부숴버릴 일격을 뛰어 피하고 내리쳐진 촉수 위에 착지했다｡"
  },
  {
   "id": 9322,
   "key": "D0710al.txt:941",
   "file": "D0710al.txt",
   "line": 941,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "相手が反応するよりも早く、触手を足場に疾走、眼前にまで接近する。問答無用でバルザイの偃月刀を突き出した。",
   "ko_candidate": "상대가 반응하기도 전에 촉수를 발판 삼아 질주하여 바로 앞까지 접근한다｡ 묻지도 따지지도 않고 바르자이의 언월도를 찔러 넣었다｡"
  },
  {
   "id": 9323,
   "key": "D0710al.txt:966",
   "file": "D0710al.txt",
   "line": 966,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "絶叫が響き渡る。偃月刀を顔面に突き刺したまま、タコ怪人はもがき苦む。",
   "ko_candidate": "절규가 울려 퍼졌다｡ 언월도를 얼굴에 찔러 넣은 채 문어 괴인은 몸부림친다｡"
  },
  {
   "id": 9324,
   "key": "D0710al.txt:970",
   "file": "D0710al.txt",
   "line": 970,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、これだけじゃ終わらない。",
   "ko_candidate": "하지만 이것만으로는 끝나지 않는다｡"
  },
  {
   "id": 9325,
   "key": "D0710al.txt:971",
   "file": "D0710al.txt",
   "line": 971,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "トドメを――！",
   "ko_candidate": "마지막 일격을――!"
  },
  {
   "id": 9326,
   "key": "D0710al.txt:988",
   "file": "D0710al.txt",
   "line": 988,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はマギウス・ウィングを紙片にして崩し、タコ怪人の周囲に舞わせた。",
   "ko_candidate": "나는 마기우스 윙을 페이지로 바꿔 문어 괴인의 주위에 흩뿌렸다｡"
  },
  {
   "id": 9327,
   "key": "D0710al.txt:994",
   "file": "D0710al.txt",
   "line": 994,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――？　何を？」",
   "ko_candidate": "「――? 뭘 하는 거지?」"
  },
  {
   "id": 9328,
   "key": "D0710al.txt:999",
   "file": "D0710al.txt",
   "line": 999,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「刺身が駄目だから、たこ焼きにしてやんのさ！」",
   "ko_candidate": "「회를 못 치니까 문어구이로 만들어주지!」"
  },
  {
   "id": 9329,
   "key": "D0710al.txt:1013",
   "file": "D0710al.txt",
   "line": 1013,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "偃月刀を引き抜き、タコ怪人から離脱する。",
   "ko_candidate": "언월도를 뽑아내고 문어 괴인에게서 떨어졌다｡"
  },
  {
   "id": 9330,
   "key": "D0710al.txt:1014",
   "file": "D0710al.txt",
   "line": 1014,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それと同時、偃月刀から発せられた炎が、周囲を舞う紙片に引火した。",
   "ko_candidate": "그와 동시에―― 문어 괴인의 주위를 맴도는 페이지에 불이 붙었다｡"
  },
  {
   "id": 9331,
   "key": "D0710al.txt:1017",
   "file": "D0710al.txt",
   "line": 1017,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "火は連鎖的に他の紙片に燃え広がり、最後には巨大な爆炎となってタコ怪人を包み込んだ。",
   "ko_candidate": "불은 연쇄적으로 다른 페이지로 옮겨붙어 마지막에는 거대한 폭염이 되어 문어 괴인을 감싸 버렸다!"
  },
  {
   "id": 9332,
   "key": "D0710al.txt:1022",
   "file": "D0710al.txt",
   "line": 1022,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こいつは……！」",
   "ko_candidate": "「이건……!」"
  },
  {
   "id": 9333,
   "key": "D0710al.txt:1036",
   "file": "D0710al.txt",
   "line": 1036,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "肉の焼ける臭いが鼻を刺激する。",
   "ko_candidate": "고기 타는 냄새가 코를 찔렀다｡ 단말마의 절규가 울려 퍼졌다｡"
  },
  {
   "id": 9334,
   "key": "D0710al.txt:1037",
   "file": "D0710al.txt",
   "line": 1037,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "炎は蛸怪人を焼き尽くし、黒炭に変えた。",
   "ko_candidate": "불길이 문어 괴인을 태워 숯덩이로 만들어버렸다｡"
  },
  {
   "id": 9335,
   "key": "D0710al.txt:1038",
   "file": "D0710al.txt",
   "line": 1038,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒い塊だけが、その場に横たわる。",
   "ko_candidate": "검은 덩어리만이 그 자리에 쓰러져 있다｡"
  },
  {
   "id": 9336,
   "key": "D0710al.txt:1048",
   "file": "D0710al.txt",
   "line": 1048,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……汝も、随分と戦い慣れしてきたな」",
   "ko_candidate": "「……그대도 꽤나 전투에 익숙해졌군」"
  },
  {
   "id": 9337,
   "key": "D0710al.txt:1054",
   "file": "D0710al.txt",
   "line": 1054,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「おかげさまで！　残り一匹ッ！」",
   "ko_candidate": "「덕분에요! 남은 한 마리……읏!」"
  },
  {
   "id": 9338,
   "key": "D0710al.txt:1068",
   "file": "D0710al.txt",
   "line": 1068,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "残った片方が、またしても触手を伸ばしてきた。",
   "ko_candidate": "남은 한 마리가 또다시 촉수를 뻗어왔다｡ ――바보 같은 놈!"
  },
  {
   "id": 9339,
   "key": "D0710al.txt:1070",
   "file": "D0710al.txt",
   "line": 1070,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――馬鹿の一つ覚えが！",
   "ko_candidate": "언월도의 검광이 어둠을 가른다｡"
  },
  {
   "id": 9340,
   "key": "D0710al.txt:1085",
   "file": "D0710al.txt",
   "line": 1085,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "偃月刀の剣閃が、闇に迅る。",
   "ko_candidate": "다가오는 촉수를 하나씩 베어 나간다｡"
  },
  {
   "id": 9341,
   "key": "D0710al.txt:1086",
   "file": "D0710al.txt",
   "line": 1086,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "迫り来る触手を、片っ端から斬り落としてゆく。",
   "ko_candidate": "「목! 받아랏!」 촉수 무리 사이를 비집고 본체를 향해 칼을 휘둘렀다!"
  },
  {
   "id": 9342,
   "key": "D0710al.txt:1094",
   "file": "D0710al.txt",
   "line": 1094,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「首！　もらったぁぁぁっ！」",
   "ko_candidate": "「……읏!? 서툴러!」 「에――――?」"
  },
  {
   "id": 9343,
   "key": "D0710al.txt:1118",
   "file": "D0710al.txt",
   "line": 1118,
   "speaker": "ちびアル / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っ！？　拙い！」 「え――――？」",
   "ko_candidate": "아주 작은 틈이었다｡"
  },
  {
   "id": 9344,
   "key": "D0710al.txt:1136",
   "file": "D0710al.txt",
   "line": 1136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "わずかな隙だった。",
   "ko_candidate": "갑자기 시야가 가려졌다｡"
  },
  {
   "id": 9345,
   "key": "D0710al.txt:1137",
   "file": "D0710al.txt",
   "line": 1137,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いきなり視界が奪われた。 咄嗟のことで反応が出来ない。",
   "ko_candidate": "순간적인 일이라 반응할 수 없었다｡ 언월도가 허공을 헛되이 베어 나갔다｡"
  },
  {
   "id": 9346,
   "key": "D0710al.txt:1141",
   "file": "D0710al.txt",
   "line": 1141,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "偃月刀が虚しく空を斬る。",
   "ko_candidate": "「커흡! 커흡! 이런……」 방심했다｡"
  },
  {
   "id": 9347,
   "key": "D0710al.txt:1147",
   "file": "D0710al.txt",
   "line": 1147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "油断していた。俺が刀を振り被った瞬間、タコ野郎は口から煙を吐き出しやがった。",
   "ko_candidate": "내가 칼을 휘두르는 순간 문어 자식이 입에서 연기를 뿜어댔다｡"
  },
  {
   "id": 9348,
   "key": "D0710al.txt:1158",
   "file": "D0710al.txt",
   "line": 1158,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ケフッ！　けふっ！　しまっ……」",
   "ko_candidate": "분홍색 연기에 시야가 가려진다｡ 숨 막힐 듯한 달콤한 냄새｡"
  },
  {
   "id": 9349,
   "key": "D0710al.txt:1169",
   "file": "D0710al.txt",
   "line": 1169,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "桃色の煙に閉ざされる視界。むせ返るような甘い匂い。神殿中に満ちている匂いを何十倍にも濃密にしたものだった。",
   "ko_candidate": "신전 안에 가득한 냄새를 수십 배로 농축한 냄새였다｡"
  },
  {
   "id": 9350,
   "key": "D0710al.txt:1175",
   "file": "D0710al.txt",
   "line": 1175,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くっ……うう……っ」",
   "ko_candidate": "「큿…… 우우……읏」"
  },
  {
   "id": 9351,
   "key": "D0710al.txt:1185",
   "file": "D0710al.txt",
   "line": 1185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "平衡感覚が失われた。",
   "ko_candidate": "평형감각을 잃었다｡"
  },
  {
   "id": 9352,
   "key": "D0710al.txt:1186",
   "file": "D0710al.txt",
   "line": 1186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "足がもつれ、不様にその場に転倒した。",
   "ko_candidate": "발이 꼬여 보기 흉하게 그 자리에 넘어졌다｡"
  },
  {
   "id": 9353,
   "key": "D0710al.txt:1200",
   "file": "D0710al.txt",
   "line": 1200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "すかさず触手の群れが覆い被さる――！",
   "ko_candidate": "틈을 놓치지 않고 내 몸 위로 촉수 무리가 덮쳐온다――!"
  },
  {
   "id": 9354,
   "key": "D0710al.txt:1205",
   "file": "D0710al.txt",
   "line": 1205,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎……っ！」",
   "ko_candidate": "「쿠로……읏!」"
  },
  {
   "id": 9355,
   "key": "D0710al.txt:1210",
   "file": "D0710al.txt",
   "line": 1210,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くっ……ざけるなァァァァァ！」",
   "ko_candidate": "「큿…… 장난치지 마아아아아!」"
  }
 ]
}