 "items": [
  {
   "id": 5825,
   "key": "D0414.txt:617",
   "file": "D0414.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少しだけ間を置いて、メタトロンは続けた。",
   "ko_candidate": "잠시 간격을 두고 메타트론이 계속했다｡"
  },
  {
   "id": 5826,
   "key": "D0414.txt:618",
   "file": "D0414.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "わずかにうつむき、顔を背ける。",
   "ko_candidate": "약간 고개를 숙이고 얼굴을 돌린다｡"
  },
  {
   "id": 5827,
   "key": "D0414.txt:627",
   "file": "D0414.txt",
   "line": 627,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「それでも私は、君達が戦う事を善しとはしない」",
   "ko_candidate": "「그래도 나는､ 당신들이 싸우는 것을 좋게 여기지 않습니다」"
  },
  {
   "id": 5828,
   "key": "D0414.txt:633",
   "file": "D0414.txt",
   "line": 633,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 5829,
   "key": "D0414.txt:639",
   "file": "D0414.txt",
   "line": 639,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……また、それか」",
   "ko_candidate": "「……또 그 얘기냐」"
  },
  {
   "id": 5830,
   "key": "D0414.txt:647",
   "file": "D0414.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……それはただ単に、俺が危険な存在だから――と言うだけではないはずだ。",
   "ko_candidate": "전에도 생각했지만… 그건 단순히 우리가 위험한 존재라서――라고 하는 것만은 아닐 거다｡"
  },
  {
   "id": 5831,
   "key": "D0414.txt:650",
   "file": "D0414.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こんなに傷ついてまでアリスンを助けようとしたその姿が、必死に訴えかけたその言葉が、それを俺に教えてくれた。",
   "ko_candidate": "이렇게 상처를 입으면서까지 앨리슨을 구하려 했던 그 모습에､ 필사적으로 호소하는 그 말에､ 나는 알았다｡"
  },
  {
   "id": 5832,
   "key": "D0414.txt:657",
   "file": "D0414.txt",
   "line": 657,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「汝が何と言おうが関係ない。 我等は――」",
   "ko_candidate": "「네가 뭐라고 하든 상관없다｡ 우리는――」"
  },
  {
   "id": 5833,
   "key": "D0414.txt:664",
   "file": "D0414.txt",
   "line": 664,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アル」",
   "ko_candidate": "「알」"
  },
  {
   "id": 5834,
   "key": "D0414.txt:669",
   "file": "D0414.txt",
   "line": 669,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………っ」",
   "ko_candidate": "「…………읏」"
  },
  {
   "id": 5835,
   "key": "D0414.txt:674",
   "file": "D0414.txt",
   "line": 674,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「熱くなるなって」",
   "ko_candidate": "「흥분하지 마」"
  },
  {
   "id": 5836,
   "key": "D0414.txt:680",
   "file": "D0414.txt",
   "line": 680,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふん……っ」",
   "ko_candidate": "「흥… 읏」"
  },
  {
   "id": 5837,
   "key": "D0414.txt:694",
   "file": "D0414.txt",
   "line": 694,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "不貞腐れて、アルは俺の肩から飛び降りる。",
   "ko_candidate": "뾰로통해진 알은 내 어깨에서 뛰어내렸다｡"
  },
  {
   "id": 5838,
   "key": "D0414.txt:695",
   "file": "D0414.txt",
   "line": 695,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの姿が元に戻り、マギウス・スタイルは解呪される。",
   "ko_candidate": "순간､ 알의 모습이 원래대로 돌아오고 마기우스 스타일은 해제된다｡"
  },
  {
   "id": 5839,
   "key": "D0414.txt:699",
   "file": "D0414.txt",
   "line": 699,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はメタトロンから目を背けず、言った。",
   "ko_candidate": "나는 메타트론에게서 눈을 돌리지 않고 말했다｡"
  },
  {
   "id": 5840,
   "key": "D0414.txt:704",
   "file": "D0414.txt",
   "line": 704,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「前にも言ったとおり退く気はなくてね。それに……あんた一人にばかり、背負わせていられない」",
   "ko_candidate": "「전에도 말했듯이 물러설 생각은 없어｡ 게다가… 너 혼자만 짊어지게 할 수는 없잖아」"
  },
  {
   "id": 5841,
   "key": "D0414.txt:709",
   "file": "D0414.txt",
   "line": 709,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そうか――」",
   "ko_candidate": "「그렇군――」"
  },
  {
   "id": 5842,
   "key": "D0414.txt:729",
   "file": "D0414.txt",
   "line": 729,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「君が一緒なら大丈夫だろう。 その娘のことを頼む」",
   "ko_candidate": "메타트론은 고개를 숙인 채였다｡ 등의 양날개가 펼쳐지고 빛을 발한다｡"
  },
  {
   "id": 5843,
   "key": "D0414.txt:736",
   "file": "D0414.txt",
   "line": 736,
   "speaker": "九郎 / メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――メタトロン」 「何だ？」",
   "ko_candidate": "메타트론의 몸이 공중에 떠올랐다｡"
  },
  {
   "id": 5844,
   "key": "D0414.txt:746",
   "file": "D0414.txt",
   "line": 746,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そういうあんたは何のために戦ってるんだ？ あんたに似たあの黒いのは何なんだ？」",
   "ko_candidate": "「네가 함께라면 괜찮을 거야｡ 그 아이를 부탁해」 「――메타트론」"
  },
  {
   "id": 5845,
   "key": "D0414.txt:752",
   "file": "D0414.txt",
   "line": 752,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――――」 わずかな逡巡。",
   "ko_candidate": "날아가려는 메타트론을 나는 불러 세웠다｡"
  },
  {
   "id": 5846,
   "key": "D0414.txt:759",
   "file": "D0414.txt",
   "line": 759,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だがメタトロンは、俺の問いに答えてくれた。",
   "ko_candidate": "천사의 눈동자가 나를 내려다본다｡ 「뭐지?」"
  },
  {
   "id": 5847,
   "key": "D0414.txt:767",
   "file": "D0414.txt",
   "line": 767,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『ブラックロッジ』に対する怨恨ゆえだ。私は皆が言うような正義の味方では、断じてない」",
   "ko_candidate": "「그런 너는 무엇을 위해 싸우고 있는 거야? 너와 닮은 그 검은 것은 뭐지?」 「――――――」"
  },
  {
   "id": 5848,
   "key": "D0414.txt:773",
   "file": "D0414.txt",
   "line": 773,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは嘘だ。",
   "ko_candidate": "잠깐의 망설임｡"
  },
  {
   "id": 5850,
   "key": "D0414.txt:776",
   "file": "D0414.txt",
   "line": 776,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "本当にただ怨恨のためだけなら……ああまでして、アリスンを助けようとはしない。",
   "ko_candidate": "「『블랙로지』에 대한 원한 때문이다｡ 나는 모두가 말하는 정의의 편이 결코 아니야」 그건 거짓말이다｡"
  },
  {
   "id": 5851,
   "key": "D0414.txt:785",
   "file": "D0414.txt",
   "line": 785,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そして奴はサンダルフォン―― 私と同タイプの戦士。人の心を棄て、力に溺れた堕天使。『ブラックロッジ』のエージェントだ」",
   "ko_candidate": "정말로 단지 원한 때문이라면… 그렇게까지 해서 앨리슨을 구하려 하지 않았을 거다｡ 「그리고 그자는 산달폰――나와 같은 타입의 전사｡ 인간의 마음을 버리고 힘에 빠진 타락천사｡ 『블랙로지』의 요원이야」"
  },
  {
   "id": 5852,
   "key": "D0414.txt:792",
   "file": "D0414.txt",
   "line": 792,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『ブラックロッジ』の……！」",
   "ko_candidate": "「『블랙로지』의…!」"
  },
  {
   "id": 5853,
   "key": "D0414.txt:803",
   "file": "D0414.txt",
   "line": 803,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "双翼より爆音が轟いた。",
   "ko_candidate": "양날개에서 폭음이 울렸다｡"
  },
  {
   "id": 5854,
   "key": "D0414.txt:804",
   "file": "D0414.txt",
   "line": 804,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "噴き出す光が、さらに眩く烈しく炎える。",
   "ko_candidate": "뿜어져 나오는 빛이 더욱 눈부시고 격렬하게 타오른다｡"
  },
  {
   "id": 5855,
   "key": "D0414.txt:810",
   "file": "D0414.txt",
   "line": 810,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「メタトロン！」",
   "ko_candidate": "「메타트론!」"
  },
  {
   "id": 5856,
   "key": "D0414.txt:816",
   "file": "D0414.txt",
   "line": 816,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今度はアリスンが呼び止めた。",
   "ko_candidate": "이번에는 앨리슨이 불러 세웠다｡"
  },
  {
   "id": 5857,
   "key": "D0414.txt:817",
   "file": "D0414.txt",
   "line": 817,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "メタトロンは彼女を見つめる。",
   "ko_candidate": "메타트론은 그녀를 돌아본다｡"
  },
  {
   "id": 5858,
   "key": "D0414.txt:823",
   "file": "D0414.txt",
   "line": 823,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ、あの……その…… ――ありがとうっ！」",
   "ko_candidate": "그 얼굴을 똑바로 바라보며 앨리슨은 폭음에 묻히지 않도록 큰 소리로 외쳤다｡ 「저､ 저기… 그… ――고마워요!」"
  },
  {
   "id": 5859,
   "key": "D0414.txt:829",
   "file": "D0414.txt",
   "line": 829,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 5860,
   "key": "D0414.txt:835",
   "file": "D0414.txt",
   "line": 835,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――皆と、仲良くな」 翔んでゆく。",
   "ko_candidate": "내려다보는 천사의 가면 아래 표정은 알 수 없다｡"
  },
  {
   "id": 5861,
   "key": "D0414.txt:856",
   "file": "D0414.txt",
   "line": 856,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "白い天使の姿は、夜空へと消えていった。",
   "ko_candidate": "단 한 번만 고개를 끄덕였다｡"
  },
  {
   "id": 5862,
   "key": "D0414.txt:859",
   "file": "D0414.txt",
   "line": 859,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺もアリスンも、しばらく空を見上げ、それを見守っていた。",
   "ko_candidate": "그리고､ 「――모두와 사이좋게 지내」"
  },
  {
   "id": 5863,
   "key": "D0414.txt:870",
   "file": "D0414.txt",
   "line": 870,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やれやれ。難儀したが何とか無事、目的は果たしたな」",
   "ko_candidate": "날아갔다｡ 하얀 천사의 모습은 밤하늘의 어둠 속으로 사라져갔다｡"
  },
  {
   "id": 5864,
   "key": "D0414.txt:877",
   "file": "D0414.txt",
   "line": 877,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アリスンから受け取ったコンパクトを手に、アルは軽くため息をついた。",
   "ko_candidate": "나도､ 앨리슨도 잠시 하늘을 올려다보며 그것을 지켜보고 있었다｡ 「휴우｡ 고생했지만 어떻게든 무사히 목적은 달성했군」"
  },
  {
   "id": 5865,
   "key": "D0414.txt:895",
   "file": "D0414.txt",
   "line": 895,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アエテュル表に拠る暗号解読、 術式置換。正しき姿に還れ――」",
   "ko_candidate": "앨리슨에게서 받은 콤팩트를 손에 들고 가볍게 한숨을 쉬는 알｡ 손바닥 안에 있는 그것을 꽉 쥔다｡"
  }
 ]
}