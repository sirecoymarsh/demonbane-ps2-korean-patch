 "items": [
  {
   "id": 26295,
   "key": "D1112le.txt:341",
   "file": "D1112le.txt",
   "line": 341,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "（メタトロン。サンダルフォン。 『暴君』。お前達だ。お前達が導いておくれ）",
   "ko_candidate": "메타트론｡ 산달폰｡ 『폭군』｡ 너희들이다｡ 너희들이 인도해 다오｡"
  },
  {
   "id": 26296,
   "key": "D1112le.txt:345",
   "file": "D1112le.txt",
   "line": 345,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "（私を――神話の領域に）",
   "ko_candidate": "나를――신화의 영역으로) 「……라이카」"
  },
  {
   "id": 26297,
   "key": "D1112le.txt:354",
   "file": "D1112le.txt",
   "line": 354,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ライカ」 血が、止まらない。",
   "ko_candidate": "피가､ 멈추지 않는다｡"
  },
  {
   "id": 26298,
   "key": "D1112le.txt:358",
   "file": "D1112le.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "古傷より、溢れ出る血が止まらない。",
   "ko_candidate": "오래된 상처에서､ 흘러나오는 피가 멈추지 않는다｡"
  },
  {
   "id": 26299,
   "key": "D1112le.txt:359",
   "file": "D1112le.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滴り落ちる。",
   "ko_candidate": "뚝뚝 떨어진다｡"
  },
  {
   "id": 26300,
   "key": "D1112le.txt:360",
   "file": "D1112le.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足元に血溜まりを作る。",
   "ko_candidate": "발밑에 피웅덩이를 만든다｡"
  },
  {
   "id": 26301,
   "key": "D1112le.txt:364",
   "file": "D1112le.txt",
   "line": 364,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカァ！」",
   "ko_candidate": "「……라이카아!」"
  },
  {
   "id": 26302,
   "key": "D1112le.txt:367",
   "file": "D1112le.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去だ。",
   "ko_candidate": "과거다｡"
  },
  {
   "id": 26303,
   "key": "D1112le.txt:368",
   "file": "D1112le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは過去の傷。過去の呪縛。",
   "ko_candidate": "이것은 과거의 상처｡ 과거의 주박｡"
  },
  {
   "id": 26304,
   "key": "D1112le.txt:369",
   "file": "D1112le.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "乗り越えるべき、くだらない過去だ。",
   "ko_candidate": "극복해야 할､ 시시한 과거다｡"
  },
  {
   "id": 26305,
   "key": "D1112le.txt:371",
   "file": "D1112le.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この痛みを、血を止めるには……ライカ、貴様を――",
   "ko_candidate": "이 고통을､ 피를 멈추려면……라이카､ 네놈을――"
  },
  {
   "id": 26306,
   "key": "D1112le.txt:375",
   "file": "D1112le.txt",
   "line": 375,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「殺す……貴様を殺す……己は、貴様を、乗り越えるぞ……貴様如き、打ち砕くべき、単なる障害に過ぎない……！」",
   "ko_candidate": "「죽인다……네놈을 죽인다……나는､ 네놈을､ 극복할 것이다……네놈 따위는､ 부숴버려야 할､ 단순한 장애물에 불과하다……!」 【File11:JOAN OF ARC】closed<PRE>."
  },
  {
   "id": 26307,
   "key": "D1112ru.txt:9",
   "file": "D1112ru.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空は徐々に明るくなり、太陽は既に東の空を眩く照らす。",
   "ko_candidate": "하늘은 서서히 밝아지고､ 태양은 이미 동쪽 하늘을 눈부시게 비추고 있다｡"
  },
  {
   "id": 26308,
   "key": "D1112ru.txt:11",
   "file": "D1112ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "朝。",
   "ko_candidate": "아침｡"
  },
  {
   "id": 26309,
   "key": "D1112ru.txt:12",
   "file": "D1112ru.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう、朝なのだ。",
   "ko_candidate": "그래､ 아침이다｡"
  },
  {
   "id": 26310,
   "key": "D1112ru.txt:14",
   "file": "D1112ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪神が陰を落とす絶望の街にも朝は来る。",
   "ko_candidate": "사신이 그림자를 드리우는 절망의 거리에도 아침은 온다｡"
  },
  {
   "id": 26311,
   "key": "D1112ru.txt:15",
   "file": "D1112ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "万物に等しく朝は来る。",
   "ko_candidate": "만물에 똑같이 아침은 온다｡"
  },
  {
   "id": 26312,
   "key": "D1112ru.txt:17",
   "file": "D1112ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 26313,
   "key": "D1112ru.txt:18",
   "file": "D1112ru.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうなのだ。",
   "ko_candidate": "그런 것이다｡"
  },
  {
   "id": 26314,
   "key": "D1112ru.txt:19",
   "file": "D1112ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必ず、朝は来るのだ。",
   "ko_candidate": "반드시､ 아침은 오는 것이다｡"
  },
  {
   "id": 26315,
   "key": "D1112ru.txt:30",
   "file": "D1112ru.txt",
   "line": 30,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「勝った……」",
   "ko_candidate": "「이겼어……」"
  },
  {
   "id": 26316,
   "key": "D1112ru.txt:34",
   "file": "D1112ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぽつりと、ソーニャが呟いた。",
   "ko_candidate": "소냐가 불쑥 중얼거렸다｡"
  },
  {
   "id": 26317,
   "key": "D1112ru.txt:35",
   "file": "D1112ru.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静寂に零れ落ちたその言葉は、水面を打つ水滴の様に、波紋を広げ、実感を伴って全員の心に染み渡っていく。",
   "ko_candidate": "정적 속에 흘러나온 그 말은､ 수면을 치는 물방울처럼､ 파문을 일으키며､ 실감을 동반해 모두의 마음에 스며들어간다｡"
  },
  {
   "id": 26318,
   "key": "D1112ru.txt:45",
   "file": "D1112ru.txt",
   "line": 45,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――字祷子無限振動、拡散。敵機の昇滅を確認。勝ちました……ね」",
   "ko_candidate": "「――아자토스 무한진동､ 확산｡ 적기의 승멸을 확인｡ 이겼습니다……네」"
  },
  {
   "id": 26319,
   "key": "D1112ru.txt:50",
   "file": "D1112ru.txt",
   "line": 50,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やったぁぁぁぁぁぁ！　勝ったぁぁぁぁぁぁ！」",
   "ko_candidate": "「해냈어어어어어어! 이겼어어어어어어!」"
  },
  {
   "id": 26320,
   "key": "D1112ru.txt:54",
   "file": "D1112ru.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "押し寄せた喜びは、一気に溢れ出した。",
   "ko_candidate": "밀려온 기쁨이 한꺼번에 넘쳐흘렀다｡"
  },
  {
   "id": 26321,
   "key": "D1112ru.txt:55",
   "file": "D1112ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソーニャの歓声が広い司令室に響く。",
   "ko_candidate": "소냐의 환호성이 넓은 사령실에 울려 퍼진다｡"
  },
  {
   "id": 26322,
   "key": "D1112ru.txt:56",
   "file": "D1112ru.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マコトの表情もわずかに綻んでいた。",
   "ko_candidate": "마코토의 표정도 살짝 풀어졌다｡"
  },
  {
   "id": 26323,
   "key": "D1112ru.txt:62",
   "file": "D1112ru.txt",
   "line": 62,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふぅぅ……っ」",
   "ko_candidate": "「후우우……」"
  },
  {
   "id": 26324,
   "key": "D1112ru.txt:65",
   "file": "D1112ru.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "珍しくウィンフィールドが、深い溜め息をつく。",
   "ko_candidate": "드물게 윈필드가 깊은 한숨을 내쉰다｡"
  },
  {
   "id": 26325,
   "key": "D1112ru.txt:67",
   "file": "D1112ru.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脱力感にも似た安堵が全身を満たしていく。",
   "ko_candidate": "탈력감과도 비슷한 안도감이 온몸을 채워간다｡"
  },
  {
   "id": 26326,
   "key": "D1112ru.txt:69",
   "file": "D1112ru.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疲れ切った精神に、だが鞭打って、ウィンフィールドは通信機に呼びかけた。",
   "ko_candidate": "지친 정신에､ 하지만 채찍질하듯､ 윈필드는 통신기에 말을 걸었다｡"
  },
  {
   "id": 26327,
   "key": "D1112ru.txt:75",
   "file": "D1112ru.txt",
   "line": 75,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お疲れ様です、瑠璃お嬢様。アル様」 「敵アンチクロスのデウス・マキナ『クラーケン』昇滅。我々の勝利です！」",
   "ko_candidate": "「수고하셨습니다､ 루리 아가씨｡ 알 님｡ 적 안티크로스의 데우스 마키나 『크라켄』 승멸｡ 우리의 승리입니다!」"
  },
  {
   "id": 26328,
   "key": "D1112ru.txt:87",
   "file": "D1112ru.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "喜びに沸く司令室から離れた、格納庫。",
   "ko_candidate": "기쁨에 들뜬 사령실에서 떨어진､ 격납고｡"
  },
  {
   "id": 26329,
   "key": "D1112ru.txt:89",
   "file": "D1112ru.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ドクター・ウェスト達も戦いの趨勢をずっと見守っていた。",
   "ko_candidate": "닥터 웨스트 일행도 전투의 추이를 계속 지켜보고 있었다｡"
  },
  {
   "id": 26330,
   "key": "D1112ru.txt:91",
   "file": "D1112ru.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "喜びは格納庫にも伝染している。",
   "ko_candidate": "기쁨은 격납고에도 전염되고 있다｡"
  },
  {
   "id": 26331,
   "key": "D1112ru.txt:98",
   "file": "D1112ru.txt",
   "line": 98,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やったぁぁぁぁロボ―――ッ！」",
   "ko_candidate": "「해냈어어어어로봇――――!」"
  },
  {
   "id": 26332,
   "key": "D1112ru.txt:103",
   "file": "D1112ru.txt",
   "line": 103,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふん、ただの世間知らずの箱入り娘かと思えば……やるではないか、覇道瑠璃！」",
   "ko_candidate": "「흥､ 그저 세상 물정 모르는 온실 속 아가씨인 줄 알았더니……제법이군､ 하도 루리!」"
  },
  {
   "id": 26333,
   "key": "D1112ru.txt:109",
   "file": "D1112ru.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不敵な笑みを浮かべ、ドクター・ウェストはギターを奏でる。",
   "ko_candidate": "뻔뻔한 미소를 띠며､ 닥터 웨스트는 기타를 연주한다｡"
  },
  {
   "id": 26334,
   "key": "D1112ru.txt:111",
   "file": "D1112ru.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは少女達の健闘を讃える凱歌。",
   "ko_candidate": "그것은 소녀들의 분전을 기리는 개선가｡"
  }
 ]
}