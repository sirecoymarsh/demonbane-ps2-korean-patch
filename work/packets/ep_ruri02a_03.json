 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "九郎": "쿠로",
  "術式": "술식",
  "アル": "알",
  "瑠璃": "루리"
 },
 "items": [
  {
   "id": 50653,
   "key": "ep_ruri02a.txt:442",
   "file": "ep_ruri02a.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "憎かった。 心底、憎かった。",
   "ko_candidate": "아직､ 아무것도 끝나지 않았다｡"
  },
  {
   "id": 50654,
   "key": "ep_ruri02a.txt:444",
   "file": "ep_ruri02a.txt",
   "line": 444,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ここまで私の心を壊した、あの人が憎かった。 憎くて、",
   "ko_candidate": "끝났다고 생각하는 건､ 내 시간에서 보고 있어서야｡"
  },
  {
   "id": 50655,
   "key": "ep_ruri02a.txt:447",
   "file": "ep_ruri02a.txt",
   "line": 447,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "憎くて、 憎くて――愛しかった。",
   "ko_candidate": "내 주관에 불과해서야｡"
  },
  {
   "id": 50656,
   "key": "ep_ruri02a.txt:449",
   "file": "ep_ruri02a.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "どうしようもないほど、愛しかった。",
   "ko_candidate": ""
  },
  {
   "id": 50657,
   "key": "ep_ruri02a.txt:451",
   "file": "ep_ruri02a.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "もう自分を制御できない。",
   "ko_candidate": ""
  },
  {
   "id": 50658,
   "key": "ep_ruri02a.txt:452",
   "file": "ep_ruri02a.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だから、壊れるのに、身を任せるしかなかった。",
   "ko_candidate": ""
  },
  {
   "id": 50659,
   "key": "ep_ruri02a.txt:455",
   "file": "ep_ruri02a.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無限に湧いて出てくると思った涙も、止まってしまう。 涙は涸れ、心も空っぽで、私はただ呆……と、床に座り込んで、天井を見つめている。",
   "ko_candidate": "지금､ 이 괴이의 한가운데 있어서……시간도 공간도 초월한 괴이 속에 있어서､ 요그 소토스의 단말기에 닿아서､ 그런 시점에 무슨 의미가 있을까?"
  },
  {
   "id": 50660,
   "key": "ep_ruri02a.txt:458",
   "file": "ep_ruri02a.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "見つめていながら……実際は何も視界に入ってこない。",
   "ko_candidate": ""
  },
  {
   "id": 50661,
   "key": "ep_ruri02a.txt:459",
   "file": "ep_ruri02a.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ただ疲労だけが、今の自分を満たす全てだった。",
   "ko_candidate": ""
  },
  {
   "id": 50662,
   "key": "ep_ruri02a.txt:463",
   "file": "ep_ruri02a.txt",
   "line": 463,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……もう、堪えられないよぉ……九郎……」",
   "ko_candidate": ""
  },
  {
   "id": 50663,
   "key": "ep_ruri02a.txt:466",
   "file": "ep_ruri02a.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "決定的な何かが崩れ去ろうとしていた――その時。",
   "ko_candidate": ""
  },
  {
   "id": 50664,
   "key": "ep_ruri02a.txt:467",
   "file": "ep_ruri02a.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何も映さないはずの視界の隅に、光を認めた。 思わず光を視線で追う。",
   "ko_candidate": "이제부터다｡"
  },
  {
   "id": 50665,
   "key": "ep_ruri02a.txt:473",
   "file": "ep_ruri02a.txt",
   "line": 473,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「え……？」 奇妙な光景だった。",
   "ko_candidate": "운명을 바꾸는 건､ 이제부터다｡"
  },
  {
   "id": 50666,
   "key": "ep_ruri02a.txt:479",
   "file": "ep_ruri02a.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "微細な光の塵が、螺旋を描くように、舞っていた。",
   "ko_candidate": ""
  },
  {
   "id": 50667,
   "key": "ep_ruri02a.txt:480",
   "file": "ep_ruri02a.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "渦巻く光の塵は徐々に、数と輝きを増してゆく。",
   "ko_candidate": ""
  },
  {
   "id": 50668,
   "key": "ep_ruri02a.txt:482",
   "file": "ep_ruri02a.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "光が部屋の明かりを圧倒するほど輝きを増して、私はそれが意味するものを知った。",
   "ko_candidate": ""
  },
  {
   "id": 50669,
   "key": "ep_ruri02a.txt:483",
   "file": "ep_ruri02a.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "光の一つ一つは魔術文字。",
   "ko_candidate": ""
  },
  {
   "id": 50670,
   "key": "ep_ruri02a.txt:485",
   "file": "ep_ruri02a.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "螺旋を描く魔術文字は、魔術を構成する複雑な術式。",
   "ko_candidate": ""
  },
  {
   "id": 50671,
   "key": "ep_ruri02a.txt:491",
   "file": "ep_ruri02a.txt",
   "line": 491,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えええっ!?」 そして魔術は、ある実体を構築した。",
   "ko_candidate": "지금이라면……이런 기적에 둘러싸인 지금이라면､ 이 영원을"
  },
  {
   "id": 50672,
   "key": "ep_ruri02a.txt:495",
   "file": "ep_ruri02a.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それはまず小さなヒト型を模り、肉体を編む。",
   "ko_candidate": ""
  },
  {
   "id": 50673,
   "key": "ep_ruri02a.txt:500",
   "file": "ep_ruri02a.txt",
   "line": 500,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "白い肌。 翡翠の瞳。",
   "ko_candidate": "끝낼 수 있어……!"
  },
  {
   "id": 50674,
   "key": "ep_ruri02a.txt:502",
   "file": "ep_ruri02a.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "銀の髪の先端はまだ構築し切らないのか、魔術文字のまま連なり、輝く。",
   "ko_candidate": ""
  },
  {
   "id": 50675,
   "key": "ep_ruri02a.txt:503",
   "file": "ep_ruri02a.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "魔術が編んだその少女を、私は良く知っていた。",
   "ko_candidate": ""
  },
  {
   "id": 50676,
   "key": "ep_ruri02a.txt:507",
   "file": "ep_ruri02a.txt",
   "line": 507,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル!?　どうして!?」 翡翠の瞳が、私を見つめる。",
   "ko_candidate": "「알! 계약을! 다시 한 번､ 당신과의 계약을 원합니다!」"
  },
  {
   "id": 50677,
   "key": "ep_ruri02a.txt:511",
   "file": "ep_ruri02a.txt",
   "line": 511,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "虚ろだった瞳が、意思の光を灯した。",
   "ko_candidate": ""
  },
  {
   "id": 50678,
   "key": "ep_ruri02a.txt:512",
   "file": "ep_ruri02a.txt",
   "line": 512,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "独り言のように、アルは喋り出す。",
   "ko_candidate": ""
  },
  {
   "id": 50679,
   "key": "ep_ruri02a.txt:516",
   "file": "ep_ruri02a.txt",
   "line": 516,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……何とか、戻って来れたか……だが、長くは持たん。 既に因果が……分解し始めている……」",
   "ko_candidate": ""
  },
  {
   "id": 50680,
   "key": "ep_ruri02a.txt:520",
   "file": "ep_ruri02a.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "言うや否や、アルの躰が幽霊のように透明に薄れていく。",
   "ko_candidate": ""
  },
  {
   "id": 50681,
   "key": "ep_ruri02a.txt:521",
   "file": "ep_ruri02a.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ときおり壊れたモニターのように、その姿にノイズが走る。",
   "ko_candidate": ""
  },
  {
   "id": 50682,
   "key": "ep_ruri02a.txt:522",
   "file": "ep_ruri02a.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何が起こっているのか、把握できない。",
   "ko_candidate": ""
  },
  {
   "id": 50683,
   "key": "ep_ruri02a.txt:526",
   "file": "ep_ruri02a.txt",
   "line": 526,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「また……輪廻に囚われる前に……瑠璃……汝に伝える事があって、参った」",
   "ko_candidate": ""
  },
  {
   "id": 50684,
   "key": "ep_ruri02a.txt:530",
   "file": "ep_ruri02a.txt",
   "line": 530,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「伝える……こと？」",
   "ko_candidate": ""
  },
  {
   "id": 50685,
   "key": "ep_ruri02a.txt:533",
   "file": "ep_ruri02a.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何が起こっているかは分からないが……それが、大切なことであるのは分かった。見逃さないよう、聞き逃さないよう、全神経を動員して、アルの一挙一動を見守る。",
   "ko_candidate": ""
  },
  {
   "id": 50686,
   "key": "ep_ruri02a.txt:537",
   "file": "ep_ruri02a.txt",
   "line": 537,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「妾が知った……輪廻の真実……そして……九郎の事を……」",
   "ko_candidate": ""
  },
  {
   "id": 50687,
   "key": "ep_ruri02a.txt:540",
   "file": "ep_ruri02a.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎！ その名前に心臓が跳ね上がった。",
   "ko_candidate": "사라져가는 빛은､"
  },
  {
   "id": 50688,
   "key": "ep_ruri02a.txt:542",
   "file": "ep_ruri02a.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "身を乗り出すようにして、アルに訴えかける。",
   "ko_candidate": ""
  },
  {
   "id": 50689,
   "key": "ep_ruri02a.txt:543",
   "file": "ep_ruri02a.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "必死だった。",
   "ko_candidate": ""
  },
  {
   "id": 50690,
   "key": "ep_ruri02a.txt:547",
   "file": "ep_ruri02a.txt",
   "line": 547,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「九郎は!?　九郎はどうしたのです！ アル！　教えて！　お願いだから、教えてっ！」",
   "ko_candidate": ""
  },
  {
   "id": 50691,
   "key": "ep_ruri02a.txt:551",
   "file": "ep_ruri02a.txt",
   "line": 551,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "私の叫びが届いているのか、いないのか。",
   "ko_candidate": ""
  },
  {
   "id": 50692,
   "key": "ep_ruri02a.txt:552",
   "file": "ep_ruri02a.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アルは相変わらず独り言を続けているような口調で、私に向かい手を翳した。",
   "ko_candidate": ""
  }
 ]
}