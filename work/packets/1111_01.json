 },
 "items": [
  {
   "id": 25936,
   "key": "D1111le.txt:162",
   "file": "D1111le.txt",
   "line": 162,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちょっ……だから、ちゃんとした説明を……！」",
   "ko_candidate": "「잠깐……그러니까､ 제대로 된 설명을……!」"
  },
  {
   "id": 25937,
   "key": "D1111le.txt:167",
   "file": "D1111le.txt",
   "line": 167,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「対象、実空間に事象固定化。衝撃波来ます」",
   "ko_candidate": "「대상､ 실공간에 사상 고정화｡ 충격파 옵니다」"
  },
  {
   "id": 25938,
   "key": "D1111le.txt:181",
   "file": "D1111le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不可視の爆発が、大気を吹き飛ばし、空間を激震させた。",
   "ko_candidate": "불가시의 폭발이 대기를 날려버리고､ 공간을 격진시켰다｡"
  },
  {
   "id": 25939,
   "key": "D1111le.txt:182",
   "file": "D1111le.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顕現化するのはデモンベインのような巨体ではない。",
   "ko_candidate": "현현화하는 것은 데몬베인과 같은 거체가 아니다｡"
  },
  {
   "id": 25940,
   "key": "D1111le.txt:183",
   "file": "D1111le.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人間と大して変わらないサイズのように見える。",
   "ko_candidate": "인간과 크게 다르지 않은 크기로 보인다｡"
  },
  {
   "id": 25941,
   "key": "D1111le.txt:186",
   "file": "D1111le.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃波が過ぎ去ると、今度はアクセルを吹かす音が、爆音となって虚空に轟く……",
   "ko_candidate": "충격파가 지나가자 이번에는 액셀을 밟는 소리가 폭음이 되어 허공에 울려 퍼진다……"
  },
  {
   "id": 25942,
   "key": "D1111le.txt:186",
   "file": "D1111le.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アクセル？",
   "ko_candidate": "액셀?"
  },
  {
   "id": 25943,
   "key": "D1111le.txt:188",
   "file": "D1111le.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭の中で、はっちゃけ過ぎてる等式が成立した。",
   "ko_candidate": "머릿속에서 너무 튀는 등식이 성립했다｡"
  },
  {
   "id": 25944,
   "key": "D1111le.txt:191",
   "file": "D1111le.txt",
   "line": 191,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まっさか……そんな、いくら何でも非常識な……」",
   "ko_candidate": "「설마……그런､ 아무리 그래도 비상식적인……」"
  },
  {
   "id": 25945,
   "key": "D1111le.txt:193",
   "file": "D1111le.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、アイツに一番求めてはいけないのは常識だ。",
   "ko_candidate": "하지만､ 그 녀석에게 가장 요구해서는 안 되는 것이 상식이다｡"
  },
  {
   "id": 25946,
   "key": "D1111le.txt:194",
   "file": "D1111le.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなことは、この俺が良く分かっている。",
   "ko_candidate": "그런 건､ 이 내가 잘 알고 있다｡"
  },
  {
   "id": 25947,
   "key": "D1111le.txt:195",
   "file": "D1111le.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、今回も例外ではなかった。",
   "ko_candidate": "그리고 이번에도 예외는 아니었다｡"
  },
  {
   "id": 25948,
   "key": "D1111le.txt:198",
   "file": "D1111le.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "世界を引き裂かんばかりに咆吼するエグゾースト。",
   "ko_candidate": "세계를 찢어발길 듯 포효하는 배기음｡"
  },
  {
   "id": 25949,
   "key": "D1111le.txt:200",
   "file": "D1111le.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の獣が吼える！",
   "ko_candidate": "강철의 짐승이 포효한다!"
  },
  {
   "id": 25950,
   "key": "D1111le.txt:201",
   "file": "D1111le.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の獣が駆ける。もとい翔ける！",
   "ko_candidate": "강철의 짐승이 달린다｡ 아니 날아오른다!"
  },
  {
   "id": 25951,
   "key": "D1111le.txt:203",
   "file": "D1111le.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾風すら引き連れ、あるいは引き裂き、俺たちに急速接近するその獣は――",
   "ko_candidate": "질풍마저 끌고 오거나 찢어발기며､ 우리에게 급속히 접근하는 그 짐승은――"
  },
  {
   "id": 25952,
   "key": "D1111le.txt:211",
   "file": "D1111le.txt",
   "line": 211,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハンティングホラーぁぁぁぁっ!?」",
   "ko_candidate": "「헌팅 호러어어어어어!?」"
  },
  {
   "id": 25953,
   "key": "D1111le.txt:213",
   "file": "D1111le.txt",
   "line": 213,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ナコト写本』の術式を組み込んだ、鬼械神に匹敵する魔導武装。",
   "ko_candidate": "『나코트 사본』의 술식을 내장한､ 귀계신에 필적하는 마도무장｡"
  },
  {
   "id": 25954,
   "key": "D1111le.txt:214",
   "file": "D1111le.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今の俺たちが持つ、唯一の切り札だ。",
   "ko_candidate": "지금의 우리가 가진 유일한 비장의 카드다｡"
  },
  {
   "id": 25955,
   "key": "D1111le.txt:216",
   "file": "D1111le.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そいつは、さも当然と言わんばかりの勢いで、何もない虚空を『走行』していた。疾走していた。",
   "ko_candidate": "그것은 당연하다는 듯한 기세로 아무것도 없는 허공을 『주행』하고 있었다｡ 질주하고 있었다｡"
  },
  {
   "id": 25956,
   "key": "D1111le.txt:218",
   "file": "D1111le.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……確かにある意味、デウス・マキナをぶっちきりで圧倒している。",
   "ko_candidate": "……확실히 어떤 의미로는 데우스 마키나를 압도하고 있다｡"
  },
  {
   "id": 25957,
   "key": "D1111le.txt:220",
   "file": "D1111le.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが問いたい。この場合、タイヤが回転する意味は、果たしてあるのだろうかと。",
   "ko_candidate": "하지만 묻고 싶다｡ 이 경우､ 타이어가 회전하는 의미가 과연 있는 것일까｡"
  },
  {
   "id": 25958,
   "key": "D1111le.txt:226",
   "file": "D1111le.txt",
   "line": 226,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――待たせたな、九郎！」",
   "ko_candidate": "「――기다리게 했군､ 쿠로!」"
  },
  {
   "id": 25959,
   "key": "D1111le.txt:233",
   "file": "D1111le.txt",
   "line": 233,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ、アル――――!?　復活したのかっ！」",
   "ko_candidate": "「아､ 알――――!? 부활한 거야!」"
  },
  {
   "id": 25960,
   "key": "D1111le.txt:235",
   "file": "D1111le.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "つーか、お前が乗ってたのか。",
   "ko_candidate": "그보다､ 네가 타고 있었어?"
  },
  {
   "id": 25961,
   "key": "D1111le.txt:236",
   "file": "D1111le.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "色々と衝撃的なことが連続していて、どこからツッコめば良いか、さっぱりだった。",
   "ko_candidate": "여러모로 충격적인 일이 연속되어서 어디서부터 지적해야 할지 전혀 모르겠다｡"
  },
  {
   "id": 25962,
   "key": "D1111le.txt:240",
   "file": "D1111le.txt",
   "line": 240,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今、そっちに行く！　用意は良いか!?」",
   "ko_candidate": "「지금､ 그쪽으로 갈게! 준비는 됐어!?」"
  },
  {
   "id": 25963,
   "key": "D1111le.txt:244",
   "file": "D1111le.txt",
   "line": 244,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お、おう！」",
   "ko_candidate": "「으､ 응!」"
  },
  {
   "id": 25964,
   "key": "D1111le.txt:246",
   "file": "D1111le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。今は状況に呑まれている場合ではない。",
   "ko_candidate": "그래｡ 지금은 상황에 휩쓸릴 때가 아니다｡"
  },
  {
   "id": 25965,
   "key": "D1111le.txt:247",
   "file": "D1111le.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今は奴を、クラーケンを斃さなければ！",
   "ko_candidate": "지금은 그 녀석을､ 크라켄을 쓰러뜨려야 한다!"
  },
  {
   "id": 25966,
   "key": "D1111le.txt:250",
   "file": "D1111le.txt",
   "line": 250,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良し……！　来い、アル！」",
   "ko_candidate": "「좋아……! 와라､ 알!」"
  },
  {
   "id": 25967,
   "key": "D1111le.txt:254",
   "file": "D1111le.txt",
   "line": 254,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「応よ！」",
   "ko_candidate": "「응!」"
  },
  {
   "id": 25968,
   "key": "D1111le.txt:261",
   "file": "D1111le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティングホラーが俺たちの真横を通り過ぎるとき、アルはバイクから飛び降りた。",
   "ko_candidate": "헌팅 호러가 우리 바로 옆을 지나갈 때､ 알은 바이크에서 뛰어내렸다｡"
  },
  {
   "id": 25969,
   "key": "D1111le.txt:261",
   "file": "D1111le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の指とアルの指が触れ合う。",
   "ko_candidate": "내 손가락과 알의 손가락이 맞닿는다｡"
  },
  {
   "id": 25970,
   "key": "D1111le.txt:266",
   "file": "D1111le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の身体は光に包まれた。",
   "ko_candidate": "내 몸은 빛에 휩싸였다｡"
  },
  {
   "id": 25971,
   "key": "D1111le.txt:271",
   "file": "D1111le.txt",
   "line": 271,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぬうウウうう！」",
   "ko_candidate": "「으으으으으!」"
  },
  {
   "id": 25972,
   "key": "D1111le.txt:274",
   "file": "D1111le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まず肉体に変化が生じる。",
   "ko_candidate": "우선 육체에 변화가 일어난다｡"
  },
  {
   "id": 25973,
   "key": "D1111le.txt:276",
   "file": "D1111le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "筋肉が骨格が魔的な要素を取り込み、ヒトの限界を超えた強靭さを得る。",
   "ko_candidate": "근육과 골격이 마적인 요소를 받아들여､ 인간의 한계를 넘어선 강인함을 얻는다｡"
  },
  {
   "id": 25974,
   "key": "D1111le.txt:278",
   "file": "D1111le.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身に漲る力。俺の肉体そのものが強大な魔力を受け入れ、循環させる伝導体と化していた。",
   "ko_candidate": "전신에 넘치는 힘｡ 내 육체 그 자체가 강대한 마력을 받아들이고､ 순환시키는 전도체로 변했다｡"
  },
  {
   "id": 25975,
   "key": "D1111le.txt:283",
   "file": "D1111le.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その身体の表面を覆う、魔導書のページ。黒いボディスーツへと変容。",
   "ko_candidate": "그 몸의 표면을 덮는､ 마도서의 페이지｡ 검은 바디슈트로 변모｡"
  }
 ]
}