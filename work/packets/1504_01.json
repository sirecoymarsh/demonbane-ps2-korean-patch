  {
   "id": 42174,
   "key": "D1504al.txt:221",
   "file": "D1504al.txt",
   "line": 221,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「チッ……これだから嫉妬深い凡人は。エルザ……この凡人眼鏡に生まれながらの才能の違いと云うものを教え――んっ？」",
   "ko_candidate": "「치… 이래서 질투심 많은 범인들은｡ 엘자… 이 범인 안경에게 타고난 재능의 차이라는 걸 가르쳐… 응?」"
  },
  {
   "id": 42175,
   "key": "D1504al.txt:231",
   "file": "D1504al.txt",
   "line": 231,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ロボー？」",
   "ko_candidate": "「로보?」"
