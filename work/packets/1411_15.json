 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ルルイエ異本": "르뤼에 이본"
 },
 "items": [
  {
   "id": 39659,
   "key": "D1411ru.txt:1636",
   "file": "D1411ru.txt",
   "line": 1636,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『ルルイエ異本』の絶叫が、大広間に轟いた。",
   "ko_candidate": "「………¨읏!?」 ――봤다｡"
  },
  {
   "id": 39660,
   "key": "D1411ru.txt:1637",
   "file": "D1411ru.txt",
   "line": 1637,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "聴く者の魂を破壊するような、悲痛な慟哭に、俺の精神は急速に再生する。",
   "ko_candidate": "촉수가 물러난､ 제단 위｡ 반나체의 소녀는､ 안아 올려지고 있었다｡"
  },
  {
   "id": 39661,
   "key": "D1411ru.txt:1642",
   "file": "D1411ru.txt",
   "line": 1642,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ!?」",
   "ko_candidate": "올라타고 있던 무녀에 의해―― ――아니었다｡"
  },
  {
   "id": 39662,
   "key": "D1411ru.txt:1652",
   "file": "D1411ru.txt",
   "line": 1652,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ァ……ァァ……ッ！」",
   "ko_candidate": "「…아… 아아… 읏!」"
  },
  {
   "id": 39663,
   "key": "D1411ru.txt:1654",
   "file": "D1411ru.txt",
   "line": 1654,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心臓を破裂させるほどの、戦慄が全身を貫いた。",
   "ko_candidate": "심장이 터질 것 같은､ 전율이 온몸을 관통했다｡"
  },
  {
   "id": 39664,
   "key": "D1411ru.txt:1656",
   "file": "D1411ru.txt",
   "line": 1656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――吐き気が乱舞する。",
   "ko_candidate": "――구역질이 난무한다｡"
  },
  {
   "id": 39665,
   "key": "D1411ru.txt:1657",
   "file": "D1411ru.txt",
   "line": 1657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――頭痛が頭蓋骨を罅割れさせる。",
   "ko_candidate": "――두통이 두개골을 갈라놓는다｡"
  },
  {
   "id": 39666,
   "key": "D1411ru.txt:1662",
   "file": "D1411ru.txt",
   "line": 1662,
   "speaker": "ルルイエ異本",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ア……アアァ……ア……いあ……いあぁぁ……らっ、らっ」",
   "ko_candidate": "「아… 아아아… 아… 이야… 이야아아… 랏､ 랏」 숨도 제대로 못 쉬는､ '르뤼에 이본'의 숨소리｡"
  },
  {
   "id": 39667,
   "key": "D1411ru.txt:1668",
   "file": "D1411ru.txt",
   "line": 1668,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "息も絶え絶えな、『ルルイエ異本』の吐息。",
   "ko_candidate": "소녀를 들어 올리는 그자의 오른팔은､ 그녀의 배에 꽂혀 있다｡ 선혈이 넘쳐흐르고 있다｡"
  },
  {
   "id": 39668,
   "key": "D1411ru.txt:1669",
   "file": "D1411ru.txt",
   "line": 1669,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女を持ち上げるそいつの右腕は、腹に突き刺さっている。",
   "ko_candidate": "두근두근｡ 두근두근｡ 두근두근｡ 그자와 소녀는､ 이미 피투성이였다｡"
  },
  {
   "id": 39669,
   "key": "D1411ru.txt:1671",
   "file": "D1411ru.txt",
   "line": 1671,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真っ赤に染まってゆく。",
   "ko_candidate": "두 사람의 하얀 피부도 피투성이｡"
  },
  {
   "id": 39670,
   "key": "D1411ru.txt:1672",
   "file": "D1411ru.txt",
   "line": 1672,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "2人の白い肌を、『ルルイエ異本』の白銀に輝く髪を、そして――そいつの黄金の髪を。",
   "ko_candidate": "'르뤼에 이본'의 하얗게 빛나는 머리카락도､ 새빨갛게 물든다｡ 그리고… 그자의 황금빛 머리카락도｡"
  },
  {
   "id": 39671,
   "key": "D1411ru.txt:1677",
   "file": "D1411ru.txt",
   "line": 1677,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「真逆……っ！」",
   "ko_candidate": "「설마…읏!」"
  },
  {
   "id": 39672,
   "key": "D1411ru.txt:1682",
   "file": "D1411ru.txt",
   "line": 1682,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――脊髄が氷結する。",
   "ko_candidate": "――척수가 얼어붙는다｡"
  },
  {
   "id": 39673,
   "key": "D1411ru.txt:1683",
   "file": "D1411ru.txt",
   "line": 1683,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――舌が灼ける。",
   "ko_candidate": "――혀가 타들어간다｡"
  },
  {
   "id": 39674,
   "key": "D1411ru.txt:1684",
   "file": "D1411ru.txt",
   "line": 1684,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――咽喉が渇き切る。",
   "ko_candidate": "――목구멍이 바싹 마른다｡"
  },
  {
   "id": 39675,
   "key": "D1411ru.txt:1686",
   "file": "D1411ru.txt",
   "line": 1686,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな……そんなはずはない。",
   "ko_candidate": "그럴 리가… 그럴 리가 없어｡"
  },
  {
   "id": 39676,
   "key": "D1411ru.txt:1688",
   "file": "D1411ru.txt",
   "line": 1688,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故、こいつが……死んだはずの……はっきりとこの目で、その様を見届けたはずのこいつが何で……！",
   "ko_candidate": "왜､ 이자가… 죽었어야 할… 분명히 이 눈으로､ 그 모습을 확인했어야 할 이자가 왜…!"
  },
  {
   "id": 39677,
   "key": "D1411ru.txt:1693",
   "file": "D1411ru.txt",
   "line": 1693,
   "speaker": "ルルイエ異本",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「かみさま……ほしが……また……ほんとうの……ただしい……ら・いらぁぁ……」",
   "ko_candidate": "「신님… 별이… 또… 진짜… 올바른… 라?이라아아…」"
  },
  {
   "id": 39678,
   "key": "D1411ru.txt:1698",
   "file": "D1411ru.txt",
   "line": 1698,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そいつは、少女の頬に散った血を丁寧に舐め取った。",
   "ko_candidate": "그자는､ 소녀의 뺨에 튄 피를 정중하게 핥아냈다｡"
  },
  {
   "id": 39679,
   "key": "D1411ru.txt:1700",
   "file": "D1411ru.txt",
   "line": 1700,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女の顔に唇を寄せたまま、ただ瞳だけが横を向く。",
   "ko_candidate": "소녀의 얼굴에 입술을 가까이 한 채､ 단지 눈동자만 옆을 향한다｡"
  },
  {
   "id": 39680,
   "key": "D1411ru.txt:1702",
   "file": "D1411ru.txt",
   "line": 1702,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こっちを覗き見る。",
   "ko_candidate": "이쪽을 엿보는｡"
  },
  {
   "id": 39681,
   "key": "D1411ru.txt:1704",
   "file": "D1411ru.txt",
   "line": 1704,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞳は――",
   "ko_candidate": "그 눈동자는――"
  },
  {
   "id": 39682,
   "key": "D1411ru.txt:1706",
   "file": "D1411ru.txt",
   "line": 1706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――内臓が痙攣する。",
   "ko_candidate": "――내장이 경련한다｡"
  },
  {
   "id": 39683,
   "key": "D1411ru.txt:1707",
   "file": "D1411ru.txt",
   "line": 1707,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――四肢が石化する。",
   "ko_candidate": "――사지가 석화된다｡"
  },
  {
   "id": 39684,
   "key": "D1411ru.txt:1708",
   "file": "D1411ru.txt",
   "line": 1708,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――眼球の奥が爆発する。",
   "ko_candidate": "――안구 속이 폭발한다｡"
  },
  {
   "id": 39685,
   "key": "D1411ru.txt:1710",
   "file": "D1411ru.txt",
   "line": 1710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間違えない。",
   "ko_candidate": "틀릴 리 없다｡"
  },
  {
   "id": 39686,
   "key": "D1411ru.txt:1711",
   "file": "D1411ru.txt",
   "line": 1711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間違えるはずがない。",
   "ko_candidate": "틀릴 리가 없다｡"
  },
  {
   "id": 39687,
   "key": "D1411ru.txt:1713",
   "file": "D1411ru.txt",
   "line": 1713,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな怪異を、俺は他に識らない。",
   "ko_candidate": "이런 괴이를､ 나는 다른 데서 알지 못한다｡"
  },
  {
   "id": 39688,
   "key": "D1411ru.txt:1714",
   "file": "D1411ru.txt",
   "line": 1714,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "他に存在していて良いはずもない。",
   "ko_candidate": "다른 곳에 존재해서는 안 되는 것이다｡"
  },
  {
   "id": 39689,
   "key": "D1411ru.txt:1715",
   "file": "D1411ru.txt",
   "line": 1715,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こんなものが……",
   "ko_candidate": "이런 것이…"
  },
  {
   "id": 39690,
   "key": "D1411ru.txt:1716",
   "file": "D1411ru.txt",
   "line": 1716,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こんな――",
   "ko_candidate": "이런――"
  },
  {
   "id": 39691,
   "key": "D1411ru.txt:1719",
   "file": "D1411ru.txt",
   "line": 1719,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒を閉じ込めた金色の瞳を。",
   "ko_candidate": "암흑을 가두어 놓은 황금빛 눈동자를｡"
  },
  {
   "id": 39692,
   "key": "D1411ru.txt:1722",
   "file": "D1411ru.txt",
   "line": 1722,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "堪え切れず、俺はそいつの名前を叫んだ。",
   "ko_candidate": "참을 수 없어､ 나는 그자의 이름을 외쳤다｡"
  },
  {
   "id": 39693,
   "key": "D1411ru.txt:1723",
   "file": "D1411ru.txt",
   "line": 1723,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ほとんど悲鳴だった。",
   "ko_candidate": "거의 비명이었다｡"
  },
  {
   "id": 39694,
   "key": "D1411ru.txt:1733",
   "file": "D1411ru.txt",
   "line": 1733,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――マスターテリオンッッッッ！」",
   "ko_candidate": "「――마스터 테리온!!!!」"
  },
  {
   "id": 39695,
   "key": "D1411ru.txt:1737",
   "file": "D1411ru.txt",
   "line": 1737,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嗤った。",
   "ko_candidate": "비웃었다｡"
  },
  {
   "id": 39696,
   "key": "D1411ru.txt:1738",
   "file": "D1411ru.txt",
   "line": 1738,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女に唇を重ねながら、そいつは嗤った。",
   "ko_candidate": "소녀에게 입술을 포개면서､ 그자는 비웃었다｡ 황금빛 어둠이 비웃었다｡"
  },
  {
   "id": 39697,
   "key": "D1411ru.txt:1739",
   "file": "D1411ru.txt",
   "line": 1739,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の闇が嗤った。",
   "ko_candidate": "――균열 같은 미소로｡"
  },
  {
   "id": 39698,
   "key": "D1411ru.txt:1741",
   "file": "D1411ru.txt",
   "line": 1741,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――亀裂の様な笑みで。",
   "ko_candidate": "To Final　→【STRANGE EONS】"
  }
 ]
