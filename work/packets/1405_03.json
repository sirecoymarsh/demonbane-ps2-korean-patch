  },
  {
   "id": 37449,
   "key": "D1405le.txt:391",
   "file": "D1405le.txt",
   "line": 391,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何だよ？」",
   "ko_candidate": "「……뭐야?」"
  },
  {
   "id": 37450,
   "key": "D1405le.txt:397",
   "file": "D1405le.txt",
   "line": 397,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほんとうに……ほんとうに勝てるとおもう？ だって……あんな……あんな、おっきい怪獣が……っ」",
   "ko_candidate": "「정말로…… 정말로 이길 수 있다고 생각해? 그치만…… 그런…… 그런､ 큰 괴수가……」"
  },
  {
   "id": 37451,
   "key": "D1405le.txt:404",
   "file": "D1405le.txt",
   "line": 404,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 37452,
   "key": "D1405le.txt:408",
   "file": "D1405le.txt",
   "line": 408,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もしも……九郎までかえってこなかったら……」",
   "ko_candidate": "「만약…… 쿠로마저 돌아오지 않는다면……」"
  },
  {
   "id": 37453,
   "key": "D1405le.txt:412",
   "file": "D1405le.txt",
   "line": 412,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 37454,
   "key": "D1405le.txt:416",
   "file": "D1405le.txt",
   "line": 416,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐすっ……ぼくたち……ぼくたち、九郎もライカお姉ちゃんもいなくて……どうすればいいのか……っ」",
   "ko_candidate": "「흑…… 우리들…… 우리들､ 쿠로도 라이카 누나도 없어서…… 어떻게 해야 할지……」"
  },
  {
   "id": 37455,
   "key": "D1405le.txt:422",
   "file": "D1405le.txt",
   "line": 422,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……絶対、勝つもん」",
   "ko_candidate": "「……절대､ 이길 거야」"
  },
  {
   "id": 37456,
   "key": "D1405le.txt:426",
   "file": "D1405le.txt",
   "line": 426,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……」",
   "ko_candidate": "「엣……」"
  },
  {
   "id": 37457,
   "key": "D1405le.txt:430",
   "file": "D1405le.txt",
   "line": 430,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……アリスン」",
   "ko_candidate": "「……앨리슨」"
  },
  {
   "id": 37458,
   "key": "D1405le.txt:436",
   "file": "D1405le.txt",
   "line": 436,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎お兄ちゃんは絶対勝つもん。ライカお姉ちゃんを助けてくれるもん」 「だってだって……九郎お兄ちゃんは私を助けてくれたもん。 悪い竜から……ジャバウォックから助けてくれたもん！」",
   "ko_candidate": "「쿠로 오빠는 절대 이길 거야｡ 라이카 누나를 구해줄 거야｡ 왜냐면 왜냐면…… 쿠로 오빠는 나를 구해줬잖아｡ 나쁜 용에게서…… 재버워크에게서 구해줬잖아! 그러니까 라이카 누나도 나쁜 용에게서､ 구해서 데려올 거야!」"
  },
  {
   "id": 37459,
   "key": "D1405le.txt:443",
   "file": "D1405le.txt",
   "line": 443,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だからライカお姉ちゃんも悪い竜から、助けて出してくれるよ！」",
   "ko_candidate": "「그래…… 맞아! 그런 괴물이 뭐야! 저쪽이 괴수라면…… 쿠로의 건 무적의 로봇이라고!」"
  },
  {
   "id": 37460,
   "key": "D1405le.txt:449",
   "file": "D1405le.txt",
   "line": 449,
   "speaker": "ジョージ / コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだ……そうだよ！　あんなオバケがなんだよっ！ あっちがカイジュウなら……九郎のはムテキのロボットだぜ！」 「……そう、だよね……！　それに……お姉ちゃんだって、メタトロンなんだから！　ぜったい……ぜったい……だいじょうぶ……」",
   "ko_candidate": "「……그렇､ 지……! 게다가…… 누나는 메타트론이잖아! 절대…… 절대…… 괜찮을 거야……」"
  },
  {
   "id": 37461,
   "key": "D1405le.txt:460",
   "file": "D1405le.txt",
   "line": 460,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……絶対、勝つもん」",
   "ko_candidate": "「……절대､ 이길 거야」"
  },
  {
   "id": 37462,
   "key": "D1405le.txt:466",
   "file": "D1405le.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それぞれの想いは、星が無言に瞬く夜に呑み込まれ――朝陽の到来と共に、光の中へと霧散していくだろう。",
   "ko_candidate": "각자의 마음은 별이 말없이 반짝이는 밤에 삼켜져―― 아침 햇살의 도래와 함께 빛 속으로 흩어질 것이다｡"
  },
  {
   "id": 37463,
   "key": "D1405le.txt:468",
   "file": "D1405le.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "想うだけの夜が終わり――想いを秘め、総てを決する為の朝が来る。",
   "ko_candidate": "생각만 하던 밤이 끝나고―― 마음을 숨기고､ 모든 것을 결정하기 위한 아침이 온다｡"
  },
  {
   "id": 37464,
   "key": "D1405le.txt:473",
   "file": "D1405le.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸に満ちる想いを決意に代えて燃やす朝が来る。",
   "ko_candidate": "가슴에 가득한 마음을 결의로 바꿔 불태우는 아침이 온다｡"
  },
  {
   "id": 37465,
   "key": "D1405le.txt:474",
   "file": "D1405le.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦士達の朝が来る。",
   "ko_candidate": "전사들의 아침이 온다｡"
  },
  {
   "id": 37466,
   "key": "D1405le.txt:478",
   "file": "D1405le.txt",
   "line": 478,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカさん」",
   "ko_candidate": "「……라이카 씨」"
  },
  {
   "id": 37467,
   "key": "D1405le.txt:481",
   "file": "D1405le.txt",
   "line": 481,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強く、強くライカさんの面影を想い浮かべる。",
   "ko_candidate": "강하게､ 강하게 라이카 씨의 모습을 떠올린다｡"
  },
  {
   "id": 37468,
   "key": "D1405le.txt:482",
   "file": "D1405le.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心に刻めつけるほどに激しく。",
   "ko_candidate": "마음에 새길 정도로 격렬하게｡"
  },
  {
   "id": 37469,
   "key": "D1405le.txt:483",
   "file": "D1405le.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸に灼きつけるほどに熱く。",
   "ko_candidate": "가슴에 새겨질 정도로 뜨겁게｡"
  },
  {
   "id": 37470,
   "key": "D1405le.txt:487",
   "file": "D1405le.txt",
   "line": 487,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカさん」",
   "ko_candidate": "「……라이카 씨」"
  },
  {
   "id": 37471,
   "key": "D1405le.txt:490",
   "file": "D1405le.txt",
   "line": 490,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この想いが、俺に決意を強固とする。",
   "ko_candidate": "이 마음이 나의 결의를 굳건하게 한다｡"
  },
  {
   "id": 37472,
   "key": "D1405le.txt:491",
   "file": "D1405le.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "決して、決して敗れはしない。",
   "ko_candidate": "결코､ 결코 패배하지 않을 것이다｡"
  },
  {
   "id": 37473,
   "key": "D1405le.txt:497",
   "file": "D1405le.txt",
   "line": 497,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさん！」",
   "ko_candidate": "「라이카 씨!」"
  },
  {
   "id": 37474,
   "key": "D1405le.txt:501",
   "file": "D1405le.txt",
   "line": 501,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うおっ」",
   "ko_candidate": "「우옷」"
  },
  {
   "id": 37475,
   "key": "D1405le.txt:504",
   "file": "D1405le.txt",
   "line": 504,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昂ぶった感情が魔力と融け合い、爆裂し、大気を震わせる。",
   "ko_candidate": "고조된 감정이 마력과 융합되어 폭발하고､ 대기를 진동시킨다｡"
  },
  {
   "id": 37476,
   "key": "D1405le.txt:505",
   "file": "D1405le.txt",
   "line": 505,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "限界を超えて溢れた魔力は紫電を帯び、俺の周囲で放電していた。",
   "ko_candidate": "한계를 넘어 넘쳐난 마력은 자색 번개를 띠고､ 내 주위에서 방전하고 있었다｡"
  },
  {
   "id": 37477,
   "key": "D1405le.txt:507",
   "file": "D1405le.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もはやライカさんは、俺にとって掛け替えのない存在だ。",
   "ko_candidate": "이제 라이카 씨는 나에게 있어 대체할 수 없는 존재다｡"
  },
  {
   "id": 37478,
   "key": "D1405le.txt:508",
   "file": "D1405le.txt",
   "line": 508,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女が居ない世界など想像できない。",
   "ko_candidate": "그녀가 없는 세상은 상상할 수 없다｡"
  },
  {
   "id": 37479,
   "key": "D1405le.txt:510",
   "file": "D1405le.txt",
   "line": 510,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶対にライカさんを救い出す。",
   "ko_candidate": "절대로 라이카 씨를 구해낼 것이다｡"
  },
  {
   "id": 37480,
   "key": "D1405le.txt:511",
   "file": "D1405le.txt",
   "line": 511,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの笑顔を、俺の元に取り戻す。",
   "ko_candidate": "그 미소를 내 곁으로 되찾아올 것이다｡"
  },
  {
   "id": 37481,
   "key": "D1405le.txt:512",
   "file": "D1405le.txt",
   "line": 512,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その邪魔をするなら……神も邪神も関係ない。",
   "ko_candidate": "그것을 방해한다면…… 신이든 사신이든 상관없다｡"
  },
  {
   "id": 37482,
   "key": "D1405le.txt:513",
   "file": "D1405le.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "根こそぎデモンベインで叩っ斬ってやる！",
   "ko_candidate": "뿌리째 데몬베인으로 쳐부숴 주겠어!"
  },
  {
   "id": 37483,
   "key": "D1405le.txt:517",
   "file": "D1405le.txt",
   "line": 517,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふぅ……気合は充分過ぎるようだな。 ならば……征くぞ、九郎！」",
   "ko_candidate": "「후우…… 기합은 충분한 것 같구나｡ 그렇다면…… 가자､ 쿠로!」"
  },
  {
   "id": 37484,
   "key": "D1405le.txt:522",
   "file": "D1405le.txt",
   "line": 522,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――応ッ！」",
   "ko_candidate": "「――네!」"
  },
  {
   "id": 37485,
   "key": "D1405ru.txt:8",
   "file": "D1405ru.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "破壊の劫火に舐め尽された、アーカムシティ。",
   "ko_candidate": "파괴의 겁화에 휩싸인 아캄시티｡"
  },
  {
   "id": 37486,
   "key": "D1405ru.txt:9",
   "file": "D1405ru.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "折り重なるような破壊の傷痕。",
   "ko_candidate": "겹겹이 쌓인 듯한 파괴의 상흔｡"
  },
  {
   "id": 37487,
   "key": "D1405ru.txt:10",
   "file": "D1405ru.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "広大な『無』の荒野の極々小さな一点。",
   "ko_candidate": "광대한 『무』의 황야의 극히 작은 한 점｡"
  }
 ]
}