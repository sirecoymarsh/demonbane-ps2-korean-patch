 "items": [
  {
   "id": 39339,
   "key": "D1411ru.txt:376",
   "file": "D1411ru.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "八方塞がり……魔銃では無理だということか？",
   "ko_candidate": "사방이 막혔어… 마총으로는 무리라는 건가?"
  },
  {
   "id": 39340,
   "key": "D1411ru.txt:378",
   "file": "D1411ru.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲。",
   "ko_candidate": "장갑｡"
  },
  {
   "id": 39341,
   "key": "D1411ru.txt:379",
   "file": "D1411ru.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔法障壁。",
   "ko_candidate": "마법 장벽｡"
  },
  {
   "id": 39342,
   "key": "D1411ru.txt:380",
   "file": "D1411ru.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あまりにも堅固すぎる、二重の城壁。",
   "ko_candidate": "너무나도 견고한 이중의 성벽｡"
  },
  {
   "id": 39343,
   "key": "D1411ru.txt:383",
   "file": "D1411ru.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どちらかを無効化できれば、どちらかの魔銃が通用するのだが――",
   "ko_candidate": "둘 중 하나를 무효화할 수 있다면､ 둘 중 하나의 마총이 통할 텐데――"
  },
  {
   "id": 39344,
   "key": "D1411ru.txt:384",
   "file": "D1411ru.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……どちらかを？",
   "ko_candidate": "…둘 중 하나를?"
  },
  {
   "id": 39345,
   "key": "D1411ru.txt:387",
   "file": "D1411ru.txt",
   "line": 387,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――そうか！」",
   "ko_candidate": "「――그렇구나!」"
  },
  {
   "id": 39346,
   "key": "D1411ru.txt:390",
   "file": "D1411ru.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この方法ならば……！",
   "ko_candidate": "이 방법이라면…!"
  },
  {
   "id": 39347,
   "key": "D1411ru.txt:392",
   "file": "D1411ru.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸を再装填する。",
   "ko_candidate": "탄환을 재장전한다｡"
  },
  {
   "id": 39348,
   "key": "D1411ru.txt:398",
   "file": "D1411ru.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は再び二挺魔銃を、レガシー・オブ・ゴールドに向けた。",
   "ko_candidate": "나는 다시 두 자루의 마총을 레거시 오브 골드를 향해 겨눴다｡"
  },
  {
   "id": 39349,
   "key": "D1411ru.txt:403",
   "file": "D1411ru.txt",
   "line": 403,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………？　九郎、どうするつもりだ？」",
   "ko_candidate": "「…? 쿠로､ 뭘 하려는 거야?」"
  },
  {
   "id": 39350,
   "key": "D1411ru.txt:408",
   "file": "D1411ru.txt",
   "line": 408,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ、見てなって！」",
   "ko_candidate": "「뭐､ 보고 있어!」"
  },
  {
   "id": 39351,
   "key": "D1411ru.txt:413",
   "file": "D1411ru.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアのモードをフルオートに変えて、連射する。",
   "ko_candidate": "크투가의 모드를 풀오토로 바꾸고､ 연사한다｡"
  },
  {
   "id": 39352,
   "key": "D1411ru.txt:425",
   "file": "D1411ru.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声が連なって、爆音となって、轟いた。",
   "ko_candidate": "총성이 이어져 폭음이 되어 울려 퍼졌다｡"
  },
  {
   "id": 39353,
   "key": "D1411ru.txt:427",
   "file": "D1411ru.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マズル・フラッシュが重なって、爆光となって、紅の空間を灼いた。",
   "ko_candidate": "머즐 플래시가 겹쳐져 폭광이 되어 붉은 공간을 태웠다｡"
  },
  {
   "id": 39354,
   "key": "D1411ru.txt:436",
   "file": "D1411ru.txt",
   "line": 436,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「無駄だというのが分からないのか！　悲しいな、大十字九郎！」",
   "ko_candidate": "「헛수고라는 걸 모르겠나! 슬프구나､ 다이쥬지 쿠로!」"
  },
  {
   "id": 39355,
   "key": "D1411ru.txt:439",
   "file": "D1411ru.txt",
   "line": 439,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かにクトゥグアでは、防御陣を突破するのが限界だ。",
   "ko_candidate": "확실히 크투가로는 방어진을 돌파하는 게 한계다｡"
  },
  {
   "id": 39356,
   "key": "D1411ru.txt:441",
   "file": "D1411ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう――防御陣を突破できるのだ。",
   "ko_candidate": "그래――방어진을 돌파할 수 있다는 거다｡"
  },
  {
   "id": 39357,
   "key": "D1411ru.txt:443",
   "file": "D1411ru.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば……！",
   "ko_candidate": "그렇다면…!"
  },
  {
   "id": 39358,
   "key": "D1411ru.txt:459",
   "file": "D1411ru.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まったく間を置かず、今度はイタクァを続けざまに発砲した。",
   "ko_candidate": "전혀 간격을 두지 않고､ 이번에는 이타콰를 연이어 발포했다｡"
  },
  {
   "id": 39359,
   "key": "D1411ru.txt:462",
   "file": "D1411ru.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "６発をゼロコンマ秒のスピードで撃ち尽くす。",
   "ko_candidate": "6발을 제로 콤마 초의 속도로 쏘아댔다｡"
  },
  {
   "id": 39360,
   "key": "D1411ru.txt:468",
   "file": "D1411ru.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無駄に乱射しているワケじゃあない――！",
   "ko_candidate": "무의미하게 난사하는 게 아니야――!"
  },
  {
   "id": 39361,
   "key": "D1411ru.txt:474",
   "file": "D1411ru.txt",
   "line": 474,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふははははは！」 「……何ぃ!?」",
   "ko_candidate": "「후하하하하! …뭐라고!?」"
  },
  {
   "id": 39362,
   "key": "D1411ru.txt:482",
   "file": "D1411ru.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、音速を超える神速の領域で、俺の術は、俺の意図は完成する。",
   "ko_candidate": "그리고､ 음속을 초월하는 신속의 영역에서､ 내 술식은､ 내 의도는 완성된다｡"
  },
  {
   "id": 39363,
   "key": "D1411ru.txt:489",
   "file": "D1411ru.txt",
   "line": 489,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先を疾るクトゥグアの魔弾の、ぴったり真後ろに付いて飛翔する、イタクァの魔弾。",
   "ko_candidate": "앞서 달리는 크투가의 마탄의､ 바로 뒤에 붙어 비행하는､ 이타콰의 마탄｡"
  },
  {
   "id": 39364,
   "key": "D1411ru.txt:491",
   "file": "D1411ru.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "６発の魔弾は全部、クトゥグアの火弾の影に隠れたのだ。",
   "ko_candidate": "6발의 마탄은 전부､ 크투가의 화탄의 그림자에 숨었다｡"
  },
  {
   "id": 39365,
   "key": "D1411ru.txt:493",
   "file": "D1411ru.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "イタクァの性能だからこそ実現できる、奇蹟。怪異。",
   "ko_candidate": "이타콰의 성능이기에 실현할 수 있는､ 기적｡ 괴이｡"
  },
  {
   "id": 39366,
   "key": "D1411ru.txt:495",
   "file": "D1411ru.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "整列した魔弾の軍勢は、レガシー・オブ・ゴールドまでの距離を、一瞬で疾駆する。",
   "ko_candidate": "정렬한 마탄의 군대는､ 레거시 오브 골드까지의 거리를､ 순식간에 질주한다｡"
  },
  {
   "id": 39367,
   "key": "D1411ru.txt:497",
   "file": "D1411ru.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアの弾丸が、魔法障壁に触れた。",
   "ko_candidate": "크투가의 탄환이､ 마법 장벽에 닿았다｡"
  },
  {
   "id": 39368,
   "key": "D1411ru.txt:502",
   "file": "D1411ru.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "圧倒的破壊力を以て、障壁を貫く弾丸。",
   "ko_candidate": "압도적인 파괴력으로､ 장벽을 관통하는 탄환｡"
  },
  {
   "id": 39369,
   "key": "D1411ru.txt:504",
   "file": "D1411ru.txt",
   "line": 504,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうして、生じた僅かな綻び。",
   "ko_candidate": "그렇게 해서､ 생긴 미세한 틈｡"
  },
  {
   "id": 39370,
   "key": "D1411ru.txt:506",
   "file": "D1411ru.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを一ミリの狂い無く、正確に通過するイタクァの弾丸。",
   "ko_candidate": "그것을 1밀리의 오차도 없이､ 정확하게 통과하는 이타콰의 탄환｡"
  },
  {
   "id": 39371,
   "key": "D1411ru.txt:508",
   "file": "D1411ru.txt",
   "line": 508,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアの弾丸は、見事、イタクァの魔弾を、敵の防御陣内へと導いたのだ。なら、もはやこの正確無比、冷酷無情の狩人を阻める障害は何も無い！",
   "ko_candidate": "크투가의 탄환은､ 훌륭하게､ 이타콰의 마탄을､ 적의 방어진 안으로 인도했다｡ 그렇다면､ 이제 이 정확무비하고 냉혹무정한 사냥꾼을 막을 장애물은 아무것도 없다!"
  },
  {
   "id": 39372,
   "key": "D1411ru.txt:510",
   "file": "D1411ru.txt",
   "line": 510,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "６発の弾丸は、その兇暴な牙をレガシー・オブ・ゴールドの急所に突き立てる！",
   "ko_candidate": "6발의 탄환은､ 그 흉포한 이빨을 레거시 오브 골드의 급소에 박아 넣는다!"
  },
  {
   "id": 39373,
   "key": "D1411ru.txt:520",
   "file": "D1411ru.txt",
   "line": 520,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐうぅぅぅぅ!?」",
   "ko_candidate": "「크으으으으!?」"
  },
  {
   "id": 39374,
   "key": "D1411ru.txt:523",
   "file": "D1411ru.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲の隙間を突いて、レガシー・オブ・ゴールドを貫く弾丸。",
   "ko_candidate": "장갑의 틈새를 찔러､ 레거시 오브 골드를 관통하는 탄환｡"
  },
  {
   "id": 39375,
   "key": "D1411ru.txt:525",
   "file": "D1411ru.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "内部から爆炎が噴き出て、紫電が迸った。",
   "ko_candidate": "내부에서 폭염이 뿜어져 나오고､ 자줏빛 번개가 튀었다｡"
  },
  {
   "id": 39376,
   "key": "D1411ru.txt:527",
   "file": "D1411ru.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "グラリと揺らぐ巨体。",
   "ko_candidate": "흔들리는 거대한 몸체｡"
  },
  {
   "id": 39377,
   "key": "D1411ru.txt:538",
   "file": "D1411ru.txt",
   "line": 538,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「成程……そう云う事か！　考えたな、九郎！」",
   "ko_candidate": "「과연… 그런 거였군! 잘 생각했어､ 쿠로!」"
  },
  {
   "id": 39378,
   "key": "D1411ru.txt:542",
   "file": "D1411ru.txt",
   "line": 542,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……だが、まだだ！」",
   "ko_candidate": "「그래… 하지만､ 아직이야!」"
  }
 ]
}