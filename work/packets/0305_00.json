   "jp": "マズイどころじゃねえ！",
   "ko_candidate": "위험한 정도가 아니야!"
  },
  {
   "id": 3136,
   "key": "D0305.txt:199",
   "file": "D0305.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
