   "line": 225,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良いから早くしやがれっ！」",
   "ko_candidate": "「앗! 이봐! 너､ 또!」"
  },
  {
