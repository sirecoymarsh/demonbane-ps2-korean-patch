   "key": "D0305.txt:158",
   "file": "D0305.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲車から真っ先に降りてきた警官と目が合った。",
   "ko_candidate": "장갑차에서 제일 먼저 내린 경찰관들과 눈이 마주쳤다｡"
