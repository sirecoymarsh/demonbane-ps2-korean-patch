   "speaker": "瑠璃 / ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……」 「……九郎ちゃんっ」",
   "ko_candidate": "「큿…」"
  },
  {
   "id": 9153,
   "key": "D0709.txt:542",
   "file": "D0709.txt",
   "line": 542,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………」",
   "ko_candidate": "「…쿠로 군!」"
