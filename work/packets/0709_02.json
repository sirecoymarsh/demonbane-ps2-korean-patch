   "file": "D0709.txt",
   "line": 732,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちょうど、そのタイミングだった。",
   "ko_candidate": "마침 그 타이밍이었다｡"
