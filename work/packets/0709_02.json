   "key": "D0709.txt:703",
   "file": "D0709.txt",
   "line": 703,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "再び船が大きく揺れた。",
   "ko_candidate": "다시､ 배가 크게 흔들렸다｡"
  },
  {
