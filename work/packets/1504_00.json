 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "ヨグ＝ソトース": "요그 소토스",
  "エルザ": "엘자"
 },
 "items": [
  {
   "id": 42130,
   "key": "D1504al.txt:28",
   "file": "D1504al.txt",
   "line": 28,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「一晩だけ待つ。 それで決断するが良い」 「――征くか、留まるか」",
   "ko_candidate": "「하룻밤만 기다려｡ 그리고 결단하도록 해｡ ――나아갈 것인가､ 머무를 것인가」"
  },
  {
   "id": 42131,
   "key": "D1504al.txt:51",
   "file": "D1504al.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かにそう言った。",
   "ko_candidate": "분명 그렇게 말했다｡"
  },
  {
   "id": 42132,
   "key": "D1504al.txt:53",
   "file": "D1504al.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かにそう言ったが――実のところ、少女には分かっていた。",
   "ko_candidate": "분명 그렇게 말했지만――사실､ 소녀는 알고 있었다｡"
  },
  {
   "id": 42133,
   "key": "D1504al.txt:55",
   "file": "D1504al.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "青年が下すであろう決断を。",
   "ko_candidate": "청년이 내릴 결단을｡"
  },
  {
   "id": 42134,
   "key": "D1504al.txt:58",
   "file": "D1504al.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処で退くような男ならば、遠の昔に少女の許から去っていたはずだから。",
   "ko_candidate": "여기서 물러설 만한 남자라면､ 이미 오래전에 소녀의 곁을 떠났을 테니까｡"
  },
  {
   "id": 42135,
   "key": "D1504al.txt:61",
   "file": "D1504al.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな男であるからこそ、今まで戦い続けたのだから。",
   "ko_candidate": "그런 남자이기에､ 지금까지 계속 싸워왔으니까｡"
  },
  {
   "id": 42136,
   "key": "D1504al.txt:64",
   "file": "D1504al.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして。",
   "ko_candidate": "그리고｡"
  },
  {
   "id": 42137,
   "key": "D1504al.txt:73",
   "file": "D1504al.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな男であるからこそ、今までずっと一緒に居られた。",
   "ko_candidate": "그런 남자이기에､ 지금까지 계속 함께 있을 수 있었다｡"
  },
  {
   "id": 42138,
   "key": "D1504al.txt:82",
   "file": "D1504al.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんな男であるからこそ、一緒に居て心地良かった。",
   "ko_candidate": "그런 남자이기에､ 함께 있어 편안했다｡"
  },
  {
   "id": 42139,
   "key": "D1504al.txt:91",
   "file": "D1504al.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな男であるからこそ、自分は死すら超えて彼の許に舞い戻った。",
   "ko_candidate": "그런 남자이기에､ 자신은 죽음마저 넘어､ 그의 곁으로"
  },
  {
   "id": 42140,
   "key": "D1504al.txt:98",
   "file": "D1504al.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんな男であるからこそ、妾は――",
   "ko_candidate": "되돌아왔다｡ 그런 남자이기에､ 첩은――"
  },
  {
   "id": 42141,
   "key": "D1504al.txt:107",
   "file": "D1504al.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今や少女にとって彼は、かけがえのない程に大きな存在になっていた。",
   "ko_candidate": "이제 소녀에게 그는､ 대체할 수 없을 만큼 큰 존재가 되어"
  },
  {
   "id": 42142,
   "key": "D1504al.txt:110",
   "file": "D1504al.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "彼女自身の命運をも左右する程に、大きな存在になっていた。",
   "ko_candidate": "있었다｡ 그녀 자신의 운명마저 좌우할 만큼､ 큰 존재가 되어 있었다｡"
  },
  {
   "id": 42143,
   "key": "D1504al.txt:113",
   "file": "D1504al.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女は既に、自分の気持ちをはっきりと理解した。",
   "ko_candidate": "소녀는 이미､ 자신의 마음을 분명히 이해했다｡"
  },
  {
   "id": 42144,
   "key": "D1504al.txt:114",
   "file": "D1504al.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分の抱く想いが、ヒトの何と云う感情に値するか、理解していた。",
   "ko_candidate": "자신이 품은 마음이､ 인간의 어떤 감정에 해당하는지､ 이해하고 있었다｡"
  },
  {
   "id": 42145,
   "key": "D1504al.txt:117",
   "file": "D1504al.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は、九郎を――",
   "ko_candidate": "첩은､ 쿠로를――"
  },
  {
   "id": 42146,
   "key": "D1504al.txt:124",
   "file": "D1504al.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼の傍に居たい。",
   "ko_candidate": "그의 곁에 있고 싶다｡"
  },
  {
   "id": 42147,
   "key": "D1504al.txt:125",
   "file": "D1504al.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分の傍に居て欲しい。",
   "ko_candidate": "자신의 곁에 있어 주길 바란다｡"
  },
  {
   "id": 42148,
   "key": "D1504al.txt:127",
   "file": "D1504al.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつも、いつも。",
   "ko_candidate": "언제나､ 언제나｡"
  },
  {
   "id": 42149,
   "key": "D1504al.txt:128",
   "file": "D1504al.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ずっと、ずっと。",
   "ko_candidate": "계속､ 계속｡"
  },
  {
   "id": 42150,
   "key": "D1504al.txt:131",
   "file": "D1504al.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "命が尽きるまで。",
   "ko_candidate": "목숨이 다할 때까지｡"
  },
  {
   "id": 42151,
   "key": "D1504al.txt:132",
   "file": "D1504al.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魂が朽ちるまで。",
   "ko_candidate": "영혼이 썩을 때까지｡"
  },
  {
   "id": 42152,
   "key": "D1504al.txt:133",
   "file": "D1504al.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時が果てるまで。",
   "ko_candidate": "시간이 끝날 때까지｡"
  },
  {
   "id": 42153,
   "key": "D1504al.txt:136",
   "file": "D1504al.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつまでも、いつまでも。",
   "ko_candidate": "언제까지나､ 언제까지나｡"
  },
  {
   "id": 42154,
   "key": "D1504al.txt:137",
   "file": "D1504al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "永遠に、ずっと一緒に。",
   "ko_candidate": "영원히､ 계속 함께｡"
  },
  {
   "id": 42155,
   "key": "D1504al.txt:140",
   "file": "D1504al.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは戦う事しか識らなかった少女に初めて芽生えた、痛切なほどに、ささやかな願いだった。",
   "ko_candidate": "그것은 싸우는 것밖에 몰랐던 소녀에게 처음 싹튼､ 절절할 만큼､ 소박한 소원이었다｡"
  },
  {
   "id": 42156,
   "key": "D1504al.txt:143",
   "file": "D1504al.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛切なほどに強く激しく狂おしく求める、剥き出しの願望だった。",
   "ko_candidate": "절절할 만큼 강렬하고 격렬하게 미치도록 갈구하는､ 적나라한 염원이었다｡"
  },
  {
   "id": 42157,
   "key": "D1504al.txt:146",
   "file": "D1504al.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何を犠牲にしても惜しくない程に昏く熱く歪んだ、剥き出しの欲望だった。",
   "ko_candidate": "무엇을 희생해도 아깝지 않을 만큼 어둡고 뜨겁고 뒤틀린､ 적나라한 욕망 이었다｡"
  },
  {
   "id": 42158,
   "key": "D1504al.txt:153",
   "file": "D1504al.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、同時に理解する。",
   "ko_candidate": "그리고､ 동시에 이해한다｡"
  },
  {
   "id": 42159,
   "key": "D1504al.txt:156",
   "file": "D1504al.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その願いは、決して叶えられない事を。",
   "ko_candidate": "그 소원은､ 결코 이루어질 수 없다는 것을｡"
  },
  {
   "id": 42160,
   "key": "D1504al.txt:157",
   "file": "D1504al.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "決して叶えてはいけない事を。",
   "ko_candidate": "이제는､ 결코 이루어서는 안 된다는 것을｡"
  },
  {
   "id": 42161,
   "key": "D1504al.txt:165",
   "file": "D1504al.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヨグ＝ソトースの門の向こう。",
   "ko_candidate": "요그 소토스의 문 너머｡"
  },
  {
   "id": 42162,
   "key": "D1504al.txt:166",
   "file": "D1504al.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其処は最早、人間の領域ではない。",
   "ko_candidate": "그곳은 이미､ 인간의 영역이 아니다｡"
  },
  {
   "id": 42163,
   "key": "D1504al.txt:169",
   "file": "D1504al.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "神の領域。異形の領域。",
   "ko_candidate": "신의 영역｡ 기괴한 존재의 영역｡"
  },
  {
   "id": 42164,
   "key": "D1504al.txt:170",
   "file": "D1504al.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂気と邪悪が哄笑する領域だ。",
   "ko_candidate": "광기와 사악함이 떠들썩거리는 영역이다｡"
  },
  {
   "id": 42165,
   "key": "D1504al.txt:173",
   "file": "D1504al.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人間が存在して善い、領域ではない。",
   "ko_candidate": "인간이 존재해서는 안 되는､ 영역이 아니다｡"
  },
  {
   "id": 42166,
   "key": "D1504al.txt:180",
   "file": "D1504al.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから。",
   "ko_candidate": "그러니｡"
  },
  {
   "id": 42167,
   "key": "D1504al.txt:181",
   "file": "D1504al.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう。",
   "ko_candidate": "이제｡"
  },
  {
   "id": 42168,
   "key": "D1504al.txt:182",
   "file": "D1504al.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これ以上は――",
   "ko_candidate": "이 이상은――"
  },
  {
   "id": 42169,
   "key": "D1504al.txt:196",
   "file": "D1504al.txt",
   "line": 196,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「エルザ、左手の反応を調べるのである……凡人眼鏡はステータスから目を逸らすなである」",
   "ko_candidate": "「엘자､ 왼손의 반응을 조사하도록 하라……범인 안경은 상태창에서 눈을 떼지 말도록 하라」"
  }
 ]
}