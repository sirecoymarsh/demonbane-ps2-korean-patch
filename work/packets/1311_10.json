  "rate": 0.833
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "姫さん": "공주님",
  "デモンベイン": "데몬베인",
  "ロードビヤーキー": "로드 비야키",
  "アル": "알",
  "魔導書": "마도서",
  "魔力": "마력",
  "シャンタク": "샨타크",
  "デウス・マキナ": "데우스 마키나",
  "アイオーン": "아이온",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 35386,
   "key": "D1311ru.txt:285",
   "file": "D1311ru.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃口を囲んで浮かび上がる、魔術文字。",
   "ko_candidate": "총구를 둘러싸고 떠오르는 마술 문자｡"
  },
  {
   "id": 35387,
   "key": "D1311ru.txt:290",
   "file": "D1311ru.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術文字の輝きが銃口に吸い込まれ、その奥で威力を宿した光と化して、兇暴な唸り声を上げて、溢れ出す。",
   "ko_candidate": "마술 문자의 빛이 총구에 빨려 들어가고､ 그 안에서 위력을 담은 빛으로 변해 흉포한 신음 소리를 내며 넘쳐 나온다｡"
  },
  {
   "id": 35388,
   "key": "D1311ru.txt:291",
   "file": "D1311ru.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊の光弾が放たれた。",
   "ko_candidate": "파괴의 광탄이 발사되었다｡"
  },
  {
   "id": 35389,
   "key": "D1311ru.txt:296",
   "file": "D1311ru.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、それよりも遥かに速く――俺たちの前に、巨大な鋼鉄が聳え立った。",
   "ko_candidate": "그리고 그보다 훨씬 더 빠르게――우리 앞에 거대한 강철이 우뚝 솟아올랐다｡"
  },
  {
   "id": 35390,
   "key": "D1311ru.txt:300",
   "file": "D1311ru.txt",
   "line": 300,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これは――！」",
   "ko_candidate": "「이건――!」"
  },
  {
   "id": 35391,
   "key": "D1311ru.txt:304",
   "file": "D1311ru.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちの代わりに、光弾の直撃を受ける。",
   "ko_candidate": "우리 대신 광탄의 직격을 받는다｡"
  },
  {
   "id": 35392,
   "key": "D1311ru.txt:307",
   "file": "D1311ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音と閃光。",
   "ko_candidate": "폭음과 섬광｡"
  },
  {
   "id": 35393,
   "key": "D1311ru.txt:308",
   "file": "D1311ru.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが巨大な鋼鉄は身じろぎもしない。",
   "ko_candidate": "하지만 거대한 강철은 꿈쩍도 하지 않는다｡"
  },
  {
   "id": 35394,
   "key": "D1311ru.txt:312",
   "file": "D1311ru.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その隙に俺は近くのビルの屋上へと着地した。姫さんたちを降ろす。",
   "ko_candidate": "그 틈에 나는 근처 빌딩 옥상으로 착지했다｡ 공주님들을 내려놓는다｡"
  },
  {
   "id": 35395,
   "key": "D1311ru.txt:319",
   "file": "D1311ru.txt",
   "line": 319,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何故…… 誰も乗っていないのに……」",
   "ko_candidate": "「왜……아무도 타고 있지 않은데……」"
  },
  {
   "id": 35396,
   "key": "D1311ru.txt:323",
   "file": "D1311ru.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんもまた、呆然と空中に浮かぶソレを見上げる。",
   "ko_candidate": "공주님도 역시 멍하니 공중에 떠 있는 그것을 올려다본다｡"
  },
  {
   "id": 35397,
   "key": "D1311ru.txt:324",
   "file": "D1311ru.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無理もない。俺だって驚いている。",
   "ko_candidate": "무리도 아니다｡ 나도 놀라고 있다｡"
  },
  {
   "id": 35398,
   "key": "D1311ru.txt:325",
   "file": "D1311ru.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何で、コイツがここに……？",
   "ko_candidate": "왜 이놈이 여기에……?"
  },
  {
   "id": 35399,
   "key": "D1311ru.txt:334",
   "file": "D1311ru.txt",
   "line": 334,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……デモンベイン」",
   "ko_candidate": "「……데몬베인」"
  },
  {
   "id": 35400,
   "key": "D1311ru.txt:341",
   "file": "D1311ru.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滞空したまま、ロードビヤーキーと対峙する巨大な鋼鉄。",
   "ko_candidate": "공중에 떠 있는 채로 로드 비야키와 대치하는 거대한 강철｡"
  },
  {
   "id": 35401,
   "key": "D1311ru.txt:343",
   "file": "D1311ru.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "見間違いようもなく、デモンベインだった。",
   "ko_candidate": "틀림없이 데몬베인이었다｡"
  },
  {
   "id": 35402,
   "key": "D1311ru.txt:345",
   "file": "D1311ru.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうして？　誰も乗っていないのに、それどころかアルの……魔導書の力も無しでどうやって？",
   "ko_candidate": "어째서? 아무도 타고 있지 않은데､ 그것도 알의…… 마도서의 힘도 없이 어떻게?"
  },
  {
   "id": 35403,
   "key": "D1311ru.txt:346",
   "file": "D1311ru.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それとも……別の誰かが操縦しているのか？　まさか。",
   "ko_candidate": "아니면…… 다른 누군가가 조종하고 있는 건가? 설마｡"
  },
  {
   "id": 35404,
   "key": "D1311ru.txt:350",
   "file": "D1311ru.txt",
   "line": 350,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それに、あの背中……」",
   "ko_candidate": "「게다가 저 등……」"
  },
  {
   "id": 35405,
   "key": "D1311ru.txt:353",
   "file": "D1311ru.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。ソレは見間違えようもなくデモンベインだったが、でも違う箇所が一点だけあった。",
   "ko_candidate": "그렇다｡ 그것은 틀림없이 데몬베인이었지만､ 다른 점이 딱 하나 있었다｡"
  },
  {
   "id": 35406,
   "key": "D1311ru.txt:355",
   "file": "D1311ru.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインの背中。",
   "ko_candidate": "데몬베인의 등｡"
  },
  {
   "id": 35407,
   "key": "D1311ru.txt:357",
   "file": "D1311ru.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い、鋼鉄で編まれたマントのようなモノが装着されていた。",
   "ko_candidate": "검은､ 강철로 짜인 망토 같은 것이 장착되어 있었다｡"
  },
  {
   "id": 35408,
   "key": "D1311ru.txt:358",
   "file": "D1311ru.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もしくは蝙蝠か、悪魔の翼のようにも見える。",
   "ko_candidate": "아니면 박쥐나､ 악마의 날개처럼도 보인다｡"
  },
  {
   "id": 35409,
   "key": "D1311ru.txt:360",
   "file": "D1311ru.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背中から広がる、鋼鉄の黒翼は焔のような魔力を、絶えず噴出している。",
   "ko_candidate": "등에서 펼쳐지는 강철의 검은 날개는 불꽃 같은 마력을､ 끊임없이 뿜어내고 있다｡"
  },
  {
   "id": 35410,
   "key": "D1311ru.txt:362",
   "file": "D1311ru.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛行能力を持たないデモンベインが、今こうして空を飛んでいるのは、どうもあの翼が原因のようだ。",
   "ko_candidate": "비행 능력이 없는 데몬베인이､ 지금 이렇게 하늘을 날고 있는 것은､ 아무래도 저 날개 때문인 것 같다｡"
  },
  {
   "id": 35411,
   "key": "D1311ru.txt:366",
   "file": "D1311ru.txt",
   "line": 366,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シャンタク」",
   "ko_candidate": "「샨타크」"
  },
  {
   "id": 35412,
   "key": "D1311ru.txt:369",
   "file": "D1311ru.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肩の上で、アルが呟いた。",
   "ko_candidate": "어깨 위에서､ 알이 중얼거렸다｡"
  },
  {
   "id": 35413,
   "key": "D1311ru.txt:373",
   "file": "D1311ru.txt",
   "line": 373,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だって？」",
   "ko_candidate": "「뭐라고?」"
  },
  {
   "id": 35414,
   "key": "D1311ru.txt:377",
   "file": "D1311ru.txt",
   "line": 377,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シャンタク。妾本来のデウス・マキナ、アイオーンの飛行ユニットだ」 「総ての頁が揃った今、ようやく招喚出来るようになったのだろう」",
   "ko_candidate": "「샨타크｡ 내 본래의 데우스 마키나､ 아이온의 비행 유닛이다｡ 모든 페이지가 갖춰진 지금､ 드디어 소환할 수 있게 된 모양이군」"
  },
  {
   "id": 35415,
   "key": "D1311ru.txt:384",
   "file": "D1311ru.txt",
   "line": 384,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「じゃあ、あれはアルが？」",
   "ko_candidate": "「그럼､ 저건 알이?」"
  },
  {
   "id": 35416,
   "key": "D1311ru.txt:388",
   "file": "D1311ru.txt",
   "line": 388,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「違う。妾は何もしておらん」 「……ったく、最後のページと云い、シャンタクと云い、今のデモンベインと云い――いったい何者の仕業だ？　何が目的だ？」",
   "ko_candidate": "「아니｡ 난 아무것도 하지 않았다｡ ……정말､ 마지막 페이지라든가､ 샨타크라든가､ 지금의 데몬베인이라든가―― 도대체 누구의 짓이지? 무엇이 목적이지?」"
  },
  {
   "id": 35417,
   "key": "D1311ru.txt:394",
   "file": "D1311ru.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺に訊かれたって、分かるはずがない。",
   "ko_candidate": "나한테 물어봤자､ 알 리가 없다｡"
  },
  {
   "id": 35418,
   "key": "D1311ru.txt:400",
   "file": "D1311ru.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眩暈。",
   "ko_candidate": "어지러움｡"
  },
  {
   "id": 35419,
   "key": "D1311ru.txt:401",
   "file": "D1311ru.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また、あの悪夢が染み込んで来たかのような、あの感覚。",
   "ko_candidate": "또､ 그 악몽이 스며들어온 것 같은､ 그 감각｡"
  },
  {
   "id": 35420,
   "key": "D1311ru.txt:402",
   "file": "D1311ru.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気のせい……か？",
   "ko_candidate": "기분 탓……인가?"
  },
  {
   "id": 35421,
   "key": "D1311ru.txt:406",
   "file": "D1311ru.txt",
   "line": 406,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――九郎！」",
   "ko_candidate": "「――쿠로!」"
  },
  {
   "id": 35422,
   "key": "D1311ru.txt:412",
   "file": "D1311ru.txt",
   "line": 412,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ん……ああ……？」",
   "ko_candidate": "「응……아아……?」"
  },
  {
   "id": 35423,
   "key": "D1311ru.txt:421",
   "file": "D1311ru.txt",
   "line": 421,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何を呆けておる。何者の意図かは知らぬが、デモンベインが此処に居るのだ。 ――戦うぞ！」",
   "ko_candidate": "「뭘 멍하니 있는 거냐｡ 누구의 의도인지는 모르겠지만､ 데몬베인이 여기 있다｡ ――싸우자!」"
  },
  {
   "id": 35424,
   "key": "D1311ru.txt:426",
   "file": "D1311ru.txt",
   "line": 426,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――っ！　あ、ああ！」",
   "ko_candidate": "「――읏! 아､ 그래!」"
  },
  {
   "id": 35425,
   "key": "D1311ru.txt:431",
   "file": "D1311ru.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。",
   "ko_candidate": "그렇다｡"
  }
 ]
}