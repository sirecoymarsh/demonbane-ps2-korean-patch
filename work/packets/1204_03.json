  {
   "id": 27292,
   "key": "D1204le.txt:148",
   "file": "D1204le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳びかかる人間魔導兵器５体。",
