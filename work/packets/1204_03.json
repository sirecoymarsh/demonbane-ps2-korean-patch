   "file": "D1204le.txt",
   "line": 160,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヘヴンズ・セイバー――天帝神罰剣。十字・断罪」",
   "ko_candidate": "「헤븐즈 세이버――천제신벌검｡ 십자?단죄」"
