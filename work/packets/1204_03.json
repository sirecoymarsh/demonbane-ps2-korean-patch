  },
  {
   "id": 27259,
   "key": "D1204le.txt:36",
   "file": "D1204le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "角を曲がると同時に飛び込む、通路を舐める爆炎。",
   "ko_candidate": "모퉁이를 돌자마자 날아드는､ 통로를 핥는 폭염｡"
  },
  {
   "id": 27260,
   "key": "D1204le.txt:37",
   "file": "D1204le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
