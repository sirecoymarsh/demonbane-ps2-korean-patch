   "ko_candidate": "그 수､ 11명｡ 아니――11『체』인가｡"
  },
  {
   "id": 27272,
   "key": "D1204le.txt:80",
   "file": "D1204le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦闘回路をアクティブモードへ移行。",
   "ko_candidate": "전투 회로를 액티브 모드로 이행｡"
