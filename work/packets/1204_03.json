   "key": "D1204le.txt:147",
   "file": "D1204le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "右腕が元に戻る。",
   "ko_candidate": "오른팔이 원래대로 돌아온다｡"
