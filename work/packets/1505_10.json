 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "魔力": "마력"
 },
 "items": [
  {
   "id": 43047,
   "key": "D1505le.txt:811",
   "file": "D1505le.txt",
   "line": 811,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……アラームの音が煩わしい。",
   "ko_candidate": "……알람 소리가 귀찮다｡"
  },
  {
   "id": 43048,
   "key": "D1505le.txt:812",
   "file": "D1505le.txt",
   "line": 812,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭に響く。頭痛が酷い。吐き気がする。",
   "ko_candidate": "머리가 울린다｡ 두통이 심하다｡ 구역질이 난다｡"
  },
  {
   "id": 43049,
   "key": "D1505le.txt:813",
   "file": "D1505le.txt",
   "line": 813,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あまりに辛いので、思わずその場に蹲った。",
   "ko_candidate": "너무 괴로워서 무심코 그 자리에 쪼그려 앉았다｡"
  },
  {
   "id": 43050,
   "key": "D1505le.txt:816",
   "file": "D1505le.txt",
   "line": 816,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟く銃声。",
   "ko_candidate": "요란한 총성｡"
  },
  {
   "id": 43051,
   "key": "D1505le.txt:817",
   "file": "D1505le.txt",
   "line": 817,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃弾が、躰を抉る。",
   "ko_candidate": "총알이 몸을 파고든다｡"
  },
  {
   "id": 43052,
   "key": "D1505le.txt:818",
   "file": "D1505le.txt",
   "line": 818,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嗚呼……だから、ウルサイってんだよ……！",
   "ko_candidate": "아아…… 그러니까､ 시끄럽다고 했잖아……!"
  },
  {
   "id": 43053,
   "key": "D1505le.txt:822",
   "file": "D1505le.txt",
   "line": 822,
   "speaker": "警備兵Ｅ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヒィィッ！　効かな――」",
   "ko_candidate": "「히이잇! 효과가 없――」"
  },
  {
   "id": 43054,
   "key": "D1505le.txt:829",
   "file": "D1505le.txt",
   "line": 829,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "噴き出る血――紅い。",
   "ko_candidate": "터져 나오는 피――붉다｡"
  },
  {
   "id": 43055,
   "key": "D1505le.txt:830",
   "file": "D1505le.txt",
   "line": 830,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燃える炎――紅い。",
   "ko_candidate": "타오르는 불꽃――붉다｡"
  },
  {
   "id": 43056,
   "key": "D1505le.txt:831",
   "file": "D1505le.txt",
   "line": 831,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "明滅するアラーム――紅い。",
   "ko_candidate": "명멸하는 알람――붉다｡ 봐､ 보라고｡"
  },
  {
   "id": 43057,
   "key": "D1505le.txt:833",
   "file": "D1505le.txt",
   "line": 833,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ほら、見てみろ。",
   "ko_candidate": "내 생각대로야｡"
  },
  {
   "id": 43058,
   "key": "D1505le.txt:834",
   "file": "D1505le.txt",
   "line": 834,
   "speaker": "警備兵Ｅ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "オレの思ったとおりだ。 「何でだよ！　こいつ、捕まって、封印されてたんじゃ……！」",
   "ko_candidate": "「왜 이래! 이놈､ 잡혀서 봉인되어 있었잖아……!」"
  },
  {
   "id": 43059,
   "key": "D1505le.txt:842",
   "file": "D1505le.txt",
   "line": 842,
   "speaker": "警備兵Ｄ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「５号の目的は４号だ！　何としても、儀式の間を死守しろ！」",
   "ko_candidate": "「5호의 목적은 4호다! 어떻게든 의식의 방을 사수해라!」"
  },
  {
   "id": 43060,
   "key": "D1505le.txt:849",
   "file": "D1505le.txt",
   "line": 849,
   "speaker": "警備兵Ｅ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「き、消え――!? がばぁらあっ！」",
   "ko_candidate": "「사､ 사라――!? 으아악!」"
  },
  {
   "id": 43061,
   "key": "D1505le.txt:857",
   "file": "D1505le.txt",
   "line": 857,
   "speaker": "警備兵Ｄ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なんて動きだ！　見えないぞ！」",
   "ko_candidate": "「어떤 움직임이야! 보이지 않아!」"
  },
  {
   "id": 43062,
   "key": "D1505le.txt:860",
   "file": "D1505le.txt",
   "line": 860,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あんなにも真っ白だった世界が、こんなにも真っ赤だ。",
   "ko_candidate": "그토록 하얬던 세상이 이렇게나 새빨갛다｡"
  },
  {
   "id": 43063,
   "key": "D1505le.txt:866",
   "file": "D1505le.txt",
   "line": 866,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なあ、ライカ。",
   "ko_candidate": "있잖아､ 라이카｡"
  },
  {
   "id": 43064,
   "key": "D1505le.txt:867",
   "file": "D1505le.txt",
   "line": 867,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これで分かっただろう？",
   "ko_candidate": "이제 알겠지?"
  },
  {
   "id": 43065,
   "key": "D1505le.txt:868",
   "file": "D1505le.txt",
   "line": 868,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何も恐れる必要はないんだ。こんなちっぽけな世界、いつだって壊せるんだ。",
   "ko_candidate": "아무것도 두려워할 필요 없어｡ 이런 조그만 세상､ 언제든 부술 수 있어｡"
  },
  {
   "id": 43066,
   "key": "D1505le.txt:870",
   "file": "D1505le.txt",
   "line": 870,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "オレ達を阻めるものなんて居ないんだ。",
   "ko_candidate": "우리를 막을 수 있는 건 아무도 없어｡"
  },
  {
   "id": 43067,
   "key": "D1505le.txt:872",
   "file": "D1505le.txt",
   "line": 872,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから、だから、いつか必ず、オレは姉さんを――",
   "ko_candidate": "그러니까､ 그러니까､ 언젠가 반드시､ 나는 누나를――"
  },
  {
   "id": 43068,
   "key": "D1505le.txt:876",
   "file": "D1505le.txt",
   "line": 876,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「―――ああ」",
   "ko_candidate": "「―――아아」"
  },
  {
   "id": 43069,
   "key": "D1505le.txt:879",
   "file": "D1505le.txt",
   "line": 879,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "炎の向こうに、見知った５つの顔があった。",
   "ko_candidate": "불꽃 너머로 익숙한 5개의 얼굴이 있었다｡"
  },
  {
   "id": 43070,
   "key": "D1505le.txt:880",
   "file": "D1505le.txt",
   "line": 880,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皆、オレと同じくらいの年頃の少女たち。",
   "ko_candidate": "모두 나와 비슷한 또래의 소녀들｡"
  },
  {
   "id": 43071,
   "key": "D1505le.txt:882",
   "file": "D1505le.txt",
   "line": 882,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この『施設』にやって来てからずっと、一緒に過ごして来た仲間たちだ。",
   "ko_candidate": "이 『시설』에 온 이후로 줄곧 함께 지내온 동료들이다｡"
  },
  {
   "id": 43072,
   "key": "D1505le.txt:886",
   "file": "D1505le.txt",
   "line": 886,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なんだ。君らも来たのか」",
   "ko_candidate": "「뭐야｡ 너희들도 왔구나」"
  },
  {
   "id": 43073,
   "key": "D1505le.txt:889",
   "file": "D1505le.txt",
   "line": 889,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女たちが身構える。",
   "ko_candidate": "소녀들이 자세를 잡는다｡"
  },
  {
   "id": 43074,
   "key": "D1505le.txt:890",
   "file": "D1505le.txt",
   "line": 890,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "オレの目には、彼女達に内蔵された魔導回路が稼動しているのが、光になって見える。",
   "ko_candidate": "내 눈에는 그녀들에게 내장된 마도 회로가 작동하는 것이 빛이 되어 보인다｡"
  },
  {
   "id": 43075,
   "key": "D1505le.txt:892",
   "file": "D1505le.txt",
   "line": 892,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いずれも戦闘態勢。",
   "ko_candidate": "모두 전투 태세｡"
  },
  {
   "id": 43076,
   "key": "D1505le.txt:896",
   "file": "D1505le.txt",
   "line": 896,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうか。君らも同じか。こんなくだらない場所に執着して……情けない」",
   "ko_candidate": "「그렇구나｡ 너희들도 똑같아｡ 이런 시시한 장소에 집착해서…… 한심하군」"
  },
  {
   "id": 43077,
   "key": "D1505le.txt:900",
   "file": "D1505le.txt",
   "line": 900,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女たちが一斉に動き出す。",
   "ko_candidate": "소녀들이 일제히 움직이기 시작한다｡"
  },
  {
   "id": 43078,
   "key": "D1505le.txt:902",
   "file": "D1505le.txt",
   "line": 902,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃が、銃弾が、光線が、魔力弾が、精神波が、迫り来る。",
   "ko_candidate": "칼날이､ 총알이､ 광선이､ 마력탄이､ 정신파가 다가온다｡"
  },
  {
   "id": 43079,
   "key": "D1505le.txt:903",
   "file": "D1505le.txt",
   "line": 903,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "警備兵よりも遥かに迅く、強く、正確無比な攻撃。",
   "ko_candidate": "경비병보다 훨씬 빠르고､ 강하고､ 정확무비한 공격｡"
  },
  {
   "id": 43080,
   "key": "D1505le.txt:904",
   "file": "D1505le.txt",
   "line": 904,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "規格外の、人間魔導兵器。",
   "ko_candidate": "규격 외의 인간 마도 병기｡"
  },
  {
   "id": 43081,
   "key": "D1505le.txt:905",
   "file": "D1505le.txt",
   "line": 905,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃対象を確実に抹消する、死の天使たち。",
   "ko_candidate": "공격 대상을 확실히 말소하는 죽음의 천사들｡"
  },
  {
   "id": 43082,
   "key": "D1505le.txt:912",
   "file": "D1505le.txt",
   "line": 912,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 43083,
   "key": "D1505le.txt:915",
   "file": "D1505le.txt",
   "line": 915,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "簡単なことだった。",
   "ko_candidate": "간단한 일이었다｡"
  },
  {
   "id": 43084,
   "key": "D1505le.txt:916",
   "file": "D1505le.txt",
   "line": 916,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "オレの方が、もっと迅くて強くて、正確だったから。",
   "ko_candidate": "내가 더 빠르고 강하고 정확했으니까｡"
  },
  {
   "id": 43085,
   "key": "D1505le.txt:918",
   "file": "D1505le.txt",
   "line": 918,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "躊躇もなかった。",
   "ko_candidate": "주저함도 없었다｡"
  },
  {
   "id": 43086,
   "key": "D1505le.txt:919",
   "file": "D1505le.txt",
   "line": 919,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女たちには所詮、ライカほどの価値はなかったから。",
   "ko_candidate": "그녀들에겐 결국 라이카만큼의 가치는 없었으니까｡"
  }
 ]
}