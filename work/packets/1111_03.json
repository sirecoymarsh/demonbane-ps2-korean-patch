 "items": [
  {
   "id": 26016,
   "key": "D1111le.txt:450",
   "file": "D1111le.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音が連続した。",
   "ko_candidate": "폭음이 연속됐다｡"
  },
  {
   "id": 26017,
   "key": "D1111le.txt:455",
   "file": "D1111le.txt",
   "line": 455,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああアアああああアアアアあああアあああ――――――ッ!?」",
   "ko_candidate": "「아아아아아아아아아아아아아아아――――――읏!?」"
  },
  {
   "id": 26018,
   "key": "D1111le.txt:462",
   "file": "D1111le.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クローを粉砕したハンティングホラーはそのまま掌を撃ち砕き、長く伸びた鋼鉄の腕を縦に、まるで豆腐でも千切るかのように、軽々と引き裂いていく！",
   "ko_candidate": "클로를 분쇄한 헌팅 호러는 그대로 손바닥을 부숴버리고､ 길게 뻗은 강철 팔을 세로로､ 마치 두부라도 찢어내듯이､ 가볍게 찢어나간다!"
  },
  {
   "id": 26019,
   "key": "D1111le.txt:464",
   "file": "D1111le.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音は鋼鉄の大蛇が搾り出す断末魔。だが、その断末魔をもハンティングホラーの咆吼は掻き消していく。",
   "ko_candidate": "폭음은 강철 대사가 짜내는 단말마｡ 하지만､ 그 단말마조차 헌팅 호러의 포효는 지워버린다｡"
  },
  {
   "id": 26020,
   "key": "D1111le.txt:466",
   "file": "D1111le.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２枚に下ろされたクラーケンの腕は、力なく大地に墜ちて、街を押し潰す。",
   "ko_candidate": "두 조각으로 갈라진 크라켄의 팔은､ 힘없이 대지에 떨어져､ 거리를 짓눌러버린다｡"
  },
  {
   "id": 26021,
   "key": "D1111le.txt:468",
   "file": "D1111le.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして光の槍と化したハンティングホラーは、そのままクラーケンの腹部……コクピットに突撃する！",
   "ko_candidate": "그리고 빛의 창이 된 헌팅 호러는､ 그대로 크라켄의 복부……콕핏에 돌진한다!"
  },
  {
   "id": 26022,
   "key": "D1111le.txt:473",
   "file": "D1111le.txt",
   "line": 473,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「い……ギゃあああああアアあああア――――――っっッっ！」",
   "ko_candidate": "「이……꺄아아아아아아아아아――――――읏!」"
  },
  {
   "id": 26023,
   "key": "D1111le.txt:476",
   "file": "D1111le.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラの口から、恐怖の悲鳴が上がる。",
   "ko_candidate": "칼리굴라의 입에서､ 공포의 비명이 터져 나온다｡"
  },
  {
   "id": 26024,
   "key": "D1111le.txt:477",
   "file": "D1111le.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティングホラーの動きが止まった。魔法障壁に阻まれたのだ。",
   "ko_candidate": "헌팅 호러의 움직임이 멈췄다｡ 마법 장벽에 막힌 것이다｡"
  },
  {
   "id": 26025,
   "key": "D1111le.txt:484",
   "file": "D1111le.txt",
   "line": 484,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 26026,
   "key": "D1111le.txt:488",
   "file": "D1111le.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらにアクセルを回す。",
   "ko_candidate": "더욱 액셀을 돌린다｡"
  },
  {
   "id": 26027,
   "key": "D1111le.txt:489",
   "file": "D1111le.txt",
   "line": 489,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音の如き咆吼と共に、ハンティングホラーのタイヤが赤熱する。",
   "ko_candidate": "폭음 같은 포효와 함께､ 헌팅 호러의 타이어가 붉게 달아오른다｡"
  },
  {
   "id": 26028,
   "key": "D1111le.txt:496",
   "file": "D1111le.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……押し進む。",
   "ko_candidate": "……밀고 나간다｡"
  },
  {
   "id": 26029,
   "key": "D1111le.txt:497",
   "file": "D1111le.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少しずつ、障壁にめり込むように、押し進んでいく。",
   "ko_candidate": "조금씩､ 장벽에 파고들듯이､ 밀고 나아간다｡"
  },
  {
   "id": 26030,
   "key": "D1111le.txt:502",
   "file": "D1111le.txt",
   "line": 502,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アアあああ！　ああアアアあああ！」",
   "ko_candidate": "「아아아아! 아아아아아아!」"
  },
  {
   "id": 26031,
   "key": "D1111le.txt:507",
   "file": "D1111le.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "限界が来た。",
   "ko_candidate": "한계가 왔다｡"
  },
  {
   "id": 26032,
   "key": "D1111le.txt:513",
   "file": "D1111le.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "強引に力尽くに、鬼械神の防禦を、アンチクロスの編んだ結界を、粉砕してしまう。",
   "ko_candidate": "강제로 힘으로､ 귀계신의 방어를､ 안티 크로스가 짠 결계를､ 분쇄해버린다｡"
  },
  {
   "id": 26033,
   "key": "D1111le.txt:514",
   "file": "D1111le.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ガラスが砕け散るような、甲高い音が響く。",
   "ko_candidate": "유리가 깨지는 듯한､ 날카로운 소리가 울린다｡"
  },
  {
   "id": 26034,
   "key": "D1111le.txt:516",
   "file": "D1111le.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もはや阻むものは何もない。",
   "ko_candidate": "이제 막는 것은 아무것도 없다｡"
  },
  {
   "id": 26035,
   "key": "D1111le.txt:517",
   "file": "D1111le.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティングホラーはコクピットに突き刺さった！",
   "ko_candidate": "헌팅 호러가 콕핏에 꽂혔다!"
  },
  {
   "id": 26036,
   "key": "D1111le.txt:522",
   "file": "D1111le.txt",
   "line": 522,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒィィィィイイイっっッ！　ひぃぃぃぃやああアアアぁぁぁぁぁッッ！」",
   "ko_candidate": "「히이이이이이잇! 히이이이야아아아아아아앗!」"
  },
  {
   "id": 26037,
   "key": "D1111le.txt:527",
   "file": "D1111le.txt",
   "line": 527,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これで……終わりだ！」",
   "ko_candidate": "「이걸로… 끝이다!」"
  },
  {
   "id": 26038,
   "key": "D1111le.txt:530",
   "file": "D1111le.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最後の一押し。",
   "ko_candidate": "마지막 한 밀어붙임｡"
  },
  {
   "id": 26039,
   "key": "D1111le.txt:531",
   "file": "D1111le.txt",
   "line": 531,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "限界まで回転するエンジン。獲物を仕留めた猟犬が、今、歓喜と勝利の雄叫びを上げる――",
   "ko_candidate": "한계까지 회전하는 엔진｡ 사냥감을 잡은 사냥개가 지금､ 환희와 승리의 포효를 지른다――"
  },
  {
   "id": 26040,
   "key": "D1111le.txt:538",
   "file": "D1111le.txt",
   "line": 538,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「!?」",
   "ko_candidate": "「!?」"
  },
  {
   "id": 26041,
   "key": "D1111le.txt:542",
   "file": "D1111le.txt",
   "line": 542,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣…?」"
  },
  {
   "id": 26042,
   "key": "D1111le.txt:547",
   "file": "D1111le.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然。",
   "ko_candidate": "갑자기｡"
  },
  {
   "id": 26043,
   "key": "D1111le.txt:548",
   "file": "D1111le.txt",
   "line": 548,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティングホラーが沈黙する。",
   "ko_candidate": "헌팅 호러가 침묵한다｡"
  },
  {
   "id": 26044,
   "key": "D1111le.txt:549",
   "file": "D1111le.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光は霧散し、車体に漲っていた兇暴な魔力のうねりは、なりを潜めた。",
   "ko_candidate": "빛은 흩어지고､ 차체에 넘쳐났던 흉폭한 마력의 파동은 잠잠해졌다｡"
  },
  {
   "id": 26045,
   "key": "D1111le.txt:554",
   "file": "D1111le.txt",
   "line": 554,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何だ……!?」",
   "ko_candidate": "「뭐､ 뭐지…!?」"
  },
  {
   "id": 26046,
   "key": "D1111le.txt:557",
   "file": "D1111le.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面を被っていても、ライカさんが焦っているのは、手に取るように分かる。",
   "ko_candidate": "가면을 쓰고 있어도､ 라이카 씨가 당황하고 있는 것은 손에 잡힐 듯이 알 수 있다｡"
  },
  {
   "id": 26047,
   "key": "D1111le.txt:558",
   "file": "D1111le.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アクセルを何度も回すが、死んだように全く動かない。",
   "ko_candidate": "액셀을 몇 번이고 돌리지만､ 죽은 듯이 전혀 움직이지 않는다｡"
  },
  {
   "id": 26048,
   "key": "D1111le.txt:567",
   "file": "D1111le.txt",
   "line": 567,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まだ術式の組み込みが完全ではなかったのだろうな……魔力が枯渇している」",
   "ko_candidate": "「아직 술식의 조립이 완전하지 않았던 모양이군… 마력이 고갈되고 있어」"
  },
  {
   "id": 26049,
   "key": "D1111le.txt:571",
   "file": "D1111le.txt",
   "line": 571,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、な……っ！　よりによって、このタイミングでトラブルかよ!?」",
   "ko_candidate": "「뭐､ 뭐…! 하필이면 이런 타이밍에 트러블이라니!?」"
  },
  {
   "id": 26050,
   "key": "D1111le.txt:576",
   "file": "D1111le.txt",
   "line": 576,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ……博士のやることロボから。詰めが甘いロボ」",
   "ko_candidate": "「뭐… 박사가 만든 로봇이니까｡ 마무리가 허술한 로봇」"
  },
  {
   "id": 26051,
   "key": "D1111le.txt:580",
   "file": "D1111le.txt",
   "line": 580,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まったくだ！　くそっ！」",
   "ko_candidate": "「정말이지! 젠장!」"
  },
  {
   "id": 26052,
   "key": "D1111le.txt:582",
   "file": "D1111le.txt",
   "line": 582,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マギウス・ウィングを羽ばたかせて、クラーケンの元に急行する。",
   "ko_candidate": "마기우스 윙을 펄럭이며､ 크라켄에게로 급행한다｡"
  },
  {
   "id": 26053,
   "key": "D1111le.txt:583",
   "file": "D1111le.txt",
   "line": 583,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど……クソ、少しばかし離れすぎている！",
   "ko_candidate": "하지만… 제기랄､ 조금 너무 멀리 떨어져 있어!"
  },
  {
   "id": 26054,
   "key": "D1111le.txt:591",
   "file": "D1111le.txt",
   "line": 591,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヲ……ヲ……ヲヲヲヲ……！」",
   "ko_candidate": "「오… 오… 오오오오…!」"
  },
  {
   "id": 26055,
   "key": "D1111le.txt:595",
   "file": "D1111le.txt",
   "line": 595,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさん！　離れろ！」",
   "ko_candidate": "「라이카 씨! 떨어져요!」"
  }
 ]
}