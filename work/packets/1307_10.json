 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "姫さん": "공주님",
  "大十字": "다이쥬지"
 },
 "items": [
  {
   "id": 33417,
   "key": "D1307ru.txt:298",
   "file": "D1307ru.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "相変わらず、あの日の図書館だ。何か様子が変わった気配も無い。",
   "ko_candidate": "여전히 그날의 도서관이다｡ 뭔가 달라진 기색도 없다｡"
  },
  {
   "id": 33418,
   "key": "D1307ru.txt:299",
   "file": "D1307ru.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……いったいどうすりゃ良いんだ？",
   "ko_candidate": "…도대체 어떻게 하면 좋지?"
  },
  {
   "id": 33419,
   "key": "D1307ru.txt:303",
   "file": "D1307ru.txt",
   "line": 303,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「とりあえず……図書館から出てみるか」",
   "ko_candidate": "「일단… 도서관에서 나가볼까」"
  },
  {
   "id": 33420,
   "key": "D1307ru.txt:306",
   "file": "D1307ru.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここに留まっていてもしょうがないだろう。",
   "ko_candidate": "여기 머물러 있어봤자 소용없겠지｡"
  },
  {
   "id": 33421,
   "key": "D1307ru.txt:307",
   "file": "D1307ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "現状を打破するには、何でも良いからアクションを起こしてみることが大切だ。多分。",
   "ko_candidate": "현 상황을 타개하려면 뭐든 좋으니 행동을 취해보는 게 중요하다｡ 아마도｡"
  },
  {
   "id": 33422,
   "key": "D1307ru.txt:311",
   "file": "D1307ru.txt",
   "line": 311,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良し。じゃあ、動くぜ姫さん…………ッ!?」",
   "ko_candidate": "「좋아｡ 그럼､ 가자 공주님………¨?!」"
  },
  {
   "id": 33423,
   "key": "D1307ru.txt:314",
   "file": "D1307ru.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこで気付いてしまった……というより、何で今まで気付かなかったのか。",
   "ko_candidate": "그때 깨달아버렸다… 라기보다､ 왜 지금까지 몰랐던 걸까｡"
  },
  {
   "id": 33424,
   "key": "D1307ru.txt:316",
   "file": "D1307ru.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その……姫さんの格好がだ。ワリと大変なことになっている。",
   "ko_candidate": "그… 공주님의 차림새 말이다｡ 꽤나 대단한 일이 벌어졌다｡"
  },
  {
   "id": 33425,
   "key": "D1307ru.txt:318",
   "file": "D1307ru.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いきなり慌て出した俺を、姫さんはしばらく不思議そうに見つめていたが、やがて視線の向いている箇所に気付いた。",
   "ko_candidate": "갑자기 당황하기 시작한 나를､ 공주님은 잠시 의아한 듯 바라보다가 이내 시선이 향하는 곳을 눈치챘다｡"
  },
  {
   "id": 33426,
   "key": "D1307ru.txt:322",
   "file": "D1307ru.txt",
   "line": 322,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ！」",
   "ko_candidate": "「………¨!」"
  },
  {
   "id": 33427,
   "key": "D1307ru.txt:325",
   "file": "D1307ru.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一気に顔が赤くなる。",
   "ko_candidate": "순식간에 얼굴이 빨개졌다｡"
  },
  {
   "id": 33428,
   "key": "D1307ru.txt:326",
   "file": "D1307ru.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸元を隠し、着衣の乱れを直して、こっちをきっと睨み返す。",
   "ko_candidate": "가슴을 가리고､ 흐트러진 옷매무새를 바로 잡더니､ 이쪽을 꼬옥 노려본다｡"
  },
  {
   "id": 33429,
   "key": "D1307ru.txt:327",
   "file": "D1307ru.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……やば。",
   "ko_candidate": "…큰일 났다｡"
  },
  {
   "id": 33430,
   "key": "D1307ru.txt:331",
   "file": "D1307ru.txt",
   "line": 331,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん！」",
   "ko_candidate": "「…다이쥬지 씨!」"
  },
  {
   "id": 33431,
   "key": "D1307ru.txt:335",
   "file": "D1307ru.txt",
   "line": 335,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわあああ!?　ご、こめんなさいっ！」",
   "ko_candidate": "「우와아아아!? 죄､ 죄송합니다!」"
  },
  {
   "id": 33432,
   "key": "D1307ru.txt:338",
   "file": "D1307ru.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳を振り上げる姫さんに、本気でビビって頭を伏せた。",
   "ko_candidate": "주먹을 치켜드는 공주님에게 진심으로 겁먹어 고개를 숙였다｡"
  },
  {
   "id": 33433,
   "key": "D1307ru.txt:339",
   "file": "D1307ru.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、いつまで経っても、殴ってこない。",
   "ko_candidate": "하지만 아무리 기다려도 때리지 않는다｡"
  },
  {
   "id": 33434,
   "key": "D1307ru.txt:340",
   "file": "D1307ru.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんが吹き出した。",
   "ko_candidate": "공주님이 폭소를 터뜨렸다｡"
  },
  {
   "id": 33435,
   "key": "D1307ru.txt:344",
   "file": "D1307ru.txt",
   "line": 344,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふ……前もこんな状況がありましたわね。まったく、大十字さんには恥ずかしいところばかり、見られています」",
   "ko_candidate": "「후후… 전에도 이런 상황이 있었죠｡ 정말､ 다이쥬지 씨에게는 부끄러운 모습만 보이고 있네요」"
  },
  {
   "id": 33436,
   "key": "D1307ru.txt:348",
   "file": "D1307ru.txt",
   "line": 348,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「え……あ……うん……」",
   "ko_candidate": "「어… 아… 응…」"
  },
  {
   "id": 33437,
   "key": "D1307ru.txt:351",
   "file": "D1307ru.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐る恐る、顔を上げる。",
   "ko_candidate": "조심스럽게 고개를 든다｡"
  },
  {
   "id": 33438,
   "key": "D1307ru.txt:352",
   "file": "D1307ru.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恥ずかしそうに、はにかむ姫さんの顔があった。",
   "ko_candidate": "부끄러워하며 수줍어하는 공주님의 얼굴이 있었다｡"
  },
  {
   "id": 33439,
   "key": "D1307ru.txt:356",
   "file": "D1307ru.txt",
   "line": 356,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これでも嫁入り前の躰。 なのに、こう何度も 肌を晒してしまっては……」 「大十字さんには色々と 責任を取って貰わないと いけませんね……」",
   "ko_candidate": "「이래 봬도 시집가기 전의 몸이에요｡ 그런데 이렇게 여러 번 살갗을 드러내다니… 다이쥬지 씨에게는 여러모로 책임을 져 주셔야겠네요…」"
  },
  {
   "id": 33440,
   "key": "D1307ru.txt:367",
   "file": "D1307ru.txt",
   "line": 367,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えええええっ!?」",
   "ko_candidate": "「에에에에엣!?」"
  },
  {
   "id": 33441,
   "key": "D1307ru.txt:370",
   "file": "D1307ru.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "せ、責任って!?",
   "ko_candidate": "책､ 책임이라니!?"
  },
  {
   "id": 33442,
   "key": "D1307ru.txt:371",
   "file": "D1307ru.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "責任っていったい、な、な、な、なに!?",
   "ko_candidate": "책임이라니 대체､ 뭐､ 뭐､ 뭐､ 뭐야!?"
  },
  {
   "id": 33443,
   "key": "D1307ru.txt:372",
   "file": "D1307ru.txt",
   "line": 372,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何なのっ!?",
   "ko_candidate": "뭐란 말이야!?"
  },
  {
   "id": 33444,
   "key": "D1307ru.txt:376",
   "file": "D1307ru.txt",
   "line": 376,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふ……あはっ。あははははっ」",
   "ko_candidate": "「후후… 아핫｡ 아하하하핫」"
  },
  {
   "id": 33445,
   "key": "D1307ru.txt:379",
   "file": "D1307ru.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐れおののく俺を見て、姫さんは愉快そうに笑い出した。",
   "ko_candidate": "두려워 떠는 나를 보고 공주님은 즐거운 듯 웃음을 터뜨렸다｡"
  },
  {
   "id": 33446,
   "key": "D1307ru.txt:380",
   "file": "D1307ru.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここまで、はっきりと、声を上げて笑う姫さんを見たのは、もしかしたら初めてかも知れない。",
   "ko_candidate": "이렇게 확실하게 소리 내어 웃는 공주님을 본 건 어쩌면 처음일지도 모른다｡"
  },
  {
   "id": 33447,
   "key": "D1307ru.txt:384",
   "file": "D1307ru.txt",
   "line": 384,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ……」",
   "ko_candidate": "「앗…」"
  },
  {
   "id": 33448,
   "key": "D1307ru.txt:387",
   "file": "D1307ru.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の前に出て、先を歩く。",
   "ko_candidate": "내 앞으로 나와 앞서 걷는다｡"
  },
  {
   "id": 33449,
   "key": "D1307ru.txt:388",
   "file": "D1307ru.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くるりとスカートを翻して、こっちを振り向く。",
   "ko_candidate": "스커트를 살랑 휘날리며 이쪽을 돌아본다｡"
  },
  {
   "id": 33450,
   "key": "D1307ru.txt:389",
   "file": "D1307ru.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺を見つめる瞳に、その笑顔に、何故か胸が高まった。",
   "ko_candidate": "나를 바라보는 눈동자와 그 미소에 왠지 가슴이 뛰었다｡"
  },
  {
   "id": 33451,
   "key": "D1307ru.txt:393",
   "file": "D1307ru.txt",
   "line": 393,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「冗談。冗談ですよ」",
   "ko_candidate": "「농담이에요｡ 농담」"
  },
  {
   "id": 33452,
   "key": "D1307ru.txt:397",
   "file": "D1307ru.txt",
   "line": 397,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「……………」"
  },
  {
   "id": 33453,
   "key": "D1307ru.txt:401",
   "file": "D1307ru.txt",
   "line": 401,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ、急ぎましょう。何とかこの悪夢から脱け出さないと」",
   "ko_candidate": "「자､ 서둘러요｡ 어떻게든 이 악몽에서 빠져나가야 해요」"
  },
  {
   "id": 33454,
   "key": "D1307ru.txt:405",
   "file": "D1307ru.txt",
   "line": 405,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……ああ」",
   "ko_candidate": "「아… 응」"
  },
  {
   "id": 33455,
   "key": "D1307ru.txt:409",
   "file": "D1307ru.txt",
   "line": 409,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんを追って、歩き出す。",
   "ko_candidate": "공주님을 뒤따라 걷기 시작한다｡"
  },
  {
   "id": 33456,
   "key": "D1307ru.txt:410",
   "file": "D1307ru.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんも再び、正面を向く。",
   "ko_candidate": "공주님도 다시 정면을 향한다｡"
  }
 ]
