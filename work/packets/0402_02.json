  {
   "id": 4413,
   "key": "D0402.txt:728",
   "file": "D0402.txt",
   "line": 728,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "目が逝っちゃったままだ。",
   "ko_candidate": "뭔가 이제､ 입가에서 침까지 흘리고 있다｡"
