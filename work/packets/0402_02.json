  {
   "id": 4412,
   "key": "D0402.txt:727",
   "file": "D0402.txt",
   "line": 727,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや、駄目だ。ぜんぜん駄目だ。",
   "ko_candidate": "그리고 이제､ 어떤 성벽의 소유자인지는 명백하다｡"
