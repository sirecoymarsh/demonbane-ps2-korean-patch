 },
 "items": [
  {
   "id": 22292,
   "key": "D1101le.txt:180",
   "file": "D1101le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの顔に手を当てる。",
   "ko_candidate": "자신의 얼굴에 손을 댄다｡"
  },
  {
   "id": 22293,
   "key": "D1101le.txt:181",
   "file": "D1101le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……無い。",
   "ko_candidate": "……없다｡"
  },
  {
   "id": 22294,
   "key": "D1101le.txt:182",
   "file": "D1101le.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔を覆う、心を覆い隠す、無表情の白い仮面が無い。",
   "ko_candidate": "얼굴을 가리는､ 마음을 감추는､ 무표정의 하얀 가면이 없다｡"
  },
  {
   "id": 22295,
   "key": "D1101le.txt:184",
   "file": "D1101le.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "つまり――",
   "ko_candidate": "즉――"
  },
  {
   "id": 22296,
   "key": "D1101le.txt:190",
   "file": "D1101le.txt",
   "line": 190,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカ……さん？」",
   "ko_candidate": "「……라이카……씨?」"
  },
  {
   "id": 22297,
   "key": "D1101le.txt:194",
   "file": "D1101le.txt",
   "line": 194,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん……見てしまったの ……？」",
   "ko_candidate": "「쿠로……봐버린 거야 ……?」"
  },
  {
   "id": 22298,
   "key": "D1101le.txt:215",
   "file": "D1101le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しばらく２人、呆然と見つめ合う。",
   "ko_candidate": "잠시 둘은 멍하니 서로를 바라본다｡"
  },
  {
   "id": 22299,
   "key": "D1101le.txt:217",
   "file": "D1101le.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "というより、語るべき言葉を見つけられなかった。",
   "ko_candidate": "라기보다는､ 할 말을 찾지 못했다｡"
  },
  {
   "id": 22300,
   "key": "D1101le.txt:218",
   "file": "D1101le.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思考がまったく纏まらない。",
   "ko_candidate": "생각이 전혀 정리되지 않는다｡"
  },
  {
   "id": 22301,
   "key": "D1101le.txt:220",
   "file": "D1101le.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何でメタトロンの仮面の下から、ライカさんの顔が……？",
   "ko_candidate": "왜 메타트론의 가면 아래에서､ 라이카 씨의 얼굴이……?"
  },
  {
   "id": 22302,
   "key": "D1101le.txt:221",
   "file": "D1101le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、んなもん答えは一つしかない。分かり切っている。",
   "ko_candidate": "아니､ 그런 건 답이 하나밖에 없잖아｡ 뻔한 거잖아｡"
  },
  {
   "id": 22303,
   "key": "D1101le.txt:223",
   "file": "D1101le.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが知ってしまった事実に、実感が追いつかないだけなのだ。",
   "ko_candidate": "하지만 알아버린 사실에､ 실감이 따라오지 않을 뿐이다｡"
  },
  {
   "id": 22304,
   "key": "D1101le.txt:226",
   "file": "D1101le.txt",
   "line": 226,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんが……メタトロン？」",
   "ko_candidate": "「라이카 씨가……메타트론?」"
  },
  {
   "id": 22305,
   "key": "D1101le.txt:228",
   "file": "D1101le.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実感が伴わないので、搾り出した言葉も分かりきった結論を繰り返すだけのものだ。",
   "ko_candidate": "실감이 나지 않아서､ 짜낸 말도 뻔한 결론을 되풀이할 뿐이다｡"
  },
  {
   "id": 22306,
   "key": "D1101le.txt:230",
   "file": "D1101le.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんは答えない。",
   "ko_candidate": "라이카 씨는 대답하지 않는다｡"
  },
  {
   "id": 22307,
   "key": "D1101le.txt:231",
   "file": "D1101le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ辛そうに、顔を背ける。",
   "ko_candidate": "그저 괴로운 듯이､ 얼굴을 돌린다｡"
  },
  {
   "id": 22308,
   "key": "D1101le.txt:234",
   "file": "D1101le.txt",
   "line": 234,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんが……ずっと、『ブラックロッジ』と戦っていた……」",
   "ko_candidate": "「라이카 씨가……줄곧､ 『블랙로지』와 싸우고 있었던 거야……」"
  },
  {
   "id": 22309,
   "key": "D1101le.txt:236",
   "file": "D1101le.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分で呟いた言葉が、初めて重い事実となって胸を締めつける。",
   "ko_candidate": "자신이 중얼거린 말이 처음으로 무거운 사실이 되어 가슴을 조여온다｡"
  },
  {
   "id": 22310,
   "key": "D1101le.txt:238",
   "file": "D1101le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ……そうなんだ。",
   "ko_candidate": "그래… 그런 거야｡"
  },
  {
   "id": 22311,
   "key": "D1101le.txt:239",
   "file": "D1101le.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺やガキんちょどもに優しい笑顔を向けるその影で、ライカさんは『ブラックロッジ』と命を賭けて戦い、傷を負っていた。",
   "ko_candidate": "나와 꼬마들에게 상냥한 미소를 보이는 그 그림자 뒤에서､ 라이카 씨는 『블랙로지』와 목숨을 걸고 싸우며 상처를 입고 있었다｡"
  },
  {
   "id": 22312,
   "key": "D1101le.txt:241",
   "file": "D1101le.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰にも知られずに、ひっそりと。",
   "ko_candidate": "누구에게도 알려지지 않은 채､ 조용히｡"
  },
  {
   "id": 22313,
   "key": "D1101le.txt:245",
   "file": "D1101le.txt",
   "line": 245,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……九郎ちゃんにはね。こんな戦いはさせたくなかったよ……」",
   "ko_candidate": "「……쿠로 군에게는 말이야｡ 이런 싸움은 시키고 싶지 않았어……」"
  },
  {
   "id": 22314,
   "key": "D1101le.txt:248",
   "file": "D1101le.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初の頃、メタトロンが俺を否定したのは、デモンベインを危険視したからではなかった。",
   "ko_candidate": "처음에 메타트론이 나를 부정한 것은 데몬베인을 위험시했기 때문이 아니었다｡"
  },
  {
   "id": 22315,
   "key": "D1101le.txt:249",
   "file": "D1101le.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ようするに……俺を気づかっていたのか。",
   "ko_candidate": "요컨대… 나를 걱정하고 있었던 건가｡"
  },
  {
   "id": 22316,
   "key": "D1101le.txt:252",
   "file": "D1101le.txt",
   "line": 252,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どうしてライカさんは、こんな戦いを……」",
   "ko_candidate": "「왜 라이카 씨는 이런 싸움을…」"
  },
  {
   "id": 22317,
   "key": "D1101le.txt:261",
   "file": "D1101le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "問いは突如、辺りを震わせる轟音によって遮られた。",
   "ko_candidate": "질문은 갑자기 주변을 흔드는 굉음에 의해 차단되었다｡"
  },
  {
   "id": 22318,
   "key": "D1101le.txt:263",
   "file": "D1101le.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地響きが脆くなっている廃屋を乱暴に揺さぶる。",
   "ko_candidate": "지진이 취약해진 폐가를 거칠게 흔든다｡"
  },
  {
   "id": 22319,
   "key": "D1101le.txt:264",
   "file": "D1101le.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な質量が近くに落ちてきたのだ。",
   "ko_candidate": "거대한 질량이 가까이에 떨어진 것이다｡"
  },
  {
   "id": 22320,
   "key": "D1101le.txt:267",
   "file": "D1101le.txt",
   "line": 267,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……っ!?　『ブラックロッジ』の追っ手か!?」",
   "ko_candidate": "「……읏!? 『블랙로지』의 추격자인가!?」"
  },
  {
   "id": 22321,
   "key": "D1101le.txt:274",
   "file": "D1101le.txt",
   "line": 274,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 22322,
   "key": "D1101le.txt:277",
   "file": "D1101le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの表情が険しくなる。",
   "ko_candidate": "라이카 씨의 표정이 험악해진다｡"
  },
  {
   "id": 22323,
   "key": "D1101le.txt:281",
   "file": "D1101le.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の知らない、冷徹な思考と強靭な意志を持つ、戦士の貌。",
   "ko_candidate": "내가 모르는､ 냉철한 사고와 강인한 의지를 가진 전사의 얼굴｡"
  },
  {
   "id": 22324,
   "key": "D1101le.txt:282",
   "file": "D1101le.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんが、シスターが、『お姉ちゃん』が見せなかった貌。",
   "ko_candidate": "라이카 씨가､ 시스터가､ 『누나』가 보여주지 않았던 얼굴｡"
  },
  {
   "id": 22325,
   "key": "D1101le.txt:283",
   "file": "D1101le.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンが仮面の下に隠していた貌。",
   "ko_candidate": "메타트론이 가면 아래에 숨기고 있던 얼굴｡"
  },
  {
   "id": 22326,
   "key": "D1101le.txt:287",
   "file": "D1101le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い残像を残し、瞬く間に廃屋を出る。",
   "ko_candidate": "하얀 잔상을 남기며 순식간에 폐가를 나간다｡"
  },
  {
   "id": 22327,
   "key": "D1101le.txt:290",
   "file": "D1101le.txt",
   "line": 290,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああっ！　待って！」",
   "ko_candidate": "「아악! 기다려!」"
  },
  {
   "id": 22328,
   "key": "D1101le.txt:294",
   "file": "D1101le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慌てて後を追いかける。",
   "ko_candidate": "황급히 뒤를 쫓는다｡"
  },
  {
   "id": 22329,
   "key": "D1101le.txt:296",
   "file": "D1101le.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは……死ぬことはないとは思うが、今の状態じゃマギウスへの変身は無理だ。２挺の拳銃だけを握って、外に出た。",
   "ko_candidate": "알은… 죽지는 않을 거라고 생각하지만､ 지금 상태로는 마기우스로의 변신은 불가능하다｡ 2정의 권총만을 쥐고 밖으로 나갔다｡"
  },
  {
   "id": 22330,
   "key": "D1101le.txt:298",
   "file": "D1101le.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "既にライカさんは、右腕をビーム砲に変形させて構えている。",
   "ko_candidate": "이미 라이카 씨는 오른팔을 빔포로 변형시켜 겨누고 있다｡"
  },
  {
   "id": 22331,
   "key": "D1101le.txt:300",
   "file": "D1101le.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンの時は考えたこともないが、今、ライカさんの顔で機械を纏うその姿は……何だか酷く痛々しい。",
   "ko_candidate": "메타트론 때는 생각해본 적도 없지만､ 지금 라이카 씨의 얼굴로 기계를 두른 그 모습은… 뭔가 몹시 아프게 느껴진다｡"
  }
 ]
}