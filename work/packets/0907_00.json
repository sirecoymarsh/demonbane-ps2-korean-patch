 },
 "items": [
  {
   "id": 19319,
   "key": "D0907al.txt:12",
   "file": "D0907al.txt",
   "line": 12,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそっ……！」",
   "ko_candidate": "「젠장……!」"
  },
  {
   "id": 19320,
   "key": "D0907al.txt:21",
   "file": "D0907al.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掴みかかって来た破壊ロボを引き剥がそうと暴れるが、なかなかに離れない。",
   "ko_candidate": "달려들어 온 파괴 로봇을 떼어내려고 몸부림치지만､ 좀처럼 떨어지지 않는다｡"
  },
  {
   "id": 19321,
   "key": "D0907al.txt:33",
   "file": "D0907al.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "動けないデモンベインに向かって、周りの破壊ロボは一斉に破壊ビームを発射した。",
   "ko_candidate": "움직일 수 없는 데몬베인을 향해､ 주변의 파괴 로봇들이 일제히 파괴 빔을 발사했다｡"
  },
  {
   "id": 19322,
   "key": "D0907al.txt:47",
   "file": "D0907al.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを掴まえている破壊ロボが盾になった。",
   "ko_candidate": "데몬베인을 붙잡고 있던 파괴 로봇이 방패가 되었다｡"
  },
  {
   "id": 19323,
   "key": "D0907al.txt:48",
   "file": "D0907al.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光線を浴び、赤熱する破壊ロボ。",
   "ko_candidate": "광선을 맞고､ 붉게 달아오르는 파괴 로봇｡"
  },
  {
   "id": 19324,
   "key": "D0907al.txt:49",
   "file": "D0907al.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊ロボの拘束が緩んだ。",
   "ko_candidate": "파괴 로봇의 구속이 느슨해졌다｡"
  },
  {
   "id": 19325,
   "key": "D0907al.txt:52",
   "file": "D0907al.txt",
   "line": 52,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！　ティマイオス！　クリティアス！」",
   "ko_candidate": "「크……! 티마이오스! 크리티오스!」"
  },
  {
   "id": 19326,
   "key": "D0907al.txt:61",
   "file": "D0907al.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "脚部シールドのエネルギーを開放して、一気に跳躍する。眼下で破壊ロボが爆発した。",
   "ko_candidate": "다리 부분 실드의 에너지를 개방하여､ 단숨에 도약한다｡ 아래에서 파괴 로봇이 폭발한다｡"
  },
  {
   "id": 19327,
   "key": "D0907al.txt:68",
   "file": "D0907al.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、破壊ロボの軍団は上空でも待ち構えていた。",
   "ko_candidate": "하지만､ 파괴 로봇의 군단은 상공에서도 대기하고 있었다｡"
  },
  {
   "id": 19328,
   "key": "D0907al.txt:78",
   "file": "D0907al.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊ビームが一斉掃射される。",
   "ko_candidate": "파괴 빔이 일제히 쏟아진다｡"
  },
  {
   "id": 19329,
   "key": "D0907al.txt:89",
   "file": "D0907al.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度こそ直撃を喰らった。",
   "ko_candidate": "이번에야말로 직격탄을 맞았다｡"
  },
  {
   "id": 19330,
   "key": "D0907al.txt:95",
   "file": "D0907al.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発に吹き飛ばされ、デモンベインは、ビルを踏み潰しながら大地を転がる。",
   "ko_candidate": "폭발에 휩쓸려､ 데몬베인은 빌딩을 짓밟으며 대지를 굴러간다｡"
  },
  {
   "id": 19331,
   "key": "D0907al.txt:98",
   "file": "D0907al.txt",
   "line": 98,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐわあっ！　い、いってえ……！」",
   "ko_candidate": "「으와악! 아､ 아파……!」"
  },
  {
   "id": 19332,
   "key": "D0907al.txt:105",
   "file": "D0907al.txt",
   "line": 105,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うつけ！　何だ、そのへっぴり腰は!?　真面目に戦え！　このような雑兵、何千何万、束になったところでデモンベインの敵ではない！」",
   "ko_candidate": "「멍청이! 뭐야､ 그 허술한 자세는!? 제대로 싸워! 이런 잡병들､ 수천 수만이 뭉쳐봤자､ 데몬베인의 적수가 되지 못해!」"
  },
  {
   "id": 19333,
   "key": "D0907al.txt:109",
   "file": "D0907al.txt",
   "line": 109,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ッッ！　分かっているっつーの！　くそがぁぁぁぁぁ！」",
   "ko_candidate": "「……읏! 알고 있다고! 젠자아아아아앙!」"
  },
  {
   "id": 19334,
   "key": "D0907al.txt:121",
   "file": "D0907al.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを起き上がらせ、両手を前に突き出す。",
   "ko_candidate": "데몬베인을 일으켜 세우고､ 양손을 앞으로 내민다｡"
  },
  {
   "id": 19335,
   "key": "D0907al.txt:122",
   "file": "D0907al.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の手の甲に浮かぶ、炎神と風神の刻印。",
   "ko_candidate": "내 손등에 떠오르는､ 염신과 풍신의 각인｡"
  },
  {
   "id": 19336,
   "key": "D0907al.txt:123",
   "file": "D0907al.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの掌、紅の焔と白い冷気が顕れる。",
   "ko_candidate": "데몬베인의 손바닥에､ 붉은 화염과 하얀 냉기가 나타난다｡"
  },
  {
   "id": 19337,
   "key": "D0907al.txt:125",
   "file": "D0907al.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔と冷気はそれぞれ実体を帯び、質量を得て、２挺の魔銃に――",
   "ko_candidate": "화염과 냉기는 각각 실체를 띠고､ 질량을 얻어､ 2정의 마총으로――"
  },
  {
   "id": 19338,
   "key": "D0907al.txt:144",
   "file": "D0907al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――――ッ!?",
   "ko_candidate": "――――읏!?"
  },
  {
   "id": 19339,
   "key": "D0907al.txt:152",
   "file": "D0907al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "精神集中が乱れ、２つの魔力は虚しく霧散する。",
   "ko_candidate": "정신 집중이 흐트러져､ 두 개의 마력은 허무하게 흩어진다｡"
  },
  {
   "id": 19340,
   "key": "D0907al.txt:153",
   "file": "D0907al.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動揺が隙を生んだ。",
   "ko_candidate": "동요가 틈을 만들었다｡"
  },
  {
   "id": 19341,
   "key": "D0907al.txt:164",
   "file": "D0907al.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空から、陸から、破壊ビームの集中砲火を喰らう。",
   "ko_candidate": "하늘에서､ 육지에서､ 파괴 빔의 집중 포화를 맞는다｡"
  },
  {
   "id": 19342,
   "key": "D0907al.txt:171",
   "file": "D0907al.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆撃に縫い付けられ、この場から動くことが出来ない。",
   "ko_candidate": "폭격에 꿰매어져､ 이 자리에서 움직일 수 없다｡ 방어진을 전개하여､ 기체를 지키는 것이 고작이었다｡"
  },
  {
   "id": 19343,
   "key": "D0907al.txt:172",
   "file": "D0907al.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "防御陣を展開して、機体を守るのが精一杯だった。",
   "ko_candidate": "「……젠장!」 「쿠로! 네놈､ 이 판국에 아직도……!」"
  },
  {
   "id": 19344,
   "key": "D0907al.txt:178",
   "file": "D0907al.txt",
   "line": 178,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ちっくしょうッ！」",
   "ko_candidate": "심장이 격렬하게 고동친다｡ 숨이 막힌다｡"
  },
  {
   "id": 19345,
   "key": "D0907al.txt:182",
   "file": "D0907al.txt",
   "line": 182,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎！　汝、この期に及んでまだ……！」",
   "ko_candidate": "두통이 심하다｡ 구토감이 치밀어 오른다｡"
  },
  {
   "id": 19346,
   "key": "D0907al.txt:207",
   "file": "D0907al.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "心臓が激しく鼓動する。息が詰まる。頭痛が酷い。吐き気が込み上げてくる。",
   "ko_candidate": "안 되겠어｡ 데몬베인을 움직일 때마다､ 엔네아의 기억이 재생된다｡"
  },
  {
   "id": 19347,
   "key": "D0907al.txt:216",
   "file": "D0907al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "駄目だ。デモンベインを動かすたびに、エンネアの記憶が再生される。エンネアの最期が脳を灼く。",
   "ko_candidate": "꾸짖듯이､ 괴롭히듯이､ 엔네아의 최후가 뇌를 태운다｡"
  },
  {
   "id": 19348,
   "key": "D0907al.txt:223",
   "file": "D0907al.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身から力が抜けた。",
   "ko_candidate": "온몸에서 힘이 빠졌다｡"
  },
  {
   "id": 19349,
   "key": "D0907al.txt:224",
   "file": "D0907al.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットの中でだらしなく膝を突く。",
   "ko_candidate": "나는 콕핏 안에서､ 무기력하게 무릎을 꿇었다｡"
  },
  {
   "id": 19350,
   "key": "D0907al.txt:231",
   "file": "D0907al.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに従いデモンベインも構えを解き、棒立ちになった。",
   "ko_candidate": "그에 따라 데몬베인도 자세를 풀고､ 우두커니 서 있게 되었다｡"
  },
  {
   "id": 19351,
   "key": "D0907al.txt:235",
   "file": "D0907al.txt",
   "line": 235,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――九郎ッ!?」",
   "ko_candidate": "「――쿠로!?」"
  },
  {
   "id": 19352,
   "key": "D0907al.txt:243",
   "file": "D0907al.txt",
   "line": 243,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……すまねえ、アル」",
   "ko_candidate": "「……미안해､ 알」"
  },
  {
   "id": 19353,
   "key": "D0907al.txt:245",
   "file": "D0907al.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "信じられないといった風に俺を睨みつけるアル。",
   "ko_candidate": "믿을 수 없다는 듯이 나를 노려보는 알｡"
  },
  {
   "id": 19354,
   "key": "D0907al.txt:246",
   "file": "D0907al.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、俺は立ち上がれない。",
   "ko_candidate": "하지만､ 나는 일어설 수 없다｡"
  },
  {
   "id": 19355,
   "key": "D0907al.txt:248",
   "file": "D0907al.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分の掌をじっと見つめる。",
   "ko_candidate": "자신의 손바닥을 뚫어지게 바라본다｡"
  },
  {
   "id": 19356,
   "key": "D0907al.txt:249",
   "file": "D0907al.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうしようもないほどに震えていた。",
   "ko_candidate": "어쩔 수 없이 떨리고 있었다｡"
  },
  {
   "id": 19357,
   "key": "D0907al.txt:254",
   "file": "D0907al.txt",
   "line": 254,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「すまねえ、アル……分かっちゃいるんだが……どうしても戦えねえ」",
   "ko_candidate": "「미안해､ 알……알고는 있지만……도저히 싸울 수가 없어」"
  },
  {
   "id": 19358,
   "key": "D0907al.txt:259",
   "file": "D0907al.txt",
   "line": 259,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何で……っ！」",
   "ko_candidate": "「왜……!」"
  }
 ]
}