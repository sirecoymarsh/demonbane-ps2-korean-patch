 },
 "items": [
  {
   "id": 25238,
   "key": "D1108ru.txt:181",
   "file": "D1108ru.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在り得る筈の無いものを見た。",
   "ko_candidate": "있을 리 없는 것을 보았다｡"
  },
  {
   "id": 25239,
   "key": "D1108ru.txt:182",
   "file": "D1108ru.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そいつは――昇降機に乗って、地上に姿を現すそいつは、確かに跡形も無く消滅した筈なのだ。",
   "ko_candidate": "그것은――승강기를 타고 지상에 모습을 드러내는 그것은､ 분명 흔적도 없이 소멸했을 터인데｡"
  },
  {
   "id": 25240,
   "key": "D1108ru.txt:184",
   "file": "D1108ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、そいつは確かにティトゥスの視界に捉えられている。",
   "ko_candidate": "하지만､ 그것은 분명 티투스의 시야에 포착되고 있다｡"
  },
  {
   "id": 25241,
   "key": "D1108ru.txt:185",
   "file": "D1108ru.txt",
   "line": 185,
   "speaker": "ティトゥス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "不敵な笑みが浮かんだ。 「……皆の者。見ろ。外を見てみろ。面白いものが見れるぞ」",
   "ko_candidate": "뻔뻔한 미소가 떠올랐다｡"
  },
  {
   "id": 25242,
   "key": "D1108ru.txt:205",
   "file": "D1108ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "司令室を駆け巡った動揺は、 ティトゥスのそれとは比べ物にならない。",
   "ko_candidate": "「……여러분｡ 보라｡ 밖을 보라｡ 재미있는 것을 볼 수 있을 것이다」"
  },
  {
   "id": 25243,
   "key": "D1108ru.txt:208",
   "file": "D1108ru.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "指揮に携わる機関としては、 あるまじき取り乱しっぷりだった。",
   "ko_candidate": "사령실을 휩쓴 동요는､ 티투스의 그것과는 비교도 되지 않는다｡"
  },
  {
   "id": 25244,
   "key": "D1108ru.txt:211",
   "file": "D1108ru.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "前代未聞で問答無用な、 徹底した大パニックっぷりだった。",
   "ko_candidate": "지휘를 담당하는 기관으로서는､ 있을 수 없는 당황스러움이었다｡"
  },
  {
   "id": 25245,
   "key": "D1108ru.txt:214",
   "file": "D1108ru.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソーニャの、無駄だと分かり切っている説得が、",
   "ko_candidate": "전대미문이고 문답무용한､ 철저한 대혼란이었다｡"
  },
  {
   "id": 25246,
   "key": "D1108ru.txt:215",
   "file": "D1108ru.txt",
   "line": 215,
   "speaker": "ソーニャ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "虚しく広い空間に木霊している。 「だから待って下さいです！　そんなの無茶！　無茶過ぎますですよ！」",
   "ko_candidate": "소냐의､ 헛수고라는 걸 뻔히 알면서도 하는 설득이､ 헛되이 넓은 공간에 메아리치고 있다｡"
  },
  {
   "id": 25247,
   "key": "D1108ru.txt:228",
   "file": "D1108ru.txt",
   "line": 228,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああああああ、だから止め……止めて――――っ！」 「もぉぉ、チアキさん！　なんでっ！　何でその場にいながら止めなかったんですか!?　この役立たずっ！　無能っ！　穀潰しっ！　眼鏡っ！　似非関西弁っ！」",
   "ko_candidate": "「그러니까 기다려 주세요! 그런 건 무리! 무리가 지나칩니다! 아아아아아､ 그러니까 멈……멈춰――――! 정말､ 치아키 씨! 왜요! 왜 그 자리에 있으면서 멈추지 않은 거예요!? 이 쓸모없는 것! 무능! 식충이! 암퇘지! 창녀! 안경! 가짜 간사이 사투리!」"
  },
  {
   "id": 25248,
   "key": "D1108ru.txt:237",
   "file": "D1108ru.txt",
   "line": 237,
   "speaker": "チアキ（通信）",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ん――――っ！　んんんっ！　ん――――っ！」",
   "ko_candidate": "「음――――! 음음음! 음――――!」"
  },
  {
   "id": 25249,
   "key": "D1108ru.txt:241",
   "file": "D1108ru.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "格納庫に繋がった通信機から、チアキの何だかもの凄く怒っているっぽい呻き声が聴こえるが、案の定、誰も構っていない。",
   "ko_candidate": "격납고에 연결된 통신기에서､ 치아키의 뭔가 굉장히 화난 것 같은 신음 소리가 들리지만､ 역시나 아무도 신경 쓰지 않는다｡"
  },
  {
   "id": 25250,
   "key": "D1108ru.txt:243",
   "file": "D1108ru.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それくらい事態は切迫していた。",
   "ko_candidate": "그만큼 사태는 절박했다｡"
  },
  {
   "id": 25251,
   "key": "D1108ru.txt:248",
   "file": "D1108ru.txt",
   "line": 248,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――て、敵機に捕捉されました。攻撃来ます……！」",
   "ko_candidate": "「――적､ 적기에 포착되었습니다｡ 공격이 옵니다……!」"
  },
  {
   "id": 25252,
   "key": "D1108ru.txt:255",
   "file": "D1108ru.txt",
   "line": 255,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……瑠璃お嬢様。今ならば、まだ引き返せます。 どうか短絡的な行動はお控えに……」",
   "ko_candidate": "「……루리 아가씨｡ 지금이라면､ 아직 돌아갈 수 있습니다｡ 부디 단락적인 행동은 삼가……」"
  },
  {
   "id": 25253,
   "key": "D1108ru.txt:261",
   "file": "D1108ru.txt",
   "line": 261,
   "speaker": "瑠璃（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あああああ――――っ！　もう！　黙りなさい！ わたくしは退きませんわよっ！」",
   "ko_candidate": "「아아아아――――! 정말! 조용히 하세요! 저는 물러서지 않아요!」"
  },
  {
   "id": 25254,
   "key": "D1108ru.txt:265",
   "file": "D1108ru.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の一喝が、司令室を静まり返らせた。",
   "ko_candidate": "루리의 일갈이､ 사령실을 조용하게 만들었다｡"
  },
  {
   "id": 25255,
   "key": "D1108ru.txt:267",
   "file": "D1108ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それも束の間。",
   "ko_candidate": "하지만､ 그것도 잠시｡"
  },
  {
   "id": 25256,
   "key": "D1108ru.txt:268",
   "file": "D1108ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "結局は火に油を注いだように、パニックは拡大する一方だ。",
   "ko_candidate": "결국은 불에 기름을 부은 것처럼､ 패닉은 확대되기만 한다｡"
  },
  {
   "id": 25257,
   "key": "D1108ru.txt:273",
   "file": "D1108ru.txt",
   "line": 273,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だってだってだってぇぇぇっ！　いくら何でもそんなぁぁぁっ！」",
   "ko_candidate": "「그래도그래도그래도에에에! 아무리 그래도 그런아아아!」"
  },
  {
   "id": 25258,
   "key": "D1108ru.txt:278",
   "file": "D1108ru.txt",
   "line": 278,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――あ……ああ……敵。敵が。敵が。敵が敵が敵が敵が敵が敵が敵が敵が敵が敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵敵――！」",
   "ko_candidate": "「――아……아아……적｡ 적이｡ 적이｡ 적이적이적이적이적이적이적이적이적이적적적적적적적적적적적적적적적적적적적적적적적적적적――!」"
  },
  {
   "id": 25259,
   "key": "D1108ru.txt:283",
   "file": "D1108ru.txt",
   "line": 283,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……どう考えても無理があります。良いですか？　大十字様の行った戦闘データから類推しますに……」",
   "ko_candidate": "「……아무리 생각해도 무리가 있습니다｡ 잘 들으세요? 다이쥬지 님의 전투 데이터로 추론하건대……」"
  },
  {
   "id": 25260,
   "key": "D1108ru.txt:286",
   "file": "D1108ru.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反論の通信がすぐに返ってくる。",
   "ko_candidate": "반론의 통신이 곧바로 돌아온다｡"
  },
  {
   "id": 25261,
   "key": "D1108ru.txt:291",
   "file": "D1108ru.txt",
   "line": 291,
   "speaker": "瑠璃（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「無理ではありません！　わたくしだって一通りの理屈は理解しています！」",
   "ko_candidate": "「무리가 아닙니다! 저도 일통의 이치는 이해하고 있어요! 그러니까､ 결코 불가능하지는 않을 거예요――」"
  },
  {
   "id": 25262,
   "key": "D1108ru.txt:294",
   "file": "D1108ru.txt",
   "line": 294,
   "speaker": "瑠璃（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから、決して不可能ではないはず――」",
   "ko_candidate": "「그런! 테스트도 훈련도 없이 갑자기라니……!」"
  },
  {
   "id": 25263,
   "key": "D1108ru.txt:299",
   "file": "D1108ru.txt",
   "line": 299,
   "speaker": "ソーニャ / 瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんなっ！　テストも訓練も無しにいきなりなんて……！」 「――大十字さんだって、ぶっつけ本番だったではないですかッッッ！」",
   "ko_candidate": "「――다이쥬지 씨도､ 무작정 본전이었잖아요!!!」"
  },
  {
   "id": 25264,
   "key": "D1108ru.txt:307",
   "file": "D1108ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の通信が発信されている場所は格納庫ではない。",
   "ko_candidate": "루리의 통신이 발신되고 있는 장소는 격납고가 아니다｡"
  },
  {
   "id": 25265,
   "key": "D1108ru.txt:308",
   "file": "D1108ru.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "格納庫には既に瑠璃は居ない……ついでに、アルも。",
   "ko_candidate": "격납고에는 이미 루리가 없다……덤으로､ 알도｡"
  },
  {
   "id": 25266,
   "key": "D1108ru.txt:309",
   "file": "D1108ru.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "現在の状況で、それが意味する事はたった一つだった。",
   "ko_candidate": "현재 상황에서､ 그것이 의미하는 바는 단 하나였다｡"
  },
  {
   "id": 25267,
   "key": "D1108ru.txt:310",
   "file": "D1108ru.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即ち――",
   "ko_candidate": "즉――"
  },
  {
   "id": 25268,
   "key": "D1108ru.txt:321",
   "file": "D1108ru.txt",
   "line": 321,
   "speaker": "アル（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――仕方があるまい。緊急事態だ。汝等にも妥協してもらう」",
   "ko_candidate": "「――어쩔 수 없군｡ 긴급 사태다｡ 너희에게도 타협해 달라」"
  },
  {
   "id": 25269,
   "key": "D1108ru.txt:326",
   "file": "D1108ru.txt",
   "line": 326,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……アル様！」",
   "ko_candidate": "「……알 님!」"
  },
  {
   "id": 25270,
   "key": "D1108ru.txt:334",
   "file": "D1108ru.txt",
   "line": 334,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「黙って見ていなさい……わたくしだって、戦えるのです！」",
   "ko_candidate": "「가만히 보고 있어요……저도､ 싸울 수 있어요!」"
  },
  {
   "id": 25271,
   "key": "D1108ru.txt:345",
   "file": "D1108ru.txt",
   "line": 345,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「わたくしが、デモンベインで戦います！」",
   "ko_candidate": "「제가､ 데몬베인으로 싸우겠어요!」"
  }
 ]
}