 "items": [
  {
   "id": 14380,
   "key": "D0809al.txt:202",
   "file": "D0809al.txt",
   "line": 202,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「伏せろ！」",
   "ko_candidate": "「엎드려!」"
  },
  {
   "id": 14381,
   "key": "D0809al.txt:208",
   "file": "D0809al.txt",
   "line": 208,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃあっ!?」",
   "ko_candidate": "「꺄앗!?」"
  },
  {
   "id": 14382,
   "key": "D0809al.txt:215",
   "file": "D0809al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンネアの頭を押さえつけて、その場にしゃがみ込む。",
   "ko_candidate": "엔네아의 머리를 누르고､ 그 자리에 쪼그려 앉는다｡"
  },
  {
   "id": 14383,
   "key": "D0809al.txt:216",
   "file": "D0809al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が金切り声を上げ、頭上を通り過ぎた。",
   "ko_candidate": "바람이 귀를 찢는 소리를 내며､ 머리 위를 지나갔다｡"
  },
  {
   "id": 14384,
   "key": "D0809al.txt:217",
   "file": "D0809al.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、",
   "ko_candidate": "그리고､"
  },
  {
   "id": 14385,
   "key": "D0809al.txt:220",
   "file": "D0809al.txt",
   "line": 220,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ――――」",
   "ko_candidate": "「낫――――」"
  },
  {
   "id": 14386,
   "key": "D0809al.txt:233",
   "file": "D0809al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の雨が降り注いだ。",
   "ko_candidate": "피의 비가 쏟아졌다｡"
  },
  {
   "id": 14387,
   "key": "D0809al.txt:234",
   "file": "D0809al.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "びちゃびちゃと、一瞬で路上を真っ赤に染め上げる。",
   "ko_candidate": "철철 흘러､ 순식간에 노면을 새빨갛게 물들인다｡"
  },
  {
   "id": 14388,
   "key": "D0809al.txt:235",
   "file": "D0809al.txt",
   "line": 235,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "断末魔が休日の街に響き渡る。 「――――――――ッッ!?」",
   "ko_candidate": "그에 뒤이어､ 손이､ 팔이､ 다리가､ 몸통이､ 내장이､ 목이――사람이었던 부위들이 떨어져 왔다｡"
  },
  {
   "id": 14389,
   "key": "D0809al.txt:247",
   "file": "D0809al.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "不可視の刃が、何も分からない通行人を斬り刻む。",
   "ko_candidate": "단말마가 휴일의 거리에 울려 퍼진다｡ 「――――――――읏읏!?」"
  },
  {
   "id": 14390,
   "key": "D0809al.txt:248",
   "file": "D0809al.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "噴き出る鮮血、辺りは血煙に充たされる。",
   "ko_candidate": "보이지 않는 칼날이､ 아무것도 모르는 행인을 난도질한다｡"
  },
  {
   "id": 14391,
   "key": "D0809al.txt:251",
   "file": "D0809al.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その紅い大気を裂いて、なおも疾る刃――カマイタチ。",
   "ko_candidate": "솟구치는 선혈､ 주변은 핏빛 연기로 가득 찬다｡{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 14392,
   "key": "D0809al.txt:253",
   "file": "D0809al.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは――とても少年のものとは思えない、残忍な愉悦に歪んだ笑みを浮かべる目の前のガキが放ったものだ。",
   "ko_candidate": "그 붉은 대기를 가르고､ 여전히 질주하는 칼날――카마이타치｡ 그것은――도저히 소년의 것이라고는 생각할 수 없는､ 잔인한 쾌락에 일그러진 미소를 띠고 있는､ 눈앞의 꼬마가 내보낸 것이다｡"
  },
  {
   "id": 14393,
   "key": "D0809al.txt:255",
   "file": "D0809al.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺には視える。このガキが走らせる術式。",
   "ko_candidate": "나는 볼 수 있다｡ 이 꼬마가 달리게 하는 술식｡"
  },
  {
   "id": 14394,
   "key": "D0809al.txt:256",
   "file": "D0809al.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の裏を掻く、新たな世界の法則を。",
   "ko_candidate": "세계의 이면을 긁어내는､ 새로운 세계의 법칙을｡"
  },
  {
   "id": 14395,
   "key": "D0809al.txt:257",
   "file": "D0809al.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やはり、こいつは――！",
   "ko_candidate": "역시､ 이놈은――!"
  },
  {
   "id": 14396,
   "key": "D0809al.txt:265",
   "file": "D0809al.txt",
   "line": 265,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「魔術師ッッ！」",
   "ko_candidate": "「마술사앗!」"
  },
  {
   "id": 14397,
   "key": "D0809al.txt:271",
   "file": "D0809al.txt",
   "line": 271,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「しかも此れは―― ハスターの力！」",
   "ko_candidate": "「게다가 이것은――하스터의 힘!」"
  },
  {
   "id": 14398,
   "key": "D0809al.txt:276",
   "file": "D0809al.txt",
   "line": 276,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハスター!?」",
   "ko_candidate": "「하스터!?」"
  },
  {
   "id": 14399,
   "key": "D0809al.txt:280",
   "file": "D0809al.txt",
   "line": 280,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「恐るべきハスターの聲を聴き、渦の悲嘆の溜息、沈黙の星の只中にて険悪に渦巻く窮極の風の狂おしい吹きすさびに耳を傾けよ――」 「『名状しがたいもの』『星間宇宙を歩むもの』、風を司りし旧支配者ハスター！」",
   "ko_candidate": "「두려운 하스터의 목소리를 듣고､ 소용돌이의 비탄의 한숨､ 침묵의 별의 한가운데에서 험악하게 소용돌이치는 궁극의 바람의 미친 듯한 휘몰아침에 귀를 기울여라―― 『형언할 수 없는 자』 『성간우주를 걷는 자』､ 바람을 다스리는 그레이트 올드 원 하스터! ……그 힘을 휘두르다니 이놈!」"
  },
  {
   "id": 14400,
   "key": "D0809al.txt:286",
   "file": "D0809al.txt",
   "line": 286,
   "speaker": "ちびアル / クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……その力を振るうとは此奴！」 「イエ――ッ！　大正解デッス――ッ！」",
   "ko_candidate": "「예――읏! 정답이에요――읏!」"
  },
  {
   "id": 14401,
   "key": "D0809al.txt:297",
   "file": "D0809al.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガキの手の中に、いつの間にか一冊の魔導書があった。古代より伝わる書物ではない。相当新しい、ここ近年に書かれたであろう魔導書だ。",
   "ko_candidate": "꼬마의 손 안에､ 어느새 한 권의 마도서가 있었다｡ 고대로부터 전해 내려오는 서적이 아니다｡"
  },
  {
   "id": 14402,
   "key": "D0809al.txt:304",
   "file": "D0809al.txt",
   "line": 304,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『セラエノ断章』！　そしてこのボクがクラウディウス！　『ブラックロッジ』でアンチクロスやってまーす！　ヨロシクねェ――！」",
   "ko_candidate": "상당히 새로운､ 최근 몇 년 사이에 쓰여졌을 법한 마도서다｡ 「『세라에노 단장』! 그리고 이 제가 클라우디우스! 『블랙로지』에서 안티 크로스 하고 있어요! 잘 부탁해――!」"
  },
  {
   "id": 14403,
   "key": "D0809al.txt:309",
   "file": "D0809al.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――アンチクロス！",
   "ko_candidate": "――안티 크로스!"
  },
  {
   "id": 14404,
   "key": "D0809al.txt:310",
   "file": "D0809al.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしてもその名前を耳にするとは！",
   "ko_candidate": "또다시 그 이름을 듣게 되다니!"
  },
  {
   "id": 14405,
   "key": "D0809al.txt:311",
   "file": "D0809al.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だったら、まさか……",
   "ko_candidate": "그렇다면､ 설마……"
  },
  {
   "id": 14406,
   "key": "D0809al.txt:316",
   "file": "D0809al.txt",
   "line": 316,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そして、こっちのデカブツが――」",
   "ko_candidate": "「그리고､ 이쪽 덩치가――」"
  },
  {
   "id": 14407,
   "key": "D0809al.txt:320",
   "file": "D0809al.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう一人の方も――！",
   "ko_candidate": "다른 한 명도――!"
  },
  {
   "id": 14408,
   "key": "D0809al.txt:329",
   "file": "D0809al.txt",
   "line": 329,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 14410,
   "key": "D0809al.txt:337",
   "file": "D0809al.txt",
   "line": 337,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大男は、背中をこちらに向けるほどに大きく拳を振り被った。エンネアをマギウス・ウィングに包み込み、飛び退いた。",
   "ko_candidate": "심장이 터질 것 같을 정도로 크게 뛴다｡ 엔네아를 마기우스 윙으로 감싸고､ 뛰어 물러났다｡{SE_PLAY(1,\"パンチ\",0,100,false);}<br>"
  },
  {
   "id": 14411,
   "key": "D0809al.txt:342",
   "file": "D0809al.txt",
   "line": 342,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「く……ッ！」",
   "ko_candidate": "「크……읏!」"
  },
  {
   "id": 14412,
   "key": "D0809al.txt:362",
   "file": "D0809al.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大男が、拳を突き出した。",
   "ko_candidate": "큰 남자가､ 주먹을 내질렀다｡"
  },
  {
   "id": 14413,
   "key": "D0809al.txt:363",
   "file": "D0809al.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界が衝撃に、白く眩む。",
   "ko_candidate": "시야가 충격에､ 하얗게 눈부시다｡"
  },
  {
   "id": 14414,
   "key": "D0809al.txt:364",
   "file": "D0809al.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音は遅れて、耳に届いた。",
   "ko_candidate": "폭음은 뒤늦게､ 귀에 들려왔다｡"
  },
  {
   "id": 14415,
   "key": "D0809al.txt:379",
   "file": "D0809al.txt",
   "line": 379,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐあああああああああっ！」",
   "ko_candidate": "공간이､ 폭쇄된다｡ 「그아아아아아아아아악!」"
  },
  {
   "id": 14416,
   "key": "D0809al.txt:382",
   "file": "D0809al.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "空間が、爆砕する。 吹き飛ばされ、またしても地面を転がり回る羽目になった。エンネアを胸の中に抱いて、しっかりと守る。",
   "ko_candidate": "날아가 또다시 땅바닥을 구르고 말았다｡"
  },
  {
   "id": 14417,
   "key": "D0809al.txt:391",
   "file": "D0809al.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何メートルも飛ばされて、ようやく止まった。",
   "ko_candidate": "엔네아를 가슴에 안고 꽉 지켰다｡ 몇 미터나 날아가 겨우 멈췄다｡"
  },
  {
   "id": 14418,
   "key": "D0809al.txt:392",
   "file": "D0809al.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "起き上がり、状況を確認する。",
   "ko_candidate": "일어나 상황을 확인한다｡ 「아…………아아아아……읏!」"
  },
  {
   "id": 14419,
   "key": "D0809al.txt:397",
   "file": "D0809al.txt",
   "line": 397,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ…………ああああ……ッッ！」",
   "ko_candidate": "「…………읏!」 「――――――」"
  },
  {
   "id": 14420,
   "key": "D0809al.txt:403",
   "file": "D0809al.txt",
   "line": 403,
   "speaker": "アル / エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ！」 「――――――」",
   "ko_candidate": "내가 본 것은 파헤쳐진 아스팔트｡ 뚫린 분화구｡"
  }
 ]
