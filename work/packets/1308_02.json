 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 33624,
   "key": "D1308al.txt:229",
   "file": "D1308al.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "１人が指を差した。",
   "ko_candidate": "한 사람이 손가락을 가리켰다｡"
  },
  {
   "id": 33625,
   "key": "D1308al.txt:230",
   "file": "D1308al.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その先に転がっている。",
   "ko_candidate": "그 앞에 굴러다니고 있다｡"
  },
  {
   "id": 33626,
   "key": "D1308al.txt:232",
   "file": "D1308al.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凄惨の只中",
   "ko_candidate": "참혹함의 한가운데"
  },
  {
   "id": 33627,
   "key": "D1308al.txt:233",
   "file": "D1308al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慟哭の只中",
   "ko_candidate": "통곡의 한가운데"
  },
  {
   "id": 33628,
   "key": "D1308al.txt:234",
   "file": "D1308al.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ一点の曇りも無く、迷いも無い。",
   "ko_candidate": "단 하나의 흐림도 없이､ 망설임도 없이｡"
  },
  {
   "id": 33629,
   "key": "D1308al.txt:236",
   "file": "D1308al.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは――無垢なる刃。",
   "ko_candidate": "그것은――무구한 칼날｡"
  },
  {
   "id": 33630,
   "key": "D1308al.txt:239",
   "file": "D1308al.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――――――――――胸が",
   "ko_candidate": "――――――――――가슴이"
  },
  {
   "id": 33631,
   "key": "D1308al.txt:240",
   "file": "D1308al.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛い――――――――――",
   "ko_candidate": "아파――――――――――"
  },
  {
   "id": 33632,
   "key": "D1308al.txt:249",
   "file": "D1308al.txt",
   "line": 249,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まだ！ まだ戦えと云うのか!? まだこんな路を 進めと云うのか!?」 「こんな苦しみが、こんな孤独が、汝等のような贄を生み続け、汝等の呪詛を未来永劫に背負い続けるのが妾に課せられた罰なのか!?」",
   "ko_candidate": "「아직! 아직 싸우라는 거냐!? 아직 이런 길을 가라는 거냐!? 이런 고통이､ 이런 고독이､ 너희들 같은 제물을 계속 만들어내고､ 너희들의 저주를 미래영겁토록 짊어지고 가는 것이 첩에게 내려진 벌이란 말이냐!? 그런… 그런 것을､ 견딜 수 있을 리가 없잖아……!」"
  },
  {
   "id": 33633,
   "key": "D1308al.txt:258",
   "file": "D1308al.txt",
   "line": 258,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんな…… そんなものに、堪え切れる訳が 無いではないかぁ……ッ！」 既に魂は疲弊し切っていた筈なのに、感情は堰を切って溢れ出した。",
   "ko_candidate": "이미 영혼은 지쳐 있었을 텐데､ 감정은 둑이 무너지듯 넘쳐흘렀다｡"
  },
  {
   "id": 33634,
   "key": "D1308al.txt:264",
   "file": "D1308al.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分でもどうする事が出来ない。",
   "ko_candidate": "스스로도 어찌할 수 없다｡"
  },
  {
   "id": 33635,
   "key": "D1308al.txt:266",
   "file": "D1308al.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただ、みっともなく、 身勝手に泣きじゃくるだけだった。",
   "ko_candidate": "그저､ 보기 흉하게､ 제멋대로 엉엉 울 뿐이었다｡"
  },
  {
   "id": 33636,
   "key": "D1308al.txt:268",
   "file": "D1308al.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この千年、これほどの激情に掻き乱された試しがない。",
   "ko_candidate": "이 천 년 동안､ 이토록 격렬한 감정에 휩싸인 적이 없다｡"
  },
  {
   "id": 33637,
   "key": "D1308al.txt:270",
   "file": "D1308al.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だからなおの事、泣きじゃくる。",
   "ko_candidate": "그래서 더욱､ 엉엉 운다｡"
  },
  {
   "id": 33638,
   "key": "D1308al.txt:272",
   "file": "D1308al.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣きじゃくる自分を制御出来ない事が、苛立たしく、情けなく、悲しくて、泣きじゃくる。",
   "ko_candidate": "엉엉 우는 자신을 제어할 수 없다는 것이､ 짜증 나고､ 한심하고､ 슬퍼서､ 엉엉 운다｡"
  },
  {
   "id": 33639,
   "key": "D1308al.txt:274",
   "file": "D1308al.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "止まることは無い。止める術すら知らない。",
   "ko_candidate": "멈출 수 없다｡ 멈추는 방법조차 모른다｡"
  },
  {
   "id": 33640,
   "key": "D1308al.txt:278",
   "file": "D1308al.txt",
   "line": 278,
   "speaker": "過去の主",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……すまない」",
   "ko_candidate": "「……미안해」"
  },
  {
   "id": 33641,
   "key": "D1308al.txt:281",
   "file": "D1308al.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聲を持たない筈の骸が喋った。",
   "ko_candidate": "목소리가 없어야 할 시체가 말을 했다｡"
  },
  {
   "id": 33642,
   "key": "D1308al.txt:282",
   "file": "D1308al.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "第一声がそれ。",
   "ko_candidate": "첫마디가 그것이었다｡"
  },
  {
   "id": 33643,
   "key": "D1308al.txt:287",
   "file": "D1308al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は感情をぶつけるように、彼に叫ぶ。",
   "ko_candidate": "첩은 감정을 부딪치듯이 그에게 외친다｡"
  },
  {
   "id": 33644,
   "key": "D1308al.txt:291",
   "file": "D1308al.txt",
   "line": 291,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何故、謝る!?」",
   "ko_candidate": "「왜 사과해!?」"
  },
  {
   "id": 33645,
   "key": "D1308al.txt:294",
   "file": "D1308al.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼の、主達の顔は、酷く穏やかだ。",
   "ko_candidate": "그의､ 주인들의 얼굴은 무척이나 평온하다｡"
  },
  {
   "id": 33646,
   "key": "D1308al.txt:295",
   "file": "D1308al.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは骸とは思えない。斃れた者とは思えない。 何故なのだろう。",
   "ko_candidate": "그것은 시체라고는 생각되지 않는다｡ 쓰러진 자라고는 생각되지 않는다｡"
  },
  {
   "id": 33647,
   "key": "D1308al.txt:298",
   "file": "D1308al.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "別の聲が、妾の問いに答える。",
   "ko_candidate": "왜일까｡ 다른 목소리가 첩의 물음에 답한다｡"
  },
  {
   "id": 33648,
   "key": "D1308al.txt:302",
   "file": "D1308al.txt",
   "line": 302,
   "speaker": "過去の主",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「私達の心は、お前と共には無かった。戦いの最中ですら」",
   "ko_candidate": "「우리의 마음은 너와 함께하지 않았다｡ 싸움의 한가운데에서조차」"
  },
  {
   "id": 33649,
   "key": "D1308al.txt:305",
   "file": "D1308al.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……それは妾も同じこと。",
   "ko_candidate": "……그것은 첩도 마찬가지다｡"
  },
  {
   "id": 33650,
   "key": "D1308al.txt:307",
   "file": "D1308al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そもそも、そういう契約ではなかったか。",
   "ko_candidate": "애초에 그런 계약이 아니었던가｡"
  },
  {
   "id": 33651,
   "key": "D1308al.txt:308",
   "file": "D1308al.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾がそのように利用したのだから。",
   "ko_candidate": "첩이 그렇게 이용한 것이니까｡"
  },
  {
   "id": 33652,
   "key": "D1308al.txt:309",
   "file": "D1308al.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "故に、何ら汝等が謝る事があろうか。",
   "ko_candidate": "그러니 너희들이 사과할 일이 있겠는가｡"
  },
  {
   "id": 33653,
   "key": "D1308al.txt:310",
   "file": "D1308al.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は……",
   "ko_candidate": "첩은……"
  },
  {
   "id": 33654,
   "key": "D1308al.txt:314",
   "file": "D1308al.txt",
   "line": 314,
   "speaker": "過去の主",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「彼は違う」",
   "ko_candidate": "「그는 달라」"
  },
  {
   "id": 33655,
   "key": "D1308al.txt:317",
   "file": "D1308al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "涙が止まる。",
   "ko_candidate": "눈물이 멈춘다｡"
  },
  {
   "id": 33656,
   "key": "D1308al.txt:319",
   "file": "D1308al.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼？",
   "ko_candidate": "그?"
  },
  {
   "id": 33657,
   "key": "D1308al.txt:321",
   "file": "D1308al.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰だ。誰のことだ。",
   "ko_candidate": "누구지｡ 누구 얘기지｡"
  },
  {
   "id": 33658,
   "key": "D1308al.txt:325",
   "file": "D1308al.txt",
   "line": 325,
   "speaker": "過去の主",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「彼はお前の心を満たした。 お前の穴を満たした。 お前は――彼と出逢う為、 戦い続けたのだから」",
   "ko_candidate": "「그는 네 마음을 채웠어｡ 네 구멍을 채웠어｡ 너는――그와 만나기 위해､ 계속 싸워왔으니까」"
  },
  {
   "id": 33659,
   "key": "D1308al.txt:333",
   "file": "D1308al.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは――",
   "ko_candidate": "그것은――"
  },
  {
   "id": 33660,
   "key": "D1308al.txt:351",
   "file": "D1308al.txt",
   "line": 351,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――っ！」",
   "ko_candidate": "「――――읏!」"
  },
  {
   "id": 33661,
   "key": "D1308al.txt:354",
   "file": "D1308al.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎！",
   "ko_candidate": "쿠로!"
  },
  {
   "id": 33662,
   "key": "D1308al.txt:355",
   "file": "D1308al.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎！",
   "ko_candidate": "쿠로!"
  },
  {
   "id": 33663,
   "key": "D1308al.txt:356",
   "file": "D1308al.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎！",
   "ko_candidate": "쿠로!"
  }
 ]
}