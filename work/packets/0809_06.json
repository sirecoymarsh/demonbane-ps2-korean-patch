 },
 "items": [
  {
   "id": 14582,
   "key": "D0809al.txt:1246",
   "file": "D0809al.txt",
   "line": 1246,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラウディウス目がけて、貫手を突き出す。風の結界が腕を切り裂くが……弱い！　このまま一気にいける！",
   "ko_candidate": "클라우디우스를 향해 관수를 내지른다｡ 바람의 결계가 팔을 베어내지만… 약하다! 이대로 한 번에 갈 수 있어!"
  },
  {
   "id": 14583,
   "key": "D0809al.txt:1248",
   "file": "D0809al.txt",
   "line": 1248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "防御陣を突破し、そのままクラウディウスの顔を――",
   "ko_candidate": "방어진을 돌파하고､ 그대로 클라우디우스의 얼굴을――"
  },
  {
   "id": 14584,
   "key": "D0809al.txt:1263",
   "file": "D0809al.txt",
   "line": 1263,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ブルぐわあああアアアアああああああ――――っ！」",
   "ko_candidate": "「부르구와아아아아아아아아아아――――읏!」"
  },
  {
   "id": 14585,
   "key": "D0809al.txt:1268",
   "file": "D0809al.txt",
   "line": 1268,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――っ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 14586,
   "key": "D0809al.txt:1273",
   "file": "D0809al.txt",
   "line": 1273,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……おいっ!?」",
   "ko_candidate": "「…어이!?」"
  },
  {
   "id": 14587,
   "key": "D0809al.txt:1279",
   "file": "D0809al.txt",
   "line": 1279,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何だと……！」",
   "ko_candidate": "「뭐､ 뭐지…!」"
  },
  {
   "id": 14588,
   "key": "D0809al.txt:1286",
   "file": "D0809al.txt",
   "line": 1286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "驚く間も一瞬。",
   "ko_candidate": "놀랄 틈도 없이｡"
  },
  {
   "id": 14589,
   "key": "D0809al.txt:1295",
   "file": "D0809al.txt",
   "line": 1295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もクラウディウスも爆発に巻き込まれた。",
   "ko_candidate": "나도 클라우디우스의 폭발에 휘말렸다｡"
  },
  {
   "id": 14590,
   "key": "D0809al.txt:1296",
   "file": "D0809al.txt",
   "line": 1296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆風に灼かれ、衝撃が全身を蹂躙する。",
   "ko_candidate": "폭풍에 그을리고､ 충격이 온몸을 유린한다｡"
  },
  {
   "id": 14591,
   "key": "D0809al.txt:1299",
   "file": "D0809al.txt",
   "line": 1299,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐあああああああ！」",
   "ko_candidate": "「구아아아아아아아!」"
  },
  {
   "id": 14592,
   "key": "D0809al.txt:1304",
   "file": "D0809al.txt",
   "line": 1304,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちぃぃぃ！」",
   "ko_candidate": "「치이이이!」"
  },
  {
   "id": 14593,
   "key": "D0809al.txt:1316",
   "file": "D0809al.txt",
   "line": 1316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・ウィングで全身を包み込み、爆風から身を守った。",
   "ko_candidate": "마기우스 윙으로 온몸을 감싸 폭풍으로부터 몸을 지켰다｡"
  },
  {
   "id": 14594,
   "key": "D0809al.txt:1317",
   "file": "D0809al.txt",
   "line": 1317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地面を転がる勢いを利用して、起き上がる。",
   "ko_candidate": "땅을 구르는 기세를 이용해 일어선다｡"
  },
  {
   "id": 14595,
   "key": "D0809al.txt:1318",
   "file": "D0809al.txt",
   "line": 1318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を激痛が苛むが、無理矢理に無視した。",
   "ko_candidate": "온몸에 격통이 몰아치지만､ 억지로 무시했다｡"
  },
  {
   "id": 14596,
   "key": "D0809al.txt:1320",
   "file": "D0809al.txt",
   "line": 1320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いったい何が起こった……!?",
   "ko_candidate": "도대체 무슨 일이 일어난 거지…!?"
  },
  {
   "id": 14597,
   "key": "D0809al.txt:1326",
   "file": "D0809al.txt",
   "line": 1326,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふんっ……」",
   "ko_candidate": "「흥…」"
  },
  {
   "id": 14598,
   "key": "D0809al.txt:1329",
   "file": "D0809al.txt",
   "line": 1329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――カリグラか!?",
   "ko_candidate": "――칼리굴라인가!?"
  },
  {
   "id": 14599,
   "key": "D0809al.txt:1330",
   "file": "D0809al.txt",
   "line": 1330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの野郎、仲間ごと俺を攻撃しやがった！",
   "ko_candidate": "그 자식､ 동료까지 포함해서 날 공격해버렸어!"
  },
  {
   "id": 14600,
   "key": "D0809al.txt:1332",
   "file": "D0809al.txt",
   "line": 1332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠くで、一緒に吹き飛ばされたクラウディウスが、受身も取れず、顔面から地面に墜落した。",
   "ko_candidate": "멀리서､ 함께 날아간 클라우디우스가 몸을 제대로 가누지 못하고 얼굴부터 땅에 떨어졌다｡"
  },
  {
   "id": 14601,
   "key": "D0809al.txt:1337",
   "file": "D0809al.txt",
   "line": 1337,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「痛っっっっっっっっっってぇぇぇぇぇ！ クッ……オルァアア！　デカブツ！　てめえ、ボクごと吹っ飛ばしやがったな！」",
   "ko_candidate": "「아파아아아아아아아아아! 이 자식아! 덩치! 네놈､ 나까지 날려버렸잖아!」"
  },
  {
   "id": 14602,
   "key": "D0809al.txt:1342",
   "file": "D0809al.txt",
   "line": 1342,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「自業自得ダ。油断しているから何度も不覚を取ル」",
   "ko_candidate": "「자업자득이다｡ 방심하고 있어서 몇 번이나 실수를 하는 거다」"
  },
  {
   "id": 14603,
   "key": "D0809al.txt:1345",
   "file": "D0809al.txt",
   "line": 1345,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……また仲間割れかよ。",
   "ko_candidate": "…또 내분이냐｡"
  },
  {
   "id": 14604,
   "key": "D0809al.txt:1346",
   "file": "D0809al.txt",
   "line": 1346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがこれで、こいつらに常識が通じないことは分かった。",
   "ko_candidate": "하지만 이걸로､ 이놈들에게 상식이 통하지 않는다는 걸 알았다｡"
  },
  {
   "id": 14605,
   "key": "D0809al.txt:1346",
   "file": "D0809al.txt",
   "line": 1346,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "メチャクチャしやがる。",
   "ko_candidate": "엉망진창이군｡"
  },
  {
   "id": 14606,
   "key": "D0809al.txt:1349",
   "file": "D0809al.txt",
   "line": 1349,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐ……っっっ！」",
   "ko_candidate": "「크… 읏읏읏!」"
  },
  {
   "id": 14607,
   "key": "D0809al.txt:1356",
   "file": "D0809al.txt",
   "line": 1356,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎……ッ！」",
   "ko_candidate": "「쿠로…읏!」"
  },
  {
   "id": 14608,
   "key": "D0809al.txt:1359",
   "file": "D0809al.txt",
   "line": 1359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛みに堪えかね、膝を突く俺。",
   "ko_candidate": "고통을 참지 못하고 무릎을 꿇는 나｡"
  },
  {
   "id": 14609,
   "key": "D0809al.txt:1360",
   "file": "D0809al.txt",
   "line": 1360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咽喉に込み上げる熱い塊を、吐き出した。",
   "ko_candidate": "목구멍으로 치밀어 오르는 뜨거운 덩어리를 토해냈다｡"
  },
  {
   "id": 14610,
   "key": "D0809al.txt:1361",
   "file": "D0809al.txt",
   "line": 1361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベシャっと赤黒い血が、地面に飛び散る。",
   "ko_candidate": "베샤앗 하고 검붉은 피가 땅에 튀었다｡"
  },
  {
   "id": 14611,
   "key": "D0809al.txt:1364",
   "file": "D0809al.txt",
   "line": 1364,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今のでやられちまった。クソッタレ」",
   "ko_candidate": "「방금 그걸로 당해버렸어｡ 젠장」"
  },
  {
   "id": 14612,
   "key": "D0809al.txt:1366",
   "file": "D0809al.txt",
   "line": 1366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仲間を巻き込んだとはいえ、考えなしの無差別ってワケではなかったようだ。",
   "ko_candidate": "동료를 휘말리게 했다고는 해도､ 생각 없는 무차별은 아니었던 모양이다｡"
  },
  {
   "id": 14613,
   "key": "D0809al.txt:1367",
   "file": "D0809al.txt",
   "line": 1367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ダメージは明らかに俺の方が大きい。",
   "ko_candidate": "데미지는 분명히 내가 더 크다｡"
  },
  {
   "id": 14614,
   "key": "D0809al.txt:1373",
   "file": "D0809al.txt",
   "line": 1373,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「この程度……！」",
   "ko_candidate": "「이 정도…!」"
  },
  {
   "id": 14615,
   "key": "D0809al.txt:1379",
   "file": "D0809al.txt",
   "line": 1379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルが呪文を唱えると、全身を穏やかな光が包み込んだ。",
   "ko_candidate": "알이 주문을 외우자､ 온몸을 온화한 빛이 감쌌다｡"
  },
  {
   "id": 14616,
   "key": "D0809al.txt:1379",
   "file": "D0809al.txt",
   "line": 1379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身体が熱く火照る。",
   "ko_candidate": "몸이 뜨겁게 달아오른다｡"
  },
  {
   "id": 14617,
   "key": "D0809al.txt:1380",
   "file": "D0809al.txt",
   "line": 1380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を駆け回る激痛が、背中の痛みが、拳と腕の裂傷が、少しずつ静かに引いていく。",
   "ko_candidate": "온몸을 달리는 격통이､ 등의 통증이､ 주먹과 팔의 열상이､ 조금씩 조용히 사라져간다｡"
  },
  {
   "id": 14618,
   "key": "D0809al.txt:1388",
   "file": "D0809al.txt",
   "line": 1388,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これで、多少はマシになったが……無茶は出来んぞ。気をつけろ」",
   "ko_candidate": "「이걸로､ 어느 정도는 나아졌지만… 무리는 하지 마｡ 조심해」"
  },
  {
   "id": 14619,
   "key": "D0809al.txt:1396",
   "file": "D0809al.txt",
   "line": 1396,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「善処するけどよ……」",
   "ko_candidate": "「최선을 다하겠지만…」"
  },
  {
   "id": 14620,
   "key": "D0809al.txt:1398",
   "file": "D0809al.txt",
   "line": 1398,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "前方を睨みつける。",
   "ko_candidate": "앞을 노려본다｡"
  },
  {
   "id": 14621,
   "key": "D0809al.txt:1399",
   "file": "D0809al.txt",
   "line": 1399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身構えるカリグラと、その横に並ぶクラウディウス。",
   "ko_candidate": "자세를 잡은 칼리굴라와､ 그 옆에 서 있는 클라우디우스｡"
  }
 ]
}