 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "マスターテリオン": "마스터 테리온",
  "アル": "알",
  "大十字九郎": "다이쥬지 쿠로",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 46102,
   "key": "D1511ru.txt:15",
   "file": "D1511ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠くには鈍く烈しく光を放ち、存在を高らかに主張する赤い太陽が見える。",
   "ko_candidate": "멀리 둔하고 격렬하게 빛을 발하며､ 존재를 당당히 주장하는 붉은 태양이"
  },
  {
   "id": 46103,
   "key": "D1511ru.txt:19",
   "file": "D1511ru.txt",
   "line": 19,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……またギリギリのところで、飛ばされたか……つぅ……」",
   "ko_candidate": "보인다｡ 「……또 아슬아슬하게 날아왔나……츠……」"
  },
  {
   "id": 46104,
   "key": "D1511ru.txt:25",
   "file": "D1511ru.txt",
   "line": 25,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……はっ……！　状況は……？」",
   "ko_candidate": "「크윽……핫……! 상황은……?」"
  },
  {
   "id": 46105,
   "key": "D1511ru.txt:30",
   "file": "D1511ru.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの全身は半ば熔けかかっていた。",
   "ko_candidate": "데몬베인의 전신은 반쯤 녹아내리고 있었다｡"
  },
  {
   "id": 46106,
   "key": "D1511ru.txt:31",
   "file": "D1511ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやらまたしても時空の揺らぎに助けられることとなったらしい。",
   "ko_candidate": "어쩌면 또다시 시공의 흔들림에 도움을 받게 된 모양이다｡"
  },
  {
   "id": 46107,
   "key": "D1511ru.txt:33",
   "file": "D1511ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが状況は良くない。",
   "ko_candidate": "하지만 상황은 좋지 않다｡"
  },
  {
   "id": 46108,
   "key": "D1511ru.txt:35",
   "file": "D1511ru.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなに彗星が絶え間なく降り注いでいる宙域だ。",
   "ko_candidate": "이렇게 혜성이 끊임없이 쏟아지는 우주 영역이다｡"
  },
  {
   "id": 46109,
   "key": "D1511ru.txt:36",
   "file": "D1511ru.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このままじゃ巻き込まれて、こっちまで流れ星になっちまう。",
   "ko_candidate": "이대로라면 휘말려서 이쪽까지 유성이 되고 말 거야｡"
  },
  {
   "id": 46110,
   "key": "D1511ru.txt:38",
   "file": "D1511ru.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに、マスターテリオンから逃れたワケだってない……",
   "ko_candidate": "게다가 마스터 테리온에게서 벗어난 것도 아니고……"
  },
  {
   "id": 46111,
   "key": "D1511ru.txt:45",
   "file": "D1511ru.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふと影が射し、視界が暗くなった。",
   "ko_candidate": "문득 그림자가 비치며 시야가 어두워졌다｡"
  },
  {
   "id": 46112,
   "key": "D1511ru.txt:47",
   "file": "D1511ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "太陽の光が遮られたのだ。",
   "ko_candidate": "태양의 빛이 가려진 것이다｡"
  },
  {
   "id": 46113,
   "key": "D1511ru.txt:49",
   "file": "D1511ru.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い月の影に、赤い太陽がすっぽりと収まっている――日蝕だ。",
   "ko_candidate": "검은 달의 그림자에 붉은 태양이 쏙 들어가 있다――일식이다｡"
  },
  {
   "id": 46114,
   "key": "D1511ru.txt:50",
   "file": "D1511ru.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い月の円周から洩れる光がルビー色のリングを象っていた。",
   "ko_candidate": "검은 달의 원주에서 새어 나오는 빛이 루비색 고리를 만들고 있었다｡"
  },
  {
   "id": 46115,
   "key": "D1511ru.txt:54",
   "file": "D1511ru.txt",
   "line": 54,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「待て…… あれは月などではない！」",
   "ko_candidate": "「잠깐……저건 달 같은 게 아니야!」 알이 외치는 동시에 그 어둠색 피부가 갈라지고 피를 흘린다｡"
  },
  {
   "id": 46116,
   "key": "D1511ru.txt:64",
   "file": "D1511ru.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルが叫ぶと同時、その闇色の肌が罅割れ、流血する。 黒い月を割って、闇黒があふれ出す。",
   "ko_candidate": "찢어진 상처가 치명적인 크기까지 벌어지고 선혈을 뿜어내며､ 모체를 살해하는 단계에 이르러 어둠색에서 태어난 붉은색､ 그 더 깊은 곳에서 태어난 역광의 그림자가 밀려왔다｡"
  },
  {
   "id": 46117,
   "key": "D1511ru.txt:73",
   "file": "D1511ru.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは牙を持つ。",
   "ko_candidate": "그것은 송곳니를 가졌다｡"
  },
  {
   "id": 46118,
   "key": "D1511ru.txt:74",
   "file": "D1511ru.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは嘴を持つ。",
   "ko_candidate": "그것은 부리를 가졌다｡"
  },
  {
   "id": 46119,
   "key": "D1511ru.txt:75",
   "file": "D1511ru.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは爪を持つ。",
   "ko_candidate": "그것은 발톱을 가졌다｡"
  },
  {
   "id": 46120,
   "key": "D1511ru.txt:76",
   "file": "D1511ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは翼を持つ。",
   "ko_candidate": "그것은 날개를 가졌다｡"
  },
  {
   "id": 46121,
   "key": "D1511ru.txt:77",
   "file": "D1511ru.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは鋏を持つ。",
   "ko_candidate": "그것은 집게를 가졌다｡"
  },
  {
   "id": 46122,
   "key": "D1511ru.txt:79",
   "file": "D1511ru.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは毛を持つ。",
   "ko_candidate": "그것은 털을 가졌다｡"
  },
  {
   "id": 46123,
   "key": "D1511ru.txt:80",
   "file": "D1511ru.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは鱗を持つ。",
   "ko_candidate": "그것은 비늘을 가졌다｡"
  },
  {
   "id": 46124,
   "key": "D1511ru.txt:81",
   "file": "D1511ru.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは殻を持つ。",
   "ko_candidate": "그것은 껍질을 가졌다｡"
  },
  {
   "id": 46125,
   "key": "D1511ru.txt:82",
   "file": "D1511ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは角を持つ。",
   "ko_candidate": "그것은 뿔을 가졌다｡"
  },
  {
   "id": 46126,
   "key": "D1511ru.txt:83",
   "file": "D1511ru.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは針を持つ。",
   "ko_candidate": "그것은 바늘을 가졌다｡"
  },
  {
   "id": 46127,
   "key": "D1511ru.txt:85",
   "file": "D1511ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは――無数の、あらゆる種の獣の群れ。",
   "ko_candidate": "그것은――무수한､ 온갖 종류의 짐승 무리｡"
  },
  {
   "id": 46128,
   "key": "D1511ru.txt:86",
   "file": "D1511ru.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "生み落とされた黒き、背徳のケダモノども。",
   "ko_candidate": "태어난 검은､ 배덕의 짐승들｡"
  },
  {
   "id": 46129,
   "key": "D1511ru.txt:90",
   "file": "D1511ru.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無音であるはずの宇宙に、獣どもの咆吼が木魂する。",
   "ko_candidate": "무음이어야 할 우주에 짐승들의 포효가 메아리친다｡"
  },
  {
   "id": 46130,
   "key": "D1511ru.txt:97",
   "file": "D1511ru.txt",
   "line": 97,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な――っ！」",
   "ko_candidate": "「뭐――!」"
  },
  {
   "id": 46131,
   "key": "D1511ru.txt:103",
   "file": "D1511ru.txt",
   "line": 103,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「早速かよ!?　くそっ……があああああっ！」",
   "ko_candidate": "「벌써냐!? 젠장……가아아아아악!」"
  },
  {
   "id": 46132,
   "key": "D1511ru.txt:110",
   "file": "D1511ru.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "獣達は動けないデモンベインをすっぽりと覆い、牙を爪を嘴を角を針を、その獣が獲物を狩る為に与えられた得物を突き立ててくる。",
   "ko_candidate": "짐승들은 움직일 수 없는 데몬베인을 완전히 덮고､ 송곳니와 발톱과 부리와 뿔과 바늘을､ 그 짐승이 먹이를 사냥하기 위해 주어진 도구를 찔러 넣어온다｡"
  },
  {
   "id": 46133,
   "key": "D1511ru.txt:112",
   "file": "D1511ru.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処は獣の海の只中。命の箱庭。略奪と凌辱の檻。",
   "ko_candidate": "여기는 짐승의 바다 한가운데｡ 생명의 상자정원｡ 약탈과 능욕의 우리｡"
  },
  {
   "id": 46134,
   "key": "D1511ru.txt:113",
   "file": "D1511ru.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "牙を持たぬ生贄として、俺達は貪り喰われる。",
   "ko_candidate": "송곳니를 가지지 않은 제물로서､ 우리는 탐욕스럽게 먹힌다｡"
  },
  {
   "id": 46135,
   "key": "D1511ru.txt:117",
   "file": "D1511ru.txt",
   "line": 117,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「羊を装うな、大十字九郎。貴公は余を殺しに来た狩人であろう。 獣に狩られる狩人などあろうはずもない」",
   "ko_candidate": "「양을 가장하지 마라､ 다이쥬지 쿠로｡ 네놈은 나를 죽이러 온 사냥꾼이지 않은가｡ 짐승에게 사냥당하는 사냥꾼 따위 있을 리가 없다」"
  },
  {
   "id": 46136,
   "key": "D1511ru.txt:121",
   "file": "D1511ru.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処からともなく聴こえるマスターテリオンの嘲笑。",
   "ko_candidate": "어디선가 들려오는 마스터 테리온의 조소｡"
  },
  {
   "id": 46137,
   "key": "D1511ru.txt:123",
   "file": "D1511ru.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "好き勝手言ってくれるぜ……こちとら、とっくに限界に来ているつーのによ……っ！",
   "ko_candidate": "마음대로 말하시지……이쪽은 벌써 한계에 다다랐다고……!"
  },
  {
   "id": 46138,
   "key": "D1511ru.txt:127",
   "file": "D1511ru.txt",
   "line": 127,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……九郎、探せ…… この餓鬼結界も……術である以上は核は存在し、破る術もまた当然にある……！」",
   "ko_candidate": "「……쿠로､ 찾아……이 아귀결계도……술식인 이상 핵은 존재하고､ 깨는 방법도 당연히 있어……!」"
  },
  {
   "id": 46139,
   "key": "D1511ru.txt:131",
   "file": "D1511ru.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "貪られながら、俺の認識は世界全体に広がっていく。",
   "ko_candidate": "탐욕스럽게 먹히면서 내 인식은 세계 전체로 퍼져나간다｡"
  },
  {
   "id": 46140,
   "key": "D1511ru.txt:133",
   "file": "D1511ru.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは世界の裏を暴く認識。",
   "ko_candidate": "그것은 세계의 이면을 폭로하는 인식｡"
  },
  {
   "id": 46141,
   "key": "D1511ru.txt:134",
   "file": "D1511ru.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今ある世界を自ら望む世界に書き換える認識。",
   "ko_candidate": "지금 있는 세계를 스스로 원하는 세계로 바꾸는 인식｡"
  }
 ]
}