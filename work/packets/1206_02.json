{
 "packet": "1206_02",
 "scene": "1206",
 "anchor": {
  "hit": 52,
  "total": 52,
  "rate": 1.0
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "クラウディウス": "클라우디우스",
  "魔力": "마력",
  "アトラック＝ナチャ": "아틀락 나차",
  "クトゥグア": "크투가"
 },
 "items": [
  {
   "id": 27805,
   "key": "D1206le.txt:33",
   "file": "D1206le.txt",
   "line": 33,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ、あ……あ、ああ！」",
   "ko_candidate": "「아､ 아……아､ 아아!」"
  },
  {
   "id": 27806,
   "key": "D1206le.txt:36",
   "file": "D1206le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "わずかな呻き声。",
   "ko_candidate": "미약한 신음 소리｡"
  },
  {
   "id": 27807,
   "key": "D1206le.txt:39",
   "file": "D1206le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが引鉄となったのか――鮮血が迸った。",
   "ko_candidate": "그것이 방아쇠가 되었는지―― 선혈이 튀었다｡"
  },
  {
   "id": 27808,
   "key": "D1206le.txt:40",
   "file": "D1206le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界を紅く塗り潰す。",
   "ko_candidate": "시야를 붉게 물들인다｡"
  },
  {
   "id": 27809,
   "key": "D1206le.txt:41",
   "file": "D1206le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼けるように熱い血が、俺の身体に浴びせかけられる。",
   "ko_candidate": "화끈거리듯 뜨거운 피가 내 몸에 쏟아진다｡"
  },
  {
   "id": 27810,
   "key": "D1206le.txt:47",
   "file": "D1206le.txt",
   "line": 47,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐ……は……ああ……て、てめぇ……！」",
   "ko_candidate": "「크……하……아아……이､ 이 자식……!」"
  },
  {
   "id": 27811,
   "key": "D1206le.txt:50",
   "file": "D1206le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なおも噴き出る鮮血の下、傷を押さえる指の間、憎悪を湛えた眸が爛々と輝く。昏い焔に燃えている。",
   "ko_candidate": "여전히 솟구치는 선혈 아래､ 상처를 누르는 손가락 사이로 증오가 담긴 눈동자가 번뜩인다｡ 어두운 불꽃에 타오르고 있다｡"
  },
  {
   "id": 27812,
   "key": "D1206le.txt:55",
   "file": "D1206le.txt",
   "line": 55,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まだだ！　まだトドメには到っておらんぞ！」",
   "ko_candidate": "「아직이다! 아직 최후의 일격에 이르지 않았다!」"
  },
  {
   "id": 27813,
   "key": "D1206le.txt:59",
   "file": "D1206le.txt",
   "line": 59,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「分かっている！」",
   "ko_candidate": "「알고 있어!」"
  },
  {
   "id": 27814,
   "key": "D1206le.txt:68",
   "file": "D1206le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一歩踏み込み、横薙ぎに斬撃を放つ。",
   "ko_candidate": "한 걸음 내딛고 옆으로 베는 공격을 날린다｡"
  },
  {
   "id": 27815,
   "key": "D1206le.txt:71",
   "file": "D1206le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳躍し、その一撃をかわすクラウディウス。とても深手を負っているとは思えない動きだ。",
   "ko_candidate": "도약하여 그 일격을 피하는 클라우디우스｡ 중상을 입었다고는 도저히 생각할 수 없는 움직임이다｡"
  },
  {
   "id": 27816,
   "key": "D1206le.txt:76",
   "file": "D1206le.txt",
   "line": 76,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「調子こいてんじゃねえぞぉぉぉぉ！」",
   "ko_candidate": "「잘난 척하지 마아아아아! 임포 자식아아아아!」"
  },
  {
   "id": 27817,
   "key": "D1206le.txt:80",
   "file": "D1206le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヨーヨーが放たれる。",
   "ko_candidate": "요요가 날아온다｡"
  },
  {
   "id": 27818,
   "key": "D1206le.txt:81",
   "file": "D1206le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "複雑な軌道を描き、唸る。唸る。唸る。",
   "ko_candidate": "복잡한 궤도를 그리며 윙윙거린다｡ 윙윙거린다｡ 윙윙거린다｡"
  },
  {
   "id": 27819,
   "key": "D1206le.txt:82",
   "file": "D1206le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大気を引き裂き、襲いかかってくる。",
   "ko_candidate": "대기를 가르며 덮쳐온다｡"
  },
  {
   "id": 27820,
   "key": "D1206le.txt:85",
   "file": "D1206le.txt",
   "line": 85,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おおっと！」",
   "ko_candidate": "「어이쿠!」"
  },
  {
   "id": 27821,
   "key": "D1206le.txt:87",
   "file": "D1206le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛び退き、かわす。",
   "ko_candidate": "뛰어 물러나 피한다｡"
  },
  {
   "id": 27822,
   "key": "D1206le.txt:88",
   "file": "D1206le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヨーヨーの一撃が床を砕く。だが、それだけに留まらない。",
   "ko_candidate": "요요의 일격이 바닥을 부순다｡ 하지만 그것으로 끝나지 않는다｡"
  },
  {
   "id": 27823,
   "key": "D1206le.txt:91",
   "file": "D1206le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げる俺を狙い、ヨーヨーは床を車輪のように転がる。",
   "ko_candidate": "도망치는 나를 노리고 요요는 바닥을 바퀴처럼 굴러온다｡"
  },
  {
   "id": 27824,
   "key": "D1206le.txt:92",
   "file": "D1206le.txt",
   "line": 92,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『犬の散歩』ってやつだ。",
   "ko_candidate": "『개 산책』이라는 거다｡"
  },
  {
   "id": 27825,
   "key": "D1206le.txt:93",
   "file": "D1206le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "床を抉り、轍を作って迫る。",
   "ko_candidate": "바닥을 파헤치며 바퀴자국을 만들어 다가온다｡"
  },
  {
   "id": 27826,
   "key": "D1206le.txt:98",
   "file": "D1206le.txt",
   "line": 98,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「轢き裂いてやる！」",
   "ko_candidate": "「갈가리 찢어주마!」"
  },
  {
   "id": 27827,
   "key": "D1206le.txt:102",
   "file": "D1206le.txt",
   "line": 102,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちぃっ！」",
   "ko_candidate": "「칫!」"
  },
  {
   "id": 27828,
   "key": "D1206le.txt:104",
   "file": "D1206le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔面を狙ってか、眼前でヨーヨーが跳ねた。",
   "ko_candidate": "얼굴을 노리는 듯 눈앞에서 요요가 튀어 올랐다｡"
  },
  {
   "id": 27829,
   "key": "D1206le.txt:105",
   "file": "D1206le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀を顔の前で構える。",
   "ko_candidate": "언월도를 얼굴 앞에 겨눈다｡"
  },
  {
   "id": 27830,
   "key": "D1206le.txt:109",
   "file": "D1206le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火花が散った。",
   "ko_candidate": "불꽃이 튀었다｡"
  },
  {
   "id": 27831,
   "key": "D1206le.txt:110",
   "file": "D1206le.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれ、ヨーヨーは再びクラウディウスの掌中に戻る。",
   "ko_candidate": "튕겨나가 요요는 다시 클라우디우스의 손바닥으로 돌아간다｡"
  },
  {
   "id": 27832,
   "key": "D1206le.txt:112",
   "file": "D1206le.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……偃月刀を持つ両手が痺れている。",
   "ko_candidate": "……언월도를 쥔 양손이 저리다｡"
  },
  {
   "id": 27833,
   "key": "D1206le.txt:113",
   "file": "D1206le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見た目によらず、相当のパワーを持っているみたいだ。",
   "ko_candidate": "겉모습과 달리 상당한 파워를 가지고 있는 것 같다｡"
  },
  {
   "id": 27834,
   "key": "D1206le.txt:114",
   "file": "D1206le.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうそう何度も受け止められねえな、こいつは。",
   "ko_candidate": "그리 여러 번 받아낼 수는 없겠어､ 이놈은｡"
  },
  {
   "id": 27835,
   "key": "D1206le.txt:116",
   "file": "D1206le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなことを考えている間にも、クラウディウスは２撃目を放とうと、ヨーヨーに魔力を集めている。",
   "ko_candidate": "그런 생각을 하는 동안에도 클라우디우스는 2타를 날리려고 요요에 마력을 모으고 있다｡"
  },
  {
   "id": 27836,
   "key": "D1206le.txt:121",
   "file": "D1206le.txt",
   "line": 121,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「殺ァァァァァ！」",
   "ko_candidate": "「죽여어어어어!」"
  },
  {
   "id": 27837,
   "key": "D1206le.txt:125",
   "file": "D1206le.txt",
   "line": 125,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「させるか！　アトラック＝ナチャ！」",
   "ko_candidate": "「못하게 해주지! 아틀락 나챠!」"
  },
  {
   "id": 27838,
   "key": "D1206le.txt:128",
   "file": "D1206le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の髪に魔力が流れ、命を得たように、独りでにうねり出す。",
   "ko_candidate": "내 머리카락에 마력이 흐르고 생명을 얻은 듯 저절로 꿈틀거리기 시작한다｡"
  },
  {
   "id": 27839,
   "key": "D1206le.txt:129",
   "file": "D1206le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "伸長し、獲物に跳びかかる蛇のように、床に転がるクトゥグアを捉えた。",
   "ko_candidate": "길어져서 먹이에 달려드는 뱀처럼 바닥에 굴러다니는 크투가를 붙잡았다｡"
  },
  {
   "id": 27840,
   "key": "D1206le.txt:134",
   "file": "D1206le.txt",
   "line": 134,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な――っ!?」",
   "ko_candidate": "「뭐――!?」"
  },
  {
   "id": 27841,
   "key": "D1206le.txt:138",
   "file": "D1206le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一気に手繰り寄せ、右手の中に落とす。",
   "ko_candidate": "단숨에 끌어당겨 오른손 안에 떨어뜨린다｡"
  },
  {
   "id": 27842,
   "key": "D1206le.txt:143",
   "file": "D1206le.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "グリップを握り締め、トリガーに指を置く。",
   "ko_candidate": "그립을 꽉 쥐고 방아쇠에 손가락을 올린다｡"
  },
  {
   "id": 27843,
   "key": "D1206le.txt:145",
   "file": "D1206le.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただそれだけのことで、クトゥグアは俺の躰の一部であるかのように、その先端まで魔力が行き渡る。",
   "ko_candidate": "그것만으로도 크투가는 내 몸의 일부인 것처럼 그 끝까지 마력이 퍼진다｡"
  },
  {
   "id": 27844,
   "key": "D1206le.txt:148",
   "file": "D1206le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヨーヨーが放たれた。",
   "ko_candidate": "요요가 날아왔다｡"
  }
 ]
}