   "key": "D1401al.txt:779",
   "file": "D1401al.txt",
   "line": 779,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "スレスレのところを龍の顎が通り過ぎていった。",
