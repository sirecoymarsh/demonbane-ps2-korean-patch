 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "九郎ちゃん": "쿠로 군",
  "ヨグ＝ソトース": "요그 소토스",
  "アル": "알",
  "デモンベイン": "데몬베인",
  "九郎": "쿠로",
  "ナイア": "나이아"
 },
 "items": [
  {
   "id": 48735,
   "key": "D1519le.txt:13",
   "file": "D1519le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今はもう空っぽの膝の上を、ライカさんは黙って見下ろしている。",
   "ko_candidate": "이제는 텅 빈 무릎 위를､ 라이카 씨는 말없이 내려다보고 있다｡"
  },
  {
   "id": 48736,
   "key": "D1519le.txt:14",
   "file": "D1519le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……何となく、声がかけ辛い。",
   "ko_candidate": "…왠지 말을 걸기가 어렵다｡"
  },
  {
   "id": 48737,
   "key": "D1519le.txt:20",
   "file": "D1519le.txt",
   "line": 20,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎ちゃん」",
   "ko_candidate": "「…쿠로 군」"
  },
  {
   "id": 48738,
   "key": "D1519le.txt:24",
   "file": "D1519le.txt",
   "line": 24,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？」",
   "ko_candidate": "「응?」"
  },
  {
   "id": 48739,
   "key": "D1519le.txt:27",
   "file": "D1519le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "と躊躇してたら、ライカさんの方から声をかけてきた。",
   "ko_candidate": "망설이고 있었더니､ 라이카 씨 쪽에서 먼저 말을 걸어왔다｡"
  },
  {
   "id": 48740,
   "key": "D1519le.txt:28",
   "file": "D1519le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かに堪えるような静かな瞳が、俺を見つめ返す。",
   "ko_candidate": "무언가를 참는 듯한 조용한 눈동자가 나를 바라본다｡"
  },
  {
   "id": 48741,
   "key": "D1519le.txt:34",
   "file": "D1519le.txt",
   "line": 34,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「終わったよ」",
   "ko_candidate": "「끝났어」"
  },
  {
   "id": 48742,
   "key": "D1519le.txt:37",
   "file": "D1519le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そっと告げて、弱々しく微笑んだ。",
   "ko_candidate": "살며시 알리고､ 힘없이 미소 지었다｡"
  },
  {
   "id": 48743,
   "key": "D1519le.txt:38",
   "file": "D1519le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は繋ぐ言葉を知らない。",
   "ko_candidate": "나는 이어갈 말을 모르겠다｡"
  },
  {
   "id": 48744,
   "key": "D1519le.txt:39",
   "file": "D1519le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だからただ、「ああ」と頷くだけだった。",
   "ko_candidate": "그래서 그저 『응』하고 고개를 끄덕일 뿐이었다｡"
  },
  {
   "id": 48745,
   "key": "D1519le.txt:43",
   "file": "D1519le.txt",
   "line": 43,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「帰ろう、九郎ちゃん。私たちが帰るべき家へ。 あの暖かい世界へ」",
   "ko_candidate": "「돌아가자､ 쿠로 군｡ 우리가 돌아가야 할 집으로｡ 그 따뜻한 세계로」"
  },
  {
   "id": 48746,
   "key": "D1519le.txt:47",
   "file": "D1519le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はもう一度、「ああ」と頷いた。",
   "ko_candidate": "나는 다시 한 번 『응』하고 고개를 끄덕였다｡"
  },
  {
   "id": 48747,
   "key": "D1519le.txt:48",
   "file": "D1519le.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただし今度は力強く。",
   "ko_candidate": "다만 이번에는 힘차게｡"
  },
  {
   "id": 48748,
   "key": "D1519le.txt:50",
   "file": "D1519le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの側によって、手を差し出した。",
   "ko_candidate": "라이카 씨 곁으로 다가가 손을 내밀었다｡"
  },
  {
   "id": 48749,
   "key": "D1519le.txt:51",
   "file": "D1519le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんが俺の手を掴む。",
   "ko_candidate": "라이카 씨가 내 손을 잡는다｡"
  },
  {
   "id": 48750,
   "key": "D1519le.txt:52",
   "file": "D1519le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女の温もりが伝わってくる。",
   "ko_candidate": "그녀의 온기가 전해져 온다｡"
  },
  {
   "id": 48751,
   "key": "D1519le.txt:56",
   "file": "D1519le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さあ……問題は山積みだ。",
   "ko_candidate": "자… 문제는 산적해 있다｡"
  },
  {
   "id": 48752,
   "key": "D1519le.txt:57",
   "file": "D1519le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやって、ヨグ＝ソトースの腹の中から脱け出そうか。",
   "ko_candidate": "어떻게 요그 소토스의 배 속에서 빠져나갈까｡"
  },
  {
   "id": 48753,
   "key": "D1519le.txt:57",
   "file": "D1519le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "頼りになりそうなのはデモンベインくらいだが……あんなになっちまってるし。とりあえずアルを叩き起こして――",
   "ko_candidate": "믿을 만한 건 데몬베인 정도지만… 저렇게 되어버렸고｡ 일단 알을 깨워서-"
  },
  {
   "id": 48754,
   "key": "D1519le.txt:61",
   "file": "D1519le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然に襲いかかる戦慄。",
   "ko_candidate": "갑자기 덮쳐오는 전율｡"
  },
  {
   "id": 48755,
   "key": "D1519le.txt:62",
   "file": "D1519le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身が総毛立ち、血の代わりに酸を全身に流し込むような苦痛を伴って、全細胞が危機を訴えてきた。",
   "ko_candidate": "온몸의 털이 곤두서고､ 피 대신 산을 온몸에 흘려 넣은 듯한 고통과 함께 모든 세포가 위기를 호소해왔다｡"
  },
  {
   "id": 48756,
   "key": "D1519le.txt:66",
   "file": "D1519le.txt",
   "line": 66,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさ――！」",
   "ko_candidate": "「라이카 씨-!」"
  },
  {
   "id": 48757,
   "key": "D1519le.txt:71",
   "file": "D1519le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界が、罅割れた。",
   "ko_candidate": "세계가 금이 갔다｡"
  },
  {
   "id": 48758,
   "key": "D1519le.txt:72",
   "file": "D1519le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地が砕け、空が砕け、亀裂より闇が溢れ出した。",
   "ko_candidate": "대지가 부서지고､ 하늘이 부서지고､ 균열에서 어둠이 넘쳐흘렀다｡"
  },
  {
   "id": 48759,
   "key": "D1519le.txt:73",
   "file": "D1519le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "のたうつ、波打つ、這い寄る闇に、世界の総てが呑まれていく。",
   "ko_candidate": "뒤틀리고､ 물결치고､ 기어오는 어둠에 세계의 모든 것이 삼켜져 간다｡"
  },
  {
   "id": 48760,
   "key": "D1519le.txt:75",
   "file": "D1519le.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "埋没してゆく。",
   "ko_candidate": "매몰되어 간다｡"
  },
  {
   "id": 48761,
   "key": "D1519le.txt:76",
   "file": "D1519le.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水没してゆく。",
   "ko_candidate": "수몰되어 간다｡"
  },
  {
   "id": 48762,
   "key": "D1519le.txt:85",
   "file": "D1519le.txt",
   "line": 85,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃああああ!?」",
   "ko_candidate": "「꺄아아아아!」 「치익!」"
  },
  {
   "id": 48763,
   "key": "D1519le.txt:89",
   "file": "D1519le.txt",
   "line": 89,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちぃぃぃっ！」 ライカさんを庇うようにして、腕の中に抱く。",
   "ko_candidate": "라이카 씨를 감싸듯 팔 안에 안는다｡"
  },
  {
   "id": 48764,
   "key": "D1519le.txt:93",
   "file": "D1519le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが足元も急速に闇に侵食され、大地は安定を失う。",
   "ko_candidate": "하지만 발밑도 급속히 어둠에 침식되어 대지는 안정을 잃는다｡"
  },
  {
   "id": 48765,
   "key": "D1519le.txt:97",
   "file": "D1519le.txt",
   "line": 97,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何なんだ……何なんだよ、チクショウ！」",
   "ko_candidate": "「뭐야… 뭐란 말이야､ 젠장!」"
  },
  {
   "id": 48766,
   "key": "D1519le.txt:106",
   "file": "D1519le.txt",
   "line": 106,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎君……君は遂に 『輝くトラペゾヘドロン』に辿り着いた。ならば次の君は、真に神を殺す刃となる――」",
   "ko_candidate": "「쿠로 군… 너는 마침내 『빛나는 트라페조헤드론』에 도달했어｡ 그렇다면 다음의 너는 진정으로 신을 죽이는 칼날이 될 거야-」"
  },
  {
   "id": 48767,
   "key": "D1519le.txt:111",
   "file": "D1519le.txt",
   "line": 111,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「っっっ!?」",
   "ko_candidate": "「윽!」"
  },
  {
   "id": 48768,
   "key": "D1519le.txt:115",
   "file": "D1519le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脈動する闇の一部が渦巻き、容を変える。",
   "ko_candidate": "맥동하는 어둠의 일부가 소용돌이치며 모습을 바꾼다｡"
  },
  {
   "id": 48769,
   "key": "D1519le.txt:123",
   "file": "D1519le.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "三本脚の怪物が咆吼した。",
   "ko_candidate": "세 다리 괴물이 포효했다｡"
  },
  {
   "id": 48770,
   "key": "D1519le.txt:131",
   "file": "D1519le.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い翼が羽ばたき、三つの眸が焔えた。",
   "ko_candidate": "검은 날개가 펄럭이고､ 세 개의 눈동자가 불타올랐다｡"
  },
  {
   "id": 48771,
   "key": "D1519le.txt:139",
   "file": "D1519le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "長身痩躯の黒人が嗤った。",
   "ko_candidate": "키 크고 마른 흑인이 웃었다｡"
  },
  {
   "id": 48772,
   "key": "D1519le.txt:147",
   "file": "D1519le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い扇を持った、化物じみた肥満の女が艶然と微笑んだ。",
   "ko_candidate": "검은 부채를 든､ 괴물 같은 뚱뚱한 여자가 요염하게 미소 지었다｡"
  },
  {
   "id": 48773,
   "key": "D1519le.txt:155",
   "file": "D1519le.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして闇は、妙齢の、一人の美女を模った。",
   "ko_candidate": "그리고 어둠은 한 명의 아름다운 젊은 여성을 본떴다｡"
  },
  {
   "id": 48774,
   "key": "D1519le.txt:166",
   "file": "D1519le.txt",
   "line": 166,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ナイア……！」",
   "ko_candidate": "「나이아…!」"
  }
 ]
}