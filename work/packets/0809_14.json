{
 "packet": "0809_14",
 "scene": "0809",
 "anchor": {
  "hit": 92,
  "total": 121,
  "rate": 0.76
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "九郎": "쿠로",
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 14902,
   "key": "D0809al.txt:2461",
   "file": "D0809al.txt",
   "line": 2461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深々と溜め息をつく。",
   "ko_candidate": "깊은 한숨을 내쉰다｡"
  },
  {
   "id": 14903,
   "key": "D0809al.txt:2462",
   "file": "D0809al.txt",
   "line": 2462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、アルもまた覚悟を決めたようだ。",
   "ko_candidate": "하지만 알 역시 각오를 다진 듯하다｡"
  },
  {
   "id": 14904,
   "key": "D0809al.txt:2463",
   "file": "D0809al.txt",
   "line": 2463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵を真っ直ぐに見据えて、叫んだ。",
   "ko_candidate": "적을 똑바로 바라보며 외쳤다｡"
  },
  {
   "id": 14905,
   "key": "D0809al.txt:2468",
   "file": "D0809al.txt",
   "line": 2468,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ならば連中を纏めて 地獄に叩き堕としてやろうぞ！ ――征くぞ！」",
   "ko_candidate": "「그렇다면 저놈들을 모조리 지옥으로 때려 떨어뜨려주자! ――간다!」"
  },
  {
   "id": 14906,
   "key": "D0809al.txt:2475",
   "file": "D0809al.txt",
   "line": 2475,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「応よッッッ！」",
   "ko_candidate": "「응!」"
  },
  {
   "id": 14907,
   "key": "D0809le.txt:10",
   "file": "D0809le.txt",
   "line": 10,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！　おい九郎！ 大丈夫か!?　生きてるか!?」",
   "ko_candidate": "「쿠로! 이봐 쿠로! 괜찮아!? 살아있어!?」"
  },
  {
   "id": 14908,
   "key": "D0809le.txt:15",
   "file": "D0809le.txt",
   "line": 15,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐっ……があ……っ！　な、何とか……なっ！」",
   "ko_candidate": "「으윽… 가아…! 어､ 어떻게든… 살았어!」"
  },
  {
   "id": 14909,
   "key": "D0809le.txt:17",
   "file": "D0809le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸は脇腹を貫通していた。",
   "ko_candidate": "총알은 옆구리를 관통했다｡"
  },
  {
   "id": 14910,
   "key": "D0809le.txt:18",
   "file": "D0809le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あれだけの防禦を突破するなんて、 どんな銃だ、アレは！",
   "ko_candidate": "저런 방어를 뚫다니､ 대체 어떤 총이야､ 저건!"
  },
  {
   "id": 14911,
   "key": "D0809le.txt:24",
   "file": "D0809le.txt",
   "line": 24,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「この程度……待ってろ。 今、治す」",
   "ko_candidate": "「이 정도… 기다려｡ 지금､ 치료할게」"
  },
  {
   "id": 14912,
   "key": "D0809le.txt:33",
   "file": "D0809le.txt",
   "line": 33,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐうぅ……！　って、えっ？」",
   "ko_candidate": "「으으…! 어､ 엥?」"
  },
  {
   "id": 14913,
   "key": "D0809le.txt:35",
   "file": "D0809le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルが呪文を唱えると、銃創の辺りが熱く火照りだした。ゆっくりと痛みが退いていく。",
   "ko_candidate": "알이 주문을 외우자､ 총상 주변이 뜨겁게 달아올랐다｡ 천천히 통증이 사라져간다｡"
  },
  {
   "id": 14914,
   "key": "D0809le.txt:38",
   "file": "D0809le.txt",
   "line": 38,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「痛み止めか」",
   "ko_candidate": "「진통제인가」"
  },
  {
   "id": 14915,
   "key": "D0809le.txt:42",
   "file": "D0809le.txt",
   "line": 42,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝の新陳代謝能力に干渉し、治癒力を急激に高めた。これで多少はマシになったが……無茶は出来んぞ。気をつけろ」",
   "ko_candidate": "「너의 신진대사 능력에 간섭해서､ 치유력을 급격히 높였어｡ 이걸로 어느 정도 나아졌지만… 무리는 하지 마｡ 조심해」"
  },
  {
   "id": 14916,
   "key": "D0809le.txt:45",
   "file": "D0809le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傷に触れる。",
   "ko_candidate": "상처를 만져본다｡"
  },
  {
   "id": 14917,
   "key": "D0809le.txt:46",
   "file": "D0809le.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かに、少しずつだが銃創が塞がっているらしい。",
   "ko_candidate": "확실히､ 조금씩이지만 총상이 아물고 있는 것 같다｡"
  },
  {
   "id": 14918,
   "key": "D0809le.txt:47",
   "file": "D0809le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これなら……っ！",
   "ko_candidate": "이 정도면…!"
  },
  {
   "id": 14919,
   "key": "D0809le.txt:50",
   "file": "D0809le.txt",
   "line": 50,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えいっ！　ッ!?　がっ、はっ！　ぐっ！ 痛い痛い痛い――っ!?」",
   "ko_candidate": "「에잇! 윽!? 악､ 핫! 으윽! 아파 아파 아파――!?」"
  },
  {
   "id": 14920,
   "key": "D0809le.txt:53",
   "file": "D0809le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起き上がろうとして、腹に激痛が走った。",
   "ko_candidate": "일어나려다 배에 격통이 일었다｡"
  },
  {
   "id": 14921,
   "key": "D0809le.txt:54",
   "file": "D0809le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "耐え切れず、また崩れ落ちて倒れる。",
   "ko_candidate": "견딜 수 없어 다시 무너져 쓰러진다｡"
  },
  {
   "id": 14922,
   "key": "D0809le.txt:58",
   "file": "D0809le.txt",
   "line": 58,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いきなり動くのは無理だ。これほどの深手、そう簡単には治らん」",
   "ko_candidate": "「갑자기 움직이는 건 무리야｡ 이 정도의 중상､ 그리 쉽게 낫지 않아」"
  },
  {
   "id": 14923,
   "key": "D0809le.txt:62",
   "file": "D0809le.txt",
   "line": 62,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「んなこと言ったって……！　向こうが待ってくれるかよ……！」",
   "ko_candidate": "「그런 소리 해도…! 저쪽이 기다려 줄 리가 없잖아…!」"
  },
  {
   "id": 14924,
   "key": "D0809le.txt:67",
   "file": "D0809le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まさしく狙い澄ましたタイミングで、脱獄囚が俺の前に立つ。",
   "ko_candidate": "정말이지 노린 듯한 타이밍에､ 탈옥수가 내 앞에 선다｡"
  },
  {
   "id": 14925,
   "key": "D0809le.txt:69",
   "file": "D0809le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷たい瞳で見下ろし、銃口を俺の頭に向ける。",
   "ko_candidate": "차가운 눈으로 내려다보며､ 총구를 내 머리에 겨눈다｡"
  },
  {
   "id": 14926,
   "key": "D0809le.txt:71",
   "file": "D0809le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "馬鹿野郎っ！　ここで死ねるかっ！",
   "ko_candidate": "바보 자식! 여기서 죽을 순 없어!"
  },
  {
   "id": 14927,
   "key": "D0809le.txt:75",
   "file": "D0809le.txt",
   "line": 75,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「本気じゃないね、大十字九郎」",
   "ko_candidate": "「진심이 아니군､ 다이쥬지 쿠로」"
  },
  {
   "id": 14928,
   "key": "D0809le.txt:79",
   "file": "D0809le.txt",
   "line": 79,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、に……？」",
   "ko_candidate": "「뭐､ 라고…?」"
  },
  {
   "id": 14929,
   "key": "D0809le.txt:81",
   "file": "D0809le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな声が聴こえてきた。",
   "ko_candidate": "그런 목소리가 들려왔다｡"
  },
  {
   "id": 14930,
   "key": "D0809le.txt:83",
   "file": "D0809le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脱獄囚の声か？",
   "ko_candidate": "탈옥수의 목소리인가?"
  },
  {
   "id": 14931,
   "key": "D0809le.txt:84",
   "file": "D0809le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、違う。こいつは猿轡を嵌められている。",
   "ko_candidate": "아니､ 다르다｡ 이자는 재갈이 물려 있다｡"
  },
  {
   "id": 14932,
   "key": "D0809le.txt:86",
   "file": "D0809le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そもそも声は別の方向……真上からだ。",
   "ko_candidate": "애초에 목소리는 다른 방향… 바로 위에서다｡"
  },
  {
   "id": 14933,
   "key": "D0809le.txt:89",
   "file": "D0809le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声の主が俺の元に降りてくる。",
   "ko_candidate": "목소리의 주인이 내게로 내려온다｡"
  },
  {
   "id": 14934,
   "key": "D0809le.txt:95",
   "file": "D0809le.txt",
   "line": 95,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……カラス？」",
   "ko_candidate": "「…까마귀?」"
  },
  {
   "id": 14935,
   "key": "D0809le.txt:98",
   "file": "D0809le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "カアァァ！",
   "ko_candidate": "까악!"
  },
  {
   "id": 14936,
   "key": "D0809le.txt:101",
   "file": "D0809le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一鳴きして翔び去っていく。",
   "ko_candidate": "한 번 울고는 날아가 버린다｡"
  },
  {
   "id": 14937,
   "key": "D0809le.txt:105",
   "file": "D0809le.txt",
   "line": 105,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「街中だと、 全力は出せないのかな？」",
   "ko_candidate": "「시내에서는 전력을 다할 수 없나 보지?」"
  },
  {
   "id": 14938,
   "key": "D0809le.txt:109",
   "file": "D0809le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "右側からの声に振り向く。",
   "ko_candidate": "오른쪽에서 들려온 목소리에 고개를 돌린다｡"
  },
  {
   "id": 14939,
   "key": "D0809le.txt:116",
   "file": "D0809le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げ遅れた野次馬の１人か、買い物袋を提げた主婦が喋っていた。",
   "ko_candidate": "도망치지 못한 구경꾼 중 한 명인가､ 쇼핑백을 든 주부가 말하고 있었다｡"
  },
  {
   "id": 14940,
   "key": "D0809le.txt:121",
   "file": "D0809le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "糸が切れたように、その場に崩れる。",
   "ko_candidate": "실이 끊어진 듯､ 그 자리에 무너진다｡"
  },
  {
   "id": 14941,
   "key": "D0809le.txt:125",
   "file": "D0809le.txt",
   "line": 125,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『だったら、 こういうのはどうかな？』",
   "ko_candidate": "『그렇다면､ 이런 건 어떨까?』"
  }
 ]
}