 "items": [
  {
   "id": 21748,
   "key": "D1006le.txt:242",
   "file": "D1006le.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拍子抜けするほど軽い音を立てて――仮面が真っ二つに割れた。",
   "ko_candidate": "맥 빠질 정도로 가벼운 소리를 내며――가면이 두 동강 났다｡"
  },
  {
   "id": 21749,
   "key": "D1006le.txt:243",
   "file": "D1006le.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "床に転がり落ちる。",
   "ko_candidate": "바닥에 굴러떨어진다｡"
  },
  {
   "id": 21750,
   "key": "D1006le.txt:248",
   "file": "D1006le.txt",
   "line": 248,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  },
  {
   "id": 21751,
   "key": "D1006le.txt:250",
   "file": "D1006le.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初、その貌が誰だか分からなかった。",
   "ko_candidate": "처음에는 그 얼굴이 누구인지 알 수 없었다｡"
  },
  {
   "id": 21752,
   "key": "D1006le.txt:251",
   "file": "D1006le.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、初めて貌を見るのだから、知らなくて当然なのだが――だけど。そうじゃなくて。",
   "ko_candidate": "아니､ 처음 얼굴을 보는 거니까 모르는 게 당연하지만――하지만｡ 그게 아니라｡"
  },
  {
   "id": 21753,
   "key": "D1006le.txt:253",
   "file": "D1006le.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、でも、髪の色が違うし。",
   "ko_candidate": "아니､ 그래도 머리색이 다르잖아｡"
  },
  {
   "id": 21754,
   "key": "D1006le.txt:254",
   "file": "D1006le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ほら、それに長さも。",
   "ko_candidate": "자､ 그리고 길이도｡"
  },
  {
   "id": 21755,
   "key": "D1006le.txt:255",
   "file": "D1006le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "でもでも、だから……えーと……何で？",
   "ko_candidate": "그래도 그래도､ 그러니까… 음… 왜?"
  },
  {
   "id": 21756,
   "key": "D1006le.txt:257",
   "file": "D1006le.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――面影。",
   "ko_candidate": "――얼굴｡"
  },
  {
   "id": 21757,
   "key": "D1006le.txt:261",
   "file": "D1006le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その面影に気付いてしまった。",
   "ko_candidate": "그 얼굴을 알아차리고 말았다｡"
  },
  {
   "id": 21758,
   "key": "D1006le.txt:262",
   "file": "D1006le.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "髪の色も長さも、それから雰囲気も全然違うが……でも間違いない。",
   "ko_candidate": "머리카락 색깔도 길이도､ 그리고 분위기도 전혀 다르지만… 하지만 틀림없다｡"
  },
  {
   "id": 21759,
   "key": "D1006le.txt:266",
   "file": "D1006le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この優しく柔らかな面影を、俺が見間違えるはずはない。",
   "ko_candidate": "이 상냥하고 부드러운 면모를､ 내가 잘못 볼 리가 없다｡"
  },
  {
   "id": 21760,
   "key": "D1006le.txt:270",
   "file": "D1006le.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その認識に辿り着いても、俺はまだその事実が受け入れられないでいた。",
   "ko_candidate": "그 인식에 도달해도､ 나는 아직 그 사실을 받아들일 수 없었다｡"
  },
  {
   "id": 21761,
   "key": "D1006le.txt:272",
   "file": "D1006le.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何だか全部、夢みたいに現実味がなくて、だから思わず零した声も、まるっきり間が抜けていた。",
   "ko_candidate": "뭔가 전부 꿈처럼 현실감이 없어서､ 그래서 무심코 흘린 목소리도 완전히 멍한 상태였다｡"
  },
  {
   "id": 21762,
   "key": "D1006le.txt:274",
   "file": "D1006le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、彼女の名前を、呆然と呟いた。",
   "ko_candidate": "나는 그녀의 이름을､ 멍하니 중얼거렸다｡"
  },
  {
   "id": 21763,
   "key": "D1006le.txt:282",
   "file": "D1006le.txt",
   "line": 282,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカ……さん？」",
   "ko_candidate": "「라이카… 씨?」"
  },
  {
   "id": 21764,
   "key": "D1006ru.txt:9",
   "file": "D1006ru.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重い静寂が、枷となって絶望に縛りつける。",
   "ko_candidate": "【File10:BIG\"C\"】closed<PRE>."
  },
  {
   "id": 21765,
   "key": "D1006ru.txt:11",
   "file": "D1006ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無表情のまま微動だにしないマコトも",
   "ko_candidate": "무거운 정적이 족쇄가 되어 절망에 묶어놓는다｡"
  },
  {
   "id": 21766,
   "key": "D1006ru.txt:12",
   "file": "D1006ru.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣きじゃくるソーニャも",
   "ko_candidate": "무표정인 채 미동도 않는 마코토도"
  },
  {
   "id": 21767,
   "key": "D1006ru.txt:13",
   "file": "D1006ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィンフィールドの横で当惑するチアキも",
   "ko_candidate": "흐느끼는 소냐도 윈필드 옆에서 당황하는 치아키도"
  },
  {
   "id": 21768,
   "key": "D1006ru.txt:14",
   "file": "D1006ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らに対する怒りに震えるウィンフィールドも",
   "ko_candidate": "자신에 대한 분노로 떨고 있는 윈필드도"
  },
  {
   "id": 21769,
   "key": "D1006ru.txt:16",
   "file": "D1006ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰一人として、この静寂を撃ち破る力を持ち合わせてはいなかった。",
   "ko_candidate": "누구 하나 이 정적을 깨뜨릴 힘을 가지고 있지 않았다｡"
  },
  {
   "id": 21770,
   "key": "D1006ru.txt:18",
   "file": "D1006ru.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "唯一の希望だったデモンベインは敗れた。",
   "ko_candidate": "유일한 희망이었던 데몬베인은 패배했다｡"
  },
  {
   "id": 21771,
   "key": "D1006ru.txt:19",
   "file": "D1006ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして一同の主人たる覇道瑠璃もまた――",
   "ko_candidate": "그리고 일동의 주인인 하도 루리 또한――"
  },
  {
   "id": 21772,
   "key": "D1006ru.txt:21",
   "file": "D1006ru.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人類に最早、打つ手はない。",
   "ko_candidate": "인류에게 더 이상 손을 쓸 방법이 없다｡"
  },
  {
   "id": 21773,
   "key": "D1006ru.txt:22",
   "file": "D1006ru.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緩やかな絶望の毒が、一同を侵す――",
   "ko_candidate": "완만한 절망의 독이 일동을 침식한다――"
  },
  {
   "id": 21774,
   "key": "D1006ru.txt:24",
   "file": "D1006ru.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否。",
   "ko_candidate": "아니｡"
  },
  {
   "id": 21775,
   "key": "D1006ru.txt:29",
   "file": "D1006ru.txt",
   "line": 29,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………!?　待って下さい。 格納庫内に、微弱な空間歪曲が発生してます」",
   "ko_candidate": "「…………!? 잠깐만요｡ 격납고 내에 미약한 공간 왜곡이 발생하고 있어요」"
  },
  {
   "id": 21776,
   "key": "D1006ru.txt:41",
   "file": "D1006ru.txt",
   "line": 41,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「へっ……？ それはいったい……」",
   "ko_candidate": "「헷……? 그게 도대체……」"
  },
  {
   "id": 21777,
   "key": "D1006ru.txt:46",
   "file": "D1006ru.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全員が重い顔を上げるよりも速く、反応は爆発的に増大した。",
   "ko_candidate": "모두가 무거운 얼굴을 들기도 전에 반응은 폭발적으로 증대했다｡"
  },
  {
   "id": 21778,
   "key": "D1006ru.txt:48",
   "file": "D1006ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "各種モニターに表示された数値が、大きく揺れ動く。",
   "ko_candidate": "각종 모니터에 표시된 수치가 크게 흔들린다｡"
  },
  {
   "id": 21779,
   "key": "D1006ru.txt:51",
   "file": "D1006ru.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鳴り響くアラーム。",
   "ko_candidate": "울려 퍼지는 알람｡"
  },
  {
   "id": 21780,
   "key": "D1006ru.txt:57",
   "file": "D1006ru.txt",
   "line": 57,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「状況を！」",
   "ko_candidate": "「상황을!」"
  },
  {
   "id": 21781,
   "key": "D1006ru.txt:63",
   "file": "D1006ru.txt",
   "line": 63,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「は、はいぃっ！ え、えっと…… こ、これは……ッッ!?」 「空間転移です！　何かが格納庫内に顕現しようとしてますです！」",
   "ko_candidate": "「네､ 네엣! 어､ 어떻게……이､ 이건……!! 공간 전이예요! 뭔가가 격납고 내에 현현하려고 하고 있어요! 추정……전장 50미터의 물체!? 이거､ 설마!?」"
  },
  {
   "id": 21782,
   "key": "D1006ru.txt:71",
   "file": "D1006ru.txt",
   "line": 71,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「推定……全長５０メートルの物体!?　これって、まさか!?」 ソーニャの想像を肯定するかのように、別のステータスが反応を示した。",
   "ko_candidate": "소냐의 상상을 긍정하듯이 다른 스테이터스가 반응을 보였다｡"
  },
  {
   "id": 21783,
   "key": "D1006ru.txt:79",
   "file": "D1006ru.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは即ち――",
   "ko_candidate": "그것은 즉――"
  },
  {
   "id": 21784,
   "key": "D1006ru.txt:84",
   "file": "D1006ru.txt",
   "line": 84,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?　デモンベインの反応が！」",
   "ko_candidate": "「――――!? 데몬베인의 반응이!」"
  },
  {
   "id": 21785,
   "key": "D1006ru.txt:89",
   "file": "D1006ru.txt",
   "line": 89,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それは、つまり……！」",
   "ko_candidate": "「그건､ 즉……!」"
  },
  {
   "id": 21786,
   "key": "D1006ru.txt:95",
   "file": "D1006ru.txt",
   "line": 95,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――格納庫内の巨大物質反応が、 実空間に事象固定。衝撃波来ます」",
   "ko_candidate": "「――격납고 내의 거대 물질 반응이 실제 공간에 사상 고정｡ 충격파 옵니다」"
  },
  {
   "id": 21787,
   "key": "D1006ru.txt:103",
