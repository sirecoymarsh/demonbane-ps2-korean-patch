 },
 "items": [
  {
   "id": 43087,
   "key": "D1505le.txt:921",
   "file": "D1505le.txt",
   "line": 921,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから、いつもと同じに粉砕できた。",
   "ko_candidate": "그래서 언제나처럼 분쇄할 수 있었다｡"
  },
  {
   "id": 43088,
   "key": "D1505le.txt:933",
   "file": "D1505le.txt",
   "line": 933,
   "speaker": "研究員Ｃ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ああ……試験体……全滅です……っ！」",
   "ko_candidate": "「아……아아…… 시험체…… 전멸입니다 ……읏!」"
  },
  {
   "id": 43089,
   "key": "D1505le.txt:937",
   "file": "D1505le.txt",
   "line": 937,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、それ程までとは……」",
   "ko_candidate": "「이､ 이 정도일 줄이야……」"
  },
  {
   "id": 43090,
   "key": "D1505le.txt:941",
   "file": "D1505le.txt",
   "line": 941,
   "speaker": "研究員Ｄ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「儀式どころではない！　わ、我々も退避を……っ！」",
   "ko_candidate": "「의식은 고사하고! 우､ 우리도 대피를 ……읏!」"
  },
  {
   "id": 43091,
   "key": "D1505le.txt:945",
   "file": "D1505le.txt",
   "line": 945,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、そうだ！　４号を囮に使えば……術式を改竄して、外部から操作出来るか!?」",
   "ko_candidate": "「그､ 그래! 4호를 미끼로 쓰면……술식을 조작해서 외부에서 조종할 수 있을까!?」"
  },
  {
   "id": 43092,
   "key": "D1505le.txt:949",
   "file": "D1505le.txt",
   "line": 949,
   "speaker": "研究員Ｄ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「や、やってみます……！」",
   "ko_candidate": "「해､ 해보겠습니다……!」"
  },
  {
   "id": 43093,
   "key": "D1505le.txt:953",
   "file": "D1505le.txt",
   "line": 953,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待て！　それだとＣとの接触に支障が出るやも……」",
   "ko_candidate": "「기다려! 그러면 C와의 접촉에 지장이 생길 지도……」"
  },
  {
   "id": 43094,
   "key": "D1505le.txt:957",
   "file": "D1505le.txt",
   "line": 957,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんな事を気にしている場合か！」",
   "ko_candidate": "「그런 걸 신경 쓸 때냐!」"
  },
  {
   "id": 43095,
   "key": "D1505le.txt:961",
   "file": "D1505le.txt",
   "line": 961,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だが、他の試験体ももう居ないのだぞ！　ここは４号も連れて……う、うわあああ！」",
   "ko_candidate": "「하지만 다른 실험체도 이제 없잖아! 여기서 4호도 데리고……우､ 우와아아아!」 「누나……」"
  },
  {
   "id": 43096,
   "key": "D1505le.txt:965",
   "file": "D1505le.txt",
   "line": 965,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ねえ……さん……」",
   "ko_candidate": "「왔､ 왔다아아아아아――――읏!」"
  },
  {
   "id": 43097,
   "key": "D1505le.txt:969",
   "file": "D1505le.txt",
   "line": 969,
   "speaker": "研究員Ｄ / 研究員Ａ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「き、来たぁぁぁぁぁ――――っ！」 「早く４号を……！ ぐるぶあらばっ！」",
   "ko_candidate": "「빨리 4호를……!{SE_PLAY(1,\"警뉜디頭砕\",0,100,false);}그루브아라밧!」"
  },
  {
   "id": 43098,
   "key": "D1505le.txt:980",
   "file": "D1505le.txt",
   "line": 980,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "明滅するアラームの赤に照らされ、ぬめり輝く赤が、 飛沫く。",
   "ko_candidate": "명멸하는 알람의 붉은빛에 비춰져 번들거리는 붉은 것이 튀어 오른다｡"
  },
  {
   "id": 43099,
   "key": "D1505le.txt:983",
   "file": "D1505le.txt",
   "line": 983,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雨となって部屋を濡らす。",
   "ko_candidate": "비가 되어 방을 적신다｡"
  },
  {
   "id": 43100,
   "key": "D1505le.txt:984",
   "file": "D1505le.txt",
   "line": 984,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "私のからだを、ぬらす。 破壊された壁の向こう。",
   "ko_candidate": "내 몸을 적신다｡"
  },
  {
   "id": 43101,
   "key": "D1505le.txt:987",
   "file": "D1505le.txt",
   "line": 987,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "佇む影が見える。",
   "ko_candidate": "파괴된 벽 너머｡"
  },
  {
   "id": 43102,
   "key": "D1505le.txt:988",
   "file": "D1505le.txt",
   "line": 988,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鈍い光沢を放つ、影が居る。",
   "ko_candidate": "우두커니 선 그림자가 보인다｡"
  },
  {
   "id": 43103,
   "key": "D1505le.txt:990",
   "file": "D1505le.txt",
   "line": 990,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しろの世界を壊しにやってきた、くろい影。",
   "ko_candidate": "둔탁한 광택을 내뿜는 그림자가 있다｡"
  },
  {
   "id": 43104,
   "key": "D1505le.txt:991",
   "file": "D1505le.txt",
   "line": 991,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しろの世界をあかで塗り潰す、くろい影。",
   "ko_candidate": "하얀 세상을 부수러 온 검은 그림자｡"
  },
  {
   "id": 43105,
   "key": "D1505le.txt:992",
   "file": "D1505le.txt",
   "line": 992,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "わたしを助けにやってきた。 わたしとおなじ姿。",
   "ko_candidate": "하얀 세상을 붉게 칠해버리는 검은 그림자｡"
  },
  {
   "id": 43106,
   "key": "D1505le.txt:995",
   "file": "D1505le.txt",
   "line": 995,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "わたしとおなじ血を流す君は――。",
   "ko_candidate": "나를 구하러 온 그림자｡ 나와 같은 모습｡"
  },
  {
   "id": 43107,
   "key": "D1505le.txt:999",
   "file": "D1505le.txt",
   "line": 999,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ラ……イカ…… 姉さ……ん……っ！」 君は――",
   "ko_candidate": "나와 같은 피를 흘리는 너는――｡"
  },
  {
   "id": 43108,
   "key": "D1505le.txt:1007",
   "file": "D1505le.txt",
   "line": 1007,
   "speaker": "研究員Ｄ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「立て、４号！　５号を処分しろ…… うぐああ……！」",
   "ko_candidate": "「라……이카……누나……읏!」"
  },
  {
   "id": 43109,
   "key": "D1505le.txt:1014",
   "file": "D1505le.txt",
   "line": 1014,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "君は――",
   "ko_candidate": "너는――"
  },
  {
   "id": 43110,
   "key": "D1505le.txt:1018",
   "file": "D1505le.txt",
   "line": 1018,
   "speaker": "リューガ / 研究員Ｄ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカ――――――ッ！」 「うぐらばっぱぁぁぁあぎゃああああ！」",
   "ko_candidate": "「일어나､ 4호! 5호를 처분해…… 너는―― 「라이카――――――읏!」 「우그라밧파아아아아기야아아아아!」 너는｡ 「내가 반드시……그 푸른……읏!」"
  },
  {
   "id": 43111,
   "key": "D1505le.txt:1027",
   "file": "D1505le.txt",
   "line": 1027,
   "speaker": "サンダルフォン",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "君は。 「ぼくが必ず……あの青い……ッ！」",
   "ko_candidate": "――너는､ 누구였더라?"
  },
  {
   "id": 43112,
   "key": "D1505le.txt:1037",
   "file": "D1505le.txt",
   "line": 1037,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――君は、誰だっけ？ 忘却が私の精神を侵し、占領した。",
   "ko_candidate": "망각이 내 정신을 침식하고 점령했다｡"
  },
  {
   "id": 43113,
   "key": "D1505le.txt:1042",
   "file": "D1505le.txt",
   "line": 1042,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私の躰を私以外の何かが動かす。",
   "ko_candidate": "내 몸을 나 아닌 무언가가 움직인다｡"
  },
  {
   "id": 43114,
   "key": "D1505le.txt:1043",
   "file": "D1505le.txt",
   "line": 1043,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が、私を包み込んだ。",
   "ko_candidate": "빛이 나를 감싸안았다｡"
  },
  {
   "id": 43115,
   "key": "D1505le.txt:1047",
   "file": "D1505le.txt",
   "line": 1047,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「変・神」",
   "ko_candidate": "「변?신」"
  },
  {
   "id": 43116,
   "key": "D1505le.txt:1064",
   "file": "D1505le.txt",
   "line": 1064,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神々しいまでの閃に、目を奪われた。",
   "ko_candidate": "신성할 정도의 섬광에 눈을 빼앗겼다｡"
  },
  {
   "id": 43117,
   "key": "D1505le.txt:1065",
   "file": "D1505le.txt",
   "line": 1065,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烈しい閃が、優しい閃が、ライカを包み込む。",
   "ko_candidate": "격렬한 섬광이､ 부드러운 섬광이 라이카를 감싸안는다｡"
  },
  {
   "id": 43118,
   "key": "D1505le.txt:1066",
   "file": "D1505le.txt",
   "line": 1066,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカを、変えていく。",
   "ko_candidate": "라이카를 변화시킨다｡"
  },
  {
   "id": 43119,
   "key": "D1505le.txt:1068",
   "file": "D1505le.txt",
   "line": 1068,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――『ソレ』はゆっくりと起き上がった。",
   "ko_candidate": "그리고――『그것』은 천천히 일어섰다｡"
  },
  {
   "id": 43120,
   "key": "D1505le.txt:1075",
   "file": "D1505le.txt",
   "line": 1075,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……誰？」",
   "ko_candidate": "「……누구?」"
  },
  {
   "id": 43121,
   "key": "D1505le.txt:1080",
   "file": "D1505le.txt",
   "line": 1080,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い装甲に鎧われたソレ。",
   "ko_candidate": "하얀 장갑으로 무장한 그것｡"
  },
  {
   "id": 43122,
   "key": "D1505le.txt:1081",
   "file": "D1505le.txt",
   "line": 1081,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の翼を広げる、ソレは白の天使。",
   "ko_candidate": "빛의 날개를 펼치는 그것은 하얀 천사｡"
  },
  {
   "id": 43123,
   "key": "D1505le.txt:1083",
   "file": "D1505le.txt",
   "line": 1083,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その白は、紅く染められた世界の中で、何よりも輝く。",
   "ko_candidate": "그 하얀색은 붉게 물든 세상 속에서 그 무엇보다 빛난다｡"
  },
  {
   "id": 43124,
   "key": "D1505le.txt:1084",
   "file": "D1505le.txt",
   "line": 1084,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何ものにも染められない、穢れなき白。",
   "ko_candidate": "그 무엇에도 물들지 않는 순수한 하얀색｡"
  },
  {
   "id": 43125,
   "key": "D1505le.txt:1088",
   "file": "D1505le.txt",
   "line": 1088,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……誰だ？」",
   "ko_candidate": "「……누구지?」"
  },
  {
   "id": 43126,
   "key": "D1505le.txt:1091",
   "file": "D1505le.txt",
   "line": 1091,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "知らない。",
   "ko_candidate": "모른다｡"
  }
 ]
}