 "items": [
  {
   "id": 16806,
   "key": "D0816le.txt:11",
   "file": "D0816le.txt",
   "line": 11,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぅぅぅぅっ！」",
   "ko_candidate": "「그으으으윽!」"
  },
  {
   "id": 16807,
   "key": "D0816le.txt:13",
   "file": "D0816le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "かわし切れないエネルギー弾が、装甲上で弾ける。",
   "ko_candidate": "피할 수 없는 에너지탄이 장갑 위에서 터진다｡"
  },
  {
   "id": 16808,
   "key": "D0816le.txt:14",
   "file": "D0816le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "円形に抉れ、焼け焦げた傷痕がいくつも穿たれる。",
   "ko_candidate": "원형으로 파이고 타버린 상처가 여러 개 뚫린다｡"
  },
  {
   "id": 16809,
   "key": "D0816le.txt:15",
   "file": "D0816le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "コクピットに響く爆音。",
   "ko_candidate": "콕핏에 폭음이 울린다｡"
  },
  {
   "id": 16810,
   "key": "D0816le.txt:24",
   "file": "D0816le.txt",
   "line": 24,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ！　『水神クタアト』が来るぞ！」 迫る鋼鉄の大蛇。伸縮する、クラーケンの腕。",
   "ko_candidate": "「큿! 『<RUBY text=\"Cth?at Aquadingen\">수신 크타아트</RUBY>』가 온다!」"
  },
  {
   "id": 16811,
   "key": "D0816le.txt:36",
   "file": "D0816le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "うねり波打って大地を抉りながら、デモンベインを捕らえようとする。",
   "ko_candidate": "다가오는 강철의 대사｡ 신축하는 크라켄의 팔｡ 꿈틀거리며 대지를 파헤치면서 데몬베인을 잡으려 한다｡"
  },
  {
   "id": 16812,
   "key": "D0816le.txt:40",
   "file": "D0816le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "脚部シールドを開放。跳躍。",
   "ko_candidate": "다리부 실드를 개방｡ 도약｡"
  },
  {
   "id": 16813,
   "key": "D0816le.txt:47",
   "file": "D0816le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鋼鉄の爪は目標を失い、大地を砕く。",
   "ko_candidate": "강철 발톱은 목표를 잃고 대지를 부순다｡"
  },
  {
   "id": 16814,
   "key": "D0816le.txt:48",
   "file": "D0816le.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しかしこれでかわし切れたワケではない。",
   "ko_candidate": "하지만 이걸로 완전히 피한 건 아니다｡"
  },
  {
   "id": 16815,
   "key": "D0816le.txt:62",
   "file": "D0816le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "着地地点を狙って、もう１本の腕が振り下ろされる。",
   "ko_candidate": "착지 지점을 노리고 또 다른 팔이 내리쳐진다｡"
  },
  {
   "id": 16816,
   "key": "D0816le.txt:65",
   "file": "D0816le.txt",
   "line": 65,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそっ！」",
   "ko_candidate": "「젠장!」"
  },
  {
   "id": 16817,
   "key": "D0816le.txt:73",
   "file": "D0816le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "間髪置かず、脚部シールドを再開放してこれをかわす。",
   "ko_candidate": "잠깐의 틈도 없이 다리부 실드를 재개방하여 이를 피한다｡"
  },
  {
   "id": 16818,
   "key": "D0816le.txt:74",
   "file": "D0816le.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "連発した負担に、デモンベインの脚が軋む。",
   "ko_candidate": "연속된 부담에 데몬베인의 다리가 삐걱거린다｡"
  },
  {
   "id": 16819,
   "key": "D0816le.txt:77",
   "file": "D0816le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "振り下ろされた腕は、デモンベインの胴をわずかにかすった。",
   "ko_candidate": "내리쳐진 팔이 데몬베인의 몸통을 살짝 스쳤다｡"
  },
  {
   "id": 16820,
   "key": "D0816le.txt:82",
   "file": "D0816le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ、それだけで。",
   "ko_candidate": "단지 그것만으로｡"
  },
  {
   "id": 16821,
   "key": "D0816le.txt:91",
   "file": "D0816le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "装甲はへこみ、カタチを歪め、ひび割れる。",
   "ko_candidate": "장갑이 찌그러지고 모양이 일그러지며 금이 간다｡"
  },
  {
   "id": 16822,
   "key": "D0816le.txt:93",
   "file": "D0816le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "腕を叩きつけられた大地が爆砕した。",
   "ko_candidate": "팔이 내리쳐진 대지가 폭발했다｡"
  },
  {
   "id": 16823,
   "key": "D0816le.txt:95",
   "file": "D0816le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "瓦礫や土砂と一緒に、デモンベインもまた宙を舞う。",
   "ko_candidate": "잔해와 토사와 함께 데몬베인도 공중으로 날아오른다｡"
  },
  {
   "id": 16824,
   "key": "D0816le.txt:101",
   "file": "D0816le.txt",
   "line": 101,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「なんちゅーパワーだ！」",
   "ko_candidate": "「어떻게 이런 파워가!」"
  },
  {
   "id": 16825,
   "key": "D0816le.txt:103",
   "file": "D0816le.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こんなの一発もらっただけでも、致命傷だ。",
   "ko_candidate": "이런 거 한 방만 맞아도 치명상이다｡"
  },
  {
   "id": 16826,
   "key": "D0816le.txt:104",
   "file": "D0816le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何とか脚部シールドによる超機動力で逃れてはいるが……。",
   "ko_candidate": "어떻게든 다리부 실드의 초기동력으로 벗어나고는 있지만…｡"
  },
  {
   "id": 16827,
   "key": "D0816le.txt:107",
   "file": "D0816le.txt",
   "line": 107,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――っ！」",
   "ko_candidate": "「――――읏!」"
  },
  {
   "id": 16828,
   "key": "D0816le.txt:109",
   "file": "D0816le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "迫り来る危機感。",
   "ko_candidate": "다가오는 위기감｡"
  },
  {
   "id": 16829,
   "key": "D0816le.txt:110",
   "file": "D0816le.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――来る！",
   "ko_candidate": "――온다!"
  },
  {
   "id": 16830,
   "key": "D0816le.txt:114",
   "file": "D0816le.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "危機感が指し示す方角をモニタに捉える。",
   "ko_candidate": "위기감이 가리키는 방향을 모니터에 포착한다｡"
  },
  {
   "id": 16831,
   "key": "D0816le.txt:116",
   "file": "D0816le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一瞬、ロードビヤーキーの影を見たような気がした。",
   "ko_candidate": "순간 로드 비야키의 그림자를 본 것 같은 기분이 들었다｡"
  },
  {
   "id": 16832,
   "key": "D0816le.txt:117",
   "file": "D0816le.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だがそれを認識するよりも早く、遥かに速く、一瞬刹那の時間にそれは来た。",
   "ko_candidate": "하지만 그걸 인식하기보다 더 빠르게､ 훨씬 빠르게､ 순간적인 시간에 그것이 왔다｡"
  },
  {
   "id": 16833,
   "key": "D0816le.txt:121",
   "file": "D0816le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインを強襲する衝撃。",
   "ko_candidate": "데몬베인을 강습하는 충격｡"
  },
  {
   "id": 16834,
   "key": "D0816le.txt:132",
   "file": "D0816le.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆発的な衝撃。",
   "ko_candidate": "폭발적인 충격｡"
  },
  {
   "id": 16835,
   "key": "D0816le.txt:134",
   "file": "D0816le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "意識が白く弾ける。破壊の波紋がコクピットを貫通し、蹂躙する。",
   "ko_candidate": "의식이 하얗게 터진다｡ 파괴의 파문이 콕핏을 관통하고 유린한다｡"
  },
  {
   "id": 16836,
   "key": "D0816le.txt:140",
   "file": "D0816le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いくつもの機器類が爆発し、紫電を散らした。",
   "ko_candidate": "여러 기기들이 폭발하며 자줏빛 전기를 뿜어냈다｡"
  },
  {
   "id": 16837,
   "key": "D0816le.txt:143",
   "file": "D0816le.txt",
   "line": 143,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ぐわああああああああ！」",
   "ko_candidate": "「구와아아아아아아아아!」"
  },
  {
   "id": 16838,
   "key": "D0816le.txt:148",
   "file": "D0816le.txt",
   "line": 148,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああああああ――――！」",
   "ko_candidate": "「아아아아아아――――!」"
  },
  {
   "id": 16839,
   "key": "D0816le.txt:157",
   "file": "D0816le.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大気を吹き飛ばすかのような爆音は、後からやってきた。",
   "ko_candidate": "대기를 날려버릴 듯한 폭음은 나중에 들려왔다｡"
  },
  {
   "id": 16840,
   "key": "D0816le.txt:158",
   "file": "D0816le.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "吹き飛ばされたデモンベインの巨体は、叩きつけられたかのような高速で大地に墜落する。",
   "ko_candidate": "날려간 데몬베인의 거체는 내리쳐진 듯한 고속으로 대지에 추락한다｡"
  },
  {
   "id": 16841,
   "key": "D0816le.txt:165",
   "file": "D0816le.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "続けてコクピットを揺るがす衝撃。",
   "ko_candidate": "이어서 콕핏을 흔드는 충격｡"
  },
  {
   "id": 16842,
   "key": "D0816le.txt:167",
   "file": "D0816le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "な……何が、起きた……!?",
   "ko_candidate": "뭐……뭐가 일어난 거지……!?"
  },
  {
   "id": 16843,
   "key": "D0816le.txt:175",
   "file": "D0816le.txt",
   "line": 175,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちんたら動いてるから、思わず轢いちまったじゃないの！　ヒャーハッハッハッ！」",
   "ko_candidate": "「꾸물거리니까 그만 치어버렸잖아! 히야하하하!」"
  },
  {
   "id": 16844,
   "key": "D0816le.txt:183",
   "file": "D0816le.txt",
   "line": 183,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『セラエノ断章』の……！」 仰向けに倒れるデモンベインを上空から見下ろすロードビヤーキー。",
   "ko_candidate": "「『<RUBY text=\"Celaeno Fragments\">세라에노 단장</RUBY>』의……!」"
  },
  {
   "id": 16845,
   "key": "D0816le.txt:191",
   "file": "D0816le.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まさか……こいつの体当たりを喰らったのか？",
   "ko_candidate": "뒤로 넘어진 데몬베인을 상공에서 내려다보는 로드 비야키｡"
  }
 ]
