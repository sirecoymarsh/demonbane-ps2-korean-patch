  {
   "id": 35862,
   "key": "D1314ru.txt:30",
   "file": "D1314ru.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "モニターには、昇滅する蝿の巨人を見つめ続ける九郎の横顔が映し出されている。",
   "ko_candidate": "모니터에는 승멸하는 파리의 거인을 계속 바라보는 쿠로의 옆모습이 비치고 있다｡"
  },
  {
   "id": 35863,
   "key": "D1314ru.txt:31",
   "file": "D1314ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "九郎が、カメラの方を向いた。",
   "ko_candidate": "쿠로가 카메라 쪽을 향했다｡"
  },
  {
   "id": 35864,
   "key": "D1314ru.txt:33",
   "file": "D1314ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "モニター越しに瑠璃と見つめ合い、ただ黙って親指を立てる。",
   "ko_candidate": "모니터 너머로 루리와 서로 바라보며､ 그저 묵묵히 엄지를 세운다｡"
  },
  {
   "id": 35865,
   "key": "D1314ru.txt:34",
   "file": "D1314ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瑠璃の顔が綻んだ。",
   "ko_candidate": "루리의 얼굴이 환하게 피어났다｡"
  },
  {
   "id": 35866,
   "key": "D1314ru.txt:41",
   "file": "D1314ru.txt",
   "line": 41,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大十字さん、わたくし達の勝利です……その……ありがとうございました」",
   "ko_candidate": "「다이쥬지 씨､ 저희의 승리예요… 그… 감사합니다」"
  },
  {
   "id": 35867,
   "key": "D1314ru.txt:44",
   "file": "D1314ru.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "モニターの向こうで、九郎が声を上げて笑う。",
   "ko_candidate": "모니터 너머에서 쿠로가 소리 내어 웃는다｡"
  },
  {
   "id": 35868,
   "key": "D1314ru.txt:48",
   "file": "D1314ru.txt",
   "line": 48,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何だよ、そりゃ？　変な姫さんだな」",
   "ko_candidate": "「뭐야､ 그게? 이상한 공주님이네」"
  },
  {
   "id": 35869,
   "key": "D1314ru.txt:52",
   "file": "D1314ru.txt",
   "line": 52,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……放っておいて下さいな。とにかく、ありがとうと云う気持ちなのですッ」 「はははっ」",
   "ko_candidate": "「…내버려 두세요｡ 어쨌든､ 감사하다는 마음이에요」"
  },
  {
   "id": 35870,
   "key": "D1314ru.txt:60",
   "file": "D1314ru.txt",
   "line": 60,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ふん」",
   "ko_candidate": "「하하핫」 「…흥」"
  },
  {
   "id": 35871,
   "key": "D1314ru.txt:63",
   "file": "D1314ru.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "緊迫した空気から解放され、柔らかい空気が一同の間を漂い始めた。",
   "ko_candidate": "긴박했던 공기에서 해방되어､ 부드러운 공기가 일동 사이를 떠돌기 시작했다｡"
  },
  {
   "id": 35872,
   "key": "D1314ru.txt:64",
   "file": "D1314ru.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その時だった。",
   "ko_candidate": "그때였다｡"
  },
  {
   "id": 35873,
   "key": "D1314ru.txt:69",
   "file": "D1314ru.txt",
   "line": 69,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――！　高魔力反応出現！　……っ!?　この数値！ 上空です！　上空からです！」",
   "ko_candidate": "「――――! 고마력 반응 출현! …읏!? 이 수치! 상공입니다! 상공에서입니다!」"
  },
  {
   "id": 35874,
