   "line": 145,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「が……アア……あ……」",
   "ko_candidate": "「크… 아아… 아…」"
  },
  {
   "id": 35893,
   "key": "D1314ru.txt:149",
