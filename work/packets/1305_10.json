 },
 "items": [
  {
   "id": 32606,
   "key": "D1305ru.txt:312",
   "file": "D1305ru.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "床を染める紅。 何だろう、これは？",
   "ko_candidate": "바닥을 물들이는 붉은색｡"
  },
  {
   "id": 32607,
   "key": "D1305ru.txt:315",
   "file": "D1305ru.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "広がってゆく。",
   "ko_candidate": "뭘까､ 이건?"
  },
  {
   "id": 32608,
   "key": "D1305ru.txt:316",
   "file": "D1305ru.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どんどんどんどん広がってゆく。",
   "ko_candidate": "퍼져 나간다｡ 점점점점 퍼져 나간다｡"
  },
  {
   "id": 32609,
   "key": "D1305ru.txt:317",
   "file": "D1305ru.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どんどんどんどん躰が冷たくなってゆく。",
   "ko_candidate": "점점점점 몸이 차가워져 간다｡"
  },
  {
   "id": 32610,
   "key": "D1305ru.txt:319",
   "file": "D1305ru.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ああ、何だ。",
   "ko_candidate": "아아､ 뭐지｡"
  },
  {
   "id": 32611,
   "key": "D1305ru.txt:320",
   "file": "D1305ru.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何てことはない。",
   "ko_candidate": "별거 아니다｡"
  },
  {
   "id": 32612,
   "key": "D1305ru.txt:322",
   "file": "D1305ru.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血だ。",
   "ko_candidate": "피다｡"
  },
  {
   "id": 32613,
   "key": "D1305ru.txt:323",
   "file": "D1305ru.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の血だ。",
   "ko_candidate": "내 피다｡"
  },
  {
   "id": 32614,
   "key": "D1305ru.txt:324",
   "file": "D1305ru.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "胸にぽっかりと穴が空いていて、それで、どんどん血が流れ出ているのだ。",
   "ko_candidate": "가슴에 구멍이 뻥 뚫려 있어서､ 그래서 점점 피가 흘러나오고 있는 거다｡"
  },
  {
   "id": 32615,
   "key": "D1305ru.txt:326",
   "file": "D1305ru.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "思い出した。",
   "ko_candidate": "기억났다｡"
  },
  {
   "id": 32616,
   "key": "D1305ru.txt:327",
   "file": "D1305ru.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はあいつに殺されたのか。",
   "ko_candidate": "나는 그자에게 살해당한 건가｡"
  },
  {
   "id": 32617,
   "key": "D1305ru.txt:329",
   "file": "D1305ru.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あいつが、あの怪異が何だったのか、俺は後々知ることになる。",
   "ko_candidate": "그자가､ 그 괴이가 무엇이었는지､ 나는 후에 알게 될 것이다｡"
  },
  {
   "id": 32618,
   "key": "D1305ru.txt:331",
   "file": "D1305ru.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……後々、知ることになるって、だったら今死んでしまっていたら、辻褄が合わなくって、おかしいのだが……まあ、良い。",
   "ko_candidate": "……후에､ 알게 될 거라고 했는데､ 그렇다면 지금 죽어버리면 말이 안 맞고 이상한데……뭐､ 좋아｡"
  },
  {
   "id": 32619,
   "key": "D1305ru.txt:331",
   "file": "D1305ru.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "色々と不都合があったんだろう。",
   "ko_candidate": "여러 가지로 불편한 점이 있었겠지｡"
  },
  {
   "id": 32620,
   "key": "D1305ru.txt:331",
   "file": "D1305ru.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "とりあえず死人が心配することではない。",
   "ko_candidate": "일단 죽은 사람이 걱정할 일은 아니다｡"
  },
  {
   "id": 32621,
   "key": "D1305ru.txt:333",
   "file": "D1305ru.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "動かない、冷たい骸に閉じ込められたまま、俺はどうすることも出来ず、ただ横倒しになった図書館を見つめ続けるだけだ。",
   "ko_candidate": "움직이지 않는 차가운 시체에 갇힌 채､ 나는 어찌할 도리 없이 그저 옆으로 쓰러진 도서관을 바라볼 뿐이다｡"
  },
  {
   "id": 32622,
   "key": "D1305ru.txt:335",
   "file": "D1305ru.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……あ。",
   "ko_candidate": "……아｡"
  },
  {
   "id": 32623,
   "key": "D1305ru.txt:337",
   "file": "D1305ru.txt",
   "line": 337,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思わず、声を上げた……つもりだったが。",
   "ko_candidate": "무심코 소리를 질렀다……고 생각했지만｡"
  },
  {
   "id": 32624,
   "key": "D1305ru.txt:341",
   "file": "D1305ru.txt",
   "line": 341,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ひゅーぅぁ」",
   "ko_candidate": "「……휴우아」"
  },
  {
   "id": 32625,
   "key": "D1305ru.txt:344",
   "file": "D1305ru.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実際は、咽喉に滞っていた空気が洩れただけだった。",
   "ko_candidate": "실제로는 목구멍에 머물러 있던 공기가 새어 나온 것뿐이었다｡"
  },
  {
   "id": 32626,
   "key": "D1305ru.txt:345",
   "file": "D1305ru.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まあ、死人のことなど、どうでも良い。",
   "ko_candidate": "뭐､ 죽은 사람의 일 따위는 어찌 되든 상관없다｡"
  },
  {
   "id": 32627,
   "key": "D1305ru.txt:347",
   "file": "D1305ru.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は横になった視界に映る意外なその姿に、我が目を疑った。",
   "ko_candidate": "나는 옆으로 누운 시야에 비친 뜻밖의 그 모습에 내 눈을 의심했다｡"
  },
  {
   "id": 32628,
   "key": "D1305ru.txt:349",
   "file": "D1305ru.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの娘は……！",
   "ko_candidate": "저 아가씨는……!"
  },
  {
   "id": 32629,
   "key": "D1305ru.txt:350",
   "file": "D1305ru.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "…………………………誰だったっけ？",
   "ko_candidate": "…………………………누구였더라?"
  },
  {
   "id": 32630,
   "key": "D1305ru.txt:352",
   "file": "D1305ru.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "おいおい、しっかりしろ俺。",
   "ko_candidate": "이봐이봐､ 정신 차려 나｡"
  },
  {
   "id": 32631,
   "key": "D1305ru.txt:353",
   "file": "D1305ru.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死人だからって、いくら何でも寝ぼけ過ぎだ。",
   "ko_candidate": "죽은 사람이라고 해도 아무리 그래도 너무 멍한 거 아냐｡"
  },
  {
   "id": 32632,
   "key": "D1305ru.txt:354",
   "file": "D1305ru.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必死になって脳を働かせ、記憶を掘り起こす。",
   "ko_candidate": "필사적으로 뇌를 움직여 기억을 파낸다｡"
  },
  {
   "id": 32633,
   "key": "D1305ru.txt:356",
   "file": "D1305ru.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……思い出せない。",
   "ko_candidate": "……기억나지 않는다｡"
  },
  {
   "id": 32634,
   "key": "D1305ru.txt:357",
   "file": "D1305ru.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "記憶にない。俺は彼女に会ったことなんて、無い。",
   "ko_candidate": "기억에 없다｡ 나는 그녀를 만난 적이 없다｡"
  },
  {
   "id": 32635,
   "key": "D1305ru.txt:359",
   "file": "D1305ru.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……ああ、そうか。",
   "ko_candidate": "……아아､ 그렇구나｡"
  },
  {
   "id": 32636,
   "key": "D1305ru.txt:360",
   "file": "D1305ru.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "イマを、ココを基準に考えるから駄目なんだ。",
   "ko_candidate": "지금을､ 여기를 기준으로 생각하니까 안 되는 거야｡"
  },
  {
   "id": 32637,
   "key": "D1305ru.txt:362",
   "file": "D1305ru.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうじゃない。",
   "ko_candidate": "그게 아니야｡"
  },
  {
   "id": 32638,
   "key": "D1305ru.txt:363",
   "file": "D1305ru.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ミライの記憶を呼び起こせ。",
   "ko_candidate": "미래의 기억을 떠올려｡"
  },
  {
   "id": 32639,
   "key": "D1305ru.txt:365",
   "file": "D1305ru.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "思い出した。",
   "ko_candidate": "기억났다｡"
  },
  {
   "id": 32640,
   "key": "D1305ru.txt:366",
   "file": "D1305ru.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覇道瑠璃。姫さん。",
   "ko_candidate": "하도 루리｡ 공주님｡"
  },
  {
   "id": 32641,
   "key": "D1305ru.txt:368",
   "file": "D1305ru.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……何で？",
   "ko_candidate": "……왜?"
  },
  {
   "id": 32642,
   "key": "D1305ru.txt:369",
   "file": "D1305ru.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは俺の心の中にある光景なのに。",
   "ko_candidate": "이건 내 마음속에 있는 광경인데｡"
  },
  {
   "id": 32643,
   "key": "D1305ru.txt:370",
   "file": "D1305ru.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の過去の光景なのに。",
   "ko_candidate": "내 과거의 광경인데｡"
  },
  {
   "id": 32644,
   "key": "D1305ru.txt:371",
   "file": "D1305ru.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何故、こんなところに姫さんが？",
   "ko_candidate": "왜 이런 곳에 공주님이?"
  },
  {
   "id": 32645,
   "key": "D1305ru.txt:373",
   "file": "D1305ru.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんは、本に埋もれて倒れていた。",
   "ko_candidate": "공주님은 책에 파묻혀 쓰러져 있었다｡"
  }
