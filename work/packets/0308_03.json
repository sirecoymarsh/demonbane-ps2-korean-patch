 },
 "items": [
  {
   "id": 3353,
   "key": "D0308.txt:909",
   "file": "D0308.txt",
   "line": 909,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "微動だにせず、何の言葉も漏らさない。",
   "ko_candidate": "미동도 하지 않고､ 어떤 말도 새어 나오지 않는다｡"
  },
  {
   "id": 3354,
   "key": "D0308.txt:910",
   "file": "D0308.txt",
   "line": 910,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "表情は仮面の下で、心の動きも見えはしない。",
   "ko_candidate": "표정은 가면 아래에 있어､ 마음의 움직임도 보이지 않는다｡"
  },
  {
   "id": 3355,
   "key": "D0308.txt:915",
   "file": "D0308.txt",
   "line": 915,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そういう事だ！　分かったなら……いい加減手を離さんか！」",
   "ko_candidate": "「그런 거야! 알았다면……이제 그만 손 놓지 않겠어!」"
  },
  {
   "id": 3356,
   "key": "D0308.txt:929",
   "file": "D0308.txt",
   "line": 929,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ボディスーツに魔術文字が輝く。",
   "ko_candidate": "알의 외침과 동시에 바디슈트에 마술 문자가 빛난다｡"
  },
  {
   "id": 3357,
   "key": "D0308.txt:930",
   "file": "D0308.txt",
   "line": 930,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "腕が勝手に動いた。",
   "ko_candidate": "팔이 멋대로 움직였다｡"
  },
  {
   "id": 3358,
   "key": "D0308.txt:931",
   "file": "D0308.txt",
   "line": 931,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の右拳がメタトロンの顔面に叩き込まれる。",
   "ko_candidate": "내 오른주먹이 메타트론의 얼굴에 꽂혔다｡"
  },
  {
   "id": 3359,
   "key": "D0308.txt:946",
   "file": "D0308.txt",
   "line": 946,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆発。衝撃。",
   "ko_candidate": "폭발｡ 충격｡"
  },
  {
   "id": 3360,
   "key": "D0308.txt:947",
   "file": "D0308.txt",
   "line": 947,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "メタトロンは俺の胸を離し、吹き飛んでいった。",
   "ko_candidate": "메타트론은 내 가슴에서 떨어져 날아갔다｡"
  },
  {
   "id": 3361,
   "key": "D0308.txt:956",
   "file": "D0308.txt",
   "line": 956,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺も爆発の反動で反対側に飛ばされる。",
   "ko_candidate": "나도 폭발의 반동으로 반대쪽으로 날아간다｡"
  },
  {
   "id": 3362,
   "key": "D0308.txt:957",
   "file": "D0308.txt",
   "line": 957,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ほぼ同時に体勢を整え、空中で静止。睨み合う。",
   "ko_candidate": "거의 동시에 자세를 가다듬고､ 공중에서 정지｡ 노려본다｡"
  },
  {
   "id": 3363,
   "key": "D0308.txt:959",
   "file": "D0308.txt",
   "line": 959,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "緊張のあまり、冷や汗が頬を伝った。",
   "ko_candidate": "긴장한 나머지､ 식은땀이 뺨을 타고 흘렀다｡"
  },
  {
   "id": 3364,
   "key": "D0308.txt:967",
   "file": "D0308.txt",
   "line": 967,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「それが答えか、大十字九郎」",
   "ko_candidate": "「그게 대답이냐､ 다이쥬지 쿠로」"
  },
  {
   "id": 3365,
   "key": "D0308.txt:983",
   "file": "D0308.txt",
   "line": 983,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺に背を向け、機械の翼を広げるメタトロン。 翼に光が集まっていた。",
   "ko_candidate": "내게 등을 돌리고､ 기계의 날개를 펼치는 메타트론｡ 날개에 빛이 모이고 있었다｡ 어깨 너머로 나를 바라본다｡"
  },
  {
   "id": 3366,
   "key": "D0308.txt:987",
   "file": "D0308.txt",
   "line": 987,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "肩越しに俺を見つめる。 そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 3367,
   "key": "D0308.txt:997",
   "file": "D0308.txt",
   "line": 997,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ならば――私は君を敵として認識する」",
   "ko_candidate": "「그렇다면――나는 너를 적으로 인식하겠다」"
  },
  {
   "id": 3368,
   "key": "D0308.txt:1003",
   "file": "D0308.txt",
   "line": 1003,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「っっっ!?」",
   "ko_candidate": "「으으으으!?」"
  },
  {
   "id": 3369,
   "key": "D0308.txt:1016",
   "file": "D0308.txt",
   "line": 1016,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "冷たく宣言して、メタトロンは翔び去っていった。",
   "ko_candidate": "차갑게 선언하고､ 메타트론은 날아올랐다｡"
  },
  {
   "id": 3370,
   "key": "D0308.txt:1018",
   "file": "D0308.txt",
   "line": 1018,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "超スピードを誇る白の天使は、あっという間に俺の視界から消えてしまう。空には翼が残した光の残滓が灼きついていた。",
   "ko_candidate": "초고속을 자랑하는 하얀 천사는､ 순식간에 내 시야에서 사라져버린다｡ 하늘에는 날개가 남긴 빛의 잔해가 새겨져 있었다｡ 마지막 대사가､ 가슴에 무겁다｡"
  },
  {
   "id": 3371,
   "key": "D0308.txt:1027",
   "file": "D0308.txt",
   "line": 1027,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「敵……俺が、メタトロンの敵？」",
   "ko_candidate": "「적……내가､ 메타트론의 적?」"
  },
  {
   "id": 3372,
   "key": "D0308.txt:1041",
   "file": "D0308.txt",
   "line": 1041,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「確かに……あんたの言う通りかも知れない」",
   "ko_candidate": "「확실히…… 네 말이 맞을지도 모르겠어」"
  },
  {
   "id": 3373,
   "key": "D0308.txt:1046",
   "file": "D0308.txt",
   "line": 1046,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎っ!?」",
   "ko_candidate": "「쿠로!?」"
  },
  {
   "id": 3374,
   "key": "D0308.txt:1051",
   "file": "D0308.txt",
   "line": 1051,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "抗議の声を上げるアル。",
   "ko_candidate": "항의의 목소리를 내는 알｡"
  },
  {
   "id": 3375,
   "key": "D0308.txt:1052",
   "file": "D0308.txt",
   "line": 1052,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど確かにメタトロンの言うことはもっともだ。",
   "ko_candidate": "하지만､ 확실히 메타트론의 말이 일리가 있다｡"
  },
  {
   "id": 3376,
   "key": "D0308.txt:1055",
   "file": "D0308.txt",
   "line": 1055,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少なくとも今のまま俺が、これ以上の被害を出さないなんて断言できるはずがない。",
   "ko_candidate": "적어도 지금 이대로 내가､ 더 이상의 피해를 내지 않을 거라고는､ 단언할 수 없을 것이다｡"
  },
  {
   "id": 3377,
   "key": "D0308.txt:1064",
   "file": "D0308.txt",
   "line": 1064,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「身の程は 理解出来ているようだな」",
   "ko_candidate": "「분수를 알고 있는 것 같군」"
  },
  {
   "id": 3378,
   "key": "D0308.txt:1070",
   "file": "D0308.txt",
   "line": 1070,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くっ……！　汝、此処まで来て、また逃げ……」",
   "ko_candidate": "「크……! 너､ 여기까지 와서､ 또 도망……」"
  },
  {
   "id": 3379,
   "key": "D0308.txt:1075",
   "file": "D0308.txt",
   "line": 1075,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だけど」",
   "ko_candidate": "「하지만」"
  },
  {
   "id": 3380,
   "key": "D0308.txt:1078",
   "file": "D0308.txt",
   "line": 1078,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの言葉をさえぎって、続けた。",
   "ko_candidate": "알의 말을 가로막고､ 계속했다｡"
  },
  {
   "id": 3381,
   "key": "D0308.txt:1083",
   "file": "D0308.txt",
   "line": 1083,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ここで退くのが、正しいとも思わない……」",
   "ko_candidate": "「여기서 물러나는 게､ 옳다고도 생각하지 않아……」"
  },
  {
   "id": 3382,
   "key": "D0308.txt:1088",
   "file": "D0308.txt",
   "line": 1088,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……君の自己満足に、周りを巻き込むつもりか」",
   "ko_candidate": "「……네 자기만족에､ 주변을 끌어들일 생각인가」"
  },
  {
   "id": 3383,
   "key": "D0308.txt:1093",
   "file": "D0308.txt",
   "line": 1093,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だって！　あんな邪悪がのさばってるのを知って！ それなのに見ないふりなんか……！」",
   "ko_candidate": "메타트론의 말은､ 어디까지나 엄격했다｡ 「그래도! 저런 사악한 것들이 활개치고 있는 걸 알면서! 그런데도 모른 척할 순……!」"
  },
  {
   "id": 3384,
   "key": "D0308.txt:1099",
   "file": "D0308.txt",
   "line": 1099,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「君が戦う義務など、どこにもない。 ……人は人の世界で生きるべきだ」",
   "ko_candidate": "「네가 싸울 의무 같은 건 어디에도 없어｡ ……인간은 인간의 세계에서 살아야 해」"
  },
  {
   "id": 3385,
   "key": "D0308.txt:1105",
   "file": "D0308.txt",
   "line": 1105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "胸倉を掴んだまま、メタトロンは淡々と告げる。",
   "ko_candidate": "옷깃을 잡은 채､ 메타트론은 담담히 말한다｡"
  },
  {
   "id": 3386,
   "key": "D0308.txt:1106",
   "file": "D0308.txt",
   "line": 1106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "表情は仮面の下で、心の動きは見えない。",
   "ko_candidate": "표정은 가면 아래로､ 마음의 움직임은 보이지 않는다｡"
  },
  {
   "id": 3387,
   "key": "D0308.txt:1107",
   "file": "D0308.txt",
   "line": 1107,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "隙を見せない、微動だにしないメタトロンの迫力に 俺は怯んでいた。",
   "ko_candidate": "틈을 보이지 않고､ 미동도 하지 않는 메타트론의 위압감에､ 나는 주눅 들어 있었다｡"
  },
  {
   "id": 3388,
   "key": "D0308.txt:1113",
   "file": "D0308.txt",
   "line": 1113,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だけど……！」",
   "ko_candidate": "「하지만……!」"
  },
  {
   "id": 3389,
   "key": "D0308.txt:1118",
   "file": "D0308.txt",
   "line": 1118,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「戯言に耳を貸すな、九郎！」",
   "ko_candidate": "「헛소리에 귀 기울이지 마､ 쿠로!」"
  },
  {
