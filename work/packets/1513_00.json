   "key": "D1513al.txt:327",
   "file": "D1513al.txt",
   "line": 327,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「貴様ァァァァァァ！」」",
   "ko_candidate": "「네놈아아아아아아!」"
  },
  {
