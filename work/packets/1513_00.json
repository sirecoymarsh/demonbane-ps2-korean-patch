   "key": "D1513al.txt:164",
   "file": "D1513al.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "手刀をかわし、リベル・レギスに組みついた。",
   "ko_candidate": "수도를 피하고 리베르 레기스에 달라붙었다｡"
