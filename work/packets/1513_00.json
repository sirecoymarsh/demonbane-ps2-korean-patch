  {
   "id": 46557,
   "key": "D1513al.txt:106",
   "file": "D1513al.txt",
   "line": 106,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「堕ちろぉぉぉぉ！ デモンベイン！」」",
   "ko_candidate": "「떨어져라아아아아! 데몬베인!」"
  },
  {
   "id": 46558,
   "key": "D1513al.txt:122",
   "file": "D1513al.txt",
   "line": 122,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「てめえも道連れだぁぁぁぁぁ！」",
   "ko_candidate": "「네놈도 함께 가자아아아아아!」"
