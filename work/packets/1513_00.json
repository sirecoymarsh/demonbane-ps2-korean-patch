   "ko_candidate": "「크크크……정말 마도서와 주인｡ 똑같이 똑같은 생각을 하는군!」"
  },
  {
   "id": 46566,
   "key": "D1513al.txt:199",
   "file": "D1513al.txt",
   "line": 199,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
