   "key": "D1513al.txt:97",
   "file": "D1513al.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "燃える大気よりも、なお烈しく焔える。",
   "ko_candidate": "타오르는 대기보다도 더욱 맹렬히 불타오른다｡"
  },
  {
   "id": 46555,
   "key": "D1513al.txt:99",
   "file": "D1513al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "トドメを刺すつもりだ。",
