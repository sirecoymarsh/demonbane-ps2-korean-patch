   "key": "D1210le.txt:1094",
   "file": "D1210le.txt",
   "line": 1094,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お前なんかと いっしょにするな！」",
   "ko_candidate": "「너 같은 놈과 같은 취급하지 마!」"
  },
  {
   "id": 29456,
