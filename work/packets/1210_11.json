  {
   "id": 29442,
   "key": "D1210le.txt:1041",
   "file": "D1210le.txt",
   "line": 1041,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そう……『Ｃの巫女』は貴女よ」",
   "ko_candidate": "「그래…… 'C의 무녀'는 당신이야」"
