  {
   "id": 29427,
   "key": "D1210le.txt:977",
   "file": "D1210le.txt",
   "line": 977,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスがライカ達の元に迫る。",
   "ko_candidate": "티베리우스가 라이카 일행에게 다가간다｡"
  },
  {
   "id": 29428,
   "key": "D1210le.txt:978",
   "file": "D1210le.txt",
   "line": 978,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖に震え、逃げ出すことも出来ない子ども達。",
   "ko_candidate": "공포에 떨며 도망??τ는 없는 아이들｡"
  },
  {
   "id": 29429,
   "key": "D1210le.txt:981",
   "file": "D1210le.txt",
   "line": 981,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカは最後の気力を振り絞って、立ち上がり、子ども達の前に出た。",
   "ko_candidate": "라이카는 마지막 기력을 짜내어 일어나 아이들 앞에 섰다｡"
  },
  {
   "id": 29430,
   "key": "D1210le.txt:988",
   "file": "D1210le.txt",
   "line": 988,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
