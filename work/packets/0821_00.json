{
 "packet": "0821_00",
 "scene": "0821",
 "anchor": {
  "hit": 8,
  "total": 9,
  "rate": 0.889
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 17495,
   "key": "D0821le.txt:18",
   "file": "D0821le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雨雲が夜から、月の光と星の光を奪う。",
   "ko_candidate": "비구름이 밤부터 달빛과 별빛을 빼앗는다｡"
  },
  {
   "id": 17496,
   "key": "D0821le.txt:19",
   "file": "D0821le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雨の降りしきる街は、深海に沈んだかのよう。",
   "ko_candidate": "비가 쏟아지는 거리는 깊은 바다에 잠긴 듯하다｡"
  },
  {
   "id": 17497,
   "key": "D0821le.txt:21",
   "file": "D0821le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暗く、重い、路地裏の闇を、囚人は歩く。",
   "ko_candidate": "어둡고 무거운 골목의 어둠을 죄수는 걷는다｡"
  },
  {
   "id": 17498,
   "key": "D0821le.txt:23",
   "file": "D0821le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "止め処なく流れる血は、けれども雨に洗われる。",
   "ko_candidate": "멈출 줄 모르고 흐르는 피는 그러나 비에 씻겨 나간다｡"
  },
  {
   "id": 17499,
   "key": "D0821le.txt:24",
   "file": "D0821le.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血が抜けて冷たくなった躰を更に打ちつけ、体温を根こそぎ奪い尽くす。",
   "ko_candidate": "피가 빠져나가 차가워진 몸을 더욱 때리며 체온을 뿌리째 빼앗아 간다｡"
  },
  {
   "id": 17500,
   "key": "D0821le.txt:26",
   "file": "D0821le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "囚人の躰が傾いだ。",
   "ko_candidate": "죄수의 몸이 기울었다｡"
  },
  {
   "id": 17501,
   "key": "D0821le.txt:29",
   "file": "D0821le.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水溜まりに顔から突っ込むように倒れる。",
   "ko_candidate": "물웅덩이에 얼굴부터 처박히듯 쓰러진다｡"
  },
  {
   "id": 17502,
   "key": "D0821le.txt:31",
   "file": "D0821le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "立ち上がろうと腕に力を込める。",
   "ko_candidate": "일어나려고 팔에 힘을 준다｡"
  },
  {
   "id": 17503,
   "key": "D0821le.txt:32",
   "file": "D0821le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無駄だった。まるで力が入らない。",
   "ko_candidate": "헛수고였다｡ 전혀 힘이 들어가지 않는다｡"
  },
  {
   "id": 17504,
   "key": "D0821le.txt:34",
   "file": "D0821le.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "観念して、躰を転がし、仰向けになる。",
   "ko_candidate": "체념하고 몸을 굴려 누운 자세가 된다｡"
  },
  {
   "id": 17505,
   "key": "D0821le.txt:35",
   "file": "D0821le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただそれだけのことが大事だった。",
   "ko_candidate": "그것만으로도 큰일이었다｡"
  },
  {
   "id": 17506,
   "key": "D0821le.txt:37",
   "file": "D0821le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "建物の壁に囲まれた、狭い狭い路地裏。",
   "ko_candidate": "건물 벽으로 둘러싸인 좁디좁은 골목｡"
  },
  {
   "id": 17507,
   "key": "D0821le.txt:38",
   "file": "D0821le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "壁に四角く切り取られた雨空が覗ける。",
   "ko_candidate": "벽에 네모나게 잘린 빗속 하늘이 보인다｡"
  },
  {
   "id": 17508,
   "key": "D0821le.txt:40",
   "file": "D0821le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "重く垂れ込めた空から注ぐ無数の雨粒が、 視界に飛び込む。",
   "ko_candidate": "무겁게 드리운 하늘에서 쏟아지는 무수한 빗방울이 시야에 뛰어든다｡"
  },
  {
   "id": 17509,
   "key": "D0821le.txt:42",
   "file": "D0821le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なんと無慈悲で――",
   "ko_candidate": "얼마나 무자비하고――"
  },
  {
   "id": 17510,
   "key": "D0821le.txt:42",
   "file": "D0821le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "優しい雨だ。",
   "ko_candidate": "상냥한 비인가｡"
  },
  {
   "id": 17511,
   "key": "D0821le.txt:46",
   "file": "D0821le.txt",
   "line": 46,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ここまでか……」",
   "ko_candidate": "「여기까지인가…」"
  },
  {
   "id": 17512,
   "key": "D0821le.txt:49",
   "file": "D0821le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ひとりごつ。",
   "ko_candidate": "혼잣말｡"
  },
  {
   "id": 17513,
   "key": "D0821le.txt:50",
   "file": "D0821le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呟きは雨の音に吸い込まれていく。",
   "ko_candidate": "중얼거림은 빗소리에 흡수되어 간다｡"
  },
  {
   "id": 17514,
   "key": "D0821le.txt:52",
   "file": "D0821le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "囚人は――笑った。",
   "ko_candidate": "죄수는―― 웃었다｡"
  },
  {
   "id": 17515,
   "key": "D0821le.txt:56",
   "file": "D0821le.txt",
   "line": 56,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「強いなぁ……あいつは……」",
   "ko_candidate": "「강하군… 그 녀석은…」"
  },
  {
   "id": 17516,
   "key": "D0821le.txt:59",
   "file": "D0821le.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎、か。",
   "ko_candidate": "다이쥬지 쿠로인가｡"
  },
  {
   "id": 17517,
   "key": "D0821le.txt:60",
   "file": "D0821le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さすが選ばれただけはある。",
   "ko_candidate": "역시 선택받은 자답다｡"
  },
  {
   "id": 17518,
   "key": "D0821le.txt:61",
   "file": "D0821le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神を殺す意志を持ちて、神の世界を導く者。",
   "ko_candidate": "신을 죽이려는 의지를 가지고 신의 세계를 이끄는 자｡"
  },
  {
   "id": 17519,
   "key": "D0821le.txt:63",
   "file": "D0821le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼もまた運命の道化。",
   "ko_candidate": "그 역시 운명의 광대｡"
  },
  {
   "id": 17520,
   "key": "D0821le.txt:64",
   "file": "D0821le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、ただの道化ではない。",
   "ko_candidate": "하지만 그저 광대는 아니다｡"
  },
  {
   "id": 17521,
   "key": "D0821le.txt:66",
   "file": "D0821le.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あれは自分の役割を超えて、舞台の全部を台無しにしてしまえる、最低の大根役者だ。",
   "ko_candidate": "저 녀석은 자신의 역할을 넘어서 무대 전체를 망쳐버릴 수 있는 최악의 서투른 배우다｡"
  },
  {
   "id": 17522,
   "key": "D0821le.txt:68",
   "file": "D0821le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "窮極のデウス・エクス・マキナだ。",
   "ko_candidate": "궁극의 데우스 엑스 마키나다｡"
  },
  {
   "id": 17523,
   "key": "D0821le.txt:72",
   "file": "D0821le.txt",
   "line": 72,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それに……面白い奴だったなぁ……あいつは……」",
   "ko_candidate": "「게다가… 재미있는 녀석이었지… 그 녀석은…」"
  },
  {
   "id": 17524,
   "key": "D0821le.txt:75",
   "file": "D0821le.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これで、ようやく、終わる。",
   "ko_candidate": "이제 드디어 끝난다｡"
  },
  {
   "id": 17525,
   "key": "D0821le.txt:77",
   "file": "D0821le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処ぞの神サマが書き殴ったこの三文芝居から、",
   "ko_candidate": "어느 신님이 대충 써내려간 이 삼류 연극에서"
  },
  {
   "id": 17526,
   "key": "D0821le.txt:78",
   "file": "D0821le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ようやく解放される。",
   "ko_candidate": "드디어 해방된다｡"
  },
  {
   "id": 17527,
   "key": "D0821le.txt:80",
   "file": "D0821le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪悪に満ちた世界よりの解放。",
   "ko_candidate": "사악으로 가득 찬 세상으로부터의 해방｡"
  },
  {
   "id": 17528,
   "key": "D0821le.txt:81",
   "file": "D0821le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理不尽の嵐よりの解放。",
   "ko_candidate": "부조리의 폭풍으로부터의 해방｡"
  },
  {
   "id": 17529,
   "key": "D0821le.txt:82",
   "file": "D0821le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう――",
   "ko_candidate": "그래――"
  },
  {
   "id": 17530,
   "key": "D0821le.txt:84",
   "file": "D0821le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ようやく、まともに、死ねる。",
   "ko_candidate": "드디어 제대로 죽을 수 있다｡"
  },
  {
   "id": 17531,
   "key": "D0821le.txt:86",
   "file": "D0821le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはきっと、永く永く求めていたもの。",
   "ko_candidate": "그것은 분명 오랫동안 오랫동안 갈망해왔던 것｡"
  },
  {
   "id": 17532,
   "key": "D0821le.txt:88",
   "file": "D0821le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去への憎悪も無く",
   "ko_candidate": "과거에 대한 증오도 없고"
  },
  {
   "id": 17533,
   "key": "D0821le.txt:89",
   "file": "D0821le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "未来への恐怖も無く",
   "ko_candidate": "미래에 대한 공포도 없고"
  },
  {
   "id": 17534,
   "key": "D0821le.txt:90",
   "file": "D0821le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去の重圧も無い、",
   "ko_candidate": "과거의 중압감도 없고"
  }
 ]
}