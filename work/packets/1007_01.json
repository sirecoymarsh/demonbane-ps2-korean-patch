{
 "packet": "1007_01",
 "scene": "1007",
 "anchor": {
  "hit": 12,
  "total": 12,
  "rate": 1.0
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "魔術師": "마술사",
  "デウス・マキナ": "데우스 마키나",
  "鬼械神": "귀계신",
  "魔導書": "마도서",
  "アル": "알"
 },
 "items": [
  {
   "id": 21914,
   "key": "D1007al.txt:174",
   "file": "D1007al.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちが踏んでいるのは屍。",
   "ko_candidate": "우리가 밟고 있는 건 시체｡"
  },
  {
   "id": 21915,
   "key": "D1007al.txt:176",
   "file": "D1007al.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "男もいる。女もいる。",
   "ko_candidate": "남자도 있다｡ 여자도 있다｡"
  },
  {
   "id": 21916,
   "key": "D1007al.txt:177",
   "file": "D1007al.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "若いのも、年老いたのもある。",
   "ko_candidate": "젊은이도､ 나이 든 이도 있다｡"
  },
  {
   "id": 21917,
   "key": "D1007al.txt:178",
   "file": "D1007al.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "積み上げられた屍の山。",
   "ko_candidate": "쌓아올려진 시체의 산｡"
  },
  {
   "id": 21918,
   "key": "D1007al.txt:180",
   "file": "D1007al.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "込み上げてきそうなものを、口を抑えて何とか堪える。",
   "ko_candidate": "치밀어 오르려는 것을､ 입을 막고 어떻게든 참는다｡"
  },
  {
   "id": 21919,
   "key": "D1007al.txt:181",
   "file": "D1007al.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こ、これはいったい……何が何なんだ？",
   "ko_candidate": "이､ 이게 도대체…… 무슨 일이지?"
  },
  {
   "id": 21920,
   "key": "D1007al.txt:183",
   "file": "D1007al.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "屍と目が合った。命の無い虚ろの輝きだ。",
   "ko_candidate": "시체와 눈이 마주쳤다｡ 생명이 없는 공허한 빛이다｡"
  },
  {
   "id": 21921,
   "key": "D1007al.txt:184",
   "file": "D1007al.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "不気味だった。",
   "ko_candidate": "섬뜩했다｡"
  },
  {
   "id": 21922,
   "key": "D1007al.txt:185",
   "file": "D1007al.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど――それ以上に、凄絶で悲痛だった。",
   "ko_candidate": "하지만――그 이상으로､ 처절하고 비통했다｡"
  },
  {
   "id": 21923,
   "key": "D1007al.txt:187",
   "file": "D1007al.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつはその命の最期に何を見たのだろう？",
   "ko_candidate": "이 녀석은 그 생명의 마지막에 무엇을 보았을까?"
  },
  {
   "id": 21924,
   "key": "D1007al.txt:188",
   "file": "D1007al.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲しみでいっぱいになる。",
   "ko_candidate": "슬픔으로 가득 차버린다｡"
  },
  {
   "id": 21925,
   "key": "D1007al.txt:197",
   "file": "D1007al.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのとき、俺の脳裏を幾つものイメージが走馬灯のように走った。",
   "ko_candidate": "그때､ 내 뇌리를 수많은 이미지가 주마등처럼 스쳐 지나갔다｡"
  },
  {
   "id": 21926,
   "key": "D1007al.txt:198",
   "file": "D1007al.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "処理しきれないほど膨大な情報の量に、自意識すら吹き飛ばされそうになる。",
   "ko_candidate": "처리할 수 없을 만큼 방대한 정보의 양에､ 자의식마저 날아갈 것 같다｡"
  },
  {
   "id": 21927,
   "key": "D1007al.txt:200",
   "file": "D1007al.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自我を必死に保ちながら、俺は何とか情報を整理する。",
   "ko_candidate": "자아를 필사적으로 유지하면서､ 나는 어떻게든 정보를 정리한다｡"
  },
  {
   "id": 21928,
   "key": "D1007al.txt:201",
   "file": "D1007al.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これは、まさか……。",
   "ko_candidate": "이건､ 설마……"
  },
  {
   "id": 21929,
   "key": "D1007al.txt:206",
   "file": "D1007al.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾人ものイメージが駈け抜けていく。",
   "ko_candidate": "수많은 이미지가 스쳐 지나간다｡"
  },
  {
   "id": 21930,
   "key": "D1007al.txt:207",
   "file": "D1007al.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同じ顔はない。時代すら違う。",
   "ko_candidate": "같은 얼굴은 없다｡ 시대조차 다르다｡"
  },
  {
   "id": 21931,
   "key": "D1007al.txt:209",
   "file": "D1007al.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ１つ共通しているのは、その全員が魔術師であること。",
   "ko_candidate": "단 하나 공통점은､ 그 모두가 마술사라는 것｡"
  },
  {
   "id": 21932,
   "key": "D1007al.txt:210",
   "file": "D1007al.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔導書を抱えデウス・マキナを操り、邪悪な魔術師と、化物や悪魔と、そして鬼械神と血塗れになりボロボロになりながらも戦っている。",
   "ko_candidate": "마도서를 안고 데우스 마키나를 조종하며､ 사악한 마술사와､ 괴물과 악마와､ 그리고 귀계신과 피투성이가 되고 만신창이가 되면서도 싸우고 있다｡"
  },
  {
   "id": 21933,
   "key": "D1007al.txt:212",
   "file": "D1007al.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やっぱり、そうだ。",
   "ko_candidate": "역시､ 그렇구나｡"
  },
  {
   "id": 21934,
   "key": "D1007al.txt:213",
   "file": "D1007al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは……アルの記憶だ。",
   "ko_candidate": "이건…… 알의 기억이다｡"
  },
  {
   "id": 21935,
   "key": "D1007al.txt:214",
   "file": "D1007al.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの千年の記憶を、俺は今、追体験していた。",
   "ko_candidate": "알의 천 년의 기억을､ 나는 지금､ 추체험하고 있었다｡"
  },
  {
   "id": 21936,
   "key": "D1007al.txt:219",
   "file": "D1007al.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼らは歴代のアルの所有者達だ。",
   "ko_candidate": "그들은 역대 알의 소유자들이다｡"
  },
  {
   "id": 21937,
   "key": "D1007al.txt:220",
   "file": "D1007al.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルと共に戦い、朽ちて逝った魔術師達だ。",
   "ko_candidate": "알과 함께 싸우고､ 썩어 사라져간 마술사들이다｡"
  },
  {
   "id": 21938,
   "key": "D1007al.txt:222",
   "file": "D1007al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無念の最期を遂げた者もいた。",
   "ko_candidate": "무념의 최후를 맞이한 자도 있었다｡"
  },
  {
   "id": 21939,
   "key": "D1007al.txt:223",
   "file": "D1007al.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "穏やかな笑顔を浮かべ逝く者もいた。",
   "ko_candidate": "평온한 미소를 띠며 떠나는 자도 있었다｡"
  },
  {
   "id": 21940,
   "key": "D1007al.txt:224",
   "file": "D1007al.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かを言い残して逝く者も、",
   "ko_candidate": "뭔가를 남기고 떠나는 자도､"
  },
  {
   "id": 21941,
   "key": "D1007al.txt:225",
   "file": "D1007al.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "残す言葉すら無かった者もいた。",
   "ko_candidate": "남길 말조차 없었던 자도 있었다｡"
  },
  {
   "id": 21942,
   "key": "D1007al.txt:227",
   "file": "D1007al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのいずれの死も、アルは見届けてきた。",
   "ko_candidate": "그 어느 죽음도､ 알은 지켜봐 왔다｡"
  },
  {
   "id": 21943,
   "key": "D1007al.txt:229",
   "file": "D1007al.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし……馬鹿だな。",
   "ko_candidate": "하지만…… 바보 같아｡"
  },
  {
   "id": 21944,
   "key": "D1007al.txt:230",
   "file": "D1007al.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何だよ、アル。お前、悲しみ方も知らないのかよ。",
   "ko_candidate": "뭐야､ 알｡ 넌 슬퍼하는 법도 모르는 거야｡"
  },
  {
   "id": 21945,
   "key": "D1007al.txt:232",
   "file": "D1007al.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣くことも出来ずに、ただ黙って見届けるだけなんて辛すぎるじゃねえか。",
   "ko_candidate": "울 수도 없이､ 그저 묵묵히 지켜보기만 하는 건 너무 괴롭잖아｡"
  },
  {
   "id": 21946,
   "key": "D1007al.txt:234",
   "file": "D1007al.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お前は自分で思っているほど、冷酷にも冷静にもなれないんだよ。",
   "ko_candidate": "넌 네가 생각하는 것만큼､ 냉혹하지도 냉정하지도 못해｡"
  },
  {
   "id": 21947,
   "key": "D1007al.txt:236",
   "file": "D1007al.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "押し潰されそうなほどの悲しみを背負い、アルは闘いの時間を生きる。",
   "ko_candidate": "짓눌릴 것 같은 슬픔을 짊어지고､ 알은 싸움의 시간을 산다｡"
  },
  {
   "id": 21948,
   "key": "D1007al.txt:236",
   "file": "D1007al.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲しみの存在にすら気づかずに生きる。",
   "ko_candidate": "슬픔의 존재조차 깨닫지 못한 채 산다｡"
  },
  {
   "id": 21949,
   "key": "D1007al.txt:241",
   "file": "D1007al.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なんて滑稽な命の在り方だろうか。",
   "ko_candidate": "얼마나 우스꽝스러운 생명의 모습일까｡"
  },
  {
   "id": 21950,
   "key": "D1007al.txt:242",
   "file": "D1007al.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傷は深く、血は流れ続け、死にかけているというのに、傷の痛みにも血まみれな自分の姿にも見向かない――そんな命が在って良いものなんだろうか。",
   "ko_candidate": "상처는 깊고､ 피는 계속 흐르고､ 죽어가고 있는데도､ 상처의 아픔도 피투성이가 된 자신의 모습도 돌아보지 않는――그런 생명이 있어도 되는 걸까｡"
  },
  {
   "id": 21951,
   "key": "D1007al.txt:244",
   "file": "D1007al.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触れられないのが、もどかしい。",
   "ko_candidate": "닿을 수 없다는 게､ 안타깝다｡"
  },
  {
   "id": 21952,
   "key": "D1007al.txt:245",
   "file": "D1007al.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "教えてやりたかった。そんな風に心を凍らせる必要はないと。",
   "ko_candidate": "알려주고 싶었다｡ 그렇게 마음을 얼어붙일 필요는 없다고｡"
  },
  {
   "id": 21953,
   "key": "D1007al.txt:247",
   "file": "D1007al.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だから、俺の存在をまったく認識していないであろうアルに、それでも俺は語りかけた。",
   "ko_candidate": "그래서､ 내 존재를 전혀 인식하지 못하고 있을 알에게､ 그래도 나는 말을 걸었다｡"
  }
 ]
}