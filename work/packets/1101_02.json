 "items": [
  {
   "id": 22132,
   "key": "D1101al.txt:213",
   "file": "D1101al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身体を起こそうとすると酷く身体が痛む。あちこち怪我をしているみたいだ。骨も何本か折れているかも知れない。",
   "ko_candidate": "몸을 일으키려고 하자 몹시 몸이 아프다｡ 여기저기 다친 것 같다｡ 뼈도 몇 개 부러졌을지도 모른다｡"
  },
  {
   "id": 22133,
   "key": "D1101al.txt:215",
   "file": "D1101al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが怯んでいられるか。",
   "ko_candidate": "하지만 주저하고 있을 수 있겠는가｡"
  },
  {
   "id": 22134,
   "key": "D1101al.txt:216",
   "file": "D1101al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "痛みを無理矢理ねじ伏せ、 俺はコクピットの中から這い出た。",
   "ko_candidate": "고통을 억지로 억누르고､ 나는 콕핏에서 기어 나왔다｡"
  },
  {
   "id": 22135,
   "key": "D1101al.txt:222",
   "file": "D1101al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲を飛び移って、下に降りようとする。",
   "ko_candidate": "장갑을 타고 넘어､ 아래로 내려가려고 한다｡"
  },
  {
   "id": 22136,
   "key": "D1101al.txt:223",
   "file": "D1101al.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、脚に力が入らない。",
   "ko_candidate": "하지만､ 다리에 힘이 들어가지 않는다｡"
  },
  {
   "id": 22137,
   "key": "D1101al.txt:226",
   "file": "D1101al.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バランスを失い、装甲の上を転がり落ちる。",
   "ko_candidate": "균형을 잃고､ 장갑 위를 굴러 떨어진다｡"
  },
  {
   "id": 22138,
   "key": "D1101al.txt:233",
   "file": "D1101al.txt",
   "line": 233,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぁ……ぐぐ……っあ！」",
   "ko_candidate": "「으아……으으……윽!」"
  },
  {
   "id": 22139,
   "key": "D1101al.txt:237",
   "file": "D1101al.txt",
   "line": 237,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さぁんっ!?」",
   "ko_candidate": "「다이쥬지 씨이잇!?」"
  },
  {
   "id": 22140,
   "key": "D1101al.txt:241",
   "file": "D1101al.txt",
   "line": 241,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いけない！」",
   "ko_candidate": "「안 돼!」"
  },
  {
   "id": 22141,
   "key": "D1101al.txt:250",
   "file": "D1101al.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "執事さんがデモンベインを翔ぶが如く駆け昇る。",
   "ko_candidate": "집사님이 데몬베인을 날듯이 달려 올라온다｡"
  },
  {
   "id": 22142,
   "key": "D1101al.txt:251",
   "file": "D1101al.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墜ちる俺の身体を、しっかりと受け止め、華麗に地面に着地する。",
   "ko_candidate": "떨어지는 내 몸을､ 단단히 받아 멈추고､ 우아하게 지면에 착지한다｡"
  },
  {
   "id": 22143,
   "key": "D1101al.txt:257",
   "file": "D1101al.txt",
   "line": 257,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……ぐぐぅ……」",
   "ko_candidate": "「크윽……으으윽……」"
  },
  {
   "id": 22144,
   "key": "D1101al.txt:261",
   "file": "D1101al.txt",
   "line": 261,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふぅ……危ない、危ない」",
   "ko_candidate": "「휴……위험해､ 위험해」"
  },
  {
   "id": 22145,
   "key": "D1101al.txt:264",
   "file": "D1101al.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "執事さんは静かに俺を下ろしてくれた。",
   "ko_candidate": "집사님은 조용히 나를 내려주었다｡"
  },
  {
   "id": 22146,
   "key": "D1101al.txt:265",
   "file": "D1101al.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんたちが、慌てて駆け寄ってくる。",
   "ko_candidate": "공주님 일행이､ 황급히 달려온다｡"
  },
  {
   "id": 22147,
   "key": "D1101al.txt:269",
   "file": "D1101al.txt",
   "line": 269,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちょっ…… え、えらい怪我やないか!? なに無茶しとんねんっ！」",
   "ko_candidate": "「잠깐…… 어､ 엄청난 부상이잖아!? 뭐하는 거야 무모하게!」"
  },
  {
   "id": 22148,
   "key": "D1101al.txt:275",
   "file": "D1101al.txt",
   "line": 275,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「救護班を早く……！」",
   "ko_candidate": "「구호반을 빨리……!」"
  },
  {
   "id": 22149,
   "key": "D1101al.txt:278",
   "file": "D1101al.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……悪いが、今は付き合っている場合じゃない。",
   "ko_candidate": "……미안하지만､ 지금은 함께할 여유가 없어｡"
  },
  {
   "id": 22150,
   "key": "D1101al.txt:279",
   "file": "D1101al.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺の身体を支えようとするみんなを、払い除けた。",
   "ko_candidate": "나를 부축하려는 모두를 밀쳐냈다｡"
  },
  {
   "id": 22151,
   "key": "D1101al.txt:283",
   "file": "D1101al.txt",
   "line": 283,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ！」",
   "ko_candidate": "「――――읏!」"
  },
  {
   "id": 22152,
   "key": "D1101al.txt:287",
   "file": "D1101al.txt",
   "line": 287,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわわっ！　だ、大十字さん、 何するんですかぁっ！」",
   "ko_candidate": "「우와왓! 다､ 다이쥬지 씨､ 뭐 하시는 거예요!」"
  },
  {
   "id": 22153,
   "key": "D1101al.txt:292",
   "file": "D1101al.txt",
   "line": 292,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「すまねえな……後にしてくれ。 今はやらなきゃならないことがある……ッ」",
   "ko_candidate": "「미안하다… 나중에 해줘｡ 지금은 해야 할 일이 있어…읏」"
  },
  {
   "id": 22154,
   "key": "D1101al.txt:297",
   "file": "D1101al.txt",
   "line": 297,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そんな身体で何を……!?」",
   "ko_candidate": "「그런 몸으로 무얼…!?」"
  },
  {
   "id": 22155,
   "key": "D1101al.txt:301",
   "file": "D1101al.txt",
   "line": 301,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「奴らを、アンチクロスをブチ殺す」",
   "ko_candidate": "「놈들을､ 안티 크로스를 박살내겠어」"
  },
  {
   "id": 22156,
   "key": "D1101al.txt:305",
   "file": "D1101al.txt",
   "line": 305,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――!?　滅茶苦茶なこと言わないで下さいまし！　今の大十字さんがのこのこ出て行って敵う相手じゃ……」",
   "ko_candidate": "「――!? 터무니없는 소리 하지 마세요! 지금의 다이쥬지 씨가 나가봤자 상대가 될 리가…」"
  },
  {
   "id": 22157,
   "key": "D1101al.txt:309",
   "file": "D1101al.txt",
   "line": 309,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――五月蝿い！」",
   "ko_candidate": "「――시끄러워!」"
  },
  {
   "id": 22158,
   "key": "D1101al.txt:313",
   "file": "D1101al.txt",
   "line": 313,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃあっ!?」",
   "ko_candidate": "「꺄악!?」"
  },
  {
   "id": 22159,
   "key": "D1101al.txt:316",
   "file": "D1101al.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反射的に怒鳴ってしまった。",
   "ko_candidate": "반사적으로 고함을 질러버렸다｡"
  },
  {
   "id": 22160,
   "key": "D1101al.txt:317",
   "file": "D1101al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "みんな静まり返り、驚いた顔で俺を見つめる。",
   "ko_candidate": "모두가 조용해지고､ 놀란 얼굴로 나를 바라본다｡"
  },
  {
   "id": 22161,
   "key": "D1101al.txt:318",
   "file": "D1101al.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少しだけ気まずい思いになったが、感情の暴走は止まりそうにもなかった。",
   "ko_candidate": "조금 어색해졌지만､ 감정의 폭주는 멈출 것 같지 않았다｡"
  },
  {
   "id": 22162,
   "key": "D1101al.txt:320",
   "file": "D1101al.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "制御できない激情に流されたまま、 俺は怒りを吐き出す。",
   "ko_candidate": "제어할 수 없는 격정에 휩쓸린 채､ 나는 분노를 토해낸다｡"
  },
  {
   "id": 22163,
   "key": "D1101al.txt:324",
   "file": "D1101al.txt",
   "line": 324,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アルは！　アルは俺を護って死んだんだ！ そんなのって有りかよ！ 許せるか！　許せるワケねえだろ！ 俺は奴らをぶっ潰さなきゃならねえんだよ！」",
   "ko_candidate": "「알은! 알은 날 지키다 죽었다고! 그런 게 말이 돼?! 용서할 수 있어? 용서할 리가 없잖아! 난 놈들을 박살내야 한다고!」"
  },
  {
   "id": 22164,
   "key": "D1101al.txt:332",
   "file": "D1101al.txt",
   "line": 332,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 22165,
   "key": "D1101al.txt:335",
   "file": "D1101al.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルが死んだという言葉に反応したのだろう、 短く息を呑んだ。",
   "ko_candidate": "알이 죽었다는 말에 반응한 것일까､ 짧게 숨을 들이켰다｡"
  },
  {
   "id": 22166,
   "key": "D1101al.txt:337",
   "file": "D1101al.txt",
   "line": 337,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソーニャの瞳にみるみる大粒の涙が浮かぶ。",
   "ko_candidate": "소냐의 눈에 순식간에 굵은 눈물이 맺힌다｡"
  },
  {
   "id": 22167,
   "key": "D1101al.txt:338",
   "file": "D1101al.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マコトにいたっては、青い顔で震えだしていた。",
   "ko_candidate": "마코토는 아예 창백한 얼굴로 떨기 시작했다｡"
  },
  {
   "id": 22168,
   "key": "D1101al.txt:340",
   "file": "D1101al.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんが恐る恐る、怯えるような声で訊ねた。",
   "ko_candidate": "공주님이 조심스레､ 두려워하는 듯한 목소리로 물었다｡"
  },
  {
   "id": 22169,
   "key": "D1101al.txt:344",
   "file": "D1101al.txt",
   "line": 344,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じゃあ…… じゃあ、やっぱり……」",
   "ko_candidate": "「그럼… 그럼､ 역시…」"
  },
  {
   "id": 22170,
   "key": "D1101al.txt:348",
   "file": "D1101al.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は黙って頷く。",
   "ko_candidate": "나는 말없이 고개를 끄덕인다｡"
  },
  {
   "id": 22171,
   "key": "D1101al.txt:349",
   "file": "D1101al.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……叫ぶだけ叫んだら、少しだけ落ち着いたらしい。",
   "ko_candidate": "…소리치고 나니 조금은 진정된 모양이다｡"
  }
 ]
}