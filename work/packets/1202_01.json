 "items": [
  {
   "id": 26747,
   "key": "D1202al.txt:219",
   "file": "D1202al.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力を纏った両手を振り下ろす。",
   "ko_candidate": "마력을 두른 양손을 내리친다｡"
  },
  {
   "id": 26748,
   "key": "D1202al.txt:220",
   "file": "D1202al.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "十字に放たれた破壊の風が、通路に無数の傷痕を刻みながら押し寄せる。",
   "ko_candidate": "십자로 방출된 파괴의 바람이 통로에 무수한 상흔을 새기며 밀려온다｡ 「우와와로봇!?」"
  },
  {
   "id": 26749,
   "key": "D1202al.txt:224",
   "file": "D1202al.txt",
   "line": 224,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわわロボっ!?」 慌ててバックステップするエルザ。",
   "ko_candidate": "허둥지둥 백스텝하는 엘자｡ 하지만 도망칠 수 있을 것 같지 않다｡"
  },
  {
   "id": 26750,
   "key": "D1202al.txt:230",
   "file": "D1202al.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかし逃げ切れそうにもない。 エルザは懐から手榴弾を取り出して、",
   "ko_candidate": "엘자는 품에서 수류탄을 꺼내 다가오는 바람을 향해 던졌다｡"
  },
  {
   "id": 26751,
   "key": "D1202al.txt:233",
   "file": "D1202al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迫る風に向かって投げつけた。",
   "ko_candidate": "열풍에 토막 나 수류탄이 폭발한다｡"
  },
  {
   "id": 26752,
   "key": "D1202al.txt:242",
   "file": "D1202al.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烈風に切り刻まれ、手榴弾が爆発する。",
   "ko_candidate": "폭발 속에서 마법진이 전개된다｡"
  },
  {
   "id": 26753,
   "key": "D1202al.txt:250",
   "file": "D1202al.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の中から魔法陣が展開される。",
   "ko_candidate": "{SE_VOL(1,1000,0);}"
  },
  {
   "id": 26754,
   "key": "D1202al.txt:253",
   "file": "D1202al.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "破壊の風は、魔法陣によって食い止められた…… こいつもドクター・ウェストの発明なのか。",
   "ko_candidate": "파괴의 바람은 마법진에 의해 저지당했다…이것도 닥터 웨스트의 발명인가｡"
  },
  {
   "id": 26755,
   "key": "D1202al.txt:261",
   "file": "D1202al.txt",
   "line": 261,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「う～～～～っ！　とっておきが！　もったいないロボ！」",
   "ko_candidate": "「우~~~~~! 비장의 무기가! 아깝네로봇!」"
  },
  {
   "id": 26756,
   "key": "D1202al.txt:264",
   "file": "D1202al.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆風に煽られ、地面を転がるエルザの身体。",
   "ko_candidate": "폭풍에 휩쓸려 바닥을 구르는 엘자의 몸｡"
  },
  {
   "id": 26757,
   "key": "D1202al.txt:265",
   "file": "D1202al.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足を踏ん張り、片手を床に突いて何とか堪える。",
   "ko_candidate": "발을 디디고 한 손을 바닥에 짚으며 어떻게든 버틴다｡"
  },
  {
   "id": 26758,
   "key": "D1202al.txt:271",
   "file": "D1202al.txt",
   "line": 271,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しゃらくせぇんだよ、 ガラクタが！」",
   "ko_candidate": "「성가시군､ 섹스돌 주제에!」"
  },
  {
   "id": 26759,
   "key": "D1202al.txt:276",
   "file": "D1202al.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の中から、風を全身に纏ったクラウディウスが飛び出した。",
   "ko_candidate": "폭발 속에서 바람을 온몸에 두른 클라우디우스가 튀어나왔다｡"
  },
  {
   "id": 26760,
   "key": "D1202al.txt:276",
   "file": "D1202al.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エルザ目がけて突っ込んでくる。",
   "ko_candidate": "엘자를 향해 돌진해온다｡"
  },
  {
   "id": 26761,
   "key": "D1202al.txt:279",
   "file": "D1202al.txt",
   "line": 279,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「伏せろ、エルザ！」",
   "ko_candidate": "「엎드려､ 엘자!」"
  },
  {
   "id": 26762,
   "key": "D1202al.txt:296",
   "file": "D1202al.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザが床に伏せたのを確認して、俺はクラウディウスに全弾を撃ち込む。",
   "ko_candidate": "엘자가 바닥에 엎드린 걸 확인하고 나는 클라우디우스에게 전탄을 쏟아부었다｡"
  },
  {
   "id": 26763,
   "key": "D1202al.txt:298",
   "file": "D1202al.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ほとんどの弾丸が風の結界を前に軌道を逸らされ、あらぬ方角へと飛んでいくが、貫通力のあるクトゥグアの弾丸一発が結界を突破した。",
   "ko_candidate": "대부분의 탄환이 바람의 결계 앞에서 궤도를 빗나가 엉뚱한 방향으로 날아가지만､ 관통력 있는 크투가의 탄환 한 발이 결계를 돌파했다｡ 「치잇!」{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 26764,
   "key": "D1202al.txt:305",
   "file": "D1202al.txt",
   "line": 305,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チィッ！」 顔面向けて飛んでくる弾丸を目で追って、軌道を見切るクラウディウス。",
   "ko_candidate": "얼굴을 향해 날아오는 탄환을 눈으로 쫓아 궤도를 간파하는 클라우디우스｡"
  },
  {
   "id": 26765,
   "key": "D1202al.txt:309",
   "file": "D1202al.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "首を大きく傾けて、弾丸をかわした。",
   "ko_candidate": "목을 크게 기울여 탄환을 피했다｡"
  },
  {
   "id": 26766,
   "key": "D1202al.txt:317",
   "file": "D1202al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その一瞬、注意が逸れたその隙に、俺はバルザイの偃月刀を手に駈け出す――！",
   "ko_candidate": "그 순간､ 주의가 흐트러진 틈을 타 나는 바르자이의 언월도를 손에 쥐고 달려나간다--!"
  },
  {
   "id": 26767,
   "key": "D1202al.txt:321",
   "file": "D1202al.txt",
   "line": 321,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「せいやっ！」",
   "ko_candidate": "「세이야!」"
  },
  {
   "id": 26768,
   "key": "D1202al.txt:326",
   "file": "D1202al.txt",
   "line": 326,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シャアアアア！」",
   "ko_candidate": "「샤아아아아!」"
  },
  {
   "id": 26769,
   "key": "D1202al.txt:331",
   "file": "D1202al.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り下ろした偃月刀を、クラウディウスは懐から取り出した何かで受け止めた。",
   "ko_candidate": "내리친 언월도를 클라우디우스는 품에서 꺼낸 무언가로 받아냈다｡"
  },
  {
   "id": 26770,
   "key": "D1202al.txt:332",
   "file": "D1202al.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "玉を乗せた、小さな小槌――今度はケンダマだった。",
   "ko_candidate": "구슬을 올린 작은 망치--이번엔 켄다마였다｡"
  },
  {
   "id": 26771,
   "key": "D1202al.txt:334",
   "file": "D1202al.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ケンダマの表面には薄っすらと魔術文字が輝いている。",
   "ko_candidate": "켄다마 표면에는 희미하게 마술 문자가 빛나고 있다｡"
  },
  {
   "id": 26772,
   "key": "D1202al.txt:335",
   "file": "D1202al.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さっきのベーゴマといい……これがクラウディウスの魔術武器か！",
   "ko_candidate": "아까의 팽이도 그렇고…이게 클라우디우스의 마술 무기인가!"
  },
  {
   "id": 26773,
   "key": "D1202al.txt:343",
   "file": "D1202al.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "驚く俺の顔を睨み、少年は狂笑を浮かべた。",
   "ko_candidate": "놀라는 내 얼굴을 노려보며 소년은 광기 어린 미소를 지었다｡"
  },
  {
   "id": 26774,
   "key": "D1202al.txt:347",
   "file": "D1202al.txt",
   "line": 347,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「よう……待っていたぜ、インスタント野郎。 てめぇはカリグラ殺したんだ……楽に死ねると思ってんじゃねえぞ！」",
   "ko_candidate": "「야…기다리고 있었다고､ 인스턴트 녀석｡ 네놈이 칼리굴라를 죽였지…편하게 죽을 수 있다고 생각하지 마!」"
  },
  {
   "id": 26775,
   "key": "D1202al.txt:353",
   "file": "D1202al.txt",
   "line": 353,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それはこっちの台詞だ、クソガキ！　世間知らずの坊やに社会の厳しさってもんを教育してやるぜ！」",
   "ko_candidate": "「그건 내 대사다､ 개자식! 세상 물정 모르는 꼬마에게 사회의 엄격함이란 걸 가르쳐주지!」"
  },
  {
   "id": 26776,
   "key": "D1202al.txt:357",
   "file": "D1202al.txt",
   "line": 357,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬかせや！」",
   "ko_candidate": "「지껄이지 마!」"
  },
  {
   "id": 26777,
   "key": "D1202al.txt:361",
   "file": "D1202al.txt",
   "line": 361,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「粋がるな！」",
   "ko_candidate": "「까부르지 마!」"
  },
  {
   "id": 26778,
   "key": "D1202al.txt:371",
   "file": "D1202al.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれ合う偃月刀とケンダマ。",
   "ko_candidate": "튕겨나는 언월도와 켄다마｡"
  },
  {
   "id": 26779,
   "key": "D1202al.txt:374",
   "file": "D1202al.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐさま２撃目を繰り出す。",
   "ko_candidate": "곧바로 2타를 날린다｡"
  },
  {
   "id": 26780,
   "key": "D1202al.txt:375",
   "file": "D1202al.txt",
   "line": 375,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぶつかる刃と槌が火花を散らす。",
   "ko_candidate": "부딪치는 칼날과 망치가 불꽃을 튀긴다｡"
  },
  {
   "id": 26781,
   "key": "D1202al.txt:379",
   "file": "D1202al.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらに３撃目、４撃目。",
   "ko_candidate": "더 나아가 3타､ 4타｡"
  },
  {
   "id": 26782,
   "key": "D1202al.txt:380",
   "file": "D1202al.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃をぶつけ合うごとに速度は増していく。",
   "ko_candidate": "공격을 주고받을 때마다 속도는 빨라진다｡"
  },
  {
   "id": 26783,
   "key": "D1202al.txt:381",
   "file": "D1202al.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くっ……目が追っつかねえ！",
   "ko_candidate": "큿…눈이 따라가질 못해!"
  },
  {
   "id": 26784,
   "key": "D1202al.txt:389",
   "file": "D1202al.txt",
   "line": 389,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「鈍いよー、九郎ちゃんよー！」",
   "ko_candidate": "「둔하네~､ 쿠로 짱~!」"
  },
  {
   "id": 26785,
   "key": "D1202al.txt:398",
   "file": "D1202al.txt",
   "line": 398,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ダーリン！」",
   "ko_candidate": "「달링!」"
  },
  {
   "id": 26786,
   "key": "D1202al.txt:404",
   "file": "D1202al.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "起き上がったエルザがこっちに向かって、駆けてくる。",
   "ko_candidate": "일어선 엘자가 이쪽을 향해 달려온다｡"
  }
 ]
}