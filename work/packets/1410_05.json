   "key": "D1410ru.txt:393",
   "file": "D1410ru.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして残りの一発は、何もないはずの空間へ向かって飛んでいった。",
   "ko_candidate": "그리고 남은 한 발은 아무것도 없어야 할 공간을 향해 날아갔다｡"
  },
  {
   "id": 38968,
   "key": "D1410ru.txt:400",
   "file": "D1410ru.txt",
   "line": 400,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……！」",
   "ko_candidate": "「뭣…!」"
