  {
   "id": 38947,
   "key": "D1410ru.txt:289",
   "file": "D1410ru.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "三巨人の間を結界が結んだ。",
   "ko_candidate": "세 거인 사이에 결계가 생겼다｡"
  },
  {
   "id": 38948,
   "key": "D1410ru.txt:293",
   "file": "D1410ru.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "結界の中心に閉じ込められたデモンベインに対し、３巨人はあの時と同じく、怨念に満ちた断末魔の雄叫びを叩きつけてくる！",
   "ko_candidate": "결계의 중심에 갇힌 데몬베인을 향해 3거인은 그때와 같이 원념으로 가득 찬 단말마의 포효를 퍼부어 온다!"
  },
  {
   "id": 38949,
   "key": "D1410ru.txt:299",
   "file": "D1410ru.txt",
   "line": 299,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちぃぃぃぃっ！　こ、これは……」",
   "ko_candidate": "「치이이이익! 이､ 이건…」"
