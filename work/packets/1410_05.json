  {
   "id": 38950,
   "key": "D1410ru.txt:306",
   "file": "D1410ru.txt",
   "line": 306,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何たる……」",
   "ko_candidate": "「이 무슨…」"
  },
  {
   "id": 38951,
   "key": "D1410ru.txt:312",
   "file": "D1410ru.txt",
   "line": 312,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――馬鹿の一つ覚えだな」",
   "ko_candidate": "「――바보 같은 소리 하고 있네」"
  },
  {
   "id": 38952,
   "key": "D1410ru.txt:324",
   "file": "D1410ru.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの姿が砕け散る。",
   "ko_candidate": "데몬베인의 모습이 산산조각 난다｡"
  },
  {
   "id": 38953,
   "key": "D1410ru.txt:325",
   "file": "D1410ru.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕け散った破片はきらきらと輝きながら、周囲の情景を映し返していた。",
   "ko_candidate": "산산조각 난 파편은 반짝반짝 빛나며 주변의 풍경을 비추고 있었다｡"
  },
  {
   "id": 38954,
   "key": "D1410ru.txt:330",
   "file": "D1410ru.txt",
   "line": 330,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
