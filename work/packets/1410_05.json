   "key": "D1410ru.txt:358",
   "file": "D1410ru.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重みに耐えかねていた巨人の首が、刎ね飛んだ。",
   "ko_candidate": "무게를 견디지 못한 거인의 목이 날아갔다｡"
  },
  {
   "id": 38962,
   "key": "D1410ru.txt:363",
   "file": "D1410ru.txt",
   "line": 363,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「貴様……っ！」",
   "ko_candidate": "「네놈…읏!」"
