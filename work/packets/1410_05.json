  {
   "id": 38955,
   "key": "D1410ru.txt:338",
   "file": "D1410ru.txt",
   "line": 338,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「不意を突いたつもりだったろうが甘かったな」",
   "ko_candidate": "「불의를 찌르려 했겠지만 어림없었어」"
  },
  {
   "id": 38956,
   "key": "D1410ru.txt:342",
   "file": "D1410ru.txt",
   "line": 342,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「かくれんぼは俺の勝ちつーことで」",
