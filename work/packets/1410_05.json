   "key": "D1410ru.txt:405",
   "file": "D1410ru.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何もないはずの空間が爆発する。",
   "ko_candidate": "아무것도 없어야 할 공간이 폭발한다｡"
  }
