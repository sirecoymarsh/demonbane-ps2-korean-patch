  "hit": 92,
  "total": 121,
  "rate": 0.76
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {},
 "items": [
  {
   "id": 14982,
   "key": "D0809le.txt:275",
   "file": "D0809le.txt",
   "line": 275,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬおああああああ!?」",
   "ko_candidate": "「우와아아아아아!?」"
  },
  {
   "id": 14983,
   "key": "D0809le.txt:284",
   "file": "D0809le.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "案の定、ガソリンに引火して爆発した。",
   "ko_candidate": "예상대로､ 가솔린에 불이 붙어 폭발했다｡"
  },
  {
   "id": 14984,
   "key": "D0809le.txt:286",
   "file": "D0809le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆風に巻き込まれる。",
   "ko_candidate": "폭풍에 휘말린다｡"
  },
  {
   "id": 14985,
   "key": "D0809le.txt:291",
   "file": "D0809le.txt",
   "line": 291,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ニィィィッ！」",
   "ko_candidate": "「니이이잇!」"
  },
  {
   "id": 14986,
   "key": "D0809le.txt:301",
   "file": "D0809le.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緩やかな、華麗ですらある動きで、照準を定める。",
   "ko_candidate": "느릿하고､ 우아하기까지 한 움직임으로､ 조준한다｡"
  },
  {
   "id": 14987,
   "key": "D0809le.txt:305",
   "file": "D0809le.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声。",
   "ko_candidate": "총성｡"
  },
  {
   "id": 14988,
   "key": "D0809le.txt:307",
   "file": "D0809le.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眉間を穿つ弾痕。それを中心に蜘蛛の巣状に拡がる罅。",
   "ko_candidate": "미간을 뚫는 탄흔｡ 그걸 중심으로 거미줄처럼 퍼지는 균열｡"
  },
  {
   "id": 14989,
   "key": "D0809le.txt:312",
   "file": "D0809le.txt",
   "line": 312,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「!?」",
   "ko_candidate": "「!?」"
  },
  {
   "id": 14990,
   "key": "D0809le.txt:328",
   "file": "D0809le.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鏡が砕け散った。",
   "ko_candidate": "거울이 산산조각 났다｡"
  },
  {
   "id": 14991,
   "key": "D0809le.txt:330",
   "file": "D0809le.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それで脱獄囚は、撃ったのが俺の幻像であると気付いたようだ。",
   "ko_candidate": "그걸로 탈옥수는､ 쏜 것이 내 환영이었다는 걸 깨달은 것 같다｡"
  },
  {
   "id": 14992,
   "key": "D0809le.txt:332",
   "file": "D0809le.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕けた鏡は破片の雨となって、脱獄囚に降り注ぐ。",
   "ko_candidate": "깨진 거울은 파편의 비가 되어､ 탈옥수에게 쏟아진다｡"
  },
  {
   "id": 14993,
   "key": "D0809le.txt:337",
   "file": "D0809le.txt",
   "line": 337,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「停っ！」",
   "ko_candidate": "「정지!」"
  },
  {
   "id": 14994,
   "key": "D0809le.txt:341",
   "file": "D0809le.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発的に迸る鬼迫。",
   "ko_candidate": "폭발적으로 솟구치는 귀박｡"
  },
  {
   "id": 14995,
   "key": "D0809le.txt:342",
   "file": "D0809le.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鏡の破片は、脱獄囚に触れる直前で、宙に停止した。",
   "ko_candidate": "거울 파편은､ 탈옥수에게 닿기 직전에､ 공중에서 멈췄다｡"
  },
  {
   "id": 14996,
   "key": "D0809le.txt:347",
   "file": "D0809le.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脱獄囚が指を鳴らす。",
   "ko_candidate": "탈옥수가 손가락을 튕긴다｡"
  },
  {
   "id": 14997,
   "key": "D0809le.txt:348",
   "file": "D0809le.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全ての破片が、地面に落ちた。",
   "ko_candidate": "모든 파편이 땅에 떨어졌다｡"
  },
  {
   "id": 14998,
   "key": "D0809le.txt:350",
   "file": "D0809le.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脱獄囚は顔を上げて、こっちを――電柱の上に逃げていた俺を見る。",
   "ko_candidate": "탈옥수는 고개를 들어､ 이쪽을――전신주 위로 도망간 나를 본다｡"
  },
  {
   "id": 14999,
   "key": "D0809le.txt:351",
   "file": "D0809le.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしてもカラスがやって来る。俺の肩に止まり、耳元で囁く。",
   "ko_candidate": "또다시 까마귀가 날아온다｡ 내 어깨에 앉아 귓가에 속삭인다｡"
  },
  {
   "id": 15000,
   "key": "D0809le.txt:355",
   "file": "D0809le.txt",
   "line": 355,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「面白いものを見させてもらったよ」",
   "ko_candidate": "「재미있는 걸 보여줬구나」"
  },
  {
   "id": 15001,
   "key": "D0809le.txt:359",
   "file": "D0809le.txt",
   "line": 359,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそ……っ」",
   "ko_candidate": "「젠장…」"
  },
  {
   "id": 15002,
   "key": "D0809le.txt:364",
   "file": "D0809le.txt",
   "line": 364,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度はこっちの番だね」",
   "ko_candidate": "「이번엔 이쪽 차례네」"
  },
  {
   "id": 15003,
   "key": "D0809le.txt:370",
   "file": "D0809le.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カラスが翔び立つ。",
   "ko_candidate": "까마귀가 날아오른다｡"
  },
  {
   "id": 15004,
   "key": "D0809le.txt:378",
   "file": "D0809le.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――脱獄囚の左手に銀色の輝き。",
   "ko_candidate": "그리고――탈옥수의 왼손에 은색 광채｡"
  },
  {
   "id": 15005,
   "key": "D0809le.txt:379",
   "file": "D0809le.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右手に持つ黒と赤の自動拳銃とは対照的な、銀色の回転式拳銃。",
   "ko_candidate": "오른손에 든 검은색과 빨간색 자동 권총과는 대조적인､ 은색의 회전식 권총｡"
  },
  {
   "id": 15006,
   "key": "D0809le.txt:384",
   "file": "D0809le.txt",
   "line": 384,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まだあるのか!?」",
   "ko_candidate": "「아직도 있는 건가!?」"
  },
  {
   "id": 15007,
   "key": "D0809le.txt:389",
   "file": "D0809le.txt",
   "line": 389,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「殺」",
   "ko_candidate": "「살」"
  },
  {
   "id": 15008,
   "key": "D0809le.txt:392",
   "file": "D0809le.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さり気なく銃口を向け、何気なく撃つ。",
   "ko_candidate": "무심히 총구를 겨누고､ 아무 생각 없이 쏜다｡"
  },
  {
   "id": 15009,
   "key": "D0809le.txt:396",
   "file": "D0809le.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "６発の銃声。",
   "ko_candidate": "6발의 총성｡"
  },
  {
   "id": 15010,
   "key": "D0809le.txt:397",
   "file": "D0809le.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まとめて、撃ってきた。",
   "ko_candidate": "한꺼번에 쏘아댔다｡"
  },
  {
   "id": 15011,
   "key": "D0809le.txt:405",
   "file": "D0809le.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・ウイングを広げて、電柱から翔び立つ。",
   "ko_candidate": "마기우스 윙을 펼치고､ 전신주에서 날아오른다｡"
  },
  {
   "id": 15012,
   "key": "D0809le.txt:407",
   "file": "D0809le.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足元を弾丸が掠めていった。",
   "ko_candidate": "발밑을 총알이 스쳐 지나갔다｡"
  },
  {
   "id": 15013,
   "key": "D0809le.txt:408",
   "file": "D0809le.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 15014,
   "key": "D0809le.txt:410",
   "file": "D0809le.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背中を貫く、鋭く冷たい殺意。",
   "ko_candidate": "등을 꿰뚫는､ 날카롭고 차가운 살의｡"
  },
  {
   "id": 15015,
   "key": "D0809le.txt:411",
   "file": "D0809le.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血が凍りつくような悪寒。",
   "ko_candidate": "피가 얼어붙을 듯한 오한｡"
  },
  {
   "id": 15016,
   "key": "D0809le.txt:412",
   "file": "D0809le.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か……何かある！",
   "ko_candidate": "뭔가… 뭔가 있어!"
  },
  {
   "id": 15017,
   "key": "D0809le.txt:417",
   "file": "D0809le.txt",
   "line": 417,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ!?」",
   "ko_candidate": "「뭐!?」"
  },
  {
   "id": 15018,
   "key": "D0809le.txt:421",
   "file": "D0809le.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り向き、信じられないものを見る。",
   "ko_candidate": "돌아보니､ 믿을 수 없는 것을 본다｡"
  },
  {
   "id": 15019,
   "key": "D0809le.txt:425",
   "file": "D0809le.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通り過ぎたはずの６発の弾丸。",
   "ko_candidate": "지나갔을 터인 6발의 총알｡"
  },
  {
   "id": 15020,
   "key": "D0809le.txt:427",
   "file": "D0809le.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "Ｕの字を描き、再びこっちに向かってくる！",
   "ko_candidate": "U자를 그리며､ 다시 이쪽으로 향해 온다!"
  },
  {
   "id": 15021,
   "key": "D0809le.txt:430",
   "file": "D0809le.txt",
   "line": 430,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何だこりゃあああああ!?」",
   "ko_candidate": "「이게 뭐야아아아아아!?」"
  }
 ]
}