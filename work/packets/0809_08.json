 },
 "items": [
  {
   "id": 14662,
   "key": "D0809al.txt:1538",
   "file": "D0809al.txt",
   "line": 1538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸から血をダラダラ流しながら、立ち上がる。",
   "ko_candidate": "가슴에서 피를 줄줄 흘리면서､ 일어선다｡"
  },
  {
   "id": 14663,
   "key": "D0809al.txt:1539",
   "file": "D0809al.txt",
   "line": 1539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膝が完全に笑っていた。立つのがやっとだった。",
   "ko_candidate": "무릎이 완전히 웃고 있었다｡ 겨우 서 있을 수 있었다｡"
  },
  {
   "id": 14664,
   "key": "D0809al.txt:1541",
   "file": "D0809al.txt",
   "line": 1541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くっ……意識が遠い。",
   "ko_candidate": "크… 의식이 멀어진다｡"
  },
  {
   "id": 14665,
   "key": "D0809al.txt:1542",
   "file": "D0809al.txt",
   "line": 1542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今にも気を失いそうだ。",
   "ko_candidate": "지금이라도 정신을 잃을 것 같다｡"
  },
  {
   "id": 14666,
   "key": "D0809al.txt:1543",
   "file": "D0809al.txt",
   "line": 1543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、ここで倒れるワケにはいかない……！",
   "ko_candidate": "하지만､ 여기서 쓰러질 수는 없어…!"
  },
  {
   "id": 14667,
   "key": "D0809al.txt:1550",
   "file": "D0809al.txt",
   "line": 1550,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何だよ……今ので死なねーのかよ」",
   "ko_candidate": "「무슨 일이야……이걸로 죽지 않는 건가」"
  },
  {
   "id": 14668,
   "key": "D0809al.txt:1553",
   "file": "D0809al.txt",
   "line": 1553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ボヤきながら、クラウディウスが屋上に降り立つ。",
   "ko_candidate": "작게 중얼거리며､ 클라우디우스가 옥상에 내려선다｡"
  },
  {
   "id": 14669,
   "key": "D0809al.txt:1554",
   "file": "D0809al.txt",
   "line": 1554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同様にカリグラも、ビルの壁面を蹴りながら、屋上まで跳躍してきた。",
   "ko_candidate": "마찬가지로 칼리굴라도､ 빌딩 벽면을 차며､ 옥상까지 뛰어올랐다｡"
  },
  {
   "id": 14670,
   "key": "D0809al.txt:1559",
   "file": "D0809al.txt",
   "line": 1559,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だがマトモには動けまイ。今のうちにトドメを刺す」",
   "ko_candidate": "「하지만 제대로는 움직이지 못할 거야｡ 지금이 기회에 마지막 일격을 가하자」"
  },
  {
   "id": 14671,
   "key": "D0809al.txt:1563",
   "file": "D0809al.txt",
   "line": 1563,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラは拳を固める。",
   "ko_candidate": "칼리굴라는 주먹을 굳힌다｡"
  },
  {
   "id": 14672,
   "key": "D0809al.txt:1564",
   "file": "D0809al.txt",
   "line": 1564,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそっ……マジにヤベぇ……。",
   "ko_candidate": "젠장……진짜로 위험해……。"
  },
  {
   "id": 14673,
   "key": "D0809al.txt:1570",
   "file": "D0809al.txt",
   "line": 1570,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・ウィングを再生させ、重ね合わせ盾にする――が、正直、こんなもんじゃ連中の攻撃を防ぎ切れない。",
   "ko_candidate": "마기우스 윙을 재생시켜､ 겹쳐 방패로 만든다――하지만､ 솔직히､ 이런 걸로는 놈들의 공격을 막아내지 못할 거다｡"
  },
  {
   "id": 14674,
   "key": "D0809al.txt:1570",
   "file": "D0809al.txt",
   "line": 1570,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か……何か手はないのか!?",
   "ko_candidate": "뭔가……뭔가 방법은 없는 건가!?"
  },
  {
   "id": 14675,
   "key": "D0809al.txt:1575",
   "file": "D0809al.txt",
   "line": 1575,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「死ネ！」",
   "ko_candidate": "「죽어라!」"
  },
  {
   "id": 14676,
   "key": "D0809al.txt:1581",
   "file": "D0809al.txt",
   "line": 1581,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「バイバーイ。逝ってらっしゃーいっ」",
   "ko_candidate": "「바이바이｡ 잘 가~」"
  },
  {
   "id": 14677,
   "key": "D0809al.txt:1586",
   "file": "D0809al.txt",
   "line": 1586,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クソッタレェェェェェェェ――――ッ！」",
   "ko_candidate": "「빌어먹으으으을――――!」"
  },
  {
   "id": 14678,
   "key": "D0809al.txt:1591",
   "file": "D0809al.txt",
   "line": 1591,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎っっっっ！」",
   "ko_candidate": "「쿠로오오오오!」"
  },
  {
   "id": 14679,
   "key": "D0809al.txt:1613",
   "file": "D0809al.txt",
   "line": 1613,
   "speaker": "九郎＆アル＆クラウディウス＆カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 14680,
   "key": "D0809al.txt:1615",
   "file": "D0809al.txt",
   "line": 1615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは一瞬の出来事だった。",
   "ko_candidate": "그것은 일순간의 사건이었다｡"
  },
  {
   "id": 14681,
   "key": "D0809al.txt:1616",
   "file": "D0809al.txt",
   "line": 1616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺を取り囲むように吹き荒れる魔導書のページ。",
   "ko_candidate": "나를 둘러싸듯이 휘몰아치는 마도서의 페이지｡"
  },
  {
   "id": 14682,
   "key": "D0809al.txt:1617",
   "file": "D0809al.txt",
   "line": 1617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "放たれたカリグラの爆砕拳を、クラウディウスのカマイタチをいとも容易く、弾き返す――！",
   "ko_candidate": "날아오는 칼리굴라의 폭쇄권을､ 클라우디우스의 카마이타치를 아주 쉽게､ 튕겨낸다――!"
  },
  {
   "id": 14683,
   "key": "D0809al.txt:1620",
   "file": "D0809al.txt",
   "line": 1620,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な――」",
   "ko_candidate": "「뭐――」"
  },
  {
   "id": 14684,
   "key": "D0809al.txt:1625",
   "file": "D0809al.txt",
   "line": 1625,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何……!?」",
   "ko_candidate": "「뭐……!?」"
  },
  {
   "id": 14685,
   "key": "D0809al.txt:1631",
   "file": "D0809al.txt",
   "line": 1631,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だってッ!?」",
   "ko_candidate": "「뭐라고옷!?」"
  },
  {
   "id": 14686,
   "key": "D0809al.txt:1637",
   "file": "D0809al.txt",
   "line": 1637,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なんダと!?」",
   "ko_candidate": "「뭐라고!?」"
  },
  {
   "id": 14687,
   "key": "D0809al.txt:1643",
   "file": "D0809al.txt",
   "line": 1643,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の目の前で、渦を巻く魔導書の頁。",
   "ko_candidate": "내 눈앞에서､ 소용돌이치는 마도서의 페이지｡"
  },
  {
   "id": 14688,
   "key": "D0809al.txt:1644",
   "file": "D0809al.txt",
   "line": 1644,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜巻の如く回転しながら、濃度を増してゆく。",
   "ko_candidate": "회오리바람처럼 회전하면서､ 농도를 더해간다｡"
  },
  {
   "id": 14689,
   "key": "D0809al.txt:1645",
   "file": "D0809al.txt",
   "line": 1645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "折り重なり、束ねられながら、容を創り上げる。",
   "ko_candidate": "겹치고､ 묶이면서､ 형태를 만들어간다｡"
  },
  {
   "id": 14690,
   "key": "D0809al.txt:1648",
   "file": "D0809al.txt",
   "line": 1648,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――っ」",
   "ko_candidate": "「――――」"
  },
  {
   "id": 14691,
   "key": "D0809al.txt:1650",
   "file": "D0809al.txt",
   "line": 1650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソレは、ヒトの容だった。",
   "ko_candidate": "그것은､ 사람의 형태였다｡"
  },
  {
   "id": 14692,
   "key": "D0809al.txt:1651",
   "file": "D0809al.txt",
   "line": 1651,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "背丈はアルよりやや高いくらいか、 小柄なヒト型の『本』だった。",
   "ko_candidate": "키는 알보다 약간 더 큰 정도인가､ 소년 같기도 소녀 같기도 한､ 작은 인간형의 『책』이었다｡"
  },
  {
   "id": 14693,
   "key": "D0809al.txt:1655",
   "file": "D0809al.txt",
   "line": 1655,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "四肢を全身に纏わりつく紙片によって、拘束されているようにも見える。",
   "ko_candidate": "사지를､ 온몸을 감싸는 종이 조각으로､ 구속되어 있는 것처럼 보인다｡"
  },
  {
   "id": 14694,
   "key": "D0809al.txt:1656",
   "file": "D0809al.txt",
   "line": 1656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まるでミイラ男だな、と思った。",
   "ko_candidate": "마치 미라 남자 같군､ 이라고 생각했다｡"
  },
  {
   "id": 14695,
   "key": "D0809al.txt:1664",
   "file": "D0809al.txt",
   "line": 1664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――衝撃が弾けた。",
   "ko_candidate": "――충격이 터졌다｡"
  },
  {
   "id": 14696,
   "key": "D0809al.txt:1670",
   "file": "D0809al.txt",
   "line": 1670,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「つぅあぁ……ッ！」",
   "ko_candidate": "「츠아아……!」 「누누우!」"
  },
  {
   "id": 14697,
   "key": "D0809al.txt:1674",
   "file": "D0809al.txt",
   "line": 1674,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヌヌゥ！」",
   "ko_candidate": "「치……!」"
  },
  {
   "id": 14698,
   "key": "D0809al.txt:1679",
   "file": "D0809al.txt",
   "line": 1679,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チッ……！」 黒翼が俺の躰を衝撃から守る。",
   "ko_candidate": "검은 날개가 내 몸을 충격으로부터 지킨다｡"
  },
  {
   "id": 14699,
   "key": "D0809al.txt:1685",
   "file": "D0809al.txt",
   "line": 1685,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アンチクロスの２人は、ミイラ男から迸る魔力に撃たれて怯んだ。",
   "ko_candidate": "안티 크로스의 2명은､ 미라 남자에게서 뿜어져 나오는 마력에 맞아 주춤했다｡"
  },
  {
   "id": 14700,
   "key": "D0809al.txt:1686",
   "file": "D0809al.txt",
   "line": 1686,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "４対の視線が一点に集中する。",
   "ko_candidate": "4개의 시선이 한 점에 집중된다｡"
  },
  {
   "id": 14701,
   "key": "D0809al.txt:1688",
   "file": "D0809al.txt",
   "line": 1688,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数枚の紙片が、花びらのように舞っている。",
   "ko_candidate": "몇 장의 종이 조각이､ 꽃잎처럼 춤추고 있다｡"
  }
 ]
}