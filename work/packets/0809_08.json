 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "クラウディウス": "클라우디우스",
  "カリグラ": "칼리굴라",
  "マギウス・ウィング": "마기우스 윙",
  "九郎": "쿠로",
  "魔導書": "마도서",
