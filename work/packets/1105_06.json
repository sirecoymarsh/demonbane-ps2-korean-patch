 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "大十字九郎": "다이쥬지 쿠로",
  "ブラックロッジ": "블랙로지",
  "ジョージ": "조지",
  "コリン": "콜린",
  "九郎": "쿠로",
  "九郎ちゃん": "쿠로 군"
 },
 "items": [
  {
   "id": 23835,
   "key": "D1105le.txt:413",
   "file": "D1105le.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悩んでいる俺を見て、ライカさんが呆れた風に溜息をついた。",
   "ko_candidate": "고민하는 나를 보고､ 라이카 씨가 어이없다는 듯이 한숨을 쉬었다｡"
  },
  {
   "id": 23836,
   "key": "D1105le.txt:414",
   "file": "D1105le.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてまた、穏やかに語り始める。",
   "ko_candidate": "그리고 또､ 차분히 말하기 시작한다｡"
  },
  {
   "id": 23837,
   "key": "D1105le.txt:420",
   "file": "D1105le.txt",
   "line": 420,
   "speaker": "ライカ / ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ほらぁ……知り合ってから何週間か経ったときのこと」 「とぉー！　いくぞ、ブラックロッジのてさき、大十字九郎めっ！」",
   "ko_candidate": "「봐요……알게 된 지 몇 주 지났을 때의 일」"
  },
  {
   "id": 23838,
   "key": "D1105le.txt:436",
   "file": "D1105le.txt",
   "line": 436,
   "speaker": "ジョージ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「せいぎのてっついをうけるがいいー！　メタトロンキッークっ」 「ぐぼぁあっ！」",
   "ko_candidate": "「토오! 간다､ 블랙로지의 앞잡이､ 다이쥬지 쿠로 녀석! 정의의 철퇴를 받아라! 메타트론 킥!」"
  },
  {
   "id": 23839,
   "key": "D1105le.txt:444",
   "file": "D1105le.txt",
   "line": 444,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あはははははー！ やれやれー！」",
   "ko_candidate": "「구보아앗!」 「아하하하하! 어이쿠!」"
  },
  {
   "id": 23840,
   "key": "D1105le.txt:449",
   "file": "D1105le.txt",
   "line": 449,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「とどめだっ！　てんてい・しんぱつけーんっ！」",
   "ko_candidate": "「마지막이다! 천제?신벌권!」"
  },
  {
   "id": 23841,
   "key": "D1105le.txt:453",
   "file": "D1105le.txt",
   "line": 453,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぎゃああああっ!?　血が！　血がぁぁぁ！ が、ガキんちょ！　てめえ、鉄パイプで叩きやがったな!? 殺る気か!?　殺る気なんだな、おいっ！」",
   "ko_candidate": "「구규아아아앗!? 피가! 피가아아! 이､ 가키! 네 녀석､ 쇠파이프로 때렸지!? 죽일 셈이야!? 죽일 셈이지､ 이 녀석!」"
  },
  {
   "id": 23842,
   "key": "D1105le.txt:461",
   "file": "D1105le.txt",
   "line": 461,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あらあらあら。 もうすっかりと打ち解けてしまって」",
   "ko_candidate": "「어머어머어머｡ 벌써 완전히 친해져 버렸네」"
  },
  {
   "id": 23843,
   "key": "D1105le.txt:466",
   "file": "D1105le.txt",
   "line": 466,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「この血に塗れた、殺伐とした状況を見て、そんな戯言を!?」",
   "ko_candidate": "「이 피투성이의､ 살벌한 상황을 보고 그런 농담을!」"
  },
  {
   "id": 23844,
   "key": "D1105le.txt:470",
   "file": "D1105le.txt",
   "line": 470,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じゅうじ・だんざーいっ」",
   "ko_candidate": "「십자?단죄!」 「카……츠앗……!」"
  },
  {
   "id": 23845,
   "key": "D1105le.txt:474",
   "file": "D1105le.txt",
   "line": 474,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「か……つぁッ……！」",
   "ko_candidate": "「해냈다! 악은､ 멸망했다!」"
  },
  {
   "id": 23846,
   "key": "D1105le.txt:482",
   "file": "D1105le.txt",
   "line": 482,
   "speaker": "コリン / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やったー。あくは、ほろびたーっ」 「お……面白ぇ……そっちがその気なら、殺られる前に殺ってやる……ッ！」",
   "ko_candidate": "「재……재밌어……그쪽이 그럴 생각이라면､ 죽기 전에 죽여 주마 ……!」"
  },
  {
   "id": 23847,
   "key": "D1105le.txt:495",
   "file": "D1105le.txt",
   "line": 495,
   "speaker": "九郎 / ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「通信教育で習った格闘術が火を噴くぜ！　カバラ何とかってやたら触手っぽいやつ」 「わーっ」",
   "ko_candidate": "「통신교육으로 배운 격투술이 불을 뿜는다! 카발라 뭐시기라고､ 유난히 외설한 거」"
  },
  {
   "id": 23848,
   "key": "D1105le.txt:504",
   "file": "D1105le.txt",
   "line": 504,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃーっ」",
   "ko_candidate": "「와악」 「꺄악」"
  },
  {
   "id": 23849,
   "key": "D1105le.txt:508",
   "file": "D1105le.txt",
   "line": 508,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マサムネ――――ッ！」",
   "ko_candidate": "「마사무네――――!」"
  },
  {
   "id": 23850,
   "key": "D1105le.txt:513",
   "file": "D1105le.txt",
   "line": 513,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「本当に仲良しさんねぇ～。お兄ちゃんに遊んでもらえて、良かったわねぇ～。ジョージ、コリン～」",
   "ko_candidate": "「정말 사이좋은 친구들이네~｡ 오빠랑 놀 수 있어서 다행이야~｡ 죠지､ 콜린~」"
  },
  {
   "id": 23851,
   "key": "D1105le.txt:520",
   "file": "D1105le.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このガキんちょども――ライカさんが引き取った孤児だ――が絡んできたのは、ライカさんと知り合ってすぐだった。",
   "ko_candidate": "이 꼬맹이들――라이카 씨가 데려온 고아들이다――이 얽혀든 건､ 라이카 씨와 알게 된 직후였다｡"
  },
  {
   "id": 23852,
   "key": "D1105le.txt:522",
   "file": "D1105le.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "よっぽど遊び相手に飢えていたのだろうか、実にパワフルに動き回る。お陰で俺は振り回されっぱなしだ。",
   "ko_candidate": "아주 놀이 상대에 굶주려 있었던 걸까､ 정말 파워풀하게 움직인다｡ 덕분에 나는 휘둘리기만 한다｡"
  },
  {
   "id": 23853,
   "key": "D1105le.txt:534",
   "file": "D1105le.txt",
   "line": 534,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はぁ……はぁ……あの餓鬼ども、まったく手加減しやがらねえ」",
   "ko_candidate": "「하아……하아……그 녀석들､ 전혀 봐주지 않는군」"
  },
  {
   "id": 23854,
   "key": "D1105le.txt:538",
   "file": "D1105le.txt",
   "line": 538,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お疲れ様ですぅ～。はい、お茶」",
   "ko_candidate": "「수고하셨어요~｡ 자､ 차」"
  },
  {
   "id": 23855,
   "key": "D1105le.txt:541",
   "file": "D1105le.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ようやくガキんちょどもから解放されて、一息つく。",
   "ko_candidate": "겨우 꼬맹이들에게서 해방되어 한숨 돌린다｡"
  },
  {
   "id": 23856,
   "key": "D1105le.txt:542",
   "file": "D1105le.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "淹れてもらった紅茶を啜っていると、ライカさんはクスクスと笑い出す。",
   "ko_candidate": "내려준 홍차를 마시고 있으니､ 라이카 씨가 키득키득 웃기 시작한다｡"
  },
  {
   "id": 23857,
   "key": "D1105le.txt:542",
   "file": "D1105le.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何だか分からないが、気持ちの良いものではない。",
   "ko_candidate": "뭔지 모르겠지만､ 기분 좋은 것은 아니다｡"
  },
  {
   "id": 23858,
   "key": "D1105le.txt:545",
   "file": "D1105le.txt",
   "line": 545,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……なに？」",
   "ko_candidate": "「……뭐야?」"
  },
  {
   "id": 23859,
   "key": "D1105le.txt:549",
   "file": "D1105le.txt",
   "line": 549,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いえいえ～。ジョージやコリンと遊んでいるところ見てると、何だか九郎さんも子どもみたいだな～と思って」",
   "ko_candidate": "「아니에요~｡ 죠지랑 콜린이랑 노는 모습을 보니까､ 뭔가 쿠로 씨도 어린애 같다나~하고 생각해서」"
  },
  {
   "id": 23860,
   "key": "D1105le.txt:553",
   "file": "D1105le.txt",
   "line": 553,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……悪かったね」",
   "ko_candidate": "「……미안하네」"
  },
  {
   "id": 23861,
   "key": "D1105le.txt:555",
   "file": "D1105le.txt",
   "line": 555,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憮然として、顔を背ける。",
   "ko_candidate": "불퉁하게 얼굴을 돌린다｡"
  },
  {
   "id": 23862,
   "key": "D1105le.txt:556",
   "file": "D1105le.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな俺の様子に、ライカさんはまた笑う。",
   "ko_candidate": "그런 내 모습에 라이카 씨는 또 웃는다｡"
  },
  {
   "id": 23863,
   "key": "D1105le.txt:560",
   "file": "D1105le.txt",
   "line": 560,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うふふ……本当、大きな子どもみたい」 「ほらほら～、ごめんなさいー。お姉ちゃんが悪かったよー。機嫌直そうね、九郎ちゃーん」",
   "ko_candidate": "「후후……정말､ 큰 아이 같아｡ 자자~ 미안해요~｡ 누나가 잘못했어요~｡ 기분 풀자､ 쿠로 군~」"
  },
  {
   "id": 23864,
   "key": "D1105le.txt:567",
   "file": "D1105le.txt",
   "line": 567,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『ちゃん』言うなっ！」",
   "ko_candidate": "「'군'이라고 하지 마!」"
  },
  {
   "id": 23865,
   "key": "D1105le.txt:569",
   "file": "D1105le.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "明らかにからかわれていた。",
   "ko_candidate": "명백히 놀림을 당하고 있었다｡"
  },
  {
   "id": 23866,
   "key": "D1105le.txt:575",
   "file": "D1105le.txt",
   "line": 575,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……でも、そんなだから、あの２人も懐くんですね。何と言うか……九郎さん、本気だし」",
   "ko_candidate": "「……하지만､ 그래서 그 둘도 따르는 거예요｡ 뭐랄까……쿠로 씨､ 진심이니까요」"
  },
  {
   "id": 23867,
   "key": "D1105le.txt:579",
   "file": "D1105le.txt",
   "line": 579,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それは結局、俺が大人気ないということか」",
   "ko_candidate": "「그건 결국､ 내가 어른답지 못하다는 거냐」"
  },
  {
   "id": 23868,
   "key": "D1105le.txt:583",
   "file": "D1105le.txt",
   "line": 583,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あーあ、本当にむくれちゃったっ。これでも感謝しているんですよぉ。 あの子たち、ああ見えて人見知りする方ですから」",
   "ko_candidate": "「아아､ 정말로 삐졌네｡ 이래도 감사하고 있다고요｡ 그 아이들､ 저렇게 보여도 낯을 가리는 편이거든요」"
  },
  {
   "id": 23869,
   "key": "D1105le.txt:587",
   "file": "D1105le.txt",
   "line": 587,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どこがっ!?」",
   "ko_candidate": "「어디가!」"
  },
  {
   "id": 23870,
   "key": "D1105le.txt:591",
   "file": "D1105le.txt",
   "line": 591,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから、九郎ちゃんが相手だから、なんですよ。あの子たち、大人の嘘には敏感です。その……２人とも、孤児だったから」",
   "ko_candidate": "「그러니까､ 쿠로가 상대라서､ 그런 거예요｡ 그 아이들､ 어른들의 거짓말에는 민감해요｡ 그……둘 다､ 고아였으니까」"
  },
  {
   "id": 23871,
   "key": "D1105le.txt:595",
   "file": "D1105le.txt",
   "line": 595,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 23872,
   "key": "D1105le.txt:597",
   "file": "D1105le.txt",
   "line": 597,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……しんみりとしてしまった。",
   "ko_candidate": "……숙연해져 버렸다｡"
  },
  {
   "id": 23873,
   "key": "D1105le.txt:598",
   "file": "D1105le.txt",
   "line": 598,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少し気まずくなって、黙ってしまう。",
   "ko_candidate": "조금 어색해져서､ 말을 잃어버린다｡"
  },
  {
   "id": 23874,
   "key": "D1105le.txt:600",
   "file": "D1105le.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんは窓の外に目を向けた。俺も何となく釣られて、外を見る。",
   "ko_candidate": "라이카 씨는 창밖으로 시선을 돌렸다｡ 나도 왠지 모르게 따라서 밖을 본다｡"
  }
 ]
}