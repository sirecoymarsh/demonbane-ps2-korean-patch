{
 "packet": "1207_04",
 "scene": "1207",
 "anchor": {
  "hit": 50,
  "total": 51,
  "rate": 0.98
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "メタトロン": "메타트론",
  "サンダルフォン": "산달폰",
  "アリスン": "앨리슨"
 },
 "items": [
  {
   "id": 28147,
   "key": "D1207le.txt:172",
   "file": "D1207le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰の目にも明らかな怪異が起こった。",
   "ko_candidate": "누구의 눈에도 분명한 괴이가 일어났다｡"
  },
  {
   "id": 28148,
   "key": "D1207le.txt:177",
   "file": "D1207le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇。",
   "ko_candidate": "어둠｡"
  },
  {
   "id": 28149,
   "key": "D1207le.txt:178",
   "file": "D1207le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "靄の様な闇が、青年の躰へと集まっている。",
   "ko_candidate": "안개 같은 어둠이､ 청년의 몸으로 모여들고 있다｡"
  },
  {
   "id": 28150,
   "key": "D1207le.txt:180",
   "file": "D1207le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が青年に纏わりつく。",
   "ko_candidate": "어둠이 청년에게 휘감긴다｡"
  },
  {
   "id": 28151,
   "key": "D1207le.txt:181",
   "file": "D1207le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒く、黒く、青年を塗り潰す。",
   "ko_candidate": "검게､ 검게､ 청년을 칠해나간다｡"
  },
  {
   "id": 28152,
   "key": "D1207le.txt:183",
   "file": "D1207le.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "子ども達はその只中で、その怪異を黙って見つめているだけだった。",
   "ko_candidate": "아이들은 그 한가운데서､ 그 괴이를 말없이 바라보고만 있었다｡"
  },
  {
   "id": 28153,
   "key": "D1207le.txt:184",
   "file": "D1207le.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何の言葉も、声も、悲鳴さえ形にならない。",
   "ko_candidate": "어떤 말도､ 소리도､ 비명조차 형태를 이루지 못한다｡"
  },
  {
   "id": 28154,
   "key": "D1207le.txt:188",
   "file": "D1207le.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の中で、青年の眸と、傷痕だけが輝いている。",
   "ko_candidate": "어둠 속에서､ 청년의 눈동자와､ 상처만이 빛나고 있다｡"
  },
  {
   "id": 28155,
   "key": "D1207le.txt:189",
   "file": "D1207le.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憎悪の彩に。血の彩に。",
   "ko_candidate": "증오의 색채로｡ 피의 색채로｡"
  },
  {
   "id": 28156,
   "key": "D1207le.txt:190",
   "file": "D1207le.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が、結晶する。",
   "ko_candidate": "어둠이､ 결정화된다｡"
  },
  {
   "id": 28157,
   "key": "D1207le.txt:195",
   "file": "D1207le.txt",
   "line": 195,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――変神」",
   "ko_candidate": "「――변신」"
  },
  {
   "id": 28158,
   "key": "D1207le.txt:201",
   "file": "D1207le.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "靄の様な闇が、確かな実体を結ぶ。",
   "ko_candidate": "안개 같은 어둠이､ 확실한 실체를 이룬다｡"
  },
  {
   "id": 28159,
   "key": "D1207le.txt:202",
   "file": "D1207le.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を包む黒い装甲。",
   "ko_candidate": "전신을 감싸는 검은 갑옷｡"
  },
  {
   "id": 28160,
   "key": "D1207le.txt:203",
   "file": "D1207le.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背中から迫り出す、黒い機械の翼。",
   "ko_candidate": "등에서 뻗어 나오는､ 검은 기계의 날개｡"
  },
  {
   "id": 28161,
   "key": "D1207le.txt:205",
   "file": "D1207le.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い仮面。",
   "ko_candidate": "검은 가면｡"
  },
  {
   "id": 28162,
   "key": "D1207le.txt:206",
   "file": "D1207le.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "黒いメタトロン。",
   "ko_candidate": "검은 메타트론｡ 산달폰｡"
  },
  {
   "id": 28163,
   "key": "D1207le.txt:207",
   "file": "D1207le.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォン。 既に何度かメタトロンとの交戦が確認されているので、サンダルフォンの姿は街の住人に知れ渡っていた。",
   "ko_candidate": "이미 여러 차례 메타트론과의 교전이 확인되었기 때문에､ 산달폰의 모습은 거리의 주민들에게 알려져 있었다｡"
  },
  {
   "id": 28164,
   "key": "D1207le.txt:216",
   "file": "D1207le.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "特にアリスンは、かつてこの黒天使を目の当たりにしている。",
   "ko_candidate": "특히 앨리슨은､ 과거에 이 검은 천사를 직접 목격한 적이 있다｡"
  },
  {
   "id": 28165,
   "key": "D1207le.txt:221",
   "file": "D1207le.txt",
   "line": 221,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、そんな……兄ちゃんが、ワルモノの天使!?」",
   "ko_candidate": "「그､ 그런…… 오빠가､ 나쁜 천사였어!?」"
  },
  {
   "id": 28166,
   "key": "D1207le.txt:228",
   "file": "D1207le.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞬く間に避難所は恐慌状態に陥った。",
   "ko_candidate": "순식간에 대피소는 공황 상태에 빠졌다｡"
  },
  {
   "id": 28167,
   "key": "D1207le.txt:229",
   "file": "D1207le.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "他人を押しのけ、踏みつけながら、我先にと出口に殺到する。",
   "ko_candidate": "다른 사람을 밀치고､ 밟으면서､ 앞다투어 출구로 몰려간다｡"
  },
  {
   "id": 28168,
   "key": "D1207le.txt:231",
   "file": "D1207le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避難所を護ってた警備兵達が、サンダルフォンの前に出ようとするが、人の波に呑まれて、なかなか身動きが取れない。",
   "ko_candidate": "대피소를 지키던 경비병들이､ 산달폰 앞에 나서려 하지만､ 사람들의 물결에 휩쓸려､ 좀처럼 몸을 움직일 수 없다｡"
  },
  {
   "id": 28169,
   "key": "D1207le.txt:235",
   "file": "D1207le.txt",
   "line": 235,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「煩い連中だ。苛つくな」",
   "ko_candidate": "「시끄러운 놈들이군｡ 짜증 나는군」"
  },
  {
   "id": 28170,
   "key": "D1207le.txt:240",
   "file": "D1207le.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳を脇に添えるようにして、構える。",
   "ko_candidate": "주먹을 옆구리에 붙이듯이 하여､ 자세를 잡는다"
  },
  {
   "id": 28171,
   "key": "D1207le.txt:242",
   "file": "D1207le.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気が鳴動する。",
   "ko_candidate": "대기가 울린다｡"
  },
  {
   "id": 28172,
   "key": "D1207le.txt:243",
   "file": "D1207le.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大きな力が、サンダルフォンへと流れ込む――そんな気配をアリスンは察知していた。",
   "ko_candidate": "거대한 힘이､ 산달폰에게 흘러 들어간다―― 그런 기척을 앨리슨은 감지하고 있었다｡"
  },
  {
   "id": 28173,
   "key": "D1207le.txt:249",
   "file": "D1207le.txt",
   "line": 249,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だ、ダメぇぇぇぇぇぇぇぇぇぇぇぇ！」",
   "ko_candidate": "「안､ 안 돼에에에에에에에에에에에!」"
  },
  {
   "id": 28174,
   "key": "D1207le.txt:254",
   "file": "D1207le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンが一歩を踏み込んだ。",
   "ko_candidate": "산달폰이 한 걸음을 내디뎠다｡"
  },
  {
   "id": 28175,
   "key": "D1207le.txt:255",
   "file": "D1207le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避難所全体に響く足音。踏み込みに耐えられなかった床が大きく陥没する。",
   "ko_candidate": "대피소 전체에 울리는 발소리｡ 발을 내디딘 충격을 견디지 못한 바닥이 크게 함몰된다｡"
  },
  {
   "id": 28176,
   "key": "D1207le.txt:263",
   "file": "D1207le.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳を放つ。",
   "ko_candidate": "주먹을 날린다｡"
  },
  {
   "id": 28177,
   "key": "D1207le.txt:264",
   "file": "D1207le.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何もない中空を叩く拳。",
   "ko_candidate": "아무것도 없는 허공을 치는 주먹｡"
  },
  {
   "id": 28178,
   "key": "D1207le.txt:266",
   "file": "D1207le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊の波紋が、空気を媒介に伝播する。",
   "ko_candidate": "파괴의 파문이､ 공기를 매개로 전파된다｡"
  },
  {
   "id": 28179,
   "key": "D1207le.txt:267",
   "file": "D1207le.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸の如く疾走する。",
   "ko_candidate": "총알처럼 질주한다｡"
  },
  {
   "id": 28180,
   "key": "D1207le.txt:269",
   "file": "D1207le.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破裂音を引き連れて、出口に集中した住人の中心に吸い込まれる。",
   "ko_candidate": "파열음을 동반하며､ 출구에 집중된 주민들의 중심으로 빨려 들어간다｡"
  },
  {
   "id": 28181,
   "key": "D1207le.txt:277",
   "file": "D1207le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同心円状に崩壊が拡がっていく。",
   "ko_candidate": "동심원 모양으로 붕괴가 퍼져나간다｡"
  },
  {
   "id": 28182,
   "key": "D1207le.txt:278",
   "file": "D1207le.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ひしゃげ、潰れていく。",
   "ko_candidate": "찌그러지고､ 으스러진다｡"
  },
  {
   "id": 28183,
   "key": "D1207le.txt:279",
   "file": "D1207le.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "潰れて、千切れていく。",
   "ko_candidate": "으스러져서､ 찢겨나간다｡"
  },
  {
   "id": 28184,
   "key": "D1207le.txt:286",
   "file": "D1207le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅い華が咲く。",
   "ko_candidate": "붉은 꽃이 핀다｡"
  },
  {
   "id": 28185,
   "key": "D1207le.txt:287",
   "file": "D1207le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咲いて咲いて咲いて咲いて咲いて裂いて裂いて裂いて裂いて裂いて崩壊の大輪となって拡がる。",
   "ko_candidate": "피어나고 피어나고 피어나고 피어나고 피어나고 찢어지고 찢어지고 찢어지고 찢어지고 찢어져서 붕괴의 대륜이 되어 퍼져나간다｡"
  },
  {
   "id": 28186,
   "key": "D1207le.txt:289",
   "file": "D1207le.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "波紋が壁に天井に触れた。",
   "ko_candidate": "파문이 벽과 천장에 닿았다｡"
  }
 ]
}