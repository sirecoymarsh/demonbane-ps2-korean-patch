 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アリスン": "앨리슨",
  "ライカ": "라이카",
  "サンダルフォン": "산달폰",
  "ジョージ": "조지",
  "コリン": "콜린",
  "リューガ": "류가",
  "ティベリウス": "티베리우스"
 },
 "items": [
  {
   "id": 29338,
   "key": "D1210le.txt:683",
   "file": "D1210le.txt",
   "line": 683,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アリスン！　早くっ！」",
   "ko_candidate": "「앨리슨! 빨리!」"
  },
  {
   "id": 29339,
   "key": "D1210le.txt:686",
   "file": "D1210le.txt",
   "line": 686,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼びかける声に自分を取り戻し、ライカを引っ張って、サンダルフォンから離れようとする。",
   "ko_candidate": "부르는 소리에 정신을 차리고 라이카를 끌어당겨 산달폰에게서 멀어지려 한다｡"
  },
  {
   "id": 29340,
   "key": "D1210le.txt:688",
   "file": "D1210le.txt",
   "line": 688,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、アリスンの力では大人１人を動かすのは無理だ。",
   "ko_candidate": "하지만 앨리슨의 힘으로는 어른 한 명을 움직이는 것은 무리다｡"
  },
  {
   "id": 29341,
   "key": "D1210le.txt:693",
   "file": "D1210le.txt",
   "line": 693,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわああっ！　もうっ！」",
   "ko_candidate": "「우와아아! 정말!」"
  },
  {
   "id": 29342,
   "key": "D1210le.txt:696",
   "file": "D1210le.txt",
   "line": 696,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ジョージとコリンも駈けつけ、ライカの腕を肩に担ぐ。",
   "ko_candidate": "죠지와 콜린도 달려와 라이카의 팔을 어깨에 멘다｡"
  },
  {
   "id": 29343,
   "key": "D1210le.txt:698",
   "file": "D1210le.txt",
   "line": 698,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ライカを引きずりながら、少しずつ、もどかしい速度で、サンダルフォンから離れる。",
   "ko_candidate": "라이카를 끌면서 조금씩 답답한 속도로 산달폰에게서 멀어진다｡"
  },
  {
   "id": 29344,
   "key": "D1210le.txt:700",
   "file": "D1210le.txt",
   "line": 700,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩れて陥没した床のせいで、なおのこと進みづらい。",
   "ko_candidate": "무너져 함몰된 바닥 때문에 더욱 나아가기 힘들다｡"
  },
  {
   "id": 29345,
   "key": "D1210le.txt:705",
   "file": "D1210le.txt",
   "line": 705,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はやく……はやく……っ！」",
   "ko_candidate": "「빨리……빨리……!」"
  },
  {
   "id": 29346,
   "key": "D1210le.txt:710",
   "file": "D1210le.txt",
   "line": 710,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああああ！　ああああああ！　アアァ――――――――――！」",
   "ko_candidate": "「아아아! 아아아아아! 아아――――――――――!」"
  },
  {
   "id": 29347,
   "key": "D1210le.txt:713",
   "file": "D1210le.txt",
   "line": 713,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "激痛がリューガを苛む。",
   "ko_candidate": "격통이 류가를 괴롭힌다｡"
  },
  {
   "id": 29348,
   "key": "D1210le.txt:714",
   "file": "D1210le.txt",
   "line": 714,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームセイバーに裂かれた傷など、物の数ではない。",
   "ko_candidate": "빔 세이버에 찢긴 상처 따위는 아무것도 아니다｡"
  },
  {
   "id": 29349,
   "key": "D1210le.txt:716",
   "file": "D1210le.txt",
   "line": 716,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "堪え難いのは、気が触れそうなまでに荒れ狂う頭痛と、そして――右瞼の傷。",
   "ko_candidate": "견디기 힘든 건 미칠 것 같이 날뛰는 두통과､ 그리고―― 오른쪽 눈꺼풀의 상처｡"
  },
  {
   "id": 29350,
   "key": "D1210le.txt:718",
   "file": "D1210le.txt",
   "line": 718,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憎悪に駆逐された筈の記憶。",
   "ko_candidate": "증오에 의해 추방되었을 터인 기억｡"
  },
  {
   "id": 29351,
   "key": "D1210le.txt:719",
   "file": "D1210le.txt",
   "line": 719,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "封印された筈の記憶。",
   "ko_candidate": "봉인되었을 터인 기억｡"
  },
  {
   "id": 29352,
   "key": "D1210le.txt:720",
   "file": "D1210le.txt",
   "line": 720,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去が、リューガを苛む。",
   "ko_candidate": "과거가 류가를 괴롭힌다｡"
  },
  {
   "id": 29353,
   "key": "D1210le.txt:722",
   "file": "D1210le.txt",
   "line": 722,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛から逃れようと、狂ったように暴れる。",
   "ko_candidate": "고통에서 벗어나려고 미친 듯이 날뛴다｡"
  },
  {
   "id": 29354,
   "key": "D1210le.txt:723",
   "file": "D1210le.txt",
   "line": 723,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳を固める。何も判断出来ない。",
   "ko_candidate": "주먹을 꽉 쥔다｡ 아무것도 판단할 수 없다｡"
  },
  {
   "id": 29355,
   "key": "D1210le.txt:725",
   "file": "D1210le.txt",
   "line": 725,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目に映るものを壊すだけだ。",
   "ko_candidate": "눈에 보이는 것을 부수기만 할 뿐이다｡"
  },
  {
   "id": 29356,
   "key": "D1210le.txt:726",
   "file": "D1210le.txt",
   "line": 726,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目に映るもの？",
   "ko_candidate": "눈에 보이는 것?"
  },
  {
   "id": 29357,
   "key": "D1210le.txt:727",
   "file": "D1210le.txt",
   "line": 727,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も見えない。何も認識できない。",
   "ko_candidate": "아무것도 보이지 않는다｡ 아무것도 인식할 수 없다｡"
  },
  {
   "id": 29358,
   "key": "D1210le.txt:729",
   "file": "D1210le.txt",
   "line": 729,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ１人。",
   "ko_candidate": "단 한 사람｡"
  },
  {
   "id": 29359,
   "key": "D1210le.txt:730",
   "file": "D1210le.txt",
   "line": 730,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ１人だけ。",
   "ko_candidate": "단 한 사람만｡"
  },
  {
   "id": 29360,
   "key": "D1210le.txt:731",
   "file": "D1210le.txt",
   "line": 731,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛と憎悪と攻撃衝動と閉ざした過去との嵐を貫いて、雷光の如く鮮烈なもの。",
   "ko_candidate": "고통과 증오와 공격 충동과 닫힌 과거의 폭풍을 꿰뚫고､ 번개처럼 선명한 것｡"
  },
  {
   "id": 29361,
   "key": "D1210le.txt:733",
   "file": "D1210le.txt",
   "line": 733,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカ。",
   "ko_candidate": "라이카｡"
  },
  {
   "id": 29362,
   "key": "D1210le.txt:734",
   "file": "D1210le.txt",
   "line": 734,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姉さん。",
   "ko_candidate": "누나｡"
  },
  {
   "id": 29363,
   "key": "D1210le.txt:735",
   "file": "D1210le.txt",
   "line": 735,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……貴様だ。貴様だけだ。",
   "ko_candidate": "……네 놈이다｡ 네 놈뿐이다｡"
  },
  {
   "id": 29364,
   "key": "D1210le.txt:736",
   "file": "D1210le.txt",
   "line": 736,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "貴様しか、見えない。",
   "ko_candidate": "네 놈밖에 보이지 않는다｡"
  },
  {
   "id": 29365,
   "key": "D1210le.txt:741",
   "file": "D1210le.txt",
   "line": 741,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ラ……イ……ッ」",
   "ko_candidate": "「라……이……」"
  },
  {
   "id": 29366,
   "key": "D1210le.txt:746",
   "file": "D1210le.txt",
   "line": 746,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「苦っしそうねぇん、サンダルフォンちゃん。 だぁいじょうぶなのぉ？」",
   "ko_candidate": "「괴로워 보이네､ 산달폰｡ 괜찮아?」"
  },
  {
   "id": 29367,
   "key": "D1210le.txt:750",
   "file": "D1210le.txt",
   "line": 750,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛が、熱病の様に意識を苛んでいた激情が、引いていく。",
   "ko_candidate": "고통이､ 열병처럼 의식을 괴롭히던 격정이 물러간다｡"
  },
  {
   "id": 29368,
   "key": "D1210le.txt:751",
   "file": "D1210le.txt",
   "line": 751,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬で冷たい思考が戻り、僅かな倦怠感がわだかまる。",
   "ko_candidate": "순식간에 차가운 사고가 돌아오고､ 약간의 권태감이 남는다｡"
  },
  {
   "id": 29369,
   "key": "D1210le.txt:753",
   "file": "D1210le.txt",
   "line": 753,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背後を振り返る。",
   "ko_candidate": "뒤를 돌아본다｡"
  },
  {
   "id": 29370,
   "key": "D1210le.txt:754",
   "file": "D1210le.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足元に光源の無い、不自然の影。",
   "ko_candidate": "발밑에 광원이 없는､ 부자연스러운 그림자｡"
  },
  {
   "id": 29371,
   "key": "D1210le.txt:757",
   "file": "D1210le.txt",
   "line": 757,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影が起き上がり、厚みを帯び、実体化する。",
   "ko_candidate": "그림자가 일어나 두께를 띠고 실체화한다｡"
  },
  {
   "id": 29372,
   "key": "D1210le.txt:758",
   "file": "D1210le.txt",
   "line": 758,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影は、サンダルフォンと同じく、仮面の――ただし、天使ではなく道化の――男を象った。",
   "ko_candidate": "그림자는 산달폰과 마찬가지로 가면을 쓴―― 다만､ 천사가 아닌 광대의―― 남자를 상징했다｡"
  },
  {
   "id": 29373,
   "key": "D1210le.txt:763",
   "file": "D1210le.txt",
   "line": 763,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ティベリウス」",
   "ko_candidate": "「티베리우스」"
  },
  {
   "id": 29374,
   "key": "D1210le.txt:770",
   "file": "D1210le.txt",
   "line": 770,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハァァーイ。何か手伝うことがあるかしらん？」",
   "ko_candidate": "「하이｡ 도와드릴 일이라도 있나요?」"
  },
  {
   "id": 29375,
   "key": "D1210le.txt:773",
   "file": "D1210le.txt",
   "line": 773,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人目の襲撃者。",
   "ko_candidate": "두 번째 습격자｡"
  },
  {
   "id": 29376,
   "key": "D1210le.txt:774",
   "file": "D1210le.txt",
   "line": 774,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶望の闇が子ども達を呑み込む。",
   "ko_candidate": "절망의 어둠이 아이들을 삼켜버린다｡"
  },
  {
   "id": 29377,
   "key": "D1210le.txt:775",
   "file": "D1210le.txt",
   "line": 775,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔を涙でクシャクシャにして、それでもライカを引きずっていた。",
   "ko_candidate": "얼굴을 눈물로 구겨 쥐고､ 그래도 라이카를 끌고 있었다｡"
  }
 ]
}