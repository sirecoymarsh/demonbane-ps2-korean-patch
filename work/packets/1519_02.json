{
 "packet": "1519_02",
 "scene": "1519",
 "anchor": {
  "hit": 25,
  "total": 29,
  "rate": 0.862
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 48615,
   "key": "D1519.txt:336",
   "file": "D1519.txt",
   "line": 336,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……馬鹿野郎」",
   "ko_candidate": "「……이 바보야」"
  },
  {
   "id": 48616,
   "key": "D1519.txt:338",
   "file": "D1519.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜空に涙を散らして、ゆっくりと落ちてゆく。",
   "ko_candidate": "밤하늘에 눈물을 흩뿌리며､ 천천히 떨어져 간다｡"
  },
  {
   "id": 48617,
   "key": "D1519.txt:339",
   "file": "D1519.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの騒がしくも、暖かい街に還る。",
   "ko_candidate": "그 시끄럽지만､ 따뜻한 거리로 돌아간다｡"
  },
  {
   "id": 48618,
   "key": "D1519.txt:340",
   "file": "D1519.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "永遠を赦されなかった男が還る。",
   "ko_candidate": "영원을 용서받지 못한 남자가 돌아온다｡"
  },
  {
   "id": 48619,
   "key": "D1519.txt:343",
   "file": "D1519.txt",
   "line": 343,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「俺も……お前を絶対許したりなんかしねえ……」",
   "ko_candidate": "「나도…… 너를 절대 용서 같은 건 하지 않아……」"
  },
  {
   "id": 48620,
   "key": "D1519.txt:345",
   "file": "D1519.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "星の輝き。",
   "ko_candidate": "별의 반짝임｡"
  },
  {
   "id": 48621,
   "key": "D1519.txt:346",
   "file": "D1519.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街の灯火。",
   "ko_candidate": "거리의 불빛｡"
  },
  {
   "id": 48622,
   "key": "D1519.txt:347",
   "file": "D1519.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは厳しくも優しい愛のカタチ。",
   "ko_candidate": "그것은 엄격하면서도 부드러운 사랑의 형태｡"
  },
  {
   "id": 48623,
   "key": "D1519.txt:349",
   "file": "D1519.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那の命が永久に紡ぐ、生命賛歌。",
   "ko_candidate": "찰나의 생명이 끝없이 자아내는､ 생명 찬가｡"
  },
  {
   "id": 48624,
   "key": "D1519.txt:355",
   "file": "D1519.txt",
   "line": 355,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……アル」",
   "ko_candidate": "「……알」"
  },
  {
   "id": 48625,
   "key": "D1519al_b.txt:15",
   "file": "D1519al_b.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの頬を涙が伝う。",
   "ko_candidate": "알의 뺨을 눈물이 흘러내린다｡"
  },
  {
   "id": 48626,
   "key": "D1519al_b.txt:17",
   "file": "D1519al_b.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そっと……九郎の眠りを妨げないように、そっと。",
   "ko_candidate": "살며시… 쿠로의 잠을 방해하지 않도록､ 살며시｡"
  },
  {
   "id": 48627,
   "key": "D1519al_b.txt:18",
   "file": "D1519al_b.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、決して弱くはない力で彼の躰にしがみついた。",
   "ko_candidate": "하지만 결코 약하지 않은 힘으로 그의 몸에 매달렸다｡"
  },
  {
   "id": 48628,
   "key": "D1519al_b.txt:19",
   "file": "D1519al_b.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸元を掴む指にぐっ……と力がこもり、シャツにしわを作る。",
   "ko_candidate": "가슴을 붙잡은 손가락에 꾹… 하고 힘이 들어가 셔츠에 주름이 생긴다｡"
  },
  {
   "id": 48629,
   "key": "D1519al_b.txt:22",
   "file": "D1519al_b.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――たとえ、赦されない事だとしても。",
   "ko_candidate": "――설령 용서받을 수 없는 일이라 해도｡"
  },
  {
   "id": 48630,
   "key": "D1519al_b.txt:27",
   "file": "D1519al_b.txt",
   "line": 27,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「別れる事など……出来ぬ」",
   "ko_candidate": "「헤어질 수는… 없어」"
  },
  {
   "id": 48631,
   "key": "D1519al_b.txt:31",
   "file": "D1519al_b.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――愛は。",
   "ko_candidate": "――사랑은｡"
  },
  {
   "id": 48632,
   "key": "D1519al_b.txt:33",
   "file": "D1519al_b.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女が、九郎に抱いた愛は。",
   "ko_candidate": "소녀가 쿠로에게 품은 사랑은｡"
  },
  {
   "id": 48633,
   "key": "D1519al_b.txt:34",
   "file": "D1519al_b.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎が、少女に与えた愛は。",
   "ko_candidate": "쿠로가 소녀에게 준 사랑은｡"
  },
  {
   "id": 48634,
   "key": "D1519al_b.txt:35",
   "file": "D1519al_b.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女を強くして、脆くもした。",
   "ko_candidate": "소녀를 강하게 하고､ 또한 연약하게 만들었다｡"
  },
  {
   "id": 48635,
   "key": "D1519al_b.txt:37",
   "file": "D1519al_b.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最早、独りで永劫を生きる為の嘘を少女は持ち得ない。",
   "ko_candidate": "이제 혼자서 영겁을 살아가기 위한 거짓말을､ 소녀는 가질 수 없다｡"
  },
  {
   "id": 48636,
   "key": "D1519al_b.txt:38",
   "file": "D1519al_b.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "虚ろな故に強固だった、嘘の力は失われてしまった。",
   "ko_candidate": "공허하기에 견고하기도 했던 거짓말의 힘은 사라져 버렸다｡"
  },
  {
   "id": 48637,
   "key": "D1519al_b.txt:40",
   "file": "D1519al_b.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女は片翼の鳥。",
   "ko_candidate": "소녀는 한쪽 날개의 새｡"
  },
  {
   "id": 48638,
   "key": "D1519al_b.txt:41",
   "file": "D1519al_b.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "番が居なくては、空を翔べない。",
   "ko_candidate": "짝이 없으면 하늘을 날 수 없다｡"
  },
  {
   "id": 48639,
   "key": "D1519al_b.txt:43",
   "file": "D1519al_b.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "たとえ、九郎が片翼でないとしても。いつでも自分を置いて空を翔ぶ事が出来るのだとしても。",
   "ko_candidate": "설령 쿠로가 한쪽 날개가 아니라고 해도｡ 언제든 자신을 두고 하늘을 날 수 있다고 해도｡"
  },
  {
   "id": 48640,
   "key": "D1519al_b.txt:44",
   "file": "D1519al_b.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば、九郎の翼をもいで、自分の許から逃げられぬようにしなければならない。",
   "ko_candidate": "그렇다면 쿠로의 날개를 뽑아 자신의 곁에서 도망갈 수 없게 해야만 한다｡"
  },
  {
   "id": 48641,
   "key": "D1519al_b.txt:47",
   "file": "D1519al_b.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――妾は、枷だ。",
   "ko_candidate": "――첩은 족쇄다｡"
  },
  {
   "id": 48642,
   "key": "D1519al_b.txt:57",
   "file": "D1519al_b.txt",
   "line": 57,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……済まない……九郎…… 赦して……赦して、 くれ……九郎……九郎」",
   "ko_candidate": "「…미안해… 쿠로… 용서해… 용서해 줘… 쿠로… 쿠로」"
  },
  {
   "id": 48643,
   "key": "D1519al_b.txt:64",
   "file": "D1519al_b.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女は涙を流したまま、繰り返し、繰り返し、何度も、何度も、赦しを乞うた。",
   "ko_candidate": "소녀는 눈물을 흘리며 반복해서､ 반복해서､ 몇 번이고､ 몇 번이고 용서를 빌었다｡"
  },
  {
   "id": 48644,
   "key": "D1519al_b.txt:67",
   "file": "D1519al_b.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、それは全く無意味な事なのだ。",
   "ko_candidate": "하지만 그것은 전혀 무의미한 일이다｡"
  },
  {
   "id": 48645,
   "key": "D1519al_b.txt:70",
   "file": "D1519al_b.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そもそも、九郎は少女は責めたりはしない。ただいつも通り、何の曇りもない笑顔で、少女を幸せに満たす笑顔で、ただただ彼女を抱き締めるだけだろう。",
   "ko_candidate": "애초에 쿠로는 소녀를 탓하지 않는다｡ 그저 언제나처럼 아무런 흐림 없는 미소로､ 소녀를 행복으로 가득 채우는 미소로､ 오로지 그녀를 꼭 안아줄 뿐일 것이다｡"
  },
  {
   "id": 48646,
   "key": "D1519al_b.txt:73",
   "file": "D1519al_b.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰からも責められる事の無い罪。",
   "ko_candidate": "누구에게도 책망받지 않는 죄｡"
  },
  {
   "id": 48647,
   "key": "D1519al_b.txt:74",
   "file": "D1519al_b.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "故に。",
   "ko_candidate": "그러므로｡"
  },
  {
   "id": 48648,
   "key": "D1519al_b.txt:75",
   "file": "D1519al_b.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰からも赦される事の無い罪。",
   "ko_candidate": "누구에게도 용서받을 수 없는 죄｡"
  },
  {
   "id": 48649,
   "key": "D1519al_b.txt:85",
   "file": "D1519al_b.txt",
   "line": 85,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎……九郎……」",
   "ko_candidate": "「…쿠로… 쿠로…」"
  },
  {
   "id": 48650,
   "key": "D1519al_b.txt:91",
   "file": "D1519al_b.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在し得ぬ罪に、心は施錠される。",
   "ko_candidate": "존재할 수 없는 죄에 마음은 잠긴다｡"
  },
  {
   "id": 48651,
   "key": "D1519al_b.txt:92",
   "file": "D1519al_b.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己が業の深さに慄き、少女は泣いた。",
   "ko_candidate": "자신의 업의 깊이에 전율하며 소녀는 울었다｡"
  },
  {
   "id": 48652,
   "key": "D1519al_b.txt:93",
   "file": "D1519al_b.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幸福の牢獄で、少女は泣いた。",
   "ko_candidate": "행복의 감옥에서 소녀는 울었다｡"
  },
  {
   "id": 48653,
   "key": "D1519al_b.txt:106",
   "file": "D1519al_b.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――喩え噺をしよう。",
   "ko_candidate": "――비유를 들어보자｡"
  },
  {
   "id": 48654,
   "key": "D1519al_b.txt:115",
   "file": "D1519al_b.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反応炉の中の宇宙。",
   "ko_candidate": "반응로 안의 우주｡"
  }
 ]
}