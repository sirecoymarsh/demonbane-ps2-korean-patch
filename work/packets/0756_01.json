 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "クトゥグア": "크투가",
  "イタクァ": "이타콰",
  "アル": "알",
  "覇道": "하도"
 },
 "items": [
  {
   "id": 11669,
   "key": "D0756.txt:243",
   "file": "D0756.txt",
   "line": 243,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――――」",
   "ko_candidate": ""
  },
  {
   "id": 11670,
   "key": "D0756.txt:246",
   "file": "D0756.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "やっぱり。",
   "ko_candidate": ""
  },
  {
   "id": 11671,
   "key": "D0756.txt:247",
   "file": "D0756.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "でも、どういうことだ？",
   "ko_candidate": ""
  },
  {
   "id": 11672,
   "key": "D0756.txt:252",
   "file": "D0756.txt",
   "line": 252,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「記憶にないんだ……さらわれてからが、酷く曖昧で。クトゥグアとイタクァに逢った気がするけど……夢かも知れないし」",
   "ko_candidate": ""
  },
  {
   "id": 11673,
   "key": "D0756.txt:261",
   "file": "D0756.txt",
   "line": 261,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ふむ……まあ、良い。 結果的には総てが上手くいった」",
   "ko_candidate": ""
  },
  {
   "id": 11674,
   "key": "D0756.txt:274",
   "file": "D0756.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "言って、手に持った断片を光に変える。光は二筋の軌跡を螺旋に描き、アルの胸へ吸い込まれる。",
   "ko_candidate": ""
  },
  {
   "id": 11675,
   "key": "D0756.txt:282",
   "file": "D0756.txt",
   "line": 282,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「イタクァの力を取り戻し、クトゥグアも再び我が許に帰った。だが……また覇道の造った魔導兵器を頼るのは止した方が良いな。今回と同じ結果に成りかねん」",
   "ko_candidate": ""
  },
  {
   "id": 11676,
   "key": "D0756.txt:288",
   "file": "D0756.txt",
   "line": 288,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ああ……」",
   "ko_candidate": ""
  },
  {
   "id": 11677,
   "key": "D0756.txt:292",
   "file": "D0756.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "釈然としないものを感じながらも、とりあえず頷いた。",
   "ko_candidate": ""
  },
  {
   "id": 11678,
   "key": "D0756.txt:295",
   "file": "D0756.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "確かに、全部が丸く収まっている。",
   "ko_candidate": ""
  },
  {
   "id": 11679,
   "key": "D0756.txt:296",
   "file": "D0756.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "残った謎は多過ぎるが――",
   "ko_candidate": ""
  },
  {
   "id": 11680,
   "key": "D0756.txt:305",
   "file": "D0756.txt",
   "line": 305,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そろそろ覇道の連中が迎えに来る。どうだ、立てるか？」",
   "ko_candidate": ""
  },
  {
   "id": 11681,
   "key": "D0756.txt:311",
   "file": "D0756.txt",
   "line": 311,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「あ、ああ……何とか……痛ッ！」",
   "ko_candidate": ""
  },
  {
   "id": 11682,
   "key": "D0756.txt:315",
   "file": "D0756.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "身体を起こそうと両手を床に突き……手の甲に走った痛みに思わず、顔をしかめる。",
   "ko_candidate": ""
  },
  {
   "id": 11683,
   "key": "D0756.txt:324",
   "file": "D0756.txt",
   "line": 324,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「どうした？　やはり辛いか？」",
   "ko_candidate": ""
  },
  {
   "id": 11684,
   "key": "D0756.txt:330",
   "file": "D0756.txt",
   "line": 330,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そうじゃなくて……今、手に痛みが……」",
   "ko_candidate": ""
  },
  {
   "id": 11685,
   "key": "D0756.txt:334",
   "file": "D0756.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "答えながら、手の甲を見る。",
   "ko_candidate": ""
  },
  {
   "id": 11686,
   "key": "D0756.txt:335",
   "file": "D0756.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "すると――",
   "ko_candidate": ""
  },
  {
   "id": 11687,
   "key": "D0756.txt:340",
   "file": "D0756.txt",
   "line": 340,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……何だ、こりゃ？」",
   "ko_candidate": ""
  },
  {
   "id": 11688,
   "key": "D0756.txt:350",
   "file": "D0756.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "両手の甲に傷痕があった。",
   "ko_candidate": ""
  },
  {
   "id": 11689,
   "key": "D0756.txt:351",
   "file": "D0756.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ただの傷痕じゃない。",
   "ko_candidate": ""
  },
  {
   "id": 11690,
   "key": "D0756.txt:353",
   "file": "D0756.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それは……その形は、明らかに何らかの意味を持っていた。",
   "ko_candidate": ""
  },
  {
   "id": 11691,
   "key": "D0756.txt:355",
   "file": "D0756.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "右手の甲。",
   "ko_candidate": ""
  },
  {
   "id": 11692,
   "key": "D0756.txt:356",
   "file": "D0756.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "焼きごてを当てられたような火傷の痕。",
   "ko_candidate": ""
  },
  {
   "id": 11693,
   "key": "D0756.txt:357",
   "file": "D0756.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "生々しい爛れた赤が、紋様を描いていた。",
   "ko_candidate": ""
  },
  {
   "id": 11694,
   "key": "D0756.txt:360",
   "file": "D0756.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "これは確か『火』を意味する魔術紋様。",
   "ko_candidate": ""
  },
  {
   "id": 11695,
   "key": "D0756.txt:361",
   "file": "D0756.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "焔の烙印だ。",
   "ko_candidate": ""
  },
  {
   "id": 11696,
   "key": "D0756.txt:364",
   "file": "D0756.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして左手の甲。",
   "ko_candidate": ""
  },
  {
   "id": 11697,
   "key": "D0756.txt:365",
   "file": "D0756.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "深々と刻まれた切り傷。",
   "ko_candidate": ""
  },
  {
   "id": 11698,
   "key": "D0756.txt:366",
   "file": "D0756.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "血こそ滴ってないが、傷口は開いたままだった。",
   "ko_candidate": ""
  },
  {
   "id": 11699,
   "key": "D0756.txt:369",
   "file": "D0756.txt",
   "line": 369,
   "speaker": null,
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "『風』を意味する魔術紋様。",
   "ko_candidate": ""
  },
  {
   "id": 11700,
   "key": "D0756.txt:370",
   "file": "D0756.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "風の刻印だ。",
   "ko_candidate": ""
  },
  {
   "id": 11701,
   "key": "D0756.txt:379",
   "file": "D0756.txt",
   "line": 379,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「それは……？」",
   "ko_candidate": ""
  },
  {
   "id": 11702,
   "key": "D0756.txt:384",
   "file": "D0756.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "分からない。",
   "ko_candidate": ""
  },
  {
   "id": 11703,
   "key": "D0756.txt:385",
   "file": "D0756.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺は首を横に振った。",
   "ko_candidate": ""
  },
  {
   "id": 11704,
   "key": "D0756.txt:387",
   "file": "D0756.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だけど予想することは出来る。",
   "ko_candidate": ""
  },
  {
   "id": 11705,
   "key": "D0756.txt:389",
   "file": "D0756.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "火と風。",
   "ko_candidate": ""
  },
  {
   "id": 11706,
   "key": "D0756.txt:390",
   "file": "D0756.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "まさか――クトゥグアとイタクァなのか？",
   "ko_candidate": ""
  },
  {
   "id": 11707,
   "key": "D0756.txt:394",
   "file": "D0756.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アルが愉しそうな、もしくは逆に不機嫌そうな、そんな微妙な表情を浮かべた。",
   "ko_candidate": ""
  },
  {
   "id": 11708,
   "key": "D0756.txt:401",
   "file": "D0756.txt",
   "line": 401,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「どうしてかは知らんが、どうやら、いたく気に入られたようではないか。これなら次に招喚した時は素直に従ってくれるやもな」",
   "ko_candidate": ""
  }
 ]
}