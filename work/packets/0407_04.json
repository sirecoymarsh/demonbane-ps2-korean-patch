  },
  {
   "id": 5040,
   "key": "D0407.txt:1525",
   "file": "D0407.txt",
   "line": 1525,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん!?」",
   "ko_candidate": "「으으으으!」 「쿠로 짱!?」"
  },
  {
   "id": 5041,
   "key": "D0407.txt:1532",
   "file": "D0407.txt",
   "line": 1532,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今まで、ふざけてじゃれ合うことはあっても、本気で叩いたりすることはなかった。相当ショックだったのか、２人とも呆然と俺を見上げている。",
   "ko_candidate": "장난치는 일은 있어도 정말로 때리는 일은 없었다｡ 너무나 큰 충격에 두 사람은 멍하니 나를 올려다보고 있었다｡"
  },
  {
   "id": 5042,
   "key": "D0407.txt:1535",
   "file": "D0407.txt",
   "line": 1535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その場にしゃがみ、同じ視線の高さから２人の顔をのぞき込む。",
   "ko_candidate": "나는 쪼그리고 앉아 두 사람과 같은 시선의 높이가 되어 어깨를 잡고 소리쳤다｡"
  },
  {
   "id": 5043,
   "key": "D0407.txt:1541",
   "file": "D0407.txt",
   "line": 1541,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ちょっとイタズラが過ぎるのも良いさ！　ケンカだって別に構わねえ！　だけどな、弱いヤツいじめて喜ぶなんてぇのは最低だ！　ダセえ真似してるんじゃねえよ！」",
   "ko_candidate": "「장난이 좀 심한 것도 괜찮아! 싸움도 별로 상관없어! 하지만 말이야､ 약한 녀석을 괴롭히고 좋아하는 건 최악이야! 구린 짓 하지 마!」"
  },
  {
   "id": 5044,
   "key": "D0407.txt:1547",
   "file": "D0407.txt",
   "line": 1547,
   "speaker": "ジョージ＆コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「………………」」",
   "ko_candidate": "「………………」 뚫어지게 두 사람의 눈동자를 들여다본다｡"
  },
  {
   "id": 5045,
   "key": "D0407.txt:1554",
   "file": "D0407.txt",
   "line": 1554,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今度は目を背けようとしなかった。 ２人の肩を掴む。",
   "ko_candidate": "겁을 먹으면서도 이번에는 두 사람 모두 눈을 돌리려 하지 않는다｡"
  },
  {
   "id": 5046,
   "key": "D0407.txt:1561",
   "file": "D0407.txt",
   "line": 1561,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「てめえら、ただ単にアリスンにビビってるだけなんだよ。なに考えてるか分からないから、おっかないから、だからいじめて、自分の方が強いって……そう安心したいだけなんだよ！　それがダセえってんだ！」",
   "ko_candidate": "나는 계속해서 말을 이었다｡ 「너희들､ 그저 앨리슨을 무서워하는 것뿐이야! 뭘 생각하는지 모르니까､ 무서우니까､ 그래서 괴롭히고､ 자신이 더 강하다고… 그렇게 안심하고 싶은 것뿐이라고! 그게 구리다고!」"
  },
  {
   "id": 5047,
   "key": "D0407.txt:1567",
   "file": "D0407.txt",
   "line": 1567,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 5048,
   "key": "D0407.txt:1573",
   "file": "D0407.txt",
   "line": 1573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんも止めない。",
   "ko_candidate": "라이카 씨도 말리지 않는다｡"
  },
  {
   "id": 5049,
   "key": "D0407.txt:1574",
   "file": "D0407.txt",
   "line": 1574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ黙って、俺たちを見守っている。",
   "ko_candidate": "그저 조용히 우리를 지켜보고 있다｡"
  },
  {
   "id": 5050,
   "key": "D0407.txt:1580",
   "file": "D0407.txt",
   "line": 1580,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何でアリスンも同じだって、分かってやれない？ なあ……お前らと一緒で、アリスンだって独りぼっちだったんだぜ？」",
   "ko_candidate": "나는 두 사람의 어깨를 잡았다｡ 「왜 앨리슨도 같다는 걸 이해해주지 못해? 있잖아… 너희와 마찬가지로 앨리슨도 외톨이였다고?」"
  },
  {
   "id": 5051,
   "key": "D0407.txt:1587",
   "file": "D0407.txt",
   "line": 1587,
   "speaker": "ジョージ＆コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「っ！」」",
   "ko_candidate": "「으!」"
  },
  {
   "id": 5052,
   "key": "D0407.txt:1593",
   "file": "D0407.txt",
   "line": 1593,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「もう此処にしか帰る場所が無いんだよ……それなのに、お前たちが疎んじてしまっちゃあ、あいつはどうすれば良いんだ？」",
   "ko_candidate": "「이제 여기밖에 돌아갈 곳이 없어… 그런데도 너희가 멀리한다면 걔는 어떻게 해야 하는 거야?」"
  },
  {
   "id": 5053,
   "key": "D0407.txt:1599",
   "file": "D0407.txt",
   "line": 1599,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………うっ、うっ、 うえええぇぇ……っ！」",
   "ko_candidate": "「…………으､ 으､ 으에에에에……!」"
  },
  {
   "id": 5054,
   "key": "D0407.txt:1605",
   "file": "D0407.txt",
   "line": 1605,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわぁぁぁっ…… うわあぁぁぁんっ！」",
   "ko_candidate": "「우와아아아…… 우와아아아앙!」 마침내 울음을 터뜨리고 말았다｡"
  },
  {
   "id": 5055,
   "key": "D0407.txt:1612",
   "file": "D0407.txt",
   "line": 1612,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ついに泣き出してしまった。しゃくり上げながら、それでも２人は「ごめんなさい」を繰り返した。",
   "ko_candidate": "흐느끼면서도 두 사람은 '죄송합니다'를 반복했다｡ 계속 우는 두 사람을 그대로 두고 나는 일어섰다｡"
  },
  {
   "id": 5056,
   "key": "D0407.txt:1618",
   "file": "D0407.txt",
   "line": 1618,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「謝るんだったら、アリスンにな」",
   "ko_candidate": "「사과할 거면 앨리슨에게 해」"
