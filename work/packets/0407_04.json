   "key": "D0407.txt:1622",
   "file": "D0407.txt",
   "line": 1622,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "告げて、俺は２人の頭を撫でた。",
   "ko_candidate": "말하고 나는 두 사람의 머리를 쓰다듬었다｡"
  },
  {
   "id": 5058,
   "key": "D0407.txt:1623",
   "file": "D0407.txt",
   "line": 1623,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "続けて、誓う。",
   "ko_candidate": "이어서 맹세한다｡"
  },
  {
   "id": 5059,
   "key": "D0407.txt:1629",
   "file": "D0407.txt",
   "line": 1629,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「その代わり、アリスンは必ず俺が連れ戻す」",
   "ko_candidate": "「그 대신 앨리슨은 반드시 내가 데려올게」"
  },
  {
   "id": 5060,
   "key": "D0407.txt:1633",
   "file": "D0407.txt",
   "line": 1633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ガキんちょどもは何度も頷いた。",
   "ko_candidate": "꼬마들은 여러 번 고개를 끄덕였다｡"
