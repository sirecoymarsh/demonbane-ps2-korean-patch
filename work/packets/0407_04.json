   "key": "D0407.txt:1724",
   "file": "D0407.txt",
   "line": 1724,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「分かった。だけど、無茶だけはするなよ」",
   "ko_candidate": "「알겠어｡ 하지만 무리만은 하지 마」 「쿠로 짱이야말로」"
  },
