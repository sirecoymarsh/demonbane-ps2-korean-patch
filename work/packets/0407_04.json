   "key": "D0407.txt:1667",
   "file": "D0407.txt",
   "line": 1667,
   "speaker": "ライカ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――神様。九郎ちゃんがとってもマトモです。びっくりです。ショックです。驚天動地です」 「黙りやがれ」",
   "ko_candidate": "「――신이시여｡ 쿠로 짱이 너무 제정신이에요｡ 놀랍습니다｡ 충격입니다｡ 경천동지입니다」"
  },
  {
   "id": 5065,
   "key": "D0407.txt:1682",
   "file": "D0407.txt",
   "line": 1682,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――九郎ちゃん」",
   "ko_candidate": "「닥쳐」 「――쿠로 짱」"
  },
  {
   "id": 5066,
   "key": "D0407.txt:1687",
   "file": "D0407.txt",
   "line": 1687,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "不意に、ライカさんの表情が引き締まった。",
   "ko_candidate": "갑자기 라이카 씨의 표정이 굳어졌다｡"
  },
  {
   "id": 5067,
   "key": "D0407.txt:1688",
   "file": "D0407.txt",
   "line": 1688,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の瞳を真っ直ぐに見つめ返して、言った。",
   "ko_candidate": "내 눈을 똑바로 바라보며 말했다｡"
  },
  {
   "id": 5068,
   "key": "D0407.txt:1694",
   "file": "D0407.txt",
   "line": 1694,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「私も一緒に行きます」",
   "ko_candidate": "「저도 같이 가겠습니다」"
  },
  {
   "id": 5069,
   "key": "D0407.txt:1699",
   "file": "D0407.txt",
   "line": 1699,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？　だけど、危険……」",
   "ko_candidate": "「엣? 하지만 위험…」"
  },
  {
   "id": 5070,
   "key": "D0407.txt:1705",
   "file": "D0407.txt",
   "line": 1705,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎ちゃんだけに任せっきりになんか出来ない。だってアリスンちゃんは、私たちの家族だから」",
   "ko_candidate": "「쿠로 짱에게만 맡겨둘 순 없어요｡ 왜냐하면 앨리슨 짱은 우리 가족이니까요」"
  },
  {
   "id": 5071,
   "key": "D0407.txt:1711",
   "file": "D0407.txt",
   "line": 1711,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 5072,
   "key": "D0407.txt:1715",
   "file": "D0407.txt",
   "line": 1715,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "決意は固いらしい。",
   "ko_candidate": "결심이 확고한 것 같다｡"
  },
  {
   "id": 5073,
   "key": "D0407.txt:1716",
   "file": "D0407.txt",
   "line": 1716,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これは何を言っても無駄だろう。",
   "ko_candidate": "이건 뭘 말해도 소용없을 거다｡"
