  {
   "id": 5061,
   "key": "D0407.txt:1651",
   "file": "D0407.txt",
   "line": 1651,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はライカさんの方に向き直る。",
   "ko_candidate": "나는 라이카 씨 쪽으로 돌아선다｡"
  },
  {
   "id": 5062,
   "key": "D0407.txt:1652",
   "file": "D0407.txt",
   "line": 1652,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんはずっと俺を見つめていた。",
   "ko_candidate": "라이카 씨는 계속 나를 바라보고 있었다｡"
  },
  {
