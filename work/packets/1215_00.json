 "items": [
  {
   "id": 30280,
   "key": "D1215le.txt:7",
   "file": "D1215le.txt",
   "line": 7,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "最後の天井を突き破る。頭上にはクトゥルーに飲み込まれたアーカムシティの夜空が広がっていた。",
   "ko_candidate": "마지막 천장을 뚫고 나온다｡ 머리 위로는 크툴루에게 삼켜진 아캄시티의 밤하늘이 펼쳐져 있었다｡"
  },
  {
   "id": 30281,
   "key": "D1215le.txt:14",
   "file": "D1215le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスはなおも昇り続ける。",
   "ko_candidate": "클라우디우스는 계속해서 상승한다｡"
  },
  {
   "id": 30282,
   "key": "D1215le.txt:15",
   "file": "D1215le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もの凄いスピードで地表が遠ざかり凄まじいＧが俺を襲う。",
   "ko_candidate": "엄청난 속도로 지표면이 멀어지고､ 어마어마한 G가 몰아친다｡"
  },
  {
   "id": 30283,
   "key": "D1215le.txt:17",
   "file": "D1215le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "歯を食いしばって衝撃に堪える。耐えられないクラウディウスの躰は、またもボロボロ崩れていく。",
   "ko_candidate": "이를 악물고 충격을 견딘다｡ 견디지 못한 클라우디우스의 몸은 또다시 산산조각 나간다｡"
  },
  {
   "id": 30284,
   "key": "D1215le.txt:21",
   "file": "D1215le.txt",
   "line": 21,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「野郎……！」",
   "ko_candidate": "「이 자식…!」"
  },
  {
   "id": 30285,
   "key": "D1215le.txt:26",
   "file": "D1215le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "充分な高さまで達したところで反転。",
   "ko_candidate": "충분한 높이에 도달한 곳에서 반전｡"
  },
  {
   "id": 30286,
   "key": "D1215le.txt:27",
   "file": "D1215le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は地表目掛けての大加速を始める。",
   "ko_candidate": "이번에는 지표면을 향해 대가속을 시작한다｡"
  },
  {
   "id": 30287,
   "key": "D1215le.txt:35",
   "file": "D1215le.txt",
   "line": 35,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「このまま地面に叩きつけるつもりか！」",
   "ko_candidate": "「이대로 지면에 내리꽂을 셈이냐!」"
  },
  {
   "id": 30288,
   "key": "D1215le.txt:39",
   "file": "D1215le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、そんなことをすればクラウディウスもただでは済まない。",
   "ko_candidate": "물론､ 그렇게 하면 클라우디우스도 무사하지 못할 것이다｡"
  },
  {
   "id": 30289,
   "key": "D1215le.txt:40",
   "file": "D1215le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "が、そんなことは屍体には関係ないのだろう。",
   "ko_candidate": "하지만 그런 건 시체에겐 상관없는 모양이다｡"
  },
  {
   "id": 30290,
   "key": "D1215le.txt:42",
   "file": "D1215le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冗談じゃねえ、付き合ってられっか！",
   "ko_candidate": "농담 아니야､ 더 이상 못 따라가겠어!"
  },
  {
   "id": 30291,
   "key": "D1215le.txt:46",
   "file": "D1215le.txt",
   "line": 46,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「墜ちるなら、１人で墜ちろ！」",
   "ko_candidate": "「떨어질 거면､ 혼자 떨어져!」"
  },
  {
   "id": 30292,
   "key": "D1215le.txt:50",
   "file": "D1215le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・ウィングを刃状に変形し、クラウディウスの腕を斬り落とす。",
   "ko_candidate": "마기우스 윙을 칼날 모양으로 변형시켜 클라우디우스의 팔을 베어낸다｡"
  },
  {
   "id": 30293,
   "key": "D1215le.txt:51",
   "file": "D1215le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一瞬の無重力感。宙に放り投げられる。",
   "ko_candidate": "순간적인 무중력감｡ 공중에 던져진다｡"
  },
  {
   "id": 30294,
   "key": "D1215le.txt:56",
   "file": "D1215le.txt",
   "line": 56,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ウィング！」",
   "ko_candidate": "「윙!」"
  },
  {
   "id": 30295,
   "key": "D1215le.txt:60",
   "file": "D1215le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃状にしたウィングを戻し、本来の翼としての機能を得る。",
   "ko_candidate": "칼날 모양으로 만든 윙을 원래대로 돌려 본래의 날개로서의 기능을 얻는다｡"
  },
  {
   "id": 30296,
   "key": "D1215le.txt:61",
   "file": "D1215le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "兇暴な重力の戒めから何とか逃れ、俺は宙に留まった。",
   "ko_candidate": "포악한 중력의 굴레에서 어떻게든 벗어나 나는 공중에 머물렀다｡"
  },
  {
   "id": 30297,
   "key": "D1215le.txt:63",
   "file": "D1215le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遥か眼下、高速で墜落するクラウディウスの姿はあっという間に見えなくなる……いや。",
   "ko_candidate": "저 멀리 아래､ 고속으로 추락하는 클라우디우스의 모습은 순식간에 보이지 않게 되었다… 아니｡"
  },
  {
   "id": 30298,
   "key": "D1215le.txt:68",
   "file": "D1215le.txt",
   "line": 68,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あんの、糞餓鬼ぁ……」",
   "ko_candidate": "「이 망할 꼬마 자식…」"
  },
  {
   "id": 30299,
   "key": "D1215le.txt:73",
   "file": "D1215le.txt",
   "line": 73,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――風が、瘴気を孕み出した」",
   "ko_candidate": "「--바람이､ 독기를 품어냈다」"
  },
  {
   "id": 30300,
   "key": "D1215le.txt:77",
   "file": "D1215le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初は、小さな旋風だった。",
   "ko_candidate": "처음에는 작은 선풍이었다｡"
  },
  {
   "id": 30301,
   "key": "D1215le.txt:82",
   "file": "D1215le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "旋風は竜巻となり、竜巻は、ビル群を呑み込み、破壊し、巻き上げながら、巨大化する。",
   "ko_candidate": "선풍은 회오리가 되고､ 회오리는 빌딩 군을 삼켜 파괴하고 휘감으며 거대해진다｡"
  },
  {
   "id": 30302,
   "key": "D1215le.txt:83",
   "file": "D1215le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜巻を中心に魔法陣が街に刻まれた。",
   "ko_candidate": "회오리를 중심으로 마법진이 거리에 새겨졌다｡"
  },
  {
   "id": 30303,
   "key": "D1215le.txt:84",
   "file": "D1215le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――来るか！",
   "ko_candidate": "--오는가!"
  },
  {
   "id": 30304,
   "key": "D1215le.txt:90",
   "file": "D1215le.txt",
   "line": 90,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「腐臭ぅるるるる……ロおォぉドビヤぁきィィ！ いあ、いあ、はすたー！」",
   "ko_candidate": "「부후우우우… 로오오오드비야아키이이! 이야､ 이야､ 하스터!」"
  },
  {
   "id": 30305,
   "key": "D1215le.txt:97",
   "file": "D1215le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "竜巻を纏い、翔け昇る全長５０メートルの巨体。細身のフォルムから兇暴な闇を大気に滲ませる、神を象りし鋼鉄。",
   "ko_candidate": "회오리를 두르고 치솟는 전장 50미터의 거체｡ 날렵한 형태에서 포악한 어둠을 대기에 스며들게 하는､ 신을 본뜬 강철｡"
  },
  {
   "id": 30306,
   "key": "D1215le.txt:102",
   "file": "D1215le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鬼械神ロードビヤーキー！",
   "ko_candidate": "귀계신 로드 비야키!"
  },
  {
   "id": 30307,
   "key": "D1215le.txt:110",
   "file": "D1215le.txt",
   "line": 110,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「屍体にも喚べるのかよ！　クソクソクソ！　どうする!?」",
   "ko_candidate": "「시체도 부를 수 있는 건가! 젠장 젠장 젠장! 어떡하지!?」"
  },
  {
   "id": 30308,
   "key": "D1215le.txt:112",
   "file": "D1215le.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鬼械神が相手となると、生身の俺ではどうすることも出来ない。",
   "ko_candidate": "귀계신이 상대가 되면 맨몸의 나로는 어찌할 도리가 없다｡"
  },
  {
   "id": 30309,
   "key": "D1215le.txt:113",
   "file": "D1215le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "望みはドクター・ウェストのハンティング・ホラーなんだが……まだ調整は終わらないのか!?",
   "ko_candidate": "희망은 닥터 웨스트의 헌팅 호러인데… 아직 조정이 끝나지 않은 건가!?"
  },
  {
   "id": 30310,
   "key": "D1215le.txt:120",
   "file": "D1215le.txt",
   "line": 120,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「殺。殺。殺。殺……大十字九郎……殺ァァァァァッ！」",
   "ko_candidate": "「죽여｡ 죽여｡ 죽여｡ 죽여… 다이쥬지 쿠로… 죽여어어어어어앗!」"
  },
  {
   "id": 30311,
   "key": "D1215le.txt:130",
   "file": "D1215le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーのライフルが吼える。",
   "ko_candidate": "로드 비야키의 라이플이 포효한다｡"
  },
  {
   "id": 30312,
   "key": "D1215le.txt:133",
   "file": "D1215le.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊の呪術を圧縮した魔力弾が、衝撃波を引き連れて、襲いかかる。",
   "ko_candidate": "파괴의 주술을 압축한 마력탄이 충격파를 동반하며 덮쳐온다｡"
  },
  {
   "id": 30313,
   "key": "D1215le.txt:134",
   "file": "D1215le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "鬼械神の攻撃だ……掠っただけでも、俺の身体なんか粉微塵に吹き飛んでしまう。",
   "ko_candidate": "귀계신의 공격이다… 스쳐도 내 몸은 산산조각 날 것이다｡"
  },
  {
   "id": 30314,
   "key": "D1215le.txt:138",
   "file": "D1215le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避けた。",
   "ko_candidate": "피했다｡"
  },
  {
   "id": 30315,
   "key": "D1215le.txt:139",
   "file": "D1215le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避けた。",
   "ko_candidate": "피했다｡"
  },
  {
   "id": 30316,
   "key": "D1215le.txt:140",
   "file": "D1215le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必死に避けた。",
   "ko_candidate": "필사적으로 피했다｡"
  },
  {
   "id": 30317,
   "key": "D1215le.txt:142",
   "file": "D1215le.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど……クソ！　とんでもなく速えぇ！",
   "ko_candidate": "하지만… 젠장! 엄청나게 빠르잖아!"
  },
  {
   "id": 30318,
   "key": "D1215le.txt:143",
   "file": "D1215le.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こちらが小さくて当たり辛いとはいえ、いつまで持つか……！",
   "ko_candidate": "이쪽이 작아서 맞추기 어렵다고는 해도､ 언제까지 버틸 수 있을지…!"
  },
  {
   "id": 30319,
   "key": "D1215le.txt:146",
   "file": "D1215le.txt",
   "line": 146,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ!?」",
   "ko_candidate": "「--앗!?」"
  }
 ]
}