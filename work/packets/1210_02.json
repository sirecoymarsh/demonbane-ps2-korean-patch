  },
  {
   "id": 29059,
   "key": "D1210al.txt:298",
   "file": "D1210al.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動かないネームレス・ワン。",
   "ko_candidate": "움직이지 않는 네임리스 원｡"
  },
  {
   "id": 29060,
   "key": "D1210al.txt:302",
   "file": "D1210al.txt",
   "line": 302,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……あ」",
   "ko_candidate": "「……아」"
  },
  {
   "id": 29061,
   "key": "D1210al.txt:305",
   "file": "D1210al.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザが、ネームレス・ワンの変化に気付いた。",
   "ko_candidate": "엘자가 네임리스 원의 변화를 눈치챘다｡"
  },
  {
   "id": 29062,
   "key": "D1210al.txt:316",
   "file": "D1210al.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネームレス・ワンの頭頂部。",
   "ko_candidate": "네임리스 원의 정수리｡"
  },
  {
   "id": 29063,
   "key": "D1210al.txt:317",
   "file": "D1210al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遥か２００メートルの高み。",
   "ko_candidate": "저 멀리 200미터 높이｡"
  },
  {
   "id": 29064,
   "key": "D1210al.txt:322",
   "file": "D1210al.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "拡大された映像が、メインモニターに映し出される。",
   "ko_candidate": "확대된 영상이 메인 모니터에 비춰진다｡"
  },
  {
   "id": 29065,
   "key": "D1210al.txt:323",
   "file": "D1210al.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其処に――彼女が立っていた。",
   "ko_candidate": "거기에――그녀가 서 있었다｡"
  },
  {
   "id": 29066,
   "key": "D1210al.txt:325",
   "file": "D1210al.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拘束具によって束縛された少女。",
   "ko_candidate": "구속구에 의해 속박된 소녀｡"
  },
  {
   "id": 29067,
   "key": "D1210al.txt:326",
   "file": "D1210al.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界を覆う仮面と、四肢を縛る枷と、口に填められた轡と。",
   "ko_candidate": "시야를 가리는 가면과､ 사지를 묶는 족쇄와､ 입에 물린 재갈과｡"
  },
  {
   "id": 29068,
   "key": "D1210al.txt:329",
   "file": "D1210al.txt",
   "line": 329,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『暴君』……ネロ？」",
   "ko_candidate": "「『폭군』…… 네로?」"
  },
  {
   "id": 29069,
   "key": "D1210al.txt:331",
   "file": "D1210al.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の目の前でページになって解けた少女。",
   "ko_candidate": "내 눈앞에서 페이지가 되어 녹아내린 소녀｡"
  },
  {
   "id": 29070,
   "key": "D1210al.txt:332",
   "file": "D1210al.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "二挺の魔銃を与えた少女。",
   "ko_candidate": "두 자루의 마총을 준 소녀｡"
  },
  {
   "id": 29071,
   "key": "D1210al.txt:334",
   "file": "D1210al.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女の口元が笑みの形に歪んだ。",
   "ko_candidate": "소녀의 입가가 미소 짓는 모양으로 일그러졌다｡"
  },
  {
   "id": 29072,
   "key": "D1210al.txt:340",
   "file": "D1210al.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ネームレス・ワンが光に包まれる。",
   "ko_candidate": "네임리스 원이 빛에 휩싸인다{SE_PLAY(1,\"魔륨衝젼\",0,100,false);}"
  },
  {
   "id": 29073,
   "key": "D1210al.txt:346",
   "file": "D1210al.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光は眩きを増し閃となり、やがて目も開けられないほどの烈光と化した。",
   "ko_candidate": "。 빛은 눈부심을 더해 섬광이 되고､ 이윽고 눈도 뜰 수 없을 정도의 강렬한 빛으로 변했다｡"
  },
  {
   "id": 29074,
   "key": "D1210al.txt:346",
   "file": "D1210al.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女の姿も閃の中に、呑み込まれてゆく。",
   "ko_candidate": "소녀의 모습도 섬광 속에 삼켜져 갔다｡"
  },
  {
   "id": 29075,
   "key": "D1210al.txt:349",
   "file": "D1210al.txt",
   "line": 349,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な――！」",
   "ko_candidate": "「뭐――!」"
  },
  {
   "id": 29076,
   "key": "D1210al.txt:354",
   "file": "D1210al.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネームレス・ワンは光の柱となった。",
   "ko_candidate": "네임리스 원은 빛의 기둥이 되었다｡"
  },
  {
   "id": 29077,
   "key": "D1210al.txt:355",
   "file": "D1210al.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真っ直ぐに天に昇り、街を覆うクトゥルーに届く。",
   "ko_candidate": "똑바로 하늘로 올라가 거리를 뒤덮은 크툴루에게 닿는다｡"
  },
  {
   "id": 29078,
   "key": "D1210al.txt:356",
   "file": "D1210al.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深い闇に覆われていたアーカムシティが、その一瞬だけ、真昼のように照らされた。",
   "ko_candidate": "깊은 어둠에 뒤덮여 있던 아캄시티가､ 그 한순간만큼은､{SE_VOL(1,1000,0);}한낮처럼 밝게 비춰졌다｡"
  },
  {
   "id": 29079,
   "key": "D1210al.txt:363",
   "file": "D1210al.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがてその光も消える。",
   "ko_candidate": "이윽고 그 빛도 사라진다｡"
  },
  {
   "id": 29080,
   "key": "D1210al.txt:364",
   "file": "D1210al.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天を貫く光の柱は、無数の粒子となって解け、闇へと散っていった。",
   "ko_candidate": "하늘을 꿰뚫는 빛의 기둥은､ 무수한 입자가 되어 녹아내려 어둠 속으로 흩어져 갔다｡"
  },
  {
   "id": 29081,
   "key": "D1210al.txt:370",
   "file": "D1210al.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街に沈黙の闇が戻る。",
   "ko_candidate": "거리에 침묵의 어둠이 돌아온다｡"
  },
  {
   "id": 29082,
   "key": "D1210al.txt:371",
   "file": "D1210al.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネームレス・ワンの姿も、もう無かった。",
   "ko_candidate": "네임리스 원의 모습도 이제 없었다｡"
  },
  {
   "id": 29083,
   "key": "D1210al.txt:377",
   "file": "D1210al.txt",
   "line": 377,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何だったんだ？」",
   "ko_candidate": "「……뭐였지?」"
  },
  {
   "id": 29084,
   "key": "D1210al.txt:385",
   "file": "D1210al.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呟きながらも、デモンベインを起き上がらせた。",
   "ko_candidate": "중얼거리면서도､ 데몬베인을 일으켜 세웠다｡"
  },
  {
   "id": 29085,
   "key": "D1210al.txt:386",
   "file": "D1210al.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破損箇所をチェックする。",
   "ko_candidate": "파손 부위를 체크한다｡"
  },
  {
   "id": 29086,
   "key": "D1210al.txt:387",
   "file": "D1210al.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "外側も中身もボロボロだったが――とりわけ深刻なのが右腕だ。",
   "ko_candidate": "겉도 속도 엉망진창이었지만――특히 심각한 건 오른팔이다｡"
  },
  {
   "id": 29087,
   "key": "D1210al.txt:389",
   "file": "D1210al.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "さっきのロードビヤーキーの体当たりで、 完全に砕けてしまった。",
   "ko_candidate": "아까 로드 비야키의 몸통박치기로 완전히 부서져 버렸다｡"
  },
  {
   "id": 29088,
   "key": "D1210al.txt:391",
   "file": "D1210al.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これでは虎の子のレムリア・インパクトを使えない。",
   "ko_candidate": "이래서는 귀중한 레무리아 임팩트를 쓸 수 없다｡"
  },
  {
   "id": 29089,
   "key": "D1210al.txt:392",
   "file": "D1210al.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに――",
   "ko_candidate": "게다가――"
  },
  {
   "id": 29090,
   "key": "D1210al.txt:395",
   "file": "D1210al.txt",
   "line": 395,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだ……司令室は！ 姫さんたちはどうしたんだっ!?」",
   "ko_candidate": "「맞아……사령실은! 공주님들은 어떻게 됐지!?」"
  },
  {
   "id": 29091,
   "key": "D1210al.txt:398",
   "file": "D1210al.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さっきはヒラニプラ・システムが起動しなかった。",
   "ko_candidate": "아까는 히라니프라 시스템이 작동하지 않았다｡"
  },
  {
   "id": 29092,
   "key": "D1210al.txt:399",
   "file": "D1210al.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何があったんだ？　みんなは無事なのか？",
   "ko_candidate": "무슨 일이 있었던 거지? 모두 무사한 건가?"
  },
  {
   "id": 29093,
   "key": "D1210al.txt:400",
   "file": "D1210al.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は慌てて、司令室に通信を繋げようとする。",
   "ko_candidate": "나는 황급히 사령실과 통신을 연결하려 한다｡"
  },
  {
   "id": 29094,
   "key": "D1210al.txt:402",
   "file": "D1210al.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その時だった。",
   "ko_candidate": "그때였다｡"
  },
  {
   "id": 29095,
   "key": "D1210al.txt:408",
   "file": "D1210al.txt",
   "line": 408,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おーほっほっほっほっ！　まだまだお祭りはこれからよん、九郎ちゃーん！」",
   "ko_candidate": "「오―호호호호호! 아직 축제는 이제부터야､ 쿠로 군!」"
  },
  {
   "id": 29096,
   "key": "D1210al.txt:413",
   "file": "D1210al.txt",
   "line": 413,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?　その声は……！」",
   "ko_candidate": "「――――!? 그 목소리는……!」"
  },
  {
   "id": 29097,
   "key": "D1210al.txt:417",
   "file": "D1210al.txt",
   "line": 417,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度は何ロボ!?」",
   "ko_candidate": "「이번엔 무슨 로봇이지!?」"
  }
 ]
}