{
 "packet": "ep_ruri02a_07",
 "scene": "ep_ruri02a",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "覇道鋼造": "하도 코조",
  "大十字九郎": "다이쥬지 쿠로",
  "デモンベイン": "데몬베인"
 },
 "items": [
  {
   "id": 50813,
   "key": "ep_ruri02a.txt:909",
   "file": "ep_ruri02a.txt",
   "line": 909,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それでもなお――戦い続ける訳がある。",
   "ko_candidate": ""
  },
  {
   "id": 50814,
   "key": "ep_ruri02a.txt:916",
   "file": "ep_ruri02a.txt",
   "line": 916,
   "speaker": "兼定",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「父さん！　生まれた！　生まれたよ！」",
   "ko_candidate": ""
  },
  {
   "id": 50815,
   "key": "ep_ruri02a.txt:919",
   "file": "ep_ruri02a.txt",
   "line": 919,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "息子が大慌てで、だけど喜色満面の笑みを浮かべて、俺の許に駆けつける。",
   "ko_candidate": ""
  },
  {
   "id": 50816,
   "key": "ep_ruri02a.txt:920",
   "file": "ep_ruri02a.txt",
   "line": 920,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "尊敬と信頼と親子愛に満ちた瞳で、俺を見つめて。",
   "ko_candidate": ""
  },
  {
   "id": 50817,
   "key": "ep_ruri02a.txt:921",
   "file": "ep_ruri02a.txt",
   "line": 921,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "３０年間、騙し続けた男を、そしてこれからも騙し続ける男を、何も疑うことなく。",
   "ko_candidate": ""
  },
  {
   "id": 50818,
   "key": "ep_ruri02a.txt:922",
   "file": "ep_ruri02a.txt",
   "line": 922,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その顔を正面から見つめ返すことが、俺には少し辛い。",
   "ko_candidate": ""
  },
  {
   "id": 50819,
   "key": "ep_ruri02a.txt:924",
   "file": "ep_ruri02a.txt",
   "line": 924,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして、俺の心を騒がせる要因が、もう一つある。",
   "ko_candidate": ""
  },
  {
   "id": 50820,
   "key": "ep_ruri02a.txt:925",
   "file": "ep_ruri02a.txt",
   "line": 925,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "というより、たった今、生まれた。",
   "ko_candidate": ""
  },
  {
   "id": 50821,
   "key": "ep_ruri02a.txt:927",
   "file": "ep_ruri02a.txt",
   "line": 927,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺の前を行く、息子の背中を見つめながら、自問する。",
   "ko_candidate": ""
  },
  {
   "id": 50822,
   "key": "ep_ruri02a.txt:928",
   "file": "ep_ruri02a.txt",
   "line": 928,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺は――覇道鋼造でいられるか？",
   "ko_candidate": ""
  },
  {
   "id": 50823,
   "key": "ep_ruri02a.txt:929",
   "file": "ep_ruri02a.txt",
   "line": 929,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "彼女を前にして、育ってゆく彼女を目の当たりにして、それでもずっと、覇道鋼造でいられるのか？",
   "ko_candidate": ""
  },
  {
   "id": 50824,
   "key": "ep_ruri02a.txt:930",
   "file": "ep_ruri02a.txt",
   "line": 930,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺は――戦い続けることが出来るのか？",
   "ko_candidate": ""
  },
  {
   "id": 50825,
   "key": "ep_ruri02a.txt:932",
   "file": "ep_ruri02a.txt",
   "line": 932,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瞳を閉じる。 心の中で思い返す。",
   "ko_candidate": "시간이 멈춘 방에서――"
  },
  {
   "id": 50826,
   "key": "ep_ruri02a.txt:934",
   "file": "ep_ruri02a.txt",
   "line": 934,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "この時間が始まる前のこと。",
   "ko_candidate": ""
  },
  {
   "id": 50827,
   "key": "ep_ruri02a.txt:935",
   "file": "ep_ruri02a.txt",
   "line": 935,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "輪廻する以前の、世界の出来事だ。",
   "ko_candidate": ""
  },
  {
   "id": 50828,
   "key": "ep_ruri02a.txt:936",
   "file": "ep_ruri02a.txt",
   "line": 936,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その世界で俺は彼女と出会い――そして。",
   "ko_candidate": ""
  },
  {
   "id": 50829,
   "key": "ep_ruri02a.txt:942",
   "file": "ep_ruri02a.txt",
   "line": 942,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの世界の覇道鋼造はどうだったのか？",
   "ko_candidate": ""
  },
  {
   "id": 50830,
   "key": "ep_ruri02a.txt:943",
   "file": "ep_ruri02a.txt",
   "line": 943,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "出会ったことも無い、男のことを思う。 覇道鋼造。",
   "ko_candidate": "「……정말､ 네 녀석은아아아!」"
  },
  {
   "id": 50831,
   "key": "ep_ruri02a.txt:945",
   "file": "ep_ruri02a.txt",
   "line": 945,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大十字九郎。 前回の俺。",
   "ko_candidate": "빛의 입자는 증식하고――"
  },
  {
   "id": 50832,
   "key": "ep_ruri02a.txt:947",
   "file": "ep_ruri02a.txt",
   "line": 947,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "お前は、覇道鋼造で居られたか？ ――居られたはずだ。",
   "ko_candidate": "「조용히 있으면 마음대로 지껄이는 거냐､ 꼬마야아아――――!」"
  },
  {
   "id": 50833,
   "key": "ep_ruri02a.txt:953",
   "file": "ep_ruri02a.txt",
   "line": 953,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だから、俺たちが巡り愛った。",
   "ko_candidate": ""
  },
  {
   "id": 50834,
   "key": "ep_ruri02a.txt:954",
   "file": "ep_ruri02a.txt",
   "line": 954,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "前回の覇道鋼造は……きっと今までの覇道鋼造と同様、彼女の未来を切り拓く為、気高く戦えたはずなのだ。",
   "ko_candidate": ""
  },
  {
   "id": 50835,
   "key": "ep_ruri02a.txt:956",
   "file": "ep_ruri02a.txt",
   "line": 956,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だから、大丈夫だ。",
   "ko_candidate": ""
  },
  {
   "id": 50836,
   "key": "ep_ruri02a.txt:957",
   "file": "ep_ruri02a.txt",
   "line": 957,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺は覇道鋼造で居られる。",
   "ko_candidate": ""
  },
  {
   "id": 50837,
   "key": "ep_ruri02a.txt:958",
   "file": "ep_ruri02a.txt",
   "line": 958,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "揺らがず、迷わず、覇道鋼造で居られる。",
   "ko_candidate": ""
  },
  {
   "id": 50838,
   "key": "ep_ruri02a.txt:959",
   "file": "ep_ruri02a.txt",
   "line": 959,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして彼女の未来を切り拓く為、魔を断つ総ての力を蓄える。",
   "ko_candidate": ""
  },
  {
   "id": 50839,
   "key": "ep_ruri02a.txt:960",
   "file": "ep_ruri02a.txt",
   "line": 960,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして、託そう。 未来の戦士達へと。",
   "ko_candidate": "――섬광이 폭발했다｡"
  },
  {
   "id": 50840,
   "key": "ep_ruri02a.txt:962",
   "file": "ep_ruri02a.txt",
   "line": 962,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつかは辿り着く勝利を掴む者達へ。 俺の持てる、力の総てを。",
   "ko_candidate": "어디서 솟아났는지､ 흩날리고､ 바람도 없는데 소용돌이치는 종이 조각｡"
  },
  {
   "id": 50841,
   "key": "ep_ruri02a.txt:970",
   "file": "ep_ruri02a.txt",
   "line": 970,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "現在、地下基地建造計画は静かに進行している。",
   "ko_candidate": ""
  },
  {
   "id": 50842,
   "key": "ep_ruri02a.txt:971",
   "file": "ep_ruri02a.txt",
   "line": 971,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして極秘裏に造られた格納庫に――アリゾナから回収したデモンベインが眠っている。",
   "ko_candidate": ""
  },
  {
   "id": 50843,
   "key": "ep_ruri02a.txt:972",
   "file": "ep_ruri02a.txt",
   "line": 972,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "魔を断つ剣は彼女に託され――そして彼女の手で、彼女を護る戦士へと手渡されるのだ。",
   "ko_candidate": ""
  },
  {
   "id": 50844,
   "key": "ep_ruri02a.txt:977",
   "file": "ep_ruri02a.txt",
   "line": 977,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "彼女は、そこで大ポカをやらかす。",
   "ko_candidate": ""
  },
  {
   "id": 50845,
   "key": "ep_ruri02a.txt:984",
   "file": "ep_ruri02a.txt",
   "line": 984,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "剣を渡したのは、よりにもよって、いい加減で自分勝手極まる、どこの馬の骨とも知れぬ小僧なのだ。",
   "ko_candidate": ""
  },
  {
   "id": 50846,
   "key": "ep_ruri02a.txt:985",
   "file": "ep_ruri02a.txt",
   "line": 985,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そいつは彼女に散々迷惑をかけて、散々怒らせて、それでも懲りずに迷惑をかけ続ける。そういう事になっている。",
   "ko_candidate": ""
  },
  {
   "id": 50847,
   "key": "ep_ruri02a.txt:990",
   "file": "ep_ruri02a.txt",
   "line": 990,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だけど、どうか勘弁してやって欲しい。",
   "ko_candidate": ""
  },
  {
   "id": 50848,
   "key": "ep_ruri02a.txt:997",
   "file": "ep_ruri02a.txt",
   "line": 997,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そいつは、どうしようもなくいい加減で自分勝手でどこの馬の骨とも知らない小僧には違いないが――悪を憎む心は本物だから。",
   "ko_candidate": ""
  },
  {
   "id": 50849,
   "key": "ep_ruri02a.txt:998",
   "file": "ep_ruri02a.txt",
   "line": 998,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "君から未来を奪う邪悪を、決して赦したりはしないから。",
   "ko_candidate": ""
  },
  {
   "id": 50850,
   "key": "ep_ruri02a.txt:999",
   "file": "ep_ruri02a.txt",
   "line": 999,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そしていつか必ず、君の未来を切り拓く――俺はそう信じてる。",
   "ko_candidate": ""
  },
  {
   "id": 50851,
   "key": "ep_ruri02a.txt:1004",
   "file": "ep_ruri02a.txt",
   "line": 1004,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は病室の前に立った。 これから俺は再び、覇道鋼造になる。",
   "ko_candidate": "소용돌이 중앙､ 마도서의 단편은 겹쳐져､ 수렴한다｡"
  },
  {
   "id": 50852,
   "key": "ep_ruri02a.txt:1006",
   "file": "ep_ruri02a.txt",
   "line": 1006,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして最期まで、覇道鋼造であり続ける。 だけど、今は。",
   "ko_candidate": "몸을 만드는 종이 조각｡"
  }
 ]
}