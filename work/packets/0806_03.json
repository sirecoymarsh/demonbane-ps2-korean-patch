   "key": "D0806al.txt:805",
   "file": "D0806al.txt",
   "line": 805,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "怒声と共に魔力がスパークした。",
   "ko_candidate": "분노의 외침과 함께 알의 몸에서 스파크가 일었다｡"
