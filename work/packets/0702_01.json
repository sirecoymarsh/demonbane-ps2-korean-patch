  {
   "id": 8318,
   "key": "D0702.txt:304",
   "file": "D0702.txt",
   "line": 304,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「きゃっ！」",
   "ko_candidate": "「꺄! ……???」"
  },
  {
   "id": 8319,
   "key": "D0702.txt:313",
   "file": "D0702.txt",
   "line": 313,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しまった。いつの間にか完全に完璧にごくごく自然に一点の疑いもなく一緒になって遊んでいた。遊びまくっていた。",
   "ko_candidate": "아차｡ 어느새､ 완전히 완벽하게 극히 자연스럽게 한 치의 의심도 없이､ 함께 놀고 있었다｡ 놀고 있었다고｡"
  },
  {
   "id": 8320,
   "key": "D0702.txt:317",
   "file": "D0702.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "見事なまでに、 こいつらのペースに乗せられてしまっている。",
   "ko_candidate": "보기 좋게､ 이 녀석들의 페이스에 말려들어 버렸다｡"
  },
  {
   "id": 8321,
   "key": "D0702.txt:327",
   "file": "D0702.txt",
   "line": 327,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……どうしたの？　飽きたなら、 ビーチバレーでもする？」",
   "ko_candidate": "「……왜 그래? 질렸으면､ 비치발리볼이라도 할까?」"
  },
  {
   "id": 8322,
   "key": "D0702.txt:333",
   "file": "D0702.txt",
   "line": 333,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうじゃなくて」",
   "ko_candidate": "「그게 아니라」"
  },
  {
   "id": 8323,
   "key": "D0702.txt:352",
   "file": "D0702.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "このままでは、いけない。",
   "ko_candidate": "이대로는､ 안 된다｡"
  },
  {
   "id": 8324,
   "key": "D0702.txt:355",
   "file": "D0702.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いくらヤル気が出ないとは言え、仕事は仕事。",
   "ko_candidate": "아무리 의욕이 안 난다고 해도､ 일은 일｡"
  },
  {
   "id": 8325,
   "key": "D0702.txt:356",
   "file": "D0702.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "引き受けた以上は、真面目にやらにゃあならん。",
   "ko_candidate": "맡은 이상은､ 진지하게 해야만 해｡"
  },
  {
   "id": 8326,
   "key": "D0702.txt:359",
   "file": "D0702.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こんなことをしている場合ではないのだ。",
   "ko_candidate": "이런 짓을 하고 있을 때가 아니야｡"
  },
  {
   "id": 8327,
   "key": "D0702.txt:364",
   "file": "D0702.txt",
   "line": 364,
   "speaker": "九郎 / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル！　仕事に戻るぞ！ 遊んでいる場合じゃねぇ！」 「ハァ～？」",
   "ko_candidate": "「알! 일로 돌아가자! 놀고 있을 때가 아니야!」"
  },
  {
   "id": 8328,
   "key": "D0702.txt:376",
   "file": "D0702.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルは不満そうな不服そうな不機嫌そうな 心底かったるそうなやってらんねぇ～つー表情で、",
   "ko_candidate": "내가 말하자､ 알은 불만스러운 듯한 불복스러운 듯한 불쾌한 듯한 속으로 짜증난다는 듯한 '이딴 거 못해먹겠다~' 하는 표정으로､ 나를 노려보았다｡"
  },
  {
   "id": 8329,
   "key": "D0702.txt:378",
   "file": "D0702.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺を睨み返した。 ――こいつ、徹底的にヤル気がねえ。",
   "ko_candidate": "――이 녀석､ 철저하게 의욕이 없어｡"
  },
  {
   "id": 8330,
   "key": "D0702.txt:391",
   "file": "D0702.txt",
   "line": 391,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……どうした、唐突に真面目になりおって？　あれほどやる気がなさそうだったのに」",
   "ko_candidate": "「……왜 그래､ 갑자기 진지해져서? 그렇게나 의욕이 없어 보였는데」"
  },
  {
   "id": 8331,
   "key": "D0702.txt:397",
   "file": "D0702.txt",
   "line": 397,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いい加減、 真面目にやらんとまた姫さんにどやされる」",
   "ko_candidate": "「확실히 몸은 힘들지만 말이야…… 하지만､ 이제 슬슬 진지하게 하지 않으면 또 공주님한테 혼날 거야」"
  },
  {
   "id": 8332,
   "key": "D0702.txt:407",
   "file": "D0702.txt",
   "line": 407,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「むっ……なんで汝はあの小娘に弱いのだ。しっかりせんと、これからもずっと嘗められっ放しだぞ」",
   "ko_candidate": "「흠…… 왜 너는 그 꼬마 아가씨한테 약한 거냐｡ 정신 차리지 않으면､ 앞으로도 계속 무시당할 거다」"
  },
  {
   "id": 8333,
   "key": "D0702.txt:413",
   "file": "D0702.txt",
   "line": 413,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……こちとら一介の私立探偵。向こうは依頼人にして大財閥の総帥様だ。格が違い過ぎるわいっ」",
   "ko_candidate": "「……이쪽은 그저 일개 사립탐정｡ 저쪽은 의뢰인이자 대재벌의 총수님이시다｡ 격이 너무 다르다고」"
  },
  {
   "id": 8334,
   "key": "D0702.txt:422",
   "file": "D0702.txt",
   "line": 422,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「下らん。世俗の柵なんぞに 囚われおって」",
   "ko_candidate": "「하찮군｡ 세속의 울타리 따위에 갇혀서」"
  },
  {
   "id": 8335,
   "key": "D0702.txt:429",
   "file": "D0702.txt",
   "line": 429,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こちとら端から、 人間の枠組みでしか生きられない凡俗の身だよッ」 「だいたい、お前だって 今回の件が気になるって言ってたろう？」",
   "ko_candidate": "「이쪽은 애초부터､ 인간의 틀 안에서밖에 살 수 없는､ 평범한 신분이라고…… 그리고 말이다｡ 너도 이번 일이 신경 쓰인다고 했잖아?」"
  },
  {
   "id": 8336,
   "key": "D0702.txt:441",
   "file": "D0702.txt",
   "line": 441,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふん、大体は見当が付いた」",
   "ko_candidate": "「흥､ 대충은 짐작이 갔다」"
  },
  {
   "id": 8337,
   "key": "D0702.txt:446",
   "file": "D0702.txt",
   "line": 446,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「はぁ？」",
   "ko_candidate": "「하아?」"
  },
  {
   "id": 8338,
   "key": "D0702.txt:450",
   "file": "D0702.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何だか今、さらりと重大なことを言ったような。",
   "ko_candidate": "뭔가 지금､ 아주 중대한 말을 한 것 같은데｡"
  },
  {
   "id": 8339,
   "key": "D0702.txt:455",
   "file": "D0702.txt",
   "line": 455,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……って、どういう意味だよ？」",
   "ko_candidate": "「……그게 무슨 뜻이야?」"
  },
  {
   "id": 8340,
   "key": "D0702.txt:464",
   "file": "D0702.txt",
   "line": 464,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「分からんのか？」",
   "ko_candidate": "「모르겠나?」"
  },
  {
   "id": 8341,
   "key": "D0702.txt:471",
   "file": "D0702.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "挑発的な瞳を俺に向け、 意地悪げな笑みを浮かべるアル。",
   "ko_candidate": "도발적인 눈동자를 나에게 향하며､ 심술궂은 미소를 띠는 알｡"
  },
  {
   "id": 8342,
   "key": "D0702.txt:474",
   "file": "D0702.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分からんかと訊かれても……まったく分からないから、調べようと思っているんだが。",
   "ko_candidate": "모르겠냐고 물어봐도…… 전혀 모르니까､ 조사하려고 하는 거잖아｡ 「츄릅츄릅」"
  },
  {
   "id": 8343,
   "key": "D0702.txt:481",
   "file": "D0702.txt",
   "line": 481,
   "speaker": "ダンセイニ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「てけり・り」",
   "ko_candidate": "「와~이 와~이!」"
  },
  {
   "id": 8344,
   "key": "D0702.txt:487",
   "file": "D0702.txt",
   "line": 487,
   "speaker": "ジョージ＆コリン＆アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「「わーいわーい！」」」 いつの間にかダンセイニと戯れているガキんちょどもを尻目に、呟くようにアルは言った。",
   "ko_candidate": "어느새 던세이니와 장난치고 있는 꼬맹이들을 뒤로하고､ 중얼거리듯 알은 말했다｡"
  },
  {
   "id": 8345,
   "key": "D0702.txt:502",
   "file": "D0702.txt",
   "line": 502,
   "speaker": "アル / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「辺りに漂う闇の匂いで判る。此処はただの海ではあるまい。今は人間が放つ陽の気によって、清められてはいるが」 「闇の匂い？ おいおい……そりゃどういう意味――」",
   "ko_candidate": "「주변에 떠도는 어둠의 냄새로 알 수 있다｡ 여기는 그저 바다가 아닐 거다｡ 하지만､ 지금은 인간이 내뿜는 양의 기운으로 인해､ 정화되어 있지만 말이다」"
  },
  {
   "id": 8346,
   "key": "D0702.txt:525",
   "file": "D0702.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……何だか本気でどうでも良くなってきた。 俺は肩を落とし、大仰に溜め息をついた。",
   "ko_candidate": "「어둠의 냄새? 이봐이봐…… 그게 무슨 뜻――」"
  },
  {
   "id": 8347,
   "key": "D0702.txt:536",
   "file": "D0702.txt",
   "line": 536,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だ、もう疲れたのか？ 我が主ながら情けない」",
   "ko_candidate": "추궁하려고 했던､ 그때였다｡ 퐁당､ 퐁당｡"
  },
  {
   "id": 8348,
   "key": "D0702.txt:543",
   "file": "D0702.txt",
   "line": 543,
   "speaker": "ダンセイニ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ほっといてくれ。 「てけり・り」",
   "ko_candidate": "트로피컬한 색채의 비치볼이､ 우리 발밑까지 굴러왔다｡"
  },
  {
   "id": 8349,
   "key": "D0702.txt:561",
   "file": "D0702.txt",
   "line": 561,
   "speaker": "ジョージ＆コリン＆アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「「わーいわーい！」」」 ガキんちょどもはダンセイニと戯れている。",
   "ko_candidate": "「음~?」"
  },
  {
   "id": 8350,
   "key": "D0702.txt:568",
   "file": "D0702.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無駄に元気で、ヒジョーに羨ましい。 ぽてん、ぽてん。",
   "ko_candidate": "라이카 씨가 공의 주인을 찾아､ 주위를 두리번두리번 살펴본다｡"
  },
  {
   "id": 8351,
   "key": "D0702.txt:589",
   "file": "D0702.txt",
   "line": 589,
   "speaker": "ライカ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "トロピカルな色彩のビーチボールが、俺たちの足元に転がってきた。 「んー？」",
   "ko_candidate": "멀리서､ 손을 흔들며 달려오는 무리가 있었다｡"
  },
  {
