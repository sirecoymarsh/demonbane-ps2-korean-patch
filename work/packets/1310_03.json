 "items": [
  {
   "id": 34722,
   "key": "D1310le.txt:106",
   "file": "D1310le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音速で飛来するそれを、ベルゼビュートは間一髪避ける。",
   "ko_candidate": "음속으로 날아오는 그것을､ 벨제뷰트는 간발의 차로 피한다｡"
  },
  {
   "id": 34723,
   "key": "D1310le.txt:107",
   "file": "D1310le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通り過ぎる衝撃波だけで、ベルゼビュートの装甲は抉れ、罅割れた。",
   "ko_candidate": "지나가는 충격파만으로도､ 벨제뷰트의 장갑은 파이고､ 금이 갔다｡"
  },
  {
   "id": 34724,
   "key": "D1310le.txt:111",
   "file": "D1310le.txt",
   "line": 111,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あの、裏切り者がぁぁぁぁぁ！」",
   "ko_candidate": "「저､ 배신자가아아아아아아!」"
  },
  {
   "id": 34725,
   "key": "D1310le.txt:114",
   "file": "D1310le.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分のやったことは棚に上げ、随分と勝手なことをホザいている。",
   "ko_candidate": "자기가 한 짓은 까맣게 잊고､ 제법 제멋대로 지껄이고 있다｡"
  },
  {
   "id": 34726,
   "key": "D1310le.txt:115",
   "file": "D1310le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが奴らのイザコザなんて、どうだって良い。",
   "ko_candidate": "하지만 그들의 다툼 따위는､ 어찌 되든 상관없다｡"
  },
  {
   "id": 34727,
   "key": "D1310le.txt:116",
   "file": "D1310le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重要なのは――",
   "ko_candidate": "중요한 건――"
  },
  {
   "id": 34728,
   "key": "D1310le.txt:119",
   "file": "D1310le.txt",
   "line": 119,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「隙だらけだぜ！　ティベリウス！」",
   "ko_candidate": "「허점투성이야! 티베리우스!」"
  },
  {
   "id": 34729,
   "key": "D1310le.txt:123",
   "file": "D1310le.txt",
   "line": 123,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベイン！」",
   "ko_candidate": "「데몬베인!」"
  },
  {
   "id": 34730,
   "key": "D1310le.txt:130",
   "file": "D1310le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２基の脚部シールド、ティマイオスとクリティアスが起動する。",
   "ko_candidate": "2기의 다리부 실드､ 티마이오스와 크리티오스가 가동된다｡"
  },
  {
   "id": 34731,
   "key": "D1310le.txt:132",
   "file": "D1310le.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時空間を歪ませて、その反作用エネルギーを獲得。",
   "ko_candidate": "시공간을 왜곡시켜､ 그 반작용 에너지를 획득한다｡"
  },
  {
   "id": 34732,
   "key": "D1310le.txt:134",
   "file": "D1310le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それにより得られる重力制御能力を、全て破壊の為に注ぎ込む。",
   "ko_candidate": "그로 인해 얻어지는 중력 제어 능력을､ 모두 파괴를 위해 쏟아붓는다｡"
  },
  {
   "id": 34733,
   "key": "D1310le.txt:135",
   "file": "D1310le.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これこそ、デモンベインの必殺キック、アトランティス・ストライク",
   "ko_candidate": "이것이야말로､ 데몬베인의 필살 킥､ 아틀란티스 스트라이크"
  },
  {
   "id": 34734,
   "key": "D1310le.txt:139",
   "file": "D1310le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次元の収縮拡張よりエネルギー漏れが生じ、迸る紫電がキックの軌跡をなぞる。雷光を纏う破壊槌がベルゼビュートに向かって振り上げられる。",
   "ko_candidate": "차원의 수축 팽창으로 에너지 누출이 일어나､ 솟구치는 자색 번개가 킥의 궤적을 따라간다｡ 번개를 두른 파괴의 망치가 벨제뷰트를 향해 들어 올려진다｡"
  },
  {
   "id": 34735,
   "key": "D1310le.txt:141",
   "file": "D1310le.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間が爆砕した。",
   "ko_candidate": "공간이 폭쇄됐다｡"
  },
  {
   "id": 34736,
   "key": "D1310le.txt:161",
   "file": "D1310le.txt",
   "line": 161,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぅあああああああ！」",
   "ko_candidate": "「그우아아아아아아아!」"
  },
  {
   "id": 34737,
   "key": "D1310le.txt:164",
   "file": "D1310le.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "特殊金属の装甲がたわみ、窪み、抉れ、砕ける。",
   "ko_candidate": "특수 금속 장갑이 휘고､ 움푹 패이고､ 파이고､ 부서진다｡"
  },
  {
   "id": 34738,
   "key": "D1310le.txt:166",
   "file": "D1310le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破損箇所から水銀の血と、瘴気が霧を吹いた。",
   "ko_candidate": "파손된 부위에서 수은 같은 피와､ 독기가 안개처럼 뿜어져 나왔다｡"
  },
  {
   "id": 34739,
   "key": "D1310le.txt:168",
   "file": "D1310le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "百トンの巨体が、空を舞う。",
   "ko_candidate": "백 톤의 거체가､ 하늘을 날았다｡"
  },
  {
   "id": 34740,
   "key": "D1310le.txt:169",
   "file": "D1310le.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地響きがビリビリと大気をも震わせる。",
   "ko_candidate": "땅울림이 찌릿찌릿 대기마저 흔든다｡"
  },
  {
   "id": 34741,
   "key": "D1310le.txt:170",
   "file": "D1310le.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "土煙が上がった。視界が閉ざされる。",
   "ko_candidate": "흙먼지가 올랐다｡ 시야가 차단된다｡"
  },
  {
   "id": 34742,
   "key": "D1310le.txt:177",
   "file": "D1310le.txt",
   "line": 177,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！　高魔力源反応！」",
   "ko_candidate": "「――――! 고마력원 반응!」"
  },
  {
   "id": 34743,
   "key": "D1310le.txt:183",
   "file": "D1310le.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "土煙を裂いて、何かが飛びかかって来た。",
   "ko_candidate": "흙먼지를 가르고､ 무언가가 달려들어 왔다｡"
  },
  {
   "id": 34744,
   "key": "D1310le.txt:184",
   "file": "D1310le.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反射的に右腕を前に出し、機体を庇う。",
   "ko_candidate": "반사적으로 오른팔을 앞으로 내밀어､ 기체를 감싼다｡"
  },
  {
   "id": 34745,
   "key": "D1310le.txt:191",
   "file": "D1310le.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右腕に何かがしがみついた。",
   "ko_candidate": "오른팔에 무언가가 달라붙었다｡"
  },
  {
   "id": 34746,
   "key": "D1310le.txt:194",
   "file": "D1310le.txt",
   "line": 194,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「星型!?」",
   "ko_candidate": "「별 모양!?」"
  },
  {
   "id": 34747,
   "key": "D1310le.txt:199",
   "file": "D1310le.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "以前にも見た、謎の星型円盤だ。",
   "ko_candidate": "전에도 본 적 있는､ 수수께끼의 별 모양 원반이다｡"
  },
  {
   "id": 34748,
   "key": "D1310le.txt:200",
   "file": "D1310le.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "５本の脚（？）をデモンベインの腕に絡め、密着するその様は、ヒトデのようにも見える。",
   "ko_candidate": "5개의 다리(?)를 데몬베인의 팔에 감고､ 밀착하는 그 모습은､ 불가사리처럼도 보인다｡"
  },
  {
   "id": 34749,
   "key": "D1310le.txt:211",
   "file": "D1310le.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅く、不気味に輝き出す。",
   "ko_candidate": "붉게､ 섬뜩하게 빛나기 시작한다｡"
  },
  {
   "id": 34750,
   "key": "D1310le.txt:212",
   "file": "D1310le.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "途端、デモンベインの異常に気付いた。",
   "ko_candidate": "순간､ 데몬베인의 이상을 깨달았다｡"
  },
  {
   "id": 34751,
   "key": "D1310le.txt:216",
   "file": "D1310le.txt",
   "line": 216,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「出力が下がっている！　此奴、魔力を吸うぞ！」",
   "ko_candidate": "「출력이 떨어지고 있어! 이놈､ 마력을 빨아들이고 있어!」"
  },
  {
   "id": 34752,
   "key": "D1310le.txt:223",
   "file": "D1310le.txt",
   "line": 223,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふっ、ざけるなぁ！　クトゥグア！」",
   "ko_candidate": "「훗､ 장난하지 마! 크투가!」"
  },
  {
   "id": 34753,
   "key": "D1310le.txt:233",
   "file": "D1310le.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔銃を左掌に招喚。星型を撃つ。",
   "ko_candidate": "마총을 왼손바닥에 소환｡ 별 모양을 쏜다｡"
  },
  {
   "id": 34754,
   "key": "D1310le.txt:234",
   "file": "D1310le.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声が轟き――",
   "ko_candidate": "총성이 울리고――"
  },
  {
   "id": 34755,
   "key": "D1310le.txt:241",
   "file": "D1310le.txt",
   "line": 241,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「っ!?　拙い！」",
   "ko_candidate": "「윽!? 실수했어!」"
  },
  {
   "id": 34756,
   "key": "D1310le.txt:245",
   "file": "D1310le.txt",
   "line": 245,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？」",
   "ko_candidate": "「엣?」"
  },
  {
   "id": 34757,
   "key": "D1310le.txt:255",
   "file": "D1310le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こちらの想像を遥かに超える、大爆発が巻き起こった。",
   "ko_candidate": "우리의 상상을 훨씬 뛰어넘는､ 대폭발이 일어났다｡"
  },
  {
   "id": 34758,
   "key": "D1310le.txt:256",
   "file": "D1310le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右腕を起点に爆裂した衝撃は、激烈にデモンベインを吹き飛ばす！",
   "ko_candidate": "오른팔을 기점으로 폭발한 충격은､ 격렬하게 데몬베인을 날려버린다!"
  },
  {
   "id": 34759,
   "key": "D1310le.txt:266",
   "file": "D1310le.txt",
   "line": 266,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……ティマイオス！　クリティアス！」",
   "ko_candidate": "「큿……티마이오스! 크리티오스!」"
  },
  {
   "id": 34760,
   "key": "D1310le.txt:275",
   "file": "D1310le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚部シールド解放。重力制御。",
   "ko_candidate": "다리부 실드 해방｡ 중력 제어｡"
  },
  {
   "id": 34761,
   "key": "D1310le.txt:276",
   "file": "D1310le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き飛ぶデモンベインは、ゆるやかに弧を描がきつつ、空中でバク転。",
   "ko_candidate": "날아가는 데몬베인은､ 완만한 호를 그리며､ 공중에서 백 턴｡"
  }
 ]
}