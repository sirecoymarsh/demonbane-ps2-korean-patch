   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインが一歩を踏み出す。",
   "ko_candidate": "데몬베인이 한 걸음을 내딛는다｡"
  },
  {
   "id": 33797,
