  {
   "id": 16262,
   "key": "D0812le.txt:374",
   "file": "D0812le.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それを引鉄に総ては動き出した！",
   "ko_candidate": "그것을 방아쇠로 모든 것이 움직이기 시작했다!"
