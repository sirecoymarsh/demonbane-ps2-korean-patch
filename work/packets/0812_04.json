  {
   "id": 16261,
   "key": "D0812le.txt:373",
   "file": "D0812le.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんが叫ぶ。",
   "ko_candidate": "라이카 씨가 외친다｡"
