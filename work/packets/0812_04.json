  {
   "id": 16263,
   "key": "D0812le.txt:384",
   "file": "D0812le.txt",
   "line": 384,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ガアアアアアアア！」",
   "ko_candidate": "「가아아아아아아!」"
