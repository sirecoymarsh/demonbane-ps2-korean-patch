  {
   "id": 16258,
   "key": "D0812le.txt:364",
   "file": "D0812le.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "落ち着けよ、大十字九郎。",
