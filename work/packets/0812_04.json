  {
   "id": 16257,
   "key": "D0812le.txt:363",
   "file": "D0812le.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "落ち着け。",
