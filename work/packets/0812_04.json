   "key": "D0812le.txt:357",
   "file": "D0812le.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "視線を絶え間なく巡らせて、最初に動くのは何かを見極める。",
