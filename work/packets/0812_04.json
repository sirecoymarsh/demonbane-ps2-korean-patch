  {
   "id": 16260,
   "key": "D0812le.txt:370",
   "file": "D0812le.txt",
   "line": 370,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎ちゃんっ！」",
   "ko_candidate": "「…쿠로 군!」"
