   "key": "D0812le.txt:359",
   "file": "D0812le.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何一つ見落とせない。",
   "ko_candidate": "단 하나도 놓칠 수 없다｡"
