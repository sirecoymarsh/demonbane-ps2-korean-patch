 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "エンネア": "엔네아",
  "ルルイエ異本": "르뤼에 이본",
  "ルルイエ": "르뤼에",
  "クトゥルー": "크툴루"
 },
 "items": [
  {
   "id": 39980,
   "key": "D1413al.txt:4",
   "file": "D1413al.txt",
   "line": 4,
   "speaker": "ルルイエ異本",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くするぅ……ら・いらー……」",
   "ko_candidate": "「크트르으…… 라?이라……」"
  },
  {
   "id": 39981,
   "key": "D1413al.txt:7",
   "file": "D1413al.txt",
   "line": 7,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エンネアの背後、 コクピットの奥から再び触手が湧いてきた。",
   "ko_candidate": "에네아의 뒤편､ 콕핏 안쪽에서 다시 촉수가 솟아올랐다｡"
  },
  {
   "id": 39982,
   "key": "D1413al.txt:9",
   "file": "D1413al.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その触手は、一人の少女を拘束している。",
   "ko_candidate": "그 촉수는 한 소녀를 구속하고 있다｡"
  },
  {
   "id": 39983,
   "key": "D1413al.txt:11",
   "file": "D1413al.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左右色違いの瞳――『ルルイエ異本』。",
   "ko_candidate": "좌우 색이 다른 눈동자―― 『르뤼에 이본』｡"
  },
  {
   "id": 39984,
   "key": "D1413al.txt:12",
   "file": "D1413al.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "触手の群れは、エンネアの前まで『ルルイエ異本』の 少女を連れてきた。",
   "ko_candidate": "촉수 무리는 에네아의 앞까지 『르뤼에 이본』의 소녀를 데려왔다｡"
  },
  {
   "id": 39985,
   "key": "D1413al.txt:18",
   "file": "D1413al.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "エンネアが呪文を唱え続ける。",
   "ko_candidate": "에네아가 주문을 계속 외운다｡"
  },
  {
   "id": 39986,
   "key": "D1413al.txt:19",
   "file": "D1413al.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それに呼応するかの如く、 『ルルイエ異本』の躰が何度も跳ねた。",
   "ko_candidate": "그에 호응하듯이 『르뤼에 이본』의 몸이 몇 번이고 튀어 올랐다｡"
  },
  {
   "id": 39987,
   "key": "D1413al.txt:22",
   "file": "D1413al.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪文の声音が高くなる。",
   "ko_candidate": "주문의 목소리가 높아진다｡"
  },
  {
   "id": 39988,
   "key": "D1413al.txt:23",
   "file": "D1413al.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに合わせて、『ルルイエ異本』の痙攣も",
   "ko_candidate": "그에 맞춰 『르뤼에 이본』의 경련도 격렬해진다｡"
  },
  {
   "id": 39989,
   "key": "D1413al.txt:24",
   "file": "D1413al.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "激しくなる。",
   "ko_candidate": "무엇을――!?"
  },
  {
   "id": 39990,
   "key": "D1413al.txt:26",
   "file": "D1413al.txt",
   "line": 26,
   "speaker": "ルルイエ異本",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何を――!? 「アアアアアアアアァァァァァ――――――――――――――――――――！」",
   "ko_candidate": "「아아아아아아아아아아아아――――――――――――――――――――!」"
  },
  {
   "id": 39991,
   "key": "D1413al.txt:33",
   "file": "D1413al.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咆吼。",
   "ko_candidate": "포효｡"
  },
  {
   "id": 39992,
   "key": "D1413al.txt:35",
   "file": "D1413al.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "エンネアが冷笑を浮かべて、呟いた。",
   "ko_candidate": "에네아가 냉소를 띠며 중얼거렸다｡"
  },
  {
   "id": 39993,
   "key": "D1413al.txt:42",
   "file": "D1413al.txt",
   "line": 42,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「制御を……無くすんだよ」",
   "ko_candidate": "「제어를…… 잃게 하는 거야」"
  },
  {
   "id": 39994,
   "key": "D1413al.txt:46",
   "file": "D1413al.txt",
   "line": 46,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッッ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 39995,
   "key": "D1413al.txt:49",
   "file": "D1413al.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咆吼はやがて断末魔に変わった。",
   "ko_candidate": "포효는 이윽고 단말마로 바뀌었다｡"
  },
  {
   "id": 39996,
   "key": "D1413al.txt:50",
   "file": "D1413al.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女の躰が、ページになって解け、 ページは光の粒子となって散ってゆく。",
   "ko_candidate": "소녀의 몸이 페이지가 되어 녹아내리고､ 페이지는 빛의 입자가 되어 흩어져 간다｡"
  },
  {
   "id": 39997,
   "key": "D1413al.txt:52",
   "file": "D1413al.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――神は、暴走した。",
   "ko_candidate": "그리고―― 신은 폭주했다｡"
  },
  {
   "id": 39998,
   "key": "D1413al.txt:62",
   "file": "D1413al.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "制御を失えば、ただひたすらに暴走する。",
   "ko_candidate": "제어를 잃으면 오로지 폭주할 뿐이다｡"
  },
  {
   "id": 39999,
   "key": "D1413al.txt:68",
   "file": "D1413al.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "情報は錯乱し、神を器に止めておく構成は壊れ、神の細胞は止まることなく増殖していく。それはまるで癌細胞の如く。",
   "ko_candidate": "정보는 착란하고､ 신을 그릇에 머물게 하는 구성은 무너지며､ 신의 세포는 멈추지 않고 증식해 간다｡ 그것은 마치 암세포와도 같이｡"
  },
  {
   "id": 40000,
   "key": "D1413al.txt:69",
   "file": "D1413al.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大いなる“Ｃ”を蝕む大いなる“Ｃ”。",
   "ko_candidate": "거대한 『C』를 좀먹는 거대한 『C』｡"
  },
  {
   "id": 40001,
   "key": "D1413al.txt:76",
   "file": "D1413al.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ルルイエの海の上、クトゥルーの動きが止まった。",
   "ko_candidate": "르뤼에의 바다 위､ 크툴루의 움직임이 멈췄다｡"
  },
  {
   "id": 40002,
   "key": "D1413al.txt:77",
   "file": "D1413al.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その躰の表面が細かく罅入る。",
   "ko_candidate": "그 몸의 표면이 미세하게 갈라진다｡"
  },
  {
   "id": 40003,
   "key": "D1413al.txt:81",
   "file": "D1413al.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否。これは罅ではなく、閉ざされた無数の瞼と唇。",
   "ko_candidate": "아니｡ 이것은 균열이 아니라 닫힌 무수한 눈꺼풀과 입술｡"
  },
  {
   "id": 40004,
   "key": "D1413al.txt:82",
   "file": "D1413al.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾千、幾万、幾億。",
   "ko_candidate": "수천､ 수만､ 수억｡"
  },
  {
   "id": 40005,
   "key": "D1413al.txt:87",
   "file": "D1413al.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "増殖し、なおも増殖する神の眸が一斉に啓く。",
   "ko_candidate": "증식하고､ 더욱 증식하는 신의 눈동자가 일제히 뜬다｡"
  },
  {
   "id": 40006,
   "key": "D1413al.txt:92",
   "file": "D1413al.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾千、幾万、幾億。",
   "ko_candidate": "수천､ 수만､ 수억｡"
  },
  {
   "id": 40007,
   "key": "D1413al.txt:93",
   "file": "D1413al.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "増殖し、なおも増殖する神の口が一斉に空く。",
   "ko_candidate": "증식하고､ 더욱 증식하는 신의 입이 일제히 벌어진다｡"
  },
  {
   "id": 40008,
   "key": "D1413al.txt:99",
   "file": "D1413al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾千、幾万、幾億の眸が血の涙を流す。",
   "ko_candidate": "수천､ 수만､ 수억의 눈동자가 피눈물을 흘린다｡"
  },
  {
   "id": 40009,
   "key": "D1413al.txt:105",
   "file": "D1413al.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾千、幾万、幾億の口が雄叫びをあげる。",
   "ko_candidate": "수천､ 수만､ 수억의 입이 함성을 지른다｡"
  },
  {
   "id": 40010,
   "key": "D1413al.txt:106",
   "file": "D1413al.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、全身が爆発的に膨れ上がる。",
   "ko_candidate": "그리고 온몸이 폭발적으로 부풀어 오른다｡"
  },
  {
   "id": 40011,
   "key": "D1413al.txt:110",
   "file": "D1413al.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の肉腫が膨れ、肉腫が土台たる身体を覆い尽くし、更にその肉腫の上に新たな肉腫が膨れ上がり、その膨れる肉腫の表面でまた無数の眸と口が咲く。",
   "ko_candidate": "무수한 육종이 부풀어 오르고､ 육종이 토대가 되는 신체를 뒤덮고､ 더욱이 그 육종 위에 새로운 육종이 부풀어 오르며､ 그 부풀어 오르는 육종의 표면에서 또다시 무수한 눈동자와 입이 피어난다｡"
  },
  {
   "id": 40012,
   "key": "D1413al.txt:114",
   "file": "D1413al.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神の肉が、間近にいた艦や海魔を呑み込んでゆく。",
   "ko_candidate": "신의 살이 가까이 있던 함선과 바다괴물을 삼켜간다｡"
  },
  {
   "id": 40013,
   "key": "D1413al.txt:115",
   "file": "D1413al.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでもまだ止まらない。",
   "ko_candidate": "그래도 아직 멈추지 않는다｡"
  },
  {
   "id": 40014,
   "key": "D1413al.txt:120",
   "file": "D1413al.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "流れ続ける血涙は眸が啓くごとに量を増し、 巨大な滝となり、海を血の彩に穢してゆく。",
   "ko_candidate": "계속 흐르는 피눈물은 눈동자가 뜰 때마다 양을 늘려 거대한 폭포가 되어 바다를 피의 색채로 더럽혀간다｡"
  },
  {
   "id": 40015,
   "key": "D1413al.txt:122",
   "file": "D1413al.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "迸る雄叫びは口が開くごとに音量を増し、 巨大な唄となって、世界に輪唱を轟かせる。",
   "ko_candidate": "솟구치는 함성은 입이 열릴 때마다 음량을 늘려 거대한 노래가 되어 세계에 윤창을 울려 퍼뜨린다｡"
  },
  {
   "id": 40016,
   "key": "D1413al.txt:125",
   "file": "D1413al.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――それはまるで、世界最期の日の光景。",
   "ko_candidate": "――그것은 마치 세계 최후의 날의 광경｡"
  },
  {
   "id": 40017,
   "key": "D1413al.txt:141",
   "file": "D1413al.txt",
   "line": 141,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ」",
   "ko_candidate": "「…………읏」"
  },
  {
   "id": 40018,
   "key": "D1413al.txt:144",
   "file": "D1413al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰もが恐怖に竦んで、身動きが取れない。",
   "ko_candidate": "누구나 공포에 움츠러들어 몸을 움직일 수 없다｡"
  },
  {
   "id": 40019,
   "key": "D1413al.txt:145",
   "file": "D1413al.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声１つ出すことすら憚っていた。",
   "ko_candidate": "목소리 하나 내는 것조차 꺼리고 있었다｡"
  }
 ]
}