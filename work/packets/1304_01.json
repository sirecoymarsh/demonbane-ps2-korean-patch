 "items": [
  {
   "id": 31811,
   "key": "D1304al.txt:186",
   "file": "D1304al.txt",
   "line": 186,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どぉぉぉしたの、九郎ちゃん？　そんなとこに這いつくばって？」",
   "ko_candidate": "「어어어어떠신가요､ 쿠로 군? 그런 데서 엎드려 있고?」"
  },
  {
   "id": 31812,
   "key": "D1304al.txt:196",
   "file": "D1304al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悪戦苦闘している間にも、 ベルゼビュートは近づいてくる。",
   "ko_candidate": "악전고투하는 사이에도 벨제뷰트는 다가오고 있다｡"
  },
  {
   "id": 31813,
   "key": "D1304al.txt:198",
   "file": "D1304al.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆっくりとした足取りで、一歩一歩確かめるように。",
   "ko_candidate": "천천히 발걸음으로､ 한 걸음 한 걸음 확인하듯이｡"
  },
  {
   "id": 31814,
   "key": "D1304al.txt:200",
   "file": "D1304al.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くっ……完全に嘗められている！",
   "ko_candidate": "큭……완전히 얕보고 있어!"
  },
  {
   "id": 31815,
   "key": "D1304al.txt:205",
   "file": "D1304al.txt",
   "line": 205,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほら、早く立ち上がりなさーい。 殺し合いにテン・カウントはなくてよ？」",
   "ko_candidate": "「자자､ 빨리 일어나세요｡ 살육전에 텐 카운트 는 없다구요?」"
  },
  {
   "id": 31816,
   "key": "D1304al.txt:211",
   "file": "D1304al.txt",
   "line": 211,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「調子に乗るな、腐乱死体！」",
   "ko_candidate": "「조심해라､ 부패 시체 자식!」"
  },
  {
   "id": 31817,
   "key": "D1304al.txt:218",
   "file": "D1304al.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ムチャクチャに機体を捻り、ムチャクチャな体勢から、ぎこちない足払いを放つ。",
   "ko_candidate": "엉망진창으로 기체를 비틀어､ 엉망진창한 자세에서 어색한 다리 휘두르기를 날린다｡"
  },
  {
   "id": 31818,
   "key": "D1304al.txt:218",
   "file": "D1304al.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悲鳴を上げる機体。次々とシステムにエラーが生じる。無視。",
   "ko_candidate": "비명을 지르는 기체｡ 연이어 시스템에 오류가 발생한다｡ 무시｡"
  },
  {
   "id": 31819,
   "key": "D1304al.txt:218",
   "file": "D1304al.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ムチャクチャでもデタラメでも何でも良い。今は何とか活路を――！",
   "ko_candidate": "엉망진창이라도 되는대로라도 뭐라도 좋다｡ 지금은 어떻게든 활로를――!"
  },
  {
   "id": 31820,
   "key": "D1304al.txt:226",
   "file": "D1304al.txt",
   "line": 226,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アタシが転んだら、瑠璃お嬢ちゃんもペチャンコよん？」",
   "ko_candidate": "「내가 넘어지면､ 루리 아가씨도 펑퍼짐하게 되는 거야?」"
  },
  {
   "id": 31821,
   "key": "D1304al.txt:231",
   "file": "D1304al.txt",
   "line": 231,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――ッ!?」",
   "ko_candidate": "「――!?」"
  },
  {
   "id": 31822,
   "key": "D1304al.txt:241",
   "file": "D1304al.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動揺が動きを鈍らせた。足払いを打ち込むより速く、ベルゼビュートの足が、デモンベインを踏みつけた。",
   "ko_candidate": "동요가 움직임을 둔하게 했다｡ 다리 휘두르기를 날리는 것보다 빠르게､ 벨제뷰트의 발이 데몬베인을 짓밟았다｡"
  },
  {
   "id": 31823,
   "key": "D1304al.txt:244",
   "file": "D1304al.txt",
   "line": 244,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまっ……しくじったっ！」",
   "ko_candidate": "「이런……실수했어!」"
  },
  {
   "id": 31824,
   "key": "D1304al.txt:249",
   "file": "D1304al.txt",
   "line": 249,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おバカさん……オォォォラうりゃうりゃうりゃうりゃうりゃああああ！」",
   "ko_candidate": "「바보 녀석……오오오오라 우랴우랴우랴우랴우랴아아아아!」"
  },
  {
   "id": 31825,
   "key": "D1304al.txt:259",
   "file": "D1304al.txt",
   "line": 259,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐがああああああああああああ！」",
   "ko_candidate": "「으가아아아아아아아아아아아아!」"
  },
  {
   "id": 31826,
   "key": "D1304al.txt:263",
   "file": "D1304al.txt",
   "line": 263,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっぐああああああああああ！」",
   "ko_candidate": "「크으가아아아아아아아아아아아아!」"
  },
  {
   "id": 31827,
   "key": "D1304al.txt:266",
   "file": "D1304al.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サッカーボールキックの連打が浴びせかけられる。",
   "ko_candidate": "축구공 킥의 연타가 퍼부어진다｡"
  },
  {
   "id": 31828,
   "key": "D1304al.txt:275",
   "file": "D1304al.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲が砕かれ、剥がれ、吹き飛ばされ、機体のあちこちから爆炎が上がる。",
   "ko_candidate": "장갑이 부서지고､ 벗겨지고､ 날아가고､ 기체 곳곳에서 폭염이 일어난다｡"
  },
  {
   "id": 31829,
   "key": "D1304al.txt:277",
   "file": "D1304al.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水銀の血が街にバラ撒かれ、破損箇所が放電して、紫電の光を漏らす。",
   "ko_candidate": "수은의 피가 거리에 뿌려지고､ 파손된 곳에서 방전되어 자색 번개의 빛을 새어 나온다｡"
  },
  {
   "id": 31830,
   "key": "D1304al.txt:284",
   "file": "D1304al.txt",
   "line": 284,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さんっ!? ああああああ！　よくも…… お爺様のデモンベインを、 よくも……ッ！」",
   "ko_candidate": "「다이쥬지 씨!? 아아아아아! 어떻게……할아버지의 데몬베인을､ 어떻게……!」"
  },
  {
   "id": 31831,
   "key": "D1304al.txt:291",
   "file": "D1304al.txt",
   "line": 291,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お――ほほほほほほほほほほっ！ 愉快！　愉快よぉぉぉぉ！」",
   "ko_candidate": "「오――호호호호호호호호호호! 유쾌! 유쾌해에에에에!」"
  },
  {
   "id": 31832,
   "key": "D1304al.txt:296",
   "file": "D1304al.txt",
   "line": 296,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐうぅぅぅぅっ！」",
   "ko_candidate": "「크으으으으으!」"
  },
  {
   "id": 31833,
   "key": "D1304al.txt:303",
   "file": "D1304al.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無様に地面を転がって、 ベルゼビュートの蹴りから逃げた。",
   "ko_candidate": "볼품없이 땅을 구르며 벨제뷰트의 발차기에서 도망쳤다｡"
  },
  {
   "id": 31834,
   "key": "D1304al.txt:305",
   "file": "D1304al.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビルを踏み潰して転がりながら、必死に打開策を練る。",
   "ko_candidate": "빌딩을 밟아 부수며 구르면서 필사적으로 타개책을 짜낸다｡"
  },
  {
   "id": 31835,
   "key": "D1304al.txt:307",
   "file": "D1304al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦力差は歴然。",
   "ko_candidate": "전력 차이는 명백하다｡"
  },
  {
   "id": 31836,
   "key": "D1304al.txt:308",
   "file": "D1304al.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかも人質まで捕られて、こっちからは攻撃できない。",
   "ko_candidate": "게다가 인질까지 잡혀서 이쪽에서는 공격할 수 없다｡"
  },
  {
   "id": 31837,
   "key": "D1304al.txt:310",
   "file": "D1304al.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうすれば良い？",
   "ko_candidate": "어떻게 하면 좋지?"
  },
  {
   "id": 31838,
   "key": "D1304al.txt:311",
   "file": "D1304al.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやって、こいつを倒す？",
   "ko_candidate": "어떻게 해서 이놈을 쓰러뜨릴까?"
  },
  {
   "id": 31839,
   "key": "D1304al.txt:312",
   "file": "D1304al.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやって、姫さんを助け出す……!?",
   "ko_candidate": "어떻게 해서 공주님을 구출할까……!?"
  },
  {
   "id": 31840,
   "key": "D1304al.txt:321",
   "file": "D1304al.txt",
   "line": 321,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふ……そろそろトドメとイこうかしらん？」",
   "ko_candidate": "「후후……슬슬 마지막 일격을 가할까?」"
  },
  {
   "id": 31841,
   "key": "D1304al.txt:324",
   "file": "D1304al.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベルゼビュートが掌を翳す。",
   "ko_candidate": "벨제뷰트가 손바닥을 가린다｡"
  },
  {
   "id": 31842,
   "key": "D1304al.txt:325",
   "file": "D1304al.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても、あの圧縮された瘴気の塊が出現した。",
   "ko_candidate": "또다시 그 압축된 장기 덩어리가 출현했다｡"
  },
  {
   "id": 31843,
   "key": "D1304al.txt:326",
   "file": "D1304al.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間を歪ませながら、瘴気は濃度を増してゆく。",
   "ko_candidate": "공간을 일그러뜨리며 장기는 농도를 높여간다｡"
  },
  {
   "id": 31844,
   "key": "D1304al.txt:329",
   "file": "D1304al.txt",
   "line": 329,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……」",
   "ko_candidate": "「큭……」"
  },
  {
   "id": 31845,
   "key": "D1304al.txt:336",
   "file": "D1304al.txt",
   "line": 336,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうするロボ、ダーリン!?」",
   "ko_candidate": "「어떡할 거로봇､ 달링!?」"
  },
  {
   "id": 31846,
   "key": "D1304al.txt:339",
   "file": "D1304al.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が訊きたい。",
   "ko_candidate": "내가 묻고 싶다｡"
  },
  {
   "id": 31847,
   "key": "D1304al.txt:340",
   "file": "D1304al.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ダメージはさっきよりも深刻になっている。",
   "ko_candidate": "데미지는 아까보다 더 심각해졌다｡"
  },
  {
   "id": 31848,
   "key": "D1304al.txt:341",
   "file": "D1304al.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術回路は一向に回復しない。",
   "ko_candidate": "마술 회로는 전혀 회복되지 않는다｡"
  },
  {
   "id": 31849,
   "key": "D1304al.txt:342",
   "file": "D1304al.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今の状態で、２発目をかわす自信は無い――！",
   "ko_candidate": "지금 상태로 2발째를 피할 자신은 없어――!"
  },
  {
   "id": 31850,
   "key": "D1304al.txt:345",
   "file": "D1304al.txt",
   "line": 345,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クソッタレ……っ！」",
   "ko_candidate": "「젠장……!」"
  }
 ]
}