 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ウェスパシアヌス": "베스파시아누스",
  "クトゥグア": "크투가",
  "デウス・マキナ": "데우스 마키나"
 },
 "items": [
  {
   "id": 16926,
   "key": "D0816le.txt:575",
   "file": "D0816le.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "温厚そうな瞳。その奥には",
   "ko_candidate": "온화해 보이는 눈동자｡ 그 안에는"
  },
  {
   "id": 16927,
   "key": "D0816le.txt:579",
   "file": "D0816le.txt",
   "line": 579,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あまり目先の事しか見ないで油断していると、ほらほら、思わぬ痛い目に遭うと思うのだが。 そうそう……」",
   "ko_candidate": "「너무 눈앞의 일만 보고 방심하면 말이야､ 어이어이､ 뜻밖의 아픈 꼴을 당할 거라고 생각하는데｡ 그래 그래……」"
  },
  {
   "id": 16928,
   "key": "D0816le.txt:585",
   "file": "D0816le.txt",
   "line": 585,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鋭く光る愉悦がある。",
   "ko_candidate": "날카롭게 빛나는 열락이 있다｡"
  },
  {
   "id": 16929,
   "key": "D0816le.txt:586",
   "file": "D0816le.txt",
   "line": 586,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "同胞をも嘲笑う、冷酷さがある。",
   "ko_candidate": "동료마저 조롱하는 냉혹함이 있다｡"
  },
  {
   "id": 16930,
   "key": "D0816le.txt:590",
   "file": "D0816le.txt",
   "line": 590,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――あんなことであの『暴君』が死んだとでも思っとるのかね」 「それはちょっと、彼女に失礼ってえものだよ。兄弟？」",
   "ko_candidate": "「――그런 일로 저 『폭군』이 죽었다고 생각하는 건가｡ 그건 좀､ 그녀에게 실례라는 거야｡ 형제?」"
  },
  {
   "id": 16931,
   "key": "D0816le.txt:596",
   "file": "D0816le.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう嗤うウェスパシアヌスの視線の先で、光が弾けた。",
   "ko_candidate": "그렇게 비웃는 베스파시아누스의 시선 앞에서 빛이 터졌다｡"
  },
  {
   "id": 16932,
   "key": "D0816le.txt:604",
   "file": "D0816le.txt",
   "line": 604,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆発する怒りと共に、クトゥグアを解き放とうとした――その時だった。",
   "ko_candidate": "폭발하는 분노와 함께 크투가를 해방하려고 했다―― 그때였다｡"
  },
  {
   "id": 16933,
   "key": "D0816le.txt:608",
   "file": "D0816le.txt",
   "line": 608,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光の如く烈しく、闇の如く無言に、ソレは速やかに顕れた。",
   "ko_candidate": "빛처럼 격렬하게､ 어둠처럼 무언으로､ 그것은 신속하게 나타났다｡"
  },
  {
   "id": 16934,
   "key": "D0816le.txt:617",
   "file": "D0816le.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔法陣。",
   "ko_candidate": "마법진｡"
  },
  {
   "id": 16935,
   "key": "D0816le.txt:618",
   "file": "D0816le.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光輝。爆裂する。夜を染め上げる。",
   "ko_candidate": "광휘｡ 폭발한다｡ 밤을 물들인다｡"
  },
  {
   "id": 16936,
   "key": "D0816le.txt:624",
   "file": "D0816le.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白。",
   "ko_candidate": "하얗다｡"
  },
  {
   "id": 16937,
   "key": "D0816le.txt:625",
   "file": "D0816le.txt",
   "line": 625,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白い闇。",
   "ko_candidate": "하얀 어둠｡"
  },
  {
   "id": 16938,
   "key": "D0816le.txt:626",
   "file": "D0816le.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光を塗りたくった、闇。",
   "ko_candidate": "빛을 칠한 어둠｡"
  },
  {
   "id": 16939,
   "key": "D0816le.txt:629",
   "file": "D0816le.txt",
   "line": 629,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――――っ!?」",
   "ko_candidate": "「――――――――읏!?」"
  },
  {
   "id": 16940,
   "key": "D0816le.txt:632",
   "file": "D0816le.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無言。",
   "ko_candidate": "무언｡"
  },
  {
   "id": 16941,
   "key": "D0816le.txt:633",
   "file": "D0816le.txt",
   "line": 633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無音。",
   "ko_candidate": "무음｡"
  },
  {
   "id": 16942,
   "key": "D0816le.txt:634",
   "file": "D0816le.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "音を呑み込む、一切を呑み込む闇。",
   "ko_candidate": "소리를 삼키는､ 모든 것을 삼키는 어둠｡"
  },
  {
   "id": 16943,
   "key": "D0816le.txt:639",
   "file": "D0816le.txt",
   "line": 639,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白い闇。",
   "ko_candidate": "하얀 어둠｡"
  },
  {
   "id": 16944,
   "key": "D0816le.txt:640",
   "file": "D0816le.txt",
   "line": 640,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白い闇の中に、亀裂。",
   "ko_candidate": "하얀 어둠 속에 균열｡"
  },
  {
   "id": 16945,
   "key": "D0816le.txt:641",
   "file": "D0816le.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒い、黒い、傷痕。",
   "ko_candidate": "검은､ 검은 상처｡"
  },
  {
   "id": 16946,
   "key": "D0816le.txt:643",
   "file": "D0816le.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "裂ける。",
   "ko_candidate": "찢어진다｡"
  },
  {
   "id": 16947,
   "key": "D0816le.txt:644",
   "file": "D0816le.txt",
   "line": 644,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "拡がる。",
   "ko_candidate": "퍼져나간다｡"
  },
  {
   "id": 16948,
   "key": "D0816le.txt:645",
   "file": "D0816le.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "罅割れる。",
   "ko_candidate": "갈라진다｡"
  },
  {
   "id": 16949,
   "key": "D0816le.txt:648",
   "file": "D0816le.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒い傷痕から噴き出す漆黒。",
   "ko_candidate": "검은 상처에서 뿜어져 나오는 칠흑｡"
  },
  {
   "id": 16950,
   "key": "D0816le.txt:649",
   "file": "D0816le.txt",
   "line": 649,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "染み込む。",
   "ko_candidate": "스며든다｡"
  },
  {
   "id": 16951,
   "key": "D0816le.txt:650",
   "file": "D0816le.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "流れ込む。",
   "ko_candidate": "흘러들어간다｡"
  },
  {
   "id": 16952,
   "key": "D0816le.txt:651",
   "file": "D0816le.txt",
   "line": 651,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "藍色の闇を飲み込んだ白い闇を呑み込む闇黒。",
   "ko_candidate": "남색 어둠을 삼킨 하얀 어둠을 삼키는 암흑｡"
  },
  {
   "id": 16953,
   "key": "D0816le.txt:655",
   "file": "D0816le.txt",
   "line": 655,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇の只中で――ソレは存在を主張していた。",
   "ko_candidate": "어둠의 한가운데서――그것은 존재를 주장하고 있었다｡"
  },
  {
   "id": 16954,
   "key": "D0816le.txt:656",
   "file": "D0816le.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇の只中に在って――ソレの輪郭ははっきりと浮き上がっていた。",
   "ko_candidate": "어둠의 한가운데에 있으면서――그것의 윤곽은 뚜렷이 떠오르고 있었다｡"
  },
  {
   "id": 16955,
   "key": "D0816le.txt:662",
   "file": "D0816le.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ソレはヒト型でありながら、異形。",
   "ko_candidate": "그것은 인간형이면서도 기괴한 모습｡"
  },
  {
   "id": 16956,
   "key": "D0816le.txt:663",
   "file": "D0816le.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "破壊をもたらす悪魔に見えるし、審判をもたらす天使にも見える。",
   "ko_candidate": "파괴를 가져오는 악마로 보이기도 하고､ 심판을 가져오는 천사로도 보인다｡"
  },
  {
   "id": 16957,
   "key": "D0816le.txt:665",
   "file": "D0816le.txt",
   "line": 665,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "つまりは、異形。",
   "ko_candidate": "즉､ 기괴한 모습｡"
  },
  {
   "id": 16958,
   "key": "D0816le.txt:666",
   "file": "D0816le.txt",
   "line": 666,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そしてこの異形の容は、俺たちには馴染みの深いものだ。",
   "ko_candidate": "그리고 이 기괴한 모습은 우리에게 익숙한 것이다｡"
  },
  {
   "id": 16959,
   "key": "D0816le.txt:668",
   "file": "D0816le.txt",
   "line": 668,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この異形は――おそらく神を象っている。",
   "ko_candidate": "이 기괴한 모습은――아마도 신을 본뜬 것이다｡"
  },
  {
   "id": 16960,
   "key": "D0816le.txt:669",
   "file": "D0816le.txt",
   "line": 669,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "異界の神を象っている。",
   "ko_candidate": "이계의 신을 본뜬 것이다｡"
  },
  {
   "id": 16961,
   "key": "D0816le.txt:670",
   "file": "D0816le.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "意味するところは唯一つ。",
   "ko_candidate": "의미하는 바는 단 하나｡"
  },
  {
   "id": 16962,
   "key": "D0816le.txt:675",
   "file": "D0816le.txt",
   "line": 675,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「デウス・マキナ……もう一機の、 デウス・マキナだと!?」",
   "ko_candidate": "「데우스 마키나……또 다른 한 대의､ 데우스 마키나라고!?」"
  },
  {
   "id": 16963,
   "key": "D0816le.txt:680",
   "file": "D0816le.txt",
   "line": 680,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "漆黒。",
   "ko_candidate": "칠흑｡"
  },
  {
   "id": 16964,
   "key": "D0816le.txt:681",
   "file": "D0816le.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆裂する。空間に砕け、散ってゆく。",
   "ko_candidate": "폭발한다｡ 공간에 부서져 흩어진다｡"
  },
  {
   "id": 16965,
   "key": "D0816le.txt:683",
   "file": "D0816le.txt",
   "line": 683,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇の因子が総て世界に溶けて、移ろい、消えてゆく。",
   "ko_candidate": "어둠의 인자가 모두 세계에 녹아들어 변하고 사라져간다｡"
  }
 ]
}