   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスは今、単なる憎悪の化身と堕ちた。",
   "ko_candidate": "리베르 레기스는 지금､ 단순한 증오의 화신으로 전락했다｡"
  },
  {
   "id": 51042,
   "key": "ep_ruri02b.txt:417",
   "file": "ep_ruri02b.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "嗚呼、こいつはもう――ヒトの容すら、棄て去ろうとしてるんだな。",
   "ko_candidate": "아아､ 이놈은 이제―― 인간의 모습조차､ 버리려 하고 있구나｡"
  },
  {
   "id": 51043,
   "key": "ep_ruri02b.txt:419",
   "file": "ep_ruri02b.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怨念を呪いを叩きつけられ、だが俺の心の中は、怒りでもなく、恐れでもなく、寂しさにも似た渇き切った何かで満たされていた。",
   "ko_candidate": "원념과 저주를 퍼부어대지만､ 하지만 내 마음속은､ 분노도 아니고､ 두려움도 아니고､ 외로움과도 비슷한 메말라버린 무언가로 가득 차 있었다｡"
  },
  {
   "id": 51044,
   "key": "ep_ruri02b.txt:423",
   "file": "ep_ruri02b.txt",
   "line": 423,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……九郎」",
   "ko_candidate": "「……쿠로」"
  },
  {
   "id": 51045,
   "key": "ep_ruri02b.txt:430",
   "file": "ep_ruri02b.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "姫さんが怯えるように、俺の手を握り締めてきた。",
   "ko_candidate": "공주님이 겁에 질린 듯､ 내 손을 꽉 잡아왔다｡"
  },
  {
   "id": 51046,
   "key": "ep_ruri02b.txt:431",
   "file": "ep_ruri02b.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は姫さんの躰を抱き寄せる。",
   "ko_candidate": "나는 공주님의 몸을 끌어당긴다｡"
  },
  {
   "id": 51047,
   "key": "ep_ruri02b.txt:435",
   "file": "ep_ruri02b.txt",
   "line": 435,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……あっ」",
   "ko_candidate": "「……앗」"
  },
  {
   "id": 51048,
   "key": "ep_ruri02b.txt:439",
   "file": "ep_ruri02b.txt",
   "line": 439,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大丈夫だ」",
   "ko_candidate": "「괜찮아」"
  },
  {
   "id": 51049,
   "key": "ep_ruri02b.txt:442",
   "file": "ep_ruri02b.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――大丈夫だ。",
   "ko_candidate": "――괜찮아｡"
  },
  {
   "id": 51050,
   "key": "ep_ruri02b.txt:446",
   "file": "ep_ruri02b.txt",
   "line": 446,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「これで終わる。俺たちが勝って――未来を切り拓く」",
   "ko_candidate": "「이걸로 끝난다｡ 우리가 이겨서―― 미래를 개척할 거야」"
  },
  {
   "id": 51051,
   "key": "ep_ruri02b.txt:449",
   "file": "ep_ruri02b.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "姫さんに誓う。",
   "ko_candidate": "공주님에게 맹세한다｡"
  },
  {
   "id": 51052,
   "key": "ep_ruri02b.txt:450",
   "file": "ep_ruri02b.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 51053,
   "key": "ep_ruri02b.txt:450",
   "file": "ep_ruri02b.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺自身に誓う。",
   "ko_candidate": "나 자신에게 맹세한다｡"
  },
  {
   "id": 51054,
   "key": "ep_ruri02b.txt:452",
   "file": "ep_ruri02b.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "負けるはずがない。",
   "ko_candidate": "질 리가 없다｡"
  },
  {
   "id": 51055,
   "key": "ep_ruri02b.txt:453",
   "file": "ep_ruri02b.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶対に、負けるはずがない。",
   "ko_candidate": "절대로､ 질 리가 없다｡"
  },
  {
   "id": 51056,
   "key": "ep_ruri02b.txt:460",
   "file": "ep_ruri02b.txt",
   "line": 460,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「征くぞォォォ！ エセルドレーダァァァ！」",
   "ko_candidate": "「가자아아아! 에셀드레다아아아!」"
  },
  {
   "id": 51057,
   "key": "ep_ruri02b.txt:465",
   "file": "ep_ruri02b.txt",
   "line": 465,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「イエス、マスター！　何処までも……！」",
   "ko_candidate": "「예스､ 마스터! 어디까지라도……!」"
  },
  {
   "id": 51058,
   "key": "ep_ruri02b.txt:472",
   "file": "ep_ruri02b.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "暗黒の宇宙を――リベル・レギスが翔ける。",
   "ko_candidate": "어두운 우주를――리베르 레기스가 날아간다｡"
  },
  {
   "id": 51059,
   "key": "ep_ruri02b.txt:473",
   "file": "ep_ruri02b.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界を裂く閃光と共に、絶対零度の焔で武装して。",
   "ko_candidate": "세계를 가르는 섬광과 함께､ 절대영도의 불꽃으로 무장하고｡"
  },
  {
   "id": 51060,
   "key": "ep_ruri02b.txt:475",
   "file": "ep_ruri02b.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "翔ける。",
   "ko_candidate": "날아간다｡"
  },
  {
   "id": 51061,
   "key": "ep_ruri02b.txt:476",
   "file": "ep_ruri02b.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "翔ける。",
   "ko_candidate": "날아간다｡"
  },
  {
   "id": 51062,
   "key": "ep_ruri02b.txt:478",
   "file": "ep_ruri02b.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "翔ける――",
   "ko_candidate": "날아간다――"
  },
  {
   "id": 51063,
   "key": "ep_ruri02b.txt:484",
   "file": "ep_ruri02b.txt",
   "line": 484,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「征くぜぇぇぇ！　アルぅぅぅぅ！」",
   "ko_candidate": "「가자아아아! 알아아아아!」"
  },
  {
   "id": 51064,
   "key": "ep_ruri02b.txt:488",
   "file": "ep_ruri02b.txt",
   "line": 488,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「応！　ヒラニプラ・システム永久承認確認！」",
   "ko_candidate": "「응! 히라니프라 시스템 영구 승인 확인!」"
  },
  {
   "id": 51065,
   "key": "ep_ruri02b.txt:495",
   "file": "ep_ruri02b.txt",
   "line": 495,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「おおおおおおおおおおおおおお！」",
   "ko_candidate": "「오오오오오오오오오오오오오오!」"
  },
  {
   "id": 51066,
   "key": "ep_ruri02b.txt:498",
   "file": "ep_ruri02b.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "暗黒の宇宙を――デモンベインが奔る！",
   "ko_candidate": "어두운 우주를――데몬베인이 달린다!"
  },
  {
   "id": 51067,
   "key": "ep_ruri02b.txt:499",
   "file": "ep_ruri02b.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界を灼く閃光と共に、無限熱量の焔で武装して。",
   "ko_candidate": "세계를 태우는 섬광과 함께､ 무한 열량의 불꽃으로 무장하고｡"
  },
  {
   "id": 51068,
   "key": "ep_ruri02b.txt:501",
   "file": "ep_ruri02b.txt",
   "line": 501,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "駆ける！",
   "ko_candidate": "달린다!"
  },
  {
   "id": 51069,
   "key": "ep_ruri02b.txt:502",
   "file": "ep_ruri02b.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "駆ける！",
   "ko_candidate": "달린다!"
  },
  {
   "id": 51070,
   "key": "ep_ruri02b.txt:510",
   "file": "ep_ruri02b.txt",
   "line": 510,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「光射す世界に、汝ら闇黒、棲まう場所無し――」",
   "ko_candidate": "「빛이 비치는 세상에､ 너희 어둠은､ 살 곳이 없다――」"
  },
  {
   "id": 51071,
   "key": "ep_ruri02b.txt:513",
   "file": "ep_ruri02b.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……駆ける！",
   "ko_candidate": "……달린다!"
  },
  {
   "id": 51072,
   "key": "ep_ruri02b.txt:520",
   "file": "ep_ruri02b.txt",
   "line": 520,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ハイパーボリアァァァアアアア！」",
   "ko_candidate": "「하이퍼보리아아아아아아아아!」"
  },
  {
   "id": 51073,
   "key": "ep_ruri02b.txt:523",
   "file": "ep_ruri02b.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "神速を超えて繰り出される、瘴滅の刃。",
   "ko_candidate": "신속을 넘어 내질러지는､ 장멸의 칼날｡"
  },
  {
   "id": 51074,
   "key": "ep_ruri02b.txt:524",
   "file": "ep_ruri02b.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、かわす必要は無い。",
   "ko_candidate": "하지만､ 피할 필요는 없다｡"
  },
  {
   "id": 51075,
   "key": "ep_ruri02b.txt:526",
   "file": "ep_ruri02b.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はただ、この右掌を信じて、総てをぶつければ良い。",
   "ko_candidate": "나는 그저､ 이 오른손바닥을 믿고､ 모든 것을 부딪치면 된다｡"
  },
  {
   "id": 51076,
   "key": "ep_ruri02b.txt:527",
   "file": "ep_ruri02b.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶対に――",
   "ko_candidate": "절대로――"
  },
  {
   "id": 51077,
   "key": "ep_ruri02b.txt:527",
   "file": "ep_ruri02b.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "勝つ！",
   "ko_candidate": "이긴다!"
  },
  {
   "id": 51078,
   "key": "ep_ruri02b.txt:535",
   "file": "ep_ruri02b.txt",
   "line": 535,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「渇かず飢えず、無に還れ――！」",
   "ko_candidate": "「목마르지도 배고프지도 않고､ 무로 돌아가라――!」"
  },
  {
   "id": 51079,
   "key": "ep_ruri02b.txt:542",
   "file": "ep_ruri02b.txt",
   "line": 542,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ゼロドライブ！」",
   "ko_candidate": "「제로드라이브!」"
  },
  {
   "id": 51080,
   "key": "ep_ruri02b.txt:548",
   "file": "ep_ruri02b.txt",
   "line": 548,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "視界が白い閃光に塗り潰される。",
   "ko_candidate": "시야가 하얀 섬광으로 뒤덮인다｡"
  }
