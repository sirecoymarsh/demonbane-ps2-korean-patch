   "key": "D0412.txt:1103",
   "file": "D0412.txt",
   "line": 1103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……早くに気づけば良かった。",
   "ko_candidate": "일찍 깨달았으면 좋았을 텐데｡"
  },
  {
