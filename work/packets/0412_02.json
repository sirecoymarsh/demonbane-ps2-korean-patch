   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「お、おい!?　九郎!?」",
   "ko_candidate": "「어､ 어이!? 쿠로!?」"
  },
  {
   "id": 5615,
