  {
   "id": 36338,
   "key": "D1401le.txt:743",
   "file": "D1401le.txt",
   "line": 743,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な眸が、景色となって広がっている。",
   "ko_candidate": "거대한 눈동자가 풍경이 되어 펼쳐져 있다｡"
  },
  {
   "id": 36339,
   "key": "D1401le.txt:744",
   "file": "D1401le.txt",
   "line": 744,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あと、もう少しで……！",
   "ko_candidate": "이제 조금만 더…!"
  },
  {
   "id": 36340,
   "key": "D1401le.txt:748",
   "file": "D1401le.txt",
   "line": 748,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「調子に乗るな、マスター・オブ・ネクロノミコン！」",
   "ko_candidate": "「조심해라､ 네크로노미콘의 마스터!」"
  },
  {
   "id": 36341,
   "key": "D1401le.txt:753",
   "file": "D1401le.txt",
   "line": 753,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は一本だけではない。",
   "ko_candidate": "이번에는 한 개뿐만이 아니다｡"
  },
  {
   "id": 36342,
   "key": "D1401le.txt:754",
   "file": "D1401le.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の龍の首が、うねりを上げ、乱気流を巻き起こしながら、同時に襲いかかって来る。",
   "ko_candidate": "무수한 용의 머리가 꿈틀거리며 난기류를 일으키면서 동시에 덮쳐온다｡"
  },
  {
   "id": 36343,
   "key": "D1401le.txt:758",
   "file": "D1401le.txt",
   "line": 758,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なろぉぉぉぉ！　レムリア……！」",
   "ko_candidate": "「으아아아아! 레무리아…!」"
  },
  {
   "id": 36344,
   "key": "D1401le.txt:763",
   "file": "D1401le.txt",
   "line": 763,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――その時だった。",
   "ko_candidate": "――그때였다｡"
  },
  {
   "id": 36345,
   "key": "D1401le.txt:768",
   "file": "D1401le.txt",
   "line": 768,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 36346,
   "key": "D1401le.txt:773",
   "file": "D1401le.txt",
   "line": 773,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 36347,
   "key": "D1401le.txt:778",
   "file": "D1401le.txt",
   "line": 778,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……!?」",
   "ko_candidate": "「뭐…!?」"
  },
  {
   "id": 36348,
   "key": "D1401le.txt:783",
   "file": "D1401le.txt",
   "line": 783,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これは……！」",
   "ko_candidate": "「이건…!」 「엣?」"
  },
  {
   "id": 36349,
   "key": "D1401le.txt:788",
   "file": "D1401le.txt",
   "line": 788,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？」 俺は幻覚を――いや、何か……何処かの世界の記憶を、幻視した。",
   "ko_candidate": "나는 환각을――아니､ 뭔가… 어딘가의 세계의 기억을 환시했다｡"
  },
  {
   "id": 36350,
   "key": "D1401le.txt:797",
   "file": "D1401le.txt",
   "line": 797,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膨大な記憶が、俺の意識に流れ込む！",
   "ko_candidate": "방대한 기억이 내 의식 속으로 흘러들어온다!"
  },
  {
   "id": 36351,
   "key": "D1401le.txt:799",
   "file": "D1401le.txt",
   "line": 799,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは巨大過ぎて、一瞬過ぎて、茫洋過ぎて、とうてい把握できる……違う。理解できる領域にはなかった。",
   "ko_candidate": "그것은 너무나 거대하고､ 순식간에 지나가며､ 너무나 광대해서 도저히 파악할 수 있는… 아니다｡ 이해할 수 있는 영역에 있지 않았다｡"
  }
 ]
