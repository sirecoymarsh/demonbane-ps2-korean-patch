  },
  {
   "id": 46273,
   "key": "D1511ru.txt:604",
   "file": "D1511ru.txt",
   "line": 604,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発が赤の太陽よりも眩く烈しく、宇宙を塗り替える。",
   "ko_candidate": "폭발이 붉은 태양보다 더 눈부시고 격렬하게 우주를 뒤덮는다｡"
  },
  {
   "id": 46274,
   "key": "D1511ru.txt:605",
   "file": "D1511ru.txt",
   "line": 605,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その白い闇の中に俺は飛び込んだ。",
   "ko_candidate": "그 하얀 어둠 속으로 나는 뛰어들었다｡"
  },
  {
   "id": 46275,
   "key": "D1511ru.txt:610",
   "file": "D1511ru.txt",
   "line": 610,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シャンタク！　フルパワーァァァァァァァ！」",
   "ko_candidate": "「샨타크! 풀파워어어어어어어어!」"
  },
  {
   "id": 46276,
   "key": "D1511ru.txt:616",
   "file": "D1511ru.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音速を遥かに超えて、飛翔する。",
   "ko_candidate": "음속을 훨씬 넘어서 비상한다｡"
  },
  {
   "id": 46277,
   "key": "D1511ru.txt:617",
   "file": "D1511ru.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の向こう、リベル・レギスに向かって全速力で。",
   "ko_candidate": "빛 너머､ 리베르 레기스를 향해 전속력으로｡"
  },
  {
   "id": 46278,
   "key": "D1511ru.txt:623",
   "file": "D1511ru.txt",
   "line": 623,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それで隙を突いたつもりか！」",
   "ko_candidate": "「그걸로 틈을 노렸다고 생각하나!」"
  },
  {
   "id": 46279,
   "key": "D1511ru.txt:630",
   "file": "D1511ru.txt",
   "line": 630,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスの掌から重力弾が放たれる。",
   "ko_candidate": "리베르 레기스의 손바닥에서 중력탄이 발사된다｡"
  },
  {
   "id": 46280,
   "key": "D1511ru.txt:631",
   "file": "D1511ru.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光を捻り呑み込みながらデモンベインの軌道に向かって。",
   "ko_candidate": "빛을 비틀어 삼키며 데몬베인의 궤도를 향해｡"
  },
  {
   "id": 46281,
   "key": "D1511ru.txt:633",
   "file": "D1511ru.txt",
   "line": 633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "かわしようのないタイミングだった――物理法則に従うならば。",
   "ko_candidate": "피할 수 없는 타이밍이었다―― 물리법칙을 따른다면｡"
  },
  {
   "id": 46282,
   "key": "D1511ru.txt:634",
   "file": "D1511ru.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、今デモンベインの動きは世界をも凌駕する。",
   "ko_candidate": "하지만 지금 데몬베인의 움직임은 세계마저 능가한다｡"
  },
  {
   "id": 46283,
   "key": "D1511ru.txt:641",
   "file": "D1511ru.txt",
   "line": 641,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……！」",
   "ko_candidate": "「뭐……!」"
  },
  {
   "id": 46284,
   "key": "D1511ru.txt:644",
   "file": "D1511ru.txt",
   "line": 644,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慣性の法則を全く無視して直角に曲がり、それをかわすデモンベイン。",
   "ko_candidate": "관성의 법칙을 완전히 무시하고 직각으로 꺾어 그것을 피하는 데몬베인｡"
  },
  {
   "id": 46285,
   "key": "D1511ru.txt:645",
   "file": "D1511ru.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慣性無視の飛行はそれに留まらない。直線直角出鱈目の軌道を宇宙に刻みながら、リベル・レギスを囲う。",
   "ko_candidate": "관성 무시의 비행은 거기서 그치지 않는다｡ 직선 직각 엉망진창의 궤도를 우주에 새기며 리베르 레기스를 에워싼다｡"
  },
  {
   "id": 46286,
   "key": "D1511ru.txt:647",
   "file": "D1511ru.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、内部にかかるＧは尋常ではない重さになっている。",
   "ko_candidate": "물론 내부에 걸리는 G는 엄청난 무게가 되고 있다｡"
  },
  {
   "id": 46287,
   "key": "D1511ru.txt:648",
   "file": "D1511ru.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "というか本来ならばとっくに俺達は粉微塵になって、ジャムかバターかといった風のはず。",
   "ko_candidate": "아니､ 원래대로라면 진작에 우리는 가루가 되어 잼이나 버터 같은 꼴이 되었어야 했다｡"
  },
  {
   "id": 46288,
   "key": "D1511ru.txt:650",
   "file": "D1511ru.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが絶対堅固の俺達の決意は、肉体の強度すらも宇宙の規格から逸脱させていた。",
   "ko_candidate": "하지만 절대 견고한 우리의 결의는 육체의 강도마저 우주의 규격에서 벗어나게 했다｡"
  },
  {
   "id": 46289,
   "key": "D1511ru.txt:657",
   "file": "D1511ru.txt",
   "line": 657,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マスター危険です！　離脱を……ッ！」",
   "ko_candidate": "「마스터 위험합니다! 이탈을……!」"
  },
  {
   "id": 46290,
   "key": "D1511ru.txt:671",
   "file": "D1511ru.txt",
   "line": 671,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう遅い。",
   "ko_candidate": "이미 늦었다｡"
  },
  {
   "id": 46291,
   "key": "D1511ru.txt:673",
   "file": "D1511ru.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神速の迅雷と化したデモンベインは、リベル・レギスを頭上から貫いた！",
   "ko_candidate": "신속한 번개가 된 데몬베인은 리베르 레기스를 머리 위에서"
  },
  {
   "id": 46292,
   "key": "D1511ru.txt:678",
   "file": "D1511ru.txt",
   "line": 678,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「が…………ッ！」",
   "ko_candidate": "관통했다! 「크…………!」"
  },
  {
   "id": 46293,
   "key": "D1511ru.txt:697",
   "file": "D1511ru.txt",
   "line": 697,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスの破片が宇宙に散らばるのを俺は見た。",
   "ko_candidate": "리베르 레기스의 파편이 우주에 흩어지는 것을 나는 보았다｡"
  },
  {
   "id": 46294,
   "key": "D1511ru.txt:698",
   "file": "D1511ru.txt",
   "line": 698,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超加速状態から脱け出し、デモンベインは停止する。",
   "ko_candidate": "초가속 상태에서 벗어나 데몬베인은 정지한다｡"
  },
  {
   "id": 46295,
   "key": "D1511ru.txt:708",
   "file": "D1511ru.txt",
   "line": 708,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はぁ……はぁ……はぁ……かッ、はッッッッ！」",
   "ko_candidate": "「하아…… 하아…… 하아…… 크､ 핫!」"
  },
  {
   "id": 46296,
   "key": "D1511ru.txt:711",
   "file": "D1511ru.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全力を搾り出して、俺は呼吸をするのもやっとといった感じだ。",
   "ko_candidate": "전력을 짜내어 나는 숨을 쉬는 것조차 겨우 할 정도다｡"
  },
  {
   "id": 46297,
   "key": "D1511ru.txt:712",
   "file": "D1511ru.txt",
   "line": 712,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルも同様に尋常じゃないほど息を荒げている。",
   "ko_candidate": "알도 마찬가지로 비정상적으로 거친 숨을 내쉬고 있다｡"
  },
  {
   "id": 46298,
   "key": "D1511ru.txt:716",
   "file": "D1511ru.txt",
   "line": 716,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハッ……ハッ…… ハッ……ッッ！　九郎……」",
   "ko_candidate": "「핫…… 핫…… 핫……! 쿠로……」"
  },
  {
   "id": 46299,
   "key": "D1511ru.txt:721",
   "file": "D1511ru.txt",
   "line": 721,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はぁ……マズイぞ……アル……ッ！　奴はまだ……斃れてないッ！」",
   "ko_candidate": "「하아…… 좋지 않아…… 알……! 놈은 아직…… 쓰러지지 않았어!」"
  },
  {
   "id": 46300,
   "key": "D1511ru.txt:729",
   "file": "D1511ru.txt",
   "line": 729,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺が叫ぶや否や、巨大十字架の一撃がデモンベインを撃ち、激烈に弾き飛ばされる。",
   "ko_candidate": "내가 외치자마자 거대한 십자가의 일격이 데몬베인을 때려 격렬하게 튕겨 나간다｡"
  },
  {
   "id": 46301,
   "key": "D1511ru.txt:731",
   "file": "D1511ru.txt",
   "line": 731,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右脚と左腕が砕け、千切れ飛んだ。",
   "ko_candidate": "오른쪽 다리와 왼팔이 부서져 날아갔다｡"
  }
 ]
