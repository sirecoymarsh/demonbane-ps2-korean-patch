 },
 "items": [
  {
   "id": 45577,
   "key": "D1509ru.txt:34",
   "file": "D1509ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り向き様に剣を振るう。",
   "ko_candidate": "돌아서며 검을 휘두른다｡"
  },
  {
   "id": 45578,
   "key": "D1509ru.txt:36",
   "file": "D1509ru.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスは遥か後方、明らかに刃圏の外。",
   "ko_candidate": "리베르 레기스는 아득히 뒤쪽､ 분명 검의 범위 밖에 있다｡"
  },
  {
   "id": 45579,
   "key": "D1509ru.txt:37",
   "file": "D1509ru.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは無論、向こうから見た俺も同じことだ。",
   "ko_candidate": "물론 저쪽에서 본 나도 마찬가지다｡"
  },
  {
   "id": 45580,
   "key": "D1509ru.txt:41",
   "file": "D1509ru.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが間合いの外で繰り出された刃からは、魔力が迸り、不可視の斬撃となって飛翔する。",
   "ko_candidate": "하지만 간격 밖에서 내질러진 칼날에서 마력이 뿜어져 나와 보이지 않는 참격이 되어 날아간다｡"
  },
  {
   "id": 45581,
   "key": "D1509ru.txt:45",
   "file": "D1509ru.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "斬撃は破壊の波紋を階段に刻みつけながら、 中央で激突。爆砕。",
   "ko_candidate": "참격은 파괴의 파문을 계단에 새기며 중앙에서 격돌한다｡ 폭쇄｡"
  },
  {
   "id": 45582,
   "key": "D1509ru.txt:47",
   "file": "D1509ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆心点を中心に階段を粉々に崩壊させる。",
   "ko_candidate": "폭심점을 중심으로 계단을 산산조각 내며 무너뜨린다｡"
  },
  {
   "id": 45583,
   "key": "D1509ru.txt:48",
   "file": "D1509ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "果たして破壊は両機の足許にまで及んだ。",
   "ko_candidate": "과연 파괴는 양쪽 기체의 발밑까지 미쳤다｡"
  },
  {
   "id": 45584,
   "key": "D1509ru.txt:52",
   "file": "D1509ru.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足場を失う寸前、俺はリベル・レギス目掛けて跳躍。",
   "ko_candidate": "발판을 잃기 직전､ 나는 리베르 레기스를 향해 도약한다｡"
  },
  {
   "id": 45585,
   "key": "D1509ru.txt:53",
   "file": "D1509ru.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "向こうもまた同じだ。",
   "ko_candidate": "저쪽도 마찬가지다｡"
  },
  {
   "id": 45586,
   "key": "D1509ru.txt:54",
   "file": "D1509ru.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳躍の頂上部で、第３撃が闇を裂いて疾走る。",
   "ko_candidate": "도약의 정점에서 제3격이 어둠을 가르며 질주한다｡"
  },
  {
   "id": 45587,
   "key": "D1509ru.txt:61",
   "file": "D1509ru.txt",
   "line": 61,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クッ……！」",
   "ko_candidate": "「크윽……!」"
  },
  {
   "id": 45588,
   "key": "D1509ru.txt:68",
   "file": "D1509ru.txt",
   "line": 68,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヌゥ……！」",
   "ko_candidate": "「으윽……!」"
  },
  {
   "id": 45589,
   "key": "D1509ru.txt:76",
   "file": "D1509ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "互いの肩口に刃は打ち込まれる。",
   "ko_candidate": "서로의 어깨에 칼날이 박힌다｡"
  },
  {
   "id": 45590,
   "key": "D1509ru.txt:77",
   "file": "D1509ru.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体を揺るがす振動。金属が削れ、火花が散る。",
   "ko_candidate": "기체를 뒤흔드는 진동｡ 금속이 깎이고 불꽃이 튄다｡"
  },
  {
   "id": 45591,
   "key": "D1509ru.txt:78",
   "file": "D1509ru.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……浅い！",
   "ko_candidate": "하지만…… 얕다!"
  },
  {
   "id": 45592,
   "key": "D1509ru.txt:82",
   "file": "D1509ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剣を引き戻す。",
   "ko_candidate": "검을 빼낸다｡"
  },
  {
   "id": 45593,
   "key": "D1509ru.txt:82",
   "file": "D1509ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重力に引かれ、落下するデモンベインとリベル・レギス。",
   "ko_candidate": "중력에 이끌려 떨어지는 데몬베인과 리베르 레기스｡"
  },
  {
   "id": 45594,
   "key": "D1509ru.txt:83",
   "file": "D1509ru.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足場を失ったその先は何処までも続く深淵。",
   "ko_candidate": "발판을 잃은 그 앞에는 어디까지나 이어지는 심연｡"
  },
  {
   "id": 45595,
   "key": "D1509ru.txt:85",
   "file": "D1509ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "墜ちていく。",
   "ko_candidate": "떨어진다｡"
  },
  {
   "id": 45596,
   "key": "D1509ru.txt:86",
   "file": "D1509ru.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "堕ちていく。",
   "ko_candidate": "추락한다｡"
  },
  {
   "id": 45597,
   "key": "D1509ru.txt:93",
   "file": "D1509ru.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "堕ちながら、俺達は次の斬撃。次の次の斬撃。 次の次の次の斬撃を重ねていく。",
   "ko_candidate": "추락하면서 우리는 다음 참격､ 다음 다음 참격､ 다음 다음 다음 참격을 거듭한다｡"
  },
  {
   "id": 45598,
   "key": "D1509ru.txt:95",
   "file": "D1509ru.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝突する剣先が魔力の火花を散らす。",
   "ko_candidate": "충돌하는 검끝이 마력의 불꽃을 뿌린다｡"
  },
  {
   "id": 45599,
   "key": "D1509ru.txt:98",
   "file": "D1509ru.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "繰り出す斬撃の速度は、高速を超え音速へ。 音速を超え神速へ。",
   "ko_candidate": "내지르는 참격의 속도는 고속을 넘어 음속으로｡ 음속을 넘어 신속으로｡"
  },
  {
   "id": 45600,
   "key": "D1509ru.txt:100",
   "file": "D1509ru.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神速を超え魔速へ。",
   "ko_candidate": "신속을 넘어 마속으로｡"
  },
  {
   "id": 45601,
   "key": "D1509ru.txt:103",
   "file": "D1509ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "百撃。千撃。万撃。億撃。",
   "ko_candidate": "백격｡ 천격｡ 만격｡ 억격｡"
  },
  {
   "id": 45602,
   "key": "D1509ru.txt:113",
   "file": "D1509ru.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "火花は閃光に。閃光は爆発に。 爆発は崩壊に。崩壊は無に。",
   "ko_candidate": "불꽃은 섬광으로｡ 섬광은 폭발로｡ 폭발은 붕괴로｡ 붕괴는 무로｡"
  },
  {
   "id": 45603,
   "key": "D1509ru.txt:124",
   "file": "D1509ru.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒトを超え、魔を超え、神を超え、世界を超える。",
   "ko_candidate": "인간을 넘어､ 마를 넘어､ 신을 넘어､ 세계를 넘는다｡"
  },
  {
   "id": 45604,
   "key": "D1509ru.txt:129",
   "file": "D1509ru.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして世界の限界を超えた攻防が、 遂に世界を斬り裂いた。",
   "ko_candidate": "그리고 세계의 한계를 넘은 공방이 마침내 세계를 갈라놓았다｡"
  },
  {
   "id": 45605,
   "key": "D1509ru.txt:134",
   "file": "D1509ru.txt",
   "line": 134,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マスター！　時空震、来ます！」",
   "ko_candidate": "「마스터! 시공진이 옵니다!」"
  },
  {
   "id": 45606,
   "key": "D1509ru.txt:138",
   "file": "D1509ru.txt",
   "line": 138,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎、備えろ！　何処に飛ばされるか、分からぬぞ！」",
   "ko_candidate": "「쿠로､ 대비해! 어디로 날아갈지 모르니까!」"
  },
  {
   "id": 45607,
   "key": "D1509ru.txt:149",
   "file": "D1509ru.txt",
   "line": 149,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「牙ァァァァァァァァァァ！」",
   "ko_candidate": "「으아아아아아아아아아아!」"
  },
  {
   "id": 45608,
   "key": "D1509ru.txt:159",
   "file": "D1509ru.txt",
   "line": 159,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「疾ィィィィィィィィィィ！」",
   "ko_candidate": "「하아아아아아아아아아아!」"
  },
  {
   "id": 45609,
   "key": "D1509ru.txt:173",
   "file": "D1509ru.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渾身の一撃が激突する。",
   "ko_candidate": "혼신의 일격이 격돌한다｡"
  },
  {
   "id": 45610,
   "key": "D1509ru.txt:174",
   "file": "D1509ru.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の断末魔と共に、光は弾け、総てが容を失った。",
   "ko_candidate": "세계의 단말마와 함께 빛이 터지고 모든 것이 형태를 잃었다｡"
  },
  {
   "id": 45611,
   "key": "D1509ru.txt:189",
   "file": "D1509ru.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蝙蝠に似た翼を生やしたヒト型の怪物が舞う夜空に、俺達は放り投げ出された。",
   "ko_candidate": "박쥐를 닮은 날개를 단 인간형 괴물이 날아다니는 밤하늘로 우리는 내던져졌다｡"
  },
  {
   "id": 45612,
   "key": "D1509ru.txt:189",
   "file": "D1509ru.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地には奇怪なフォルムの構造物が建立し、あまつさえ宙に浮いていたりもする。",
   "ko_candidate": "대지에는 기괴한 형태의 구조물이 세워져 있고､ 심지어 공중에 떠 있기도 하다｡"
  },
  {
   "id": 45613,
   "key": "D1509ru.txt:191",
   "file": "D1509ru.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処かは分からないが、地球の風景ではないことは確かだ。",
   "ko_candidate": "어디인지는 모르겠지만 지구의 풍경이 아닌 것은 확실하다｡"
  },
  {
   "id": 45614,
   "key": "D1509ru.txt:193",
   "file": "D1509ru.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更にちょうど真下、石で造られた一際巨大な建物が足許に広がっている。",
   "ko_candidate": "게다가 바로 아래､ 돌로 만들어진 유독 거대한 건물이 발밑에 펼쳐져 있다｡"
  },
  {
   "id": 45615,
   "key": "D1509ru.txt:193",
   "file": "D1509ru.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見る者を圧倒する荘厳なその建物は、あるいは神殿のようにも見える。",
   "ko_candidate": "보는 이를 압도하는 장엄한 그 건물은 어쩌면 신전처럼 보이기도 한다｡"
  },
  {
   "id": 45616,
   "key": "D1509ru.txt:197",
   "file": "D1509ru.txt",
   "line": 197,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大図書館！　プレアデス星団のセラエノか、此処は！」",
   "ko_candidate": "「……대도서관! 플라이아데스 성단의 세라에노인가､ 여긴!」"
  }
 ]
}