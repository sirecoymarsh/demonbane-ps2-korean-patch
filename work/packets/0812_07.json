  {
   "id": 16376,
   "key": "D0812le.txt:947",
   "file": "D0812le.txt",
   "line": 947,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "指先がようやく触れた――そのとき。",
   "ko_candidate": "손끝이 겨우 닿았다―― 그때｡"
  },
  {
   "id": 16377,
   "key": "D0812le.txt:952",
   "file": "D0812le.txt",
   "line": 952,
   "speaker": "カリグラ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「鬼械神クラーケン！　壊セ壊セ壊セえええぇぇぇえええ！」 「――――っ!?」",
   "ko_candidate": "「<RUBY text=\"데우스 마키나\">귀계신</RUBY> 크라켄! 부숴라 부숴라 부숴라아아아아아아!」"
  },
  {
   "id": 16378,
   "key": "D0812le.txt:962",
   "file": "D0812le.txt",
   "line": 962,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あああああっ!?」",
   "ko_candidate": "「――――!?」 「아아아아아!?」"
