   "key": "D0812le.txt:930",
   "file": "D0812le.txt",
   "line": 930,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんもこっちに気付いているようだった。",
   "ko_candidate": "라이카 씨도 이쪽을 알아챈 것 같았다｡"
  },
  {
   "id": 16373,
   "key": "D0812le.txt:933",
   "file": "D0812le.txt",
   "line": 933,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
