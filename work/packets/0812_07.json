   "line": 17,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 16384,
   "key": "D0812ru.txt:22",
