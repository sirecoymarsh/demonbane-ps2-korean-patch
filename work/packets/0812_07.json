   "id": 16375,
   "key": "D0812le.txt:946",
   "file": "D0812le.txt",
   "line": 946,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "濁流の中を泳ぎ、互いに手を伸ばす。",
   "ko_candidate": "탁류 속을 헤엄치며､ 서로 손을 뻗는다｡"
