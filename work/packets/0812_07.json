  {
   "id": 16390,
   "key": "D0812ru.txt:53",
   "file": "D0812ru.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しかし狂暴たる鬼械神はいまだ健在だ。",
   "ko_candidate": "하지만 광폭한 귀계신은 아직도 건재하다｡"
  },
  {
   "id": 16391,
   "key": "D0812ru.txt:55",
   "file": "D0812ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "理由は単純だった――",
   "ko_candidate": "이유는 단순했다――"
  },
  {
   "id": 16392,
   "key": "D0812ru.txt:60",
   "file": "D0812ru.txt",
   "line": 60,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「トカゲの尻尾切りかよ、クソ！」",
   "ko_candidate": "「도마뱀 꼬리 자르기냐､ 젠장!」"
  }
 ]
