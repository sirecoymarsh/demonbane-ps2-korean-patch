   "file": "D0812ru.txt",
   "line": 12,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やりましたか……？」",
   "ko_candidate": "「했습니까……?」"
