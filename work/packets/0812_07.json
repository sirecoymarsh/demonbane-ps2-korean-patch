   "line": 22,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………!?　いえ！　まだ反応がありますです！」",
   "ko_candidate": "「…………!? 아니요! 아직 반응이 있습니다!」"
  },
  {
   "id": 16385,
   "key": "D0812ru.txt:28",
   "file": "D0812ru.txt",
   "line": 28,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何やて!?　レムリア・インパクトから逃れたなんて……！」",
   "ko_candidate": "「뭐라고!? 레무리아 임팩트에서 벗어났다니……!」"
  },
  {
   "id": 16386,
   "key": "D0812ru.txt:35",
   "file": "D0812ru.txt",
   "line": 35,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「大十字さん！」",
   "ko_candidate": "「다이쥬지 씨!」"
