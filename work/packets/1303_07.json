 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "クトゥグア": "크투가",
  "九郎": "쿠로",
  "瑠璃": "루리",
  "大十字": "다이쥬지"
 },
 "items": [
  {
   "id": 31741,
   "key": "D1303ru.txt:443",
   "file": "D1303ru.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアが焔えるが如く、紅く輝いた。",
   "ko_candidate": "크투가가 불타오르듯 붉게 빛났다｡"
  },
  {
   "id": 31742,
   "key": "D1303ru.txt:445",
   "file": "D1303ru.txt",
   "line": 445,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烙印の輝きと、光の波長が同調する。",
   "ko_candidate": "낙인의 빛과 광파장이 동조한다｡"
  },
  {
   "id": 31743,
   "key": "D1303ru.txt:449",
   "file": "D1303ru.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔銃と烙印が、まったく同時に閃光を放つ。",
   "ko_candidate": "마총과 낙인이 완전히 동시에 섬광을 발한다｡"
  },
  {
   "id": 31744,
   "key": "D1303ru.txt:450",
   "file": "D1303ru.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒を引き裂く、白い闇。",
   "ko_candidate": "암흑을 찢는 하얀 어둠｡"
  },
  {
   "id": 31745,
   "key": "D1303ru.txt:454",
   "file": "D1303ru.txt",
   "line": 454,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ！　これは！」",
   "ko_candidate": "「――――! 이건!」"
  },
  {
   "id": 31746,
   "key": "D1303ru.txt:458",
   "file": "D1303ru.txt",
   "line": 458,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 31747,
   "key": "D1303ru.txt:461",
   "file": "D1303ru.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光の中、九郎の偃月刀を放とうとする動きに、若干の逡巡が生じた。",
   "ko_candidate": "섬광 속에서 쿠로의 언월도를 놓으려는 움직임에 약간의 망설임이 생겼다｡"
  },
  {
   "id": 31748,
   "key": "D1303ru.txt:463",
   "file": "D1303ru.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その隙に滑り込むようにして、クトゥグアが飛翔する。",
   "ko_candidate": "그 틈을 타듯 크투가가 날아온다｡"
  },
  {
   "id": 31749,
   "key": "D1303ru.txt:465",
   "file": "D1303ru.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀が空間を疾る。",
   "ko_candidate": "언월도가 공간을 가른다｡"
  },
  {
   "id": 31750,
   "key": "D1303ru.txt:468",
   "file": "D1303ru.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが刃は瑠璃に触れる直前で、飛んで来たクトゥグアに弾かれ、宙を舞った。",
   "ko_candidate": "하지만 칼날은 루리에게 닿기 직전 날아온 크투가에 튕겨나 허공을 맴돌았다｡"
  },
  {
   "id": 31751,
   "key": "D1303ru.txt:469",
   "file": "D1303ru.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その隙を瑠璃は見逃さなかった。",
   "ko_candidate": "그 틈을 루리는 놓치지 않았다｡"
  },
  {
   "id": 31752,
   "key": "D1303ru.txt:473",
   "file": "D1303ru.txt",
   "line": 473,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――大十字さん！」",
   "ko_candidate": "「――다이쥬지 씨!」"
  },
  {
   "id": 31753,
   "key": "D1303ru.txt:477",
   "file": "D1303ru.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "体当たりするように、九郎に抱き付いた。",
   "ko_candidate": "몸을 부딪치듯 쿠로에게 달려들어 안겼다｡"
  },
  {
   "id": 31754,
   "key": "D1303ru.txt:479",
   "file": "D1303ru.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このまま全力で九郎の躰を持ち上げ、一緒にこの闇の中から脱出しようとする。だが――遅かった。",
   "ko_candidate": "이대로 전력으로 쿠로의 몸을 들어 올려 함께 이 어둠에서 탈출하려 한다｡ 하지만――늦었다｡"
  },
  {
   "id": 31755,
   "key": "D1303ru.txt:483",
   "file": "D1303ru.txt",
   "line": 483,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――っ!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 31756,
   "key": "D1303ru.txt:487",
   "file": "D1303ru.txt",
   "line": 487,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……駄目か!?」",
   "ko_candidate": "「…안 되나!?」"
  },
  {
   "id": 31757,
   "key": "D1303ru.txt:492",
   "file": "D1303ru.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒の津波は、頭上まで迫っていた。",
   "ko_candidate": "암흑의 쓰나미가 머리 위까지 다가왔다｡"
  },
  {
   "id": 31758,
   "key": "D1303ru.txt:493",
   "file": "D1303ru.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界の総てが全き無明に鎖され――",
   "ko_candidate": "시야의 모든 것이 완전한 무명에 사로잡히고――"
  },
  {
   "id": 31759,
   "key": "D1303ru.txt:502",
   "file": "D1303ru.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼熱が空間を舐め、極寒が空間を凍らせ、衝撃が空間を爆裂させた。",
   "ko_candidate": "작열이 공간을 핥고 극한의 한기가 공간을 얼리며 충격이 공간을 폭발시켰다｡"
  },
  {
   "id": 31760,
   "key": "D1303ru.txt:504",
   "file": "D1303ru.txt",
   "line": 504,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "様々な現象がない交ぜになった、混沌と闇黒の奔流が、３人を呑み込む。",
   "ko_candidate": "온갖 현상이 뒤섞인 혼돈과 암흑의 급류가 세 사람을 삼켜버린다｡"
  },
  {
   "id": 31761,
   "key": "D1303ru.txt:508",
   "file": "D1303ru.txt",
   "line": 508,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――！」",
   "ko_candidate": "「――――――――――!」"
  },
  {
   "id": 31762,
   "key": "D1303ru.txt:511",
   "file": "D1303ru.txt",
   "line": 511,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲鳴すら闇黒に呑み込まれる。",
   "ko_candidate": "비명조차 암흑에 삼켜진다｡"
  },
  {
   "id": 31763,
   "key": "D1303ru.txt:513",
   "file": "D1303ru.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光も、音も、触感も、匂いも、恐らく味も、総ての感覚が蹂躙され、略奪された。",
   "ko_candidate": "빛도､ 소리도､ 촉감도､ 냄새도､ 아마도 맛도､ 모든 감각이 유린되고 약탈당했다｡"
  },
  {
   "id": 31764,
   "key": "D1303ru.txt:515",
   "file": "D1303ru.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでもなお、闇黒の侵略は進む。",
   "ko_candidate": "그래도 여전히 암흑의 침략은 계속된다｡"
  },
  {
   "id": 31765,
   "key": "D1303ru.txt:517",
   "file": "D1303ru.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "五感を呑み込み、意識へ、精神へ、そして魂の領域へと雪崩れ込む。",
   "ko_candidate": "오감을 삼키고 의식으로､ 정신으로､ 그리고 영혼의 영역으로 눈사태처럼 밀려든다｡"
  },
  {
   "id": 31766,
   "key": "D1303ru.txt:519",
   "file": "D1303ru.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の存在総てに闇黒を流し込み、瑠璃を闇黒の中に砕いて壊して崩して溶かしてしまう。",
   "ko_candidate": "루리의 존재 전체에 암흑을 흘려 넣어 루리를 암흑 속에서 부수고 파괴하고 무너뜨리고 녹여버린다｡"
  },
  {
   "id": 31767,
   "key": "D1303ru.txt:522",
   "file": "D1303ru.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――瑠璃は見た。",
   "ko_candidate": "그리고――루리는 보았다｡"
  },
  {
   "id": 31768,
   "key": "D1303ru.txt:523",
   "file": "D1303ru.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃もまた、見た。",
   "ko_candidate": "루리 또한 보았다｡"
  },
  {
   "id": 31769,
   "key": "D1303ru.txt:525",
   "file": "D1303ru.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の覗き込む深淵の一端を。",
   "ko_candidate": "쿠로가 들여다보는 심연의 일부를｡"
  },
  {
   "id": 31770,
   "key": "D1303ru.txt:526",
   "file": "D1303ru.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の魂の奥に生じた亀裂、その奥で蠢く闇黒を――",
   "ko_candidate": "쿠로의 영혼 깊은 곳에 생긴 균열､ 그 안에서 꿈틀거리는 암흑을――"
  }
 ]
}