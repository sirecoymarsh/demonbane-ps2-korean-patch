 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ハンティング・ホラー": "헌팅 호러",
  "サンダルフォン": "산달폰",
  "リューガ": "류가",
  "ライカ": "라이카",
  "デモンベイン": "데몬베인",
  "クトゥルー": "크툴루",
  "ルルイエ": "르뤼에"
 },
 "items": [
  {
   "id": 37735,
   "key": "D1407le.txt:7",
   "file": "D1407le.txt",
   "line": 7,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「痛ぅ……！」",
   "ko_candidate": "「아파……!」"
  },
  {
   "id": 37736,
   "key": "D1407le.txt:11",
   "file": "D1407le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "海面に白い轍を波立たせながらハンティング・ホラーは進む。",
   "ko_candidate": "바다 표면에 하얀 자국을 일으키며 헌팅 호러가 나아간다｡"
  },
  {
   "id": 37737,
   "key": "D1407le.txt:12",
   "file": "D1407le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その機上、サンダルフォンの躰が一瞬、ぐらついた。",
   "ko_candidate": "그 기체 위에서 산달폰의 몸이 순간 흔들렸다｡"
  },
  {
   "id": 37738,
   "key": "D1407le.txt:13",
   "file": "D1407le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即座に躰を起こし、体勢を整える。",
   "ko_candidate": "즉시 몸을 일으켜 자세를 바로잡는다｡"
  },
  {
   "id": 37739,
   "key": "D1407le.txt:17",
   "file": "D1407le.txt",
   "line": 17,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「また……！」",
   "ko_candidate": "「또……!」"
  },
  {
   "id": 37740,
   "key": "D1407le.txt:23",
   "file": "D1407le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の上から、右目と右頬を真っ直ぐに撫でる。",
   "ko_candidate": "가면 위로 오른쪽 눈과 오른쪽 뺨을 곧바로 쓰다듬는다｡"
  },
  {
   "id": 37741,
   "key": "D1407le.txt:25",
   "file": "D1407le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まただ。",
   "ko_candidate": "또다｡"
  },
  {
   "id": 37742,
   "key": "D1407le.txt:26",
   "file": "D1407le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また、あの傷が痛む。",
   "ko_candidate": "또 그 상처가 아프다｡"
  },
  {
   "id": 37743,
   "key": "D1407le.txt:28",
   "file": "D1407le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不快な熱さを伴い、血を流す。",
   "ko_candidate": "불쾌한 열기와 함께 피를 흘린다｡"
  },
  {
   "id": 37744,
   "key": "D1407le.txt:29",
   "file": "D1407le.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去が未だにリューガを苛む、その証。",
   "ko_candidate": "과거가 아직도 류가를 괴롭히는 증거｡"
  },
  {
   "id": 37745,
   "key": "D1407le.txt:31",
   "file": "D1407le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この痛みを、渇きを、飢えを、癒すのは世界に唯一人しか居ない。",
   "ko_candidate": "이 고통과 갈증､ 굶주림을 치유할 수 있는 건 세상에 단 한 사람뿐이다｡"
  },
  {
   "id": 37746,
   "key": "D1407le.txt:33",
   "file": "D1407le.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカ。",
   "ko_candidate": "라이카｡"
  },
  {
   "id": 37747,
   "key": "D1407le.txt:35",
   "file": "D1407le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その名を口にする毎に、その面影を思い浮かべる毎に、痛みに古傷は激しく炎え、渇きに咽喉は罅割れ、飢えに心は臓腑を抉る。",
   "ko_candidate": "그 이름을 입에 올릴 때마다､ 그 모습을 떠올릴 때마다､ 고통에 옛 상처는 격렬히 타오르고､ 갈증에 목구멍은 갈라지며､ 굶주림에 마음은 내장을 파고든다｡"
  },
  {
   "id": 37748,
   "key": "D1407le.txt:37",
   "file": "D1407le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その苦しみは憎悪を無限に汲み上げる。",
   "ko_candidate": "그 고통은 증오를 무한히 끌어올린다｡"
  },
  {
   "id": 37749,
   "key": "D1407le.txt:38",
   "file": "D1407le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "尽きる事は決して無い。",
   "ko_candidate": "결코 끝나지 않는다｡"
  },
  {
   "id": 37750,
   "key": "D1407le.txt:40",
   "file": "D1407le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは、何と凄惨で何と甘美な、命の意味、命の証か。",
   "ko_candidate": "그것은 얼마나 참혹하고 얼마나 달콤한､ 생명의 의미､ 생명의 증거인가｡"
  },
  {
   "id": 37751,
   "key": "D1407le.txt:42",
   "file": "D1407le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "滅ぼせる。",
   "ko_candidate": "멸망시킬 수 있다｡"
  },
  {
   "id": 37752,
   "key": "D1407le.txt:44",
   "file": "D1407le.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己が道に立ち塞がるものは総て、ライカに辿り着く道を塞ぐもの総て、確実に滅ぼせる。",
   "ko_candidate": "자신의 길을 가로막는 모든 것､ 라이카에게 도달하는 길을 막는 모든 것을 확실히 멸망시킬 수 있다｡"
  },
  {
   "id": 37753,
   "key": "D1407le.txt:46",
   "file": "D1407le.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインだろうがクトゥルーだろうが関係ない。",
   "ko_candidate": "데몬베인이든 크툴루든 상관없다｡"
  },
  {
   "id": 37754,
   "key": "D1407le.txt:48",
   "file": "D1407le.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ては等しく、単なる障害に過ぎない。",
   "ko_candidate": "모든 것은 동등하게 단순한 장애물에 불과하다｡"
  },
  {
   "id": 37755,
   "key": "D1407le.txt:49",
   "file": "D1407le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今までも総ての障害を破壊してきた。",
   "ko_candidate": "지금까지도 모든 장애물을 파괴해왔다｡"
  },
  {
   "id": 37756,
   "key": "D1407le.txt:51",
   "file": "D1407le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これからも変わらない。",
   "ko_candidate": "앞으로도 변함없다｡"
  },
  {
   "id": 37757,
   "key": "D1407le.txt:52",
   "file": "D1407le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も。",
   "ko_candidate": "아무것도｡"
  },
  {
   "id": 37758,
   "key": "D1407le.txt:53",
   "file": "D1407le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も。",
   "ko_candidate": "아무것도｡"
  },
  {
   "id": 37759,
   "key": "D1407le.txt:55",
   "file": "D1407le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、ライカの呪縛をも打ち破り、遥かなる高みへ。",
   "ko_candidate": "그리고 라이카의 주술마저 깨뜨리고 아득히 높은 곳으로｡"
  },
  {
   "id": 37760,
   "key": "D1407le.txt:60",
   "file": "D1407le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――空へ。",
   "ko_candidate": "――하늘로｡"
  },
  {
   "id": 37761,
   "key": "D1407le.txt:64",
   "file": "D1407le.txt",
   "line": 64,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぅ……！」",
   "ko_candidate": "「으윽……!」"
  },
  {
   "id": 37762,
   "key": "D1407le.txt:67",
   "file": "D1407le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突如と、何の前触れも無く、リューガの心に無限の蒼穹が拡がる。",
   "ko_candidate": "돌연 아무 전조도 없이 류가의 마음에 무한한 창공이 펼쳐진다｡"
  },
  {
   "id": 37763,
   "key": "D1407le.txt:68",
   "file": "D1407le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "古傷を苛む激痛が、より一層、激しさを増した。",
   "ko_candidate": "옛 상처를 괴롭히는 격통이 더욱 더 격렬해졌다｡"
  },
  {
   "id": 37764,
   "key": "D1407le.txt:72",
   "file": "D1407le.txt",
   "line": 72,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐあああ……！　いったい、何だと言うのだ……！ ……ん？」",
   "ko_candidate": "「으아아아……! 도대체 무슨 일이란 말인가……! ……응?」"
  },
  {
   "id": 37765,
   "key": "D1407le.txt:78",
   "file": "D1407le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空の蒼を映し返していた筈の大海。",
   "ko_candidate": "하늘의 푸름을 비추고 있었을 대해｡"
  },
  {
   "id": 37766,
   "key": "D1407le.txt:79",
   "file": "D1407le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが今、海の蒼は、海中を進む影に埋め尽くされている。",
   "ko_candidate": "하지만 지금 바다의 푸름은 바다 속을 진행하는 그림자로 뒤덮여 있다｡"
  },
  {
   "id": 37767,
   "key": "D1407le.txt:80",
   "file": "D1407le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の、巨大な影に覆い尽くされている。",
   "ko_candidate": "무수한 거대한 그림자로 뒤덮여 있다｡"
  },
  {
   "id": 37768,
   "key": "D1407le.txt:82",
   "file": "D1407le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "畏怖を以って大海を震わす怪異の大軍が、今、海中深くに押し寄せ、進軍していた。",
   "ko_candidate": "경외심으로 대해를 떨게 하는 괴이의 대군이 지금 바다 깊숙이 밀려들어 진군하고 있었다｡"
  },
  {
   "id": 37769,
   "key": "D1407le.txt:83",
   "file": "D1407le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目指す方角は同じ――ルルイエだ。",
   "ko_candidate": "향하는 방향은 같다――르뤼에다｡"
  },
  {
   "id": 37770,
   "key": "D1407le.txt:87",
   "file": "D1407le.txt",
   "line": 87,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふん……そう来たか。良いだろう。相手になってやる」",
   "ko_candidate": "「흥……그렇게 나오는군｡ 좋아｡ 상대해주지」"
  },
  {
   "id": 37771,
   "key": "D1407le.txt:93",
   "file": "D1407le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怪異の一団が急速に浮上してくる。",
   "ko_candidate": "괴이의 무리가 급속히 떠오른다｡"
  },
  {
   "id": 37772,
   "key": "D1407le.txt:94",
   "file": "D1407le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な、爆発のような水柱が上がり、天を突いた。",
   "ko_candidate": "거대한 폭발 같은 물기둥이 솟아올라 하늘을 찔렀다｡"
  },
  {
   "id": 37773,
   "key": "D1407le.txt:95",
   "file": "D1407le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティング・ホラーのスロットルを回す。",
   "ko_candidate": "헌팅 호러의 스로틀을 돌린다｡"
  },
  {
   "id": 37774,
   "key": "D1407le.txt:98",
   "file": "D1407le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の心臓が雄叫びを上げる。",
   "ko_candidate": "강철의 심장이 포효를 내지른다｡"
  }
 ]
}