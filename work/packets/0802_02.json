 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アーカム": "아컴",
  "ブラックロッジ": "블랙로지",
  "アル": "알",
  "ライカ": "라이카",
  "ジョージ": "조지"
 },
 "items": [
  {
   "id": 12354,
   "key": "D0802le.txt:77",
   "file": "D0802le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この街ではお馴染みの地方紙である。世界中のどの都市よりも事件が相次ぐここアーカム・シティでは、情報媒体はまさに生命線だ。",
   "ko_candidate": "「에잇! 어쨌든! 너희들에게 재미있는 일도､ 걱정할 만한 일도､ 아무것도 없다고! 자자､ 앉아 앉아!」 대화를 끊기 위해､ 테이블 위의 신문을 집어 들었다｡"
  },
  {
   "id": 12355,
   "key": "D0802le.txt:79",
   "file": "D0802le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もちろん、この『アーカム・アドヴァタイザー』紙もその役割を大きく担っている。",
   "ko_candidate": "『아캄 애드버타이저』｡ 이 도시에서는 익숙한 지방지다｡ 세계 어느 도시보다도 사건이 잇따르는 이곳 아캄시티에서는､ 정보 매체는 말 그대로 생명선이다｡"
  },
  {
   "id": 12356,
   "key": "D0802le.txt:81",
   "file": "D0802le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これ見よがしに広げて、第一面に目を通す。",
   "ko_candidate": "물론､ 이 『아캄 애드버타이저』지도 그 역할을 크게 담당하고 있다｡"
  },
  {
   "id": 12357,
   "key": "D0802le.txt:82",
   "file": "D0802le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "視界に飛び込んできた見出しに驚いた。",
   "ko_candidate": "과시하듯이 펼쳐서､ 1면을 훑어본다｡"
  },
  {
   "id": 12358,
   "key": "D0802le.txt:84",
   "file": "D0802le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "シティ１８番区で『ブラックロッジ』信者７８名殺される。",
   "ko_candidate": "시야에 들어온 헤드라인에 놀랐다｡ 시티 18구에서 『블랙로지』 신도 78명 살해당해｡"
  },
  {
   "id": 12359,
   "key": "D0802le.txt:87",
   "file": "D0802le.txt",
   "line": 87,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な……っ？　ええっ！　ちょっ……ちょい！　アル！」",
   "ko_candidate": "「뭐……? 에엣! 잠깐……잠깐만! 알!」"
  },
  {
   "id": 12360,
   "key": "D0802le.txt:93",
   "file": "D0802le.txt",
   "line": 93,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ん？ 大人の痴情がどうかしたか？」",
   "ko_candidate": "「응? 어른의 치정이 어쨌다고?」"
  },
  {
   "id": 12361,
   "key": "D0802le.txt:98",
   "file": "D0802le.txt",
   "line": 98,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「その話はもう良い。それよりこのニュース！」",
   "ko_candidate": "「……그 얘기는 이제 됐어｡ 그보다 이 뉴스!」"
  },
  {
   "id": 12362,
   "key": "D0802le.txt:102",
   "file": "D0802le.txt",
   "line": 102,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふむ」",
   "ko_candidate": "「흠」"
  },
  {
   "id": 12363,
   "key": "D0802le.txt:107",
   "file": "D0802le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "身を乗り出し、新聞を覗き込むアル。",
   "ko_candidate": "몸을 기울여 신문을 들여다보는 알｡"
  },
  {
   "id": 12364,
   "key": "D0802le.txt:109",
   "file": "D0802le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "文字を追っているうちに、表情は次第に硬くなっていった。",
   "ko_candidate": "글자를 따라가면서､ 표정은 점점 굳어져 갔다｡"
  },
  {
   "id": 12365,
   "key": "D0802le.txt:114",
   "file": "D0802le.txt",
   "line": 114,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「昨夜未明、『ブラックロッジ』の信者、合わせて７８名が殺されているのが発見された。治安警察では裏社会の抗争に巻き込まれたものとして捜査を…… これは」",
   "ko_candidate": "「어젯밤 미명､ 『블랙로지』의 신도､ 모두 78명이 살해된 채 발견되었다｡ 치안경찰에서는 뒷세계의 항쟁에 휘말린 것으로 보고 수사를…… 이거」"
  },
  {
   "id": 12366,
   "key": "D0802le.txt:118",
   "file": "D0802le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "抗争？　馬鹿言え。",
   "ko_candidate": "항쟁? 말도 안 돼｡"
  },
  {
   "id": 12367,
   "key": "D0802le.txt:119",
   "file": "D0802le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "連中に喧嘩吹っかけるような命知らずが、どこに居るってんだ。",
   "ko_candidate": "그들에게 싸움을 걸 만한 무모한 자가 어디 있다고｡"
  },
  {
   "id": 12368,
   "key": "D0802le.txt:120",
   "file": "D0802le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや……ここに居るが。",
   "ko_candidate": "아니……여기 있지만｡"
  },
  {
   "id": 12369,
   "key": "D0802le.txt:123",
   "file": "D0802le.txt",
   "line": 123,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どう思う？」",
   "ko_candidate": "「어떻게 생각해?」"
  },
  {
   "id": 12370,
   "key": "D0802le.txt:129",
   "file": "D0802le.txt",
   "line": 129,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……流石に、これだけでは何とも言えんな。連中の間で何か尋常ならざる事態が起きてるのは間違いないが……」",
   "ko_candidate": "「……역시､ 이것만으로는 뭐라고 말하기 어렵군｡ 그들 사이에서 뭔가 심상치 않은 일이 일어난 건 틀림없지만……」"
  },
  {
   "id": 12371,
   "key": "D0802le.txt:133",
   "file": "D0802le.txt",
   "line": 133,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まんまじゃねえかよ」",
   "ko_candidate": "「그대로잖아」"
  },
  {
   "id": 12372,
   "key": "D0802le.txt:139",
   "file": "D0802le.txt",
   "line": 139,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「五月蝿い。だから分からんと言っておる」",
   "ko_candidate": "「시끄럽다｡ 그래서 모르겠다고 말하고 있잖아」"
  },
  {
   "id": 12373,
   "key": "D0802le.txt:144",
   "file": "D0802le.txt",
   "line": 144,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うわぁ……物騒な事件ねぇ……」",
   "ko_candidate": "「우와……무서운 사건이네……」"
  },
  {
   "id": 12374,
   "key": "D0802le.txt:148",
   "file": "D0802le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "朝食の用意が出来たことを告げに戻ったライカさんが、後ろから話に加わった。ガキんちょどもは食器を並べるため、入れ替わりに台所へ向かう。",
   "ko_candidate": "아침 식사 준비가 됐다고 알리러 돌아온 라이카 씨가､ 뒤에서 대화에 끼어들었다｡ 꼬마들은 식기를 놓으러 교대로 부엌으로 향한다｡"
  },
  {
   "id": 12375,
   "key": "D0802le.txt:150",
   "file": "D0802le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "重たい空気が３人の間を流れる。",
   "ko_candidate": "무거운 공기가 세 사람 사이를 흐른다｡"
  },
  {
   "id": 12376,
   "key": "D0802le.txt:152",
   "file": "D0802le.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いったい誰の仕業だ？",
   "ko_candidate": "도대체 누구의 소행일까?"
  },
  {
   "id": 12377,
   "key": "D0802le.txt:153",
   "file": "D0802le.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何のためにこんなことを？",
   "ko_candidate": "무엇을 위해 이런 짓을?"
  },
  {
   "id": 12378,
   "key": "D0802le.txt:154",
   "file": "D0802le.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "止め処もなく次々と疑問が浮かぶ。",
   "ko_candidate": "끝도 없이 계속해서 의문이 떠오른다｡"
  },
  {
   "id": 12379,
   "key": "D0802le.txt:155",
   "file": "D0802le.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "考えても仕方ないってことは分かっているのだが……",
   "ko_candidate": "생각해봐야 소용없다는 걸 알고 있지만……"
  },
  {
   "id": 12380,
   "key": "D0802le.txt:161",
   "file": "D0802le.txt",
   "line": 161,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いずれは我々にも関わってくるだろうな。覚悟しておけ」",
   "ko_candidate": "「언젠가는 우리에게도 관련되겠지｡ 각오해 두어라」"
  },
  {
   "id": 12381,
   "key": "D0802le.txt:165",
   "file": "D0802le.txt",
   "line": 165,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……ああ」",
   "ko_candidate": "「……그래」"
  },
  {
   "id": 12382,
   "key": "D0802le.txt:172",
   "file": "D0802le.txt",
   "line": 172,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカ姉ちゃん、はやくー！」",
   "ko_candidate": "「라이카 누나､ 빨리!」"
  },
  {
   "id": 12383,
   "key": "D0802le.txt:176",
   "file": "D0802le.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "皿を運びながら、ジョージが俺たちを急かす。",
   "ko_candidate": "접시를 나르면서､ 죠지가 우리를 재촉한다｡"
  },
  {
   "id": 12384,
   "key": "D0802le.txt:178",
   "file": "D0802le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その声にライカさんの緊張が解けた。",
   "ko_candidate": "그 목소리에 라이카 씨의 긴장이 풀렸다｡"
  },
  {
   "id": 12385,
   "key": "D0802le.txt:180",
   "file": "D0802le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "両方の手のひらをパンッと合わせて、ぽややーんと微笑む。",
   "ko_candidate": "양손 바닥을 팡 하고 마주치고､ 멍하니 미소 짓는다｡"
  },
  {
   "id": 12386,
   "key": "D0802le.txt:186",
   "file": "D0802le.txt",
   "line": 186,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「まあ、今から悩んでもしょーがなひっ。こんなときはしっかり朝ごはん食べて、気合を入れよー。おー」",
   "ko_candidate": "「뭐､ 지금부터 고민해봤자 어쩔 수 없어｡ 이럴 때는 제대로 아침밥 먹고､ 기합을 넣자｡ 오!」"
  },
  {
   "id": 12387,
   "key": "D0802le.txt:189",
   "file": "D0802le.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まっ……その通りだわな。",
   "ko_candidate": "맞아……그 말이 맞지｡"
  },
  {
   "id": 12388,
   "key": "D0802le.txt:191",
   "file": "D0802le.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何をおいてもまず、身体が基本。",
   "ko_candidate": "무엇보다도 우선､ 몸이 기본이야｡"
  },
  {
   "id": 12389,
   "key": "D0802le.txt:192",
   "file": "D0802le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "肝心なときに動けなくなってちゃあ、話にならない。",
   "ko_candidate": "중요한 때에 움직일 수 없게 되면､ 말짱 도루묵이지｡"
  },
  {
   "id": 12390,
   "key": "D0802le.txt:194",
   "file": "D0802le.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "つーことで飯を食う。",
   "ko_candidate": "그래서 밥을 먹는다｡"
  },
  {
   "id": 12391,
   "key": "D0802le.txt:195",
   "file": "D0802le.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "微塵の遠慮もなく徹底的に、だ。",
   "ko_candidate": "조금의 거리낌도 없이 철저하게､ 말이다｡"
  },
  {
   "id": 12392,
   "key": "D0802le.txt:200",
   "file": "D0802le.txt",
   "line": 200,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そうだな……食事をしながら、大人の事情とやらについて、じっくり会話の花を咲かせようではないか」",
   "ko_candidate": "「그렇군……식사를 하면서､ 어른의 사정이란 것에 대해､ 천천히 대화의 꽃을 피워볼까」"
  },
  {
   "id": 12393,
   "key": "D0802le.txt:207",
   "file": "D0802le.txt",
   "line": 207,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「っ！　～～～～～～っ」",
   "ko_candidate": "「윽! ～～～～～～」"
  }
 ]
}