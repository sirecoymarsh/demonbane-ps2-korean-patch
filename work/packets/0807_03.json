 },
 "items": [
  {
   "id": 13672,
   "key": "D0807al.txt:392",
   "file": "D0807al.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "狸寝入りだったようだ。",
   "ko_candidate": "새 잠을 자는 척하고 있었던 모양이다｡"
  },
  {
   "id": 13673,
   "key": "D0807al.txt:393",
   "file": "D0807al.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "上半身を起こし、アルはエンネアを見つめた。",
   "ko_candidate": "상체를 일으키고､ 알은 엔네아를 바라보았다｡"
  },
  {
   "id": 13674,
   "key": "D0807al.txt:395",
   "file": "D0807al.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "声に、視線に、確かに込められた敵意と嫌悪。",
   "ko_candidate": "목소리에､ 시선에､ 분명히 담긴 적의와 혐오｡"
  },
  {
   "id": 13675,
   "key": "D0807al.txt:400",
   "file": "D0807al.txt",
   "line": 400,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「汝――九郎に擦り寄って、何を考えておる？」",
   "ko_candidate": "「네놈――쿠로에게 들러붙어､ 무엇을 생각하고 있느냐?」"
  },
  {
   "id": 13676,
   "key": "D0807al.txt:405",
   "file": "D0807al.txt",
   "line": 405,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「別に……何も」",
   "ko_candidate": "「별로……아무것도」"
  },
  {
   "id": 13677,
   "key": "D0807al.txt:410",
   "file": "D0807al.txt",
   "line": 410,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「とぼけるな……！」",
   "ko_candidate": "「시치미 떼지 마라……!」"
  },
  {
   "id": 13678,
   "key": "D0807al.txt:415",
   "file": "D0807al.txt",
   "line": 415,
   "speaker": "ダンセイニ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「てけり・り？」",
   "ko_candidate": "「테켈리?리?」"
  },
  {
   "id": 13679,
   "key": "D0807al.txt:418",
   "file": "D0807al.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "素っ気ないエンネアの態度が癪に障ったか、アルはダンセイニの上から飛び降りる。",
   "ko_candidate": "무뚝뚝한 엔네아의 태도가 심기를 건드렸는지､ 알은 던세이니 위에서 뛰어내린다｡"
  },
  {
   "id": 13680,
   "key": "D0807al.txt:419",
   "file": "D0807al.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今にも襲いかかりそうな怒りの形相で、アルはエンネアを睨みつける。",
   "ko_candidate": "지금이라도 덮칠 것 같은 분노의 형상으로､ 알은 엔네아를 노려본다｡"
  },
  {
   "id": 13681,
   "key": "D0807al.txt:424",
   "file": "D0807al.txt",
   "line": 424,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「汝からは善くない存在の気配がする。正体までは探れぬが、九郎に害を為すと云うならば、この場で……！」",
   "ko_candidate": "「네놈에게서는 좋지 않은 존재의 기척이 난다｡ 정체까지는 알 수 없지만､ 쿠로에게 해를 끼치려 한다면､ 이 자리에서……!」"
  },
  {
   "id": 13682,
   "key": "D0807al.txt:427",
   "file": "D0807al.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "敵意と嫌悪が純度を高め、殺意へと研ぎ澄まされていく。",
   "ko_candidate": "적의와 혐오가 순도를 높여､ 살의로 연마되어 간다｡"
  },
  {
   "id": 13683,
   "key": "D0807al.txt:429",
   "file": "D0807al.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一触即発の空気。",
   "ko_candidate": "일촉즉발의 공기｡"
  },
  {
   "id": 13684,
   "key": "D0807al.txt:430",
   "file": "D0807al.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しかし、エンネアは気にも留めず、さらりと答えた。",
   "ko_candidate": "하지만､ 엔네아는 신경 쓰지도 않고､ 담담히 대답했다｡"
  },
  {
   "id": 13685,
   "key": "D0807al.txt:435",
   "file": "D0807al.txt",
   "line": 435,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そんなつもりはないよ……」",
   "ko_candidate": "「그럴 생각은 없어……」"
  },
  {
   "id": 13686,
   "key": "D0807al.txt:440",
   "file": "D0807al.txt",
   "line": 440,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………ッ」",
   "ko_candidate": "「…………윽」"
  },
  {
   "id": 13687,
   "key": "D0807al.txt:444",
   "file": "D0807al.txt",
   "line": 444,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何処か空ろな声だった。",
   "ko_candidate": "어딘가 공허한 목소리였다｡"
  },
  {
   "id": 13688,
   "key": "D0807al.txt:446",
   "file": "D0807al.txt",
   "line": 446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これだけの殺意を向けられ、だがエンネアには何の敵意は無い。",
   "ko_candidate": "이 정도의 살의를 받고､ 하지만 엔네아에게는 아무런 적의도 없다｡"
  },
  {
   "id": 13689,
   "key": "D0807al.txt:448",
   "file": "D0807al.txt",
   "line": 448,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "謀ろうとする悪意も感じない。",
   "ko_candidate": "꾀하려는 악의도 느껴지지 않는다｡"
  },
  {
   "id": 13690,
   "key": "D0807al.txt:450",
   "file": "D0807al.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "放った殺意の収め所を見失い、戸惑うアル。",
   "ko_candidate": "내뿜은 살의의 거둘 곳을 잃고､ 당황하는 알｡"
  },
  {
   "id": 13691,
   "key": "D0807al.txt:452",
   "file": "D0807al.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "エンネアが微笑んだ。",
   "ko_candidate": "엔네아가 미소 지었다｡"
  },
  {
   "id": 13692,
   "key": "D0807al.txt:453",
   "file": "D0807al.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何処か空ろな微笑みだった。",
   "ko_candidate": "어딘가 공허한 미소였다｡"
  },
  {
   "id": 13693,
   "key": "D0807al.txt:454",
   "file": "D0807al.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "酷く穏やかな微笑みだった。",
   "ko_candidate": "몹시 온화한 미소였다｡"
  },
  {
   "id": 13694,
   "key": "D0807al.txt:459",
   "file": "D0807al.txt",
   "line": 459,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「エンネアは、ただ、九郎に逢いたかっただけ。本当に、ただ、それだけ」",
   "ko_candidate": "「엔네아는､ 그저､ 쿠로를 만나고 싶었을 뿐이야｡ 정말로､ 그저､ 그뿐」"
  },
  {
   "id": 13695,
   "key": "D0807al.txt:464",
   "file": "D0807al.txt",
   "line": 464,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「汝、記憶が――」",
   "ko_candidate": "「네놈､ 기억이――」"
  },
  {
   "id": 13696,
   "key": "D0807al.txt:467",
   "file": "D0807al.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "問い詰めようとするアル。",
   "ko_candidate": "추궁하려는 알｡"
  },
  {
   "id": 13697,
   "key": "D0807al.txt:468",
   "file": "D0807al.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そのとき、エンネアが破顔した。",
   "ko_candidate": "그때､ 엔네아가 활짝 웃었다｡"
  },
  {
   "id": 13698,
   "key": "D0807al.txt:470",
   "file": "D0807al.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今までの空ろな気配を微塵にも感じさせない、満面の笑顔だった。",
   "ko_candidate": "지금까지의 공허한 기색을 조금도 느끼게 하지 않는､ 만면의 미소였다｡"
  },
  {
   "id": 13699,
   "key": "D0807al.txt:475",
   "file": "D0807al.txt",
   "line": 475,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「おわりおわり！　夜更かしは美貌の天敵だよっ！　じゃあ、おやすみ――っ！」",
   "ko_candidate": "「끝! 끝! 밤샘은 미모의 천적이라고! 그럼､ 잘 자――!」"
  },
  {
   "id": 13700,
   "key": "D0807al.txt:480",
   "file": "D0807al.txt",
   "line": 480,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「待っ……！」",
   "ko_candidate": "「기다려……!」"
  },
  {
   "id": 13701,
   "key": "D0807al.txt:483",
   "file": "D0807al.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "止める暇も無い。",
   "ko_candidate": "말릴 틈도 없다｡"
  },
  {
   "id": 13702,
   "key": "D0807al.txt:484",
   "file": "D0807al.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "エンネアは速攻で毛布に包まり、速攻でソファーの上で横になった。",
   "ko_candidate": "엔네아는 재빨리 담요에 싸여､ 재빨리 소파 위에 누웠다｡"
  },
  {
   "id": 13703,
   "key": "D0807al.txt:485",
   "file": "D0807al.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "速攻で寝息を立てる。",
   "ko_candidate": "재빨리 코 고는 소리를 낸다｡"
  },
  {
   "id": 13704,
   "key": "D0807al.txt:489",
   "file": "D0807al.txt",
   "line": 489,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くぅー……くぅー……」",
   "ko_candidate": "「쿠우――…쿠우――…」"
  },
  {
   "id": 13705,
   "key": "D0807al.txt:494",
   "file": "D0807al.txt",
   "line": 494,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 13706,
   "key": "D0807al.txt:497",
   "file": "D0807al.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "呆気に取られるアルだけが残された。",
   "ko_candidate": "어리둥절한 알만이 남겨졌다｡"
  },
  {
   "id": 13707,
   "key": "D0807al.txt:498",
   "file": "D0807al.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "難しい顔で、眠るエンネアを見つめ続けている。",
   "ko_candidate": "난처한 표정으로､ 잠든 엔네아를 계속 바라보고 있다｡"
  },
  {
   "id": 13708,
   "key": "D0807al.txt:499",
   "file": "D0807al.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "静寂の中、九郎とエンネアの寝息だけが、聞こえている。",
   "ko_candidate": "정적 속에､ 쿠로와 엔네아의 숨소리만이､ 들리고 있다｡"
  },
  {
   "id": 13709,
   "key": "D0807al.txt:504",
   "file": "D0807al.txt",
   "line": 504,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何なのだ、この娘は？ ……分からん」",
   "ko_candidate": "「뭐지､ 이 아이는? ……모르겠군」"
  },
  {
   "id": 13710,
   "key": "D0807al.txt:510",
   "file": "D0807al.txt",
   "line": 510,
   "speaker": "ダンセイニ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「てけり・り」",
   "ko_candidate": "「테켈리?리」"
  },
  {
   "id": 13711,
   "key": "D0807le.txt:11",
   "file": "D0807le.txt",
   "line": 11,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……ったく！　荷物も……置いて……どこへ、行った、んだ……ライカさん……はっ！」",
   "ko_candidate": "「……정말! 짐도……놓고……어디로､ 갔던､ 거야……라이카 씨……핫!」"
  }
 ]
}