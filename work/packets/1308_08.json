   "key": "D1308ru.txt:149",
   "file": "D1308ru.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "変容る其れは――",
   "ko_candidate": "변용하는 그것은――"
