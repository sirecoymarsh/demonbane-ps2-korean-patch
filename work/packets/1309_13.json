 "items": [
  {
   "id": 34411,
   "key": "D1309ru.txt:184",
   "file": "D1309ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "水音を立てて、腐汁と血の雨を降らせて、何本もの肉鞭が千切れ飛ぶ。",
   "ko_candidate": "물소리를 내며 부패액과 피의 비를 뿌리며 여러 개의 육편이 찢겨 날아간다｡"
  },
  {
   "id": 34412,
   "key": "D1309ru.txt:187",
   "file": "D1309ru.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらに連射、連射、連射。",
   "ko_candidate": "더 연사､ 연사､ 연사｡"
  },
  {
   "id": 34413,
   "key": "D1309ru.txt:192",
   "file": "D1309ru.txt",
   "line": 192,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チィ――ッ！」",
   "ko_candidate": "「치익--!」"
  },
  {
   "id": 34414,
   "key": "D1309ru.txt:195",
   "file": "D1309ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉塊が、天井を高速で走った。",
   "ko_candidate": "육괴가 천장을 고속으로 달렸다｡"
  },
  {
   "id": 34415,
   "key": "D1309ru.txt:196",
   "file": "D1309ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目標を失い、天井を抉る銃弾。",
   "ko_candidate": "목표를 잃고 천장을 파고드는 총알｡"
  },
  {
   "id": 34416,
   "key": "D1309ru.txt:197",
   "file": "D1309ru.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の触手と共に、肉塊は地面に降り立った。",
   "ko_candidate": "무수한 촉수와 함께 육괴는 바닥에 내려섰다｡"
  },
  {
   "id": 34417,
   "key": "D1309ru.txt:199",
   "file": "D1309ru.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もまた、跳ね起きて、肉塊と対峙する。",
   "ko_candidate": "나 또한 벌떡 일어나 육괴와 대치한다｡"
  },
  {
   "id": 34418,
   "key": "D1309ru.txt:200",
   "file": "D1309ru.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉塊の正体は、躰中から触手を生やした、動く屍体だった。",
   "ko_candidate": "육괴의 정체는 온몸에서 촉수를 뻗은 움직이는 시체였다｡"
  },
  {
   "id": 34419,
   "key": "D1309ru.txt:204",
   "file": "D1309ru.txt",
   "line": 204,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ティベリウス！」",
   "ko_candidate": "「티베리우스!」"
  },
  {
   "id": 34420,
   "key": "D1309ru.txt:210",
   "file": "D1309ru.txt",
   "line": 210,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やっほー、九郎ちゃ～ん。何だぁ、ぜんぜん元気そーじゃあないのぉ」",
   "ko_candidate": "「야호~ 쿠로쨩｡ 뭐야､ 전혀 원기 왕성해 보이지 않네에」"
  },
  {
   "id": 34421,
   "key": "D1309ru.txt:213",
   "file": "D1309ru.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愉悦の表情を模った仮面が、こっちを向いていた。",
   "ko_candidate": "환희의 표정을 흉내 낸 가면이 이쪽을 향하고 있었다｡"
  },
  {
   "id": 34422,
   "key": "D1309ru.txt:214",
   "file": "D1309ru.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はクトゥグアの照準をティベリウスに合わせたまま、空の左手も前に突き出す。",
   "ko_candidate": "나는 크투가의 조준경을 티베리우스에 맞춘 채､ 빈 왼손도 앞으로 내민다｡"
  },
  {
   "id": 34423,
   "key": "D1309ru.txt:217",
   "file": "D1309ru.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左掌に集まる銀色の輝き。",
   "ko_candidate": "왼손바닥에 모이는 은색 빛｡"
  },
  {
   "id": 34424,
   "key": "D1309ru.txt:218",
   "file": "D1309ru.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光は急速に鋼鉄の質感を得て、一挺の魔銃になって顕現した。",
   "ko_candidate": "빛은 급속도로 강철의 질감을 얻어 한 자루의 마총이 되어 나타났다｡"
  },
  {
   "id": 34425,
   "key": "D1309ru.txt:220",
   "file": "D1309ru.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの銃口をティベリウスに向けて、俺は答える。",
   "ko_candidate": "두 개의 총구를 티베리우스에게 향하고 나는 대답한다｡"
  },
  {
   "id": 34426,
   "key": "D1309ru.txt:224",
   "file": "D1309ru.txt",
   "line": 224,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ、おかげさまでな。見ての通り、元気になったぜ。 お前らにも、たっぷり礼をしてやらんとな」",
   "ko_candidate": "「그래､ 덕분에｡ 보다시피 건강해졌어｡ 너희들에게도 충분히 감사를 해야겠지」"
  },
  {
   "id": 34427,
   "key": "D1309ru.txt:229",
   "file": "D1309ru.txt",
   "line": 229,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いえいえ、どーぞ、 お構いなくぅ？」",
   "ko_candidate": "「아이고､ 뭘요､ 신경 쓰지 마세요?」"
  },
  {
   "id": 34428,
   "key": "D1309ru.txt:234",
   "file": "D1309ru.txt",
   "line": 234,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ、そう遠慮すんなよ……」",
   "ko_candidate": "「뭐､ 그렇게 사양하지 마…」"
  },
  {
   "id": 34429,
   "key": "D1309ru.txt:237",
   "file": "D1309ru.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "引鉄に掛けた指に力を込める――その寸前だった。",
   "ko_candidate": "방아쇠에 걸은 손가락에 힘을 주려는 그 찰나였다｡"
  },
  {
   "id": 34430,
   "key": "D1309ru.txt:241",
   "file": "D1309ru.txt",
   "line": 241,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「下手な真似はしないと良いと思うわん？　ほぉら」",
   "ko_candidate": "「서툰 짓은 하지 않는 게 좋을 거예요? 자､ 봐」"
  },
  {
   "id": 34431,
   "key": "D1309ru.txt:244",
   "file": "D1309ru.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一本の触手が天井近くまで持ち上げられる。",
   "ko_candidate": "한 개의 촉수가 천장 가까이까지 들어 올려진다｡"
  },
  {
   "id": 34432,
   "key": "D1309ru.txt:245",
   "file": "D1309ru.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その先端に吊るされているのは……姫さん！",
   "ko_candidate": "그 끝에 매달려 있는 건… 공주님!"
  },
  {
   "id": 34433,
   "key": "D1309ru.txt:251",
   "file": "D1309ru.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両手首を拘束され、ぶら下げられ、首にも別の触手が巻きついている。",
   "ko_candidate": "양 손목이 구속되어 매달려 있고､ 목에도 다른 촉수가 감겨 있다｡"
  },
  {
   "id": 34434,
   "key": "D1309ru.txt:252",
   "file": "D1309ru.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の下でカタカタと死人は嗤う。",
   "ko_candidate": "가면 아래에서 카타카타 시체가 웃는다｡"
  },
  {
   "id": 34435,
   "key": "D1309ru.txt:256",
   "file": "D1309ru.txt",
   "line": 256,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こんな細い首、簡単にポッキリ逝くわよん？」",
   "ko_candidate": "「이렇게 가는 목､ 간단히 뚝 하고 부러질 거예요?」"
  },
  {
   "id": 34436,
   "key": "D1309ru.txt:260",
   "file": "D1309ru.txt",
   "line": 260,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ッ……ッッ！」",
   "ko_candidate": "「…큭…큭!」 「크윽…!」"
  },
  {
   "id": 34437,
   "key": "D1309ru.txt:264",
   "file": "D1309ru.txt",
   "line": 264,
   "speaker": "九郎 / ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」 「あ・の・コ・ム・ス・メ・は……ッ！　またかぁぁぁぁぁぁぁ！」",
   "ko_candidate": "「그・녀・석・은…! 또냐아아아아아아아!」"
  },
  {
   "id": 34438,
   "key": "D1309ru.txt:271",
   "file": "D1309ru.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "耳元でアルが絶叫する……鼓膜が破れるっつーの。",
   "ko_candidate": "귓가에서 알이 절규한다… 고막이 터질 것 같아｡"
  },
  {
   "id": 34439,
   "key": "D1309ru.txt:272",
   "file": "D1309ru.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "でも、また厄介な状況になってしまった。",
   "ko_candidate": "하지만､ 또 귀찮은 상황이 되어버렸다｡"
  },
  {
   "id": 34440,
   "key": "D1309ru.txt:273",
   "file": "D1309ru.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さて、どう動くべきか……ん？",
   "ko_candidate": "자､ 어떻게 움직여야 할까… 음?"
  },
  {
   "id": 34441,
   "key": "D1309ru.txt:277",
   "file": "D1309ru.txt",
   "line": 277,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「---------」"
  },
  {
   "id": 34442,
   "key": "D1309ru.txt:281",
   "file": "D1309ru.txt",
   "line": 281,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――？」",
   "ko_candidate": "「----?」"
  },
  {
   "id": 34443,
   "key": "D1309ru.txt:284",
   "file": "D1309ru.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの視線に気づいた。",
   "ko_candidate": "공주님의 시선을 눈치챘다｡"
  },
  {
   "id": 34444,
   "key": "D1309ru.txt:285",
   "file": "D1309ru.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真っ直ぐに、俺を見つめている。",
   "ko_candidate": "똑바로 나를 바라보고 있다｡"
  },
  {
   "id": 34445,
   "key": "D1309ru.txt:287",
   "file": "D1309ru.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞳に怯えの彩は無い。",
   "ko_candidate": "그 눈동자에 두려움의 빛은 없다｡"
  },
  {
   "id": 34446,
   "key": "D1309ru.txt:288",
   "file": "D1309ru.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣き叫んだりしない。暴れたりもしない。",
   "ko_candidate": "울부짖지도 않는다｡ 발버둥 치지도 않는다｡"
  },
  {
   "id": 34447,
   "key": "D1309ru.txt:289",
   "file": "D1309ru.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ静かな決意を湛えている。",
   "ko_candidate": "단지 조용한 결의를 담고 있다｡"
  },
  {
   "id": 34448,
   "key": "D1309ru.txt:291",
   "file": "D1309ru.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その意図までは、まだ分からないが――",
   "ko_candidate": "그 의도까지는 아직 모르겠지만--"
  },
  {
   "id": 34449,
   "key": "D1309ru.txt:295",
   "file": "D1309ru.txt",
   "line": 295,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎」",
   "ko_candidate": "「…쿠로」"
  },
  {
   "id": 34450,
   "key": "D1309ru.txt:298",
   "file": "D1309ru.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルには伝わったらしい。",
   "ko_candidate": "알에게는 전해진 모양이다｡"
  }
 ]
