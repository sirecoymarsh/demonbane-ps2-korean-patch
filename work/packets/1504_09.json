 },
 "items": [
  {
   "id": 42491,
   "key": "D1504le.txt:446",
   "file": "D1504le.txt",
   "line": 446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは酷く酷く、残虐な結末を以って、ウェスパシアヌスの魂に止めを刺す。",
   "ko_candidate": "그것은 몹시도 몹시도 잔혹한 결말로 베스파시아누스의 영혼에 마지막 일격을 가한다｡"
  },
  {
   "id": 42492,
   "key": "D1504le.txt:450",
   "file": "D1504le.txt",
   "line": 450,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ウェスパシアヌス導師。貴方が創った、この子は――」",
   "ko_candidate": "「베스파시아누스 도사｡ 당신이 만든､ 이 아이는――」"
  },
  {
   "id": 42493,
   "key": "D1504le.txt:455",
   "file": "D1504le.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウェスパシアヌスの傍らにしゃがみ込み、その耳元にそっと囁きかける。",
   "ko_candidate": "베스파시아누스의 곁에 쪼그리고 앉아 그의 귓가에 살며시 속삭인다｡"
  },
  {
   "id": 42494,
   "key": "D1504le.txt:455",
   "file": "D1504le.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼の全存在を否定する、凄惨極まる真実と、運命を。",
   "ko_candidate": "그의 모든 존재를 부정하는､ 처참하기 그지없는 진실과 운명을｡"
  },
  {
   "id": 42495,
   "key": "D1504le.txt:459",
   "file": "D1504le.txt",
   "line": 459,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――――――――――――――――――」",
   "ko_candidate": "「――――――――――――――――――――――――――」"
  },
  {
   "id": 42496,
   "key": "D1504le.txt:462",
   "file": "D1504le.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウェスパシアヌスの内で、世界の総てが凍結した。",
   "ko_candidate": "베스파시아누스의 내면에서 세계의 모든 것이 동결되었다｡"
  },
  {
   "id": 42497,
   "key": "D1504le.txt:463",
   "file": "D1504le.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 42498,
   "key": "D1504le.txt:467",
   "file": "D1504le.txt",
   "line": 467,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ああああ……」",
   "ko_candidate": "「아……아아아아……」"
  },
  {
   "id": 42499,
   "key": "D1504le.txt:470",
   "file": "D1504le.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最期の力を振り絞る様な、嗚咽。",
   "ko_candidate": "마지막 힘을 짜내는 듯한 흐느낌｡"
  },
  {
   "id": 42500,
   "key": "D1504le.txt:474",
   "file": "D1504le.txt",
   "line": 474,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あああああああ……！　ああ……！　あああああああああああああ！」",
   "ko_candidate": "「아아아아아아……! 아아……! 아아아아아아아아아아아아아!」"
  },
  {
   "id": 42501,
   "key": "D1504le.txt:477",
   "file": "D1504le.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲鳴。",
   "ko_candidate": "비명｡"
  },
  {
   "id": 42502,
   "key": "D1504le.txt:481",
   "file": "D1504le.txt",
   "line": 481,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あああああああああああああああああああああ――――――――――――――――――――――――――――――――ッッッ！」 「あああああ―――――――――――ッッ！」",
   "ko_candidate": "「아아아아아아아아아아아아아아아아아아아――――――――――――――――――――――――――――――――――읏읏읏! 아아아아아―――――――――――읏읏! 아아아아읏! 우와아아아아아아아아아아――――――――――――――――――――가아아아아아아아아아아아아아아아아아아아아읏읏읏!」"
  },
  {
   "id": 42503,
   "key": "D1504le.txt:487",
   "file": "D1504le.txt",
   "line": 487,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああああッ！」 「うわああああああああああ――――――――――――――――――がああああああああああああああああああああああッッッ！」",
   "ko_candidate": "포효｡"
  },
  {
   "id": 42504,
   "key": "D1504le.txt:493",
   "file": "D1504le.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "咆吼。 世界の総てを呪って、絶望の断末魔が迸る。",
   "ko_candidate": "세계의 모든 것을 저주하며 절망의 단말마가 터져 나온다｡"
  },
  {
   "id": 42505,
   "key": "D1504le.txt:499",
   "file": "D1504le.txt",
   "line": 499,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おのれぇぇぇぇ！　おのれぇぇぇぇ！」 「ライカァァ！　ライカァァ！　逃げろ、ライカァァァァァ！」",
   "ko_candidate": "「이놈아아아아! 이놈아아아아! 라이카아아! 라이카아아! 도망쳐 라이카아아아아아! 그놈에게서……그 괴물에게서! 신들의 오물에게서……! 그놈은……그놈은 아직읏읏!」"
  },
  {
   "id": 42506,
   "key": "D1504le.txt:505",
   "file": "D1504le.txt",
   "line": 505,
   "speaker": "ウェスパシアヌス / エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そいつから……その化物から！ 神々の汚物から……！　奴は……奴はまだッッ！」 「……さようなら。因果すら滅ぼされて、消え失せなさい」",
   "ko_candidate": "「……안녕히｡ 인과마저 멸해져 사라져버리세요」"
  },
  {
   "id": 42507,
   "key": "D1504le.txt:515",
   "file": "D1504le.txt",
   "line": 515,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガァァァァ！　思い出せ取り戻せ！　お前の憎悪を！　お前の憎悪の理由を！　お前ならお前ならお前なら！　奴等を赦せぬ筈なんだ！」 「リュ……！」",
   "ko_candidate": "「류가아아아아! 기억해내 되찾아! 네 증오를! 네 증오의 이유를! 너라면 너라면 너라면! 그놈들을 용서할 수 없을 터다! 류……!」"
  },
  {
   "id": 42508,
   "key": "D1504le.txt:532",
   "file": "D1504le.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウェスパシアヌスの躰が爆発した。",
   "ko_candidate": "베스파시아누스의 몸이 폭발했다｡"
  },
  {
   "id": 42509,
   "key": "D1504le.txt:534",
   "file": "D1504le.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――その場にはただ、血に濡れた十字架だけが残された。",
   "ko_candidate": "――그 자리에는 단지 피에 젖은 십자가만이 남겨졌다｡"
  },
  {
   "id": 42510,
   "key": "D1504ru.txt:14",
   "file": "D1504ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "甲板の上で風に吹かれながら、瑠璃は暮れなずんでゆく水平線の向こう、巨大な……壮大な、長大な扉を見つめていた。",
   "ko_candidate": "갑판 위에서 바람을 맞으며､ 루리는 어두워져 가는 수평선 너머의 거대한… 장대한､ 거대한 문을 바라보고 있었다｡"
  },
  {
   "id": 42511,
   "key": "D1504ru.txt:16",
   "file": "D1504ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜が明ければ、大十字九郎は、あの扉の向こう側へ征く。",
   "ko_candidate": "날이 밝으면､ 다이쥬지 쿠로는 저 문 너머로 나아간다｡"
  },
  {
   "id": 42512,
   "key": "D1504ru.txt:17",
   "file": "D1504ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "如何なる怪異が蠢いているかも分からぬ異界、混沌の渦中へと。",
   "ko_candidate": "어떤 괴이가 꿈틀거리고 있는지도 모르는 이계､ 혼돈의 소용돌이 속으로｡"
  },
  {
   "id": 42513,
   "key": "D1504ru.txt:20",
   "file": "D1504ru.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎はあんな軽い調子で言っていたが、瑠璃は彼の言葉をそのままには信じない。",
   "ko_candidate": "쿠로는 그렇게 가벼운 말투로 말했지만､ 루리는 그의 말을 그대로 믿지 않는다｡"
  },
  {
   "id": 42514,
   "key": "D1504ru.txt:21",
   "file": "D1504ru.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は最後の最後には、自分で全部を背負ってしまう人だ。",
   "ko_candidate": "그는 마지막에는 모든 것을 혼자 짊어지는 사람이다｡"
  },
  {
   "id": 42515,
   "key": "D1504ru.txt:23",
   "file": "D1504ru.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに、彼の瞳。",
   "ko_candidate": "게다가､ 그의 눈동자｡"
  },
  {
   "id": 42516,
   "key": "D1504ru.txt:24",
   "file": "D1504ru.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その奥に閉じ込めた光。",
   "ko_candidate": "그 안에 가둔 빛｡"
  },
  {
   "id": 42517,
   "key": "D1504ru.txt:26",
   "file": "D1504ru.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "隠し通せるはずもない。",
   "ko_candidate": "숨길 수 있을 리가 없다｡"
  },
  {
   "id": 42518,
   "key": "D1504ru.txt:27",
   "file": "D1504ru.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あれは祖父の瞳と同じだ。",
   "ko_candidate": "그건 할아버지의 눈동자와 같다｡"
  },
  {
   "id": 42519,
   "key": "D1504ru.txt:29",
   "file": "D1504ru.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ある種の覚悟を決めたものだけが持つ、悲壮なほどに気高い戦士の瞳。",
   "ko_candidate": "어떤 각오를 다진 사람만이 가질 수 있는､ 비장할 정도로 고귀한 전사의 눈동자｡"
  },
  {
   "id": 42520,
   "key": "D1504ru.txt:31",
   "file": "D1504ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "護るものがある誇りに満ちた、優しさと呼ぶには苛烈過ぎる戦士の瞳だ。",
   "ko_candidate": "지킬 것이 있다는 자부심으로 가득 찬､ 온화함이라고 부르기엔 너무나 가혹한 전사의 눈동자다｡"
  },
  {
   "id": 42521,
   "key": "D1504ru.txt:33",
   "file": "D1504ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃はほぼ確信している。",
   "ko_candidate": "루리는 거의 확신하고 있다｡"
  },
  {
   "id": 42522,
   "key": "D1504ru.txt:34",
   "file": "D1504ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は自らを引き換えに、世界を救うつもりだ。",
   "ko_candidate": "그는 자신을 희생해서라도 세계를 구하려고 한다｡"
  },
  {
   "id": 42523,
   "key": "D1504ru.txt:35",
   "file": "D1504ru.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけどきっと彼は、それを尊い自己犠牲だとは思わない。",
   "ko_candidate": "하지만 분명 그는 그것을 고귀한 자기희생이라고 생각하지 않을 것이다｡"
  },
  {
   "id": 42524,
   "key": "D1504ru.txt:37",
   "file": "D1504ru.txt",
   "line": 37,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「後味が悪ィから」。",
   "ko_candidate": "「뒷맛이 나빠서｡」"
  },
  {
   "id": 42525,
   "key": "D1504ru.txt:39",
   "file": "D1504ru.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただその一言だけで全てを片付けてしまうつもりなのだ。",
   "ko_candidate": "단지 그 한마디로 모든 것을 정리해 버릴 작정인 것이다｡"
  },
  {
   "id": 42526,
   "key": "D1504ru.txt:40",
   "file": "D1504ru.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どんな激烈な戦いも。",
   "ko_candidate": "어떤 격렬한 싸움도｡"
  },
  {
   "id": 42527,
   "key": "D1504ru.txt:41",
   "file": "D1504ru.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どんな凄惨な戦いも。",
   "ko_candidate": "어떤 처참한 싸움도｡"
  },
  {
   "id": 42528,
   "key": "D1504ru.txt:45",
   "file": "D1504ru.txt",
   "line": 45,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん……貴方って人は……」",
   "ko_candidate": "「다이쥬지 씨… 당신이란 사람은…」"
  },
  {
   "id": 42529,
   "key": "D1504ru.txt:48",
   "file": "D1504ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手すりに額を押し付けて、躰を震わせる。",
   "ko_candidate": "난간에 이마를 대고､ 몸을 떨었다｡"
  },
  {
   "id": 42530,
   "key": "D1504ru.txt:49",
   "file": "D1504ru.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳から零れた雫が月光を照り返して、綺羅綺羅と輝いた。",
   "ko_candidate": "눈동자에서 흘러내린 물방울이 달빛을 반사하며､ 반짝반짝 빛났다｡"
  }
 ]
}