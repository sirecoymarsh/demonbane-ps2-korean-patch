 },
 "items": [
  {
   "id": 28859,
   "key": "D1209le.txt:81",
   "file": "D1209le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのときにはもう天井近くまで、跳躍していた。",
   "ko_candidate": "그때는 이미 천장 가까이까지､ 도약해 있었다｡"
  },
  {
   "id": 28860,
   "key": "D1209le.txt:85",
   "file": "D1209le.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目標を失った弾丸がお互いを撃つ。",
   "ko_candidate": "목표를 잃은 총알이 서로를 쏜다｡"
  },
  {
   "id": 28861,
   "key": "D1209le.txt:86",
   "file": "D1209le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マシンガンに撃たれたゾンビが粉々に砕けていくのが見える。",
   "ko_candidate": "기관총에 맞은 좀비가 산산조각 나는 것이 보인다｡"
  },
  {
   "id": 28862,
   "key": "D1209le.txt:93",
   "file": "D1209le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ページの紙片をばら撒く。",
   "ko_candidate": "페이지의 종이 조각을 뿌린다｡"
  },
  {
   "id": 28863,
   "key": "D1209le.txt:94",
   "file": "D1209le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ページの紙吹雪がゾンビの群れを包み込んだ。",
   "ko_candidate": "페이지의 종이 눈보라가 좀비 무리를 감싸 안았다｡"
  },
  {
   "id": 28864,
   "key": "D1209le.txt:97",
   "file": "D1209le.txt",
   "line": 97,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――燃えろ」",
   "ko_candidate": "「――불타라」"
  },
  {
   "id": 28865,
   "key": "D1209le.txt:102",
   "file": "D1209le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紙吹雪は爆炎の竜巻と化す。",
   "ko_candidate": "종이 눈보라는 폭염의 회오리가 되었다｡"
  },
  {
   "id": 28866,
   "key": "D1209le.txt:103",
   "file": "D1209le.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焼き尽くす。",
   "ko_candidate": "태워 없앤다｡"
  },
  {
   "id": 28867,
   "key": "D1209le.txt:104",
   "file": "D1209le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眠れぬ死者を焼き尽くす。",
   "ko_candidate": "잠들지 못한 죽은 자를 태워 없앤다｡"
  },
  {
   "id": 28868,
   "key": "D1209le.txt:105",
   "file": "D1209le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "虚ろな屍体を焼き尽くす。",
   "ko_candidate": "텅 빈 시체를 태워 없앤다｡"
  },
  {
   "id": 28869,
   "key": "D1209le.txt:108",
   "file": "D1209le.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渦巻く焔の中心に、俺は着地した。",
   "ko_candidate": "소용돌이치는 불꽃의 중심에､ 나는 착지했다｡"
  },
  {
   "id": 28870,
   "key": "D1209le.txt:119",
   "file": "D1209le.txt",
   "line": 119,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「簡単な火葬になっちまったけど……成仏しろよ」",
   "ko_candidate": "「간단한 화장이 되어버렸지만……극락에 가라」"
  },
  {
   "id": 28871,
   "key": "D1209le.txt:124",
   "file": "D1209le.txt",
   "line": 124,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まだ湧いてくるぞ……」",
   "ko_candidate": "「아직 더 나오고 있어……」"
  },
  {
   "id": 28872,
   "key": "D1209le.txt:128",
   "file": "D1209le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通路の角を曲がって、ゾンビの大群がわらわらと湧いてくる。",
   "ko_candidate": "통로의 모퉁이를 돌아､ 좀비 대군이 우글우글 몰려온다｡"
  },
  {
   "id": 28873,
   "key": "D1209le.txt:129",
   "file": "D1209le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのほとんどは、警備兵だったものだ。",
   "ko_candidate": "그 대부분은､ 경비병이었던 것들이다｡"
  },
  {
   "id": 28874,
   "key": "D1209le.txt:131",
   "file": "D1209le.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "中には一般人らしき屍体も混じっていたりする。",
   "ko_candidate": "중에는 일반인으로 보이는 시체도 섞여 있기도 하다｡"
  },
  {
   "id": 28875,
   "key": "D1209le.txt:133",
   "file": "D1209le.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コメカミの辺りが怒りに熱くなった。",
   "ko_candidate": "관자놀이 부근이 분노로 뜨거워졌다｡"
  },
  {
   "id": 28876,
   "key": "D1209le.txt:143",
   "file": "D1209le.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアとイタクァを招喚して、構える。",
   "ko_candidate": "크투가와 이타콰를 소환하여､ 준비한다｡"
  },
  {
   "id": 28877,
   "key": "D1209le.txt:146",
   "file": "D1209le.txt",
   "line": 146,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「丁重には弔ってやれないな。勘弁な」",
   "ko_candidate": "「정중하게 조문해 줄 순 없겠다｡ 용서해라」"
  },
  {
   "id": 28878,
   "key": "D1209le.txt:151",
   "file": "D1209le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアが吼えた。",
   "ko_candidate": "크투가가 포효했다｡"
  },
  {
   "id": 28879,
   "key": "D1209le.txt:152",
   "file": "D1209le.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゾンビの先頭集団がバラバラに砕け散る。",
   "ko_candidate": "좀비의 선두 집단이 산산조각 나 흩어진다｡"
  },
  {
   "id": 28880,
   "key": "D1209le.txt:158",
   "file": "D1209le.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は駈け出した。",
   "ko_candidate": "나는 달려나갔다｡"
  },
  {
   "id": 28881,
   "key": "D1209le.txt:168",
   "file": "D1209le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "イタクァを撃つ。",
   "ko_candidate": "이타콰를 쏜다｡"
  },
  {
   "id": 28882,
   "key": "D1209le.txt:171",
   "file": "D1209le.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアのように一撃で吹き飛ばす威力はないが、自在に弾道を変える弾丸は何度も何度も屍体を貫き、引き裂いていく。",
   "ko_candidate": "크투가처럼 일격에 날려버릴 위력은 없지만､ 자유자재로 탄도를 바꾸는 총알은 몇 번이고 몇 번이고 시체를 관통하고､ 찢어놓는다｡"
  },
  {
   "id": 28883,
   "key": "D1209le.txt:174",
   "file": "D1209le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアが穿ち抉り、イタクァが引き裂き引き千切る。",
   "ko_candidate": "크투가가 뚫고 파내고､ 이타콰가 찢고 잡아뜯는다｡"
  },
  {
   "id": 28884,
   "key": "D1209le.txt:175",
   "file": "D1209le.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "屍体の群れをモーゼの如く割って、血煙のアーチを駈け抜ける。",
   "ko_candidate": "시체의 무리를 모세처럼 가르며､ 피연기의 아치를 달려 지나간다｡"
  },
  {
   "id": 28885,
   "key": "D1209le.txt:179",
   "file": "D1209le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウス……今度こそケリをつけてやる！",
   "ko_candidate": "티베리우스……이번엔 확실히 결판을 내주마!"
  },
  {
   "id": 28886,
   "key": "D1209ru.txt:11",
   "file": "D1209ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "噴き出た血は天井をも濡らす。",
   "ko_candidate": "분출된 피가 천장까지 적신다｡"
  },
  {
   "id": 28887,
   "key": "D1209ru.txt:13",
   "file": "D1209ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "斃れたウィンフィールドの傍らには、返り血に染まったティトゥスが立つ。",
   "ko_candidate": "쓰러진 윈필드 곁에는 튄 피에 물든 티투스가 서 있다｡"
  },
  {
   "id": 28888,
   "key": "D1209ru.txt:15",
   "file": "D1209ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "纏う衣の黒と血に濡れた紅。悪夢のコントラスト。",
   "ko_candidate": "걸친 옷의 검은색과 피에 젖은 붉은색｡ 악몽의 대비｡"
  },
  {
   "id": 28889,
   "key": "D1209ru.txt:17",
   "file": "D1209ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの顔が愉悦に歪む。",
   "ko_candidate": "티투스의 얼굴이 희열로 일그러진다｡"
  },
  {
   "id": 28890,
   "key": "D1209ru.txt:23",
   "file": "D1209ru.txt",
   "line": 23,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「総てを捨てる事が出来ぬお主と、力の為に総てを捨てた拙者。 結局は、その差が明暗を分けただけの事よ」",
   "ko_candidate": "「모든 것을 버릴 수 없는 당신과､ 힘을 위해 모든 것을 버린 저｡ 결국은 그 차이가 명암을 갈랐을 뿐이오」"
  },
  {
   "id": 28891,
   "key": "D1209ru.txt:28",
   "file": "D1209ru.txt",
   "line": 28,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ウィンフィールド様！」",
   "ko_candidate": "「……윈필드 님!」"
  },
  {
   "id": 28892,
   "key": "D1209ru.txt:31",
   "file": "D1209ru.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶叫するマコトをティトゥスが睨む。ソーニャの口から小さな悲鳴が零れた。",
   "ko_candidate": "절규하는 마코토를 티투스가 노려본다｡ 소냐의 입에서 작은 비명이 새어 나왔다｡"
  },
  {
   "id": 28893,
   "key": "D1209ru.txt:33",
   "file": "D1209ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "警備兵達は今度こそ、前に出る。",
   "ko_candidate": "경비병들은 이번에야말로 앞으로 나선다｡"
  },
  {
   "id": 28894,
   "key": "D1209ru.txt:35",
   "file": "D1209ru.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスは刀を杖に立つのが、やっとの状態だった。",
   "ko_candidate": "티투스는 칼을 지팡이 삼아 겨우 서 있는 상태였다｡"
  },
  {
   "id": 28895,
   "key": "D1209ru.txt:37",
   "file": "D1209ru.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血に濡れた修羅の貌が、振り返った。",
   "ko_candidate": "피에 젖은 수라의 얼굴이 돌아보았다｡"
  },
  {
   "id": 28896,
   "key": "D1209ru.txt:39",
   "file": "D1209ru.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気圧される一同。全身から汗が噴き出る。",
   "ko_candidate": "기가 눌린 일동｡ 온몸에서 땀이 분출된다｡"
  },
  {
   "id": 28897,
   "key": "D1209ru.txt:40",
   "file": "D1209ru.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蛇に睨まれた蛙の心境。",
   "ko_candidate": "뱀에게 노려본 개구리의 심경｡"
  },
  {
   "id": 28898,
   "key": "D1209ru.txt:44",
   "file": "D1209ru.txt",
   "line": 44,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あわ……あわわわ」",
   "ko_candidate": "「아와……아와와와」"
  }
 ]
}