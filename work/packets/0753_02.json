 "items": [
  {
   "id": 11469,
   "key": "D0753.txt:347",
   "file": "D0753.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何でこんなところに……？",
   "ko_candidate": ""
  },
  {
   "id": 11470,
   "key": "D0753.txt:357",
   "file": "D0753.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そうだ。あのとき魔銃が暴発して……もしかして、それで解き放たれたのか？",
   "ko_candidate": ""
  },
  {
   "id": 11471,
   "key": "D0753.txt:379",
   "file": "D0753.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "地球上のどの生命でも持ち得ない唸り声が、回廊を震わせる。",
   "ko_candidate": ""
  },
  {
   "id": 11472,
   "key": "D0753.txt:381",
   "file": "D0753.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "焔の獣は、イタクァを威嚇するように、睨みつけていた。イタクァは警戒しているのか、硬直して動かない。",
   "ko_candidate": ""
  },
  {
   "id": 11473,
   "key": "D0753.txt:384",
   "file": "D0753.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それにしても……イタクァにクトゥグア、か。",
   "ko_candidate": ""
  },
  {
   "id": 11474,
   "key": "D0753.txt:385",
   "file": "D0753.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何か状況は悪化の一途を辿っているっぽいんだが。",
   "ko_candidate": ""
  },
  {
   "id": 11475,
   "key": "D0753.txt:388",
   "file": "D0753.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だけど躰の中の冷気が消えたのは、クトゥグアの魔力のお陰のようだ。クトゥグアは何故、俺を助けた？",
   "ko_candidate": ""
  },
  {
   "id": 11476,
   "key": "D0753.txt:394",
   "file": "D0753.txt",
   "line": 394,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――ッ」",
   "ko_candidate": ""
  },
  {
   "id": 11477,
   "key": "D0753.txt:400",
   "file": "D0753.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "不利を悟ったのか、背中を向けて逃げ出そうとするイタクァ。だがクトゥグアの方が早かった。",
   "ko_candidate": ""
  },
  {
   "id": 11478,
   "key": "D0753.txt:410",
   "file": "D0753.txt",
   "line": 410,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「…………ッ!?」",
   "ko_candidate": ""
  },
  {
   "id": 11479,
   "key": "D0753.txt:433",
   "file": "D0753.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァの退路を、燃え上がる炎が阻んだ。",
   "ko_candidate": ""
  },
  {
   "id": 11480,
   "key": "D0753.txt:434",
   "file": "D0753.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "回廊いっぱいを炎の壁が遮っている。",
   "ko_candidate": ""
  },
  {
   "id": 11481,
   "key": "D0753.txt:437",
   "file": "D0753.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァが次の行動に移る前に、獣は動いた。",
   "ko_candidate": ""
  },
  {
   "id": 11482,
   "key": "D0753.txt:438",
   "file": "D0753.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "熱波を伴って、一気にイタクァの元まで疾走する。",
   "ko_candidate": ""
  },
  {
   "id": 11483,
   "key": "D0753.txt:441",
   "file": "D0753.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "クトゥグアから発せられる熱風にあぶられ、俺の全身からは汗が噴き出した。",
   "ko_candidate": ""
  },
  {
   "id": 11484,
   "key": "D0753.txt:448",
   "file": "D0753.txt",
   "line": 448,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「Ｎ’ＧＡＡＡ――――――ｉｉｉ！」",
   "ko_candidate": ""
  },
  {
   "id": 11485,
   "key": "D0753.txt:453",
   "file": "D0753.txt",
   "line": 453,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……ァァァァッ！」",
   "ko_candidate": ""
  },
  {
   "id": 11486,
   "key": "D0753.txt:457",
   "file": "D0753.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "炎の獣はイタクァに飛びかかる。",
   "ko_candidate": ""
  },
  {
   "id": 11487,
   "key": "D0753.txt:458",
   "file": "D0753.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "女を押し倒して、身動きを封じる。",
   "ko_candidate": ""
  },
  {
   "id": 11488,
   "key": "D0753.txt:469",
   "file": "D0753.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "白い焔がほとばしる。焔は烈しく燃え盛り、柱となって渦巻き、獣と女を呑み込んだ。",
   "ko_candidate": ""
  },
  {
   "id": 11489,
   "key": "D0753.txt:474",
   "file": "D0753.txt",
   "line": 474,
   "speaker": "イタクァ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ァァァァ――――ッ！」",
   "ko_candidate": ""
  },
  {
   "id": 11490,
   "key": "D0753.txt:478",
   "file": "D0753.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺はどうすることも出来ず、ただ呆然と焔を見つめ続ける。やがて焔の中にゆらりと立ち上がる人影を見た。",
   "ko_candidate": ""
  },
  {
   "id": 11491,
   "key": "D0753.txt:483",
   "file": "D0753.txt",
   "line": 483,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「えっ？」",
   "ko_candidate": ""
  },
  {
   "id": 11492,
   "key": "D0753.txt:490",
   "file": "D0753.txt",
   "line": 490,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "焔の中から出てきたのは――イタクァではなかった。",
   "ko_candidate": ""
  },
  {
   "id": 11493,
   "key": "D0753.txt:493",
   "file": "D0753.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "複数の光球を引き連れ歩く、やはり長身の女。",
   "ko_candidate": ""
  },
  {
   "id": 11494,
   "key": "D0753.txt:495",
   "file": "D0753.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "褐色の肌の上からまとう服は、攻撃性を象徴するためか、軍服に見えなくもない。",
   "ko_candidate": ""
  },
  {
   "id": 11495,
   "key": "D0753.txt:497",
   "file": "D0753.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "……ああ、もうだいたい予想できた。",
   "ko_candidate": ""
  },
  {
   "id": 11496,
   "key": "D0753.txt:498",
   "file": "D0753.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "魔力の気配を探ればすぐ判るだろう。",
   "ko_candidate": ""
  },
  {
   "id": 11497,
   "key": "D0753.txt:507",
   "file": "D0753.txt",
   "line": 507,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……フフッ」",
   "ko_candidate": ""
  },
  {
   "id": 11498,
   "key": "D0753.txt:516",
   "file": "D0753.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "情熱的な瞳が、俺を見つめている。",
   "ko_candidate": ""
  },
  {
   "id": 11499,
   "key": "D0753.txt:517",
   "file": "D0753.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "感情の動きに合わせるように周囲の火球が、明るく昏く明滅する。",
   "ko_candidate": ""
  },
  {
   "id": 11500,
   "key": "D0753.txt:522",
   "file": "D0753.txt",
   "line": 522,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……クトゥグアか」",
   "ko_candidate": ""
  },
  {
   "id": 11501,
   "key": "D0753.txt:530",
   "file": "D0753.txt",
   "line": 530,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「良く分かったな、主」",
   "ko_candidate": ""
  },
  {
   "id": 11502,
   "key": "D0753.txt:534",
   "file": "D0753.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "驚いた。まさか言葉を喋るとは。",
   "ko_candidate": ""
  },
  {
   "id": 11503,
   "key": "D0753.txt:535",
   "file": "D0753.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "予想の斜め上をいかれた感じだ。",
   "ko_candidate": ""
  },
  {
   "id": 11504,
   "key": "D0753.txt:543",
   "file": "D0753.txt",
   "line": 543,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「驚く事ではない。妾もまた『アル・アジフ』の一部。母の霊力を源に、人格を形成したまでの事」",
   "ko_candidate": ""
  },
  {
   "id": 11505,
   "key": "D0753.txt:548",
   "file": "D0753.txt",
   "line": 548,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「母……？　ああ、もしかしてアルのことか」",
   "ko_candidate": ""
  },
  {
   "id": 11506,
   "key": "D0753.txt:553",
   "file": "D0753.txt",
   "line": 553,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「左様。母が主に選んだ男。興味が湧いたので声をかけてみた」",
   "ko_candidate": ""
  },
  {
   "id": 11507,
   "key": "D0753.txt:557",
   "file": "D0753.txt",
   "line": 557,
   "speaker": "クトゥグア",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「だが……我々の様な断片相手に、ここまで不覚を取る様では、『アル・アジフ』のマスターは務まらないのではないか？」",
   "ko_candidate": ""
  },
  {
   "id": 11508,
   "key": "D0753.txt:562",
   "file": "D0753.txt",
   "line": 562,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ちっ……ほっとけ」",
   "ko_candidate": ""
  }
 ]
}