 "items": [
  {
   "id": 48887,
   "key": "D1520le.txt:10",
   "file": "D1520le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇が、崩れてゆく。",
   "ko_candidate": "어둠이 무너져 간다｡"
  },
  {
   "id": 48888,
   "key": "D1520le.txt:11",
   "file": "D1520le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "罅割れ、砕け、融け落ち、泡立ち、揮発する。",
   "ko_candidate": "갈라지고､ 부서지고､ 녹아내리고､ 거품이 일고､ 증발한다｡"
  },
  {
   "id": 48889,
   "key": "D1520le.txt:12",
   "file": "D1520le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "死絶した世界と共に崩れゆく。",
   "ko_candidate": "죽어버린 세계와 함께 무너져 간다｡"
  },
  {
   "id": 48890,
   "key": "D1520le.txt:16",
   "file": "D1520le.txt",
   "line": 16,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……流石にこの子が輪廻の鍵で ある事には、勘付いてたみたいだね」",
   "ko_candidate": "「……역시 이 아이가 윤회의 열쇠라는 걸 눈치챈 모양이군」"
  },
  {
   "id": 48891,
   "key": "D1520le.txt:20",
   "file": "D1520le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇の女もまた、崩れてゆく。",
   "ko_candidate": "어둠의 여자 또한 무너져 간다｡"
  },
  {
   "id": 48892,
   "key": "D1520le.txt:21",
   "file": "D1520le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "罅割れた貌が、凝っと俺たちを見つめていた。",
   "ko_candidate": "갈라진 얼굴이 우리를 뚫어지게 바라보고 있었다｡"
  },
  {
   "id": 48893,
   "key": "D1520le.txt:25",
   "file": "D1520le.txt",
   "line": 25,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どうやら完全に僕の負けのようだ。 おめでとう、九郎君。アル・アジフ。真逆、こんな容で僕の庭が壊れるとは思わなかったよ」",
   "ko_candidate": "「아무래도 완전히 내가 진 것 같군｡ 축하해､ 쿠로 군｡ 알 아지프｡ 설마하니､ 이런 모습으로 내 정원이 망가질 줄은 몰랐어」"
  },
  {
   "id": 48894,
   "key": "D1520le.txt:29",
   "file": "D1520le.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "言って、亀裂のような笑みを浮かべる。",
   "ko_candidate": "말하며､ 균열 같은 미소를 짓는다｡"
  },
  {
   "id": 48895,
   "key": "D1520le.txt:30",
   "file": "D1520le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや、実際に亀裂が走っていた。",
   "ko_candidate": "아니､ 실제로 균열이 생기고 있었다｡"
  },
  {
   "id": 48896,
   "key": "D1520le.txt:31",
   "file": "D1520le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "音を立て、貌の半分が砕け散る。",
   "ko_candidate": "소리를 내며､ 얼굴의 절반이 부서져 흩어진다｡"
  },
  {
   "id": 48897,
   "key": "D1520le.txt:35",
   "file": "D1520le.txt",
   "line": 35,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だけどね。輪廻が砕ければ、今までの世界もまた砕け散る。 九郎君。君の世界もまた、結局は僕の輪廻の上に在ったのさ」 「だから、九郎君。君があの街に帰っても……もう其処は君が生きた世界ではない」",
   "ko_candidate": "「하지만 말이야｡ 윤회가 부서지면､ 지금까지의 세계도 부서져 흩어지지｡ 쿠로 군｡ 너의 세계도 결국은 내 윤회 위에 있었던 거야｡ 그러니까､ 쿠로 군｡ 네가 그 거리로 돌아가도……이제 그곳은 네가 살았던 세계가 아니야｡ 대황금시대이자 대혼란시대이자 대암흑시대의 아캄시티는､ 이제 존재하지 않아」"
  },
  {
   "id": 48898,
   "key": "D1520le.txt:42",
   "file": "D1520le.txt",
   "line": 42,
   "speaker": "ナイア / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大黄金時代にして大混乱時代にして大暗黒時代のアーカムシティは、もう存在しないのさ」 「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 48899,
   "key": "D1520le.txt:49",
   "file": "D1520le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "躰が砕けて、塵になる。",
   "ko_candidate": "몸이 부서져､ 먼지가 된다｡"
  },
  {
   "id": 48900,
   "key": "D1520le.txt:53",
   "file": "D1520le.txt",
   "line": 53,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「君たちも所詮は狂った因果の産物さ。さあ……総ては正しく因果に還る。君たちも還るが良い」 「僕はまた、宇宙の外から、生き足掻くちっぽけな君たちを嘲笑い続けよう」",
   "ko_candidate": "「너희들도 결국은 미친 인과의 산물이야｡ 자……모든 것은 올바른 인과로 돌아가｡ 너희들도 돌아가는 게 좋아｡ 나는 또､ 우주 밖에서､ 살아 발버둥치는 조그마한 너희들을 비웃으며 계속 지켜보겠어」"
  },
  {
   "id": 48901,
   "key": "D1520le.txt:59",
   "file": "D1520le.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "陰鬱な愉悦に歪む口許が最後に残された。",
   "ko_candidate": "음울한 희열로 일그러진 입술이 마지막으로 남겨졌다｡"
  },
  {
   "id": 48902,
   "key": "D1520le.txt:60",
   "file": "D1520le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "虚空に浮かぶ口が大きく開かれた。",
   "ko_candidate": "허공에 떠 있는 입이 크게 벌어졌다｡"
  },
  {
   "id": 48903,
   "key": "D1520le.txt:87",
   "file": "D1520le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "女の口の向こうに広がるのは――別の宇宙。",
   "ko_candidate": "여자의 입 너머로 펼쳐지는 것은――다른 우주｡"
  },
  {
   "id": 48904,
   "key": "D1520le.txt:88",
   "file": "D1520le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "宇宙は怒濤の勢いで、こっち側に、砕け散る世界へと",
   "ko_candidate": "우주가 거센 기세로､ 이쪽으로､ 부서져 흩어지는 세계로"
  },
  {
   "id": 48905,
   "key": "D1520le.txt:89",
   "file": "D1520le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "雪崩れ込んできた！",
   "ko_candidate": "눈사태처럼 밀려들어왔다!"
  },
  {
   "id": 48906,
   "key": "D1520le.txt:93",
   "file": "D1520le.txt",
   "line": 93,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何ぃぃぃ――――っ!?」",
   "ko_candidate": "「뭐어어어――――엇!?」"
  },
  {
   "id": 48907,
   "key": "D1520le.txt:97",
   "file": "D1520le.txt",
   "line": 97,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あはははは！　あはははははははは！　あははははははははははは！」",
   "ko_candidate": "「아하하하! 아하하하하하하! 아하하하하하하하하하!」"
  },
  {
   "id": 48908,
   "key": "D1520le.txt:100",
   "file": "D1520le.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ナイアの哄笑が轟き渡る。",
   "ko_candidate": "나이아의 폭소가 울려 퍼진다｡"
  },
  {
   "id": 48909,
   "key": "D1520le.txt:106",
   "file": "D1520le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "拡がる宇宙が深淵の顎を広げる。",
   "ko_candidate": "펼쳐지는 우주가 심연의 턱을 벌린다｡"
  },
  {
   "id": 48910,
   "key": "D1520le.txt:107",
   "file": "D1520le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無限のソラに向かって、俺たちは堕ちてゆく。",
   "ko_candidate": "무한한 하늘을 향해､ 우리는 떨어져 간다｡"
  },
  {
   "id": 48911,
   "key": "D1520le.txt:114",
   "file": "D1520le.txt",
   "line": 114,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くっ……！　ライカさんッッッ！」",
   "ko_candidate": "「큿……! 라이카 씨이이이!」"
  },
  {
   "id": 48912,
   "key": "D1520le.txt:119",
   "file": "D1520le.txt",
   "line": 119,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃんっっっ！」",
   "ko_candidate": "「쿠로 챠아안!」"
  },
  {
   "id": 48913,
   "key": "D1520le.txt:122",
   "file": "D1520le.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "堕ちながら、互いに手を伸ばす。",
   "ko_candidate": "떨어지면서､ 서로에게 손을 뻗는다｡"
  },
  {
   "id": 48914,
   "key": "D1520le.txt:123",
   "file": "D1520le.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "指先が触れる、その寸前――",
   "ko_candidate": "손끝이 닿을 듯한 그 순간――"
  },
  {
   "id": 48915,
   "key": "D1520le.txt:128",
   "file": "D1520le.txt",
   "line": 128,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣……?」"
  },
  {
   "id": 48916,
   "key": "D1520le.txt:134",
   "file": "D1520le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんを包むメタトロンの装甲が砕けて、宙に輝いた。",
   "ko_candidate": "라이카 씨를 감싸고 있던 메타트론의 장갑이 부서져､ 공중에서 빛났다｡"
  },
  {
   "id": 48917,
   "key": "D1520le.txt:135",
   "file": "D1520le.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そのまま装甲は光の粒子と化して、ソラに散った。",
   "ko_candidate": "그대로 장갑은 빛의 입자가 되어､ 하늘에 흩어졌다｡"
  },
  {
   "id": 48918,
   "key": "D1520le.txt:136",
   "file": "D1520le.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光翼を失ったライカさんは、急速に深淵へと吸い込まれていく！",
   "ko_candidate": "빛의 날개를 잃은 라이카 씨는､ 급속도로 심연으로 빨려 들어간다!"
  },
  {
   "id": 48919,
   "key": "D1520le.txt:141",
   "file": "D1520le.txt",
   "line": 141,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何で……!?」",
   "ko_candidate": "「왜……!?」"
  },
  {
   "id": 48920,
   "key": "D1520le.txt:145",
   "file": "D1520le.txt",
   "line": 145,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ライカさ……っ！　――――!?」",
   "ko_candidate": "「라이카 씨……읏! ――――!?」"
  },
  {
   "id": 48921,
   "key": "D1520le.txt:148",
   "file": "D1520le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんだけでは無かった。",
   "ko_candidate": "라이카 씨뿐만이 아니었다｡"
  },
  {
   "id": 48922,
   "key": "D1520le.txt:149",
   "file": "D1520le.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺を包むボディスーツもまた、魔導書のページに変わって、ソラに散る。",
   "ko_candidate": "나를 감싸고 있던 바디슈트 또한､ 마도서의 페이지로 변해､ 하늘에 흩어진다｡"
  },
  {
   "id": 48923,
   "key": "D1520le.txt:151",
   "file": "D1520le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒翼を失い、深淵へと吸い込まれる。",
   "ko_candidate": "검은 날개를 잃고､ 심연으로 빨려 들어간다｡"
  },
  {
   "id": 48924,
   "key": "D1520le.txt:155",
   "file": "D1520le.txt",
   "line": 155,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どうしたんだっ、アル!?」",
   "ko_candidate": "「어떻게 된 거야､ 알!?」"
  },
  {
   "id": 48925,
   "key": "D1520le.txt:164",
   "file": "D1520le.txt",
   "line": 164,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あ……ああ……！」",
   "ko_candidate": "「아……아아……!」"
  },
  {
   "id": 48926,
   "key": "D1520le.txt:168",
   "file": "D1520le.txt",
   "line": 168,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アルっっっ!?」",
   "ko_candidate": "「알아아아!?」"
  }
 ]
