   "key": "D0602.txt:318",
   "file": "D0602.txt",
   "line": 318,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「それで……何を悩んでいるの、 九郎ちゃん？」",
   "ko_candidate": "「그래서…… 무엇 때문에 고민하고 있는 거야､ 쿠로 군?」"
  },
  {
   "id": 6929,
   "key": "D0602.txt:324",
   "file": "D0602.txt",
   "line": 324,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……何のことだよ？」",
   "ko_candidate": "「……무슨 소리야?」"
  },
  {
   "id": 6930,
   "key": "D0602.txt:329",
   "file": "D0602.txt",
   "line": 329,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「しらばっくれても駄目ーっ。 アルちゃんから聞いたもの」",
   "ko_candidate": "「시치미 떼도 소용없어~｡ 알 짱한테 들었거든」"
  },
  {
   "id": 6931,
   "key": "D0602.txt:335",
   "file": "D0602.txt",
   "line": 335,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ちっ……余計なことを」",
   "ko_candidate": "「쓸데없는 소리를……」"
  },
  {
   "id": 6932,
   "key": "D0602.txt:340",
   "file": "D0602.txt",
   "line": 340,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だいたい、いつもと様子が違うことぐらいバレバレよ。あんまり、お姉さんを甘く見ないことねー」",
   "ko_candidate": "「대충､ 평소와 다른 모습이라는 것 정도는 다 보이는걸｡ 너무 누나를 얕보지 말라구~」"
  }
 ]
