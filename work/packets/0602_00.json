  {
   "id": 6914,
   "key": "D0602.txt:219",
   "file": "D0602.txt",
   "line": 219,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「人間、中身はそうそう変わらんからな。特に莫迦は死ぬまで治らんと来る」",
   "ko_candidate": "「……인간､ 속은 변하지 않으니까｡ 특히 바보는 죽을 때까지 고쳐지지 않는다고」"
  },
  {
   "id": 6915,
   "key": "D0602.txt:228",
   "file": "D0602.txt",
   "line": 228,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あらあらあら、アルちゃんはアルちゃんで機嫌が悪いみたいね？」",
   "ko_candidate": "「어머어머어머､ 알 짱도 알 짱대로 기분이 안 좋아 보이네?」"
  },
  {
   "id": 6916,
   "key": "D0602.txt:233",
   "file": "D0602.txt",
   "line": 233,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……別に。単に些細な事でいちいち気に病む、彼奴の弱さが苛つくだけだ」",
   "ko_candidate": "「……별로｡ 단지､ 사소한 일에 일일이 신경 쓰는 그자의 약함이 짜증날 뿐이다」"
  },
  {
   "id": 6917,
   "key": "D0602.txt:241",
   "file": "D0602.txt",
   "line": 241,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「んー？　ははぁーん？　アルちゃん、九郎ちゃんに構ってもらえなくて寂しい？　寂しい？　もお、可愛いんだからっ」",
   "ko_candidate": "「음~? 하하아~앙? 알 짱､ 쿠로 군이 신경 안 써줘서 외로워? 외로워? 정말､ 귀여운 걸」"
  },
  {
   "id": 6918,
   "key": "D0602.txt:246",
   "file": "D0602.txt",
   "line": 246,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「つまらん冗談は止せ。何で妾が、あのうつけに気を取られねばならんのだ」",
   "ko_candidate": "「시시한 농담은 그만둬｡ 왜 내가 저 멍청이에게 신경 써야 하는 거지」"
  },
  {
   "id": 6919,
   "key": "D0602.txt:253",
   "file": "D0602.txt",
   "line": 253,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふぅ～～ん？　へぇ～～？ ほほぉ～～？」",
   "ko_candidate": "「후우~운? 헤에~? 호호오~?」"
  },
  {
   "id": 6920,
   "key": "D0602.txt:260",
   "file": "D0602.txt",
   "line": 260,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……不愉快な女だな、汝も」",
   "ko_candidate": "「……불쾌한 여자로군､ 너도」"
  },
  {
   "id": 6921,
   "key": "D0602.txt:269",
   "file": "D0602.txt",
   "line": 269,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うふふ、いっつもいつも世話を焼かせる２人に、お返しですよーだ」",
   "ko_candidate": "「우후후､ 항상 항상 신경 쓰게 만드는 두 사람에게､ 보답이에요~」"
  },
  {
   "id": 6922,
