 "items": [
  {
   "id": 42051,
   "key": "D1503le.txt:408",
   "file": "D1503le.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が痛みを訴える。",
   "ko_candidate": "의식이 고통을 호소한다｡"
  },
  {
   "id": 42052,
   "key": "D1503le.txt:409",
   "file": "D1503le.txt",
   "line": 409,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眩みそうなほどに、私を苛み続ける。",
   "ko_candidate": "어지러울 정도로 나를 괴롭힌다｡"
  },
  {
   "id": 42053,
   "key": "D1503le.txt:411",
   "file": "D1503le.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皮肉な事にその痛みこそが、急速に私の自我を、復元させてゆく。",
   "ko_candidate": "아이러니하게도 그 고통이야말로 급속도로 내 자아를 복원시켜 간다｡"
  },
  {
   "id": 42054,
   "key": "D1503le.txt:413",
   "file": "D1503le.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私は――この光景を識っている。",
   "ko_candidate": "나는――이 광경을 알고 있다｡"
  },
  {
   "id": 42055,
   "key": "D1503le.txt:414",
   "file": "D1503le.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これと同じ光景を識っている。",
   "ko_candidate": "이와 같은 광경을 알고 있다｡"
  },
  {
   "id": 42056,
   "key": "D1503le.txt:416",
   "file": "D1503le.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうだ――私は、繰り返してしまった。",
   "ko_candidate": "그래――나는 반복해 버렸다｡"
  },
  {
   "id": 42057,
   "key": "D1503le.txt:417",
   "file": "D1503le.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの時と同じ――私の罪。",
   "ko_candidate": "그때와 같은――내 죄를｡"
  },
  {
   "id": 42058,
   "key": "D1503le.txt:418",
   "file": "D1503le.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "永遠に刻まれた、私の罪。",
   "ko_candidate": "영원히 새겨진､ 내 죄를｡"
  },
  {
   "id": 42059,
   "key": "D1503le.txt:419",
   "file": "D1503le.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃れられない、私の罪。",
   "ko_candidate": "벗어날 수 없는､ 내 죄를｡"
  },
  {
   "id": 42060,
   "key": "D1503le.txt:422",
   "file": "D1503le.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――『彼』を、殺した罪。",
   "ko_candidate": "――『그』를､ 죽인 죄를｡"
  },
  {
   "id": 42061,
   "key": "D1503ru.txt:15",
   "file": "D1503ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……二度とは戻れない。",
   "ko_candidate": "……다시는 돌아갈 수 없다｡"
  },
  {
   "id": 42062,
   "key": "D1503ru.txt:16",
   "file": "D1503ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、確かに在る俺の総てを捨てなければならない。",
   "ko_candidate": "지금､ 확실히 존재하는 나의 모든 것을 버려야만 한다｡"
  },
  {
   "id": 42063,
   "key": "D1503ru.txt:17",
   "file": "D1503ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それで、迷わないはずはなかった。",
   "ko_candidate": "그래서､ 망설이지 않을 수가 없었다｡"
  },
  {
   "id": 42064,
   "key": "D1503ru.txt:33",
   "file": "D1503ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「一晩だけ待つ。それで決断するが良い。 ――征くか、留まるか」",
   "ko_candidate": "「하룻밤만 기다려｡ 그리고 결단하도록 해｡ ――갈 것인가､ 머물 것인가」"
  },
  {
   "id": 42065,
   "key": "D1503ru.txt:44",
   "file": "D1503ru.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう言ってアルは独りで考える時間を与えてくれた。",
   "ko_candidate": "그렇게 말하며 알은 혼자 생각할 시간을 주었다｡"
  },
  {
   "id": 42066,
   "key": "D1503ru.txt:46",
   "file": "D1503ru.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "たった一晩……短すぎる。",
   "ko_candidate": "단 하룻밤……너무 짧다｡"
  },
  {
   "id": 42067,
   "key": "D1503ru.txt:47",
   "file": "D1503ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もしくは長すぎる。",
   "ko_candidate": "아니면 너무 길다｡"
  },
  {
   "id": 42068,
   "key": "D1503ru.txt:49",
   "file": "D1503ru.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てと決別するには。",
   "ko_candidate": "모든 것과 결별하기에는｡"
  },
  {
   "id": 42069,
   "key": "D1503ru.txt:50",
   "file": "D1503ru.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あるいは決意を鈍らせないには。",
   "ko_candidate": "혹은 결의를 무디게 하지 않으려면｡"
  },
  {
   "id": 42070,
   "key": "D1503ru.txt:52",
   "file": "D1503ru.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、それでも――",
   "ko_candidate": "하지만､ 그래도――"
  },
  {
   "id": 42071,
   "key": "D1503ru.txt:64",
   "file": "D1503ru.txt",
   "line": 64,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……どうだ？」",
   "ko_candidate": "「……어때?」"
  },
  {
   "id": 42072,
   "key": "D1503ru.txt:70",
   "file": "D1503ru.txt",
   "line": 70,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大したことはない。すぐに片付くのである。 魔術回路の調整に少々手間がかかる程度か」",
   "ko_candidate": "「대단한 일은 아니다｡ 곧 끝날 것이다｡ 마술 회로의 조정에 약간 시간이 걸리는 정도랄까」"
  },
  {
   "id": 42073,
   "key": "D1503ru.txt:75",
   "file": "D1503ru.txt",
   "line": 75,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……って、だから何であんたが 答えとるねん!? ええい！　出てかんかいっ！」",
   "ko_candidate": "「……아니､ 그래서 왜 네가 대답하고 있는 거야!? 이런! 나가라고!」"
  },
  {
   "id": 42074,
   "key": "D1503ru.txt:81",
   "file": "D1503ru.txt",
   "line": 81,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「黙れ、凡人眼鏡」",
   "ko_candidate": "「닥쳐､ 범인 안경」"
  },
  {
   "id": 42075,
   "key": "D1503ru.txt:85",
   "file": "D1503ru.txt",
   "line": 85,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「キ――――――――――ッ！」",
   "ko_candidate": "「크――――――――――읏!」"
  },
  {
   "id": 42076,
   "key": "D1503ru.txt:89",
   "file": "D1503ru.txt",
   "line": 89,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いや……その。とにかく、夜が明けるまでに頼むぜ？　……多分、奴との戦いでは、僅かなズレが勝敗を決する。万全を期したいんだ」",
   "ko_candidate": "「아니……그｡ 어쨌든､ 날이 밝기 전까지 부탁해? ……아마도､ 그 녀석과의 싸움에서는 작은 차이가 승패를 가를 거야｡ 만전을 기하고 싶어」"
  },
  {
   "id": 42077,
   "key": "D1503ru.txt:95",
   "file": "D1503ru.txt",
   "line": 95,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そんなに時間は 要らぬのであーる！」",
   "ko_candidate": "「그렇게 시간은 필요 없다고!」"
  },
  {
   "id": 42078,
   "key": "D1503ru.txt:104",
   "file": "D1503ru.txt",
   "line": 104,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「殺す！　今、ここで殺す！　絶対殺す！」",
   "ko_candidate": "「죽여버릴 거야! 지금､ 여기서 죽여버릴 거야! 절대 죽여버릴 거라고!」"
  },
  {
   "id": 42079,
   "key": "D1503ru.txt:108",
   "file": "D1503ru.txt",
   "line": 108,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「本当に頼んだからな？　……いや、マジに大丈夫か、お前ら？」",
   "ko_candidate": "「정말로 부탁했으니까? ……아니､ 진짜 괜찮아､ 너희들?」"
  },
  {
   "id": 42080,
   "key": "D1503ru.txt:113",
   "file": "D1503ru.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一抹の不安を抱えつつ、喧々囂々と罵声が響き渡る格納庫を離れた。",
   "ko_candidate": "한 줄기 불안을 안고､ 시끌벅적 욕설이 울려 퍼지는 격납고를 떠났다｡"
  },
  {
   "id": 42081,
   "key": "D1503ru.txt:113",
   "file": "D1503ru.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "出る間際にちょうど中に入ってきたエルザと鉢合わせになる。",
   "ko_candidate": "나가는 순간 마침 들어오던 엘자와 마주쳤다｡"
  },
  {
   "id": 42082,
   "key": "D1503ru.txt:124",
   "file": "D1503ru.txt",
   "line": 124,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ダーリン……征くロボか？」",
   "ko_candidate": "「쿠로……갈 로봇이야?」"
  },
  {
   "id": 42083,
   "key": "D1503ru.txt:128",
   "file": "D1503ru.txt",
   "line": 128,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ、これでラストだ。俺は奴を……」",
   "ko_candidate": "「응､ 이게 마지막이야｡ 나는 그 녀석을……」"
  },
  {
   "id": 42084,
   "key": "D1503ru.txt:132",
   "file": "D1503ru.txt",
   "line": 132,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――マスターテリオンを斃しに征ってくる」",
   "ko_candidate": "「――마스터 테리온을 쓰러뜨리러 갈 거야」"
  },
  {
   "id": 42085,
   "key": "D1503ru.txt:144",
   "file": "D1503ru.txt",
   "line": 144,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……いよいよですか」",
   "ko_candidate": "「……드디어군요」"
  },
  {
   "id": 42086,
   "key": "D1503ru.txt:148",
   "file": "D1503ru.txt",
   "line": 148,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ、奴をぶっ潰して、ヨグ＝ソトースを追っ払う。今度こそしっかりケリをつけてくるよ」",
   "ko_candidate": "「응､ 그 녀석을 박살내고､ 요그 소토스를 쫓아낼 거야｡ 이번에야말로 확실히 결판을 내고 올 거야」"
  },
  {
   "id": 42087,
   "key": "D1503ru.txt:153",
   "file": "D1503ru.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "答える俺に、姫さんは不安と俺に対する気遣いが混じった憂いの表情を浮かべる。",
   "ko_candidate": "대답하는 나에게､ 공주님은 불안과 나에 대한 걱정이 섞인 근심 어린"
  },
  {
   "id": 42088,
   "key": "D1503ru.txt:157",
   "file": "D1503ru.txt",
   "line": 157,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「でも、マスターテリオンが生きていたなんて……」",
   "ko_candidate": "표정을 짓는다｡ 「하지만､ 마스터 테리온이 살아있었다니……」"
  },
  {
   "id": 42089,
   "key": "D1503ru.txt:161",
   "file": "D1503ru.txt",
   "line": 161,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……つくづく化物だよ、奴は。あんなものがこの世にいちゃいけないんだ」 「だから討つ。それが出来るのは俺とアルしかいないんだから」",
   "ko_candidate": "「……정말 괴물이야､ 그 녀석은｡ 저런 게 이 세상에 있어선 안 돼｡ 그래서 물리치는 거야｡ 그걸 할 수 있는 건 나와 알뿐이니까」"
  },
  {
   "id": 42090,
   "key": "D1503ru.txt:168",
   "file": "D1503ru.txt",
   "line": 168,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「申し訳御座いません。結局、我々は大十字様に全てを背負わせてしまっています」",
   "ko_candidate": "「죄송합니다｡ 결국､ 저희는 다이쥬지님께 모든 걸 떠맡기고 말았습니다」"
  }
 ]
}