 },
 "items": [
  {
   "id": 34291,
   "key": "D1309le.txt:623",
   "file": "D1309le.txt",
   "line": 623,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……てめえ」",
   "ko_candidate": "「……네놈」"
  },
  {
   "id": 34292,
   "key": "D1309le.txt:627",
   "file": "D1309le.txt",
   "line": 627,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おいおい……貴様の相手は己ではない。奴の方だろ？」",
   "ko_candidate": "「이봐이봐……네놈의 상대는 내가 아니야｡ 그 녀석 쪽이겠지?」"
  },
  {
   "id": 34293,
   "key": "D1309le.txt:635",
   "file": "D1309le.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地の底より、瘴気が噴き出した。",
   "ko_candidate": "땅속에서 장기가 뿜어져 나왔다｡"
  },
  {
   "id": 34294,
   "key": "D1309le.txt:636",
   "file": "D1309le.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の様に紅いラインが描く、巨大な魔法陣。",
   "ko_candidate": "피처럼 붉은 선이 그리는 거대한 마법진｡"
  },
  {
   "id": 34295,
   "key": "D1309le.txt:638",
   "file": "D1309le.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地に刻まれたそれからは、腐臭と血臭が入り混じった穢れた気が立ち昇ってくる。",
   "ko_candidate": "대지에 새겨진 그것에서는 썩은 냄새와 피 냄새가 뒤섞인 더러운 기운이 피어오른다｡"
  },
  {
   "id": 34296,
   "key": "D1309le.txt:639",
   "file": "D1309le.txt",
   "line": 639,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔法円の内に、闇黒の穴が生じた。",
   "ko_candidate": "마법진 안에 암흑의 구멍이 생겼다｡"
  },
  {
   "id": 34297,
   "key": "D1309le.txt:640",
   "file": "D1309le.txt",
   "line": 640,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "亡者の呻き声が聴こえてくる。",
   "ko_candidate": "망자의 신음 소리가 들려온다｡"
  },
  {
   "id": 34298,
   "key": "D1309le.txt:644",
   "file": "D1309le.txt",
   "line": 644,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……デ・ウェルミス・ミステリイス」",
   "ko_candidate": "「……데 베르미스 미스테리이스」"
  },
  {
   "id": 34299,
   "key": "D1309le.txt:647",
   "file": "D1309le.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "亡者達の無念よりも強く、ティベリウスの呪文は世界に轟いた。",
   "ko_candidate": "망자들의 무념보다 강하게 티베리우스의 주문이 세계에 울려 퍼졌다｡"
  },
  {
   "id": 34300,
   "key": "D1309le.txt:648",
   "file": "D1309le.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……来る。",
   "ko_candidate": "……온다｡"
  },
  {
   "id": 34301,
   "key": "D1309le.txt:652",
   "file": "D1309le.txt",
   "line": 652,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――鬼械神ベルゼビュート！　暴食せよ！」",
   "ko_candidate": "「――귀계신 벨제뷰트! 폭식하라!」 ――땅속에서｡"
  },
  {
   "id": 34302,
   "key": "D1309le.txt:663",
   "file": "D1309le.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――地の底より。",
   "ko_candidate": "명부와 이어진 심연에서｡"
  },
  {
   "id": 34303,
   "key": "D1309le.txt:664",
   "file": "D1309le.txt",
   "line": 664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冥府と繋がる深淵より。",
   "ko_candidate": "벨제뷰트가 기어올라왔다｡"
  },
  {
   "id": 34304,
   "key": "D1309le.txt:665",
   "file": "D1309le.txt",
   "line": 665,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ベルゼビュートが這い上がってきた。",
   "ko_candidate": "어둠이 귀계신의 기체에 감겨 끈적거렸다｡"
  },
  {
   "id": 34305,
   "key": "D1309le.txt:667",
   "file": "D1309le.txt",
   "line": 667,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇が鬼械神の機体に纏わり、粘ついていた。 瘴気が靄となって、醜悪な鬼械神の姿を妖しく翳ませる。",
   "ko_candidate": "장기가 안개가 되어 추악한 귀계신의 모습을 요염하게 가린다｡"
  },
  {
   "id": 34306,
   "key": "D1309le.txt:672",
   "file": "D1309le.txt",
   "line": 672,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何度も……何度も……何度も何度も何度も！　アンタはアタシを不愉快にさせるのね！　気持ち良くないわぁ……気持ち良くないのよ、アンタ！」 「もっともっともっと無様に地べたを這いずり回ってなさいッッ！」",
   "ko_candidate": "「몇 번이고……몇 번이고……몇 번이고 몇 번이고 몇 번이고! 넌 날 불쾌하게 만드는구나! 기분 좋지 않아……기분 좋지 않아､ 너! 더더더 볼품없이 땅바닥을 기어다녀!」"
  },
  {
   "id": 34307,
   "key": "D1309le.txt:680",
   "file": "D1309le.txt",
   "line": 680,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベルゼビュートの周囲の瘴気が、怒号を浴びて、渦を巻く。",
   "ko_candidate": "벨제뷰트 주위의 장기가 고함을 맞고 소용돌이친다｡"
  },
  {
   "id": 34308,
   "key": "D1309le.txt:681",
   "file": "D1309le.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……いい加減、この耳障りな声にも、吐き気を催す腐臭にも、胸糞悪い気配にも飽き飽きだ。",
   "ko_candidate": "……이제 충분히 이 귀에 거슬리는 목소리에도､ 구토를 일으키는 썩은 냄새에도､ 속이 메스꺼운 기운에도 질렸다｡"
  },
  {
   "id": 34309,
   "key": "D1309le.txt:682",
   "file": "D1309le.txt",
   "line": 682,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――終わりにしてやる。",
   "ko_candidate": "――끝내주겠어｡"
  },
  {
   "id": 34310,
   "key": "D1309le.txt:685",
   "file": "D1309le.txt",
   "line": 685,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「地べたを這いずるのは、蛆虫野郎の専売特許だろ？ てめえのお株を奪うワケにはいかねえな。謹んで辞退させてもらうよ」",
   "ko_candidate": "「땅바닥을 기어다니는 건 구더기 녀석의 전매특허잖아? 네놈의 자리를 빼앗을 순 없지｡ 정중히 사양하겠어」"
  },
  {
   "id": 34311,
   "key": "D1309le.txt:690",
   "file": "D1309le.txt",
   "line": 690,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「貴様らなんかに勝ち目など微塵にも……！」",
   "ko_candidate": "「너희들 따위에게 승산 따위는 미진도……!」"
  },
  {
   "id": 34312,
   "key": "D1309le.txt:700",
   "file": "D1309le.txt",
   "line": 700,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「わざわざデモンベインを修理してくれたのは、致命的なミスだったな？ ――アル！」",
   "ko_candidate": "「일부러 데몬베인을 수리해준 건 치명적인 실수였지? ――알!」"
  },
  {
   "id": 34313,
   "key": "D1309le.txt:706",
   "file": "D1309le.txt",
   "line": 706,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「応！　……九郎。格の違いというものを教育してやろうぞ」",
   "ko_candidate": "「응! ……쿠로｡ 격의 차이라는 것을 가르쳐 주지」"
  },
  {
   "id": 34314,
   "key": "D1309le.txt:710",
   "file": "D1309le.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは光の粒子となって、自らのコクピットへと吸い込まれていく。",
   "ko_candidate": "알은 빛의 입자가 되어 자신의 콕핏으로 빨려 들어간다｡"
  },
  {
   "id": 34315,
   "key": "D1309le.txt:711",
   "file": "D1309le.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もまた剥き出しのコクピットに身を預ける。",
   "ko_candidate": "나 또한 드러난 콕핏에 몸을 맡긴다｡"
  },
  {
   "id": 34316,
   "key": "D1309le.txt:714",
   "file": "D1309le.txt",
   "line": 714,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もう哭く必要はないぜ、デモンベイン。 さあ……反撃タイムと行こうじゃないか！」",
   "ko_candidate": "「이제 울 필요는 없어､ 데몬베인｡ 자… 반격 타임으로 가볼까!」"
  },
  {
   "id": 34317,
   "key": "D1309le.txt:733",
   "file": "D1309le.txt",
   "line": 733,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎の戦いは、大十字九郎の起こした逆転の奇蹟は、神への畏怖に麻痺した司令室のモニターにも映し出されていた。",
   "ko_candidate": "다이쥬지 쿠로의 싸움은､ 다이쥬지 쿠로가 일으킨 역전의 기적은､ 신에 대한 두려움에 마비된 사령실의 모니터에도 비춰지고 있었다｡"
  },
  {
   "id": 34318,
   "key": "D1309le.txt:735",
   "file": "D1309le.txt",
   "line": 735,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、誰もがモニターを注視出来ない。",
   "ko_candidate": "하지만､ 누구도 모니터를 주시할 수 없다｡"
  },
  {
   "id": 34319,
   "key": "D1309le.txt:736",
   "file": "D1309le.txt",
   "line": 736,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ一人――瑠璃を除いては。",
   "ko_candidate": "단 한 사람――루리를 제외하고는｡"
  },
  {
   "id": 34320,
   "key": "D1309le.txt:740",
   "file": "D1309le.txt",
   "line": 740,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん」",
   "ko_candidate": "「……다이쥬지 씨」"
  },
  {
   "id": 34321,
   "key": "D1309le.txt:743",
   "file": "D1309le.txt",
   "line": 743,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインに纏わる、空間を歪める程の瘴気が、霧散する。",
   "ko_candidate": "데몬베인을 감싸고 있던､ 공간을 왜곡할 정도의 장기가 흩어진다｡"
  },
  {
   "id": 34322,
   "key": "D1309le.txt:745",
   "file": "D1309le.txt",
   "line": 745,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正しき主の元に還って、正しき戦友を取り戻して、デモンベインは本来在るべき姿へと浄化されてゆく。",
   "ko_candidate": "올바른 주인에게 돌아가､ 올바른 전우를 되찾아､ 데몬베인은 본래 있어야 할 모습으로 정화되어 간다｡"
  },
  {
   "id": 34323,
   "key": "D1309le.txt:746",
   "file": "D1309le.txt",
   "line": 746,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "輝く聖剣が、聖戦士の手に帰還する。",
   "ko_candidate": "빛나는 성검이 성전사의 손에 귀환한다｡"
  },
  {
   "id": 34324,
   "key": "D1309le.txt:748",
   "file": "D1309le.txt",
   "line": 748,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは、邪神が織る闇の深さに比べ、あまりにも脆弱な灯火だった。",
   "ko_candidate": "그것은 사신이 짜는 어둠의 깊이에 비해 너무나도 취약한 등불이었다｡"
  },
  {
   "id": 34325,
   "key": "D1309le.txt:749",
   "file": "D1309le.txt",
   "line": 749,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれは、無限の闇黒でしかなかった世界の中で、それでも確固と存在する希望の光だった。",
   "ko_candidate": "하지만 그것은 무한한 암흑뿐이었던 세계 속에서 그래도 확고히 존재하는 희망의 빛이었다｡"
  },
  {
   "id": 34326,
   "key": "D1309le.txt:751",
   "file": "D1309le.txt",
   "line": 751,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は歯を食いしばる。",
   "ko_candidate": "루리는 이를 악문다｡"
  },
  {
   "id": 34327,
   "key": "D1309le.txt:752",
   "file": "D1309le.txt",
   "line": 752,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕け散りそうなほどの圧力を受けて、奥歯が軋む。",
   "ko_candidate": "부서질 것 같은 압력을 받아 어금니가 삐걱거린다｡"
  },
  {
   "id": 34328,
   "key": "D1309le.txt:754",
   "file": "D1309le.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これしきの事で、諦めてどうする！",
   "ko_candidate": "이 정도 일로 포기해서 어쩌겠어!"
  },
  {
   "id": 34329,
   "key": "D1309le.txt:755",
   "file": "D1309le.txt",
   "line": 755,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃。",
   "ko_candidate": "루리｡"
  },
  {
   "id": 34330,
   "key": "D1309le.txt:756",
   "file": "D1309le.txt",
   "line": 756,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "貴女は、覇道家の人間でしょう！",
   "ko_candidate": "당신은 하도가의 사람이잖아!"
  }
 ]
}