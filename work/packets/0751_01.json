 "items": [
  {
   "id": 11326,
   "key": "D0751.txt:390",
   "file": "D0751.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "答えるや否や、アーカムシティを見下ろす時計塔の上空で、時空が歪んだ。",
   "ko_candidate": ""
  },
  {
   "id": 11327,
   "key": "D0751.txt:393",
   "file": "D0751.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "顕現した光が、デモンベイン目がけて真っ直ぐに飛来する。高速で飛んでくるそれを、しかと右手で受け止めた。",
   "ko_candidate": ""
  },
  {
   "id": 11328,
   "key": "D0751.txt:399",
   "file": "D0751.txt",
   "line": 399,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「こいつは……」",
   "ko_candidate": ""
  },
  {
   "id": 11329,
   "key": "D0751.txt:409",
   "file": "D0751.txt",
   "line": 409,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "見た目は拳銃をデモンベインに合うサイズにまで拡大した感じ。バカバカしいほどのデカさだ。",
   "ko_candidate": ""
  },
  {
   "id": 11330,
   "key": "D0751.txt:415",
   "file": "D0751.txt",
   "line": 415,
   "speaker": "チアキ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「クトゥグアから発生したエネルギーを指向性を持たせて、制御している」",
   "ko_candidate": ""
  },
  {
   "id": 11331,
   "key": "D0751.txt:419",
   "file": "D0751.txt",
   "line": 419,
   "speaker": "チアキ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「プラズマ・ガン……と言ったところやね。ただし本来のパワーの十分の一程度まで落ちとるけど……」",
   "ko_candidate": ""
  },
  {
   "id": 11332,
   "key": "D0751.txt:425",
   "file": "D0751.txt",
   "line": 425,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「充分！　感謝だぜ！」",
   "ko_candidate": ""
  },
  {
   "id": 11333,
   "key": "D0751.txt:443",
   "file": "D0751.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "こちらに気付いたのか、イタクァは巨人の輪郭を崩し、膨らみ……体内に吹雪を閉じ込める積乱雲と化した。",
   "ko_candidate": ""
  },
  {
   "id": 11334,
   "key": "D0751.txt:451",
   "file": "D0751.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "時折、ほとばしる雷。",
   "ko_candidate": ""
  },
  {
   "id": 11335,
   "key": "D0751.txt:452",
   "file": "D0751.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "荒れ狂う嵐の塊にはやはり、あの炎える２つの星。",
   "ko_candidate": ""
  },
  {
   "id": 11336,
   "key": "D0751.txt:458",
   "file": "D0751.txt",
   "line": 458,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「来るぞ……！」",
   "ko_candidate": ""
  },
  {
   "id": 11337,
   "key": "D0751.txt:482",
   "file": "D0751.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イタクァは限界まで膨張すると――突然に収縮。",
   "ko_candidate": ""
  },
  {
   "id": 11338,
   "key": "D0751.txt:483",
   "file": "D0751.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "白く凍る暴風と化して、急降下してきた！",
   "ko_candidate": ""
  },
  {
   "id": 11339,
   "key": "D0751.txt:486",
   "file": "D0751.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "雲状の身体にはまったく効果がない……となれば大概この手のお約束では目が弱点だったりするのだ。",
   "ko_candidate": ""
  },
  {
   "id": 11340,
   "key": "D0751.txt:487",
   "file": "D0751.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "つーか、それくらいしかひらめかない。",
   "ko_candidate": ""
  },
  {
   "id": 11341,
   "key": "D0751.txt:490",
   "file": "D0751.txt",
   "line": 490,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "銃に運命を乗せて、あとはただ祈るだけだ――！",
   "ko_candidate": ""
  },
  {
   "id": 11342,
   "key": "D0751.txt:496",
   "file": "D0751.txt",
   "line": 496,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「喰らえ！」",
   "ko_candidate": ""
  },
  {
   "id": 11343,
   "key": "D0751.txt:533",
   "file": "D0751.txt",
   "line": 533,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「やったか！？」",
   "ko_candidate": ""
  },
  {
   "id": 11344,
   "key": "D0751.txt:539",
   "file": "D0751.txt",
   "line": 539,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「まだだ！　気配が――！」",
   "ko_candidate": ""
  },
  {
   "id": 11345,
   "key": "D0751.txt:559",
   "file": "D0751.txt",
   "line": 559,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――っ！？」",
   "ko_candidate": ""
  },
  {
   "id": 11346,
   "key": "D0751.txt:580",
   "file": "D0751.txt",
   "line": 580,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "弾き飛ばされ、大地に倒れるデモンベイン。その上にのしかかるイタクァは、氷の身体を持つドラゴンの姿をしていた。",
   "ko_candidate": ""
  },
  {
   "id": 11347,
   "key": "D0751.txt:586",
   "file": "D0751.txt",
   "line": 586,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「これが本体か！？」",
   "ko_candidate": ""
  },
  {
   "id": 11348,
   "key": "D0751.txt:591",
   "file": "D0751.txt",
   "line": 591,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そうか……雲を吹き飛ばされ、本性を……」",
   "ko_candidate": ""
  },
  {
   "id": 11349,
   "key": "D0751.txt:612",
   "file": "D0751.txt",
   "line": 612,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「くあああっ！」",
   "ko_candidate": ""
  },
  {
   "id": 11350,
   "key": "D0751.txt:623",
   "file": "D0751.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "氷竜が、デモンベインの首に牙を突き立てる。",
   "ko_candidate": ""
  },
  {
   "id": 11351,
   "key": "D0751.txt:624",
   "file": "D0751.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "破損箇所が放電し、水銀の血を撒き散らした。",
   "ko_candidate": ""
  },
  {
   "id": 11352,
   "key": "D0751.txt:630",
   "file": "D0751.txt",
   "line": 630,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「くぅぅぅ……！」",
   "ko_candidate": ""
  },
  {
   "id": 11353,
   "key": "D0751.txt:642",
   "file": "D0751.txt",
   "line": 642,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「や、ヤロぉぉぉぉ……！」",
   "ko_candidate": ""
  },
  {
   "id": 11354,
   "key": "D0751.txt:649",
   "file": "D0751.txt",
   "line": 649,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "振りほどこうと足掻くが、マウントポジションは崩せない。暴れるほどに、地面がひび割れ、陥没する。",
   "ko_candidate": ""
  },
  {
   "id": 11355,
   "key": "D0751.txt:655",
   "file": "D0751.txt",
   "line": 655,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「あんまり……調子にっ！　乗るんじゃねえ！」",
   "ko_candidate": ""
  },
  {
   "id": 11356,
   "key": "D0751.txt:672",
   "file": "D0751.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "今しがた撃ったばかりの拳銃を、氷竜の腹の辺りに押しつける。これなら外れねえぞ！",
   "ko_candidate": ""
  },
  {
   "id": 11357,
   "key": "D0751.txt:680",
   "file": "D0751.txt",
   "line": 680,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「喰ら……！」",
   "ko_candidate": ""
  },
  {
