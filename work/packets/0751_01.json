   "speaker": "ネロ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……くすくす」",
   "ko_candidate": ""
  },
  {
   "id": 11359,
   "key": "D0751.txt:714",
   "file": "D0751.txt",
   "line": 714,
   "speaker": "マコト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――！？　プラズマ・ガン内部の魔力が、規定値を超えて増大。暴走します」",
   "ko_candidate": ""
  },
  {
   "id": 11360,
   "key": "D0751.txt:720",
