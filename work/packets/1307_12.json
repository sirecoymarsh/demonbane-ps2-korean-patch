{
 "packet": "1307_12",
 "scene": "1307",
 "anchor": {
  "hit": 30,
  "total": 32,
  "rate": 0.938
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ウィルバー・ウェイトリイ": "윌버 웨이틀리",
  "魔導書": "마도서",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 33497,
   "key": "D1307ru.txt:534",
   "file": "D1307ru.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "汚液を吐き散らして、山羊ツラの化け物はもがき苦しむ。",
   "ko_candidate": "더러운 액체를 토해내며､ 염소 얼굴의 괴물은 몸부림치며 고통스러워한다｡"
  },
  {
   "id": 33498,
   "key": "D1307ru.txt:538",
   "file": "D1307ru.txt",
   "line": 538,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「時が来れば、我等は必ず巡り逢う」",
   "ko_candidate": "「때가 오면､ 우리는 반드시 만나게 될 것이다」"
  },
  {
   "id": 33499,
   "key": "D1307ru.txt:541",
   "file": "D1307ru.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰だ……お前は、俺を助けてくれたお前はいったい誰なんだ？",
   "ko_candidate": "누구야… 너는､ 나를 도와준 너는 대체 누구야?"
  },
  {
   "id": 33500,
   "key": "D1307ru.txt:542",
   "file": "D1307ru.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何なんだ？",
   "ko_candidate": "뭐야?"
  },
  {
   "id": 33501,
   "key": "D1307ru.txt:544",
   "file": "D1307ru.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹きつけるページが、ウィルバー・ウェイトリイを取り囲み、高速で回転する。魔導書の断片によって造られた竜巻に、怪異を閉じ込める。",
   "ko_candidate": "불어닥치는 페이지가､ 윌버 웨이틀리를 둘러싸고､ 고속으로 회전한다｡ 마도서의 파편으로 만들어진 회오리에､ 괴이를 가두어 버린다｡"
  },
  {
   "id": 33502,
   "key": "D1307ru.txt:548",
   "file": "D1307ru.txt",
   "line": 548,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だが……今はまだだ！　まだなのだ！」",
   "ko_candidate": "「하지만… 지금은 아직이다! 아직인 것이다!」"
  },
  {
   "id": 33503,
   "key": "D1307ru.txt:552",
   "file": "D1307ru.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜巻の内部で雷が迸る。",
   "ko_candidate": "회오리 내부에서 번개가 튀어오른다｡"
  },
  {
   "id": 33504,
   "key": "D1307ru.txt:553",
   "file": "D1307ru.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雷撃が異形の躰を灼きながら、引き裂いてゆく。",
   "ko_candidate": "번개가 기괴한 몸을 태우며､ 찢어발긴다｡"
  },
  {
   "id": 33505,
   "key": "D1307ru.txt:554",
   "file": "D1307ru.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶叫は風に阻まれる。",
   "ko_candidate": "절규는 바람에 막힌다｡"
  },
  {
   "id": 33506,
   "key": "D1307ru.txt:556",
   "file": "D1307ru.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰が……誰がいったい、俺を……！",
   "ko_candidate": "누가… 대체 누가､ 나를…!"
  },
  {
   "id": 33507,
   "key": "D1307ru.txt:557",
   "file": "D1307ru.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の向こうに目を凝らしても、嵐の主の姿は見えない。",
   "ko_candidate": "바람 너머로 눈을 부릅떠도､ 폭풍의 주인 모습은 보이지 않는다｡"
  },
  {
   "id": 33508,
   "key": "D1307ru.txt:559",
   "file": "D1307ru.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ風の合間を縫って、たなびく銀の煌きと、それから。",
   "ko_candidate": "바람의 틈새를 타고､ 흩날리는 은빛 광채와､ 그리고｡"
  },
  {
   "id": 33509,
   "key": "D1307ru.txt:563",
   "file": "D1307ru.txt",
   "line": 563,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今はまだ外道の知識を操る術が、理不尽と戦う力が、来たるべき運命に抗う意志が無い！　無いのだ……」",
   "ko_candidate": "「지금은 아직 외도의 지식을 다루는 술법이､ 불합리와 싸울 힘이､ 다가올 운명에 맞설 의지가 없어! 없다고……」"
  },
  {
   "id": 33510,
   "key": "D1307ru.txt:566",
   "file": "D1307ru.txt",
   "line": 566,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "翡翠の――",
   "ko_candidate": "비취색의――"
  },
  {
   "id": 33511,
   "key": "D1307ru.txt:571",
   "file": "D1307ru.txt",
   "line": 571,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――九郎！」",
   "ko_candidate": "「――쿠로!」"
  },
  {
   "id": 33512,
   "key": "D1307ru.txt:574",
   "file": "D1307ru.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そいつは、確かにあの時、俺の名を呼んだ。",
   "ko_candidate": "그것은､ 분명 그때､ 내 이름을 불렀다｡"
  },
  {
   "id": 33513,
   "key": "D1307ru.txt:578",
   "file": "D1307ru.txt",
   "line": 578,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えずふぁれす、おりゅあらむ、いりおん・えしゅてりおん……！」",
   "ko_candidate": "「에즈파레스､ 오류아라무､ 이리온?에슈테리온……!」"
  },
  {
   "id": 33514,
   "key": "D1307ru.txt:582",
   "file": "D1307ru.txt",
   "line": 582,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 33515,
   "key": "D1307ru.txt:589",
   "file": "D1307ru.txt",
   "line": 589,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪文と共に、ウィルバー・ウェイトリイを捕らえる竜巻が爆裂する。",
   "ko_candidate": "주문과 함께､ 윌버 웨이틀리를 포획하는 회오리바람이 폭발한다｡"
  },
  {
   "id": 33516,
   "key": "D1307ru.txt:593",
   "file": "D1307ru.txt",
   "line": 593,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……写本の力か！」",
   "ko_candidate": "「큿……사본의 힘인가!」"
  },
  {
   "id": 33517,
   "key": "D1307ru.txt:596",
   "file": "D1307ru.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ボロボロの躰からは想像もつかないほどの俊敏さで、図書館から逃げ出そうと出口に走る。",
   "ko_candidate": "너덜너덜한 몸에서는 상상도 할 수 없을 정도의 민첩함으로､ 도서관에서 도망치려 출구로 달린다｡"
  },
  {
   "id": 33518,
   "key": "D1307ru.txt:598",
   "file": "D1307ru.txt",
   "line": 598,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……同じだ。",
   "ko_candidate": "……똑같아｡"
  },
  {
   "id": 33519,
   "key": "D1307ru.txt:599",
   "file": "D1307ru.txt",
   "line": 599,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの時とまったく同じだ。",
   "ko_candidate": "그때와 완전히 똑같아｡"
  },
  {
   "id": 33520,
   "key": "D1307ru.txt:600",
   "file": "D1307ru.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。そして奴は……",
   "ko_candidate": "그래｡ 그리고 그놈은……"
  },
  {
   "id": 33521,
   "key": "D1307ru.txt:604",
   "file": "D1307ru.txt",
   "line": 604,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……アアああアアアア!?」",
   "ko_candidate": "「……아아아아아아아아!?」"
  },
  {
   "id": 33522,
   "key": "D1307ru.txt:607",
   "file": "D1307ru.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "玄関から一匹の黒い狗が飛び込んで来た。",
   "ko_candidate": "현관에서 한 마리의 검은 개가 뛰어들어 왔다｡"
  },
  {
   "id": 33523,
   "key": "D1307ru.txt:609",
   "file": "D1307ru.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狗はウィルバー・ウェイトリイに猛然と襲いかかり、その喉笛を噛み千切る。",
   "ko_candidate": "개는 윌버 웨이틀리에게 맹렬히 달려들어､ 그의 목구멍을 물어뜯는다｡"
  },
  {
   "id": 33524,
   "key": "D1307ru.txt:611",
   "file": "D1307ru.txt",
   "line": 611,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鮮血の代わりに、汚液が迸った。",
   "ko_candidate": "선혈 대신에､ 더러운 액체가 튀었다｡"
  },
  {
   "id": 33525,
   "key": "D1307ru.txt:612",
   "file": "D1307ru.txt",
   "line": 612,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同時に空間を黒く冒す、瘴気も。",
   "ko_candidate": "동시에 공간을 검게 물들이는､ 장기도｡"
  },
  {
   "id": 33526,
   "key": "D1307ru.txt:613",
   "file": "D1307ru.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴の力が奪われてゆく。",
   "ko_candidate": "그놈의 힘이 빼앗겨 간다｡"
  },
  {
   "id": 33527,
   "key": "D1307ru.txt:615",
   "file": "D1307ru.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "断末魔の絶叫を上げ、ウィルバー・ウェイトリイは斃れた。",
   "ko_candidate": "단말마의 절규를 지르며､ 윌버 웨이틀리는 쓰러졌다｡"
  },
  {
   "id": 33528,
   "key": "D1307ru.txt:617",
   "file": "D1307ru.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィップアーウィルの啼き声。",
   "ko_candidate": "휘프어윌의 울음소리｡"
  },
  {
   "id": 33529,
   "key": "D1307ru.txt:618",
   "file": "D1307ru.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その黒犬は、斃れた怪異の躰を踏みつけ、冷笑を浮かべた。",
   "ko_candidate": "그 검은 개는､ 쓰러진 괴이의 몸을 밟고､ 냉소를 띄웠다｡"
  },
  {
   "id": 33530,
   "key": "D1307ru.txt:620",
   "file": "D1307ru.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故か、嗤っていると、確信できた。",
   "ko_candidate": "왠지､ 비웃고 있다고､ 확신할 수 있었다｡"
  },
  {
   "id": 33531,
   "key": "D1307ru.txt:622",
   "file": "D1307ru.txt",
   "line": 622,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒犬が俺たちの方を振り向いた。",
   "ko_candidate": "검은 개가 우리 쪽을 돌아보았다｡"
  },
  {
   "id": 33532,
   "key": "D1307ru.txt:623",
   "file": "D1307ru.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒曜石の様な瞳には、確かな知性が感じられる。",
   "ko_candidate": "흑요석 같은 눈동자에는､ 분명한 지성이 느껴진다｡"
  },
  {
   "id": 33533,
   "key": "D1307ru.txt:624",
   "file": "D1307ru.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳の奥に宿した澄み渡る闇は、邪悪の彩に染まっていて。",
   "ko_candidate": "눈동자 안쪽에 깃든 맑디맑은 어둠은､ 사악의 색채로 물들어 있고｡"
  },
  {
   "id": 33534,
   "key": "D1307ru.txt:626",
   "file": "D1307ru.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――吼えた。",
   "ko_candidate": "――으르렁거렸다｡"
  },
  {
   "id": 33535,
   "key": "D1307ru.txt:628",
   "file": "D1307ru.txt",
   "line": 628,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "牙を剥き出しにして、俺たちに向かって来る……！",
   "ko_candidate": "이빨을 드러내며､ 우리를 향해 달려온다……!"
  },
  {
   "id": 33536,
   "key": "D1307ru.txt:632",
   "file": "D1307ru.txt",
   "line": 632,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃああぁぁっ！」",
   "ko_candidate": "「꺄아아아앗!」"
  }
 ]
}