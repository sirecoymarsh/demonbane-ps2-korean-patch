   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正面を向いて……硬直した。",
   "ko_candidate": "정면을 향하고… 굳어버렸다｡"
  },
  {
   "id": 33458,
   "key": "D1307ru.txt:415",
   "file": "D1307ru.txt",
   "line": 415,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「？」",
   "ko_candidate": "「?」"
  },
  {
   "id": 33459,
   "key": "D1307ru.txt:419",
   "file": "D1307ru.txt",
   "line": 419,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん」",
   "ko_candidate": "「……다이쥬지 씨」"
  },
  {
   "id": 33460,
   "key": "D1307ru.txt:423",
   "file": "D1307ru.txt",
   "line": 423,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度は、何だよ？」",
   "ko_candidate": "「이번엔 뭐야?」"
  },
  {
   "id": 33461,
   "key": "D1307ru.txt:427",
   "file": "D1307ru.txt",
   "line": 427,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アレ……本当に、ちゃんと仕留めたんですか？」",
   "ko_candidate": "「그거… 정말로 제대로 처리하셨나요?」"
  },
  {
   "id": 33462,
   "key": "D1307ru.txt:431",
   "file": "D1307ru.txt",
   "line": 431,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アレ……って」",
   "ko_candidate": "「그거… 라니」"
  },
  {
   "id": 33463,
   "key": "D1307ru.txt:434",
   "file": "D1307ru.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皆まで言う必要はなかった。",
   "ko_candidate": "굳이 끝까지 말할 필요는 없었다｡"
  },
  {
   "id": 33464,
   "key": "D1307ru.txt:435",
   "file": "D1307ru.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――妖気。",
   "ko_candidate": "――요기｡"
  },
  {
   "id": 33465,
   "key": "D1307ru.txt:439",
   "file": "D1307ru.txt",
   "line": 439,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おいおい……何でだよ」",
   "ko_candidate": "「이봐이봐… 왜 그래」"
  },
  {
   "id": 33466,
   "key": "D1307ru.txt:442",
   "file": "D1307ru.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "驚いたと言うよりビビったと言うより、むしろ呆れた。",
   "ko_candidate": "놀랐다기보다는 겁먹었다기보다는､ 오히려 어이가 없었다｡"
  },
  {
   "id": 33467,
   "key": "D1307ru.txt:443",
   "file": "D1307ru.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀を構えて、姫さんを背中に庇って、前に出る。",
   "ko_candidate": "언월도를 구비고､ 공주님을 등 뒤로 감싸며､ 앞으로 나선다｡"
  },
  {
   "id": 33468,
   "key": "D1307ru.txt:447",
   "file": "D1307ru.txt",
   "line": 447,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じょぐッ、しょっとッ、ほッと、ス！ ゆぐ・そぐ・ごォォォォォォォすぅぅぅぅぅぅぅ！」",
   "ko_candidate": "「죠그､ 쇼트､ 호트､ 스! 유구?소구?고오오오오오오스으으으으으으!」"
  },
  {
   "id": 33469,
   "key": "D1307ru.txt:451",
   "file": "D1307ru.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィルバー・ウェイトリイ。",
   "ko_candidate": "윌버 웨이틀리｡"
  },
  {
   "id": 33470,
   "key": "D1307ru.txt:452",
   "file": "D1307ru.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "四分割にしたのに、また元通りになって、俺たちの前に立ちはだかっている。",
   "ko_candidate": "사등분했는데도､ 다시 원래대로 돌아와서､ 우리 앞을 가로막고 있다｡"
  },
  {
   "id": 33471,
   "key": "D1307ru.txt:454",
   "file": "D1307ru.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……どうにもおかしい。",
   "ko_candidate": "…뭔가 이상하다｡"
  },
  {
   "id": 33472,
   "key": "D1307ru.txt:455",
   "file": "D1307ru.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そりゃあ、夢の世界の出来事なんだから不条理で当たり前かも知れないが、つまり何だ？　まだ俺は恐怖を克服してないってことか？",
   "ko_candidate": "그야 꿈속의 일이니까 불합리한 게 당연할 수도 있겠지만､ 즉 뭐지? 아직 내가 공포를 극복하지 못했다는 건가?"
  },
  {
   "id": 33473,
   "key": "D1307ru.txt:456",
   "file": "D1307ru.txt",
   "line": 456,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……何かが釈然としねえ。",
   "ko_candidate": "…뭔가 석연치 않다｡"
  },
  {
   "id": 33474,
   "key": "D1307ru.txt:463",
   "file": "D1307ru.txt",
   "line": 463,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん」",
   "ko_candidate": "「……다이쥬지 씨」"
  },
  {
   "id": 33475,
   "key": "D1307ru.txt:467",
   "file": "D1307ru.txt",
   "line": 467,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「んー、何か変だなぁ。まあ……やるっきゃねえか」",
   "ko_candidate": "「음- 뭔가 이상하네｡ 뭐… 할 수밖에 없지」"
  },
  {
   "id": 33476,
   "key": "D1307ru.txt:471",
   "file": "D1307ru.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀を右に、クトゥグアを左に構える。",
   "ko_candidate": "언월도를 오른손에､ 크투가를 왼손에 구비한다｡"
  },
  {
   "id": 33477,
   "key": "D1307ru.txt:472",
   "file": "D1307ru.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刀身に炎える秘文字。銃身を走る光。",
   "ko_candidate": "도신에 타오르는 비문자｡ 총신을 달리는 빛｡"
  },
  {
   "id": 33478,
   "key": "D1307ru.txt:474",
   "file": "D1307ru.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――その時だった。",
   "ko_candidate": "――그때였다｡"
  },
  {
   "id": 33479,
   "key": "D1307ru.txt:478",
   "file": "D1307ru.txt",
   "line": 478,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――っっ」",
   "ko_candidate": "「――――읏」"
  },
  {
   "id": 33480,
   "key": "D1307ru.txt:481",
   "file": "D1307ru.txt",
   "line": 481,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "山羊ヅラに、明らかな怯えが浮かんだ。",
   "ko_candidate": "염소 얼굴에､ 명백한 두려움이 떠올랐다｡"
  },
  {
   "id": 33481,
   "key": "D1307ru.txt:482",
   "file": "D1307ru.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その恐怖を見つけたとき、俺は悟った。",
   "ko_candidate": "그 공포를 발견했을 때､ 나는 깨달았다｡"
  },
  {
   "id": 33482,
   "key": "D1307ru.txt:483",
   "file": "D1307ru.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、思い出した。",
   "ko_candidate": "아니､ 기억해냈다｡"
  },
  {
   "id": 33483,
   "key": "D1307ru.txt:486",
   "file": "D1307ru.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうだ。あの時もそうだった。",
   "ko_candidate": "그래｡ 그때도 그랬어｡"
  },
  {
   "id": 33484,
   "key": "D1307ru.txt:487",
   "file": "D1307ru.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が、この化け物に殺されそうになったあの時。",
   "ko_candidate": "내가､ 이 괴물에게 죽을 뻔했던 그때｡"
  },
  {
   "id": 33485,
   "key": "D1307ru.txt:488",
   "file": "D1307ru.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの時も、こいつの貌には今と同じ恐怖が――",
   "ko_candidate": "그때도､ 이놈의 얼굴에는 지금과 같은 공포가――"
  },
  {
   "id": 33486,
   "key": "D1307ru.txt:494",
   "file": "D1307ru.txt",
   "line": 494,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔導書の頁が嵐となって、吹き荒んだ。",
   "ko_candidate": "마도서의 페이지가 폭풍이 되어､ 거세게 불어닥쳤다｡"
  },
  {
   "id": 33487,
   "key": "D1307ru.txt:495",
   "file": "D1307ru.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "嵐に乗って奔るページは切れ味すら伴って、 ウィルバー・ウェイトリイを襲う。",
   "ko_candidate": "폭풍을 타고 달리는 페이지는 날카로움마저 띠며､ 윌버 웨이틀리를 덮친다｡ 울려 퍼지는 인간의 것이 아닌 비명｡ 휘프어윌이 운다｡"
  },
  {
   "id": 33488,
   "key": "D1307ru.txt:497",
   "file": "D1307ru.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "響き渡るヒトのものならぬ悲鳴。 ウィップアーウィルが啼く。",
   "ko_candidate": "「읏! 무､ 무슨 일이 일어나고 있는 거죠!?」"
  },
  {
   "id": 33489,
   "key": "D1307ru.txt:505",
   "file": "D1307ru.txt",
   "line": 505,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ッッ！　な、何が起こっているんですかっ!?」 吹き飛ばされないように両足を踏ん張って、姫さんを胸に抱いて風から守りながら、俺は今起ころうとしていることを見届けようと、目を凝らす。",
   "ko_candidate": "날아가지 않도록 두 발로 버티며､ 공주님을 가슴에 안고 바람으로부터 보호하면서､ 나는 지금 일어나려 하는 일을 지켜보려 눈을 부릅뜬다｡"
  },
  {
   "id": 33490,
   "key": "D1307ru.txt:515",
   "file": "D1307ru.txt",
   "line": 515,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――まだ早い」",
   "ko_candidate": "「――아직 이르다」"
  },
  {
   "id": 33491,
   "key": "D1307ru.txt:518",
   "file": "D1307ru.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き荒れる嵐の向こうから聴こえる、あの声。",
   "ko_candidate": "거세게 불어대는 폭풍 너머에서 들리는､ 그 목소리｡"
  },
  {
   "id": 33492,
   "key": "D1307ru.txt:522",
   "file": "D1307ru.txt",
   "line": 522,
   "speaker": "過去アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まだ出逢うには、早い」",
   "ko_candidate": "「아직 만나기엔､ 이르다」"
  },
  {
   "id": 33493,
   "key": "D1307ru.txt:525",
   "file": "D1307ru.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの時、巡り逢ったもう一つの怪異。",
   "ko_candidate": "그때､ 마주쳤던 또 다른 괴이｡"
  },
  {
   "id": 33494,
   "key": "D1307ru.txt:526",
   "file": "D1307ru.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――俺を救った、怪異。",
   "ko_candidate": "――나를 구해준､ 괴이｡"
  },
  {
   "id": 33495,
   "key": "D1307ru.txt:527",
   "file": "D1307ru.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やっぱり……この夢はまだ、過去をなぞっているんだ！",
   "ko_candidate": "역시… 이 꿈은 아직､ 과거를 더듬고 있는 거야!"
  },
  {
   "id": 33496,
   "key": "D1307ru.txt:533",
   "file": "D1307ru.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見えない衝撃がウィルバー・ウェイトリイを撃つ。",
   "ko_candidate": "보이지 않는 충격이 윌버 웨이틀리를 강타한다｡"
  }
 ]
}