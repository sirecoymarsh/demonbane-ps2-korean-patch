 "items": [
  {
   "id": 31771,
   "key": "D1304al.txt:15",
   "file": "D1304al.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベルゼビュートの瘴気は、未だにデモンベインを侵し続けている。",
   "ko_candidate": "벨제뷰트의 장기는 여전히 데몬베인을 침식하고 있다｡"
  },
  {
   "id": 31772,
   "key": "D1304al.txt:16",
   "file": "D1304al.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ステータスが危険域を突破し、モニターが赤く、忙しく、点滅していた。",
   "ko_candidate": "상태가 위험 영역을 돌파하고､ 모니터가 빨갛게､ 바쁘게､ 점멸하고 있었다｡"
  },
  {
   "id": 31773,
   "key": "D1304al.txt:18",
   "file": "D1304al.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔面を掴むベルゼビュートを引き剥がそうと腕を伸ばすが、魔術回路のイカれたデモンベインはいうことを聞かない。",
   "ko_candidate": "얼굴을 붙잡은 벨제뷰트를 떼어내려고 팔을 뻗지만､ 마술 회로가 망가진 데몬베인은 말을 듣지 않는다｡"
  },
  {
   "id": 31774,
   "key": "D1304al.txt:23",
   "file": "D1304al.txt",
   "line": 23,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まずいロボ！　各種機関の稼働率がどんどん落ちているロボ！」",
   "ko_candidate": "「큰일이로봇! 각종 기관의 가동률이 점점 떨어지고 있로봇!」"
  },
  {
   "id": 31775,
   "key": "D1304al.txt:28",
   "file": "D1304al.txt",
   "line": 28,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なろぉぉぉぉっ！　くっ!?」",
   "ko_candidate": "「으아아아아앗! 크윽!? ……크으아악!」"
  },
  {
   "id": 31776,
   "key": "D1304al.txt:32",
   "file": "D1304al.txt",
   "line": 32,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ぐぅああっ！」 ふとベルゼビュートがデモンベインを手放した。",
   "ko_candidate": "문득 벨제뷰트가 데몬베인을 놓아주었다｡"
  },
  {
   "id": 31777,
   "key": "D1304al.txt:35",
   "file": "D1304al.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインが地に崩れ落ちる。",
   "ko_candidate": "데몬베인이 땅에 무너져 내린다｡"
  },
  {
   "id": 31778,
   "key": "D1304al.txt:42",
   "file": "D1304al.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地面に両膝を突いて、 倒れないようにするのが精一杯だった。",
   "ko_candidate": "땅에 양 무릎을 꿇고､ 쓰러지지 않도록 하는 것이 고작이었다｡"
  },
  {
   "id": 31779,
   "key": "D1304al.txt:48",
   "file": "D1304al.txt",
   "line": 48,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くふふふふふ…… おーほほほほほほほ！」",
   "ko_candidate": "「쿠후후후후……오호호호호호호!」"
  },
  {
   "id": 31780,
   "key": "D1304al.txt:59",
   "file": "D1304al.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬だけ間を置いて、ベルゼビュートが殴りかかってくる。",
   "ko_candidate": "잠시 간격을 두고､ 벨제뷰트가 주먹을 날려온다｡"
  },
  {
   "id": 31781,
   "key": "D1304al.txt:60",
   "file": "D1304al.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "振り下ろされる腕の先は、デモンベインの胸部――コクピット！",
   "ko_candidate": "내리꽂히는 팔 끝은 데몬베인의 가슴부――콕핏!"
  },
  {
   "id": 31782,
   "key": "D1304al.txt:64",
   "file": "D1304al.txt",
   "line": 64,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん！　危ないっ！」",
   "ko_candidate": "「다이쥬지 씨! 위험해요!」"
  },
  {
   "id": 31783,
   "key": "D1304al.txt:69",
   "file": "D1304al.txt",
   "line": 69,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「チィィィィ――――ッ！」",
   "ko_candidate": "「치이이이이――――잇!」"
  },
  {
   "id": 31784,
   "key": "D1304al.txt:73",
   "file": "D1304al.txt",
   "line": 73,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボぉぉぉぉぉっ!?」",
   "ko_candidate": "「로봇오오오오옷!?」"
  },
  {
   "id": 31785,
   "key": "D1304al.txt:86",
   "file": "D1304al.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身を捩じらせて、コクピットへの直撃を避ける。",
   "ko_candidate": "몸을 비틀어 콕핏으로의 직격을 피한다｡"
  },
  {
   "id": 31786,
   "key": "D1304al.txt:87",
   "file": "D1304al.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの右肩に、深々とめり込むベルゼビュートの腕。",
   "ko_candidate": "데몬베인의 오른쪽 어깨에 깊숙이 박히는 벨제뷰트의 팔｡"
  },
  {
   "id": 31787,
   "key": "D1304al.txt:90",
   "file": "D1304al.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけでは終わらなかった。",
   "ko_candidate": "그것으로 끝나지 않았다｡"
  },
  {
   "id": 31788,
   "key": "D1304al.txt:91",
   "file": "D1304al.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕の表面に無数の魔術文字が浮かび上がる。",
   "ko_candidate": "팔 표면에 무수한 마술 문자가 떠오른다｡"
  },
  {
   "id": 31789,
   "key": "D1304al.txt:92",
   "file": "D1304al.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "集中する魔力……マズい！",
   "ko_candidate": "집중되는 마력……좋지 않아!"
  },
  {
   "id": 31790,
   "key": "D1304al.txt:96",
   "file": "D1304al.txt",
   "line": 96,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くかかかかかかかかっ！」",
   "ko_candidate": "「쿠카카카카카카카캇!」"
  },
  {
   "id": 31791,
   "key": "D1304al.txt:107",
   "file": "D1304al.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "限界まで膨張した魔力が爆発した。",
   "ko_candidate": "한계까지 팽창한 마력이 폭발했다｡"
  },
  {
   "id": 31792,
   "key": "D1304al.txt:113",
   "file": "D1304al.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右肩が粉微塵になって吹き飛ぶ。",
   "ko_candidate": "오른쪽 어깨가 산산조각 나 날아간다｡"
  },
  {
   "id": 31793,
   "key": "D1304al.txt:114",
   "file": "D1304al.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の反動でバランスを崩し、デモンベインは仰向けになって地面に倒れた。",
   "ko_candidate": "폭발의 반동으로 균형을 잃고､ 데몬베인은 뒤로 넘어져 땅에 쓰러졌다｡"
  },
  {
   "id": 31794,
   "key": "D1304al.txt:118",
   "file": "D1304al.txt",
   "line": 118,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ほらほら、ボーッとしている暇はないわよ！」",
   "ko_candidate": "「자자､ 멍하니 있을 시간 없어!」"
  },
  {
   "id": 31795,
   "key": "D1304al.txt:129",
   "file": "D1304al.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベルゼビュートの掌が、圧縮された瘴気の弾を生んだ。",
   "ko_candidate": "벨제뷰트의 손바닥에서 압축된 장기의 탄환이 생겼다｡"
  },
  {
   "id": 31796,
   "key": "D1304al.txt:130",
   "file": "D1304al.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瘴気の呪弾は、まるで断末魔の絶叫のような轟音を上げて、デモンベインを襲った。",
   "ko_candidate": "장기의 주탄은 마치 단말마의 절규 같은 굉음을 내며､"
  },
  {
   "id": 31797,
   "key": "D1304al.txt:137",
   "file": "D1304al.txt",
   "line": 137,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……ティマイオス！　クリティアスッ！」",
   "ko_candidate": "데몬베인을 덮쳤다｡ 「큭……티마이오스! 크리티오스!」"
  },
  {
   "id": 31798,
   "key": "D1304al.txt:144",
   "file": "D1304al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生き残っている回路を駆使して、脚部シールドを起動させる。",
   "ko_candidate": "살아남은 회로를 총동원해 다리 부분 실드를 가동시킨다｡"
  },
  {
   "id": 31799,
   "key": "D1304al.txt:145",
   "file": "D1304al.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膝を突いた状態から、爆発的に跳躍。",
   "ko_candidate": "무릎을 꿇은 상태에서 폭발적으로 도약｡"
  },
  {
   "id": 31800,
   "key": "D1304al.txt:149",
   "file": "D1304al.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪弾は目標を失い、大地を撃った。",
   "ko_candidate": "주탄은 목표를 잃고 대지를 강타했다｡"
  },
  {
   "id": 31801,
   "key": "D1304al.txt:150",
   "file": "D1304al.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瘴気に侵され、腐れてゆく大地。",
   "ko_candidate": "장기에 침식되어 썩어가는 대지｡"
  },
  {
   "id": 31802,
   "key": "D1304al.txt:155",
   "file": "D1304al.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何とか難を逃れたが、デモンベインがまともに動けないのは相変わらず。",
   "ko_candidate": "어떻게든 피했지만､ 데몬베인이 제대로 움직이지 못하는 건 여전하다｡"
  },
  {
   "id": 31803,
   "key": "D1304al.txt:155",
   "file": "D1304al.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、マトモな着地など期待できるはずもない。",
   "ko_candidate": "물론 제대로 된 착지 따위 기대할 수 없다｡"
  },
  {
   "id": 31804,
   "key": "D1304al.txt:162",
   "file": "D1304al.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭から地面に突っ込むようにして墜ちる。",
   "ko_candidate": "머리부터 땅에 처박히듯이 떨어진다｡"
  },
  {
   "id": 31805,
   "key": "D1304al.txt:168",
   "file": "D1304al.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "落下の衝撃がコクピットを激しく揺さぶった。",
   "ko_candidate": "낙하의 충격이 콕핏을 격렬하게 흔들었다｡"
  },
  {
   "id": 31806,
   "key": "D1304al.txt:171",
   "file": "D1304al.txt",
   "line": 171,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐがっ！　い、痛ぇ……頭打った……ッ」",
   "ko_candidate": "「으갓! 아､ 아파……머리 부딪혔……」"
  },
  {
   "id": 31807,
   "key": "D1304al.txt:175",
   "file": "D1304al.txt",
   "line": 175,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うっうっ…… データがトんでしまうロボ～～」",
   "ko_candidate": "「으으…… 데이터가 날아가 버리로봇～～」"
  },
  {
   "id": 31808,
   "key": "D1304al.txt:180",
   "file": "D1304al.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体を何とか立ち上がらせようと足掻く。",
   "ko_candidate": "기체를 어떻게든 일으켜 세우려고 발버둥 친다｡"
  },
  {
   "id": 31809,
   "key": "D1304al.txt:181",
   "file": "D1304al.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体を支える腕がギシギシと頼りなく震えている。",
   "ko_candidate": "기체를 지탱하는 팔이 삐걱삐걱 불안하게 떨리고 있다｡"
  },
  {
   "id": 31810,
   "key": "D1304al.txt:182",
   "file": "D1304al.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駄目か……!?",
   "ko_candidate": "안 되나……!?"
  }
 ]
}