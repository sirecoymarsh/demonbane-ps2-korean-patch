 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リューガ": "류가"
 },
 "items": [
  {
   "id": 33217,
   "key": "D1307le.txt:242",
   "file": "D1307le.txt",
   "line": 242,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「試験体０１、第１２区画の封印を解読！　第８層に侵食します！」",
   "ko_candidate": "「시험체 01､ 제12구획의 봉인을 해독! 제8층에 침식합니다!」"
  },
  {
   "id": 33218,
   "key": "D1307le.txt:246",
   "file": "D1307le.txt",
   "line": 246,
   "speaker": "研究員Ｂ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「呪装兵、第３種武装にて展開！　急げ！　急げ！」",
   "ko_candidate": "「주장병､ 제3종 무장으로 전개! 서둘러! 서둘러!」"
  },
  {
   "id": 33219,
   "key": "D1307le.txt:249",
   "file": "D1307le.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実験は失敗だったらしい。",
   "ko_candidate": "실험은 실패였던 모양이다｡"
  },
  {
   "id": 33220,
   "key": "D1307le.txt:250",
   "file": "D1307le.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣き叫ぶように鳴り響くアラーム。",
   "ko_candidate": "울부짖듯 울려 퍼지는 알람｡"
  },
  {
   "id": 33221,
   "key": "D1307le.txt:252",
   "file": "D1307le.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い施設を赤と闇に明滅させる、ライトの光。",
   "ko_candidate": "하얀 시설을 붉은색과 어둠으로 명멸시키는 라이트의 빛｡"
  },
  {
   "id": 33222,
   "key": "D1307le.txt:253",
   "file": "D1307le.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "研究員や武装した警備兵が慌しく廊下を駈ける。",
   "ko_candidate": "연구원과 무장한 경비병이 분주히 복도를 달린다｡"
  },
  {
   "id": 33223,
   "key": "D1307le.txt:255",
   "file": "D1307le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "部屋から一歩も外に出ないようにと警告され、私達は寄り添って不安に震えていた。",
   "ko_candidate": "방에서 한 발짝도 밖으로 나가지 말라는 경고를 받고､ 우리는 서로 붙어 불안에 떨고 있었다｡"
  },
  {
   "id": 33224,
   "key": "D1307le.txt:256",
   "file": "D1307le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……果たして実験対象である１号は、彼女は無事なのだろうか？",
   "ko_candidate": "… 과연 실험 대상인 1호는､ 그녀는 무사할까?"
  },
  {
   "id": 33225,
   "key": "D1307le.txt:258",
   "file": "D1307le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガをぎゅ……と抱き締める。",
   "ko_candidate": "류가를 꼭… 하고 끌어안는다｡"
  },
  {
   "id": 33226,
   "key": "D1307le.txt:259",
   "file": "D1307le.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頼れるものは、このときの私達には、お互いしかなかった。",
   "ko_candidate": "의지할 수 있는 것은､ 이때의 우리에게는 서로밖에 없었다｡"
  },
  {
   "id": 33227,
   "key": "D1307le.txt:261",
   "file": "D1307le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "たった２人きりの姉弟だから。",
   "ko_candidate": "단 둘뿐인 남매니까｡"
  },
  {
   "id": 33228,
   "key": "D1307le.txt:262",
   "file": "D1307le.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガは腕の中で、怯えているのか呆けているのか、よく分からない微妙な表情を浮かべていた。",
   "ko_candidate": "류가는 팔 안에서 겁에 질렸는지 멍해졌는지 잘 모를 미묘한 표정을 짓고 있었다｡"
  },
  {
   "id": 33229,
   "key": "D1307le.txt:264",
   "file": "D1307le.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声をかけようとして――",
   "ko_candidate": "말을 걸려고 하는데――"
  },
  {
   "id": 33230,
   "key": "D1307le.txt:267",
   "file": "D1307le.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女の慟哭が、施設を揺るがした。",
   "ko_candidate": "그녀의 통곡이 시설을 흔들었다｡"
  },
  {
   "id": 33231,
   "key": "D1307le.txt:277",
   "file": "D1307le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "きっと、このとき初めて、僕は恐怖を知った。",
   "ko_candidate": "분명､ 이때 처음으로 나는 공포를 알았다｡"
  },
  {
   "id": 33232,
   "key": "D1307le.txt:278",
   "file": "D1307le.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "初めて知った恐怖は、ヒトの理解をはるかに超えた領域にあった。",
   "ko_candidate": "처음 알게 된 공포는 인간의 이해를 훨씬 뛰어넘은 영역에 있었다｡"
  },
  {
   "id": 33233,
   "key": "D1307le.txt:280",
   "file": "D1307le.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "試験体１号の狂気は、暴走した超能力に乗って伝播する。",
   "ko_candidate": "시험체 1호의 광기는 폭주한 초능력을 타고 전파된다｡"
  },
  {
   "id": 33234,
   "key": "D1307le.txt:281",
   "file": "D1307le.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慟哭は、施設内の人間全員の精神に、直接轟いた。",
   "ko_candidate": "통곡은 시설 내의 모든 사람의 정신에 직접 울려 퍼졌다｡"
  },
  {
   "id": 33235,
   "key": "D1307le.txt:283",
   "file": "D1307le.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理由は分からない。",
   "ko_candidate": "이유는 모르겠다｡"
  },
  {
   "id": 33236,
   "key": "D1307le.txt:284",
   "file": "D1307le.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理屈も分からない。",
   "ko_candidate": "이치도 모르겠다｡"
  },
  {
   "id": 33237,
   "key": "D1307le.txt:286",
   "file": "D1307le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ身を引き裂く絶望を、僕たちの魂を打ち砕こうと、叩きつけてくる。",
   "ko_candidate": "단지 몸을 찢는 절망을､ 우리의 영혼을 부숴버리려고 내리치고 있다｡"
  },
  {
   "id": 33238,
   "key": "D1307le.txt:287",
   "file": "D1307le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実際、ココロを破壊されて、消えてしまった人も居るかも知れなかった。",
   "ko_candidate": "실제로 마음이 파괴되어 사라져버린 사람도 있을지도 모른다｡"
  },
  {
   "id": 33239,
   "key": "D1307le.txt:289",
   "file": "D1307le.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲鳴が鼓膜を貫いた。",
   "ko_candidate": "비명이 고막을 뚫었다｡"
  },
  {
   "id": 33240,
   "key": "D1307le.txt:290",
   "file": "D1307le.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分の悲鳴なのか、それとも僕を抱く彼女の悲鳴なのか、それとも心の中で猛り狂う慟哭が実際に音になってしまったのか。",
   "ko_candidate": "자신의 비명인지､ 아니면 나를 안고 있는 그녀의 비명인지､ 아니면 마음속에서 맹렬히 날뛰는 통곡이 실제로 소리가 되어버린 것인지｡"
  },
  {
   "id": 33241,
   "key": "D1307le.txt:292",
   "file": "D1307le.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "未知の恐怖に、恐怖という未知に犯された僕には、その区別すらつかない。",
   "ko_candidate": "미지의 공포에､ 공포라는 미지에 범해진 나로서는 그 구별조차 할 수 없다｡"
  },
  {
   "id": 33242,
   "key": "D1307le.txt:294",
   "file": "D1307le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなはずないのに……！",
   "ko_candidate": "이럴 리가 없는데…!"
  },
  {
   "id": 33243,
   "key": "D1307le.txt:295",
   "file": "D1307le.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "僕には恐いものなんてないはずなのに……！",
   "ko_candidate": "나에게는 무서운 것 따위 없을 텐데…! 왜… 왜 이런…!"
  },
  {
   "id": 33244,
   "key": "D1307le.txt:297",
   "file": "D1307le.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何で……何でこんな……！",
   "ko_candidate": "이건… 이건 잘못됐어!"
  },
  {
   "id": 33245,
   "key": "D1307le.txt:298",
   "file": "D1307le.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなの……こんなの間違っている！",
   "ko_candidate": "나는､ 나는 더 잘 살 수 있을 텐데!"
  },
  {
   "id": 33246,
   "key": "D1307le.txt:299",
   "file": "D1307le.txt",
   "line": 299,
   "speaker": "リューガ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "僕は、僕はもっと上手く生きられるはずなんだ！ 「アアアアアあああああアアアぁァァぁアアアああア！ 己を……この己を阻めるものなど……在っていい筈が無いッ！」",
   "ko_candidate": "「아아아아아아아아아아아아아아아아아아아아아! 나를… 이 나를 막을 수 있는 것 따위… 있을 리가 없다!」"
  },
  {
   "id": 33247,
   "key": "D1307le.txt:316",
   "file": "D1307le.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ！",
   "ko_candidate": "그래!"
  },
  {
   "id": 33248,
   "key": "D1307le.txt:317",
   "file": "D1307le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僕は何だって出来る！　僕を邪魔できるものなんて存在しない！",
   "ko_candidate": "나는 뭐든 할 수 있어! 나를 방해할 수 있는 것 따위 존재하지 않아!"
  },
  {
   "id": 33249,
   "key": "D1307le.txt:318",
   "file": "D1307le.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなのは……こんな恐怖はマヤカシだっ！",
   "ko_candidate": "이런 건… 이런 공포는 허상이다!"
  },
  {
   "id": 33250,
   "key": "D1307le.txt:319",
   "file": "D1307le.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだとも！　僕は……！",
   "ko_candidate": "그렇고말고! 나는…!"
  },
  {
   "id": 33251,
   "key": "D1307le.txt:327",
   "file": "D1307le.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……リューガが泣き叫びながら、躰を激しく痙攣させていた。",
   "ko_candidate": "… 류가가 울부짖으면서 몸을 격렬하게 경련시키고 있었다｡"
  },
  {
   "id": 33252,
   "key": "D1307le.txt:328",
   "file": "D1307le.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私も、恐怖のあまり、ココロがくだけそうだった。",
   "ko_candidate": "나도 공포 때문에 마음이 부서질 것 같았다｡"
  },
  {
   "id": 33253,
   "key": "D1307le.txt:330",
   "file": "D1307le.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガにすがって、抱きしめる。",
   "ko_candidate": "류가에게 매달려 끌어안는다｡"
  },
  {
   "id": 33254,
   "key": "D1307le.txt:331",
   "file": "D1307le.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リューガのふるえを、力づくで抑えつけるように。",
   "ko_candidate": "류가의 떨림을 억지로 억누르듯이｡"
  },
  {
   "id": 33255,
   "key": "D1307le.txt:335",
   "file": "D1307le.txt",
   "line": 335,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "（……リューガ……っ！）",
   "ko_candidate": "（… 류가…!）"
  },
  {
   "id": 33256,
   "key": "D1307le.txt:340",
   "file": "D1307le.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "記憶の中のリューガが、私を見上げる。",
   "ko_candidate": "기억 속의 류가가 나를 올려다본다｡"
  }
 ]
}