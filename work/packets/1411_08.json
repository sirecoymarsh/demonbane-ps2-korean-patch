 "items": [
  {
   "id": 39379,
   "key": "D1411ru.txt:544",
   "file": "D1411ru.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。まだだ。",
   "ko_candidate": "그래｡ 아직이다｡"
  },
  {
   "id": 39380,
   "key": "D1411ru.txt:545",
   "file": "D1411ru.txt",
   "line": 545,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだ、これは決定打ではない！",
   "ko_candidate": "아직､ 이것은 결정타가 아니다!"
  },
  {
   "id": 39381,
   "key": "D1411ru.txt:547",
   "file": "D1411ru.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "たった今、切り開いた活路。",
   "ko_candidate": "방금 전､ 열어젖힌 활로｡"
  },
  {
   "id": 39382,
   "key": "D1411ru.txt:548",
   "file": "D1411ru.txt",
   "line": 548,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "決定的な隙。",
   "ko_candidate": "결정적인 틈｡"
  },
  {
   "id": 39383,
   "key": "D1411ru.txt:549",
   "file": "D1411ru.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこに次の攻撃を、願わくば、これが必殺の一撃たれとの祈りを込めて、叩き込む！",
   "ko_candidate": "거기에 다음 공격을､ 원컨대､ 이것이 필살의 일격이 되기를 바라는 기도를 담아､ 퍼부어 넣는다!"
  },
  {
   "id": 39384,
   "key": "D1411ru.txt:558",
   "file": "D1411ru.txt",
   "line": 558,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル！」",
   "ko_candidate": "「알!」"
  },
  {
   "id": 39385,
   "key": "D1411ru.txt:563",
   "file": "D1411ru.txt",
   "line": 563,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「応！　神獣弾装填！」",
   "ko_candidate": "「응! 신수탄 장전!」"
  },
  {
   "id": 39386,
   "key": "D1411ru.txt:566",
   "file": "D1411ru.txt",
   "line": 566,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気を灼熱させ、大気を凍結させ、二発の弾丸が顕現する。",
   "ko_candidate": "대기를 작열시키고､ 대기를 동결시키며､ 두 발의 탄환이 현현한다｡"
  },
  {
   "id": 39387,
   "key": "D1411ru.txt:569",
   "file": "D1411ru.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアのチェンバーに、イタクァのリボルバーに、それぞれ自らの意志を持つかの如く、滑り込んだ。",
   "ko_candidate": "크투가의 챔버에､ 이타콰의 리볼버에､ 각각 스스로의 의지를 가진 듯이､ 미끄러져 들어갔다｡"
  },
  {
   "id": 39388,
   "key": "D1411ru.txt:574",
   "file": "D1411ru.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装填。魔銃に刻まれた魔術文字が光り輝く。",
   "ko_candidate": "장전｡ 마총에 새겨진 마술 문자가 빛나기 시작한다｡"
  },
  {
   "id": 39389,
   "key": "D1411ru.txt:576",
   "file": "D1411ru.txt",
   "line": 576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光となって空間を染める。",
   "ko_candidate": "섬광이 되어 공간을 물들인다｡"
  },
  {
   "id": 39390,
   "key": "D1411ru.txt:579",
   "file": "D1411ru.txt",
   "line": 579,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クトゥグア、イタクァ神獣形態！」",
   "ko_candidate": "「크투가､ 이타콰 신수 형태!」"
  },
  {
   "id": 39391,
   "key": "D1411ru.txt:581",
   "file": "D1411ru.txt",
   "line": 581,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同時にトリガーを引いた。",
   "ko_candidate": "동시에 방아쇠를 당겼다｡"
  },
  {
   "id": 39392,
   "key": "D1411ru.txt:586",
   "file": "D1411ru.txt",
   "line": 586,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃口から放たれるのは弾丸ではない。",
   "ko_candidate": "총구에서 발사되는 것은 탄환이 아니다｡"
  },
  {
   "id": 39393,
   "key": "D1411ru.txt:588",
   "file": "D1411ru.txt",
   "line": 588,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超高温に具現した魔力と、極低温に具現した魔力。",
   "ko_candidate": "초고온으로 구현된 마력과､ 극저온으로 구현된 마력｡"
  },
  {
   "id": 39394,
   "key": "D1411ru.txt:590",
   "file": "D1411ru.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超高温は異形の劫火へ。焔え猛る、一匹の魔獣へ。",
   "ko_candidate": "초고온은 기괴한 겁화로｡ 불타오르는､ 한 마리의 마수로｡"
  },
  {
   "id": 39395,
   "key": "D1411ru.txt:591",
   "file": "D1411ru.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "極低温は魔性の冷気へ。凍てつく、一匹の竜へ。",
   "ko_candidate": "극저온은 마성의 냉기로｡ 얼어붙는､ 한 마리의 용으로｡"
  },
  {
   "id": 39396,
   "key": "D1411ru.txt:597",
   "file": "D1411ru.txt",
   "line": 597,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咆吼を轟かせ、牙を剥き出し、レガシー・オブ・ゴールドに襲いかかる！",
   "ko_candidate": "포효를 울리며､ 이빨을 드러내고､ 레거시 오브 골드에 달려든다!"
  },
  {
   "id": 39397,
   "key": "D1411ru.txt:603",
   "file": "D1411ru.txt",
   "line": 603,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だとぉぉぉぉぉッッ!?」",
   "ko_candidate": "「뭐라고오오오오옷!?」"
  },
  {
   "id": 39398,
   "key": "D1411ru.txt:606",
   "file": "D1411ru.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "灼熱の爪牙が、極冷の爪牙が、引き裂く、粉砕する、蹂躙する、凌辱する。",
   "ko_candidate": "작열하는 발톱이､ 극한의 차가운 발톱이､ 찢어발기고､ 분쇄하고､ 유린하고､ 능욕한다｡"
  },
  {
   "id": 39399,
   "key": "D1411ru.txt:607",
   "file": "D1411ru.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "加速する破壊の乱舞。極限まで昂る破壊の魔力。",
   "ko_candidate": "가속하는 파괴의 난무｡ 극한까지 고조되는 파괴의 마력｡"
  },
  {
   "id": 39400,
   "key": "D1411ru.txt:613",
   "file": "D1411ru.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――閃光。",
   "ko_candidate": "――섬광｡"
  },
  {
   "id": 39401,
   "key": "D1411ru.txt:619",
   "file": "D1411ru.txt",
   "line": 619,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間をも破壊するような、超エネルギーの爆発が広大過ぎるこの広間を震撼させた。",
   "ko_candidate": "공간마저 파괴할 듯한､ 초에너지의 폭발이 광대하기 그지없는 이 홀을 뒤흔들었다｡"
  },
  {
   "id": 39402,
   "key": "D1411ru.txt:620",
   "file": "D1411ru.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光から瞳を守りながら、俺は白い闇の向こう、レガシー・オブ・ゴールドの様子を窺う。",
   "ko_candidate": "섬광으로부터 눈을 보호하면서､ 나는 하얀 어둠 너머､ 레거시 오브 골드의 상태를 살핀다｡"
  },
  {
   "id": 39403,
   "key": "D1411ru.txt:623",
   "file": "D1411ru.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――危機感が、全身を貫く。",
   "ko_candidate": "――위기감이､ 온몸을 관통한다｡"
  },
  {
   "id": 39404,
   "key": "D1411ru.txt:626",
   "file": "D1411ru.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光の中から、こちらに伸びる一筋の光。",
   "ko_candidate": "섬광 속에서､ 이쪽으로 뻗어 오는 한 줄기 빛｡"
  },
  {
   "id": 39405,
   "key": "D1411ru.txt:627",
   "file": "D1411ru.txt",
   "line": 627,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬だが、視認できた。",
   "ko_candidate": "순간이었지만､ 볼 수 있었다｡"
  },
  {
   "id": 39406,
   "key": "D1411ru.txt:632",
   "file": "D1411ru.txt",
   "line": 632,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ッ!?　ニトクリスの鏡……ミラーコーティング！」",
   "ko_candidate": "「읏!? 니토크리스의 거울……미러 코팅!」"
  },
  {
   "id": 39407,
   "key": "D1411ru.txt:636",
   "file": "D1411ru.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの装甲が鏡面となる。",
   "ko_candidate": "데몬베인의 장갑이 거울면이 된다｡"
  },
  {
   "id": 39408,
   "key": "D1411ru.txt:637",
   "file": "D1411ru.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次の瞬間、ビーム砲がデモンベインを直撃した。",
   "ko_candidate": "다음 순간､ 빔포가 데몬베인을 직격했다｡"
  },
  {
   "id": 39409,
   "key": "D1411ru.txt:643",
   "file": "D1411ru.txt",
   "line": 643,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐあああああああっ！」",
   "ko_candidate": "「크아아아아아아악!」"
  },
  {
   "id": 39410,
   "key": "D1411ru.txt:645",
   "file": "D1411ru.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無効化し切れない。",
   "ko_candidate": "완전히 무효화하지 못했다｡"
  },
  {
   "id": 39411,
   "key": "D1411ru.txt:650",
   "file": "D1411ru.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ダメージを負い、デモンベインは膝を突く。",
   "ko_candidate": "데미지를 입고､ 데몬베인은 무릎을 꿇는다｡"
  },
  {
   "id": 39412,
   "key": "D1411ru.txt:653",
   "file": "D1411ru.txt",
   "line": 653,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光が止み、爆発の向こうにレガシー・オブ・ゴールドの輝く巨体を確認した。",
   "ko_candidate": "섬광이 멎고､ 폭발 너머로 레거시 오브 골드의 빛나는 거체를 확인했다｡"
  },
  {
   "id": 39413,
   "key": "D1411ru.txt:655",
   "file": "D1411ru.txt",
   "line": 655,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今のでも斃せないなんて……！",
   "ko_candidate": "이 정도로도 쓰러뜨릴 수 없다니……!"
  },
  {
   "id": 39414,
   "key": "D1411ru.txt:657",
   "file": "D1411ru.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実際には、向こうもダメージは大きい。",
   "ko_candidate": "실제로는､ 저쪽도 데미지가 크다｡"
  },
  {
   "id": 39415,
   "key": "D1411ru.txt:658",
   "file": "D1411ru.txt",
   "line": 658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、むしろまだ稼動しているのが不思議なくらいだった。",
   "ko_candidate": "아니､ 오히려 아직도 가동하고 있다는 게 이상할 정도였다｡"
  },
  {
   "id": 39416,
   "key": "D1411ru.txt:660",
   "file": "D1411ru.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "半身が吹き飛ばされ、放電する機械の内臓を曝け出し、爆炎を噴き、装甲は融解し、水銀の血が滂沱と流れている。",
   "ko_candidate": "반신이 날아가 버리고､ 방전하는 기계의 내장을 드러내고､ 폭염을 내뿜으며､ 장갑은 융해되고､ 수은의 피가 흘러넘치고 있다｡"
  },
  {
   "id": 39417,
   "key": "D1411ru.txt:662",
   "file": "D1411ru.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、それでも、レガシー・オブ・ゴールドはまだ、確かに動いているのだ！",
   "ko_candidate": "하지만､ 그래도､ 레거시 오브 골드는 아직､ 분명히 움직이고 있는 것이다!"
  },
  {
   "id": 39418,
   "key": "D1411ru.txt:668",
   "file": "D1411ru.txt",
   "line": 668,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふは……ふははは……はははははははッ！　流石はマスター・オブ・ネクロノミコン！　なかなかに味な真似をしてくれる」 「だが、甘いぞ！」",
   "ko_candidate": "「후하……후하하하……하하하하하하핫! 역시 마스터 오브 네크로노미콘! 꽤나 맛있는 짓을 해주는군｡ 하지만､ 아직 멀었다!」"
  }
 ]
}