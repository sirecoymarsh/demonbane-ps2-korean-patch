 "items": [
  {
   "id": 41149,
   "key": "D1501ru.txt:212",
   "file": "D1501ru.txt",
   "line": 212,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「解からないか、大十字九郎？　そうか……解からないか」 「だが仕方ないな。貴公はそういうものなのだから」",
   "ko_candidate": "「이해가 안 되나､ 다이쥬지 쿠로? 그렇군…… 이해가 안 되는군｡ 하지만 어쩔 수 없지｡ 너는 그런 존재니 까」"
  },
  {
   "id": 41150,
   "key": "D1501ru.txt:219",
   "file": "D1501ru.txt",
   "line": 219,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「また……っ！」",
   "ko_candidate": "「또……읏!」"
  },
  {
   "id": 41151,
   "key": "D1501ru.txt:227",
   "file": "D1501ru.txt",
   "line": 227,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「肝心な事はだ……前回の約束通り、余はちゃんと姿を顕したぞ。 貴公と対峙する為に。時の果てで対峙する為に」",
   "ko_candidate": "「중요한 건 말이다……지난번 약속대로 내가 제대로 모습을 드러냈다는 거다｡ 너와 대치하기 위해｡ 시간의 끝에서 대치하기 위해」"
  },
  {
   "id": 41152,
   "key": "D1501ru.txt:233",
   "file": "D1501ru.txt",
   "line": 233,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……！」",
   "ko_candidate": "「크읏……!」"
  },
  {
   "id": 41153,
   "key": "D1501ru.txt:237",
   "file": "D1501ru.txt",
   "line": 237,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「無論、余の力は何ら欠けたる所は無い。魔導書も――」",
   "ko_candidate": "「물론 내 힘은 조금도 줄어들지 않았다｡ 마도서도――」"
  },
  {
   "id": 41154,
   "key": "D1501ru.txt:241",
   "file": "D1501ru.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マスターテリオンの周囲を舞う花吹雪。",
   "ko_candidate": "마스터 테리온의 주위를 날아다니는 꽃보라｡"
  },
  {
   "id": 41155,
   "key": "D1501ru.txt:242",
   "file": "D1501ru.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "花弁の一枚一枚は、魔導書の断片。",
   "ko_candidate": "꽃잎 하나하나는 마도서의 파편｡"
  },
  {
   "id": 41156,
   "key": "D1501ru.txt:243",
   "file": "D1501ru.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "螺旋を描いて、唸り、昇り、炎上する。",
   "ko_candidate": "나선을 그리며 윙윙거리고 올라가 불타오른다｡"
  },
  {
   "id": 41157,
   "key": "D1501ru.txt:249",
   "file": "D1501ru.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔。",
   "ko_candidate": "불꽃｡"
  },
  {
   "id": 41158,
   "key": "D1501ru.txt:250",
   "file": "D1501ru.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔が少女の容を手に入れる。",
   "ko_candidate": "불꽃이 소녀의 모습을 얻는다｡"
  },
  {
   "id": 41159,
   "key": "D1501ru.txt:251",
   "file": "D1501ru.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれは、『ルルイエ異本』ではない。",
   "ko_candidate": "하지만 그것은 『르뤼에 이본』이 아니다｡"
  },
  {
   "id": 41160,
   "key": "D1501ru.txt:261",
   "file": "D1501ru.txt",
   "line": 261,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「来たか、エセルドレーダ」",
   "ko_candidate": "「왔구나､ 에셀드레다」"
  },
  {
   "id": 41161,
   "key": "D1501ru.txt:265",
   "file": "D1501ru.txt",
   "line": 265,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「イエス・マスター。御前に」",
   "ko_candidate": "「예､ 마스터｡ 당신 앞에」"
  },
  {
   "id": 41162,
   "key": "D1501ru.txt:268",
   "file": "D1501ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔より、墨を流した様な黒が、生まれた。",
   "ko_candidate": "불꽃에서 먹물을 흘린 듯한 검은색이 태어났다｡"
  },
  {
   "id": 41163,
   "key": "D1501ru.txt:270",
   "file": "D1501ru.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い装束。",
   "ko_candidate": "검은 의상｡"
  },
  {
   "id": 41164,
   "key": "D1501ru.txt:271",
   "file": "D1501ru.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い長髪。",
   "ko_candidate": "검은 긴 머리｡"
  },
  {
   "id": 41165,
   "key": "D1501ru.txt:272",
   "file": "D1501ru.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い瞳。",
   "ko_candidate": "검은 눈동자｡"
  },
  {
   "id": 41166,
   "key": "D1501ru.txt:276",
   "file": "D1501ru.txt",
   "line": 276,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……『ナコト写本』！」",
   "ko_candidate": "「……『나코트 사본』!」"
  },
  {
   "id": 41167,
   "key": "D1501ru.txt:288",
   "file": "D1501ru.txt",
   "line": 288,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ナコト写本』の精霊、エセルドレーダは、静かにマスターテリオンの傍らに舞い降りた。",
   "ko_candidate": "『나코트 사본』의 정령､ 에셀드레다는 조용히 마스터 테리온의 곁으로 내려앉았다｡"
  },
  {
   "id": 41168,
   "key": "D1501ru.txt:289",
   "file": "D1501ru.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "細い腰に腕を回し、少年は少女を、そっと抱き寄せる。",
   "ko_candidate": "가는 허리에 팔을 두르고 소년은 소녀를 살며시 끌어안는다｡"
  },
  {
   "id": 41169,
   "key": "D1501ru.txt:293",
   "file": "D1501ru.txt",
   "line": 293,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――この通りだ。 ……エセルドレーダ。躰の調子はどうだ？　大事無いか？」",
   "ko_candidate": "「――이렇다｡ ……에셀드레다｡ 몸 상태는 어떠냐? 괜찮으냐?」"
  },
  {
   "id": 41170,
   "key": "D1501ru.txt:299",
   "file": "D1501ru.txt",
   "line": 299,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「問題ありません。 お心遣い、有り難く思います」",
   "ko_candidate": "「문제없습니다｡ 배려해 주셔서 감사합니다」"
  },
  {
   "id": 41171,
   "key": "D1501ru.txt:307",
   "file": "D1501ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、２人は唇を重ねる。",
   "ko_candidate": "말하고 둘은 입술을 포개었다｡"
  },
  {
   "id": 41172,
   "key": "D1501ru.txt:308",
   "file": "D1501ru.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しばらくして、唇を離した２人は再びこちらを見据える。",
   "ko_candidate": "잠시 후 타액의 실을 끌며 입술을 떼어낸 둘은 다시 이쪽을 응시한다｡"
  },
  {
   "id": 41173,
   "key": "D1501ru.txt:310",
   "file": "D1501ru.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処までも深い、金の瞳と黒の瞳。",
   "ko_candidate": "끝없이 깊은 황금빛 눈동자와 검은 눈동자｡"
  },
  {
   "id": 41174,
   "key": "D1501ru.txt:314",
   "file": "D1501ru.txt",
   "line": 314,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ、この道化芝居も、 ようやく終演を迎えようとしている」",
   "ko_candidate": "「자､ 이 도화극도 드디어 막을 내리려 하고 있다」"
  },
  {
   "id": 41175,
   "key": "D1501ru.txt:320",
   "file": "D1501ru.txt",
   "line": 320,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アルゥゥゥゥ！」",
   "ko_candidate": "「알으으으으!」"
  },
  {
   "id": 41176,
   "key": "D1501ru.txt:326",
   "file": "D1501ru.txt",
   "line": 326,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……分かった！」",
   "ko_candidate": "「……알겠어!」"
  },
  {
   "id": 41177,
   "key": "D1501ru.txt:337",
   "file": "D1501ru.txt",
   "line": 337,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの拳を振り上げる。",
   "ko_candidate": "데몬베인의 주먹을 치켜든다｡"
  },
  {
   "id": 41178,
   "key": "D1501ru.txt:338",
   "file": "D1501ru.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳に集中した魔力が外に零れ、空間に紫電となって放射される。",
   "ko_candidate": "주먹에 집중된 마력이 밖으로 새어나와 공간에 자색 번개가 되어 방사된다｡"
  },
  {
   "id": 41179,
   "key": "D1501ru.txt:339",
   "file": "D1501ru.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血臭に充ちた大気を灼いて、吼える。",
   "ko_candidate": "피 냄새로 가득한 대기를 태우며 포효한다｡"
  },
  {
   "id": 41180,
   "key": "D1501ru.txt:343",
   "file": "D1501ru.txt",
   "line": 343,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふふ。随分と積極的だな、大十字九郎」 「――エセルドレーダ！」",
   "ko_candidate": "「후후｡ 꽤나 적극적이구나､ 다이쥬지 쿠로｡ ――에셀드레다!」"
  },
  {
   "id": 41181,
   "key": "D1501ru.txt:350",
   "file": "D1501ru.txt",
   "line": 350,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イエス、マスター」",
   "ko_candidate": "「예､ 마스터」"
  },
  {
   "id": 41182,
   "key": "D1501ru.txt:359",
   "file": "D1501ru.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスの胸部に魔法陣が輝く。",
   "ko_candidate": "리베르 레기스의 가슴에 마법진이 빛난다｡"
  },
  {
   "id": 41183,
   "key": "D1501ru.txt:360",
   "file": "D1501ru.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人の躰が光になって、魔法陣の中心に吸い込まれる。",
   "ko_candidate": "둘의 몸이 빛이 되어 마법진의 중심으로 빨려 들어간다｡"
  },
  {
   "id": 41184,
   "key": "D1501ru.txt:361",
   "file": "D1501ru.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスの表面、無数の魔術文字が疾走する。",
   "ko_candidate": "리베르 레기스의 표면､ 무수한 마술 문자가 질주한다｡"
  },
  {
   "id": 41185,
   "key": "D1501ru.txt:368",
   "file": "D1501ru.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "劫――ッ！",
   "ko_candidate": "콰앙――읏!"
  },
  {
   "id": 41186,
   "key": "D1501ru.txt:372",
   "file": "D1501ru.txt",
   "line": 372,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起動する。吼える。",
   "ko_candidate": "기동한다｡ 포효한다｡"
  },
  {
   "id": 41187,
   "key": "D1501ru.txt:373",
   "file": "D1501ru.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "翼を閉じた蝙蝠の如き装甲の下から、拳を突き出し、殴りかかって来る！",
   "ko_candidate": "날개를 접은 박쥐 같은 장갑 아래에서 주먹을 내밀어 때려 온다!"
  },
  {
   "id": 41188,
   "key": "D1501ru.txt:373",
   "file": "D1501ru.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血臭に充ちた大気を燃やして、迫る。",
   "ko_candidate": "피 냄새로 가득한 대기를 태우며 다가온다｡"
