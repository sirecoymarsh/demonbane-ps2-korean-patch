 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎ちゃん": "쿠로 군",
  "ライカ": "라이카",
  "鬼械神": "귀계신"
 },
 "items": [
  {
   "id": 23915,
   "key": "D1105le.txt:760",
   "file": "D1105le.txt",
   "line": 760,
   "speaker": "ライカ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "革命とまで言うか。 「私は雨が嫌いだった。空を覆ってしまう雨雲が嫌いだった」",
   "ko_candidate": "혁명이라고까지 말하나｡"
  },
  {
   "id": 23916,
   "key": "D1105le.txt:769",
   "file": "D1105le.txt",
   "line": 769,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「多分、気がおかしくなってしまいそうなくらいに憂鬱になっていた」 「だけど、そんな憂鬱、全然大したものじゃないって教えてくれたのが九郎ちゃんだった」",
   "ko_candidate": "「저는 비가 싫었어요｡ 하늘을 뒤덮어 버리는 비구름이 싫었어요｡ 아마도 미쳐버릴 것 같을 정도로 우울해지고 있었어요｡ 하지만 그런 우울함이 전혀 대단한 게 아니라고 가르쳐 준 게 쿠로 군이었어요」"
  },
  {
   "id": 23917,
   "key": "D1105le.txt:776",
   "file": "D1105le.txt",
   "line": 776,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大袈裟な」",
   "ko_candidate": "「……과장이야」"
  },
  {
   "id": 23918,
   "key": "D1105le.txt:780",
   "file": "D1105le.txt",
   "line": 780,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「雨の日も楽しいことがある……当たり前のことなのかも知れないけど」 「でもヒトという生き物はよく、その当たり前のものが見えなくなってしまう」",
   "ko_candidate": "「비 오는 날도 즐거운 일이 있다…… 당연한 일일지도 모르지만｡ 하지만 인간이라는 생물은 자주 그 당연한 것이 보이지 않게 되어버려요｡ 보이지 않게 되어 어둠 속에서 두려워하게 돼요｡ 사실은 자신을 위협하는 것 따위 아무것도 없는데｡ 그래서 당연한 것을 당연하게 생각할 수 있다는 것은 분명 중요한 일이에요｡ 쿠로 군은 그 당연함을 저에게 주었어요」"
  },
  {
   "id": 23919,
   "key": "D1105le.txt:786",
   "file": "D1105le.txt",
   "line": 786,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「見えなくなって暗闇の中で怯えてしまう。本当は自分を脅かすものなんて何もないのに」 「だから当たり前のことを、当たり前に考えられることは、きっと大切なこと」",
   "ko_candidate": "「……전혀 모르겠어」"
  },
  {
   "id": 23920,
   "key": "D1105le.txt:795",
   "file": "D1105le.txt",
   "line": 795,
   "speaker": "ライカ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃんは、その当たり前を、私にくれた」 「……全然、分からない」",
   "ko_candidate": "「후후」"
  },
  {
   "id": 23921,
   "key": "D1105le.txt:803",
   "file": "D1105le.txt",
   "line": 803,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふふ」 ライカさんが笑みをこぼす。",
   "ko_candidate": "라이카 씨가 미소를 흘린다｡"
  },
  {
   "id": 23922,
   "key": "D1105le.txt:807",
   "file": "D1105le.txt",
   "line": 807,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夢を見るような瞳が、俺の瞳を覗きこむ。",
   "ko_candidate": "꿈을 꾸는 듯한 눈동자가 내 눈동자를 들여다본다｡"
  },
  {
   "id": 23923,
   "key": "D1105le.txt:813",
   "file": "D1105le.txt",
   "line": 813,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「多分そのときには……九郎ちゃんが九郎『ちゃん』になったそのときにはもう、私は九郎ちゃんのことが好きだったと思う……」",
   "ko_candidate": "「아마 그때는…… 쿠로 군이 쿠로 '군'이 된 그때에는 이미 저는 쿠로 군을 좋아하고 있었던 것 같아요……」"
  },
  {
   "id": 23924,
   "key": "D1105le.txt:817",
   "file": "D1105le.txt",
   "line": 817,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカさん」",
   "ko_candidate": "「……라이카 씨」"
  },
  {
   "id": 23925,
   "key": "D1105le.txt:822",
   "file": "D1105le.txt",
   "line": 822,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "果たして。",
   "ko_candidate": "과연｡"
  },
  {
   "id": 23926,
   "key": "D1105le.txt:823",
   "file": "D1105le.txt",
   "line": 823,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "唇を寄せたのは、どっちからだったろうか？",
   "ko_candidate": "입술을 가까이 한 건 누구부터였을까?"
  },
  {
   "id": 23927,
   "key": "D1105le.txt:825",
   "file": "D1105le.txt",
   "line": 825,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "惹かれるように、お互い寄せ合い……零距離の寸前になって、互いに躊躇して――。",
   "ko_candidate": "끌리듯이 서로 가까워지고…… 제로 거리 직전에서 서로 망설이고――｡"
  },
  {
   "id": 23928,
   "key": "D1105le.txt:836",
   "file": "D1105le.txt",
   "line": 836,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吐息のかかる間近にライカさんが居る。",
   "ko_candidate": "숨결이 닿을 만큼 가까이에 라이카 씨가 있다｡"
  },
  {
   "id": 23929,
   "key": "D1105le.txt:837",
   "file": "D1105le.txt",
   "line": 837,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの瞳が、俺の瞳のすぐ側にある。",
   "ko_candidate": "라이카 씨의 눈동자가 내 눈동자 바로 옆에 있다｡"
  },
  {
   "id": 23930,
   "key": "D1105le.txt:838",
   "file": "D1105le.txt",
   "line": 838,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の瞳も、ライカさんのすぐ側にある。",
   "ko_candidate": "내 눈동자도 라이카 씨의 바로 옆에 있다｡"
  },
  {
   "id": 23931,
   "key": "D1105le.txt:839",
   "file": "D1105le.txt",
   "line": 839,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "唇も。",
   "ko_candidate": "입술도｡"
  },
  {
   "id": 23932,
   "key": "D1105le.txt:841",
   "file": "D1105le.txt",
   "line": 841,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんが瞳を閉じた。",
   "ko_candidate": "라이카 씨가 눈을 감았다｡"
  },
  {
   "id": 23933,
   "key": "D1105le.txt:842",
   "file": "D1105le.txt",
   "line": 842,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺も瞳を閉じた。",
   "ko_candidate": "나도 눈을 감았다｡"
  },
  {
   "id": 23934,
   "key": "D1105le.txt:843",
   "file": "D1105le.txt",
   "line": 843,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妙に遠く感じられた零が埋め尽くされた。",
   "ko_candidate": "묘하게 멀게 느껴졌던 제로가 메워졌다｡"
  },
  {
   "id": 23935,
   "key": "D1105le.txt:845",
   "file": "D1105le.txt",
   "line": 845,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "唇に柔らかな感触。",
   "ko_candidate": "입술에 부드러운 감촉｡"
  },
  {
   "id": 23936,
   "key": "D1105le.txt:846",
   "file": "D1105le.txt",
   "line": 846,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして痺れるほどに、甘い味が。",
   "ko_candidate": "그리고 저릿할 정도로 달콤한 맛이｡"
  },
  {
   "id": 23937,
   "key": "D1105le.txt:848",
   "file": "D1105le.txt",
   "line": 848,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳では捉えず、ただ唇で、俺たちは互いを感じ取る。",
   "ko_candidate": "눈으로는 포착하지 않고 오직 입술로､ 우리는 서로를 느낀다｡"
  },
  {
   "id": 23938,
   "key": "D1105le.txt:856",
   "file": "D1105le.txt",
   "line": 856,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "＊＊＊ 千年の悠久を、嵐の様に駈け抜けて来た。",
   "ko_candidate": "천년의 유구함을､ 폭풍처럼 달려왔다｡"
  },
  {
   "id": 23939,
   "key": "D1105ru.txt:8",
   "file": "D1105ru.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鬼械神を駆って、邪神の勢力と戦い続けた。",
   "ko_candidate": "귀계신을 몰아､ 사신의 세력과 계속 싸워왔다｡"
  },
  {
   "id": 23940,
   "key": "D1105ru.txt:9",
   "file": "D1105ru.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地で。森で。砂漠で。雪原で。山で。海で。空で。",
   "ko_candidate": "대지에서｡ 숲에서｡ 사막에서｡ 설원에서｡ 산에서｡ 바다에서｡ 하늘에서｡"
  },
  {
   "id": 23941,
   "key": "D1105ru.txt:10",
   "file": "D1105ru.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ある時は宇宙ですら。",
   "ko_candidate": "어떤 때는 우주에서조차｡"
  },
  {
   "id": 23942,
   "key": "D1105ru.txt:12",
   "file": "D1105ru.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焦燥があった。",
   "ko_candidate": "초조함이 있었다｡"
  },
  {
   "id": 23943,
   "key": "D1105ru.txt:13",
   "file": "D1105ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦わねばと云う焦燥が、いつも我が身を灼いていた。",
   "ko_candidate": "싸워야 한다는 초조함이､ 언제나 내 몸을 태우고 있었다｡"
  },
  {
   "id": 23944,
   "key": "D1105ru.txt:14",
   "file": "D1105ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理由は解からない。",
   "ko_candidate": "이유는 알 수 없다｡"
  },
  {
   "id": 23945,
   "key": "D1105ru.txt:15",
   "file": "D1105ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今でもまだ、解からない。",
   "ko_candidate": "지금도 여전히､ 알 수 없다｡"
  },
  {
   "id": 23946,
   "key": "D1105ru.txt:16",
   "file": "D1105ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ邪神の勢力と戦う意志を、戦わねばと云う焦燥を、自らに与えられた使命であると認識した。",
   "ko_candidate": "단지 사신의 세력과 싸우는 의지를､ 싸워야 한다는 초조함을､ 스스로에게 주어진 사명이라고 인식했다｡"
  },
  {
   "id": 23947,
   "key": "D1105ru.txt:17",
   "file": "D1105ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰に与えられたとも知れぬ、使命だが。",
   "ko_candidate": "누구에게 주어졌는지도 모르는､ 사명이지만｡"
  },
  {
   "id": 23948,
   "key": "D1105ru.txt:19",
   "file": "D1105ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "故に。",
   "ko_candidate": "그러므로｡"
  },
  {
   "id": 23949,
   "key": "D1105ru.txt:20",
   "file": "D1105ru.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闘争こそ我が生涯の糧。",
   "ko_candidate": "투쟁이야말로 내 평생의 양식｡"
  },
  {
   "id": 23950,
   "key": "D1105ru.txt:21",
   "file": "D1105ru.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闘争こそ我が永遠の伴侶。",
   "ko_candidate": "투쟁이야말로 내 영원한 반려｡"
  },
  {
   "id": 23951,
   "key": "D1105ru.txt:22",
   "file": "D1105ru.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疑う事無く、戦い続けた。",
   "ko_candidate": "의심할 것 없이､ 계속 싸워왔다｡"
  },
  {
   "id": 23952,
   "key": "D1105ru.txt:24",
   "file": "D1105ru.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "独りで。",
   "ko_candidate": "혼자서｡"
  },
  {
   "id": 23953,
   "key": "D1105ru.txt:25",
   "file": "D1105ru.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう、独り。",
   "ko_candidate": "그래､ 혼자｡"
  },
  {
   "id": 23954,
   "key": "D1105ru.txt:26",
   "file": "D1105ru.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あくまで、独り。",
   "ko_candidate": "어디까지나､ 혼자｡"
  }
 ]
}