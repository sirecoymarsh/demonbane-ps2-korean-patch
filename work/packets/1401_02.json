 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "デモンベイン": "데몬베인",
  "アル": "알",
  "大十字": "다이쥬지"
 },
 "items": [
  {
   "id": 35992,
   "key": "D1401al.txt:344",
   "file": "D1401al.txt",
   "line": 344,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「拙い……拙いぞ、九郎……ッ！」",
   "ko_candidate": "「위험해……위험하다고､ 쿠로……!」"
  },
  {
   "id": 35993,
   "key": "D1401al.txt:348",
   "file": "D1401al.txt",
   "line": 348,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「んなこたぁ、分かっている！」",
   "ko_candidate": "「그런 건 알고 있다고!」"
  },
  {
   "id": 35994,
   "key": "D1401al.txt:356",
   "file": "D1401al.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "分かっているけど……どうすりゃ良い!?",
   "ko_candidate": "알고 있지만……어떻게 해야 하지!?"
  },
  {
   "id": 35995,
   "key": "D1401al.txt:358",
   "file": "D1401al.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どうやって止める？",
   "ko_candidate": "어떻게 막아?"
  },
  {
   "id": 35996,
   "key": "D1401al.txt:360",
   "file": "D1401al.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな強大な強壮な兇暴な兇悪な狂気的な絶対的力、絶望的力を持った化け物を……どうやって止めれば良い？",
   "ko_candidate": "이렇게 강대하고 강건하고 흉폭하고 흉악하고 광기적이고 절대적인 힘､ 절망적인 힘을 가진 괴물을……어떻게 막아야 하지?"
  },
  {
   "id": 35997,
   "key": "D1401al.txt:362",
   "file": "D1401al.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、悩んでいる場合じゃない。",
   "ko_candidate": "하지만 고민할 시간이 없다｡"
  },
  {
   "id": 35998,
   "key": "D1401al.txt:363",
   "file": "D1401al.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖している暇も絶望している暇もない。",
   "ko_candidate": "공포에 빠질 시간도 절망할 시간도 없다｡"
  },
  {
   "id": 35999,
   "key": "D1401al.txt:365",
   "file": "D1401al.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなのん気な、のどかな気持ちでいる余裕なんて微塵も無い。",
   "ko_candidate": "그런 한가하고 평화로운 마음을 가질 여유 따위는 조금도 없다｡"
  },
  {
   "id": 36000,
   "key": "D1401al.txt:366",
   "file": "D1401al.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何でも良いから、何をやったって、奇蹟を起こしたって、止めなきゃならないッ！",
   "ko_candidate": "뭐든 좋으니까､ 뭘 해도 좋으니까､ 기적을 일으켜서라도 막아야 해!"
  },
  {
   "id": 36001,
   "key": "D1401al.txt:373",
   "file": "D1401al.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触手の一本、竜頭の一つが、デモンベインに牙を剥けた。",
   "ko_candidate": "촉수 하나､ 용두 하나가 데몬베인에 이빨을 드러냈다｡"
  },
  {
   "id": 36002,
   "key": "D1401al.txt:374",
   "file": "D1401al.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大きく開け放たれた顎が、純然な破壊の劫火を、今まさに開放しようとしている――！",
   "ko_candidate": "크게 벌어진 턱이 순수한 파괴의 겁화를 지금 막 해방하려 하고 있다――!"
  },
  {
   "id": 36003,
   "key": "D1401al.txt:377",
   "file": "D1401al.txt",
   "line": 377,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ!?」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 36004,
   "key": "D1401al.txt:382",
   "file": "D1401al.txt",
   "line": 382,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チィィィィッ！」",
   "ko_candidate": "「치이이이이!」"
  },
  {
   "id": 36005,
   "key": "D1401al.txt:391",
   "file": "D1401al.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚部シールドを全開にして、デモンベインは翔ぶが如く疾走する。",
   "ko_candidate": "다리 부분 실드를 전개하고 데몬베인은 날아오르듯 질주한다｡"
  },
  {
   "id": 36006,
   "key": "D1401al.txt:392",
   "file": "D1401al.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、こんなことで逃れられるとは……！",
   "ko_candidate": "하지만 이런 걸로 벗어날 수 있을 리가……!"
  },
  {
   "id": 36007,
   "key": "D1401al.txt:397",
   "file": "D1401al.txt",
   "line": 397,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「消えて無くなれぇぇぇぇぇい！　デモンベインッ！」",
   "ko_candidate": "「사라져버려어어어어! 데몬베인!」"
  },
  {
   "id": 36008,
   "key": "D1401al.txt:401",
   "file": "D1401al.txt",
   "line": 401,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……あああああ……ッッ！」",
   "ko_candidate": "「아……아아아아아……!」"
  },
  {
   "id": 36009,
   "key": "D1401al.txt:410",
   "file": "D1401al.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雷鳴が世界中の静寂を埋め尽くした。",
   "ko_candidate": "천둥소리가 세계 전체의 정적을 뒤덮었다｡"
  },
  {
   "id": 36010,
   "key": "D1401al.txt:411",
   "file": "D1401al.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇夜に無数の太陽が生まれた。",
   "ko_candidate": "어두운 밤에 무수한 태양이 태어났다｡"
  },
  {
   "id": 36011,
   "key": "D1401al.txt:412",
   "file": "D1401al.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪神の吐息が、街を薙ぎ払う。",
   "ko_candidate": "사신의 숨결이 거리를 휩쓴다｡"
  },
  {
   "id": 36012,
   "key": "D1401al.txt:418",
   "file": "D1401al.txt",
   "line": 418,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……――――――――――――――ッ！」",
   "ko_candidate": "「……――――――――――――――!」"
  },
  {
   "id": 36013,
   "key": "D1401al.txt:424",
   "file": "D1401al.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの叫びすら掻き消された。",
   "ko_candidate": "알의 외침마저 사라졌다｡"
  },
  {
   "id": 36014,
   "key": "D1401al.txt:425",
   "file": "D1401al.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ破滅が、衝撃と閃光を伴って、デモンベインを呑み込む。",
   "ko_candidate": "오직 파멸만이 충격과 섬광을 동반해 데몬베인을 삼켜버린다｡"
  },
  {
   "id": 36015,
   "key": "D1401al.txt:426",
   "file": "D1401al.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界が白い闇に包まれる。",
   "ko_candidate": "세계가 하얀 어둠에 휩싸인다｡"
  },
  {
   "id": 36016,
   "key": "D1401al.txt:435",
   "file": "D1401al.txt",
   "line": 435,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!? 大十字さ……ッ！」",
   "ko_candidate": "「――――!? 다이쥬지……!」"
  },
  {
   "id": 36017,
   "key": "D1401al.txt:449",
   "file": "D1401al.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誕生は祝福であるとヒトは信じている。",
   "ko_candidate": "탄생은 축복이라고 인간은 믿고 있다｡"
  },
  {
   "id": 36018,
   "key": "D1401al.txt:451",
   "file": "D1401al.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "喜びに満たされ、愛に満たされ、命は生まれてくると信じている。",
   "ko_candidate": "기쁨으로 가득 차고 사랑으로 가득 차서 생명이 태어난다고 믿고 있다｡"
  },
  {
   "id": 36019,
   "key": "D1401al.txt:456",
   "file": "D1401al.txt",
   "line": 456,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは過ちである。",
   "ko_candidate": "그것은 잘못이다｡"
  },
  {
   "id": 36020,
   "key": "D1401al.txt:457",
   "file": "D1401al.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは欺瞞である。",
   "ko_candidate": "그것은 기만이다｡"
  },
  {
   "id": 36021,
   "key": "D1401al.txt:459",
   "file": "D1401al.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誕生は呪いであり、世界は悪意と冒涜に満ちている。",
   "ko_candidate": "탄생은 저주이며 세계는 악의와 모독으로 가득 차 있다｡"
  },
  {
   "id": 36022,
   "key": "D1401al.txt:461",
   "file": "D1401al.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして赤子は純粋であるが故に、それを理解している。",
   "ko_candidate": "그리고 갓난아기는 순수하기에 그것을 이해하고 있다｡"
  },
  {
   "id": 36023,
   "key": "D1401al.txt:463",
   "file": "D1401al.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "母の胎内に在って、赤子は完全である。",
   "ko_candidate": "어머니의 태내에 있을 때 갓난아기는 완전하다｡"
  },
  {
   "id": 36024,
   "key": "D1401al.txt:464",
   "file": "D1401al.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "母の温もりに包まれた、母の鼓動に抱かれた、其処は世界の中心。",
   "ko_candidate": "어머니의 온기에 싸여 어머니의 고동에 안겨 있는 그곳은 세계의 중심｡"
  },
  {
   "id": 36025,
   "key": "D1401al.txt:466",
   "file": "D1401al.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限の愛の揺籃。",
   "ko_candidate": "무한한 사랑의 요람｡"
  },
  {
   "id": 36026,
   "key": "D1401al.txt:467",
   "file": "D1401al.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なれば、それ以上、何を求めるものがあろう？",
   "ko_candidate": "그렇다면 그 이상 무엇을 구할 것이 있겠는가?"
  },
  {
   "id": 36027,
   "key": "D1401al.txt:469",
   "file": "D1401al.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "赤子は世界を精一杯に享受している。",
   "ko_candidate": "갓난아기는 세계를 온 힘을 다해 누리고 있다｡"
  },
  {
   "id": 36028,
   "key": "D1401al.txt:471",
   "file": "D1401al.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "故に――",
   "ko_candidate": "그러므로――"
  },
  {
   "id": 36029,
   "key": "D1401al.txt:472",
   "file": "D1401al.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "楽園から放逐され、外界に産み堕とされたそのとき、",
   "ko_candidate": "낙원에서 쫓겨나 외계에 태어났을 때､"
  },
  {
   "id": 36030,
   "key": "D1401al.txt:473",
   "file": "D1401al.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "赤子は泣き叫ぶのだ。慟哭するのだ。",
   "ko_candidate": "갓난아기는 울부짖는 것이다｡ 통곡하는 것이다｡"
  },
  {
   "id": 36031,
   "key": "D1401al.txt:475",
   "file": "D1401al.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肌を切り裂く尖った大気。",
   "ko_candidate": "살갗을 베는 날카로운 대기｡"
  }
 ]
}