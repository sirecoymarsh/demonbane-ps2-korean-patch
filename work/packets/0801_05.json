   "work": false,
   "jp": "……ああ。",
   "ko_candidate": "……아아｡"
  },
  {
   "id": 11947,
   "key": "D0801le.txt:20",
   "file": "D0801le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また、しろい、景色だ。",
   "ko_candidate": "또､ 하얀､ 풍경이다｡"
  },
  {
   "id": 11948,
   "key": "D0801le.txt:27",
