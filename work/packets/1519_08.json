 },
 "items": [
  {
   "id": 48855,
   "key": "D1519le.txt:448",
   "file": "D1519le.txt",
   "line": 448,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "神獣はナイアを押し倒し、馬乗りになったままの状態で、女性の姿に変わる。",
   "ko_candidate": "신수는 나이아를 밀어 넘어뜨리고､ 기승 자세 그대로､ 여성의 모습으로 변한다｡"
  },
  {
   "id": 48856,
   "key": "D1519le.txt:450",
   "file": "D1519le.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇の女と焔の女。",
   "ko_candidate": "어둠의 여자와 불꽃의 여자｡"
  },
  {
   "id": 48857,
   "key": "D1519le.txt:451",
   "file": "D1519le.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼熱の抱擁が２人を包む。",
   "ko_candidate": "작열의 포옹이 둘을 감싼다｡"
  },
  {
   "id": 48859,
   "key": "D1519le.txt:453",
   "file": "D1519le.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光が砕け、闇が爆ぜる。",
   "ko_candidate": "섬광이 부서지고､ 어둠이 터진다｡"
  },
  {
   "id": 48860,
   "key": "D1519le.txt:454",
   "file": "D1519le.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "融け合う光と闇の世界に、異形の叫びが響き渡った。",
   "ko_candidate": "녹아드는 빛과 어둠의 세계에 기괴한 외침이 울려 퍼졌다｡"
  },
  {
   "id": 48861,
   "key": "D1519le.txt:471",
   "file": "D1519le.txt",
   "line": 471,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「甘いぞ、デモンベイン！」",
   "ko_candidate": "「달콤하구나､ 데몬베인!」"
  },
  {
   "id": 48862,
   "key": "D1519le.txt:482",
   "file": "D1519le.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滅びを孕む鋭い闇が空間を疾る。",
   "ko_candidate": "멸망을 잉태한 날카로운 어둠이 공간을 가로지른다｡"
  },
  {
   "id": 48863,
   "key": "D1519le.txt:483",
   "file": "D1519le.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬でデモンベインの右腕が消失し、魔銃は群がる闇に貪られる。",
   "ko_candidate": "순식간에 데몬베인의 오른팔이 사라지고､ 마총은 몰려드는 어둠에 탐식당한다｡"
  },
  {
   "id": 48864,
   "key": "D1519le.txt:485",
   "file": "D1519le.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔銃は魔導書のページへと変わって散らばる。",
   "ko_candidate": "마총은 마도서의 페이지로 변해 흩어진다｡"
  },
  {
   "id": 48865,
   "key": "D1519le.txt:486",
   "file": "D1519le.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間を舞う紙片が燃え落ち、灰になって散った。",
   "ko_candidate": "공간을 날아다니는 종이 조각이 타떨어져 재가 되어 흩어졌다｡"
  },
  {
   "id": 48866,
   "key": "D1519le.txt:492",
   "file": "D1519le.txt",
   "line": 492,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぅああ……！」",
   "ko_candidate": "「크으아아……!」"
  },
  {
   "id": 48867,
   "key": "D1519le.txt:496",
   "file": "D1519le.txt",
   "line": 496,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大人しく混沌に沈め！」",
   "ko_candidate": "「얌전히 혼돈 속에 가라앉아라!」"
  },
  {
   "id": 48868,
   "key": "D1519le.txt:500",
   "file": "D1519le.txt",
   "line": 500,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アル！　ライカさん！」",
   "ko_candidate": "「알! 라이카 씨!」"
  },
  {
   "id": 48869,
   "key": "D1519le.txt:510",
   "file": "D1519le.txt",
   "line": 510,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇の海が完全にデモンベインを呑み込んでしまう寸前、俺たちはハッチを吹き飛ばし、外に逃れた。",
   "ko_candidate": "어둠의 바다가 완전히 데몬베인을 삼켜버리기 직전､ 우리는 해치를 날려버리고 밖으로 탈출했다｡"
  },
  {
   "id": 48870,
   "key": "D1519le.txt:512",
   "file": "D1519le.txt",
   "line": 512,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の身体を、黒いボディスーツが包み込む。",
   "ko_candidate": "내 몸을 검은 바디슈트가 감싼다｡"
  },
  {
   "id": 48871,
   "key": "D1519le.txt:513",
   "file": "D1519le.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紡ぎ出す術式は、もう一挺の魔銃を招喚する術だった。",
   "ko_candidate": "짜내는 술식은 또 한 자루의 마총을 소환하는 술이었다｡"
  },
  {
   "id": 48872,
   "key": "D1519le.txt:517",
   "file": "D1519le.txt",
   "line": 517,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イタクァ！」",
   "ko_candidate": "「이타콰!」"
  },
  {
   "id": 48873,
   "key": "D1519le.txt:526",
   "file": "D1519le.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "流麗な銀色の拳銃が、掌の中に顕れる。",
   "ko_candidate": "유려한 은색 권총이 손바닥 안에 나타난다｡"
  },
  {
   "id": 48874,
   "key": "D1519le.txt:533",
   "file": "D1519le.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "照準を、ある一点に合わせた。",
   "ko_candidate": "표준을 어느 한 점에 맞췄다｡"
  },
  {
   "id": 48875,
   "key": "D1519le.txt:534",
   "file": "D1519le.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんもまた、変形させた右腕を、同じ一点に向ける。",
   "ko_candidate": "라이카 씨도 또한 변형시킨 오른팔을 같은 한 점을 향해 겨눈다｡"
  },
  {
   "id": 48876,
   "key": "D1519le.txt:535",
   "file": "D1519le.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "考えることは一緒か！",
   "ko_candidate": "생각하는 것은 똑같군!"
  },
  {
   "id": 48877,
   "key": "D1519le.txt:544",
   "file": "D1519le.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の中に護っても、俺には解かる。",
   "ko_candidate": "어둠 속에 숨어있어도 나에겐 알 수 있다｡"
  },
  {
   "id": 48878,
   "key": "D1519le.txt:545",
   "file": "D1519le.txt",
   "line": 545,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソレの居場所が。",
   "ko_candidate": "그것의 있는 곳이｡"
  },
  {
   "id": 48879,
   "key": "D1519le.txt:547",
   "file": "D1519le.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さっきソレを見たとき、ソレの気配は俺の魂にしかと刻み込まれた。",
   "ko_candidate": "아까 그것을 봤을 때､ 그것의 기척은 내 영혼에 확실히 새겨졌다｡"
  },
  {
   "id": 48880,
   "key": "D1519le.txt:548",
   "file": "D1519le.txt",
   "line": 548,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見失うはずがない。",
   "ko_candidate": "놓칠 리가 없다｡"
  },
  {
   "id": 48881,
   "key": "D1519le.txt:552",
   "file": "D1519le.txt",
   "line": 552,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「真逆!?」",
   "ko_candidate": "「설마!?」"
  },
  {
   "id": 48882,
   "key": "D1519le.txt:564",
   "file": "D1519le.txt",
   "line": 564,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声と砲声が重なった。",
   "ko_candidate": "총성과 포성이 겹쳤다｡"
  },
  {
   "id": 48883,
   "key": "D1519le.txt:565",
   "file": "D1519le.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "空間を自在に疾る弾丸が、空間を裂く光が、まったく同時に、闇の中のソレを貫く。",
   "ko_candidate": "공간을 자유자재로 가로지르는 탄환이､ 공간을 가르는 빛이､ 완전히 동시에､ 어둠 속의 그것을 꿰뚫는다｡"
  },
  {
   "id": 48884,
   "key": "D1519le.txt:576",
   "file": "D1519le.txt",
   "line": 576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "硝子が砕ける、甲高い音が聴こえた。",
   "ko_candidate": "유리가 깨지는 듯한 날카로운 소리가 들렸다｡"
  },
  {
   "id": 48885,
   "key": "D1519le.txt:577",
   "file": "D1519le.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃弾と砲撃は、あの魔人の胎児を確かに貫いた。",
   "ko_candidate": "총알과 포격은 저 마인의 태아를 확실히 관통했다｡"
  },
  {
   "id": 48886,
   "key": "D1519le.txt:579",
   "file": "D1519le.txt",
   "line": 579,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――この瞬間、輪廻の環もまた、砕けた。",
   "ko_candidate": "――이 순간､ 윤회의 고리 또한 부서졌다｡"
  }
 ]
}