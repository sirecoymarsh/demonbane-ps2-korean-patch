 "items": [
  {
   "id": 27725,
   "key": "D1206al.txt:13",
   "file": "D1206al.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トドメを刺そうとケンダマを振り上げたクラウディウスの足場が、突然崩れた。",
   "ko_candidate": "클라우디우스가 마지막 일격을 가하려고 켄다마를 들어올리자 갑자기 발판이 무너졌다｡"
  },
  {
   "id": 27726,
   "key": "D1206al.txt:17",
   "file": "D1206al.txt",
   "line": 17,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ!?　ぐはっ！」",
   "ko_candidate": "「뭐!? 으악!」"
  },
  {
   "id": 27727,
   "key": "D1206al.txt:24",
   "file": "D1206al.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩れた床の下から黒い棺桶が飛び出す。",
   "ko_candidate": "무너진 바닥 아래에서 검은 관이 튀어나왔다｡"
  },
  {
   "id": 27728,
   "key": "D1206al.txt:25",
   "file": "D1206al.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "棺桶に顎を打たれ、クラウディウスは後ろへと仰け反り、転がった。",
   "ko_candidate": "관에 턱을 맞은 클라우디우스는 뒤로 젖혀져 굴러갔다｡"
  },
  {
   "id": 27729,
   "key": "D1206al.txt:26",
   "file": "D1206al.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "棺桶に向かってエルザが叫ぶ。",
   "ko_candidate": "엘자가 관을 향해 외쳤다｡"
  },
  {
   "id": 27730,
   "key": "D1206al.txt:30",
   "file": "D1206al.txt",
   "line": 30,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「術式魔砲 『我、埋葬にあたわず』！」",
   "ko_candidate": "「술식마포 『나､ 매장할 수 없노라』!」"
  },
  {
   "id": 27731,
   "key": "D1206al.txt:39",
   "file": "D1206al.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "棺桶が砕け散り、エルザの得物である術式魔砲が姿を見せる。",
   "ko_candidate": "관이 산산조각 나며 엘자의 무기인 술식마포가 모습을 드러냈다｡"
  },
  {
   "id": 27732,
   "key": "D1206al.txt:40",
   "file": "D1206al.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザが手を伸ばすと大砲は彼女の元まで飛んできた。",
   "ko_candidate": "엘자가 손을 뻗자 대포가 그녀에게 날아왔다｡"
  },
  {
   "id": 27733,
   "key": "D1206al.txt:42",
   "file": "D1206al.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "担ぎ上げ、砲口を床に転がるクラウディウスに向ける。",
   "ko_candidate": "들어 올려 포구를 바닥에 구르는 클라우디우스에게 겨눈다｡"
  },
  {
   "id": 27734,
   "key": "D1206al.txt:49",
   "file": "D1206al.txt",
   "line": 49,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ファイア！」",
   "ko_candidate": "「파이어!」"
  },
  {
   "id": 27735,
   "key": "D1206al.txt:55",
   "file": "D1206al.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔砲が吠えた。",
   "ko_candidate": "마포가 포효했다｡"
  },
  {
   "id": 27736,
   "key": "D1206al.txt:56",
   "file": "D1206al.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "質量と衝撃力と爆発力とを兼ねた砲弾が、紫電を迸らせながら、クラウディウスに迫る。",
   "ko_candidate": "질량과 충격력과 폭발력을 겸비한 포탄이 자줏빛 번개를 내뿜으며 클라우디우스에게 다가간다｡"
  },
  {
   "id": 27737,
   "key": "D1206al.txt:61",
   "file": "D1206al.txt",
   "line": 61,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ！」",
   "ko_candidate": "「큭!」"
  },
  {
   "id": 27738,
   "key": "D1206al.txt:75",
   "file": "D1206al.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスを包む風の防禦陣が目に見えるほど、はっきりと顕現化した。",
   "ko_candidate": "클라우디우스를 감싸는 바람의 방어진이 눈에 보일 정도로 뚜렷하게 현현화했다｡"
  },
  {
   "id": 27739,
   "key": "D1206al.txt:78",
   "file": "D1206al.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、砲弾は防禦陣を無理矢理に穿ち、クラウディウスに直撃する！",
   "ko_candidate": "하지만 포탄은 방어진을 억지로 뚫고 클라우디우스에게 직격했다!"
  },
  {
   "id": 27740,
   "key": "D1206al.txt:91",
   "file": "D1206al.txt",
   "line": 91,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「があああああああ！」 爆発に吹き飛ばされ、床を転がるクラウディウス。",
   "ko_candidate": "「으아아아아아아아!」{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 27741,
   "key": "D1206al.txt:100",
   "file": "D1206al.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "勝機を見い出したか、エルザは更に魔砲を連射する。",
   "ko_candidate": "폭발에 날아가 바닥을 구르는 클라우디우스｡ 승기를 포착했는지 엘자는 더욱 마포를 연사한다｡"
  },
  {
   "id": 27742,
   "key": "D1206al.txt:109",
   "file": "D1206al.txt",
   "line": 109,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボォォォォォォォォォォォ！」",
   "ko_candidate": "「로보오오오오오오오오오오오오!」"
  },
  {
   "id": 27743,
   "key": "D1206al.txt:113",
   "file": "D1206al.txt",
   "line": 113,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐわあああっ！ くぅぅぅぅっ！」",
   "ko_candidate": "「으와아아악! 크으으으으윽!」"
  },
  {
   "id": 27744,
   "key": "D1206al.txt:117",
   "file": "D1206al.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反動がじりじりとエルザを後ずさらせる。",
   "ko_candidate": "반동이 엘자를 조금씩 뒤로 밀어낸다｡"
  },
  {
   "id": 27745,
   "key": "D1206al.txt:130",
   "file": "D1206al.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾度と砲弾が爆発し、クラウディウスは爆炎と閃光に呑み込まれた。",
   "ko_candidate": "수차례 포탄이 폭발하고 클라우디우스는 폭염과 섬광에 휩싸였다｡"
  },
  {
   "id": 27746,
   "key": "D1206al.txt:133",
   "file": "D1206al.txt",
   "line": 133,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「良しッ！」 この隙を逃すワケにはいかない。",
   "ko_candidate": "「좋아!」{SE_VOL(2,1000,0);}<br>"
  },
  {
   "id": 27747,
   "key": "D1206al.txt:139",
   "file": "D1206al.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺はクトゥグアとイタクァの弾倉を詰め替え、エルザを援護する。",
   "ko_candidate": "이 틈을 놓칠 수는 없다｡ 나는 크투가와 이타콰의 탄창을 갈아 끼우고､{SE_PLAY(1,\"갖郎クトゥグア6連염\",0,85,false);}엘자를 지원한다｡"
  },
  {
   "id": 27748,
   "key": "D1206al.txt:160",
   "file": "D1206al.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音と銃声が耳をつんざく。",
   "ko_candidate": "폭음과 총성이 귀를 찢는다｡"
  },
  {
   "id": 27749,
   "key": "D1206al.txt:165",
   "file": "D1206al.txt",
   "line": 165,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こぉぉぉのぉぉお！ 糞ネズミどもがァァァっ！」",
   "ko_candidate": "「이이이이이이잇! 쥐새끼들아아아아!」"
  },
  {
   "id": 27750,
   "key": "D1206al.txt:171",
   "file": "D1206al.txt",
   "line": 171,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ――!?」",
   "ko_candidate": "「큭――!?」"
  },
  {
   "id": 27751,
   "key": "D1206al.txt:175",
   "file": "D1206al.txt",
   "line": 175,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ロボっ!?」",
   "ko_candidate": "「로봇!?」"
  },
  {
   "id": 27752,
   "key": "D1206al.txt:184",
   "file": "D1206al.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆炎を烈風で一気に吹き飛ばし、 クラウディウスが吼えた。",
   "ko_candidate": "폭염을 열풍으로 단숨에 날려버리고 클라우디우스가 포효했다｡"
  },
  {
   "id": 27753,
   "key": "D1206al.txt:186",
   "file": "D1206al.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、こっちの攻撃は間違いなく効いている。",
   "ko_candidate": "하지만 이쪽의 공격은 틀림없이 먹혔다｡"
  },
  {
   "id": 27754,
   "key": "D1206al.txt:187",
   "file": "D1206al.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身から血を流し、いたる箇所が火傷に爛れている。",
   "ko_candidate": "온몸에서 피를 흘리고 곳곳이 화상으로 문드러졌다｡"
  },
  {
   "id": 27755,
   "key": "D1206al.txt:188",
   "file": "D1206al.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怒りに燃える眼が、俺たちを睨んでいる。",
   "ko_candidate": "분노에 불타는 눈이 우리를 노려보고 있다｡"
  },
  {
   "id": 27756,
   "key": "D1206al.txt:192",
   "file": "D1206al.txt",
   "line": 192,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「最大魔力で ズタズタにしてやらぁ！」",
   "ko_candidate": "「최대 마력으로 갈가리 내주마!」"
  },
  {
   "id": 27757,
   "key": "D1206al.txt:196",
   "file": "D1206al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怒りのあまり、こっちのことしか見えてない。",
   "ko_candidate": "분노에 휩싸여 이쪽만 보고 있다｡"
  },
  {
   "id": 27758,
   "key": "D1206al.txt:197",
   "file": "D1206al.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "チャンスだ。俺は意識を集中して、魔術の法則を形成させる。",
   "ko_candidate": "기회다｡ 나는 의식을 집중해 마술의 법칙을 형성시킨다｡"
  },
  {
   "id": 27759,
   "key": "D1206al.txt:200",
   "file": "D1206al.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "法則は単純だ。",
   "ko_candidate": "법칙은 단순하다｡"
  },
  {
   "id": 27760,
   "key": "D1206al.txt:201",
   "file": "D1206al.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "たった今、撃ち尽くしたイタクァの弾丸。",
   "ko_candidate": "방금 전 쏟아부은 이타콰의 탄환｡"
  },
  {
   "id": 27761,
   "key": "D1206al.txt:202",
   "file": "D1206al.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのほとんどはクラウディウスには当たらず、その横を通り過ぎるか、風に弾かれるかだ。",
   "ko_candidate": "그 대부분은 클라우디우스에게 맞지 않고 옆을 지나가거나 바람에 튕겨나갔다｡"
  },
  {
   "id": 27762,
   "key": "D1206al.txt:204",
   "file": "D1206al.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、ただ一発。",
   "ko_candidate": "하지만 단 한 발｡"
  },
  {
   "id": 27763,
   "key": "D1206al.txt:205",
   "file": "D1206al.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "音速で飛ぶただ一発の弾丸と、 俺の精神は繋がっていた。",
   "ko_candidate": "음속으로 날아가는 단 한 발의 탄환과 내 정신은 연결되어 있었다｡"
  },
  {
   "id": 27764,
   "key": "D1206al.txt:207",
   "file": "D1206al.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今こそ命令を飛ばす。",
   "ko_candidate": "지금이야말로 명령을 내린다｡"
  }
 ]
}