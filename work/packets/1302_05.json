 "items": [
  {
   "id": 31272,
   "key": "D1302le.txt:127",
   "file": "D1302le.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か、しっくり来ない。",
   "ko_candidate": "뭔가､ 석연치 않다｡"
  },
  {
   "id": 31273,
   "key": "D1302le.txt:128",
   "file": "D1302le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そういう安直な結末は、納得がいかない。",
   "ko_candidate": "그런 안이한 결말은､ 납득이 가지 않는다｡"
  },
  {
   "id": 31274,
   "key": "D1302le.txt:135",
   "file": "D1302le.txt",
   "line": 135,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あの状態でまだ息があった。そして我々が戦っている内に逃げおおせた……と考えるべきだ。楽観的な見方は感心できんぞ」",
   "ko_candidate": "「그 상태에서도 아직 숨이 붙어 있었다｡ 그리고 우리가 싸우는 동안 도망쳤다……고 봐야 한다｡ 낙관적인 견해는 찬성할 수 없어」"
  },
  {
   "id": 31275,
   "key": "D1302le.txt:139",
   "file": "D1302le.txt",
   "line": 139,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ、そうだな」",
   "ko_candidate": "「아아､ 그렇지」"
  },
  {
   "id": 31276,
   "key": "D1302le.txt:144",
   "file": "D1302le.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルも同じことを考えていたらしい。",
   "ko_candidate": "알도 같은 생각을 하고 있었던 모양이다｡"
  },
  {
   "id": 31277,
   "key": "D1302le.txt:145",
   "file": "D1302le.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もまったくの同意見だ。素直に頷く。",
   "ko_candidate": "나도 전적으로 동의한다｡ 솔직히 고개를 끄덕인다｡"
  },
  {
   "id": 31278,
   "key": "D1302le.txt:146",
   "file": "D1302le.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかしその場合、何処に逃げたかという疑問がある。",
   "ko_candidate": "하지만 그 경우､ 어디로 도망갔는지 의문이 있다｡"
  },
  {
   "id": 31279,
   "key": "D1302le.txt:148",
   "file": "D1302le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスに粛清されかけたのだ。『ブラックロッジ』に戻ることはない。",
   "ko_candidate": "티베리우스에게 숙청당할 뻔했다｡ 『블랙로지』로 돌아가지는 않을 것이다｡"
  },
  {
   "id": 31280,
   "key": "D1302le.txt:149",
   "file": "D1302le.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今まで以上に行動の予測が難しくなりそうだ。",
   "ko_candidate": "지금까지 이상으로 행동 예측이 어려워질 것 같다｡"
  },
  {
   "id": 31281,
   "key": "D1302le.txt:151",
   "file": "D1302le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……だが、ひとまずは置いておこう。",
   "ko_candidate": "……하지만､ 일단은 제쳐두자｡"
  },
  {
   "id": 31282,
   "key": "D1302le.txt:152",
   "file": "D1302le.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "問題は他に山ほどある。",
   "ko_candidate": "문제는 다른 게 산더미다｡"
  },
  {
   "id": 31283,
   "key": "D1302le.txt:156",
   "file": "D1302le.txt",
   "line": 156,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「メタトロン……いえ、ライカさん、でしたね。 彼女は敵の手に落ちましたか……」",
   "ko_candidate": "「메타트론……아니､ 라이카 씨､ 였죠｡ 그녀는 적의 손에 떨어졌습니까……」"
  },
  {
   "id": 31284,
   "key": "D1302le.txt:162",
   "file": "D1302le.txt",
   "line": 162,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 31285,
   "key": "D1302le.txt:166",
   "file": "D1302le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンを失ったという事は、『ブラックロッジ』に対抗する戦力の大部分を失った事と同義である。",
   "ko_candidate": "메타트론을 잃었다는 것은､ 『블랙로지』에 대항할 전력의 대부분을 잃은 것과 같은 의미다｡"
  },
  {
   "id": 31286,
   "key": "D1302le.txt:167",
   "file": "D1302le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺やガキんちょどもだけの問題ではない。",
   "ko_candidate": "나나 꼬마들만의 문제가 아니다｡"
  },
  {
   "id": 31287,
   "key": "D1302le.txt:169",
   "file": "D1302le.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインも無く、ライカさんの助けも無い。",
   "ko_candidate": "데몬베인도 없고､ 라이카 씨의 도움도 없다｡"
  },
  {
   "id": 31288,
   "key": "D1302le.txt:170",
   "file": "D1302le.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやって連中と渡り合う？",
   "ko_candidate": "어떻게 그들과 맞서 싸울 수 있을까?"
  },
  {
   "id": 31289,
   "key": "D1302le.txt:172",
   "file": "D1302le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵はまだアンチクロスが４人。そしてクトゥルーもまた『Ｃの巫女』であるライカさんを得て、覚醒を迎えようとしている。",
   "ko_candidate": "적은 아직 안티 크로스가 4명｡ 그리고 크툴루도 또는 『C의 무녀』인 라이카 씨를 얻어､ 각성을 맞이하려 하고 있다｡"
  },
  {
   "id": 31290,
   "key": "D1302le.txt:174",
   "file": "D1302le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鬼械神とホンモノの神様を、生身のまま敵に回そうってんだ。",
   "ko_candidate": "귀계신과 진짜 신을､ 맨몸으로 적으로 삼겠다는 거다｡"
  },
  {
   "id": 31291,
   "key": "D1302le.txt:175",
   "file": "D1302le.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正気の沙汰じゃない。",
   "ko_candidate": "정상적인 생각이 아니다｡"
  },
  {
   "id": 31292,
   "key": "D1302le.txt:177",
   "file": "D1302le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今の俺に、この絶望的状況を打破する力があるのか……？",
   "ko_candidate": "지금의 내게､ 이 절망적인 상황을 타개할 힘이 있을까……?"
  },
  {
   "id": 31293,
   "key": "D1302le.txt:183",
   "file": "D1302le.txt",
   "line": 183,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さんは、知っておられたのですか？ その……ライカさんが、メタトロンである事を」",
   "ko_candidate": "「다이쥬지 씨는､ 알고 계셨나요? 그……라이카 씨가､ 메타트론이라는 것을」"
  },
  {
   "id": 31294,
   "key": "D1302le.txt:188",
   "file": "D1302le.txt",
   "line": 188,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……知ったのは、ついつい最近だけど。 黙っていて、悪かったとは思ってる」",
   "ko_candidate": "「아아……알게 된 건､ 바로 얼마 전이지만｡ 말하지 않아서､ 미안하다고 생각하고 있어」"
  },
  {
   "id": 31295,
   "key": "D1302le.txt:195",
   "file": "D1302le.txt",
   "line": 195,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いえ、気にしてなどおりません。それに、一番、辛いのは大十字さんでしょうから……」",
   "ko_candidate": "「아니요､ 신경 쓰지 않고 있습니다｡ 그리고､ 가장 괴로운 건 다이쥬지 씨일 테니까……」"
  },
  {
   "id": 31296,
   "key": "D1302le.txt:199",
   "file": "D1302le.txt",
   "line": 199,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……いや、違う」",
   "ko_candidate": "「……아니､ 틀려」"
  },
  {
   "id": 31297,
   "key": "D1302le.txt:205",
   "file": "D1302le.txt",
   "line": 205,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え？」",
   "ko_candidate": "「네?」"
  },
  {
   "id": 31298,
   "key": "D1302le.txt:209",
   "file": "D1302le.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "違う。",
   "ko_candidate": "틀렸다｡"
  },
  {
   "id": 31299,
   "key": "D1302le.txt:210",
   "file": "D1302le.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは違う。",
   "ko_candidate": "그건 틀렸다｡"
  },
  {
   "id": 31300,
   "key": "D1302le.txt:211",
   "file": "D1302le.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "辛いだなんて、自分の不幸に酔うような真似は、俺には許されない。",
   "ko_candidate": "괴롭다니､ 자신의 불행에 취하는 것 같은 짓은､ 내겐 허용되지 않는다｡"
  },
  {
   "id": 31301,
   "key": "D1302le.txt:216",
   "file": "D1302le.txt",
   "line": 216,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「一番、辛いのはガキんちょどもさ……！」",
   "ko_candidate": "「가장､ 괴로운 건 꼬마들이야……!」"
  },
  {
   "id": 31302,
   "key": "D1302le.txt:218",
   "file": "D1302le.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分の不甲斐なさに腹が立つ。",
   "ko_candidate": "자신의 무능함에 화가 난다｡"
  },
  {
   "id": 31303,
   "key": "D1302le.txt:219",
   "file": "D1302le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こうしている間にも、ライカさんの身には危険が迫っている。",
   "ko_candidate": "이러고 있는 동안에도､ 라이카 씨에겐 위험이 다가오고 있다｡"
  },
  {
   "id": 31304,
   "key": "D1302le.txt:221",
   "file": "D1302le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "落ち込んだり、ビビったりしてる暇が、何処にあるかってんだ。",
   "ko_candidate": "낙담하거나､ 겁먹거나 할 시간이､ 어디 있다는 거야｡"
  },
  {
   "id": 31305,
   "key": "D1302le.txt:222",
   "file": "D1302le.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ふざけてんじゃねえぞ、俺！",
   "ko_candidate": "장난하지 마､ 나!"
  },
  {
   "id": 31306,
   "key": "D1302le.txt:228",
   "file": "D1302le.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は出口に向かって、歩き出す。",
   "ko_candidate": "나는 출구를 향해 걸어간다｡"
  },
  {
   "id": 31307,
   "key": "D1302le.txt:240",
   "file": "D1302le.txt",
   "line": 240,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ……」",
   "ko_candidate": "「앗……」"
  },
  {
   "id": 31308,
   "key": "D1302le.txt:245",
   "file": "D1302le.txt",
   "line": 245,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎、何処に行く？」",
   "ko_candidate": "「쿠로､ 어디 가?」"
  },
  {
   "id": 31309,
   "key": "D1302le.txt:250",
   "file": "D1302le.txt",
   "line": 250,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「執事さんやドクター・ウェストを見舞ってくる。 ドクター・ウェストには話もあるしな……」",
   "ko_candidate": "「집사 씨랑 닥터 웨스트를 문병하러 가｡ 닥터 웨스트한테는 할 얘기도 있고 말이야……」"
  },
  {
   "id": 31310,
   "key": "D1302le.txt:256",
   "file": "D1302le.txt",
   "line": 256,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待て待て、置いていくなっ」",
   "ko_candidate": "「잠깐 잠깐､ 두고 가지 마」"
  },
  {
   "id": 31311,
   "key": "D1302le.txt:264",
   "file": "D1302le.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルが後を追ってくる。",
   "ko_candidate": "알이 뒤를 쫓아온다｡"
  }
 ]
}