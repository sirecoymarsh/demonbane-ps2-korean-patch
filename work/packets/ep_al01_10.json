 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "九郎": "쿠로",
  "アル": "알",
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 49426,
   "key": "ep_al01.txt:1681",
   "file": "ep_al01.txt",
   "line": 1681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その怪異を、俺は良く知っている。",
   "ko_candidate": "그리고 빨려들 것만 같은 비취색 눈동자｡"
  },
  {
   "id": 49427,
   "key": "ep_al01.txt:1682",
   "file": "ep_al01.txt",
   "line": 1682,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "知らないはずがない。",
   "ko_candidate": "그 괴이를 나는 잘 알고 있다｡"
  },
  {
   "id": 49428,
   "key": "ep_al01.txt:1685",
   "file": "ep_al01.txt",
   "line": 1685,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「オリジナルが保管されてるとは、さすがに聞いてなかったぞ」",
   "ko_candidate": "모를 리가 없다｡ 「오리지널이 보관되어 있다니､ 그건 듣지 못했는데」"
  },
  {
   "id": 49429,
   "key": "ep_al01.txt:1691",
   "file": "ep_al01.txt",
   "line": 1691,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎……九郎……九郎――――――ッ！」",
   "ko_candidate": "「쿠로……쿠로……쿠로――――――읏!」"
  },
  {
   "id": 49430,
   "key": "ep_al01.txt:1702",
   "file": "ep_al01.txt",
   "line": 1702,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総ての悲しみが拭われた世界で",
   "ko_candidate": "모든 슬픔이 지워진 세계에서"
  },
  {
   "id": 49431,
   "key": "ep_al01.txt:1704",
   "file": "ep_al01.txt",
   "line": 1704,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総ての悲しみを忘れた世界で",
   "ko_candidate": "모든 슬픔을 잊은 세계에서"
  },
  {
   "id": 49432,
   "key": "ep_al01.txt:1706",
   "file": "ep_al01.txt",
   "line": 1706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ独りと独り、記憶を受け止めていた俺たちは",
   "ko_candidate": "오직 둘만이 기억을 간직하고 있던 우리는"
  },
  {
   "id": 49433,
   "key": "ep_al01.txt:1708",
   "file": "ep_al01.txt",
   "line": 1708,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空っぽの幸福の果てに",
   "ko_candidate": "텅 빈 행복의 끝에서"
  },
  {
   "id": 49434,
   "key": "ep_al01.txt:1710",
   "file": "ep_al01.txt",
   "line": 1710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "永き旅路の果てに",
   "ko_candidate": "긴 여정의 끝에서"
  },
  {
   "id": 49435,
   "key": "ep_al01.txt:1713",
   "file": "ep_al01.txt",
   "line": 1713,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――ようやく、互いの腕の中に帰還した。",
   "ko_candidate": "――마침내 서로의 품 안으로 돌아왔다｡"
  },
  {
   "id": 49436,
   "key": "ep_al01.txt:1725",
   "file": "ep_al01.txt",
   "line": 1725,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「馬鹿野郎……勝手な真似ばかりしやがって」",
   "ko_candidate": "「이 바보야……제멋대로 행동만 하고 말이야」"
  },
  {
   "id": 49437,
   "key": "ep_al01.txt:1727",
   "file": "ep_al01.txt",
   "line": 1727,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "胸の中で泣きじゃくるアルを、俺は力いっぱい抱き締める。",
   "ko_candidate": "가슴 속에서 흐느끼는 알을 나는 온 힘을 다해 꼭 껴안는다｡"
  },
  {
   "id": 49438,
   "key": "ep_al01.txt:1728",
   "file": "ep_al01.txt",
   "line": 1728,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "強く、強く。",
   "ko_candidate": "강하게､ 강하게｡"
  },
  {
   "id": 49439,
   "key": "ep_al01.txt:1729",
   "file": "ep_al01.txt",
   "line": 1729,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "想いの全てを込める勢いで。",
   "ko_candidate": "모든 마음을 담아내듯이｡"
  },
  {
   "id": 49440,
   "key": "ep_al01.txt:1733",
   "file": "ep_al01.txt",
   "line": 1733,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「い、痛いぞ……九郎」",
   "ko_candidate": "「아､ 아파……쿠로」"
  },
  {
   "id": 49441,
   "key": "ep_al01.txt:1737",
   "file": "ep_al01.txt",
   "line": 1737,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「五月蝿い」",
   "ko_candidate": "「시끄러워」"
  },
  {
   "id": 49442,
   "key": "ep_al01.txt:1739",
   "file": "ep_al01.txt",
   "line": 1739,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "抗議の声を上げようが知ったことか。",
   "ko_candidate": "항의의 목소리를 내든 말든 상관없다｡"
  },
  {
   "id": 49443,
   "key": "ep_al01.txt:1740",
   "file": "ep_al01.txt",
   "line": 1740,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶対、容赦なんかしない。",
   "ko_candidate": "절대로 용서하지 않을 거다｡"
  },
  {
   "id": 49444,
   "key": "ep_al01.txt:1741",
   "file": "ep_al01.txt",
   "line": 1741,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あんな酷い裏切りを受けたんだ。",
   "ko_candidate": "그렇게 심한 배신을 당했는데｡"
  },
  {
   "id": 49445,
   "key": "ep_al01.txt:1742",
   "file": "ep_al01.txt",
   "line": 1742,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はもう、こいつを許すつもりはない。",
   "ko_candidate": "나는 이제 이 녀석을 용서할 생각이 없다｡"
  },
  {
   "id": 49446,
   "key": "ep_al01.txt:1746",
   "file": "ep_al01.txt",
   "line": 1746,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから――",
   "ko_candidate": "그러니까――"
  },
  {
   "id": 49447,
   "key": "ep_al01.txt:1751",
   "file": "ep_al01.txt",
   "line": 1751,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「二度と逃がしたりするもんか」",
   "ko_candidate": "「두 번 다시 도망가게 하진 않을 거야」"
  },
  {
   "id": 49448,
   "key": "ep_al01.txt:1753",
   "file": "ep_al01.txt",
   "line": 1753,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうだ。二度と離したりするもんか。",
   "ko_candidate": "그래｡ 두 번 다시 놓아주지 않을 거다｡"
  },
  {
   "id": 49449,
   "key": "ep_al01.txt:1755",
   "file": "ep_al01.txt",
   "line": 1755,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今まで散々人のこと巻き込んで、迷惑かけ通しで、いざとなったら、こっちの気持ちはお構いなしにてめえを犠牲にして、サヨナラしちゃうような薄情な女だ。",
   "ko_candidate": "지금까지 계속 남을 끌어들이고 폐를 끼치다가､ 막상 중요한 순간에는 내 마음 따위는 아랑곳하지 않고 자신을 희생해서 작별해 버리는 무정한 여자다｡"
  },
  {
   "id": 49450,
   "key": "ep_al01.txt:1757",
   "file": "ep_al01.txt",
   "line": 1757,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だったらこっちも遠慮することはない。",
   "ko_candidate": "그렇다면 나도 사양할 이유가 없다｡"
  },
  {
   "id": 49451,
   "key": "ep_al01.txt:1758",
   "file": "ep_al01.txt",
   "line": 1758,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今度はこっちが引っ掻き回してやる番だ。",
   "ko_candidate": "이번에는 내가 휘저어놓을 차례다｡"
  },
  {
   "id": 49452,
   "key": "ep_al01.txt:1760",
   "file": "ep_al01.txt",
   "line": 1760,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どんなにウザがられても、一生纏わりついてやる。",
   "ko_candidate": "아무리 귀찮아해도 평생 달라붙어 있을 거다｡"
  },
  {
   "id": 49453,
   "key": "ep_al01.txt:1761",
   "file": "ep_al01.txt",
   "line": 1761,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こいつを人間の生活に巻き込んで、一緒に人間の時間を生き足掻いてやる。",
   "ko_candidate": "이 녀석을 인간의 생활에 끌어들여서 함께 인간의 시간을 살아가며 발버둥 칠 거다｡"
  },
  {
   "id": 49454,
   "key": "ep_al01.txt:1763",
   "file": "ep_al01.txt",
   "line": 1763,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "共に笑い、共に泣き、共に歩んでやる。",
   "ko_candidate": "함께 웃고､ 함께 울고､ 함께 걸어갈 거다｡"
  },
  {
   "id": 49455,
   "key": "ep_al01.txt:1764",
   "file": "ep_al01.txt",
   "line": 1764,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺達が愛する、この蒼い地球の上で。",
   "ko_candidate": "우리가 사랑하는 이 푸른 지구 위에서｡"
  },
  {
   "id": 49456,
   "key": "ep_al01.txt:1767",
   "file": "ep_al01.txt",
   "line": 1767,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――それが俺、大十字九郎の生涯総てを賭して行う、最大最悪の復讐だ。",
   "ko_candidate": "――그것이 나､ 다이쥬지 쿠로의 일생을 모두 걸고 행하는 최대 최악의 복수다｡"
  },
  {
   "id": 49457,
   "key": "ep_al01.txt:1773",
   "file": "ep_al01.txt",
   "line": 1773,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "抱き合う俺たちは、どちらからともなく、顔を寄せた。",
   "ko_candidate": "서로 껴안은 우리는 누가 먼저랄 것도 없이 얼굴을 가까이 했다｡"
  },
  {
   "id": 49458,
   "key": "ep_al01.txt:1774",
   "file": "ep_al01.txt",
   "line": 1774,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "唇が重なるのを合図に、２人の時間は今、騒がしく動き始めた。",
   "ko_candidate": "입술이 맞닿는 것을 신호로､ 두 사람의 시간이 지금 요란스럽게 움직이기 시작했다｡"
  }
 ]
}