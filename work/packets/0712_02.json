  {
   "id": 9882,
   "key": "D0712al.txt:849",
   "file": "D0712al.txt",
   "line": 849,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "深きものどものざわめきを割って、乾いた拍手が広間に響いた。",
   "ko_candidate": "「자､ 거기서 구경하고 있어」 공주님과 라이카 씨가 서 있는 근처까지 날아갔다｡"
  },
  {
   "id": 9883,
   "key": "D0712al.txt:887",
   "file": "D0712al.txt",
   "line": 887,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「マァァベラス！　素晴らしい！ 流石は大十字九郎君に『アル・アジフ』」",
   "ko_candidate": "목구멍을 맞은 아픔과 등을 돌바닥에 내리꽂힌 아픔에 숨을 쉴 수가 없다｡ 생각보다 데미지가 큰 것 같다｡"
  },
  {
   "id": 9884,
   "key": "D0712al.txt:891",
   "file": "D0712al.txt",
   "line": 891,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「我々『ブラックロッジ』に刃向かおうとするだけはある……失敗作如きではどうにもならんか」",
   "ko_candidate": "그래도 어떻게든 반쯤 일어나 베스파시아누스 쪽으로 눈을 돌린다｡ 「――――!?」"
  },
  {
   "id": 9885,
   "key": "D0712al.txt:896",
   "file": "D0712al.txt",
   "line": 896,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ファンタスティック！ 実に！　実に！ 実にファンタスティックだ！」",
   "ko_candidate": "베스파시아누스의 뒤편､ 제단 위에서 일어나는 괴이에 눈치챘다｡ 무심코 말을 잃고 그것을 올려다본다｡"
  },
  {
   "id": 9886,
   "key": "D0712al.txt:910",
   "file": "D0712al.txt",
   "line": 910,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "奥から２人の男が出てきた。",
   "ko_candidate": "「조각상이……!」 신상에 생명이 깃들었다｡"
  },
  {
   "id": 9888,
   "key": "D0712al.txt:912",
   "file": "D0712al.txt",
   "line": 912,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "１人はインスマウス面のジジイ。",
   "ko_candidate": "균열이 넓어지고 무너져 내린다｡"
  },
  {
   "id": 9890,
   "key": "D0712al.txt:913",
   "file": "D0712al.txt",
   "line": 913,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そしてもう１人――如何にも紳士然といった風情の中年男、こっちが拍手の主だった。",
   "ko_candidate": "조각상 아래에서 나타난 그것은 그 거대한 체구를 담아내지 못해 조각상을 무너뜨리며 점점 비대해져 간다―― 마치 번데기에서 탈피하는 곤충처럼｡"
  },
  {
   "id": 9891,
   "key": "D0712al.txt:916",
   "file": "D0712al.txt",
   "line": 916,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ジジイの方はともかくとして……こっちの紳士野郎から発せられる威圧感。只者ではない。",
   "ko_candidate": "얼굴 부분이 무너져 내리고 그 아래에서 사악한 빛을 머금은 눈동자가 나타났다｡ 탁한 색의 눈동자가 휘둥그레 주위를 노려본다……!"
  },
  {
   "id": 9892,
   "key": "D0712al.txt:919",
   "file": "D0712al.txt",
   "line": 919,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "紳士は手を胸に添え、仰々しく頭を垂れた。",
   "ko_candidate": "「～～～～～～～～～～!」 구토를 유발하는 오한이 달려 내려갔다｡"
  },
  {
   "id": 9893,
   "key": "D0712al.txt:928",
   "file": "D0712al.txt",
   "line": 928,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ、すまない。自己紹介がまだだった」",
   "ko_candidate": "그건 다른 모두도 마찬가지였을 것이다｡ 모두 떨리는 몸을 필사적으로 참으려 하고 있었다｡"
  },
  {
   "id": 9894,
   "key": "D0712al.txt:932",
   "file": "D0712al.txt",
   "line": 932,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お初にお目にかかる。私の名前はウェスパシアヌス。『ブラックロッジ』が導師アンチクロスの１人だ。今後ともよろしくお願いするよ」",
   "ko_candidate": "내 귓가에서 알이 혀를 찬다｡ 「치……다곤이잖아! 골치 아픈 게 나타났군……!」"
  },
  {
   "id": 9895,
   "key": "D0712al.txt:941",
   "file": "D0712al.txt",
   "line": 941,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ！？」",
   "ko_candidate": "「다､ 다곤?」"
  },
  {
   "id": 9897,
   "key": "D0712al.txt:946",
   "file": "D0712al.txt",
   "line": 946,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アンチクロス……ッ！」",
   "ko_candidate": "「신이라기보다는 저건 괴수예요!」"
  },
  {
   "id": 9898,
   "key": "D0712al.txt:951",
   "file": "D0712al.txt",
   "line": 951,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "また……！",
   "ko_candidate": "적절한 말이었다｡ 「――――――!」"
  },
  {
   "id": 9899,
   "key": "D0712al.txt:952",
   "file": "D0712al.txt",
   "line": 952,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "また、アンチクロスなのか！",
   "ko_candidate": "「크……! 으으으!」 「으아아아아!」"
  },
  {
   "id": 9900,
   "key": "D0712al.txt:955",
   "file": "D0712al.txt",
   "line": 955,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この前に引き続きこれで３人目……奴らの動きが活発になっているのか？",
   "ko_candidate": "「아､ 아가씨……!」 다곤의 포효가 신전 전체를 격진시켰다｡"
  },
  {
   "id": 9901,
   "key": "D0712al.txt:962",
   "file": "D0712al.txt",
   "line": 962,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「マスターテリオンの懐刀であるアンチクロスが、何故に『深きものども』なんぞと戯れておる？　何が目的だ！？」",
   "ko_candidate": "원초의 본능이 흔들리고 공포와 혼란이 마음을 찢어놓는다｡ 베스파시아누스 곁에 서 있는 노인이 환희에 떨고 있었다｡"
  },
  {
   "id": 9902,
   "key": "D0712al.txt:971",
   "file": "D0712al.txt",
   "line": 971,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なに。ちょっとした実験とでも答えておくかね。なになに。これでこうして彼らもなかなかに役立ってくれたよ。あとは成果を見るだけだ」",
   "ko_candidate": "「오오오오오! 우리의 신 다곤! 이제 다시 우리의 바다를 되찾을 수 있겠구나! 쿠스후……르이에! 이야! 이야! 자 우리의 신이여! 이 땅에 사는 육지의 인간들에게 어서 심판을!」 「젠장……저놈들!」"
  },
  {
   "id": 9903,
   "key": "D0712al.txt:977",
   "file": "D0712al.txt",
   "line": 977,
   "speaker": "長老",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何ダト……？」",
   "ko_candidate": "「잠깐……뭔가 이상하지 않아?」 「엣?」"
  },
  {
   "id": 9906,
   "key": "D0712al.txt:983",
   "file": "D0712al.txt",
   "line": 983,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
