  {
   "id": 9880,
   "key": "D0712al.txt:837",
   "file": "D0712al.txt",
   "line": 837,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何です！？」",
   "ko_candidate": "「쿠로 짱! 꺄악!」"
  },
  {
   "id": 9881,
   "key": "D0712al.txt:843",
   "file": "D0712al.txt",
   "line": 843,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「っっっっ！」",
   "ko_candidate": "「구와아아아! 크……!」"
