 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "アル": "알",
  "クラウディウス": "클라우디우스",
  "魔力": "마력",
  "マギウス・ウィング": "마기우스 윙"
 },
 "items": [
  {
   "id": 14541,
   "key": "D0809al.txt:1068",
   "file": "D0809al.txt",
   "line": 1068,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……想像以上に迅えぞ、あいつ！",
   "ko_candidate": "젠장… 상상 이상으로 빠르잖아､ 저놈!"
  },
  {
   "id": 14542,
   "key": "D0809al.txt:1070",
   "file": "D0809al.txt",
   "line": 1070,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背中が灼けるように痛い。",
   "ko_candidate": "등이 타는 듯이 아프다｡"
  },
  {
   "id": 14543,
   "key": "D0809al.txt:1071",
   "file": "D0809al.txt",
   "line": 1071,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滴る血が足下に水溜まりを作っていた。",
   "ko_candidate": "떨어지는 피가 발밑에 물웅덩이를 만들고 있었다｡"
  },
  {
   "id": 14544,
   "key": "D0809al.txt:1076",
   "file": "D0809al.txt",
   "line": 1076,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎……！」",
   "ko_candidate": "「쿠로…!」"
  },
  {
   "id": 14545,
   "key": "D0809al.txt:1080",
   "file": "D0809al.txt",
   "line": 1080,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大丈夫さ、傷は浅い……問題はこっちだ」",
   "ko_candidate": "「괜찮아､ 상처는 얕아… 문제는 이쪽이야」"
  },
  {
   "id": 14546,
   "key": "D0809al.txt:1082",
   "file": "D0809al.txt",
   "line": 1082,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "折れた偃月刀を、ブラブラと振り回す。",
   "ko_candidate": "부러진 언월도를 흔들흔들 휘두른다｡"
  },
  {
   "id": 14547,
   "key": "D0809al.txt:1083",
   "file": "D0809al.txt",
   "line": 1083,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは首を横に振って、溜め息をついた。",
   "ko_candidate": "알은 고개를 가로저으며 한숨을 쉬었다｡"
  },
  {
   "id": 14548,
   "key": "D0809al.txt:1087",
   "file": "D0809al.txt",
   "line": 1087,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……諦めろ。創り直すにしても、時間が掛かる」",
   "ko_candidate": "「…포기해｡ 다시 만들려고 해도 시간이 걸려」"
  },
  {
   "id": 14549,
   "key": "D0809al.txt:1091",
   "file": "D0809al.txt",
   "line": 1091,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そーかい」",
   "ko_candidate": "「그래」"
  },
  {
   "id": 14550,
   "key": "D0809al.txt:1099",
   "file": "D0809al.txt",
   "line": 1099,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "未練を持っていても、しょうがない。",
   "ko_candidate": "미련을 가져봤자 소용없다｡"
  },
  {
   "id": 14551,
   "key": "D0809al.txt:1100",
   "file": "D0809al.txt",
   "line": 1100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はあっさり偃月刀を投げ捨て、身構える。",
   "ko_candidate": "나는 싱겁게 언월도를 던져버리고 자세를 잡는다｡"
  },
  {
   "id": 14552,
   "key": "D0809al.txt:1105",
   "file": "D0809al.txt",
   "line": 1105,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから偃月刀は剣としてだけではなく魔術の媒介としてだな……ぬぅぅ、まったく。粗末に扱いおって」",
   "ko_candidate": "「그래서 언월도는 검으로서뿐만 아니라 마술의 매개체로서… 으음､ 정말｡ 함부로 다루다니｡ …너､ 아직도 싸울 생각이냐? 솔직히 상당히 불리하다고――」"
  },
  {
   "id": 14553,
   "key": "D0809al.txt:1109",
   "file": "D0809al.txt",
   "line": 1109,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……汝、まだ戦うつもりなのか？　正直、かなり不利だぞ――」",
   "ko_candidate": "「싸울 수밖에 없잖아｡ 그냥 둘 수는 없고､ 게다가…」 슬쩍 주위를 둘러본다｡"
  },
  {
   "id": 14554,
   "key": "D0809al.txt:1115",
   "file": "D0809al.txt",
   "line": 1115,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「戦うに決まってんだろ。捨て置くワケにはいかねえし、それに……」",
   "ko_candidate": "…잘려나가고､ 부서져 버린 사람들의 시체｡ 가슴이 타는 듯하다｡"
  },
  {
   "id": 14555,
   "key": "D0809al.txt:1118",
   "file": "D0809al.txt",
   "line": 1118,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちらりと周囲を見渡す。",
   "ko_candidate": "구역질이 난다｡"
  },
  {
   "id": 14556,
   "key": "D0809al.txt:1135",
   "file": "D0809al.txt",
   "line": 1135,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "胸焼けがする。吐き気がする。心臓が送り出す血が熱い。脳の神経が灼け切れるほどに痛い。",
   "ko_candidate": "심장이 내보내는 피가 뜨겁다｡ 뇌의 신경이 타버릴 정도로 아프다｡"
  },
  {
   "id": 14557,
   "key": "D0809al.txt:1143",
   "file": "D0809al.txt",
   "line": 1143,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「許せるか…… 許しておけるかよ、あんな下衆野郎ども！」",
   "ko_candidate": "「용서할 수 있겠어… 용서해줄 수 있겠냐고､ 저런 쓰레기 자식들을!」"
  },
  {
   "id": 14558,
   "key": "D0809al.txt:1148",
   "file": "D0809al.txt",
   "line": 1148,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――吠えてろよ、負け犬っ！」",
   "ko_candidate": "「――짖어대라､ 패배자!」"
  },
  {
   "id": 14559,
   "key": "D0809al.txt:1152",
   "file": "D0809al.txt",
   "line": 1152,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「疾――ッ！」",
   "ko_candidate": "「윽――!」 날아오는 진공 칼날｡"
  },
  {
   "id": 14560,
   "key": "D0809al.txt:1162",
   "file": "D0809al.txt",
   "line": 1162,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "放たれる真空刃。思いっきり身を屈め地を這うようにして俺は疾走る。拳に魔力を込めクラウディウスのボディを目がけて……！",
   "ko_candidate": "있는 힘껏 몸을 숙이고､ 땅을 기듯이 해서 나는 질주한다｡ 주먹에 마력을 담아 클라우디우스의 몸을 향해…!"
  },
  {
   "id": 14561,
   "key": "D0809al.txt:1166",
   "file": "D0809al.txt",
   "line": 1166,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「つ……ぅぅっ!?」",
   "ko_candidate": "「크…윽!?」"
  },
  {
   "id": 14562,
   "key": "D0809al.txt:1171",
   "file": "D0809al.txt",
   "line": 1171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの身体に触れる手前、拳に無数の裂傷が生じ血を噴き出した。慌てて、拳を引っ込める。",
   "ko_candidate": "클라우디우스의 몸에 닿기 직전､ 주먹에 여러 겹의 열상이 생기고 피를 뿜어냈다｡ 황급히 주먹을 거둔다｡"
  },
  {
   "id": 14563,
   "key": "D0809al.txt:1177",
   "file": "D0809al.txt",
   "line": 1177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの周囲を、風が取り囲んでいる。",
   "ko_candidate": "클라우디우스의 주위를 바람이 둘러싸고 있다｡"
  },
  {
   "id": 14564,
   "key": "D0809al.txt:1178",
   "file": "D0809al.txt",
   "line": 1178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の防御陣!?",
   "ko_candidate": "바람의 방어진!?"
  },
  {
   "id": 14565,
   "key": "D0809al.txt:1187",
   "file": "D0809al.txt",
   "line": 1187,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「野郎っ！」",
   "ko_candidate": "「이 자식!」"
  },
  {
   "id": 14566,
   "key": "D0809al.txt:1190",
   "file": "D0809al.txt",
   "line": 1190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・ウィングを槍状に変形させ、クラウディウスを突く。",
   "ko_candidate": "마기우스 윙을 창 모양으로 변형시켜 클라우디우스를 찌른다｡"
  },
  {
   "id": 14567,
   "key": "D0809al.txt:1191",
   "file": "D0809al.txt",
   "line": 1191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の結界がさらに強固なものとなった。",
   "ko_candidate": "바람의 결계가 더욱 강고해졌다｡"
  },
  {
   "id": 14568,
   "key": "D0809al.txt:1196",
   "file": "D0809al.txt",
   "line": 1196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "槍は無数のカマイタチに切り刻まれ、シュレッダーにかけられたような紙片が、周囲に舞い散る。",
   "ko_candidate": "창은 무수한 카마이타치에 의해 잘게 잘려 파쇄기에 걸린 것 같은 종이 조각이 주위에 흩날린다｡"
  },
  {
   "id": 14569,
   "key": "D0809al.txt:1201",
   "file": "D0809al.txt",
   "line": 1201,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「へっ！　ボケやがって！　ラリってんじゃねえよ！」",
   "ko_candidate": "「헷! 바보 같은 놈! 정신 나간 거 아냐!」"
  },
  {
   "id": 14570,
   "key": "D0809al.txt:1205",
   "file": "D0809al.txt",
   "line": 1205,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝がな」",
   "ko_candidate": "「네가 말이다」"
  },
  {
   "id": 14571,
   "key": "D0809al.txt:1209",
   "file": "D0809al.txt",
   "line": 1209,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 14572,
   "key": "D0809al.txt:1220",
   "file": "D0809al.txt",
   "line": 1220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "細切れの紙屑が、風の結界に乗って舞う。",
   "ko_candidate": "잘게 찢어진 종이 조각이 바람의 결계에 실려 춤춘다｡"
  },
  {
   "id": 14573,
   "key": "D0809al.txt:1221",
   "file": "D0809al.txt",
   "line": 1221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の、夥しいまでの紙紙紙紙紙――！",
   "ko_candidate": "무수한､ 엄청난 양의､ 종이｡ 종이｡ 종이｡"
  },
  {
   "id": 14575,
   "key": "D0809al.txt:1222",
   "file": "D0809al.txt",
   "line": 1222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬のうちにクラウディウスを囲う風の結界を埋め尽くした。",
   "ko_candidate": "순식간에､ 클라우디우스를 둘러싼 바람의 결계를 가득 메웠다｡"
  },
  {
   "id": 14576,
   "key": "D0809al.txt:1227",
   "file": "D0809al.txt",
   "line": 1227,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわあああっ!?」",
   "ko_candidate": "「우와아아아!?」"
  },
  {
   "id": 14577,
   "key": "D0809al.txt:1231",
   "file": "D0809al.txt",
   "line": 1231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紙吹雪に視界を遮られ、クラウディウスはわずかに怯んだ。",
   "ko_candidate": "종이 폭풍에 시야를 가려､ 클라우디우스는 잠시 주춤했다｡"
  },
  {
   "id": 14578,
   "key": "D0809al.txt:1232",
   "file": "D0809al.txt",
   "line": 1232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の結界を、わずかに緩めてしまう。",
   "ko_candidate": "바람의 결계를､ 약간 느슨하게 해버린다｡"
  },
  {
   "id": 14579,
   "key": "D0809al.txt:1233",
   "file": "D0809al.txt",
   "line": 1233,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "つまりは――それが隙だった。",
   "ko_candidate": "즉､ 그것이 틈이었다｡"
  },
  {
   "id": 14580,
   "key": "D0809al.txt:1237",
   "file": "D0809al.txt",
   "line": 1237,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しゃあああああああ！」",
   "ko_candidate": "「샤아아아아아아!」"
  },
  {
   "id": 14581,
   "key": "D0809al.txt:1242",
   "file": "D0809al.txt",
   "line": 1242,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  }
 ]
}