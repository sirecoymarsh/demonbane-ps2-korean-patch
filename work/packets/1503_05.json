{
 "packet": "1503_05",
 "scene": "1503",
 "anchor": {
  "hit": 26,
  "total": 28,
  "rate": 0.929
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "九郎": "쿠로",
  "リューガ": "류가",
  "ネクロノミコン": "네크로노미콘"
 },
 "items": [
  {
   "id": 42011,
   "key": "D1503le.txt:289",
   "file": "D1503le.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "消えて、融合する。",
   "ko_candidate": "사라져 융합한다｡"
  },
  {
   "id": 42012,
   "key": "D1503le.txt:291",
   "file": "D1503le.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただ、それだけ。それだけのこと――",
   "ko_candidate": "단지 그뿐｡ 그뿐인 것――"
  },
  {
   "id": 42013,
   "key": "D1503le.txt:295",
   "file": "D1503le.txt",
   "line": 295,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――ライカさんっ！",
   "ko_candidate": "――라이카 씨!"
  },
  {
   "id": 42014,
   "key": "D1503le.txt:298",
   "file": "D1503le.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その無限をも超えて、届く聲が在る。",
   "ko_candidate": "그 무한을 넘어 닿는 목소리가 있다｡"
  },
  {
   "id": 42015,
   "key": "D1503le.txt:300",
   "file": "D1503le.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは小さな……世界の濁流に簡単に呑み込まれ、砕け散ってしまいそうな程に、ちっぽけな聲に過ぎない。",
   "ko_candidate": "그것은 작은… 세계의 탁류에 쉽게 삼켜져 산산조각 날 것 같을 정도로 작은 목소리에 불과하다｡"
  },
  {
   "id": 42016,
   "key": "D1503le.txt:302",
   "file": "D1503le.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな儚い聲が、圧倒的な絶望を裂いて、私の魂に強く響く。",
   "ko_candidate": "그런 덧없는 목소리가 압도적인 절망을 가르고 내 영혼에 강하게 울린다｡"
  },
  {
   "id": 42017,
   "key": "D1503le.txt:303",
   "file": "D1503le.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大事な何かを、力の限り訴えかける。",
   "ko_candidate": "소중한 무언가를 온 힘을 다해 호소한다｡"
  },
  {
   "id": 42018,
   "key": "D1503le.txt:304",
   "file": "D1503le.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私の存在を訴えかける。",
   "ko_candidate": "내 존재를 호소한다｡"
  },
  {
   "id": 42019,
   "key": "D1503le.txt:306",
   "file": "D1503le.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私は、砕けた意識の破片を拾い集める。",
   "ko_candidate": "나는 산산조각 난 의식의 파편을 주워 모은다｡"
  },
  {
   "id": 42020,
   "key": "D1503le.txt:307",
   "file": "D1503le.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "懐かしい、あの聲の許を確かめる為に。",
   "ko_candidate": "그리운 그 목소리의 곁을 확인하기 위해｡"
  },
  {
   "id": 42021,
   "key": "D1503le.txt:308",
   "file": "D1503le.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其処に多分、私が私である為の、大切なものが在る。",
   "ko_candidate": "거기에 아마도 내가 나이기 위한 소중한 것이 있다｡"
  },
  {
   "id": 42022,
   "key": "D1503le.txt:310",
   "file": "D1503le.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "甦る意識が、一つの映像を作り上げる。",
   "ko_candidate": "되살아나는 의식이 하나의 영상을 만들어낸다｡"
  },
  {
   "id": 42023,
   "key": "D1503le.txt:311",
   "file": "D1503le.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それはまだ夢の様に儚くて……まだ私の手から遠い場所に在って……だけど、確かな現実との接点。",
   "ko_candidate": "그것은 아직 꿈처럼 덧없고… 아직 내 손에서 먼 곳에 있고 …하지만 확실한 현실과의 접점｡"
  },
  {
   "id": 42024,
   "key": "D1503le.txt:313",
   "file": "D1503le.txt",
   "line": 313,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手を伸ばす。",
   "ko_candidate": "손을 뻗는다｡"
  },
  {
   "id": 42025,
   "key": "D1503le.txt:314",
   "file": "D1503le.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処までも、手を伸ばす。",
   "ko_candidate": "어디까지나 손을 뻗는다｡"
  },
  {
   "id": 42026,
   "key": "D1503le.txt:315",
   "file": "D1503le.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの場所に届けと。",
   "ko_candidate": "저 곳에 닿기를｡"
  },
  {
   "id": 42027,
   "key": "D1503le.txt:325",
   "file": "D1503le.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、そのとき、私は視た。",
   "ko_candidate": "하지만 그때 나는 보았다｡"
  },
  {
   "id": 42028,
   "key": "D1503le.txt:327",
   "file": "D1503le.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夢の様に霞む現実の向こう――無意識から這いずり出ようと足掻く意識を嘲笑う様に――私が握る光の刃が――私を抱き締める誰かを、大切な誰かを――それが誰だか判らないのがもどかしくて――",
   "ko_candidate": "꿈처럼 아른거리는 현실 너머――무의식에서 기어 나오려고 발버둥치는 의식을 조롱하듯이――내가 쥐고 있는 빛의 칼이――나를 껴안고 있는 누군가를､ 소중한 누군가를――그게 누구인지 알 수 없는 것이 안타까워서――"
  },
  {
   "id": 42029,
   "key": "D1503le.txt:328",
   "file": "D1503le.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦しくて――嗚呼――刃が――彼を――貫いて――",
   "ko_candidate": "괴로워서――아아――칼이――그를――꿰뚫고――"
  },
  {
   "id": 42030,
   "key": "D1503le.txt:342",
   "file": "D1503le.txt",
   "line": 342,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ら、ライカさん……？　な、んで……？」",
   "ko_candidate": "「라､ 라이카 씨…? 왜､ 죠…?」"
  },
  {
   "id": 42031,
   "key": "D1503le.txt:345",
   "file": "D1503le.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腹が、灼けるように熱い。",
   "ko_candidate": "배가 타는 듯이 뜨겁다｡"
  },
  {
   "id": 42032,
   "key": "D1503le.txt:346",
   "file": "D1503le.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "と言うより、実際、灼けていた。",
   "ko_candidate": "라기보다는 실제로 타고 있었다｡"
  },
  {
   "id": 42033,
   "key": "D1503le.txt:347",
   "file": "D1503le.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉の焦げる、不快な臭いが、鼻腔をくすぐる。",
   "ko_candidate": "살이 타는 불쾌한 냄새가 코를 자극한다｡"
  },
  {
   "id": 42034,
   "key": "D1503le.txt:352",
   "file": "D1503le.txt",
   "line": 352,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うぶぐ……っ！」",
   "ko_candidate": "「우부구…!」"
  },
  {
   "id": 42035,
   "key": "D1503le.txt:355",
   "file": "D1503le.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼熱する塊が、咽喉まで込み上げてきた。",
   "ko_candidate": "작열하는 덩어리가 목구멍까지 치밀어 올랐다｡"
  },
  {
   "id": 42036,
   "key": "D1503le.txt:356",
   "file": "D1503le.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鉄の味が口の中に充満した。",
   "ko_candidate": "쇠 맛이 입안에 가득 찼다｡"
  },
  {
   "id": 42037,
   "key": "D1503le.txt:358",
   "file": "D1503le.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは……マズイだろ。",
   "ko_candidate": "이건… 큰일이겠지｡"
  },
  {
   "id": 42038,
   "key": "D1503le.txt:359",
   "file": "D1503le.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "堪え切れず、吐き出す。",
   "ko_candidate": "참지 못하고 토해낸다｡"
  },
  {
   "id": 42039,
   "key": "D1503le.txt:362",
   "file": "D1503le.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の固まりが、ライカさんの白い顔に降り注いだ。",
   "ko_candidate": "핏덩이가 라이카 씨의 하얀 얼굴에 쏟아졌다｡"
  },
  {
   "id": 42040,
   "key": "D1503le.txt:363",
   "file": "D1503le.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ああ……悪ぃ。汚しちまった。",
   "ko_candidate": "아아… 미안｡ 더럽혀 버렸어｡"
  },
  {
   "id": 42041,
   "key": "D1503le.txt:367",
   "file": "D1503le.txt",
   "line": 367,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「つっ！　九郎――――――ッ！」",
   "ko_candidate": "「큿! 쿠로――――――!」"
  },
  {
   "id": 42042,
   "key": "D1503le.txt:371",
   "file": "D1503le.txt",
   "line": 371,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あはっ……は、は。操られているのが……リューガだけだと思った？」 「本当に……っ……夢中になると……何も、見えなく、なるのですね……マスター・オブ・ザ・ネクロノミコン」",
   "ko_candidate": "「아핫… 하､ 하｡ 조종당하고 있는 게… 류가뿐이라고 생각했어? 정말… 열중하면… 아무것도､ 보이지 않게､ 되는군요… 마스터 오브 더 네크로노미콘」"
  },
  {
   "id": 42043,
   "key": "D1503le.txt:381",
   "file": "D1503le.txt",
   "line": 381,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐっ……ああああ！」",
   "ko_candidate": "「크… 아아아아!」"
  },
  {
   "id": 42044,
   "key": "D1503le.txt:384",
   "file": "D1503le.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腹に突き刺さったビームセイバーが引き抜かれた。",
   "ko_candidate": "배에 꽂힌 빔 세이버가 뽑혔다｡"
  },
  {
   "id": 42045,
   "key": "D1503le.txt:386",
   "file": "D1503le.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焼け爛れた傷口からは、血は噴き出ない。",
   "ko_candidate": "불에 타 문드러진 상처에서는 피가 솟구치지 않는다｡"
  },
  {
   "id": 42046,
   "key": "D1503le.txt:387",
   "file": "D1503le.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが身体に穿たれた穴は酷く熱いくせに、おぞましいくらいに冷たくて、寒い。",
   "ko_candidate": "하지만 몸에 뚫린 구멍은 몹시 뜨거우면서도 섬뜩할 정도로"
  },
  {
   "id": 42047,
   "key": "D1503le.txt:391",
   "file": "D1503le.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "意識が、眩んだ。身体のバランスを失い、仰向けに倒れた。",
   "ko_candidate": "차갑고 춥다｡ 의식이 아찔해졌다｡ 몸의 균형을 잃고 뒤로 넘어졌다｡"
  },
  {
   "id": 42048,
   "key": "D1503le.txt:393",
   "file": "D1503le.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇に閉ざされていく視界が、起き上がるライカさんを捉えていた――",
   "ko_candidate": "어둠에 닫혀가는 시야가 일어서는 라이카 씨를 포착했다――"
  },
  {
   "id": 42049,
   "key": "D1503le.txt:404",
   "file": "D1503le.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を吐き、斃れる彼の姿。",
   "ko_candidate": "피를 토하고 쓰러지는 그의 모습｡"
  },
  {
   "id": 42050,
   "key": "D1503le.txt:406",
   "file": "D1503le.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "驚愕に見開かれた瞳が、哀しみに霞む瞳の光が、私の心を酷く揺さぶった。",
   "ko_candidate": "경악으로 크게 뜬 눈동자가､ 슬픔에 흐려지는 눈동자의 빛이､ 내 마음을 몹시 흔들었다｡"
  }
 ]
}