  },
  {
   "id": 23171,
   "key": "D1103ru.txt:161",
   "file": "D1103ru.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術師としての素質。",
   "ko_candidate": "마술사로서의 소질｡"
  },
  {
   "id": 23172,
   "key": "D1103ru.txt:162",
   "file": "D1103ru.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけではない。",
   "ko_candidate": "그뿐만이 아니다｡"
