 "items": [
  {
   "id": 17069,
   "key": "D0817le.txt:228",
   "file": "D0817le.txt",
   "line": 228,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「吹き飛んじゃったよ」",
   "ko_candidate": "「날아가 버렸어｡ 이 손처럼」"
  },
  {
   "id": 17070,
   "key": "D0817le.txt:236",
   "file": "D0817le.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――――――何？",
   "ko_candidate": "――――――뭐?"
  },
  {
   "id": 17071,
   "key": "D0817le.txt:241",
   "file": "D0817le.txt",
   "line": 241,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「バラバラに砕けちゃったんじゃないかな？ あれだけの爆発だもの。普通は死ぬっしょ？」",
   "ko_candidate": "「산산조각 났을지도 모르지? 저 정도의 폭발이었으니까｡ 보통은 죽겠지?」"
  },
  {
   "id": 17072,
   "key": "D0817le.txt:246",
   "file": "D0817le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――――――ライカさんが？　死ぬ？　馬鹿な。",
   "ko_candidate": "――――――라이카 씨가? 죽는다고? 말도 안 돼｡"
  },
  {
   "id": 17073,
   "key": "D0817le.txt:251",
   "file": "D0817le.txt",
   "line": 251,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「く、九郎！　耳を傾けるな！　敵の手に乗るな！」",
   "ko_candidate": "「쿠､ 쿠로! 귀 기울이지 마! 적의 수에 놀아나지 마!」"
  },
  {
   "id": 17074,
   "key": "D0817le.txt:255",
   "file": "D0817le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの言葉も届かない。",
   "ko_candidate": "알의 말도 닿지 않는다｡"
  },
  {
   "id": 17075,
   "key": "D0817le.txt:256",
   "file": "D0817le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "脊椎を凍らされたかのように、躰が冷たい。",
   "ko_candidate": "척추가 얼어붙은 것처럼､ 몸이 차갑다｡"
  },
  {
   "id": 17076,
   "key": "D0817le.txt:257",
   "file": "D0817le.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そんな俺を『暴君』は――",
   "ko_candidate": "그런 나를 『폭군』은――"
  },
  {
   "id": 17077,
   "key": "D0817le.txt:262",
   "file": "D0817le.txt",
   "line": 262,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ははっ……可哀想な子だね、九郎は」",
   "ko_candidate": "「하하…… 불쌍한 아이구나､ 쿠로는」"
  },
  {
   "id": 17078,
   "key": "D0817le.txt:266",
   "file": "D0817le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "本当に愉しそうに――",
   "ko_candidate": "정말로 즐거운 듯이――"
  },
  {
   "id": 17079,
   "key": "D0817le.txt:271",
   "file": "D0817le.txt",
   "line": 271,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎、君は……」",
   "ko_candidate": "「쿠로､ 너는……」"
  },
  {
   "id": 17080,
   "key": "D0817le.txt:275",
   "file": "D0817le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "心底、愉しそうに――",
   "ko_candidate": "진심으로､ 즐거운 듯이――"
  },
  {
   "id": 17081,
   "key": "D0817le.txt:280",
   "file": "D0817le.txt",
   "line": 280,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「大切な女ひとり、護れやしない」",
   "ko_candidate": "「소중한 여자 하나､ 지키지 못해」"
  },
  {
   "id": 17082,
   "key": "D0817le.txt:284",
   "file": "D0817le.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――嗤った。亀裂のような笑みで。",
   "ko_candidate": "――비웃었다｡ 균열 같은 웃음으로｡"
  },
  {
   "id": 17083,
   "key": "D0817le.txt:285",
   "file": "D0817le.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "マスターテリオンと同じ、あの微笑で。",
   "ko_candidate": "마스터 테리온과 같은､ 그 미소로｡"
  },
  {
   "id": 17084,
   "key": "D0817le.txt:290",
   "file": "D0817le.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――滅ぼしてやる。",
   "ko_candidate": "――멸망시켜 주마｡"
  },
  {
   "id": 17085,
   "key": "D0817le.txt:297",
   "file": "D0817le.txt",
   "line": 297,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「？」",
   "ko_candidate": "「?」"
  },
  {
   "id": 17086,
   "key": "D0817le.txt:304",
   "file": "D0817le.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインの右手。光が迸った。爆裂した。",
   "ko_candidate": "데몬베인의 오른손｡ 빛이 솟구쳤다｡ 폭발했다｡"
  },
  {
   "id": 17087,
   "key": "D0817le.txt:307",
   "file": "D0817le.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "放電する光の中央に、あの焔の獣が顕現する。",
   "ko_candidate": "방전하는 빛의 중앙에､ 그 염의 짐승이 현현한다｡"
  },
  {
   "id": 17088,
   "key": "D0817le.txt:308",
   "file": "D0817le.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クトゥグア招喚。",
   "ko_candidate": "크투가 소환｡"
  },
  {
   "id": 17089,
   "key": "D0817le.txt:311",
   "file": "D0817le.txt",
   "line": 311,
   "speaker": "アル",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "街が、焔えて、熔ける。 「莫迦！　二度も……」",
   "ko_candidate": "거리가､ 불타오르고､{SE_VOL(1,1000,0);}녹는다｡"
  },
  {
   "id": 17090,
   "key": "D0817le.txt:325",
   "file": "D0817le.txt",
   "line": 325,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「またクトゥグアかい？　今の九郎には無理だって……――!?」",
   "ko_candidate": "「바보! 두 번이나……」 「또 크투가인가? 지금의 쿠로로는 무리라고…… ――!?」"
  },
  {
   "id": 17091,
   "key": "D0817le.txt:340",
   "file": "D0817le.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインの左手。数多の光が瞬いた。凝結した。",
   "ko_candidate": "데몬베인의 왼손｡ 수많은 빛이 반짝였다｡ 응결했다｡"
  },
  {
   "id": 17092,
   "key": "D0817le.txt:345",
   "file": "D0817le.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "結晶した光の中央に――神獣が顕現する。",
   "ko_candidate": "결정화된 빛의 중앙에―― 신수가 현현한다｡"
  },
  {
   "id": 17093,
   "key": "D0817le.txt:347",
   "file": "D0817le.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今まで一度も喚んだことのない神獣が。",
   "ko_candidate": "지금까지 한 번도 부른 적 없는 신수가｡"
  },
  {
   "id": 17094,
   "key": "D0817le.txt:349",
   "file": "D0817le.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "クトゥグアを焔の獣に喩えるなら、こっちは氷の竜と言ったところか。",
   "ko_candidate": "크투가를 염의 짐승에 비유한다면､ 이쪽은 얼음의 용이라고 할까｡"
  },
  {
   "id": 17095,
   "key": "D0817le.txt:357",
   "file": "D0817le.txt",
   "line": 357,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……これはイタクァ!?」 「莫迦な！　一度に２つの神の力を招喚するだと！」",
   "ko_candidate": "「뭐……이건 이타콰!? 말도 안 돼! 한 번에 2개의 신의 힘을 소환한다고! 무모하기 짝이 없어…… 흔적도 없이 날아가 버릴 거야! 그만둬､ 쿠로!」"
  },
  {
   "id": 17096,
   "key": "D0817le.txt:363",
   "file": "D0817le.txt",
   "line": 363,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「無茶どころではない……跡形も無く消し飛ぶぞ！ 止めろ、九郎！」",
   "ko_candidate": "모르고 불러내 버렸지만､ 이타콰라고 부르는 모양이다｡ 알겠다｡ 이해했다｡"
  },
  {
   "id": 17097,
   "key": "D0817le.txt:374",
   "file": "D0817le.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "街が凍り、砕ける。",
   "ko_candidate": "이타콰 소환｡"
  },
  {
   "id": 17098,
   "key": "D0817le.txt:376",
   "file": "D0817le.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "神獣たちの放つ魔力は、絡まり合い、反発し合い、世界を激震させる。",
   "ko_candidate": "거리가 얼어붙고､ 부서진다｡ 신수들이 내뿜는 마력은､ 얽히고､ 반발하며､ 세계를 격진시킨다｡"
  },
  {
   "id": 17099,
   "key": "D0817le.txt:378",
   "file": "D0817le.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空間には紫電が迸り……いや、ここまで来るとほとんど落雷だ。",
   "ko_candidate": "공간에는 자색 번개가 튀고…… 아니､ 여기까지 오면 거의 낙뢰다｡"
  },
  {
   "id": 17100,
   "key": "D0817le.txt:380",
   "file": "D0817le.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さらに空間が何度も砕け、爆音を響かせる。",
   "ko_candidate": "게다가 공간이 몇 번이고 부서지며､ 폭음을 울린다｡"
  },
  {
   "id": 17101,
   "key": "D0817le.txt:385",
   "file": "D0817le.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインも無事じゃない。",
   "ko_candidate": "데몬베인도 무사하지 않다｡"
  },
  {
   "id": 17102,
   "key": "D0817le.txt:387",
   "file": "D0817le.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "右半身は熔けかけ、左半身は凍りつく。",
   "ko_candidate": "오른쪽 반신은 녹아내리고､ 왼쪽 반신은 얼어붙는다｡"
  },
  {
   "id": 17103,
   "key": "D0817le.txt:389",
   "file": "D0817le.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鬩ぎ合い、交じり合う魔力が、デモンベインを少しずつ押し潰す。",
   "ko_candidate": "다투고､ 뒤섞이는 마력이､ 데몬베인을 조금씩 짓눌러 간다｡"
  },
  {
   "id": 17104,
   "key": "D0817le.txt:391",
   "file": "D0817le.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "状態異常を告げるアラームが点滅し、コクピット内部を紅く染めていた。",
   "ko_candidate": "상태 이상을 알리는 알람이 점멸하며､ 콕핏 내부를 붉게 물들이고 있었다｡"
  },
  {
   "id": 17105,
   "key": "D0817le.txt:393",
   "file": "D0817le.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それでも俺は止まらない。",
   "ko_candidate": "그래도 나는 멈추지 않는다｡"
  },
  {
   "id": 17106,
   "key": "D0817le.txt:394",
   "file": "D0817le.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだだ。",
   "ko_candidate": "아직이다｡"
  },
  {
   "id": 17107,
   "key": "D0817le.txt:395",
   "file": "D0817le.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだまだだ！",
   "ko_candidate": "아직 아직이다!"
  },
  {
   "id": 17108,
   "key": "D0817le.txt:400",
   "file": "D0817le.txt",
   "line": 400,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「無茶するね……。良いよ、どこまで無茶できるか見届けてあげよう」",
   "ko_candidate": "「무모하구나……｡ 좋아､ 어디까지 무모할 수 있는지 지켜봐 주지」"
  }
 ]
}