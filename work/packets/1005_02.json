 "items": [
  {
   "id": 21430,
   "key": "D1005le.txt:345",
   "file": "D1005le.txt",
   "line": 345,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――ッ！」",
   "ko_candidate": "「――읏!」"
  },
  {
   "id": 21431,
   "key": "D1005le.txt:349",
   "file": "D1005le.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザは懐から取り出した手榴弾を床に叩きつける。",
   "ko_candidate": "엘자는 품에서 꺼낸 수류탄을 바닥에 내리쳤다｡"
  },
  {
   "id": 21432,
   "key": "D1005le.txt:356",
   "file": "D1005le.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光がエルザとアウグストゥスの間で迸った。",
   "ko_candidate": "섬광이 엘자와 아우구스투스 사이에서 번쩍였다｡"
  },
  {
   "id": 21433,
   "key": "D1005le.txt:357",
   "file": "D1005le.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そちらに目を向けていた全員が思わず光から目を背ける。",
   "ko_candidate": "그쪽을 바라보고 있던 모두가 무의식적으로 빛에서 눈을 돌린다｡"
  },
  {
   "id": 21434,
   "key": "D1005le.txt:362",
   "file": "D1005le.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が収まったときには、その場にはもうエルザの姿もドクター・ウェストの姿もなかった。",
   "ko_candidate": "빛이 가라앉았을 때는 그 자리에 이미 엘자의 모습도 닥터 웨스트의 모습도 없었다｡"
  },
  {
   "id": 21435,
   "key": "D1005le.txt:364",
   "file": "D1005le.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正面門の向こうにドクター・ウェストを背負って走るエルザの背中が小さく見えた。",
   "ko_candidate": "정면 문 너머로 닥터 웨스트를 업고 달리는 엘자의 등이 작게 보였다｡"
  },
  {
   "id": 21436,
   "key": "D1005le.txt:369",
   "file": "D1005le.txt",
   "line": 369,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「オラァ！　何ボケっとしてやがる、ヌケサクども！　とっとと反逆者を追うんだよ、ボケナスが！」",
   "ko_candidate": "「이 자식아! 뭘 멍하니 있는 거야､ 멍청이들아! 어서 반역자를 쫓아가라고､ 바보 녀석들아!」"
  },
  {
   "id": 21437,
   "key": "D1005le.txt:373",
   "file": "D1005le.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが信徒達を一喝する。",
   "ko_candidate": "클라우디우스가 신도들을 호통친다｡"
  },
  {
   "id": 21438,
   "key": "D1005le.txt:377",
   "file": "D1005le.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慌てて、戦闘員達がエルザの後を追った。",
   "ko_candidate": "당황하여 전투원들이 엘자의 뒤를 쫓았다｡"
  },
  {
   "id": 21439,
   "key": "D1005le.txt:378",
   "file": "D1005le.txt",
   "line": 378,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『夢幻心母』内に緊急事態を告げる警報が鳴り響く。",
   "ko_candidate": "『몽환심모』 내에 긴급 사태를 알리는 경보가 울려 퍼진다｡"
  },
  {
   "id": 21440,
   "key": "D1005le.txt:384",
   "file": "D1005le.txt",
   "line": 384,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「良いのか？　拙者共が追わなくて」",
   "ko_candidate": "「괜찮은가? 우리가 쫓지 않고」"
  },
  {
   "id": 21441,
   "key": "D1005le.txt:389",
   "file": "D1005le.txt",
   "line": 389,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふん、どうせ彼には何も出来んよ」 「さて後は――サンダルフォンはどうした？」",
   "ko_candidate": "「흥､ 어차피 그에겐 아무것도 할 수 없어｡ 자､ 이제는―― 산달폰은 어떻게 됐지?」"
  },
  {
   "id": 21442,
   "key": "D1005le.txt:397",
   "file": "D1005le.txt",
   "line": 397,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さっきから念話が通じんのだが……はてさて、まさかまさかメタトロンに敗れたかなぁ？」",
   "ko_candidate": "「아까부터 염화가 통하지 않는데… 설마설마 메타트론에게 패배했나?」"
  },
  {
   "id": 21443,
   "key": "D1005le.txt:404",
   "file": "D1005le.txt",
   "line": 404,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……奴はどう出る？」",
   "ko_candidate": "「…그자는 어떻게 나올까?」"
  },
  {
   "id": 21444,
   "key": "D1005le.txt:409",
   "file": "D1005le.txt",
   "line": 409,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「問題あるまい。奴は組織の事など、欠片にも微塵にも興味が無いよ」 「あいつが興味あるのは、メタトロンの事だけだろうさ」",
   "ko_candidate": "「문제없을 거야｡ 그자는 조직의 일 따위는 조금도 티끌만큼도 관심이 없어｡ 그가 관심 있는 건 메타트론의 일뿐이겠지」"
  },
  {
   "id": 21445,
   "key": "D1005le.txt:417",
   "file": "D1005le.txt",
   "line": 417,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふむ……それは、それで問題だな」",
   "ko_candidate": "「흠… 그것도 그것대로 문제군」"
  },
  {
   "id": 21446,
   "key": "D1005le.txt:422",
   "file": "D1005le.txt",
   "line": 422,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「んん？」",
   "ko_candidate": "「응?」"
  },
  {
   "id": 21447,
   "key": "D1005le.txt:427",
   "file": "D1005le.txt",
   "line": 427,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだな――では今後の事について、語ろうではないか」",
   "ko_candidate": "「그렇군―― 그럼 앞으로의 일에 대해 이야기해볼까」"
  },
  {
   "id": 21448,
   "key": "D1005le.txt:430",
   "file": "D1005le.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アウグストゥスがアンチクロス全員を見回した。",
   "ko_candidate": "아우구스투스가 안티 크로스 전원을 둘러보았다｡"
  },
  {
   "id": 21449,
   "key": "D1005le.txt:431",
   "file": "D1005le.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線が集中する。",
   "ko_candidate": "시선이 집중된다｡"
  },
  {
   "id": 21450,
   "key": "D1005le.txt:432",
   "file": "D1005le.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "軽く頷き、アウグストゥスは続けた。",
   "ko_candidate": "가볍게 끄덕이고 아우구스투스는 계속했다｡"
  },
  {
   "id": 21451,
   "key": "D1005le.txt:436",
   "file": "D1005le.txt",
   "line": 436,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今回の『Ｃ計画』は、大導師の策謀によって、不完全なまま発動してしまった。今のままでは我々に、クトゥルーを制御する術は無い」",
   "ko_candidate": "「이번 『C계획』은 <RUBY text=\"그랜드 마스터\">대도사</RUBY>의 책략으로 인해 불완전한 채로 발동해버렸다｡ 지금 상태로는 우리에게 크툴루를 제어할 방법이 없어」"
  },
  {
   "id": 21452,
   "key": "D1005le.txt:441",
   "file": "D1005le.txt",
   "line": 441,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そりゃあねえ。『Ｃの巫女』である『暴君』も死んじゃったし……」",
   "ko_candidate": "「그야 그렇지｡ 『C의 무녀』인 『폭군』도 죽어버렸고…」"
  },
  {
   "id": 21453,
   "key": "D1005le.txt:446",
   "file": "D1005le.txt",
   "line": 446,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クトゥルーを制御する為の中枢ユニット、ネームレス・ワンも当然、存在しない。忌まわしい事にあのデモンベインに滅ぼされてしまったからなぁ」",
   "ko_candidate": "「크툴루를 제어하기 위한 중추 유닛､ 네임리스 원도 당연히 존재하지 않아｡ 저주스럽게도 그 데몬베인에 의해 파괴되어 버렸으니까 말이야」"
  },
  {
   "id": 21454,
   "key": "D1005le.txt:451",
   "file": "D1005le.txt",
   "line": 451,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今、拙者共の手の内にあるは『ルルイエ異本』のみ。此れでは、『Ｃ計画』の完遂は不可能――」",
   "ko_candidate": "「지금 우리 손에 있는 건 『르뤼에 이본』뿐｡ 이것으로는 『C계획』의 완수는 불가능――」"
  },
  {
   "id": 21455,
   "key": "D1005le.txt:456",
   "file": "D1005le.txt",
   "line": 456,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そこでだ。代用品を用意する事にしよう」",
   "ko_candidate": "「그래서 말이다｡ 대용품을 준비하기로 했어」"
  },
  {
   "id": 21456,
   "key": "D1005le.txt:461",
   "file": "D1005le.txt",
   "line": 461,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「代用品だって？」",
   "ko_candidate": "「대용품이라고?」"
  },
  {
   "id": 21457,
   "key": "D1005le.txt:466",
   "file": "D1005le.txt",
   "line": 466,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――見ろ」",
   "ko_candidate": "「――봐라」"
  },
  {
   "id": 21458,
   "key": "D1005le.txt:469",
   "file": "D1005le.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "広間の中心に、幻影が浮かび上がる。",
   "ko_candidate": "광장의 중심에 환영이 떠오른다｡"
  },
  {
   "id": 21459,
   "key": "D1005le.txt:470",
   "file": "D1005le.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其処に映し出されたのは――",
   "ko_candidate": "거기에 비춰진 것은――"
  },
  {
   "id": 21460,
   "key": "D1005le.txt:478",
   "file": "D1005le.txt",
   "line": 478,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「リベル・レギス!?」",
   "ko_candidate": "「리베르 레기스!?」"
  },
  {
   "id": 21461,
   "key": "D1005le.txt:487",
   "file": "D1005le.txt",
   "line": 487,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだ。既に回収して、中心部に転送してある」 「これとは別にもう一機……いや、その話は置いておくか。今は関係ない」",
   "ko_candidate": "「그렇다｡ 이미 회수해서 중심부로 이송해 두었다｡ 이것과는 별개로 또 한 대… 아니､ 그 이야기는 접어두자｡ 지금은 관계없어」"
  },
  {
   "id": 21462,
   "key": "D1005le.txt:495",
   "file": "D1005le.txt",
   "line": 495,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……あれだけ破壊したのに、随分と直っているじゃねえか」",
   "ko_candidate": "「…그렇게 파괴했는데도 꽤나 복구되어 있잖아」"
  },
  {
   "id": 21463,
   "key": "D1005le.txt:499",
   "file": "D1005le.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "映し出されたリベル・レギスは確かに、大破していたにも関わらず、そのほとんどが修復されていた。",
   "ko_candidate": "비춰진 리베르 레기스는 확실히 크게 파괴되었음에도 불구하고 대부분이 복구되어 있었다｡"
  },
  {
   "id": 21464,
   "key": "D1005le.txt:500",
   "file": "D1005le.txt",
   "line": 500,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "千切れた四肢も、断たれたボディも、復活している。",
   "ko_candidate": "끊어진 사지도､ 잘린 몸체도 부활해 있다｡"
  },
  {
   "id": 21465,
   "key": "D1005le.txt:507",
   "file": "D1005le.txt",
   "line": 507,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クトゥルーの神気を浴びて、急速に再生している――中枢ユニットには、前に大導師が言っていた通り、リベル・レギスを使わせてもらおう」",
   "ko_candidate": "「크툴루의 신기를 받아 급속히 재생하고 있어―― 중추 유닛으로는 전에 <RUBY text=\"그랜드 마스터\">대도사</RUBY>가 말했던 대로 리베르 레기스를 사용하도록 하지」"
  },
  {
   "id": 21466,
   "key": "D1005le.txt:512",
   "file": "D1005le.txt",
   "line": 512,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なるほどねんっ。で、も一つの問題。巫女代わりはどうするワケ？」",
   "ko_candidate": "「그렇군｡ 그럼 또 하나의 문제｡ 무녀 대신은 어떻게 할 거야?」"
  },
  {
   "id": 21467,
   "key": "D1005le.txt:517",
   "file": "D1005le.txt",
   "line": 517,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ウェスパシアヌス」",
   "ko_candidate": "「베스파시아누스」"
  },
  {
   "id": 21468,
   "key": "D1005le.txt:520",
   "file": "D1005le.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "見定めるような視線を向けられ、ウェスパシアヌスは警戒の色を見せる。",
   "ko_candidate": "가늠하는 듯한 시선을 받고 베스파시아누스는 경계의 색을 보인다｡"
  },
  {
   "id": 21469,
   "key": "D1005le.txt:520",
   "file": "D1005le.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かに問い返す。",
   "ko_candidate": "조용히 되묻는다｡"
  }
 ]
}