{
 "packet": "0803_00",
 "scene": "0803",
 "anchor": {
  "hit": 13,
  "total": 14,
  "rate": 0.929
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "アル": "알",
  "エンネア": "엔네아"
 },
 "items": [
  {
   "id": 12489,
   "key": "D0803al.txt:13",
   "file": "D0803al.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――少女よ、私はあなたに言う。 起きなさい。",
   "ko_candidate": "――소녀여､ 내가 너에게 말하노라｡ 일어나라｡"
  },
  {
   "id": 12490,
   "key": "D0803al.txt:22",
   "file": "D0803al.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "至福なるかな、朝の微睡み。",
   "ko_candidate": "지복하도다､ 아침의 미몽｡"
  },
  {
   "id": 12491,
   "key": "D0803al.txt:24",
   "file": "D0803al.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそのささやかな幸福は、突然に唐突に理不尽に粉砕されるのだった。",
   "ko_candidate": "하지만､ 그 작은 행복은､ 갑자기 뜬금없이 이치에 맞지 않게 산산조각 나고 말았다｡"
  },
  {
   "id": 12492,
   "key": "D0803al.txt:31",
   "file": "D0803al.txt",
   "line": 31,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎――っ！ 朝だよ――っ！」",
   "ko_candidate": "「쿠로――! 아침이야――!」"
  },
  {
   "id": 12493,
   "key": "D0803al.txt:44",
   "file": "D0803al.txt",
   "line": 44,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「～～～～～～ッッッ!?」",
   "ko_candidate": "「으으으으으으으으으으!?」"
  },
  {
   "id": 12494,
   "key": "D0803al.txt:47",
   "file": "D0803al.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "完全な不意打ちで襲う衝撃と重圧。",
   "ko_candidate": "완전히 불시에 덮치는 충격과 중압｡"
  },
  {
   "id": 12495,
   "key": "D0803al.txt:48",
   "file": "D0803al.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鳩尾をうがち、腹全体にのしかかる。",
   "ko_candidate": "명치를 파고들어 배 전체를 짓누른다｡"
  },
  {
   "id": 12496,
   "key": "D0803al.txt:51",
   "file": "D0803al.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吐き気を伴う激痛と、声にならない悲鳴が、咽喉まで込み上げてきた。",
   "ko_candidate": "구토를 동반하는 격통과､ 소리 없는 비명이 목구멍까지 치밀어 오른다｡"
  },
  {
   "id": 12497,
   "key": "D0803al.txt:53",
   "file": "D0803al.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "陸に揚げられた魚のように口をパクパクとさせながら激痛に耐え、現状を把握しようとまぶたを開ける。",
   "ko_candidate": "육지에 올려진 물고기처럼 입을 빠끔빠끔 거리며 격통을 견디며､ 나는 현 상황을 파악하려 눈꺼풀을 들어올렸다｡"
  },
  {
   "id": 12498,
   "key": "D0803al.txt:62",
   "file": "D0803al.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……俺の上に誰かが乗っていた。",
   "ko_candidate": "……내 위에 누군가가 올라타 있었다｡"
  },
  {
   "id": 12499,
   "key": "D0803al.txt:63",
   "file": "D0803al.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重量感ある女の尻が俺の腹を圧迫している。",
   "ko_candidate": "무게감 있는 여자의 엉덩이가 내 배를 압박하고 있다｡"
  },
  {
   "id": 12500,
   "key": "D0803al.txt:66",
   "file": "D0803al.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が目を覚ましたのに気付くと、彼女は満面の笑顔を浮かべた。",
   "ko_candidate": "내가 눈을 뜬 걸 알아차리자､ 그녀는 만면에 미소를 띠었다｡"
  },
  {
   "id": 12501,
   "key": "D0803al.txt:77",
   "file": "D0803al.txt",
   "line": 77,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あははは、起きた起きた！ おはよ――！　九郎！」",
   "ko_candidate": "「아하하하､ 일어났다 일어났다! 안녕――! 쿠로!」"
  },
  {
   "id": 12502,
   "key": "D0803al.txt:83",
   "file": "D0803al.txt",
   "line": 83,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ん……あ……な、なに？」",
   "ko_candidate": "「음……아……뭐､ 뭐야?」"
  },
  {
   "id": 12503,
   "key": "D0803al.txt:86",
   "file": "D0803al.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ちょっと癖のある赤毛のショートカット。",
   "ko_candidate": "약간 버릇이 있는 빨간 머리 숏컷｡"
  },
  {
   "id": 12504,
   "key": "D0803al.txt:87",
   "file": "D0803al.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あどけなさを残す顔。",
   "ko_candidate": "앳된 면모를 간직한 얼굴｡"
  },
  {
   "id": 12505,
   "key": "D0803al.txt:88",
   "file": "D0803al.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悪戯っぽい瞳が、くりくりと忙しなく動く。 小柄な身体。",
   "ko_candidate": "장난기 어린 눈동자가 끊임없이 바쁘게 움직인다｡"
  },
  {
   "id": 12506,
   "key": "D0803al.txt:92",
   "file": "D0803al.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "辛うじてアルよりも大きいくらいか。",
   "ko_candidate": "작은 체구는 겨우 알보다 위……정도일까｡"
  },
  {
   "id": 12507,
   "key": "D0803al.txt:95",
   "file": "D0803al.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "知っている顔だった。",
   "ko_candidate": "아는 얼굴이었다｡"
  },
  {
   "id": 12508,
   "key": "D0803al.txt:96",
   "file": "D0803al.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――というか、昨日連れてきた少女だった。",
   "ko_candidate": "――라기보다､ 어제 데려온 소녀였다｡"
  },
  {
   "id": 12509,
   "key": "D0803al.txt:99",
   "file": "D0803al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど。",
   "ko_candidate": "하지만｡"
  },
  {
   "id": 12510,
   "key": "D0803al.txt:104",
   "file": "D0803al.txt",
   "line": 104,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 12511,
   "key": "D0803al.txt:109",
   "file": "D0803al.txt",
   "line": 109,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「？？？？？」",
   "ko_candidate": "「????」"
  },
  {
   "id": 12512,
   "key": "D0803al.txt:113",
   "file": "D0803al.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昨日の酷く儚げな雰囲気の少女と――今、俺の目の前で、ワイシャツ一枚だけを着て、無邪気に無防備に微笑む少女とが、どうもイコールで繋がらない。",
   "ko_candidate": "어제의 몹시 덧없어 보이던 분위기의 소녀와――지금､ 내 눈앞에서 와이셔츠 한 장만 입고､ 천진난만하게 무방비하게 미소 짓는 소녀가､ 도무지 등호로 연결되지 않는다｡"
  },
  {
   "id": 12513,
   "key": "D0803al.txt:116",
   "file": "D0803al.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は恐る恐ると、少女に訊ねた。",
   "ko_candidate": "나는 조심스럽게 소녀에게 물었다｡"
  },
  {
   "id": 12514,
   "key": "D0803al.txt:120",
   "file": "D0803al.txt",
   "line": 120,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっと……たしか、エンネア……？」",
   "ko_candidate": "「저기……맞지､ 엔네아……?」"
  },
  {
   "id": 12515,
   "key": "D0803al.txt:125",
   "file": "D0803al.txt",
   "line": 125,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うん、そうだよ！」",
   "ko_candidate": "「응､ 맞아!」"
  },
  {
   "id": 12516,
   "key": "D0803al.txt:129",
   "file": "D0803al.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "元気いっぱい、全身を使うような勢いで、少女は頷いた。",
   "ko_candidate": "기운 넘치게､ 온몸을 사용하는 듯한 기세로､ 소녀는 고개를 끄덕였다｡"
  },
  {
   "id": 12517,
   "key": "D0803al.txt:131",
   "file": "D0803al.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やっぱり……見ての通り、彼女は昨日の少女らしい。",
   "ko_candidate": "역시……보다시피､ 그녀는 어제의 소녀인 듯하다｡"
  },
  {
   "id": 12518,
   "key": "D0803al.txt:134",
   "file": "D0803al.txt",
   "line": 134,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ず、随分と元気そうじゃないか……」",
   "ko_candidate": "「꽤､ 꽤나 건강해 보이는데……」"
  },
  {
   "id": 12519,
   "key": "D0803al.txt:138",
   "file": "D0803al.txt",
   "line": 138,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うん！　だってお外はこーんなに良い天気だからね！　いつまでも寝ているのは勿体ないよ！」",
   "ko_candidate": "「응! 밖은 이렇게나 좋은 날씨니까! 계속 자고 있으면 아깝잖아!」"
  },
  {
   "id": 12520,
   "key": "D0803al.txt:142",
   "file": "D0803al.txt",
   "line": 142,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はあ…………」",
   "ko_candidate": "「하아…………」"
  },
  {
   "id": 12521,
   "key": "D0803al.txt:144",
   "file": "D0803al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いかん。",
   "ko_candidate": "안 되겠어｡"
  },
  {
   "id": 12522,
   "key": "D0803al.txt:145",
   "file": "D0803al.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "完全に勢いに飲み込まれてしまっている。",
   "ko_candidate": "완전히 기세에 휩쓸려 버렸다｡"
  },
  {
   "id": 12523,
   "key": "D0803al.txt:147",
   "file": "D0803al.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだ寝惚けている上に、頭が混乱しているから、気の利いた対応が出来ない。",
   "ko_candidate": "아직 잠에서 덜 깬 데다가､ 머리가 혼란스러워서 제대로 된 대응을 할 수가 없다｡"
  },
  {
   "id": 12524,
   "key": "D0803al.txt:149",
   "file": "D0803al.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まあ、とりあえず……。",
   "ko_candidate": "뭐､ 일단은……"
  },
  {
   "id": 12525,
   "key": "D0803al.txt:153",
   "file": "D0803al.txt",
   "line": 153,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「すまん……エンネア。ひとまず退いてくれ。重い」",
   "ko_candidate": "「미안……엔네아｡ 우선 내려줘｡ 무거워」"
  },
  {
   "id": 12526,
   "key": "D0803al.txt:158",
   "file": "D0803al.txt",
   "line": 158,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え――っっっ！？　ひどいひどいひどい！　エンネアは重くないよーだ！」",
   "ko_candidate": "「에――에에에!? 너무해 너무해 너무해! 엔네아는 무겁지 않다구!」"
  },
  {
   "id": 12527,
   "key": "D0803al.txt:165",
   "file": "D0803al.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "頬を膨らませて、ポカポカと叩いてくる。",
   "ko_candidate": "볼을 부풀리며 톡톡 때려온다｡"
  },
  {
   "id": 12528,
   "key": "D0803al.txt:168",
   "file": "D0803al.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……傍から見てると可愛らしい仕草だがこれはマウント・ポジションだ。",
   "ko_candidate": "……옆에서 보면 귀여운 행동이겠지만､ 내가 말하자면､ 이건 마운트 포지션이다｡"
  }
 ]
}