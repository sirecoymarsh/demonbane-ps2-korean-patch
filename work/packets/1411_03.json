 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リューガ": "류가",
  "ハンティング・ホラー": "헌팅 호러",
  "サイクラノーシュ": "사이크라노쉬",
  "サンダルフォン": "산달폰",
  "鬼械神": "귀계신",
  "ライカ": "라이카"
 },
 "items": [
  {
   "id": 39179,
   "key": "D1411le.txt:511",
   "file": "D1411le.txt",
   "line": 511,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの、青い空へ。",
   "ko_candidate": "저､ 푸른 하늘로｡"
  },
  {
   "id": 39180,
   "key": "D1411le.txt:513",
   "file": "D1411le.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やくそく――",
   "ko_candidate": "약속――"
  },
  {
   "id": 39181,
   "key": "D1411le.txt:516",
   "file": "D1411le.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガの凶相を引き裂く古傷。",
   "ko_candidate": "류가의 광기 어린 얼굴을 갈라놓는 옛 상처｡"
  },
  {
   "id": 39182,
   "key": "D1411le.txt:517",
   "file": "D1411le.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右の視界が、紅に染まった。",
   "ko_candidate": "오른쪽 시야가､ 붉게 물들었다｡"
  },
  {
   "id": 39183,
   "key": "D1411le.txt:525",
   "file": "D1411le.txt",
   "line": 525,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「黙れぇぇぇぇぇぇ――――――！」",
   "ko_candidate": "「닥쳐어어어어어어――――――!」"
  },
  {
   "id": 39184,
   "key": "D1411le.txt:528",
   "file": "D1411le.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を吐くような咆吼が轟いた。",
   "ko_candidate": "피를 토하는 듯한 포효가 울려 퍼졌다｡"
  },
  {
   "id": 39185,
   "key": "D1411le.txt:529",
   "file": "D1411le.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼応するように、ハンティング・ホラーが狩人の咆吼と共に、サイクラノーシュの装甲を砕き、機体を貫き、断ち切り、引き裂き、粉砕する。",
   "ko_candidate": "호응하듯､ 헌팅 호러가 사냥꾼의 포효와 함께､ 사이크라노쉬의 장갑을 부수고､ 기체를 관통하고､ 베어내고､ 찢어내고､ 분쇄한다｡"
  },
  {
   "id": 39186,
   "key": "D1411le.txt:533",
   "file": "D1411le.txt",
   "line": 533,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「君は既に我が術中に陥った！」",
   "ko_candidate": "「너는 이미 내 술중에 빠졌다!」"
  },
  {
   "id": 39187,
   "key": "D1411le.txt:537",
   "file": "D1411le.txt",
   "line": 537,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――何!?」",
   "ko_candidate": "「――뭣!?」"
  },
  {
   "id": 39188,
   "key": "D1411le.txt:545",
   "file": "D1411le.txt",
   "line": 545,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サイクラノーシュが影となって、空間に溶けた。",
   "ko_candidate": "사이크라노쉬가 그림자가 되어､ 공간에 녹아들었다｡"
  },
  {
   "id": 39189,
   "key": "D1411le.txt:546",
   "file": "D1411le.txt",
   "line": 546,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幻覚――気づいたときにはもう遅い。",
   "ko_candidate": "환각―― 깨달았을 때는 이미 늦었다｡"
  },
  {
   "id": 39190,
   "key": "D1411le.txt:553",
   "file": "D1411le.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "壁面に埋もれる肉が突然に泡立ち、膨れ上がる。",
   "ko_candidate": "벽면에 묻힌 살점이 갑자기 거품을 일으키며､ 부풀어 오른다｡"
  },
  {
   "id": 39191,
   "key": "D1411le.txt:554",
   "file": "D1411le.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数にして３つ、それぞれがヒトのカタチを模る。",
   "ko_candidate": "수로는 3개､ 각각이 사람의 형태를 본뜬다｡"
  },
  {
   "id": 39192,
   "key": "D1411le.txt:559",
   "file": "D1411le.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンを取り囲むように出現した巨人は、怨嗟の咆吼を空間に轟かせた。",
   "ko_candidate": "산달폰을 둘러싸듯 출현한 거인은､ 원한에 찬 포효를 공간에 울려 퍼뜨렸다｡"
  },
  {
   "id": 39193,
   "key": "D1411le.txt:560",
   "file": "D1411le.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気が固定化し、空中にハンティング・ホラーを縛りつける。",
   "ko_candidate": "대기가 고정화되어､ 공중에 헌팅 호러를 묶어둔다｡"
  },
  {
   "id": 39194,
   "key": "D1411le.txt:564",
   "file": "D1411le.txt",
   "line": 564,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ――!?　結界か！」",
   "ko_candidate": "「크…!? 결계인가!」"
  },
  {
   "id": 39195,
   "key": "D1411le.txt:568",
   "file": "D1411le.txt",
   "line": 568,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ガルバ。オトー。ウィテリウス。さあさあ私の可愛い使い魔達よ。 謡え！　呪え！」",
   "ko_candidate": "「갈바｡ 오토｡ 비텔리우스｡ 자 자 내 귀여운 사역마들아｡ 노래하라! 저주하라!」"
  },
  {
   "id": 39196,
   "key": "D1411le.txt:573",
   "file": "D1411le.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪詛が世界を犯し、大気が毒素を帯びた。",
   "ko_candidate": "저주가 세계를 범하고､ 대기가 독소를 띠었다｡"
  },
  {
   "id": 39197,
   "key": "D1411le.txt:574",
   "file": "D1411le.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨嗟が、サンダルフォンに猛威の牙を突き立てる。",
   "ko_candidate": "원한이､ 산달폰에게 맹위의 이빨을 박는다｡"
  },
  {
   "id": 39198,
   "key": "D1411le.txt:575",
   "file": "D1411le.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暴虐の毒が、臓腑を、魂を腐らせる。",
   "ko_candidate": "폭력적인 독이､ 장기를､ 영혼을 부패시킨다｡"
  },
  {
   "id": 39199,
   "key": "D1411le.txt:577",
   "file": "D1411le.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身を引き裂く呪念の乱舞に、サンダルフォンは絶叫した。",
   "ko_candidate": "몸을 찢는 주념의 난무에､ 산달폰은 절규했다｡"
  },
  {
   "id": 39200,
   "key": "D1411le.txt:581",
   "file": "D1411le.txt",
   "line": 581,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐああああああああ！」",
   "ko_candidate": "「크아아아아아아아!」"
  },
  {
   "id": 39201,
   "key": "D1411le.txt:585",
   "file": "D1411le.txt",
   "line": 585,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「鬼械神すら粉砕する、破滅の結界ぞ！ 塵すら遺さず、消し飛ぶが良いさ！」",
   "ko_candidate": "「귀계신마저 분쇄하는､ 파멸의 결계다! 먼지조차 남기지 않고､ 날아가 버려라!」"
  },
  {
   "id": 39202,
   "key": "D1411le.txt:590",
   "file": "D1411le.txt",
   "line": 590,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ギィ……アアアア……アアア――――ッ！」 崩壊がもたらす激痛の嵐。",
   "ko_candidate": "「크이… 아아아아… 아아아――――!」"
  },
  {
   "id": 39203,
   "key": "D1411le.txt:603",
   "file": "D1411le.txt",
   "line": 603,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "灼ける痛み。凍る痛み。爛れる痛み。えぐれる痛み。 だが、その如何なる苦痛よりも鮮烈な痛みが在った。",
   "ko_candidate": "붕괴가 가져오는 격통의 폭풍으로―― 하지만､ 피부를 태우고､ 장기를 끓이고､ 살을 찢고､ 뼈를 부수고､ 뇌를 도려내는､ 그 어떤 고통보다도 선명한 아픔이 있었다｡"
  },
  {
   "id": 39204,
   "key": "D1411le.txt:609",
   "file": "D1411le.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右瞼から――頬までを引き裂く――傷痕――灼ける様に熱く――それは――",
   "ko_candidate": "오른쪽 눈꺼풀에서―― 뺨까지 갈라놓는―― 상처―― 타는 듯이 뜨겁게―― 그것은――"
  },
  {
   "id": 39205,
   "key": "D1411le.txt:623",
   "file": "D1411le.txt",
   "line": 623,
   "speaker": "研究員Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「早く４号を――」",
   "ko_candidate": "「빨리 4호를――」"
  },
  {
   "id": 39206,
   "key": "D1411le.txt:626",
   "file": "D1411le.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳に貫かれ、胸に風穴を穿たれ、崩れ落ちる男。",
   "ko_candidate": "주먹에 꿰뚫리고､ 가슴에 구멍이 뚫리고､ 무너져 내리는 남자｡"
  },
  {
   "id": 39207,
   "key": "D1411le.txt:627",
   "file": "D1411le.txt",
   "line": 627,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "噴射する鮮血が、広間を濡らす。",
   "ko_candidate": "분출하는 선혈이､ 홀을 적신다｡"
  },
  {
   "id": 39208,
   "key": "D1411le.txt:631",
   "file": "D1411le.txt",
   "line": 631,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカ……姉さん……っ」",
   "ko_candidate": "「라이카… 누나…」"
  },
  {
   "id": 39209,
   "key": "D1411le.txt:634",
   "file": "D1411le.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界を染める紅の向こう。",
   "ko_candidate": "시야를 물들이는 붉은 색 너머｡"
  },
  {
   "id": 39210,
   "key": "D1411le.txt:635",
   "file": "D1411le.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅に染められる、白い世界の向こう。",
   "ko_candidate": "붉게 물들어가는､ 하얀 세계 너머｡"
  },
  {
   "id": 39211,
   "key": "D1411le.txt:637",
   "file": "D1411le.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカが。",
   "ko_candidate": "라이카가｡"
  },
  {
   "id": 39212,
   "key": "D1411le.txt:638",
   "file": "D1411le.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ライカを、この、しろい、せかいから、たすけださないと。",
   "ko_candidate": "라이카를､ 이､ 하얀､ 세상에서､ 구해내지 않으면｡ 「누나…!」"
  },
  {
   "id": 39213,
   "key": "D1411le.txt:642",
   "file": "D1411le.txt",
   "line": 642,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ねえさ……ん……ッ！」 ――紅よりも白よりも、なお鮮烈な、耀く白。",
   "ko_candidate": "――붉은 색보다도 하얀색보다도､ 더욱 선명한､ 빛나는 하얀색｡"
  },
  {
   "id": 39214,
   "key": "D1411le.txt:651",
   "file": "D1411le.txt",
   "line": 651,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 39215,
   "key": "D1411le.txt:654",
   "file": "D1411le.txt",
   "line": 654,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この白い、閃は、なに？",
   "ko_candidate": "이 하얀､ 섬광은､ 뭐지?"
  },
  {
   "id": 39216,
   "key": "D1411le.txt:655",
   "file": "D1411le.txt",
   "line": 655,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは――ライカは――ライカだった存在は――",
   "ko_candidate": "이것은―― 라이카는―― 라이카였던 존재는――"
  },
  {
   "id": 39217,
   "key": "D1411le.txt:672",
   "file": "D1411le.txt",
   "line": 672,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ォォォォ……おおオお……ＯＯＯｏｏｏｏｏＯＯＯ……怨悪悪嗚怨悪怨悪嗚悪怨嗚嗚鏖悪嗚鏖鏖おオおおおｏｏＯＯＯ怨嗚嗚鏖悪――――――――――ッッッッ！」",
   "ko_candidate": "「오오오오… 오오오… OOOooooOOO… 원악오악오원원악원악악오악원오오살악악오살살살오오오오오ooOOO원오오살악――――――――――――!」"
  },
  {
   "id": 39218,
   "key": "D1411le.txt:676",
   "file": "D1411le.txt",
   "line": 676,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い天使の仮面が砕け散る。",
   "ko_candidate": "검은 천사의 가면이 산산조각 난다｡"
  }
 ]
}