 },
 "items": [
  {
   "id": 32406,
   "key": "D1305le.txt:178",
   "file": "D1305le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は必殺の威力を引き出すため、ハンティングホラーの術式をリンクする――",
   "ko_candidate": "나는 필살의 위력을 끌어내기 위해 헌팅 호러의 술식을 링크한다――"
  },
  {
   "id": 32407,
   "key": "D1305le.txt:181",
   "file": "D1305le.txt",
   "line": 181,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――ッ!?」",
   "ko_candidate": "「――――――!?」"
  },
  {
   "id": 32408,
   "key": "D1305le.txt:183",
   "file": "D1305le.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "な、何だ、これは!?",
   "ko_candidate": "뭐､ 뭐야､ 이건!?"
  },
  {
   "id": 32409,
   "key": "D1305le.txt:185",
   "file": "D1305le.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気の流れがメチャクチャだ！　ヒトの中に入り込んで、好き勝手に大暴れしやがる！　何つー暴れ馬だ、こいつは！",
   "ko_candidate": "기의 흐름이 엉망진창이다! 사람 안에 들어와서 마음대로 날뛰고 있어! 무슨 난폭한 말이야､ 이 녀석은!"
  },
  {
   "id": 32410,
   "key": "D1305le.txt:187",
   "file": "D1305le.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……いや、それだけじゃない？",
   "ko_candidate": "…아니､ 그뿐만이 아니?"
  },
  {
   "id": 32411,
   "key": "D1305le.txt:188",
   "file": "D1305le.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これは――",
   "ko_candidate": "이건――"
  },
  {
   "id": 32412,
   "key": "D1305le.txt:194",
   "file": "D1305le.txt",
   "line": 194,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「う……っぐあああああああ――――っ！」",
   "ko_candidate": "「으… 크아아아아아아아――――!」"
  },
  {
   "id": 32413,
   "key": "D1305le.txt:198",
   "file": "D1305le.txt",
   "line": 198,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎っ!?」",
   "ko_candidate": "「쿠로!?」"
  },
  {
   "id": 32414,
   "key": "D1305le.txt:201",
   "file": "D1305le.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苛烈なほどの拒絶の意志。",
   "ko_candidate": "격렬할 정도의 거부의 의지｡"
  },
  {
   "id": 32415,
   "key": "D1305le.txt:202",
   "file": "D1305le.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティングホラーが俺を排斥しようと、敵意を向けてくる。",
   "ko_candidate": "헌팅 호러가 나를 배척하려고 적의를 보내온다｡ 칼날처럼 내 정신에 꽂힌다｡"
  },
  {
   "id": 32416,
   "key": "D1305le.txt:204",
   "file": "D1305le.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃のように、俺の精神に突き刺さる。",
   "ko_candidate": "머리에 타는 듯한 고통이 달리고､ 그리고 터졌다｡"
  },
  {
   "id": 32417,
   "key": "D1305le.txt:205",
   "file": "D1305le.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭に灼けるような痛みが走り、そして弾けた。",
   "ko_candidate": "동시에 전신의 모세혈관이 파열되어 피가 분출된다｡"
  },
  {
   "id": 32418,
   "key": "D1305le.txt:206",
   "file": "D1305le.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "同時に全身の毛細血管が破裂して、血が噴き出る。",
   "ko_candidate": "…위험해｡ 이대로라면… 나는 이놈에게 죽을지도 몰라!"
  },
  {
   "id": 32419,
   "key": "D1305le.txt:207",
   "file": "D1305le.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……ヤバい。",
   "ko_candidate": "핸들을 놓는다｡"
  },
  {
   "id": 32420,
   "key": "D1305le.txt:208",
   "file": "D1305le.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "このままじゃ……俺はこいつに殺されかねない！",
   "ko_candidate": "떠오르는 몸｡ 시트를 걷어차고 헌팅 호러에서 떨어진다｡"
  },
  {
   "id": 32421,
   "key": "D1305le.txt:215",
   "file": "D1305le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンドルを手離す。 浮かび上がる身体。シートを蹴飛ばして、ハンティングホラーから離れる。",
   "ko_candidate": "주인을 잃은 헌팅 호러는 곧장 엉뚱한 방향으로 날아가 잔해를 날리며 지면에 충돌했다｡"
  },
  {
   "id": 32422,
   "key": "D1305le.txt:218",
   "file": "D1305le.txt",
   "line": 218,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "主を失ったハンティングホラーは真っ直ぐにあらぬ方向に翔んでいき、瓦礫を吹き飛ばしつつ、地面に激突した。 「ぐぅうっ！」",
   "ko_candidate": "「크으!」"
  },
  {
   "id": 32423,
   "key": "D1305le.txt:230",
   "file": "D1305le.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空中でバランスを取り、高層ビルの屋上に降り立つ。",
   "ko_candidate": "공중에서 균형을 잡고 고층 빌딩의 옥상에 내려선다｡"
  },
  {
   "id": 32424,
   "key": "D1305le.txt:231",
   "file": "D1305le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこに申し合わせたかのように、拳を振り上げるデモンベイン！",
   "ko_candidate": "그곳에 약속이라도 한 듯이 주먹을 들어 올리는 데몬베인!"
  },
  {
   "id": 32425,
   "key": "D1305le.txt:235",
   "file": "D1305le.txt",
   "line": 235,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っ！」",
   "ko_candidate": "「…!」"
  },
  {
   "id": 32426,
   "key": "D1305le.txt:239",
   "file": "D1305le.txt",
   "line": 239,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あらあらぁん、どうしちゃったの。九郎ちゃん!? せっかくの武器を離すなんて、おバカさん、ねっ！」",
   "ko_candidate": "「어머어머､ 어떻게 된 거야｡ 쿠로 짜앙!? 모처럼의 무기를 놓다니､ 바보 같은 짓이네､ 응!」"
  },
  {
   "id": 32427,
   "key": "D1305le.txt:248",
   "file": "D1305le.txt",
   "line": 248,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちぃぃぃっ！」",
   "ko_candidate": "「치이이이!」"
  },
  {
   "id": 32428,
   "key": "D1305le.txt:250",
   "file": "D1305le.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "息を継ぐ暇もなく、ビルから翔び立つ。",
   "ko_candidate": "숨 돌릴 틈도 없이 빌딩에서 날아오른다｡"
  },
  {
   "id": 32429,
   "key": "D1305le.txt:260",
   "file": "D1305le.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの拳が高層ビルを粉々に粉砕した。",
   "ko_candidate": "데몬베인의 주먹이 고층 빌딩을 산산조각 냈다｡"
  },
  {
   "id": 32430,
   "key": "D1305le.txt:261",
   "file": "D1305le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛び交う瓦礫を足場に、何度も飛び移り、デモンベインの懐に入り込む。",
   "ko_candidate": "날아다니는 잔해를 발판 삼아 여러 번 뛰어넘어 데몬베인의 품으로 들어간다｡"
  },
  {
   "id": 32431,
   "key": "D1305le.txt:266",
   "file": "D1305le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クトゥグアを招喚。",
   "ko_candidate": "크투가를 소환｡"
  },
  {
   "id": 32432,
   "key": "D1305le.txt:273",
   "file": "D1305le.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "コクピットに向けて発砲する。",
   "ko_candidate": "콕핏을 향해 발포한다｡"
  },
  {
   "id": 32433,
   "key": "D1305le.txt:274",
   "file": "D1305le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "小爆発が起こった……だが、ヒヒイロカネの装甲は傷一つつかない。",
   "ko_candidate": "작은 폭발이 일어났다… 하지만 히히이로카네의 장갑은 흠집 하나 나지 않는다｡"
  },
  {
   "id": 32434,
   "key": "D1305le.txt:281",
   "file": "D1305le.txt",
   "line": 281,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そんな豆鉄砲じゃどうにもならないことぐらい、九郎ちゃんなら理解しているでしょお？」",
   "ko_candidate": "「그런 콩알 총으로는 어떻게 할 수 없다는 걸 쿠로 짜앙이라면 알고 있겠지?」"
  },
  {
   "id": 32435,
   "key": "D1305le.txt:285",
   "file": "D1305le.txt",
   "line": 285,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「糞がぁぁぁぁ！」",
   "ko_candidate": "「젠장아아아아!」"
  },
  {
   "id": 32436,
   "key": "D1305le.txt:291",
   "file": "D1305le.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐ真横を轟音と暴風が通り過ぎる。",
   "ko_candidate": "바로 옆을 굉음과 폭풍이 지나간다｡"
  },
  {
   "id": 32437,
   "key": "D1305le.txt:292",
   "file": "D1305le.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "続けて放たれた、デモンベインの拳が掠ったのだ。",
   "ko_candidate": "연이어 발사된 데몬베인의 주먹이 스쳐 지나간 것이다｡"
  },
  {
   "id": 32438,
   "key": "D1305le.txt:293",
   "file": "D1305le.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風に煽られ、バランスを失う。",
   "ko_candidate": "바람에 휘말려 균형을 잃는다｡"
  },
  {
   "id": 32439,
   "key": "D1305le.txt:294",
   "file": "D1305le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟風に揉みくちゃにされて、錐揉みに落下しかけるのを、黒翼を広げて何とか堪える。",
   "ko_candidate": "폭풍에 휘말려 회전하며 떨어질 뻔한 것을 검은 날개를 펼쳐 간신히 버틴다｡"
  },
  {
   "id": 32440,
   "key": "D1305le.txt:297",
   "file": "D1305le.txt",
   "line": 297,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「큭…!」"
  },
  {
   "id": 32441,
   "key": "D1305le.txt:305",
   "file": "D1305le.txt",
   "line": 305,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大丈夫か？　……さっきは何が起こった？　やはりあの兵器は……」",
   "ko_candidate": "「괜찮아? …아까는 무슨 일이 있었어? 역시 저 무기는…」"
  },
  {
   "id": 32442,
   "key": "D1305le.txt:309",
   "file": "D1305le.txt",
   "line": 309,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ。なんか、すっげぇ嫌われてるみたいだぜ、俺」",
   "ko_candidate": "「아아｡ 뭔가､ 엄청 미움받고 있는 것 같아､ 나」"
  },
  {
   "id": 32443,
   "key": "D1305le.txt:313",
   "file": "D1305le.txt",
   "line": 313,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やはり『ナコト写本』の意思が残っているのか」",
   "ko_candidate": "「역시 『나코트 사본』의 의지가 남아있는 건가」"
  },
  {
   "id": 32444,
   "key": "D1305le.txt:317",
   "file": "D1305le.txt",
   "line": 317,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあな……ちっ、次、来るぞ！」",
   "ko_candidate": "「글쎄… 치､ 다음 공격이 온다!」"
  },
  {
   "id": 32445,
   "key": "D1305le.txt:321",
   "file": "D1305le.txt",
   "line": 321,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあさあ、九郎ちゃーん。あっそびましょーっ！」",
   "ko_candidate": "「자､ 자､ 쿠로 짜앙｡ 놀아볼까아!」"
  }
 ]
}