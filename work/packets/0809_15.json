{
 "packet": "0809_15",
 "scene": "0809",
 "anchor": {
  "hit": 92,
  "total": 121,
  "rate": 0.76
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "アル": "알",
  "魔力": "마력",
  "マギウス・ウィング": "마기우스 윙",
  "アンチクロス": "안티크로스",
  "覇道": "하도"
 },
 "items": [
  {
   "id": 14942,
   "key": "D0809le.txt:129",
   "file": "D0809le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鉄柱に備えつけられたスピーカーが喋る。",
   "ko_candidate": "철주에 설치된 스피커가 말한다｡"
  },
  {
   "id": 14943,
   "key": "D0809le.txt:130",
   "file": "D0809le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目の前には以前、銃を突きつけたまま微動だにしない脱獄囚。",
   "ko_candidate": "눈앞에는 아까 총을 겨눈 채 미동도 않는 탈옥수｡"
  },
  {
   "id": 14944,
   "key": "D0809le.txt:134",
   "file": "D0809le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もしかして……こいつが喋らせているのか？",
   "ko_candidate": "혹시… 이자가 말하게 하는 건가?"
  },
  {
   "id": 14945,
   "key": "D0809le.txt:136",
   "file": "D0809le.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ショーウインドウに並べられているテレビが嘲笑を含めて喋る。",
   "ko_candidate": "쇼윈도에 진열된 텔레비전이 조소를 담아 말한다｡"
  },
  {
   "id": 14946,
   "key": "D0809le.txt:140",
   "file": "D0809le.txt",
   "line": 140,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ここら辺、全部を真っ平らにして、みんな殺しちゃうとか。それならもう誰に遠慮することなく思いっきり……」",
   "ko_candidate": "「이 근처､ 전부 평평하게 만들어서､ 모두 죽여버리는 거라든가｡ 그러면 이제 누구에게도 눈치 볼 필요 없이 마음껏…」"
  },
  {
   "id": 14947,
   "key": "D0809le.txt:149",
   "file": "D0809le.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脱獄囚が俺の前から飛び退いた。",
   "ko_candidate": "탈옥수가 내 앞에서 뛰어올랐다｡"
  },
  {
   "id": 14948,
   "key": "D0809le.txt:151",
   "file": "D0809le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アスファルトの地面が切断されただけだ。",
   "ko_candidate": "아스팔트 바닥이 잘린 것뿐이다｡"
  },
  {
   "id": 14949,
   "key": "D0809le.txt:154",
   "file": "D0809le.txt",
   "line": 154,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……外したか」",
   "ko_candidate": "「…빗나갔나」"
  },
  {
   "id": 14950,
   "key": "D0809le.txt:159",
   "file": "D0809le.txt",
   "line": 159,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おい、九郎……」",
   "ko_candidate": "「이봐､ 쿠로…」"
  },
  {
   "id": 14951,
   "key": "D0809le.txt:164",
   "file": "D0809le.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咎めるアルの声も無視して立ち上がる。",
   "ko_candidate": "꾸짖는 알의 목소리도 무시하고 일어선다｡"
  },
  {
   "id": 14952,
   "key": "D0809le.txt:166",
   "file": "D0809le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腹の傷がまた開き、血が滴っていた。",
   "ko_candidate": "배의 상처가 다시 벌어져､ 피가 떨어지고 있었다｡"
  },
  {
   "id": 14953,
   "key": "D0809le.txt:168",
   "file": "D0809le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ちっ……折れた偃月刀では間合いが足りなかったか。",
   "ko_candidate": "칫… 부러진 언월도로는 간격이 부족했나｡"
  },
  {
   "id": 14954,
   "key": "D0809le.txt:170",
   "file": "D0809le.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力もほとんど消えかかっている。",
   "ko_candidate": "마력도 거의 다 사라져가고 있다｡"
  },
  {
   "id": 14955,
   "key": "D0809le.txt:173",
   "file": "D0809le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しゃあない。未練だが、偃月刀を投げ捨てる。",
   "ko_candidate": "어쩔 수 없다｡ 미련하지만､ 언월도를 던져버린다｡"
  },
  {
   "id": 14956,
   "key": "D0809le.txt:179",
   "file": "D0809le.txt",
   "line": 179,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大事に使えとあれほどっ」",
   "ko_candidate": "「…소중히 쓰라고 그렇게 말했건만」"
  },
  {
   "id": 14957,
   "key": "D0809le.txt:184",
   "file": "D0809le.txt",
   "line": 184,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「説教は後だ」",
   "ko_candidate": "「설교는 나중에」"
  },
  {
   "id": 14958,
   "key": "D0809le.txt:188",
   "file": "D0809le.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両方のマギウス・ウィングを刃状に変形させて身構える。",
   "ko_candidate": "양쪽 마기우스 윙을 칼날 모양으로 변형시켜 자세를 잡는다｡"
  },
  {
   "id": 14959,
   "key": "D0809le.txt:190",
   "file": "D0809le.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつは……見逃すワケにはいかない。",
   "ko_candidate": "이자는… 그냥 보내줄 수 없어｡"
  },
  {
   "id": 14960,
   "key": "D0809le.txt:192",
   "file": "D0809le.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "路上に停められた自動車のカーステレオが最大音量で笑う。",
   "ko_candidate": "길가에 세워진 자동차의 카스테레오가 최대 음량으로 웃는다｡"
  },
  {
   "id": 14961,
   "key": "D0809le.txt:196",
   "file": "D0809le.txt",
   "line": 196,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『あははっ、やっぱり九郎は怒ると強くなるタイプだ。 お約束で恥ずかしい奴』",
   "ko_candidate": "『아하하､ 역시 쿠로는 화나면 강해지는 타입이구나｡ 뻔한 전개라 부끄러운 녀석』"
  },
  {
   "id": 14962,
   "key": "D0809le.txt:201",
   "file": "D0809le.txt",
   "line": 201,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「恥ずかしくて結構……てめえはブッ斃す」",
   "ko_candidate": "「부끄러워도 상관없어… 너는 죽여버릴 테니까」"
  },
  {
   "id": 14963,
   "key": "D0809le.txt:203",
   "file": "D0809le.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ありったけの闘気をぶつける。",
   "ko_candidate": "있는 힘껏 투기를 내뿜는다｡"
  },
  {
   "id": 14964,
   "key": "D0809le.txt:205",
   "file": "D0809le.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気が歪み、地面がひび割れた。",
   "ko_candidate": "대기가 일그러지고､ 땅이 갈라졌다｡"
  },
  {
   "id": 14965,
   "key": "D0809le.txt:207",
   "file": "D0809le.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが脱獄囚は涼しい顔で――いや、仮面で顔は見えないけど――受け流す。",
   "ko_candidate": "하지만 탈옥수는 태연한 얼굴로――아니､ 가면을 써서 얼굴은 안 보이지만――받아넘긴다｡"
  },
  {
   "id": 14966,
   "key": "D0809le.txt:209",
   "file": "D0809le.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうやって対峙したまま、静止。",
   "ko_candidate": "그렇게 대치한 채､ 정지｡"
  },
  {
   "id": 14967,
   "key": "D0809le.txt:211",
   "file": "D0809le.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷や汗が頬を伝う。",
   "ko_candidate": "식은땀이 뺨을 타고 흐른다｡"
  },
  {
   "id": 14968,
   "key": "D0809le.txt:213",
   "file": "D0809le.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……隙がない。それにこの威圧感。",
   "ko_candidate": "젠장… 틈이 없어｡ 게다가 이 위압감｡"
  },
  {
   "id": 14969,
   "key": "D0809le.txt:215",
   "file": "D0809le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アンチクロス級の位階に在ると見て、間違いなさそうだ。",
   "ko_candidate": "안티 크로스급의 위계에 있다고 봐도､ 틀림없을 것 같다｡"
  },
  {
   "id": 14970,
   "key": "D0809le.txt:217",
   "file": "D0809le.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覇道邸のときといい、この前の海といい、立て続けかよ……！",
   "ko_candidate": "하도 저택 때도 그렇고､ 이전 바다에서도 그렇고､ 연달아 나오는 거냐…!"
  },
  {
   "id": 14971,
   "key": "D0809le.txt:221",
   "file": "D0809le.txt",
   "line": 221,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シッ！」",
   "ko_candidate": "「쉿!」"
  },
  {
   "id": 14972,
   "key": "D0809le.txt:233",
   "file": "D0809le.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脱獄囚の拳銃が再び向けられる。冗談じゃない。",
   "ko_candidate": "탈옥수의 권총이 다시 겨눠진다｡ 농담 아니야｡"
  },
  {
   "id": 14973,
   "key": "D0809le.txt:235",
   "file": "D0809le.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狙いを定められるより早く、俺は動いた。",
   "ko_candidate": "조준당하기 전에､ 내가 움직였다｡"
  },
  {
   "id": 14974,
   "key": "D0809le.txt:250",
   "file": "D0809le.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬前まで居た地点を銃弾が穿つ……というより爆発して、アスファルトを抉る。爆風に煽られ、バランスを崩しかけた。",
   "ko_candidate": "잠깐 전까지 있던 지점을 총알이 뚫는다… 라기보다 폭발해서､ 아스팔트를 파낸다｡ 폭풍에 휘말려 균형을 잃을 뻔했다｡"
  },
  {
   "id": 14975,
   "key": "D0809le.txt:252",
   "file": "D0809le.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……って、こんなもん、もう鉄砲でも何でもねえ！",
   "ko_candidate": "…이런 거､ 이제 총도 뭣도 아니잖아!"
  },
  {
   "id": 14976,
   "key": "D0809le.txt:256",
   "file": "D0809le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "とにかく疾る。",
   "ko_candidate": "어쨌든 달린다｡"
  },
  {
   "id": 14977,
   "key": "D0809le.txt:258",
   "file": "D0809le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "撃たれた傷がキリキリ悲鳴をあげているが、それを気にしている場合ではない。もう一発喰らったら、今度こそ御陀仏だ。",
   "ko_candidate": "맞은 상처가 찌릿찌릿 비명을 지르고 있지만､ 그걸 신경 쓸 겨를이 없다｡ 한 발 더 맞으면､ 이번엔 정말 죽는다｡"
  },
  {
   "id": 14978,
   "key": "D0809le.txt:265",
   "file": "D0809le.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逸れた弾丸が地面に炸裂し、アスファルトの破片を撒き散らす。",
   "ko_candidate": "빗나간 총알이 땅에서 폭발하고､ 아스팔트 파편을 흩뿌린다｡"
  },
  {
   "id": 14979,
   "key": "D0809le.txt:267",
   "file": "D0809le.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "信号機が吹っ飛ぶ。",
   "ko_candidate": "신호등이 날아간다｡"
  },
  {
   "id": 14980,
   "key": "D0809le.txt:269",
   "file": "D0809le.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ショーウィンドウが砕けて、着飾ったマネキンの頭が消滅する。",
   "ko_candidate": "쇼윈도가 깨지고､ 치장한 마네킹의 머리가 사라진다｡"
  },
  {
   "id": 14981,
   "key": "D0809le.txt:272",
   "file": "D0809le.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自動車のエンジンを貫通、横転。炎上する……ってヤバイ！",
   "ko_candidate": "자동차 엔진을 관통해 전복｡ 불이 붙는다… 위험해!"
  }
 ]
}