 },
 "items": [
  {
   "id": 11286,
   "key": "D0751.txt:26",
   "file": "D0751.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "視界は限りなくゼロ。",
   "ko_candidate": ""
  },
  {
   "id": 11287,
   "key": "D0751.txt:27",
   "file": "D0751.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "見渡す限り白。白。白。",
   "ko_candidate": ""
  },
  {
   "id": 11288,
   "key": "D0751.txt:28",
   "file": "D0751.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "白に埋め尽くされている。",
   "ko_candidate": ""
  },
  {
   "id": 11289,
   "key": "D0751.txt:47",
   "file": "D0751.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "うねる風の音が耳を打つ。",
   "ko_candidate": ""
  },
  {
   "id": 11290,
   "key": "D0751.txt:48",
   "file": "D0751.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "魔物のうめき声のような、悪意に満ちた風の音。",
   "ko_candidate": ""
  },
  {
   "id": 11291,
   "key": "D0751.txt:67",
   "file": "D0751.txt",
   "line": 67,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「くそ……どこだ！？」",
   "ko_candidate": ""
  },
  {
   "id": 11292,
   "key": "D0751.txt:73",
   "file": "D0751.txt",
   "line": 73,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「九郎！　後ろを……！」",
   "ko_candidate": ""
  },
  {
   "id": 11293,
   "key": "D0751.txt:78",
   "file": "D0751.txt",
   "line": 78,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――――っ！」",
   "ko_candidate": ""
  },
  {
   "id": 11294,
   "key": "D0751.txt:95",
   "file": "D0751.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "燃える瞳が、白い闇に浮かび上がる。反射的にかわそうとするが――足は凍りつき、大地に縫いつけられている。",
   "ko_candidate": ""
  },
  {
   "id": 11295,
   "key": "D0751.txt:98",
   "file": "D0751.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "クソ！　マズ……ッ！",
   "ko_candidate": ""
  },
  {
   "id": 11296,
   "key": "D0751.txt:119",
   "file": "D0751.txt",
   "line": 119,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「うわあああああああ！？」",
   "ko_candidate": ""
  },
  {
   "id": 11297,
   "key": "D0751.txt:138",
   "file": "D0751.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "足を束縛していた氷は砕け、デモンベインは宙を舞う。無様に背中から大地に倒れた。白く凍ったビルがガラス細工のように砕け散る。",
   "ko_candidate": ""
  },
  {
   "id": 11298,
   "key": "D0751.txt:149",
   "file": "D0751.txt",
   "line": 149,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「おのれ……！」",
   "ko_candidate": ""
  },
  {
   "id": 11299,
   "key": "D0751.txt:165",
   "file": "D0751.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "倒れるデモンベインを見下ろす、巨大な影――と呼んでいいものか。",
   "ko_candidate": ""
  },
  {
   "id": 11300,
   "key": "D0751.txt:168",
   "file": "D0751.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "白い、雲のようなもやに包まれた、巨人の姿。ヒト型の雲に、炎える瞳が星のように爛々と輝いている。",
   "ko_candidate": ""
  },
  {
   "id": 11301,
   "key": "D0751.txt:172",
   "file": "D0751.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ページモンスター、イタクァ。",
   "ko_candidate": ""
  },
  {
   "id": 11302,
   "key": "D0751.txt:174",
   "file": "D0751.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "イヌイットの伝承等で、ウェンディゴの名で伝わる旧支配者の一。",
   "ko_candidate": ""
  },
  {
   "id": 11303,
   "key": "D0751.txt:186",
   "file": "D0751.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "これが今回の――アーカムシティを突然襲った大寒波の原因だ。季節外れにもほどがある吹雪に、アーカムシティは白く凍っている。",
   "ko_candidate": ""
  },
  {
   "id": 11304,
   "key": "D0751.txt:192",
   "file": "D0751.txt",
   "line": 192,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「調子に乗るなよっ！」",
   "ko_candidate": ""
  },
  {
   "id": 11305,
   "key": "D0751.txt:211",
   "file": "D0751.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "脚部シールドを開放。爆発的なエネルギーを迸らせて、一気に跳ね起きる。",
   "ko_candidate": ""
  },
  {
   "id": 11306,
   "key": "D0751.txt:217",
   "file": "D0751.txt",
   "line": 217,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「バルザイの偃月刀！」",
   "ko_candidate": ""
  },
  {
   "id": 11307,
   "key": "D0751.txt:236",
   "file": "D0751.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "偃月刀を招喚し、イタクァに斬りかかる――が。",
   "ko_candidate": ""
  },
  {
   "id": 11308,
   "key": "D0751.txt:241",
   "file": "D0751.txt",
   "line": 241,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ぬぉあ！？」",
   "ko_candidate": ""
  },
  {
   "id": 11309,
   "key": "D0751.txt:252",
   "file": "D0751.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "偃月刀は雲のような巨人の身体を捉えるものの、中身はやはり雲のようにスカスカで、そのまますり抜けてしまう。",
   "ko_candidate": ""
  },
  {
   "id": 11310,
   "key": "D0751.txt:255",
   "file": "D0751.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "旋風に巨人の身体がわずかに散った。",
   "ko_candidate": ""
  },
  {
   "id": 11311,
   "key": "D0751.txt:267",
   "file": "D0751.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "クソ……実体が無いのかよ！？",
   "ko_candidate": ""
  },
  {
   "id": 11312,
   "key": "D0751.txt:273",
   "file": "D0751.txt",
   "line": 273,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……！？　くぅっ！」",
   "ko_candidate": ""
  },
  {
   "id": 11313,
   "key": "D0751.txt:284",
   "file": "D0751.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "突風が吹き抜ける。凍った街路樹が、置き去りにされた自動車が、木の葉の如く舞い上げられた。",
   "ko_candidate": ""
  },
  {
   "id": 11314,
   "key": "D0751.txt:287",
   "file": "D0751.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "白く凍れる疾風は、一瞬でデモンベインの装甲を凍りつかせる。",
   "ko_candidate": ""
  },
  {
   "id": 11315,
   "key": "D0751.txt:290",
   "file": "D0751.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "吹雪に視界を遮られる。突風を耐え切り、視界が戻ったときにはイタクァは、もういない。",
   "ko_candidate": ""
  },
  {
   "id": 11316,
   "key": "D0751.txt:310",
   "file": "D0751.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "はるか上空から、炎える瞳でデモンベインを見下ろしている。",
   "ko_candidate": ""
  },
  {
   "id": 11317,
   "key": "D0751.txt:324",
   "file": "D0751.txt",
   "line": 324,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「なんちゅーすばしっこい奴だ！」",
   "ko_candidate": ""
  },
  {
   "id": 11318,
   "key": "D0751.txt:329",
   "file": "D0751.txt",
   "line": 329,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「『風に乗りて歩むもの』の異名を持つ神性だ。捕らえるのは少々、骨が折れるぞ」",
   "ko_candidate": ""
  },
  {
   "id": 11319,
   "key": "D0751.txt:335",
   "file": "D0751.txt",
   "line": 335,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「こっちは空に逃げられちゃ、打つ手が限られちまうしな……チクショウ」",
   "ko_candidate": ""
  },
  {
   "id": 11320,
   "key": "D0751.txt:340",
   "file": "D0751.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "……ページモンスターもだんだん手強くなっている気がするぞ。",
   "ko_candidate": ""
  },
  {
   "id": 11321,
   "key": "D0751.txt:343",
   "file": "D0751.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "高速で空を自在に飛び回る敵に有効な武器つったら何がある？　ロイガーとツァールを投げてもかわされそうだし……",
   "ko_candidate": ""
  },
  {
   "id": 11322,
   "key": "D0751.txt:352",
   "file": "D0751.txt",
   "line": 352,
   "speaker": "チアキ（通信）",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「――九郎ちゃん！ アルちゃん！」",
   "ko_candidate": ""
  },
  {
   "id": 11323,
   "key": "D0751.txt:358",
   "file": "D0751.txt",
   "line": 358,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「どうした！？　戦闘中だぞ！」",
   "ko_candidate": ""
  },
  {
   "id": 11324,
   "key": "D0751.txt:363",
   "file": "D0751.txt",
   "line": 363,
   "speaker": "ソーニャ（通信）",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「クトゥグアの制御ユニットの調整が終わりましたです！　今から転送します！」",
   "ko_candidate": ""
  },
  {
   "id": 11325,
   "key": "D0751.txt:368",
   "file": "D0751.txt",
   "line": 368,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そうか！　頼んだ！」",
   "ko_candidate": ""
  }
 ]
}