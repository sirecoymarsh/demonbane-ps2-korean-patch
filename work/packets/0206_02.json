 "items": [
  {
   "id": 2208,
   "key": "D0206.txt:499",
   "file": "D0206.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大いなる獣！ 聖書の獣！",
   "ko_candidate": "알 덕분에 꼬마들도 무사하다｡"
  },
  {
   "id": 2209,
   "key": "D0206.txt:501",
   "file": "D0206.txt",
   "line": 501,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "七頭十角の獣！",
   "ko_candidate": "하지만――"
  },
  {
   "id": 2210,
   "key": "D0206.txt:512",
   "file": "D0206.txt",
   "line": 512,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『ブラックロッジ』の大導師！ マスターテリオン!?」",
   "ko_candidate": "나는 안도의 한숨을 내쉬면서도 소년이 발한 말의 의미를 검색하고 있었다｡ 즉､ 그것은… 거대한 야수!"
  },
  {
   "id": 2211,
   "key": "D0206.txt:518",
   "file": "D0206.txt",
   "line": 518,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだ！　そして彼奴こそ妾の『敵』だ！」",
   "ko_candidate": "성서의 짐승! 일곱 머리와 열 뿔을 가진 짐승!"
  },
  {
   "id": 2212,
   "key": "D0206.txt:536",
   "file": "D0206.txt",
   "line": 536,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少年――マスターテリオンは、大仰な素振りでお辞儀した。明らかにこっちを馬鹿にした態度だった。",
   "ko_candidate": "「『블랙로지』의 <RUBY text=\"그랜드 마스터\">대도사</RUBY>! 마스터 테리온!?」 「그렇다! 그리고 그 자가 바로 내 『적』이다!」"
  },
  {
   "id": 2213,
   "key": "D0206.txt:541",
   "file": "D0206.txt",
   "line": 541,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「以後お見知りおきを、マスター・オブ・ネクロノミコン」",
   "ko_candidate": "소년――마스터 테리온은 우리를 향해 과장된 몸짓으로 인사했다｡ 명백히 우리를 무시하는 태도였다｡"
  },
  {
   "id": 2214,
   "key": "D0206.txt:544",
   "file": "D0206.txt",
   "line": 544,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「今日はアル・アジフが選んだ新たな術者と直に会ってみたくてね、こうして伺わせてもらった。突然の訪問の無礼を許していただきたい」",
   "ko_candidate": "「앞으로 잘 부탁드립니다､ 네크로노미콘의 마스터｡ 오늘은 알 아지프가 선택한 새로운 술사와 직접 만나보고 싶어서 이렇게 찾아왔습니다｡ 갑작스러운 방문의 무례함을 용서해 주시기 바랍니다」"
  },
  {
   "id": 2215,
   "key": "D0206.txt:550",
   "file": "D0206.txt",
   "line": 550,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はちらりと後ろを盗み見る。",
   "ko_candidate": "나는 살짝 뒤를 훔쳐봤다｡"
  },
  {
   "id": 2216,
   "key": "D0206.txt:552",
   "file": "D0206.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "気を失っているライカさん。",
   "ko_candidate": "기절해 있는 라이카 씨｡"
  },
  {
   "id": 2217,
   "key": "D0206.txt:553",
   "file": "D0206.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "涙で顔をぐしゃぐしゃにして、怯える子どもたち。",
   "ko_candidate": "눈물로 얼굴이 엉망이 된 채 겁에 질린 아이들｡"
  },
  {
   "id": 2218,
   "key": "D0206.txt:555",
   "file": "D0206.txt",
   "line": 555,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "怒りは無尽蔵に沸き立つ。",
   "ko_candidate": "분노가 무한히 솟구친다｡"
  },
  {
   "id": 2219,
   "key": "D0206.txt:561",
   "file": "D0206.txt",
   "line": 561,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「女に手をあげるったぁ、どうも育ちがよろしくないようだなぁ？　このテロリスト野郎が……っ！」",
   "ko_candidate": "「여자에게 손을 대다니､ 어쩐지 교육을 제대로 못 받은 것 같군? 이 테러리스트 자식아……!」"
  },
  {
   "id": 2220,
   "key": "D0206.txt:568",
   "file": "D0206.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺の言葉に、マスターテリオンは「はて？」と、しばし考え込むような仕草を見せた。 ややあって、納得したように微笑みかける。",
   "ko_candidate": "내 말에 마스터 테리온은 「음?」하며 잠시 생각에 잠기는 듯한 몸짓을 보였다｡ 잠시 후､ 납득한 듯이 미소 지었다｡"
  },
  {
   "id": 2221,
   "key": "D0206.txt:578",
   "file": "D0206.txt",
   "line": 578,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああ……先程のシスターか。それは済まなかった。余は、地を這う蟲けらに気を付けながら歩けるほど、神経質ではなくてな」",
   "ko_candidate": "「아아… 아까 그 수녀 말이군｡ 그건 미안했어｡ 나는 땅을 기어다니는 벌레들을 조심하며 걸을 만큼 신경질적이지 않거든」"
  },
  {
   "id": 2222,
   "key": "D0206.txt:583",
   "file": "D0206.txt",
   "line": 583,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――――――――ッッッッ！」",
   "ko_candidate": "「――――――――――!」"
  },
  {
   "id": 2223,
   "key": "D0206.txt:591",
   "file": "D0206.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "完全にブチ切れた。目の前が真っ白になる。",
   "ko_candidate": "완전히 열받았다｡ 눈앞이 하얘진다｡"
  },
  {
   "id": 2224,
   "key": "D0206.txt:592",
   "file": "D0206.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "金縛りが解けた。",
   "ko_candidate": "금제가 풀렸다｡"
  },
  {
   "id": 2225,
   "key": "D0206.txt:594",
   "file": "D0206.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "酷く身体が軽くなった気がする。",
   "ko_candidate": "몸이 굉장히 가벼워진 것 같다｡"
  },
  {
   "id": 2226,
   "key": "D0206.txt:595",
   "file": "D0206.txt",
   "line": 595,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちょっとした浮遊感。",
   "ko_candidate": "약간의 부유감｡"
  },
  {
   "id": 2227,
   "key": "D0206.txt:596",
   "file": "D0206.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、拳に衝撃。",
   "ko_candidate": "그리고 주먹에 충격｡"
  },
  {
   "id": 2228,
   "key": "D0206.txt:605",
   "file": "D0206.txt",
   "line": 605,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ッッ！」",
   "ko_candidate": "「……!」"
  },
  {
   "id": 2229,
   "key": "D0206.txt:621",
   "file": "D0206.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "気が付いた時には全力で、マスターテリオンを殴り飛ばしていた。教会の壁をぶち抜いて、外まで吹き飛ぶマスターテリオンの身体。",
   "ko_candidate": "정신을 차렸을 때는 전력으로 마스터 테리온을 날려버리고 있었다｡ 교회의 벽을 뚫고 밖으로 날아가는 마스터 테리온의 몸｡"
  },
  {
   "id": 2230,
   "key": "D0206.txt:638",
   "file": "D0206.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は床を蹴り、すぐさま、その後を追った。",
   "ko_candidate": "나는 바닥을 박차고 곧바로 그 뒤를 쫓았다｡"
  },
  {
   "id": 2231,
   "key": "D0206.txt:640",
   "file": "D0206.txt",
   "line": 640,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "未だに宙を舞い続けるマスターテリオン。",
   "ko_candidate": "아직도 공중을 날아다니는 마스터 테리온｡"
  },
  {
   "id": 2232,
   "key": "D0206.txt:641",
   "file": "D0206.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "不意に、不自然な慣性が少年を捉えた。",
   "ko_candidate": "갑자기 부자연스러운 관성이 소년을 붙잡았다｡"
  },
  {
   "id": 2233,
   "key": "D0206.txt:643",
   "file": "D0206.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "身に纏った法衣をはためかせ、空中で一回転した。",
   "ko_candidate": "걸친 법의를 펄럭이며 공중에서 한 바퀴 돌았다｡"
  },
  {
   "id": 2234,
   "key": "D0206.txt:646",
   "file": "D0206.txt",
   "line": 646,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "優雅に、地面に着地する。",
   "ko_candidate": "우아하게 땅에 착지한다｡"
  },
  {
   "id": 2235,
   "key": "D0206.txt:648",
   "file": "D0206.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "口の端から伝う血を舐め取り、微笑んだ。",
   "ko_candidate": "입가에 흐르는 피를 핥아내고 미소 지었다｡"
  },
  {
   "id": 2236,
   "key": "D0206.txt:657",
   "file": "D0206.txt",
   "line": 657,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「防禦陣を撃ち抜き、余の躰に触れるとはな。潜在的な魔力はどうして中々のものではないか」",
   "ko_candidate": "「방어진을 뚫고 내 몸에 닿다니｡ 잠재적인 마력이 꽤나 대단하군」"
  },
  {
   "id": 2237,
   "key": "D0206.txt:664",
   "file": "D0206.txt",
   "line": 664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この野郎……どこまでも癪に触る！",
   "ko_candidate": "이 자식… 어디까지나 짜증 나게!"
  },
  {
   "id": 2238,
   "key": "D0206.txt:682",
   "file": "D0206.txt",
   "line": 682,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「余裕こいてるんじゃねえよ！」",
   "ko_candidate": "「여유 부리지 마!」"
  },
  {
   "id": 2239,
   "key": "D0206.txt:685",
   "file": "D0206.txt",
   "line": 685,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怒りに流されるまま、俺はもう一度、マスターテリオンに飛びかかった。 その大層な美形ヅラ……整形が必要なくらいにボコボコにしてやる！",
   "ko_candidate": "분노에 휩싸인 채 나는 다시 한 번 마스터 테리온에게 달려들었다｡ 저 잘난 미남 얼굴… 성형이 필요할 정도로 박살내 주겠어!"
  },
  {
   "id": 2240,
   "key": "D0206.txt:704",
   "file": "D0206.txt",
   "line": 704,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「待て、九郎！　熱くなるな！」",
   "ko_candidate": "「기다려､ 쿠로! 흥분하지 마!」"
  },
  {
   "id": 2241,
   "key": "D0206.txt:709",
   "file": "D0206.txt",
   "line": 709,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "耳元で叫ぶアル・アジフの叫びすら届かなかった。",
   "ko_candidate": "귓가에 외치는 알 아지프의 외침조차 들리지 않았다｡"
  },
  {
   "id": 2242,
   "key": "D0206.txt:716",
   "file": "D0206.txt",
   "line": 716,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "右拳に集中する魔力。荒れ狂う力が迸り、大気中に放電していた。",
   "ko_candidate": "오른 주먹에 집중되는 마력｡ 거칠게 날뛰는 힘이 솟구쳐 대기 중에 방전되고 있었다｡"
  },
  {
   "id": 2243,
   "key": "D0206.txt:717",
   "file": "D0206.txt",
   "line": 717,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "必殺の威力を込めた一撃を振り下ろす！",
   "ko_candidate": "필살의 위력을 담은 일격을 마스터 테리온에게 내리쳤다!"
  },
  {
   "id": 2244,
   "key": "D0206.txt:732",
   "file": "D0206.txt",
   "line": 732,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆砕した。",
   "ko_candidate": "폭쇄했다｡"
  },
  {
   "id": 2245,
   "key": "D0206.txt:733",
   "file": "D0206.txt",
   "line": 733,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "舞い上がる土砂。えぐれる地面。",
   "ko_candidate": "날아오르는 토사｡ 파이는 지면｡"
  },
  {
   "id": 2246,
   "key": "D0206.txt:736",
   "file": "D0206.txt",
   "line": 736,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど――マスターテリオンの姿はそこには無い。",
   "ko_candidate": "하지만――마스터 테리온의 모습은 거기에 없다｡"
  },
  {
   "id": 2247,
   "key": "D0206.txt:738",
   "file": "D0206.txt",
   "line": 738,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "馬鹿なっ!?",
   "ko_candidate": "말도 안 돼!?"
  }
 ]
}