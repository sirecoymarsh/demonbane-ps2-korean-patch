 "items": [
  {
   "id": 38810,
   "key": "D1410le.txt:342",
   "file": "D1410le.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手に持った『クトゥグア』で受け止める。否。むしろこっちから刀に向かわせる勢いで叩きつけた。",
   "ko_candidate": "손에 든 『크투가』로 막아낸다｡ 아니｡ 오히려 이쪽에서 칼을 향해 세게 내리쳤다｡"
  },
  {
   "id": 38811,
   "key": "D1410le.txt:348",
   "file": "D1410le.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――空薬莢が床に落ちて跳ね返る。",
   "ko_candidate": "――탄피가 바닥에 떨어져 튕긴다｡"
  },
  {
   "id": 38812,
   "key": "D1410le.txt:359",
   "file": "D1410le.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれた皇餓の刀と『クトゥグア』が宙を舞った。",
   "ko_candidate": "튕겨난 황아의 칼과 『크투가』가 공중을 날았다｡"
  },
  {
   "id": 38813,
   "key": "D1410le.txt:360",
   "file": "D1410le.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２刀目をやり過ごした。しかしこれで終わりではない。",
   "ko_candidate": "두 번째 칼을 피했다｡ 하지만 이걸로 끝이 아니다｡"
  },
  {
   "id": 38814,
   "key": "D1410le.txt:365",
   "file": "D1410le.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺はそのことを執事さんから教えてもらっている。",
   "ko_candidate": "나는 그 사실을 집사님에게 들었다｡"
  },
  {
   "id": 38815,
   "key": "D1410le.txt:366",
   "file": "D1410le.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはまったく予期せぬ方向から襲いかかってくるのだ。",
   "ko_candidate": "그것은 전혀 예상치 못한 방향에서 덮쳐올 것이다｡"
  },
  {
   "id": 38816,
   "key": "D1410le.txt:367",
   "file": "D1410le.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何故なら……！",
   "ko_candidate": "왜냐하면…!"
  },
  {
   "id": 38817,
   "key": "D1410le.txt:375",
   "file": "D1410le.txt",
   "line": 375,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「二刀流じゃないからさ！」",
   "ko_candidate": "「이도류가 아니니까!」"
  },
  {
   "id": 38818,
   "key": "D1410le.txt:384",
   "file": "D1410le.txt",
   "line": 384,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「斬ッ！」",
   "ko_candidate": "「베어라!」"
  },
  {
   "id": 38819,
   "key": "D1410le.txt:387",
   "file": "D1410le.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皇餓の両脇腹から刀を持った腕が出現する！",
   "ko_candidate": "황아의 양 옆구리에서 칼을 든 팔이 나타난다!"
  },
  {
   "id": 38820,
   "key": "D1410le.txt:396",
   "file": "D1410le.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３刀目と４刀目がデモンベインを挟み込むように空間を横に迅る。",
   "ko_candidate": "세 번째와 네 번째 칼이 데몬베인을 끼워 넣듯이 공간을 가로지른다｡"
  },
  {
   "id": 38821,
   "key": "D1410le.txt:397",
   "file": "D1410le.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそこに、もうデモンベインの姿はない。",
   "ko_candidate": "하지만 거기에 이미 데몬베인의 모습은 없다｡"
  },
  {
   "id": 38822,
   "key": "D1410le.txt:402",
   "file": "D1410le.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はデモンベインの脚部シールドのエネルギーを爆砕させて、跳躍していた。",
   "ko_candidate": "나는 데몬베인의 다리 부분 실드의 에너지를 폭발시켜 도약했다｡"
  },
  {
   "id": 38823,
   "key": "D1410le.txt:407",
   "file": "D1410le.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちょうど落ちようとしていた『クトゥグア』を空中でキャッチする。",
   "ko_candidate": "마침 떨어지려던 『크투가』를 공중에서 캐치한다｡"
  },
  {
   "id": 38824,
   "key": "D1410le.txt:408",
   "file": "D1410le.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "照準もそこそこに眼下の皇餓に向けて、引鉄を引く！",
   "ko_candidate": "조준도 대충 아래의 황아를 향해 방아쇠를 당긴다!"
  },
  {
   "id": 38825,
   "key": "D1410le.txt:420",
   "file": "D1410le.txt",
   "line": 420,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『クトゥグア』の弾丸が皇餓の４本の腕を吹き飛ばす。",
   "ko_candidate": "『크투가』의 총알이 황아의 네 팔을 날려버린다｡"
  },
  {
   "id": 38826,
   "key": "D1410le.txt:421",
   "file": "D1410le.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこで弾切れ。",
   "ko_candidate": "그때 탄환이 떨어졌다｡"
  },
  {
   "id": 38827,
   "key": "D1410le.txt:423",
   "file": "D1410le.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは皇餓の頭上に落ちようとしていた。",
   "ko_candidate": "데몬베인은 황아의 머리 위로 떨어지려 하고 있었다｡"
  },
  {
   "id": 38828,
   "key": "D1410le.txt:425",
   "file": "D1410le.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃を投げ捨て、右掌に魔力を集中。内蔵された必殺兵器のシステムが稼動する！　俺は右腕を振り上げた。",
   "ko_candidate": "총을 던져버리고 오른손바닥에 마력을 집중한다｡ 내장된 필살 무기의 시스템이 가동한다! 나는 오른팔을 들어올렸다｡"
  },
  {
   "id": 38829,
   "key": "D1410le.txt:432",
   "file": "D1410le.txt",
   "line": 432,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「斬ッッッッッッ！」",
   "ko_candidate": "「베어라아아아아아!」"
  },
  {
   "id": 38830,
   "key": "D1410le.txt:435",
   "file": "D1410le.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭をもたげ、背面を晒す皇餓。",
   "ko_candidate": "고개를 들어 등을 드러내는 황아｡"
  },
  {
   "id": 38831,
   "key": "D1410le.txt:437",
   "file": "D1410le.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その皇餓の背中から三振りの刀が飛び出した！",
   "ko_candidate": "그 황아의 등에서 세 자루의 칼이 튀어나왔다!"
  },
  {
   "id": 38832,
   "key": "D1410le.txt:439",
   "file": "D1410le.txt",
   "line": 439,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "落ちてくるデモンベインを迎え撃つ！",
   "ko_candidate": "떨어지는 데몬베인을 맞아치려 한다!"
  },
  {
   "id": 38833,
   "key": "D1410le.txt:443",
   "file": "D1410le.txt",
   "line": 443,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「レムリア・インパクト！」",
   "ko_candidate": "「레무리아 임팩트!」"
  },
  {
   "id": 38834,
   "key": "D1410le.txt:447",
   "file": "D1410le.txt",
   "line": 447,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「征けぇぇぇぇぇぇぇぇぇ！」",
   "ko_candidate": "「가라아아아아아아아아!」"
  },
  {
   "id": 38835,
   "key": "D1410le.txt:454",
   "file": "D1410le.txt",
   "line": 454,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 38836,
   "key": "D1410le.txt:460",
   "file": "D1410le.txt",
   "line": 460,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……デモンベインの掌底は三振りの刀を粉砕し、そのまま皇蛾の背中に突き刺さった。",
   "ko_candidate": "…데몬베인의 손바닥은 세 자루의 칼을 부수고 그대로 황아의 등에 꽂혔다｡"
  },
  {
   "id": 38837,
   "key": "D1410le.txt:461",
   "file": "D1410le.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両機、しばしそのままの状態で静止する。",
   "ko_candidate": "양쪽 기체､ 잠시 그대로의 상태로 정지한다｡"
  },
  {
   "id": 38838,
   "key": "D1410le.txt:467",
   "file": "D1410le.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初に動いたのは俺の方。",
   "ko_candidate": "먼저 움직인 건 내 쪽이었다｡"
  },
  {
   "id": 38839,
   "key": "D1410le.txt:468",
   "file": "D1410le.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右腕を引き抜き、そのまま皇餓に背を向ける。",
   "ko_candidate": "오른팔을 뽑아내고 그대로 황아에게 등을 돌린다｡"
  },
  {
   "id": 38840,
   "key": "D1410le.txt:476",
   "file": "D1410le.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皇餓が身を起こす。",
   "ko_candidate": "황아가 몸을 일으킨다｡"
  },
  {
   "id": 38841,
   "key": "D1410le.txt:477",
   "file": "D1410le.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが振り返る必要はない。先へ、進もう。",
   "ko_candidate": "하지만 돌아볼 필요는 없다｡ 앞으로､ 나아가자｡"
  },
  {
   "id": 38842,
   "key": "D1410le.txt:479",
   "file": "D1410le.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皇餓一機だけを残し、俺はこの空間を去った。",
   "ko_candidate": "황아 한 대만을 남기고 나는 이 공간을 떠났다｡"
  },
  {
   "id": 38843,
   "key": "D1410le.txt:488",
   "file": "D1410le.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "立ち尽くす皇蛾のコクピットの中で立ち尽くすティトゥス。",
   "ko_candidate": "우두커니 서 있는 황아의 콕핏 안에서 우두커니 서 있는 티투스｡"
  },
  {
   "id": 38844,
   "key": "D1410le.txt:490",
   "file": "D1410le.txt",
   "line": 490,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "４本の腕を生やしたその姿は異形。",
   "ko_candidate": "네 개의 팔을 가진 그 모습은 기괴하다｡"
  },
  {
   "id": 38845,
   "key": "D1410le.txt:491",
   "file": "D1410le.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正道に背き、人外の境地を求めた末に手に入れた化物の躰だった。",
   "ko_candidate": "정도에 어긋나 인간 이상의 경지를 추구한 끝에 얻은 괴물의 몸이었다｡"
  },
  {
   "id": 38846,
   "key": "D1410le.txt:495",
   "file": "D1410le.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、魔人の力が己に何をもたらしてくれただろうか？",
   "ko_candidate": "하지만 마인의 힘이 자신에게 무엇을 가져다주었을까?"
  },
  {
   "id": 38847,
   "key": "D1410le.txt:497",
   "file": "D1410le.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今になってティトゥスは自問する。",
   "ko_candidate": "이제 와서 티투스는 자문한다｡"
  },
  {
   "id": 38848,
   "key": "D1410le.txt:498",
   "file": "D1410le.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦場を求め、闘争に渇き、人ではもう駄目だと。人を超えた領域で戦わなければ決して癒されぬと思っていた。",
   "ko_candidate": "전장을 찾고 투쟁에 목말라하며 인간으로는 이제 안 된다고｡ 인간을 넘어선 영역에서 싸우지 않으면 결코 치유되지 않는다고 생각했다｡"
  },
  {
   "id": 38849,
   "key": "D1410le.txt:500",
   "file": "D1410le.txt",
   "line": 500,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、其処に踏み入れて何が在った？",
   "ko_candidate": "하지만 그곳에 들어서서 무엇이 있었나?"
  }
 ]
}