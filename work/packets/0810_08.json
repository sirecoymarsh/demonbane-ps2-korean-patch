 "items": [
  {
   "id": 15564,
   "key": "D0810al.txt:1372",
   "file": "D0810al.txt",
   "line": 1372,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "赤熱し、融解するデモンベインの右半身。",
   "ko_candidate": "붉게 달아오르고､ 융해되는 데몬베인의 오른쪽 반신｡"
  },
  {
   "id": 15565,
   "key": "D0810al.txt:1381",
   "file": "D0810al.txt",
   "line": 1381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凍りつき、罅割れていく左半身。",
   "ko_candidate": "얼어붙고､ 갈라져가는 왼쪽 반신｡"
  },
  {
   "id": 15566,
   "key": "D0810al.txt:1387",
   "file": "D0810al.txt",
   "line": 1387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鬩ぎ合い、交じり合う魔力が、デモンベインを少しずつ蝕んでゆく。",
   "ko_candidate": "다투고､ 뒤섞이는 마력이 데몬베인을 조금씩 좀먹어간다｡"
  },
  {
   "id": 15567,
   "key": "D0810al.txt:1388",
   "file": "D0810al.txt",
   "line": 1388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――まだだ。",
   "ko_candidate": "――아직이다｡"
  },
  {
   "id": 15568,
   "key": "D0810al.txt:1392",
   "file": "D0810al.txt",
   "line": 1392,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎――――――ッッッ！」",
   "ko_candidate": "「쿠로――――――!」"
  },
  {
   "id": 15569,
   "key": "D0810al.txt:1397",
   "file": "D0810al.txt",
   "line": 1397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだまだ……まだまだだ。",
   "ko_candidate": "아직 아직… 아직 아직이다｡"
  },
  {
   "id": 15570,
   "key": "D0810al.txt:1398",
   "file": "D0810al.txt",
   "line": 1398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな曖昧な、茫洋とした容ではなく。",
   "ko_candidate": "이런 애매한､ 아득한 형태가 아니라｡"
  },
  {
   "id": 15571,
   "key": "D0810al.txt:1399",
   "file": "D0810al.txt",
   "line": 1399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もっと確かに、もっと烈しく――殺意よ、容となれ。",
   "ko_candidate": "더욱 확실하게､ 더욱 격렬하게――살의여､ 형태가 되어라｡"
  },
  {
   "id": 15572,
   "key": "D0810al.txt:1409",
   "file": "D0810al.txt",
   "line": 1409,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だったら――力を貸してあげるよ、 大十字九郎」",
   "ko_candidate": "「그렇다면――힘을 빌려줄게､ 다이쥬지 쿠로」"
  },
  {
   "id": 15573,
   "key": "D0810al.txt:1418",
   "file": "D0810al.txt",
   "line": 1418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――――――!?",
   "ko_candidate": "――――――!?"
  },
  {
   "id": 15574,
   "key": "D0810al.txt:1420",
   "file": "D0810al.txt",
   "line": 1420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かが、俺の意識に囁きかけた。",
   "ko_candidate": "무언가가､ 내 의식에 속삭였다｡"
  },
  {
   "id": 15575,
   "key": "D0810al.txt:1421",
   "file": "D0810al.txt",
   "line": 1421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞬間、俺の識らない術式が、強制的に紡がれた。",
   "ko_candidate": "그 순간､ 내가 알지 못하는 술식이 강제적으로 짜여졌다｡"
  },
  {
   "id": 15576,
   "key": "D0810al.txt:1423",
   "file": "D0810al.txt",
   "line": 1423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この感覚は――！",
   "ko_candidate": "이 감각은――!"
  },
  {
   "id": 15577,
   "key": "D0810al.txt:1429",
   "file": "D0810al.txt",
   "line": 1429,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "殺意が実体を結び、質量を獲得する。",
   "ko_candidate": "살의가 실체를 이루고､ 질량을 획득한다｡"
  },
  {
   "id": 15578,
   "key": "D0810al.txt:1430",
   "file": "D0810al.txt",
   "line": 1430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "実空間に顕現する。",
   "ko_candidate": "실제 공간에 현현한다｡"
  },
  {
   "id": 15579,
   "key": "D0810al.txt:1442",
   "file": "D0810al.txt",
   "line": 1442,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「霊圧値３万８千ぇぇぇぇんっ！　だ、駄目ですっ！　暴発しちゃいます――――――ぅぅぅぅぅぅ！」",
   "ko_candidate": "「영압값 3만 8천이이이잇! 안､ 안 됩니다! 폭발해버려요―――――우우우우우우!」"
  },
  {
   "id": 15580,
   "key": "D0810al.txt:1446",
   "file": "D0810al.txt",
   "line": 1446,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん！　止まって下さい！　大十字さん！」",
   "ko_candidate": "「다이쥬지 씨! 멈춰주세요! 다이쥬지 씨!」"
  },
  {
   "id": 15581,
   "key": "D0810al.txt:1449",
   "file": "D0810al.txt",
   "line": 1449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力の膨張は既に危険域に突入していた。",
   "ko_candidate": "마력의 팽창은 이미 위험 영역에 돌입해 있었다｡"
  },
  {
   "id": 15582,
   "key": "D0810al.txt:1451",
   "file": "D0810al.txt",
   "line": 1451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もし、このまま臨界を超えてしまえば――あの区画が吹っ飛ぶどころの騒ぎではない。致命的な呪的汚染に見舞われ、生命を寄せつけない死の荒野と化す。",
   "ko_candidate": "만약､ 이대로 임계를 넘어버린다면――그 구역이 날아가는 정도의 소동이 아니다｡ 치명적인 주술적 오염에 휩싸여､ 생명을 가까이 할 수 없는 죽음의 황야로 변한다｡"
  },
  {
   "id": 15583,
   "key": "D0810al.txt:1453",
   "file": "D0810al.txt",
   "line": 1453,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちょうど永久封鎖された１３区画―― 通称『第２焼野』の様に。",
   "ko_candidate": "마침 영구 봉쇄된 13구역――통칭 『제2 야케노』처럼｡"
  },
  {
   "id": 15584,
   "key": "D0810al.txt:1458",
   "file": "D0810al.txt",
   "line": 1458,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「きゃ――――！　きゃ――――！　きゃぁぁぁぁぁぁぁ――――！」",
   "ko_candidate": "「꺄――――! 꺄――――! 꺄아아아아아아아――――!」"
  },
  {
   "id": 15585,
   "key": "D0810al.txt:1462",
   "file": "D0810al.txt",
   "line": 1462,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――お待ち下さい。様子が変です」",
   "ko_candidate": "「――잠깐만요｡ 상황이 이상합니다」"
  },
  {
   "id": 15586,
   "key": "D0810al.txt:1466",
   "file": "D0810al.txt",
   "line": 1466,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何が、ですか？」",
   "ko_candidate": "「…무엇이 말입니까?」"
  },
  {
   "id": 15587,
   "key": "D0810al.txt:1471",
   "file": "D0810al.txt",
   "line": 1471,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――字祷子圧縮、情報化。新術式を構成。神獣内の術式に介入し、情報を書き換えます」 「神獣、情報体へと分解、 再結晶。超高密度の字祷子を内包したまま、まったく新たな魔導物質へと顕在化します」",
   "ko_candidate": "「――자도자 압축､ 정보화｡ 새로운 술식을 구성｡ 신수 내의 술식에 개입하여 정보를 다시 씁니다｡ 신수､ 정보체로 분해､ 재결정｡ 초고밀도의 인과율자를 내포한 채､ 완전히 새로운 마도물질로 현재화합니다」"
  },
  {
   "id": 15588,
   "key": "D0810al.txt:1479",
   "file": "D0810al.txt",
   "line": 1479,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……はあ？」",
   "ko_candidate": "「…하아?」"
  },
  {
   "id": 15589,
   "key": "D0810al.txt:1483",
   "file": "D0810al.txt",
   "line": 1483,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な――神獣が……ッ！」",
   "ko_candidate": "「뭐――신수가…!」"
  },
  {
   "id": 15590,
   "key": "D0810al.txt:1495",
   "file": "D0810al.txt",
   "line": 1495,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「汝……そいつは……！」",
   "ko_candidate": "「너… 그놈은…!」"
  },
  {
   "id": 15591,
   "key": "D0810al.txt:1498",
   "file": "D0810al.txt",
   "line": 1498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "畏れ慄くように、呟きを洩らすアル。",
   "ko_candidate": "두려워 떨듯이､ 중얼거리는 알｡"
  },
  {
   "id": 15592,
   "key": "D0810al.txt:1499",
   "file": "D0810al.txt",
   "line": 1499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２体の神獣が、目の前で姿を変える――。",
   "ko_candidate": "2체의 신수가 눈앞에서 모습을 바꾼다――｡"
  },
  {
   "id": 15593,
   "key": "D0810al.txt:1512",
   "file": "D0810al.txt",
   "line": 1512,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……クトゥグア」",
   "ko_candidate": "「…크투가」"
  },
  {
   "id": 15594,
   "key": "D0810al.txt:1523",
   "file": "D0810al.txt",
   "line": 1523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒れ狂う焔を纏った獣を、放電する光として圧縮。",
   "ko_candidate": "광란하는 불꽃을 두른 짐승을､ 방전하는 빛으로 압축｡"
  },
  {
   "id": 15595,
   "key": "D0810al.txt:1524",
   "file": "D0810al.txt",
   "line": 1524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在力の密度を増し、物質化。",
   "ko_candidate": "존재력의 밀도를 높이고､ 물질화｡"
  },
  {
   "id": 15596,
   "key": "D0810al.txt:1525",
   "file": "D0810al.txt",
   "line": 1525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは右手を伸ばす。",
   "ko_candidate": "데몬베인은 오른손을 편다｡"
  },
  {
   "id": 15597,
   "key": "D0810al.txt:1536",
   "file": "D0810al.txt",
   "line": 1536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重厚なる黒。苛烈なる赤。装飾を施されながらも無骨。何より凶暴。",
   "ko_candidate": "중후한 검정｡ 가혹한 붉은색｡ 장식이 되어 있으면서도 투박함｡ 무엇보다 흉포함｡"
  },
  {
   "id": 15598,
   "key": "D0810al.txt:1536",
   "file": "D0810al.txt",
   "line": 1536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "前面下方に設置された弾倉に闘志を装填する破壊の象徴。",
   "ko_candidate": "전면 하방에 설치된 탄창에 투지를 장전하는 파괴의 상징｡"
  },
  {
   "id": 15599,
   "key": "D0810al.txt:1537",
   "file": "D0810al.txt",
   "line": 1537,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自動拳銃『クトゥグア』。",
   "ko_candidate": "자동 권총 『크투가』｡"
  },
  {
   "id": 15600,
   "key": "D0810al.txt:1554",
   "file": "D0810al.txt",
   "line": 1554,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……イタクァ」",
   "ko_candidate": "「…이타콰」"
  },
  {
   "id": 15601,
   "key": "D0810al.txt:1563",
   "file": "D0810al.txt",
   "line": 1563,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き荒む冷気を纏った竜を、沈黙する結晶として圧縮。",
   "ko_candidate": "휘몰아치는 냉기를 두른 용을､ 침묵하는 결정으로 압축｡"
  },
  {
   "id": 15602,
   "key": "D0810al.txt:1564",
   "file": "D0810al.txt",
   "line": 1564,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在力の密度を増し、物質化。",
   "ko_candidate": "존재력의 밀도를 높이고､ 물질화｡"
  },
  {
   "id": 15603,
   "key": "D0810al.txt:1565",
   "file": "D0810al.txt",
   "line": 1565,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは左手を伸ばす。",
   "ko_candidate": "데몬베인은 왼손을 편다｡"
  }
 ]
