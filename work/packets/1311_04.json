 },
 "items": [
  {
   "id": 35146,
   "key": "D1311al.txt:469",
   "file": "D1311al.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "祝詞の様な呪詛の様な異界の言葉――いや、それは解読できない、人間の理解を超えた、異形に棲まうもの共の聲だ。",
   "ko_candidate": "축사 같기도 저주 같기도 한 이계의 언어――아니､ 그것은 해독할 수 없는､ 인간의 이해를 초월한､ 기괴한 존재들의 목소리다｡"
  },
  {
   "id": 35147,
   "key": "D1311al.txt:471",
   "file": "D1311al.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが異形の呪文は、 やがて意味の解かる言葉へと変わっていく。",
   "ko_candidate": "하지만 기괴한 주문은 이내 의미를 알 수 있는 말로 바뀌어간다｡"
  },
  {
   "id": 35148,
   "key": "D1311al.txt:473",
   "file": "D1311al.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聲が、告げた。",
   "ko_candidate": "목소리가 고했다｡"
  },
  {
   "id": 35149,
   "key": "D1311al.txt:479",
   "file": "D1311al.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちは、同時に呟いた。",
   "ko_candidate": "우리는 동시에 중얼거렸다｡"
  },
  {
   "id": 35150,
   "key": "D1311al.txt:486",
   "file": "D1311al.txt",
   "line": 486,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「輝く……」",
   "ko_candidate": "「빛나는…」"
  },
  {
   "id": 35151,
   "key": "D1311al.txt:493",
   "file": "D1311al.txt",
   "line": 493,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「トラペゾヘドロン……だと？」",
   "ko_candidate": "「트라페조헤드론… 이라고?」"
  },
  {
   "id": 35152,
   "key": "D1311al.txt:504",
   "file": "D1311al.txt",
   "line": 504,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――然り！」",
   "ko_candidate": "「――그렇다!」"
  },
  {
   "id": 35153,
   "key": "D1311al.txt:518",
   "file": "D1311al.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――そして、戦場は異界と化した。",
   "ko_candidate": "――그리고 전장은 이계로 변했다｡"
  },
  {
   "id": 35154,
   "key": "D1311al.txt:525",
   "file": "D1311al.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が集う。",
   "ko_candidate": "어둠이 모인다｡"
  },
  {
   "id": 35155,
   "key": "D1311al.txt:526",
   "file": "D1311al.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が集う。",
   "ko_candidate": "어둠이 모인다｡"
  },
  {
   "id": 35156,
   "key": "D1311al.txt:527",
   "file": "D1311al.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が集う。",
   "ko_candidate": "어둠이 모인다｡"
  },
  {
   "id": 35157,
   "key": "D1311al.txt:529",
   "file": "D1311al.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歪んだ、狂った、悶える、異形の闇が集う。",
   "ko_candidate": "일그러진､ 미친､ 몸부림치는､ 기괴한 어둠이 모인다｡"
  },
  {
   "id": 35158,
   "key": "D1311al.txt:539",
   "file": "D1311al.txt",
   "line": 539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が集う。",
   "ko_candidate": "빛이 모인다｡"
  },
  {
   "id": 35159,
   "key": "D1311al.txt:540",
   "file": "D1311al.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が集う。",
   "ko_candidate": "빛이 모인다｡"
  },
  {
   "id": 35160,
   "key": "D1311al.txt:541",
   "file": "D1311al.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が集う。",
   "ko_candidate": "빛이 모인다｡"
  },
  {
   "id": 35161,
   "key": "D1311al.txt:543",
   "file": "D1311al.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒ぶる、吼える、嘲笑う、異形の光が集う。",
   "ko_candidate": "거칠게 날뛰는､ 포효하는､ 조소하는､ 기괴한 빛이 모인다｡"
  },
  {
   "id": 35162,
   "key": "D1311al.txt:553",
   "file": "D1311al.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の極限に位置する",
   "ko_candidate": "어둠의 극한에 위치한"
  },
  {
   "id": 35163,
   "key": "D1311al.txt:554",
   "file": "D1311al.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の極限に位置する",
   "ko_candidate": "빛의 극한에 위치한"
  },
  {
   "id": 35164,
   "key": "D1311al.txt:556",
   "file": "D1311al.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処は異界。在り得てはならぬ世界。",
   "ko_candidate": "여기는 이계｡ 있어서는 안 될 세계｡"
  },
  {
   "id": 35165,
   "key": "D1311al.txt:557",
   "file": "D1311al.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "矛盾の巣窟、",
   "ko_candidate": "모순의 소굴､"
  },
  {
   "id": 35166,
   "key": "D1311al.txt:557",
   "file": "D1311al.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の綻び、",
   "ko_candidate": "세계의 흐트러짐､"
  },
  {
   "id": 35167,
   "key": "D1311al.txt:557",
   "file": "D1311al.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神々の禁忌。",
   "ko_candidate": "신들의 금기｡"
  },
  {
   "id": 35168,
   "key": "D1311al.txt:559",
   "file": "D1311al.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処は決戦場。",
   "ko_candidate": "여기는 결전장｡"
  },
  {
   "id": 35169,
   "key": "D1311al.txt:561",
   "file": "D1311al.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否、一方的な蹂躙を決戦とは呼ばない、",
   "ko_candidate": "아니､ 일방적인 유린을 결전이라 부르지 않는다｡"
  },
  {
   "id": 35170,
   "key": "D1311al.txt:563",
   "file": "D1311al.txt",
   "line": 563,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処は処刑場。",
   "ko_candidate": "여기는 처형장｡"
  },
  {
   "id": 35171,
   "key": "D1311al.txt:564",
   "file": "D1311al.txt",
   "line": 564,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶対的な権威を以て、デモンベインが魔を裁く。",
   "ko_candidate": "절대적인 권위로 데몬베인이 마를 심판한다｡"
  },
  {
   "id": 35172,
   "key": "D1311al.txt:568",
   "file": "D1311al.txt",
   "line": 568,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――――――――――――――――ッッッッッ!?」",
   "ko_candidate": "「――――――――――――――――――엇!?」"
  },
  {
   "id": 35173,
   "key": "D1311al.txt:572",
   "file": "D1311al.txt",
   "line": 572,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの恐怖が伝わってくる。",
   "ko_candidate": "티베리우스의 공포가 전해져 온다｡"
  },
  {
   "id": 35174,
   "key": "D1311al.txt:573",
   "file": "D1311al.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれはこちらも同じことだった。",
   "ko_candidate": "하지만 그것은 이쪽도 마찬가지였다｡"
  },
  {
   "id": 35175,
   "key": "D1311al.txt:575",
   "file": "D1311al.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まったく制御が出来ない。暴走している。こちらの意図とは関係なく、デモンベインはただ定められた仕事を為そうとしている。",
   "ko_candidate": "전혀 제어가 되지 않는다｡ 폭주하고 있다｡ 이쪽의 의도와는 관계없이 데몬베인은 그저 정해진 일을 하려 하고 있다｡"
  },
  {
   "id": 35176,
   "key": "D1311al.txt:582",
   "file": "D1311al.txt",
   "line": 582,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "レムリア・インパクトのエネルギーを込めた右掌を突き出した。",
   "ko_candidate": "레무리아 임팩트의 에너지를 담은 오른손바닥을 내밀었다｡"
  },
  {
   "id": 35177,
   "key": "D1311al.txt:582",
   "file": "D1311al.txt",
   "line": 582,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右掌から何かが現出する。",
   "ko_candidate": "오른손바닥에서 무언가가 나타난다｡"
  },
  {
   "id": 35178,
   "key": "D1311al.txt:584",
   "file": "D1311al.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の塊。",
   "ko_candidate": "어둠의 덩어리｡"
  },
  {
   "id": 35179,
   "key": "D1311al.txt:585",
   "file": "D1311al.txt",
   "line": 585,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲の光景をも歪ませ、飲み込む圧倒的な闇。",
   "ko_candidate": "주변의 광경마저 왜곡시키고､ 삼켜버리는 압도적인 어둠｡"
  },
  {
   "id": 35180,
   "key": "D1311al.txt:588",
   "file": "D1311al.txt",
   "line": 588,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ブラックホール……!?」",
   "ko_candidate": "「블랙홀……!?」"
  },
  {
   "id": 35181,
   "key": "D1311al.txt:590",
   "file": "D1311al.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ブラックホールは更に周囲を歪ませ、 終いには次元そのものをも歪ませてしまう。",
   "ko_candidate": "블랙홀은 더욱 주변을 왜곡시키고､ 마침내는 차원 그 자체마저 왜곡시켜 버린다｡ 눈앞에 차원의 균열이 펼쳐졌다｡"
  },
  {
   "id": 35182,
   "key": "D1311al.txt:592",
   "file": "D1311al.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "眼前に次元の裂け目が広がった。 裂け目の中から何かが頭を覗かせていた。デモンベインはそれを手に取り、引きずり出した。全体が姿を現す。",
   "ko_candidate": "균열 속에서 무언가가 머리를 내밀고 있었다｡ 데몬베인은 그것을 손에 잡고､ 끌어당겼다｡ 전체가 모습을 드러낸다｡"
  },
  {
   "id": 35183,
   "key": "D1311al.txt:600",
   "file": "D1311al.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……どう表現すれば良いのだろう？",
   "ko_candidate": "……어떻게 표현하면 좋을까?"
  },
  {
   "id": 35184,
   "key": "D1311al.txt:601",
   "file": "D1311al.txt",
   "line": 601,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "捻じ曲がった神柱。狂った神樹。刃の無い神剣……ともかく酷く異形じみた物質であった。",
   "ko_candidate": "뒤틀린 신주｡ 미친 신수｡ 날 없는 신검……어쨌든 몹시 기괴한 물질이었다｡"
  },
  {
   "id": 35185,
   "key": "D1311al.txt:603",
   "file": "D1311al.txt",
   "line": 603,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして、その中心―― 夢の中で見た、あの黒い結晶体が――",
   "ko_candidate": "그리고､ 그 중심에――꿈속에서 본､ 그 검은 결정체가――"
  }
 ]
}