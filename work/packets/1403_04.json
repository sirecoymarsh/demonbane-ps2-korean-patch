 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "クトゥルー": "크툴루",
  "姫さん": "공주님",
  "ルルイエ": "르뤼에"
 },
 "items": [
  {
   "id": 36938,
   "key": "D1403ru.txt:188",
   "file": "D1403ru.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の主要都市を襲撃するワケでもない。降伏を勧告するワケでもない。",
   "ko_candidate": "세계의 주요 도시를 습격하는 것도 아니다｡ 항복을 권고하는 것도 아니다｡"
  },
  {
   "id": 36939,
   "key": "D1403ru.txt:190",
   "file": "D1403ru.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何を考えているんだ……？",
   "ko_candidate": "무엇을 생각하고 있는 거지…?"
  },
  {
   "id": 36940,
   "key": "D1403ru.txt:191",
   "file": "D1403ru.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "答えの出ない思考のスパイラルに迷い込みそうになったそのとき、隣のアルが深刻な声で呟いた。",
   "ko_candidate": "답이 나오지 않는 사고의 나선에 빠져들 뻔했을 때､ 옆의 알이 심각한 목소리로 중얼거렸다｡"
  },
  {
   "id": 36941,
   "key": "D1403ru.txt:198",
   "file": "D1403ru.txt",
   "line": 198,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……南緯４７度９分、西経１２６度４３分」",
   "ko_candidate": "「…남위 47도 9분､ 서경 126도 43분」"
  },
  {
   "id": 36942,
   "key": "D1403ru.txt:202",
   "file": "D1403ru.txt",
   "line": 202,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はあ？」",
   "ko_candidate": "「뭐?」"
  },
  {
   "id": 36943,
   "key": "D1403ru.txt:208",
   "file": "D1403ru.txt",
   "line": 208,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クトゥルーの目指しておる場所だ」",
   "ko_candidate": "「크툴루가 향하고 있는 장소다」"
  },
  {
   "id": 36944,
   "key": "D1403ru.txt:213",
   "file": "D1403ru.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "んなこと言ったって……世界地図のその場所に目を向ける。",
   "ko_candidate": "그렇게 말해도… 세계 지도의 그 장소에 눈을 돌린다｡"
  },
  {
   "id": 36945,
   "key": "D1403ru.txt:215",
   "file": "D1403ru.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "単なる海だ。近くには何もありはしない。",
   "ko_candidate": "단순한 바다다｡ 근처에는 아무것도 없다｡"
  },
  {
   "id": 36946,
   "key": "D1403ru.txt:216",
   "file": "D1403ru.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "全然、分からないのだが……。",
   "ko_candidate": "전혀､ 모르겠는데…"
  },
  {
   "id": 36947,
   "key": "D1403ru.txt:218",
   "file": "D1403ru.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし姫さんにはピンと来るものがあったらしい。",
   "ko_candidate": "하지만 공주님에게는 무언가 떠오르는 게 있었던 모양이다｡"
  },
  {
   "id": 36948,
   "key": "D1403ru.txt:219",
   "file": "D1403ru.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緊張に汗ばみながら、アルの言葉を継ぐ。",
   "ko_candidate": "긴장으로 땀을 흘리며､ 알의 말을 이어받는다｡"
  },
  {
   "id": 36949,
   "key": "D1403ru.txt:224",
   "file": "D1403ru.txt",
   "line": 224,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「１９２５年３月２３日！　アラート号事件！」",
   "ko_candidate": "「1925년 3월 23일! 얼러트호 사건!」"
  },
  {
   "id": 36950,
   "key": "D1403ru.txt:228",
   "file": "D1403ru.txt",
   "line": 228,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何それ？」",
   "ko_candidate": "「…그게 뭐야?」"
  },
  {
   "id": 36951,
   "key": "D1403ru.txt:235",
   "file": "D1403ru.txt",
   "line": 235,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お爺様が随分と熱心に調査していた事件です」 「武装快速艇アラート号の遭難。乗組員達はかの海域で正体不明の怪異と遭遇したと言います。海底から浮上した、何かに――」",
   "ko_candidate": "「할아버지께서 상당히 열심히 조사하고 계셨던 사건입니다｡ 무장 쾌속정 얼러트호의 조난｡ 승무원들은 그 해역에서 정체불명의 괴이와 조우했다고 합니다｡ 해저에서 부상한､ 무언가와―」"
  },
  {
   "id": 36952,
   "key": "D1403ru.txt:242",
   "file": "D1403ru.txt",
   "line": 242,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そ、それって……」",
   "ko_candidate": "「그､ 그럼…」"
  },
  {
   "id": 36953,
   "key": "D1403ru.txt:247",
   "file": "D1403ru.txt",
   "line": 247,
   "speaker": "アル / 瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ルルイエだ。クトゥルーが治める海底都市。彼奴は自らの城を浮上させるつもりなのだ」 「……ルルイエを拠点に、地球制覇に乗り出す気ですか」",
   "ko_candidate": "「르뤼에다｡ 크툴루가 다스리는 해저 도시｡ 놈은 자신의 성을 부상시키려는 모양이다」"
  },
  {
   "id": 36954,
   "key": "D1403ru.txt:258",
   "file": "D1403ru.txt",
   "line": 258,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ルルイエ。恐らくは大陸規模の大きさを持つ、異形の都市だ」",
   "ko_candidate": "「…르뤼에를 거점으로､ 지구 제패에 나설 생각인가요」"
  },
  {
   "id": 36955,
   "key": "D1403ru.txt:261",
   "file": "D1403ru.txt",
   "line": 261,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんな都市が撒き散らす瘴気の量はどれ程のものか」 「……浮上するだけで人類の文明は灰燼と化すであろうな」",
   "ko_candidate": "「르뤼에｡ 아마도 대륙급의 크기를 가진､ 기괴한 도시일 거다｡ 그런 도시가 뿜어내는 장기의 양은 얼마나 될까｡ …부상하는 것만으로도 인류의 문명은 잿더미가 되겠지」"
  },
  {
   "id": 36956,
   "key": "D1403ru.txt:267",
   "file": "D1403ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重たい沈黙が訪れた。",
   "ko_candidate": "무거운 침묵이 찾아왔다｡"
  },
  {
   "id": 36957,
   "key": "D1403ru.txt:268",
   "file": "D1403ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "事態は刻一刻と破滅の一途を、急激な勢いで突き進む。",
   "ko_candidate": "사태는 시시각각 파멸의 일로를､ 급격한 기세로 돌진한다｡"
  },
  {
   "id": 36958,
   "key": "D1403ru.txt:269",
   "file": "D1403ru.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒトに過ぎぬこの身で、その絶対的な破滅に立ち向かう手段が、果たしてあるのだろうか？",
   "ko_candidate": "인간에 불과한 이 몸으로､ 그 절대적인 파멸에 맞설 수단이､ 과연 있을까?"
  },
  {
   "id": 36959,
   "key": "D1403ru.txt:271",
   "file": "D1403ru.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや……",
   "ko_candidate": "아니…"
  },
  {
   "id": 36960,
   "key": "D1403ru.txt:278",
   "file": "D1403ru.txt",
   "line": 278,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……絶対に阻止せねばなりません」",
   "ko_candidate": "「…절대로 저지해야만 합니다」"
  },
  {
   "id": 36961,
   "key": "D1403ru.txt:283",
   "file": "D1403ru.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの声が沈黙を鋭く貫く。",
   "ko_candidate": "공주님의 목소리가 침묵을 날카롭게 꿰뚫는다｡"
  },
  {
   "id": 36962,
   "key": "D1403ru.txt:284",
   "file": "D1403ru.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。出来る出来ないの問題ではない。",
   "ko_candidate": "그렇다｡ 할 수 있느냐 없느냐의 문제가 아니다｡"
  },
  {
   "id": 36963,
   "key": "D1403ru.txt:285",
   "file": "D1403ru.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やらなければ……地球が滅びる。",
   "ko_candidate": "하지 않으면… 지구가 멸망한다｡"
  },
  {
   "id": 36964,
   "key": "D1403ru.txt:288",
   "file": "D1403ru.txt",
   "line": 288,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「俺たちの手で、クトゥルーを斃すんだ」",
   "ko_candidate": "「우리들의 손으로､ 크툴루를 쓰러뜨리자」"
  }
 ]
}