 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アンチクロス": "안티크로스",
  "カリグラ": "칼리굴라",
  "魔力": "마력",
  "マギウス・ウィング": "마기우스 윙",
  "クラウディウス": "클라우디우스",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 14622,
   "key": "D0809al.txt:1401",
   "file": "D0809al.txt",
   "line": 1401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……やはり、アンチクロス２匹相手は分が悪すぎるか。",
   "ko_candidate": "…역시､ 안티크로스 2마리를 상대로는 불리하군｡"
  },
  {
   "id": 14623,
   "key": "D0809al.txt:1402",
   "file": "D0809al.txt",
   "line": 1402,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か勝算はないのか？",
   "ko_candidate": "뭔가 승산은 없을까?"
  },
  {
   "id": 14624,
   "key": "D0809al.txt:1407",
   "file": "D0809al.txt",
   "line": 1407,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「力を出し惜しムな。一気にケリをつけるぞ！」",
   "ko_candidate": "「힘을 아끼지 마라｡ 한 번에 결판을 내자!」"
  },
  {
   "id": 14625,
   "key": "D0809al.txt:1413",
   "file": "D0809al.txt",
   "line": 1413,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「指図すんな、デブ！」",
   "ko_candidate": "「지시하지 마､ 뚱보!」"
  },
  {
   "id": 14626,
   "key": "D0809al.txt:1417",
   "file": "D0809al.txt",
   "line": 1417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラが頭上で両手を堅く繋ぎ合わせる。",
   "ko_candidate": "칼리굴라가 머리 위에서 양손을 단단히 맞잡는다｡"
  },
  {
   "id": 14627,
   "key": "D0809al.txt:1417",
   "file": "D0809al.txt",
   "line": 1417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "純然たる魔力は純粋たる目的のために高まり、結晶する。",
   "ko_candidate": "순수한 마력이 순수한 목적을 위해 높아지고､ 결정화된다｡"
  },
  {
   "id": 14628,
   "key": "D0809al.txt:1418",
   "file": "D0809al.txt",
   "line": 1418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは即ち純粋たる破壊。",
   "ko_candidate": "그것은 곧 순수한 파괴｡"
  },
  {
   "id": 14629,
   "key": "D0809al.txt:1424",
   "file": "D0809al.txt",
   "line": 1424,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「マギウス・ウィング！」",
   "ko_candidate": "「마기우스 윙!」"
  },
  {
   "id": 14630,
   "key": "D0809al.txt:1435",
   "file": "D0809al.txt",
   "line": 1435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "危険を察したときにはもう、ロケット弾の如く宙に飛翔する。",
   "ko_candidate": "위험을 감지했을 때는 이미､ 로켓탄처럼 공중으로 날아오른다｡"
  },
  {
   "id": 14631,
   "key": "D0809al.txt:1436",
   "file": "D0809al.txt",
   "line": 1436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音が下の方から聴こえた。",
   "ko_candidate": "폭음이 아래쪽에서 들렸다｡"
  },
  {
   "id": 14632,
   "key": "D0809al.txt:1439",
   "file": "D0809al.txt",
   "line": 1439,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッッ!?」",
   "ko_candidate": "「………¨읏읏!?」"
  },
  {
   "id": 14633,
   "key": "D0809al.txt:1446",
   "file": "D0809al.txt",
   "line": 1446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――間一髪。",
   "ko_candidate": "――아슬아슬했다｡"
  },
  {
   "id": 14634,
   "key": "D0809al.txt:1448",
   "file": "D0809al.txt",
   "line": 1448,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地面は巨大なハンマーで殴られたかの如くひび割れ、陥没し、土煙をあげながら崩れ落ちた。",
   "ko_candidate": "지면은 거대한 망치로 내리친 것처럼 갈라지고､ 함몰되며､ 흙먼지를 일으키며 무너져 내렸다｡"
  },
  {
   "id": 14635,
   "key": "D0809al.txt:1449",
   "file": "D0809al.txt",
   "line": 1449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "近くのビルが巻き込まれ、斜めに傾いでいく。",
   "ko_candidate": "근처의 빌딩이 휘말려 비스듬히 기울어진다｡"
  },
  {
   "id": 14636,
   "key": "D0809al.txt:1451",
   "file": "D0809al.txt",
   "line": 1451,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "チクショウ……！　クソふざけた破壊力だっ！",
   "ko_candidate": "젠장…! 엄청난 파괴력이잖아!"
  },
  {
   "id": 14637,
   "key": "D0809al.txt:1453",
   "file": "D0809al.txt",
   "line": 1453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空に逃れたからといって、安心してはいられなかった。",
   "ko_candidate": "상공으로 피했다고 해서､ 안심할 수는 없었다｡"
  },
  {
   "id": 14638,
   "key": "D0809al.txt:1456",
   "file": "D0809al.txt",
   "line": 1456,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 14639,
   "key": "D0809al.txt:1467",
   "file": "D0809al.txt",
   "line": 1467,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "プレッシャーがもの凄いスピードで迫ってきた。",
   "ko_candidate": "프레셔가 엄청난 속도로 다가왔다｡"
  },
  {
   "id": 14640,
   "key": "D0809al.txt:1468",
   "file": "D0809al.txt",
   "line": 1468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空を翔ぶ俺に向かって、猛スピードで接近する影がある……！",
   "ko_candidate": "하늘을 나는 나를 향해､ 맹렬한 속도로 접근하는 그림자가 있다…!"
  },
  {
   "id": 14641,
   "key": "D0809al.txt:1471",
   "file": "D0809al.txt",
   "line": 1471,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クラウディウス!?」",
   "ko_candidate": "「클라우디우스!?」"
  },
  {
   "id": 14642,
   "key": "D0809al.txt:1476",
   "file": "D0809al.txt",
   "line": 1476,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「飛べるのはてめえだけじゃねーんだよ！」",
   "ko_candidate": "「날 수 있는 건 너뿐만이 아니라고!」"
  },
  {
   "id": 14643,
   "key": "D0809al.txt:1480",
   "file": "D0809al.txt",
   "line": 1480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛ぶ――と言うより、空を疾走すると呼ぶのが相応しい。",
   "ko_candidate": "날다――라기보다는､ 하늘을 질주한다고 부르는 게 어울린다｡"
  },
  {
   "id": 14644,
   "key": "D0809al.txt:1480",
   "file": "D0809al.txt",
   "line": 1480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風を足場とし、クラウディウスが一気に駆け上ってくる！",
   "ko_candidate": "바람을 발판 삼아､ 클라우디우스가 단숨에 달려 올라온다!"
  },
  {
   "id": 14645,
   "key": "D0809al.txt:1485",
   "file": "D0809al.txt",
   "line": 1485,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「イア！　イア！　ハスタァァァァァ――――ッ！」",
   "ko_candidate": "「이야! 이야! 하스터어어어어어――――읏!」"
  },
  {
   "id": 14646,
   "key": "D0809al.txt:1489",
   "file": "D0809al.txt",
   "line": 1489,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾走りながら、交差させた両腕を勢いよく振った。",
   "ko_candidate": "질주하면서､ 교차시킨 양팔을 힘차게 휘둘렀다｡"
  },
  {
   "id": 14647,
   "key": "D0809al.txt:1490",
   "file": "D0809al.txt",
   "line": 1490,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両腕に纏った真空刃が、十字になって放たれる。",
   "ko_candidate": "양팔에 감긴 진공날이 십자가 모양으로 방출된다｡"
  },
  {
   "id": 14648,
   "key": "D0809al.txt:1491",
   "file": "D0809al.txt",
   "line": 1491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その威力は今までの比ではない――！",
   "ko_candidate": "그 위력은 지금까지와는 비교도 안 된다――!"
  },
  {
   "id": 14649,
   "key": "D0809al.txt:1496",
   "file": "D0809al.txt",
   "line": 1496,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐああああああああああああ！」",
   "ko_candidate": "「구아아아아아아아아아아아아!」"
  },
  {
   "id": 14650,
   "key": "D0809al.txt:1498",
   "file": "D0809al.txt",
   "line": 1498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の刃が、俺の胸を十字に裂いた。",
   "ko_candidate": "바람의 칼날이 내 가슴을 십자로 갈랐다｡"
  },
  {
   "id": 14651,
   "key": "D0809al.txt:1499",
   "file": "D0809al.txt",
   "line": 1499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やや遅れ、鮮血が迸る。",
   "ko_candidate": "약간 늦게､ 선혈이 튀어 오른다｡"
  },
  {
   "id": 14652,
   "key": "D0809al.txt:1500",
   "file": "D0809al.txt",
   "line": 1500,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の雨を降り注がせる。",
   "ko_candidate": "피의 비를 내리게 한다｡"
  },
  {
   "id": 14653,
   "key": "D0809al.txt:1503",
   "file": "D0809al.txt",
   "line": 1503,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ああああ……っ！」",
   "ko_candidate": "「아… 아아아아…읏!」"
  },
  {
   "id": 14654,
   "key": "D0809al.txt:1508",
   "file": "D0809al.txt",
   "line": 1508,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎――――ッ！」",
   "ko_candidate": "「쿠로――――읏!」"
  },
  {
   "id": 14655,
   "key": "D0809al.txt:1514",
   "file": "D0809al.txt",
   "line": 1514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が一瞬、途絶えた。",
   "ko_candidate": "의식이 순간､ 끊겼다｡"
  },
  {
   "id": 14656,
   "key": "D0809al.txt:1515",
   "file": "D0809al.txt",
   "line": 1515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "集中力を失い、マギウス・ウィングが紙片になって解けていく。",
   "ko_candidate": "집중력을 잃고､ 마기우스 윙이 종이 조각이 되어 풀어진다｡"
  },
  {
   "id": 14657,
   "key": "D0809al.txt:1524",
   "file": "D0809al.txt",
   "line": 1524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は傾ぐビルの屋上にある貯水タンクに墜落した。",
   "ko_candidate": "나는 기울어진 빌딩의 옥상에 있는 저수 탱크에 추락했다｡"
  },
  {
   "id": 14658,
   "key": "D0809al.txt:1525",
   "file": "D0809al.txt",
   "line": 1525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ブチ壊れた貯水タンクから水が一斉に溢れ出す。",
   "ko_candidate": "부서진 저수 탱크에서 물이 일제히 넘쳐흐른다｡"
  },
  {
   "id": 14659,
   "key": "D0809al.txt:1526",
   "file": "D0809al.txt",
   "line": 1526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "流れ出る水は、俺の血が混じって、紅に染まる。",
   "ko_candidate": "흘러나오는 물은 내 피가 섞여 붉게 물든다｡"
  },
  {
   "id": 14660,
   "key": "D0809al.txt:1532",
   "file": "D0809al.txt",
   "line": 1532,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「拙い……傷が深いぞ！」",
   "ko_candidate": "「좋지 않아… 상처가 깊어!」"
  },
  {
   "id": 14661,
   "key": "D0809al.txt:1536",
   "file": "D0809al.txt",
   "line": 1536,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「冷てぇな……チクショウ！」",
   "ko_candidate": "「차갑군… 젠장!」"
  }
 ]
}