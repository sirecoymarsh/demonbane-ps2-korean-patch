 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "デモンベイン": "데몬베인",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 48575,
   "key": "D1519.txt:194",
   "file": "D1519.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、遅すぎた。",
   "ko_candidate": "하지만､ 너무 늦었다｡"
  },
  {
   "id": 48576,
   "key": "D1519.txt:197",
   "file": "D1519.txt",
   "line": 197,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アル……！　お前、何を……！」",
   "ko_candidate": "「알……! 네가 무슨……!」"
  },
  {
   "id": 48577,
   "key": "D1519.txt:206",
   "file": "D1519.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声が形になる前に、俺は光になる。",
   "ko_candidate": "목소리가 형태를 갖추기도 전에､ 나는 빛이 된다｡"
  },
  {
   "id": 48578,
   "key": "D1519.txt:207",
   "file": "D1519.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "翡翠の瞳に涙を湛えた、 アルの笑顔をただ見つめるだけ。",
   "ko_candidate": "비취빛 눈동자에 눈물을 머금은､ 알의 미소를 그저 바라볼 뿐｡"
  },
  {
   "id": 48579,
   "key": "D1519.txt:210",
   "file": "D1519.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは一瞬に違いないが、 酷く永くその笑顔が灼きついている。",
   "ko_candidate": "그것은 순간에 불과하지만､ 지독하게 오랫동안 그 미소가 새겨져 있다｡"
  },
  {
   "id": 48580,
   "key": "D1519.txt:213",
   "file": "D1519.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それもいつか失われる。",
   "ko_candidate": "하지만､ 그것마저 언젠가는 사라진다｡"
  },
  {
   "id": 48581,
   "key": "D1519.txt:219",
   "file": "D1519.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠のいていく。",
   "ko_candidate": "멀어져 간다｡"
  },
  {
   "id": 48582,
   "key": "D1519.txt:224",
   "file": "D1519.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルの笑顔が、星の海に取り残されたデモンベインが、みるみる小さくなっていく。",
   "ko_candidate": "알의 미소가､ 별의 바다에 남겨진 데몬베인이､ 눈 깜짝할 사이에 작아져 간다｡"
  },
  {
   "id": 48583,
   "key": "D1519.txt:227",
   "file": "D1519.txt",
   "line": 227,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「馬鹿野郎！　何、勝手なことしてやがる！ ずっと一緒に居るって……そう決めたのに！ 何でお前は……クソ！」",
   "ko_candidate": "「이 바보야! 뭘 마음대로 하는 거야! 계속 함께 있자고 ……그렇게 정했잖아! 왜 너는……젠장!」"
  },
  {
   "id": 48584,
   "key": "D1519.txt:236",
   "file": "D1519.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "叫ぼうと聞こえるはずもない。",
   "ko_candidate": "외치려 해도 들릴 리 없다｡"
  },
  {
   "id": 48585,
   "key": "D1519.txt:237",
   "file": "D1519.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手を伸ばそうと届くはずもない。",
   "ko_candidate": "손을 뻗어도 닿을 리 없다｡"
  },
  {
   "id": 48586,
   "key": "D1519.txt:238",
   "file": "D1519.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掴みたい総てはすり抜けていく。",
   "ko_candidate": "잡고 싶은 모든 것이 빠져나간다｡"
  },
  {
   "id": 48587,
   "key": "D1519.txt:240",
   "file": "D1519.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは、酷い孤独感だった。",
   "ko_candidate": "그것은､ 지독한 고독감이었다｡"
  },
  {
   "id": 48588,
   "key": "D1519.txt:246",
   "file": "D1519.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無慈悲にも暖かく、 あの街の灯火が心の中に拡がっていく。",
   "ko_candidate": "무자비하게도 따뜻하게､ 그 거리의 불빛이 마음속에 퍼져간다｡"
  },
  {
   "id": 48589,
   "key": "D1519.txt:250",
   "file": "D1519.txt",
   "line": 250,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アル――――――――――――――ッ！」",
   "ko_candidate": "「알――――――――――――――!」"
  },
  {
   "id": 48590,
   "key": "D1519.txt:260",
   "file": "D1519.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "完全に眠りについたデモンベインの中で、",
   "ko_candidate": "완전히 잠든 데몬베인 안에서､ 알은 쿠로가 사라져도"
  },
  {
   "id": 48591,
   "key": "D1519.txt:261",
   "file": "D1519.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルは九郎が消えてもなお微笑み続けていた。",
   "ko_candidate": "여전히 미소 짓고 있었다｡"
  },
  {
   "id": 48592,
   "key": "D1519.txt:263",
   "file": "D1519.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かな声で、戦友に語りかける。",
   "ko_candidate": "조용한 목소리로､ 전우에게 말을 건넨다｡"
  },
  {
   "id": 48593,
   "key": "D1519.txt:269",
   "file": "D1519.txt",
   "line": 269,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ……デモンベイン。 共に往こうか。それにしても……」",
   "ko_candidate": "「자……데몬베인｡ 함께 가볼까｡ 그나저나……」"
  },
  {
   "id": 48594,
   "key": "D1519.txt:277",
   "file": "D1519.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "囁いて……堪えた涙が、遂に零れ出す。",
   "ko_candidate": "속삭이며……참았던 눈물이､ 마침내 흘러나온다｡"
  },
  {
   "id": 48595,
   "key": "D1519.txt:278",
   "file": "D1519.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぽろぽろと。止め処もなく。",
   "ko_candidate": "뚝뚝｡ 멈출 줄 모르고｡"
  },
  {
   "id": 48596,
   "key": "D1519.txt:282",
   "file": "D1519.txt",
   "line": 282,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それにしても、独りで居るには此処は少々寒いなぁ……」",
   "ko_candidate": "「그나저나､ 혼자 있기엔 여긴 좀 춥구나……」"
  },
  {
   "id": 48597,
   "key": "D1519.txt:285",
   "file": "D1519.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでもアルは微笑み続ける。",
   "ko_candidate": "그래도 알은 계속 미소 짓는다｡"
  },
  {
   "id": 48598,
   "key": "D1519.txt:286",
   "file": "D1519.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣きながら、微笑み続ける。",
   "ko_candidate": "울면서､ 계속 미소 짓는다｡"
  },
  {
   "id": 48599,
   "key": "D1519.txt:293",
   "file": "D1519.txt",
   "line": 293,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……この旅の果てに、何処か暖かい場所に辿り着けると良いのだが」",
   "ko_candidate": "「……이 여행의 끝에､ 어딘가 따뜻한 곳에 도착할 수 있으면 좋겠어」"
  },
  {
   "id": 48600,
   "key": "D1519.txt:296",
   "file": "D1519.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――そして其処に、九郎が待っていてくれたら、 どんなに素晴らしいことだろうな。",
   "ko_candidate": "――그리고 거기에､ 쿠로가 기다리고 있다면､ 얼마나 멋진 일일까｡"
  },
  {
   "id": 48601,
   "key": "D1519.txt:299",
   "file": "D1519.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎を想って、微笑み続ける。",
   "ko_candidate": "쿠로를 생각하며､ 계속 미소 짓는다｡"
  },
  {
   "id": 48602,
   "key": "D1519.txt:300",
   "file": "D1519.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつまでも、微笑み続ける――",
   "ko_candidate": "언제까지나､ 계속 미소 짓는다――"
  },
  {
   "id": 48603,
   "key": "D1519.txt:311",
   "file": "D1519.txt",
   "line": 311,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……馬鹿野郎」",
   "ko_candidate": "「……이 바보야」"
  },
  {
   "id": 48604,
   "key": "D1519.txt:315",
   "file": "D1519.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜空を眺めながら、ゆっくりと落ちていく。",
   "ko_candidate": "밤하늘을 바라보며､ 천천히 떨어져 간다｡"
  },
  {
   "id": 48605,
   "key": "D1519.txt:316",
   "file": "D1519.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地上から見る星は、宇宙の星ほどには眩くはない。",
   "ko_candidate": "지상에서 보는 별은､ 우주의 별만큼 눈부시지 않다｡"
  },
  {
   "id": 48606,
   "key": "D1519.txt:318",
   "file": "D1519.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれは、優しく暖かな輝きを帯びていた。",
   "ko_candidate": "하지만 그것은､ 부드럽고 따뜻한 빛을 띠고 있었다｡"
  },
  {
   "id": 48607,
   "key": "D1519.txt:319",
   "file": "D1519.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "結局、宇宙の星も地上の星も等しく美しい。",
   "ko_candidate": "결국､ 우주의 별도 지상의 별도 똑같이 아름답다｡"
  },
  {
   "id": 48608,
   "key": "D1519.txt:322",
   "file": "D1519.txt",
   "line": 322,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……馬鹿野郎」",
   "ko_candidate": "「……이 바보야」"
  },
  {
   "id": 48609,
   "key": "D1519.txt:324",
   "file": "D1519.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜空を眺めながら、ゆっくりと落ちていく。",
   "ko_candidate": "밤하늘을 바라보며､ 천천히 떨어져 간다｡"
  },
  {
   "id": 48610,
   "key": "D1519.txt:325",
   "file": "D1519.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その星の瞬きとは別に、 綺羅綺羅と光る別の何を見つけた。",
   "ko_candidate": "그 별의 반짝임과는 별개로､ 반짝반짝 빛나는 다른 무언가를 발견했다｡"
  },
  {
   "id": 48611,
   "key": "D1519.txt:327",
   "file": "D1519.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは一瞬、綺麗に輝くと すぐに闇に呑まれて消えてゆく。",
   "ko_candidate": "그것은 순간､ 아름답게 빛나다가 곧 어둠에 삼켜져 사라져 간다｡"
  },
  {
   "id": 48612,
   "key": "D1519.txt:330",
   "file": "D1519.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ああ、何だ。",
   "ko_candidate": "아아､ 뭐지｡"
  },
  {
   "id": 48613,
   "key": "D1519.txt:331",
   "file": "D1519.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何てことはない。",
   "ko_candidate": "별거 아니었다｡"
  },
  {
   "id": 48614,
   "key": "D1519.txt:333",
   "file": "D1519.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はようやく、自分が泣いていることに気づいた。",
   "ko_candidate": "나는 드디어､ 내가 울고 있다는 것을 깨달았다｡"
  }
 ]
}