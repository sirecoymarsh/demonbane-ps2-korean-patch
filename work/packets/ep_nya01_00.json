{
 "packet": "ep_nya01_00",
 "scene": "ep_nya01",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "姫さん": "공주님"
 },
 "items": [
  {
   "id": 49895,
   "key": "ep_nya01.txt:14",
   "file": "ep_nya01.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "凌辱は、終わること無く果てること無く、 永遠に続いた。",
   "ko_candidate": "「능욕과 쾌락은 끝나지 않고 다하지 않으며 영원히 계속되었다｡」"
  },
  {
   "id": 49896,
   "key": "ep_nya01.txt:16",
   "file": "ep_nya01.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "絶え間なく、俺を苛む。 終わらない――快楽。",
   "ko_candidate": "「절정이 끊임없이 나를 괴롭힌다｡」"
  },
  {
   "id": 49897,
   "key": "ep_nya01.txt:23",
   "file": "ep_nya01.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "二度と逃れられない、快楽の檻。",
   "ko_candidate": "「끝나지 않는 쾌락｡」 「두 번 다시 벗어날 수 없는 쾌락의 감옥｡」"
  },
  {
   "id": 49898,
   "key": "ep_nya01.txt:24",
   "file": "ep_nya01.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "徐々に腐れ堕ち、甘い腐臭を放ち、退廃する。",
   "ko_candidate": "「서서히 썩어 무너지고 달콤한 부패 냄새를 풍기며 퇴폐한다｡」 「썩어 문드러진 살과 꿀과 혼돈의 소용돌이 속에서도 여전히 홀린 듯이 계속 갈구한다｡ 계속 탐한다｡」"
  },
  {
   "id": 49899,
   "key": "ep_nya01.txt:31",
   "file": "ep_nya01.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腐れ爛れた肉と蜜と混沌の渦の中、なおも取り憑かれたように、求め続ける。貪り続ける。 甘い蜜の味がする。",
   "ko_candidate": "「미끈거리는 몸을 얽히고설키며 곪은 피부와 상처를 핥듯이 혀를 기어 다니게 한다｡」"
  },
  {
   "id": 49900,
   "key": "ep_nya01.txt:34",
   "file": "ep_nya01.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "甘い毒の味がある。 甘い腐汁の味がする。",
   "ko_candidate": "「달콤한 꿀 맛이 난다｡ 달콤한 독 맛이 있다｡ 달콤한 부패액 맛이 난다｡」"
  },
  {
   "id": 49901,
   "key": "ep_nya01.txt:41",
   "file": "ep_nya01.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "貪り貪り貪り貪り貪り貪り貪り貪り貪り貪り貪り何度も何度も何度も何度も何度も何度も何度も達し続けて焼け爛れた脳灼き切れた神経。 もう何が何だか判らなかった。",
   "ko_candidate": "「탐하고 탐하고 탐하고 탐하고 탐하고 탐하고 탐하고 탐하고 탐하고 탐하고 탐하고 몇 번이고 몇 번이고 몇 번이고 몇 번이고 몇 번이고 몇 번이고 몇 번이고 계속 절정에 달해 타들어간 뇌와 타버린 신경｡」"
  },
  {
   "id": 49902,
   "key": "ep_nya01.txt:49",
   "file": "ep_nya01.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "抱いているのか抱かれているのか抉っているのか抉られているのか出しているのか出されているのか上なのか下なのか逆しまなのか何もかも何もかも溶けてゆく崩れてゆく。",
   "ko_candidate": "「이제 무엇이 무엇인지 알 수 없었다｡」 「안고 있는 건지 안겨 있는 건지 범하고 있는 건지 범해지고 있는 건지 파고들고 있는 건지 파고들어지고 있는 건지 내고 있는 건지 받고 있는 건지 위인지 아래인지 거꾸로인지 모든 것이 모든 것이 녹아내리고 무너져 간다｡」{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 49903,
   "key": "ep_nya01.txt:54",
   "file": "ep_nya01.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "激しく荒れ狂う混沌の意識の中―― 灼け堕ち境界を失う思考の中――",
   "ko_candidate": "「격렬하게 날뛰는 혼돈의 의식 속에서――」"
  },
  {
   "id": 49904,
   "key": "ep_nya01.txt:57",
   "file": "ep_nya01.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は、見るのだ。 宇宙の、姿を。",
   "ko_candidate": "「타오르며 무너져 경계를 잃은 사고 속에서――」"
  },
  {
   "id": 49905,
   "key": "ep_nya01.txt:75",
   "file": "ep_nya01.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――俺は本を捜していた。",
   "ko_candidate": "「나는 보는 것이다｡」 「우주의 모습을｡」"
  },
  {
   "id": 49906,
   "key": "ep_nya01.txt:78",
   "file": "ep_nya01.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もしくは或いは匣だったかも知れないし、宝石だったかも知れないし、胎児だったかも知れないが、そうでなくて、俺が捜しているのは、あくまで歯車なのだ。卵だったかも知れない。",
   "ko_candidate": "――나는 책을 찾고 있었다｡ 아니면 어쩌면 상자였을 수도 있고､ 보석이었을 수도 있고､ 태아였을 수도 있지만､ 그게 아니라 내가 찾고 있는 것은 어디까지나 톱니바퀴인 것이다｡ 알이었을 는 있다｡"
  },
  {
   "id": 49907,
   "key": "ep_nya01.txt:78",
   "file": "ep_nya01.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "姫さんに依頼されたからだ。",
   "ko_candidate": "공주님의 부탁을 받았기 때문이다｡"
  },
  {
   "id": 49908,
   "key": "ep_nya01.txt:89",
   "file": "ep_nya01.txt",
   "line": 89,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「わたくしの蛇が逃げ出しました。 捜して、見つけ出して、 掴まえて、首を絞め、 首を吊り上げ、首を刎ねよ」",
   "ko_candidate": "「제 뱀이 도망쳤어요｡ 찾아서､ 발견해서､ 붙잡아서､ 목을 조르고､ 목을 들어 올리고､ 목을 베세요」"
  },
  {
   "id": 49909,
   "key": "ep_nya01.txt:96",
   "file": "ep_nya01.txt",
   "line": 96,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「はい」",
   "ko_candidate": "「네」"
  },
  {
   "id": 49910,
   "key": "ep_nya01.txt:106",
   "file": "ep_nya01.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は次の日の朝まで眠ることにした。",
   "ko_candidate": "나는 다음 날 아침까지 자기로 했다｡"
  },
  {
   "id": 49911,
   "key": "ep_nya01.txt:106",
   "file": "ep_nya01.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ソファーの上で横になる俺を、黒い山羊の貌が天井から見下ろしていた。",
   "ko_candidate": "{SE_PLAY(1,\"ティベ땁生\",0,100,false);} 소파에 누운 나를 검은 염소의 얼굴이 천장에서 내려다보고 있었다｡"
  },
  {
   "id": 49912,
   "key": "ep_nya01.txt:108",
   "file": "ep_nya01.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ぐるぐると眼球が回転していた。",
   "ko_candidate": "빙글빙글 안구가 회전하고 있었다｡"
  },
  {
   "id": 49913,
   "key": "ep_nya01.txt:109",
   "file": "ep_nya01.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "長く紅い舌が垂れ下がる。",
   "ko_candidate": "길고 붉은 혀가 늘어져 있다｡"
  },
  {
   "id": 49914,
   "key": "ep_nya01.txt:110",
   "file": "ep_nya01.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "舌を震わせ、山羊は「残虐メルヒェン」と、 寂しそうに呟いた。",
   "ko_candidate": "혀를 떨며 염소는 「잔혹 동화」라고 쓸쓸하게 중얼거렸다｡"
  },
  {
   "id": 49915,
   "key": "ep_nya01.txt:122",
   "file": "ep_nya01.txt",
   "line": 122,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「起きて、お兄ちゃん。朝だよ」",
   "ko_candidate": "「일어나､ 오빠｡ 아침이야」"
  },
  {
   "id": 49916,
   "key": "ep_nya01.txt:126",
   "file": "ep_nya01.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "妹が身体を揺さぶる。",
   "ko_candidate": "여동생이 몸을 흔든다｡"
  },
  {
   "id": 49917,
   "key": "ep_nya01.txt:133",
   "file": "ep_nya01.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "もう朝だった。",
   "ko_candidate": "벌써 아침이었다｡"
  },
  {
   "id": 49918,
   "key": "ep_nya01.txt:137",
   "file": "ep_nya01.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "原色で塗り潰された朝陽が、 カーテンの隙間から射し込んでいた。",
   "ko_candidate": "원색으로 칠해진 아침 햇살이 커튼 틈새로 비치고 있었다｡"
  },
  {
   "id": 49919,
   "key": "ep_nya01.txt:139",
   "file": "ep_nya01.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "棺桶のような目覚まし時計を確かめる。",
   "ko_candidate": "관 같은 알람시계를 확인한다｡"
  },
  {
   "id": 49920,
   "key": "ep_nya01.txt:140",
   "file": "ep_nya01.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "４つの針が完全無秩序に時を刻んでいた。",
   "ko_candidate": "4개의 바늘이 완전 무질서하게 시간을 새기고 있었다｡"
  },
  {
   "id": 49921,
   "key": "ep_nya01.txt:142",
   "file": "ep_nya01.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ザクザクザクザク。",
   "ko_candidate": "자글자글자글자글｡"
  },
  {
   "id": 49922,
   "key": "ep_nya01.txt:149",
   "file": "ep_nya01.txt",
   "line": 149,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「早くしないと、遅刻しちゃうよ？」",
   "ko_candidate": "「빨리 안 하면 지각해?」 그 말이 맞았다｡"
  },
  {
   "id": 49923,
   "key": "ep_nya01.txt:152",
   "file": "ep_nya01.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その通りだった。",
   "ko_candidate": "늦으면 큰일이다｡"
  },
  {
   "id": 49924,
   "key": "ep_nya01.txt:153",
   "file": "ep_nya01.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "遅れたら大変だ。 俺は羊水の中から飛び起きて、学校へ行く支度をした。",
   "ko_candidate": "나는 핏자국과 양수와 살덩어리 속에서 벌떡 일어나 학교 갈 준비를 했다｡"
  },
  {
   "id": 49925,
   "key": "ep_nya01.txt:159",
   "file": "ep_nya01.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "血まみれのパジャマを脱ぎ捨てる。",
   "ko_candidate": "피투성이 파자마를 벗어던진다｡"
  },
  {
   "id": 49926,
   "key": "ep_nya01.txt:168",
   "file": "ep_nya01.txt",
   "line": 168,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いやぁん！ お兄ちゃんのえっちぃ☆」 妹を追い出して、服を着替える。",
   "ko_candidate": "「아앙! 오빠 야해☆」"
  },
  {
   "id": 49927,
   "key": "ep_nya01.txt:177",
   "file": "ep_nya01.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "カーテンを勢いよく開けば、",
   "ko_candidate": "여동생을 내쫓고 옷을 갈아입는다｡"
  },
  {
   "id": 49928,
   "key": "ep_nya01.txt:178",
   "file": "ep_nya01.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "極彩色の空が滴り落ちていた。 風が甘い腐臭を運ぶ。",
   "ko_candidate": "커튼을 힘차게 열면 극채색의 하늘이 뚝뚝 떨어지고 있었다｡"
  },
  {
   "id": 49929,
   "key": "ep_nya01.txt:180",
   "file": "ep_nya01.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "心地好い春の匂いだった。",
   "ko_candidate": "바람이 달콤한 썩은 냄새를 실어온다｡"
  },
  {
   "id": 49930,
   "key": "ep_nya01.txt:181",
   "file": "ep_nya01.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今日もいい天気だ。",
   "ko_candidate": "기분 좋은 봄 냄새였다｡"
  },
  {
   "id": 49931,
   "key": "ep_nya01.txt:192",
   "file": "ep_nya01.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "食卓についた。",
   "ko_candidate": "오늘도 날씨가 좋다｡"
  },
  {
   "id": 49932,
   "key": "ep_nya01.txt:197",
   "file": "ep_nya01.txt",
   "line": 197,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お兄ちゃん、おはよう」",
   "ko_candidate": "식탁에 앉았다｡ 「오빠､ 안녕」"
  },
  {
   "id": 49933,
   "key": "ep_nya01.txt:204",
   "file": "ep_nya01.txt",
   "line": 204,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お兄ちゃん、おはよう」",
   "ko_candidate": "「오빠､ 안녕」 「오빠､ 안녕」"
  },
  {
   "id": 49934,
   "key": "ep_nya01.txt:211",
   "file": "ep_nya01.txt",
   "line": 211,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お兄ちゃん、おはよう」",
   "ko_candidate": "모두 모여 있었다｡ 「엄마는?」"
  }
 ]
