 "items": [
  {
   "id": 14130,
   "key": "D0808al.txt:657",
   "file": "D0808al.txt",
   "line": 657,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「四六時中、キリキリ殺気立っている奴なんていないだろう？」",
   "ko_candidate": "「24시간 내내 살기를 뿜고 있는 녀석은 없겠지?」"
  },
  {
   "id": 14131,
   "key": "D0808al.txt:662",
   "file": "D0808al.txt",
   "line": 662,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そりゃそうだけど、九郎はちょっと違うんだよ。うーん……なんて言えば良いのかなぁ？」",
   "ko_candidate": "「그야 그렇지만､ 쿠로는 좀 달라｡ 음……뭐라고 하면 좋을까?」"
  },
  {
   "id": 14132,
   "key": "D0808al.txt:665",
   "file": "D0808al.txt",
   "line": 665,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕を組み、首を捻って悩むエンネア。",
   "ko_candidate": "팔짱을 끼고 고개를 갸웃거리며 고민하는 엔네아｡"
  },
  {
   "id": 14133,
   "key": "D0808al.txt:667",
   "file": "D0808al.txt",
   "line": 667,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ややあって、納得がいったのか、うんうんと頷いた。",
   "ko_candidate": "잠시 후､ 납득이 간 듯 고개를 끄덕였다｡"
  },
  {
   "id": 14134,
   "key": "D0808al.txt:669",
   "file": "D0808al.txt",
   "line": 669,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "微笑みを浮かべて、彼女は言った。",
   "ko_candidate": "미소를 지으며 그녀가 말했다｡"
  },
  {
   "id": 14135,
   "key": "D0808al.txt:674",
   "file": "D0808al.txt",
   "line": 674,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎はね……どんな大変なことになっても、そんなノリで、軽く戦い抜いちゃうんだよ、きっと」",
   "ko_candidate": "「쿠로는 말이야……아무리 힘든 일이 생겨도､ 그런 식으로 가볍게 싸워 이겨버릴 거야､ 틀림없이」"
  },
  {
   "id": 14136,
   "key": "D0808al.txt:678",
   "file": "D0808al.txt",
   "line": 678,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………？」",
   "ko_candidate": "「…………?」"
  },
  {
   "id": 14137,
   "key": "D0808al.txt:680",
   "file": "D0808al.txt",
   "line": 680,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何が言いたいんだろう？",
   "ko_candidate": "무슨 말을 하고 싶은 걸까?"
  },
  {
   "id": 14138,
   "key": "D0808al.txt:681",
   "file": "D0808al.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "難しい顔をする俺に、エンネアは微笑み続ける。",
   "ko_candidate": "어려운 표정을 짓는 나에게 엔네아는 계속 미소 짓는다｡"
  },
  {
   "id": 14139,
   "key": "D0808al.txt:683",
   "file": "D0808al.txt",
   "line": 683,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……酷く穏やかな微笑みだった。",
   "ko_candidate": "……무척이나 온화한 미소였다｡"
  },
  {
   "id": 14140,
   "key": "D0808al.txt:688",
   "file": "D0808al.txt",
   "line": 688,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎は挫けない人。どんな大変な目に遭っても、『それがどうした』って、簡単に払い除けちゃう人なんだよ」",
   "ko_candidate": "「쿠로는 좌절하지 않는 사람이야｡ 아무리 힘든 일을 겪어도､ '그게 어쨌다고'라며 간단히 떨쳐버릴 수 있는 사람이라고」"
  },
  {
   "id": 14141,
   "key": "D0808al.txt:692",
   "file": "D0808al.txt",
   "line": 692,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……そうか？」",
   "ko_candidate": "「……그런가?」"
  },
  {
   "id": 14142,
   "key": "D0808al.txt:694",
   "file": "D0808al.txt",
   "line": 694,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分ではよく分からないが……。",
   "ko_candidate": "스스로는 잘 모르겠지만……"
  },
  {
   "id": 14143,
   "key": "D0808al.txt:695",
   "file": "D0808al.txt",
   "line": 695,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルがケーキを咀嚼しながら、鼻で笑った。",
   "ko_candidate": "알이 케이크를 씹으며 코웃음 쳤다｡"
  },
  {
   "id": 14144,
   "key": "D0808al.txt:700",
   "file": "D0808al.txt",
   "line": 700,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はんっ……何も考えてない、お気楽莫迦なだけだ」",
   "ko_candidate": "「흥……아무 생각도 없는､ 태평한 바보일 뿐이다」 「시끄러워?!」"
  },
  {
   "id": 14145,
   "key": "D0808al.txt:704",
   "file": "D0808al.txt",
   "line": 704,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「五月蝿いよッ!?」",
   "ko_candidate": "「아하하하하하하하하하하♪」"
  },
  {
   "id": 14146,
   "key": "D0808al.txt:709",
   "file": "D0808al.txt",
   "line": 709,
   "speaker": "エンネア / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あはははははははははははは♪」 「お前も笑い過ぎだっ！　……ほら、そろそろ周りの視線も痛くなってきたから、やめろっての」",
   "ko_candidate": "「너도 웃음이 지나쳐! ……자､ 이제 주변 시선도 신경 쓰이니까 그만해」"
  },
  {
   "id": 14147,
   "key": "D0808al.txt:718",
   "file": "D0808al.txt",
   "line": 718,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あはっ、ごめん。ごめん。だってさ、よくよく考えたらもの凄い光景だよ？　夫婦漫才する、魔術師と魔導書なんて………………」 「あっ」",
   "ko_candidate": "「아핫､ 미안｡ 미안｡ 그치만 말이야､ 잘 생각해보면 엄청난 광경이잖아? 부부 만담하는 마술사와 마도서라니……………… 앗」"
  },
  {
   "id": 14148,
   "key": "D0808al.txt:726",
   "file": "D0808al.txt",
   "line": 726,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンネアは自分のミスにすぐ気付いたようだった。",
   "ko_candidate": "엔네아는 자신의 실수를 바로 깨달은 것 같았다｡"
  },
  {
   "id": 14149,
   "key": "D0808al.txt:727",
   "file": "D0808al.txt",
   "line": 727,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――遅すぎる。",
   "ko_candidate": "하지만――너무 늦었다｡"
  },
  {
   "id": 14150,
   "key": "D0808al.txt:730",
   "file": "D0808al.txt",
   "line": 730,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――」",
   "ko_candidate": "「――――――――――」"
  },
  {
   "id": 14151,
   "key": "D0808al.txt:735",
   "file": "D0808al.txt",
   "line": 735,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――」",
   "ko_candidate": "「――――――――――」"
  },
  {
   "id": 14152,
   "key": "D0808al.txt:740",
   "file": "D0808al.txt",
   "line": 740,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……………………あちゃあ～」",
   "ko_candidate": "「……………………아차~」"
  },
  {
   "id": 14153,
   "key": "D0808al.txt:744",
   "file": "D0808al.txt",
   "line": 744,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しまったなあ、というようにぺロッと舌を出すエンネア。",
   "ko_candidate": "아차 했다는 듯이 혀를 내미는 엔네아｡"
  },
  {
   "id": 14154,
   "key": "D0808al.txt:746",
   "file": "D0808al.txt",
   "line": 746,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……確かに、今のは大きなミスだ。",
   "ko_candidate": "……확실히､ 방금 그건 큰 실수였다｡"
  },
  {
   "id": 14155,
   "key": "D0808al.txt:747",
   "file": "D0808al.txt",
   "line": 747,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もアルも、自分の正体については何一つ語っていないのだから。",
   "ko_candidate": "나도 알도､ 자신의 정체에 대해서는 아무것도 말하지 않았으니까｡"
  },
  {
   "id": 14156,
   "key": "D0808al.txt:749",
   "file": "D0808al.txt",
   "line": 749,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重くて冷たい沈黙が、俺たちを支配した。",
   "ko_candidate": "무겁고 차가운 침묵이 우리를 지배했다｡"
  },
  {
   "id": 14157,
   "key": "D0808al.txt:750",
   "file": "D0808al.txt",
   "line": 750,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "汗の滲む手のひらを握り締め、俺はエンネアに問いかけた。",
   "ko_candidate": "땀이 배어나는 손바닥을 꽉 쥐고､ 나는 엔네아에게 물었다｡"
  },
  {
   "id": 14158,
   "key": "D0808al.txt:753",
   "file": "D0808al.txt",
   "line": 753,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「知っていたのか……エンネア」",
   "ko_candidate": "「알고 있었던 거야……엔네아」"
  },
  {
   "id": 14159,
   "key": "D0808al.txt:758",
   "file": "D0808al.txt",
   "line": 758,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うー……」",
   "ko_candidate": "「으음……」"
  },
  {
   "id": 14160,
   "key": "D0808al.txt:761",
   "file": "D0808al.txt",
   "line": 761,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンネアは気まずそうに俯いて、上目遣いにこちらの様子を窺う。",
   "ko_candidate": "엔네아는 어색한 듯이 고개를 숙이고､ 치켜뜬 눈으로 이쪽 상황을 살폈다｡"
  },
  {
   "id": 14161,
   "key": "D0808al.txt:763",
   "file": "D0808al.txt",
   "line": 763,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の顔は、強張ったままだ。",
   "ko_candidate": "내 얼굴은､ 굳어진 채다｡"
  },
  {
   "id": 14162,
   "key": "D0808al.txt:764",
   "file": "D0808al.txt",
   "line": 764,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "さらに追求する。",
   "ko_candidate": "더 추궁한다｡"
  },
  {
   "id": 14163,
   "key": "D0808al.txt:767",
   "file": "D0808al.txt",
   "line": 767,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「記憶喪失ってのも嘘か？」",
   "ko_candidate": "「기억 상실이란 것도 거짓말이야?」"
  },
  {
   "id": 14164,
   "key": "D0808al.txt:772",
   "file": "D0808al.txt",
   "line": 772,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ～～～……」",
   "ko_candidate": "「아~~~~~……」"
  },
  {
   "id": 14165,
   "key": "D0808al.txt:775",
   "file": "D0808al.txt",
   "line": 775,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "困ったように癖っ毛を掻く。",
   "ko_candidate": "곤란한 듯이 곱슬머리를 긁는다｡"
  },
  {
   "id": 14166,
   "key": "D0808al.txt:776",
   "file": "D0808al.txt",
   "line": 776,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがて決心したのか、こっちを真っ直ぐに見つめ返して、頷いた。",
   "ko_candidate": "이윽고 결심한 듯､ 이쪽을 똑바로 바라보며 고개를 끄덕였다｡"
  },
  {
   "id": 14167,
   "key": "D0808al.txt:781",
   "file": "D0808al.txt",
   "line": 781,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うん、ごめんね」",
   "ko_candidate": "「응､ 미안해」"
  },
  {
   "id": 14168,
   "key": "D0808al.txt:785",
   "file": "D0808al.txt",
   "line": 785,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……どういうつもりなんだ？」",
   "ko_candidate": "「……무슨 생각으로 이러는 거야?」"
  },
  {
   "id": 14169,
   "key": "D0808al.txt:787",
   "file": "D0808al.txt",
   "line": 787,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……分からなかった。",
   "ko_candidate": "……이해할 수 없었다｡"
  }
 ]
}