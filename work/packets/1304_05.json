 "items": [
  {
   "id": 31971,
   "key": "D1304le.txt:257",
   "file": "D1304le.txt",
   "line": 257,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……それしか方法はねえだろ」",
   "ko_candidate": "「그래… 그것 말고는 방법이 없잖아」"
  },
  {
   "id": 31972,
   "key": "D1304le.txt:259",
   "file": "D1304le.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインが無い以上、鬼械神に対抗できる武器はコイツだけだ。",
   "ko_candidate": "데몬베인이 없는 이상､ 귀계신에 대항할 수 있는 무기는 이놈뿐이다｡"
  },
  {
   "id": 31973,
   "key": "D1304le.txt:260",
   "file": "D1304le.txt",
   "line": 260,
   "speaker": "ウェスト",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ヤバかろうが怪しかろうが、やるしかない。 「正直、我輩からもお奨めしかねるのであるがな」",
   "ko_candidate": "위험하든 수상하든､ 해야만 해｡"
  },
  {
   "id": 31974,
   "key": "D1304le.txt:267",
   "file": "D1304le.txt",
   "line": 267,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「コレの性能を完全に使いこなせるのは、自身が魔導兵器であるメタトロンだけである」 「機体とのシンクロの件からも、肉体的な強度の点からも、鬼械神と張り合うには貴様では……」",
   "ko_candidate": "「솔직히､ 나도 추천하기 어렵다네｡ 이것의 성능을 완전히 사용할 수 있는 건､ 자신이 마도병기인 메타트론뿐이야｡ 기체와의 싱크로 건에서도､ 육체적인 강도 면에서도､ 귀계신과 맞서려면 너로는…」"
  },
  {
   "id": 31975,
   "key": "D1304le.txt:274",
   "file": "D1304le.txt",
   "line": 274,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だけど、俺以外にはいねえだろ。だったら最善を尽くすまでだ」",
   "ko_candidate": "「하지만､ 나 말고는 없잖아｡ 그렇다면 최선을 다할 뿐이야」"
  },
  {
   "id": 31976,
   "key": "D1304le.txt:278",
   "file": "D1304le.txt",
   "line": 278,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だが此奴に組み込まれているのは、あの『ナコト写本』だ。 精霊的な反応は失われているとは言え、不気味だ……」",
   "ko_candidate": "「하지만 이놈에 내장되어 있는 건､ 그 『나코트 사본』이다｡ 정령적인 반응은 사라졌다고는 해도､ 불길하다…」"
  },
  {
   "id": 31977,
   "key": "D1304le.txt:282",
   "file": "D1304le.txt",
   "line": 282,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ナコト写本』。",
   "ko_candidate": "『나코트 사본』｡"
  },
  {
   "id": 31978,
   "key": "D1304le.txt:283",
   "file": "D1304le.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マスターテリオンの魔導書。",
   "ko_candidate": "마스터 테리온의 마도서｡"
  },
  {
   "id": 31979,
   "key": "D1304le.txt:284",
   "file": "D1304le.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "このハンティングホラーに、あいつの何らかの意思が密かに介在しているのだとしたら？",
   "ko_candidate": "이 헌팅 호러에､ 그자의 어떤 의지가 은밀히 개입하고 있다면?"
  },
  {
   "id": 31980,
   "key": "D1304le.txt:286",
   "file": "D1304le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……やめよう。",
   "ko_candidate": "…그만두자｡"
  },
  {
   "id": 31981,
   "key": "D1304le.txt:287",
   "file": "D1304le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなことを気にしている状況ではない。",
   "ko_candidate": "그런 걸 신경 쓰고 있을 상황이 아니야｡"
  },
  {
   "id": 31982,
   "key": "D1304le.txt:288",
   "file": "D1304le.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "利用できるものなら敵の罠だろうが何だろうが、全部、使ってやる。",
   "ko_candidate": "이용할 수 있는 건 적의 함정이든 뭐든､ 전부 사용해 주겠어｡"
  },
  {
   "id": 31983,
   "key": "D1304le.txt:289",
   "file": "D1304le.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶対に、ライカさんを助けないと。",
   "ko_candidate": "반드시､ 라이카 씨를 구해야 해｡"
  },
  {
   "id": 31984,
   "key": "D1304le.txt:292",
   "file": "D1304le.txt",
   "line": 292,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「とにかく急いで点検してくれ。連中が動き始める前に、ケリをつけたい」",
   "ko_candidate": "「어쨌든 서둘러 점검해 줘｡ 놈들이 움직이기 전에､ 결판을 내고 싶어」"
  },
  {
   "id": 31985,
   "key": "D1304le.txt:296",
   "file": "D1304le.txt",
   "line": 296,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ、出来るだけ貴様に対応できるよう弄ってみるのである」",
   "ko_candidate": "「뭐､ 최대한 너에게 대응할 수 있도록 만져볼 테다」"
  },
  {
   "id": 31986,
   "key": "D1304le.txt:306",
   "file": "D1304le.txt",
   "line": 306,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……待て、九郎」",
   "ko_candidate": "「…잠깐､ 쿠로」"
  },
  {
   "id": 31987,
   "key": "D1304le.txt:309",
   "file": "D1304le.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルはハンティングホラーに向けていた厳しい視線を俺に向ける。",
   "ko_candidate": "알은 헌팅 호러를 향하고 있던 엄격한 시선을 나에게 돌린다｡"
  },
  {
   "id": 31988,
   "key": "D1304le.txt:310",
   "file": "D1304le.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こちらを見透かすような瞳。",
   "ko_candidate": "이쪽을 꿰뚫어 보는 듯한 눈동자｡"
  },
  {
   "id": 31989,
   "key": "D1304le.txt:313",
   "file": "D1304le.txt",
   "line": 313,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だよ」",
   "ko_candidate": "「뭐야」"
  },
  {
   "id": 31990,
   "key": "D1304le.txt:319",
   "file": "D1304le.txt",
   "line": 319,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『ケリを着ける』だと？ 汝、真逆――『夢幻心母』に乗り込むつもりではあるまいな」",
   "ko_candidate": "「『결판을 낸다』고? 너､ 설마――『몽환심모』에 탑승할 생각은 아니겠지」"
  },
  {
   "id": 31991,
   "key": "D1304le.txt:324",
   "file": "D1304le.txt",
   "line": 324,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「!?」",
   "ko_candidate": "「!?」"
  },
  {
   "id": 31992,
   "key": "D1304le.txt:328",
   "file": "D1304le.txt",
   "line": 328,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ロボっ!?」",
   "ko_candidate": "「로봇!?」"
  },
  {
   "id": 31993,
   "key": "D1304le.txt:331",
   "file": "D1304le.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やっぱり、こいつは察しの良い奴だ。",
   "ko_candidate": "역시､ 이놈은 눈치 빠른 녀석이야｡"
  },
  {
   "id": 31994,
   "key": "D1304le.txt:332",
   "file": "D1304le.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まあ、俺とアルとは一蓮托生。隠してたってどうしょうもないことなのだが。",
   "ko_candidate": "뭐､ 나와 알은 운명을 함께하는 사이｡ 숨겨봤자 어쩔 수 없는 일이지만｡"
  },
  {
   "id": 31995,
   "key": "D1304le.txt:333",
   "file": "D1304le.txt",
   "line": 333,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "素直に頷く。 「それが唯一の勝算だろ」",
   "ko_candidate": "솔직히 고개를 끄덕인다｡"
  },
  {
   "id": 31996,
   "key": "D1304le.txt:340",
   "file": "D1304le.txt",
   "line": 340,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「めちゃくちゃロボよ、それっ て！」",
   "ko_candidate": "「그게 유일한 승산이잖아」 「엉망진창로봇､ 그건!」"
  },
  {
   "id": 31997,
   "key": "D1304le.txt:345",
   "file": "D1304le.txt",
   "line": 345,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、その通りである！　勝算でも何でも無い！　そんなものはただの自殺行為である！」",
   "ko_candidate": "「그､ 그렇다! 승산도 뭐도 아니야! 그런 건 그저 자살 행위일 뿐이다!」"
  },
  {
   "id": 31998,
   "key": "D1304le.txt:349",
   "file": "D1304le.txt",
   "line": 349,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うるせぇっ！　俺は俺なりに、一番の算段をしてんだよ！ つべこべ言わずに働けぇい！　馬車馬の如く蜜蜂の如く奴隷の如くっ！」",
   "ko_candidate": "「시끄러워! 나는 나대로､ 최선의 방책을 세우고 있다고! 쓸데없는 소리 말고 일해! 마차 말처럼 꿀벌처럼 노예처럼!」 「…」"
  },
  {
   "id": 31999,
   "key": "D1304le.txt:356",
   "file": "D1304le.txt",
   "line": 356,
   "speaker": "アル / ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」 「考え直せっ！　貴様は我輩の宿敵なのである！　勝手に死なれては困るのである！　こう、何て言うか、宿命的にっ！」",
   "ko_candidate": "「다시 생각해! 너는 나의 숙적이다! 마음대로 죽어선 곤란하다! 뭐랄까､ 숙명적으로!」"
  },
  {
   "id": 32000,
   "key": "D1304le.txt:364",
   "file": "D1304le.txt",
   "line": 364,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「勝手にハタ迷惑な宿命付けてんじゃねえよっ！」",
   "ko_candidate": "「마음대로 귀찮은 숙명 붙이지 마!」 「…」"
  },
  {
   "id": 32001,
   "key": "D1304le.txt:368",
   "file": "D1304le.txt",
   "line": 368,
   "speaker": "アル / エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」 「考え直すロボ～考え直すロボ～っ！　ええい、洗脳電波発信っ！ 機能は無くても気持ち的に」",
   "ko_candidate": "「다시 생각해로봇~ 다시 생각해로봇~! 에이､ 세뇌 전파 발신! 기능은 없어도 마음만은」"
  },
  {
   "id": 32002,
   "key": "D1304le.txt:377",
   "file": "D1304le.txt",
   "line": 377,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「変な気持ち、送信するんじゃねえっ！」",
   "ko_candidate": "「이상한 마음､ 보내지 마!」"
  },
  {
   "id": 32003,
   "key": "D1304le.txt:383",
   "file": "D1304le.txt",
   "line": 383,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――そんなに、あの女が大事か」",
   "ko_candidate": "「――그렇게까지､ 그 여자가 소중한가」"
  },
  {
   "id": 32004,
   "key": "D1304le.txt:387",
   "file": "D1304le.txt",
   "line": 387,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………っっ！」",
   "ko_candidate": "「…읏!」"
  },
  {
   "id": 32005,
   "key": "D1304le.txt:389",
   "file": "D1304le.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "短く、鋭く、冷たく、ただ一言。",
   "ko_candidate": "짧고､ 날카롭고､ 차갑게､ 단 한마디｡"
  },
  {
   "id": 32006,
   "key": "D1304le.txt:390",
   "file": "D1304le.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは、そう訊ねてきた。",
   "ko_candidate": "알은､ 그렇게 물어왔다｡"
  },
  {
   "id": 32007,
   "key": "D1304le.txt:391",
   "file": "D1304le.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "射抜くような視線。",
   "ko_candidate": "꿰뚫는 듯한 시선｡"
  },
  {
   "id": 32008,
   "key": "D1304le.txt:393",
   "file": "D1304le.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "返答次第では容赦しないと言わんばかりの、殺気じみたものさえ窺わせる視線だ。",
   "ko_candidate": "대답 여하에 따라서는 용서하지 않겠다는 듯한､ 살기마저 느껴지는 시선이다｡"
  },
  {
   "id": 32009,
   "key": "D1304le.txt:394",
   "file": "D1304le.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、すぐには答えられなかった。",
   "ko_candidate": "나는､ 바로 대답할 수 없었다｡"
  },
  {
   "id": 32010,
   "key": "D1304le.txt:396",
   "file": "D1304le.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しばらく待って……答えが無いので、アルは続ける。",
   "ko_candidate": "잠시 기다려… 대답이 없어서､ 알은 계속한다｡"
  }
 ]
}