 "items": [
  {
   "id": 46665,
   "key": "D1513le.txt:211",
   "file": "D1513le.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "開かれたドールの顎は天蓋の如く、頭上を覆い尽くした。",
   "ko_candidate": "열린 도울의 턱은 천개와 같이 머리 위를 뒤덮었다｡"
  },
  {
   "id": 46666,
   "key": "D1513le.txt:212",
   "file": "D1513le.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "天が、墜ちる。",
   "ko_candidate": "하늘이 무너진다｡"
  },
  {
   "id": 46667,
   "key": "D1513le.txt:212",
   "file": "D1513le.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺たちを、永遠の飢餓に犯されている腹へと収めるために。",
   "ko_candidate": "우리를 영원한 기아에 시달리는 배 속으로 집어넣기 위해｡"
  },
  {
   "id": 46668,
   "key": "D1513le.txt:216",
   "file": "D1513le.txt",
   "line": 216,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎！」",
   "ko_candidate": "「쿠로!」"
  },
  {
   "id": 46669,
   "key": "D1513le.txt:219",
   "file": "D1513le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――時が、動いた！",
   "ko_candidate": "――시간이 움직였다!"
  },
  {
   "id": 46670,
   "key": "D1513le.txt:229",
   "file": "D1513le.txt",
   "line": 229,
   "speaker": "九郎＆リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「おおおおおおおおおおおおおおおおおおおおおおおおおおお！」",
   "ko_candidate": "「오오오오오오오오오오오오오오오오오오오오오오오오오오오!」"
  },
  {
   "id": 46671,
   "key": "D1513le.txt:237",
   "file": "D1513le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "吼え猛る掌を、光り耀く手刀を振り上げ、デモンベインが、リベル・レギスが突撃する。",
   "ko_candidate": "포효하는 손바닥을､ 빛나는 수도를 들어올리며､ 데몬베인이､ 리베르 레기스가 돌격한다｡"
  },
  {
   "id": 46672,
   "key": "D1513le.txt:238",
   "file": "D1513le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "死をも呑み込む破滅の力が、此処に顕現した。",
   "ko_candidate": "죽음마저 삼켜버리는 파멸의 힘이 여기에 현현했다｡"
  },
  {
   "id": 46673,
   "key": "D1513le.txt:245",
   "file": "D1513le.txt",
   "line": 245,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「レムリアァァァァァァァァ！」",
   "ko_candidate": "「레무리아아아아아아아아아!」"
  },
  {
   "id": 46674,
   "key": "D1513le.txt:251",
   "file": "D1513le.txt",
   "line": 251,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハイパーボリアァァァ……！」",
   "ko_candidate": "「하이퍼보리아아아아…!」 「임팩트!」"
  },
  {
   "id": 46675,
   "key": "D1513le.txt:257",
   "file": "D1513le.txt",
   "line": 257,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「インパクト！」",
   "ko_candidate": "「제로드라이브!」"
  },
  {
   "id": 46676,
   "key": "D1513le.txt:264",
   "file": "D1513le.txt",
   "line": 264,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ゼロドライブ！」 絶対零度、静止した世界に、ドールは掴まった。",
   "ko_candidate": "절대영도､ 정지한 세계에 도울은 붙잡혔다｡"
  },
  {
   "id": 46677,
   "key": "D1513le.txt:274",
   "file": "D1513le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "閃光の瘴滅がドールを呑み込み、存在を崩壊させる。",
   "ko_candidate": "섬광의 장멸이 도울을 삼켜 존재를 붕괴시킨다｡"
  },
  {
   "id": 46678,
   "key": "D1513le.txt:275",
   "file": "D1513le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "次いで無限熱量。絶対零度。",
   "ko_candidate": "이어서 무한열량｡ 절대영도｡"
  },
  {
   "id": 46679,
   "key": "D1513le.txt:277",
   "file": "D1513le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "抉る。",
   "ko_candidate": "도려낸다｡"
  },
  {
   "id": 46680,
   "key": "D1513le.txt:293",
   "file": "D1513le.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頭部の半分を丸ごと消失したドールの巨体が横たわる。",
   "ko_candidate": "머리 부분의 절반이 통째로 사라진 도울의 거대한 몸이 누워있다｡"
  },
  {
   "id": 46681,
   "key": "D1513le.txt:294",
   "file": "D1513le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "斃れた時の衝撃が、大地震を巻き起こした。",
   "ko_candidate": "쓰러진 순간의 충격이 대지진을 일으켰다｡"
  },
  {
   "id": 46682,
   "key": "D1513le.txt:295",
   "file": "D1513le.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "崩壊の傷痕を拡げてゆく大地。",
   "ko_candidate": "붕괴의 상흔을 넓혀가는 대지｡"
  },
  {
   "id": 46683,
   "key": "D1513le.txt:298",
   "file": "D1513le.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その震動に興奮したのか、次々と、巨大なミミズが地表に頭を出す。",
   "ko_candidate": "그 진동에 흥분했는지､ 차례차례 거대한 지렁이가 지표에 머리를 내민다｡"
  },
  {
   "id": 46684,
   "key": "D1513le.txt:304",
   "file": "D1513le.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "５つの太陽の烈光に苛まれながらも、無数のドールどもが憤りながら、ちっぽけなモノを呑み込もうと躰を天へと伸ばす。",
   "ko_candidate": "5개의 태양의 열광에 시달리면서도､ 무수한 도울들이 분노하며 작은 것들을 삼키려 몸을 하늘로 뻗는다｡"
  },
  {
   "id": 46685,
   "key": "D1513le.txt:308",
   "file": "D1513le.txt",
   "line": 308,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「と、とんでもないことに……っ」",
   "ko_candidate": "「어､ 어마어마한 일이 벌어졌어…」"
  },
  {
   "id": 46686,
   "key": "D1513le.txt:311",
   "file": "D1513le.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しかし俺の意識はそんなミミズの親玉どもになんかない。",
   "ko_candidate": "하지만 내 의식은 그런 지렁이 우두머리들에게 있지 않다｡"
  },
  {
   "id": 46687,
   "key": "D1513le.txt:312",
   "file": "D1513le.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "斃すべき敵は、恐れるべき敵はただ一人。ただ一体。",
   "ko_candidate": "쓰러뜨려야 할 적은､ 두려워해야 할 적은 단 한 명｡ 단 하나｡"
  },
  {
   "id": 46688,
   "key": "D1513le.txt:314",
   "file": "D1513le.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "互いの奥義は不発に終わったが、第２撃目の体勢は既に整っている。",
   "ko_candidate": "서로의 오의는 불발로 끝났지만､ 두 번째 공격의 태세는 이미 갖추어져 있다｡"
  },
  {
   "id": 46689,
   "key": "D1513le.txt:322",
   "file": "D1513le.txt",
   "line": 322,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「破ァァァァァァァ！」",
   "ko_candidate": "「파아아아아아아아!」"
  },
  {
   "id": 46690,
   "key": "D1513le.txt:325",
   "file": "D1513le.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスの２撃目。",
   "ko_candidate": "리베르 레기스의 2타｡"
  },
  {
   "id": 46691,
   "key": "D1513le.txt:326",
   "file": "D1513le.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "間合いの外から繰り出される正拳突き。",
   "ko_candidate": "간합 밖에서 내지르는 정권 찌르기｡"
  },
  {
   "id": 46692,
   "key": "D1513le.txt:327",
   "file": "D1513le.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大気を媒介に伝播する破壊の波紋だ。",
   "ko_candidate": "대기를 매개로 전파되는 파괴의 파문이다｡"
  },
  {
   "id": 46693,
   "key": "D1513le.txt:329",
   "file": "D1513le.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "不可視の衝撃が、大気の分子を震動させ、翔ける。翔ける。翔ける。",
   "ko_candidate": "불가시의 충격이 대기의 분자를 진동시켜 날아간다｡ 날아간다｡ 날아간다｡"
  },
  {
   "id": 46694,
   "key": "D1513le.txt:336",
   "file": "D1513le.txt",
   "line": 336,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「斬ンンンンッ！」",
   "ko_candidate": "「참으으으으읏!」"
  },
  {
   "id": 46695,
   "key": "D1513le.txt:343",
   "file": "D1513le.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインの２撃目。",
   "ko_candidate": "데몬베인의 2타｡"
  },
  {
   "id": 46696,
   "key": "D1513le.txt:344",
   "file": "D1513le.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "偃月刀の招喚と同時に放つ、斬撃波。",
   "ko_candidate": "언월도의 소환과 동시에 내뿜는 참격파｡"
  },
  {
   "id": 46697,
   "key": "D1513le.txt:346",
   "file": "D1513le.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "迸る魔力が光刃と化し、大気を裂いて、疾る。疾る。疾る。",
   "ko_candidate": "솟구치는 마력이 빛의 칼날이 되어 대기를 가르며 질주한다｡ 질주한다｡ 질주한다｡"
  },
  {
   "id": 46698,
   "key": "D1513le.txt:353",
   "file": "D1513le.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "２つの破壊力は正面から衝突し、爆裂。",
   "ko_candidate": "두 개의 파괴력은 정면에서 충돌하여 폭발한다｡"
  },
  {
   "id": 46699,
   "key": "D1513le.txt:354",
   "file": "D1513le.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "近付いていたドールの十数匹を爆発に巻き込んだ。",
   "ko_candidate": "다가오고 있던 도울 십여 마리를 폭발에 휘말리게 했다｡"
  },
  {
   "id": 46700,
   "key": "D1513le.txt:360",
   "file": "D1513le.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頭部や胴体を破裂させられ、引き千切られ、穿たれ、猛毒の血をスコールのように撒き散らしながら、ドールどもは大地に斃れる。",
   "ko_candidate": "머리나 몸통이 터지고､ 찢겨나가고､ 뚫리며､ 맹독의 피를 스콜처럼 뿌리면서 도울들은 대지에 쓰러진다｡"
  },
  {
   "id": 46701,
   "key": "D1513le.txt:367",
   "file": "D1513le.txt",
   "line": 367,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「甘いッ！」",
   "ko_candidate": "「달콤해!」"
  },
  {
   "id": 46702,
   "key": "D1513le.txt:377",
   "file": "D1513le.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆発の閃光も消えないうちに、リューガは次の攻撃に入った。",
   "ko_candidate": "폭발의 섬광이 사라지기도 전에 류가는 다음 공격에 들어갔다｡"
  },
  {
   "id": 46703,
   "key": "D1513le.txt:377",
   "file": "D1513le.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "超高速に繰り出される両拳。",
   "ko_candidate": "초고속으로 뻗어나가는 양 주먹｡"
  },
  {
   "id": 46704,
   "key": "D1513le.txt:378",
   "file": "D1513le.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "連続する爆裂音が大気を伝播して迫る。",
   "ko_candidate": "연속되는 폭렬음이 대기를 통해 전파되어 다가온다｡"
  }
 ]
}