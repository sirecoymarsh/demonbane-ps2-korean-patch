 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "エンネア": "엔네아",
  "九郎": "쿠로",
  "アル": "알"
 },
 "items": [
  {
   "id": 13632,
   "key": "D0807al.txt:254",
   "file": "D0807al.txt",
   "line": 254,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「人間って。結構、そんな理由になってない理由で動いたりするもんじゃないのかな？」",
   "ko_candidate": "「인간이란 게｡ 꽤 그런 이유도 안 되는 이유로 움직이는 거 아닐까?」"
  },
  {
   "id": 13633,
   "key": "D0807al.txt:258",
   "file": "D0807al.txt",
   "line": 258,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……そうかなぁ？」",
   "ko_candidate": "「……그럴까?」"
  },
  {
   "id": 13634,
   "key": "D0807al.txt:262",
   "file": "D0807al.txt",
   "line": 262,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ボクサーに『何で戦うの？』って聞いたって『勝ちたいから』としか返って来ないと思うぞ」",
   "ko_candidate": "「복서한테 '왜 싸우는 거야?'라고 물어봐도 '이기고 싶어서'라고밖에 대답 안 할 거야」"
  },
  {
   "id": 13635,
   "key": "D0807al.txt:266",
   "file": "D0807al.txt",
   "line": 266,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 13636,
   "key": "D0807al.txt:270",
   "file": "D0807al.txt",
   "line": 270,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あえて言うなら――」",
   "ko_candidate": "「굳이 말하자면――」"
  },
  {
   "id": 13637,
   "key": "D0807al.txt:272",
   "file": "D0807al.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はエンネアの瞳を見つめたまま、微笑んだ。",
   "ko_candidate": "나는 엔네아의 눈동자를 바라보며 미소 지었다｡"
  },
  {
   "id": 13638,
   "key": "D0807al.txt:273",
   "file": "D0807al.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ少しばかり苦笑が混ざっていたかも知れない。",
   "ko_candidate": "다만 조금 쓴웃음이 섞였을지도 모른다｡"
  },
  {
   "id": 13639,
   "key": "D0807al.txt:276",
   "file": "D0807al.txt",
   "line": 276,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そうすると自分が気持ち良いから……かな？　少なくとも俺は。ははっ……結局はてめえ勝手な理由なんだよ。だから全然、大したもんじゃねえ」",
   "ko_candidate": "「그렇게 하면 내가 기분 좋으니까…… 일까? 적어도 나는｡ 하하…… 결국엔 제멋대로인 이유인 거지｡ 그래서 전혀 대단한 게 아니야」"
  },
  {
   "id": 13640,
   "key": "D0807al.txt:280",
   "file": "D0807al.txt",
   "line": 280,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 13641,
   "key": "D0807al.txt:284",
   "file": "D0807al.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "エンネアは、再び黙ってしまった。",
   "ko_candidate": "엔네아는 다시 말을 잃어버렸다｡"
  },
  {
   "id": 13642,
   "key": "D0807al.txt:285",
   "file": "D0807al.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "難しそうな顔で、何かを考え込んでいる。",
   "ko_candidate": "어려운 표정으로 뭔가를 골똘히 생각하고 있다｡"
  },
  {
   "id": 13643,
   "key": "D0807al.txt:287",
   "file": "D0807al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺はエンネアを待つことにした。彼女の顔をじっと、黙って見つめ続けて――やがてエンネアは、ゆっくりとした口調で問いかけてきた。",
   "ko_candidate": "나는 엔네아를 기다리기로 했다｡ 그녀의 얼굴을 뚫어지게､ 말없이 바라보며―― 이윽고 엔네아는 천천히 입을 열었다｡"
  },
  {
   "id": 13644,
   "key": "D0807al.txt:291",
   "file": "D0807al.txt",
   "line": 291,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「もし……全部無駄だとしたら？」",
   "ko_candidate": "「만약…… 전부 헛수고라면?」"
  },
  {
   "id": 13645,
   "key": "D0807al.txt:297",
   "file": "D0807al.txt",
   "line": 297,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ん？」",
   "ko_candidate": "「응?」"
  },
  {
   "id": 13646,
   "key": "D0807al.txt:300",
   "file": "D0807al.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "冷たい声だった。",
   "ko_candidate": "차가운 목소리였다｡"
  },
  {
   "id": 13647,
   "key": "D0807al.txt:301",
   "file": "D0807al.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "感情の凍りついた――寂しい声だった。",
   "ko_candidate": "감정이 얼어붙은――쓸쓸한 목소리였다｡"
  },
  {
   "id": 13648,
   "key": "D0807al.txt:304",
   "file": "D0807al.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺を見下ろす瞳は、まるで初めて出会った夜のように意思の光が無い。そんな気がしてならない。",
   "ko_candidate": "나를 내려다보는 그녀의 눈동자는､ 마치 처음 만났던 밤과 같이､ 의지의 빛이 없는――그런 느낌이 들어 어쩔 수 없었다｡ 방이 어두워서､ 잘못 본 건가｡"
  },
  {
   "id": 13649,
   "key": "D0807al.txt:310",
   "file": "D0807al.txt",
   "line": 310,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「もしもね。未来を知ることが出来て、それでどんなに必死に戦ったって、誰も救えない、救われない。全部無駄なことだって分かったらどうする？」",
   "ko_candidate": "그녀는 차갑고､ 쓸쓸한 목소리로 이어갔다｡ 「만약 말이야｡ 미래를 알 수 있게 되어서､ 아무리 필사적으로 싸워도､ 누구도 구할 수 없고､ 구원받을 수 없어｡ 전부 헛된 일이라는 걸 알게 된다면 어떻게 할 거야? ――그래도 아직 싸울 수 있어?」"
  },
  {
   "id": 13650,
   "key": "D0807al.txt:313",
   "file": "D0807al.txt",
   "line": 313,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――それでもまだ戦える？」",
   "ko_candidate": "흠……그렇군｡ 자신이 하고 있는 일이 전부 헛된 게 아닐까……라고｡"
  },
  {
   "id": 13651,
   "key": "D0807al.txt:316",
   "file": "D0807al.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ふむ……なるほど。",
   "ko_candidate": "누구나 한 번쯤은 생각하는 거지｡"
  },
  {
   "id": 13652,
   "key": "D0807al.txt:317",
   "file": "D0807al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自分のやっていることは全て無駄なんじゃないか……ってか。",
   "ko_candidate": "한 번뿐만 아니라､ 몇 번이고 몇 번이고､ 살아있는 한 계속 생각하게 되는 거야､ 틀림없이｡"
  },
  {
   "id": 13653,
   "key": "D0807al.txt:319",
   "file": "D0807al.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "誰しもが一度は考えることだ。",
   "ko_candidate": "그래서､ 나는 오히려 되물었다｡"
  },
  {
   "id": 13654,
   "key": "D0807al.txt:320",
   "file": "D0807al.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一度と言わず、何度も何度も、生きている限り考え続けることだ、きっと。 だから、俺は逆に訊ね返した。",
   "ko_candidate": "「그럼 말이야……전부 헛된 일이었다고 치자｡ 그래서 아무것도 하지 않고 있을 수 있을까? 아무것도 하지 않고 참을 수 있을까? 음――…나는 무리일 것 같은데」"
  },
  {
   "id": 13655,
   "key": "D0807al.txt:325",
   "file": "D0807al.txt",
   "line": 325,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じゃあさ……全部無駄だったとしてだ」",
   "ko_candidate": "「――――――」 엔네아는､ 눈을 동그랗게 뜨고､ 놀란 듯한 표정을 지었다｡"
  },
  {
   "id": 13656,
   "key": "D0807al.txt:328",
   "file": "D0807al.txt",
   "line": 328,
   "speaker": "九郎 / エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それで何もしないでいられるかな？何もしないで我慢できるのかな？ 「んー……俺には無理っぽいな」 「――――――」 エンネアは、目を丸くして、驚いたような表情をした。 ぽかんと口を開けて、俺のことをまじまじと見つめている。 ……何か、照れくさい。",
   "ko_candidate": "멍하니 입을 벌리고､ 나를 뚫어지게 바라보고 있다｡ ……뭔가､ 부끄럽네｡"
  },
  {
   "id": 13657,
   "key": "D0807al.txt:343",
   "file": "D0807al.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "痛みも治まったので、身体を起こす。",
   "ko_candidate": "통증도 가라앉아서､ 몸을 일으킨다｡"
  },
  {
   "id": 13658,
   "key": "D0807al.txt:344",
   "file": "D0807al.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "最後に一言だけ付け加えた。",
   "ko_candidate": "마지막으로 한마디만 덧붙였다｡"
  },
  {
   "id": 13659,
   "key": "D0807al.txt:347",
   "file": "D0807al.txt",
   "line": 347,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だいたいさ。戦っているときはみんな必死だからさ。 そんなこと気にしている余裕なんてねえよ」",
   "ko_candidate": "「대체로 말이야｡ 싸우고 있을 때는 모두 필사적이니까｡ 그런 걸 신경 쓸 여유 같은 건 없다고」"
  },
  {
   "id": 13660,
   "key": "D0807al.txt:351",
   "file": "D0807al.txt",
   "line": 351,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「さっ……もう遅いから寝ようぜ、エンネア」",
   "ko_candidate": "「자……이제 늦었으니까 자자､ 엔네아」"
  },
  {
   "id": 13661,
   "key": "D0807al.txt:361",
   "file": "D0807al.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ソファーをエンネアに明け渡し、九郎は床に寝た。",
   "ko_candidate": "소파를 엔네아에게 양보하고､ 쿠로는 바닥에 누웠다｡"
  },
  {
   "id": 13662,
   "key": "D0807al.txt:363",
   "file": "D0807al.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "エンネアはソファーに腰掛けたまま、凝っと眠る九郎を見つめ続ける。",
   "ko_candidate": "엔네아는 소파에 걸터앉은 채､ 꼭 잠든 쿠로를 계속 바라본다｡"
  },
  {
   "id": 13663,
   "key": "D0807al.txt:368",
   "file": "D0807al.txt",
   "line": 368,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「後味悪ィ……か」",
   "ko_candidate": "「뒷맛 나쁘군……인가」"
  },
  {
   "id": 13664,
   "key": "D0807al.txt:371",
   "file": "D0807al.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "先程の九郎の言葉を反芻する。",
   "ko_candidate": "방금 전 쿠로의 말을 되새긴다｡"
  },
  {
   "id": 13665,
   "key": "D0807al.txt:373",
   "file": "D0807al.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "正直、よく分からない。",
   "ko_candidate": "솔직히､ 잘 모르겠다｡"
  },
  {
   "id": 13666,
   "key": "D0807al.txt:374",
   "file": "D0807al.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そもそも理屈にすらなっていないから、当然の事かも知れない。",
   "ko_candidate": "애초에 이치에도 맞지 않으니､ 당연한 일일지도 모른다｡"
  },
  {
   "id": 13667,
   "key": "D0807al.txt:376",
   "file": "D0807al.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、その言葉はエンネアの心の深い場所に、引っかかるのだった。",
   "ko_candidate": "하지만､ 그 말은 엔네아의 마음 깊은 곳에､ 걸리는 것이었다｡"
  },
  {
   "id": 13668,
   "key": "D0807al.txt:378",
   "file": "D0807al.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "癖っ毛な髪をぐしゃぐしゃと掻く。",
   "ko_candidate": "곱슬머리를 헝클어뜨린다｡"
  },
  {
   "id": 13669,
   "key": "D0807al.txt:380",
   "file": "D0807al.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "唐突に、声をかけた。",
   "ko_candidate": "갑자기､ 말을 걸었다｡"
  },
  {
   "id": 13670,
   "key": "D0807al.txt:385",
   "file": "D0807al.txt",
   "line": 385,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「盗み聞きはどうかと思うなあ～、アル？」",
   "ko_candidate": "「엿듣는 건 좀 그렇지 않아~､ 알?」"
  },
  {
   "id": 13671,
   "key": "D0807al.txt:389",
   "file": "D0807al.txt",
   "line": 389,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……汝にその呼び方をされる筋合いは無い」",
   "ko_candidate": "「……네놈에게 그렇게 불릴 이유는 없다」"
  }
 ]
}