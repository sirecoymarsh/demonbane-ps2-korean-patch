 },
 "items": [
  {
   "id": 12144,
   "key": "D0801ru.txt:259",
   "file": "D0801ru.txt",
   "line": 259,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その本は『ネクロノミコン新釈』か！　なかなかに考えたではないか！ だが……」",
   "ko_candidate": "「그 책은 『네크로노미콘 신석』인가! 꽤나 생각을 했구나! 하지만…」"
  },
  {
   "id": 12145,
   "key": "D0801ru.txt:264",
   "file": "D0801ru.txt",
   "line": 264,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「覇アアアアァァッ！」",
   "ko_candidate": "「하아아아아아앗!」"
  },
  {
   "id": 12146,
   "key": "D0801ru.txt:267",
   "file": "D0801ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "旋風に乗るように、老人の躰が高速回転した。",
   "ko_candidate": "선풍을 타듯 노인의 몸이 고속 회전했다｡"
  },
  {
   "id": 12147,
   "key": "D0801ru.txt:268",
   "file": "D0801ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触れるものをことごとく両断する竜巻、刃金の独楽と化した老人が、金の獣に斬りかかる。",
   "ko_candidate": "닿는 것을 모조리 양단하는 용오름､ 칼날의 팽이가 된 노인이 황금빛 짐승에게 베어 들어간다｡"
  },
  {
   "id": 12148,
   "key": "D0801ru.txt:272",
   "file": "D0801ru.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃の嵐が獣を捉える。",
   "ko_candidate": "칼날의 폭풍이 짐승을 포착한다｡"
  },
  {
   "id": 12149,
   "key": "D0801ru.txt:273",
   "file": "D0801ru.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、刃は実体を擦り抜け――金色の影は、雪となって散る。",
   "ko_candidate": "하지만 칼날은 실체를 스쳐 지나가고――황금빛 그림자는 눈이 되어 흩어진다｡"
  },
  {
   "id": 12150,
   "key": "D0801ru.txt:276",
   "file": "D0801ru.txt",
   "line": 276,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 12151,
   "key": "D0801ru.txt:282",
   "file": "D0801ru.txt",
   "line": 282,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その本は信頼に足る内容とは言い難い」",
   "ko_candidate": "「그 책은 신뢰할 만한 내용이라고 하기 어렵군」"
  },
  {
   "id": 12152,
   "key": "D0801ru.txt:287",
   "file": "D0801ru.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "１１人の金色が、老人を囲んだ。",
   "ko_candidate": "11명의 황금빛이 노인을 둘러쌌다｡"
  },
  {
   "id": 12153,
   "key": "D0801ru.txt:288",
   "file": "D0801ru.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "１１の拳が老人の躰に叩き込まれる。",
   "ko_candidate": "11개의 주먹이 노인의 몸에 내리꽂힌다｡"
  },
  {
   "id": 12154,
   "key": "D0801ru.txt:291",
   "file": "D0801ru.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "骨が砕ける鈍い音が、体内を震わせる。",
   "ko_candidate": "뼈가 부서지는 둔탁한 소리가 체내를 진동시킨다｡"
  },
  {
   "id": 12155,
   "key": "D0801ru.txt:303",
   "file": "D0801ru.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "老人の躰は砲弾の如く吹っ飛び、 時計塔の壁を破壊した。",
   "ko_candidate": "노인의 몸은 포탄처럼 날아가 시계탑의 벽을 파괴했다｡"
  },
  {
   "id": 12156,
   "key": "D0801ru.txt:306",
   "file": "D0801ru.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クレーター状に罅割れる壁面。",
   "ko_candidate": "크레이터 모양으로 갈라지는 벽면｡"
  },
  {
   "id": 12157,
   "key": "D0801ru.txt:316",
   "file": "D0801ru.txt",
   "line": 316,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ガァッフゥアァ！」",
   "ko_candidate": "「가아아후우아아!」"
  },
  {
   "id": 12158,
   "key": "D0801ru.txt:318",
   "file": "D0801ru.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の固まりを吐き出し、激しく咳き込む。",
   "ko_candidate": "핏덩이를 토해내며 격렬하게 기침한다｡"
  },
  {
   "id": 12159,
   "key": "D0801ru.txt:320",
   "file": "D0801ru.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "１１人の獣は融けて重なり、再び１人に戻った。",
   "ko_candidate": "11명의 짐승은 녹아 겹쳐져 다시 한 명으로 돌아왔다｡"
  },
  {
   "id": 12160,
   "key": "D0801ru.txt:324",
   "file": "D0801ru.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "髪を靡かせ、空中に停止する。",
   "ko_candidate": "머리카락을 휘날리며 공중에 정지한다｡"
  },
  {
   "id": 12161,
   "key": "D0801ru.txt:326",
   "file": "D0801ru.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雪は、静かに降っている。",
   "ko_candidate": "눈은 조용히 내리고 있다｡"
  },
  {
   "id": 12162,
   "key": "D0801ru.txt:330",
   "file": "D0801ru.txt",
   "line": 330,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その魔導書では少々、力不足だ。 だが、これで終わり……という事は、いくら何でもあるまいよな？」",
   "ko_candidate": "「그 마도서로는 좀､ 역부족이군｡ 하지만 이걸로 끝… 이라고 하기엔､ 아무래도 좀 그렇지 않나?」"
  },
  {
   "id": 12163,
   "key": "D0801ru.txt:335",
   "file": "D0801ru.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時計塔の鐘が鳴る。",
   "ko_candidate": "시계탑의 종이 울린다｡"
  },
  {
   "id": 12164,
   "key": "D0801ru.txt:337",
   "file": "D0801ru.txt",
   "line": 337,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人は動けない。時計塔の壁にめり込んだまま、息を荒げるだけだ。",
   "ko_candidate": "노인은 움직일 수 없다｡ 시계탑의 벽에 박힌 채 거친 숨만 내쉰다｡"
  },
  {
   "id": 12165,
   "key": "D0801ru.txt:339",
   "file": "D0801ru.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雪と風の冷たさが、老人を苛む。",
   "ko_candidate": "눈과 바람의 차가움이 노인을 괴롭힌다｡"
  },
  {
   "id": 12166,
   "key": "D0801ru.txt:343",
   "file": "D0801ru.txt",
   "line": 343,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「余と貴公との因縁ぞ。簡単に決着してくれるな」",
   "ko_candidate": "「나와 당신의 인연이다｡ 간단히 결판 짓지 말게」"
  },
  {
   "id": 12167,
   "key": "D0801ru.txt:347",
   "file": "D0801ru.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時計塔の鐘が鳴る。",
   "ko_candidate": "시계탑의 종이 울린다｡"
  },
  {
   "id": 12168,
   "key": "D0801ru.txt:348",
   "file": "D0801ru.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人は動けない。",
   "ko_candidate": "노인은 움직일 수 없다｡"
  },
  {
   "id": 12169,
   "key": "D0801ru.txt:352",
   "file": "D0801ru.txt",
   "line": 352,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チャンスをやろう。今から、鐘の音が完全に鳴り止むまでの間、余は無防備に徹し続けよう」 「その間に、老いた貴公の全力を賭して、最期の灯火までをも完全に燃焼して、運命から勝利を奪い取ってみせよ」",
   "ko_candidate": "「기회를 주지｡ 지금부터 종소리가 완전히 멎을 때까지､ 나는 무방비 상태를 유지하겠다｡ 그 동안 늙은 당신의 전력을 걸고､ 마지막 불꽃까지 완전히 태워 운명으로부터 승리를 쟁취해 보게」"
  },
  {
   "id": 12170,
   "key": "D0801ru.txt:359",
   "file": "D0801ru.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時計塔の鐘が鳴る。",
   "ko_candidate": "시계탑의 종이 울린다｡"
  },
  {
   "id": 12171,
   "key": "D0801ru.txt:360",
   "file": "D0801ru.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人は動けない。",
   "ko_candidate": "노인은 움직일 수 없다｡"
  },
  {
   "id": 12172,
   "key": "D0801ru.txt:364",
   "file": "D0801ru.txt",
   "line": 364,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ、どうした？　まだやる気が 湧いて来ないか？　分かった。 なら、これではどうだ？」 「――余を失望させてみよ。そのときは、貴公の大事な『孫娘』。イハ＝ントレイの魚共の餌にくれてやる」",
   "ko_candidate": "「자､ 어떻게 된 건가? 아직도 의욕이 생기지 않나? 알겠다｡ 그렇다면 이건 어떤가? ――나를 실망시켜 보게｡ 그때는 당신의 소중한 『손녀』｡ 범하고 난 뒤 이하-느트레이의 물고기들의 먹이로 주겠다」"
  },
  {
   "id": 12173,
   "key": "D0801ru.txt:373",
   "file": "D0801ru.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時計塔の鐘が鳴る。",
   "ko_candidate": "시계탑의 종이 울린다｡"
  },
  {
   "id": 12174,
   "key": "D0801ru.txt:375",
   "file": "D0801ru.txt",
   "line": 375,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人は――",
   "ko_candidate": "노인은――"
  },
  {
   "id": 12175,
   "key": "D0801ru.txt:378",
   "file": "D0801ru.txt",
   "line": 378,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「後悔するなよ！　糞餓鬼！」",
   "ko_candidate": "「후회하지 마라! 젠장할 꼬마 녀석!」"
  },
  {
   "id": 12176,
   "key": "D0801ru.txt:380",
   "file": "D0801ru.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "翔けた。",
   "ko_candidate": "날아올랐다｡"
  },
  {
   "id": 12177,
   "key": "D0801ru.txt:388",
   "file": "D0801ru.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の魔導書の頁が舞う。",
   "ko_candidate": "무수한 마도서의 페이지가 날아다닌다｡"
  },
  {
   "id": 12178,
   "key": "D0801ru.txt:390",
   "file": "D0801ru.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の獣に纏わり、躰を拘束する。",
   "ko_candidate": "황금빛 짐승에게 휘감겨 몸을 구속한다｡"
  },
  {
   "id": 12179,
   "key": "D0801ru.txt:395",
   "file": "D0801ru.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鐘が鳴った。",
   "ko_candidate": "종이 울렸다｡"
  },
  {
   "id": 12180,
   "key": "D0801ru.txt:400",
   "file": "D0801ru.txt",
   "line": 400,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだ！　斃せないまでも……余を愉しませてみよ！ この無限の倦怠を、少しでも癒してみせよ！」",
   "ko_candidate": "「그래! 쓰러뜨리지 못하더라도… 나를 즐겁게 해보게! 이 무한한 권태를､ 조금이라도 치유해 보게!」"
  },
  {
   "id": 12181,
   "key": "D0801ru.txt:409",
   "file": "D0801ru.txt",
   "line": 409,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜闇を疾る何十もの銀の煌めき。",
   "ko_candidate": "어둠 속을 가르는 수십 개의 은빛 번쩍임｡"
  },
  {
   "id": 12182,
   "key": "D0801ru.txt:411",
   "file": "D0801ru.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "儀礼を施した銀ナイフの群れが飛来して、獣に突き刺さった。",
   "ko_candidate": "의식을 치른 은 나이프 무리가 날아와 짐승에게 꽂혔다｡"
  },
  {
   "id": 12183,
   "key": "D0801ru.txt:413",
   "file": "D0801ru.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を滴らせながら――いつしか獣は歌い出した。",
   "ko_candidate": "피를 흘리면서――어느새 짐승은 노래를 부르기 시작했다｡"
  }
 ]
}