   "key": "D0412.txt:483",
   "file": "D0412.txt",
   "line": 483,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「私だけで……充分だ……ッ！」",
   "ko_candidate": "「나 하나로……충분해……!」"
