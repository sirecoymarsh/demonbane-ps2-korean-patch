   "key": "D0412.txt:387",
   "file": "D0412.txt",
   "line": 387,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「メタトロンっっ！」",
   "ko_candidate": "「메타트론!」"
