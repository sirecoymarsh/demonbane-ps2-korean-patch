  {
   "id": 5526,
   "key": "D0412.txt:218",
   "file": "D0412.txt",
   "line": 218,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっちいけぇぇぇぇぇぇぇぇ！」",
   "ko_candidate": "손을 뻗어 앨리슨을 잡으려 한다｡ 하지만 앨리슨은 고개를 격렬하게 흔들며 눈물을 날리며 거부한다｡"
  },
  {
   "id": 5527,
   "key": "D0412.txt:238",
   "file": "D0412.txt",
   "line": 238,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
