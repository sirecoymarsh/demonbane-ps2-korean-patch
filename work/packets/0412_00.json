   "key": "D0412.txt:292",
   "file": "D0412.txt",
   "line": 292,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「無謀な！」",
   "ko_candidate": "「무모해!」"
  },
  {
   "id": 5534,
   "key": "D0412.txt:303",
   "file": "D0412.txt",
