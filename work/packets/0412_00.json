  {
   "id": 5539,
   "key": "D0412.txt:423",
   "file": "D0412.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白い装甲が紅く染められてゆく。",
   "ko_candidate": "하얀 장갑을 붉은 피가 물들여 간다｡"
  },
  {
   "id": 5540,
   "key": "D0412.txt:425",
   "file": "D0412.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それでもメタトロンは……",
   "ko_candidate": "그래도 메타트론은……"
  },
  {
   "id": 5541,
   "key": "D0412.txt:436",
   "file": "D0412.txt",
   "line": 436,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……戦うのは」",
   "ko_candidate": "「……싸우는 건」"
