   "key": "D0412.txt:466",
   "file": "D0412.txt",
   "line": 466,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……戦いに巻き込まれるのは」",
   "ko_candidate": "「……싸움에 휘말리는 건」"
