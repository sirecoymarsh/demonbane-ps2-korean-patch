  {
   "id": 5538,
   "key": "D0412.txt:422",
   "file": "D0412.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ついに亀裂の隙間から、流れ出す血。",
   "ko_candidate": "마침내 균열 사이로 피가 뿜어져 나왔다｡"
