   "key": "D0412.txt:286",
   "file": "D0412.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして再びアリスンに向かっていく。",
   "ko_candidate": "그리고 다시 앨리슨을 향해 간다｡"
  },
  {
