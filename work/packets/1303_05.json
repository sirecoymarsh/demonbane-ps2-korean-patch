 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "瑠璃": "루리",
  "九郎": "쿠로",
  "ドクター・ウェスト": "닥터 웨스트",
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 31661,
   "key": "D1303ru.txt:186",
   "file": "D1303ru.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無言のまま、光の無い瞳のまま、再び、何の感慨も無く、自動的に、偃月刀を構え直す。",
   "ko_candidate": "무언인 채､ 빛 없는 눈동자인 채､ 다시 아무런 감흥도 없이 자동적으로 언월도를 다시 겨눈다｡"
  },
  {
   "id": 31662,
   "key": "D1303ru.txt:190",
   "file": "D1303ru.txt",
   "line": 190,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「魂が囚われておる。世界を拒絶し、近寄る者には闘争本能を剥き出しにして襲い掛かる」 「取り憑いた魔性に、修羅を呼び起こされたようだ……」",
   "ko_candidate": "「영혼이 사로잡혔구나｡ 세계를 거부하고 다가오는 자에게는 투쟁 본능을 드러내며 덤벼든다｡ 씌운 마성에 의해 수라를 불러일으킨 것 같다…」"
  },
  {
   "id": 31663,
   "key": "D1303ru.txt:197",
   "file": "D1303ru.txt",
   "line": 197,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そんな……！」",
   "ko_candidate": "「그럴 리가…!」"
  },
  {
   "id": 31664,
   "key": "D1303ru.txt:200",
   "file": "D1303ru.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔える闇黒が、一瞬だけ静止した。",
   "ko_candidate": "타오르는 암흑이 잠시 정지했다｡"
  },
  {
   "id": 31665,
   "key": "D1303ru.txt:201",
   "file": "D1303ru.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那――",
   "ko_candidate": "순간――"
  },
  {
   "id": 31666,
   "key": "D1303ru.txt:203",
   "file": "D1303ru.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルが瑠璃の神経系に介入、偽のシグナルを脊髄神経に送り込み、瑠璃の躰を動かした。このような強引な介入は、術者の肉体に大きなダメージを与えてしまうが、それを心配している場合ではなかった。",
   "ko_candidate": "알이 루리의 신경계에 개입해 거짓 신호를 척수신경에 보내 루리의 몸을 움직였다｡ 이런 강압적인 개입은 술자의 육체에 큰 데미지를 주지만､ 그걸 걱정할 상황이 아니었다｡"
  },
  {
   "id": 31667,
   "key": "D1303ru.txt:211",
   "file": "D1303ru.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全速力で飛び退く。",
   "ko_candidate": "전속력으로 뛰어 물러난다｡"
  },
  {
   "id": 31668,
   "key": "D1303ru.txt:213",
   "file": "D1303ru.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――すぐ目の前に、九郎が居た。",
   "ko_candidate": "――바로 눈앞에 쿠로가 있었다｡"
  },
  {
   "id": 31669,
   "key": "D1303ru.txt:215",
   "file": "D1303ru.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の動体視力では、その動きをまったく捉えられなかった。",
   "ko_candidate": "루리의 동체시력으로는 그 움직임을 전혀 포착할 수 없었다｡"
  },
  {
   "id": 31670,
   "key": "D1303ru.txt:217",
   "file": "D1303ru.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それどころか動いた気配すら感じられなかった。",
   "ko_candidate": "그뿐만 아니라 움직인 기척조차 느낄 수 없었다｡"
  },
  {
   "id": 31671,
   "key": "D1303ru.txt:219",
   "file": "D1303ru.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルもまた同様だった。避けられたのは、千年の間で鍛えられ、研ぎ澄まされた戦士の勘のお陰だった。",
   "ko_candidate": "알 역시 마찬가지였다｡ 피할 수 있었던 건 천 년 동안 단련되고 연마된 전사의 직감 덕분이었다｡"
  },
  {
   "id": 31672,
   "key": "D1303ru.txt:221",
   "file": "D1303ru.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の躰は後ろに跳ぶ。",
   "ko_candidate": "루리의 몸이 뒤로 뛴다｡"
  },
  {
   "id": 31673,
   "key": "D1303ru.txt:222",
   "file": "D1303ru.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の姿が遠のく。",
   "ko_candidate": "쿠로의 모습이 멀어진다｡"
  },
  {
   "id": 31674,
   "key": "D1303ru.txt:225",
   "file": "D1303ru.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一瞬前まで瑠璃が立っていた場所の地面は、 飛びかかった九郎に踏み抜かれて、陥没していた。",
   "ko_candidate": "잠시 전까지 루리가 서 있던 자리의 땅은 뛰어든 쿠로에 의해 밟혀 함몰되어 있었다｡"
  },
  {
   "id": 31675,
   "key": "D1303ru.txt:227",
   "file": "D1303ru.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬でも逃げるのが遅れていたら、踏み潰されていた。",
   "ko_candidate": "잠시라도 도망치는 게 늦었다면 밟혀 죽었을 것이다｡"
  },
  {
   "id": 31676,
   "key": "D1303ru.txt:230",
   "file": "D1303ru.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "着地。",
   "ko_candidate": "착지｡"
  },
  {
   "id": 31677,
   "key": "D1303ru.txt:231",
   "file": "D1303ru.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それと同時に無理をかけた神経が悲鳴を上げた。",
   "ko_candidate": "동시에 무리를 한 신경이 비명을 질렀다｡"
  },
  {
   "id": 31678,
   "key": "D1303ru.txt:233",
   "file": "D1303ru.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を駆け抜ける激痛に思わず、その場に蹲る。",
   "ko_candidate": "온몸을 관통하는 격통에 저도 모르게 그 자리에 쪼그려 앉는다｡"
  },
  {
   "id": 31679,
   "key": "D1303ru.txt:235",
   "file": "D1303ru.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "息が詰まって、悲鳴すら零れない。",
   "ko_candidate": "숨이 막혀 비명조차 새어 나오지 않는다｡"
  },
  {
   "id": 31680,
   "key": "D1303ru.txt:236",
   "file": "D1303ru.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その隙にも九郎は――",
   "ko_candidate": "그 틈에도 쿠로는――"
  },
  {
   "id": 31681,
   "key": "D1303ru.txt:260",
   "file": "D1303ru.txt",
   "line": 260,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「っ……ぁ……ッ！　…………？」",
   "ko_candidate": "「…아…! ……?」"
  },
  {
   "id": 31682,
   "key": "D1303ru.txt:268",
   "file": "D1303ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロケット弾の爆発が、九郎を包み込む。",
   "ko_candidate": "로켓탄의 폭발이 쿠로를 감싼다｡"
  },
  {
   "id": 31683,
   "key": "D1303ru.txt:269",
   "file": "D1303ru.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃達の後ろ、ようやく駆けつけたドクター・ウェストのギターケース・バズーカによる砲撃だった。",
   "ko_candidate": "루리 일행의 뒤에서 겨우 달려온 닥터 웨스트의 기타케이스 바주카에 의한 포격이었다｡"
  },
  {
   "id": 31684,
   "key": "D1303ru.txt:273",
   "file": "D1303ru.txt",
   "line": 273,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ったく、何がどうしたであるか！」",
   "ko_candidate": "「…젠장､ 대체 무슨 일이야!」"
  },
  {
   "id": 31685,
   "key": "D1303ru.txt:276",
   "file": "D1303ru.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎から目を離さず、ドクター・ウェストは毒づく。",
   "ko_candidate": "폭염에서 눈을 떼지 않고 닥터 웨스트가 욕설을 내뱉는다｡"
  },
  {
   "id": 31686,
   "key": "D1303ru.txt:278",
   "file": "D1303ru.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "案の定、傷一つ負っていない九郎が、炎の向こうから、ゆらりと姿を現した。",
   "ko_candidate": "예상대로 상처 하나 입지 않은 쿠로가 불꽃 너머에서 어슬렁거리며 모습을 드러냈다｡"
  },
  {
   "id": 31687,
   "key": "D1303ru.txt:281",
   "file": "D1303ru.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀を軽く振るう。",
   "ko_candidate": "언월도를 가볍게 휘두른다｡"
  },
  {
   "id": 31688,
   "key": "D1303ru.txt:283",
   "file": "D1303ru.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それだけで炎は砕け散るようにして、消し飛ばされてしまった。",
   "ko_candidate": "그것만으로도 불꽃은 부서지듯 날아가 버렸다｡"
  },
  {
   "id": 31689,
   "key": "D1303ru.txt:285",
   "file": "D1303ru.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ドクター・ウェストが、唾を飛ばしながら怒鳴る。",
   "ko_candidate": "닥터 웨스트가 침을 튀기며 고함친다｡"
  },
  {
   "id": 31690,
   "key": "D1303ru.txt:289",
   "file": "D1303ru.txt",
   "line": 289,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なぁぁぁぁにをやっているのであるか、大十字九郎！ 貴様、戦う相手を間違えて……うおおおおおおおおっ!?」 飛んで来た斬撃を、慌ててかわす。",
   "ko_candidate": "「뭐어어어어어를 하고 있는 거야､ 다이쥬지 쿠로! 네놈､ 싸울 상대를 착각하고… 우오오오오오오오!?」"
  },
  {
   "id": 31691,
   "key": "D1303ru.txt:296",
   "file": "D1303ru.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身体スレスレを掠める斬撃波は、",
   "ko_candidate": "날아온 참격을 황급히 피한다｡"
  },
  {
   "id": 31692,
   "key": "D1303ru.txt:297",
   "file": "D1303ru.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ギターケース・バズーカを両断した。 無論、爆発した。",
   "ko_candidate": "몸을 스치듯 지나간 참격파는 기타케이스 바주카를 양단했다｡"
  },
  {
   "id": 31693,
   "key": "D1303ru.txt:301",
   "file": "D1303ru.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無論、至近距離だった。",
   "ko_candidate": "물론 폭발했다｡"
  },
  {
   "id": 31694,
   "key": "D1303ru.txt:302",
   "file": "D1303ru.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、気絶した。",
   "ko_candidate": "물론 지근거리였다｡"
  },
  {
   "id": 31695,
   "key": "D1303ru.txt:306",
   "file": "D1303ru.txt",
   "line": 306,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ぎゃぶっ、ぐふっ」",
   "ko_candidate": "물론 기절했다｡ 「…꺄붑､ 꾸훗」"
  },
  {
   "id": 31696,
   "key": "D1303ru.txt:310",
   "file": "D1303ru.txt",
   "line": 310,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ええい！　何しに出てきた！」",
   "ko_candidate": "「이런! 뭐하러 나온 거야!」"
  },
  {
   "id": 31697,
   "key": "D1303ru.txt:317",
   "file": "D1303ru.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "三度、九郎が偃月刀を振るう。",
   "ko_candidate": "세 번째로 쿠로가 언월도를 휘두른다｡"
  },
  {
   "id": 31698,
   "key": "D1303ru.txt:318",
   "file": "D1303ru.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その動きに合わせて、焔える闇黒が、なお烈しく猛り狂った。",
   "ko_candidate": "그 움직임에 맞춰 타오르는 암흑이 더욱 맹렬히 날뛰었다｡"
  },
  {
   "id": 31699,
   "key": "D1303ru.txt:320",
   "file": "D1303ru.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溢れ出す闇黒は、既に瑠璃達をも取り囲んでいる。",
   "ko_candidate": "넘쳐나는 암흑은 이미 루리 일행마저 둘러싸고 있다｡"
  },
  {
   "id": 31700,
   "key": "D1303ru.txt:322",
   "file": "D1303ru.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間を埋め尽くし、わななく。",
   "ko_candidate": "공간을 가득 채우고 떨린다｡"
  }
 ]
}