 "items": [
  {
   "id": 47223,
   "key": "D1514ru.txt:123",
   "file": "D1514ru.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのほんの僅かを、汝は重ね過ぎていた。",
   "ko_candidate": "그 작은 차이를､ 너는 너무 많이 쌓아왔다｡"
  },
  {
   "id": 47224,
   "key": "D1514ru.txt:124",
   "file": "D1514ru.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "汝は只の人間でありながら、人間を超えていた。",
   "ko_candidate": "너는 그저 인간이면서도､ 인간을 초월했다｡"
  },
  {
   "id": 47225,
   "key": "D1514ru.txt:126",
   "file": "D1514ru.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが大十字九郎。",
   "ko_candidate": "그것이 바로 다이쥬지 쿠로다｡"
  },
  {
   "id": 47226,
   "key": "D1514ru.txt:128",
   "file": "D1514ru.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして……奴は、きっと妾をも変えてしまった。",
   "ko_candidate": "그리고… 그 자는 분명 나를 변화시켰다｡"
  },
  {
   "id": 47227,
   "key": "D1514ru.txt:129",
   "file": "D1514ru.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "単なる魔導書である妾を、",
   "ko_candidate": "단순한 마도서였던 나를､"
  },
  {
   "id": 47228,
   "key": "D1514ru.txt:130",
   "file": "D1514ru.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "只、戦うだけの存在である妾を、",
   "ko_candidate": "그저 싸우기만 하는 존재였던 나를､"
  },
  {
   "id": 47229,
   "key": "D1514ru.txt:131",
   "file": "D1514ru.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎、汝は――",
   "ko_candidate": "쿠로､ 너는―"
  },
  {
   "id": 47230,
   "key": "D1514ru.txt:142",
   "file": "D1514ru.txt",
   "line": 142,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何としても、汝を救う」",
   "ko_candidate": "「무슨 일이 있어도､ 너를 구하겠다」"
  },
  {
   "id": 47231,
   "key": "D1514ru.txt:145",
   "file": "D1514ru.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今。",
   "ko_candidate": "지금｡"
  },
  {
   "id": 47232,
   "key": "D1514ru.txt:146",
   "file": "D1514ru.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それだけが。",
   "ko_candidate": "그것만이｡"
  },
  {
   "id": 47233,
   "key": "D1514ru.txt:147",
   "file": "D1514ru.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾が、奴にしてやれる事の総てだ。",
   "ko_candidate": "내가 그에게 해줄 수 있는 전부다｡"
  },
  {
   "id": 47234,
   "key": "D1514ru.txt:149",
   "file": "D1514ru.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何としても――",
   "ko_candidate": "무슨 일이 있어도―"
  },
  {
   "id": 47235,
   "key": "D1514ru.txt:156",
   "file": "D1514ru.txt",
   "line": 156,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それで、本当に良いのかい？」",
   "ko_candidate": "「그래도 정말 괜찮은 거니?」"
  },
  {
   "id": 47236,
   "key": "D1514ru.txt:159",
   "file": "D1514ru.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――この気配。",
   "ko_candidate": "―이 기척｡"
  },
  {
   "id": 47237,
   "key": "D1514ru.txt:160",
   "file": "D1514ru.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾の精神領域に踏み込む、この混沌とした気配は。",
   "ko_candidate": "내 정신 영역에 들어오는 이 혼돈스러운 기척은｡"
  },
  {
   "id": 47238,
   "key": "D1514ru.txt:162",
   "file": "D1514ru.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目の前で、闇が焔えていた。",
   "ko_candidate": "눈앞에서 어둠이 타오르고 있었다｡"
  },
  {
   "id": 47239,
   "key": "D1514ru.txt:163",
   "file": "D1514ru.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やはり、此奴は……",
   "ko_candidate": "역시､ 이 녀석은…"
  },
  {
   "id": 47240,
   "key": "D1514ru.txt:167",
   "file": "D1514ru.txt",
   "line": 167,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎に憑いていた怪異か」",
   "ko_candidate": "「쿠로에게 붙어 있던 괴이인가」"
  },
  {
   "id": 47241,
   "key": "D1514ru.txt:173",
   "file": "D1514ru.txt",
   "line": 173,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「また逢ったね……アル・アジフ」",
   "ko_candidate": "「다시 만났네… 알 아지프」"
  },
  {
   "id": 47242,
   "key": "D1514ru.txt:178",
   "file": "D1514ru.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が悶え、のたうちながら、人の容を模った。",
   "ko_candidate": "어둠이 몸부림치며 사람의 모습을 흉내 냈다｡"
  },
  {
   "id": 47243,
   "key": "D1514ru.txt:179",
   "file": "D1514ru.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "女の様だった。",
   "ko_candidate": "여자처럼 보였다｡"
  },
  {
   "id": 47244,
   "key": "D1514ru.txt:183",
   "file": "D1514ru.txt",
   "line": 183,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「この前の時と云い……答えよ、 怪異。汝は何を企んでおる？」",
   "ko_candidate": "「지난번에 이어… 대답해라､ 괴이여｡ 너는 무엇을 꾀하고 있느냐?」"
  },
  {
   "id": 47245,
   "key": "D1514ru.txt:188",
   "file": "D1514ru.txt",
   "line": 188,
   "speaker": "ナイア / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「僕はただ、僕の世界を正しく美しく変えたいだけだ」 「どう云う意味だ？」",
   "ko_candidate": "「나는 그저､ 내 세계를 올바르고 아름답게 바꾸고 싶을 뿐이야」"
  },
  {
   "id": 47246,
   "key": "D1514ru.txt:198",
   "file": "D1514ru.txt",
   "line": 198,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……さあ？」",
   "ko_candidate": "「무슨 뜻이냐?」"
  },
  {
   "id": 47247,
   "key": "D1514ru.txt:201",
   "file": "D1514ru.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "くすくすくすくす……。",
   "ko_candidate": "「…글쎄?」 키득키득키득키득…"
  },
  {
   "id": 47248,
   "key": "D1514ru.txt:202",
   "file": "D1514ru.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘲り、笑い、囁く声がする。",
   "ko_candidate": "조롱하고､ 웃고､ 속삭이는 소리가 들린다｡"
  },
  {
   "id": 47249,
   "key": "D1514ru.txt:203",
   "file": "D1514ru.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸の奥で、怒りが荒れ狂う。",
   "ko_candidate": "가슴 속에서 분노가 들끓는다｡"
  },
  {
   "id": 47250,
   "key": "D1514ru.txt:207",
   "file": "D1514ru.txt",
   "line": 207,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……汝！」",
   "ko_candidate": "「…너!」"
  },
  {
   "id": 47251,
   "key": "D1514ru.txt:213",
   "file": "D1514ru.txt",
   "line": 213,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字九郎は消えないよ」",
   "ko_candidate": "「다이쥬지 쿠로는 사라지지 않을 거야」"
  },
  {
   "id": 47252,
   "key": "D1514ru.txt:217",
   "file": "D1514ru.txt",
   "line": 217,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何？」",
   "ko_candidate": "「…뭐?」"
  },
  {
   "id": 47253,
   "key": "D1514ru.txt:221",
   "file": "D1514ru.txt",
   "line": 221,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「僕が消させないから。僕にとって、彼は大事な、大事な子だから」",
   "ko_candidate": "「내가 사라지게 두지 않을 테니까｡ 내게 있어 그는 소중한､ 소중한 아이니까」"
  },
  {
   "id": 47254,
   "key": "D1514ru.txt:225",
   "file": "D1514ru.txt",
   "line": 225,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから、汝は何を――」",
   "ko_candidate": "「그래서､ 너는 무엇을―」"
  },
  {
   "id": 47255,
   "key": "D1514ru.txt:231",
   "file": "D1514ru.txt",
   "line": 231,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それよりも…… 本当に良いのかい？」",
   "ko_candidate": "「그보다… 정말 괜찮은 거니?」"
  },
  {
   "id": 47256,
   "key": "D1514ru.txt:236",
   "file": "D1514ru.txt",
   "line": 236,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――？」",
   "ko_candidate": "「――――?」"
  },
  {
   "id": 47257,
   "key": "D1514ru.txt:239",
   "file": "D1514ru.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "女の容の闇が、揺らめきながら、囁きかける。",
   "ko_candidate": "여자 모습의 어둠이 흔들리며 속삭인다｡"
  },
  {
   "id": 47258,
   "key": "D1514ru.txt:240",
   "file": "D1514ru.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その言葉に何故か、妾の心は呪縛される。",
   "ko_candidate": "그 말에 왠지 내 마음은 주박당한다｡"
  },
  {
   "id": 47259,
   "key": "D1514ru.txt:241",
   "file": "D1514ru.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動揺する妾に、闇の女は笑いながら、続けた。",
   "ko_candidate": "동요하는 나에게 어둠의 여자는 웃으며 계속했다｡"
  },
  {
   "id": 47260,
   "key": "D1514ru.txt:245",
   "file": "D1514ru.txt",
   "line": 245,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大十字九郎を元の世界に戻してしまって……だよ」",
   "ko_candidate": "「다이쥬지 쿠로를 원래 세계로 돌려보내 버리고 …말이야」 「무슨…」"
  },
  {
   "id": 47261,
   "key": "D1514ru.txt:249",
   "file": "D1514ru.txt",
   "line": 249,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何を……」 何を云うか。",
   "ko_candidate": "무슨 소리를 하는 거냐｡"
  },
  {
   "id": 47262,
   "key": "D1514ru.txt:253",
   "file": "D1514ru.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎を失わせてなるものか。",
   "ko_candidate": "쿠로를 잃게 할 리가 없다｡"
  }
 ]
}