 },
 "items": [
  {
   "id": 34986,
   "key": "D1311al.txt:8",
   "file": "D1311al.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "危険を感じ、その場から飛び退く。",
   "ko_candidate": "위험을 감지하고 그 자리에서 뛰어 물러났다｡"
  },
  {
   "id": 34987,
   "key": "D1311al.txt:9",
   "file": "D1311al.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして予感は多分、的中していた。",
   "ko_candidate": "그리고 예감은 아마도 적중했을 것이다｡"
  },
  {
   "id": 34988,
   "key": "D1311al.txt:16",
   "file": "D1311al.txt",
   "line": 16,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうした!?」",
   "ko_candidate": "「무슨 일이야!?」"
  },
  {
   "id": 34989,
   "key": "D1311al.txt:20",
   "file": "D1311al.txt",
   "line": 20,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……見ろ」",
   "ko_candidate": "「……봐봐」"
  },
  {
   "id": 34990,
   "key": "D1311al.txt:26",
   "file": "D1311al.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "変化は破壊されたはずの ベルゼビュートに起こっていた。",
   "ko_candidate": "변화는 파괴되었어야 할 벨제뷰트에게 일어나고 있었다｡"
  },
  {
   "id": 34991,
   "key": "D1311al.txt:28",
   "file": "D1311al.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体の表面に錆が浮き、もの凄い勢いで腐食している。",
   "ko_candidate": "기체의 표면에 녹이 피어올라 엄청난 기세로 부식되고 있다｡"
  },
  {
   "id": 34992,
   "key": "D1311al.txt:29",
   "file": "D1311al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや……そうじゃない。それだけじゃない。",
   "ko_candidate": "아니……그게 아니다｡ 그뿐만이 아니다｡"
  },
  {
   "id": 34993,
   "key": "D1311al.txt:33",
   "file": "D1311al.txt",
   "line": 33,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……腐敗しているのか？」",
   "ko_candidate": "「……부패하고 있는 건가?」"
  },
  {
   "id": 34994,
   "key": "D1311al.txt:35",
   "file": "D1311al.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "信じられない光景だ。",
   "ko_candidate": "믿을 수 없는 광경이다｡"
  },
  {
   "id": 34995,
   "key": "D1311al.txt:37",
   "file": "D1311al.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐食した表面の金属が罅割れ、中から緑色に汚濁した肉汁が滴り始める。",
   "ko_candidate": "부식된 표면의 금속이 갈라지고 그 안에서 녹색으로 오염된 육즙이 흘러내리기 시작한다｡"
  },
  {
   "id": 34996,
   "key": "D1311al.txt:39",
   "file": "D1311al.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "不意に卵の殻のように表面が砕け、腐肉が一斉に溢れ出した。腐肉は地面を埋め尽くし、膨張する。",
   "ko_candidate": "갑자기 달걀 껍질처럼 표면이 부서지고 썩은 살점이 일제히 쏟아져 나왔다｡ 썩은 살점이 땅을 뒤덮고 팽창한다｡"
  },
  {
   "id": 34997,
   "key": "D1311al.txt:41",
   "file": "D1311al.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐肉の中では人間ほどの大きさがあろう蛆蟲が無数に蠢いていた。",
   "ko_candidate": "썩은 살점 속에서는 사람 크기만 한 구더기들이 무수히 꿈틀거리고 있었다｡"
  },
  {
   "id": 34998,
   "key": "D1311al.txt:49",
   "file": "D1311al.txt",
   "line": 49,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何が起こっているかは知らんが ……どうやら、まだ斃したことにはならんようだな」",
   "ko_candidate": "「무슨 일이 일어나고 있는지는 모르겠지만……아무래도 아직 쓰러뜨린 게 아닌 것 같군」"
  },
  {
   "id": 34999,
   "key": "D1311al.txt:54",
   "file": "D1311al.txt",
   "line": 54,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うぷっ……見てて、気持ち悪くなってきた……」",
   "ko_candidate": "「우웩……보고 있자니 구역질이 나려고 해……」"
  },
  {
   "id": 35000,
   "key": "D1311al.txt:58",
   "file": "D1311al.txt",
   "line": 58,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しっかりしろよ」",
   "ko_candidate": "「정신 차려」"
  },
  {
   "id": 35001,
   "key": "D1311al.txt:66",
   "file": "D1311al.txt",
   "line": 66,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字……九郎……アル…… アジフぅぅぅぅ……」",
   "ko_candidate": "「다이쥬지……쿠로……알…… 아지프으으으으……」"
  },
  {
   "id": 35002,
   "key": "D1311al.txt:71",
   "file": "D1311al.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "声が響く。 もうウンザリするほど聞かされた下品な声だ。",
   "ko_candidate": "목소리가 울린다｡ 이제 질릴 만큼 들어온 천박한 목소리다｡"
  },
  {
   "id": 35003,
   "key": "D1311al.txt:73",
   "file": "D1311al.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "野郎……あれだけやっても、まだ死なないのかよ。",
   "ko_candidate": "이 자식……그 정도로 해도 아직 죽지 않는 건가｡"
  },
  {
   "id": 35004,
   "key": "D1311al.txt:78",
   "file": "D1311al.txt",
   "line": 78,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『妖蛆の秘密』を操る……アタシは不死身……殺せない……アンタなんかに……このアタシが……コロセルものくあぁぁあああっ！」",
   "ko_candidate": "「『벌레의 신비』를 조종하는……나는 불사신……죽일 수 없어……너 따위가……이 나를……죽일 수 있을 리가 없어어어어어어어어엇!」"
  },
  {
   "id": 35005,
   "key": "D1311al.txt:83",
   "file": "D1311al.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ざわめき。",
   "ko_candidate": "소란스러움｡"
  },
  {
   "id": 35006,
   "key": "D1311al.txt:84",
   "file": "D1311al.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ざわめき。",
   "ko_candidate": "소란스러움｡"
  },
  {
   "id": 35007,
   "key": "D1311al.txt:85",
   "file": "D1311al.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ざわめき。",
   "ko_candidate": "소란스러움｡"
  },
  {
   "id": 35008,
   "key": "D1311al.txt:87",
   "file": "D1311al.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蝿の羽音。",
   "ko_candidate": "파리 날개 소리｡"
  },
  {
   "id": 35009,
   "key": "D1311al.txt:88",
   "file": "D1311al.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "群れを成す無数の蝿が、押し寄せてくるような、不快なノイズ。",
   "ko_candidate": "무리를 이룬 무수한 파리가 밀려오는 듯한 불쾌한 노이즈｡"
  },
  {
   "id": 35010,
   "key": "D1311al.txt:90",
   "file": "D1311al.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――来る！",
   "ko_candidate": "――온다!"
  },
  {
   "id": 35011,
   "key": "D1311al.txt:99",
   "file": "D1311al.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐敗する機体が爆ぜた。",
   "ko_candidate": "부패하는 기체가 터졌다｡"
  },
  {
   "id": 35012,
   "key": "D1311al.txt:100",
   "file": "D1311al.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一気に溢れ出す黒い群雲。",
   "ko_candidate": "단숨에 쏟아져 나오는 검은 구름 무리｡"
  },
  {
   "id": 35013,
   "key": "D1311al.txt:102",
   "file": "D1311al.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふとすれば闇夜に融けてしまいそうな黒雲は、だがあまりもの禍々しさ故に、夜に存在する如何なる闇よりも、その存在を主張していた。",
   "ko_candidate": "어쩌면 어두운 밤에 녹아들 것 같은 검은 구름은､ 하지만 너무나도 불길해서 밤에 존재하는 어떤 어둠보다도 그 존재를 주장하고 있었다｡"
  },
  {
   "id": 35014,
   "key": "D1311al.txt:104",
   "file": "D1311al.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燃え広がり、とぐろを巻く黒雲。",
   "ko_candidate": "타오르며 퍼지고 똬리를 틀며 도는 검은 구름｡"
  },
  {
   "id": 35015,
   "key": "D1311al.txt:105",
   "file": "D1311al.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動きに合わせて、大きく小さく近く遠く、音の幅を変える羽音。",
   "ko_candidate": "움직임에 맞춰 크게 작게 가깝게 멀게､ 소리의 폭을 바꾸는 날개 소리｡"
  },
  {
   "id": 35016,
   "key": "D1311al.txt:105",
   "file": "D1311al.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは……蝿の群れ!?",
   "ko_candidate": "이건……파리 무리!?"
  },
  {
   "id": 35017,
   "key": "D1311al.txt:109",
   "file": "D1311al.txt",
   "line": 109,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐぶるぶぼぎゃああああああああああ！」",
   "ko_candidate": "「그부르부보갸아아아아아아아아아아!」"
  },
  {
   "id": 35018,
   "key": "D1311al.txt:112",
   "file": "D1311al.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蝿の集合体が、 黒雲のような全体を身悶えさせて、吼える。",
   "ko_candidate": "파리의 집합체가 검은 구름 같은 전체를 몸부림치며 포효한다｡"
  },
  {
   "id": 35019,
   "key": "D1311al.txt:114",
   "file": "D1311al.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か……夢に見そうな光景だ。",
   "ko_candidate": "뭔가……꿈에서나 볼 법한 광경이다｡"
  },
  {
   "id": 35020,
   "key": "D1311al.txt:117",
   "file": "D1311al.txt",
   "line": 117,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そう言えば１人暮らしを始めて間もない頃さ……夏場に食器の洗い物、台所にほったらかしていたら、排水溝の内側にびっちり蝿の卵が……」",
   "ko_candidate": "「그러고 보니 혼자 살기 시작하고 얼마 안 됐을 때 말이야……여름에 설거지를､ 부엌에 방치해뒀더니 배수구 안쪽에 빼곡히 파리 알이……」"
  },
  {
   "id": 35021,
   "key": "D1311al.txt:121",
   "file": "D1311al.txt",
   "line": 121,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんなことはどうでも良い！」",
   "ko_candidate": "「그런 건 상관없어!」"
  },
  {
   "id": 35022,
   "key": "D1311al.txt:130",
   "file": "D1311al.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迸る怨念。",
   "ko_candidate": "치솟는 원념｡"
  },
  {
   "id": 35023,
   "key": "D1311al.txt:131",
   "file": "D1311al.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "牙を剥いて襲う呪詛",
   "ko_candidate": "이를 드러내고 덤벼드는 저주"
  },
  {
   "id": 35024,
   "key": "D1311al.txt:133",
   "file": "D1311al.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渦を巻く蝿の群れの中心、さっきベルゼビュートが編み上げた瘴気の塊が存在していた。",
   "ko_candidate": "소용돌이치는 파리 무리의 중심에 아까 벨제뷰트가 엮어낸 장기의 덩어리가 존재하고 있었다｡"
  },
  {
   "id": 35025,
   "key": "D1311al.txt:137",
   "file": "D1311al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨怨汚怨怨怨怨汚怨怨汚怨怨怨怨汚怨怨汚怨怨怨怨汚怨怨汚……！",
   "ko_candidate": "원원오원원원원오원원오원원원원오원원오원원원원오원원오……!"
  }
 ]
}