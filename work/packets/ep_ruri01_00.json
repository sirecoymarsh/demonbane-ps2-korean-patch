  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "大十字九郎": "다이쥬지 쿠로",
  "覇道財閥": "하도 재벌"
 },
 "items": [
  {
   "id": 50138,
   "key": "ep_ruri01.txt:12",
   "file": "ep_ruri01.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門は、閉じた。",
   "ko_candidate": "문은 닫혔다｡"
  },
  {
   "id": 50139,
   "key": "ep_ruri01.txt:13",
   "file": "ep_ruri01.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの人は勝ったのだろうか。",
   "ko_candidate": "그 사람은 이겼을까｡"
  },
  {
   "id": 50140,
   "key": "ep_ruri01.txt:14",
   "file": "ep_ruri01.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう、信じたい。",
   "ko_candidate": "그렇게 믿고 싶다｡"
  },
  {
   "id": 50141,
   "key": "ep_ruri01.txt:16",
   "file": "ep_ruri01.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界を巻き込んだ大事件は、だが誰にも知らない場所で幕を閉じた。",
   "ko_candidate": "세계를 휘말린 대사건은､ 하지만 누구도 모르는 곳에서 막을 내렸다｡"
  },
  {
   "id": 50142,
   "key": "ep_ruri01.txt:18",
   "file": "ep_ruri01.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "総ては嵐の様に過ぎ去り、訪れた平和にも、あれほど壮絶だった戦いの日々も、実感が失われている。",
   "ko_candidate": "모든 것은 폭풍처럼 지나갔고､ 찾아온 평화에도､ 그토록 장렬했던 전투의 나날도､ 실감이 사라지고 있다｡"
  },
  {
   "id": 50143,
   "key": "ep_ruri01.txt:19",
   "file": "ep_ruri01.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "全世界が呆けたような空気の中、人類は日常を取り戻しつつある。",
   "ko_candidate": "전 세계가 멍한 듯한 공기 속에서､ 인류는 일상을 되찾아가고 있다｡"
  },
  {
   "id": 50144,
   "key": "ep_ruri01.txt:21",
   "file": "ep_ruri01.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "総てはまるで夢の様で――だけど、私はあの人の戦いを憶えている。",
   "ko_candidate": "모든 것이 마치 꿈만 같아서――하지만､ 나는 그 사람의 싸움을 기억하고 있다｡"
  },
  {
   "id": 50145,
   "key": "ep_ruri01.txt:21",
   "file": "ep_ruri01.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "戦いの激しさを憶えている。",
   "ko_candidate": "전투의 격렬함을 기억하고 있다｡"
  },
  {
   "id": 50146,
   "key": "ep_ruri01.txt:22",
   "file": "ep_ruri01.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの戦いの日々は、決して幻では無い。",
   "ko_candidate": "그 전투의 나날은､ 결코 환상이 아니다｡"
  },
  {
   "id": 50147,
   "key": "ep_ruri01.txt:24",
   "file": "ep_ruri01.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、私は待ち続ける。",
   "ko_candidate": "그래서､ 나는 계속 기다린다｡"
  },
  {
   "id": 50148,
   "key": "ep_ruri01.txt:25",
   "file": "ep_ruri01.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "戦い終わり、私の許に帰って来る、あの人を。",
   "ko_candidate": "싸움을 끝내고､ 내게로 돌아올､ 그 사람을｡"
  },
  {
   "id": 50149,
   "key": "ep_ruri01.txt:26",
   "file": "ep_ruri01.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私が愛する、あの人を。",
   "ko_candidate": "내가 사랑하는､ 그 사람을｡"
  },
  {
   "id": 50150,
   "key": "ep_ruri01.txt:28",
   "file": "ep_ruri01.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大十字九郎を、待ち続ける。",
   "ko_candidate": "다이쥬지 쿠로를､ 계속 기다린다｡"
  },
  {
   "id": 50151,
   "key": "ep_ruri01.txt:36",
   "file": "ep_ruri01.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門が閉じて、１日。",
   "ko_candidate": "문이 닫힌 지､ 1일｡"
  },
  {
   "id": 50152,
   "key": "ep_ruri01.txt:37",
   "file": "ep_ruri01.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私は海上で、空を見上げて、待っていた。",
   "ko_candidate": "나는 해상에서､ 하늘을 올려다보며､ 기다리고 있었다｡"
  },
  {
   "id": 50153,
   "key": "ep_ruri01.txt:38",
   "file": "ep_ruri01.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼が降りてくるのを、待っていた。",
   "ko_candidate": "그가 내려오기를､ 기다리고 있었다｡"
  },
  {
   "id": 50154,
   "key": "ep_ruri01.txt:40",
   "file": "ep_ruri01.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "降りてきたら、あの人を抱き締めよう。",
   "ko_candidate": "내려오면､ 그 사람을 꼭 안아주리라｡"
  },
  {
   "id": 50155,
   "key": "ep_ruri01.txt:41",
   "file": "ep_ruri01.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "優しく抱き締めて、おかえりなさい、と声をかけてあげよう。",
   "ko_candidate": "부드럽게 안아주고､ 어서 오세요､ 라고 말을 걸어주리라｡"
  },
  {
   "id": 50156,
   "key": "ep_ruri01.txt:49",
   "file": "ep_ruri01.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門が閉じて、３日。",
   "ko_candidate": "문이 닫힌 지､ 3일｡"
  },
  {
   "id": 50157,
   "key": "ep_ruri01.txt:50",
   "file": "ep_ruri01.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私は海上で、空を見上げて、待っていた。",
   "ko_candidate": "나는 해상에서､ 하늘을 올려다보며､ 기다리고 있었다｡"
  },
  {
   "id": 50158,
   "key": "ep_ruri01.txt:51",
   "file": "ep_ruri01.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼が降りてくるのを、待っていた。",
   "ko_candidate": "그가 내려오기를､ 기다리고 있었다｡"
  },
  {
   "id": 50159,
   "key": "ep_ruri01.txt:53",
   "file": "ep_ruri01.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "降りてきたら、あの人に胸に飛び込んで、抱きつこう。",
   "ko_candidate": "내려오면､ 그 사람의 가슴에 뛰어들어､ 안겨보리라｡"
  },
  {
   "id": 50160,
   "key": "ep_ruri01.txt:54",
   "file": "ep_ruri01.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの人は疲れ切っていて、傷だらけに違いないけど、容赦はしない。",
   "ko_candidate": "그 사람은 지쳐 있고､ 상처투성이일 테지만､ 용서하지 않을 거야｡"
  },
  {
   "id": 50161,
   "key": "ep_ruri01.txt:56",
   "file": "ep_ruri01.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私を心配させた報いだ。",
   "ko_candidate": "나를 걱정시킨 대가야｡"
  },
  {
   "id": 50162,
   "key": "ep_ruri01.txt:57",
   "file": "ep_ruri01.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私の重さを、受け止めてもらおう。",
   "ko_candidate": "내 무게를､ 받아들여 주시길｡"
  },
  {
   "id": 50163,
   "key": "ep_ruri01.txt:65",
   "file": "ep_ruri01.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門が閉じて、７日。",
   "ko_candidate": "문이 닫힌 지､ 7일｡"
  },
  {
   "id": 50164,
   "key": "ep_ruri01.txt:66",
   "file": "ep_ruri01.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これ以上、海に留まる事は出来ない。",
   "ko_candidate": "이제 더는､ 바다에 머물 수 없다｡"
  },
  {
   "id": 50165,
   "key": "ep_ruri01.txt:68",
   "file": "ep_ruri01.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界の復興は始まったばかりで、私には、覇道財閥にはやるべき事がある。",
   "ko_candidate": "세계의 복구는 이제 막 시작되었고､ 나에겐､ 하도 재벌에는 해야 할 일이 있다｡"
  },
  {
   "id": 50166,
   "key": "ep_ruri01.txt:69",
   "file": "ep_ruri01.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私はあの街に帰らなければならない。",
   "ko_candidate": "나는 그 거리로 돌아가야만 한다｡"
  },
  {
   "id": 50167,
   "key": "ep_ruri01.txt:71",
   "file": "ep_ruri01.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、大丈夫。",
   "ko_candidate": "하지만､ 괜찮아｡"
  },
  {
   "id": 50168,
   "key": "ep_ruri01.txt:72",
   "file": "ep_ruri01.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自分に言い聞かせる。",
   "ko_candidate": "스스로에게 다짐한다｡"
  },
  {
   "id": 50169,
   "key": "ep_ruri01.txt:74",
   "file": "ep_ruri01.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だって……あの人の帰る場所は、あの街なのだから。",
   "ko_candidate": "왜냐하면……그 사람이 돌아올 곳은､ 그 거리니까｡"
  },
  {
   "id": 50170,
   "key": "ep_ruri01.txt:76",
   "file": "ep_ruri01.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの人が愛する街。私が愛する街。",
   "ko_candidate": "그 사람이 사랑하는 거리｡ 내가 사랑하는 거리｡"
  },
  {
   "id": 50171,
   "key": "ep_ruri01.txt:77",
   "file": "ep_ruri01.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大黄金時代で大混乱時代で大暗黒時代の、あの街が、私達の生きる世界だから。",
   "ko_candidate": "대황금시대와 대혼란시대와 대암흑시대의､ 그 거리가､ 우리의 살아갈 세계니까｡"
  },
  {
   "id": 50172,
   "key": "ep_ruri01.txt:78",
   "file": "ep_ruri01.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、あの人は、きっと帰って来る。",
   "ko_candidate": "그러니까､ 그 사람은､ 반드시 돌아올 거야｡"
  },
  {
   "id": 50173,
   "key": "ep_ruri01.txt:86",
   "file": "ep_ruri01.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "門が閉じて、１ヶ月。",
   "ko_candidate": "문이 닫힌 지､ 1개월｡"
  },
  {
   "id": 50174,
   "key": "ep_ruri01.txt:87",
   "file": "ep_ruri01.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "復興作業は続く。",
   "ko_candidate": "복구 작업은 계속된다｡"
  },
  {
   "id": 50175,
   "key": "ep_ruri01.txt:88",
   "file": "ep_ruri01.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "日々の仕事に忙殺され、時間を忘れてしまう。",
   "ko_candidate": "매일의 일에 치여 시간을 잊어버린다｡"
  },
  {
   "id": 50176,
   "key": "ep_ruri01.txt:89",
   "file": "ep_ruri01.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの人の事を、思い出さない時間がある。",
   "ko_candidate": "그 사람의 일을､ 떠올리지 않는 시간이 있다｡"
  },
  {
   "id": 50177,
   "key": "ep_ruri01.txt:91",
   "file": "ep_ruri01.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そんな自分に、うんざりする。",
   "ko_candidate": "그런 자신이､ 지긋지긋하다｡"
  }
 ]
}