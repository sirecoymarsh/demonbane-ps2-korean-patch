   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「爆ッッッッ！」",
   "ko_candidate": "「폭????!」"
  },
  {
   "id": 12210,
   "key": "D0801ru.txt:520",
   "file": "D0801ru.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀に内包された火の術式が発動。爆発。連鎖。",
   "ko_candidate": "언월도에 내포된 불의 술식이 발동｡ 폭발｡ 연쇄｡"
  },
  {
