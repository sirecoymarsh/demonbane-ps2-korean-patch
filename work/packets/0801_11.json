 "items": [
  {
   "id": 12184,
   "key": "D0801ru.txt:415",
   "file": "D0801ru.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少年のものとも少女のものとも取れぬ、中性的な声色で。",
   "ko_candidate": "소년의 것인지 소녀의 것인지 구분할 수 없는､ 중성적인 목소리로｡"
  },
  {
   "id": 12185,
   "key": "D0801ru.txt:417",
   "file": "D0801ru.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "忌まわしい程に清廉で、吐き気を催すほどに美しい歌を。",
   "ko_candidate": "저주스러울 정도로 청렴하고､ 구토를 일으킬 정도로 아름다운 노래를｡"
  },
  {
   "id": 12186,
   "key": "D0801ru.txt:422",
   "file": "D0801ru.txt",
   "line": 422,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「至上の愛、なんと甘美なる響き。 こんな私さえも、主は救われた」 「私はかつて失われ、いま導かれた。 盲目だった私は、光を知った」",
   "ko_candidate": "「지상의 사랑､ 얼마나 감미로운 울림인가｡ 이런 나조차도､ 주님은 구원하셨다｡ 나는 한때 잃어버렸다가､ 지금 인도되었다｡ 눈먼 나는､ 빛을 알게 되었다」"
  },
  {
   "id": 12187,
   "key": "D0801ru.txt:431",
   "file": "D0801ru.txt",
   "line": 431,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおおおおおおお！」",
   "ko_candidate": "「우오오오오오오오오오!」"
  },
  {
   "id": 12188,
   "key": "D0801ru.txt:434",
   "file": "D0801ru.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鐘が鳴る。",
   "ko_candidate": "종이 울린다｡"
  },
  {
   "id": 12189,
   "key": "D0801ru.txt:436",
   "file": "D0801ru.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人は翔けながら、偃月刀を振り被った。",
   "ko_candidate": "노인은 날아오르며 언월도를 휘둘렀다｡"
  },
  {
   "id": 12190,
   "key": "D0801ru.txt:438",
   "file": "D0801ru.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刀身に刻まれた、火の秘文字が赤熱し、刃は焔を纏う。",
   "ko_candidate": "도신에 새겨진 불의 비문자가 붉게 달아오르고､ 칼날은 화염에 휩싸인다｡"
  },
  {
   "id": 12191,
   "key": "D0801ru.txt:440",
   "file": "D0801ru.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人に降る雪が蒸発して、蒸気を昇らせる。",
   "ko_candidate": "노인에게 내리는 눈이 증발하여 증기를 피워 올린다｡"
  },
  {
   "id": 12192,
   "key": "D0801ru.txt:443",
   "file": "D0801ru.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔の斬撃が振り下ろされる。",
   "ko_candidate": "화염의 참격이 내리꽂힌다｡"
  },
  {
   "id": 12193,
   "key": "D0801ru.txt:448",
   "file": "D0801ru.txt",
   "line": 448,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「至上の愛、主は恐れを教え、 そして、私を解き放った」 「私が信じる事を知ったその時、 おお、至上の愛よ。 何と素晴らしきものか」",
   "ko_candidate": "「지상의 사랑､ 주님은 두려움을 가르치시고､ 그리고 나를 해방시키셨다｡ 내가 믿는 것을 알게 된 그 순간､ 오､ 지상의 사랑이여｡ 얼마나 멋진 것인가」"
  },
  {
   "id": 12194,
   "key": "D0801ru.txt:461",
   "file": "D0801ru.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔が軌跡を描き、幾重にも獣を切り刻む。",
   "ko_candidate": "화염이 궤적을 그리며 여러 겹으로 짐승을 베어낸다｡"
  },
  {
   "id": 12195,
   "key": "D0801ru.txt:463",
   "file": "D0801ru.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "獣の躰が焔に包まれる。",
   "ko_candidate": "짐승의 몸이 화염에 휩싸인다｡"
  },
  {
   "id": 12196,
   "key": "D0801ru.txt:466",
   "file": "D0801ru.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鐘が鳴る。",
   "ko_candidate": "종이 울린다｡"
  },
  {
   "id": 12197,
   "key": "D0801ru.txt:468",
   "file": "D0801ru.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歌は止まない。",
   "ko_candidate": "노래는 멈추지 않는다｡"
  },
  {
   "id": 12198,
   "key": "D0801ru.txt:473",
   "file": "D0801ru.txt",
   "line": 473,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「数多の危険を、苦闘を、誘惑を、 私は乗り越えた」 「主の愛は、こんなにも安らぎを与え、 私を家路へと導いてくれる」",
   "ko_candidate": "「수많은 위험과 고난､ 유혹을､ 나는 극복했다｡ 주님의 사랑은 이토록 평안을 주시고､ 나를 집으로 인도해 주신다」"
  },
  {
   "id": 12199,
   "key": "D0801ru.txt:484",
   "file": "D0801ru.txt",
   "line": 484,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ガアアアアアアアアアッ！」",
   "ko_candidate": "「가아아아아아아아아아!」"
  },
  {
   "id": 12200,
   "key": "D0801ru.txt:486",
   "file": "D0801ru.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人の両手に、更なる刃の閃が疾る。",
   "ko_candidate": "노인의 양손에 더욱 날카로운 칼날의 섬광이 가른다｡"
  },
  {
   "id": 12201,
   "key": "D0801ru.txt:487",
   "file": "D0801ru.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ての指の間に挟まれた、バルザイの偃月刀。",
   "ko_candidate": "모든 손가락 사이에 끼워진 바르자이의 언월도｡"
  },
  {
   "id": 12202,
   "key": "D0801ru.txt:489",
   "file": "D0801ru.txt",
   "line": 489,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "投げつけ、貫く。",
   "ko_candidate": "던지고､ 꿰뚫는다｡"
  },
  {
