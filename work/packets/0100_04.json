{
 "packet": "0100_04",
 "scene": "0100",
 "anchor": {
  "hit": 19,
  "total": 20,
  "rate": 0.95
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {},
 "items": [
  {
   "id": 162,
   "key": "D0100.txt:573",
   "file": "D0100.txt",
   "line": 573,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「堕ちろ」",
   "ko_candidate": "「떨어져라」"
  },
  {
   "id": 163,
   "key": "D0100.txt:588",
   "file": "D0100.txt",
   "line": 588,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『損害率３３％、戦闘性能１８％低下。駆動システム及びメイン動力に一部損傷有り……追跡しなくて宜しいのですか、マスター？』",
   "ko_candidate": "『손상률 33%､ 전투 성능 18% 저하｡ 구동 시스템 및 메인 동력에 일부 손상 있음……추적하지 않아도 괜찮으십니까､ 마스터?』"
  },
  {
   "id": 164,
   "key": "D0100.txt:592",
   "file": "D0100.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人の聲は、今までとは違う響きだった。",
   "ko_candidate": "붉은 거인의 목소리는､ 지금까지와는 다른 울림이었다｡"
  },
  {
   "id": 165,
   "key": "D0100.txt:593",
   "file": "D0100.txt",
   "line": 593,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声色は高く、幼く、しかし静かで、冷淡で、老獪でもあった。",
   "ko_candidate": "음색은 높고､ 어리며､ 하지만 조용하고､ 냉담하며､ 교활하기도 했다｡"
  },
  {
   "id": 166,
   "key": "D0100.txt:594",
   "file": "D0100.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな畸形な、少女、の声だった。",
   "ko_candidate": "그런 기형적인､ 소녀의 목소리였다｡"
  },
  {
   "id": 167,
   "key": "D0100.txt:599",
   "file": "D0100.txt",
   "line": 599,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「構わん」",
   "ko_candidate": "「상관없다」"
  },
  {
   "id": 168,
   "key": "D0100.txt:605",
   "file": "D0100.txt",
   "line": 605,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人の内より零れた声に、やはり巨人の内から零れた聲が答える。",
   "ko_candidate": "거인의 내부에서 흘러나온 목소리에､ 역시 거인의 내부에서 흘러나온 목소리가 대답한다｡"
  },
  {
   "id": 169,
   "key": "D0100.txt:606",
   "file": "D0100.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの中性的な聲が。",
   "ko_candidate": "그 중성적인 목소리가｡"
  },
  {
   "id": 170,
   "key": "D0100.txt:612",
   "file": "D0100.txt",
   "line": 612,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人の腹が、開く。",
   "ko_candidate": "거인의 배가､ 열린다｡"
  },
  {
   "id": 171,
   "key": "D0100.txt:613",
   "file": "D0100.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "割れた鋼鉄の胎より人影が這い出てくる。",
   "ko_candidate": "갈라진 강철의 태에서 인영이 기어 나온다｡"
  },
  {
   "id": 172,
   "key": "D0100.txt:617",
   "file": "D0100.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強風にはためく呪術的な礼服。",
   "ko_candidate": "강풍에 펄럭이는 주술적인 예복｡"
  },
  {
   "id": 173,
   "key": "D0100.txt:618",
   "file": "D0100.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強風に靡く金色の髪。",
   "ko_candidate": "강풍에 나부끼는 금색 머리카락｡"
  },
  {
   "id": 174,
   "key": "D0100.txt:619",
   "file": "D0100.txt",
   "line": 619,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白すぎる肌。",
   "ko_candidate": "하얀 피부｡"
  },
  {
   "id": 175,
   "key": "D0100.txt:620",
   "file": "D0100.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、金色の眸。",
   "ko_candidate": "그리고､ 금색 눈동자｡"
  },
  {
   "id": 176,
   "key": "D0100.txt:622",
   "file": "D0100.txt",
   "line": 622,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これほどに深い金は、自然界に存在しない。",
   "ko_candidate": "이토록 깊은 금색은､ 자연계에 존재하지 않는다｡"
  },
  {
   "id": 177,
   "key": "D0100.txt:623",
   "file": "D0100.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そもそもその金は、金でありながら、何ら輝きを発しない。",
   "ko_candidate": "애초에 그 금색은､ 금색이면서도､ 전혀 빛을 발하지 않는다｡"
  },
  {
   "id": 178,
   "key": "D0100.txt:625",
   "file": "D0100.txt",
   "line": 625,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――金色の闇を秘める少年。",
   "ko_candidate": "――금색의 어둠을 품은 소년｡"
  },
  {
   "id": 179,
   "key": "D0100.txt:627",
   "file": "D0100.txt",
   "line": 627,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地表より遥か遥か上空、吹き荒む大気の渦の只中、だが華奢な少年の躰は微塵にも揺らぐ事はなく、むしろ、靡く金の長髪が顔にかかるのが鬱陶しくて腹立たしい……ただ、それだけが気がかりだと言いたげに、髪を押さえていた。",
   "ko_candidate": "지표로부터 아득히 먼 상공､ 거세게 부는 대기의 소용돌이 한가운데､ 하지만 가녀린 소년의 몸은 조금도 흔들리지 않고､ 오히려､ 나부끼는 금색 긴 머리카락이 얼굴에 걸리는 것이 귀찮고 짜증난다는 듯이､ 단지､ 그것만이 신경 쓰인다는 듯이､ 머리카락을 누르고 있었다｡"
  },
  {
   "id": 180,
   "key": "D0100.txt:629",
   "file": "D0100.txt",
   "line": 629,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の無い眸が眼下を見下ろす。",
   "ko_candidate": "빛 없는 눈동자가 아래를 내려다본다｡"
  },
  {
   "id": 181,
   "key": "D0100.txt:631",
   "file": "D0100.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜。",
   "ko_candidate": "밤｡"
  },
  {
   "id": 182,
   "key": "D0100.txt:632",
   "file": "D0100.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かで深い藍色の海底に、世界は沈んでいるかの様だ。",
   "ko_candidate": "조용하고 깊은 남색 바다 밑에､ 세계가 잠겨 있는 듯하다｡"
  },
  {
   "id": 183,
   "key": "D0100.txt:635",
   "file": "D0100.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遥か下方、黒い蔭の様に広がる大地に散らかされた、無数の光。",
   "ko_candidate": "아득히 아래､ 검은 그림자처럼 펼쳐진 대지에 흩뿌려진､ 무수한 빛｡"
  },
  {
   "id": 184,
   "key": "D0100.txt:636",
   "file": "D0100.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街の灯火。",
   "ko_candidate": "거리의 등불｡"
  },
  {
   "id": 185,
   "key": "D0100.txt:637",
   "file": "D0100.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒトの生活の瞬き。",
   "ko_candidate": "인간 생활의 반짝임｡"
  },
  {
   "id": 186,
   "key": "D0100.txt:647",
   "file": "D0100.txt",
   "line": 647,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「彼奴は間違いなくあの街に落ちる。総ては運命が刻むがままに。 そして運命の輪は常に余の手中にある」",
   "ko_candidate": "「그자는 틀림없이 저 거리에 떨어질 것이다｡ 모든 것은 운명이 새기는 대로｡ 그리고 운명의 수레바퀴는 항상 내 손안에 있다」"
  },
  {
   "id": 187,
   "key": "D0100.txt:654",
   "file": "D0100.txt",
   "line": 654,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『イエス、マスター。万物はマスターの下に集い、傅き、従うのが正しき姿。総てはマスターの御心のままに――』",
   "ko_candidate": "『예､ 마스터｡ 만물은 마스터 아래에 모이고､ 복종하고､ 따르는 것이 올바른 모습입니다｡ 모든 것은 마스터의 뜻대로――』"
  },
  {
   "id": 188,
   "key": "D0100.txt:658",
   "file": "D0100.txt",
   "line": 658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少年は見つめ続ける。",
   "ko_candidate": "소년은 계속 바라본다｡"
  },
  {
   "id": 189,
   "key": "D0100.txt:659",
   "file": "D0100.txt",
   "line": 659,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人の上で。",
   "ko_candidate": "거인 위에서｡"
  },
  {
   "id": 190,
   "key": "D0100.txt:660",
   "file": "D0100.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傲慢な優しさを持つ、絶対者の眸で。",
   "ko_candidate": "오만한 온화함을 지닌､ 절대자의 눈동자로｡"
  },
  {
   "id": 191,
   "key": "D0100.txt:662",
   "file": "D0100.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛おしむ様に。",
   "ko_candidate": "사랑스럽게 여기듯이｡"
  },
  {
   "id": 192,
   "key": "D0100.txt:663",
   "file": "D0100.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憐れむ様に。",
   "ko_candidate": "불쌍히 여기듯이｡"
  },
  {
   "id": 193,
   "key": "D0100.txt:664",
   "file": "D0100.txt",
   "line": 664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘲る様に。",
   "ko_candidate": "조롱하듯이｡"
  },
  {
   "id": 194,
   "key": "D0100.txt:666",
   "file": "D0100.txt",
   "line": 666,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生き足掻く地上の星々を。",
   "ko_candidate": "살아 발버둥치는 지상의 별들을｡"
  },
  {
   "id": 195,
   "key": "D0100.txt:667",
   "file": "D0100.txt",
   "line": 667,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天の星より墜とされ、地の星へと堕ちる宿敵を。",
   "ko_candidate": "하늘의 별에서 떨어져､ 지상의 별로 추락한 숙적을｡"
  },
  {
   "id": 196,
   "key": "D0100.txt:668",
   "file": "D0100.txt",
   "line": 668,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少年と同じく、異形の知識を駆り、異形の巨人を駆る、全き異形を。",
   "ko_candidate": "소년과 마찬가지로､ 기괴한 지식을 다루고､ 기괴한 거인을 조종하는､ 완전한 기괴함을｡"
  },
  {
   "id": 197,
   "key": "D0100.txt:670",
   "file": "D0100.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その異形とは――",
   "ko_candidate": "그 기괴함이란――"
  }
 ]
}