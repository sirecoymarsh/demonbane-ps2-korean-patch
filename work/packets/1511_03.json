 },
 "items": [
  {
   "id": 46142,
   "key": "D1511ru.txt:136",
   "file": "D1511ru.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "解呪の法則。",
   "ko_candidate": "해주의 법칙｡"
  },
  {
   "id": 46143,
   "key": "D1511ru.txt:141",
   "file": "D1511ru.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見つけた――と思ったときは右手が動いていた。",
   "ko_candidate": "찾았다――고 생각했을 때는 오른손이 움직이고 있었다｡"
  },
  {
   "id": 46144,
   "key": "D1511ru.txt:142",
   "file": "D1511ru.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一匹の蛇の頭に掌を押しつけ、システムが起動する。",
   "ko_candidate": "한 마리 뱀의 머리에 손바닥을 누르고 시스템이 가동된다｡"
  },
  {
   "id": 46145,
   "key": "D1511ru.txt:146",
   "file": "D1511ru.txt",
   "line": 146,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――レムリア・インパクト！」",
   "ko_candidate": "「――레무리아 임팩트!」"
  },
  {
   "id": 46146,
   "key": "D1511ru.txt:156",
   "file": "D1511ru.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつがこの結界の核――！",
   "ko_candidate": "이놈이 이 결계의 핵이군――!"
  },
  {
   "id": 46147,
   "key": "D1511ru.txt:158",
   "file": "D1511ru.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一撃必滅の無限熱量は、その蛇のみならず、デモンベインを取り囲む獣の檻を根こそぎ昇滅させた。",
   "ko_candidate": "일격필멸의 무한열량은 그 뱀뿐만 아니라 데몬베인을 둘러싼 짐승의 우리를 뿌리째 승멸시켰다｡"
  },
  {
   "id": 46148,
   "key": "D1511ru.txt:160",
   "file": "D1511ru.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界は再び光を取り戻す。",
   "ko_candidate": "세계는 다시 빛을 되찾는다｡"
  },
  {
   "id": 46149,
   "key": "D1511ru.txt:166",
   "file": "D1511ru.txt",
   "line": 166,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はあ……はあ……くっ……マスターテリオン……！」",
   "ko_candidate": "「하아… 하아… 크윽… 마스터 테리온…!」"
  },
  {
   "id": 46150,
   "key": "D1511ru.txt:169",
   "file": "D1511ru.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが今の攻撃でデモンベインはまた大きく損傷し、俺達自身もさらに魔力を磨り減らすことになった。",
   "ko_candidate": "하지만 방금의 공격으로 데몬베인은 또 크게 손상되었고､ 우리 자신도 더욱 마력을 소모하게 되었다｡"
  },
  {
   "id": 46151,
   "key": "D1511ru.txt:171",
   "file": "D1511ru.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に運悪く、ちょうど彗星がこちらに向かって飛んできた。",
   "ko_candidate": "게다가 운 나쁘게도 마침 혜성이 이쪽을 향해 날아오고 있었다｡"
  },
  {
   "id": 46152,
   "key": "D1511ru.txt:180",
   "file": "D1511ru.txt",
   "line": 180,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちっ……数が多いな！」",
   "ko_candidate": "「칫… 수가 많군!」"
  },
  {
   "id": 46153,
   "key": "D1511ru.txt:183",
   "file": "D1511ru.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次から次へと押し寄せる彗星の合間を見切って、かわし続ける。",
   "ko_candidate": "연이어 밀려오는 혜성의 틈새를 간파하며 계속해서 피한다｡"
  },
  {
   "id": 46154,
   "key": "D1511ru.txt:185",
   "file": "D1511ru.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……何かがおかしい。",
   "ko_candidate": "하지만… 뭔가 이상하다｡"
  },
  {
   "id": 46155,
   "key": "D1511ru.txt:186",
   "file": "D1511ru.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故、そう感じるかは分からなかったが……これは自然ではない。",
   "ko_candidate": "왜 그렇게 느끼는지는 모르겠지만… 이건 자연스럽지 않아｡"
  },
  {
   "id": 46156,
   "key": "D1511ru.txt:188",
   "file": "D1511ru.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これには明らかな敵意が――！",
   "ko_candidate": "여기에는 분명한 적의가――!"
  },
  {
   "id": 46157,
   "key": "D1511ru.txt:194",
   "file": "D1511ru.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気づいたときには遅かった。",
   "ko_candidate": "깨달았을 때는 이미 늦었다｡"
  },
  {
   "id": 46158,
   "key": "D1511ru.txt:195",
   "file": "D1511ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通り過ぎたはずの彗星の一つが軌道を変え、再びこっちに向かって飛んできた。",
   "ko_candidate": "지나갔어야 할 혜성 중 하나가 궤도를 바꿔 다시 이쪽으로 날아오고 있었다｡"
  },
  {
   "id": 46159,
   "key": "D1511ru.txt:197",
   "file": "D1511ru.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背後からの不意討ちにかわす術も無く、デモンベインは吹っ飛ばされる。",
   "ko_candidate": "뒤에서의 불의의 습격에 피할 방법도 없이 데몬베인은 날아가 버린다｡"
  },
  {
   "id": 46160,
   "key": "D1511ru.txt:202",
   "file": "D1511ru.txt",
   "line": 202,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これも……彼奴の仕業か！」",
   "ko_candidate": "「이것도… 그자의 짓인가!」"
  },
  {
   "id": 46161,
   "key": "D1511ru.txt:205",
   "file": "D1511ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "体勢を立て直すデモンベイン。",
   "ko_candidate": "자세를 바로잡는 데몬베인｡"
  },
  {
   "id": 46162,
   "key": "D1511ru.txt:206",
   "file": "D1511ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが隕石の雨は次から次へと、四方八方、弧を描き襲いかかってくる。",
   "ko_candidate": "하지만 운석의 비는 연이어 사방팔방에서 호를 그리며 덮쳐"
  },
  {
   "id": 46163,
   "key": "D1511ru.txt:213",
   "file": "D1511ru.txt",
   "line": 213,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「防禦結界！」",
   "ko_candidate": "온다｡ 「방어결계!」"
  },
  {
   "id": 46164,
   "key": "D1511ru.txt:219",
   "file": "D1511ru.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大きな隕石はシャンタクを駆使して避け、小さな隕石は魔法障壁で弾く。",
   "ko_candidate": "큰 운석은 샨타크를 구사해 피하고､ 작은 운석은 마법 장벽으로 튕겨낸다｡"
  },
  {
   "id": 46165,
   "key": "D1511ru.txt:221",
   "file": "D1511ru.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "四方から一際巨大な隕石が飛んでくるのを、真上に上昇することでかわす。",
   "ko_candidate": "사방에서 유독 거대한 운석이 날아오는 것을､ 위로 상승하며 피한다｡"
  },
  {
   "id": 46166,
   "key": "D1511ru.txt:223",
   "file": "D1511ru.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……駄目だ、かわし切れない！",
   "ko_candidate": "…안 돼､ 피할 수 없어!"
  },
  {
   "id": 46167,
   "key": "D1511ru.txt:231",
   "file": "D1511ru.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "４つの隕石が衝突し、爆発。",
   "ko_candidate": "4개의 운석이 충돌하며 폭발한다｡"
  },
  {
   "id": 46168,
   "key": "D1511ru.txt:232",
   "file": "D1511ru.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その衝撃に巻き込まれ、デモンベインは弾き飛ばされた。",
   "ko_candidate": "그 충격에 휘말려 데몬베인은 튕겨 나갔다｡"
  },
  {
   "id": 46169,
   "key": "D1511ru.txt:233",
   "file": "D1511ru.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞬間、デモンベインは完全に無防備。",
   "ko_candidate": "순간､ 데몬베인은 완전히 무방비 상태가 되었다｡"
  },
  {
   "id": 46170,
   "key": "D1511ru.txt:234",
   "file": "D1511ru.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは致命的な隙。",
   "ko_candidate": "그것은 치명적인 틈｡"
  },
  {
   "id": 46171,
   "key": "D1511ru.txt:243",
   "file": "D1511ru.txt",
   "line": 243,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  },
  {
   "id": 46172,
   "key": "D1511ru.txt:246",
   "file": "D1511ru.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な金の十字架。",
   "ko_candidate": "거대한 황금 십자가｡"
  },
  {
   "id": 46173,
   "key": "D1511ru.txt:247",
   "file": "D1511ru.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術防禦を突き破り、それはデモンベインへと振り下ろされる。",
   "ko_candidate": "마술 방어를 뚫고､ 그것은 데몬베인을 향해 내리쳐진다｡"
  },
  {
   "id": 46174,
   "key": "D1511ru.txt:251",
   "file": "D1511ru.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真っ先に来たものは空白。",
   "ko_candidate": "가장 먼저 온 것은 공백｡"
  },
  {
   "id": 46175,
   "key": "D1511ru.txt:252",
   "file": "D1511ru.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次に来たものは衝動。",
   "ko_candidate": "다음으로 온 것은 충동｡"
  },
  {
   "id": 46176,
   "key": "D1511ru.txt:253",
   "file": "D1511ru.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遅れて絶望。",
   "ko_candidate": "뒤늦게 절망｡"
  },
  {
   "id": 46177,
   "key": "D1511ru.txt:254",
   "file": "D1511ru.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃はついぞ感じることもなく――",
   "ko_candidate": "충격은 끝내 느낄 수조차 없이――"
  },
  {
   "id": 46178,
   "key": "D1511ru.txt:267",
   "file": "D1511ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットの中に、赤い水の塊が浮かび、漂っている。",
   "ko_candidate": "콕핏 안에 붉은 물의 덩어리가 떠다니고 있다｡"
  },
  {
   "id": 46179,
   "key": "D1511ru.txt:269",
   "file": "D1511ru.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが何なのか、最初は分からなかった。",
   "ko_candidate": "그것이 무엇인지 처음에는 몰랐다｡"
  },
  {
   "id": 46180,
   "key": "D1511ru.txt:270",
   "file": "D1511ru.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "が、腹ン中の痛みと、唐突に込み上げてきた熱い塊。",
   "ko_candidate": "하지만 배 속의 통증과 갑자기 치밀어 오른 뜨거운 덩어리｡"
  },
  {
   "id": 46181,
   "key": "D1511ru.txt:273",
   "file": "D1511ru.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "咽喉を灼くその感覚に耐え切れずそれを吐き出して――ようやく内臓をやられていることに気づいた。",
   "ko_candidate": "목구멍을 태우는 그 감각을 견디지 못하고 그것을 토해내고서야――겨우 내장이 당했다는 것을 깨달았다｡"
  }
 ]
}