 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "九郎ちゃん": "쿠로 군",
  "アル": "알"
 },
 "items": [
  {
   "id": 45763,
   "key": "D1510le.txt:9",
   "file": "D1510le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここが何処で、今がいつで、何がどうなっているのか。",
   "ko_candidate": "여기가 어디고､ 지금이 언제이며､ 무엇이 어떻게 되고 있는지｡"
  },
  {
   "id": 45764,
   "key": "D1510le.txt:10",
   "file": "D1510le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "混乱の収まらない意識が、必死に世界との取っ掛かりを求めていた。",
   "ko_candidate": "혼란이 가라앉지 않는 의식이 필사적으로 세계와의 연결고리를 찾고 있었다｡"
  },
  {
   "id": 45765,
   "key": "D1510le.txt:12",
   "file": "D1510le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何もかもが曖昧で、何に対しても実感がないのは、どうしようもなく不安だ。",
   "ko_candidate": "모든 것이 모호하고､ 어떤 것에도 실감이 나지 않는 것은 어쩔 수 없이"
  },
  {
   "id": 45766,
   "key": "D1510le.txt:14",
   "file": "D1510le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自分と世界の境界すら、あやふやになってしまう。",
   "ko_candidate": "불안하다｡ 자신과 세계의 경계조차 흐릿해져 버린다｡"
  },
  {
   "id": 45767,
   "key": "D1510le.txt:16",
   "file": "D1510le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそんな不安の中、腕に抱いた、優しく、柔らかい温もりの存在を強く感じた。",
   "ko_candidate": "하지만 그런 불안 속에서 팔에 안긴 부드럽고 따뜻한 온기의 존재를 강하게 느꼈다｡"
  },
  {
   "id": 45768,
   "key": "D1510le.txt:18",
   "file": "D1510le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを確かな存在の手がかりに、俺は自分を取り戻していく。",
   "ko_candidate": "그것을 확실한 존재의 단서로 삼아､ 나는 자신을 되찾아간다｡"
  },
  {
   "id": 45769,
   "key": "D1510le.txt:20",
   "file": "D1510le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳を開けた。",
   "ko_candidate": "눈을 떴다｡"
  },
  {
   "id": 45770,
   "key": "D1510le.txt:21",
   "file": "D1510le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何よりも真っ先に飛び込んで来たのは、腕の中から俺を見上げてる、大切な女性の顔。",
   "ko_candidate": "무엇보다도 가장 먼저 눈에 들어온 것은 팔 안에서 나를 올려다보는 소중한 여성의 얼굴｡"
  },
  {
   "id": 45771,
   "key": "D1510le.txt:31",
   "file": "D1510le.txt",
   "line": 31,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ライカさん」",
   "ko_candidate": "「……라이카 씨」"
  },
  {
   "id": 45772,
   "key": "D1510le.txt:33",
   "file": "D1510le.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "名前を呼ぶと、彼女は柔らかな微笑みを浮かべて、俺を迎え入れてくれた。",
   "ko_candidate": "이름을 부르자 그녀는 부드러운 미소를 지으며 나를 맞이해 주었다｡"
  },
  {
   "id": 45773,
   "key": "D1510le.txt:35",
   "file": "D1510le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "穏やかな光を湛える、あの優しい瞳が、俺を見つめている。",
   "ko_candidate": "온화한 빛을 머금은 그 상냥한 눈동자가 나를 바라보고 있다｡"
  },
  {
   "id": 45774,
   "key": "D1510le.txt:39",
   "file": "D1510le.txt",
   "line": 39,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……大丈夫？　九郎ちゃん？」",
   "ko_candidate": "「……괜찮아? 쿠로?」"
  },
  {
   "id": 45775,
   "key": "D1510le.txt:43",
   "file": "D1510le.txt",
   "line": 43,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんこそ……！」",
   "ko_candidate": "「라이카 씨야말로……!」"
  },
  {
   "id": 45776,
   "key": "D1510le.txt:50",
   "file": "D1510le.txt",
   "line": 50,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃっ……！」",
   "ko_candidate": "「꺄……!」"
  },
  {
   "id": 45777,
   "key": "D1510le.txt:53",
   "file": "D1510le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力いっぱいに、その柔らかい躰を抱きしめる。",
   "ko_candidate": "온 힘을 다해 그 부드러운 몸을 꼭 껴안는다｡"
  },
  {
   "id": 45778,
   "key": "D1510le.txt:54",
   "file": "D1510le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつも通りのライカさんが、俺の腕の中にいる。",
   "ko_candidate": "언제나처럼 변함없는 라이카 씨가 내 팔 안에 있다｡"
  },
  {
   "id": 45779,
   "key": "D1510le.txt:56",
   "file": "D1510le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ようやく……ようやく、取り戻した。",
   "ko_candidate": "드디어…… 드디어 되찾았다｡"
  },
  {
   "id": 45780,
   "key": "D1510le.txt:57",
   "file": "D1510le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "日なたのように暖かい、俺の居場所を取り戻した。",
   "ko_candidate": "양지처럼 따뜻한､ 내 자리를 되찾았다｡"
  },
  {
   "id": 45781,
   "key": "D1510le.txt:61",
   "file": "D1510le.txt",
   "line": 61,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「痛いよ……九郎ちゃん」",
   "ko_candidate": "「아파…… 쿠로」 「………………」"
  },
  {
   "id": 45782,
   "key": "D1510le.txt:65",
   "file": "D1510le.txt",
   "line": 65,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………ッ」",
   "ko_candidate": "「……쿠로?」 「으윽……」"
  },
  {
   "id": 45783,
   "key": "D1510le.txt:69",
   "file": "D1510le.txt",
   "line": 69,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……九郎ちゃん？」",
   "ko_candidate": "「쿠로…… 혹시 울고 있어?」"
  },
  {
   "id": 45784,
   "key": "D1510le.txt:73",
   "file": "D1510le.txt",
   "line": 73,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うく……っ」",
   "ko_candidate": "「……미안해」"
  },
  {
   "id": 45785,
   "key": "D1510le.txt:77",
   "file": "D1510le.txt",
   "line": 77,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん…… もしかして泣いてる？」",
   "ko_candidate": "「엣……?」"
  },
  {
   "id": 45786,
   "key": "D1510le.txt:82",
   "file": "D1510le.txt",
   "line": 82,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……すまない」",
   "ko_candidate": "「……오는 게…… 늦어서……」"
  },
  {
   "id": 45787,
   "key": "D1510le.txt:86",
   "file": "D1510le.txt",
   "line": 86,
   "speaker": "ライカ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」 「……来るのが……遅くなった……」",
   "ko_candidate": "자기만족일지라도 사과하지 않으면 마음이 편치 않았다｡"
  },
  {
   "id": 45788,
   "key": "D1510le.txt:93",
   "file": "D1510le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自己満足でも、謝らなければ気が済まなかった。",
   "ko_candidate": "내가 우물쭈물하는 동안 라이카 씨가 얼마나 끔찍한 일을"
  },
  {
   "id": 45789,
   "key": "D1510le.txt:95",
   "file": "D1510le.txt",
   "line": 95,
   "speaker": "ライカ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺がもたもたしている間に、ライカさんがどれほど酷い目に遭ってきたか、それを考えるだけで胸が苦しくなった。 「九郎ちゃん……」",
   "ko_candidate": "겪었을지､ 그것을 생각하는 것만으로도 가슴이 아팠다｡"
  },
  {
   "id": 45790,
   "key": "D1510le.txt:103",
   "file": "D1510le.txt",
   "line": 103,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「쿠로……」"
  },
  {
   "id": 45791,
   "key": "D1510le.txt:107",
   "file": "D1510le.txt",
   "line": 107,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……えいっ」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 45792,
   "key": "D1510le.txt:111",
   "file": "D1510le.txt",
   "line": 111,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ん……っ!?」",
   "ko_candidate": "「……에잇」 「음……?!」"
  },
  {
   "id": 45793,
   "key": "D1510le.txt:117",
   "file": "D1510le.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんが、突然、俺の頭を抱きかかえ、唇を重ねてきた。",
   "ko_candidate": "라이카 씨가 갑자기 내 머리를 감싸 안고 입술을 포개왔다｡"
  },
  {
   "id": 45794,
   "key": "D1510le.txt:119",
   "file": "D1510le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "互いの温もりを伝え合う、長い、長いキス。",
   "ko_candidate": "서로의 온기를 나누는 길고 긴 키스｡"
  },
  {
   "id": 45795,
   "key": "D1510le.txt:121",
   "file": "D1510le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがてゆっくりと唇を離し、面食らう俺に、悪戯っぽく微笑みかけた。",
   "ko_candidate": "이윽고 천천히 입술을 떼고 당황한 나에게 장난스럽게 미소 지었다｡"
  },
  {
   "id": 45796,
   "key": "D1510le.txt:127",
   "file": "D1510le.txt",
   "line": 127,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃんは、ちゃんと私を助けてくれた。閉ざされた心の中で、九郎ちゃんの声が聴こえたから。だから私は自分を取り戻すことが出来た」",
   "ko_candidate": "「쿠로는 제대로 날 구해줬어｡ 닫혀 있던 마음속에서 쿠로의 목소리가 들렸으니까｡ 그래서 나는 자신을 되찾을 수 있었어」"
  },
  {
   "id": 45797,
   "key": "D1510le.txt:131",
   "file": "D1510le.txt",
   "line": 131,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 45798,
   "key": "D1510le.txt:137",
   "file": "D1510le.txt",
   "line": 137,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それよりも……私、九郎ちゃんをもう少しで殺してしまうところだった……」",
   "ko_candidate": "「그보다…… 나､ 쿠로를 조금 더 있었으면 죽일 뻔했어……」"
  },
  {
   "id": 45799,
   "key": "D1510le.txt:140",
   "file": "D1510le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腹の、刺された辺りをそっと撫でながら、ライカさんは憂いの表情を覗かせた。",
   "ko_candidate": "배의 찔린 부위를 살며시 쓰다듬으며 라이카 씨는 근심 어린 표정을 보였다｡"
  },
  {
   "id": 45800,
   "key": "D1510le.txt:140",
   "file": "D1510le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傷は確かに深かったが、アルの術を施されて、もうだいぶ治っている。",
   "ko_candidate": "상처는 확실히 깊었지만､ 알의 술식을 받아 이제 많이 나아졌다｡"
  },
  {
   "id": 45801,
   "key": "D1510le.txt:142",
   "file": "D1510le.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もまた、笑って答えた。",
   "ko_candidate": "나 역시 웃으며 대답했다｡"
  },
  {
   "id": 45802,
   "key": "D1510le.txt:146",
   "file": "D1510le.txt",
   "line": 146,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「かすり傷さ」",
   "ko_candidate": "「긁힌 정도야」"
  }
 ]
}