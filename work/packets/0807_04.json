 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ライカ": "라이카",
  "マギウス・スタイル": "마기우스 스타일",
  "九郎": "쿠로",
  "魔力": "마력"
 },
 "items": [
  {
   "id": 13712,
   "key": "D0807le.txt:13",
   "file": "D0807le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "荷物を引きずりながら、ライカさんの姿を捜す。",
   "ko_candidate": "짐을 끌면서 라이카 씨의 모습을 찾는다｡"
  },
  {
   "id": 13713,
   "key": "D0807le.txt:15",
   "file": "D0807le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "店員から解放されるのに時間を食ってしまったから、もうどこに居るのやら、完全に見失っている。",
   "ko_candidate": "점원에게서 해방되는 데 시간을 잡아먹어 버려서､ 이제 어디에 있는지 완전히 놓쳐버렸다｡"
  },
  {
   "id": 13714,
   "key": "D0807le.txt:18",
   "file": "D0807le.txt",
   "line": 18,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「まったく……なんて、迷惑……なっ！」",
   "ko_candidate": "「정말……뭐 이런､ 폐를……낫!」"
  },
  {
   "id": 13715,
   "key": "D0807le.txt:23",
   "file": "D0807le.txt",
   "line": 23,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だが、尋常ではない様子だったな」",
   "ko_candidate": "「하지만､ 보통이 아닌 모습이었어」"
  },
  {
   "id": 13716,
   "key": "D0807le.txt:28",
   "file": "D0807le.txt",
   "line": 28,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 13717,
   "key": "D0807le.txt:30",
   "file": "D0807le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その通りだった。",
   "ko_candidate": "그 말이 맞았다｡"
  },
  {
   "id": 13718,
   "key": "D0807le.txt:31",
   "file": "D0807le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんのあんな表情は、少なくとも俺は今まで見たことない。",
   "ko_candidate": "라이카 씨의 그런 표정은､ 적어도 나는 지금까지 본 적이 없다｡"
  },
  {
   "id": 13719,
   "key": "D0807le.txt:33",
   "file": "D0807le.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いったい何があったのか。心配だ。",
   "ko_candidate": "도대체 무슨 일이 있었던 걸까｡ 걱정된다｡"
  },
  {
   "id": 13720,
   "key": "D0807le.txt:34",
   "file": "D0807le.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "街の中に視線を走らせて、ライカさんの姿を捜す。",
   "ko_candidate": "거리 안에 시선을 달리며 라이카 씨의 모습을 찾는다｡"
  },
  {
   "id": 13721,
   "key": "D0807le.txt:35",
   "file": "D0807le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だがこの人込みでは見つけられる可能性は薄い。",
   "ko_candidate": "하지만 이 인파 속에서는 찾을 수 있는 가능성은 희박하다｡"
  },
  {
   "id": 13722,
   "key": "D0807le.txt:37",
   "file": "D0807le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どうする？",
   "ko_candidate": "어떻게 하지?"
  },
  {
   "id": 13723,
   "key": "D0807le.txt:38",
   "file": "D0807le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "先に帰って、待っていた方が良いのか？",
   "ko_candidate": "먼저 돌아가서 기다리는 게 좋을까?"
  },
  {
   "id": 13724,
   "key": "D0807le.txt:39",
   "file": "D0807le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "でも……。",
   "ko_candidate": "하지만……"
  },
  {
   "id": 13725,
   "key": "D0807le.txt:43",
   "file": "D0807le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……こいつの出番か。",
   "ko_candidate": "……이놈의 차례인가｡"
  },
  {
   "id": 13726,
   "key": "D0807le.txt:45",
   "file": "D0807le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "首にかけたネックレスを手に持つ。",
   "ko_candidate": "목에 걸린 목걸이를 손에 쥔다｡"
  },
  {
   "id": 13727,
   "key": "D0807le.txt:46",
   "file": "D0807le.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "チェーンにぶら下がった飾り石は振り子となって、自ら意思を持つかのように激しく回転を始める。",
   "ko_candidate": "체인에 매달린 장식 돌은 추가 되어 스스로 의지를 가진 듯이 격렬하게 회전을 시작한다｡"
  },
  {
   "id": 13728,
   "key": "D0807le.txt:48",
   "file": "D0807le.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ダウジング。",
   "ko_candidate": "다우징｡"
  },
  {
   "id": 13729,
   "key": "D0807le.txt:49",
   "file": "D0807le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "精度は低いものの、ようやくマギウス・スタイルに変身しないでも使えるようになった。",
   "ko_candidate": "정확도는 낮지만､ 드디어 마기우스 스타일로 변신하지 않고도 쓸 수 있게 되었다｡"
  },
  {
   "id": 13730,
   "key": "D0807le.txt:51",
   "file": "D0807le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さて、これで見つかれば良いが……。",
   "ko_candidate": "자､ 이걸로 찾을 수 있으면 좋겠지만……"
  },
  {
   "id": 13731,
   "key": "D0807le.txt:56",
   "file": "D0807le.txt",
   "line": 56,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「!?　九郎、振り子の揺れがおかしい！」",
   "ko_candidate": "「!? 쿠로､ 추의 흔들림이 이상해!」"
  },
  {
   "id": 13732,
   "key": "D0807le.txt:61",
   "file": "D0807le.txt",
   "line": 61,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「えっ……？　ッ!?　こ、これは……！」",
   "ko_candidate": "「엣……? 읏!? 이､ 이건……!」"
  },
  {
   "id": 13733,
   "key": "D0807le.txt:64",
   "file": "D0807le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "回転の向きがはっきりせず、出鱈目な動き。",
   "ko_candidate": "회전의 방향이 분명하지 않고､ 엉망진창인 움직임｡"
  },
  {
   "id": 13734,
   "key": "D0807le.txt:65",
   "file": "D0807le.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや、それだけではなかった。",
   "ko_candidate": "아니､ 그뿐만이 아니었다｡"
  },
  {
   "id": 13735,
   "key": "D0807le.txt:67",
   "file": "D0807le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "異様なぐらいに振れている。というより、こっちが引っ張り回されそうなぐらいの強い力だ。",
   "ko_candidate": "이상할 정도로 흔들리고 있다｡ 아니､ 이쪽이 끌려다닐 것 같은 정도의 강한 힘이다｡"
  },
  {
   "id": 13736,
   "key": "D0807le.txt:69",
   "file": "D0807le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こ、こいつは……!?",
   "ko_candidate": "이､ 이놈은……!?"
  },
  {
   "id": 13737,
   "key": "D0807le.txt:71",
   "file": "D0807le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "突然、ダウジングの動きが止まった。",
   "ko_candidate": "갑자기 다우징의 움직임이 멈췄다｡"
  },
  {
   "id": 13738,
   "key": "D0807le.txt:75",
   "file": "D0807le.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "バンッ！",
   "ko_candidate": "팡!"
  },
  {
   "id": 13739,
   "key": "D0807le.txt:78",
   "file": "D0807le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "振り子が砕け散り、行き場を失った魔力は逆流して鎖を持つ手で弾けた。",
   "ko_candidate": "추가 산산조각 나고､ 갈 곳을 잃은 마력은 역류해서 사슬을 쥔 손에서 튀었다｡"
  },
  {
   "id": 13740,
   "key": "D0807le.txt:80",
   "file": "D0807le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鎖を落とす。",
   "ko_candidate": "사슬을 떨어뜨린다｡"
  },
  {
   "id": 13741,
   "key": "D0807le.txt:81",
   "file": "D0807le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "手のひらを血が伝った。",
   "ko_candidate": "손바닥에 피가 흘렀다｡"
  },
  {
   "id": 13742,
   "key": "D0807le.txt:83",
   "file": "D0807le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "タウジングをジャミングしてしまうほどの強力な魔力。",
   "ko_candidate": "다우징을 재밍해 버릴 정도의 강력한 마력｡"
  },
  {
   "id": 13743,
   "key": "D0807le.txt:84",
   "file": "D0807le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いったい誰が？",
   "ko_candidate": "도대체 누가?"
  },
  {
   "id": 13744,
   "key": "D0807le.txt:87",
   "file": "D0807le.txt",
   "line": 87,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――ッ」",
   "ko_candidate": "「――――읏」"
  },
  {
   "id": 13745,
   "key": "D0807le.txt:89",
   "file": "D0807le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いきなり人込みが、海を渡るモーゼの如く、２つに分かれた。",
   "ko_candidate": "갑자기 인파가 바다를 건너는 모세처럼 둘로 갈라졌다｡"
  },
  {
   "id": 13746,
   "key": "D0807le.txt:91",
   "file": "D0807le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "みんな遠巻きに、眉を顰めながら、ソレの様子を窺っている。",
   "ko_candidate": "모두 멀찍이서 눈살을 찌푸리며 그것의 모습을 살펴보고 있다｡"
  },
  {
   "id": 13747,
   "key": "D0807le.txt:93",
   "file": "D0807le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "目の前に現れた者の異様さ加減に、目が点になった。",
   "ko_candidate": "눈앞에 나타난 자의 이상한 모습에 눈이 동그래졌다｡"
  },
  {
   "id": 13748,
   "key": "D0807le.txt:98",
   "file": "D0807le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "破けた拘束具に身を包んだ小柄な人間。",
   "ko_candidate": "찢어진 구속구에 몸을 감싼 작은 체구의 인간｡"
  },
  {
   "id": 13749,
   "key": "D0807le.txt:100",
   "file": "D0807le.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "素顔は仮面に隠されていて、分からない。",
   "ko_candidate": "얼굴은 가면에 가려져 있어 알 수 없다｡"
  },
  {
   "id": 13750,
   "key": "D0807le.txt:101",
   "file": "D0807le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "口元は覗けているが、猿轡を嵌められていた。",
   "ko_candidate": "입가는 엿볼 수 있지만､ 재갈이 물려 있었다｡"
  },
  {
   "id": 13751,
   "key": "D0807le.txt:102",
   "file": "D0807le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まるで牢屋から脱獄してきたようなナリだった。",
   "ko_candidate": "마치 감옥에서 탈옥해 온 것 같은 차림새였다｡"
  }
 ]
}