{
 "packet": "1311_03",
 "scene": "1311",
 "anchor": {
  "hit": 50,
  "total": 60,
  "rate": 0.833
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "アル・アジフ": "알 아지프",
  "魔導書": "마도서"
 },
 "items": [
  {
   "id": 35106,
   "key": "D1311al.txt:356",
   "file": "D1311al.txt",
   "line": 356,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "分からなかったが――俺は、聲を聴いた。",
   "ko_candidate": "모르겠지만――나는､ 목소리를 들었다｡"
  },
  {
   "id": 35107,
   "key": "D1311al.txt:357",
   "file": "D1311al.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳に直接響き渡る、異形の聲を。",
   "ko_candidate": "뇌에 직접 울려 퍼지는､ 기괴한 목소리를｡"
  },
  {
   "id": 35108,
   "key": "D1311al.txt:369",
   "file": "D1311al.txt",
   "line": 369,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ……見せてもらうよ、九郎君にアル・アジフ」 「時の濁流に呑まれ、鍛えに鍛えられた術者と、完全体となった最強の魔導書の力がどれほどのものか！」",
   "ko_candidate": "「자……보여주겠지､ 쿠로 군과 알 아지프｡ 시간의 탁류에 휩쓸려､ 단련에 단련된 술사와､ 완전체가 된 최강의 마도서의 힘이 얼마나 대단한지! 이번에야말로､ 이번에야말로 나를 기쁘게 해줘!」"
  },
  {
   "id": 35109,
   "key": "D1311al.txt:375",
   "file": "D1311al.txt",
   "line": 375,
   "speaker": "ナイア / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「今回こそ、 今回こそ僕を悦ばせてくれ！」 「なっ……!?」",
   "ko_candidate": "「뭐……!?」"
  },
  {
   "id": 35110,
   "key": "D1311al.txt:390",
   "file": "D1311al.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞬間、俺の意識は闇に堕ちた。",
   "ko_candidate": "그 순간､ 내 의식은 어둠에 빠졌다｡"
  },
  {
   "id": 35111,
   "key": "D1311al.txt:400",
   "file": "D1311al.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒。",
   "ko_candidate": "암흑｡"
  },
  {
   "id": 35112,
   "key": "D1311al.txt:401",
   "file": "D1311al.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "完全な無明の闇。",
   "ko_candidate": "완전한 무명의 어둠｡"
  },
  {
   "id": 35113,
   "key": "D1311al.txt:402",
   "file": "D1311al.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "纏わりつく、粘つく闇の中に、俺は浮かんでいる。",
   "ko_candidate": "휘감기는､ 끈적이는 어둠 속에､ 나는 떠 있다｡"
  },
  {
   "id": 35114,
   "key": "D1311al.txt:404",
   "file": "D1311al.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "沈んでいる。",
   "ko_candidate": "가라앉고 있다｡"
  },
  {
   "id": 35115,
   "key": "D1311al.txt:405",
   "file": "D1311al.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墜ちている。",
   "ko_candidate": "추락하고 있다｡"
  },
  {
   "id": 35116,
   "key": "D1311al.txt:406",
   "file": "D1311al.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昇っている。",
   "ko_candidate": "올라가고 있다｡"
  },
  {
   "id": 35117,
   "key": "D1311al.txt:408",
   "file": "D1311al.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いずれの感覚も正しくはなかった。",
   "ko_candidate": "어느 감각도 정확하지는 않았다｡"
  },
  {
   "id": 35118,
   "key": "D1311al.txt:409",
   "file": "D1311al.txt",
   "line": 409,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無理に喩えるとするなら、それは何か異常な角度、三次元に生きる存在には、認識出来ない在り得ざる角度へと、進んでいるようだった。",
   "ko_candidate": "억지로 비유하자면､ 그것은 뭔가 이상한 각도､ 3차원에 사는 존재로는､ 인식할 수 없는 있을 수 없는 각도로､ 나아가고 있는 것 같았다｡"
  },
  {
   "id": 35119,
   "key": "D1311al.txt:411",
   "file": "D1311al.txt",
   "line": 411,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この異常な闇は何処まで続くのだろうか。",
   "ko_candidate": "이 이상한 어둠은 어디까지 계속될까｡"
  },
  {
   "id": 35120,
   "key": "D1311al.txt:412",
   "file": "D1311al.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつまで続くのだろうか。",
   "ko_candidate": "언제까지 계속될까｡"
  },
  {
   "id": 35121,
   "key": "D1311al.txt:414",
   "file": "D1311al.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分からない。",
   "ko_candidate": "모르겠다｡"
  },
  {
   "id": 35122,
   "key": "D1311al.txt:416",
   "file": "D1311al.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処は空間も時間も理解できない領域だ。",
   "ko_candidate": "여기는 공간도 시간도 이해할 수 없는 영역이다｡"
  },
  {
   "id": 35123,
   "key": "D1311al.txt:417",
   "file": "D1311al.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何もかもが鎖されている。",
   "ko_candidate": "모든 것이 속박되어 있다｡"
  },
  {
   "id": 35124,
   "key": "D1311al.txt:419",
   "file": "D1311al.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光も音も空気も気配も生も死も 創造も破滅も刹那も永劫も。",
   "ko_candidate": "빛도 소리도 공기도 기척도 삶도 죽음도 창조도 파멸도 찰나도 영겁도｡"
  },
  {
   "id": 35125,
   "key": "D1311al.txt:421",
   "file": "D1311al.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、混沌の闇に囚われている。",
   "ko_candidate": "나는､ 혼돈의 어둠에 사로잡혀 있다｡"
  },
  {
   "id": 35126,
   "key": "D1311al.txt:423",
   "file": "D1311al.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人智を超えた混沌の中で、俺の意識は朽ちてゆく。",
   "ko_candidate": "인지를 초월한 혼돈 속에서､ 내 의식은 썩어가고 있다｡"
  },
  {
   "id": 35127,
   "key": "D1311al.txt:424",
   "file": "D1311al.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理解を超える異形は、人の魂を犯すのだ。",
   "ko_candidate": "이해를 초월하는 기괴한 형상이 인간의 영혼을 침범한다｡"
  },
  {
   "id": 35128,
   "key": "D1311al.txt:426",
   "file": "D1311al.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでも、俺は必死で自らを繋ぎ止める。",
   "ko_candidate": "그래도 나는 필사적으로 자신을 붙잡는다｡"
  },
  {
   "id": 35129,
   "key": "D1311al.txt:427",
   "file": "D1311al.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処で消滅するワケにはいかないという意志が、唯一、俺を支えていた。",
   "ko_candidate": "여기서 소멸할 수는 없다는 의지만이 유일하게 나를 지탱하고 있었다｡"
  },
  {
   "id": 35130,
   "key": "D1311al.txt:429",
   "file": "D1311al.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして苛烈な闘いの果てに――",
   "ko_candidate": "그리고 격렬한 싸움 끝에――"
  },
  {
   "id": 35131,
   "key": "D1311al.txt:434",
   "file": "D1311al.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の中に、突然、一粒の光が生まれた。",
   "ko_candidate": "어둠 속에 갑자기 한 줄기 빛이 생겼다｡"
  },
  {
   "id": 35132,
   "key": "D1311al.txt:435",
   "file": "D1311al.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光を求めて、手を伸ばす。",
   "ko_candidate": "빛을 향해 손을 뻗는다｡"
  },
  {
   "id": 35133,
   "key": "D1311al.txt:437",
   "file": "D1311al.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の正体は、匣、だった。",
   "ko_candidate": "빛의 정체는 상자였다｡"
  },
  {
   "id": 35134,
   "key": "D1311al.txt:439",
   "file": "D1311al.txt",
   "line": 439,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不均整な容の、匣の隙間から、僅かに光が零れている。",
   "ko_candidate": "불균형한 모양의 상자 틈새로 희미하게 빛이 새어 나오고 있다｡"
  },
  {
   "id": 35135,
   "key": "D1311al.txt:440",
   "file": "D1311al.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "伸ばした手は、あっさりと、匣に触れた。",
   "ko_candidate": "뻗은 손은 어렵지 않게 상자에 닿았다｡"
  },
  {
   "id": 35136,
   "key": "D1311al.txt:441",
   "file": "D1311al.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蓋が独りでに開き、中身が覗ける。",
   "ko_candidate": "뚜껑이 저절로 열리고 내용물이 보인다｡"
  },
  {
   "id": 35137,
   "key": "D1311al.txt:448",
   "file": "D1311al.txt",
   "line": 448,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは……異様な物体だった。",
   "ko_candidate": "그것은… 기이한 물체였다｡"
  },
  {
   "id": 35138,
   "key": "D1311al.txt:449",
   "file": "D1311al.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "７本の支柱に支えられた、黒い結晶体。",
   "ko_candidate": "7개의 기둥에 받쳐진 검은 결정체｡"
  },
  {
   "id": 35139,
   "key": "D1311al.txt:450",
   "file": "D1311al.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不揃いの平面によって構成された多面体に、まるで血管のような紅い線が走っている。",
   "ko_candidate": "불규칙한 평면으로 구성된 다면체에 마치 혈관 같은 붉은 선이 그어져 있다｡"
  },
  {
   "id": 35140,
   "key": "D1311al.txt:452",
   "file": "D1311al.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは明らかに鉱物でありながら、同時に脈動する生命の生々しさを兼ね揃えていた。 光は、その結晶体より発せられていた。",
   "ko_candidate": "그것은 분명 광물이면서도 동시에 맥박 치는 생명의 생생함을 겸비하고 있었다｡"
  },
  {
   "id": 35141,
   "key": "D1311al.txt:463",
   "file": "D1311al.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蓋が開けられた事で光が爆裂する。",
   "ko_candidate": "빛은 그 결정체에서 발산되고 있었다｡"
  },
  {
   "id": 35142,
   "key": "D1311al.txt:464",
   "file": "D1311al.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "異形じみた光だった。",
   "ko_candidate": "뚜껑이 열리자 빛이 폭발한다｡"
  },
  {
   "id": 35143,
   "key": "D1311al.txt:465",
   "file": "D1311al.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうとしか表現のしようがなかった。",
   "ko_candidate": "기괴한 빛이었다｡ 그렇게밖에 표현할 수 없었다｡"
  },
  {
   "id": 35144,
   "key": "D1311al.txt:466",
   "file": "D1311al.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光は悶え狂いつつ乱舞し、俺を呑み込んでしまう。",
   "ko_candidate": "빛은 몸부림치며 광란의 춤을 추다 나를 삼켜버린다｡"
  },
  {
   "id": 35145,
   "key": "D1311al.txt:468",
   "file": "D1311al.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂った光と闇の中で、異形の聲を聴く。",
   "ko_candidate": "미친 빛과 어둠 속에서 기괴한 목소리를 듣는다｡"
  }
 ]
}