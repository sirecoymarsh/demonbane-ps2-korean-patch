 },
 "items": [
  {
   "id": 46342,
   "key": "D1511ru.txt:972",
   "file": "D1511ru.txt",
   "line": 972,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――あ」",
   "ko_candidate": "「――――――――아」"
  },
  {
   "id": 46343,
   "key": "D1511ru.txt:975",
   "file": "D1511ru.txt",
   "line": 975,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして視界に広がるそれを見て、絶句する。",
   "ko_candidate": "그리고 시야에 펼쳐진 그것을 보고 말을 잃는다｡"
  },
  {
   "id": 46344,
   "key": "D1511ru.txt:977",
   "file": "D1511ru.txt",
   "line": 977,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――圧倒されていた。",
   "ko_candidate": "――압도당하고 있었다｡"
  },
  {
   "id": 46345,
   "key": "D1511ru.txt:978",
   "file": "D1511ru.txt",
   "line": 978,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その、何処までも透明な美しさに。",
   "ko_candidate": "그 어디까지나 투명한 아름다움에｡"
  },
  {
   "id": 46346,
   "key": "D1511ru.txt:982",
   "file": "D1511ru.txt",
   "line": 982,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてようやく悟る。",
   "ko_candidate": "그리고 마침내 깨닫는다｡"
  },
  {
   "id": 46347,
   "key": "D1511ru.txt:983",
   "file": "D1511ru.txt",
   "line": 983,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺達に漲るこの力の正体を。",
   "ko_candidate": "우리에게 넘치는 이 힘의 정체를｡"
  },
  {
   "id": 46348,
   "key": "D1511ru.txt:985",
   "file": "D1511ru.txt",
   "line": 985,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魂は限り無く昂ぶり、だが限り無く澄み切っていた。",
   "ko_candidate": "영혼은 한없이 고조되고､ 하지만 한없이 맑아져 있었다｡"
  },
  {
   "id": 46349,
   "key": "D1511ru.txt:986",
   "file": "D1511ru.txt",
   "line": 986,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "みっともないことに俺は沸き起こる感情に、薄ら涙すら浮かべていた。",
   "ko_candidate": "부끄럽게도 나는 솟구치는 감정에 엷은 눈물까지 맺히고 말았다｡"
  },
  {
   "id": 46350,
   "key": "D1511ru.txt:989",
   "file": "D1511ru.txt",
   "line": 989,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル……俺たちは……」",
   "ko_candidate": "「알……우리는……」"
  },
  {
   "id": 46351,
   "key": "D1511ru.txt:994",
   "file": "D1511ru.txt",
   "line": 994,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……分かるとも。九郎」",
   "ko_candidate": "「그래……알고 있어｡ 쿠로」"
  },
  {
   "id": 46352,
   "key": "D1511ru.txt:1003",
   "file": "D1511ru.txt",
   "line": 1003,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はつくづく大馬鹿野郎だ。",
   "ko_candidate": "나는 정말 대바보 멍청이다｡"
  },
  {
   "id": 46353,
   "key": "D1511ru.txt:1005",
   "file": "D1511ru.txt",
   "line": 1005,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何を自惚れていた？",
   "ko_candidate": "무엇을 자만했던 거지?"
  },
  {
   "id": 46354,
   "key": "D1511ru.txt:1006",
   "file": "D1511ru.txt",
   "line": 1006,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何をヒーローぶっていた？",
   "ko_candidate": "무엇을 영웅인 척했던 거지?"
  },
  {
   "id": 46355,
   "key": "D1511ru.txt:1007",
   "file": "D1511ru.txt",
   "line": 1007,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな器じゃないこと、分かりきっていることじゃないか。",
   "ko_candidate": "그런 그릇이 아니라는 걸､ 뻔히 알고 있는 일이 아닌가｡"
  },
  {
   "id": 46356,
   "key": "D1511ru.txt:1009",
   "file": "D1511ru.txt",
   "line": 1009,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうさ、俺たちが護っていたんじゃない……！",
   "ko_candidate": "그래､ 우리가 지키고 있던 게 아니야……!"
  },
  {
   "id": 46357,
   "key": "D1511ru.txt:1019",
   "file": "D1511ru.txt",
   "line": 1019,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――俺達が、この地球に護られていたんだ！",
   "ko_candidate": "――우리가､ 이 지구에 의해 지켜지고 있었던 거야!"
  },
  {
   "id": 46358,
   "key": "D1511ru.txt:1031",
   "file": "D1511ru.txt",
   "line": 1031,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――地球。",
   "ko_candidate": "――지구｡"
  },
  {
   "id": 46359,
   "key": "D1511ru.txt:1033",
   "file": "D1511ru.txt",
   "line": 1033,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつの時代の地球かは分からない。",
   "ko_candidate": "언제의 시대의 지구인지는 모르겠다｡"
  },
  {
   "id": 46360,
   "key": "D1511ru.txt:1035",
   "file": "D1511ru.txt",
   "line": 1035,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、その美しさは、俺に漲る力を与えてくれる。",
   "ko_candidate": "하지만､ 그 아름다움은 나에게 넘치는 힘을 준다｡"
  },
  {
   "id": 46361,
   "key": "D1511ru.txt:1037",
   "file": "D1511ru.txt",
   "line": 1037,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの地球を護る為に――俺と姫さんが生きる地球を守る為に、俺は戦っている。",
   "ko_candidate": "저 지구를 지키기 위해――나와 공주님이 살아가는 지구를 지키기 위해､ 나는 싸우고 있다｡"
  },
  {
   "id": 46362,
   "key": "D1511ru.txt:1038",
   "file": "D1511ru.txt",
   "line": 1038,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのことを改めて、確信させられる。",
   "ko_candidate": "그 사실을 다시금 확신하게 된다｡"
  },
  {
   "id": 46363,
   "key": "D1511ru.txt:1040",
   "file": "D1511ru.txt",
   "line": 1040,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魂は限り無く昂ぶり、だが限り無く澄み切っていた。",
   "ko_candidate": "영혼은 한없이 고조되고､ 하지만 한없이 맑아졌다｡"
  },
  {
   "id": 46364,
   "key": "D1511ru.txt:1041",
   "file": "D1511ru.txt",
   "line": 1041,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "みっとないことに俺は沸き起こる感情に、薄ら涙すら浮かべていた。",
   "ko_candidate": "부끄럽게도 나는 솟구치는 감정에､ 엷은 눈물까지 맺혔다｡"
  },
  {
   "id": 46365,
   "key": "D1511ru.txt:1047",
   "file": "D1511ru.txt",
   "line": 1047,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まだまだやれるな、九郎？」",
   "ko_candidate": "「아직 더 할 수 있겠지､ 쿠로?」"
  },
  {
   "id": 46366,
   "key": "D1511ru.txt:1053",
   "file": "D1511ru.txt",
   "line": 1053,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「当たり前だ……これからが本番だぜ！」",
   "ko_candidate": "「당연하지……이제부터가 진짜라고!」"
  },
  {
   "id": 46367,
   "key": "D1511ru.txt:1058",
   "file": "D1511ru.txt",
   "line": 1058,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは地球を背負い、戦う。",
   "ko_candidate": "데몬베인은 지구를 짊어지고､ 싸운다｡"
  },
  {
   "id": 46368,
   "key": "D1511ru.txt:1059",
   "file": "D1511ru.txt",
   "line": 1059,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "負ける道理が見当たらなかった。",
   "ko_candidate": "질 이유가 보이지 않았다｡"
  }
 ]
}