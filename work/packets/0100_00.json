{
 "packet": "0100_00",
 "scene": "0100",
 "anchor": {
  "hit": 19,
  "total": 20,
  "rate": 0.95
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {},
 "items": [
  {
   "id": 0,
   "key": "D0100.txt:47",
   "file": "D0100.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無限の虚空の遥か彼方、孤独の世界のすぐ裏側――侵し合い、犯し合い、冒し合い、幾星霜――それでもなお続く。なお巡る。未来永劫。過去永劫。",
   "ko_candidate": "심원｡ 심연｡"
  },
  {
   "id": 1,
   "key": "D0100.txt:122",
   "file": "D0100.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蠢く怪異の存在を、迫る脅威の存在を、誰が識る。",
   "ko_candidate": "끝없는､ 한없는 별들의 바다｡ 이 무한한 허공의 아득한 저편､ 고독한 세계의 바로 뒤편――"
  },
  {
   "id": 3,
   "key": "D0100.txt:122",
   "file": "D0100.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰が識る。",
   "ko_candidate": "누가 알겠는가｡"
  },
  {
   "id": 5,
   "key": "D0100.txt:124",
   "file": "D0100.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "人智を超え、狂気をも超えた領域で、",
   "ko_candidate": "그래도 여전히 계속된다｡ 여전히 순환한다｡"
  },
  {
   "id": 6,
   "key": "D0100.txt:125",
   "file": "D0100.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして現在、この瞬間もなお。",
   "ko_candidate": "미래영겁､ 과거영겁｡"
  },
  {
   "id": 7,
   "key": "D0100.txt:127",
   "file": "D0100.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "終わりは、恐らくは無いのだろう。",
   "ko_candidate": "그리고 현재､ 이 순간에도 여전히｡"
  },
  {
   "id": 8,
   "key": "D0100.txt:129",
   "file": "D0100.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "果て知らぬ時ののちには、死もまた死ぬる宿めなれば。",
   "ko_candidate": "끝은､ 아마도 없을 것이다｡ 기이한 영겁 속에서 죽음은 죽음마저 소멸시킨다｡"
  },
  {
   "id": 9,
   "key": "D0100.txt:131",
   "file": "D0100.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "星は瞬かない。",
   "ko_candidate": "별은 깜빡이지 않는다｡"
  },
  {
   "id": 10,
   "key": "D0100.txt:132",
   "file": "D0100.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "星は揺らがない。",
   "ko_candidate": "별은 흔들리지 않는다｡"
  },
  {
   "id": 11,
   "key": "D0100.txt:133",
   "file": "D0100.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宙では星の輝きはあまりに凄絶だ。",
   "ko_candidate": "우주에서 별의 빛남은 너무나 처절하다｡"
  },
  {
   "id": 12,
   "key": "D0100.txt:135",
   "file": "D0100.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その輝きが無数に穿たれた漆黒に、この惑星は存在する。",
   "ko_candidate": "그 빛남이 무수히 뚫린 칠흑에､ 이 행성은 존재한다｡"
  },
  {
   "id": 13,
   "key": "D0100.txt:140",
   "file": "D0100.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――蒼い地球。",
   "ko_candidate": "――푸른 지구｡"
  },
  {
   "id": 14,
   "key": "D0100.txt:142",
   "file": "D0100.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深く、",
   "ko_candidate": "깊고､"
  },
  {
   "id": 15,
   "key": "D0100.txt:142",
   "file": "D0100.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深く、",
   "ko_candidate": "깊고､"
  },
  {
   "id": 16,
   "key": "D0100.txt:142",
   "file": "D0100.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蒼い。",
   "ko_candidate": "푸르다｡"
  },
  {
   "id": 17,
   "key": "D0100.txt:143",
   "file": "D0100.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の様な蒼。",
   "ko_candidate": "어둠 같은 푸름｡"
  },
  {
   "id": 18,
   "key": "D0100.txt:144",
   "file": "D0100.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呑み込まれそうな蒼。",
   "ko_candidate": "삼켜질 것 같은 푸름｡"
  },
  {
   "id": 19,
   "key": "D0100.txt:145",
   "file": "D0100.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その癖、何より煌いている。",
   "ko_candidate": "그 주제에､ 무엇보다 찬란하다｡"
  },
  {
   "id": 20,
   "key": "D0100.txt:147",
   "file": "D0100.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "淡く",
   "ko_candidate": "은은하게"
  },
  {
   "id": 21,
   "key": "D0100.txt:148",
   "file": "D0100.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眩く",
   "ko_candidate": "눈부시게"
  },
  {
   "id": 22,
   "key": "D0100.txt:149",
   "file": "D0100.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静謐に",
   "ko_candidate": "고요하게"
  },
  {
   "id": 23,
   "key": "D0100.txt:150",
   "file": "D0100.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "圧倒的に。",
   "ko_candidate": "압도적으로｡"
  },
  {
   "id": 24,
   "key": "D0100.txt:158",
   "file": "D0100.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――その蒼を抉り、闇色の傷痕が拡がった。",
   "ko_candidate": "――그 푸름을 파고들어､ 어둠색의 상흔이 퍼져갔다｡"
  },
  {
   "id": 25,
   "key": "D0100.txt:163",
   "file": "D0100.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宙を引き裂いた黒い亀裂。",
   "ko_candidate": "우주를 찢은 검은 균열｡"
  },
  {
   "id": 26,
   "key": "D0100.txt:164",
   "file": "D0100.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蒼の拡がりに比べ、それは余りにも小さい。",
   "ko_candidate": "푸름의 광활함에 비해､ 그것은 너무나도 작다｡"
  },
  {
   "id": 27,
   "key": "D0100.txt:166",
   "file": "D0100.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それは確実に存在する怪異。",
   "ko_candidate": "하지만､ 그것은 확실히 존재하는 괴이｡"
  },
  {
   "id": 28,
   "key": "D0100.txt:168",
   "file": "D0100.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不、自然。",
   "ko_candidate": "부､ 자연｡"
  },
  {
   "id": 29,
   "key": "D0100.txt:170",
   "file": "D0100.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在らざるもの。",
   "ko_candidate": "있어서는 안 되는 것｡"
  },
  {
   "id": 30,
   "key": "D0100.txt:171",
   "file": "D0100.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在ってはならぬもの。",
   "ko_candidate": "있어서는 안 되는 것｡"
  },
  {
   "id": 31,
   "key": "D0100.txt:172",
   "file": "D0100.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは明らかな世界の、綻び。",
   "ko_candidate": "그것은 명백한 세계의､ 흐트러짐｡"
  },
  {
   "id": 32,
   "key": "D0100.txt:183",
   "file": "D0100.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "綻びより、ソレは来た。",
   "ko_candidate": "흐트러짐으로부터､ 그것은 왔다｡"
  },
  {
   "id": 33,
   "key": "D0100.txt:184",
   "file": "D0100.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "綻びの向こうから拒絶された様に。",
   "ko_candidate": "흐트러짐의 저편에서 거부된 듯이｡"
  },
  {
   "id": 34,
   "key": "D0100.txt:185",
   "file": "D0100.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "忌まれ、蔑まれ、嘲笑され、排出された。",
   "ko_candidate": "기피되고､ 멸시되고､ 조롱당하고､ 배출되었다｡"
  },
  {
   "id": 35,
   "key": "D0100.txt:187",
   "file": "D0100.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソレは、鋼。",
   "ko_candidate": "그것은､ 강철｡"
  },
  {
   "id": 36,
   "key": "D0100.txt:188",
   "file": "D0100.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な、鋼。",
   "ko_candidate": "거대한､ 강철｡"
  },
  {
   "id": 37,
   "key": "D0100.txt:189",
   "file": "D0100.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何を以って巨大と認識するか。",
   "ko_candidate": "무엇을 가지고 거대하다고 인식하는가｡"
  },
  {
   "id": 38,
   "key": "D0100.txt:191",
   "file": "D0100.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "答えは明白である。",
   "ko_candidate": "답은 명백하다｡"
  },
  {
   "id": 39,
   "key": "D0100.txt:192",
   "file": "D0100.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ソレが模したものと比べて、ソレは余りにも巨大過ぎた。",
   "ko_candidate": "그것이 본뜬 것과 비교해､ 그것은 너무나도 거대했다｡"
  },
  {
   "id": 40,
   "key": "D0100.txt:198",
   "file": "D0100.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――鋼はヒトを象っていた。",
   "ko_candidate": "――강철은 인간을 본떴다｡"
  },
  {
   "id": 41,
   "key": "D0100.txt:200",
   "file": "D0100.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "或いはその認識は過ちであり、傲慢なのかも知れない。",
   "ko_candidate": "혹은 그 인식은 잘못되었고､ 오만한 것일지도 모른다｡"
  }
 ]
}