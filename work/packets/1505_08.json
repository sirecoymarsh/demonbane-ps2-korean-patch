 "items": [
  {
   "id": 42967,
   "key": "D1505le.txt:501",
   "file": "D1505le.txt",
   "line": 501,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っ！」",
   "ko_candidate": "「……!」"
  },
  {
   "id": 42968,
   "key": "D1505le.txt:507",
   "file": "D1505le.txt",
   "line": 507,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうせ。どうせ、外にお前達が生きられる世界はないよ。解かっているだろう？ お前達は人間ではないのだから。 お前達は魔人なのだから。 ただ在るだけで悪。 ただ生きるだけで罪」",
   "ko_candidate": "「어차피｡ 어차피､ 밖에 너희들이 살 수 있는 세상은 없어｡ 알고 있겠지? 너희들은 인간이 아니니까｡ 너희들은 마인이니까｡ 그저 존재하는 것만으로도 악｡ 그저 살아있는 것만으로도 죄」"
  },
  {
   "id": 42969,
   "key": "D1505le.txt:519",
   "file": "D1505le.txt",
   "line": 519,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……ああ……」",
   "ko_candidate": "「아… 아아…」"
  },
  {
   "id": 42970,
   "key": "D1505le.txt:525",
   "file": "D1505le.txt",
   "line": 525,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ帰ろう。悪人達の園に。愛しき我が家に」",
   "ko_candidate": "「자､ 돌아가자｡ 악인들의 정원으로｡ 사랑스러운 우리 집으로」"
  },
  {
   "id": 42971,
   "key": "D1505le.txt:529",
   "file": "D1505le.txt",
   "line": 529,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「耳を貸すな、ライカ！」",
   "ko_candidate": "「귀 기울이지 마､ 라이카!」"
  },
  {
   "id": 42972,
   "key": "D1505le.txt:533",
   "file": "D1505le.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傷ついた躰に鞭打って、リューガは再び魔術師に飛びかかる。",
   "ko_candidate": "상처 입은 몸을 채찍질하듯､ 류가는 다시 마술사에게 달려든다｡"
  },
  {
   "id": 42973,
   "key": "D1505le.txt:534",
   "file": "D1505le.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "軽々と十数メートルの高さまで跳躍。",
   "ko_candidate": "가볍게 십 수 미터 높이까지 도약｡"
  },
  {
   "id": 42974,
   "key": "D1505le.txt:535",
   "file": "D1505le.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのまま鷹のように、上空から襲い掛かる。",
   "ko_candidate": "그대로 매처럼､ 상공에서 덮쳐온다｡"
  },
  {
   "id": 42975,
   "key": "D1505le.txt:538",
   "file": "D1505le.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "稲妻の如き飛び蹴りを、魔術師はやはりステッキで受け止める。",
   "ko_candidate": "번개같은 날아차기를､ 마술사는 역시 지팡이로 받아낸다｡"
  },
  {
   "id": 42976,
   "key": "D1505le.txt:539",
   "file": "D1505le.txt",
   "line": 539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お互いに弾かれ合うように飛び退き、対峙する。",
   "ko_candidate": "서로 튕겨나가듯 뛰어 물러나 대치한다｡"
  },
  {
   "id": 42977,
   "key": "D1505le.txt:541",
   "file": "D1505le.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リューガの殺意に満ちた視線を浴びて、魔術師は溜息をついて、大仰にかぶりを振った。",
   "ko_candidate": "류가의 살의에 찬 시선을 받으며､ 마술사는 한숨을 쉬고､"
  },
  {
   "id": 42978,
   "key": "D1505le.txt:547",
   "file": "D1505le.txt",
   "line": 547,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やれやれ……リューガ。そろそろ、止めにしないかね」 「そろそろおやつの時間なんだが」",
   "ko_candidate": "과장되게 고개를 저었다｡"
  },
  {
   "id": 42979,
   "key": "D1505le.txt:553",
   "file": "D1505le.txt",
   "line": 553,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「今日は折角、せっかくデメルのとっておきが入ったというのに」 「栗をベースにしたチョコレート菓子なのだがな。これが、なかなかに下品でよろしい」",
   "ko_candidate": "「아이고… 류가｡ 슬슬､ 그만두지 않겠나｡ 슬슬 간식 시간인데 말이야｡ 오늘은 마침､ 데메르의 특선이 들어왔다고 하는데｡ 밤을 베이스로 한 초콜릿 과자인데 말이지｡ 이게､ 꽤나 저속해서 좋다고」"
  },
  {
   "id": 42980,
   "key": "D1505le.txt:560",
   "file": "D1505le.txt",
   "line": 560,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「甘いものは嫌いだ」",
   "ko_candidate": "「단 것은 싫어해」"
  },
  {
   "id": 42981,
   "key": "D1505le.txt:566",
   "file": "D1505le.txt",
   "line": 566,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「残念……趣味が合わないねえ」",
   "ko_candidate": "「아쉽군… 취향이 안 맞는구나」"
  },
  {
   "id": 42982,
   "key": "D1505le.txt:570",
   "file": "D1505le.txt",
   "line": 570,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「外にオレ達の生きる世界がないというのなら、それで良い」 「オレ達を認めない世界なら壊してやる。 壊して真っ平らにして、空を覆う全部を無くしてしまえば良い。何も、問題は無い」",
   "ko_candidate": "「밖에 우리가 살 세상이 없다면､ 그걸로 좋아｡ 우리를 인정하지 않는 세상이라면 부숴버리겠어｡ 부숴서 평평하게 만들고､ 하늘을 덮는 모든 것을 없애버리면 돼｡ 아무런､ 문제도 없어」"
  },
  {
   "id": 42983,
   "key": "D1505le.txt:580",
   "file": "D1505le.txt",
   "line": 580,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それが出来るのは『Ｃ計画』だけだよ」",
   "ko_candidate": "「그걸 할 수 있는 건 『C계획』뿐이야」"
  },
  {
   "id": 42984,
   "key": "D1505le.txt:584",
   "file": "D1505le.txt",
   "line": 584,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くだらないな！」",
   "ko_candidate": "「시시하군!」"
  },
  {
   "id": 42985,
   "key": "D1505le.txt:587",
   "file": "D1505le.txt",
   "line": 587,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガが新たな構えを取る。",
   "ko_candidate": "류가가 새로운 자세를 취한다｡"
  },
  {
   "id": 42986,
   "key": "D1505le.txt:588",
   "file": "D1505le.txt",
   "line": 588,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右手を天に翳し、左手を地に下ろす。天地を繋ぐ、攻防一体の構え。",
   "ko_candidate": "오른손을 하늘로 들어 올리고､ 왼손을 땅으로 내린다｡ 천지를 잇는､ 공수일체의 자세｡"
  },
  {
   "id": 42987,
   "key": "D1505le.txt:591",
   "file": "D1505le.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気が、大地が震動する。",
   "ko_candidate": "대기가､ 대지가 진동한다｡"
  },
  {
   "id": 42988,
   "key": "D1505le.txt:592",
   "file": "D1505le.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガに内蔵された機関が世界より魔力を汲み上げているのだ。その波動の総てを彼は、破壊力へと変換する。",
   "ko_candidate": "류가에 내장된 기관이 세계로부터 마력을 끌어올리고 있다｡ 그 파동의 모든 것을 그는､ 파괴력으로 변환한다｡"
  },
  {
   "id": 42989,
   "key": "D1505le.txt:594",
   "file": "D1505le.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "劫――ッ！",
   "ko_candidate": "콰아――앗!"
  },
  {
   "id": 42990,
   "key": "D1505le.txt:597",
   "file": "D1505le.txt",
   "line": 597,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "世界の震動は激震となり、魔物の咆吼かと思わせるような爆音が轟いた。",
   "ko_candidate": "세계의 진동은 격진이 되어､ 마물의 포효인가 싶을 정도의 폭음이 울려 퍼졌다｡"
  },
  {
   "id": 42991,
   "key": "D1505le.txt:599",
   "file": "D1505le.txt",
   "line": 599,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガの周囲で、体内で、力が渦巻き、空間を蜃気楼のように歪ませる。",
   "ko_candidate": "류가의 주위에서､ 체내에서､ 힘이 소용돌이치며､ 공간을 신기루처럼 일그러뜨린다｡"
  },
  {
   "id": 42992,
   "key": "D1505le.txt:605",
   "file": "D1505le.txt",
   "line": 605,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「素晴らしい。本当に、お前は想定外に面白い」 「『ムーンチャイルド計画』の意図からは外れるが、お前の見せてくれた結果は実に有意義なものになりそうだ」",
   "ko_candidate": "「훌륭해｡ 정말､ 넌 예상 밖으로 재미있어｡ 『문 차일드 계획』의 의도와는 벗어나지만､ 네가 보여준 결과는 정말 의미 있는 것이 될 것 같아」"
  },
  {
   "id": 42993,
   "key": "D1505le.txt:612",
   "file": "D1505le.txt",
   "line": 612,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いや……死人には無意味なものだろうさ！」",
   "ko_candidate": "「아니… 죽은 자에겐 무의미한 것이겠지!」"
  },
  {
   "id": 42994,
   "key": "D1505le.txt:616",
   "file": "D1505le.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガの足が、大地を、蹴った。",
   "ko_candidate": "류가의 발이､ 대지를､ 찼다｡"
  },
  {
   "id": 42995,
   "key": "D1505le.txt:617",
   "file": "D1505le.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人の間合いは一瞬でゼロになる。",
   "ko_candidate": "두 사람 사이의 간격은 순식간에 제로가 된다｡"
  },
  {
   "id": 42996,
   "key": "D1505le.txt:619",
   "file": "D1505le.txt",
   "line": 619,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渾身の一撃は破壊を宿し崩壊を紡ぎ破滅に至らしめる一撃必殺。",
   "ko_candidate": "혼신의 일격은 파괴를 품고 붕괴를 자아내며 파멸에 이르게 하는 일격필살｡"
  },
  {
   "id": 42997,
   "key": "D1505le.txt:620",
   "file": "D1505le.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一撃必滅。",
   "ko_candidate": "일격필멸｡"
  },
  {
   "id": 42998,
   "key": "D1505le.txt:621",
   "file": "D1505le.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一切合切を絶滅する――",
   "ko_candidate": "일체를 절멸시키는――"
  },
  {
   "id": 42999,
   "key": "D1505le.txt:628",
   "file": "D1505le.txt",
   "line": 628,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理不尽の嵐は、その刹那に、割り込み、爆裂した。",
   "ko_candidate": "이치에 맞지 않는 폭풍은､ 그 찰나에､ 끼어들어､ 폭발했다｡"
  },
  {
   "id": 43000,
   "key": "D1505le.txt:629",
   "file": "D1505le.txt",
   "line": 629,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは秩序の外に位置する現象。",
   "ko_candidate": "그것은 질서의 바깥에 위치하는 현상｡"
  },
  {
   "id": 43001,
   "key": "D1505le.txt:630",
   "file": "D1505le.txt",
   "line": 630,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在り得る筈の無い怪異。",
   "ko_candidate": "있을 수 없는 괴이｡"
  },
  {
   "id": 43002,
   "key": "D1505le.txt:632",
   "file": "D1505le.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大物質の、限り無く零に近い時間に於ける、出現。実体化。",
   "ko_candidate": "거대 물질의､ 한없이 0에 가까운 시간에서의､ 출현｡ 실체화｡"
  },
  {
   "id": 43003,
   "key": "D1505le.txt:633",
   "file": "D1505le.txt",
   "line": 633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俗にそれを『招喚』と呼ぶ。",
   "ko_candidate": "속칭 그것을 『소환』이라 부른다｡"
  },
  {
   "id": 43004,
   "key": "D1505le.txt:637",
   "file": "D1505le.txt",
   "line": 637,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何――――？」",
   "ko_candidate": "「뭐――――?」"
  },
  {
   "id": 43005,
   "key": "D1505le.txt:640",
   "file": "D1505le.txt",
   "line": 640,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『招喚』が空間にもたらす反動が、衝撃波として迸った。",
   "ko_candidate": "『소환』이 공간에 가져온 반동이 충격파로 터져 나왔다｡"
  },
  {
   "id": 43006,
   "key": "D1505le.txt:642",
   "file": "D1505le.txt",
   "line": 642,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "体内を駆け巡る魔導回路が、荒れ狂う衝撃波の牙から、私の躰を守る。",
   "ko_candidate": "체내를 달리는 마도회로가 거칠게 날뛰는 충격파의 이빨로부터 내 몸을"
  }
 ]
}