 },
 "items": [
  {
   "id": 15324,
   "key": "D0810al.txt:295",
   "file": "D0810al.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬から一瞬への綱渡り。",
   "ko_candidate": "순간에서 순간으로의 줄타기｡"
  },
  {
   "id": 15325,
   "key": "D0810al.txt:304",
   "file": "D0810al.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足下が魔弾に穿たれ、爆ぜる、爆ぜる、爆ぜる。",
   "ko_candidate": "발밑이 마탄에 뚫리고 터지고 터지고 터진다｡"
  },
  {
   "id": 15326,
   "key": "D0810al.txt:311",
   "file": "D0810al.txt",
   "line": 311,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ウルアアアアアア！　ミンチだァァァァァァ！」",
   "ko_candidate": "「우루아아아아아! 다진 고기다아아아아아아아!」"
  },
  {
   "id": 15327,
   "key": "D0810al.txt:315",
   "file": "D0810al.txt",
   "line": 315,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――！　ぐっっっ！」",
   "ko_candidate": "「――――! 으윽!」"
  },
  {
   "id": 15328,
   "key": "D0810al.txt:318",
   "file": "D0810al.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラのデウス・マキナ――クラーケンもまた、デモンベインに襲いかかる。",
   "ko_candidate": "칼리굴라의 데우스 마키나――크라켄 또한 데몬베인에 덤벼든다｡"
  },
  {
   "id": 15329,
   "key": "D0810al.txt:326",
   "file": "D0810al.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の両腕が、驚くべき変形を遂げた。",
   "ko_candidate": "강철의 양팔이 놀라운 변형을 이룬다｡"
  },
  {
   "id": 15330,
   "key": "D0810al.txt:327",
   "file": "D0810al.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕の関節の中から、新たな関節が現れる。",
   "ko_candidate": "팔의 관절 안에서 새로운 관절이 나타난다｡"
  },
  {
   "id": 15331,
   "key": "D0810al.txt:329",
   "file": "D0810al.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "新たな関節はさらに新たな関節を出現させ、その関節がさらにさらに新しい関節を――クラーケンの両腕は、もの凄い勢いで伸張し、大蛇のようにうねりながら、デモンベインに迫った！",
   "ko_candidate": "새로운 관절은 더 새로운 관절을 출현시키고､ 그 관절이 더더욱 새로운 관절을――크라켄의 양팔은 엄청난 기세로 신장하며 큰 뱀처럼 꿈틀거리면서 데몬베인에 다가왔다!"
  },
  {
   "id": 15332,
   "key": "D0810al.txt:331",
   "file": "D0810al.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の爪は、喩えるならば大蛇の牙。",
   "ko_candidate": "강철의 발톱은 비유하자면 큰 뱀의 이빨｡"
  },
  {
   "id": 15333,
   "key": "D0810al.txt:332",
   "file": "D0810al.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを噛み砕こうと、兇暴な顎を開ける。",
   "ko_candidate": "데몬베인을 물어뜯으려 흉포한 턱을 벌린다｡"
  },
  {
   "id": 15334,
   "key": "D0810al.txt:335",
   "file": "D0810al.txt",
   "line": 335,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「たぁぁぁぁ！」",
   "ko_candidate": "「타아아아아!」"
  },
  {
   "id": 15335,
   "key": "D0810al.txt:344",
   "file": "D0810al.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶妙の角度から襲いかかるクローを、宙返りしてかわす。",
   "ko_candidate": "절묘한 각도에서 덤벼드는 클로를 공중제비를 돌며 피한다｡"
  },
  {
   "id": 15336,
   "key": "D0810al.txt:349",
   "file": "D0810al.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の腕はとぐろを巻いて、再び迫る。",
   "ko_candidate": "강철의 팔은 똬리를 틀며 다시 다가온다｡"
  },
  {
   "id": 15337,
   "key": "D0810al.txt:359",
   "file": "D0810al.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛び退いてかわす。アスファルトを砕き、大地が抉られる。",
   "ko_candidate": "뛰어 물러나 피한다｡ 아스팔트를 부수고 대지가 파인다｡"
  },
  {
   "id": 15338,
   "key": "D0810al.txt:365",
   "file": "D0810al.txt",
   "line": 365,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅぅぅぅぅ！」",
   "ko_candidate": "「쿠우우우우우!」"
  },
  {
   "id": 15339,
   "key": "D0810al.txt:367",
   "file": "D0810al.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だがいくらクローをかわそうと、伸張した腕、大蛇の胴体が、デモンベインを捉え、絞め殺そうとしつこく纏わりつく。",
   "ko_candidate": "하지만 아무리 발톱을 피하려 해도､ 늘어난 팔과 대사의 몸통이 데몬베인을 붙잡고 질식시키려 집요하게 휘감긴다｡"
  },
  {
   "id": 15340,
   "key": "D0810al.txt:369",
   "file": "D0810al.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "くっ……バルザイの偃月刀があれば、ブッタ斬っているところだが……",
   "ko_candidate": "큿… 바르자이의 언월도가 있었다면 베어버렸을 텐데"
  },
  {
   "id": 15341,
   "key": "D0810al.txt:374",
   "file": "D0810al.txt",
   "line": 374,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おい、アル……」",
   "ko_candidate": "하지만… 「이봐､ 알…」"
  },
  {
   "id": 15342,
   "key": "D0810al.txt:378",
   "file": "D0810al.txt",
   "line": 378,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「無理だ。汝の偃月刀とデモンベインの偃月刀は、霊的に繋がっている」 「片方を失えば、もう片方もタマシイの容を失い、顕現化するだけのエネルギーは得られなくなる」",
   "ko_candidate": "「무리야｡ 네 언월도와 데몬베인의 언월도는 영적으로 연결되어 있어｡ 한쪽을 잃으면 다른 쪽도 영혼의 그릇을 잃고､ 현현화할 만한 에너지를 얻을 수 없게 돼」"
  },
  {
   "id": 15343,
   "key": "D0810al.txt:385",
   "file": "D0810al.txt",
   "line": 385,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ、そう……」",
   "ko_candidate": "「아､ 그래…」"
  },
  {
   "id": 15344,
   "key": "D0810al.txt:388",
   "file": "D0810al.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ならロイガーとツァールならば……！ ――!?　くっ……！",
   "ko_candidate": "게다가 로드 비야키의 포격도 아직 계속되고 있다｡"
  },
  {
   "id": 15345,
   "key": "D0810al.txt:406",
   "file": "D0810al.txt",
   "line": 406,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おらおらおらおらおらおら！　踊れ踊れ踊れ踊れ踊れぇぇぇぇぇ！」",
   "ko_candidate": "「오라오라오라오라오라오라! 춤춰라 춤춰라 춤춰라 춤춰라 춤춰라아아아아!」"
  },
  {
   "id": 15346,
   "key": "D0810al.txt:415",
   "file": "D0810al.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ロードビヤーキーの銃撃が続く。",
   "ko_candidate": "젠장… 저놈｡"
  },
  {
   "id": 15347,
   "key": "D0810al.txt:416",
   "file": "D0810al.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クソッ……奴め。デタラメに撃っているようで正確にこっちの動きを読んでいやがる！",
   "ko_candidate": "엉망으로 쏘는 것 같으면서도 정확하게 이쪽의 움직임을 읽고 있잖아!"
  },
  {
   "id": 15348,
   "key": "D0810al.txt:417",
   "file": "D0810al.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これじゃあ招喚する暇もない！",
   "ko_candidate": "이대로라면 언젠가는 잡힐 거야!"
  },
  {
   "id": 15349,
   "key": "D0810al.txt:424",
   "file": "D0810al.txt",
   "line": 424,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「危ないッ！」",
   "ko_candidate": "「위험해!」"
  },
  {
   "id": 15350,
   "key": "D0810al.txt:428",
   "file": "D0810al.txt",
   "line": 428,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 15351,
   "key": "D0810al.txt:445",
   "file": "D0810al.txt",
   "line": 445,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒャーハハハハッ！　ビンゴぉぉぉぉぉ！　……なに？」",
   "ko_candidate": "「햐하하하하! 빙고오오오오! …뭐지?」"
  },
  {
   "id": 15352,
   "key": "D0810al.txt:462",
   "file": "D0810al.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ニトクリスの鏡で生み出した幻像が砕け散る。",
   "ko_candidate": "니토크리스의 거울로 만들어낸 환영이 산산조각 난다｡"
  },
  {
   "id": 15353,
   "key": "D0810al.txt:463",
   "file": "D0810al.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "危ねえ、危ねえ……今のはちょいとヤバかった。",
   "ko_candidate": "하마터면､ 하마터면… 방금 건 좀 위험했어｡"
  },
  {
   "id": 15354,
   "key": "D0810al.txt:464",
   "file": "D0810al.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 15355,
   "key": "D0810al.txt:471",
   "file": "D0810al.txt",
   "line": 471,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……セコイ真似してんじゃねぇよ、ヘタレがっ！」",
   "ko_candidate": "「…비겁한 짓 하지 마､ 겁쟁이 자식!」"
  },
  {
   "id": 15356,
   "key": "D0810al.txt:475",
   "file": "D0810al.txt",
   "line": 475,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「グッ……！」",
   "ko_candidate": "「큿…!」"
  },
  {
   "id": 15357,
   "key": "D0810al.txt:482",
   "file": "D0810al.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空からの掃射は続く。",
   "ko_candidate": "상공에서의 소사는 계속된다｡"
  },
  {
   "id": 15358,
   "key": "D0810al.txt:483",
   "file": "D0810al.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "状況は何一つとして、好転していない……！",
   "ko_candidate": "상황은 하나도 좋아지지 않고 있어…! 어떡하지?"
  },
  {
   "id": 15359,
   "key": "D0810al.txt:491",
   "file": "D0810al.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうする？　飛行能力の無いデモンベインでどうやって、上空の――あの高度の敵を迎え撃つ!?",
   "ko_candidate": "비행 능력이 없는 데몬베인으로 어떻게 상공의―― 저 고도의 적을 맞서 싸울 수 있을까!?"
  },
  {
   "id": 15360,
   "key": "D0810al.txt:496",
   "file": "D0810al.txt",
   "line": 496,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「右！　『水神クタアト』が来るぞ！」",
   "ko_candidate": "「오른쪽! 『수신 크타아트』가 온다!」"
  },
  {
   "id": 15361,
   "key": "D0810al.txt:500",
   "file": "D0810al.txt",
   "line": 500,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちぃぃぃぃ……ッッッ！」",
   "ko_candidate": "「치이이이이…!」"
  },
  {
   "id": 15362,
   "key": "D0810al.txt:509",
   "file": "D0810al.txt",
   "line": 509,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの招喚と２体のデウス・マキナの出現は、既に覇道財閥地下施設の管制室にも観測されていた。",
   "ko_candidate": "데몬베인의 소환과 2체의 데우스 마키나의 출현은 이미 하도 재벌 지하시설의 관제실에서도 관측되고 있었다｡"
  },
  {
   "id": 15363,
   "key": "D0810al.txt:510",
   "file": "D0810al.txt",
   "line": 510,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "現在、中央の巨大モニタには、苦戦するデモンベインの姿が映し出されている。",
   "ko_candidate": "현재､ 중앙의 거대한 모니터에는 고전하는 데몬베인의 모습이 비춰지고 있다｡"
  }
 ]
}