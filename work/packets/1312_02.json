  {
   "id": 35557,
   "key": "D1312ru.txt:316",
   "file": "D1312ru.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "さらに面倒なことが……",
