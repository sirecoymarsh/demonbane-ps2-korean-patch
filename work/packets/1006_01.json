  },
  {
   "id": 21641,
   "key": "D1006al.txt:130",
   "file": "D1006al.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今は逃げ延び、次なる力を得るそのときを待てと。",
   "ko_candidate": "지금은 도망쳐 살아남아､ 다음 힘을 얻을 그때를 기다리라고｡"
