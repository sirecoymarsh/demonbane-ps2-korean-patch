 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "クラウディウス": "클라우디우스",
  "カリグラ": "칼리굴라",
  "アンチクロス": "안티크로스",
  "ブラックロッジ": "블랙로지",
  "魔導書": "마도서",
  "九郎": "쿠로",
  "アル": "알"
 },
 "items": [
  {
   "id": 14702,
   "key": "D0809al.txt:1689",
   "file": "D0809al.txt",
   "line": 1689,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その中心。",
   "ko_candidate": "그 중심｡"
  },
  {
   "id": 14703,
   "key": "D0809al.txt:1691",
   "file": "D0809al.txt",
   "line": 1691,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒト型の紙束だったソレは、完全なヒトそのものとして顕現していた。",
   "ko_candidate": "인간형의 종이 뭉치였던 그것은､ 완전한 인간 그 자체로 현현하고 있었다｡"
  },
  {
   "id": 14704,
   "key": "D0809al.txt:1692",
   "file": "D0809al.txt",
   "line": 1692,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は魂を奪われたように、『彼女』を見つめ続けた。",
   "ko_candidate": "나는 영혼을 빼앗긴 듯이､ 『그녀』를 계속 바라보았다｡"
  },
  {
   "id": 14705,
   "key": "D0809al.txt:1699",
   "file": "D0809al.txt",
   "line": 1699,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女は、拘束されていた。",
   "ko_candidate": "그녀는､ 구속되어 있었다｡"
  },
  {
   "id": 14706,
   "key": "D0809al.txt:1701",
   "file": "D0809al.txt",
   "line": 1701,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界を覆う仮面。",
   "ko_candidate": "시야를 가리는 가면｡"
  },
  {
   "id": 14707,
   "key": "D0809al.txt:1702",
   "file": "D0809al.txt",
   "line": 1702,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "口には轡。",
   "ko_candidate": "입에는 재갈｡"
  },
  {
   "id": 14708,
   "key": "D0809al.txt:1703",
   "file": "D0809al.txt",
   "line": 1703,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身に纏うのは、皮で出来た拘束具。",
   "ko_candidate": "몸에 걸친 것은､ 가죽으로 만든 구속구｡"
  },
  {
   "id": 14709,
   "key": "D0809al.txt:1704",
   "file": "D0809al.txt",
   "line": 1704,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕と脚を拘束する枷。",
   "ko_candidate": "팔과 다리를 구속하는 족쇄｡"
  },
  {
   "id": 14710,
   "key": "D0809al.txt:1706",
   "file": "D0809al.txt",
   "line": 1706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "華奢な躰を、無慈悲にも縛する。",
   "ko_candidate": "가녀린 몸을､ 무자비하게도 묶는다｡"
  },
  {
   "id": 14711,
   "key": "D0809al.txt:1707",
   "file": "D0809al.txt",
   "line": 1707,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 14712,
   "key": "D0809al.txt:1713",
   "file": "D0809al.txt",
   "line": 1713,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ッッッッッッ!?」",
   "ko_candidate": "「츠츠츠츠츠츠!?」"
  },
  {
   "id": 14713,
   "key": "D0809al.txt:1718",
   "file": "D0809al.txt",
   "line": 1718,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、な、な――ッ!?」",
   "ko_candidate": "「뭐､ 뭐､ 뭐――엇!?」"
  },
  {
   "id": 14714,
   "key": "D0809al.txt:1722",
   "file": "D0809al.txt",
   "line": 1722,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらに２人は後ずさった。",
   "ko_candidate": "더욱 2명은 뒷걸음질 쳤다｡"
  },
  {
   "id": 14715,
   "key": "D0809al.txt:1723",
   "file": "D0809al.txt",
   "line": 1723,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "拘束された少女より、発せられるプレッシャー。",
   "ko_candidate": "구속된 소녀로부터､ 발산되는 프레셔｡"
  },
  {
   "id": 14716,
   "key": "D0809al.txt:1724",
   "file": "D0809al.txt",
   "line": 1724,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心臓が締め付けられるほどの、凄まじい威圧感だった。",
   "ko_candidate": "심장이 조여들 정도의､ 굉장한 위압감이었다｡"
  },
  {
   "id": 14717,
   "key": "D0809al.txt:1726",
   "file": "D0809al.txt",
   "line": 1726,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この小さな、華奢な躰の何処に、こんな力が――!?",
   "ko_candidate": "이 작고､ 가녀린 몸 어디에､ 이런 힘이――!?"
  },
  {
   "id": 14718,
   "key": "D0809al.txt:1731",
   "file": "D0809al.txt",
   "line": 1731,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何でだよ!?　どういうことだよ、おい！」",
   "ko_candidate": "「왜 그런 거야!? 어떻게 된 거야､ 이봐!」"
  },
  {
   "id": 14719,
   "key": "D0809al.txt:1737",
   "file": "D0809al.txt",
   "line": 1737,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………っっっ」",
   "ko_candidate": "「…………츠츠츠」"
  },
  {
   "id": 14720,
   "key": "D0809al.txt:1741",
   "file": "D0809al.txt",
   "line": 1741,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスとカリグラはすっかり取り乱していた。",
   "ko_candidate": "클라우디우스와 칼리굴라는 완전히 당황하고 있었다｡"
  },
  {
   "id": 14721,
   "key": "D0809al.txt:1742",
   "file": "D0809al.txt",
   "line": 1742,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この２人を――『ブラックロッジ』の幹部たるアンチクロスをここまで、怯ませる、この少女は何者だ？",
   "ko_candidate": "이 두 사람을――『블랙로지』의 간부인 안티 크로스를 이 정도로､ 주눅 들게 하는､ 이 소녀는 누구지?"
  },
  {
   "id": 14722,
   "key": "D0809al.txt:1744",
   "file": "D0809al.txt",
   "line": 1744,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが叫んだ。",
   "ko_candidate": "클라우디우스가 외쳤다｡"
  },
  {
   "id": 14723,
   "key": "D0809al.txt:1750",
   "file": "D0809al.txt",
   "line": 1750,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――『暴君』っっっっ！」",
   "ko_candidate": "「――『폭군』!」"
  },
  {
   "id": 14724,
   "key": "D0809al.txt:1755",
   "file": "D0809al.txt",
   "line": 1755,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……『暴君』？」",
   "ko_candidate": "「……『폭군』?」"
  },
  {
   "id": 14725,
   "key": "D0809al.txt:1757",
   "file": "D0809al.txt",
   "line": 1757,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この少女のことなのか？",
   "ko_candidate": "이 소녀를 말하는 건가?"
  },
  {
   "id": 14726,
   "key": "D0809al.txt:1758",
   "file": "D0809al.txt",
   "line": 1758,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女は何も答えない……と言うより、轡を噛まされては、答えられるはずがない。",
   "ko_candidate": "소녀는 아무 대답도 하지 않는다……라기보다는､ 재갈을 물려서는､ 대답할 수가 없다｡"
  },
  {
   "id": 14727,
   "key": "D0809al.txt:1760",
   "file": "D0809al.txt",
   "line": 1760,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ緩慢な動作で、その両腕を持ち上げて――",
   "ko_candidate": "다만 느릿한 동작으로､ 그 양팔을 들어 올리고――"
  },
  {
   "id": 14728,
   "key": "D0809al.txt:1765",
   "file": "D0809al.txt",
   "line": 1765,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「させルかっ！」",
   "ko_candidate": "「시킬 리가 없어!」"
  },
  {
   "id": 14729,
   "key": "D0809al.txt:1776",
   "file": "D0809al.txt",
   "line": 1776,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラが拳を振るう。",
   "ko_candidate": "칼리굴라가 주먹을 휘두른다｡"
  },
  {
   "id": 14730,
   "key": "D0809al.txt:1784",
   "file": "D0809al.txt",
   "line": 1784,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "追ってクラウディウスが風の刃を放つ。",
   "ko_candidate": "뒤이어 클라우디우스가 바람의 칼날을 날린다｡"
  },
  {
   "id": 14731,
   "key": "D0809al.txt:1790",
   "file": "D0809al.txt",
   "line": 1790,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆撃と斬撃が少女を襲う。轡を填めた口元が、ニィィィッ……と不敵に歪んだように見えた。",
   "ko_candidate": "폭격과 참격이 소녀를 덮친다｡ 재갈을 물린 입가가､ 니이이이잇……하고 뻔뻔하게 일그러진 것처럼 보였다｡"
  },
  {
   "id": 14732,
   "key": "D0809al.txt:1795",
   "file": "D0809al.txt",
   "line": 1795,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの衝撃が炸裂した。",
   "ko_candidate": "두 개의 충격이 터졌다｡"
  },
  {
   "id": 14733,
   "key": "D0809al.txt:1799",
   "file": "D0809al.txt",
   "line": 1799,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」 팟､ 붉은 꽃이､ 피었다｡"
  },
  {
   "id": 14734,
   "key": "D0809al.txt:1801",
   "file": "D0809al.txt",
   "line": 1801,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ぱっと、紅い華が、咲いた。 迸る血飛沫。",
   "ko_candidate": "칼리굴라의 주먹이 소녀의 반신을 날려버렸다｡"
  },
  {
   "id": 14735,
   "key": "D0809al.txt:1803",
   "file": "D0809al.txt",
   "line": 1803,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それは俺たちを濡らす前に――",
   "ko_candidate": "클라우디우스의 바람이 소녀의 목을 베어냈다｡"
  },
  {
   "id": 14736,
   "key": "D0809al.txt:1813",
   "file": "D0809al.txt",
   "line": 1813,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "解けた。",
   "ko_candidate": "튀어 오르는 피보라｡"
  },
  {
   "id": 14737,
   "key": "D0809al.txt:1816",
   "file": "D0809al.txt",
   "line": 1816,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "崩れ落ちる躰が、噴き出る鮮血が、全部全部、魔導書の頁となってばらけていく。",
   "ko_candidate": "하지만､ 그것은 우리를 적시기 전에―― 풀어졌다｡"
  },
  {
   "id": 14738,
   "key": "D0809al.txt:1819",
   "file": "D0809al.txt",
   "line": 1819,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怪異はそれだけに留まらなかった。",
   "ko_candidate": "공중에 떠 있는 머리가､ 무너져 내리는 몸이､"
  },
  {
   "id": 14739,
   "key": "D0809al.txt:1824",
   "file": "D0809al.txt",
   "line": 1824,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「え――？　あ――痛……ぅぅっ!?」",
   "ko_candidate": "솟구치는 선혈이､ 전부､ 전부､ 마도서의 페이지가 되어､ 흩어져 간다｡"
  },
  {
   "id": 14740,
   "key": "D0809al.txt:1829",
   "file": "D0809al.txt",
   "line": 1829,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎!?　どうした!?」",
   "ko_candidate": "괴이는 그것뿐만이 아니었다｡ 「어――? 아――아파……우웃!?」"
  },
  {
   "id": 14741,
   "key": "D0809al.txt:1833",
   "file": "D0809al.txt",
   "line": 1833,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "手を押さえてしゃがみ込む俺を見て、アルが焦った。",
   "ko_candidate": "「쿠로!? 왜 그래!?」 손을 누르며 쪼그리고 앉는 나를 보고､ 알이 당황했다｡"
  }
 ]
}