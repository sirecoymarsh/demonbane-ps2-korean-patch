 "items": [
  {
   "id": 6488,
   "key": "D0507.txt:471",
   "file": "D0507.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "分からないが――",
   "ko_candidate": "이유는 모르겠다｡"
  },
  {
   "id": 6489,
   "key": "D0507.txt:491",
   "file": "D0507.txt",
   "line": 491,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やべぇ！　エルザッ！」",
   "ko_candidate": "모르겠지만― 「위험해! 엘자!」"
  },
  {
   "id": 6490,
   "key": "D0507.txt:498",
   "file": "D0507.txt",
   "line": 498,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「!?」",
   "ko_candidate": "「!?」"
  },
  {
   "id": 6491,
   "key": "D0507.txt:521",
   "file": "D0507.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "回転する偃月刀が鏡となってビームを跳ね返した！",
   "ko_candidate": "언월도는 날의 등을 이쪽으로 향하고 있었다｡"
  },
  {
   "id": 6492,
   "key": "D0507.txt:522",
   "file": "D0507.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "反転したビームは今度は逆にエルザに迫る！",
   "ko_candidate": "등으로 빔을 받아낸다… 받아내고 있어!?"
  },
  {
   "id": 6493,
   "key": "D0507.txt:525",
   "file": "D0507.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "くそッ……そういう魂胆か！ ――間に合うか!?",
   "ko_candidate": "받아낸 빔은 그대로 엘자를 향해 튕겨 나갔다｡ 그런 속셈이었나! 칫､ 늦지 않을까!?"
  },
  {
   "id": 6494,
   "key": "D0507.txt:542",
   "file": "D0507.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "紙一重、エルザを抱きかかえて飛ぶ。",
   "ko_candidate": "아슬아슬하게 엘자를 끌어안고 날아오른다｡"
  },
  {
   "id": 6495,
   "key": "D0507.txt:543",
   "file": "D0507.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ビームの熱がチリチリと肌を焼くのが感じられた。",
   "ko_candidate": "측면에서 오는 열풍이 지지직 살갗을 태우는 게 느껴졌다｡"
  },
  {
   "id": 6496,
   "key": "D0507.txt:560",
   "file": "D0507.txt",
   "line": 560,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "安堵する暇もなく、空気を裂く偃月刀の音がすぐそこに迫っている。 「離すぞ！」",
   "ko_candidate": "빔에서 벗어난 것에 안도할 틈도 없이 언월도가 공기를 가르는 소리가 바로 코앞까지 다가왔다｡"
  },
  {
   "id": 6497,
   "key": "D0507.txt:571",
   "file": "D0507.txt",
   "line": 571,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「了解ロボ！」",
   "ko_candidate": "「놓을게!」"
  },
  {
   "id": 6498,
   "key": "D0507.txt:581",
   "file": "D0507.txt",
   "line": 581,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "お互い、弾け合うように分かれる。",
   "ko_candidate": "「알겠로봇!」 서로 튕겨 나가듯 갈라진다｡"
  },
  {
   "id": 6499,
   "key": "D0507.txt:582",
   "file": "D0507.txt",
   "line": 582,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "２人の間を偃月刀が通り過ぎていった。 エルザが片膝を突いて着地する。",
   "ko_candidate": "우리 사이를 언월도가 지나갔다｡ 잘린 머리카락 몇 가닥이 바람에 실려 흘러간다｡"
  },
  {
   "id": 6500,
   "key": "D0507.txt:599",
   "file": "D0507.txt",
   "line": 599,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺もマギウス・ウィングを羽ばたかせて、地面に舞い降りた。",
   "ko_candidate": "엘자가 한쪽 무릎을 꿇고 착지한다｡ 나도 마기우스 윙을 펄럭이며 지면에 내려앉았다｡"
  },
  {
   "id": 6501,
   "key": "D0507.txt:605",
   "file": "D0507.txt",
   "line": 605,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「また助けたのか…… 何を考えておる？」",
   "ko_candidate": "「또 도와준 건가… 무슨 생각이지?」"
  },
  {
   "id": 6502,
   "key": "D0507.txt:611",
   "file": "D0507.txt",
   "line": 611,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いや、さすがに見殺しは後味悪ィだろ」",
   "ko_candidate": "「아니､ 아무래도 그냥 죽게 내버려 두면 찜찜하잖아」"
  },
  {
   "id": 6503,
   "key": "D0507.txt:620",
   "file": "D0507.txt",
   "line": 620,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「助かったロボ、マイ・ダーリン」",
   "ko_candidate": "「살았로봇､ 마이 달링」 「갑자기 격상이냐!?」"
  },
  {
   "id": 6504,
   "key": "D0507.txt:628",
   "file": "D0507.txt",
   "line": 628,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「一気に格上げかよ!?」",
   "ko_candidate": "「수렁이군」 그때였다｡"
  },
  {
   "id": 6505,
   "key": "D0507.txt:633",
   "file": "D0507.txt",
   "line": 633,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「泥沼だな」",
   "ko_candidate": "「…………앗」"
  },
  {
   "id": 6506,
   "key": "D0507.txt:654",
   "file": "D0507.txt",
   "line": 654,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそ……もう戻って来やがった！ こっちこそ泥沼だっ！」",
   "ko_candidate": "파르르､ 하고― 언월도에 잘린 모양인지 엘자의 옷 가슴팍이 찢어졌다｡ 옷 사이로 흘러나오는 형 좋은 가슴과 복숭아색 돌기｡"
  },
  {
   "id": 6507,
   "key": "D0507.txt:671",
   "file": "D0507.txt",
   "line": 671,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "慌てて軌道上から飛び退く。",
   "ko_candidate": "…장내가 얼어붙었다｡ 「…………………」"
  },
  {
   "id": 6508,
   "key": "D0507.txt:672",
   "file": "D0507.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "すぐ横を偃月刀が通り過ぎていく――はずだった。",
   "ko_candidate": "「…………………」 「살갗까지 드러냈다면 이제 변명은 허용하지 않로봇｡ 책임지로봇」"
  },
  {
   "id": 6509,
   "key": "D0507.txt:687",
   "file": "D0507.txt",
   "line": 687,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "偃月刀は回転したまま、目の前で止まった。",
   "ko_candidate": "「이 세상에 신은 없어어어어어!」 「…수렁이군」"
  },
  {
   "id": 6510,
   "key": "D0507.txt:690",
   "file": "D0507.txt",
   "line": 690,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……何だ、これ？ 何かが今までと違う。",
   "ko_candidate": "「젠장… 또 돌아왔잖아! 이쪽이야말로 수렁이라고!」"
  },
  {
   "id": 6511,
   "key": "D0507.txt:693",
   "file": "D0507.txt",
   "line": 693,
   "speaker": "ちびアル",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これは―― 「しまった！　逆回転か！」",
   "ko_candidate": "언월도의 궤도에서 황급히 날아 물러난다｡"
  },
  {
   "id": 6512,
   "key": "D0507.txt:716",
   "file": "D0507.txt",
   "line": 716,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "逆回転で無理矢理に軌道を変えやがった！",
   "ko_candidate": "우리 앞을 언월도가 또 지나가려고 한다 ― 줄 알았다｡"
  },
  {
   "id": 6513,
   "key": "D0507.txt:717",
   "file": "D0507.txt",
   "line": 717,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "かわせる距離ではない。",
   "ko_candidate": "언월도는 눈앞에서 회전한 채로 멈춰 있다｡"
  },
  {
   "id": 6514,
   "key": "D0507.txt:718",
   "file": "D0507.txt",
   "line": 718,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "偃月刀の一撃が脇腹に決まる。",
   "ko_candidate": "하지만 뭔가가 지금까지와 다르다… 이건｡"
  },
  {
   "id": 6515,
   "key": "D0507.txt:736",
   "file": "D0507.txt",
   "line": 736,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐっ……！」",
   "ko_candidate": "「아차! 역회전이잖아!」"
  },
  {
   "id": 6516,
   "key": "D0507.txt:739",
   "file": "D0507.txt",
   "line": 739,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "逆回転だったので、刃ではなく峰打ちだったのが幸いだった。だが偃月刀はその場ですぐに反転し、袈裟斬りにしようと俺の肩口を狙う！",
   "ko_candidate": "우리 바로 앞에서 역회전함으로써 무리하게 궤도를 바꿔 왔잖아! 피할 거리가 아니다｡ 언월도의 일격이 옆구리에 꽂힌다｡ 「으윽…!」"
  },
  {
   "id": 6517,
   "key": "D0507.txt:758",
   "file": "D0507.txt",
   "line": 758,
   "speaker": "エルザ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大十字九郎！」 「なぁぁぁぁぁめるなあ！」",
   "ko_candidate": "역회전이었기에 칼날이 아닌 등으로 맞은 게 다행이었다｡"
  },
  {
   "id": 6519,
   "key": "D0507.txt:784",
   "file": "D0507.txt",
   "line": 784,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「なっ……!?」",
   "ko_candidate": "「다이쥬지 쿠로!」"
  },
  {
   "id": 6520,
   "key": "D0507.txt:796",
   "file": "D0507.txt",
   "line": 796,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "刃は肩の数センチ上でギリギリ止まっていた。",
   "ko_candidate": "「얕보지 마아아아아!」 「뭐…!?」"
  },
  {
   "id": 6521,
   "key": "D0507.txt:799",
   "file": "D0507.txt",
   "line": 799,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は刀を『合掌』の形で挟んでいる――真剣白刃取りというやつだ。",
   "ko_candidate": "칼날은 어깨 몇 센티 위에서 간신히 멈췄다｡ 나는 칼날을 『합장』 형태로 끼워 넣고 있다――진검백인취라는 거다｡"
  },
  {
   "id": 6522,
   "key": "D0507.txt:802",
   "file": "D0507.txt",
   "line": 802,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "危なかった……。 失敗していたら、完全に御陀仏だった。",
   "ko_candidate": "위험했어… 실패했다면 완전히 끝장났을 뻔했다｡"
  },
  {
   "id": 6523,
   "key": "D0507.txt:809",
   "file": "D0507.txt",
   "line": 809,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「今までの借りだ。とっておけ！」",
   "ko_candidate": "「지금까지의 빚이다｡ 받아라!」 칼날을 끼운 양손에 마력을 집중시킨다｡"
  },
  {
   "id": 6524,
   "key": "D0507.txt:823",
   "file": "D0507.txt",
   "line": 823,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "刀身を挟む両掌に魔力を集中させる。",
   "ko_candidate": "날카로운 소리를 내며 언월도가 산산조각 났다｡"
  },
  {
   "id": 6525,
   "key": "D0507.txt:849",
   "file": "D0507.txt",
   "line": 849,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "甲高い音を立てて、偃月刀は砕け散った。",
   "ko_candidate": "부서진 파편은 칼로서의 형태를 잃고 본래의 모습인 종이 조각으로 돌아간다｡"
  },
  {
   "id": 6526,
   "key": "D0507.txt:850",
   "file": "D0507.txt",
   "line": 850,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "刀の破片は本来の姿である紙切れへと戻る。",
   "ko_candidate": "종이 조각은 바람을 타고 우리 주위를 떠다녔다｡"
  },
  {
   "id": 6527,
   "key": "D0507.txt:851",
   "file": "D0507.txt",
   "line": 851,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "紙片は風に乗り、俺たちの周りを漂っていた。",
   "ko_candidate": "「정말 무모한 짓을 하는군」 「역시 식은땀 날 정도였어｡ 하지만 이걸로 이번엔 정말 회수 완료다」"
  },
  {
   "id": 6528,
   "key": "D0507.txt:865",
   "file": "D0507.txt",
   "line": 865,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まったく無茶をしおる」",
   "ko_candidate": "「음」 알이 주문을 외운다｡"
  }
 ]
}