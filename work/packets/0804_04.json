   "line": 148,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な……大十字さんっ!?」",
   "ko_candidate": "「뭐……다이쥬지 씨!?」"
  },
  {
   "id": 12947,
   "key": "D0804ru.txt:153",
