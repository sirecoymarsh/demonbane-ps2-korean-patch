 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アトラック＝ナチャ": "아틀락 나차",
  "術式": "술식",
  "クトゥグア": "크투가",
  "魔導書": "마도서",
  "ネクロノミコン": "네크로노미콘",
  "アーミティッジ": "아미티지",
  "姫さん": "공주님"
 },
 "items": [
  {
   "id": 49266,
   "key": "ep_al01.txt:1080",
   "file": "ep_al01.txt",
   "line": 1080,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "気配は其処から発せられていた。",
   "ko_candidate": "기척은 거기서 발산되고 있었다｡"
  },
  {
   "id": 49267,
   "key": "ep_al01.txt:1085",
   "file": "ep_al01.txt",
   "line": 1085,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頭上を覆い尽くす夜の闇に、ぼんやりと白く、女の躰が浮かび上がっていた。",
   "ko_candidate": "머리 위를 뒤덮은 밤의 어둠에､ 희미하게 하얗게､ 여자의 몸이 떠오르고 있었다｡"
  },
  {
   "id": 49268,
   "key": "ep_al01.txt:1085",
   "file": "ep_al01.txt",
   "line": 1085,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は、その女を知っている。",
   "ko_candidate": "나는､ 그 여자를 알고 있다｡"
  },
  {
   "id": 49269,
   "key": "ep_al01.txt:1088",
   "file": "ep_al01.txt",
   "line": 1088,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………！　何でお前が!?」",
   "ko_candidate": "「…………! 왜 네가!?」"
  },
  {
   "id": 49270,
   "key": "ep_al01.txt:1090",
   "file": "ep_al01.txt",
   "line": 1090,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "蜘蛛そのものの格好で巣にへばりついた女。",
   "ko_candidate": "거미 그 자체의 모습으로 거미줄에 달라붙은 여자｡"
  },
  {
   "id": 49271,
   "key": "ep_al01.txt:1091",
   "file": "ep_al01.txt",
   "line": 1091,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の顔を見て、笑う。",
   "ko_candidate": "내 얼굴을 보고､ 웃는다｡"
  },
  {
   "id": 49272,
   "key": "ep_al01.txt:1095",
   "file": "ep_al01.txt",
   "line": 1095,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "跳んで、俺の目の前に着地した。",
   "ko_candidate": "뛰어､ 내 눈앞에 착지했다｡"
  },
  {
   "id": 49273,
   "key": "ep_al01.txt:1096",
   "file": "ep_al01.txt",
   "line": 1096,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "くすくすと妖艶に笑いながら、女は舌なめずりした。",
   "ko_candidate": "키득키득 요염하게 웃으며､ 여자는 혀를 날름거렸다｡"
  },
  {
   "id": 49274,
   "key": "ep_al01.txt:1099",
   "file": "ep_al01.txt",
   "line": 1099,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アトラック＝ナチャ!?」",
   "ko_candidate": "「아틀락 나챠!?」"
  },
  {
   "id": 49275,
   "key": "ep_al01.txt:1101",
   "file": "ep_al01.txt",
   "line": 1101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "蜘蛛の化身が吼えた。",
   "ko_candidate": "거미의 화신이 포효했다｡"
  },
  {
   "id": 49276,
   "key": "ep_al01.txt:1108",
   "file": "ep_al01.txt",
   "line": 1108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "女の皮が裂け、その下から異形の姿が膨れ上がる。",
   "ko_candidate": "여자의 피부가 찢어지고､ 그 아래에서 기괴한 모습이 부풀어 오른다｡"
  },
  {
   "id": 49277,
   "key": "ep_al01.txt:1109",
   "file": "ep_al01.txt",
   "line": 1109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ヒトとクモの中間に位置する、怪物の本性を顕す。",
   "ko_candidate": "인간과 거미의 중간에 위치한､ 괴물의 본성을 드러낸다｡"
  },
  {
   "id": 49278,
   "key": "ep_al01.txt:1114",
   "file": "ep_al01.txt",
   "line": 1114,
   "speaker": "アトラック＝ナチャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シャアアアアアアア――ッ！」",
   "ko_candidate": "「샤아아아아아아――앗!」"
  },
  {
   "id": 49279,
   "key": "ep_al01.txt:1117",
   "file": "ep_al01.txt",
   "line": 1117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "咆吼と共に、顎を開け、牙を晒し、動けない俺に襲い掛かってくる！",
   "ko_candidate": "포효와 함께､ 턱을 벌리고､ 이빨을 드러내며､ 움직일 수 없는 나에게 덮쳐온다!"
  },
  {
   "id": 49280,
   "key": "ep_al01.txt:1120",
   "file": "ep_al01.txt",
   "line": 1120,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くっ……嘗めるなァァァァ！」",
   "ko_candidate": "「크윽……얕보지 마아아아아!」"
  },
  {
   "id": 49281,
   "key": "ep_al01.txt:1125",
   "file": "ep_al01.txt",
   "line": 1125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は――術式を疾らせる。",
   "ko_candidate": "나는――술식을 재촉한다｡"
  },
  {
   "id": 49282,
   "key": "ep_al01.txt:1132",
   "file": "ep_al01.txt",
   "line": 1132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺を拘束する蜘蛛の巣が、一瞬で、燃え尽きた。",
   "ko_candidate": "나를 구속하는 거미줄이 순식간에 타버렸다｡"
  },
  {
   "id": 49283,
   "key": "ep_al01.txt:1138",
   "file": "ep_al01.txt",
   "line": 1138,
   "speaker": "アトラック＝ナチャ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 49284,
   "key": "ep_al01.txt:1149",
   "file": "ep_al01.txt",
   "line": 1149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自由になった手で、クトゥグアを引き抜く。",
   "ko_candidate": "자유로워진 손으로 크투가를 뽑아든다｡"
  },
  {
   "id": 49285,
   "key": "ep_al01.txt:1150",
   "file": "ep_al01.txt",
   "line": 1150,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "躊躇うことなく、撃った。",
   "ko_candidate": "주저 없이 쏘았다｡"
  },
  {
   "id": 49286,
   "key": "ep_al01.txt:1162",
   "file": "ep_al01.txt",
   "line": 1162,
   "speaker": "アトラック＝ナチャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ギャアアアアアアアアアアア！」",
   "ko_candidate": "「꺄아아아아아아아아아아!」"
  },
  {
   "id": 49287,
   "key": "ep_al01.txt:1165",
   "file": "ep_al01.txt",
   "line": 1165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "断末魔の咆吼。",
   "ko_candidate": "단말마의 포효｡"
  },
  {
   "id": 49288,
   "key": "ep_al01.txt:1166",
   "file": "ep_al01.txt",
   "line": 1166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "クトゥグアの弾丸は、アトラック＝ナチャの身体を爆発で吹き飛ばし、デカい風穴を開けた。",
   "ko_candidate": "크투가의 탄환은 아틀락 나챠의 몸을 폭발로 날려버리고 커다란 구멍을 뚫었다｡"
  },
  {
   "id": 49289,
   "key": "ep_al01.txt:1173",
   "file": "ep_al01.txt",
   "line": 1173,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「魔術が使えないと思ったら、大間違いだぜ？」",
   "ko_candidate": "「마술을 쓸 수 없다고 생각했다면､ 큰 오산이야?」"
  },
  {
   "id": 49290,
   "key": "ep_al01.txt:1181",
   "file": "ep_al01.txt",
   "line": 1181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "懐から一冊の魔導書を取り出す。",
   "ko_candidate": "품에서 한 권의 마도서를 꺼낸다｡"
  },
  {
   "id": 49291,
   "key": "ep_al01.txt:1182",
   "file": "ep_al01.txt",
   "line": 1182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "昨夜も教本代わりに読んでいた本……『ネクロノミコン新釈』だ。",
   "ko_candidate": "어젯밤에도 교본 대신 읽고 있던 책……『네크로노미콘 신석』이다｡"
  },
  {
   "id": 49292,
   "key": "ep_al01.txt:1184",
   "file": "ep_al01.txt",
   "line": 1184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "信頼に足る内容とは言い難いが、これも立派に魔導書の一つ。",
   "ko_candidate": "신뢰할 만한 내용이라고 하기는 어렵지만､ 이것도 엄연히 마도서의 하나｡"
  },
  {
   "id": 49293,
   "key": "ep_al01.txt:1185",
   "file": "ep_al01.txt",
   "line": 1185,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アーミティッジの爺さんから譲ってもらったばかりだが……早速、役に立った。",
   "ko_candidate": "아미티지 할아버지에게 막 받은 것이지만…… 바로 쓸모가 있었다｡"
  },
  {
   "id": 49294,
   "key": "ep_al01.txt:1192",
   "file": "ep_al01.txt",
   "line": 1192,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だけど……やっぱり、こいつら」",
   "ko_candidate": "「하지만……역시､ 이놈들」"
  },
  {
   "id": 49295,
   "key": "ep_al01.txt:1196",
   "file": "ep_al01.txt",
   "line": 1196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の目の前で、アトラック＝ナチャの容が崩れた。",
   "ko_candidate": "내 눈앞에서 아틀락 나챠의 모습이 무너졌다｡"
  },
  {
   "id": 49296,
   "key": "ep_al01.txt:1197",
   "file": "ep_al01.txt",
   "line": 1197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "全身が無数の紙片になって、解けていく。",
   "ko_candidate": "온몸이 무수한 종이 조각이 되어 녹아내린다｡"
  },
  {
   "id": 49297,
   "key": "ep_al01.txt:1198",
   "file": "ep_al01.txt",
   "line": 1198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "崩れ落ち、残ったのは風に舞う紙片――魔導書の断片だけだ。",
   "ko_candidate": "무너져 내리고 남은 것은 바람에 날리는 종이 조각――마도서의 파편뿐이다｡"
  },
  {
   "id": 49298,
   "key": "ep_al01.txt:1200",
   "file": "ep_al01.txt",
   "line": 1200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その光景に俺は、もやもやとした胸騒ぎのようなものが、少しずつ形になっていくのを感じていた。",
   "ko_candidate": "그 광경에 나는 모호한 불안감 같은 것이 조금씩 형태를 갖춰가는 것을 느끼고 있었다｡"
  },
  {
   "id": 49299,
   "key": "ep_al01.txt:1201",
   "file": "ep_al01.txt",
   "line": 1201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "姫さんの依頼を聴いたときの、何か引っかかるような感じ。",
   "ko_candidate": "공주님의 의뢰를 들었을 때의､ 뭔가 걸리는 듯한 느낌｡"
  },
  {
   "id": 49300,
   "key": "ep_al01.txt:1202",
   "file": "ep_al01.txt",
   "line": 1202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その正体が、すぐそこにある。",
   "ko_candidate": "그 정체가 바로 거기에 있다｡"
  },
  {
   "id": 49301,
   "key": "ep_al01.txt:1205",
   "file": "ep_al01.txt",
   "line": 1205,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 49302,
   "key": "ep_al01.txt:1207",
   "file": "ep_al01.txt",
   "line": 1207,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "舞い散る魔導書のページに手を伸ばした。 そのとき――",
   "ko_candidate": "흩날리는 마도서의 페이지에 손을 뻗었다｡"
  },
  {
   "id": 49303,
   "key": "ep_al01.txt:1211",
   "file": "ep_al01.txt",
   "line": 1211,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッッ！」",
   "ko_candidate": "그때―― 「――――읏!」"
  },
  {
   "id": 49304,
   "key": "ep_al01.txt:1221",
   "file": "ep_al01.txt",
   "line": 1221,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "飛び退くと同時、真上から襲いかかって来た気配に向けて、クトゥグアを発砲する。",
   "ko_candidate": "뛰어 물러나는 동시에 바로 위에서 덮쳐오는 기척을 향해､ 크투가를 발포한다｡"
  },
  {
   "id": 49305,
   "key": "ep_al01.txt:1234",
   "file": "ep_al01.txt",
   "line": 1234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "またしても断末魔が、無人の路地に響き渡った。",
   "ko_candidate": "또다시 단말마가 무인의 골목에 울려 퍼졌다｡"
  }
 ]
}