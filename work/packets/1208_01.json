 },
 "items": [
  {
   "id": 28359,
   "key": "D1208al.txt:154",
   "file": "D1208al.txt",
   "line": 154,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ここかぁぁぁぁぁぁぁ！」",
   "ko_candidate": "「여기구나아아아아아아!」"
  },
  {
   "id": 28360,
   "key": "D1208al.txt:161",
   "file": "D1208al.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゲートをくぐると、やたら開けた場所に出た。",
   "ko_candidate": "게이트를 지나자 유난히 넓은 곳으로 나왔다｡"
  },
  {
   "id": 28361,
   "key": "D1208al.txt:162",
   "file": "D1208al.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "間違いない。",
   "ko_candidate": "틀림없다｡"
  },
  {
   "id": 28362,
   "key": "D1208al.txt:163",
   "file": "D1208al.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ここがデモンベインの格納庫だ。",
   "ko_candidate": "여기가 데몬베인의 격납고다｡"
  },
  {
   "id": 28363,
   "key": "D1208al.txt:169",
   "file": "D1208al.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見渡すまでもなかった。",
   "ko_candidate": "둘러볼 필요도 없었다｡"
  },
  {
   "id": 28364,
   "key": "D1208al.txt:170",
   "file": "D1208al.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ちょうど目の前、固定されたデモンベインが聳え立っている！",
   "ko_candidate": "바로 눈앞에 고정된 데몬베인이 우뚝 서 있다!"
  },
  {
   "id": 28365,
   "key": "D1208al.txt:174",
   "file": "D1208al.txt",
   "line": 174,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ゲェーヒャハハハハハハハッ！　ボクの勝ちだ、 大十字九郎――――ッ！」",
   "ko_candidate": "「게에히야하하하하하하핫! 내가 이겼다､ 다이쥬지 쿠로――――!」"
  },
  {
   "id": 28366,
   "key": "D1208al.txt:187",
   "file": "D1208al.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "より一層、強固な風の結界を纏わせ、一気に飛翔する。",
   "ko_candidate": "더욱 강력한 바람의 결계를 두르고 단숨에 날아오른다｡"
  },
  {
   "id": 28367,
   "key": "D1208al.txt:188",
   "file": "D1208al.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "胸のところにあるコクピット――こいつを破壊すれば、終わりだ！",
   "ko_candidate": "가슴 부분에 있는 콕핏――이걸 파괴하면 끝이다!"
  },
  {
   "id": 28368,
   "key": "D1208al.txt:192",
   "file": "D1208al.txt",
   "line": 192,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「せいぜい悔しがれ！ 肥だめ野郎っっっっ！」",
   "ko_candidate": "「실컷 분해하라고! 거름통 자식!」"
  },
  {
   "id": 28369,
   "key": "D1208al.txt:200",
   "file": "D1208al.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが勝ち誇った、そのときだった。",
   "ko_candidate": "클라우디우스가 승리를 확신한 그때였다｡"
  },
  {
   "id": 28370,
   "key": "D1208al.txt:201",
   "file": "D1208al.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインのコクピットが、独りでに開いた。",
   "ko_candidate": "데몬베인의 콕핏이 저절로 열렸다｡"
  },
  {
   "id": 28371,
   "key": "D1208al.txt:207",
   "file": "D1208al.txt",
   "line": 207,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 28372,
   "key": "D1208al.txt:212",
   "file": "D1208al.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットの中、見知った顔がいる――と思ったときには、遅かった。",
   "ko_candidate": "콕핏 안에 익숙한 얼굴이 있다――고 생각했을 때는 이미 늦었다｡"
  },
  {
   "id": 28373,
   "key": "D1208al.txt:213",
   "file": "D1208al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そいつが不敵な笑みを浮かべる。",
   "ko_candidate": "그자가 뻔뻔한 미소를 짓는다｡"
  },
  {
   "id": 28374,
   "key": "D1208al.txt:215",
   "file": "D1208al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肩には、ごっついギターケースを構えて。",
   "ko_candidate": "어깨에는 거대한 기타 케이스를 들고｡"
  },
  {
   "id": 28375,
   "key": "D1208al.txt:222",
   "file": "D1208al.txt",
   "line": 222,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ようこそ、 我輩のスウィートルームへ…… レッツ・プレイ」",
   "ko_candidate": "「어서 오시게､ 내 스위트룸으로…… 레츠 플레이」"
  },
  {
   "id": 28376,
   "key": "D1208al.txt:235",
   "file": "D1208al.txt",
   "line": 235,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「て、てめぇ……ぐわあああああああああああああッ！」",
   "ko_candidate": "「네､ 네 녀석……꺄아아아아아아아아아아아아앗!」"
  },
  {
   "id": 28377,
   "key": "D1208al.txt:245",
   "file": "D1208al.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ギターケースからロケット弾が発射された。",
   "ko_candidate": "기타 케이스에서 로켓탄이 발사되었다｡"
  },
  {
   "id": 28378,
   "key": "D1208al.txt:246",
   "file": "D1208al.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "真正面からの直撃を喰らい、 クラウディウスは宙を飛ぶ。",
   "ko_candidate": "정면에서 직격탄을 맞고 클라우디우스는 허공을 날아간다｡"
  },
  {
   "id": 28379,
   "key": "D1208al.txt:255",
   "file": "D1208al.txt",
   "line": 255,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっそぉぉぉぉぉぉぉ！ 裏切り者がぁぁぁぁぁぁぁぁ！」 爆炎に包まれながらも、",
   "ko_candidate": "「젠장아아아아아아! 배신자 자식아아아아아아아!」"
  },
  {
   "id": 28380,
   "key": "D1208al.txt:261",
   "file": "D1208al.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラウディウスは手に持ったヨーヨーを放とうとする。 ヨーヨーに集中する破壊の魔力。",
   "ko_candidate": "폭염에 휩싸인 채로도 클라우디우스는 손에 든 요요를 던지려 한다｡ 요요에 집중되는 파괴의 마력｡"
  },
  {
   "id": 28381,
   "key": "D1208al.txt:266",
   "file": "D1208al.txt",
   "line": 266,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うおおおっ？ ヤバイであるかな？」",
   "ko_candidate": "「우와아? 위험한 것인가?」"
  },
  {
   "id": 28382,
   "key": "D1208al.txt:271",
   "file": "D1208al.txt",
   "line": 271,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「死――――！」",
   "ko_candidate": "「죽어――――!」"
  },
  {
   "id": 28383,
   "key": "D1208al.txt:280",
   "file": "D1208al.txt",
   "line": 280,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「我、埋葬にあたわず！」",
   "ko_candidate": "「나､ 매장할 수 없노라!」"
  },
  {
   "id": 28384,
   "key": "D1208al.txt:293",
   "file": "D1208al.txt",
   "line": 293,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐがああああああああああああああッッッ！」",
   "ko_candidate": "「꾸가아아아아아아아아아아아아아아앗!」"
  },
  {
   "id": 28385,
   "key": "D1208al.txt:305",
   "file": "D1208al.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――ギリギリのところで間に合った！",
   "ko_candidate": "――아슬아슬하게 간신히 막았다!"
  },
  {
   "id": 28386,
   "key": "D1208al.txt:307",
   "file": "D1208al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザの魔砲がクラウディウスを撃ち落とす。",
   "ko_candidate": "엘자의 마포가 클라우디우스를 격추시킨다｡"
  },
  {
   "id": 28387,
   "key": "D1208al.txt:308",
   "file": "D1208al.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎と雷光に巻かれ、クラウディウスはもがき苦しむ。",
   "ko_candidate": "폭염과 번개에 휩싸여 클라우디우스는 몸부림친다｡"
  },
  {
   "id": 28388,
   "key": "D1208al.txt:312",
   "file": "D1208al.txt",
   "line": 312,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度こそトドメだ！」",
   "ko_candidate": "「이번엔 진짜 마지막이다!」"
  },
  {
   "id": 28389,
   "key": "D1208al.txt:323",
   "file": "D1208al.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺もクトゥグアを撃つ。",
   "ko_candidate": "나도 크투가를 발사한다｡"
  },
  {
   "id": 28390,
   "key": "D1208al.txt:332",
   "file": "D1208al.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の結界に阻まれる弾丸。だが火薬に混ぜられたイブン・ガズイの粉薬が魔術反応を起こし爆発。",
   "ko_candidate": "바람의 결계에 막힌 탄환｡ 하지만 화약에 섞인 이븐 가지의 분말이 마술 반응을 일으켜 폭발한다｡"
  },
  {
   "id": 28391,
   "key": "D1208al.txt:333",
   "file": "D1208al.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスをさらに追い詰める。",
   "ko_candidate": "클라우디우스를 더욱 궁지로 몰아넣는다｡"
  },
  {
   "id": 28392,
   "key": "D1208al.txt:338",
   "file": "D1208al.txt",
   "line": 338,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐあ……あああ……イあ……イア……はすタァぁぁ……ァァ！」",
   "ko_candidate": "「꾸아……아아아……이아……이아……하스터어어어……어어!」"
  },
  {
   "id": 28393,
   "key": "D1208al.txt:342",
   "file": "D1208al.txt",
   "line": 342,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 28394,
   "key": "D1208al.txt:348",
   "file": "D1208al.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を吐き、血を流しながらも、クラウディウスの魔力は高まっていく。",
   "ko_candidate": "피를 토하고 피를 흘리면서도 클라우디우스의 마력은 높아져 간다｡"
  },
  {
   "id": 28395,
   "key": "D1208al.txt:349",
   "file": "D1208al.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が瘴気を孕み、闇の彩に滲む。",
   "ko_candidate": "바람이 장기를 품고 어둠의 색채로 물들어간다｡"
  },
  {
   "id": 28396,
   "key": "D1208al.txt:350",
   "file": "D1208al.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この期に及んで、まだ術を――！",
   "ko_candidate": "이 판국에 아직도 술을――!"
  },
  {
   "id": 28397,
   "key": "D1208al.txt:353",
   "file": "D1208al.txt",
   "line": 353,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「させ……！」",
   "ko_candidate": "「못 하게……!」"
  },
  {
   "id": 28398,
   "key": "D1208al.txt:359",
   "file": "D1208al.txt",
   "line": 359,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アイ！　アイ！ はすトゥゥゥゥるゥゥゥゥゥゥ！ ロードビヤーキーィィィィィ！」",
   "ko_candidate": "「아이! 아이! 하스터으으으으르으으으으으! 로드 비야키이이이이이이이이!」"
  }
 ]
}