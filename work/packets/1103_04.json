 "items": [
  {
   "id": 22888,
   "key": "D1103le.txt:202",
   "file": "D1103le.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "扉が軋む音が、無人の街に寂しく響く。",
   "ko_candidate": "문이 삐걱거리는 소리가 무인의 거리에 쓸쓸히 울린다｡"
  },
  {
   "id": 22889,
   "key": "D1103le.txt:204",
   "file": "D1103le.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……居た。",
   "ko_candidate": "……있었다｡"
  },
  {
   "id": 22890,
   "key": "D1103le.txt:206",
   "file": "D1103le.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "参拝者用の椅子の中央を横切って、祭壇へと続く道。",
   "ko_candidate": "참배객용 의자 중앙을 가로질러 제단으로 이어지는 길｡"
  },
  {
   "id": 22891,
   "key": "D1103le.txt:208",
   "file": "D1103le.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神父席の奥、いつも通りシスターの格好をしたライカさんが、磔の聖者像を見上げている。",
   "ko_candidate": "신부석 뒤､ 평소처럼 수녀 차림을 한 라이카 씨가 십자가에 못 박힌 성자상을 올려다보고 있다｡"
  },
  {
   "id": 22892,
   "key": "D1103le.txt:212",
   "file": "D1103le.txt",
   "line": 212,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎ちゃん？」",
   "ko_candidate": "「……쿠로?」"
  },
  {
   "id": 22893,
   "key": "D1103le.txt:215",
   "file": "D1103le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り向きもせず訊ねるライカさん。",
   "ko_candidate": "돌아보지도 않고 묻는 라이카 씨｡"
  },
  {
   "id": 22894,
   "key": "D1103le.txt:216",
   "file": "D1103le.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "短く一言、「ああ」とだけ返事した。",
   "ko_candidate": "짧게 한마디､ 「응」이라고만 대답했다｡"
  },
  {
   "id": 22895,
   "key": "D1103le.txt:217",
   "file": "D1103le.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神父席へと近づく。",
   "ko_candidate": "신부석으로 다가간다｡"
  },
  {
   "id": 22896,
   "key": "D1103le.txt:220",
   "file": "D1103le.txt",
   "line": 220,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こんなトコで何してるんだよ。みんな心配してるぜ？」",
   "ko_candidate": "「이런 데서 뭐 하고 있어｡ 모두들 걱정하고 있다고?」"
  },
  {
   "id": 22897,
   "key": "D1103le.txt:225",
   "file": "D1103le.txt",
   "line": 225,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 22898,
   "key": "D1103le.txt:229",
   "file": "D1103le.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ライカさんは、黙ったまま。",
   "ko_candidate": "라이카 씨는 말없이｡"
  },
  {
   "id": 22899,
   "key": "D1103le.txt:231",
   "file": "D1103le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黙ったまま、十字架を見上げている。",
   "ko_candidate": "말없이 십자가를 올려다보고 있다｡"
  },
  {
   "id": 22900,
   "key": "D1103le.txt:232",
   "file": "D1103le.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はライカさんの傍らに立った。",
   "ko_candidate": "나는 라이카 씨 곁에 섰다｡"
  },
  {
   "id": 22901,
   "key": "D1103le.txt:235",
   "file": "D1103le.txt",
   "line": 235,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……戻らないのか？」",
   "ko_candidate": "「……돌아가지 않을 거야?」"
  },
  {
   "id": 22902,
   "key": "D1103le.txt:240",
   "file": "D1103le.txt",
   "line": 240,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あの子たちには……」",
   "ko_candidate": "「그 아이들에게는……」"
  },
  {
   "id": 22903,
   "key": "D1103le.txt:245",
   "file": "D1103le.txt",
   "line": 245,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何も言ってないよ。これ以上、余計な心配かけさせたくないしな」",
   "ko_candidate": "「아무 말도 하지 않았어｡ 더 이상 쓸데없는 걱정을 끼치고 싶지 않으니까」"
  },
  {
   "id": 22904,
   "key": "D1103le.txt:250",
   "file": "D1103le.txt",
   "line": 250,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そう……」",
   "ko_candidate": "「그래……」"
  },
  {
   "id": 22905,
   "key": "D1103le.txt:254",
   "file": "D1103le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの横顔を盗み見る。",
   "ko_candidate": "라이카 씨의 옆모습을 훔쳐본다｡"
  },
  {
   "id": 22906,
   "key": "D1103le.txt:256",
   "file": "D1103le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦悩と疲弊が剥き出しのまま、浮かんでいる。",
   "ko_candidate": "고뇌와 피로가 그대로 드러난 채 떠올라 있다｡"
  },
  {
   "id": 22907,
   "key": "D1103le.txt:258",
   "file": "D1103le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今までこの顔をずっと、誰にも……身近な人たちにすら気付かせることなく、ずっと隠し通してきたのか。",
   "ko_candidate": "지금까지 이 얼굴을 계속､ 누구에게도……가까운 사람들에게조차 알아채지 못하게 하고､ 계속 숨겨왔던 걸까｡"
  },
  {
   "id": 22908,
   "key": "D1103le.txt:260",
   "file": "D1103le.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "笑顔の下に隠して。",
   "ko_candidate": "미소 아래에 숨겨서｡"
  },
  {
   "id": 22909,
   "key": "D1103le.txt:261",
   "file": "D1103le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の下に隠して。",
   "ko_candidate": "가면 아래에 숨겨서｡"
  },
  {
   "id": 22910,
   "key": "D1103le.txt:262",
   "file": "D1103le.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故、ライカさんは、メタトロンはそんな生き方をしなければならないのだろう。",
   "ko_candidate": "왜 라이카 씨는､ 메타트론은 그런 삶을 살아야만 하는 걸까｡"
  },
  {
   "id": 22911,
   "key": "D1103le.txt:265",
   "file": "D1103le.txt",
   "line": 265,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なあ……良かったら、聞かせてくれないか？ なんで、こんなことをしているのか」",
   "ko_candidate": "「저기……괜찮다면 들려줄 수 있어? 왜 이런 일을 하고 있는지」"
  },
  {
   "id": 22912,
   "key": "D1103le.txt:271",
   "file": "D1103le.txt",
   "line": 271,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 22913,
   "key": "D1103le.txt:275",
   "file": "D1103le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凝っと聖者を見つめ続ける瞳。",
   "ko_candidate": "뚫어지게 성자를 바라보는 눈동자｡"
  },
  {
   "id": 22914,
   "key": "D1103le.txt:276",
   "file": "D1103le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦悩は悔恨から来るものなのか。",
   "ko_candidate": "고뇌는 후회에서 오는 것일까｡"
  },
  {
   "id": 22915,
   "key": "D1103le.txt:277",
   "file": "D1103le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから、懺悔し、赦しを乞うのか。",
   "ko_candidate": "그래서 참회하고 용서를 구하는 걸까｡"
  },
  {
   "id": 22916,
   "key": "D1103le.txt:279",
   "file": "D1103le.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それとも……憎悪し、怨嗟をぶつけるのか。",
   "ko_candidate": "아니면……증오하고 원망을 퍼붓는 걸까｡"
  },
  {
   "id": 22917,
   "key": "D1103le.txt:280",
   "file": "D1103le.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それがたとえ、神に背く行為だとしても――",
   "ko_candidate": "그것이 설령 신에게 등을 돌리는 행위라 해도――"
  },
  {
   "id": 22918,
   "key": "D1103le.txt:285",
   "file": "D1103le.txt",
   "line": 285,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「実はね……私、そんなには信心深くないのよ……」",
   "ko_candidate": "「사실은 말이야……나､ 그다지 신심 깊지 않아……」"
  },
  {
   "id": 22919,
   "key": "D1103le.txt:289",
   "file": "D1103le.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "唐突に、そんなことを語り始める。",
   "ko_candidate": "갑자기 그런 말을 꺼낸다｡"
  },
  {
   "id": 22920,
   "key": "D1103le.txt:294",
   "file": "D1103le.txt",
   "line": 294,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「私は本当のシスターじゃないから。周囲をごまかすために、捨てられていた教会を利用して、その真似事をしていただけ」 「神様は……というより、教会とかシスターとか、本当は好きじゃないの」",
   "ko_candidate": "「나는 진짜 수녀가 아니니까｡ 주변을 속이기 위해 버려진 교회를 이용해서 그 흉내를 내고 있었을 뿐이야｡ 신님은……이라기보다는､ 교회라든가 수녀라든가､ 사실은 좋아하지 않아」"
  },
  {
   "id": 22921,
   "key": "D1103le.txt:302",
   "file": "D1103le.txt",
   "line": 302,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「周囲をごまかすって……」",
   "ko_candidate": "「주변을 속이다니……」"
  },
  {
   "id": 22922,
   "key": "D1103le.txt:308",
   "file": "D1103le.txt",
   "line": 308,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃんにも、ジョージやコリン、アリスンにも、嘘をついていた。 みんなを騙していたのよ、私……」",
   "ko_candidate": "「쿠로에게도､ 죠지와 콜린､ 앨리슨에게도 거짓말을 했어｡ 모두를 속이고 있었어､ 나……」"
  },
  {
   "id": 22923,
   "key": "D1103le.txt:313",
   "file": "D1103le.txt",
   "line": 313,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いったい何でそんなことを？」",
   "ko_candidate": "「도대체 왜 그런 짓을?」"
  },
  {
   "id": 22924,
   "key": "D1103le.txt:317",
   "file": "D1103le.txt",
   "line": 317,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 22925,
   "key": "D1103le.txt:320",
   "file": "D1103le.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても押し黙ってしまう。",
   "ko_candidate": "또다시 입을 다물어 버린다｡"
  },
  {
   "id": 22926,
   "key": "D1103le.txt:321",
   "file": "D1103le.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その部分は、もっとも触れられたくない真相なのだろうか。",
   "ko_candidate": "그 부분은 가장 언급하고 싶지 않은 진실인 걸까｡"
  },
  {
   "id": 22927,
   "key": "D1103le.txt:323",
   "file": "D1103le.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの肩が震える。",
   "ko_candidate": "라이카 씨의 어깨가 떨린다｡"
  }
 ]
