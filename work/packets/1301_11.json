 "items": [
  {
   "id": 31006,
   "key": "D1301ru.txt:319",
   "file": "D1301ru.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が、砕け散った。",
   "ko_candidate": "바람이 산산조각 났다｡"
  },
  {
   "id": 31007,
   "key": "D1301ru.txt:340",
   "file": "D1301ru.txt",
   "line": 340,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「え…………？」",
   "ko_candidate": "「어…?」"
  },
  {
   "id": 31008,
   "key": "D1301ru.txt:343",
   "file": "D1301ru.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の頭上で、黒風は爆裂した。",
   "ko_candidate": "루리의 머리 위에서 검은 바람이 폭발했다｡"
  },
  {
   "id": 31009,
   "key": "D1301ru.txt:344",
   "file": "D1301ru.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血飛沫が盛大に飛び散る。",
   "ko_candidate": "피보라가 성대하게 튀어 올랐다｡"
  },
  {
   "id": 31010,
   "key": "D1301ru.txt:345",
   "file": "D1301ru.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "壁を、天井を、瑠璃を、 まるで殴りつけるかの如く迸った。",
   "ko_candidate": "벽을､ 천장을､ 루리를､ 마치 때리는 것처럼 튀어 올랐다｡"
  },
  {
   "id": 31011,
   "key": "D1301ru.txt:348",
   "file": "D1301ru.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を撒き散らして、クラウディウスが墜ちる。",
   "ko_candidate": "피를 뿌리며 클라우디우스가 떨어진다｡"
  },
  {
   "id": 31012,
   "key": "D1301ru.txt:349",
   "file": "D1301ru.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を浴びて、苛烈な黒が、砕け散る風の中で躍る。",
   "ko_candidate": "피를 뒤집어쓰고 맹렬한 검은색이 산산조각 난 바람 속에서 춤춘다｡"
  },
  {
   "id": 31013,
   "key": "D1301ru.txt:350",
   "file": "D1301ru.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀の焔が、黒いヒト型の、貌を照らした。",
   "ko_candidate": "언월도의 불꽃이 검은 인간형의 얼굴을 비추었다｡"
  },
  {
   "id": 31014,
   "key": "D1301ru.txt:354",
   "file": "D1301ru.txt",
   "line": 354,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎？」",
   "ko_candidate": "「…쿠로?」"
  },
  {
   "id": 31015,
   "key": "D1301ru.txt:360",
   "file": "D1301ru.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが地面を、跳ねる様に転がった。",
   "ko_candidate": "클라우디우스가 바닥을 튀어 오르듯 구른다｡"
  },
  {
   "id": 31016,
   "key": "D1301ru.txt:361",
   "file": "D1301ru.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その傍らに九郎が着地する。全くの無音。",
   "ko_candidate": "그 옆에 쿠로가 착지한다｡ 완전히 무음으로｡"
  },
  {
   "id": 31017,
   "key": "D1301ru.txt:365",
   "file": "D1301ru.txt",
   "line": 365,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「が……ハッ……！　かあ…… 大十字……九郎……かァァッ！」",
   "ko_candidate": "「크… 핫…! 크아… 다이쥬지… 쿠로… 크아악!」"
  },
  {
   "id": 31018,
   "key": "D1301ru.txt:369",
   "file": "D1301ru.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "床に広がる血溜まりの中、クラウディウスは憎悪の視線で、九郎を見上げる。",
   "ko_candidate": "바닥에 퍼진 피웅덩이 속에서 클라우디우스는 증오의 시선으로 쿠로를 올려다본다｡"
  },
  {
   "id": 31019,
   "key": "D1301ru.txt:371",
   "file": "D1301ru.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが九郎は、彼の方を見ていない。",
   "ko_candidate": "하지만 쿠로는 그의 쪽을 보고 있지 않다｡"
  },
  {
   "id": 31020,
   "key": "D1301ru.txt:372",
   "file": "D1301ru.txt",
   "line": 372,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳に光は無く、焦点は何処にも定まらず、遠い何処かを見つめているようであった。",
   "ko_candidate": "눈동자에 빛은 없고､ 초점은 어디에도 맞춰지지 않은 채､ 먼 어딘가를 바라보고"
  },
  {
   "id": 31021,
   "key": "D1301ru.txt:376",
   "file": "D1301ru.txt",
   "line": 376,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「え、あ、え……？　ダーリン？」",
   "ko_candidate": "있는 것 같았다｡ 「어､ 아､ 어…? 달링?」"
  },
  {
   "id": 31022,
   "key": "D1301ru.txt:379",
   "file": "D1301ru.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰もが、凍りついた。",
   "ko_candidate": "모두가 얼어붙었다｡"
  },
  {
   "id": 31023,
   "key": "D1301ru.txt:380",
   "file": "D1301ru.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それ程に九郎の状態は、異常だった。",
   "ko_candidate": "그만큼 쿠로의 상태는 이상했다｡"
  },
  {
   "id": 31024,
   "key": "D1301ru.txt:385",
   "file": "D1301ru.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇。",
   "ko_candidate": "어둠｡"
  },
  {
   "id": 31025,
   "key": "D1301ru.txt:386",
   "file": "D1301ru.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎は闇を纏っている。",
   "ko_candidate": "쿠로는 어둠을 두르고 있다｡"
  },
  {
   "id": 31026,
   "key": "D1301ru.txt:388",
   "file": "D1301ru.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇を鎧っている。",
   "ko_candidate": "어둠을 갑옷처럼 입고 있다｡"
  },
  {
   "id": 31027,
   "key": "D1301ru.txt:389",
   "file": "D1301ru.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蠢く闇を。脈動する闇を。焔える闇を。",
   "ko_candidate": "꿈틀거리는 어둠을｡ 맥동하는 어둠을｡ 불타오르는 어둠을｡"
  },
  {
   "id": 31028,
   "key": "D1301ru.txt:390",
   "file": "D1301ru.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生きた闇を。",
   "ko_candidate": "살아있는 어둠을｡"
  },
  {
   "id": 31029,
   "key": "D1301ru.txt:397",
   "file": "D1301ru.txt",
   "line": 397,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「っ……っ……大十字さんは…… どうしたのです……？」",
   "ko_candidate": "「으… 으… 다이쥬지 씨는… 어떻게 된 겁니까…?」"
  },
  {
   "id": 31030,
   "key": "D1301ru.txt:402",
   "file": "D1301ru.txt",
   "line": 402,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「妾が知るか…… だが、この気配……」",
   "ko_candidate": "「내가 알겠느냐… 하지만 이 기운은…」"
  },
  {
   "id": 31031,
   "key": "D1301ru.txt:406",
   "file": "D1301ru.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の胸の上に乗っかったアルの身体がふらつく。",
   "ko_candidate": "루리의 가슴 위에 올라탄 알의 몸이 흔들린다｡"
  },
  {
   "id": 31032,
   "key": "D1301ru.txt:407",
   "file": "D1301ru.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "震えた声で言った。",
   "ko_candidate": "떨리는 목소리로 말했다｡"
  },
  {
   "id": 31033,
   "key": "D1301ru.txt:411",
   "file": "D1301ru.txt",
   "line": 411,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何か……善くないものに憑かれおったな。 くっ、未熟な男だ……！」",
   "ko_candidate": "「뭔가… 좋지 않은 것에 씌였 구나｡ 크윽､ 미숙한 녀석…!」"
  },
  {
   "id": 31034,
   "key": "D1301ru.txt:417",
   "file": "D1301ru.txt",
   "line": 417,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そ、そんな……っ」",
   "ko_candidate": "「그､ 그런…」"
  },
  {
   "id": 31035,
   "key": "D1301ru.txt:425",
   "file": "D1301ru.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎は動かない。",
   "ko_candidate": "쿠로는 움직이지 않는다｡"
  },
  {
   "id": 31036,
   "key": "D1301ru.txt:426",
   "file": "D1301ru.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慄く一同を、全く意に介する事無く、ただ深淵を見つめ続ける。",
   "ko_candidate": "전율하는 일동을 전혀 개의치 않고 그저 심연을 응시할 뿐이다｡"
  },
  {
   "id": 31037,
   "key": "D1301ru.txt:427",
   "file": "D1301ru.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の足許で、血の水面が跳ねた。",
   "ko_candidate": "쿠로의 발밑에서 피의 수면이 튀었다｡"
  },
  {
   "id": 31038,
   "key": "D1301ru.txt:431",
   "file": "D1301ru.txt",
   "line": 431,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なァァァに無視してやがんだ、 コラァァァァァ！」",
   "ko_candidate": "「뭐어어어를 무시하고 있는 거야､ 이 자식아아아아아!」"
  },
  {
   "id": 31039,
   "key": "D1301ru.txt:436",
   "file": "D1301ru.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風を纏って、倒れていたクラウディウスが、飛んだ。",
   "ko_candidate": "바람을 두르고 쓰러져 있던 클라우디우스가 날아올랐다｡"
  },
  {
   "id": 31040,
   "key": "D1301ru.txt:438",
   "file": "D1301ru.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだ健在な方の手にケンダマを握っている。",
   "ko_candidate": "아직 멀쩡한 쪽 손에 켄다마를 쥐고 있다｡"
  },
  {
   "id": 31041,
   "key": "D1301ru.txt:440",
   "file": "D1301ru.txt",
   "line": 440,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『玉』が弾丸の如く、放たれた。",
   "ko_candidate": "『구슬』이 총알처럼 발사되었다｡"
  },
  {
   "id": 31042,
   "key": "D1301ru.txt:441",
   "file": "D1301ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "真っ直ぐとかわせない速度で、 九郎の眉間を撃とうと――",
   "ko_candidate": "똑바로 피할 수 없는 속도로 쿠로의 미간을 향해 날아가려고――"
  },
  {
   "id": 31043,
   "key": "D1301ru.txt:446",
   "file": "D1301ru.txt",
   "line": 446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃が閃った。",
   "ko_candidate": "칼날이 번쩍였다｡"
  },
  {
   "id": 31044,
   "key": "D1301ru.txt:450",
   "file": "D1301ru.txt",
   "line": 450,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 31045,
   "key": "D1301ru.txt:453",
   "file": "D1301ru.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音速をも完全に捉えるクラウディウスの",
   "ko_candidate": "음속조차 완벽하게 포착하는 클라우디우스의 동체시력으로도"
  }
 ]
}