 "items": [
  {
   "id": 14090,
   "key": "D0808al.txt:505",
   "file": "D0808al.txt",
   "line": 505,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "徹底的に遊び倒して、気付けばだいぶ日が暮れていた。",
   "ko_candidate": "철저하게 놀아댄 끝에 정신을 차려보니 해가 꽤 저물어 있었다｡"
  },
  {
   "id": 14091,
   "key": "D0808al.txt:508",
   "file": "D0808al.txt",
   "line": 508,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「も……もう……駄目……ばたんっ」 俺は完全にノックダウン。",
   "ko_candidate": "「이……이제……안 돼……털썩」{SE_PLAY(1,\"갖郎へぼダメージ단\",0,100,false);}<br>"
  },
  {
   "id": 14092,
   "key": "D0808al.txt:516",
   "file": "D0808al.txt",
   "line": 516,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なんて……タフな……小娘、だ……きゅ～っ」",
   "ko_candidate": "나는 완전히 녹다운｡ 「정말……터프한……꼬마구나……큐~」"
  },
  {
   "id": 14093,
   "key": "D0808al.txt:519",
   "file": "D0808al.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "引き続き、アルもリタイア。",
   "ko_candidate": "이어서 알도 리타이어｡"
  },
  {
   "id": 14094,
   "key": "D0808al.txt:525",
   "file": "D0808al.txt",
   "line": 525,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あーあ、２人とも体力無いなぁ～」",
   "ko_candidate": "「아아､ 둘 다 체력이 없구나~」"
  },
  {
   "id": 14095,
   "key": "D0808al.txt:528",
   "file": "D0808al.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、一人エンネアが元気だった。",
   "ko_candidate": "오직 엔네아만이 원기왕성했다｡"
  },
  {
   "id": 14096,
   "key": "D0808al.txt:530",
   "file": "D0808al.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その小さな身体の何処に、そんな無尽蔵のパワーが秘められているのか。",
   "ko_candidate": "그 작은 몸 어디에 그런 무진장의 파워가 숨겨져 있는 걸까｡"
  },
  {
   "id": 14097,
   "key": "D0808al.txt:534",
   "file": "D0808al.txt",
   "line": 534,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「しょうがないなぁ～。少し休む？」",
   "ko_candidate": "「어쩔 수 없네~｡ 잠깐 쉴까?」"
  },
  {
   "id": 14098,
   "key": "D0808al.txt:537",
   "file": "D0808al.txt",
   "line": 537,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声も無く、俺たちは頷いた。",
   "ko_candidate": "소리 없이 우리는 고개를 끄덕였다｡"
  },
  {
   "id": 14099,
   "key": "D0808al.txt:543",
   "file": "D0808al.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "小腹も空くけど、だからと言って夕食にはやや早い。",
   "ko_candidate": "배도 고프지만 그렇다고 저녁 식사하기엔 좀 이르다｡"
  },
  {
   "id": 14100,
   "key": "D0808al.txt:545",
   "file": "D0808al.txt",
   "line": 545,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "喫茶店で軽めの食事をとることにした。",
   "ko_candidate": "카페에서 가벼운 식사를 하기로 했다｡"
  },
  {
   "id": 14101,
   "key": "D0808al.txt:547",
   "file": "D0808al.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ケーキが旨いと評判の店なので注文してみたが……なるほど、これはイケる。",
   "ko_candidate": "케이크가 맛있다고 소문난 가게라 주문해봤는데……과연､ 이건 괜찮다｡"
  },
  {
   "id": 14102,
   "key": "D0808al.txt:549",
   "file": "D0808al.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "甘いものが好きなエンネアは大喜びだ。",
   "ko_candidate": "단 것을 좋아하는 엔네아는 매우 기뻐한다｡"
  },
  {
   "id": 14103,
   "key": "D0808al.txt:551",
   "file": "D0808al.txt",
   "line": 551,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなエンネアを横目に、俺は財布の中身を確認する。",
   "ko_candidate": "그런 엔네아를 곁눈질하며 나는 지갑 속을 확인한다｡"
  },
  {
   "id": 14104,
   "key": "D0808al.txt:554",
   "file": "D0808al.txt",
   "line": 554,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今日一日で相当減った……」",
   "ko_candidate": "「오늘 하루만에 꽤 줄었어……」"
  },
  {
   "id": 14105,
   "key": "D0808al.txt:559",
   "file": "D0808al.txt",
   "line": 559,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎は貧乏性過ぎー！　遊ぶときはパーッと使わなきゃ！」",
   "ko_candidate": "「쿠로는 너무 구두쇠야! 놀 때는 팍팍 써야지!」"
  },
  {
   "id": 14106,
   "key": "D0808al.txt:563",
   "file": "D0808al.txt",
   "line": 563,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「貧乏どころか赤貧と呼んだ方が相応しい生活が長かったからな……」",
   "ko_candidate": "「구두쇠는커녕 빈털터리라고 불러야 할 생활이 오래 계속됐으니까……」"
  },
  {
   "id": 14107,
   "key": "D0808al.txt:565",
   "file": "D0808al.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ぼやきながら、アルが食べているショートケーキの苺を奪う。",
   "ko_candidate": "투덜거리며 알이 먹고 있는 쇼트케이크의 딸기를 빼앗는다｡"
  },
  {
   "id": 14108,
   "key": "D0808al.txt:570",
   "file": "D0808al.txt",
   "line": 570,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ――――ッ!?　な、汝！　なんて真似をっ!?」",
   "ko_candidate": "「아――――?! 네､ 네놈! 무슨 짓을?!」"
  },
  {
   "id": 14109,
   "key": "D0808al.txt:574",
   "file": "D0808al.txt",
   "line": 574,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いつまでも残しておくからだ」",
   "ko_candidate": "「계속 남겨두고 있으니까지」"
  },
  {
   "id": 14110,
   "key": "D0808al.txt:579",
   "file": "D0808al.txt",
   "line": 579,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「楽しみは取っておく主義なのだ！　それを……許せんっ！」",
   "ko_candidate": "「즐거움은 아껴두는 주의인 것이다! 그것을……용서할 수 없다!」"
  },
  {
   "id": 14111,
   "key": "D0808al.txt:583",
   "file": "D0808al.txt",
   "line": 583,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……き、貴様!?　苺１つでケーキ１つ丸ごとってのは不当だろ!? ハムラビ法典ですら違法だぜ、それはっ！」",
   "ko_candidate": "「……이､ 이 자식?! 딸기 하나에 케이크 하나 통째로 가져가는 건 부당하잖아?! 함무라비 법전에서도 불법이라고､ 그건!」"
  },
  {
   "id": 14112,
   "key": "D0808al.txt:589",
   "file": "D0808al.txt",
   "line": 589,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もぐもぐ……報復は倍返しが基本だ」",
   "ko_candidate": "「우물우물……보복은 배로 갚는 게 기본이지」"
  },
  {
   "id": 14113,
   "key": "D0808al.txt:593",
   "file": "D0808al.txt",
   "line": 593,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おのれっ！　こうしてくれるっ！　ぺっぺっ！」",
   "ko_candidate": "「이 자식! 이렇게 나올 줄 알았다! 퉤퉤!」"
  },
  {
   "id": 14114,
   "key": "D0808al.txt:598",
   "file": "D0808al.txt",
   "line": 598,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわっ、汚っ！」",
   "ko_candidate": "「우와､ 더러워!」"
  },
  {
   "id": 14115,
   "key": "D0808al.txt:602",
   "file": "D0808al.txt",
   "line": 602,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「つーワケで、このアップルパイは俺のものだっ！」",
   "ko_candidate": "「그래서 이 애플파이는 내 거야!」"
  },
  {
   "id": 14116,
   "key": "D0808al.txt:607",
   "file": "D0808al.txt",
   "line": 607,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「が、餓鬼のような真似をしおってからに！」",
   "ko_candidate": "「어､ 어린애 같은 짓을 하다니!」"
  },
  {
   "id": 14117,
   "key": "D0808al.txt:611",
   "file": "D0808al.txt",
   "line": 611,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何をいまさら。それが俺だ」",
   "ko_candidate": "「뭘 이제 와서｡ 이게 바로 나야」"
  },
  {
   "id": 14118,
   "key": "D0808al.txt:616",
   "file": "D0808al.txt",
   "line": 616,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「開き直るかっ！」",
   "ko_candidate": "「뻔뻔하기는!」"
  },
  {
   "id": 14119,
   "key": "D0808al.txt:621",
   "file": "D0808al.txt",
   "line": 621,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……あははは♪」",
   "ko_candidate": "「……아하하하♪」"
  },
  {
   "id": 14120,
   "key": "D0808al.txt:624",
   "file": "D0808al.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ん……？",
   "ko_candidate": "응……?"
  },
  {
   "id": 14121,
   "key": "D0808al.txt:625",
   "file": "D0808al.txt",
   "line": 625,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気づけば、エンネアが俺達の言い争いを見て、けらけら笑っている。",
   "ko_candidate": "정신차려보니 엔네아가 우리의 말다툼을 보며 깔깔 웃고 있다｡"
  },
  {
   "id": 14122,
   "key": "D0808al.txt:627",
   "file": "D0808al.txt",
   "line": 627,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当に可笑しそうに笑うので、何となく恥ずかしくなってきた。",
   "ko_candidate": "정말 재미있어 보이는지 웃어서､ 왠지 부끄러워졌다｡"
  },
  {
   "id": 14123,
   "key": "D0808al.txt:630",
   "file": "D0808al.txt",
   "line": 630,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うっ…………うぅむ」",
   "ko_candidate": "「으……음음」"
  },
  {
   "id": 14124,
   "key": "D0808al.txt:635",
   "file": "D0808al.txt",
   "line": 635,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………こほん」",
   "ko_candidate": "「………………콜록」"
  },
  {
   "id": 14125,
   "key": "D0808al.txt:640",
   "file": "D0808al.txt",
   "line": 640,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あははははははっ！」",
   "ko_candidate": "「아하하하하하!」"
  },
  {
   "id": 14126,
   "key": "D0808al.txt:643",
   "file": "D0808al.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気まずそうに、顔を背ける俺たち。",
   "ko_candidate": "어색하게 고개를 돌리는 우리들｡"
  },
  {
   "id": 14127,
   "key": "D0808al.txt:644",
   "file": "D0808al.txt",
   "line": 644,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その様子を見て、エンネアはまた笑う。",
   "ko_candidate": "그 모습을 보고 엔네아는 또 웃는다｡"
  },
  {
   "id": 14128,
   "key": "D0808al.txt:647",
   "file": "D0808al.txt",
   "line": 647,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だよ……そんなに可笑しいか？」",
   "ko_candidate": "「뭐야……그렇게 웃긴가?」"
  },
  {
   "id": 14129,
   "key": "D0808al.txt:652",
   "file": "D0808al.txt",
   "line": 652,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あはははは……うん。 九郎って戦う人なのに、全然それっぽくないって言うか」",
   "ko_candidate": "「아하하하……응｡ 쿠로는 싸우는 사람인데､ 전혀 그렇지 않다고 할까」"
  }
 ]
