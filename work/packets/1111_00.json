 },
 "items": [
  {
   "id": 25896,
   "key": "D1111le.txt:6",
   "file": "D1111le.txt",
   "line": 6,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐわああああああ！」",
   "ko_candidate": "「꺄아아아아아아!」"
  },
  {
   "id": 25897,
   "key": "D1111le.txt:11",
   "file": "D1111le.txt",
   "line": 11,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ダーリンッッッッ！」",
   "ko_candidate": "「달링!!!!」"
  },
  {
   "id": 25898,
   "key": "D1111le.txt:14",
   "file": "D1111le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザが俺を庇う。次の瞬間、熱波と衝撃が襲いかかって来た。",
   "ko_candidate": "엘자가 나를 감싼다｡ 다음 순간､ 열파와 충격이 덮쳐왔다｡"
  },
  {
   "id": 25899,
   "key": "D1111le.txt:15",
   "file": "D1111le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "浮遊感。",
   "ko_candidate": "부유감｡"
  },
  {
   "id": 25900,
   "key": "D1111le.txt:20",
   "file": "D1111le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発に吹き飛ばされ、俺たちは外に吐き出される。",
   "ko_candidate": "폭발에 날려 우리는 밖으로 튕겨나간다｡"
  },
  {
   "id": 25901,
   "key": "D1111le.txt:22",
   "file": "D1111le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界には粉微塵になって、残骸を地表に降らす、破壊ロボ。",
   "ko_candidate": "시야에는 산산조각 나 잔해를 지표에 뿌리는 파괴 로봇｡"
  },
  {
   "id": 25902,
   "key": "D1111le.txt:24",
   "file": "D1111le.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……まずい。",
   "ko_candidate": "……큰일이다｡"
  },
  {
   "id": 25903,
   "key": "D1111le.txt:25",
   "file": "D1111le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確認するまでもなく、この高さから墜ちれば死ぬ。",
   "ko_candidate": "확인할 필요도 없이 이 높이에서 떨어지면 죽는다｡"
  },
  {
   "id": 25904,
   "key": "D1111le.txt:26",
   "file": "D1111le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だからと言って、どうすることも出来ない。",
   "ko_candidate": "그렇다고 어떻게 할 수도 없다｡"
  },
  {
   "id": 25905,
   "key": "D1111le.txt:31",
   "file": "D1111le.txt",
   "line": 31,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃ……くっ……！」",
   "ko_candidate": "「쿠로……큿……!」"
  },
  {
   "id": 25906,
   "key": "D1111le.txt:35",
   "file": "D1111le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "助けようと、こちらに翔んでくるライカさん。",
   "ko_candidate": "도우려고 이쪽으로 날아오는 라이카 씨｡"
  },
  {
   "id": 25907,
   "key": "D1111le.txt:37",
   "file": "D1111le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが直撃こそ免れたものの、あの攻撃でダメージを負い、血を流している。",
   "ko_candidate": "하지만 직격은 면했어도 그 공격으로 데미지를 입어 피를 흘리고 있다｡"
  },
  {
   "id": 25908,
   "key": "D1111le.txt:37",
   "file": "D1111le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらに最悪なことに、背中の翼をやられたのか、まったく出力が上がらないようだ。",
   "ko_candidate": "게다가 최악의 상황으로 등의 날개를 다쳤는지 전혀 출력이 오르지 않는 것 같다｡"
  },
  {
   "id": 25909,
   "key": "D1111le.txt:39",
   "file": "D1111le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墜ちる俺たちとの、距離は開く一方……ちっ、こんなところで死んじまうのか。情けないにもほどがある……！",
   "ko_candidate": "떨어지는 우리와의 거리는 점점 벌어질 뿐……칫､ 이런 곳에서 죽어버리는 건가｡ 한심하기 짝이 없군……!"
  },
  {
   "id": 25910,
   "key": "D1111le.txt:42",
   "file": "D1111le.txt",
   "line": 42,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くそ……せめてアルが居れば……！」",
   "ko_candidate": "「젠장……알이라도 있었다면……!」"
  },
  {
   "id": 25911,
   "key": "D1111le.txt:44",
   "file": "D1111le.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶望が心を埋め尽くす――まさにその時だった。",
   "ko_candidate": "절망이 마음을 가득 채우는――바로 그때였다｡"
  },
  {
   "id": 25912,
   "key": "D1111le.txt:49",
   "file": "D1111le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目の前の光景が歪む。",
   "ko_candidate": "눈앞의 광경이 일그러진다｡"
  },
  {
   "id": 25913,
   "key": "D1111le.txt:50",
   "file": "D1111le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初は墜落の速度のせいで、視界が定まらないせいだと思ったが、どうも違うようだ。",
   "ko_candidate": "처음에는 추락 속도 때문에 시야가 흐려진 것이라 생각했지만､ 아무래도 다른 것 같다｡"
  },
  {
   "id": 25914,
   "key": "D1111le.txt:52",
   "file": "D1111le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影が。",
   "ko_candidate": "그림자가｡"
  },
  {
   "id": 25915,
   "key": "D1111le.txt:53",
   "file": "D1111le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暗闇に、揺らぐ影が顕れる。",
   "ko_candidate": "어둠 속에 흔들리는 그림자가 나타난다｡"
  },
  {
   "id": 25916,
   "key": "D1111le.txt:55",
   "file": "D1111le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影は次第に確かな『気配』を実像を結びつつある。",
   "ko_candidate": "그림자는 점점 확실한 『기척』을 실체화하고 있다｡"
  },
  {
   "id": 25917,
   "key": "D1111le.txt:56",
   "file": "D1111le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この現象を、俺はよく知っている。",
   "ko_candidate": "이 현상을 나는 잘 알고 있다｡"
  },
  {
   "id": 25918,
   "key": "D1111le.txt:59",
   "file": "D1111le.txt",
   "line": 59,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何で……？」",
   "ko_candidate": "「뭐､ 어째서……?」"
  },
  {
   "id": 25919,
   "key": "D1111le.txt:72",
   "file": "D1111le.txt",
   "line": 72,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「きょ、虚数展開カタパルト……稼動してます……！」",
   "ko_candidate": "「허､ 허수전개 카타펄트……가동하고 있습니다……!」"
  },
  {
   "id": 25920,
   "key": "D1111le.txt:77",
   "file": "D1111le.txt",
   "line": 77,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何やて!?　デモンベインでもないのに、カタパルトを稼動させるだけの動力は何処から？　それに何を転送しようっていうんや!?」",
   "ko_candidate": "「뭐라고!? 데몬베인도 아닌데 카타펄트를 가동할 만한 동력이 어디서 나온 거지? 게다가 뭘 전송하려는 거야!」"
  },
  {
   "id": 25921,
   "key": "D1111le.txt:81",
   "file": "D1111le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戸惑う司令室に、突然、けたたましいエレキギターの音が響いた。",
   "ko_candidate": "당황하는 사령실에 갑자기 귀가 찢어질 듯한 일렉 기타 소리가 울려 퍼졌다｡"
  },
  {
   "id": 25922,
   "key": "D1111le.txt:88",
   "file": "D1111le.txt",
   "line": 88,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「～～～～～～～～～～～～～――――――ッッッッ！」",
   "ko_candidate": "「～～～～～～～～～～～～～――――――엇!!!!」"
  },
  {
   "id": 25923,
   "key": "D1111le.txt:91",
   "file": "D1111le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "と言うよりハウリングしていた。",
   "ko_candidate": "라기보다는 하울링하고 있었다｡"
  },
  {
   "id": 25924,
   "key": "D1111le.txt:92",
   "file": "D1111le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "耳を押さえて、一同、蹲る。",
   "ko_candidate": "귀를 막고 일동 쪼그려 앉는다｡"
  },
  {
   "id": 25925,
   "key": "D1111le.txt:97",
   "file": "D1111le.txt",
   "line": 97,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――耳が、痛い」",
   "ko_candidate": "「――귀가 아파」"
  },
  {
   "id": 25926,
   "key": "D1111le.txt:102",
   "file": "D1111le.txt",
   "line": 102,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何や、何や！　何処の馬鹿の仕業や!?」",
   "ko_candidate": "「뭐야､ 뭐야! 어느 바보 짓이야!?」"
  },
  {
   "id": 25927,
   "key": "D1111le.txt:110",
   "file": "D1111le.txt",
   "line": 110,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヘーイ！ はぅどぅゆーどぅ、ご機嫌麗しゅう、覇道財閥の諸君！」 「我輩は世紀の大天才！　最も神に近き頭脳、ドクター・ウェストであーる！」",
   "ko_candidate": "「헤이! 하우 두 유 두､ 안녕하신가､ 하도 재벌의 여러분! 나는 세기의 대천재! 가장 신에 가까운 두뇌､ 닥터 웨스트다!」"
  },
  {
   "id": 25928,
   "key": "D1111le.txt:117",
   "file": "D1111le.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハウリングの正体は通信機だった。",
   "ko_candidate": "하울링의 정체는 통신기였다｡"
  },
  {
   "id": 25929,
   "key": "D1111le.txt:118",
   "file": "D1111le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "モニター画面いっぱいにドクター・ウェストの顔が表示されている。",
   "ko_candidate": "모니터 화면 가득 닥터 웨스트의 얼굴이 표시되어 있다｡"
  },
  {
   "id": 25930,
   "key": "D1111le.txt:119",
   "file": "D1111le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暑苦しい事この上ない。",
   "ko_candidate": "답답하기 이를 데 없다｡"
  },
  {
   "id": 25931,
   "key": "D1111le.txt:124",
   "file": "D1111le.txt",
   "line": 124,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……貴方！　どうやって通信機のコードに……！」",
   "ko_candidate": "「아……당신! 어떻게 통신기 코드에……!」"
  },
  {
   "id": 25932,
   "key": "D1111le.txt:129",
   "file": "D1111le.txt",
   "line": 129,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふん！　この程度のプロテクト、我輩には無いも当然である！」 「それはともかくこのたび、我輩ことドクター・ウェストは諸君らに協力してやる事になったので感動に咽び泣きつつ、まあ仲良くやれ」",
   "ko_candidate": "「흥! 이 정도의 프로텍트､ 나에겐 당연히 없지! 그건 그렇고 이번에 나 닥터 웨스트는 여러분에게 협력하기로 했으니 감동에 목이 메어 울면서 뭐､ 사이좋게 지내라｡ 그리고 그런 이유로 허수전개 카타펄트를 마음대로 사용했으니 그 점은 잘 부탁해」"
  },
  {
   "id": 25933,
   "key": "D1111le.txt:135",
   "file": "D1111le.txt",
   "line": 135,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それからそんなワケで虚数展開カタパルトを勝手に使わせてもらったので、そこんとこヨロシク」",
   "ko_candidate": "「뭐뭐뭐……뭘 마음대로 얘기를 진행하고 있어､ 이 바보 녀석! 자비를 베풀어줬더니 조금 봐줬더니 기어오르고……!」"
  },
  {
   "id": 25934,
   "key": "D1111le.txt:140",
   "file": "D1111le.txt",
   "line": 140,
   "speaker": "チアキ / ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ななな……なに勝手に話し進めていやがる、このトンチキ！ 情けをかけてやれば調子に乗って……！」 「落ち着きなさい、チアキ。 ……ドクター、説明して戴けますか？ 返答次第では、我々は貴方を 『処分』することになります」",
   "ko_candidate": "「진정하세요､ 치아키｡ ……닥터､ 설명해 주시겠습니까? 대답에 따라서는 우리는 당신을 『처분』하게 될 겁니다」"
  },
  {
   "id": 25935,
   "key": "D1111le.txt:154",
   "file": "D1111le.txt",
   "line": 154,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふははははは！　良かろう、ならば刮目して見よ！」 「我輩のハンティングホラーの勇姿を、いざいざいざぁぁぁぁぁ！」",
   "ko_candidate": "「후하하하하! 좋다､ 그럼 눈을 크게 뜨고 보라! 나의 헌팅 호러의 용맹한 모습을､ 자 자 자아아아아!」"
  }
 ]
}