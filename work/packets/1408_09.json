 "items": [
  {
   "id": 38451,
   "key": "D1408ru.txt:829",
   "file": "D1408ru.txt",
   "line": 829,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はんッ！」",
   "ko_candidate": "「흥!」"
  },
  {
   "id": 38452,
   "key": "D1408ru.txt:832",
   "file": "D1408ru.txt",
   "line": 832,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先ほどと同じ要領で、その斬撃を両方の魔銃を使って捌く。",
   "ko_candidate": "아까와 같은 요령으로 그 참격을 양쪽 마총을 사용해 받아낸다｡"
  },
  {
   "id": 38453,
   "key": "D1408ru.txt:836",
   "file": "D1408ru.txt",
   "line": 836,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左真横から迫る刃をクトゥグアで弾き返し、真上から振り下ろしてくる刃をイタクァで受け止めた。",
   "ko_candidate": "왼쪽 옆에서 다가오는 칼날을 크투가로 튕겨내고､ 위에서 내리꽂히는 칼날을 이타콰로 받아냈다｡"
  },
  {
   "id": 38454,
   "key": "D1408ru.txt:838",
   "file": "D1408ru.txt",
   "line": 838,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃身と刃が衝突し、火花が飛び散る。",
   "ko_candidate": "총신과 칼날이 충돌하며 불꽃이 튀어 오른다｡"
  },
  {
   "id": 38455,
   "key": "D1408ru.txt:842",
   "file": "D1408ru.txt",
   "line": 842,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………！」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 38456,
   "key": "D1408ru.txt:845",
   "file": "D1408ru.txt",
   "line": 845,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その状態のまま、イタクァの引鉄を引く。",
   "ko_candidate": "그 상태 그대로 이타콰의 방아쇠를 당긴다｡"
  },
  {
   "id": 38457,
   "key": "D1408ru.txt:848",
   "file": "D1408ru.txt",
   "line": 848,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ほとんどがら空きの胸部に、弾丸が撃ち込まれた。",
   "ko_candidate": "거의 무방비 상태인 가슴에 총알이 박혔다｡"
  },
  {
   "id": 38458,
   "key": "D1408ru.txt:853",
   "file": "D1408ru.txt",
   "line": 853,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおお!?」",
   "ko_candidate": "「우오오오오오!?」"
  },
  {
   "id": 38459,
   "key": "D1408ru.txt:866",
   "file": "D1408ru.txt",
   "line": 866,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬の間を置いて、皇餓の胸部が爆発した。",
   "ko_candidate": "잠깐의 간격을 두고 황아의 가슴이 폭발했다｡"
  },
  {
   "id": 38460,
   "key": "D1408ru.txt:868",
   "file": "D1408ru.txt",
   "line": 868,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎を噴きながら、後ろ向きに皇餓は墜ちる。",
   "ko_candidate": "폭염을 내뿜으며 뒤로 황아가 떨어진다｡"
  },
  {
   "id": 38461,
   "key": "D1408ru.txt:873",
   "file": "D1408ru.txt",
   "line": 873,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを追うように墜ちながら、俺はもう一挺、クトゥグアの銃口を向けた。",
   "ko_candidate": "그것을 쫓듯이 떨어지며 나는 다른 한 자루､ 크투가의 총구를 겨눴다｡"
  },
  {
   "id": 38462,
   "key": "D1408ru.txt:876",
   "file": "D1408ru.txt",
   "line": 876,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「喰らっとけぇぇぇぇ！」",
   "ko_candidate": "「먹어라아아아아!」"
  },
  {
   "id": 38463,
   "key": "D1408ru.txt:885",
   "file": "D1408ru.txt",
   "line": 885,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マズル・フラッシュが視界を灼く。",
   "ko_candidate": "머즐 플래시가 시야를 태운다｡"
  },
  {
   "id": 38464,
   "key": "D1408ru.txt:886",
   "file": "D1408ru.txt",
   "line": 886,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声に引き続き、爆音。",
   "ko_candidate": "총성에 이어 폭음｡"
  },
  {
   "id": 38465,
   "key": "D1408ru.txt:897",
   "file": "D1408ru.txt",
   "line": 897,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発に呑み込まれ、砕け散る皇餓の右半身。",
   "ko_candidate": "폭발에 휩싸여 부서지는 황아의 오른쪽 반신｡"
  },
  {
   "id": 38466,
   "key": "D1408ru.txt:898",
   "file": "D1408ru.txt",
   "line": 898,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲と、内部の機械類と、水銀の血が、雨のように降り注いだ。",
   "ko_candidate": "장갑과 내부의 기계류와 수은의 피가 비처럼 쏟아졌다｡"
  },
  {
   "id": 38467,
   "key": "D1408ru.txt:902",
   "file": "D1408ru.txt",
   "line": 902,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 38468,
   "key": "D1408ru.txt:916",
   "file": "D1408ru.txt",
   "line": 916,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皇餓は、さっきイタクァによって凍らされた海に叩き墜とされた。",
   "ko_candidate": "황아는 아까 이타콰에 의해 얼어붙은 바다에 내리꽂혔다｡"
  },
  {
   "id": 38469,
   "key": "D1408ru.txt:917",
   "file": "D1408ru.txt",
   "line": 917,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凍った海面に無数の亀裂が走り、遂には砕けた。",
   "ko_candidate": "얼어붙은 해면에 무수한 균열이 생기더니 마침내 부서졌다｡"
  },
  {
   "id": 38470,
   "key": "D1408ru.txt:919",
   "file": "D1408ru.txt",
   "line": 919,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "罅割れから海水が溢れ出す。",
   "ko_candidate": "갈라진 틈에서 바닷물이 넘쳐흐른다｡"
  },
  {
   "id": 38471,
   "key": "D1408ru.txt:920",
   "file": "D1408ru.txt",
   "line": 920,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕けた氷塊の群れに呑み込まれ、皇餓が海へと沈んでゆく。",
   "ko_candidate": "부서진 얼음 덩어리에 휩싸여 황아가 바다로 가라앉는다｡"
  },
  {
   "id": 38472,
   "key": "D1408ru.txt:927",
   "file": "D1408ru.txt",
   "line": 927,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これでトドメだぁぁぁ！」",
   "ko_candidate": "「이걸로 마지막이다아아아!」"
  },
  {
   "id": 38473,
   "key": "D1408ru.txt:929",
   "file": "D1408ru.txt",
   "line": 929,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "シャンタクを噴かせ、突撃する勢いで、皇餓を追いかける。",
   "ko_candidate": "샨타크를 분사하며 돌격하는 기세로 황아를 쫓는다｡"
  },
  {
   "id": 38474,
   "key": "D1408ru.txt:931",
   "file": "D1408ru.txt",
   "line": 931,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔銃を手離し空にした右掌に、昇華呪法が疾走する。",
   "ko_candidate": "마총을 놓아 비운 오른손바닥에 승화주법이 질주한다｡"
  },
  {
   "id": 38475,
   "key": "D1408ru.txt:932",
   "file": "D1408ru.txt",
   "line": 932,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限熱量を生み出す術式が、兇暴な咆吼を蒼穹に轟かせた。",
   "ko_candidate": "무한열량을 만들어내는 술식이 흉포한 포효를 창공에 울려 퍼뜨렸다｡"
  },
  {
   "id": 38476,
   "key": "D1408ru.txt:935",
   "file": "D1408ru.txt",
   "line": 935,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「レムリア・インパクト！」",
   "ko_candidate": "「레무리아 임팩트!」"
  },
  {
   "id": 38477,
   "key": "D1408ru.txt:945",
   "file": "D1408ru.txt",
   "line": 945,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ウェスパシアヌス。我々も迎撃の用意を。僧院内で迎え撃つぞ」",
   "ko_candidate": "「……베스파시아누스｡ 우리도 요격 준비를｡ 수도원 안에서 맞서 싸우자」"
  },
  {
   "id": 38478,
   "key": "D1408ru.txt:950",
   "file": "D1408ru.txt",
   "line": 950,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……了解だ。了解だとも。お前の言う通りさ」 「今のデモンベインは、この手で、確かに確実に仕留めなければならん。我々、自らの手で仕留めなければならん」",
   "ko_candidate": "「아아……알겠다｡ 알겠다고｡ 네 말대로다｡ 지금의 데몬베인은 이 손으로 확실히 확실하게 잡아야 해｡ 우리가､ 우리 손으로 잡아야만 해」"
  },
  {
   "id": 38479,
   "key": "D1408ru.txt:965",
   "file": "D1408ru.txt",
   "line": 965,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――昇華！」",
   "ko_candidate": "「――승화!」"
  },
  {
   "id": 38480,
   "key": "D1408ru.txt:973",
   "file": "D1408ru.txt",
   "line": 973,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必滅の呪法が周囲の氷海も、海水をも抉った。",
   "ko_candidate": "필멸의 주법이 주변의 얼음 바다도､ 바닷물도 파냈다｡"
  },
  {
   "id": 38481,
   "key": "D1408ru.txt:978",
   "file": "D1408ru.txt",
   "line": 978,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限熱量が皇餓を昇滅させる。",
   "ko_candidate": "무한열량이 황아를 승멸시킨다｡"
  },
  {
   "id": 38482,
   "key": "D1408ru.txt:980",
   "file": "D1408ru.txt",
   "line": 980,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一切の無へと、引きずり込んでゆく。",
   "ko_candidate": "일체의 무로､ 끌어들여 간다｡"
  },
  {
   "id": 38483,
   "key": "D1408ru.txt:982",
   "file": "D1408ru.txt",
   "line": 982,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "潔癖なまでに、総てを清めてゆく。",
   "ko_candidate": "결벽할 정도로 모든 것을 정화해 간다｡"
  },
  {
   "id": 38484,
   "key": "D1408ru.txt:990",
   "file": "D1408ru.txt",
   "line": 990,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……よう。待たせたな、クトゥルー」",
   "ko_candidate": "「……이봐｡ 기다리게 했군､ 크툴루」"
  },
  {
   "id": 38485,
   "key": "D1408ru.txt:997",
   "file": "D1408ru.txt",
   "line": 997,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――――――――――――――――――！",
   "ko_candidate": "――――――――――――――――――!"
  },
  {
   "id": 38486,
   "key": "D1408ru.txt:1002",
   "file": "D1408ru.txt",
   "line": 1002,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "如何なる生物の器官でも発声できないだろう、この世のものならざる咆吼がルルイエの海に轟いた。",
   "ko_candidate": "어떤 생물의 기관으로도 발성할 수 없을 이 세상의 것이 아닌 포효가 르뤼에의 바다에 울려 퍼졌다｡"
  },
  {
   "id": 38487,
   "key": "D1408ru.txt:1004",
   "file": "D1408ru.txt",
   "line": 1004,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数キロの距離を一瞬で踏破して、クトゥルーの触腕が迫る。",
   "ko_candidate": "수 킬로미터의 거리를 순식간에 뛰어넘어 크툴루의 촉수가 다가온다｡"
  },
  {
   "id": 38488,
   "key": "D1408ru.txt:1006",
   "file": "D1408ru.txt",
   "line": 1006,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目視するよりも、耳に聴くよりも速く、吐き気を催す圧迫感に急き立てられて、シャンタクを加速させた。",
   "ko_candidate": "눈으로 보는 것보다､ 귀로 듣는 것보다 빠르게 구토를 재촉하는 압박감에 재촉되어 샨타크를 가속시켰다｡"
  },
  {
   "id": 38489,
   "key": "D1408ru.txt:1015",
   "file": "D1408ru.txt",
   "line": 1015,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "海が爆裂した。",
   "ko_candidate": "바다가 폭발했다｡"
  },
  {
   "id": 38490,
   "key": "D1408ru.txt:1016",
   "file": "D1408ru.txt",
   "line": 1016,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触腕の一つが、海面を穿ったのだ。",
   "ko_candidate": "촉수 하나가 해면을 뚫은 것이다｡"
  }
 ]
}