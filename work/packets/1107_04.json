  },
  {
   "id": 25013,
   "key": "D1107ru.txt:492",
   "file": "D1107ru.txt",
   "line": 492,
   "speaker": "ソーニャ（通信）",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そ、それと！　お、お嬢様の行方が分からないんですぅ！ さっきから連絡が取れなくって……！」",
   "ko_candidate": ""
  },
  {
   "id": 25014,
   "key": "D1107ru.txt:500",
   "file": "D1107ru.txt",
   "line": 500,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「あぁっ!?　小娘だったら其処に……」",
   "ko_candidate": ""
