   "key": "D1107ru.txt:475",
   "file": "D1107ru.txt",
   "line": 475,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「アル様ですか。敵の第２波です」",
   "ko_candidate": ""
  },
  {
   "id": 24971,
   "key": "D1107ru.txt:478",
   "file": "D1107ru.txt",
   "line": 478,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「飛行タイプの破壊ロボ１００機が、バンカーバスターによる空爆を開始しました」",
   "ko_candidate": ""
  },
  {
   "id": 24985,
   "key": "D1107ru.txt:481",
   "file": "D1107ru.txt",
   "line": 481,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「今のところ、被害は最表層で食い止めていますが……。 今後、魔力付加型爆弾を使用されると、少々辛いですね……」",
   "ko_candidate": ""
  },
  {
   "id": 25011,
   "key": "D1107ru.txt:487",
