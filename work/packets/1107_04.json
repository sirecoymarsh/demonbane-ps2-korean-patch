   "key": "D1107ru.txt:503",
   "file": "D1107ru.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "振り返って、思考が麻痺する。",
   "ko_candidate": ""
  },
  {
   "id": 25034,
   "key": "D1107ru.txt:504",
