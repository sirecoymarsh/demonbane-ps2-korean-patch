   "ko_candidate": ""
  },
  {
   "id": 24940,
   "key": "D1107ru.txt:464",
   "file": "D1107ru.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アルは、苦労しながらも立ち上がり、壁際に設置されている通信機に急いだ。",
   "ko_candidate": ""
  },
  {
   "id": 24948,
   "key": "D1107ru.txt:470",
