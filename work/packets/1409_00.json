{
 "packet": "1409_00",
 "scene": "1409",
 "anchor": {
  "hit": 10,
  "total": 11,
  "rate": 0.909
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "イタクァ": "이타콰",
  "メタトロン": "메타트론",
  "サンダルフォン": "산달폰"
 },
 "items": [
  {
   "id": 38533,
   "key": "D1409al.txt:6",
   "file": "D1409al.txt",
   "line": 6,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大洋を戦火で灼きながら、人類と邪神の眷属との凄絶な戦いは続いていた。",
   "ko_candidate": "대양을 전화로 태우며､ 인류와 사신의 권속과의 처절한 싸움은 계속되고 있었다｡"
  },
  {
   "id": 38534,
   "key": "D1409al.txt:7",
   "file": "D1409al.txt",
   "line": 7,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砲撃が幾度も海を震撼させ、瘴気が幾度となく海を犯す。",
   "ko_candidate": "포격이 몇 번이고 바다를 뒤흔들고､ 장기가 수차례 바다를 범한다｡"
  },
  {
   "id": 38535,
   "key": "D1409al.txt:9",
   "file": "D1409al.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緑色の血と、重油で穢れた海。",
   "ko_candidate": "녹색 피와 중유로 더럽혀진 바다｡"
  },
  {
   "id": 38536,
   "key": "D1409al.txt:10",
   "file": "D1409al.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎で灼かれ、爆煙に覆われた空。",
   "ko_candidate": "폭염에 타오르고 폭연에 뒤덮인 하늘｡"
  },
  {
   "id": 38537,
   "key": "D1409al.txt:11",
   "file": "D1409al.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "断末魔の絶叫と、爆音に震える大気。",
   "ko_candidate": "단말마의 절규와 폭음에 떨리는 대기｡"
  },
  {
   "id": 38538,
   "key": "D1409al.txt:13",
   "file": "D1409al.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂気と憎悪と嘲笑と恐怖と誇りと勇気と怒りと絶望と決意と嗜虐と自虐と慟哭と――あらゆる光輝と闇黒を撒き散らす魂。",
   "ko_candidate": "광기와 증오와 조소와 공포와 긍지와 용기와 분노와 절망과 결의와 시학과 자학과 통곡과―― 온갖 광휘와 암흑을 뿌리는 영혼｡"
  },
  {
   "id": 38539,
   "key": "D1409al.txt:14",
   "file": "D1409al.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地球を賭した最終戦争。",
   "ko_candidate": "지구를 건 최종전쟁｡"
  },
  {
   "id": 38540,
   "key": "D1409al.txt:20",
   "file": "D1409al.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その戦火の只中、だが僅かな、束の間の時間だけ、偶然にも平穏が訪れた、まるで凪の様な氷海。イタクァの力が氷結させた海に浮かぶ、一つの流氷の上に、昏き天使が降り立つ。",
   "ko_candidate": "그 전화의 한가운데､ 하지만 잠깐의 짧은 시간만､ 우연히도 평온이 찾아온､ 마치 바람 없는 듯한 얼음 바다｡ 이타콰의 힘이 얼려버린 바다에 떠 있는､ 하나의 유빙 위에､ 어두운 천사가 내려선다｡"
  },
  {
   "id": 38541,
   "key": "D1409al.txt:26",
   "file": "D1409al.txt",
   "line": 26,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 38542,
   "key": "D1409al.txt:29",
   "file": "D1409al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天使には静かに待つ。",
   "ko_candidate": "천사는 조용히 기다린다｡"
  },
  {
   "id": 38543,
   "key": "D1409al.txt:30",
   "file": "D1409al.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦いの趨勢など、彼には何の意味も持たない。",
   "ko_candidate": "싸움의 형세 따위는 그에게 아무런 의미도 없다｡"
  },
  {
   "id": 38544,
   "key": "D1409al.txt:31",
   "file": "D1409al.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼にとって意味があるのは、唯一つ――",
   "ko_candidate": "그에게 의미가 있는 것은 단 하나――"
  },
  {
   "id": 38545,
   "key": "D1409al.txt:35",
   "file": "D1409al.txt",
   "line": 35,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やはりな」",
   "ko_candidate": "「역시나」"
  },
  {
   "id": 38546,
   "key": "D1409al.txt:48",
   "file": "D1409al.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な水飛沫が迸った。",
   "ko_candidate": "거대한 물보라가 튀었다｡"
  },
  {
   "id": 38547,
   "key": "D1409al.txt:49",
   "file": "D1409al.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一匹の海魔が天使の前に姿を現した。",
   "ko_candidate": "한 마리의 바다괴물이 천사 앞에 모습을 드러냈다｡"
  },
  {
   "id": 38548,
   "key": "D1409al.txt:50",
   "file": "D1409al.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全長３００メートルに達するその巨体に比べ、天使は余りにも小さい。",
   "ko_candidate": "전장 100미터에 달하는 그 거체에 비해 천사는 너무나 작다｡"
  },
  {
   "id": 38549,
   "key": "D1409al.txt:52",
   "file": "D1409al.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "海魔が雄叫びを上げる。",
   "ko_candidate": "바다괴물이 포효를 내지른다｡"
  },
  {
   "id": 38550,
   "key": "D1409al.txt:53",
   "file": "D1409al.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒波を引き連れ、天使の頭上を覆い尽くし、邪神の眷属は迫る。",
   "ko_candidate": "거센 파도를 이끌고 천사의 머리 위를 뒤덮으며 사신의 권속이 다가온다｡"
  },
  {
   "id": 38551,
   "key": "D1409al.txt:55",
   "file": "D1409al.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、天使は動かない。",
   "ko_candidate": "하지만 천사는 움직이지 않는다｡"
  },
  {
   "id": 38552,
   "key": "D1409al.txt:56",
   "file": "D1409al.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ静かに、呟く。",
   "ko_candidate": "그저 조용히 중얼거린다｡"
  },
  {
   "id": 38553,
   "key": "D1409al.txt:57",
   "file": "D1409al.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呟きは、雄叫びに掻き消される事なく、やけにはっきりと響いた。",
   "ko_candidate": "중얼거림은 포효에 묻히지 않고 유독 또렷이 울렸다｡"
  },
  {
   "id": 38554,
   "key": "D1409al.txt:61",
   "file": "D1409al.txt",
   "line": 61,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「来たか、メタトロン」",
   "ko_candidate": "「왔느냐､ 메타트론」"
  },
  {
   "id": 38555,
   "key": "D1409al.txt:71",
   "file": "D1409al.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雄叫びが断末魔となった。",
   "ko_candidate": "포효가 단말마가 되었다｡"
  },
  {
   "id": 38556,
   "key": "D1409al.txt:72",
   "file": "D1409al.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の光が海魔の顔面に降り注ぎ、貫いた。",
   "ko_candidate": "무수한 빛이 바다괴물의 얼굴에 쏟아져 꿰뚫었다｡"
  },
  {
   "id": 38557,
   "key": "D1409al.txt:73",
   "file": "D1409al.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "海魔の貌が爆ぜる。",
   "ko_candidate": "바다괴물의 얼굴이 터진다｡"
  },
  {
   "id": 38558,
   "key": "D1409al.txt:74",
   "file": "D1409al.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緑色の汚液を撒き散らし、異形は海に還る。",
   "ko_candidate": "녹색 오액을 뿌리며 기괴한 모습은 바다로 돌아간다｡"
  },
  {
   "id": 38559,
   "key": "D1409al.txt:79",
   "file": "D1409al.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "海魔の頭上。",
   "ko_candidate": "바다괴물의 머리 위｡"
  },
  {
   "id": 38560,
   "key": "D1409al.txt:80",
   "file": "D1409al.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い天使が居た。",
   "ko_candidate": "하얀 천사가 있었다｡"
  },
  {
   "id": 38561,
   "key": "D1409al.txt:84",
   "file": "D1409al.txt",
   "line": 84,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やはり、此処に来ていたのだな。サンダルフォン」",
   "ko_candidate": "「역시 여기 와 있었구나｡ 산달폰」"
  },
  {
   "id": 38562,
   "key": "D1409al.txt:88",
   "file": "D1409al.txt",
   "line": 88,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あの時は妙な邪魔が入ったが――」",
   "ko_candidate": "「그때는 이상한 방해가 들어왔지만――」"
  },
  {
   "id": 38563,
   "key": "D1409al.txt:95",
   "file": "D1409al.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "流氷の上、サンダルフォンが天地上下の構えを取った。",
   "ko_candidate": "유빙 위､ 산달폰이 천지상하의 자세를 취했다｡"
  },
  {
   "id": 38564,
   "key": "D1409al.txt:99",
   "file": "D1409al.txt",
   "line": 99,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度こそ決着だ」",
   "ko_candidate": "「이번엔 결판을 내자」"
  },
  {
   "id": 38565,
   "key": "D1409al.txt:107",
   "file": "D1409al.txt",
   "line": 107,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 38566,
   "key": "D1409al.txt:112",
   "file": "D1409al.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い天使は黙って、２本の光の刃を十字に重ねる。",
   "ko_candidate": "하얀 천사는 말없이 2개의 빛의 칼날을 십자로 겹친다｡"
  },
  {
   "id": 38567,
   "key": "D1409al.txt:117",
   "file": "D1409al.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かに高まる闘志と殺意。",
   "ko_candidate": "조용히 고조되는 투지와 살의｡"
  },
  {
   "id": 38568,
   "key": "D1409al.txt:118",
   "file": "D1409al.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空気の濃度が変わる。",
   "ko_candidate": "공기의 농도가 바뀐다｡"
  },
  {
   "id": 38569,
   "key": "D1409al.txt:119",
   "file": "D1409al.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "流氷に亀裂が生じる。",
   "ko_candidate": "유빙에 균열이 생긴다｡"
  },
  {
   "id": 38570,
   "key": "D1409al.txt:127",
   "file": "D1409al.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾る。",
   "ko_candidate": "달린다｡"
  },
  {
   "id": 38571,
   "key": "D1409al.txt:135",
   "file": "D1409al.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾る。",
   "ko_candidate": "달린다｡"
  },
  {
   "id": 38572,
   "key": "D1409al.txt:143",
   "file": "D1409al.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "十字の閃が瞬いた。",
   "ko_candidate": "십자의 섬광이 번쩍였다｡"
  }
 ]
}