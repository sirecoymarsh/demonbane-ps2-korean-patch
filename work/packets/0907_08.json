  {
   "id": 19661,
   "key": "D0907le.txt:1530",
   "file": "D0907le.txt",
   "line": 1530,
   "speaker": "信徒３",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大導師様っ!? 大導師様……ッ！」 神の肉は『夢幻心母』の一切と絡み合い、繋がれ、結ばれ、融け合い、形成されてゆく。",
   "ko_candidate": "「<RUBY text=\"그랜드 마스터\">대도사</RUBY>님!? <RUBY text=\"그랜드 마스터\">대도사</RUBY>님…!」"
  },
  {
   "id": 19662,
   "key": "D0907le.txt:1544",
   "file": "D0907le.txt",
   "line": 1544,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "神の血、神の腑、神の骨、神の肢、神の躰、神の眸、神の貌。 なおも肥大し、膨張する。",
   "ko_candidate": "신의 살은 『몽환심모』의 모든 것과 얽히고､ 연결되고､ 맺어지고､ 녹아들어､ 형성되어 간다｡"
  },
  {
   "id": 19663,
   "key": "D0907le.txt:1559",
   "file": "D0907le.txt",
   "line": 1559,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『我、埋葬にあたわず』！」 「くっ……切りがないロボ！ 博士っ！」",
   "ko_candidate": "신의 피､ 신의 내장､ 신의 뼈､ 신의 사지､ 신의 몸､ 신의 눈동자､ 신의 얼굴｡"
  },
  {
   "id": 19664,
   "key": "D0907le.txt:1574",
   "file": "D0907le.txt",
   "line": 1574,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うぷ……うげええええええええええっ！」",
   "ko_candidate": "더욱 비대해지고､ 팽창한다｡ 「『나､ 매장할 수 없노라』!」"
  },
  {
   "id": 19665,
   "key": "D0907le.txt:1579",
   "file": "D0907le.txt",
   "line": 1579,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわっ！　汚ぇロボ！　こんなときにどーしたロボ、博士!?」",
   "ko_candidate": "「큿… 끝이 없로봇! 박사!」 「우푸… 우게에에에에에에에에엑!」"
  },
  {
   "id": 19666,
   "key": "D0907le.txt:1584",
   "file": "D0907le.txt",
   "line": 1584,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うぷっ…… だ、大丈夫である…… ただ邪気にやられただけである」",
   "ko_candidate": "「우와! 더럽로봇! 이런 때에 왜 그러로봇､ 박사!?」"
  },
  {
   "id": 19667,
   "key": "D0907le.txt:1591",
   "file": "D0907le.txt",
   "line": 1591,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だが……こんなものが……こんなおぞましいものが『Ｃ計画』の正体なのであるか……っ！」",
   "ko_candidate": "「우풉… 괜､ 괜찮다… 그저 사기에 당했을 뿐이다｡ 하지만… 이런 것이… 이런 끔찍한 것이 『C계획』의 정체였단 말인가…!」 그렇다､ 그러하다｡"
  },
  {
   "id": 19668,
   "key": "D0907le.txt:1604",
   "file": "D0907le.txt",
   "line": 1604,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "是、也。",
   "ko_candidate": "기괴한 신｡"
  },
  {
   "id": 19669,
   "key": "D0907le.txt:1606",
   "file": "D0907le.txt",
   "line": 1606,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
