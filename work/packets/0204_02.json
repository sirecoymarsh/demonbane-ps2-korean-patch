   "line": 630,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "や、やりやがったよ……こいつ。",
   "ko_candidate": "용서 없는 마력파의 일격이 폭발한다｡"
