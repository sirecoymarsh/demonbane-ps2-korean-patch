 },
 "items": [
  {
   "id": 29138,
   "key": "D1210al.txt:591",
   "file": "D1210al.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の刃が迸った。",
   "ko_candidate": "빛의 칼날이 튀어올랐다｡"
  },
  {
   "id": 29139,
   "key": "D1210al.txt:592",
   "file": "D1210al.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の拳が爆ぜた。",
   "ko_candidate": "어둠의 주먹이 터졌다｡"
  },
  {
   "id": 29140,
   "key": "D1210al.txt:594",
   "file": "D1210al.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃が世界を激震させる。",
   "ko_candidate": "충격이 세계를 격렬하게 흔든다｡"
  },
  {
   "id": 29141,
   "key": "D1210al.txt:609",
   "file": "D1210al.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天空。『夢幻心母』内部。",
   "ko_candidate": "천공｡ 『몽환심모』 내부｡"
  },
  {
   "id": 29142,
   "key": "D1210al.txt:614",
   "file": "D1210al.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の閃の粒子が集まり、爆裂した。",
   "ko_candidate": "무수한 섬광의 입자가 모여 폭발했다｡"
  },
  {
   "id": 29143,
   "key": "D1210al.txt:615",
   "file": "D1210al.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昏い空間を、白く塗り潰す。",
   "ko_candidate": "어두운 공간을､ 하얗게 덮어버린다｡"
  },
  {
   "id": 29144,
   "key": "D1210al.txt:620",
   "file": "D1210al.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な神殿の如き鬼械の神が光の中に聳えた。",
   "ko_candidate": "거대한 신전과 같은 귀계의 신이 빛 속에 우뚝 솟았다｡"
  },
  {
   "id": 29145,
   "key": "D1210al.txt:621",
   "file": "D1210al.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無銘の神。",
   "ko_candidate": "무명의 신｡"
  },
  {
   "id": 29146,
   "key": "D1210al.txt:626",
   "file": "D1210al.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その頭頂部。少女は変わらず、其処に立っていた。",
   "ko_candidate": "그 정상부｡ 소녀는 변함없이､ 그곳에 서 있었다｡"
  },
  {
   "id": 29147,
   "key": "D1210al.txt:635",
   "file": "D1210al.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女を呪縛する拘束具が、 魔導書の頁となって解けてゆく。",
   "ko_candidate": "소녀를 속박하는 구속구가､ 마도서의 페이지가 되어 풀려간다｡"
  },
  {
   "id": 29148,
   "key": "D1210al.txt:637",
   "file": "D1210al.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "晒される少女の裸身。",
   "ko_candidate": "드러나는 소녀의 나체｡"
  },
  {
   "id": 29149,
   "key": "D1210al.txt:638",
   "file": "D1210al.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紙片は容を変え、細い糸状となり、幾重にも幾重にも絡まって、服を編み上げていく。",
   "ko_candidate": "종이 조각은 모습을 바꾸어 가는 실이 되어､ 겹겹이 겹겹이 얽혀､ 옷을 짜올린다｡"
  },
  {
   "id": 29150,
   "key": "D1210al.txt:647",
   "file": "D1210al.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎が少女に買ってやった服。",
   "ko_candidate": "다이쥬지 쿠로가 소녀에게 사준 옷｡"
  },
  {
   "id": 29151,
   "key": "D1210al.txt:648",
   "file": "D1210al.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エンネアと云う少女に買ってやった服。",
   "ko_candidate": "엔네아라는 소녀에게 사준 옷｡"
  },
  {
   "id": 29152,
   "key": "D1210al.txt:649",
   "file": "D1210al.txt",
   "line": 649,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女らしい、可愛らしい洋服は、邪気と瘴気、狂気に穢れたこの空間には、酷く不釣合いだった。",
   "ko_candidate": "소녀다운､ 귀여운 양복은､ 사기와 장기､ 광기로 더럽혀진 이 공간에는､ 너무나 어울리지 않았다｡"
  },
  {
   "id": 29153,
   "key": "D1210al.txt:653",
   "file": "D1210al.txt",
   "line": 653,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あどけない少女の顔を、昏い愉悦に歪ませて、エンネアは――暴君ネロは囁く。",
   "ko_candidate": "천진한 소녀의 얼굴을､ 어두운 환희로 일그러뜨리며､ 엔네아는――폭군 네로는 속삭인다｡"
  },
  {
   "id": 29154,
   "key": "D1210al.txt:657",
   "file": "D1210al.txt",
   "line": 657,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ、これからが、 これからこそが本当の始まり」 「ここからは運命の中心に立つ、 ネロたちのための物語」",
   "ko_candidate": "「자､ 이제부터가､ 이제부터야말로 진정한 시작｡ 여기서부터는 운명의 중심에 선､ 네로들을 위한 이야기｡ 무대에 어울리지 않는 서투른 배우는 물러나 있어야겠지､ 아우구스투스!」"
  },
  {
   "id": 29155,
   "key": "D1210al.txt:665",
   "file": "D1210al.txt",
   "line": 665,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「舞台に相応しくない 大根役者は引っ込んでいることね、 アウグストゥス！」",
   "ko_candidate": "【File12:THE HUNT】closed<PRE>. 「또 그걸 포효하는가!」"
  },
  {
   "id": 29156,
   "key": "D1210le.txt:17",
   "file": "D1210le.txt",
   "line": 17,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「またそれを吼えるか！」 サンダルフォンが疾る。",
   "ko_candidate": "산달폰이 질주한다｡"
  },
  {
   "id": 29157,
   "key": "D1210le.txt:27",
   "file": "D1210le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い風と化す。",
   "ko_candidate": "검은 바람으로 변한다｡"
  },
  {
   "id": 29158,
   "key": "D1210le.txt:28",
   "file": "D1210le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迫り来る黒い風に、一閃。メタトロンのサーベルが迅る。",
   "ko_candidate": "다가오는 검은 바람에､ 일섬｡ 메타트론의 세이버가 번쩍인다｡"
  },
  {
   "id": 29159,
   "key": "D1210le.txt:37",
   "file": "D1210le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サーベルと拳が正面からぶつかり合った。",
   "ko_candidate": "세이버와 주먹이 정면으로 부딪쳤다｡"
  },
  {
   "id": 29160,
   "key": "D1210le.txt:38",
   "file": "D1210le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームが烈光となって砕ける。",
   "ko_candidate": "빔이 열광으로 변해 부서진다｡"
  },
  {
   "id": 29161,
   "key": "D1210le.txt:40",
   "file": "D1210le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームサーベルはサンダルフォンの拳を断ち斬るには足りない。",
   "ko_candidate": "빔 세이버는 산달폰의 주먹을 베어내기에 부족하다｡"
  },
  {
   "id": 29162,
   "key": "D1210le.txt:41",
   "file": "D1210le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかしサンダルフォンの拳もまた、ビームサーベルの威力を散らすには足りない。",
   "ko_candidate": "하지만 산달폰의 주먹 또한 빔 세이버의 위력을 흩뜨리기에는 부족하다｡"
  },
  {
   "id": 29163,
   "key": "D1210le.txt:42",
   "file": "D1210le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれ合う２人。",
   "ko_candidate": "튕겨져 나가는 두 사람｡"
  },
  {
   "id": 29164,
   "key": "D1210le.txt:47",
   "file": "D1210le.txt",
   "line": 47,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だが貴様に朝は無い。悪夢に抱かれて滅びろ！」",
   "ko_candidate": "「하지만 네놈에겐 아침이 없다｡ 악몽에 휩싸여 멸망하라!」"
  },
  {
   "id": 29165,
   "key": "D1210le.txt:52",
   "file": "D1210le.txt",
   "line": 52,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハァァァァッ！」",
   "ko_candidate": "「하아아아아앗!」"
  },
  {
   "id": 29166,
   "key": "D1210le.txt:56",
   "file": "D1210le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逆袈裟に振り上げられるビームサーベル。",
   "ko_candidate": "역게사로 들어 올려지는 빔 세이버｡"
  },
  {
   "id": 29167,
   "key": "D1210le.txt:57",
   "file": "D1210le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンは半身を引くだけで、それをかわす。",
   "ko_candidate": "산달폰은 반신을 뒤로 빼는 것만으로 그것을 피한다｡"
  },
  {
   "id": 29168,
   "key": "D1210le.txt:60",
   "file": "D1210le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "袈裟斬り。戻して振り下ろされる。",
   "ko_candidate": "게사베기｡ 되돌려 내리치는｡"
  },
  {
   "id": 29169,
   "key": "D1210le.txt:61",
   "file": "D1210le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳の甲で受け止め、弾く。",
   "ko_candidate": "주먹등으로 받아내고､ 튕겨낸다｡"
  },
  {
   "id": 29170,
   "key": "D1210le.txt:63",
   "file": "D1210le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "体勢を崩すメタトロン。そこに放たれるサンダルフォンの貫手。",
   "ko_candidate": "자세가 무너지는 메타트론｡ 거기에 날아드는 산달폰의 관수｡"
  },
  {
   "id": 29171,
   "key": "D1210le.txt:64",
   "file": "D1210le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾く、無言にメタトロンの咽喉笛に滑り込む。",
   "ko_candidate": "빠르게､ 무언으로 메타트론의 목구멍으로 미끄러져 들어간다｡"
  },
  {
   "id": 29172,
   "key": "D1210le.txt:66",
   "file": "D1210le.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間髪、回避。",
   "ko_candidate": "찰나､ 회피｡"
  },
  {
   "id": 29173,
   "key": "D1210le.txt:67",
   "file": "D1210le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い仮面の頬を削る貫手。",
   "ko_candidate": "하얀 가면의 뺨을 스치는 관수｡"
  },
  {
   "id": 29174,
   "key": "D1210le.txt:70",
   "file": "D1210le.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの躰を蹴飛ばし、その反動で後方に飛び退く。",
   "ko_candidate": "산달폰의 몸을 걷어차고､ 그 반동으로 뒤로 날아간다｡"
  },
  {
   "id": 29175,
   "key": "D1210le.txt:71",
   "file": "D1210le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンもまた自ら後方に跳んで、蹴りの衝撃を逃す。",
   "ko_candidate": "산달폰 또한 스스로 뒤로 뛰어 차기의 충격을 피한다｡"
  },
  {
   "id": 29176,
   "key": "D1210le.txt:79",
   "file": "D1210le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お互い、着地と同時に敵に向かって飛び込む。",
   "ko_candidate": "서로､ 착지와 동시에 적을 향해 뛰어든다｡"
  },
  {
   "id": 29177,
   "key": "D1210le.txt:83",
   "file": "D1210le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斬撃。斬撃。斬撃。斬撃。斬撃。",
   "ko_candidate": "참격｡ 참격｡ 참격｡ 참격｡ 참격｡"
  }
 ]
}