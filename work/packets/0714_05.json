 },
 "items": [
  {
   "id": 10872,
   "key": "D0714.txt:1661",
   "file": "D0714.txt",
   "line": 1661,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "太陽が、爆ぜた。",
   "ko_candidate": "태양이､ 터져버렸다｡"
  },
  {
   "id": 10873,
   "key": "D0714.txt:1664",
   "file": "D0714.txt",
   "line": 1664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "砕け散る光が縦横無尽に暴れ回り、インスマウスの海を蹂躙する。",
   "ko_candidate": "부서져 흩어지는 빛이 종횡무진으로 날뛰며､ 인스머스의 바다를 유린한다｡"
  },
  {
   "id": 10874,
   "key": "D0714.txt:1670",
   "file": "D0714.txt",
   "line": 1670,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――始まった」",
   "ko_candidate": "「――시작됐어」"
  },
  {
   "id": 10875,
   "key": "D0714.txt:1676",
   "file": "D0714.txt",
   "line": 1676,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆音轟く海に、詩が響き渡る。",
   "ko_candidate": "폭음이 울리는 바다에､ 시가 울려 퍼진다｡"
  },
  {
   "id": 10876,
   "key": "D0714.txt:1677",
   "file": "D0714.txt",
   "line": 1677,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "地球上の如何なる言語にも属さない言葉。",
   "ko_candidate": "지구상의 어떤 언어에도 속하지 않는 말｡"
  },
  {
   "id": 10877,
   "key": "D0714.txt:1680",
   "file": "D0714.txt",
   "line": 1680,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "呪力が込められた、異界の詩が。",
   "ko_candidate": "주력이 담긴､ 이계의 시가｡"
  },
  {
   "id": 10878,
   "key": "D0714.txt:1681",
   "file": "D0714.txt",
   "line": 1681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "秘められた力を解き放つために。",
   "ko_candidate": "숨겨진 힘을 풀어내기 위해｡"
  },
  {
   "id": 10879,
   "key": "D0714.txt:1700",
   "file": "D0714.txt",
   "line": 1700,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――フングルイ　ムグルウナフ クトゥグア　フォマルハウト……",
   "ko_candidate": "――프응그르이､ 므그르우나프､ 크투가､ 포말하우트……"
  },
  {
   "id": 10880,
   "key": "D0714.txt:1721",
   "file": "D0714.txt",
   "line": 1721,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――気温が急激に上昇した。",
   "ko_candidate": "――기온이 급격히 상승했다｡"
  },
  {
   "id": 10881,
   "key": "D0714.txt:1724",
   "file": "D0714.txt",
   "line": 1724,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まず、雨が止まった。",
   "ko_candidate": "우선､ 비가 멈췄다｡"
  },
  {
   "id": 10882,
   "key": "D0714.txt:1725",
   "file": "D0714.txt",
   "line": 1725,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "気温が高過ぎて、蒸発してしまうからだ。",
   "ko_candidate": "기온이 너무 높아서､ 비가 증발해 버리기 때문이다｡"
  },
  {
   "id": 10883,
   "key": "D0714.txt:1736",
   "file": "D0714.txt",
   "line": 1736,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "すぐに大気が帯電した。デモンベインとゴンドラを取り囲んで、雷光が乱舞する。",
   "ko_candidate": "곧 대기가 대전되었다｡ 데몬베인과 곤드라를 둘러싸고､ 번개가 난무한다｡"
  },
  {
   "id": 10884,
   "key": "D0714.txt:1739",
   "file": "D0714.txt",
   "line": 1739,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ゴンドラが慄くように身を震わせたように見えた。",
   "ko_candidate": "곤드라가 전율하듯 몸을 떠는 것이 보였다｡"
  },
  {
   "id": 10885,
   "key": "D0714.txt:1743",
   "file": "D0714.txt",
   "line": 1743,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして――雷光は瞬く間に、閃光となって世界を灼いた。",
   "ko_candidate": "그리고――번개는 순식간에､ 섬광이 되어 세계를 태웠다｡"
  },
  {
   "id": 10886,
   "key": "D0714.txt:1768",
   "file": "D0714.txt",
   "line": 1768,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 10887,
   "key": "D0714.txt:1771",
   "file": "D0714.txt",
   "line": 1771,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白く染まる視界に、灼け爛れ、融解してゆく大地の姿を見た。",
   "ko_candidate": "하얗게 물든 시야에､ 타들어가고､ 녹아내리는 대지의 모습을 보았다｡"
  },
  {
   "id": 10888,
   "key": "D0714.txt:1774",
   "file": "D0714.txt",
   "line": 1774,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まさか……これほどのものとは……ッ！",
   "ko_candidate": "설마……이 정도일 줄이야……!"
  },
  {
   "id": 10889,
   "key": "D0714.txt:1778",
   "file": "D0714.txt",
   "line": 1778,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今度こそゴンドラが身をねじり、暴れた。",
   "ko_candidate": "이번에야말로 곤드라가 몸을 비틀며､ 날뛰었다｡"
  },
  {
   "id": 10890,
   "key": "D0714.txt:1779",
   "file": "D0714.txt",
   "line": 1779,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "全身から緑色の蒸気を発する。 血が沸騰しているのだ。",
   "ko_candidate": "온몸에서 녹색 증기를 내뿜는다｡ 피가 끓어오르고 있는 것이다｡"
  },
  {
   "id": 10891,
   "key": "D0714.txt:1783",
   "file": "D0714.txt",
   "line": 1783,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "海魔の絶叫は、爆音に掻き消されて聴こえない。",
   "ko_candidate": "바다괴물의 절규는､ 폭음에 묻혀 들리지 않는다｡"
  },
  {
   "id": 10892,
   "key": "D0714.txt:1790",
   "file": "D0714.txt",
   "line": 1790,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ンガア・グア、 ナフルタグン……」",
   "ko_candidate": "「은가아-그아､ 나프르타근……」"
  },
  {
   "id": 10893,
   "key": "D0714.txt:1802",
   "file": "D0714.txt",
   "line": 1802,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、視た。",
   "ko_candidate": "그리고､ 보았다｡"
  },
  {
   "id": 10894,
   "key": "D0714.txt:1803",
   "file": "D0714.txt",
   "line": 1803,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白い闇に覆われていく世界で。",
   "ko_candidate": "하얀 어둠에 뒤덮여가는 세계에서｡"
  },
  {
   "id": 10895,
   "key": "D0714.txt:1817",
   "file": "D0714.txt",
   "line": 1817,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインと海魔の間に、白い焔を纏う獣が、実体を結ぶのを。",
   "ko_candidate": "데몬베인과 바다괴물 사이에､ 하얀 불꽃을 두른 짐승이､ 실체를 이루는 것을｡"
  },
  {
   "id": 10896,
   "key": "D0714.txt:1821",
   "file": "D0714.txt",
   "line": 1821,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "静かに佇む獣は、荘厳で圧倒的な神気を隠す事なく、迸らせていた。",
   "ko_candidate": "조용히 서 있는 짐승은､ 장엄하고 압도적인 신기를 숨김없이､ 뿜어내고 있었다｡"
  },
  {
   "id": 10897,
   "key": "D0714.txt:1824",
   "file": "D0714.txt",
   "line": 1824,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これが、まさか――",
   "ko_candidate": "이것이､ 설마――"
  },
  {
   "id": 10898,
   "key": "D0714.txt:1830",
   "file": "D0714.txt",
   "line": 1830,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――イア！　クトゥグア！」",
   "ko_candidate": "「――이야! 크투가!」"
  },
  {
   "id": 10899,
   "key": "D0714.txt:1844",
   "file": "D0714.txt",
   "line": 1844,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白く焔える獣が奔った。",
   "ko_candidate": "하얗게 불타오르는 짐승이 달려들었다｡"
  },
  {
   "id": 10900,
   "key": "D0714.txt:1845",
   "file": "D0714.txt",
   "line": 1845,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "獣の顎が、海魔を捉えた。",
   "ko_candidate": "짐승의 턱이､ 바다괴물을 포착했다｡"
  },
  {
   "id": 10901,
   "key": "D0714.txt:1873",
   "file": "D0714.txt",
   "line": 1873,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆ぜた。",
   "ko_candidate": "터져버렸다｡"
  },
  {
   "id": 10902,
   "key": "D0714.txt:1875",
   "file": "D0714.txt",
   "line": 1875,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一瞬だった。",
   "ko_candidate": "순간이었다｡"
  },
  {
   "id": 10903,
   "key": "D0714.txt:1877",
   "file": "D0714.txt",
   "line": 1877,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "海魔の躰が融解し、沸騰し、蒸発した。",
   "ko_candidate": "바다괴물의 몸이 녹아내리고､ 끓어오르고､ 증발했다｡"
  },
  {
   "id": 10904,
   "key": "D0714.txt:1879",
   "file": "D0714.txt",
   "line": 1879,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一片の慈悲もなく、圧倒的な熱量は存在自身を灼き払う。あまりにも単純で純粋な、破壊のエネルギー。",
   "ko_candidate": "일말의 자비도 없이､ 압도적인 열량은､ 그 자신의 존재를 유린해 버린다｡ 너무나도 단순하고 순수한､ 파괴의 에너지｡"
  },
  {
   "id": 10905,
   "key": "D0714.txt:1891",
   "file": "D0714.txt",
   "line": 1891,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の精神が限界に達した。",
   "ko_candidate": "내 정신이 한계에 도달했다｡"
  },
  {
   "id": 10906,
   "key": "D0714.txt:1892",
   "file": "D0714.txt",
   "line": 1892,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白の視界が、意識が、爆ぜる。",
   "ko_candidate": "하얀 시야가､ 의식이､ 터져버린다｡"
  },
  {
   "id": 10907,
   "key": "D0714.txt:1895",
   "file": "D0714.txt",
   "line": 1895,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "クトゥグアの熱はデモンベインにも及ぶ。",
   "ko_candidate": "마지막으로 본 것은､ 녹아내리는 데몬베인의 팔｡"
  },
  {
   "id": 10908,
   "key": "D0714.txt:1898",
   "file": "D0714.txt",
   "line": 1898,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "最後に見たのは、熔け落ちるデモンベインの腕。",
   "ko_candidate": "크투가의 열기는 데몬베인에도 미친다｡"
  },
  {
   "id": 10909,
   "key": "D0714.txt:1911",
   "file": "D0714.txt",
   "line": 1911,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――灼熱が総てを舐めてゆく。",
   "ko_candidate": "작열이 모든 것을 핥아간다｡"
  },
  {
   "id": 10910,
   "key": "D0714.txt:1937",
   "file": "D0714.txt",
   "line": 1937,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はは……こいつは…… 凄いものを見たなあ」",
   "ko_candidate": "――어둠만이､ 남았다｡ 「하하……이건……대단한 걸 봤군」"
  },
  {
   "id": 10911,
   "key": "D0714.txt:1944",
   "file": "D0714.txt",
   "line": 1944,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "薄っすらと冷汗を流し、ウェスパシアヌスは呟いた。",
   "ko_candidate": "희미하게 식은땀을 흘리며､ 베스파시아누스는 중얼거렸다｡"
  }
 ]
}