 "items": [
  {
   "id": 26949,
   "key": "D1203le.txt:15",
   "file": "D1203le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鮮血が通路の壁を染め上げる。",
   "ko_candidate": "흩뿌려진 선혈이 통로의 벽을 물들인다｡"
  },
  {
   "id": 26950,
   "key": "D1203le.txt:16",
   "file": "D1203le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "角を曲がった先の惨劇を見て、俺は思わずうめいた。",
   "ko_candidate": "모퉁이를 돌아 마주한 참극을 보고 나는 무심코 신음했다｡"
  },
  {
   "id": 26951,
   "key": "D1203le.txt:18",
   "file": "D1203le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こみ上げる吐き気を、なんとか抑える。",
   "ko_candidate": "위액이 치밀어 오르려는 것을 간신히 억누른다｡"
  },
  {
   "id": 26952,
   "key": "D1203le.txt:19",
   "file": "D1203le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吐き気が治まると、次に襲ってきたのは怒りだった。",
   "ko_candidate": "시체가 쌓이고 피가 강을 이루는 광경이 바로 이런 것인가｡"
  },
  {
   "id": 26953,
   "key": "D1203le.txt:21",
   "file": "D1203le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は惨劇の中心に立つ少年に向かって叫んだ。",
   "ko_candidate": "통로는 피바다에 잠겼고､ 인간이었던 파편들이 사방에 흩어져 있다｡"
  },
  {
   "id": 26954,
   "key": "D1203le.txt:28",
   "file": "D1203le.txt",
   "line": 28,
   "speaker": "九郎 / クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クラウディウス！」 「!? 来やがったな大十字九郎ッ！」",
   "ko_candidate": "수차례 토막 나고 해체된 팔과 다리､ 목과 내장､ 뼈들이 떠다니고 있다｡"
  },
  {
   "id": 26955,
   "key": "D1203le.txt:38",
   "file": "D1203le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一際、濃厚な血臭が鼻腔の奥を突く。",
   "ko_candidate": "벽에도 살점이 달라붙어 피의 선을 그리며 미끄러져 내린다｡"
  },
  {
   "id": 26956,
   "key": "D1203le.txt:39",
   "file": "D1203le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血の霧を纏わりつかせ、血風となったカマイタチが迫っていた。",
   "ko_candidate": "구토감이 가라앉자 다음으로 밀려온 것은 분노였다｡ 나는 참극의 중심에 서 있는 소년을 향해 외쳤다｡"
  },
  {
   "id": 26957,
   "key": "D1203le.txt:45",
   "file": "D1203le.txt",
   "line": 45,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちっ……！」",
   "ko_candidate": "「클라우디우스!」"
  },
  {
   "id": 26958,
   "key": "D1203le.txt:53",
   "file": "D1203le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "バルザイの偃月刀を抜き放つ。",
   "ko_candidate": "「!? 와버렸군 다이쥬지 쿠로!」 유독 짙은 피 냄새가 콧속 깊숙이 찌른다｡"
  },
  {
   "id": 26959,
   "key": "D1203le.txt:56",
   "file": "D1203le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃から迸る衝撃。血風刃と衝突し、紅く華を裂かせ爆砕。",
   "ko_candidate": "피의 안개를 휘감고 피바람이 된 카마이다치가 다가오고 있었다｡"
  },
  {
   "id": 26960,
   "key": "D1203le.txt:62",
   "file": "D1203le.txt",
   "line": 62,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「蜂の巣にしてやらあ！」",
   "ko_candidate": "「칫……!」 바르자이의 언월도를 뽑아든다｡"
  },
  {
   "id": 26961,
   "key": "D1203le.txt:69",
   "file": "D1203le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "構えるクラウディウスの両手の指間には数十個のベーゴマが挟まれていた。",
   "ko_candidate": "칼날에서 뿜어져 나오는 충격｡ 피바람 날과 충돌하여 붉은 꽃을 터뜨리며 폭산한다｡ 「벌집으로 만들어주마!」"
  },
  {
   "id": 26962,
   "key": "D1203le.txt:69",
   "file": "D1203le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "両腕を振って、ベーゴマを放つ。",
   "ko_candidate": "자세를 잡은 클라우디우스의 양손 손가락 사이에는 수십 개의 팽이가 끼워져 있었다｡"
  },
  {
   "id": 26963,
   "key": "D1203le.txt:72",
   "file": "D1203le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "高速回転しながら、唸りを上げて、床、左右の壁、天井、立体的に縦横無尽に、ベーゴマは疾走する。",
   "ko_candidate": "양팔을 휘둘러 팽이를 날린다｡ 고속 회전하며 윙윙거리는 소리를 내며 바닥､ 좌우 벽､ 천장을 종횡무진 입체적으로 팽이가 질주한다｡"
  },
  {
   "id": 26964,
   "key": "D1203le.txt:75",
   "file": "D1203le.txt",
   "line": 75,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「疾ィ……ッ」",
   "ko_candidate": "「빠르……읏」"
  },
  {
   "id": 26965,
   "key": "D1203le.txt:79",
   "file": "D1203le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神経を研ぎ澄ませる。",
   "ko_candidate": "신경을 곤두세운다｡"
  },
  {
   "id": 26966,
   "key": "D1203le.txt:83",
   "file": "D1203le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ての動きを１つとして捉え、その流れに身を投じる。",
   "ko_candidate": "모든 움직임을 하나로 포착하고 그 흐름에 몸을 던진다｡"
  },
  {
   "id": 26967,
   "key": "D1203le.txt:84",
   "file": "D1203le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "流れに沿って、流れをなぞるように、刃を振るう。",
   "ko_candidate": "흐름을 따라 흐름을 그리듯 칼을 휘두른다｡"
  },
  {
   "id": 26968,
   "key": "D1203le.txt:88",
   "file": "D1203le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火花が散る。",
   "ko_candidate": "불꽃이 튄다｡"
  },
  {
   "id": 26969,
   "key": "D1203le.txt:89",
   "file": "D1203le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベーゴマも自らの太刀も、何も見えてはいない。",
   "ko_candidate": "팽이도 내 칼도 아무것도 보이지 않는다｡"
  },
  {
   "id": 26970,
   "key": "D1203le.txt:90",
   "file": "D1203le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ無数に飛び跳ねる火花だけが、星のように俺の視界を埋め尽くす。",
   "ko_candidate": "단지 무수히 튀어 오르는 불꽃만이 별처럼 내 시야를 가득 메운다｡"
  },
  {
   "id": 26971,
   "key": "D1203le.txt:92",
   "file": "D1203le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "３秒ほども経っただろうか。",
   "ko_candidate": "3초 정도 지났을까｡"
  },
  {
   "id": 26972,
   "key": "D1203le.txt:97",
   "file": "D1203le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数十個のベーゴマは全て叩き落され、足元で恨みがましく、転がっていた。",
   "ko_candidate": "수십 개의 팽이는 모두 쳐내려져 발밑에서 원망스럽게 굴러다니고 있었다｡"
  },
  {
   "id": 26973,
   "key": "D1203le.txt:102",
   "file": "D1203le.txt",
   "line": 102,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なぁぁにっ!?」",
   "ko_candidate": "「뭐어어엇!?」"
  },
  {
   "id": 26974,
   "key": "D1203le.txt:106",
   "file": "D1203le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右手に偃月刀を執ったまま、左手にクトゥグアを招喚し、撃つ。",
   "ko_candidate": "오른손에 언월도를 쥔 채 왼손에 크투가를 소환해 발사한다｡"
  },
  {
   "id": 26975,
   "key": "D1203le.txt:113",
   "file": "D1203le.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声が通路の壁に幾重にも跳ね返る。",
   "ko_candidate": "총성이 통로의 벽에 수차례 반사된다｡"
  },
  {
   "id": 26976,
   "key": "D1203le.txt:118",
   "file": "D1203le.txt",
   "line": 118,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ケッ！」",
   "ko_candidate": "「켓!」"
  },
  {
   "id": 26977,
   "key": "D1203le.txt:126",
   "file": "D1203le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの足元が弾け飛ぶ。",
   "ko_candidate": "클라우디우스의 발밑이 튀어 오른다｡"
  },
  {
   "id": 26978,
   "key": "D1203le.txt:127",
   "file": "D1203le.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれよりも早くクラウディウスは床を蹴り、こっちに向かって飛び込んできた。",
   "ko_candidate": "하지만 그보다 더 빠르게 클라우디우스는 바닥을 차고 이쪽으로 뛰어들어왔다｡"
  },
  {
   "id": 26979,
   "key": "D1203le.txt:132",
   "file": "D1203le.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "壁を蹴り、三角跳びに突進してくる。",
   "ko_candidate": "벽을 차고 삼각 점프로 돌진해 온다｡"
  },
  {
   "id": 26980,
   "key": "D1203le.txt:133",
   "file": "D1203le.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "連射される弾丸の軌道上に、自らの身体を置かないためだ。",
   "ko_candidate": "연사되는 총알의 궤도상에 자신의 몸을 두지 않기 위해서다｡"
  },
  {
   "id": 26981,
   "key": "D1203le.txt:137",
   "file": "D1203le.txt",
   "line": 137,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「野郎！」",
   "ko_candidate": "「이 자식!」"
  },
  {
   "id": 26982,
   "key": "D1203le.txt:147",
   "file": "D1203le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "接近するクラウディウスに偃月刀を放つ。",
   "ko_candidate": "접근하는 클라우디우스에게 언월도를 날린다｡"
  },
  {
   "id": 26983,
   "key": "D1203le.txt:152",
   "file": "D1203le.txt",
   "line": 152,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「嘗めるな！」",
   "ko_candidate": "「얕보지 마!」"
  },
  {
   "id": 26984,
   "key": "D1203le.txt:156",
   "file": "D1203le.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスは懐からケンダマを抜き放つ。",
   "ko_candidate": "클라우디우스는 품에서 켄다마를 뽑아든다｡"
  },
  {
   "id": 26985,
   "key": "D1203le.txt:157",
   "file": "D1203le.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "激突する２つの魔力。",
   "ko_candidate": "두 마력이 격돌한다｡"
  },
  {
   "id": 26986,
   "key": "D1203le.txt:166",
   "file": "D1203le.txt",
   "line": 166,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「グッ……！」",
   "ko_candidate": "「으윽……!」"
  },
  {
   "id": 26987,
   "key": "D1203le.txt:168",
   "file": "D1203le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ケンダマの球を繋ぐ光の糸が、偃月刀に巻きついている。",
   "ko_candidate": "켄다마의 공을 잇는 빛의 실이 언월도에 감겨 있다｡"
  },
  {
   "id": 26988,
   "key": "D1203le.txt:171",
   "file": "D1203le.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "互いに得物を力任せに引っ張り合う。",
   "ko_candidate": "서로 무기를 힘껏 잡아당긴다｡"
  }
 ]
}