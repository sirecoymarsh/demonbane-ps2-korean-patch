{
 "packet": "ep_al02_02",
 "scene": "ep_al02",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "大十字九郎": "다이쥬지 쿠로",
  "ネロ": "네로"
 },
 "items": [
  {
   "id": 49539,
   "key": "ep_al02.txt:300",
   "file": "ep_al02.txt",
   "line": 300,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「泡沫の夢だとしてもね――神様でも壊せない、強くて綺麗なモノもあるんだよ。喩えばね――」",
   "ko_candidate": "「물거품의 꿈이라 해도 말이야――신님도 부술 수 없는､ 강하고 아름다운 것도 있다고｡ 예를 들면 말이야――」"
  },
  {
   "id": 49540,
   "key": "ep_al02.txt:304",
   "file": "ep_al02.txt",
   "line": 304,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「喩えば――」",
   "ko_candidate": "「예를 들면――」"
  },
  {
   "id": 49541,
   "key": "ep_al02.txt:310",
   "file": "ep_al02.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女は再び空を見上げた。",
   "ko_candidate": "소녀는 다시 하늘을 올려다봤다｡"
  },
  {
   "id": 49542,
   "key": "ep_al02.txt:311",
   "file": "ep_al02.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "邪悪を孕んだ世界で、空だけは清廉として、 美しく、蒼い。",
   "ko_candidate": "사악함을 품은 세계에서 하늘만은 청렴하고､ 아름답고､ 푸르다｡"
  },
  {
   "id": 49543,
   "key": "ep_al02.txt:316",
   "file": "ep_al02.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女は再び、詩を詠う。",
   "ko_candidate": "소녀는 다시 시를 읊는다｡"
  },
  {
   "id": 49544,
   "key": "ep_al02.txt:318",
   "file": "ep_al02.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "祈りの様に。",
   "ko_candidate": "기도하듯이｡"
  },
  {
   "id": 49545,
   "key": "ep_al02.txt:319",
   "file": "ep_al02.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "願いの様に。",
   "ko_candidate": "소원을 빌듯이｡"
  },
  {
   "id": 49546,
   "key": "ep_al02.txt:320",
   "file": "ep_al02.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "誓いの様に。",
   "ko_candidate": "맹세하듯이｡"
  },
  {
   "id": 49547,
   "key": "ep_al02.txt:322",
   "file": "ep_al02.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは――御伽噺だった。",
   "ko_candidate": "그것은――동화이야기였다｡"
  },
  {
   "id": 49548,
   "key": "ep_al02.txt:333",
   "file": "ep_al02.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、みんなの祈りは届きました。",
   "ko_candidate": "하지만､ 모두의 기도는 닿았습니다｡"
  },
  {
   "id": 49549,
   "key": "ep_al02.txt:334",
   "file": "ep_al02.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ある日、空が輝きました。",
   "ko_candidate": "어느 날､ 하늘이 빛났습니다｡"
  },
  {
   "id": 49550,
   "key": "ep_al02.txt:335",
   "file": "ep_al02.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "誰もが、空を見上げました。",
   "ko_candidate": "모두가 하늘을 올려다봤습니다｡"
  },
  {
   "id": 49551,
   "key": "ep_al02.txt:336",
   "file": "ep_al02.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、誰もがそれを見ました。",
   "ko_candidate": "그리고､ 모두가 그것을 보았습니다｡"
  },
  {
   "id": 49552,
   "key": "ep_al02.txt:342",
   "file": "ep_al02.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "憎しみに燃える空から、 血を舐める地球に降り立った、光の巨人。",
   "ko_candidate": "증오로 불타는 하늘에서､ 피를 핥는 지구로 내려온 빛의 거인｡"
  },
  {
   "id": 49553,
   "key": "ep_al02.txt:344",
   "file": "ep_al02.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空を輝かせ、地を照らし、彼はやってきました。",
   "ko_candidate": "하늘을 빛내고､ 땅을 비추며､ 그가 왔습니다｡"
  },
  {
   "id": 49554,
   "key": "ep_al02.txt:346",
   "file": "ep_al02.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――善い神様が、舞い降りたのです。",
   "ko_candidate": "――착한 신님이 내려오신 것입니다｡"
  },
  {
   "id": 49555,
   "key": "ep_al02.txt:348",
   "file": "ep_al02.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "善い神様は、荒れ果てた地球を見て、 とても怒りました。",
   "ko_candidate": "착한 신님은 황폐해진 지구를 보고 매우 화를 냈습니다｡"
  },
  {
   "id": 49556,
   "key": "ep_al02.txt:355",
   "file": "ep_al02.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、悪い神様たちを懲らしめようと、その手に光り輝く剣を執りました。",
   "ko_candidate": "그리고 나쁜 신들을 혼내주려고 그 손에 빛나는 검을 들었습니다｡"
  },
  {
   "id": 49557,
   "key": "ep_al02.txt:367",
   "file": "ep_al02.txt",
   "line": 367,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「喩えば、あの大十字九郎の様に ――かな？」",
   "ko_candidate": "「예를 들면､ 그 다이쥬지 쿠로처럼 ――일까?」"
  },
  {
   "id": 49558,
   "key": "ep_al02.txt:372",
   "file": "ep_al02.txt",
   "line": 372,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 49559,
   "key": "ep_al02.txt:376",
   "file": "ep_al02.txt",
   "line": 376,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「成程、確かに――彼は、私がそう育てたとは云え、私の思惑を遥かに超えた存在だった。認めよう、あの世界では確かに、私は大十字九郎に敗北した」",
   "ko_candidate": "「그렇군､ 확실히――그는 내가 그렇게 키웠다고는 해도､ 내 의도를 훨씬 뛰어넘은 존재였어｡ 인정하지､ 그 세계에서는 확실히 나는 다이쥬지 쿠로에게 패배했다」"
  },
  {
   "id": 49560,
   "key": "ep_al02.txt:379",
   "file": "ep_al02.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そう答える男の表情は、闇に覆われ、 全く判別がつかない。",
   "ko_candidate": "그렇게 대답하는 남자의 표정은 어둠에 가려져 전혀 알아볼 수 없었다｡"
  },
  {
   "id": 49561,
   "key": "ep_al02.txt:381",
   "file": "ep_al02.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、その聲には苦渋の響きが在った。",
   "ko_candidate": "하지만 그 목소리에는 고뇌의 울림이 있었다｡"
  },
  {
   "id": 49562,
   "key": "ep_al02.txt:382",
   "file": "ep_al02.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "憎悪の臭いが在った。",
   "ko_candidate": "증오의 냄새가 있었다｡"
  },
  {
   "id": 49563,
   "key": "ep_al02.txt:384",
   "file": "ep_al02.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして何より――愛の温もりが在った。",
   "ko_candidate": "그리고 무엇보다――사랑의 온기가 있었다｡"
  },
  {
   "id": 49564,
   "key": "ep_al02.txt:385",
   "file": "ep_al02.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "神たる存在には似つかわしくない、 生温さが在った。",
   "ko_candidate": "신이라는 존재에게는 어울리지 않는 미지근함이 있었다｡"
  },
  {
   "id": 49565,
   "key": "ep_al02.txt:390",
   "file": "ep_al02.txt",
   "line": 390,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だがそれも、千の異形を持つ無貌たる我にとって、夢の出来事に過ぎぬ。 世界が泡沫なれば、この我もまた泡沫に過ぎぬ」",
   "ko_candidate": "「하지만 그것도 천의 얼굴을 가진 묘사할 수 없는 나에게는 꿈속의 일에 불과해｡ 세상이 물거품이라면 이 나 또한 물거품에 지나지 않아」"
  },
  {
   "id": 49566,
   "key": "ep_al02.txt:394",
   "file": "ep_al02.txt",
   "line": 394,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「寂しい奴だね、君も」",
   "ko_candidate": "「외로운 녀석이구나､ 너도」"
  },
  {
   "id": 49567,
   "key": "ep_al02.txt:397",
   "file": "ep_al02.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "詩を止めて、振り向きもせず、少女は言った。",
   "ko_candidate": "시를 멈추고 돌아보지도 않은 채 소녀가 말했다｡"
  },
  {
   "id": 49568,
   "key": "ep_al02.txt:398",
   "file": "ep_al02.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "男の、闇に覆われた貌の、口元が亀裂の様な笑みを刻んだ。",
   "ko_candidate": "남자의 어둠에 가려진 얼굴의 입가에 균열 같은 미소가 새겨졌다｡"
  },
  {
   "id": 49569,
   "key": "ep_al02.txt:402",
   "file": "ep_al02.txt",
   "line": 402,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「なればこそ、道化は道化らしく 滑稽に振舞わねばな。 私は私の役目を演じよう。 さあ、来たまえネロ。 再び道化芝居を始める為に」",
   "ko_candidate": "「그러니까 광대는 광대답게 우스꽝스럽게 행동해야지｡ 나는 내 역할을 연기하겠어｡ 자､ 오거라 네로｡ 다시 광대극을 시작하기 위해」"
  },
  {
   "id": 49570,
   "key": "ep_al02.txt:410",
   "file": "ep_al02.txt",
   "line": 410,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 49571,
   "key": "ep_al02.txt:413",
   "file": "ep_al02.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女は応えない。",
   "ko_candidate": "소녀는 대답하지 않는다｡"
  },
  {
   "id": 49572,
   "key": "ep_al02.txt:414",
   "file": "ep_al02.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "振り向かない。",
   "ko_candidate": "돌아보지 않는다｡"
  },
  {
   "id": 49573,
   "key": "ep_al02.txt:418",
   "file": "ep_al02.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ青空を見上げて――詩を続ける。",
   "ko_candidate": "그저 푸른 하늘을 올려다보며――시를 이어간다｡"
  },
  {
   "id": 49574,
   "key": "ep_al02.txt:419",
   "file": "ep_al02.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "御伽噺を続ける。",
   "ko_candidate": "동화이야기를 이어간다｡"
  },
  {
   "id": 49575,
   "key": "ep_al02.txt:430",
   "file": "ep_al02.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "善い神様と悪い神様たちとの戦いがはじまりました。",
   "ko_candidate": "착한 신님과 나쁜 신들과의 싸움이 시작되었습니다｡"
  },
  {
   "id": 49576,
   "key": "ep_al02.txt:431",
   "file": "ep_al02.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――実のところ、善い神様は、みんなが思っていたような、全知全能の神様ではありませんでした。",
   "ko_candidate": "――사실､ 착한 신님은 모두가 생각했던 것 같은 전지전능한 신님이 아니었습니다｡"
  },
  {
   "id": 49577,
   "key": "ep_al02.txt:433",
   "file": "ep_al02.txt",
   "line": 433,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『えるだー・ごっど』が『ぐれーと・おーるど・わん』を懲らしめただなんて、嘘っぱちなのです。",
   "ko_candidate": "엘더 갓이 그레이트 올드 원을 혼내줬다니､ 새빨간 거짓말입니다｡ 이 이야기는 동화이지만――동화 속에서도 거짓말은 거짓말인 것입니다｡"
  },
  {
   "id": 49578,
   "key": "ep_al02.txt:434",
   "file": "ep_al02.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "このお話は御伽噺ですが――御伽噺の中でも、嘘は嘘なのです。",
   "ko_candidate": "우주에는 역시 나쁜 신들밖에 없는 것입니다｡"
  }
 ]
}