 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "瑠璃": "루리",
  "クラウディウス": "클라우디우스",
  "アル": "알",
  "ベーゴマ": "팽이",
  "エルザ": "엘자"
 },
 "items": [
  {
   "id": 28679,
   "key": "D1208ru.txt:140",
   "file": "D1208ru.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "玉が弧を描いて、瑠璃のこめかみに迫る。",
   "ko_candidate": "구슬이 호를 그리며､ 루리의 관자놀이로 다가온다｡"
  },
  {
   "id": 28680,
   "key": "D1208ru.txt:144",
   "file": "D1208ru.txt",
   "line": 144,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「避けろ！」",
   "ko_candidate": "「피해!」"
  },
  {
   "id": 28681,
   "key": "D1208ru.txt:149",
   "file": "D1208ru.txt",
   "line": 149,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃっ！」",
   "ko_candidate": "「꺄악!」"
  },
  {
   "id": 28682,
   "key": "D1208ru.txt:152",
   "file": "D1208ru.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔を後ろに反らす。鼻先を掠める赤い玉。",
   "ko_candidate": "얼굴을 뒤로 젖힌다｡ 코끝을 스치는 빨간 구슬｡"
  },
  {
   "id": 28683,
   "key": "D1208ru.txt:153",
   "file": "D1208ru.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それはフェイント。",
   "ko_candidate": "하지만､ 그것은 페인트였다｡"
  },
  {
   "id": 28684,
   "key": "D1208ru.txt:154",
   "file": "D1208ru.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスのもう片方の掌には、ヨーヨーが！",
   "ko_candidate": "클라우디우스의 다른 한 손바닥에는､ 요요가!"
  },
  {
   "id": 28685,
   "key": "D1208ru.txt:158",
   "file": "D1208ru.txt",
   "line": 158,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまった……！」",
   "ko_candidate": "「아차……!」"
  },
  {
   "id": 28686,
   "key": "D1208ru.txt:162",
   "file": "D1208ru.txt",
   "line": 162,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「かかりやがったな、 トンマがっ！」",
   "ko_candidate": "「걸려들었군､ 멍청이가!」"
  },
  {
   "id": 28687,
   "key": "D1208ru.txt:168",
   "file": "D1208ru.txt",
   "line": 168,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………！」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 28688,
   "key": "D1208ru.txt:171",
   "file": "D1208ru.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヨーヨーが瑠璃の頬を掠める。",
   "ko_candidate": "요요가 루리의 뺨을 스친다｡"
  },
  {
   "id": 28689,
   "key": "D1208ru.txt:173",
   "file": "D1208ru.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "外れたのではない。ヨーヨーは瑠璃の周囲を円を描いて回転する。",
   "ko_candidate": "빗나간 게 아니다｡ 요요는 루리의 주위를 원을 그리며 회전한다｡"
  },
  {
   "id": 28690,
   "key": "D1208ru.txt:175",
   "file": "D1208ru.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "円の中心には無論、瑠璃がいる。",
   "ko_candidate": "원의 중심에는 물론､ 루리가 있다｡"
  },
  {
   "id": 28691,
   "key": "D1208ru.txt:177",
   "file": "D1208ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして、ヨーヨーと云うからには、 本体は糸で――チェーンで繋がれている。",
   "ko_candidate": "그리고､ 요요라고 하면､ 본체는 실로――체인으로 연결되어 있다｡"
  },
  {
   "id": 28692,
   "key": "D1208ru.txt:180",
   "file": "D1208ru.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即ち、それが意味するのは――",
   "ko_candidate": "즉､ 그것이 의미하는 것은――"
  },
  {
   "id": 28693,
   "key": "D1208ru.txt:185",
   "file": "D1208ru.txt",
   "line": 185,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ッ!?　あ……あがっ！　ぐ……ぐぐ……うぅぅぅっ！」",
   "ko_candidate": "「……읏!? 아……아갓! 그……그그……우우우웃!」"
  },
  {
   "id": 28694,
   "key": "D1208ru.txt:191",
   "file": "D1208ru.txt",
   "line": 191,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒャーハハハハハハッ！」",
   "ko_candidate": "「히야하하하하하핫!」"
  },
  {
   "id": 28695,
   "key": "D1208ru.txt:194",
   "file": "D1208ru.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヨーヨーのチェーンは何重にもなって、瑠璃の首に絡みついた。",
   "ko_candidate": "요요의 체인은 여러 겹으로､ 루리의 목에 감겼다｡"
  },
  {
   "id": 28696,
   "key": "D1208ru.txt:196",
   "file": "D1208ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咽喉笛に喰い込み、じわりじわり締め上げるチェーン。",
   "ko_candidate": "목구멍에 파고들어､ 서서히 조여오는 체인｡"
  },
  {
   "id": 28697,
   "key": "D1208ru.txt:198",
   "file": "D1208ru.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛に悲鳴を上げようと、洩れるのは詰まった吐息だけだ。",
   "ko_candidate": "고통에 비명을 지르려 해도､ 새어 나오는 것은 막힌 숨소리뿐이다｡"
  },
  {
   "id": 28698,
   "key": "D1208ru.txt:202",
   "file": "D1208ru.txt",
   "line": 202,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「苦しいかぁ!?　苦しいだろぉ！　……このまま、じっくりと縊り殺してやるよ、お嬢サマ！」",
   "ko_candidate": "「괴롭나아!? 괴롭겠지이! ……이대로､ 천천히 목 졸라 죽여주지､ 아가씨!」"
  },
  {
   "id": 28699,
   "key": "D1208ru.txt:206",
   "file": "D1208ru.txt",
   "line": 206,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ああぁぁぁ……ぁぁぁぁぁ……ッッッ！」",
   "ko_candidate": "「아……아아아아……아아아아아……읏읏읏!」"
  },
  {
   "id": 28700,
   "key": "D1208ru.txt:210",
   "file": "D1208ru.txt",
   "line": 210,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おのれ……させるか！」",
   "ko_candidate": "「이놈……못 하게 해!」"
  },
  {
   "id": 28701,
   "key": "D1208ru.txt:216",
   "file": "D1208ru.txt",
   "line": 216,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「てめぇは大人しくしてなぁ！」 ベーゴマがアルに放たれた。",
   "ko_candidate": "「넌 얌전히 있어!」"
  },
  {
   "id": 28702,
   "key": "D1208ru.txt:222",
   "file": "D1208ru.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "かわそうとするが、",
   "ko_candidate": "팽이가 알에게 날아갔다｡"
  },
  {
   "id": 28703,
   "key": "D1208ru.txt:223",
   "file": "D1208ru.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベーゴマは軌道を変えて襲いかかってくる。",
   "ko_candidate": "피하려 하지만､ 팽이는 궤도를 바꾸어 덮쳐온다｡"
  },
  {
   "id": 28704,
   "key": "D1208ru.txt:225",
   "file": "D1208ru.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "逃げ切れなかった。",
   "ko_candidate": "피하지 못했다｡"
  },
  {
   "id": 28705,
   "key": "D1208ru.txt:231",
   "file": "D1208ru.txt",
   "line": 231,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐあああああ！」",
   "ko_candidate": "「그아아아아아!」"
  },
  {
   "id": 28706,
   "key": "D1208ru.txt:234",
   "file": "D1208ru.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾き飛ばされ、小さくなったアルの躰が床をぼてぼてと跳ねる。",
   "ko_candidate": "튕겨 나가､ 작아진 알의 몸이 바닥을 데구르르 굴러간다｡"
  },
  {
   "id": 28707,
   "key": "D1208ru.txt:235",
   "file": "D1208ru.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何とか立ち上がろうとしているが、痛みに躰が上手く動かないようだった。",
   "ko_candidate": "어떻게든 일어나려 하고 있지만､ 고통에 몸이 잘 움직이지 않는 것 같았다｡"
  },
  {
   "id": 28708,
   "key": "D1208ru.txt:239",
   "file": "D1208ru.txt",
   "line": 239,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぁ……ぁぁ……ぁ……」",
   "ko_candidate": "「아……아아……아……」"
  },
  {
   "id": 28709,
   "key": "D1208ru.txt:243",
   "file": "D1208ru.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の手から偃月刀が零れて、甲高い金属音を響かせ、床を転がった。",
   "ko_candidate": "루리의 손에서 언월도가 떨어져､ 날카로운 금속음을 울리며､ 바닥을 굴렀다｡"
  },
  {
   "id": 28710,
   "key": "D1208ru.txt:244",
   "file": "D1208ru.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が、遠のく。",
   "ko_candidate": "의식이､ 멀어진다｡"
  },
  {
   "id": 28711,
   "key": "D1208ru.txt:250",
   "file": "D1208ru.txt",
   "line": 250,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さっきまでの威勢はどうしたぁ？　もっと良い声で泣いてくれよぉ……あぁん？」",
   "ko_candidate": "「아까까지의 기세는 어디 갔아? 좀 더 좋은 목소리로 울어 달라고……응?」"
  },
  {
   "id": 28712,
   "key": "D1208ru.txt:254",
   "file": "D1208ru.txt",
   "line": 254,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「や……やめるロボ……っ！」",
   "ko_candidate": "「그……그만두라고 로봇……읏!」"
  },
  {
   "id": 28713,
   "key": "D1208ru.txt:257",
   "file": "D1208ru.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ダメージから復帰できないエルザが、床に這い蹲りながら、クラウディウスの足首を掴んだ。",
   "ko_candidate": "데미지에서 회복하지 못한 엘자가､ 바닥에 엎드린 채､ 클라우디우스의 발목을 잡았다｡"
  },
  {
   "id": 28714,
   "key": "D1208ru.txt:260",
   "file": "D1208ru.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの足元で、風が弾ける。",
   "ko_candidate": "클라우디우스의 발밑에서､ 바람이 터진다｡"
  },
  {
   "id": 28715,
   "key": "D1208ru.txt:261",
   "file": "D1208ru.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カマイタチに刻まれ、エルザは思わず指を離した。",
   "ko_candidate": "카마이타치에 베여､ 엘자는 무의식중에 손가락을 놓았다｡"
  },
  {
   "id": 28716,
   "key": "D1208ru.txt:265",
   "file": "D1208ru.txt",
   "line": 265,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うくっ!?」",
   "ko_candidate": "「으큿!?」"
  },
  {
   "id": 28717,
   "key": "D1208ru.txt:271",
   "file": "D1208ru.txt",
   "line": 271,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お呼びじゃねえんだよ、マネキン人形！」",
   "ko_candidate": "「부르지도 않았어､ 마네킹 인형!」"
  },
  {
   "id": 28718,
   "key": "D1208ru.txt:277",
   "file": "D1208ru.txt",
   "line": 277,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あうわぁぁぁッ！」",
   "ko_candidate": "「아우와아아앗!」"
  }
 ]
}