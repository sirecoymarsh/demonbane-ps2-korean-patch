 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アウグストゥス": "아우구스투스",
  "鬼械神": "귀계신",
  "デモンベイン": "데몬베인",
  "メタトロン": "메타트론",
  "アーカムシティ": "아컴시티",
  "ウィンフィールド": "윈필드"
 },
 "items": [
  {
   "id": 21328,
   "key": "D1004ru.txt:206",
   "file": "D1004ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見下ろすのは、アウグストゥスの鬼械神が街に抉った、巨大な爪痕。",
   "ko_candidate": "내려다보는 것은､ 아우구스투스의 귀계신이 거리에 파낸､ 거대한 발톱 자국｡"
  },
  {
   "id": 21329,
   "key": "D1004ru.txt:208",
   "file": "D1004ru.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "射線上のビルは全て融解、蒸発していた。そして終着点。デモンベインが立っていた場所には何もない。",
   "ko_candidate": "사격 선상의 빌딩은 모두 융해､ 증발해 버렸다｡ 그리고 종착점｡ 데몬베인이 서 있던 자리에는 아무것도 없다｡"
  },
  {
   "id": 21330,
   "key": "D1004ru.txt:209",
   "file": "D1004ru.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "中心部から半径１キロ範囲に渡っては何一つ残さず綺麗に吹き飛んでしまっている。",
   "ko_candidate": "중심부에서 반경 1킬로미터 범위에 걸쳐 아무것도 남김없이 깨끗이 날아가 버렸다｡"
  },
  {
   "id": 21331,
   "key": "D1004ru.txt:211",
   "file": "D1004ru.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無論、デモンベインの姿は跡形も無かった。",
   "ko_candidate": "물론､ 데몬베인의 모습은 흔적도 없었다｡"
  },
  {
   "id": 21332,
   "key": "D1004ru.txt:215",
   "file": "D1004ru.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンはその上空から見下ろしている。",
   "ko_candidate": "메타트론은 그 상공에서 내려다보고 있다｡"
  },
  {
   "id": 21333,
   "key": "D1004ru.txt:216",
   "file": "D1004ru.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "握り締めた拳が、小刻みに震えていた――。",
   "ko_candidate": "꽉 쥔 주먹이 미세하게 떨리고 있었다――｡"
  },
  {
   "id": 21334,
   "key": "D1004ru.txt:221",
   "file": "D1004ru.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敗北が――",
   "ko_candidate": "패배가――"
  },
  {
   "id": 21335,
   "key": "D1004ru.txt:230",
   "file": "D1004ru.txt",
   "line": 230,
   "speaker": "ストーン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まさか……あのロボットが負けるなんて、そんなことが……」",
   "ko_candidate": "「설마…… 그 로봇이 질 줄이야､ 그런 일이……」"
  },
  {
   "id": 21336,
   "key": "D1004ru.txt:236",
   "file": "D1004ru.txt",
   "line": 236,
   "speaker": "ネス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どうしようかねえ……まったく」",
   "ko_candidate": "「어쩌면 좋을까…… 정말」"
  },
  {
   "id": 21337,
   "key": "D1004ru.txt:241",
   "file": "D1004ru.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アーカムシティに、重く圧し掛かる――",
   "ko_candidate": "아캄시티에､ 무겁게 짓누르는――"
  },
  {
   "id": 21338,
   "key": "D1004ru.txt:250",
   "file": "D1004ru.txt",
   "line": 250,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……デモンベイン、消失しました」",
   "ko_candidate": "「……데몬베인､ 소실됐습니다」"
  },
  {
   "id": 21339,
   "key": "D1004ru.txt:262",
   "file": "D1004ru.txt",
   "line": 262,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な……なな……」",
   "ko_candidate": "「뭐…… 뭐뭐……」"
  },
  {
   "id": 21340,
   "key": "D1004ru.txt:267",
   "file": "D1004ru.txt",
   "line": 267,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、そんなぁぁ……そんなあぁぁぁぁっ！」",
   "ko_candidate": "「그､ 그럴 리가…… 그럴 리가 없어어어어!」"
  },
  {
   "id": 21341,
   "key": "D1004ru.txt:272",
   "file": "D1004ru.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音にも似た音に、一同は身を竦ませながら、振り向いた。",
   "ko_candidate": "폭음과도 같은 소리에､ 일동은 몸을 움츠리며 돌아보았다｡"
  },
  {
   "id": 21342,
   "key": "D1004ru.txt:274",
   "file": "D1004ru.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "視線の集中した先には――ウィンフィールドが。",
   "ko_candidate": "시선이 집중된 곳에는―― 윈필드가｡"
  },
  {
   "id": 21343,
   "key": "D1004ru.txt:276",
   "file": "D1004ru.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳を罅割れた壁にめり込ましたまま、打ち震えていた。",
   "ko_candidate": "주먹을 금이 간 벽에 박은 채､ 떨고 있었다｡"
  },
  {
   "id": 21344,
   "key": "D1004ru.txt:281",
   "file": "D1004ru.txt",
   "line": 281,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「私は……何て無力な……！　くおぉぉぉ……！」",
   "ko_candidate": "「나는…… 정말 무력한……! 크으으으……!」 「윈 님!?」"
  },
  {
   "id": 21345,
   "key": "D1004ru.txt:286",
   "file": "D1004ru.txt",
   "line": 286,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ウィン様!?」 天を覆うは、一切を闇に包み込む陰、邪神の威容。",
   "ko_candidate": "하늘을 뒤덮은 것은､ 모든 것을 어둠으로 감싸는 그림자､ 사신의 위용｡"
  },
  {
   "id": 21346,
   "key": "D1004ru.txt:292",
   "file": "D1004ru.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして人の心を覆うは、",
   "ko_candidate": "그리고 사람의 마음을 뒤덮은 것은､"
  },
  {
   "id": 21347,
   "key": "D1004ru.txt:293",
   "file": "D1004ru.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一切の光を貪る、蝕む、其れは、只こう呼ばれる。",
   "ko_candidate": "모든 빛을 탐하고､ 갉아먹는､ 그것은､ 단지 이렇게 불린다｡"
  },
  {
   "id": 21348,
   "key": "D1004ru.txt:298",
   "file": "D1004ru.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――絶望と。",
   "ko_candidate": "――절망이라고｡"
  }
 ]
}