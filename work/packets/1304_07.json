 "items": [
  {
   "id": 32051,
   "key": "D1304le.txt:558",
   "file": "D1304le.txt",
   "line": 558,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ――――」",
   "ko_candidate": "「아――――」"
  },
  {
   "id": 32052,
   "key": "D1304le.txt:562",
   "file": "D1304le.txt",
   "line": 562,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝に護りたい者が居るように、汝を護りたい者も居るのだ。 九郎、独りで戦おうとするな……皆も妾も、汝の背中くらいは護ってやれるさ」",
   "ko_candidate": "「너에게 지키고 싶은 사람이 있듯이､ 너를 지키고 싶은 사람도 있다는 걸｡ 쿠로､ 혼자서 싸우려 하지 마… 모두도 나도､ 너의 등 정도는 지켜줄 수 있어」"
  },
  {
   "id": 32053,
   "key": "D1304le.txt:567",
   "file": "D1304le.txt",
   "line": 567,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……本当に、ありがとう」",
   "ko_candidate": "「…정말､ 고마워」"
  },
  {
   "id": 32054,
   "key": "D1304le.txt:571",
   "file": "D1304le.txt",
   "line": 571,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「礼を言う事ではないさ。さあ、分かったなら、覇道の小娘共と作戦を――」",
   "ko_candidate": "「감사할 일이 아니야｡ 자､ 알았다면､ 하도의 계집애들과 작전을――」"
  },
  {
   "id": 32055,
   "key": "D1304le.txt:576",
   "file": "D1304le.txt",
   "line": 576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの言葉は鳴り響くサイレンの音に遮られた。",
   "ko_candidate": "알의 말은 울려 퍼지는 사이렌 소리에 가로막혔다｡"
  },
  {
   "id": 32056,
   "key": "D1304le.txt:577",
   "file": "D1304le.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この場にいる全員に緊張感が走る。",
   "ko_candidate": "이 자리에 있는 모두에게 긴장감이 달린다｡"
  },
  {
   "id": 32057,
   "key": "D1304le.txt:578",
   "file": "D1304le.txt",
   "line": 578,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通信機からマコトの声が聴こえてきた。",
   "ko_candidate": "통신기에서 마코토의 목소리가 들려왔다｡"
  },
  {
   "id": 32058,
   "key": "D1304le.txt:582",
   "file": "D1304le.txt",
   "line": 582,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「シティ４９番区近辺に時空震反応有り。 鬼械神級のエネルギーを内包した何かが顕現化します」",
   "ko_candidate": "「시티 49번 구역 근처에 시공진 반응 있음｡ 귀계신급의 에너지를 내포한 무언가가 현현화합니다｡ ――소환입니다」"
  },
  {
   "id": 32059,
   "key": "D1304le.txt:586",
   "file": "D1304le.txt",
   "line": 586,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――招喚です」",
   "ko_candidate": "「안티 크로스인가!?」"
  },
  {
   "id": 32060,
   "key": "D1304le.txt:594",
   "file": "D1304le.txt",
   "line": 594,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アンチクロスか!?」",
   "ko_candidate": "「젠장…! 연속이라고! 너무 빨라!」"
  },
  {
   "id": 32061,
   "key": "D1304le.txt:598",
   "file": "D1304le.txt",
   "line": 598,
   "speaker": "九郎 / ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそ……！　連続かよ！　早すぎるぜ！」 「さて……正義だのくっだらねーこと、ホザいていやがりますお子チャマたちに教育してあげないとねぇ。人生の厳しさってえヤツを……！」",
   "ko_candidate": "「자… 정의니 뭐니 시시한 소리나 지껄이고 있는 꼬마들에게 교육해 줘야겠어｡ 인생의 엄격함이란 걸…!」"
  },
  {
   "id": 32062,
   "key": "D1304le.txt:612",
   "file": "D1304le.txt",
   "line": 612,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「観測対象、顕現化！　全長５０メートル級、鬼械神で……ええ！　そ、そんな……これって！」",
   "ko_candidate": "「관측 대상､ 현현화! 전장 50미터급､ 귀계신으로… 어! 그､ 그런… 이건!」"
  },
  {
   "id": 32063,
   "key": "D1304le.txt:623",
   "file": "D1304le.txt",
   "line": 623,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こんな……こんな事って」",
   "ko_candidate": "「이런… 이런 일이」"
  },
  {
   "id": 32064,
   "key": "D1304le.txt:627",
   "file": "D1304le.txt",
   "line": 627,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……連中。エゲツない真似をやってきおる！」",
   "ko_candidate": "「…놈들｡ 엄청난 짓을 저질러 왔군!」"
  },
  {
   "id": 32065,
   "key": "D1304le.txt:631",
   "file": "D1304le.txt",
   "line": 631,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ！」",
   "ko_candidate": "「…읏!」"
  },
  {
   "id": 32066,
   "key": "D1304le.txt:635",
   "file": "D1304le.txt",
   "line": 635,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……相変わらず、下衆な奴であるな」",
   "ko_candidate": "「…여전히､ 비열한 놈이로군」"
  },
  {
   "id": 32067,
   "key": "D1304le.txt:639",
   "file": "D1304le.txt",
   "line": 639,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボ～」",
   "ko_candidate": "「로봇~」"
  },
  {
   "id": 32068,
   "key": "D1304le.txt:644",
   "file": "D1304le.txt",
   "line": 644,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……彼奴等！　何処まで我々を虚仮にすればっ！」",
   "ko_candidate": "「…그들! 어디까지 우리를 우롱하면!」"
  },
  {
   "id": 32069,
   "key": "D1304le.txt:647",
   "file": "D1304le.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……拳から血が滴り落ちる。",
   "ko_candidate": "…주먹에서 피가 뚝뚝 떨어진다｡"
  },
  {
   "id": 32070,
   "key": "D1304le.txt:648",
   "file": "D1304le.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "硬く握りすぎて、爪が掌に食い込んだのだ。",
   "ko_candidate": "너무 세게 쥐어서､ 손톱이 손바닥에 파고들었다｡"
  },
  {
   "id": 32071,
   "key": "D1304le.txt:649",
   "file": "D1304le.txt",
   "line": 649,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがその痛みすら、怒りに麻痺した脳には、感じ取れない。",
   "ko_candidate": "하지만 그 통증조차､ 분노로 마비된 뇌에는､ 느껴지지 않는다｡"
  },
  {
   "id": 32072,
   "key": "D1304le.txt:651",
   "file": "D1304le.txt",
   "line": 651,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "熱すぎて目が眩む。",
   "ko_candidate": "너무 뜨거워서 눈이 어지럽다｡"
  },
  {
   "id": 32073,
   "key": "D1304le.txt:652",
   "file": "D1304le.txt",
   "line": 652,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "うなじの辺りが灼ける。",
   "ko_candidate": "목덜미 근처가 타는 듯하다｡"
  },
  {
   "id": 32074,
   "key": "D1304le.txt:653",
   "file": "D1304le.txt",
   "line": 653,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咽喉の奥がジリジリと乾く。",
   "ko_candidate": "목구멍 안쪽이 지글지글 마른다｡"
  },
  {
   "id": 32075,
   "key": "D1304le.txt:654",
   "file": "D1304le.txt",
   "line": 654,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心臓が激しく脈打つ。",
   "ko_candidate": "심장이 격렬하게 맥박 친다｡"
  },
  {
   "id": 32076,
   "key": "D1304le.txt:667",
   "file": "D1304le.txt",
   "line": 667,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おーほほほほほほほほほほ！」",
   "ko_candidate": "「오호호호호호호호호호호호!」"
  },
  {
   "id": 32077,
   "key": "D1304le.txt:671",
   "file": "D1304le.txt",
   "line": 671,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "招喚され実体を結んだ、その機体の中から下卑た哄笑が聴こえてきた。",
   "ko_candidate": "소환되어 실체를 이룬､ 그 기체 안에서 천박한 웃음소리가 들려왔다｡"
  },
  {
   "id": 32078,
   "key": "D1304le.txt:673",
   "file": "D1304le.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウス……やはり貴様か！",
   "ko_candidate": "티베리우스… 역시 네 녀석인가!"
  },
  {
   "id": 32079,
   "key": "D1304le.txt:674",
   "file": "D1304le.txt",
   "line": 674,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かに、こんな下衆なこと思いつくのは貴様くらいだろうよ……。",
   "ko_candidate": "확실히､ 이런 비열한 짓을 생각해낼 수 있는 건 네 녀석뿐이겠지…"
  },
  {
   "id": 32080,
   "key": "D1304le.txt:676",
   "file": "D1304le.txt",
   "line": 676,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴が乗っている機体は、『妖蛆の秘密』が招喚する鬼械神ではなかった。",
   "ko_candidate": "놈이 타고 있는 기체는､ 『벌레의 신비』가 소환하는 귀계신이 아니었다｡"
  },
  {
   "id": 32081,
   "key": "D1304le.txt:678",
   "file": "D1304le.txt",
   "line": 678,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この機体は……",
   "ko_candidate": "이 기체는…"
  },
  {
   "id": 32082,
   "key": "D1304le.txt:680",
   "file": "D1304le.txt",
   "line": 680,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この機体は――ッ！",
   "ko_candidate": "이 기체는――!"
  },
  {
   "id": 32083,
   "key": "D1304le.txt:687",
   "file": "D1304le.txt",
   "line": 687,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――デモンベイン！」",
   "ko_candidate": "「――데몬베인!」"
  },
  {
   "id": 32084,
   "key": "D1304ru.txt:10",
   "file": "D1304ru.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ミスカトニック河の上流、世界随一の大都市アーカム・シティも近い丘陵地帯に、だが廃屋同然の、まるで時間に取り残されたかの様な、古びた寒村がある。",
   "ko_candidate": "미스카토닉 강의 상류､ 세계 최고의 대도시 아캄시티도 가까운 구릉지대에､ 하지만 폐가나 다름없는､ 마치 시간에 뒤처진 듯한､ 낡은 한촌이 있다｡"
  },
  {
   "id": 32085,
   "key": "D1304ru.txt:11",
   "file": "D1304ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――ダンウィッチ。",
   "ko_candidate": "――던위치｡"
  },
  {
   "id": 32086,
   "key": "D1304ru.txt:12",
   "file": "D1304ru.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "忌まわしきその名を耳にするたびに、かの事件を知る者は、吐き気を催す猛毒の記憶を喚起させられる。",
   "ko_candidate": "그 불길한 이름을 들을 때마다､ 그 사건을 아는 자는､ 구토를 유발하는 맹독의 기억을 떠올리게 된다｡"
  },
  {
   "id": 32087,
   "key": "D1304ru.txt:14",
   "file": "D1304ru.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暴力と背徳が跋扈し、堕落と頽廃に冒された、呪われし土地。",
   "ko_candidate": "폭력과 배덕이 횡행하고､ 타락과 퇴폐에 물든､ 저주받은 땅｡"
  },
  {
   "id": 32088,
   "key": "D1304ru.txt:15",
   "file": "D1304ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今では街道からこの土地を指し示す全ての標識が取り払われ、全ての者がその名を悪魔の記憶と共に封印しようとしている。",
   "ko_candidate": "지금은 가도에서 이 땅을 가리키는 모든 표지판이 제거되고､ 모든 이가 그 이름을 악마의 기억과 함께 봉인하려 하고 있다｡"
  },
  {
   "id": 32089,
   "key": "D1304ru.txt:17",
   "file": "D1304ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "世界より隔離され、更なる衰退を辿るこの村に住む、古い家系。元は紋章を付ける資格を持つ名家でありながら、魔道に耽り堕落の一途を辿った、呪われたダンウィッチに在って、なお呪われた一族の名をウェイトリイと云う。",
   "ko_candidate": "세계로부터 격리되어､ 더욱 쇠퇴의 길을 걷는 이 마을에 사는､ 오래된 가계｡ 원래는 문장을 달 자격을 가진 명가였으나､ 마도에 빠져 타락의 길을 걸은､ 저주받은 던위치에 있어서､ 더욱 저주받은 일족의 이름을 웨이틀리라고 한다｡"
  },
  {
   "id": 32090,
   "key": "D1304ru.txt:19",
   "file": "D1304ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ダンウィッチの怪。",
   "ko_candidate": "던위치의 괴｡"
  }
 ]
}