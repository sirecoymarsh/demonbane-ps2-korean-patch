   "key": "D1414le.txt:653",
   "file": "D1414le.txt",
   "line": 653,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして……",
   "ko_candidate": "그리고……"
  },
  {
   "id": 40530,
   "key": "D1414le.txt:660",
   "file": "D1414le.txt",
   "line": 660,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……あ……ああ……」",
   "ko_candidate": "「아…… 아…… 아아……」"
  },
  {
   "id": 40531,
   "key": "D1414le.txt:664",
