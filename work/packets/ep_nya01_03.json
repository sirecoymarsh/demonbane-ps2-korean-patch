  },
  {
   "id": 50019,
   "key": "ep_nya01.txt:529",
   "file": "ep_nya01.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "堕胎の受胎。",
   "ko_candidate": "완결의 성장｡"
  },
  {
   "id": 50020,
   "key": "ep_nya01.txt:532",
   "file": "ep_nya01.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "完結の成長。",
   "ko_candidate": "고정의 분출｡"
  },
  {
   "id": 50021,
   "key": "ep_nya01.txt:533",
   "file": "ep_nya01.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "固定の噴出。",
   "ko_candidate": "오욕의 순결｡"
  },
  {
   "id": 50022,
   "key": "ep_nya01.txt:534",
   "file": "ep_nya01.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "汚穢の純潔。",
   "ko_candidate": "광기의 질서｡"
  },
  {
   "id": 50023,
   "key": "ep_nya01.txt:535",
   "file": "ep_nya01.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "孤独の共鳴。",
   "ko_candidate": "고독의 공명｡"
  },
  {
   "id": 50024,
   "key": "ep_nya01.txt:541",
   "file": "ep_nya01.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は本を――",
   "ko_candidate": "나는 책을――"
  },
  {
   "id": 50025,
   "key": "ep_nya01.txt:556",
   "file": "ep_nya01.txt",
   "line": 556,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 50026,
   "key": "ep_nya01.txt:560",
   "file": "ep_nya01.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔導書の頁が、花吹雪のように舞っていた。",
   "ko_candidate": "마도서의 페이지가､ 꽃보라처럼 흩날리고 있었다｡"
  },
  {
   "id": 50027,
   "key": "ep_nya01.txt:562",
   "file": "ep_nya01.txt",
   "line": 562,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうだ。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 50028,
   "key": "ep_nya01.txt:563",
   "file": "ep_nya01.txt",
   "line": 563,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうだった。",
   "ko_candidate": "그랬지｡"
  },
  {
   "id": 50029,
   "key": "ep_nya01.txt:565",
   "file": "ep_nya01.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "かつて。",
   "ko_candidate": "예전에｡"
  },
  {
   "id": 50030,
   "key": "ep_nya01.txt:566",
   "file": "ep_nya01.txt",
   "line": 566,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺がまだ陰秘学科の生徒だった頃。",
   "ko_candidate": "내가 아직 은비학과의 학생이었을 때｡"
  },
  {
   "id": 50031,
   "key": "ep_nya01.txt:567",
   "file": "ep_nya01.txt",
   "line": 567,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "初めての魔導書閲覧の時。",
   "ko_candidate": "처음으로 마도서를 열람했을 때｡"
  },
  {
   "id": 50032,
   "key": "ep_nya01.txt:569",
   "file": "ep_nya01.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺はこの場所で――あの怪異と出遭ったのだ。",
   "ko_candidate": "나는 이곳에서――그 괴이와 마주쳤던 것이다｡"
  },
  {
   "id": 50033,
   "key": "ep_nya01.txt:578",
   "file": "ep_nya01.txt",
   "line": 578,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――ミスカトニック大学、秘密図書館。",
   "ko_candidate": "――미스카토닉 대학､ 비밀 도서관｡"
  },
  {
   "id": 50034,
   "key": "ep_nya01.txt:590",
   "file": "ep_nya01.txt",
   "line": 590,
   "speaker": "アル（回想）",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――まだ早い」",
   "ko_candidate": "「――아직 이르다」"
  },
  {
   "id": 50035,
   "key": "ep_nya01.txt:601",
   "file": "ep_nya01.txt",
   "line": 601,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "記憶が疼く。",
   "ko_candidate": "기억이 욱신거린다｡"
  },
  {
   "id": 50036,
   "key": "ep_nya01.txt:602",
   "file": "ep_nya01.txt",
   "line": 602,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "疼きはだんだん激しくなり、 頭が割れるような激痛となった。",
   "ko_candidate": "욱신거림은 점점 심해져､ 머리가 갈라질 듯한 격통이 되었다｡"
  },
  {
   "id": 50037,
   "key": "ep_nya01.txt:604",
   "file": "ep_nya01.txt",
   "line": 604,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それだけが、この悪夢の世界で確かなものだった。",
   "ko_candidate": "그것만이､ 이 악몽의 세계에서 확실한 것이었다｡"
  },
  {
   "id": 50038,
   "key": "ep_nya01.txt:606",
   "file": "ep_nya01.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "脳を灼き、苛む記憶だけを頼りに、俺は図書館の中に足を踏み入れた。",
   "ko_candidate": "뇌를 태우고､ 괴롭히는 기억만을 의지해､ 나는 도서관 안으로 발을 들여놓았다｡"
  },
  {
   "id": 50039,
   "key": "ep_nya01.txt:611",
   "file": "ep_nya01.txt",
   "line": 611,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空間を歪ませるような、強力な魔力のうねり。",
   "ko_candidate": "공간을 왜곡시키는 듯한､ 강력한 마력의 파동｡"
  },
  {
   "id": 50040,
   "key": "ep_nya01.txt:612",
   "file": "ep_nya01.txt",
   "line": 612,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは全て、この図書館の本棚に収められた魔導書が発する妖気。",
   "ko_candidate": "그것은 모두､ 이 도서관의 책장에 수납된 마도서가 발하는 요기｡"
  },
  {
   "id": 50041,
   "key": "ep_nya01.txt:613",
   "file": "ep_nya01.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "高濃度の妖気が、図書館に充満していた。",
   "ko_candidate": "고농도의 요기가､ 도서관에 충만해 있었다｡"
  },
  {
   "id": 50042,
   "key": "ep_nya01.txt:615",
   "file": "ep_nya01.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今の俺に怯む理由は無い。",
   "ko_candidate": "지금의 나에겐 주저할 이유가 없다｡"
  },
  {
   "id": 50043,
   "key": "ep_nya01.txt:616",
   "file": "ep_nya01.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何であろうと、今のこの悪夢より酷くなることは無い。",
   "ko_candidate": "무엇이든 간에､ 지금의 이 악몽보다 더 끔찍해질 순 없다｡"
  },
  {
   "id": 50044,
   "key": "ep_nya01.txt:617",
   "file": "ep_nya01.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は進む。",
   "ko_candidate": "나는 나아간다｡"
  },
  {
   "id": 50045,
   "key": "ep_nya01.txt:618",
   "file": "ep_nya01.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "奥へ、奥へと。",
   "ko_candidate": "안쪽으로､ 더 안쪽으로｡"
  },
  {
   "id": 50046,
   "key": "ep_nya01.txt:633",
   "file": "ep_nya01.txt",
   "line": 633,
   "speaker": "アル（回想）",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「まだ出会うには早い」",
   "ko_candidate": "「아직 만나기엔 이르다」"
  },
  {
   "id": 50047,
   "key": "ep_nya01.txt:645",
   "file": "ep_nya01.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何処かで夜鷹が啼いた。",
   "ko_candidate": "어디선가 밤매가 울었다｡"
  },
  {
   "id": 50048,
   "key": "ep_nya01.txt:646",
   "file": "ep_nya01.txt",
   "line": 646,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィップアーウィル。",
   "ko_candidate": "휘푸어윌｡"
  },
  {
   "id": 50049,
   "key": "ep_nya01.txt:647",
   "file": "ep_nya01.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "伝承に曰く、死者の魂を攫う鷹と。 俺は進む。",
   "ko_candidate": "전설에 따르면､ 죽은 자의 영혼을 잡아채는 매라고｡"
  },
  {
   "id": 50050,
   "key": "ep_nya01.txt:650",
   "file": "ep_nya01.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "奥へ、奥へ。",
   "ko_candidate": "나는 나아간다｡"
  },
  {
   "id": 50051,
   "key": "ep_nya01.txt:652",
   "file": "ep_nya01.txt",
   "line": 652,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "本棚の迷路を。",
   "ko_candidate": "안쪽으로､ 안쪽으로｡"
  },
  {
   "id": 50052,
   "key": "ep_nya01.txt:653",
   "file": "ep_nya01.txt",
   "line": 653,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何処までも伸びてゆく通路を。",
   "ko_candidate": "책장의 미로를｡ 끝없이 뻗어가는 통로를｡"
  },
  {
   "id": 50053,
   "key": "ep_nya01.txt:654",
   "file": "ep_nya01.txt",
   "line": 654,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何処までも拡大してゆく迷路を進む。",
   "ko_candidate": "끝없이 확장되어 가는 미로를 나아간다｡"
  },
  {
   "id": 50054,
   "key": "ep_nya01.txt:656",
   "file": "ep_nya01.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "右に。",
   "ko_candidate": "오른쪽으로｡"
  }
 ]
}