   "ko_candidate": "안녕의 광란｡"
  },
  {
   "id": 50018,
   "key": "ep_nya01.txt:528",
   "file": "ep_nya01.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "安寧の狂乱。",
