 "items": [
  {
   "id": 27701,
   "key": "D1205ru.txt:400",
   "file": "D1205ru.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肩に小さくなったアルが、ちょこんと座っていた。",
   "ko_candidate": "어깨에 작아진 알이 살짝 앉아 있었다｡"
  },
  {
   "id": 27702,
   "key": "D1205ru.txt:401",
   "file": "D1205ru.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "耳元でアルが囁く。",
   "ko_candidate": "귓가에서 알이 속삭인다｡"
  },
  {
   "id": 27703,
   "key": "D1205ru.txt:405",
   "file": "D1205ru.txt",
   "line": 405,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「奴を斃すぞ！　戦い方は妾がナビゲートする！」",
   "ko_candidate": "「놈을 쓰러뜨리자! 싸우는 방법은 내가 안내할게!」"
  },
  {
   "id": 27704,
   "key": "D1205ru.txt:415",
   "file": "D1205ru.txt",
   "line": 415,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ!?」",
   "ko_candidate": "「…………읏!?」"
  },
  {
   "id": 27705,
   "key": "D1205ru.txt:418",
   "file": "D1205ru.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アンチクロスを相手に、デモンベインと云う鎧を纏わず、生身で殺り合う。",
   "ko_candidate": "안티 크로스를 상대로､ 데몬베인이라는 갑옷을 입지 않고､ 맨몸으로 죽이고 죽는다｡"
  },
  {
   "id": 27706,
   "key": "D1205ru.txt:419",
   "file": "D1205ru.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刃の様な戦慄が心はおろか、肉体までをも蹂躙した。",
   "ko_candidate": "칼날 같은 전율이 마음은 물론､ 육체까지도 유린했다｡"
  },
  {
   "id": 27707,
   "key": "D1205ru.txt:420",
   "file": "D1205ru.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが恐怖が致命的に瑠璃を侵すより早く、アルは叱咤した。",
   "ko_candidate": "하지만 공포가 치명적으로 루리를 침범하기 전에､ 알은 꾸짖었다｡"
  },
  {
   "id": 27708,
   "key": "D1205ru.txt:424",
   "file": "D1205ru.txt",
   "line": 424,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「此処まで来て、九郎を死なせるつもりか！　今、この場にアンチクロスと拮抗出来るのは我等だけだ！　戦え！」",
   "ko_candidate": "「여기까지 와서､ 쿠로를 죽게 할 생각이야! 지금､ 이 자리에서 안티 크로스와 맞설 수 있는 건 우리뿐이야! 싸워!」"
  },
  {
   "id": 27709,
   "key": "D1205ru.txt:431",
   "file": "D1205ru.txt",
   "line": 431,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――っ！」",
   "ko_candidate": "「――――읏!」"
  },
  {
   "id": 27710,
   "key": "D1205ru.txt:437",
   "file": "D1205ru.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖を力尽くで抑え込み、勇気を無理矢理に奮い立たせ、覚悟を武装する。",
   "ko_candidate": "공포를 억지로 억누르고､ 용기를 억지로 불러일으키며､ 각오를 무장한다｡"
  },
  {
   "id": 27711,
   "key": "D1205ru.txt:440",
   "file": "D1205ru.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳内を疾走する術式。手に持った偃月刀に刻まれた魔術文字が炎える。",
   "ko_candidate": "뇌내를 질주하는 술식｡ 손에 든 언월도에 새겨진 마술 문자가 불타오른다｡"
  },
  {
   "id": 27712,
   "key": "D1205ru.txt:441",
   "file": "D1205ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光り輝くそれを、正眼に構えた。",
   "ko_candidate": "빛나는 그것을､ 정면으로 겨누었다｡"
  },
  {
   "id": 27713,
   "key": "D1205ru.txt:446",
   "file": "D1205ru.txt",
   "line": 446,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「気色悪ィんだよ！ 邪魔だァァァァ――――ッ！」",
   "ko_candidate": "「역겨워! 방해돼에에에에――――읏!」"
  },
  {
   "id": 27714,
   "key": "D1205ru.txt:453",
   "file": "D1205ru.txt",
   "line": 453,
   "speaker": "ダンセイニ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てけり・り」",
   "ko_candidate": "「테켈리?리」"
  },
  {
   "id": 27715,
   "key": "D1205ru.txt:457",
   "file": "D1205ru.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が爆裂し、ダンセイニを吹き飛ばした。",
   "ko_candidate": "바람이 폭발하고､ 던세이니를 날려버렸다｡"
  },
  {
   "id": 27716,
   "key": "D1205ru.txt:459",
   "file": "D1205ru.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛び散った粘着質の肉体を掻き集めて、ダンセイニは召喚円の中へと逃げ込んだ。",
   "ko_candidate": "흩어진 점착질의 육체를 긁어모아､ 던세이니는 소환진 안으로 도망쳤다｡"
  },
  {
   "id": 27717,
   "key": "D1205ru.txt:461",
   "file": "D1205ru.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自由になったクラウディウス。だがエルザが即座に襲いかかる。",
   "ko_candidate": "자유로워진 클라우디우스｡ 하지만 엘자가 즉시 덮쳐온다｡"
  },
  {
   "id": 27718,
   "key": "D1205ru.txt:470",
   "file": "D1205ru.txt",
   "line": 470,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おらおらおらおらロボ――っ！」",
   "ko_candidate": "「오라오라오라오라 로봇――읏!」"
  },
  {
   "id": 27719,
   "key": "D1205ru.txt:481",
   "file": "D1205ru.txt",
   "line": 481,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちぃぃっ……！」",
   "ko_candidate": "「치이이읏……!」"
  },
  {
   "id": 27720,
   "key": "D1205ru.txt:486",
   "file": "D1205ru.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "トンファーの乱舞。",
   "ko_candidate": "통파의 난무｡"
  },
  {
   "id": 27721,
   "key": "D1205ru.txt:488",
   "file": "D1205ru.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それをかわし、あるいは魔風を纏った腕で弾く、クラウディウス。",
   "ko_candidate": "그것을 피하고､ 혹은 마풍을 두른 팔로 튕겨내는､ 클라우디우스｡"
  },
  {
   "id": 27722,
   "key": "D1205ru.txt:491",
   "file": "D1205ru.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は打突と疾風の弾幕の只中へと、突撃した。",
   "ko_candidate": "루리는 타격과 질풍의 탄막 한가운데로､ 돌격했다｡"
  },
  {
   "id": 27723,
   "key": "D1205ru.txt:492",
   "file": "D1205ru.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剣を手に、駈ける！",
   "ko_candidate": "검을 손에､ 달린다!"
  },
  {
   "id": 27724,
   "key": "D1205ru.txt:496",
   "file": "D1205ru.txt",
   "line": 496,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やああああぁぁぁぁぁぁぁ！」",
   "ko_candidate": "「야아아아아아아아아아아!」"
  }
 ]
