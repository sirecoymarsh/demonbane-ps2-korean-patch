 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "リューガ": "류가",
  "ライカ": "라이카",
  "九郎ちゃん": "쿠로 군",
  "サンダルフォン": "산달폰",
  "ライカ・クルセイド": "라이카 크루세이드"
 },
 "items": [
  {
   "id": 48180,
   "key": "D1517le.txt:101",
   "file": "D1517le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の翼から黒い炎を噴いて、リューガが飛翔する。",
   "ko_candidate": "강철 날개에서 검은 불꽃을 뿜으며 류가가 비상한다｡"
  },
  {
   "id": 48181,
   "key": "D1517le.txt:104",
   "file": "D1517le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカもまた光の翼を展開し、リューガと同じ高さまで昇った。",
   "ko_candidate": "라이카 또한 빛의 날개를 펼치고 류가와 같은 높이까지 올랐다｡"
  },
  {
   "id": 48182,
   "key": "D1517le.txt:106",
   "file": "D1517le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滅びの太陽、血濡れの月を背景に、白と黒の影が交差する。",
   "ko_candidate": "멸망의 태양､ 피에 젖은 달을 배경으로 백과 흑의 그림자가 교차한다｡"
  },
  {
   "id": 48183,
   "key": "D1517le.txt:107",
   "file": "D1517le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両者の蹴りが擦れ違った。",
   "ko_candidate": "양자의 발차기가 스쳐 지나갔다｡"
  },
  {
   "id": 48184,
   "key": "D1517le.txt:114",
   "file": "D1517le.txt",
   "line": 114,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「グアァ……！」",
   "ko_candidate": "「크와아…!」"
  },
  {
   "id": 48185,
   "key": "D1517le.txt:118",
   "file": "D1517le.txt",
   "line": 118,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くぅ……！」",
   "ko_candidate": "「크윽…!」"
  },
  {
   "id": 48186,
   "key": "D1517le.txt:121",
   "file": "D1517le.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれ合い、それぞれ別の廃ビルの屋上に着地、対峙する。",
   "ko_candidate": "튕겨져 나가 각자 다른 폐빌딩의 옥상에 착지하여 대치한다｡"
  },
  {
   "id": 48187,
   "key": "D1517le.txt:125",
   "file": "D1517le.txt",
   "line": 125,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「リューガ……貴方の目的は、九郎ちゃんではないでしょう？」",
   "ko_candidate": "「류가…… 당신의 목적은 쿠로 군이 아니겠죠?」"
  },
  {
   "id": 48188,
   "key": "D1517le.txt:129",
   "file": "D1517le.txt",
   "line": 129,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハァーハハッ！　ようやくその気になったか、ライカ？」",
   "ko_candidate": "「하아하하! 드디어 그 마음이 들었나､ 라이카?」"
  },
  {
   "id": 48189,
   "key": "D1517le.txt:133",
   "file": "D1517le.txt",
   "line": 133,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 48190,
   "key": "D1517le.txt:136",
   "file": "D1517le.txt",
   "line": 136,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカは黙って、昏い狂気に沈んだリューガの眸を覗き込む。",
   "ko_candidate": "라이카는 말없이 어두운 광기에 빠진 류가의 눈동자를 들여다본다｡"
  },
  {
   "id": 48191,
   "key": "D1517le.txt:137",
   "file": "D1517le.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リューガがこの狂気に冒されたのは、いつからなのだろう？",
   "ko_candidate": "류가가 이 광기에 물든 건 언제부터일까?"
  },
  {
   "id": 48192,
   "key": "D1517le.txt:139",
   "file": "D1517le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分が、彼を殺した時か。",
   "ko_candidate": "자신이 그를 죽였을 때부터일까｡"
  },
  {
   "id": 48193,
   "key": "D1517le.txt:140",
   "file": "D1517le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう、思っていた。",
   "ko_candidate": "그렇게 생각했었다｡"
  },
  {
   "id": 48194,
   "key": "D1517le.txt:141",
   "file": "D1517le.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの日を境に、総てが狂った。",
   "ko_candidate": "그날을 기점으로 모든 것이 미쳐버렸다｡"
  },
  {
   "id": 48195,
   "key": "D1517le.txt:142",
   "file": "D1517le.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの日を境に、過去と現在は断絶した。",
   "ko_candidate": "그날을 기점으로 과거와 현재는 단절되었다｡"
  },
  {
   "id": 48196,
   "key": "D1517le.txt:144",
   "file": "D1517le.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。信じて疑わなかった。",
   "ko_candidate": "그래｡ 의심 없이 믿었다｡"
  },
  {
   "id": 48197,
   "key": "D1517le.txt:145",
   "file": "D1517le.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや……そう信じたかった、というだけなのか。",
   "ko_candidate": "아니…… 그렇게 믿고 싶었던 것뿐인가｡"
  },
  {
   "id": 48198,
   "key": "D1517le.txt:147",
   "file": "D1517le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そういう事にしておけば、過去を穢さず、ただ運命の残酷さを呪えば良いだけだった。",
   "ko_candidate": "그렇게 생각하면 과거를 더럽히지 않고､ 그저 운명의 잔혹함을 저주하면 그만이었다｡"
  },
  {
   "id": 48199,
   "key": "D1517le.txt:148",
   "file": "D1517le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この世で２人きりの姉弟。",
   "ko_candidate": "이 세상에서 둘뿐인 남매｡"
  },
  {
   "id": 48200,
   "key": "D1517le.txt:150",
   "file": "D1517le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を分けた弟リューガは死んで、今動いているのは過去の残滓が、リューガの骸を操っているサンダルフォンという怨霊に過ぎない。",
   "ko_candidate": "피를 나눈 동생 류가는 죽고､ 지금 움직이는 건 과거의 잔재가 류가의 시체를 조종하는 산달폰이라는 원령에 불과하다｡"
  },
  {
   "id": 48201,
   "key": "D1517le.txt:151",
   "file": "D1517le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そういう事にしておけば、これ以上、罪を負う必要は無い。",
   "ko_candidate": "그렇게 생각하면 더 이상 죄를 짊어질 필요가 없다｡"
  },
  {
   "id": 48202,
   "key": "D1517le.txt:153",
   "file": "D1517le.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――リューガの狂気が、２人過ごした日々に積み重ねられた想いである事を否定しまえば、それで。",
   "ko_candidate": "――류가의 광기가 둘이 보낸 나날에 쌓아올린 마음이라는 사실을 부정해버리면､ 그걸로｡"
  },
  {
   "id": 48203,
   "key": "D1517le.txt:155",
   "file": "D1517le.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、本当は知っていた。",
   "ko_candidate": "하지만 사실은 알고 있었다｡"
  },
  {
   "id": 48204,
   "key": "D1517le.txt:156",
   "file": "D1517le.txt",
   "line": 156,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『施設』を逃げ出すとき、彼が覗かせた狂気の断片を。",
   "ko_candidate": "『시설』을 도망쳐 나올 때､ 그가 보여준 광기의 단편을｡"
  },
  {
   "id": 48205,
   "key": "D1517le.txt:158",
   "file": "D1517le.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目の当たりにして、知って、だけどそれを嫌悪して、逃げたのだ。",
   "ko_candidate": "목격하고､ 알고､ 하지만 그것을 혐오하며 도망쳤던 것이다｡"
  },
  {
   "id": 48206,
   "key": "D1517le.txt:160",
   "file": "D1517le.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 48207,
   "key": "D1517le.txt:161",
   "file": "D1517le.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分は、あのとき既に逃げていた。",
   "ko_candidate": "자신은 그때 이미 도망치고 있었다｡"
  },
  {
   "id": 48208,
   "key": "D1517le.txt:163",
   "file": "D1517le.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "罪から逃れられないと嘯きながら……一番肝心な罪からこそ、逃げていたのだ。",
   "ko_candidate": "죄에서 벗어날 수 없다고 떠들면서…… 가장 중요한 죄에서야말로 도망치고 있었던 것이다｡"
  },
  {
   "id": 48209,
   "key": "D1517le.txt:165",
   "file": "D1517le.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は言った。",
   "ko_candidate": "그는 말했다｡"
  },
  {
   "id": 48210,
   "key": "D1517le.txt:166",
   "file": "D1517le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカ・クルセイドは自分にとっての牢獄だと。",
   "ko_candidate": "라이카 크루세이드는 자신에게 감옥이라고｡"
  },
  {
   "id": 48211,
   "key": "D1517le.txt:167",
   "file": "D1517le.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しろい、牢獄だと。",
   "ko_candidate": "하얀 감옥이라고｡"
  },
  {
   "id": 48212,
   "key": "D1517le.txt:169",
   "file": "D1517le.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ライカ・クルセイドにとって、あの『施設』がしろい牢獄だったのと同じように。",
   "ko_candidate": "라이카 크루세이드에게 그 『시설』이 하얀 감옥이었던 것과"
  },
  {
   "id": 48213,
   "key": "D1517le.txt:173",
   "file": "D1517le.txt",
   "line": 173,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「リューガ……貴方にとって、私は枷でしかなかったの？」",
   "ko_candidate": "똑같이｡ 「류가…… 당신에게 나는 족쇄에 불과했던 거야?」"
  },
  {
   "id": 48214,
   "key": "D1517le.txt:176",
   "file": "D1517le.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気付けば、静かに問うていた。",
   "ko_candidate": "깨닫고 보니 조용히 묻고 있었다｡"
  },
  {
   "id": 48215,
   "key": "D1517le.txt:178",
   "file": "D1517le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この期に及んで、彼を責めるように。",
   "ko_candidate": "이 시점에 와서 그를 탓하듯이｡"
  },
  {
   "id": 48216,
   "key": "D1517le.txt:179",
   "file": "D1517le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この期に及んで、今さら、悔いるように。",
   "ko_candidate": "이 시점에 와서 이제 와서 후회하듯이｡"
  },
  {
   "id": 48217,
   "key": "D1517le.txt:181",
   "file": "D1517le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの卑劣さが心底、憎かった。",
   "ko_candidate": "자신의 비열함이 뼛속 깊이 증오스러웠다｡"
  },
  {
   "id": 48218,
   "key": "D1517le.txt:185",
   "file": "D1517le.txt",
   "line": 185,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  },
  {
   "id": 48219,
   "key": "D1517le.txt:188",
   "file": "D1517le.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがその時、リューガの眸から、昏い狂気が追い払われた。",
   "ko_candidate": "하지만 그때､ 류가의 눈동자에서 어두운 광기가 사라졌다｡"
  }
 ]
}