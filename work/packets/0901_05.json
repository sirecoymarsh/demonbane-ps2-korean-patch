 "items": [
  {
   "id": 17962,
   "key": "D0901ru.txt:154",
   "file": "D0901ru.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私は魅入られていた。",
   "ko_candidate": "나는 매료되어 있었다｡"
  },
  {
   "id": 17963,
   "key": "D0901ru.txt:155",
   "file": "D0901ru.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人が、刃金の下に内在する、圧倒的な力の気配――それは、ただ純粋に戦う為に生まれた存在。ただ純粋なる意志の結晶。",
   "ko_candidate": "거인이､ 칼날 아래에 내재된 압도적인 힘의 기척 - 그것은 오로지 순수하게 싸우기 위해 태어난 존재｡ 오로지 순수한 의지의 결정체｡"
  },
  {
   "id": 17964,
   "key": "D0901ru.txt:157",
   "file": "D0901ru.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは、ただ純粋な美そのものだった。",
   "ko_candidate": "그것은 오로지 순수한 아름다움 그 자체였다｡"
  },
  {
   "id": 17965,
   "key": "D0901ru.txt:158",
   "file": "D0901ru.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今はまだ、その力は――",
   "ko_candidate": "지금은 아직 그 힘은 -"
  },
  {
   "id": 17966,
   "key": "D0901ru.txt:162",
   "file": "D0901ru.txt",
   "line": 162,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今はまだ、その力は眠っている。 デモンベインを動かせる鍵は一つ。力ある魔導書だけだ」",
   "ko_candidate": "「지금은 아직 그 힘이 잠들어 있다｡ 데몬베인을 움직일 수 있는 열쇠는 하나｡ 힘 있는 마도서뿐이다」"
  },
  {
   "id": 17967,
   "key": "D0901ru.txt:167",
   "file": "D0901ru.txt",
   "line": 167,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「魔導書？」",
   "ko_candidate": "「마도서?」"
  },
  {
   "id": 17968,
   "key": "D0901ru.txt:170",
   "file": "D0901ru.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意外な言葉に、私は振り向いた。",
   "ko_candidate": "뜻밖의 말에 나는 돌아보았다｡"
  },
  {
   "id": 17969,
   "key": "D0901ru.txt:171",
   "file": "D0901ru.txt",
   "line": 171,
   "speaker": "鋼造",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "私を見つめ返して、お爺様は頷く。 「そうだ。『ブラックロッジ』の力の根源は邪悪な魔術」",
   "ko_candidate": "나를 바라보며 할아버지는 고개를 끄덕인다｡"
  },
  {
   "id": 17970,
   "key": "D0901ru.txt:178",
   "file": "D0901ru.txt",
   "line": 178,
   "speaker": "鋼造",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「魔術に対抗できる手段は唯一、 魔術しかない」 「デモンベインは外道の法を操りながら、それでも外道を狩る、闇の中の光なのだ」",
   "ko_candidate": "「그렇다｡ 『블랙로지』의 힘의 근원은 사악한 마술｡ 마술에 대항할 수 있는 수단은 오직､ 마술뿐이다｡ 데몬베인은 외도의 법을 다루면서도 그래도 외도를 사냥하는､ 어둠 속의 빛이다」"
  },
  {
   "id": 17971,
   "key": "D0901ru.txt:185",
   "file": "D0901ru.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お爺様の瞳は、凝っと私を見つめ続ける。",
   "ko_candidate": "할아버지의 눈동자는 뚫어지게 나를 바라본다｡"
  },
  {
   "id": 17972,
   "key": "D0901ru.txt:187",
   "file": "D0901ru.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鷹の瞳。",
   "ko_candidate": "매의 눈동자｡"
  },
  {
   "id": 17973,
   "key": "D0901ru.txt:188",
   "file": "D0901ru.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦士の瞳。",
   "ko_candidate": "전사의 눈동자｡"
  },
  {
   "id": 17974,
   "key": "D0901ru.txt:189",
   "file": "D0901ru.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは絶望に呑み込まれ溺れようと、それでも足掻き戦う、闇を裂いてなお爛々と耀く瞳だ。",
   "ko_candidate": "그것은 절망에 삼켜져 빠지려 해도 그래도 발버둥 치며 싸우는､"
  },
  {
   "id": 17975,
   "key": "D0901ru.txt:193",
   "file": "D0901ru.txt",
   "line": 193,
   "speaker": "鋼造",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベインの力が今こそ必要になったと感じた、その時は――瑠璃」 「魔導書を探しなさい」",
   "ko_candidate": "어둠을 가르고도 여전히 찬란히 빛나는 눈동자다｡"
  },
  {
   "id": 17976,
   "key": "D0901ru.txt:199",
   "file": "D0901ru.txt",
   "line": 199,
   "speaker": "鋼造",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『ブラックロッジ』が所有するあらゆる外道を凌駕する外道の力を」 「そして、デモンベインのパイロットを――その外道を駆りながらも、決して外道に呑み込まれぬ正義を貫く戦士を探しなさい」",
   "ko_candidate": "「데몬베인의 힘이 지금이야말로 필요하다고 느낀 그때는 - 루리｡ 마도서를 찾아라｡ 『블랙로지』가 소유한 모든 외도를 능가하는 외도의 힘을｡ 그리고 데몬베인의 파일럿을 - 그 외도를 다루면서도 결코 외도에 삼켜지지 않는 정의를 관철하는 전사를 찾아라」"
  },
  {
   "id": 17977,
   "key": "D0901ru.txt:205",
   "file": "D0901ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お爺様は言った。",
   "ko_candidate": "할아버지가 말했다｡"
  },
  {
   "id": 17978,
   "key": "D0901ru.txt:206",
   "file": "D0901ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶対の意志と共に、私に願いを託す。",
   "ko_candidate": "절대적인 의지와 함께 나에게 소원을 맡긴다｡"
  },
  {
   "id": 17979,
   "key": "D0901ru.txt:207",
   "file": "D0901ru.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――",
   "ko_candidate": "그리고 -"
  },
  {
   "id": 17980,
   "key": "D0901ru.txt:211",
   "file": "D0901ru.txt",
   "line": 211,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「デモンベインがアーカムシティを、そしてお前を護るだろう」",
   "ko_candidate": "「데몬베인이 아캄시티를､ 그리고 너를 지켜줄 것이다」"
  },
  {
   "id": 17981,
   "key": "D0901ru.txt:214",
   "file": "D0901ru.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お爺様は誓った。",
   "ko_candidate": "할아버지는 맹세했다｡"
  },
  {
   "id": 17982,
   "key": "D0901ru.txt:215",
   "file": "D0901ru.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶対の約定と共に、私に祝福を与える。",
   "ko_candidate": "절대적인 약속과 함께 나에게 축복을 내린다｡"
  },
  {
   "id": 17983,
   "key": "D0901ru.txt:219",
   "file": "D0901ru.txt",
   "line": 219,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「このロボットが……」",
   "ko_candidate": "「이 로봇이…」"
  },
  {
   "id": 17984,
   "key": "D0901ru.txt:222",
   "file": "D0901ru.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは眠っている。",
   "ko_candidate": "데몬베인은 잠들어 있다｡"
  },
  {
   "id": 17985,
   "key": "D0901ru.txt:223",
   "file": "D0901ru.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眠りながら、夢を見る。",
   "ko_candidate": "잠들면서 꿈을 꾼다｡"
  },
  {
   "id": 17986,
   "key": "D0901ru.txt:224",
   "file": "D0901ru.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らを駆る正義を待ち望んで――",
   "ko_candidate": "자신을 움직일 정의를 기다리며 -"
  },
  {
   "id": 17987,
   "key": "D0901ru.txt:254",
   "file": "D0901ru.txt",
   "line": 254,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふむ、大した銃だなこれは。デウス・マキナと同じ魔術理論を以てして造られておる」 「バルザイの偃月刀と同様に儀式の媒介として機能するうえに、この弾丸――」",
   "ko_candidate": "「흠､ 대단한 총이군 이건｡ 데우스 마키나와 같은 마술 이론으로 만들어졌어｡ 바르자이의 언월도와 마찬가지로 의식의 매개체로 기능할 뿐만 아니라､ 이 탄환 -」"
  },
  {
   "id": 17988,
   "key": "D0901ru.txt:261",
   "file": "D0901ru.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルは『クトゥグア』のマガジンから、弾丸をひとつ取り出した。",
   "ko_candidate": "알은 『크투가』의 탄창에서 탄환 하나를 꺼냈다｡"
  },
  {
   "id": 17989,
   "key": "D0901ru.txt:262",
   "file": "D0901ru.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "片目を瞑り弾丸の細かいところまで観察する。",
   "ko_candidate": "한쪽 눈을 감고 탄환의 세세한 부분까지 관찰한다｡"
  },
  {
   "id": 17990,
   "key": "D0901ru.txt:267",
   "file": "D0901ru.txt",
   "line": 267,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふん、手の込んだことだ。弾丸の一つ一つに洗礼を施してある」 「『The minions of Cthugha』か……魔力を注ぎ込めば、爆裂弾にもなるな」",
   "ko_candidate": "「흥､ 손이 많이 간 일이군｡ 탄환 하나하나에 세례를 베풀어 놓았어｡ 『The minions of Cthugha』인가… 마력을 주입하면 폭렬탄도 되겠군」"
  },
  {
   "id": 17991,
   "key": "D0901ru.txt:274",
   "file": "D0901ru.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は薬莢を取り外し、机の上に火薬をばら蒔く。",
   "ko_candidate": "이번에는 탄피를 분리해 책상 위에 화약을 뿌린다｡"
  },
  {
   "id": 17992,
   "key": "D0901ru.txt:275",
   "file": "D0901ru.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火薬を指ですくい、匂いを確かめる。",
   "ko_candidate": "화약을 손가락으로 집어 냄새를 확인한다｡"
  },
  {
   "id": 17993,
   "key": "D0901ru.txt:280",
   "file": "D0901ru.txt",
   "line": 280,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やはりな。火薬に『イブン・ガズイの粉薬』を混ぜておる」 「この粉薬はな、霊的存在の物質化を促す霊薬だ。弾丸それ自体に魔術的効果をもたらせてある訳だな」",
   "ko_candidate": "「역시나｡ 화약에 『이븐 가지의 분말』을 섞어 놓았어｡ 이 분말은 말이다､ 영적 존재의 물질화를 촉진하는 영약이지｡ 탄환 그 자체에 마술적 효과를 부여한 거야」"
  },
  {
   "id": 17994,
   "key": "D0901ru.txt:287",
   "file": "D0901ru.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は『イタクァ』の弾丸を摘まんで観察する。",
   "ko_candidate": "이번에는 『이타콰』의 탄환을 집어 관찰한다｡"
  },
  {
   "id": 17995,
   "key": "D0901ru.txt:292",
   "file": "D0901ru.txt",
   "line": 292,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こっちもだ。 『Wendigo the Blackwood』」 「これでクトゥグアの問題はおろか、イタクァを操る術まで手に入れた。 ……使わぬ手は無いな」",
   "ko_candidate": "「이쪽도 마찬가지군｡ 『Wendigo the Blackwood』｡ 이걸로 크투가 문제는 물론이고､ 이타콰를 다루는 술법까지 손에 넣었어｡ …쓰지 않을 수 없겠군」"
  },
  {
   "id": 17996,
   "key": "D0901ru.txt:303",
   "file": "D0901ru.txt",
   "line": 303,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……」",
   "ko_candidate": "「아아…」"
  },
  {
   "id": 17997,
   "key": "D0901ru.txt:305",
   "file": "D0901ru.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２挺の魔銃を見つめながら、俺は頷いた。",
   "ko_candidate": "두 자루의 마총을 바라보며 나는 고개를 끄덕였다｡"
  },
  {
   "id": 17998,
   "key": "D0901ru.txt:307",
   "file": "D0901ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの時、２体の鬼械神相手に見せたあの威力……確かにコイツは心強い武器だ。",
   "ko_candidate": "그때､ 두 마리의 귀계신을 상대로 보여준 그 위력… 확실히 이놈은 든든한 무기다｡"
  },
  {
   "id": 17999,
   "key": "D0901ru.txt:307",
   "file": "D0901ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど当然、引っかかることが多い。",
   "ko_candidate": "하지만 당연히 걸리는 점이 많다｡"
  },
  {
   "id": 18000,
   "key": "D0901ru.txt:309",
   "file": "D0901ru.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悩む俺の様子を、アルは上の空の返事と受け取ったか、やや怒った風に問い詰めてきた。",
   "ko_candidate": "고민하는 내 모습을 알은 건성으로 대답한 것으로 받아들였는지､ 약간 화난 듯이 추궁해 왔다｡"
  },
  {
   "id": 18001,
   "key": "D0901ru.txt:315",
   "file": "D0901ru.txt",
   "line": 315,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何を柄にもなく、思い詰めた表情をしておる？」",
   "ko_candidate": "「무슨 일로 그렇게 심각한 표정을 짓고 있는 거지?」"
  }
 ]
}