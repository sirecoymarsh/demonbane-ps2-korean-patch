 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "メタトロン": "메타트론",
  "大十字九郎": "다이쥬지 쿠로",
  "サンダルフォン": "산달폰"
 },
 "items": [
  {
   "id": 29218,
   "key": "D1210le.txt:216",
   "file": "D1210le.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線は仮面に隠され、子ども達はそれには気付かない。",
   "ko_candidate": "시선은 가면에 가려져 아이들은 그것을 알아채지 못한다｡"
  },
  {
   "id": 29219,
   "key": "D1210le.txt:218",
   "file": "D1210le.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の下の愛と悲しみと悔恨と決意に気付かない。",
   "ko_candidate": "가면 아래의 사랑과 슬픔과 회한과 결의를 알아채지 못한다｡"
  },
  {
   "id": 29220,
   "key": "D1210le.txt:219",
   "file": "D1210le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンは断言する。",
   "ko_candidate": "메타트론은 단언한다｡"
  },
  {
   "id": 29221,
   "key": "D1210le.txt:224",
   "file": "D1210le.txt",
   "line": 224,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの子達のような輝ける命がある。大十字九郎のような輝ける魂がある」 「そう。私には――この街がある。独りではない」",
   "ko_candidate": "「저 아이들 같은 빛나는 생명이 있다｡ 다이쥬지 쿠로 같은 빛나는 영혼이 있다｡ 그래｡ 나에겐――이 거리가 있다｡ 혼자가 아니다」"
  },
  {
   "id": 29222,
   "key": "D1210le.txt:234",
   "file": "D1210le.txt",
   "line": 234,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……そして、その総てを貪る。 その輝ける命とやらを糧に、貴様は穢れた朝を往くのだ」",
   "ko_candidate": "「……그리고 그 모든 것을 탐한다｡ 그 빛나는 생명이란 것을 양식 삼아 네놈은 더러운 아침을 향해 가는 것이다」"
  },
  {
   "id": 29223,
   "key": "D1210le.txt:240",
   "file": "D1210le.txt",
   "line": 240,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「私は、お前とは違う」",
   "ko_candidate": "「나는 너와는 다르다」"
  },
  {
   "id": 29224,
   "key": "D1210le.txt:244",
   "file": "D1210le.txt",
   "line": 244,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……許さん」",
   "ko_candidate": "「……용서 못 해」"
  },
  {
   "id": 29225,
   "key": "D1210le.txt:247",
   "file": "D1210le.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンは聞いては居ない。",
   "ko_candidate": "산달폰은 듣고 있지 않다｡"
  },
  {
   "id": 29226,
   "key": "D1210le.txt:248",
   "file": "D1210le.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ湧き上がる激情に、身を灼くだけだ。",
   "ko_candidate": "단지 솟구치는 격정에 몸을 태울 뿐이다｡"
  },
  {
   "id": 29227,
   "key": "D1210le.txt:249",
   "file": "D1210le.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何の言葉も、届きはしない。",
   "ko_candidate": "어떤 말도 닿지 않는다｡"
  },
  {
   "id": 29228,
   "key": "D1210le.txt:253",
   "file": "D1210le.txt",
   "line": 253,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「許さんぞ……！」",
   "ko_candidate": "「용서 못 한다……!」"
  },
  {
   "id": 29229,
   "key": "D1210le.txt:258",
   "file": "D1210le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンが構える。",
   "ko_candidate": "산달폰이 자세를 잡는다｡"
  },
  {
   "id": 29230,
   "key": "D1210le.txt:259",
   "file": "D1210le.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強大な気が、サンダルフォンの躰へと流れ込む。",
   "ko_candidate": "강대한 기가 산달폰의 몸으로 흘러 들어간다｡"
  },
  {
   "id": 29231,
   "key": "D1210le.txt:261",
   "file": "D1210le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の総てを飲み込まんとする程の勢いで。",
   "ko_candidate": "세상의 모든 것을 삼켜버릴 듯한 기세로｡"
  },
  {
   "id": 29232,
   "key": "D1210le.txt:262",
   "file": "D1210le.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 29233,
   "key": "D1210le.txt:266",
   "file": "D1210le.txt",
   "line": 266,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「己を置き去りに独り往く貴様を……己は決して、許さない！」",
   "ko_candidate": "「자신을 버려두고 혼자 가는 네놈을……나는 결코 용서하지 않는다!」"
  },
  {
   "id": 29234,
   "key": "D1210le.txt:272",
   "file": "D1210le.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い、爆発。",
   "ko_candidate": "검은 폭발｡"
  },
  {
   "id": 29235,
   "key": "D1210le.txt:273",
   "file": "D1210le.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンが地面を蹴ると同時、黒い衝撃波が拡がる。",
   "ko_candidate": "산달폰이 땅을 박차는 동시에 검은 충격파가 퍼진다｡"
  },
  {
   "id": 29236,
   "key": "D1210le.txt:275",
   "file": "D1210le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い暴風となって、怒濤と襲いかかり、メタトロンを呑み込む。",
   "ko_candidate": "검은 폭풍이 되어 격렬하게 덮쳐 메타트론을 삼켜버린다｡"
  },
  {
   "id": 29237,
   "key": "D1210le.txt:279",
   "file": "D1210le.txt",
   "line": 279,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「鬼殺ァァァァァァァァァァ！」",
   "ko_candidate": "「귀살아아아아아아아아아아!」"
  },
  {
   "id": 29238,
   "key": "D1210le.txt:284",
   "file": "D1210le.txt",
   "line": 284,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シッ……！」",
   "ko_candidate": "「쉿……!」"
  },
  {
   "id": 29239,
   "key": "D1210le.txt:308",
   "file": "D1210le.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正拳。平拳。裏拳。掌底。手刀。背刀。貫手。肘打ち。",
   "ko_candidate": "정권｡ 평권｡ 배권｡ 장저｡ 수도｡ 배도｡ 관수｡ 팔꿈치 치기｡"
  },
  {
   "id": 29240,
   "key": "D1210le.txt:332",
   "file": "D1210le.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃の嵐は人間の動体視力を越え、黒く鋭い影が幾重にも踊っているようにしか見えない。",
   "ko_candidate": "공격의 폭풍은 인간의 동체시력을 넘어 검고 날카로운 그림자가 여러 겹으로 춤추는 것처럼밖에 보이지 않는다｡"
  },
  {
   "id": 29241,
   "key": "D1210le.txt:337",
   "file": "D1210le.txt",
   "line": 337,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その黒い幻影を、吹き荒れる黒い嵐を、二振りのビームセイバーが斬り裂いて迅る。",
   "ko_candidate": "그 검은 환영을､ 휘몰아치는 검은 폭풍을 두 자루의 빔 세이버가 갈라 번쩍인다｡"
  },
  {
   "id": 29242,
   "key": "D1210le.txt:340",
   "file": "D1210le.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "繰り返される攻防。",
   "ko_candidate": "반복되는 공방｡"
  },
  {
   "id": 29243,
   "key": "D1210le.txt:341",
   "file": "D1210le.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳撃を撃ち落とす剣撃。剣撃を払う拳撃。",
   "ko_candidate": "권격을 쳐내는 검격｡ 검격을 치는 권격｡"
  },
  {
   "id": 29244,
   "key": "D1210le.txt:342",
   "file": "D1210le.txt",
   "line": 342,
   "speaker": "サンダルフォン",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "影が舞い、光が飛ぶ。 「旋ッ！　刃ッ！」",
   "ko_candidate": "그림자가 춤추고 빛이 날아간다｡"
  },
  {
   "id": 29245,
   "key": "D1210le.txt:365",
   "file": "D1210le.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンの背中が見えた。",
   "ko_candidate": "「선! 인!」 산달폰의 등이 보였다｡"
  },
  {
   "id": 29246,
   "key": "D1210le.txt:366",
   "file": "D1210le.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "首を斬り落とさんと漆黒の鎌が迫る。",
   "ko_candidate": "목을 베어내려 칠흑의 낫이 다가온다｡"
  },
  {
   "id": 29247,
   "key": "D1210le.txt:368",
   "file": "D1210le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンの回し蹴りだ。",
   "ko_candidate": "산달폰의 회전 차기다｡"
  },
  {
   "id": 29248,
   "key": "D1210le.txt:374",
   "file": "D1210le.txt",
   "line": 374,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 29249,
   "key": "D1210le.txt:377",
   "file": "D1210le.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "旋風は後を追ってくる。",
   "ko_candidate": "선풍이 뒤를 쫓아온다｡"
  },
  {
   "id": 29250,
   "key": "D1210le.txt:378",
   "file": "D1210le.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蹴りの軌跡上にメタトロンは居ない。",
   "ko_candidate": "차기의 궤적상에 메타트론은 없다｡"
  },
  {
   "id": 29251,
   "key": "D1210le.txt:380",
   "file": "D1210le.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深くしゃがみ込み、腕を交差させ、二振りのビームセイバーを左右に広げている。",
   "ko_candidate": "깊이 웅크리고 팔을 교차시켜 두 자루의 빔 세이버를 좌우로 펼치고 있다｡"
  },
  {
   "id": 29252,
   "key": "D1210le.txt:385",
   "file": "D1210le.txt",
   "line": 385,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬぅ……!?」",
   "ko_candidate": "「흐응……!?」"
  },
  {
   "id": 29253,
   "key": "D1210le.txt:392",
   "file": "D1210le.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬刹那の間隙を突いて、光が迅る。",
   "ko_candidate": "순간의 틈을 타고 빛이 번쩍인다｡"
  },
  {
   "id": 29254,
   "key": "D1210le.txt:393",
   "file": "D1210le.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い嵐に、光の十字架を刻印する。",
   "ko_candidate": "검은 폭풍에 빛의 십자가를 새긴다｡"
  },
  {
   "id": 29255,
   "key": "D1210le.txt:394",
   "file": "D1210le.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嵐が止んだ。",
   "ko_candidate": "폭풍이 멈췄다｡"
  },
  {
   "id": 29256,
   "key": "D1210le.txt:399",
   "file": "D1210le.txt",
   "line": 399,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「十字・断罪」",
   "ko_candidate": "「십자?단죄」"
  },
  {
   "id": 29257,
   "key": "D1210le.txt:402",
   "file": "D1210le.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蹴り上げた体勢のまま、サンダルフォンは硬直する。",
   "ko_candidate": "차올린 자세 그대로 산달폰은 경직된다｡"
  }
 ]
}