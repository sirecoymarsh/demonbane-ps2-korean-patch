 "items": [
  {
   "id": 38371,
   "key": "D1408ru.txt:526",
   "file": "D1408ru.txt",
   "line": 526,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ！」",
   "ko_candidate": "「――――읏!」"
  },
  {
   "id": 38372,
   "key": "D1408ru.txt:528",
   "file": "D1408ru.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ダゴンの群れを蹴散らしながら飛翔するデモンベインの前方。",
   "ko_candidate": "다곤의 무리를 걷어차며 비행하는 데몬베인의 전방｡"
  },
  {
   "id": 38373,
   "key": "D1408ru.txt:532",
   "file": "D1408ru.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "虚空に無数の剣閃が疾った。",
   "ko_candidate": "허공에 무수한 검광이 질주했다｡"
  },
  {
   "id": 38374,
   "key": "D1408ru.txt:534",
   "file": "D1408ru.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反射的にシャンタクを逆噴射して、静止する。",
   "ko_candidate": "반사적으로 샨타크를 역분사하여 정지한다｡"
  },
  {
   "id": 38375,
   "key": "D1408ru.txt:538",
   "file": "D1408ru.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――目の前の空間が、何も無い空間が、斬り刻まれた。",
   "ko_candidate": "――눈앞의 공간이､ 아무것도 없는 공간이 베어졌다｡"
  },
  {
   "id": 38376,
   "key": "D1408ru.txt:540",
   "file": "D1408ru.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蒼穹が細切れの破片となって、散らばってゆく。",
   "ko_candidate": "창공이 잘게 썬 파편이 되어 흩어져 간다｡"
  },
  {
   "id": 38377,
   "key": "D1408ru.txt:542",
   "file": "D1408ru.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "虚空に生じた、偏多角形を描く時空の裂け目。",
   "ko_candidate": "허공에 생긴 다각형을 그리는 시공의 틈새｡"
  },
  {
   "id": 38378,
   "key": "D1408ru.txt:549",
   "file": "D1408ru.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その向こう側、血の色の宇宙から、鎧武者に似た、鬼にも似た、鋼鉄の巨人が姿を顕す。",
   "ko_candidate": "그 너머､ 피빛 우주에서 갑옷 무사를 닮은､ 귀신을 닮은 강철의 거인이 모습을 드러낸다｡"
  },
  {
   "id": 38379,
   "key": "D1408ru.txt:553",
   "file": "D1408ru.txt",
   "line": 553,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「鬼械神、皇餓……いざ参る」",
   "ko_candidate": "「귀계신､ 황아……이제 가겠소」"
  },
  {
   "id": 38380,
   "key": "D1408ru.txt:557",
   "file": "D1408ru.txt",
   "line": 557,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ティトゥスか！」",
   "ko_candidate": "「……티투스인가!」"
  },
  {
   "id": 38381,
   "key": "D1408ru.txt:560",
   "file": "D1408ru.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟ッ。",
   "ko_candidate": "쾅｡"
  },
  {
   "id": 38382,
   "key": "D1408ru.txt:562",
   "file": "D1408ru.txt",
   "line": 562,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時空の裂け目から皇餓の巨体が躍り出た。",
   "ko_candidate": "시공의 틈새에서 황아의 거체가 뛰어나왔다｡"
  },
  {
   "id": 38383,
   "key": "D1408ru.txt:568",
   "file": "D1408ru.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ダゴンの背中を蹴って、さらに跳躍。",
   "ko_candidate": "다곤의 등을 밟고 더 높이 도약｡"
  },
  {
   "id": 38384,
   "key": "D1408ru.txt:570",
   "file": "D1408ru.txt",
   "line": 570,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの目の前まで迫った。",
   "ko_candidate": "데몬베인의 눈앞까지 다가왔다｡"
  },
  {
   "id": 38385,
   "key": "D1408ru.txt:572",
   "file": "D1408ru.txt",
   "line": 572,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両手に持った刀を振るう。十字に疾る剣閃。",
   "ko_candidate": "양손에 든 칼을 휘두른다｡ 십자로 질주하는 검광｡"
  },
  {
   "id": 38386,
   "key": "D1408ru.txt:575",
   "file": "D1408ru.txt",
   "line": 575,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チィッ！」",
   "ko_candidate": "「치잇!」"
  },
  {
   "id": 38387,
   "key": "D1408ru.txt:579",
   "file": "D1408ru.txt",
   "line": 579,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一つを身を捻ってかわし、一つを偃月刀で跳ね返す。",
   "ko_candidate": "하나는 몸을 비틀어 피하고､ 하나는 언월도로 튕겨냈다｡"
  },
  {
   "id": 38388,
   "key": "D1408ru.txt:581",
   "file": "D1408ru.txt",
   "line": 581,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "響き渡る金属音。",
   "ko_candidate": "울려 퍼지는 금속음｡"
  },
  {
   "id": 38389,
   "key": "D1408ru.txt:583",
   "file": "D1408ru.txt",
   "line": 583,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾かれ合い、同じ極の磁石が反発するように、後ろに飛んだ。",
   "ko_candidate": "튕겨져 나가며､ 같은 극의 자석이 반발하듯이 뒤로 날아갔다｡"
  },
  {
   "id": 38390,
   "key": "D1408ru.txt:590",
   "file": "D1408ru.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お互い、別々のダゴンの背中に着地する。",
   "ko_candidate": "서로 다른 다곤의 등에 착지한다｡"
  },
  {
   "id": 38391,
   "key": "D1408ru.txt:597",
   "file": "D1408ru.txt",
   "line": 597,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「斬り棄て御免！」",
   "ko_candidate": "「베어버리겠소!」"
  },
  {
   "id": 38392,
   "key": "D1408ru.txt:607",
   "file": "D1408ru.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皇餓が、再び跳躍する。",
   "ko_candidate": "황아가 다시 도약한다｡"
  },
  {
   "id": 38393,
   "key": "D1408ru.txt:608",
   "file": "D1408ru.txt",
   "line": 608,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真上から、刀を振り下ろしつつ、降下する巨体。",
   "ko_candidate": "정면에서 칼을 내리치며 강하하는 거체｡"
  },
  {
   "id": 38394,
   "key": "D1408ru.txt:609",
   "file": "D1408ru.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛び退き、避ける。",
   "ko_candidate": "뛰어 물러나 피한다｡"
  },
  {
   "id": 38395,
   "key": "D1408ru.txt:612",
   "file": "D1408ru.txt",
   "line": 612,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ギジャアアアァァァァァァァァ！",
   "ko_candidate": "끼이이이이이이이이이이이잇!"
  },
  {
   "id": 38396,
   "key": "D1408ru.txt:614",
   "file": "D1408ru.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟き渡る、海魔の悲鳴。",
   "ko_candidate": "울려 퍼지는 바다괴물의 비명｡"
  },
  {
   "id": 38397,
   "key": "D1408ru.txt:615",
   "file": "D1408ru.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足場にしていたダゴンの背中が裂けた。",
   "ko_candidate": "발판으로 삼았던 다곤의 등이 갈라졌다｡"
  },
  {
   "id": 38398,
   "key": "D1408ru.txt:616",
   "file": "D1408ru.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "噴射する緑の鮮血を纏って、血風と化した剣撃が奔る。",
   "ko_candidate": "분출하는 초록빛 선혈을 두르고 피바람이 된 검격이 달린다｡"
  },
  {
   "id": 38399,
   "key": "D1408ru.txt:625",
   "file": "D1408ru.txt",
   "line": 625,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２撃目。",
   "ko_candidate": "2격｡"
  },
  {
   "id": 38400,
   "key": "D1408ru.txt:629",
   "file": "D1408ru.txt",
   "line": 629,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ッ！」",
   "ko_candidate": "「……읏!」"
  },
  {
   "id": 38401,
   "key": "D1408ru.txt:632",
   "file": "D1408ru.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぶつかり合う刀と刀。",
   "ko_candidate": "부딪치는 칼과 칼｡"
  },
  {
   "id": 38402,
   "key": "D1408ru.txt:633",
   "file": "D1408ru.txt",
   "line": 633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火花どころが衝撃が弾け飛んだ。",
   "ko_candidate": "불꽃은커녕 충격이 튀어나갔다｡"
  },
  {
   "id": 38403,
   "key": "D1408ru.txt:641",
   "file": "D1408ru.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "続いて３撃目――駄目だ、迅い。",
   "ko_candidate": "이어서 3격――안 된다､ 빠르다｡"
  },
  {
   "id": 38404,
   "key": "D1408ru.txt:649",
   "file": "D1408ru.txt",
   "line": 649,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何とか不恰好にも受け止めた。だけど、次。",
   "ko_candidate": "어떻게든 어설프게나마 받아냈다｡ 하지만 다음은｡"
  },
  {
   "id": 38405,
   "key": "D1408ru.txt:650",
   "file": "D1408ru.txt",
   "line": 650,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "４撃目。",
   "ko_candidate": "4격｡"
  },
  {
   "id": 38406,
   "key": "D1408ru.txt:654",
   "file": "D1408ru.txt",
   "line": 654,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しまった！」",
   "ko_candidate": "「이런!」"
  },
  {
   "id": 38407,
   "key": "D1408ru.txt:661",
   "file": "D1408ru.txt",
   "line": 661,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ついに偃月刀が弾かれた。",
   "ko_candidate": "마침내 언월도가 튕겨나갔다｡"
  },
  {
   "id": 38408,
   "key": "D1408ru.txt:662",
   "file": "D1408ru.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの掌を離れて、回転しながら宙に舞い上がる。",
   "ko_candidate": "데몬베인의 손바닥을 떠나 회전하며 공중으로 날아오른다｡"
  },
  {
   "id": 38409,
   "key": "D1408ru.txt:669",
   "file": "D1408ru.txt",
   "line": 669,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マズイ。マズイ。マズイ。",
   "ko_candidate": "좋지 않아｡ 좋지 않아｡ 좋지 않아｡"
  },
  {
   "id": 38410,
   "key": "D1408ru.txt:670",
   "file": "D1408ru.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐ来るもう来るもう来ている……来た！　５撃目！",
   "ko_candidate": "곧 온다 이미 온다 이미 오고 있다……왔다! 5격!"
  }
 ]
}