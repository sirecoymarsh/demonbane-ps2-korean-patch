{
 "packet": "1302_00",
 "scene": "1302",
 "anchor": {
  "hit": 33,
  "total": 34,
  "rate": 0.971
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ネロ": "네로",
  "アンチクロス": "안티크로스",
  "アウグストゥス": "아우구스투스",
  "ウェスパシアヌス": "베스파시아누스",
  "クラウディウス": "클라우디우스",
  "九郎": "쿠로",
  "エンネア": "엔네아",
  "マスターテリオン": "마스터 테리온"
 },
 "items": [
  {
   "id": 31072,
   "key": "D1302al.txt:17",
   "file": "D1302al.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "長く、長く、闇の奥へと続く廻廊。",
   "ko_candidate": "길고 긴 어둠의 깊은 곳으로 이어지는 회랑｡"
  },
  {
   "id": 31073,
   "key": "D1302al.txt:18",
   "file": "D1302al.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "響く靴音。",
   "ko_candidate": "울리는 구두 소리｡"
  },
  {
   "id": 31074,
   "key": "D1302al.txt:20",
   "file": "D1302al.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音に振り返り――信徒達は１人残らず、凍りついた。",
   "ko_candidate": "소리에 뒤돌아보니―― 신도들은 한 명도 빠짐없이 얼어붙었다｡"
  },
  {
   "id": 31075,
   "key": "D1302al.txt:21",
   "file": "D1302al.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰一人として動けない。",
   "ko_candidate": "누구 하나 움직일 수 없다｡"
  },
  {
   "id": 31076,
   "key": "D1302al.txt:22",
   "file": "D1302al.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "驚愕が、畏怖が、恐怖が、彼らを呪縛する。",
   "ko_candidate": "경악과 외경과 공포가 그들을 속박한다｡"
  },
  {
   "id": 31077,
   "key": "D1302al.txt:29",
   "file": "D1302al.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖に囚われている信徒達の横を、すました顔で少女は通り抜ける。",
   "ko_candidate": "공포에 사로잡힌 신도들 옆을 태연한 얼굴로 소녀가 지나간다｡"
  },
  {
   "id": 31078,
   "key": "D1302al.txt:31",
   "file": "D1302al.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "魔人の巣窟の只中を、罪人達の園の只中を、何ら怯んだ様子も見せず、軽やかな足取りで、鼻唄すら口ずさみながら。奥深く奥深く玉座の間を目指す。",
   "ko_candidate": "마인의 소굴 한가운데를､ 죄인들의 정원 한가운데를､ 전혀 겁먹은 기색도 보이지 않고 가벼운 발걸음으로 콧노래까지 흥얼거리며｡ 깊숙이､ 깊숙이､ 옥좌의 방을 향해 간다｡"
  },
  {
   "id": 31079,
   "key": "D1302al.txt:33",
   "file": "D1302al.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女の名はネロ。",
   "ko_candidate": "소녀의 이름은 네로｡"
  },
  {
   "id": 31080,
   "key": "D1302al.txt:35",
   "file": "D1302al.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この魔人共の庭に在って、この罪人共の園に在って、なお罪深いが故に戒められ、なお異形じみた故に封ぜられた、『暴君』の名を冠せられし魔人。",
   "ko_candidate": "이 마인들의 정원에 있어､ 이 죄인들의 정원에 있어､ 더욱 죄 깊기에 경계되고､ 더욱 기괴하기에 봉인된､"
  },
  {
   "id": 31081,
   "key": "D1302al.txt:45",
   "file": "D1302al.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女が門の前に辿り着いた。",
   "ko_candidate": "『폭군』이라는 이름을 가진 마인｡ 소녀가 문 앞에 도착했다｡"
  },
  {
   "id": 31082,
   "key": "D1302al.txt:46",
   "file": "D1302al.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両脇に控えていた門番が、銃を手に構える。",
   "ko_candidate": "양옆에 대기하고 있던 문지기가 총을 겨눈다｡"
  },
  {
   "id": 31083,
   "key": "D1302al.txt:51",
   "file": "D1302al.txt",
   "line": 51,
   "speaker": "戦闘員Ｄ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「止ま――！」",
   "ko_candidate": "「멈춰―!」"
  },
  {
   "id": 31084,
   "key": "D1302al.txt:57",
   "file": "D1302al.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぼん。",
   "ko_candidate": "퐁｡"
  },
  {
   "id": 31085,
   "key": "D1302al.txt:58",
   "file": "D1302al.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間抜けなくらいに軽い破裂音。",
   "ko_candidate": "어이없을 정도로 가벼운 파열음｡"
  },
  {
   "id": 31086,
   "key": "D1302al.txt:59",
   "file": "D1302al.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "糸が切れた人形のようにくずおれる門番。",
   "ko_candidate": "실이 끊어진 인형처럼 무너져 내리는 문지기｡"
  },
  {
   "id": 31087,
   "key": "D1302al.txt:61",
   "file": "D1302al.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その屍が黒い霧を噴き出し蒸発していく。",
   "ko_candidate": "바닥에 흩어진 피와 뇌장과 두개골 파편이 검은 안개를 뿜어내며 증발해간다｡"
  },
  {
   "id": 31088,
   "key": "D1302al.txt:62",
   "file": "D1302al.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僧院内を充たす瘴気のせいだ。",
   "ko_candidate": "수도원 내를 채우는 장기 때문이다｡"
  },
  {
   "id": 31089,
   "key": "D1302al.txt:66",
   "file": "D1302al.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溶けゆく屍体に目もくれず、少女は門の前に立つ。",
   "ko_candidate": "녹아가는 시체는 쳐다보지도 않고 소녀는 문 앞에 선다｡"
  },
  {
   "id": 31090,
   "key": "D1302al.txt:67",
   "file": "D1302al.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "門の表面に魔法陣が浮かび上がった。",
   "ko_candidate": "문 표면에 마법진이 떠올랐다｡"
  },
  {
   "id": 31091,
   "key": "D1302al.txt:68",
   "file": "D1302al.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "軋みを上げて、ゆっくりと門が開く。",
   "ko_candidate": "삐걱거리며 천천히 문이 열린다｡"
  },
  {
   "id": 31092,
   "key": "D1302al.txt:75",
   "file": "D1302al.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "祭壇にして王座の間。",
   "ko_candidate": "제단이자 왕좌의 방｡"
  },
  {
   "id": 31093,
   "key": "D1302al.txt:76",
   "file": "D1302al.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "古代ローマのコロシアムを思わせる円形の空間。",
   "ko_candidate": "고대 로마의 콜로세움을 연상시키는 원형의 공간｡"
  },
  {
   "id": 31094,
   "key": "D1302al.txt:77",
   "file": "D1302al.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その中央に位置し、広間総てを見渡す玉座。",
   "ko_candidate": "그 중앙에 위치하여 광장 전체를 내려다보는 옥좌｡"
  },
  {
   "id": 31095,
   "key": "D1302al.txt:79",
   "file": "D1302al.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "さらに玉座を囲んで見下ろす、 アンチクロスの席が７つ。",
   "ko_candidate": "더욱이 옥좌를 둘러싸고 내려다보는 안티 크로스의 자리가 7개｡"
  },
  {
   "id": 31096,
   "key": "D1302al.txt:80",
   "file": "D1302al.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その内、４つは空席。",
   "ko_candidate": "그중 4개는 공석｡"
  },
  {
   "id": 31097,
   "key": "D1302al.txt:81",
   "file": "D1302al.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "１つは危難の席であり封じられた席でありネロの席。",
   "ko_candidate": "1개는 위험한 자리이자 봉인된 자리이자 네로의 자리｡"
  },
  {
   "id": 31098,
   "key": "D1302al.txt:83",
   "file": "D1302al.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "残る２つの席に、アウグストゥスとウェスパシアヌスが立っていた。",
   "ko_candidate": "남은 2개의 자리에 아우구스투스와 베스파시아누스가 서 있었다｡"
  },
  {
   "id": 31099,
   "key": "D1302al.txt:84",
   "file": "D1302al.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "正面から乗り込んで来たネロを、真っ直ぐに見据える。",
   "ko_candidate": "정면에서 들어온 네로를 똑바로 바라본다｡"
  },
  {
   "id": 31100,
   "key": "D1302al.txt:91",
   "file": "D1302al.txt",
   "line": 91,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「君の方から来るとはな、ネロ。他のアンチクロスが出払っている今を狙ったか」",
   "ko_candidate": "「네가 먼저 올 줄이야､ 네로｡ 다른 안티 크로스들이 나가있는 지금을 노린 건가」"
  },
  {
   "id": 31101,
   "key": "D1302al.txt:94",
   "file": "D1302al.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アウグストゥスの問いに、ネロはきょとんとした表情で首を傾げた。",
   "ko_candidate": "아우구스투스의 질문에 네로는 어리둥절한 표정으로 고개를 갸웃거렸다｡"
  },
  {
   "id": 31102,
   "key": "D1302al.txt:94",
   "file": "D1302al.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さも心外とでも言わんばかりの呆れ果てた声色で、ネロは答える。",
   "ko_candidate": "마치 억울하다는 듯한 어이없다는 목소리로 네로가 대답한다｡"
  },
  {
   "id": 31103,
   "key": "D1302al.txt:99",
   "file": "D1302al.txt",
   "line": 99,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さっきクラウディウスを片付けたんだけど――もの凄く弱かったよ？」",
   "ko_candidate": "「방금 클라우디우스를 처리했는데―― 엄청 약하더라?」"
  },
  {
   "id": 31104,
   "key": "D1302al.txt:103",
   "file": "D1302al.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄く、微笑む。",
   "ko_candidate": "옅게 미소 짓는다｡"
  },
  {
   "id": 31105,
   "key": "D1302al.txt:104",
   "file": "D1302al.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の前では、エンネアと名乗っていたときには、決して浮かべなかった背筋の凍るような微笑。",
   "ko_candidate": "쿠로 앞에서 엔네아라고 이름을 밝혔을 때는 결코 짓지 않았던 등골이 오싹해지는 미소｡"
  },
  {
   "id": 31106,
   "key": "D1302al.txt:106",
   "file": "D1302al.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "酷く異形じみた、名状し難い邪悪を孕んだ、 それでいて穏やかな微笑。",
   "ko_candidate": "몹시 기괴하고 형언할 수 없는 사악함을 품은､ 그러면서도 온화한"
  },
  {
   "id": 31107,
   "key": "D1302al.txt:109",
   "file": "D1302al.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それはあのマスターテリオンを想起させる。",
   "ko_candidate": "미소｡ 그것은 마스터 테리온을 연상시킨다｡"
  },
  {
   "id": 31108,
   "key": "D1302al.txt:114",
   "file": "D1302al.txt",
   "line": 114,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あんな程度、何匹いても ネロは怖くないけど？ アウグストゥスってば 自信過剰ーっ。あははっ」",
   "ko_candidate": "「그 정도라면 몇 마리가 있어도 네로는 무섭지 않은데? 아우구스투스도 참 자신만만하네｡ 아하핫」"
  },
  {
   "id": 31109,
   "key": "D1302al.txt:122",
   "file": "D1302al.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "笑うネロの瞳には光が無い。",
   "ko_candidate": "웃는 네로의 눈동자에는 빛이 없다｡"
  },
  {
   "id": 31110,
   "key": "D1302al.txt:123",
   "file": "D1302al.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "代わりに冷たく燃え滾る闇黒が在った。",
   "ko_candidate": "대신 차갑게 타오르는 암흑이 있었다｡"
  },
  {
   "id": 31111,
   "key": "D1302al.txt:129",
   "file": "D1302al.txt",
   "line": 129,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………ッ」",
   "ko_candidate": "「………………읏」"
  }
 ]
}