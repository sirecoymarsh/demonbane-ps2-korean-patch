 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ティベリウス": "티베리우스",
  "クラウディウス": "클라우디우스",
  "ライカ": "라이카",
  "イタクァ": "이타콰",
  "マギウス・ウィング": "마기우스 윙",
  "アリスン": "앨리슨"
 },
 "items": [
  {
   "id": 30075,
   "key": "D1213le.txt:535",
   "file": "D1213le.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その挑発が引鉄となった。",
   "ko_candidate": "그 도발이 방아쇠가 되었다｡"
  },
  {
   "id": 30076,
   "key": "D1213le.txt:536",
   "file": "D1213le.txt",
   "line": 536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスとクラウディウスが同時に地面を蹴る！",
   "ko_candidate": "티베리우스와 클라우디우스가 동시에 땅을 박차고 나간다!"
  },
  {
   "id": 30077,
   "key": "D1213le.txt:542",
   "file": "D1213le.txt",
   "line": 542,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もう遊びは無しよ！　ブチ殺してあげるわ、反吐野郎がァァァァァ！」",
   "ko_candidate": "「이제 장난은 끝이야! 죽여주마､ 역겨운 놈아아아아아!」"
  },
  {
   "id": 30078,
   "key": "D1213le.txt:552",
   "file": "D1213le.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腹が弾ける。",
   "ko_candidate": "배가 터진다｡"
  },
  {
   "id": 30079,
   "key": "D1213le.txt:554",
   "file": "D1213le.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の赤と白が、鳳仙花の如く、弾け飛ぶ。",
   "ko_candidate": "피의 붉은색과 흰색이 봉선화처럼 튀어 오른다｡"
  },
  {
   "id": 30080,
   "key": "D1213le.txt:556",
   "file": "D1213le.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白はティベリウスの骨だ。",
   "ko_candidate": "흰색은 티베리우스의 뼈다｡"
  },
  {
   "id": 30081,
   "key": "D1213le.txt:558",
   "file": "D1213le.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先の尖った肋骨を凶器とし、射出する。",
   "ko_candidate": "끝이 뾰족한 갈비뼈를 흉기로 삼아 발사한다｡"
  },
  {
   "id": 30082,
   "key": "D1213le.txt:560",
   "file": "D1213le.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺とライカさんは散開。",
   "ko_candidate": "나와 라이카 씨는 흩어진다｡"
  },
  {
   "id": 30083,
   "key": "D1213le.txt:561",
   "file": "D1213le.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "翔け、飛び跳ね、肋骨の雨をかわす。",
   "ko_candidate": "달리고 뛰어오르며 갈비뼈의 비를 피한다｡"
  },
  {
   "id": 30084,
   "key": "D1213le.txt:563",
   "file": "D1213le.txt",
   "line": 563,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肋骨はそのまま地面に突き刺さった。",
   "ko_candidate": "갈비뼈는 그대로 땅에 꽂혔다｡"
  },
  {
   "id": 30085,
   "key": "D1213le.txt:571",
   "file": "D1213le.txt",
   "line": 571,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「シャアアアァァァァァァァ！」",
   "ko_candidate": "「샤아아아아아아아아아아!」"
  },
  {
   "id": 30086,
   "key": "D1213le.txt:574",
   "file": "D1213le.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風を纏い、突撃するクラウディウス。",
   "ko_candidate": "바람을 두르고 돌진하는 클라우디우스｡"
  },
  {
   "id": 30087,
   "key": "D1213le.txt:575",
   "file": "D1213le.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、違う。これは――",
   "ko_candidate": "아니､ 다르다｡ 이건――"
  },
  {
   "id": 30088,
   "key": "D1213le.txt:579",
   "file": "D1213le.txt",
   "line": 579,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟音が耳を劈き、轟風が横を通り過ぎた。",
   "ko_candidate": "굉음이 귀를 가르고 폭풍이 옆을 지나간다｡"
  },
  {
   "id": 30089,
   "key": "D1213le.txt:580",
   "file": "D1213le.txt",
   "line": 580,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのまま俺の背後、避難所の出口まで翔んでいく――狙いはガキんちょどもか！",
   "ko_candidate": "그대로 내 뒤､ 대피소 출구까지 날아가는――목표는 꼬맹이들인가!"
  },
  {
   "id": 30090,
   "key": "D1213le.txt:587",
   "file": "D1213le.txt",
   "line": 587,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「させるか！」",
   "ko_candidate": "「못 할 짓이야!」"
  },
  {
   "id": 30091,
   "key": "D1213le.txt:589",
   "file": "D1213le.txt",
   "line": 589,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "イタクァを構える。銀色の銃身を駈ける魔術文字の輝き。",
   "ko_candidate": "이타콰를 겨눈다｡ 은색 총신을 달리는 마술 문자의 빛｡"
  },
  {
   "id": 30092,
   "key": "D1213le.txt:590",
   "file": "D1213le.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ジャスティス＆ヴァニシング。",
   "ko_candidate": "저스티스 & 배니싱｡"
  },
  {
   "id": 30093,
   "key": "D1213le.txt:594",
   "file": "D1213le.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正確無比の狩人の魂を込められた弾丸が、クラウディウスを襲う。",
   "ko_candidate": "정확무비한 사냥꾼의 영혼을 담은 탄환이 클라우디우스를 덮친다｡"
  },
  {
   "id": 30094,
   "key": "D1213le.txt:599",
   "file": "D1213le.txt",
   "line": 599,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ガッ……！」",
   "ko_candidate": "「윽……!」"
  },
  {
   "id": 30095,
   "key": "D1213le.txt:602",
   "file": "D1213le.txt",
   "line": 602,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何度も何度もクラウディウスを貫き、引き裂き、撃ち落とす。",
   "ko_candidate": "몇 번이고 몇 번이고 클라우디우스를 관통하고 찢어내고 쓰러뜨린다｡"
  },
  {
   "id": 30096,
   "key": "D1213le.txt:603",
   "file": "D1213le.txt",
   "line": 603,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれでも、内臓をこぼしながら起き上がる。",
   "ko_candidate": "하지만 그래도 내장을 쏟아내며 일어선다｡"
  },
  {
   "id": 30097,
   "key": "D1213le.txt:605",
   "file": "D1213le.txt",
   "line": 605,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸の猛攻を受けながらも、歩き出す。",
   "ko_candidate": "탄환의 맹공을 받으면서도 걸어간다｡"
  },
  {
   "id": 30098,
   "key": "D1213le.txt:606",
   "file": "D1213le.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一歩一歩、ガキんちょどもに近づいていく。",
   "ko_candidate": "한 걸음 한 걸음､ 꼬맹이들에게 다가간다｡"
  },
  {
   "id": 30099,
   "key": "D1213le.txt:609",
   "file": "D1213le.txt",
   "line": 609,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「早く逃げろ！」",
   "ko_candidate": "「빨리 도망쳐!」"
  },
  {
   "id": 30100,
   "key": "D1213le.txt:614",
   "file": "D1213le.txt",
   "line": 614,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「余所見をしてる場合じゃなくってよ！」",
   "ko_candidate": "「딴 데 보고 있을 때가 아니야!」"
  },
  {
   "id": 30101,
   "key": "D1213le.txt:620",
   "file": "D1213le.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肋骨の矢が飛来する。",
   "ko_candidate": "갈비뼈 화살이 날아온다｡"
  },
  {
   "id": 30102,
   "key": "D1213le.txt:621",
   "file": "D1213le.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反射的にマギウス・ウィングを楯にして、それを防ぐ。",
   "ko_candidate": "반사적으로 마기우스 윙을 방패로 삼아 그것을 막는다｡"
  },
  {
   "id": 30103,
   "key": "D1213le.txt:630",
   "file": "D1213le.txt",
   "line": 630,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深々と突き刺さる肋骨。",
   "ko_candidate": "깊숙이 꽂히는 갈비뼈｡"
  },
  {
   "id": 30104,
   "key": "D1213le.txt:631",
   "file": "D1213le.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なおも降り注ぐ。人間の持つ肋骨の数を遥かに超えて、降り注ぐ。",
   "ko_candidate": "계속해서 쏟아진다｡ 인간이 가진 갈비뼈의 수를 훨씬 넘어서 쏟아진다｡"
  },
  {
   "id": 30105,
   "key": "D1213le.txt:636",
   "file": "D1213le.txt",
   "line": 636,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちぃ！　糸を引いているだけあって、しつこい！」",
   "ko_candidate": "「치잇! 실을 조종하는 만큼 끈질기군!」"
  },
  {
   "id": 30106,
   "key": "D1213le.txt:643",
   "file": "D1213le.txt",
   "line": 643,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はぁぁぁっ！」",
   "ko_candidate": "「하아아아앗!」"
  },
  {
   "id": 30107,
   "key": "D1213le.txt:652",
   "file": "D1213le.txt",
   "line": 652,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスに斬りかかるライカさん。",
   "ko_candidate": "티베리우스에게 베어 들어가는 라이카 씨｡"
  },
  {
   "id": 30108,
   "key": "D1213le.txt:653",
   "file": "D1213le.txt",
   "line": 653,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舌打ちして、飛び退くティベリウス。",
   "ko_candidate": "혀를 차며 뛰어 물러나는 티베리우스｡"
  },
  {
   "id": 30109,
   "key": "D1213le.txt:655",
   "file": "D1213le.txt",
   "line": 655,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃が止んだ。",
   "ko_candidate": "공격이 멈췄다｡"
  },
  {
   "id": 30110,
   "key": "D1213le.txt:656",
   "file": "D1213le.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガキんちょどもは――!?",
   "ko_candidate": "꼬마들은――!?"
  },
  {
   "id": 30111,
   "key": "D1213le.txt:661",
   "file": "D1213le.txt",
   "line": 661,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あっちへ行けぇぇぇぇぇ！」",
   "ko_candidate": "「저쪽으로 가아아아아!」"
  },
  {
   "id": 30112,
   "key": "D1213le.txt:665",
   "file": "D1213le.txt",
   "line": 665,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アリスンの見えない力が、クラウディウスを吹き飛ばした。",
   "ko_candidate": "앨리슨의 보이지 않는 힘이 클라우디우스를 날려버렸다｡"
  },
  {
   "id": 30113,
   "key": "D1213le.txt:666",
   "file": "D1213le.txt",
   "line": 666,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い血や腐汁を散らしながら、床を転がる。",
   "ko_candidate": "검은 피와 썩은 즙을 흩뿌리며 바닥을 구른다｡"
  },
  {
   "id": 30114,
   "key": "D1213le.txt:671",
   "file": "D1213le.txt",
   "line": 671,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「い、今のうちに！」",
   "ko_candidate": "「지､ 지금이야!」"
  }
 ]
}