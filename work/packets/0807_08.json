 },
 "items": [
  {
   "id": 13872,
   "key": "D0807ru.txt:126",
   "file": "D0807ru.txt",
   "line": 126,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うんうん……ライバルが居ると大変だねえ。 お姉さんにも、辛い気持ちはよぅく解かりますよぉ」",
   "ko_candidate": "「응응… 라이벌이 있으면 힘들지｡ 누나도 괴로운 마음은 잘~ 알겠어요」"
  },
  {
   "id": 13873,
   "key": "D0807ru.txt:132",
   "file": "D0807ru.txt",
   "line": 132,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「こ、このぉ……大うつけぇぇぇぇ――――――――――――っ！」",
   "ko_candidate": "「이､ 이 녀석… 대바보오오오오――――――――――――!」"
  },
  {
   "id": 13874,
   "key": "D0807ru.txt:135",
   "file": "D0807ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ついに切れてしまったアルの絶叫が、休日の街に木霊した。",
   "ko_candidate": "마침내 폭발해버린 알의 절규가 휴일의 거리에 메아리쳤다｡"
  },
  {
   "id": 13875,
   "key": "D0807ru.txt:140",
   "file": "D0807ru.txt",
   "line": 140,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………うわ。びっくり」",
   "ko_candidate": "「……………………어와｡ 깜짝이야」"
  },
  {
   "id": 13876,
   "key": "D0807ru.txt:144",
   "file": "D0807ru.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一瞬、街のざわめきが途絶え――道行く人の視線が集中した。 だが奇異の視線にもまったく気に留めず――と言うより気に留める余裕もなく、一気にまくし立てる。",
   "ko_candidate": "순간､ 거리의 소란이 멎고――지나가는 사람들의 시선이 집중됐다｡"
  },
  {
   "id": 13877,
   "key": "D0807ru.txt:152",
   "file": "D0807ru.txt",
   "line": 152,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だから下衆の考えで、妾と九郎の関係を邪推するな！」 「戦う者同士の絆と言うものは、もっと、こう……神聖で気高いものなのだ！」",
   "ko_candidate": "하지만 기이한 시선에도 전혀 신경 쓰지 않고――라기보다 신경 쓸 여유도 없이 한 번에 쏟아낸다｡"
  },
  {
   "id": 13878,
   "key": "D0807ru.txt:160",
   "file": "D0807ru.txt",
   "line": 160,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それを、まるで妾を盛った犬の様に……ッ！」 「汝も解かっておるのか！　もしこんなタイミングで、『ブラックロッジ』が現れようものなら、我等には何の手立ても……」",
   "ko_candidate": "「그러니까 천박한 생각으로 첩과 쿠로의 관계를 의심하지 마! 싸우는 자들 간의 유대라는 것은 더욱､ 그러니까… 신성하고 고귀한 것이라고! 그것을 마치 첩을 발정난 개처럼… 읏! 너도 알고 있지! 만약 이런 타이밍에 『블랙로지』가 나타난다면 우리에겐 아무런 대책도…」"
  },
  {
   "id": 13879,
   "key": "D0807ru.txt:173",
   "file": "D0807ru.txt",
   "line": 173,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 13880,
   "key": "D0807ru.txt:176",
   "file": "D0807ru.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの表情が、瞬時に変わった。",
   "ko_candidate": "알의 표정이 순식간에 바뀌었다｡"
  },
  {
   "id": 13881,
   "key": "D0807ru.txt:177",
   "file": "D0807ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "羞恥心に顔を赤らめる、微笑ましい少女の貌ではなく、ほんの僅かな危険の気配すら嗅ぎつける、歴戦の戦士の其れへと。",
   "ko_candidate": "수치심에 얼굴을 붉히는 미소 짓는 소녀의 얼굴이 아닌､ 아주 작은 위험의 기척조차 감지해내는 전쟁의 전사의 그것으로｡"
  },
  {
   "id": 13882,
   "key": "D0807ru.txt:178",
   "file": "D0807ru.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "戦慄に凍える躰を抑え、注意深く周囲を見回す。",
   "ko_candidate": "전율에 얼어붙은 몸을 억누르며 조심스럽게 주위를 둘러본다｡"
  },
  {
   "id": 13883,
   "key": "D0807ru.txt:183",
   "file": "D0807ru.txt",
   "line": 183,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――どうしたの、アルちゃん？」",
   "ko_candidate": "「――어떻게 된 거야､ 알 쨩?」"
  },
  {
   "id": 13884,
   "key": "D0807ru.txt:190",
   "file": "D0807ru.txt",
   "line": 190,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 13885,
   "key": "D0807ru.txt:193",
   "file": "D0807ru.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカの問いには答えず、なおも気配を探り続ける。",
   "ko_candidate": "라이카의 물음에는 대답하지 않고 여전히 기척을 탐색한다｡"
  },
  {
   "id": 13886,
   "key": "D0807ru.txt:195",
   "file": "D0807ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……消えた。",
   "ko_candidate": "…사라졌다｡"
  },
  {
   "id": 13887,
   "key": "D0807ru.txt:196",
   "file": "D0807ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もう何も感じない。",
   "ko_candidate": "이제 아무것도 느껴지지 않는다｡"
  },
  {
   "id": 13888,
   "key": "D0807ru.txt:198",
   "file": "D0807ru.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが……今のプレッシャーは何だ？",
   "ko_candidate": "하지만… 방금 그 압박감은 뭐지?"
  },
  {
   "id": 13889,
   "key": "D0807ru.txt:200",
   "file": "D0807ru.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アンチクロスすら超えている、あの魔人マスターテリオンにも匹敵するかという邪悪な存在力。",
   "ko_candidate": "안티 크로스조차 뛰어넘는､ 그 마인 마스터 테리온에 필적할 만한 사악한 존재감｡"
  },
  {
   "id": 13890,
   "key": "D0807ru.txt:202",
   "file": "D0807ru.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ほんの一瞬だった。",
   "ko_candidate": "아주 짧은 순간이었다｡"
  },
  {
   "id": 13891,
   "key": "D0807ru.txt:203",
   "file": "D0807ru.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "刹那にも満たない一瞬だった。",
   "ko_candidate": "찰나에도 미치지 못하는 순간이었다｡"
  },
  {
   "id": 13892,
   "key": "D0807ru.txt:204",
   "file": "D0807ru.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だがその一瞬が、アルに灼きついて離れない。",
   "ko_candidate": "하지만 그 순간이 알에게 새겨져 떨어지지 않는다｡"
  },
  {
   "id": 13893,
   "key": "D0807ru.txt:210",
   "file": "D0807ru.txt",
   "line": 210,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「本気で急ぐぞ……何か胸騒ぎがする」",
   "ko_candidate": "「정말로 서두르자… 뭔가 불안해」"
  },
  {
   "id": 13894,
   "key": "D0807ru.txt:223",
   "file": "D0807ru.txt",
   "line": 223,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くすくす……くすくす……」",
   "ko_candidate": "「크스크스… 크스크스…」"
  },
  {
   "id": 13895,
   "key": "D0807ru.txt:227",
   "file": "D0807ru.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "笑い声がアーカムシティの空に響く。",
   "ko_candidate": "웃음소리가 아캄시티의 하늘에 울려 퍼진다｡"
  },
  {
   "id": 13896,
   "key": "D0807ru.txt:229",
   "file": "D0807ru.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無邪気で、怪異を孕んだ、あの笑い声。",
   "ko_candidate": "천진난만하고 괴이를 품은 그 웃음소리｡"
  },
  {
   "id": 13897,
   "key": "D0807ru.txt:230",
   "file": "D0807ru.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "罪人共の園に在って、魔人共の庭に在って、なお罪深く、なお異形じみた魔人の笑い声。",
   "ko_candidate": "죄인들의 정원에 있어､ 마인들의 정원에 있어､ 더욱 죄 깊고､ 더욱 기괴한 마인의 웃음소리｡"
  },
  {
   "id": 13898,
   "key": "D0807ru.txt:232",
   "file": "D0807ru.txt",
   "line": 232,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "『暴君』と、『黒き聖域』に棲まう者は言う。",
   "ko_candidate": "『폭군』과 『검은 성역』에 사는 자가 말한다｡"
  },
  {
   "id": 13899,
   "key": "D0807ru.txt:234",
   "file": "D0807ru.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "遥か高み、アーカムシティを見下ろす時計塔の長針の上に立ち、『暴君』の千里眼は、彼等の姿を捉えている。",
   "ko_candidate": "아득히 높은 곳､ 아캄시티를 내려다보는 시계탑의 긴 바늘 위에 서서､ 『폭군』의 천리안은 그들의 모습을 포착하고 있다｡"
  },
  {
   "id": 13900,
   "key": "D0807ru.txt:236",
   "file": "D0807ru.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――アル・アジフ。",
   "ko_candidate": "――알 아지프｡"
  },
  {
   "id": 13901,
   "key": "D0807ru.txt:238",
   "file": "D0807ru.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――大十字九郎。",
   "ko_candidate": "――다이쥬지 쿠로｡"
  },
  {
   "id": 13902,
   "key": "D0807ru.txt:240",
   "file": "D0807ru.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼等の一挙一動を余さず観察し、そのたびに一喜一憂して、身を捩らせる。",
   "ko_candidate": "그들의 일거수일투족을 빠짐없이 관찰하며､ 그때마다 희비를 오가며 몸을 비튼다｡"
  },
  {
   "id": 13903,
   "key": "D0807ru.txt:242",
   "file": "D0807ru.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鈴の音を転がす様な笑い声が響く。",
   "ko_candidate": "방울 소리를 굴리는 듯한 웃음소리가 울린다｡"
  },
  {
   "id": 13904,
   "key": "D0807ru.txt:244",
   "file": "D0807ru.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが……その笑い声はいったい何処から零れているのだろうか。",
   "ko_candidate": "하지만… 그 웃음소리는 도대체 어디서 새어나오는 걸까｡"
  },
  {
   "id": 13905,
   "key": "D0807ru.txt:249",
   "file": "D0807ru.txt",
   "line": 249,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "『暴君』を包む衣装は――袖の無い、黒いレザースーツ。",
   "ko_candidate": "『폭군』을 감싸는 의상은――소매 없는 검은 가죽 슈트｡"
  },
  {
   "id": 13906,
   "key": "D0807ru.txt:250",
   "file": "D0807ru.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "拘束具をぶら下げた細い腕。",
   "ko_candidate": "구속구를 매단 가는 팔｡"
  },
  {
   "id": 13907,
   "key": "D0807ru.txt:251",
   "file": "D0807ru.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "両足に嵌る枷。",
   "ko_candidate": "양 발에 끼워진 족쇄｡"
  },
  {
   "id": 13908,
   "key": "D0807ru.txt:252",
   "file": "D0807ru.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "口元だけを覗かせる仮面。口に嵌められた轡。",
   "ko_candidate": "입술만 드러내는 가면｡ 입에 물린 재갈｡"
  },
  {
   "id": 13909,
   "key": "D0807ru.txt:254",
   "file": "D0807ru.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして幾重にも貼られた呪符。呪符。呪符。",
   "ko_candidate": "그리고 겹겹이 붙여진 주부｡ 주부｡ 주부｡"
  },
  {
   "id": 13910,
   "key": "D0807ru.txt:255",
   "file": "D0807ru.txt",
   "line": 255,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "『呪縛』を意味する魔術文字。",
   "ko_candidate": "『주박』을 의미하는 마술 문자｡"
  },
  {
   "id": 13911,
   "key": "D0807ru.txt:257",
   "file": "D0807ru.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――即ち、拘束されている。",
   "ko_candidate": "――즉､ 구속되어 있다｡"
  }
 ]
}