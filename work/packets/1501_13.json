 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "リベル・レギス": "리베르 레기스",
  "マスターテリオン": "마스터 테리온",
  "デウス・マキナ": "데우스 마키나",
  "クトゥルー": "크툴루",
  "ルルイエ": "르뤼에",
  "魔力": "마력",
  "術式": "술식"
 },
 "items": [
  {
   "id": 41269,
   "key": "D1501ru.txt:779",
   "file": "D1501ru.txt",
   "line": 779,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが手加減されていたあの時とは段違いの呪力だ！",
   "ko_candidate": "하지만 그때는 봐주고 있었던 것과는 차원이 다른 주력이다!"
  },
  {
   "id": 41270,
   "key": "D1501ru.txt:785",
   "file": "D1501ru.txt",
   "line": 785,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを立たせることもままならず、そのまま倒れ込む。",
   "ko_candidate": "데몬베인을 일으키는 것조차 여의치 않고､ 그대로 쓰러진다｡"
  },
  {
   "id": 41271,
   "key": "D1501ru.txt:786",
   "file": "D1501ru.txt",
   "line": 786,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起き上がらなければ……と思うが、操縦桿を握る腕すら動かすことが出来ない。それほどの重圧だった。",
   "ko_candidate": "일어나야 한다……고 생각하지만､ 조종간을 잡은 팔조차 움직일 수 없다｡ 그 정도의 중압이었다｡"
  },
  {
   "id": 41272,
   "key": "D1501ru.txt:794",
   "file": "D1501ru.txt",
   "line": 794,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "倒れたデモンベインを、リベル・レギスが見下ろしている。",
   "ko_candidate": "쓰러진 데몬베인을､ 리베르 레기스가 내려다보고 있다｡"
  },
  {
   "id": 41273,
   "key": "D1501ru.txt:794",
   "file": "D1501ru.txt",
   "line": 794,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くすくすと嗤うマスターテリオンの囁きが聴こえてきた。",
   "ko_candidate": "키득키득 웃는 마스터 테리온의 속삭임이 들려왔다｡"
  },
  {
   "id": 41274,
   "key": "D1501ru.txt:795",
   "file": "D1501ru.txt",
   "line": 795,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同じ手に引っ掛かるなんて……なんて不様な……っ！",
   "ko_candidate": "같은 수에 당하다니……정말 한심하군……!"
  },
  {
   "id": 41275,
   "key": "D1501ru.txt:799",
   "file": "D1501ru.txt",
   "line": 799,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そう、悔しがる事もあるまい。並みの術者なら一瞬で、デウス・マキナごと圧縮された鉄塊に成り果てている」",
   "ko_candidate": "「그래､ 억울해할 것도 없다｡ 보통의 술사라면 순식간에 데우스 마키나째 압축된 철덩어리가 되어버렸을 테니까」"
  },
  {
   "id": 41276,
   "key": "D1501ru.txt:803",
   "file": "D1501ru.txt",
   "line": 803,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「て、てめえ……！」",
   "ko_candidate": "「이､ 이 자식……!」"
  },
  {
   "id": 41277,
   "key": "D1501ru.txt:807",
   "file": "D1501ru.txt",
   "line": 807,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ではそろそろ教えてやろう。 『Ｃ計画』の本当の目的を――」",
   "ko_candidate": "「그럼 이제 알려주지｡ 『C계획』의 진짜 목적을――」"
  },
  {
   "id": 41278,
   "key": "D1501ru.txt:811",
   "file": "D1501ru.txt",
   "line": 811,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さらりと、そんなことを言ってのける。",
   "ko_candidate": "담담하게､ 그런 말을 내뱉는다｡"
  },
  {
   "id": 41279,
   "key": "D1501ru.txt:813",
   "file": "D1501ru.txt",
   "line": 813,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当の目的？",
   "ko_candidate": "진짜 목적?"
  },
  {
   "id": 41280,
   "key": "D1501ru.txt:814",
   "file": "D1501ru.txt",
   "line": 814,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥルーを、邪神を招喚して世界を征服する……もしくは、こいつの場合なら、世界を滅ぼす……それ以上の目的があるって言うのか？",
   "ko_candidate": "크툴루를､ 사신을 소환해서 세계를 정복한다……아니면､ 이놈의 경우라면､ 세계를 멸망시킨다……그 이상의 목적이 있다는 건가?"
  },
  {
   "id": 41281,
   "key": "D1501ru.txt:816",
   "file": "D1501ru.txt",
   "line": 816,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな馬鹿な……!?",
   "ko_candidate": "그런 말도 안 되는……!?"
  },
  {
   "id": 41282,
   "key": "D1501ru.txt:820",
   "file": "D1501ru.txt",
   "line": 820,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……どう云う意味だ ……獣よ……！」",
   "ko_candidate": "「……무슨 뜻이냐 ……짐승아……!」"
  },
  {
   "id": 41283,
   "key": "D1501ru.txt:825",
   "file": "D1501ru.txt",
   "line": 825,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「余の目的は旧支配者を超えた領域にこそある。クトゥルーも、ルルイエの浮上も、総てはその目的の為。窮極の結末の為に」",
   "ko_candidate": "「나의 목적은 그레이트 올드 원을 넘어선 영역에 있다｡ 크툴루도､ 르뤼에의 부상도､ 모든 것은 그 목적을 위해｡ 궁극의 결말을 위해｡ 만물은――신조차 별조차､ 운명이 가리키는 대로」"
  },
  {
   "id": 41284,
   "key": "D1501ru.txt:828",
   "file": "D1501ru.txt",
   "line": 828,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「万物は――神ですら星ですら、運命の指し示すがままに」",
   "ko_candidate": "천장에서 점액이 떨어져 내렸다｡ 올려다보니､ 살점으로 된 천장에 거대한 열상｡"
  },
  {
   "id": 41285,
   "key": "D1501ru.txt:837",
   "file": "D1501ru.txt",
   "line": 837,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "天井から、粘液が滴り落ちてきた。 見上げれば、肉質の天井に、巨大な裂傷。",
   "ko_candidate": "피와 점액과 살점을 흩뿌리며､ 갈라져 간다｡"
  },
  {
   "id": 41286,
   "key": "D1501ru.txt:843",
   "file": "D1501ru.txt",
   "line": 843,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "穴が穿たれた。",
   "ko_candidate": "구멍이 뚫렸다｡"
  },
  {
   "id": 41287,
   "key": "D1501ru.txt:844",
   "file": "D1501ru.txt",
   "line": 844,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "裂傷は、遥か上空に続き、外に繋がっていた。",
   "ko_candidate": "열상은 저 멀리 상공까지 이어져 밖으로 연결되어 있었다｡"
  },
  {
   "id": 41288,
   "key": "D1501ru.txt:845",
   "file": "D1501ru.txt",
   "line": 845,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスから、魔力の爆風が吹き荒れる。",
   "ko_candidate": "리베르 레기스에서 마력의 폭풍이 휘몰아친다｡"
  },
  {
   "id": 41289,
   "key": "D1501ru.txt:852",
   "file": "D1501ru.txt",
   "line": 852,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音が轟き、閃光が迸った。",
   "ko_candidate": "폭음이 울리고､ 섬광이 튀었다｡"
  },
  {
   "id": 41290,
   "key": "D1501ru.txt:853",
   "file": "D1501ru.txt",
   "line": 853,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスは凄まじい勢いで、天井に出来た穴を一気に翔け昇っていく。",
   "ko_candidate": "리베르 레기스는 엄청난 기세로 천장에 생긴 구멍을 단숨에 날아올랐다｡"
  },
  {
   "id": 41291,
   "key": "D1501ru.txt:857",
   "file": "D1501ru.txt",
   "line": 857,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ま、待て……ちくしょう……っ！」",
   "ko_candidate": "「잠､ 잠깐……이 자식……!」"
  },
  {
   "id": 41292,
   "key": "D1501ru.txt:863",
   "file": "D1501ru.txt",
   "line": 863,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "後を追おうにも、指一本動かせない。",
   "ko_candidate": "뒤쫓으려 해도､ 손가락 하나 움직일 수 없다｡"
  },
  {
   "id": 41293,
   "key": "D1501ru.txt:864",
   "file": "D1501ru.txt",
   "line": 864,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くっ……このまま押し潰されたら、間抜け過ぎる……！",
   "ko_candidate": "젠장……이대로 짓눌리면､ 너무 멍청해……!"
  },
  {
   "id": 41294,
   "key": "D1501ru.txt:868",
   "file": "D1501ru.txt",
   "line": 868,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「落ち着け……ッ！　如何に威力は違えども……一度は破った術……ッ！ 解呪出来ない道理は……なかろう……！」",
   "ko_candidate": "「진정해……! 아무리 위력이 다르다 해도……한 번은 깼던 술식……! 해주할 수 없을 리가……없어……!」"
  },
  {
   "id": 41295,
   "key": "D1501ru.txt:873",
   "file": "D1501ru.txt",
   "line": 873,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そ、そうだ……落ち着け。",
   "ko_candidate": "그､ 그래……진정하자｡"
  },
  {
   "id": 41296,
   "key": "D1501ru.txt:874",
   "file": "D1501ru.txt",
   "line": 874,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "状況はあの時とまったく同じなんだ。",
   "ko_candidate": "상황은 그때와 완전히 똑같아｡"
  },
  {
   "id": 41297,
   "key": "D1501ru.txt:876",
   "file": "D1501ru.txt",
   "line": 876,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "思考しろ。",
   "ko_candidate": "생각해｡"
  },
  {
   "id": 41298,
   "key": "D1501ru.txt:877",
   "file": "D1501ru.txt",
   "line": 877,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "思考しろ。",
   "ko_candidate": "생각해｡"
  },
  {
   "id": 41299,
   "key": "D1501ru.txt:878",
   "file": "D1501ru.txt",
   "line": 878,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "思考しろ。",
   "ko_candidate": "생각해｡"
  },
  {
   "id": 41300,
   "key": "D1501ru.txt:880",
   "file": "D1501ru.txt",
   "line": 880,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳を疾走させろ。",
   "ko_candidate": "뇌를 질주시켜｡"
  },
  {
   "id": 41301,
   "key": "D1501ru.txt:881",
   "file": "D1501ru.txt",
   "line": 881,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界を読み取り、術式を解いて、答えを導け。",
   "ko_candidate": "세계를 읽어내고､ 술식을 풀어､ 답을 도출해｡"
  },
  {
   "id": 41302,
   "key": "D1501ru.txt:882",
   "file": "D1501ru.txt",
   "line": 882,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば……自ずと……！",
   "ko_candidate": "그러면……자연스럽게……!"
  },
  {
   "id": 41303,
   "key": "D1501ru.txt:889",
   "file": "D1501ru.txt",
   "line": 889,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――見えた！」",
   "ko_candidate": "「――보였다!」"
  },
  {
   "id": 41304,
   "key": "D1501ru.txt:892",
   "file": "D1501ru.txt",
   "line": 892,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "常に激変する情報、容を変える術式。",
   "ko_candidate": "항상 격변하는 정보､ 모습을 바꾸는 술식｡"
  },
  {
   "id": 41305,
   "key": "D1501ru.txt:893",
   "file": "D1501ru.txt",
   "line": 893,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが基軸になる部分は一緒だ。",
   "ko_candidate": "하지만 기축이 되는 부분은 같다｡"
  },
  {
   "id": 41306,
   "key": "D1501ru.txt:895",
   "file": "D1501ru.txt",
   "line": 895,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "解読したその箇所に、僅かな隙に、この結界を破壊する新たな法則を、俺の魔術を乱暴に雪崩れ込ませる！",
   "ko_candidate": "해독한 그 부분에､ 미세한 틈에､ 이 결계를 파괴할 새로운 법칙을､ 내 마술을 난폭하게 쏟아부어!"
  },
  {
   "id": 41307,
   "key": "D1501ru.txt:901",
   "file": "D1501ru.txt",
   "line": 901,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ガラスが砕け散るような音を、心の中で聴いた。",
   "ko_candidate": "유리가 부서지는 듯한 소리를､ 마음속으로 들었다｡"
  },
  {
   "id": 41308,
   "key": "D1501ru.txt:903",
   "file": "D1501ru.txt",
   "line": 903,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あれほどデモンベインを強烈に呪縛していた魔力は、",
   "ko_candidate": "그토록 데몬베인을 강렬하게 주박하고 있던 마력은､"
  }
 ]
}