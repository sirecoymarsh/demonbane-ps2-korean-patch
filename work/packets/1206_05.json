  {
   "id": 27948,
   "key": "D1206ru.txt:221",
   "file": "D1206ru.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思考の速度に躰が付いて来てくれるだろうか。",
   "ko_candidate": "사고의 속도를 몸이 따라올 수 있을까｡"
  },
  {
   "id": 27949,
   "key": "D1206ru.txt:224",
   "file": "D1206ru.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上半身を逸らす。",
   "ko_candidate": "상체를 비틀어 피한다｡"
  },
  {
   "id": 27950,
   "key": "D1206ru.txt:225",
   "file": "D1206ru.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背広が斬られた。",
