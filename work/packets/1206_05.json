   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "筋肉の動き、",
   "ko_candidate": "근육의 움직임､"
  },
  {
   "id": 27930,
   "key": "D1206ru.txt:177",
   "file": "D1206ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
