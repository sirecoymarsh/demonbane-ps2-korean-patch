  {
   "id": 27931,
   "key": "D1206ru.txt:177",
   "file": "D1206ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の流れ、",
   "ko_candidate": "피의 흐름､"
  },
  {
   "id": 27932,
   "key": "D1206ru.txt:177",
   "file": "D1206ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼吸、",
   "ko_candidate": "호흡､"
  },
  {
   "id": 27933,
   "key": "D1206ru.txt:177",
   "file": "D1206ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気の流れ、",
   "ko_candidate": "대기의 흐름､"
  },
  {
   "id": 27934,
   "key": "D1206ru.txt:177",
   "file": "D1206ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力の流れ――",
   "ko_candidate": "힘의 흐름――"
  },
  {
   "id": 27935,
   "key": "D1206ru.txt:179",
   "file": "D1206ru.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティトゥスが、笑った。",
   "ko_candidate": "티투스가 웃었다｡"
  },
  {
   "id": 27936,
   "key": "D1206ru.txt:182",
   "file": "D1206ru.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の雫を撒き散らしながら、疾走る。",
   "ko_candidate": "피의 방울을 흩뿌리며 질주한다｡"
  },
  {
   "id": 27937,
   "key": "D1206ru.txt:186",
   "file": "D1206ru.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "走るどころか、まともに動く事すらも怪しい躰が、疾風の如く。",
   "ko_candidate": "달리는 것은커녕 제대로 움직이는 것조차 의심스러운 몸이 질풍처럼｡"
  },
  {
   "id": 27938,
   "key": "D1206ru.txt:187",
   "file": "D1206ru.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一気に間合いを詰める。",
   "ko_candidate": "단숨에 간격을 좁힌다｡"
  },
  {
   "id": 27939,
   "key": "D1206ru.txt:191",
   "file": "D1206ru.txt",
   "line": 191,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（先程よりも速い！）",
   "ko_candidate": "（아까보다 더 빠르다!）"
  },
  {
   "id": 27940,
   "key": "D1206ru.txt:205",
   "file": "D1206ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人だけの時間が始まった。",
   "ko_candidate": "두 사람만의 시간이 시작되었다｡"
  },
  {
   "id": 27941,
   "key": "D1206ru.txt:206",
   "file": "D1206ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは刹那、人の目に留まらぬ刹那に閉ざされた世界。",
   "ko_candidate": "그것은 찰나､ 사람의 눈에 머물지 않는 찰나에 닫힌 세계｡"
  },
  {
   "id": 27942,
   "key": "D1206ru.txt:207",
   "file": "D1206ru.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那の中、２人の思考もまた同じ速度で疾走する。",
   "ko_candidate": "찰나 속에서 두 사람의 사고 또한 같은 속도로 질주한다｡"
  },
  {
   "id": 27943,
   "key": "D1206ru.txt:211",
   "file": "D1206ru.txt",
   "line": 211,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（２撃かわせば私の勝ちです！）",
   "ko_candidate": "（2타를 피하면 제가 이깁니다!）"
  },
  {
   "id": 27944,
   "key": "D1206ru.txt:215",
   "file": "D1206ru.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超神速で迫る右の刀。袈裟斬り。",
   "ko_candidate": "초신속으로 다가오는 오른쪽 칼｡ 게사베기｡"
  },
  {
   "id": 27945,
   "key": "D1206ru.txt:217",
   "file": "D1206ru.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "速い。",
   "ko_candidate": "빠르다｡"
  },
  {
   "id": 27946,
   "key": "D1206ru.txt:218",
   "file": "D1206ru.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
