 },
 "items": [
  {
   "id": 46585,
   "key": "D1513al.txt:346",
   "file": "D1513al.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そのボディに問答無用で手刀を突き刺した。",
   "ko_candidate": "그 몸에 무작정 수도를 찔러 넣었다｡"
  },
  {
   "id": 46586,
   "key": "D1513al.txt:349",
   "file": "D1513al.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "逆の腕でリベル・レギスの首を抱え込む。",
   "ko_candidate": "반대쪽 팔로 리베르 레기스의 목을 감싼다｡"
  },
  {
   "id": 46587,
   "key": "D1513al.txt:367",
   "file": "D1513al.txt",
   "line": 367,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「があああああああああ！」」",
   "ko_candidate": "「크아아아아아아아아아!」"
  },
  {
   "id": 46588,
   "key": "D1513al.txt:373",
   "file": "D1513al.txt",
   "line": 373,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「つれなくするな…… 最後まで付き合ってもらうぞ！」",
   "ko_candidate": "「매정하게 굴지 마라……끝까지 함께 가자고!」"
  },
  {
   "id": 46589,
   "key": "D1513al.txt:386",
   "file": "D1513al.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――燃える。",
   "ko_candidate": "――타오른다｡"
  },
  {
   "id": 46590,
   "key": "D1513al.txt:387",
   "file": "D1513al.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――世界が燃える。",
   "ko_candidate": "――세계가 타오른다｡"
  },
  {
   "id": 46591,
   "key": "D1513al.txt:395",
   "file": "D1513al.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そしてデモンベインとリベル・レギスは、地球の空を翔ける流れ星となった。",
   "ko_candidate": "그리고 데몬베인과 리베르 레기스는､ 지구의 하늘을 가로지르는 유성이 되었다｡"
  },
  {
   "id": 46592,
   "key": "D1513al.txt:460",
   "file": "D1513al.txt",
   "line": 460,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「クハッ……クハハハハ……ッ……ククククッ……ハァーハーハッハッハッ！　大十字九郎ッッ！」",
   "ko_candidate": "「크핫……크하하하하……읏……크크크크……하아-하-핫핫핫! 다이쥬지 쿠로오오오!」"
  },
  {
   "id": 46593,
   "key": "D1513al.txt:473",
   "file": "D1513al.txt",
   "line": 473,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ハァ……ハァ……アアアアアァァァァァ！ マスターテリオンッッ！」",
   "ko_candidate": "「하아……하아……아아아아아아아아아아! 마스터 테리온!」"
  },
  {
   "id": 46594,
   "key": "D1513al.txt:485",
   "file": "D1513al.txt",
   "line": 485,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル……アジフゥゥゥ！」",
   "ko_candidate": "「알……아지프우우우!」 「나코트 사본!」"
  },
  {
   "id": 46595,
   "key": "D1513al.txt:497",
   "file": "D1513al.txt",
   "line": 497,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ナコト写本ッッ！」",
   "ko_candidate": "「레무리아……아아아아아!」"
  },
  {
   "id": 46596,
   "key": "D1513al.txt:517",
   "file": "D1513al.txt",
   "line": 517,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「「レムリア…ァァァ！」」",
   "ko_candidate": "「하이퍼보리아……아아아아아!」"
  },
  {
   "id": 46597,
   "key": "D1513al.txt:531",
   "file": "D1513al.txt",
   "line": 531,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「「ハイパーボリア…ァァァ！」」 「インパクト！」",
   "ko_candidate": "「임팩트!」「제로 드라이브!」{SE_PLAY(1,\"閃둡・爆音\",0,85,false);}<br>"
  },
  {
   "id": 46598,
   "key": "D1513al.txt:553",
   "file": "D1513al.txt",
   "line": 553,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ゼロ・ドライブ！」 ――――!?",
   "ko_candidate": "――――!?"
  },
  {
   "id": 46599,
   "key": "D1513al.txt:613",
   "file": "D1513al.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――６５００万年前。地球。",
   "ko_candidate": "――6500만 년 전｡ 지구｡"
  },
  {
   "id": 46600,
   "key": "D1513al.txt:629",
   "file": "D1513al.txt",
   "line": 629,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "我々の時代で言う所のメキシコはユカタン半島で激突する両機を、時空震が呑み込んだ。",
   "ko_candidate": "우리 시대로 말하자면 멕시코 유카탄 반도에서 충돌하는 양 기체를､ 시공진이 삼켜버렸다｡"
  },
  {
   "id": 46601,
   "key": "D1513al.txt:632",
   "file": "D1513al.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その際、生じた時空の亀裂――如何なる宇宙の法則も通用しない異界の向こうから、膨大なエネルギーが溢れ出した。",
   "ko_candidate": "그때 생긴 시공의 균열――어떤 우주의 법칙도 통하지 않는 이계의 저편에서､ 방대한 에너지가 넘쳐흘렀다｡ 데몬베인이､ 리베르 레기스가､ 향하는 마지막 결전장｡"
  },
  {
   "id": 46602,
   "key": "D1513al.txt:635",
   "file": "D1513al.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインが、リベル・レギスが赴く最後の決戦場。零にして無限、刹那にして永劫の宇宙。遂に解き放たれんとする世界より零れた、ほんの僅かなエネルギーの飛沫。",
   "ko_candidate": "제로이자 무한､ 찰나이자 영겁의 우주｡ 마침내 풀려나려 하는 세계에서 흘러나온､ 아주 작은 에너지의 물방울｡"
  },
  {
   "id": 46603,
   "key": "D1513al.txt:638",
   "file": "D1513al.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは地球の生命に振り下ろされた死神の鎌であり、与えられた進化の黄金だった。",
   "ko_candidate": "그것은 지구의 생명에 내려친 사신의 낫이자､ 주어진 진화의 황금이었다｡"
  },
  {
   "id": 46604,
   "key": "D1513al.txt:656",
   "file": "D1513al.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆発中心部の温度は、摂氏６万度。",
   "ko_candidate": "폭발 중심부의 온도는､ 섭씨 6만 도｡"
  },
  {
   "id": 46605,
   "key": "D1513al.txt:657",
   "file": "D1513al.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一切を蒸発させる。",
   "ko_candidate": "모든 것을 증발시킨다｡"
  },
  {
   "id": 46606,
   "key": "D1513al.txt:660",
   "file": "D1513al.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "地表に穿たれたクレーターは直径１７０キロメートル。深さはマントル層にまで達した。",
   "ko_candidate": "지표에 뚫린 크레이터는 직경 170킬로미터｡ 깊이는 맨틀층까지 도달했다｡"
  },
  {
   "id": 46607,
   "key": "D1513al.txt:663",
   "file": "D1513al.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その威力は、世界中の核爆弾を一斉に爆発させた時の、千倍から一万倍相当に値する。",
   "ko_candidate": "그 위력은､ 전 세계의 핵폭탄을 일제히 폭발시켰을 때의､ 천 배에서 만 배에 상당하는 값이다｡"
  },
  {
   "id": 46608,
   "key": "D1513al.txt:675",
   "file": "D1513al.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総ては光の中へ砕けてゆく。",
   "ko_candidate": "모든 것이 빛 속으로 부서져 간다｡"
  },
  {
   "id": 46609,
   "key": "D1513al.txt:676",
   "file": "D1513al.txt",
   "line": 676,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "砕き、解き、再構築する。創造する。",
   "ko_candidate": "데몬베인도｡"
  },
  {
   "id": 46610,
   "key": "D1513al.txt:679",
   "file": "D1513al.txt",
   "line": 679,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "最後の、宇宙を。",
   "ko_candidate": "리베르 레기스도――"
  },
  {
   "id": 46611,
   "key": "D1513le.txt:11",
   "file": "D1513le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "５つの太陽が燦々と照り、世界を眩む程に輝かせる。",
   "ko_candidate": "5개의 태양이 찬란히 비추며､ 세계를 눈부시게 빛나게 한다｡"
  },
  {
   "id": 46612,
   "key": "D1513le.txt:12",
   "file": "D1513le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だがその過剰なまでの恩恵を授かる生命はこの惑星には存在しない。",
   "ko_candidate": "하지만 그 과도할 정도의 은혜를 받는 생명체는 이 행성에 존재하지 않는다｡"
  },
  {
   "id": 46613,
   "key": "D1513le.txt:14",
   "file": "D1513le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この惑星で生命を謳歌するものは、地中を蠢く粘液に塗れた青白い巨体。うねる躰。忌わしきドールどものみである。",
   "ko_candidate": "이 행성에서 생명을 구가하는 것은 지중을 꿈틀거리는 점액에 뒤덮인 창백한 거대한 몸체｡ 꿈틀거리는 몸｡ 혐오스러운 돌들뿐이다｡"
  },
  {
   "id": 46614,
   "key": "D1513le.txt:16",
   "file": "D1513le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔道士の呪文によって地底奥深くへと封じ込められていた彼等は、この遥か未来の時代に至って遂にその呪縛を打ち破り、惑星の総てを貪り喰らい死滅させ、それでもなお足らず、死すらも根こそぎ貪り尽くさんとする。",
   "ko_candidate": "마도사의 주문으로 지저 깊숙이 봉인되어 있던 그들은､ 이 머나먼 미래의 시대에 이르러 마침내 그 주박을 깨뜨리고､ 행성의 모든 것을 탐욕스럽게 먹어치우고 멸망시키며､ 그래도 부족해 죽음마저 뿌리째 탐욕스럽게 먹어치우려 한다｡"
  },
  {
   "id": 46615,
   "key": "D1513le.txt:18",
   "file": "D1513le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "腹の中で蠢く寄生虫に凌辱され、この惑星は安息の死すら迎えることは叶わない――。",
   "ko_candidate": "배 속에서 꿈틀거리는 기생충에 능욕당하며､ 이 행성은 안식의 죽음조차 맞이할 수 없다――｡"
  },
  {
   "id": 46616,
   "key": "D1513le.txt:23",
   "file": "D1513le.txt",
   "line": 23,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん！」",
   "ko_candidate": "「쿠로 군!」"
  },
  {
   "id": 46617,
   "key": "D1513le.txt:26",
   "file": "D1513le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんの呼び声に、意識が現実に引き戻された。",
   "ko_candidate": "라이카 씨의 부르는 소리에､ 의식이 현실로 되돌아왔다｡"
  },
  {
   "id": 46618,
   "key": "D1513le.txt:28",
   "file": "D1513le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "必殺キックの衝突は、互いを吹き飛ばし、磁極の違う磁石同士が反発するようにして、離れた。",
   "ko_candidate": "필살 킥의 충돌은 서로를 날려버리고､ 극이 다른 자석끼리 반발하듯이 떨어졌다｡"
  },
  {
   "id": 46619,
   "key": "D1513le.txt:34",
   "file": "D1513le.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "シャンタクの推進力を逆方向に噴射し、空中で静止する。",
   "ko_candidate": "샨타크의 추진력을 역방향으로 분사하여 공중에서 정지한다｡"
  },
  {
   "id": 46620,
   "key": "D1513le.txt:35",
   "file": "D1513le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスも同様だった。",
   "ko_candidate": "리베르 레기스도 마찬가지였다｡"
  },
  {
   "id": 46621,
   "key": "D1513le.txt:36",
   "file": "D1513le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空中で２体の鬼械神は再び対峙する。",
   "ko_candidate": "공중에서 2체의 귀계신은 다시 대치한다｡"
  },
  {
   "id": 46622,
   "key": "D1513le.txt:45",
   "file": "D1513le.txt",
   "line": 45,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふぅ……」",
   "ko_candidate": "「휴……」"
  },
  {
   "id": 46623,
   "key": "D1513le.txt:49",
   "file": "D1513le.txt",
   "line": 49,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どうしたの、大丈夫？　何か意識がどっか行ってたみたいだけど……」",
   "ko_candidate": "「어떻게 된 거야､ 괜찮아? 뭔가 의식이 어딘가로 가버린 것 같았는데……」"
  },
  {
   "id": 46624,
   "key": "D1513le.txt:53",
   "file": "D1513le.txt",
   "line": 53,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああ……大丈夫だ……」",
   "ko_candidate": "「아아…… 괜찮아……」"
  }
 ]
}