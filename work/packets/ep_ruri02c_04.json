   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何か――",
   "ko_candidate": "뭔가――"
  },
  {
   "id": 51253,
   "key": "ep_ruri02c.txt:457",
   "file": "ep_ruri02c.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "熱い何かが、",
   "ko_candidate": "뜨거운 뭔가가､"
  },
  {
   "id": 51254,
   "key": "ep_ruri02c.txt:457",
   "file": "ep_ruri02c.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "遠い何かが、",
   "ko_candidate": "먼 뭔가가､"
  },
  {
   "id": 51255,
   "key": "ep_ruri02c.txt:457",
   "file": "ep_ruri02c.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "暖かい何かが、",
   "ko_candidate": "따뜻한 뭔가가､"
  },
  {
   "id": 51256,
   "key": "ep_ruri02c.txt:457",
   "file": "ep_ruri02c.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "痛い何かが、",
   "ko_candidate": "아픈 뭔가가､"
  },
  {
   "id": 51257,
   "key": "ep_ruri02c.txt:457",
   "file": "ep_ruri02c.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "通り過ぎていったような気がした。",
   "ko_candidate": "스쳐 지나간 것 같은 기분이 들었다｡"
  },
  {
   "id": 51258,
   "key": "ep_ruri02c.txt:459",
   "file": "ep_ruri02c.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは一瞬の出来事だった。",
   "ko_candidate": "그것은 순간의 일이었다｡"
  },
  {
   "id": 51259,
   "key": "ep_ruri02c.txt:463",
   "file": "ep_ruri02c.txt",
   "line": 463,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……………………………………」",
   "ko_candidate": "「…………………………」 「…………………………」"
  },
  {
   "id": 51260,
   "key": "ep_ruri02c.txt:467",
   "file": "ep_ruri02c.txt",
   "line": 467,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………………………」",
   "ko_candidate": "「…………………………………………………」"
  },
  {
   "id": 51261,
   "key": "ep_ruri02c.txt:471",
   "file": "ep_ruri02c.txt",
   "line": 471,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………………………………………………………………………」 「……あの」",
   "ko_candidate": "「……저」"
  },
  {
   "id": 51262,
   "key": "ep_ruri02c.txt:478",
   "file": "ep_ruri02c.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黙って見つめ合う２人。",
   "ko_candidate": "말없이 서로 바라보는 2명｡"
  },
  {
   "id": 51263,
   "key": "ep_ruri02c.txt:479",
   "file": "ep_ruri02c.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いや、向こうからしてみれば、一方的に睨まれていると言ったところか。",
   "ko_candidate": "아니､ 저쪽에서 보면､ 일방적으로 노려보고 있다고 할 정도일까｡"
  },
  {
   "id": 51264,
   "key": "ep_ruri02c.txt:481",
   "file": "ep_ruri02c.txt",
   "line": 481,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "怯んだ瞳で、見つめ返してくる。",
   "ko_candidate": "겁먹은 눈동자로､ 마주 바라보고 있다｡"
  },
  {
   "id": 51265,
   "key": "ep_ruri02c.txt:482",
   "file": "ep_ruri02c.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "沈黙に堪え切れなくなったか、その人は恐る恐る、声をかけてきた。",
   "ko_candidate": "침묵을 견디지 못했는지､ 그 사람은 조심스럽게､ 말을 걸어왔다｡"
  },
  {
   "id": 51266,
   "key": "ep_ruri02c.txt:486",
   "file": "ep_ruri02c.txt",
   "line": 486,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アイス、すまなかった……えーと弁償するから……」",
   "ko_candidate": "「아이스､ 미안했어……저기 변상할 테니까……」"
  },
  {
   "id": 51267,
   "key": "ep_ruri02c.txt:490",
   "file": "ep_ruri02c.txt",
   "line": 490,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………………………」",
   "ko_candidate": "「……………………｡」"
  },
  {
   "id": 51268,
   "key": "ep_ruri02c.txt:493",
   "file": "ep_ruri02c.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私はまだ彼を睨み続けていたが、やがて",
   "ko_candidate": "나는 아직 그를 노려보고 있었지만､ 이윽고"
  },
  {
   "id": 51269,
   "key": "ep_ruri02c.txt:497",
   "file": "ep_ruri02c.txt",
   "line": 497,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「其処のお店」",
   "ko_candidate": "「저기 가게」"
  },
  {
   "id": 51270,
   "key": "ep_ruri02c.txt:501",
   "file": "ep_ruri02c.txt",
   "line": 501,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「え？」",
   "ko_candidate": "「엥?」"
  },
  {
   "id": 51271,
   "key": "ep_ruri02c.txt:505",
   "file": "ep_ruri02c.txt",
   "line": 505,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「凄い行列で、待たされました。 ３０分くらい」",
   "ko_candidate": "「엄청난 줄이었고､ 기다렸어요｡ 30분 정도」"
  },
  {
   "id": 51272,
   "key": "ep_ruri02c.txt:510",
   "file": "ep_ruri02c.txt",
   "line": 510,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……はあ」",
   "ko_candidate": "「……하아」"
  },
  {
   "id": 51273,
   "key": "ep_ruri02c.txt:514",
   "file": "ep_ruri02c.txt",
   "line": 514,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「また並ばないといけないではありませんか。 ……付き合いなさい」",
   "ko_candidate": "「또 줄 서야 하지 않겠어요｡ ……함께 가세요」"
  },
  {
   "id": 51274,
   "key": "ep_ruri02c.txt:519",
   "file": "ep_ruri02c.txt",
   "line": 519,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ゲゲッ」",
   "ko_candidate": "「헉」"
  },
  {
   "id": 51275,
   "key": "ep_ruri02c.txt:522",
   "file": "ep_ruri02c.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あからさまに、心底、嫌そうに顔を顰める彼に、私は怒鳴った。",
   "ko_candidate": "노골적으로､ 진심으로､ 싫다는 듯이 얼굴을 찌푸리는 그에게､ 나는 소리쳤다｡"
  },
  {
   "id": 51276,
   "key": "ep_ruri02c.txt:526",
   "file": "ep_ruri02c.txt",
   "line": 526,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「自分でやった事でしょう!? ちゃんと責任は取ってもらいますわよ！」",
   "ko_candidate": "「자기가 한 일 아니에요!? 제대로 책임은 져야 해요!」"
  },
  {
   "id": 51277,
   "key": "ep_ruri02c.txt:531",
   "file": "ep_ruri02c.txt",
   "line": 531,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「わ、分かった！　分かったから、大声出すな！　目立つじゃないか！」",
   "ko_candidate": "「알､ 알았어! 알았으니까､ 큰 소리 내지 마! 눈에 띄잖아!」"
  },
  {
   "id": 51278,
   "key": "ep_ruri02c.txt:535",
   "file": "ep_ruri02c.txt",
   "line": 535,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「貴方、この辺りの事は詳しいのですか？」",
   "ko_candidate": "「당신､ 이 근처는 잘 아나요?」"
  },
  {
   "id": 51279,
   "key": "ep_ruri02c.txt:539",
   "file": "ep_ruri02c.txt",
   "line": 539,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「え……あー、まあ、そこそこ」",
   "ko_candidate": "「어……아-､ 뭐､ 그럭저럭」"
  },
  {
   "id": 51280,
   "key": "ep_ruri02c.txt:543",
   "file": "ep_ruri02c.txt",
   "line": 543,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それは良かった。わたくし、この辺りは良く分からないのです。 後で案内してもらいますわね」",
   "ko_candidate": "「다행이네요｡ 저는､ 이 근처는 잘 모르거든요｡ 나중에 안내해 주세요」"
  },
  {
   "id": 51281,
   "key": "ep_ruri02c.txt:548",
   "file": "ep_ruri02c.txt",
   "line": 548,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「はぁぁっ!?　何でアイス一つで、そこまでせにゃあ……！」",
   "ko_candidate": "「하아아!? 왜 아이스 하나로､ 거기까지 해야……!」"
  },
  {
   "id": 51282,
   "key": "ep_ruri02c.txt:552",
   "file": "ep_ruri02c.txt",
   "line": 552,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「貴方のせいで、貴重な時間を浪費してしまうからではありませんか！　こうなったら無駄は省かないと……最後までちゃんと面倒見てもらいますわ！」",
   "ko_candidate": "「당신 때문에､ 귀중한 시간을 낭비하게 됐으니까 아니에요! 이렇게 된 이상 낭비는 줄여야……끝까지 제대로 책임져 주세요!」"
  },
  {
   "id": 51283,
   "key": "ep_ruri02c.txt:556",
   "file": "ep_ruri02c.txt",
   "line": 556,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「どういう理屈だ、それは!?　だいたいあんた、見ず知らずの人間に……」",
   "ko_candidate": "「무슨 논리야､ 그게!? 게다가 너､ 본 적도 없는 사람한테……」"
  },
  {
   "id": 51284,
   "key": "ep_ruri02c.txt:560",
   "file": "ep_ruri02c.txt",
   "line": 560,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「黙りなさい！　ここまで来て逃げるつもりですか！　男らしくない……！」",
   "ko_candidate": "「조용히 하세요! 여기까지 와서 도망칠 생각인가요! 남자답지 않아……!」"
  },
  {
   "id": 51285,
   "key": "ep_ruri02c.txt:564",
   "file": "ep_ruri02c.txt",
   "line": 564,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「男らしいらしくないじゃねえだろっ！ あああああ！　もう！　何が何だか……ッ！」",
   "ko_candidate": "「남자답고 안 답고가 아니잖아! 아아아아! 정말! 뭐가 뭔지……!」"
  },
  {
   "id": 51286,
   "key": "ep_ruri02c.txt:575",
   "file": "ep_ruri02c.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "街の喧騒をも貫いて、男と女の怒鳴り声は街に響き渡っていた。",
   "ko_candidate": "거리의 소음을 뚫고､ 남자와 여자의 고함소리가 거리에 울려 퍼지고 있었다｡"
  },
  {
   "id": 51287,
   "key": "ep_ruri02c.txt:576",
   "file": "ep_ruri02c.txt",
   "line": 576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何事かと思った通行人の視線が、２人に集中している。",
   "ko_candidate": "무슨 일인가 하고 생각한 행인들의 시선이､ 두 사람에게 집중되고 있다｡"
  },
  {
   "id": 51288,
   "key": "ep_ruri02c.txt:577",
   "file": "ep_ruri02c.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "傍から見ればそれは、痴話喧嘩の様に見えるかも知れない。",
   "ko_candidate": "옆에서 보면 그것은､ 연인 싸움처럼 보일지도 모른다｡"
  },
  {
   "id": 51289,
   "key": "ep_ruri02c.txt:583",
   "file": "ep_ruri02c.txt",
   "line": 583,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "雑踏に混じって、小柄な少女の姿があった。",
   "ko_candidate": "잡답에 섞여､ 작은 체구의 소녀의 모습이 있었다｡"
  },
  {
   "id": 51290,
   "key": "ep_ruri02c.txt:584",
   "file": "ep_ruri02c.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "喧嘩する２人を、遠くから凝っと眺めている。",
   "ko_candidate": "싸우는 두 사람을､ 멀리서 뚫어지게 바라보고 있다｡"
  },
  {
   "id": 51291,
   "key": "ep_ruri02c.txt:586",
   "file": "ep_ruri02c.txt",
   "line": 586,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その口元が、僅かに綻んだ。",
   "ko_candidate": "그 입가가､ 살짝 풀어졌다｡"
  }
 ]
}