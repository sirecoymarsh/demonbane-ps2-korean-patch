 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ネロ": "네로",
  "アウグストゥス": "아우구스투스",
  "ナイ神父": "나이 신부"
 },
 "items": [
  {
   "id": 49499,
   "key": "ep_al02.txt:159",
   "file": "ep_al02.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "詩を、詠いながら。",
   "ko_candidate": "시를､ 읊으면서｡"
  },
  {
   "id": 49500,
   "key": "ep_al02.txt:167",
   "file": "ep_al02.txt",
   "line": 167,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何を、そんなに 焦がれているのかな？」",
   "ko_candidate": "「무엇을､ 그렇게 애타게 기다리고 있는 걸까?」"
  },
  {
   "id": 49501,
   "key": "ep_al02.txt:172",
   "file": "ep_al02.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "唐突に。",
   "ko_candidate": "돌연｡"
  },
  {
   "id": 49502,
   "key": "ep_al02.txt:174",
   "file": "ep_al02.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空っぽの世界に。",
   "ko_candidate": "텅 빈 세계에｡"
  },
  {
   "id": 49503,
   "key": "ep_al02.txt:175",
   "file": "ep_al02.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女しか居ない世界に。",
   "ko_candidate": "소녀밖에 없는 세계에｡"
  },
  {
   "id": 49504,
   "key": "ep_al02.txt:176",
   "file": "ep_al02.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "孤独の世界に。",
   "ko_candidate": "고독의 세계에｡"
  },
  {
   "id": 49505,
   "key": "ep_al02.txt:177",
   "file": "ep_al02.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女のものではない、声が響いた。",
   "ko_candidate": "소녀의 것이 아닌､ 목소리가 울렸다｡"
  },
  {
   "id": 49506,
   "key": "ep_al02.txt:179",
   "file": "ep_al02.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その瞬間、世界は、空っぽでも孤独でも無くなった。",
   "ko_candidate": "그 순간､ 세계는､ 텅 비지도 고독하지도 않게 되었다｡"
  },
  {
   "id": 49507,
   "key": "ep_al02.txt:180",
   "file": "ep_al02.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "目に視える訳ではなく、音に聴こえる訳でもない、嗅ぐ事も触れる事も出来ない、だけど確実に存在する濃密な何かが、世界を急激な勢いで、邪悪に侵していった。",
   "ko_candidate": "눈에 보이는 것도 아니고､ 귀에 들리는 것도 아니며､ 냄새 맡을 수도 만질 수도 없지만､ 확실히 존재하는 농밀한 무언가가 세계를 급격한 기세로 사악하게 침식해갔다｡"
  },
  {
   "id": 49508,
   "key": "ep_al02.txt:183",
   "file": "ep_al02.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "瘴気を孕んだ風が吹く。",
   "ko_candidate": "독기를 품은 바람이 분다｡"
  },
  {
   "id": 49509,
   "key": "ep_al02.txt:184",
   "file": "ep_al02.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女の詩が止んだ。",
   "ko_candidate": "소녀의 시가 멈췄다｡"
  },
  {
   "id": 49510,
   "key": "ep_al02.txt:185",
   "file": "ep_al02.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "濃密な気配が、少女の背後に立つ気配が、 少女の名を呼んだ。",
   "ko_candidate": "농밀한 기척이､ 소녀의 뒤에 서 있는 기척이､ 소녀의 이름을 불렀다｡"
  },
  {
   "id": 49511,
   "key": "ep_al02.txt:190",
   "file": "ep_al02.txt",
   "line": 190,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――ネロ」",
   "ko_candidate": "「――네로」"
  },
  {
   "id": 49512,
   "key": "ep_al02.txt:197",
   "file": "ep_al02.txt",
   "line": 197,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「君か」",
   "ko_candidate": "「너구나」"
  },
  {
   "id": 49513,
   "key": "ep_al02.txt:200",
   "file": "ep_al02.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "応じる少女の貌に、鬼相が疾る。",
   "ko_candidate": "대답하는 소녀의 얼굴에 귀신의 상이 스친다｡"
  },
  {
   "id": 49514,
   "key": "ep_al02.txt:201",
   "file": "ep_al02.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "虚ろな憎悪を閉じ込めた冷たい瞳で、振り返る。",
   "ko_candidate": "공허한 증오를 담은 차가운 눈동자로 돌아본다｡"
  },
  {
   "id": 49515,
   "key": "ep_al02.txt:205",
   "file": "ep_al02.txt",
   "line": 205,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ナイアルラトホテップ」",
   "ko_candidate": "「니알라토텝」"
  },
  {
   "id": 49516,
   "key": "ep_al02.txt:208",
   "file": "ep_al02.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――邪悪は其処に居た。",
   "ko_candidate": "――사악함은 그곳에 있었다｡"
  },
  {
   "id": 49517,
   "key": "ep_al02.txt:217",
   "file": "ep_al02.txt",
   "line": 217,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「久しぶり―― と言っても良いのかな？」",
   "ko_candidate": "「오랜만이군――이라고 해도 될까?」"
  },
  {
   "id": 49518,
   "key": "ep_al02.txt:221",
   "file": "ep_al02.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒い肌の長躯が、鉄骨に座る少女を見上げていた。",
   "ko_candidate": "검은 피부의 장신이 철골 위에 앉은 소녀를 올려다보고 있었다｡"
  },
  {
   "id": 49519,
   "key": "ep_al02.txt:222",
   "file": "ep_al02.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女は立ち上がる。",
   "ko_candidate": "소녀가 일어선다｡"
  },
  {
   "id": 49520,
   "key": "ep_al02.txt:223",
   "file": "ep_al02.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "バランスの悪い、斜めに傾いだ鉄骨の上に、 真っ直ぐと。",
   "ko_candidate": "균형이 나쁜､ 비스듬히 기울어진 철골 위에 똑바로｡"
  },
  {
   "id": 49521,
   "key": "ep_al02.txt:224",
   "file": "ep_al02.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "男を見下ろし、告げる。",
   "ko_candidate": "남자를 내려다보며 말한다｡"
  },
  {
   "id": 49522,
   "key": "ep_al02.txt:228",
   "file": "ep_al02.txt",
   "line": 228,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何だ……此処ではその姿なの、アウグストゥス。 いや、中身が違うなら呼び方も変えるべきだよね？」",
   "ko_candidate": "「뭐야……여기서는 그 모습인 거야､ 아우구스투스｡ 아니､ 내용물이 다르다면 부르는 방식도 바꿔야겠지?」"
  },
  {
   "id": 49523,
   "key": "ep_al02.txt:232",
   "file": "ep_al02.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女の口元に、不敵な笑みが浮かぶ。",
   "ko_candidate": "소녀의 입가에 뻔뻔한 미소가 떠오른다｡"
  },
  {
   "id": 49524,
   "key": "ep_al02.txt:233",
   "file": "ep_al02.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "男の口元が、嘲笑の容をとって裂ける。",
   "ko_candidate": "남자의 입가가 조소의 모습을 하고 갈라진다｡"
  },
  {
   "id": 49525,
   "key": "ep_al02.txt:234",
   "file": "ep_al02.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女が、男の名を呼んだ。",
   "ko_candidate": "소녀가 남자의 이름을 불렀다｡"
  },
  {
   "id": 49526,
   "key": "ep_al02.txt:238",
   "file": "ep_al02.txt",
   "line": 238,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――ナイ神父」",
   "ko_candidate": "「――나이 신부」"
  },
  {
   "id": 49527,
   "key": "ep_al02.txt:245",
   "file": "ep_al02.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒い男の、哄笑が響き渡った。",
   "ko_candidate": "검은 남자의 폭소가 울려 퍼졌다｡"
  },
  {
   "id": 49528,
   "key": "ep_al02.txt:250",
   "file": "ep_al02.txt",
   "line": 250,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いやはや、名前など僕には――私には、全くもって意味の無いものさ」",
   "ko_candidate": "「참으로､ 이름 따위는 나에게는――저에게는､ 전혀 의미 없는 것이지」"
  },
  {
   "id": 49529,
   "key": "ep_al02.txt:269",
   "file": "ep_al02.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――劫ッ。",
   "ko_candidate": "――콰앙｡"
  },
  {
   "id": 49530,
   "key": "ep_al02.txt:271",
   "file": "ep_al02.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "男の内から、燃え盛る闇黒が噴き出した。",
   "ko_candidate": "남자의 내면에서 타오르는 암흑이 뿜어져 나왔다｡"
  },
  {
   "id": 49531,
   "key": "ep_al02.txt:272",
   "file": "ep_al02.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "焔える闇黒を身に纏う男。",
   "ko_candidate": "불타는 암흑을 몸에 두른 남자｡"
  },
  {
   "id": 49532,
   "key": "ep_al02.txt:274",
   "file": "ep_al02.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "雲ひとつ無い青天の下、だが男の貌には影が差す。",
   "ko_candidate": "구름 한 점 없는 푸른 하늘 아래､ 하지만 남자의 얼굴에는 그림자가 드리워져 있다｡"
  },
  {
   "id": 49533,
   "key": "ep_al02.txt:275",
   "file": "ep_al02.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "漆黒の貌に焔える眸が爛々と輝いていた。",
   "ko_candidate": "칠흑의 얼굴에 불타는 눈동자가 번쩍번쩍 빛나고 있었다｡"
  },
  {
   "id": 49534,
   "key": "ep_al02.txt:277",
   "file": "ep_al02.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "否。",
   "ko_candidate": "아니｡"
  },
  {
   "id": 49535,
   "key": "ep_al02.txt:278",
   "file": "ep_al02.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "額が裂けた様に第三の眸が焔えている。",
   "ko_candidate": "이마가 갈라진 듯 제3의 눈동자가 불타고 있다｡"
  },
  {
   "id": 49536,
   "key": "ep_al02.txt:284",
   "file": "ep_al02.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女が、鼻で嗤った。",
   "ko_candidate": "소녀가 코웃음 쳤다｡"
  },
  {
   "id": 49537,
   "key": "ep_al02.txt:288",
   "file": "ep_al02.txt",
   "line": 288,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「往生際が悪いなあ。まだ諦めていないのかい、神様？」",
   "ko_candidate": "「미련이 남았구나｡ 아직도 포기하지 않은 거야､ 신님?」"
  },
  {
   "id": 49538,
   "key": "ep_al02.txt:292",
   "file": "ep_al02.txt",
   "line": 292,
   "speaker": "ナイ神父",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの世界では無理だったがね。 まあ、良い。もう一度、繰り返すとしようじゃないか」 「今度は如何なる結果に辿り着くかは判らないが……まあ、それも一興。 空間も時間も私にとっては意味を成さない。宇宙の総ては、泡沫の夢」",
   "ko_candidate": "「저 세계에서는 무리였지만 말이야｡ 뭐､ 좋아｡ 다시 한 번 반복해보자고｡ 이번에는 어떤 결과에 도달할지 모르겠지만……뭐､ 그것도 흥미롭군｡ 공간도 시간도 나에게는 의미가 없어｡ 우주의 모든 것은 물거품의 꿈」"
  }
 ]
}