 "items": [
  {
   "id": 46003,
   "key": "D1510ru.txt:457",
   "file": "D1510ru.txt",
   "line": 457,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……大丈夫か、九郎？」",
   "ko_candidate": "「큭… 괜찮아､ 쿠로?」"
  },
  {
   "id": 46004,
   "key": "D1510ru.txt:461",
   "file": "D1510ru.txt",
   "line": 461,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何とか……だが……」",
   "ko_candidate": "「어떻게든… 하지만…」"
  },
  {
   "id": 46005,
   "key": "D1510ru.txt:467",
   "file": "D1510ru.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墜落のダメージに加え、魔力のほとんどを使い果たしたのもあって、力が入らずデモンベインを動かせない。",
   "ko_candidate": "추락의 데미지에 더해､ 마력의 대부분을 소진한 탓에 힘이 들어가지 않아 데몬베인을 움직일 수 없다｡"
  },
  {
   "id": 46006,
   "key": "D1510ru.txt:469",
   "file": "D1510ru.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを動かせるようになるまで魔力を回復させるのには随分と時間がかかる。",
   "ko_candidate": "데몬베인을 움직일 수 있을 정도로 마력을 회복하려면 꽤 시간이 걸릴 것이다｡"
  },
  {
   "id": 46007,
   "key": "D1510ru.txt:469",
   "file": "D1510ru.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが追撃は無かった。",
   "ko_candidate": "하지만 추격은 없었다｡"
  },
  {
   "id": 46008,
   "key": "D1510ru.txt:471",
   "file": "D1510ru.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスは十字架を仕舞い、腕を組んでこちらを待っている。",
   "ko_candidate": "리베르 레기스는 십자가를 치우고､ 팔짱을 낀 채 이쪽을 기다리고 있다｡"
  },
  {
   "id": 46009,
   "key": "D1510ru.txt:481",
   "file": "D1510ru.txt",
   "line": 481,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそ……！」",
   "ko_candidate": "「젠장…!」"
  },
  {
   "id": 46010,
   "key": "D1510ru.txt:484",
   "file": "D1510ru.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力の限りを尽くしてようやく身を起こす。",
   "ko_candidate": "온 힘을 다해 겨우 몸을 일으킨다｡"
  },
  {
   "id": 46011,
   "key": "D1510ru.txt:485",
   "file": "D1510ru.txt",
   "line": 485,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その様をマスターテリオンはコクピットの中で嗤っているのだろう。",
   "ko_candidate": "그 모습을 마스터 테리온은 콕핏 안에서 비웃고 있겠지｡"
  },
  {
   "id": 46012,
   "key": "D1510ru.txt:487",
   "file": "D1510ru.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悔しさに眉間が熱くなる。",
   "ko_candidate": "분함에 미간이 뜨거워진다｡"
  },
  {
   "id": 46013,
   "key": "D1510ru.txt:488",
   "file": "D1510ru.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "片膝と片腕を突いたまま、それでも右手に『クトゥグア』を握って、上空のマスターテリオンに向け……そこでまた凍りつく羽目になった。",
   "ko_candidate": "한쪽 무릎과 한쪽 팔을 짚은 채､ 그래도 오른손에 『크투가』를 쥐고､ 상공의 마스터 테리온을 향해… 거기서 또 얼어붙을 수밖에 없었다｡"
  },
  {
   "id": 46014,
   "key": "D1510ru.txt:495",
   "file": "D1510ru.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見たのは巨大な、黒き龍の躰を持った金色の弓。",
   "ko_candidate": "본 것은 거대한､ 검은 용의 몸을 가진 황금빛 활｡"
  },
  {
   "id": 46015,
   "key": "D1510ru.txt:496",
   "file": "D1510ru.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天空より首をもたげてデモンベインを見下ろし、その口腔に装填された燃える、輝く矢を向けている。",
   "ko_candidate": "천공에서 고개를 들어 데몬베인을 내려다보며､ 그 구강에 장전된 불타오르는､ 빛나는 화살을 겨누고 있다｡"
  },
  {
   "id": 46016,
   "key": "D1510ru.txt:498",
   "file": "D1510ru.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "矢の放つ輝きは５つの太陽よりも眩く世界を染め上げ、矢の放つ熱は５つの太陽よりも熱く世界を灼く。",
   "ko_candidate": "화살이 뿜어내는 광채는 5개의 태양보다 더 눈부시게 세상을 물들이고､ 화살이 뿜어내는 열기는 5개의 태양보다 더 뜨겁게 세상을 태운다｡"
  },
  {
   "id": 46017,
   "key": "D1510ru.txt:502",
   "file": "D1510ru.txt",
   "line": 502,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おのれ……ッ」",
   "ko_candidate": "「이 자식…」"
  },
  {
   "id": 46018,
   "key": "D1510ru.txt:509",
   "file": "D1510ru.txt",
   "line": 509,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「天狼星の弓……放て」",
   "ko_candidate": "「천랑성의 활… 쏴라」"
  },
  {
   "id": 46019,
   "key": "D1510ru.txt:513",
   "file": "D1510ru.txt",
   "line": 513,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イエス、マスター」",
   "ko_candidate": "「예､ 마스터」"
  },
  {
   "id": 46020,
   "key": "D1510ru.txt:521",
   "file": "D1510ru.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "龍の咆吼は伽藍に響く鐘の音にも似ていた。",
   "ko_candidate": "용의 포효는 가람에 울리는 종소리와도 비슷했다｡"
  },
  {
   "id": 46021,
   "key": "D1510ru.txt:528",
   "file": "D1510ru.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――世界が白く、沸騰する。",
   "ko_candidate": "――세계가 하얗게､ 들끓는다｡"
  }
 ]
