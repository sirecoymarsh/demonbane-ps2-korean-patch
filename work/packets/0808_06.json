{
 "packet": "0808_06",
 "scene": "0808",
 "anchor": {
  "hit": 17,
  "total": 20,
  "rate": 0.85
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎ちゃん": "쿠로 군",
  "ライカ": "라이카",
  "九郎": "쿠로",
  "魔術師": "마술사"
 },
 "items": [
  {
   "id": 14210,
   "key": "D0808le.txt:38",
   "file": "D0808le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当は分かっている。",
   "ko_candidate": "정말로 알고 있다｡"
  },
  {
   "id": 14211,
   "key": "D0808le.txt:39",
   "file": "D0808le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総て、自分のせいなのだ。",
   "ko_candidate": "모든 것이 자신 때문이라는 것을｡"
  },
  {
   "id": 14212,
   "key": "D0808le.txt:41",
   "file": "D0808le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "でも。それでも。",
   "ko_candidate": "하지만｡ 그래도｡"
  },
  {
   "id": 14213,
   "key": "D0808le.txt:43",
   "file": "D0808le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "運命の皮肉を呪わずにはいられない。",
   "ko_candidate": "운명의 아이러니를 저주하지 않을 수 없다｡"
  },
  {
   "id": 14214,
   "key": "D0808le.txt:45",
   "file": "D0808le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃れられないのか。",
   "ko_candidate": "벗어날 수 없는 걸까｡"
  },
  {
   "id": 14215,
   "key": "D0808le.txt:46",
   "file": "D0808le.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この呪縛からは、永遠に逃れられないのか。",
   "ko_candidate": "이 주박에서는 영원히 벗어날 수 없는 걸까｡"
  },
  {
   "id": 14216,
   "key": "D0808le.txt:51",
   "file": "D0808le.txt",
   "line": 51,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃん……置いてきちゃった」",
   "ko_candidate": "「쿠로 군…… 두고 와버렸어」"
  },
  {
   "id": 14217,
   "key": "D0808le.txt:55",
   "file": "D0808le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今ごろ怒っているに違いない。",
   "ko_candidate": "지금쯤 화내고 있을 게 분명해｡"
  },
  {
   "id": 14218,
   "key": "D0808le.txt:57",
   "file": "D0808le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "早く戻らないと。",
   "ko_candidate": "빨리 돌아가야 해｡"
  },
  {
   "id": 14219,
   "key": "D0808le.txt:59",
   "file": "D0808le.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。今は今で大切なことがある。",
   "ko_candidate": "그래｡ 지금은 지금대로 중요한 일이 있어｡"
  },
  {
   "id": 14220,
   "key": "D0808le.txt:60",
   "file": "D0808le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "守らなくてはならない生活がある。",
   "ko_candidate": "지켜야 할 생활이 있어｡"
  },
  {
   "id": 14221,
   "key": "D0808le.txt:62",
   "file": "D0808le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから、戻ろう。",
   "ko_candidate": "그러니까 돌아가자｡"
  },
  {
   "id": 14222,
   "key": "D0808le.txt:63",
   "file": "D0808le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暖かい、ただの日常に。",
   "ko_candidate": "따뜻한､ 그저 평범한 일상으로｡"
  },
  {
   "id": 14223,
   "key": "D0808le.txt:65",
   "file": "D0808le.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通行人が騒いでいる。",
   "ko_candidate": "행인들이 소란스럽다｡"
  },
  {
   "id": 14224,
   "key": "D0808le.txt:67",
   "file": "D0808le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……何かあったんだろうか。",
   "ko_candidate": "……무슨 일이 있었던 걸까｡"
  },
  {
   "id": 14225,
   "key": "D0808le.txt:69",
   "file": "D0808le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今しがた見た彼の幻影に、ライカの心は不安が覆う。",
   "ko_candidate": "방금 전에 본 그의 환영에､ 라이카의 마음은 불안으로 뒤덮인다｡"
  },
  {
   "id": 14226,
   "key": "D0808le.txt:72",
   "file": "D0808le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そしてそれを肯定するかのように",
   "ko_candidate": "그리고 그것을 긍정하듯이"
  },
  {
   "id": 14227,
   "key": "D0808le.txt:73",
   "file": "D0808le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "またしても運命は嘲笑うように",
   "ko_candidate": "또다시 운명은 비웃듯이"
  },
  {
   "id": 14228,
   "key": "D0808le.txt:77",
   "file": "D0808le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――鳴り響く銃声。",
   "ko_candidate": "――울려 퍼지는 총성｡"
  },
  {
   "id": 14229,
   "key": "D0808le.txt:79",
   "file": "D0808le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカは見た。",
   "ko_candidate": "라이카는 보았다｡"
  },
  {
   "id": 14230,
   "key": "D0808le.txt:88",
   "file": "D0808le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声に振り返ったその先。上空に浮かぶ翼を持った黒い影。",
   "ko_candidate": "총성에 돌아본 그 앞｡ 상공에 떠 있는 날개를 가진 검은 그림자｡"
  },
  {
   "id": 14231,
   "key": "D0808le.txt:91",
   "file": "D0808le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎だ。",
   "ko_candidate": "쿠로다｡"
  },
  {
   "id": 14232,
   "key": "D0808le.txt:92",
   "file": "D0808le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術師の姿になった九郎だ。",
   "ko_candidate": "마술사의 모습이 된 쿠로다｡"
  },
  {
   "id": 14233,
   "key": "D0808le.txt:94",
   "file": "D0808le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術師の姿だという事は……尋常ならざる事態が起きたのだ。",
   "ko_candidate": "마술사의 모습이라는 건…… 심상치 않은 사태가 벌어진 거야｡"
  },
  {
   "id": 14234,
   "key": "D0808le.txt:99",
   "file": "D0808le.txt",
   "line": 99,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん！」",
   "ko_candidate": "「쿠로 군!」"
  },
  {
   "id": 14235,
   "key": "D0808le.txt:106",
   "file": "D0808le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "急がないと。",
   "ko_candidate": "서둘러야 해｡"
  },
  {
   "id": 14236,
   "key": "D0808le.txt:107",
   "file": "D0808le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駈け出そうとした矢先。空にある九郎の躰が傾いだ。",
   "ko_candidate": "달려나가려는 찰나｡ 하늘에 있던 쿠로의 몸이 기울었다｡"
  },
  {
   "id": 14237,
   "key": "D0808le.txt:109",
   "file": "D0808le.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのまま力を失ったように墜落する。",
   "ko_candidate": "그대로 힘을 잃은 듯 추락한다｡"
  },
  {
   "id": 14238,
   "key": "D0808le.txt:111",
   "file": "D0808le.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その光景を、ライカは遠目に、はっきりと捉えてしまった。",
   "ko_candidate": "그 광경을､ 라이카는 멀리서､ 분명히 포착해버렸다｡"
  },
  {
   "id": 14239,
   "key": "D0808le.txt:116",
   "file": "D0808le.txt",
   "line": 116,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……あああ……！　九郎ちゃんっっっ！」",
   "ko_candidate": "「아…… 아아아……! 쿠로 군!!!」"
  },
  {
   "id": 14240,
   "key": "D0808le.txt:124",
   "file": "D0808le.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駈け出す。",
   "ko_candidate": "달려나간다｡"
  },
  {
   "id": 14241,
   "key": "D0808le.txt:126",
   "file": "D0808le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全速力で駈け出す。",
   "ko_candidate": "전속력으로 달려나간다｡"
  },
  {
   "id": 14242,
   "key": "D0808le.txt:128",
   "file": "D0808le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人があまりにも集まり過ぎているのが鬱陶しい。",
   "ko_candidate": "사람들이 너무 많이 모여 있어서 짜증 난다｡"
  },
  {
   "id": 14243,
   "key": "D0808le.txt:130",
   "file": "D0808le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何でこう、いちいち噛み合っていかないのだろうか。",
   "ko_candidate": "왜 이렇게､ 하나하나 맞물리지 않는 걸까｡"
  },
  {
   "id": 14244,
   "key": "D0808le.txt:132",
   "file": "D0808le.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても、運命が嗤っている。",
   "ko_candidate": "또다시 운명이 웃고 있다｡"
  },
  {
   "id": 14245,
   "key": "D0808le.txt:133",
   "file": "D0808le.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "運命が嘲笑っている。",
   "ko_candidate": "운명이 비웃고 있다｡"
  },
  {
   "id": 14246,
   "key": "D0808le.txt:135",
   "file": "D0808le.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その哄笑が、ライカを縛って、離れない。",
   "ko_candidate": "그 조소가 라이카를 묶어서 떨어지지 않는다｡"
  },
  {
   "id": 14247,
   "key": "D0808ru.txt:10",
   "file": "D0808ru.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さて……困った。",
   "ko_candidate": "자… 곤란하군｡"
  },
  {
   "id": 14248,
   "key": "D0808ru.txt:11",
   "file": "D0808ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いきなり拉致られて、なし崩し的に映画を一緒に見ることになったワケだが……これからどうすれば良いか分からない。",
   "ko_candidate": "갑자기 납치당해서 어쩌다 보니 영화를 함께 보게 됐는데… 이제 어떻게 해야 할지 모르겠다｡"
  },
  {
   "id": 14249,
   "key": "D0808ru.txt:13",
   "file": "D0808ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "とりあえず適当な店に入って、お茶でも飲んで寛げば良いのだろうか。",
   "ko_candidate": "일단 적당한 가게에 들어가서 차라도 마시며 쉬면 되려나｡"
  }
 ]
}