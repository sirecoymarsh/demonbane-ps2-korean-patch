 },
 "items": [
  {
   "id": 31352,
   "key": "D1302ru.txt:90",
   "file": "D1302ru.txt",
   "line": 90,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「え……あ……っ」",
   "ko_candidate": "「어……아……」"
  },
  {
   "id": 31353,
   "key": "D1302ru.txt:93",
   "file": "D1302ru.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの怒声に、何とか自分を取り戻す。",
   "ko_candidate": "알의 고함에､ 어떻게든 자신을 되찾는다｡"
  },
  {
   "id": 31354,
   "key": "D1302ru.txt:95",
   "file": "D1302ru.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが感情はやはり麻痺したままで、だけどアルの言葉だけを足懸かりに、自我を留め続ける。",
   "ko_candidate": "하지만 감정은 역시 마비된 채로､ 그래도 알의 말만을 발판 삼아､ 자아를 계속 유지한다｡"
  },
  {
   "id": 31355,
   "key": "D1302ru.txt:97",
   "file": "D1302ru.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖だけの心に、僅かに捩じ込まれたアルの声。",
   "ko_candidate": "공포뿐인 마음에､ 간신히 비집고 들어간 알의 목소리｡"
  },
  {
   "id": 31356,
   "key": "D1302ru.txt:98",
   "file": "D1302ru.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけに縋り、這って九郎から逃げ続ける。",
   "ko_candidate": "그것만을 붙잡고､ 기어서 쿠로에게서 계속 도망친다｡"
  },
  {
   "id": 31357,
   "key": "D1302ru.txt:101",
   "file": "D1302ru.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に一歩。",
   "ko_candidate": "한 걸음 더｡"
  },
  {
   "id": 31358,
   "key": "D1302ru.txt:102",
   "file": "D1302ru.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんな幽かな意思を嘲笑い、恐怖が絶望へと変わるその瞬間、九郎の動きが止まった。",
   "ko_candidate": "그런 희미한 의지를 조롱하듯､ 공포가 절망으로 변하는 그 순간､ 쿠로의 움직임이 멈췄다｡"
  },
  {
   "id": 31359,
   "key": "D1302ru.txt:104",
   "file": "D1302ru.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇の烈しさが薄れ、代わりに九郎の上に圧し掛かる様に、昏く昏く堆積してゆく。",
   "ko_candidate": "어둠의 격렬함이 옅어지고､ 대신 쿠로 위에 덮치듯､ 어둡고 어둡게 쌓여간다｡"
  },
  {
   "id": 31360,
   "key": "D1302ru.txt:106",
   "file": "D1302ru.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "降り積もる闇の只中で、九郎は、絶叫する。",
   "ko_candidate": "내려쌓이는 어둠의 한가운데서､ 쿠로는､ 절규한다｡"
  },
  {
   "id": 31361,
   "key": "D1302ru.txt:112",
   "file": "D1302ru.txt",
   "line": 112,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアアアアアアアアアアアアアアアアアアアアアア！」",
   "ko_candidate": "「아아아아아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 31362,
   "key": "D1302ru.txt:116",
   "file": "D1302ru.txt",
   "line": 116,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎!?」",
   "ko_candidate": "「쿠로!?」"
  },
  {
   "id": 31363,
   "key": "D1302ru.txt:122",
   "file": "D1302ru.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "闇の只中――瞳に深淵を宿したまま、 深淵の侵略を許したまま、",
   "ko_candidate": "어둠의 한가운데――눈동자에 심연을 품은 채､ 심연의 침략을 허용한 채､"
  },
  {
   "id": 31364,
   "key": "D1302ru.txt:124",
   "file": "D1302ru.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の心は未だ、過去の恐怖に呪縛されている。",
   "ko_candidate": "쿠로의 마음은 아직､ 과거의 공포에 주박되어 있다｡"
  },
  {
   "id": 31365,
   "key": "D1302ru.txt:126",
   "file": "D1302ru.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃れられない。",
   "ko_candidate": "벗어날 수 없다｡"
  },
  {
   "id": 31366,
   "key": "D1302ru.txt:126",
   "file": "D1302ru.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墜ちてゆく。",
   "ko_candidate": "추락해간다｡"
  },
  {
   "id": 31367,
   "key": "D1302ru.txt:126",
   "file": "D1302ru.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墜ちてゆく。",
   "ko_candidate": "추락해간다｡"
  },
  {
   "id": 31368,
   "key": "D1302ru.txt:128",
   "file": "D1302ru.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの日の恐怖。",
   "ko_candidate": "그날의 공포｡"
  },
  {
   "id": 31369,
   "key": "D1302ru.txt:129",
   "file": "D1302ru.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "初めての魔導書閲覧。",
   "ko_candidate": "처음으로 마도서를 열람한 날｡"
  },
  {
   "id": 31370,
   "key": "D1302ru.txt:130",
   "file": "D1302ru.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、彼を退学に追い込んだ、あの忌まわしき事件。",
   "ko_candidate": "그리고､ 그를 퇴학으로 몰아넣은､ 그 불길한 사건｡"
  },
  {
   "id": 31371,
   "key": "D1302ru.txt:132",
   "file": "D1302ru.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "後に、ごく一部の者の間では『ダンウィッチの怪事件』と呼ばれ、呪われた記憶と共に封印された怪異。",
   "ko_candidate": "후에､ 극소수의 사람들 사이에서는 『던위치의 괴사건』이라 불리며､ 저주받은 기억과 함께 봉인된 괴이｡"
  },
  {
   "id": 31372,
   "key": "D1302ru.txt:134",
   "file": "D1302ru.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎は、かの事件の一端を垣間見たのだ。",
   "ko_candidate": "다이쥬지 쿠로는､ 그 사건의 일부를 엿본 것이다｡"
  },
  {
   "id": 31373,
   "key": "D1302ru.txt:155",
   "file": "D1302ru.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げていた。",
   "ko_candidate": "도망치고 있었다｡"
  },
  {
   "id": 31374,
   "key": "D1302ru.txt:156",
   "file": "D1302ru.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気付けば、全力で、必死に、本棚と本棚の間を、走っていた。",
   "ko_candidate": "정신차려보니､ 전력으로､ 필사적으로､ 책장과 책장 사이를､ 달리고 있었다｡"
  },
  {
   "id": 31375,
   "key": "D1302ru.txt:158",
   "file": "D1302ru.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "追って来る。",
   "ko_candidate": "쫓아온다｡"
  },
  {
   "id": 31376,
   "key": "D1302ru.txt:159",
   "file": "D1302ru.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの怪異が追って来る。",
   "ko_candidate": "그 괴이가 쫓아온다｡"
  },
  {
   "id": 31377,
   "key": "D1302ru.txt:160",
   "file": "D1302ru.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在り得てはならない存在が、俺を亡ぼそうと。",
   "ko_candidate": "있어서는 안 될 존재가､ 나를 없애려고｡"
  },
  {
   "id": 31378,
   "key": "D1302ru.txt:162",
   "file": "D1302ru.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "追ってくる。",
   "ko_candidate": "쫓아온다｡"
  },
  {
   "id": 31379,
   "key": "D1302ru.txt:163",
   "file": "D1302ru.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "おれを消そうとする。",
   "ko_candidate": "나를 지우려 한다｡"
  },
  {
   "id": 31380,
   "key": "D1302ru.txt:165",
   "file": "D1302ru.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――俺を殺そうと、あの化け物が迫って来る！",
   "ko_candidate": "――나를 죽이려고､ 그 괴물이 다가온다!"
  },
  {
   "id": 31381,
   "key": "D1302ru.txt:172",
   "file": "D1302ru.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "走った。",
   "ko_candidate": "달렸다｡"
  },
  {
   "id": 31382,
   "key": "D1302ru.txt:173",
   "file": "D1302ru.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "走った。",
   "ko_candidate": "달렸다｡"
  },
  {
   "id": 31383,
   "key": "D1302ru.txt:174",
   "file": "D1302ru.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "走った。",
   "ko_candidate": "달렸다｡"
  },
  {
   "id": 31384,
   "key": "D1302ru.txt:176",
   "file": "D1302ru.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一生分、走り尽くして、それでも走った。",
   "ko_candidate": "평생 달려도 모자랄 만큼､ 그래도 달렸다｡"
  },
  {
   "id": 31385,
   "key": "D1302ru.txt:177",
   "file": "D1302ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、出口には一向に辿り着かない。",
   "ko_candidate": "하지만､ 출구에는 도무지 도착하지 못한다｡"
  },
  {
   "id": 31386,
   "key": "D1302ru.txt:179",
   "file": "D1302ru.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "おかしい。",
   "ko_candidate": "이상하다｡"
  },
  {
   "id": 31387,
   "key": "D1302ru.txt:180",
   "file": "D1302ru.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは、おかしい。",
   "ko_candidate": "이건､ 이상하다｡"
  },
  {
   "id": 31388,
   "key": "D1302ru.txt:181",
   "file": "D1302ru.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いくら、この秘密図書館が大きいからと云って……",
   "ko_candidate": "아무리､ 이 비밀 도서관이 크다고 해도……"
  },
  {
   "id": 31389,
   "key": "D1302ru.txt:182",
   "file": "D1302ru.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなはずは無い。",
   "ko_candidate": "이럴 리가 없다｡"
  },
  {
   "id": 31390,
   "key": "D1302ru.txt:184",
   "file": "D1302ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それとも俺の頭の方が、とっくにイカれてしまっているんだろうか。",
   "ko_candidate": "아니면 내 머리가 벌써 미쳐버린 걸까｡"
  },
  {
   "id": 31391,
   "key": "D1302ru.txt:186",
   "file": "D1302ru.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……何でも良い。",
   "ko_candidate": "……뭐든 좋다｡"
  }
 ]
