 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "破壊ロボ": "파괴 로봇",
  "デモンベイン": "데몬베인",
  "九郎": "쿠로",
  "ティマイオス": "티마이오스",
  "クリティアス": "크리티아스",
  "アトランティス・ストライク": "아틀란티스 스트라이크",
  "ウィンフィールド": "윈필드"
 },
 "items": [
  {
   "id": 19700,
   "key": "D0907ru.txt:54",
   "file": "D0907ru.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３体の破壊ロボは同時に動き出した！",
   "ko_candidate": "3대의 파괴 로봇이 동시에 움직이기 시작했다!"
  },
  {
   "id": 19701,
   "key": "D0907ru.txt:59",
   "file": "D0907ru.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一体はビルを飛び越え、襲いかかってくる。",
   "ko_candidate": "한 대는 빌딩을 뛰어넘어 덮쳐온다｡"
  },
  {
   "id": 19702,
   "key": "D0907ru.txt:60",
   "file": "D0907ru.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勢いを乗せた豪腕が、鎚の如く振り下ろされる――",
   "ko_candidate": "기세를 실은 강한 팔이 망치처럼 내리쳐진다――"
  },
  {
   "id": 19703,
   "key": "D0907ru.txt:63",
   "file": "D0907ru.txt",
   "line": 63,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「甘いっ！」",
   "ko_candidate": "「너무 얕봤군!」"
  },
  {
   "id": 19704,
   "key": "D0907ru.txt:71",
   "file": "D0907ru.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クロスカウンターで鉄拳をぶち込む。",
   "ko_candidate": "크로스 카운터로 철권을 날린다｡"
  },
  {
   "id": 19705,
   "key": "D0907ru.txt:73",
   "file": "D0907ru.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔面にめり込んだ拳は、そのまま胴体まで貫通し、機体をバラバラに粉砕する。",
   "ko_candidate": "얼굴에 박힌 주먹은 그대로 동체까지 관통해 기체를 산산조각 낸다｡"
  },
  {
   "id": 19706,
   "key": "D0907ru.txt:81",
   "file": "D0907ru.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紫電が迸り、一瞬遅れて爆発。",
   "ko_candidate": "자색 번개가 튀고､ 잠시 뒤 폭발｡"
  },
  {
   "id": 19707,
   "key": "D0907ru.txt:82",
   "file": "D0907ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎が、デモンベインの視界を包み込む。",
   "ko_candidate": "폭염이 데몬베인의 시야를 감싼다｡"
  },
  {
   "id": 19708,
   "key": "D0907ru.txt:90",
   "file": "D0907ru.txt",
   "line": 90,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――九郎！」",
   "ko_candidate": "「――쿠로!」"
  },
  {
   "id": 19709,
   "key": "D0907ru.txt:95",
   "file": "D0907ru.txt",
   "line": 95,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「バルザイの偃月刀！」",
   "ko_candidate": "「바르자이의 언월도!」"
  },
  {
   "id": 19710,
   "key": "D0907ru.txt:103",
   "file": "D0907ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎も治まらない内に、バルザイの偃月刀を招喚、扇状に展開する。",
   "ko_candidate": "폭염이 가라앉기도 전에 바르자이의 언월도를 소환해 부채꼴로 펼친다｡"
  },
  {
   "id": 19711,
   "key": "D0907ru.txt:107",
   "file": "D0907ru.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "扇の表面に輝く防禦陣の紋様。",
   "ko_candidate": "부채 표면에 빛나는 방어진의 문양｡"
  },
  {
   "id": 19712,
   "key": "D0907ru.txt:109",
   "file": "D0907ru.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎を裂いて、破壊ビームの光が奔った。",
   "ko_candidate": "폭염을 가르고 파괴 빔의 빛이 달려왔다｡"
  },
  {
   "id": 19713,
   "key": "D0907ru.txt:118",
   "file": "D0907ru.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし光はデモンベインに届かず、偃月刀に払われ霧散する。",
   "ko_candidate": "하지만 빛은 데몬베인에 닿지 않고 언월도에 튕겨져 흩어진다｡"
  },
  {
   "id": 19714,
   "key": "D0907ru.txt:119",
   "file": "D0907ru.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界が晴れる。",
   "ko_candidate": "시야가 맑아진다｡"
  },
  {
   "id": 19715,
   "key": "D0907ru.txt:124",
   "file": "D0907ru.txt",
   "line": 124,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふん……目くらましのつもりか。 機械風情が生意気な」",
   "ko_candidate": "「흥……눈속임을 하려 했나｡ 기계 주제에 건방지군」"
  },
  {
   "id": 19716,
   "key": "D0907ru.txt:135",
   "file": "D0907ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２体の破壊ロボはビルの陰から、続けてビームを連射してくる。",
   "ko_candidate": "2대의 파괴 로봇이 빌딩 그늘에서 계속해서 빔을 연사해 온다｡"
  },
  {
   "id": 19717,
   "key": "D0907ru.txt:140",
   "file": "D0907ru.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雨、雷と放たれる破壊ビームの悉くを、扇を振るって、払い落とす。",
   "ko_candidate": "비､ 번개처럼 쏟아지는 파괴 빔을 모조리 부채를 휘둘러 쳐낸다｡"
  },
  {
   "id": 19718,
   "key": "D0907ru.txt:141",
   "file": "D0907ru.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃の隙を突いて、脚部シールドのエネルギーを開放した。",
   "ko_candidate": "공격의 틈을 타 다리 부분 실드의 에너지를 개방했다｡"
  },
  {
   "id": 19719,
   "key": "D0907ru.txt:147",
   "file": "D0907ru.txt",
   "line": 147,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ティマイオス！　クリティアス！」",
   "ko_candidate": "「티마이오스! 크리티오스!」"
  },
  {
   "id": 19720,
   "key": "D0907ru.txt:152",
   "file": "D0907ru.txt",
   "line": 152,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃ……！」",
   "ko_candidate": "「꺄……!」"
  },
  {
   "id": 19721,
   "key": "D0907ru.txt:160",
   "file": "D0907ru.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームを弾きながら、デモンベインが宙を舞った。",
   "ko_candidate": "빔을 튕겨내며 데몬베인이 공중으로 날아올랐다｡"
  },
  {
   "id": 19722,
   "key": "D0907ru.txt:161",
   "file": "D0907ru.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊ロボの頭上、奥の奴に扇状の偃月刀を投擲する。",
   "ko_candidate": "파괴 로봇의 머리 위､ 뒤쪽 녀석에게 부채꼴의 언월도를 던진다｡"
  },
  {
   "id": 19723,
   "key": "D0907ru.txt:167",
   "file": "D0907ru.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀はブーメランのように弧を回転しながら、破壊ロボの背後に回り込む。",
   "ko_candidate": "언월도는 부메랑처럼 호를 그리며 회전하면서 파괴 로봇의 뒤로 돌아간다｡"
  },
  {
   "id": 19724,
   "key": "D0907ru.txt:170",
   "file": "D0907ru.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀が、遮蔽物であるビルごと破壊ロボを薙ぐ。",
   "ko_candidate": "언월도가 차폐물인 빌딩째로 파괴 로봇을 베어 넘긴다｡"
  },
  {
   "id": 19725,
   "key": "D0907ru.txt:171",
   "file": "D0907ru.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斜めに両断された機体とビル。",
   "ko_candidate": "비스듬히 양단된 기체와 빌딩｡"
  },
  {
   "id": 19726,
   "key": "D0907ru.txt:172",
   "file": "D0907ru.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "切断面に沿って、上半分と下半分がゆっくりとズレる。",
   "ko_candidate": "절단면을 따라 위쪽 반과 아래쪽 반이 천천히 어긋난다｡"
  },
  {
   "id": 19727,
   "key": "D0907ru.txt:180",
   "file": "D0907ru.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "切断面から放電、ビルを巻き込んで爆発する。",
   "ko_candidate": "절단면에서 방전되며 빌딩을 휘감아 폭발한다｡"
  },
  {
   "id": 19728,
   "key": "D0907ru.txt:181",
   "file": "D0907ru.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてもう一体の破壊ロボには――",
   "ko_candidate": "그리고 나머지 한 대의 파괴 로봇에는――"
  },
  {
   "id": 19729,
   "key": "D0907ru.txt:184",
   "file": "D0907ru.txt",
   "line": 184,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アトランティス・ストライク！」",
   "ko_candidate": "「아틀란티스 스트라이크!」"
  },
  {
   "id": 19730,
   "key": "D0907ru.txt:194",
   "file": "D0907ru.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸の如く、降下するデモンベインの蹴りが炸裂した。",
   "ko_candidate": "총알처럼 하강하는 데몬베인의 발차기가 작렬했다｡"
  },
  {
   "id": 19731,
   "key": "D0907ru.txt:195",
   "file": "D0907ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "脚部シールドが帯びた空間反転エネルギーは、インパクトの瞬間、爆砕。破壊ロボを徹底的に蹂躙、粉微塵にした。",
   "ko_candidate": "다리 부분 실드가 띤 공간 반전 에너지는 임팩트의 순간 폭쇄｡ 파괴 로봇을 철저히 유린해 가루로 만들었다｡"
  },
  {
   "id": 19732,
   "key": "D0907ru.txt:200",
   "file": "D0907ru.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大地を震動させつつ、着地。",
   "ko_candidate": "대지를 진동시키며 착지｡"
  },
  {
   "id": 19733,
   "key": "D0907ru.txt:201",
   "file": "D0907ru.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戻ってきた偃月刀を右手でしっかりと掴まえる。",
   "ko_candidate": "돌아온 언월도를 오른손으로 꽉 잡는다｡"
  },
  {
   "id": 19734,
   "key": "D0907ru.txt:203",
   "file": "D0907ru.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３体片付けるのに、３０秒とかからなかった。",
   "ko_candidate": "3대를 처리하는 데 30초도 걸리지 않았다｡"
  },
  {
   "id": 19735,
   "key": "D0907ru.txt:204",
   "file": "D0907ru.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 19736,
   "key": "D0907ru.txt:212",
   "file": "D0907ru.txt",
   "line": 212,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「新手か……！」",
   "ko_candidate": "「새로운 적인가……!」"
  },
  {
   "id": 19737,
   "key": "D0907ru.txt:216",
   "file": "D0907ru.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "優先すべき破壊目標として認識されたか、四方八方より破壊ロボの群れが迫る。",
   "ko_candidate": "우선적으로 파괴해야 할 목표로 인식된 건지､ 사방팔방에서 파괴 로봇 무리가 다가온다｡"
  },
  {
   "id": 19738,
   "key": "D0907ru.txt:216",
   "file": "D0907ru.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……これじゃキリがない！",
   "ko_candidate": "젠장……이래서는 끝이 없어!"
  },
  {
   "id": 19739,
   "key": "D0907ru.txt:225",
   "file": "D0907ru.txt",
   "line": 225,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ウィンフィールド！」",
   "ko_candidate": "「윈필드!」"
  }
 ]
}