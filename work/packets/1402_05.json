 "items": [
  {
   "id": 36696,
   "key": "D1402ru.txt:349",
   "file": "D1402ru.txt",
   "line": 349,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボ――――っ!?」",
   "ko_candidate": "「로봇------!?」"
  },
  {
   "id": 36697,
   "key": "D1402ru.txt:361",
   "file": "D1402ru.txt",
   "line": 361,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああああ――！　もう、さっきから何なんやっ!?」",
   "ko_candidate": "「아아아아--! 도대체､ 아까부터 뭐야!?」"
  },
  {
   "id": 36698,
   "key": "D1402ru.txt:374",
   "file": "D1402ru.txt",
   "line": 374,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これは……」",
   "ko_candidate": "「이건…」"
  },
  {
   "id": 36699,
   "key": "D1402ru.txt:378",
   "file": "D1402ru.txt",
   "line": 378,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何だ!?　何が起こっている!? こんなものは…… 私は知らぬぞ!? ぬおおおおおおお！」",
   "ko_candidate": "「뭐지!? 무슨 일이 일어나고 있는 거지!? 이런 건… 내가 모르는 일이다!? 크오오오오오오오!」"
  },
  {
   "id": 36700,
   "key": "D1402ru.txt:396",
   "file": "D1402ru.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が、爆裂した。",
   "ko_candidate": "빛이 폭발했다｡"
  },
  {
   "id": 36701,
   "key": "D1402ru.txt:397",
   "file": "D1402ru.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはクトゥルーの仕業ではない。",
   "ko_candidate": "그것은 크툴루의 소행이 아니다｡"
  },
  {
   "id": 36702,
   "key": "D1402ru.txt:399",
   "file": "D1402ru.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力の性質が違った。",
   "ko_candidate": "힘의 성질이 달랐다｡"
  },
  {
   "id": 36703,
   "key": "D1402ru.txt:400",
   "file": "D1402ru.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在の指向性が違った。",
   "ko_candidate": "존재의 지향성이 달랐다｡"
  },
  {
   "id": 36704,
   "key": "D1402ru.txt:401",
   "file": "D1402ru.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "現象の波動が違った。",
   "ko_candidate": "현상의 파동이 달랐다｡"
  },
  {
   "id": 36705,
   "key": "D1402ru.txt:403",
   "file": "D1402ru.txt",
   "line": 403,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは――",
   "ko_candidate": "이것은--"
  },
  {
   "id": 36706,
   "key": "D1402ru.txt:405",
   "file": "D1402ru.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界は、極彩色の光に包まれる。",
   "ko_candidate": "세계는 극채색의 빛에 휩싸인다｡"
  },
  {
   "id": 36707,
   "key": "D1402ru.txt:417",
   "file": "D1402ru.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てが終わっても、俺たちはただ呆然としているだけだった。",
   "ko_candidate": "모든 것이 끝나도 우리는 그저 멍하니 있을 뿐이었다｡"
  },
  {
   "id": 36708,
   "key": "D1402ru.txt:418",
   "file": "D1402ru.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心が空っぽで、それ以外のことが出来ないでいた。",
   "ko_candidate": "마음이 텅 비어 그 외의 일은 할 수 없었다｡"
  },
  {
   "id": 36709,
   "key": "D1402ru.txt:420",
   "file": "D1402ru.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんなにも俺たちの精神を占めていた存在を、極彩色の光は根こそぎ奪って行ったのだ。",
   "ko_candidate": "그토록 우리의 정신을 차지하고 있던 존재를 극채색의 빛은 뿌리째 빼앗아 갔다｡"
  },
  {
   "id": 36710,
   "key": "D1402ru.txt:422",
   "file": "D1402ru.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうしたら良いか、判断がつかなかった。",
   "ko_candidate": "어떻게 해야 할지 판단이 서지 않았다｡"
  },
  {
   "id": 36711,
   "key": "D1402ru.txt:432",
   "file": "D1402ru.txt",
   "line": 432,
   "speaker": "マコト（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――その……状況を報告します」",
   "ko_candidate": "「--그… 상황을 보고합니다」"
  },
  {
   "id": 36712,
   "key": "D1402ru.txt:436",
   "file": "D1402ru.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やっとのことで声を絞り出して、マコトさんが告げる。",
   "ko_candidate": "겨우 목소리를 짜내어 마코토 씨가 알린다｡"
  },
  {
   "id": 36713,
   "key": "D1402ru.txt:437",
   "file": "D1402ru.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あまりにも馬鹿げていて、間の抜けた、とんでもない事実を。",
   "ko_candidate": "너무나 어처구니없고 허탈한､ 엄청난 사실을｡"
  },
  {
   "id": 36714,
   "key": "D1402ru.txt:442",
   "file": "D1402ru.txt",
   "line": 442,
   "speaker": "マコト（通信）",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……クトゥルー……消滅しました」",
   "ko_candidate": "「…크툴루… 소멸했습니다」"
  },
  {
   "id": 36715,
   "key": "D1402ru.txt:446",
   "file": "D1402ru.txt",
   "line": 446,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界を圧迫していた威容は一瞬にして、消えて、失せた。",
   "ko_candidate": "세계를 압박하고 있던 위용은 순식간에 사라져버렸다｡"
  },
  {
   "id": 36716,
   "key": "D1402ru.txt:448",
   "file": "D1402ru.txt",
   "line": 448,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も無い。",
   "ko_candidate": "아무것도 없다｡"
  },
  {
   "id": 36717,
   "key": "D1402ru.txt:450",
   "file": "D1402ru.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天上にはただ星空が広がるだけで――地上にはアーカムシティを抉ったクレーターが広がるだけだ。",
   "ko_candidate": "하늘에는 그저 별하늘이 펼쳐져 있을 뿐-- 지상에는 아캄시티를 파낸 분화구가 펼쳐져 있을 뿐이다｡"
  },
  {
   "id": 36718,
   "key": "D1402ru.txt:453",
   "file": "D1402ru.txt",
   "line": 453,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ったく、何だってんだ……ッ！」",
   "ko_candidate": "「…쳇､ 뭐란 말이야…앗!」"
  },
  {
   "id": 36719,
   "key": "D1402ru.txt:462",
   "file": "D1402ru.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "各フロアを繋ぐ地下線路。",
   "ko_candidate": "각 층을 잇는 지하 선로｡"
  },
  {
   "id": 36720,
   "key": "D1402ru.txt:463",
   "file": "D1402ru.txt",
   "line": 463,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "メタトロンとサンダルフォンの決戦場。",
   "ko_candidate": "메타트론과 산달폰의 결전장｡"
  },
  {
   "id": 36721,
   "key": "D1402ru.txt:464",
   "file": "D1402ru.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "基地の端に位置する為に、最も被害の大きい区画となった。",
   "ko_candidate": "기지의 끝에 위치해 있어 가장 피해가 큰 구역이 되었다｡"
  },
  {
   "id": 36722,
   "key": "D1402ru.txt:466",
   "file": "D1402ru.txt",
   "line": 466,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "魔術的な保護をされた建材も、クトゥルーの力の前には紙も同然だった。",
   "ko_candidate": "마술적인 보호를 받은 건축 자재도 크툴루의 힘 앞에서는 종이와 다름없었다｡"
  },
  {
   "id": 36723,
   "key": "D1402ru.txt:468",
   "file": "D1402ru.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地下である筈の場所が、今は地上に曝されている。",
   "ko_candidate": "지하였을 터인 장소가 이제는 지상에 노출되어 있다｡"
  },
  {
   "id": 36724,
   "key": "D1402ru.txt:470",
   "file": "D1402ru.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爆発が抉ったクレーターは、それほどの深度に及び、爆風は其処までメタトロンの躰を舞い上げたのだ。",
   "ko_candidate": "폭발이 파낸 분화구는 그만큼의 깊이에 이르렀고､ 폭풍은 거기까지 메타트론의 몸을 날려 올렸던 것이다｡"
  },
  {
   "id": 36725,
   "key": "D1402ru.txt:472",
   "file": "D1402ru.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砂塵に埋もれて、メタトロンは倒れていた。",
   "ko_candidate": "모래먼지에 파묻혀 메타트론은 쓰러져 있었다｡"
  },
  {
   "id": 36726,
   "key": "D1402ru.txt:473",
   "file": "D1402ru.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "長く、死んだように動かなかった。",
   "ko_candidate": "오랫동안 죽은 듯이 움직이지 않았다｡"
  },
  {
   "id": 36727,
   "key": "D1402ru.txt:475",
   "file": "D1402ru.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "が突如、白い装甲に幾重にも光が疾る。",
   "ko_candidate": "그러다 돌연 하얀 장갑에 여러 겹으로 빛이 달린다｡"
  },
  {
   "id": 36728,
   "key": "D1402ru.txt:477",
   "file": "D1402ru.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が装甲の上に紋様を描き、高速で回転する。",
   "ko_candidate": "빛이 장갑 위에 문양을 그리며 고속으로 회전한다｡"
  },
  {
   "id": 36729,
   "key": "D1402ru.txt:479",
   "file": "D1402ru.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その光は途切れ途切れで、実に弱々しいものだったが。",
   "ko_candidate": "그 빛은 끊어질 듯 끊어질 듯 매우 약한 것이었지만｡"
  },
  {
   "id": 36730,
   "key": "D1402ru.txt:482",
   "file": "D1402ru.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――再起動……",
   "ko_candidate": "--재기동…"
  },
  {
   "id": 36731,
   "key": "D1402ru.txt:483",
   "file": "D1402ru.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――記憶を元に状況を予測……",
   "ko_candidate": "--기억을 바탕으로 상황 예측…"
  },
  {
   "id": 36732,
   "key": "D1402ru.txt:484",
   "file": "D1402ru.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――現在時刻を算出……",
   "ko_candidate": "--현재 시각 산출…"
  },
  {
   "id": 36733,
   "key": "D1402ru.txt:486",
   "file": "D1402ru.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――各種魔術回路を総て『ＲＵＮ』に……エラー発生。再起動。",
   "ko_candidate": "--각종 마술 회로를 모두 『RUN』에… 에러 발생｡ 재기동｡"
  },
  {
   "id": 36734,
   "key": "D1402ru.txt:489",
   "file": "D1402ru.txt",
   "line": 489,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――『ＲＵＮ』……『ＥＲＲＯＲ』……再起動。",
   "ko_candidate": "--『RUN』…『ERROR』… 재기동｡"
  },
  {
   "id": 36735,
   "key": "D1402ru.txt:490",
