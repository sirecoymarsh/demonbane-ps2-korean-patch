 },
 "items": [
  {
   "id": 37005,
   "key": "D1404al.txt:196",
   "file": "D1404al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かあったのか？",
   "ko_candidate": "무슨 일이 있었나?"
  },
  {
   "id": 37006,
   "key": "D1404al.txt:201",
   "file": "D1404al.txt",
   "line": 201,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん？」",
   "ko_candidate": "「쿠로?」"
  },
  {
   "id": 37007,
   "key": "D1404al.txt:205",
   "file": "D1404al.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベッドで寝ていたライカさんが、身体を起こした。",
   "ko_candidate": "침대에 누워 있던 라이카 씨가 몸을 일으켰다｡"
  },
  {
   "id": 37008,
   "key": "D1404al.txt:207",
   "file": "D1404al.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あちこちに包帯を巻いている。",
   "ko_candidate": "여기저기에 붕대를 감고 있다｡"
  },
  {
   "id": 37009,
   "key": "D1404al.txt:210",
   "file": "D1404al.txt",
   "line": 210,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「怪我していたのか……大丈夫なのか、ライカさん？」",
   "ko_candidate": "「다쳤었나… 괜찮아､ 라이카 씨?」"
  },
  {
   "id": 37010,
   "key": "D1404al.txt:215",
   "file": "D1404al.txt",
   "line": 215,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大丈夫、大丈夫。大した怪我じゃないんだから」",
   "ko_candidate": "「괜찮아､ 괜찮아｡ 대단한 부상이 아니니까」"
  },
  {
   "id": 37011,
   "key": "D1404al.txt:218",
   "file": "D1404al.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両手の拳を軽く握り締め、ガッツポーズをとる。",
   "ko_candidate": "양손 주먹을 가볍게 쥐고 파이팅 포즈를 취한다｡"
  },
  {
   "id": 37012,
   "key": "D1404al.txt:219",
   "file": "D1404al.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "健気な姿に、俺の胸が痛む。",
   "ko_candidate": "건강한 모습에 내 가슴이 아파온다｡"
  },
  {
   "id": 37013,
   "key": "D1404al.txt:222",
   "file": "D1404al.txt",
   "line": 222,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「すまない……何も助けられなかった」",
   "ko_candidate": "「미안해… 아무것도 도와주지 못했어」"
  },
  {
   "id": 37014,
   "key": "D1404al.txt:227",
   "file": "D1404al.txt",
   "line": 227,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こらぁ」",
   "ko_candidate": "「이봐」"
  },
  {
   "id": 37015,
   "key": "D1404al.txt:231",
   "file": "D1404al.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は腰に手を当てて、怒った風なジェスチャー。",
   "ko_candidate": "이번엔 허리에 손을 얹고 화난 듯한 제스처｡"
  },
  {
   "id": 37016,
   "key": "D1404al.txt:236",
   "file": "D1404al.txt",
   "line": 236,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何でも自分で抱え込もうとしないっ。みんなだって、自分に出来る範囲で、ちゃんと頑張ってるんだから」 「何でもかんでも背負い込もうとするの、それって大きなお世話ってもんですよっ!?」",
   "ko_candidate": "「뭐든지 혼자서 떠안으려고 하지 마｡ 모두 자기가 할 수 있는 범위에서 열심히 하고 있잖아｡ 뭐든지 다 짊어지려고 하는 건､ 그건 과한 참견이라고!」"
  },
  {
   "id": 37017,
   "key": "D1404al.txt:244",
   "file": "D1404al.txt",
   "line": 244,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「…」"
  },
  {
   "id": 37018,
   "key": "D1404al.txt:249",
   "file": "D1404al.txt",
   "line": 249,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃんは、九郎ちゃんにしか出来ないことをやっているんだから、堂々と、しっかり、それをこなしなさい。ねっ？」",
   "ko_candidate": "「쿠로는 쿠로만이 할 수 있는 일을 하고 있으니까､ 당당하게､ 확실하게､ 그걸 해내세요｡ 알겠죠?」"
  },
  {
   "id": 37019,
   "key": "D1404al.txt:254",
   "file": "D1404al.txt",
   "line": 254,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……そうだな」",
   "ko_candidate": "「…그렇지」"
  },
  {
   "id": 37020,
   "key": "D1404al.txt:256",
   "file": "D1404al.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思わず笑みがこぼれた。",
   "ko_candidate": "저도 모르게 미소가 새어 나왔다｡"
  },
  {
   "id": 37021,
   "key": "D1404al.txt:257",
   "file": "D1404al.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんもにっこりと笑う。",
   "ko_candidate": "라이카 씨도 환하게 웃는다｡"
  },
  {
   "id": 37022,
   "key": "D1404al.txt:261",
   "file": "D1404al.txt",
   "line": 261,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ありがと、ライカさん。ちょいと気が楽になったよ」",
   "ko_candidate": "「고마워､ 라이카 씨｡ 조금 마음이 가벼워졌어」"
  },
  {
   "id": 37023,
   "key": "D1404al.txt:266",
   "file": "D1404al.txt",
   "line": 266,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ん、分かれば、よろしいっ」",
   "ko_candidate": "「…응､ 알았다면 좋아」"
  },
  {
   "id": 37024,
   "key": "D1404al.txt:270",
   "file": "D1404al.txt",
   "line": 270,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はは……」",
   "ko_candidate": "「하하…」"
  },
  {
   "id": 37025,
   "key": "D1404al.txt:275",
   "file": "D1404al.txt",
   "line": 275,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふふ」",
   "ko_candidate": "「후후후」"
  },
  {
   "id": 37026,
   "key": "D1404al.txt:278",
   "file": "D1404al.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、２人で声を上げて笑った。",
   "ko_candidate": "말하고､ 둘이서 소리 내어 웃었다｡"
  },
  {
   "id": 37027,
   "key": "D1404al.txt:280",
   "file": "D1404al.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心なしか、この部屋に入ってきたときにあったギクシャクしたような空気が、多少、和らいでいるような気がする。",
   "ko_candidate": "기분 탓인지､ 이 방에 들어왔을 때 있었던 어색한 듯한 분위기가 다소 누그러진 것 같은 기분이 든다｡"
  },
  {
   "id": 37028,
   "key": "D1404al.txt:283",
   "file": "D1404al.txt",
   "line": 283,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うん……とにかく、みんな無事で良かった。じゃあ、俺は自分の出来ることを、もうちょっとばかし頑張るとするよ」",
   "ko_candidate": "「응… 어쨌든 모두 무사해서 다행이야｡ 그럼､ 난 내가 할 수 있는 일을 조금 더 열심히 하도록 할게」"
  },
  {
   "id": 37029,
   "key": "D1404al.txt:288",
   "file": "D1404al.txt",
   "line": 288,
   "speaker": "ライカ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……九郎ちゃん……その、今の状況はどうなっているの？」 「………………」",
   "ko_candidate": "「…쿠로… 그､ 지금 상황은 어떻게 되고 있어?」"
  },
  {
   "id": 37030,
   "key": "D1404al.txt:294",
   "file": "D1404al.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やはり、そこに触れないはずが無いか。",
   "ko_candidate": "「…」 역시､ 거기에 언급하지 않을 리가 없지｡"
  },
  {
   "id": 37031,
   "key": "D1404al.txt:295",
   "file": "D1404al.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何と答えるべきか、俺は言葉に詰まる。",
   "ko_candidate": "뭐라고 대답해야 할지､ 나는 말문이 막힌다｡"
  },
  {
   "id": 37032,
   "key": "D1404al.txt:297",
   "file": "D1404al.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "代わりにアルが、至極、単刀直入に答えた。",
   "ko_candidate": "대신 알이 지극히 단도직입적으로 대답했다｡"
  },
  {
   "id": 37033,
   "key": "D1404al.txt:302",
   "file": "D1404al.txt",
   "line": 302,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「邪神との――『ブラックロッジ』との最終決戦だ。今度の戦いで、総てが決する」",
   "ko_candidate": "「사신과의――『블랙로지』와의 최종 결전이다｡ 이번 싸움으로 모든 것이 결정된다」"
  },
  {
   "id": 37034,
   "key": "D1404al.txt:306",
   "file": "D1404al.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "単刀直入で単純明快がゆえに、有無を言わせぬ迫力があった。",
   "ko_candidate": "단도직입적이고 단순명쾌하기에､ 거부할 수 없는 박력이 있었다｡"
  },
  {
   "id": 37035,
   "key": "D1404al.txt:307",
   "file": "D1404al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ガキんちょどもが、不安そうな瞳で俺を見上げている。",
   "ko_candidate": "꼬마들이 불안한 눈동자로 나를 올려다보고 있다｡"
  },
  {
   "id": 37036,
   "key": "D1404al.txt:312",
   "file": "D1404al.txt",
   "line": 312,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎……勝つよね？」",
   "ko_candidate": "「쿠로… 이길 거지?」"
  },
  {
   "id": 37037,
   "key": "D1404al.txt:316",
   "file": "D1404al.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝てるか？",
   "ko_candidate": "이길 수 있을까?"
  },
  {
   "id": 37038,
   "key": "D1404al.txt:317",
   "file": "D1404al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥルーに。旧支配者に。邪神に。",
   "ko_candidate": "크툴루를｡ 구지배자를｡ 사신을｡"
  },
  {
   "id": 37039,
   "key": "D1404al.txt:319",
   "file": "D1404al.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……答えは簡単だ。考えるまでもない。",
   "ko_candidate": "…대답은 간단하다｡ 생각할 필요도 없다｡"
  },
  {
   "id": 37040,
   "key": "D1404al.txt:321",
   "file": "D1404al.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝てなきゃ終わりなんだ。",
   "ko_candidate": "이기지 못하면 끝이다｡"
  },
  {
   "id": 37041,
   "key": "D1404al.txt:322",
   "file": "D1404al.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "じゃあ、勝つしかないだろう。",
   "ko_candidate": "그럼､ 이길 수밖에 없잖아｡"
  },
  {
   "id": 37042,
   "key": "D1404al.txt:325",
   "file": "D1404al.txt",
   "line": 325,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あんな蛸の化け物、切り刻んで食卓に並べてやるよ」",
   "ko_candidate": "「저런 문어 괴물､ 토막 내서 식탁에 올려줄게」"
  },
  {
   "id": 37043,
   "key": "D1404al.txt:330",
   "file": "D1404al.txt",
   "line": 330,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「絶対……だよな？」",
   "ko_candidate": "「절대… 맞지?」"
  },
  {
   "id": 37044,
   "key": "D1404al.txt:334",
   "file": "D1404al.txt",
   "line": 334,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……絶対でなきゃならんだろう。まったく厄介な名前のロボットを引き受けちまったよ」",
   "ko_candidate": "「응… 절대여야만 하겠지｡ 정말 귀찮은 이름의 로봇을 맡아버렸어」"
  }
 ]
}