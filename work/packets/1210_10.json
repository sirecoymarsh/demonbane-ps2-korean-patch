   "line": 780,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……げ、なさい」",
   "ko_candidate": "「……도､ 망가」"
  },
  {
   "id": 29379,
   "key": "D1210le.txt:785",
   "file": "D1210le.txt",
   "line": 785,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカ姉ちゃん！」",
   "ko_candidate": "「라이카 누나!」"
  },
  {
   "id": 29380,
   "key": "D1210le.txt:788",
   "file": "D1210le.txt",
   "line": 788,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気絶していたはずのライカが、子ども達の耳元で呟いた。",
   "ko_candidate": "기절했을 터인 라이카가 아이들의 귓가에 속삭였다｡"
  },
  {
   "id": 29381,
   "key": "D1210le.txt:789",
   "file": "D1210le.txt",
   "line": 789,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "涙に濡れた子ども達の顔が明るくなる。",
   "ko_candidate": "눈물에 젖은 아이들의 얼굴이 밝아진다｡"
  },
  {
   "id": 29382,
   "key": "D1210le.txt:790",
   "file": "D1210le.txt",
   "line": 790,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかしライカは、絞り出すような声で告げる。",
   "ko_candidate": "하지만 라이카는 짜내는 듯한 목소리로 말한다｡"
  },
  {
   "id": 29383,
   "key": "D1210le.txt:795",
   "file": "D1210le.txt",
   "line": 795,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「私を置いて……逃げ、なさい……っ」",
   "ko_candidate": "「나를 두고…… 도망､ 가……」"
  },
  {
   "id": 29384,
   "key": "D1210le.txt:800",
   "file": "D1210le.txt",
   "line": 800,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、そんなっ！」",
   "ko_candidate": "「그､ 그럴 순 없어!」"
  },
  {
   "id": 29385,
   "key": "D1210le.txt:803",
   "file": "D1210le.txt",
   "line": 803,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "子ども達を跳ね除け、立ち上がろうとするライカ。",
   "ko_candidate": "아이들을 밀어내고 일어나려는 라이카｡"
  },
  {
   "id": 29386,
   "key": "D1210le.txt:804",
   "file": "D1210le.txt",
   "line": 804,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが力が入らなかった。",
   "ko_candidate": "하지만 힘이 들어가지 않았다｡"
  },
  {
   "id": 29387,
   "key": "D1210le.txt:806",
   "file": "D1210le.txt",
   "line": 806,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "子ども達はライカに縋りつき、離れない。",
   "ko_candidate": "아이들은 라이카에게 매달려 떨어지지 않는다｡"
  },
  {
   "id": 29388,
   "key": "D1210le.txt:807",
   "file": "D1210le.txt",
   "line": 807,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなライカ達を尻目に、サンダルフォンはティベリウスに冷たく告げる。",
   "ko_candidate": "그런 라이카 일행을 뒤로하고 산달폰은 티베리우스에게 차갑게 말한다｡"
  },
  {
   "id": 29389,
   "key": "D1210le.txt:812",
   "file": "D1210le.txt",
   "line": 812,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「貴様の手を借りる必要など、何も無い。 黙って、失せろ」",
   "ko_candidate": "「네 놈의 손을 빌릴 필요 따위는 전혀 없다｡ 조용히 꺼져라」"
  },
  {
   "id": 29390,
   "key": "D1210le.txt:817",
   "file": "D1210le.txt",
   "line": 817,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あらあらーん、冷たい態度っ。アタシ、寂しいわぁ～ん。 でも……相当、やられているように見えるけど？」",
   "ko_candidate": "「어머어머､ 차가운 태도네｡ 난 외롭다구~｡ 하지만…… 상당히 당한 것 같은데?」"
  },
  {
   "id": 29391,
   "key": "D1210le.txt:821",
   "file": "D1210le.txt",
   "line": 821,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの全身に大きく刻まれた十字の痕をねめつけ、嗤うティベリウス。",
   "ko_candidate": "산달폰의 전신에 크게 새겨진 십자의 흔적을 훑어보며 비웃는 티베리우스｡"
  },
  {
   "id": 29392,
   "key": "D1210le.txt:822",
   "file": "D1210le.txt",
   "line": 822,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがサンダルフォンは意ともしない。",
   "ko_candidate": "하지만 산달폰은 개의치 않는다｡"
  },
  {
   "id": 29393,
   "key": "D1210le.txt:827",
   "file": "D1210le.txt",
   "line": 827,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「自然治癒と自己修復の範囲内だ」",
   "ko_candidate": "「자연 치유와 자기 수복의 범위 내다」"
  },
  {
   "id": 29394,
   "key": "D1210le.txt:830",
   "file": "D1210le.txt",
   "line": 830,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かに言っている端から、十字の傷は塞がっていく。",
   "ko_candidate": "확실히 말하는 사이에 십자의 상처는 아물어 간다｡"
  },
  {
   "id": 29395,
   "key": "D1210le.txt:831",
   "file": "D1210le.txt",
   "line": 831,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焼き爛れた醜い紅は瘡蓋となって剥がれ落ち、その上を鱗状に再生する黒の装甲が覆っていく。",
   "ko_candidate": "불에 타 문드러진 추한 붉은 색은 딱지가 되어 떨어져 나가고､ 그 위를 비늘 모양으로 재생하는 검은 장갑이 덮어간다｡"
  },
  {
   "id": 29396,
   "key": "D1210le.txt:834",
   "file": "D1210le.txt",
   "line": 834,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがティベリウスはなおも嗤ったままで",
   "ko_candidate": "하지만 티베리우스는 여전히 비웃으며"
  },
  {
   "id": 29397,
   "key": "D1210le.txt:838",
   "file": "D1210le.txt",
   "line": 838,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「またまたー。ホントはシンドイでしょ？　助けてほしいでしょ？」 「遠慮することなんてないわよーん。アタシとサンダルフォンちゃんの仲じゃなーい」",
   "ko_candidate": "「또또｡ 사실은 힘들죠? 도와주길 바라죠? 사양할 필요 없어요｡ 나와 산달폰은 친구잖아」"
  },
  {
   "id": 29398,
   "key": "D1210le.txt:846",
   "file": "D1210le.txt",
   "line": 846,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くどい！　これは己とメタトロンとの戦いだ！　アンチクロスと言えども、出る幕など無いッ！」",
   "ko_candidate": "「시끄럽다! 이건 나와 메타트론과의 싸움이다! 안티 크로스라고는 해도 끼어들 자리는 없다!」"
  },
  {
   "id": 29399,
   "key": "D1210le.txt:850",
   "file": "D1210le.txt",
   "line": 850,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……そうもいかないのよ」",
   "ko_candidate": "「……그렇게 되지 않을 거야」"
  },
  {
   "id": 29400,
   "key": "D1210le.txt:855",
   "file": "D1210le.txt",
   "line": 855,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何？」",
   "ko_candidate": "「뭐?」"
  },
  {
   "id": 29401,
   "key": "D1210le.txt:865",
   "file": "D1210le.txt",
   "line": 865,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――肉の鞭が踊った。",
   "ko_candidate": "――살로 된 채찍이 춤을 췄다｡"
  },
  {
   "id": 29402,
   "key": "D1210le.txt:876",
   "file": "D1210le.txt",
   "line": 876,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「が……っ！」",
   "ko_candidate": "「크……!」"
  },
  {
   "id": 29403,
   "key": "D1210le.txt:881",
   "file": "D1210le.txt",
   "line": 881,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……！」",
   "ko_candidate": "「뭐……!」"
  },
  {
   "id": 29404,
   "key": "D1210le.txt:884",
   "file": "D1210le.txt",
   "line": 884,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの腹を割いて、現れた肉の鞭。その先端には黒光りする血塗れの鎌が握られていた。",
   "ko_candidate": "티베리우스의 배를 가르고 나타난 살로 된 채찍｡ 그 끝에는 검게 빛나는 피 묻은 낫이 쥐어져 있었다｡"
  },
  {
   "id": 29405,
   "key": "D1210le.txt:885",
   "file": "D1210le.txt",
   "line": 885,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンの背中に、深く深く突き刺さる。",
   "ko_candidate": "산달폰의 등에 깊이 깊이 꽂힌다｡"
  },
  {
   "id": 29406,
   "key": "D1210le.txt:890",
   "file": "D1210le.txt",
   "line": 890,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何の……真似だ……ティベリウス……ッ！」",
   "ko_candidate": "「무슨…… 짓이냐…… 티베리우스……!」"
  },
  {
   "id": 29407,
   "key": "D1210le.txt:893",
   "file": "D1210le.txt",
   "line": 893,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血を吐きながら、サンダルフォンは吼えた。",
   "ko_candidate": "피를 토하며 산달폰이 포효했다｡"
  },
  {
   "id": 29408,
   "key": "D1210le.txt:895",
   "file": "D1210le.txt",
   "line": 895,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "フードの中でティベリウスの仮面が目まぐるしく回転する。",
   "ko_candidate": "후드 안에서 티베리우스의 가면이 눈부시게 회전한다｡"
  },
  {
   "id": 29409,
   "key": "D1210le.txt:896",
   "file": "D1210le.txt",
   "line": 896,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怒り、悲しみ、驚き――様々な表情を百面相の如く切り替える。",
   "ko_candidate": "분노､ 슬픔､ 놀라움―― 다양한 표정을 백면상처럼 바꾼다｡"
  },
  {
   "id": 29410,
   "key": "D1210le.txt:901",
   "file": "D1210le.txt",
   "line": 901,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「残念だけどぉー、サンダルフォンちゃんにメタトロンを殺させるワケにはいかなくなったのん。メタトロンはアタシが戴いていくわ」",
   "ko_candidate": "「유감이지만､ 산달폰에게 메타트론을 죽이게 할 수는 없게 됐어｡ 메타트론은 내가 받아가겠어」"
  },
  {
   "id": 29411,
   "key": "D1210le.txt:906",
   "file": "D1210le.txt",
   "line": 906,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な……何、だと……っ」",
   "ko_candidate": "「뭐…… 라고……」"
  },
  {
   "id": 29412,
   "key": "D1210le.txt:911",
   "file": "D1210le.txt",
   "line": 911,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「詳しいことを知る必要はないわよん。どうせアンタはここで処分されちゃうんだから」 「じゃね。おやすみなさぁい、坊や……チュ♪」",
   "ko_candidate": "「자세한 건 알 필요 없어｡ 어차피 너는 여기서 처분될 테니까｡ 통제가 안 되는 미친개를 키워둘 만큼 우리에겐 여유가 없다는 거지｡ 그럼｡ 잘 자､ 꼬마야…… 쪽♪」"
  },
  {
   "id": 29413,
   "key": "D1210le.txt:933",
   "file": "D1210le.txt",
   "line": 933,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "十数本の鞭が同時に踊った。",
   "ko_candidate": "십여 개의 채찍이 동시에 춤을 췄다｡"
  },
  {
   "id": 29414,
   "key": "D1210le.txt:936",
   "file": "D1210le.txt",
   "line": 936,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンの全身に、鎌が突き刺さる。",
   "ko_candidate": "산달폰의 전신에 낫이 꽂힌다｡"
  },
  {
   "id": 29415,
   "key": "D1210le.txt:937",
   "file": "D1210le.txt",
   "line": 937,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "躰が傾ぐ。",
   "ko_candidate": "몸이 기운다｡"
  },
  {
   "id": 29416,
   "key": "D1210le.txt:939",
   "file": "D1210le.txt",
   "line": 939,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "四肢が力を失うものの、躰に突き刺さった鎌を持つ肉の鞭に吊るされて、斃れる事が出来ない。",
   "ko_candidate": "사지에 힘이 빠지지만､ 몸에 꽂힌 낫을 가진 살로 된 채찍에 매달려 쓰러질 수가 없다｡"
  },
  {
   "id": 29417,
   "key": "D1210le.txt:945",
   "file": "D1210le.txt",
   "line": 945,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「がばっ……ぐふぅあ……！」",
   "ko_candidate": "「크아……크흐아……!」"
  }
 ]
}