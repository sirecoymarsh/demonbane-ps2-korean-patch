 "items": [
  {
   "id": 26176,
   "key": "D1111ru.txt:287",
   "file": "D1111ru.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同時に咆吼。",
   "ko_candidate": "동시에 포효｡"
  },
  {
   "id": 26177,
   "key": "D1111ru.txt:289",
   "file": "D1111ru.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右掌に組み込まれた機関が高速で回転し、一撃必滅の法則を与えられた術式が、回路を駆け巡る。",
   "ko_candidate": "오른손바닥에 내장된 기관이 고속으로 회전하며 일격필살의 법칙이 부여된 방식이 회로를 질주한다｡"
  },
  {
   "id": 26178,
   "key": "D1111ru.txt:291",
   "file": "D1111ru.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一切の闇を払う閃光を右掌に纏わせ ――デモンベインは奔った！",
   "ko_candidate": "모든 어둠을 몰아내는 섬광을 오른손바닥에 두르고―― 데몬베인은 질주했다!"
  },
  {
   "id": 26179,
   "key": "D1111ru.txt:300",
   "file": "D1111ru.txt",
   "line": 300,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うわああああああああああああああああああ――――ッ！」",
   "ko_candidate": "「우와아아아아아아아아아아아아아아아아아――――!」"
  },
  {
   "id": 26180,
   "key": "D1111ru.txt:305",
   "file": "D1111ru.txt",
   "line": 305,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 26181,
   "key": "D1111ru.txt:309",
   "file": "D1111ru.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラーケンを牽制していたメタトロンが、 急速離脱する。",
   "ko_candidate": "크라켄을 견제하고 있던 메타트론이 급속히 이탈한다｡"
  },
  {
   "id": 26182,
   "key": "D1111ru.txt:314",
   "file": "D1111ru.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なおも暴れるクラーケン。",
   "ko_candidate": "여전히 날뛰는 크라켄｡"
  },
  {
   "id": 26183,
   "key": "D1111ru.txt:316",
   "file": "D1111ru.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両腕が再び、鋼鉄の大蛇と化す。",
   "ko_candidate": "양팔이 다시 강철의 큰 뱀으로 변한다｡"
  },
  {
   "id": 26184,
   "key": "D1111ru.txt:318",
   "file": "D1111ru.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数百メートルに及ぶその両腕を、まるで鞭の様に振り下ろした。",
   "ko_candidate": "수백 미터에 달하는 그 양팔을 마치 채찍처럼 내리쳤다｡"
  },
  {
   "id": 26185,
   "key": "D1111ru.txt:327",
   "file": "D1111ru.txt",
   "line": 327,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お嬢様！」",
   "ko_candidate": "「아가씨!」"
  },
  {
   "id": 26186,
   "key": "D1111ru.txt:338",
   "file": "D1111ru.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大爆音。",
   "ko_candidate": "큰 폭음｡"
  },
  {
   "id": 26187,
   "key": "D1111ru.txt:340",
   "file": "D1111ru.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "踏み潰されたビルが瓦礫になって舞い上がり、大地に２本の亀裂が走った。",
   "ko_candidate": "짓밟힌 빌딩이 잔해가 되어 날아오르고 대지에 두 줄의 균열이 생겼다｡"
  },
  {
   "id": 26188,
   "key": "D1111ru.txt:342",
   "file": "D1111ru.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地割れに呑み込まれていく街並み。",
   "ko_candidate": "갈라진 틈에 삼켜지는 거리 풍경｡"
  },
  {
   "id": 26189,
   "key": "D1111ru.txt:344",
   "file": "D1111ru.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、そこにデモンベインの姿は無かった。",
   "ko_candidate": "하지만 그곳에 데몬베인의 모습은 없었다｡"
  },
  {
   "id": 26190,
   "key": "D1111ru.txt:360",
   "file": "D1111ru.txt",
   "line": 360,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「光射す世界に、汝ら闇黒、棲まう場所無し！ 渇かず飢えず、無に還れ――！」",
   "ko_candidate": "「빛이 비추는 세계에 너희 어둠이 머물 곳은 없다! 목마르지도 배고프지도 않으니 무로 돌아가라――!」"
  },
  {
   "id": 26191,
   "key": "D1111ru.txt:373",
   "file": "D1111ru.txt",
   "line": 373,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐるゥアアああっ!?」",
   "ko_candidate": "「그르아아아아!?」"
  },
  {
   "id": 26192,
   "key": "D1111ru.txt:377",
   "file": "D1111ru.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空。",
   "ko_candidate": "상공｡"
  },
  {
   "id": 26193,
   "key": "D1111ru.txt:378",
   "file": "D1111ru.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪神の威容が落とす陰に、燦々と輝く光。",
   "ko_candidate": "사신의 위용이 드리우는 그림자에 찬란히 빛나는 광채｡"
  },
  {
   "id": 26194,
   "key": "D1111ru.txt:380",
   "file": "D1111ru.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "レムリア・インパクトの閃りを纏って、デモンベインは飛翔していた。",
   "ko_candidate": "레무리아 임팩트의 섬광을 두르고 데몬베인은 비상하고 있었다｡"
  },
  {
   "id": 26195,
   "key": "D1111ru.txt:382",
   "file": "D1111ru.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚部シールドのエネルギーを解放。",
   "ko_candidate": "다리 부분 실드의 에너지를 해방｡"
  },
  {
   "id": 26196,
   "key": "D1111ru.txt:384",
   "file": "D1111ru.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空を蹴り、まるで弾丸の如く、デモンベインは突貫する！",
   "ko_candidate": "하늘을 박차고 마치 총알처럼 데몬베인은 돌격한다!"
  },
  {
   "id": 26197,
   "key": "D1111ru.txt:391",
   "file": "D1111ru.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "明るみ始めた東の空から、朝陽が昇る。",
   "ko_candidate": "밝아지기 시작한 동쪽 하늘에서 아침 해가 떠오른다｡"
  },
  {
   "id": 26198,
   "key": "D1111ru.txt:393",
   "file": "D1111ru.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊の光を纏い、空を翔けるデモンベインを、朝陽の光が染める。",
   "ko_candidate": "파괴의 빛을 두르고 하늘을 날아가는 데몬베인을 아침 햇살이 물들인다｡"
  },
  {
   "id": 26199,
   "key": "D1111ru.txt:395",
   "file": "D1111ru.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの聖なる光が、クラーケンのサブモニターをも灼き尽くし、カリグラから完全に視界を奪った。",
   "ko_candidate": "두 개의 성스러운 빛이 크라켄의 서브 모니터마저 태워버리고 칼리굴라에게서 완전히 시야를 빼앗았다｡"
  },
  {
   "id": 26200,
   "key": "D1111ru.txt:403",
   "file": "D1111ru.txt",
   "line": 403,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヤベェ……逃げろォォォォォ！　カリグラァァァァァ！」",
   "ko_candidate": "「큰일이다… 도망쳐어어어어! 칼리굴라아아아아아!」"
  },
  {
   "id": 26201,
   "key": "D1111ru.txt:412",
   "file": "D1111ru.txt",
   "line": 412,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「う……オオオオオオオオオオオオォォォォォォォォォ！」",
   "ko_candidate": "「으… 오오오오오오오오오오오오오오오오오오오오!」"
  },
  {
   "id": 26202,
   "key": "D1111ru.txt:416",
   "file": "D1111ru.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラの雄叫びは怒りの咆吼か、それとも恐怖の絶叫か。",
   "ko_candidate": "칼리굴라의 외침은 분노의 포효인가､ 아니면 공포의 절규인가｡"
  },
  {
   "id": 26203,
   "key": "D1111ru.txt:418",
   "file": "D1111ru.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舞い降りたデモンベインの右掌が吸い込まれる様に、クラーケンの胸部へと突き立てられる。",
   "ko_candidate": "내려온 데몬베인의 오른손바닥이 빨려 들어가듯이 크라켄의 가슴 부위에 꽂혀들어간다｡"
  },
  {
   "id": 26204,
   "key": "D1111ru.txt:426",
   "file": "D1111ru.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必滅の術式を、クラーケンの中枢へと流し込む。",
   "ko_candidate": "필멸의 술식을 크라켄의 중추로 흘려보낸다｡"
  },
  {
   "id": 26205,
   "key": "D1111ru.txt:428",
   "file": "D1111ru.txt",
   "line": 428,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限熱量を閉じ込めた破滅の毒は速やかに機体を侵し――",
   "ko_candidate": "무한 열량을 가둔 파멸의 독은 신속하게 기체를 침식하고――"
  },
  {
   "id": 26206,
   "key": "D1111ru.txt:433",
   "file": "D1111ru.txt",
   "line": 433,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――昇華！」",
   "ko_candidate": "「――승화!」"
  },
  {
   "id": 26207,
   "key": "D1111ru.txt:440",
   "file": "D1111ru.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "内部にて、解き放たれた。",
   "ko_candidate": "내부에서 풀려났다｡"
  },
  {
   "id": 26208,
   "key": "D1111ru.txt:441",
   "file": "D1111ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界に２つ目の太陽が昇った。",
   "ko_candidate": "세계에 두 번째 태양이 떠올랐다｡"
  },
  {
   "id": 26209,
   "key": "D1111ru.txt:442",
   "file": "D1111ru.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限熱量の太陽はクラーケンを呑み込む。",
   "ko_candidate": "무한 열량의 태양이 크라켄을 삼켜버린다｡"
  },
  {
   "id": 26210,
   "key": "D1111ru.txt:447",
   "file": "D1111ru.txt",
   "line": 447,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「―――――――――――――！」",
   "ko_candidate": "「――――――――――――――――!」"
  },
  {
   "id": 26211,
   "key": "D1111ru.txt:452",
   "file": "D1111ru.txt",
   "line": 452,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もはや、断末魔すら届かない。",
   "ko_candidate": "이제 단말마조차 들리지 않는다｡"
  },
  {
   "id": 26212,
   "key": "D1111ru.txt:453",
   "file": "D1111ru.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てを灼き尽くし、総てを昇滅させる。",
   "ko_candidate": "모든 것을 태워 없애고､ 모든 것을 승화시킨다｡"
  },
  {
   "id": 26213,
   "key": "D1111ru.txt:454",
   "file": "D1111ru.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在そのものを、否定し尽くすかの如く――",
   "ko_candidate": "존재 그 자체를 부정하려는 듯이――"
  },
  {
   "id": 26214,
   "key": "D1111ru.txt:461",
   "file": "D1111ru.txt",
   "line": 461,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「カリグラァァァァァァァァァァァァァァ――――――ッッッッ！」",
   "ko_candidate": "「칼리굴라아아아아아아아아아아 아아아아아――――――앗!」"
  }
 ]
}