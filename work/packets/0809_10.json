 "items": [
  {
   "id": 14742,
   "key": "D0809al.txt:1834",
   "file": "D0809al.txt",
   "line": 1834,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右手の甲に焼きごてを当てられたような痛みを感じ、左手の甲からは急速に体温が奪われていく。",
   "ko_candidate": "오른손 등에 화인을 찍힌 것 같은 통증을 느끼고､ 왼손 등에서는 급속도로 체온이 빼앗기고 있다｡"
  },
  {
   "id": 14743,
   "key": "D0809al.txt:1835",
   "file": "D0809al.txt",
   "line": 1835,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こ、これは……！",
   "ko_candidate": "이､ 이건……!"
  },
  {
   "id": 14744,
   "key": "D0809al.txt:1840",
   "file": "D0809al.txt",
   "line": 1840,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――!? 九郎……紋様が……！」",
   "ko_candidate": "「――!? 쿠로……문양이……!」"
  },
  {
   "id": 14745,
   "key": "D0809al.txt:1846",
   "file": "D0809al.txt",
   "line": 1846,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ!?」",
   "ko_candidate": "「…………!?」"
  },
  {
   "id": 14746,
   "key": "D0809al.txt:1848",
   "file": "D0809al.txt",
   "line": 1848,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『火』と『風』の魔術紋様。",
   "ko_candidate": "『불』과 『바람』의 마술 문양｡"
  },
  {
   "id": 14747,
   "key": "D0809al.txt:1849",
   "file": "D0809al.txt",
   "line": 1849,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "前にクトゥグアとイタクァによって付けられた刻印だ。",
   "ko_candidate": "전에 크투가와 이타콰에 의해 새겨진 각인이다｡"
  },
  {
   "id": 14748,
   "key": "D0809al.txt:1850",
   "file": "D0809al.txt",
   "line": 1850,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの刻印が、それぞれ、眩い光を発している。",
   "ko_candidate": "두 개의 각인이､ 각각､ 눈부신 빛을 발하고 있다｡"
  },
  {
   "id": 14749,
   "key": "D0809al.txt:1852",
   "file": "D0809al.txt",
   "line": 1852,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアの紋様は紅く、紅く、血のように紅く燃えるように。",
   "ko_candidate": "크투가의 문양은 붉게､ 붉게､ 피처럼 붉게 타오르듯이｡"
  },
  {
   "id": 14750,
   "key": "D0809al.txt:1853",
   "file": "D0809al.txt",
   "line": 1853,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "イタクァの紋様は、冷たく、鋭く、清廉な光を。",
   "ko_candidate": "이타콰의 문양은､ 차갑게､ 날카롭게､ 청렴한 빛을｡"
  },
  {
   "id": 14751,
   "key": "D0809al.txt:1855",
   "file": "D0809al.txt",
   "line": 1855,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力の風が吹いた。",
   "ko_candidate": "마력의 바람이 불었다｡"
  },
  {
   "id": 14752,
   "key": "D0809al.txt:1856",
   "file": "D0809al.txt",
   "line": 1856,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舞い散る魔導書のページが、輝く刻印に吸い寄せられていく。",
   "ko_candidate": "흩날리는 마도서의 페이지가､ 빛나는 각인에 빨려들어가고 있다｡"
  },
  {
   "id": 14753,
   "key": "D0809al.txt:1857",
   "file": "D0809al.txt",
   "line": 1857,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ページは、俺の両手の周りをぐるぐると、幾重にも囲んで、竜巻のように回転する。",
   "ko_candidate": "페이지는､ 내 양손 주위를 빙글빙글､ 여러 겹으로 둘러싸고､ 회오리바람처럼 회전한다｡"
  },
  {
   "id": 14754,
   "key": "D0809al.txt:1863",
   "file": "D0809al.txt",
   "line": 1863,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "回転が速まる。",
   "ko_candidate": "회전이 빨라진다｡"
  },
  {
   "id": 14755,
   "key": "D0809al.txt:1864",
   "file": "D0809al.txt",
   "line": 1864,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜巻の回転速度に耐え切れない紙片がどんどん崩れてゆく。",
   "ko_candidate": "회오리바람의 회전 속도를 견디지 못하는 종이 조각이 점점 부서져 간다｡"
  },
  {
   "id": 14756,
   "key": "D0809al.txt:1865",
   "file": "D0809al.txt",
   "line": 1865,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "千切れる紙片から魔術文字だけが飛び出した。",
   "ko_candidate": "찢어지는 종이 조각에서 마술 문자만이 튀어나왔다｡"
  },
  {
   "id": 14757,
   "key": "D0809al.txt:1870",
   "file": "D0809al.txt",
   "line": 1870,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幾千幾万行もの魔術文字は互いに連なり、螺旋を描き、輝きを増す。",
   "ko_candidate": "수천 수만 행의 마술 문자는 서로 이어져､ 나선을 그리며､ 빛을 더해간다｡"
  },
  {
   "id": 14758,
   "key": "D0809al.txt:1876",
   "file": "D0809al.txt",
   "line": 1876,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刻印の輝きと、魔術文字の輝き。",
   "ko_candidate": "각인의 빛과 마술 문자의 빛｡"
  },
  {
   "id": 14759,
   "key": "D0809al.txt:1877",
   "file": "D0809al.txt",
   "line": 1877,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの輝きは眩い閃光となって、世界を灼く――！",
   "ko_candidate": "두 개의 빛은 눈부신 섬광이 되어 세계를 태운다――!"
  },
  {
   "id": 14760,
   "key": "D0809al.txt:1882",
   "file": "D0809al.txt",
   "line": 1882,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――!?」",
   "ko_candidate": "「――――――!?」"
  },
  {
   "id": 14761,
   "key": "D0809al.txt:1887",
   "file": "D0809al.txt",
   "line": 1887,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――ッ！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 14762,
   "key": "D0809al.txt:1896",
   "file": "D0809al.txt",
   "line": 1896,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光の中に、俺は見た。",
   "ko_candidate": "섬광 속에서 나는 보았다｡"
  },
  {
   "id": 14763,
   "key": "D0809al.txt:1897",
   "file": "D0809al.txt",
   "line": 1897,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宙に浮く、強烈な魔力を放つ、２つの存在。",
   "ko_candidate": "공중에 떠 있는､ 강렬한 마력을 발산하는 두 개의 존재｡"
  },
  {
   "id": 14764,
   "key": "D0809al.txt:1901",
   "file": "D0809al.txt",
   "line": 1901,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眩し過ぎて、それが何であるか理解は出来なかった。",
   "ko_candidate": "너무 눈부셔서 그것이 무엇인지 이해할 수 없었다｡"
  },
  {
   "id": 14765,
   "key": "D0809al.txt:1902",
   "file": "D0809al.txt",
   "line": 1902,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが本能めいた衝動に駆られて、俺はその２つに手を伸ばす。",
   "ko_candidate": "하지만 본능적인 충동에 이끌려 나는 그 두 개에 손을 뻗는다｡"
  },
  {
   "id": 14766,
   "key": "D0809al.txt:1903",
   "file": "D0809al.txt",
   "line": 1903,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "指先が触れる。",
   "ko_candidate": "손끝이 닿는다｡"
  },
  {
   "id": 14767,
   "key": "D0809al.txt:1905",
   "file": "D0809al.txt",
   "line": 1905,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞬間。",
   "ko_candidate": "그 순간｡"
  },
  {
   "id": 14768,
   "key": "D0809al.txt:1906",
   "file": "D0809al.txt",
   "line": 1906,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の脳を光の速度で、高密度の情報が駆け巡った。",
   "ko_candidate": "내 뇌를 빛의 속도로 고밀도의 정보가 휘몰아쳤다｡"
  },
  {
   "id": 14769,
   "key": "D0809al.txt:1908",
   "file": "D0809al.txt",
   "line": 1908,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞬間。",
   "ko_candidate": "그 순간｡"
  },
  {
   "id": 14770,
   "key": "D0809al.txt:1909",
   "file": "D0809al.txt",
   "line": 1909,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は思考するより迅く、動き出していた。",
   "ko_candidate": "나는 생각하기보다 빠르게 움직이기 시작했다｡"
  },
  {
   "id": 14771,
   "key": "D0809al.txt:1915",
   "file": "D0809al.txt",
   "line": 1915,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "グリップをしっかりと握った。",
   "ko_candidate": "그립을 단단히 잡았다｡"
  },
  {
   "id": 14772,
   "key": "D0809al.txt:1916",
   "file": "D0809al.txt",
   "line": 1916,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心強い重量感が両手に圧し掛かる。",
   "ko_candidate": "든든한 무게감이 양손에 실린다｡"
  },
  {
   "id": 14773,
   "key": "D0809al.txt:1917",
   "file": "D0809al.txt",
   "line": 1917,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "電流のように体内に流れ込む強力な魔力も。",
   "ko_candidate": "전류처럼 체내로 흘러들어오는 강력한 마력도｡"
  },
  {
   "id": 14774,
   "key": "D0809al.txt:1919",
   "file": "D0809al.txt",
   "line": 1919,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トリガーに指を添える。",
   "ko_candidate": "방아쇠에 손가락을 얹는다｡"
  },
  {
   "id": 14775,
   "key": "D0809al.txt:1920",
   "file": "D0809al.txt",
   "line": 1920,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界は閃光に灼かれ、何も見えない。",
   "ko_candidate": "시야는 섬광에 타버려 아무것도 보이지 않는다｡"
  },
  {
   "id": 14776,
   "key": "D0809al.txt:1921",
   "file": "D0809al.txt",
   "line": 1921,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、気配だけで知る。",
   "ko_candidate": "하지만 기척만으로 안다｡"
  },
  {
   "id": 14777,
   "key": "D0809al.txt:1926",
   "file": "D0809al.txt",
   "line": 1926,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右を、カリグラの気配に。",
   "ko_candidate": "오른쪽을 칼리굴라의 기척에｡"
  },
  {
   "id": 14778,
   "key": "D0809al.txt:1927",
   "file": "D0809al.txt",
   "line": 1927,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左を、クラウディウスの気配に。",
   "ko_candidate": "왼쪽을 클라우디우스의 기척에｡"
  },
  {
   "id": 14779,
   "key": "D0809al.txt:1929",
   "file": "D0809al.txt",
   "line": 1929,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それぞれ銃口を向けた。",
   "ko_candidate": "각각 총구를 향했다｡"
  },
  {
   "id": 14780,
   "key": "D0809al.txt:1930",
   "file": "D0809al.txt",
   "line": 1930,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迷わず、トリガーを引いた。",
   "ko_candidate": "망설임 없이 방아쇠를 당겼다｡"
  },
  {
   "id": 14781,
   "key": "D0809al.txt:1939",
   "file": "D0809al.txt",
   "line": 1939,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２発轟くはずだった銃声は、だが全くの同時だったため、一発にしか聴こえなかった。",
   "ko_candidate": "두 발 울려 퍼질 총성은 하지만 완전히 동시여서 한 발로밖에 들리지 않았다｡"
  }
 ]
}