   "ko_candidate": "험악한 얼굴로 앞을 응시하고 있다｡"
  },
  {
   "id": 9528,
   "key": "D0710le.txt:604",
   "file": "D0710le.txt",
   "line": 604,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "漠然とした不安が、恐怖に変わった。",
