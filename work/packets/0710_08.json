   "key": "D0710le.txt:550",
   "file": "D0710le.txt",
   "line": 550,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――九郎ちゃん、ここで待ってて」",
   "ko_candidate": "「――쿠로 군､ 여기서 기다리고 있어」"
