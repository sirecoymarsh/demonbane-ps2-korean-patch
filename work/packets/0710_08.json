   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の中で、不安が広がっていく。",
   "ko_candidate": "내 안에서 불안감이 퍼져나간다｡"
  },
  {
   "id": 9519,
   "key": "D0710le.txt:544",
