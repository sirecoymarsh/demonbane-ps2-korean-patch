   "file": "D0710le.txt",
   "line": 581,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちょっ……ちょっと待った！ ど、どうしたんだよ！？　いきなり！？」",
   "ko_candidate": "「잠깐……잠깐만! 어､ 어떻게 된 거야!? 갑자기!?」"
  },
  {
   "id": 9525,
   "key": "D0710le.txt:594",
