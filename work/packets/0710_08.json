   "key": "D0710le.txt:600",
   "file": "D0710le.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんは黙ったままだ。",
   "ko_candidate": "라이카 씨는 말없이 있다｡"
