 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎ちゃん": "쿠로 군",
  "テリオン": "테리온",
  "大十字九郎": "다이쥬지 쿠로",
  "ライカ": "라이카",
  "ハスター": "하스터"
 },
 "items": [
  {
   "id": 15870,
   "key": "D0811le.txt:81",
   "file": "D0811le.txt",
   "line": 81,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃんを誘い出して、殺すつもりなのね……！」",
   "ko_candidate": "「쿠로를 유인해서､ 죽일 생각이구나……!」"
  },
  {
   "id": 15871,
   "key": "D0811le.txt:85",
   "file": "D0811le.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鴉達の合唱が止む。",
   "ko_candidate": "까마귀들의 합창이 멈춘다｡"
  },
  {
   "id": 15872,
   "key": "D0811le.txt:87",
   "file": "D0811le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬にして重い沈黙が暗闇に圧し掛かってきた。",
   "ko_candidate": "순식간에 무거운 침묵이 어둠에 짓눌려왔다｡"
  },
  {
   "id": 15873,
   "key": "D0811le.txt:89",
   "file": "D0811le.txt",
   "line": 89,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『暴君』と名乗った囚人は、首を傾げている。",
   "ko_candidate": "『폭군』이라 자칭한 죄수는､ 고개를 갸웃거리고 있다｡"
  },
  {
   "id": 15874,
   "key": "D0811le.txt:90",
   "file": "D0811le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやら悩んでいるらしかった。",
   "ko_candidate": "아무래도 고민하고 있는 듯했다｡"
  },
  {
   "id": 15875,
   "key": "D0811le.txt:94",
   "file": "D0811le.txt",
   "line": 94,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「違う、かな？ 殺そうと思っているワケではない、はず。 テリオンも多分、一緒」",
   "ko_candidate": "「아닌､ 걸까? 죽이려고 생각하고 있는 건 아닐､ 거야｡ 테리온도 아마､ 마찬가지」"
  },
  {
   "id": 15876,
   "key": "D0811le.txt:101",
   "file": "D0811le.txt",
   "line": 101,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……え？」",
   "ko_candidate": "「……엣?」"
  },
  {
   "id": 15877,
   "key": "D0811le.txt:106",
   "file": "D0811le.txt",
   "line": 106,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「でもテリオンの思惑通りにはさせない」 「だから大十字九郎と『暴君』は戦う。 テリオンのルールを破れる者が居るとしたら、それは多分、あの 『神殺し』だけ」",
   "ko_candidate": "「하지만 테리온의 속셈대로는 두지 않을 거야｡ 그래서 다이쥬지 쿠로와 『폭군』은 싸운다｡ 테리온의 규칙을 깰 수 있는 자가 있다면､ 그건 아마도､ 저 『신살자』뿐」"
  },
  {
   "id": 15878,
   "key": "D0811le.txt:115",
   "file": "D0811le.txt",
   "line": 115,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……どういう意味？」",
   "ko_candidate": "「……무슨 뜻이야?」"
  },
  {
   "id": 15879,
   "key": "D0811le.txt:120",
   "file": "D0811le.txt",
   "line": 120,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ははっ、お姉ちゃんにはムズカシー話だと思うよ。まっ、こっちの事情だから、気にしないで」",
   "ko_candidate": "「하핫､ 누나에겐 어려운 얘기일 거야｡ 뭐､ 이쪽 사정이니까､ 신경 쓰지 마」"
  },
  {
   "id": 15880,
   "key": "D0811le.txt:125",
   "file": "D0811le.txt",
   "line": 125,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうはいかない……あなた、九郎ちゃんを巻き込もうとしてるもの……。許さない……そんなこと許さない……」",
   "ko_candidate": "「그럴 순 없어……당신､ 쿠로를 끌어들이려 하고 있잖아…… 용서 못 해……그런 건 용서 못 해……」"
  },
  {
   "id": 15881,
   "key": "D0811le.txt:130",
   "file": "D0811le.txt",
   "line": 130,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「許さなかったら何だってーの、シスターってば、あははは」",
   "ko_candidate": "「용서 못 한다고 해서 어쩌겠다는 거야､ 수녀님이라니､ 아하하하」"
  },
  {
   "id": 15882,
   "key": "D0811le.txt:136",
   "file": "D0811le.txt",
   "line": 136,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『暴君』の意思を受けて、鴉達が一斉に嘲笑う。",
   "ko_candidate": "『폭군』의 의지를 받아､ 까마귀들이 일제히 조소한다｡"
  },
  {
   "id": 15883,
   "key": "D0811le.txt:138",
   "file": "D0811le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘲笑が、合唱する。",
   "ko_candidate": "조소가､ 합창한다｡"
  },
  {
   "id": 15884,
   "key": "D0811le.txt:140",
   "file": "D0811le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがライカは怯えない。気にも留めない。",
   "ko_candidate": "하지만 라이카는 겁먹지 않는다｡ 신경도 쓰지 않는다｡"
  },
  {
   "id": 15885,
   "key": "D0811le.txt:142",
   "file": "D0811le.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ黙って『暴君』を睨みつける。",
   "ko_candidate": "그저 묵묵히 『폭군』을 노려본다｡"
  },
  {
   "id": 15886,
   "key": "D0811le.txt:144",
   "file": "D0811le.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否――",
   "ko_candidate": "아니――"
  },
  {
   "id": 15887,
   "key": "D0811le.txt:152",
   "file": "D0811le.txt",
   "line": 152,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………へえ」",
   "ko_candidate": "「…………헤에」"
  },
  {
   "id": 15888,
   "key": "D0811le.txt:155",
   "file": "D0811le.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘲笑が止む。再び沈黙。",
   "ko_candidate": "조소가 멈춘다｡ 다시 침묵｡"
  },
  {
   "id": 15889,
   "key": "D0811le.txt:156",
   "file": "D0811le.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度はただ一羽の鴉が、『暴君』の言葉を伝える。",
   "ko_candidate": "이번엔 단 한 마리의 까마귀가､ 『폭군』의 말을 전한다｡"
  },
  {
   "id": 15890,
   "key": "D0811le.txt:157",
   "file": "D0811le.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その声色は……酷く愉しそうだった。",
   "ko_candidate": "그 목소리는……몹시 즐거워 보였다｡"
  },
  {
   "id": 15891,
   "key": "D0811le.txt:161",
   "file": "D0811le.txt",
   "line": 161,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そういうことか。 おっけー。じゃあ、少しだけ教えてあげる」 「『暴君』はね。『Ｃ計画』の鍵。Ｃの巫女」",
   "ko_candidate": "「그런 거구나｡ 오케이｡ 그럼､ 조금만 알려줄게｡ 『폭군』은 말이야｡ 『C계획』의 열쇠｡ C의 무녀」"
  },
  {
   "id": 15892,
   "key": "D0811le.txt:169",
   "file": "D0811le.txt",
   "line": 169,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ッッ!?」",
   "ko_candidate": "「……읏!?」"
  },
  {
   "id": 15893,
   "key": "D0811le.txt:173",
   "file": "D0811le.txt",
   "line": 173,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『Ｃ計画』。",
   "ko_candidate": "『C계획』｡"
  },
  {
   "id": 15894,
   "key": "D0811le.txt:173",
   "file": "D0811le.txt",
   "line": 173,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『Ｃの巫女』。",
   "ko_candidate": "『C의 무녀』｡"
  },
  {
   "id": 15895,
   "key": "D0811le.txt:174",
   "file": "D0811le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その言葉にライカは目を見開く。",
   "ko_candidate": "그 말에 라이카는 눈을 크게 뜬다｡"
  },
  {
   "id": 15896,
   "key": "D0811le.txt:176",
   "file": "D0811le.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "酷く動揺しているのか、躰が小刻みに震えていた。",
   "ko_candidate": "몹시 동요하고 있는지､ 몸이 미세하게 떨리고 있었다｡"
  },
  {
   "id": 15897,
   "key": "D0811le.txt:180",
   "file": "D0811le.txt",
   "line": 180,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そう……この『暴君』こそが偶然に生まれた完成体。 ラスト・ナンバーなんだよ……」",
   "ko_candidate": "「그래……이 『폭군』이야말로 우연히 태어난 완성체｡ 라스트 넘버라고……」"
  },
  {
   "id": 15898,
   "key": "D0811le.txt:185",
   "file": "D0811le.txt",
   "line": 185,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まさか……まさか……本当にあなたのような存在が居るなんて……」",
   "ko_candidate": "「설마……설마……정말로 당신 같은 존재가 있다니……」"
  },
  {
   "id": 15899,
   "key": "D0811le.txt:191",
   "file": "D0811le.txt",
   "line": 191,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――だガ、失敗作だ。同胞に牙剥き、僧院の最下層にアる地下牢に幽閉さレタ。『暴君』は『罪人』なのダ」",
   "ko_candidate": "「――하지만､ 실패작이다｡ 동포에게 이빨을 드러내고､ 승원의 최하층에 있는 지하 감옥에 유폐되었다｡ 『폭군』은 『죄인』이다」"
  },
  {
   "id": 15900,
   "key": "D0811le.txt:195",
   "file": "D0811le.txt",
   "line": 195,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「っ!?」",
   "ko_candidate": "「읏!?」"
  },
  {
   "id": 15901,
   "key": "D0811le.txt:200",
   "file": "D0811le.txt",
   "line": 200,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ!?　きゃあああああっ！」",
   "ko_candidate": "「엣!? 꺄아아아아악!」"
  },
  {
   "id": 15902,
   "key": "D0811le.txt:213",
   "file": "D0811le.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然、聴こえてきた声と共に建物が激震する。",
   "ko_candidate": "갑자기､ 들려온 목소리와 함께 건물이 격렬하게 흔들린다｡"
  },
  {
   "id": 15903,
   "key": "D0811le.txt:215",
   "file": "D0811le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "壁には亀裂が走り、地面が傾ぐ。",
   "ko_candidate": "벽에는 균열이 생기고､ 바닥이 기울어진다｡"
  },
  {
   "id": 15904,
   "key": "D0811le.txt:218",
   "file": "D0811le.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鴉達が喚き、危険から逃れようと一斉に羽ばたく。",
   "ko_candidate": "까마귀들이 울부짖으며､ 위험에서 벗어나려 일제히 날갯짓한다｡"
  },
  {
   "id": 15905,
   "key": "D0811le.txt:220",
   "file": "D0811le.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い羽根が部屋の中を舞う。",
   "ko_candidate": "검은 깃털이 방 안을 날아다닌다｡"
  },
  {
   "id": 15906,
   "key": "D0811le.txt:224",
   "file": "D0811le.txt",
   "line": 224,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おぉぉぉら、見つけたぜ！　ナマス切りだっ！　ハラワタぶちまけろっ！」",
   "ko_candidate": "「오오오라､ 찾았다! 생선회다! 내장을 뒤집어라!」"
  },
  {
   "id": 15907,
   "key": "D0811le.txt:227",
   "file": "D0811le.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "窓から――ここは地上遠く離れた最上階だというのに――矮躯の影が踊り込む。風が吹き荒れた。",
   "ko_candidate": "창문에서――여기는 지상에서 멀리 떨어진 최상층인데도――작은 체구의 그림자가 뛰어든다｡ 바람이 거세게 불었다｡"
  },
  {
   "id": 15908,
   "key": "D0811le.txt:232",
   "file": "D0811le.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き荒れた風は、刃の如き鋭さを持って、コンクリートを刻んでいく！",
   "ko_candidate": "거세게 분 바람은､ 칼날 같은 날카로움을 지니고､ 콘크리트를 깎아나간다!"
  },
  {
   "id": 15909,
   "key": "D0811le.txt:236",
   "file": "D0811le.txt",
   "line": 236,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「イア！　イア！　ハスター！」",
   "ko_candidate": "「이야! 이야! 하스터!」"
  }
 ]
}