{
 "packet": "1309_08",
 "scene": "1309",
 "anchor": {
  "hit": 63,
  "total": 67,
  "rate": 0.94
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "九郎": "쿠로",
  "術式": "술식",
  "魔力": "마력",
  "大十字九郎": "다이쥬지 쿠로",
  "ヒヒイロカネ": "히히이로카네"
 },
 "items": [
  {
   "id": 34211,
   "key": "D1309le.txt:252",
   "file": "D1309le.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "折れるな、俺の闘志。",
   "ko_candidate": "꺾이지 마､ 내 투지여｡"
  },
  {
   "id": 34212,
   "key": "D1309le.txt:253",
   "file": "D1309le.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "決して邪悪を相手に屈するな！",
   "ko_candidate": "결코 사악을 상대로 굴하지 마!"
  },
  {
   "id": 34213,
   "key": "D1309le.txt:255",
   "file": "D1309le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はバルザイの偃月刀を脇に下ろし、軽く腰を落として身構えた。",
   "ko_candidate": "나는 바르자이의 언월도를 옆으로 내리고 가볍게 허리를 낮춰 자세를 잡았다｡"
  },
  {
   "id": 34214,
   "key": "D1309le.txt:261",
   "file": "D1309le.txt",
   "line": 261,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待っていろ、デモンベイン。俺が救ってやる」",
   "ko_candidate": "「기다려､ 데몬베인｡ 내가 구해줄게」"
  },
  {
   "id": 34215,
   "key": "D1309le.txt:265",
   "file": "D1309le.txt",
   "line": 265,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何をブツクサ呟いてるのアンタら……恐怖でアタマがどうかしちゃったかしら？　まあ良いわ。そろろそろ飽きたから死になさい」",
   "ko_candidate": "「뭘 중얼거리고 있는 거야 너희들……공포로 머리가 어떻게 된 걸까? 뭐 좋아｡ 슬슬 질렸으니까 죽어」"
  },
  {
   "id": 34216,
   "key": "D1309le.txt:274",
   "file": "D1309le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを覆う怨念にベクトルが与えられる。",
   "ko_candidate": "데몬베인을 덮은 원념에 벡터가 주어진다｡"
  },
  {
   "id": 34217,
   "key": "D1309le.txt:275",
   "file": "D1309le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "現実をも侵す邪念の波動は、俺を消し滅ぼすべく集結する。",
   "ko_candidate": "현실마저 침식하는 사념의 파동은 나를 없애 멸하기 위해 집결한다｡"
  },
  {
   "id": 34218,
   "key": "D1309le.txt:279",
   "file": "D1309le.txt",
   "line": 279,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じゃあねぇぇぇぇぇ、九郎ちゃぁぁぁん！ けっこー愉しかったわよぉぉぉん！」",
   "ko_candidate": "「그럼 안녕~､ 쿠로 짱! 꽤나 즐거웠어~!」"
  },
  {
   "id": 34219,
   "key": "D1309le.txt:283",
   "file": "D1309le.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "限界寸前まで濃縮された呪詛は、今、起爆の術式を送り込まれ――",
   "ko_candidate": "한계 직전까지 농축된 저주는 지금 기폭의 술식을 보내 넣어――"
  },
  {
   "id": 34220,
   "key": "D1309le.txt:286",
   "file": "D1309le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那。",
   "ko_candidate": "찰나｡"
  },
  {
   "id": 34221,
   "key": "D1309le.txt:296",
   "file": "D1309le.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が、呪弾を貫いた。",
   "ko_candidate": "빛이 주탄을 꿰뚫었다｡"
  },
  {
   "id": 34222,
   "key": "D1309le.txt:298",
   "file": "D1309le.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲鳴をあげ、散り乱れる怨霊の群れ。",
   "ko_candidate": "비명을 지르며 흩어지는 원령의 무리｡"
  },
  {
   "id": 34223,
   "key": "D1309le.txt:299",
   "file": "D1309le.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呪弾は急速にその威力を失う。",
   "ko_candidate": "주탄은 급속도로 그 위력을 잃는다｡"
  },
  {
   "id": 34224,
   "key": "D1309le.txt:301",
   "file": "D1309le.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃波。",
   "ko_candidate": "충격파｡"
  },
  {
   "id": 34225,
   "key": "D1309le.txt:302",
   "file": "D1309le.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "兇暴なエグゾーストが耳を打ったのは、それからしばらくの後だった。",
   "ko_candidate": "흉포한 배기음이 귀를 때린 것은 그로부터 잠시 후였다｡"
  },
  {
   "id": 34226,
   "key": "D1309le.txt:306",
   "file": "D1309le.txt",
   "line": 306,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な――」",
   "ko_candidate": "「뭐――」"
  },
  {
   "id": 34227,
   "key": "D1309le.txt:310",
   "file": "D1309le.txt",
   "line": 310,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――に!?」",
   "ko_candidate": "「――야!?」"
  },
  {
   "id": 34228,
   "key": "D1309le.txt:326",
   "file": "D1309le.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが何か認識するよりも確認するよりもまず、大地を蹴る。",
   "ko_candidate": "그것이 무엇인지 인식하기보다 확인하기보다 먼저 대지를 박찬다｡"
  },
  {
   "id": 34229,
   "key": "D1309le.txt:327",
   "file": "D1309le.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足元で魔力を爆砕させ、強力な推進力を得る。",
   "ko_candidate": "발밑에서 마력을 폭쇄시켜 강력한 추진력을 얻는다｡"
  },
  {
   "id": 34230,
   "key": "D1309le.txt:329",
   "file": "D1309le.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの躰を弾丸とし、デモンベインに向かって射出させる。",
   "ko_candidate": "자신의 몸을 탄환으로 삼아 데몬베인을 향해 발사시킨다｡"
  },
  {
   "id": 34231,
   "key": "D1309le.txt:335",
   "file": "D1309le.txt",
   "line": 335,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀を突き出し、硬質化させた黒翼を畳んで、身体に巻きつかせる。",
   "ko_candidate": "언월도를 내밀고 경질화시킨 검은 날개를 접어 몸에 감는다｡"
  },
  {
   "id": 34232,
   "key": "D1309le.txt:336",
   "file": "D1309le.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀の剣先を先端に、俺は黒い円錐型の矢尻と化した。",
   "ko_candidate": "언월도의 검끝을 첨단으로 나는 검은 원뿔형의 화살촉이 되었다｡"
  },
  {
   "id": 34233,
   "key": "D1309le.txt:338",
   "file": "D1309le.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "コクピットを目指して、翔ぶ。",
   "ko_candidate": "콕핏을 향해 날아간다｡"
  },
  {
   "id": 34234,
   "key": "D1309le.txt:339",
   "file": "D1309le.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狙うは閉じたハッチの僅かな――本当に僅かな隙間。",
   "ko_candidate": "노리는 것은 닫힌 해치의 아주――정말 아주 작은 틈｡"
  },
  {
   "id": 34235,
   "key": "D1309le.txt:341",
   "file": "D1309le.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊の魔力を偃月刀の剣先に集中させ、これを貫く――！",
   "ko_candidate": "파괴의 마력을 언월도의 검끝에 집중시켜 이것을 꿰뚫는다――!"
  },
  {
   "id": 34236,
   "key": "D1309le.txt:349",
   "file": "D1309le.txt",
   "line": 349,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおおおおおおおお！」",
   "ko_candidate": "「우오오오오오오오오오오오!」"
  },
  {
   "id": 34237,
   "key": "D1309le.txt:351",
   "file": "D1309le.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界を灼き尽くすほどに眩い火花が弾けた。",
   "ko_candidate": "시야를 태워버릴 정도로 눈부신 불꽃이 튀었다｡"
  },
  {
   "id": 34238,
   "key": "D1309le.txt:355",
   "file": "D1309le.txt",
   "line": 355,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐうぅあっ!?　大十字九郎……アンタァァァァァ！」",
   "ko_candidate": "「그우우앗!? 다이쥬지 쿠로……너어어어어어!」"
  },
  {
   "id": 34239,
   "key": "D1309le.txt:359",
   "file": "D1309le.txt",
   "line": 359,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐ……ぐぐ……だあああああああああああッ！」",
   "ko_candidate": "「그……그그……다아아아아아아아아아앗!」"
  },
  {
   "id": 34240,
   "key": "D1309le.txt:361",
   "file": "D1309le.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全魔力を注ぎ込むつもりだった。",
   "ko_candidate": "전 마력을 쏟아 부을 작정이었다｡"
  },
  {
   "id": 34241,
   "key": "D1309le.txt:362",
   "file": "D1309le.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術防護を破り、ヒヒイロカネの装甲を破り、ほんの僅かで良い。ほんの僅か、剣先がハッチの隙間に入り込めば良い。",
   "ko_candidate": "마술 방호를 뚫고 히히이로카네의 장갑을 뚫고 아주 조금이라도 좋다｡ 아주 조금이라도 검끝이 해치의 틈에 들어가기만 하면 된다｡"
  },
  {
   "id": 34242,
   "key": "D1309le.txt:364",
   "file": "D1309le.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い円錐に包まれた全身を回転させ、錐のように掘り進む。",
   "ko_candidate": "검은 원뿔에 싸인 온몸을 회전시켜 송곳처럼 파고든다｡"
  },
  {
   "id": 34243,
   "key": "D1309le.txt:365",
   "file": "D1309le.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "回転のたびに火花が盛大に飛び散り、世界を染める。",
   "ko_candidate": "회전할 때마다 불꽃이 성대하게 튀어 세상을 물들인다｡"
  },
  {
   "id": 34244,
   "key": "D1309le.txt:367",
   "file": "D1309le.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――偃月刀の耐久度が限界に達するより、ほんの少しだけ早く、剣先がめり込んだ。",
   "ko_candidate": "그리고――언월도의 내구도가 한계에 도달하기보다 아주 조금 빨리 검끝이 파고들었다｡"
  },
  {
   "id": 34245,
   "key": "D1309le.txt:368",
   "file": "D1309le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝機。",
   "ko_candidate": "승기｡"
  },
  {
   "id": 34246,
   "key": "D1309le.txt:374",
   "file": "D1309le.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "媒介には血を使った。",
   "ko_candidate": "매개로는 피를 썼다｡"
  },
  {
   "id": 34247,
   "key": "D1309le.txt:375",
   "file": "D1309le.txt",
   "line": 375,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身から流れる血が腕を昇り、偃月刀の刃身を昇り、ハッチの隙間へと流れ込む。",
   "ko_candidate": "온몸에서 흐르는 피가 팔을 타고 언월도의 칼날을 타고 해치의 틈으로 흘러들어간다｡"
  },
  {
   "id": 34248,
   "key": "D1309le.txt:377",
   "file": "D1309le.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起爆させる。",
   "ko_candidate": "기폭시킨다｡"
  },
  {
   "id": 34249,
   "key": "D1309le.txt:380",
   "file": "D1309le.txt",
   "line": 380,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「爆発！」",
   "ko_candidate": "「폭발!」"
  },
  {
   "id": 34250,
   "key": "D1309le.txt:397",
   "file": "D1309le.txt",
   "line": 397,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぎぃやああああああっ!?」",
   "ko_candidate": "「기이야아아아아아앗!?」"
  }
 ]
}