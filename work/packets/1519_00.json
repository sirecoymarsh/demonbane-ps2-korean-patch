 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "アル": "알",
  "九郎": "쿠로",
  "魔導書": "마도서"
 },
 "items": [
  {
   "id": 48535,
   "key": "D1519.txt:12",
   "file": "D1519.txt",
   "line": 12,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……デモンベイン。もう一頑張りしてはくれぬか？」",
   "ko_candidate": "「……데몬베인｡ 마지막으로 한 번만 더 힘을 내줄 수 없겠나?」"
  },
  {
   "id": 48536,
   "key": "D1519.txt:15",
   "file": "D1519.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠く遠く宇宙に、戦いの軌跡を求めながら、アルは戦友に語りかける。",
   "ko_candidate": "멀고 먼 우주에서 전투의 궤적을 찾으며､ 알은 전우에게 말을 건넨다｡"
  },
  {
   "id": 48537,
   "key": "D1519.txt:19",
   "file": "D1519.txt",
   "line": 19,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「１人分くらいなら……何とかなると思うのだが」",
   "ko_candidate": "「한 사람 정도라면…… 어떻게든 될 것 같은데」"
  },
  {
   "id": 48538,
   "key": "D1519.txt:22",
   "file": "D1519.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは応えない。",
   "ko_candidate": "데몬베인은 대답하지 않는다｡"
  },
  {
   "id": 48539,
   "key": "D1519.txt:23",
   "file": "D1519.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、アルは独りで続ける。",
   "ko_candidate": "하지만 알은 혼자서 계속한다｡"
  },
  {
   "id": 48540,
   "key": "D1519.txt:27",
   "file": "D1519.txt",
   "line": 27,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やはりな……この様な永遠は、違うと思うのだ。幸せを得るのならもっと違った形で……」",
   "ko_candidate": "「역시나……이런 영원은 잘못됐다고 생각해｡ 행복을 얻으려면 더 다른 방식으로……」"
  },
  {
   "id": 48541,
   "key": "D1519.txt:30",
   "file": "D1519.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは応えない。",
   "ko_candidate": "데몬베인은 대답하지 않는다｡"
  },
  {
   "id": 48542,
   "key": "D1519.txt:40",
   "file": "D1519.txt",
   "line": 40,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――妾は九郎から多くの掛け替えの無いものを貰った。それは身に余るほどの幸福だ。だから……」",
   "ko_candidate": "――자신은 쿠로에게서 많은 대체 불가능한 것들을 받았다｡ 그것은 과분할 정도의 행복이다｡ 그러니까……"
  },
  {
   "id": 48543,
   "key": "D1519.txt:43",
   "file": "D1519.txt",
   "line": 43,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベイン。この男を、もうヒトの世界に返そうではないか」",
   "ko_candidate": "데몬베인｡ 이 남자를､ 이제 인간의 세계로 돌려보내자｡"
  },
  {
   "id": 48544,
   "key": "D1519.txt:50",
   "file": "D1519.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインは……",
   "ko_candidate": "데몬베인은……"
  },
  {
   "id": 48545,
   "key": "D1519.txt:58",
   "file": "D1519.txt",
   "line": 58,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「この男の笑顔はやはり……太陽の下が一番良く似合う」 デモンベインは――少女の願いに応えた。",
   "ko_candidate": "이 남자의 미소는 역시……태양 아래가 가장 잘 어울린다｡"
  },
  {
   "id": 48546,
   "key": "D1519.txt:73",
   "file": "D1519.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "おもむろに自らの胸を貫く。",
   "ko_candidate": "데몬베인은――소녀의 소원에 응답했다｡"
  },
  {
   "id": 48547,
   "key": "D1519.txt:74",
   "file": "D1519.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "引き抜いたその手に握られているエンジン。",
   "ko_candidate": "천천히 자신의 가슴을 꿰뚫는다｡ 뽑아낸 그 손에 쥐고 있는 엔진｡"
  },
  {
   "id": 48548,
   "key": "D1519.txt:76",
   "file": "D1519.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの心臓、獅子の心臓。",
   "ko_candidate": "데몬베인의 심장､ 사자의 심장｡"
  },
  {
   "id": 48549,
   "key": "D1519.txt:77",
   "file": "D1519.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銀鍵守護神機関。",
   "ko_candidate": "은건수호신기관｡"
  },
  {
   "id": 48550,
   "key": "D1519.txt:79",
   "file": "D1519.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "平行宇宙より無尽蔵のエネルギーを組み上げる無限の心臓は、今、真に最期の死力を振り絞った。",
   "ko_candidate": "평행우주로부터 무진장의 에너지를 끌어올리는 무한의 심장은､ 지금､ 진정 마지막 죽을힘을 짜냈다｡"
  },
  {
   "id": 48551,
   "key": "D1519.txt:84",
   "file": "D1519.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルもまた全神経を宇宙に張り巡らせる。",
   "ko_candidate": "알 또한 모든 신경을 우주에 펼쳐놓는다｡"
  },
  {
   "id": 48552,
   "key": "D1519.txt:85",
   "file": "D1519.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "些細な手掛かりも見逃さないよう……魂にかかる負荷は大きく、苦痛がアルを苛む。",
   "ko_candidate": "사소한 단서라도 놓치지 않도록……영혼에 걸리는 부하는 크고､ 고통이 알을 괴롭힌다｡"
  },
  {
   "id": 48553,
   "key": "D1519.txt:87",
   "file": "D1519.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それは喜びだ。",
   "ko_candidate": "하지만､ 그것은 기쁨이다｡"
  },
  {
   "id": 48554,
   "key": "D1519.txt:89",
   "file": "D1519.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛する者の為に血を流す。それは魔導書である自分は持っていなかった、愛し合うことの出来る生命だけに許された痛み。",
   "ko_candidate": "사랑하는 사람을 위해 피를 흘리는 것｡ 그것은 마도서인 자신은 가지고 있지 않았던､ 사랑할 수 있는 생명에게만 허락된 아픔｡"
  },
  {
   "id": 48555,
   "key": "D1519.txt:90",
   "file": "D1519.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生命賛歌なのだから。",
   "ko_candidate": "생명 찬가이니까｡"
  },
  {
   "id": 48556,
   "key": "D1519.txt:97",
   "file": "D1519.txt",
   "line": 97,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あの世界は…… 妾が必ず見つけ出す。 デモンベイン…… 汝は其処に到る扉を……！」",
   "ko_candidate": "「저 세계는……내가 반드시 찾아낼 거야｡ 데몬베인……너는 그곳으로 가는 문을 ……!」"
  },
  {
   "id": 48557,
   "key": "D1519.txt:106",
   "file": "D1519.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、光が啓ける。",
   "ko_candidate": "그리고､ 빛이 밝아온다｡"
  },
  {
   "id": 48558,
   "key": "D1519.txt:111",
   "file": "D1519.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街の灯火。",
   "ko_candidate": "거리의 불빛｡"
  },
  {
   "id": 48559,
   "key": "D1519.txt:114",
   "file": "D1519.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人々の命の輝き。",
   "ko_candidate": "사람들의 생명의 빛남｡"
  },
  {
   "id": 48560,
   "key": "D1519.txt:119",
   "file": "D1519.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬だが、確かに捉えた。",
   "ko_candidate": "순간이지만､ 확실히 포착했다｡"
  },
  {
   "id": 48561,
   "key": "D1519.txt:125",
   "file": "D1519.txt",
   "line": 125,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンベイン！」",
   "ko_candidate": "「데몬베인!」"
  },
  {
   "id": 48562,
   "key": "D1519.txt:138",
   "file": "D1519.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限の心臓は砕け散り、その内から宇宙が溢れ出す。",
   "ko_candidate": "무한의 심장은 산산조각 나고､ 그 안에서 우주가 넘쳐흐른다｡"
  },
  {
   "id": 48563,
   "key": "D1519.txt:145",
   "file": "D1519.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは幽玄に揺らめく儚い扉。",
   "ko_candidate": "그것은 유현하게 흔들리는 덧없는 문｡"
  },
  {
   "id": 48564,
   "key": "D1519.txt:146",
   "file": "D1519.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、確実にあの世界へと続く路。",
   "ko_candidate": "하지만､ 확실히 저 세계로 이어지는 길｡"
  },
  {
   "id": 48565,
   "key": "D1519.txt:152",
   "file": "D1519.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "息を荒げ、冷や汗を流しながらも、アルは愛する男の寝顔に微笑みかける。",
   "ko_candidate": "거친 숨을 내쉬며､ 식은땀을 흘리면서도､ 알은 사랑하는 남자의 잠든 얼굴에 미소를 짓는다｡"
  },
  {
   "id": 48566,
   "key": "D1519.txt:153",
   "file": "D1519.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう一度、感謝を。",
   "ko_candidate": "다시 한 번､ 감사를｡"
  },
  {
   "id": 48567,
   "key": "D1519.txt:157",
   "file": "D1519.txt",
   "line": 157,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「本当にありがとう…… お人よしの、我が主。 そして――」",
   "ko_candidate": "「정말 고마워……착한､ 내 주인님｡ 그리고――」"
  },
  {
   "id": 48568,
   "key": "D1519.txt:164",
   "file": "D1519.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 48569,
   "key": "D1519.txt:172",
   "file": "D1519.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "転移の術が発動する。",
   "ko_candidate": "전이의 술식이 발동한다｡"
  },
  {
   "id": 48570,
   "key": "D1519.txt:173",
   "file": "D1519.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎の躰は光の粒子となって融け、 扉の向こう側へと投げ出される。",
   "ko_candidate": "쿠로의 몸은 빛의 입자가 되어 녹아､ 문 너머로 던져진다｡"
  },
  {
   "id": 48571,
   "key": "D1519.txt:181",
   "file": "D1519.txt",
   "line": 181,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「我が悠久、唯一人の君。 ……九郎、愛しているぞ」",
   "ko_candidate": "「나의 영원한､ 단 한 사람의 그대｡ ……쿠로､ 사랑해」"
  },
  {
   "id": 48572,
   "key": "D1519.txt:185",
   "file": "D1519.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう一度、愛の言葉を――",
   "ko_candidate": "다시 한 번､ 사랑의 말을――"
  },
  {
   "id": 48573,
   "key": "D1519.txt:191",
   "file": "D1519.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夢の中でその言葉を聞いた。",
   "ko_candidate": "꿈속에서 그 말을 들었다｡"
  },
  {
   "id": 48574,
   "key": "D1519.txt:192",
   "file": "D1519.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "足許が崩れ落ちていくような喪失感に戦慄して、 目を覚ます。",
   "ko_candidate": "발밑이 무너져 내리는 듯한 상실감에 전율하며､ 눈을 뜬다｡"
  }
 ]
}