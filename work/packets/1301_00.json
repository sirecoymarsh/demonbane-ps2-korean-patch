  },
  {
   "id": 30589,
   "key": "D1301al.txt:64",
   "file": "D1301al.txt",
   "line": 64,
   "speaker": "ウィルバー・ウェイトリイ / アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イグナヰイ……イグナイヰ…… トゥフルトゥクングア…… よぅぐそぉとおお……！」 「これで止めだ！ 征くぞ、アイオーン！」",
   "ko_candidate": "「<RUBY text=\"이그나일히\">Ygnailh</RUBY>……<RUBY text=\"이그나이이\">ygnaiih</RUBY>……<RUBY text=\"토프르토킁그아\">thflthkh'ngha</RUBY>……<RUBY text=\"요그 소토스\">Yog-Sothoth</RUBY>……!」"
  },
  {
   "id": 30590,
   "key": "D1301al.txt:81",
   "file": "D1301al.txt",
   "line": 81,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イブトゥンク……ヘフイエ―― ングルクドルウ……」",
   "ko_candidate": "「이걸로 끝이다! 가자､ 아이온!」"
  },
  {
   "id": 30592,
   "key": "D1301al.txt:88",
   "file": "D1301al.txt",
   "line": 88,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「亡びよ、外道！ 父親の許へと還るが良い！」",
   "ko_candidate": "「멸망하라､ 외도여! 아버지의 곁으로 돌아가거라!」"
  },
  {
   "id": 30593,
   "key": "D1301al.txt:99",
   "file": "D1301al.txt",
   "line": 99,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「エエ・ヤ・ヤァ・ヤァ・ヤハアアア――エ・ヤヤヤアアアア……ング・アアアアア……ング・アアア……フ・ユウ……フ・ユウ……助けッ、助けて！」 「ち、ち、ち、父上ぇ！ 父上ぇぇぇぇぇぇ！ よおぉぉぉぉぉうぐそおとお とおぉぉぉ……！」",
   "ko_candidate": "「<RUBY text=\"에에야야야야하아아아-에야야야야아아아\">Eh-y-ya-ya-yahaah-e'yayayaaaa</RUBY>……<RUBY text=\"은그아아아아아\">ngh'aaaaa</RUBY>……<RUBY text=\"은그아아아\">ngh'aaa</RUBY>……후유……후유……살려줘､ 살려줘! 아､ 아､ 아､ 아버지! 아버지이이이이이이! <RUBY text=\"요그 소토스\">Yog-Sothoth</RUBY>오오오오오오……!」"
  },
  {
   "id": 30594,
   "key": "D1301al.txt:120",
   "file": "D1301al.txt",
   "line": 120,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――見事だ、アル・アジフ。 真逆、あの異形を――外宇宙の法則で存在する、全き化物を滅ぼすとは」 「ならば、次のステップだ…… 余を、愉しませてみせろ！」",
   "ko_candidate": "「――훌륭하다､ 알 아지프｡ 설마､ 저 기괴한 존재를――외우주의 법칙으로 존재하는､ 완전한 괴물을 멸망시키다니｡ 그렇다면､ 다음 단계다…… 나를､ 즐겁게 해보거라!」"
  },
