{
 "packet": "1212_00",
 "scene": "1212",
 "anchor": {
  "hit": 25,
  "total": 25,
  "rate": 1.0
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "メタトロン": "메타트론",
  "ティベリウス": "티베리우스",
  "魔術師": "마술사"
 },
 "items": [
  {
   "id": 29779,
   "key": "D1212le.txt:15",
   "file": "D1212le.txt",
   "line": 15,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐあるぶふっ！　ちぃぃぃぃっ！」",
   "ko_candidate": "「구아르부풋! 치이이이잇!」"
  },
  {
   "id": 29780,
   "key": "D1212le.txt:23",
   "file": "D1212le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐敗した、節くれだった腕が、斬り落とされる。",
   "ko_candidate": "메타트론의 참격은 티베리우스의 팔을 포착했다｡"
  },
  {
   "id": 29781,
   "key": "D1212le.txt:27",
   "file": "D1212le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "後ろに飛び退きながら、肉鞭を振るう。しなりながら、四方八方、縦横無尽に鎌が襲いかかってくる。",
   "ko_candidate": "부패한､ 마디가 굵은 팔이 퍽 하고 바닥에 떨어진다｡ 뒤로 날아 물러나면서 육편을 휘두른다｡ 휘어지면서 사방팔방､ 종횡무진으로 낫이 덮쳐온다｡"
  },
  {
   "id": 29782,
   "key": "D1212le.txt:29",
   "file": "D1212le.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――痛覚は遮断。",
   "ko_candidate": "――통각은 차단｡"
  },
  {
   "id": 29783,
   "key": "D1212le.txt:31",
   "file": "D1212le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こうすれば、ある程度は堪えられる。",
   "ko_candidate": "이렇게 하면 어느 정도는 견딜 수 있다｡"
  },
  {
   "id": 29784,
   "key": "D1212le.txt:32",
   "file": "D1212le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "残りの感覚系を爆発的に加速させる。",
   "ko_candidate": "남은 감각계를 폭발적으로 가속시킨다｡"
  },
  {
   "id": 29785,
   "key": "D1212le.txt:34",
   "file": "D1212le.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神経系への負担は無視する。",
   "ko_candidate": "신경계에 대한 부담은 무시한다｡"
  },
  {
   "id": 29786,
   "key": "D1212le.txt:35",
   "file": "D1212le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今はただ、この邪悪を斃す。それだけだ。",
   "ko_candidate": "지금은 오직 이 사악함을 쓰러뜨리는 것｡ 그것뿐이다｡"
  },
  {
   "id": 29787,
   "key": "D1212le.txt:37",
   "file": "D1212le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――世界の速度が一転する。",
   "ko_candidate": "――세계의 속도가 일변한다｡"
  },
  {
   "id": 29788,
   "key": "D1212le.txt:40",
   "file": "D1212le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "兇悪に黒光りする無数の鎌。だが、その動きは加速された感覚、強化された動体視力を得た今、ひたすらに緩慢だ。",
   "ko_candidate": "흉악하게 검게 빛나는 무수한 낫｡ 하지만 그 움직임은 가속된 감각､ 강화된 동체시력을 얻은 지금､ 한없이 느리다｡"
  },
  {
   "id": 29789,
   "key": "D1212le.txt:43",
   "file": "D1212le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームセイバーを振るう。",
   "ko_candidate": "빔 세이버를 휘두른다｡"
  },
  {
   "id": 29790,
   "key": "D1212le.txt:44",
   "file": "D1212le.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "単純に、迫り来る順に落としていけば良いだけだった。",
   "ko_candidate": "단순히 다가오는 순서대로 떨어뜨리면 그만이었다｡"
  },
  {
   "id": 29791,
   "key": "D1212le.txt:46",
   "file": "D1212le.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鎌が熔かされ、肉鞭が切断される。",
   "ko_candidate": "낫이 녹아내리고､ 육편이 절단된다｡"
  },
  {
   "id": 29792,
   "key": "D1212le.txt:47",
   "file": "D1212le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "斬り落とされた肉鞭が、地面でのたうつ。",
   "ko_candidate": "잘려나간 육편이 바닥에서 뒹군다｡"
  },
  {
   "id": 29793,
   "key": "D1212le.txt:52",
   "file": "D1212le.txt",
   "line": 52,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅぅぅぅぅぅ!?」",
   "ko_candidate": "「쿠우우우우우우!?」"
  },
  {
   "id": 29794,
   "key": "D1212le.txt:57",
   "file": "D1212le.txt",
   "line": 57,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――……つっ」",
   "ko_candidate": "「――――――……츳」"
  },
  {
   "id": 29795,
   "key": "D1212le.txt:60",
   "file": "D1212le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……いけない。",
   "ko_candidate": "……안 되겠어｡"
  },
  {
   "id": 29796,
   "key": "D1212le.txt:61",
   "file": "D1212le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手離しそうになる意識を、ライカは必死に繋ぎ止めた。",
   "ko_candidate": "놓칠 뻔한 의식을 라이카는 필사적으로 붙잡았다｡"
  },
  {
   "id": 29797,
   "key": "D1212le.txt:63",
   "file": "D1212le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "負担は大きい。",
   "ko_candidate": "부담이 크다｡"
  },
  {
   "id": 29798,
   "key": "D1212le.txt:64",
   "file": "D1212le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――このまま一気に押し切る！",
   "ko_candidate": "――이대로 단숨에 밀어붙인다!"
  },
  {
   "id": 29799,
   "key": "D1212le.txt:68",
   "file": "D1212le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛翔。",
   "ko_candidate": "비상｡"
  },
  {
   "id": 29800,
   "key": "D1212le.txt:69",
   "file": "D1212le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天井近くまで跳躍したメタトロンの身体が、縦回転する。",
   "ko_candidate": "천장 가까이까지 도약한 메타트론의 몸이 세로로 회전한다｡"
  },
  {
   "id": 29801,
   "key": "D1212le.txt:70",
   "file": "D1212le.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空中に円を描く、ビームセイバーの軌跡。",
   "ko_candidate": "공중에 원을 그리는 빔 세이버의 궤적｡"
  },
  {
   "id": 29802,
   "key": "D1212le.txt:71",
   "file": "D1212le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのままティベリウスの真下へ降下する……！",
   "ko_candidate": "그대로 티베리우스의 바로 밑으로 하강한다……!"
  },
  {
   "id": 29803,
   "key": "D1212le.txt:76",
   "file": "D1212le.txt",
   "line": 76,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 29804,
   "key": "D1212le.txt:82",
   "file": "D1212le.txt",
   "line": 82,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「十字・天雷！」",
   "ko_candidate": "「십자?천뢰!」"
  },
  {
   "id": 29805,
   "key": "D1212le.txt:86",
   "file": "D1212le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームセイバーから閃光が迸り、避難所全体を白い闇に覆う。",
   "ko_candidate": "빔 세이버에서 섬광이 뿜어져 나와 대피소 전체를 하얀 어둠으로 뒤덮는다｡"
  },
  {
   "id": 29806,
   "key": "D1212le.txt:95",
   "file": "D1212le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一閃。",
   "ko_candidate": "일섬｡"
  },
  {
   "id": 29807,
   "key": "D1212le.txt:96",
   "file": "D1212le.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神罰の焔を噴き出す刃が、ティベリウスを両断する。",
   "ko_candidate": "신벌의 불꽃을 뿜어내는 칼날이 티베리우스를 양단한다｡"
  },
  {
   "id": 29808,
   "key": "D1212le.txt:97",
   "file": "D1212le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの躰を縦に走る光は、そのまま十字架型の劫火となって、全身を包み込む。",
   "ko_candidate": "티베리우스의 몸을 세로로 가로지르는 빛은 그대로 십자가형의 겁화가 되어 온몸을 감싼다｡"
  },
  {
   "id": 29809,
   "key": "D1212le.txt:102",
   "file": "D1212le.txt",
   "line": 102,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うぎゃああああああああ！」",
   "ko_candidate": "「우갸아아아아아아아아!」"
  },
  {
   "id": 29810,
   "key": "D1212le.txt:107",
   "file": "D1212le.txt",
   "line": 107,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『妖蛆の秘密』の所有者……不死身の魔術師。 だが……灼き尽くされても果たして、不死身でいられるか？」",
   "ko_candidate": "「『벌레의 신비』의 소유자……불사신의 마술사｡ 하지만……불태워져도 과연 불사신일 수 있을까?」"
  },
  {
   "id": 29811,
   "key": "D1212le.txt:113",
   "file": "D1212le.txt",
   "line": 113,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぎゃああああぁぁぁぁああああああ！……あああああぁぁぁぁぁぁ！……ぁぁぁぁぁぁぁ…………ぁぁぁ……ぁぁぁ…………ぁ…………」",
   "ko_candidate": "「갸아아아아아아아아아아아아아아!……아아아아아아아아아아!……아아아아아아아…………아아아……아아아…………아…………」"
  },
  {
   "id": 29812,
   "key": "D1212le.txt:116",
   "file": "D1212le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "響き渡るティベリウスの断末魔。",
   "ko_candidate": "울려 퍼지는 티베리우스의 단말마｡"
  },
  {
   "id": 29813,
   "key": "D1212le.txt:119",
   "file": "D1212le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、それも徐々に小さくなり――遂には止んだ。",
   "ko_candidate": "하지만 그것도 점점 작아지더니――마침내 멈췄다｡"
  },
  {
   "id": 29814,
   "key": "D1212le.txt:122",
   "file": "D1212le.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燃え盛る躰が前のめりに斃れる。",
   "ko_candidate": "불타오르는 몸이 앞으로 쓰러진다｡"
  },
  {
   "id": 29815,
   "key": "D1212le.txt:129",
   "file": "D1212le.txt",
   "line": 129,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……やった、か」",
   "ko_candidate": "「……해냈나」 「누나!」"
  },
  {
   "id": 29816,
   "key": "D1212le.txt:134",
   "file": "D1212le.txt",
   "line": 134,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お姉ちゃん！」 力が抜け、メタトロンは膝を突く。",
   "ko_candidate": "힘이 빠져 메타트론은 무릎을 꿇는다｡"
  },
  {
   "id": 29817,
   "key": "D1212le.txt:138",
   "file": "D1212le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "子ども達がその傍らに走り寄る――",
   "ko_candidate": "아이들이 그 곁으로 달려온다――"
  },
  {
   "id": 29818,
   "key": "D1212le.txt:143",
   "file": "D1212le.txt",
   "line": 143,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なぁぁぁぁんちゃって」",
   "ko_candidate": "「냐아아아아안 농담이야」"
  }
 ]
}