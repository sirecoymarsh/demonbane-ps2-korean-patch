 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "リベル・レギス": "리베르 레기스",
  "大十字九郎": "다이쥬지 쿠로",
  "リューガ": "류가",
  "九郎": "쿠로",
  "ライカ": "라이카",
  "九郎ちゃん": "쿠로 군",
  "アル": "알"
 },
 "items": [
  {
   "id": 48140,
   "key": "D1517al.txt:825",
   "file": "D1517al.txt",
   "line": 825,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マスタァァァァァァァァァァ！」",
   "ko_candidate": "「마스터어어어어어어어어어어어!」"
  },
  {
   "id": 48141,
   "key": "D1517al.txt:831",
   "file": "D1517al.txt",
   "line": 831,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして混沌の女もまた、",
   "ko_candidate": "그리고 혼돈의 여자 또한､"
  },
  {
   "id": 48142,
   "key": "D1517al.txt:835",
   "file": "D1517al.txt",
   "line": 835,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「真逆――君も同じだったのか？ だとしたら……僕は知らずに、自ら巨大な運命の輪に囚われていたのか――」 抗う術を持ち合わせていなかった。",
   "ko_candidate": "「설마――너도 같았던 거야? 그렇다면……나는 모르는 사이에 스스로 거대한 운명의 수레바퀴에 갇혀 있었던 걸까――」"
  },
  {
   "id": 48143,
   "key": "D1517le.txt:10",
   "file": "D1517le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い太陽と紅い月が昇る澱んだ空。",
   "ko_candidate": "저항할 방법을 갖고 있지 않았다｡"
  },
  {
   "id": 48144,
   "key": "D1517le.txt:11",
   "file": "D1517le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静寂を運ぶ、死の匂いを孕む、風。",
   "ko_candidate": "검은 태양과 붉은 달이 떠오르는 탁한 하늘｡"
  },
  {
   "id": 48145,
   "key": "D1517le.txt:12",
   "file": "D1517le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腐れ果てた都市に、凄絶な闇黒が充ちる。",
   "ko_candidate": "정적을 실어 나르는､ 죽음의 냄새를 품은 바람｡"
  },
  {
   "id": 48146,
   "key": "D1517le.txt:14",
   "file": "D1517le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其れは糜爛に犯され死絶した世界の、亡骸。",
   "ko_candidate": "썩어 문드러진 도시에 처절한 암흑이 가득 차 있다｡"
  },
  {
   "id": 48147,
   "key": "D1517le.txt:15",
   "file": "D1517le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人の歴史が行き着いた、黄昏の墓標だ。",
   "ko_candidate": "그것은 부패에 침식당해 죽어버린 세계의 망자｡"
  },
  {
   "id": 48148,
   "key": "D1517le.txt:17",
   "file": "D1517le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "廃墟の大地にデモンベインとリベル・レギスは、折り重なって斃れている。",
   "ko_candidate": "인류의 역사가 도달한 황혼의 묘표다｡ 폐허의 대지에 데몬베인과 리베르 레기스가 겹쳐져"
  },
  {
   "id": 48149,
   "key": "D1517le.txt:19",
   "file": "D1517le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "トラペゾヘドロンの力に半身を抉られたリベル・レギス。",
   "ko_candidate": "쓰러져 있다｡ 트라페조헤드론의 힘에 반신이 도려낸 리베르 레기스｡"
  },
  {
   "id": 48150,
   "key": "D1517le.txt:20",
   "file": "D1517le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トラペゾヘドロンの力を抑え込んだ反動で下半身を吹き飛ばされたデモンベイン。",
   "ko_candidate": "트라페조헤드론의 힘을 억눌렀던 반동으로 하반신이 날아간 데몬베인｡"
  },
  {
   "id": 48151,
   "key": "D1517le.txt:22",
   "file": "D1517le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両機とも、文字通り「半壊」。",
   "ko_candidate": "양쪽 기체 모두 문자 그대로 '반파'｡"
  },
  {
   "id": 48152,
   "key": "D1517le.txt:27",
   "file": "D1517le.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死に絶えた世界に、爆音が木霊する。",
   "ko_candidate": "죽어버린 세계에 폭음이 울려 퍼진다｡"
  },
  {
   "id": 48153,
   "key": "D1517le.txt:28",
   "file": "D1517le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインのコクピットからだった。",
   "ko_candidate": "데몬베인의 콕핏에서였다｡"
  },
  {
   "id": 48154,
   "key": "D1517le.txt:29",
   "file": "D1517le.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハッチが弾け、宙を舞った。",
   "ko_candidate": "해치가 튀어올라 공중을 날았다｡"
  },
  {
   "id": 48155,
   "key": "D1517le.txt:33",
   "file": "D1517le.txt",
   "line": 33,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハァ……ハァ……アアアァァ！ 大十字九郎、貴様ァァァァァ！」",
   "ko_candidate": "「하아… 하아… 아아아아아! 다이쥬지 쿠로､ 네 이 자식아아아아!」"
  },
  {
   "id": 48156,
   "key": "D1517le.txt:37",
   "file": "D1517le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "コクピットを見下ろしながら、リューガが叫ぶ。",
   "ko_candidate": "콕핏을 내려다보며 류가가 외친다｡"
  },
  {
   "id": 48157,
   "key": "D1517le.txt:38",
   "file": "D1517le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その貌に張りついた度し難い怒りと――",
   "ko_candidate": "그 얼굴에 드리워진 돌이킬 수 없는 분노와――"
  },
  {
   "id": 48158,
   "key": "D1517le.txt:38",
   "file": "D1517le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖。",
   "ko_candidate": "공포｡"
  },
  {
   "id": 48159,
   "key": "D1517le.txt:40",
   "file": "D1517le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "我を見失い、逆上していた。",
   "ko_candidate": "자아를 잃고 격분해 있었다｡"
  },
  {
   "id": 48160,
   "key": "D1517le.txt:41",
   "file": "D1517le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピット内部に向けて、破壊の拳を振りかぶる。",
   "ko_candidate": "콕핏 내부를 향해 파괴의 주먹을 치켜든다｡"
  },
  {
   "id": 48161,
   "key": "D1517le.txt:45",
   "file": "D1517le.txt",
   "line": 45,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「砕け散れぇぇぇぇぇ！」",
   "ko_candidate": "「박살나라아아아아!」"
  },
  {
   "id": 48162,
   "key": "D1517le.txt:50",
   "file": "D1517le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットより放たれた一条の光が、リューガを貫く。",
   "ko_candidate": "콕핏에서 뿜어져 나온 한 줄기 빛이 류가를 꿰뚫는다｡"
  },
  {
   "id": 48163,
   "key": "D1517le.txt:54",
   "file": "D1517le.txt",
   "line": 54,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐふっ……あああっ！」",
   "ko_candidate": "「크윽… 아아악!」"
  },
  {
   "id": 48164,
   "key": "D1517le.txt:57",
   "file": "D1517le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身を屈めて吐血する。",
   "ko_candidate": "몸을 구부리며 피를 토한다｡"
  },
  {
   "id": 48165,
   "key": "D1517le.txt:58",
   "file": "D1517le.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "倒れ、機体の上から転がり落ちた。",
   "ko_candidate": "쓰러져 기체 위에서 굴러 떨어졌다｡"
  },
  {
   "id": 48166,
   "key": "D1517le.txt:60",
   "file": "D1517le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それを確認したライカは、ビーム砲に変質させた右腕を元に戻し、先程から目を醒まさない九郎を、抱き締め揺さぶる。",
   "ko_candidate": "그것을 확인한 라이카는 빔포로 변질시킨 오른팔을 원래대로 돌리고 아까부터 깨어나지 않는 쿠로를 끌어안고 흔든다｡"
  },
  {
   "id": 48167,
   "key": "D1517le.txt:66",
   "file": "D1517le.txt",
   "line": 66,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎ちゃん！　九郎ちゃん！ 目を、目を開けて……っ！」",
   "ko_candidate": "「쿠로 군! 쿠로 군! 눈을､ 눈을 떠 봐…!」"
  },
  {
   "id": 48168,
   "key": "D1517le.txt:71",
   "file": "D1517le.txt",
   "line": 71,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ぐあ……あ……」",
   "ko_candidate": "「아… 크아… 아…」"
  },
  {
   "id": 48169,
   "key": "D1517le.txt:74",
   "file": "D1517le.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎はただ、呻き声を上げるだけだ。",
   "ko_candidate": "쿠로는 그저 신음 소리만 낼 뿐이다｡"
  },
  {
   "id": 48170,
   "key": "D1517le.txt:75",
   "file": "D1517le.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔色は蒼く、全身にはまったく力が入っていない。",
   "ko_candidate": "안색이 창백하고 온몸에 전혀 힘이 들어가지 않는다｡"
  },
  {
   "id": 48171,
   "key": "D1517le.txt:76",
   "file": "D1517le.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "体温が、死を予感させるほど冷たくなっている。",
   "ko_candidate": "체온이 죽음을 예감할 정도로 차가워지고 있다｡"
  },
  {
   "id": 48172,
   "key": "D1517le.txt:78",
   "file": "D1517le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "トラペゾヘドロンの力を無理矢理に歪めた反動は、術者にも跳ね返っていた。",
   "ko_candidate": "트라페조헤드론의 힘을 무리하게 왜곡한 반동이 술사에게도 되돌아왔던 것이다｡"
  },
  {
   "id": 48173,
   "key": "D1517le.txt:79",
   "file": "D1517le.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "向こうではアルもまた力を失い、シートに倒れている。",
   "ko_candidate": "저쪽에서는 알도 역시 힘을 잃고 시트에 쓰러져 있다｡"
  },
  {
   "id": 48174,
   "key": "D1517le.txt:83",
   "file": "D1517le.txt",
   "line": 83,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「큿…!」"
  },
  {
   "id": 48175,
   "key": "D1517le.txt:86",
   "file": "D1517le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "抱き締める腕の力がきつくなる。",
   "ko_candidate": "끌어안는 팔에 힘이 더해진다｡"
  },
  {
   "id": 48176,
   "key": "D1517le.txt:87",
   "file": "D1517le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の頭がライカの胸の中に埋まった。",
   "ko_candidate": "쿠로의 머리가 라이카의 가슴 속에 파묻혔다｡"
  },
  {
   "id": 48177,
   "key": "D1517le.txt:88",
   "file": "D1517le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "為す術も無く、ただ目覚める事を祈るしかない。",
   "ko_candidate": "어찌할 도리도 없이 그저 깨어나기를 기도할 수밖에 없다｡"
  },
  {
   "id": 48178,
   "key": "D1517le.txt:92",
   "file": "D1517le.txt",
   "line": 92,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「つっ……アアアア…… ライカァァァァッ！」",
   "ko_candidate": "「크윽… 아아아아… 라이카아아아아!」"
  },
  {
   "id": 48179,
   "key": "D1517le.txt:97",
   "file": "D1517le.txt",
   "line": 97,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「っっ！　リューガ……！」",
   "ko_candidate": "「읏! 류가…!」"
  }
 ]
}