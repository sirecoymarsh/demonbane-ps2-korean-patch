  },
  {
   "id": 8894,
   "key": "D0706le.txt:73",
   "file": "D0706le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何処かでししおどしの音が響いた。",
   "ko_candidate": "어디선가 물방울 떨어지는 소리가 울렸다｡"
  },
  {
   "id": 8895,
   "key": "D0706le.txt:76",
   "file": "D0706le.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶叫はまったく同時のタイミングだった。",
   "ko_candidate": "비명은 완전히 동시에 터져 나왔다｡"
  },
  {
   "id": 8896,
   "key": "D0706le.txt:82",
   "file": "D0706le.txt",
   "line": 82,
   "speaker": "ライカ / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くくくくくくく、 九郎ちゃんっっっっ！？」 「ららららららら、ライカさんっっっっ！？」",
   "ko_candidate": "「쿠쿠쿠쿠쿠쿠쿠､ 쿠로 짱!?」"
  },
  {
   "id": 8897,
   "key": "D0706le.txt:95",
   "file": "D0706le.txt",
   "line": 95,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃあっきゃあっきゃ ああああああああ！？」",
   "ko_candidate": "「라라라라라라라､ 라이카 씨!?」 「꺄악꺄악꺄아아아악!?」"
  },
  {
   "id": 8898,
   "key": "D0706le.txt:105",
   "file": "D0706le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "バスタオルの前を押さえて、飛び込むように湯船の中に身を沈めるライカさん。水飛沫が派手に散った。",
   "ko_candidate": "목욕 타월로 앞을 가리고 뛰어들듯이 욕조 안으로 몸을 숨기는 라이카 씨｡ 물방울이 튀었다｡"
  },
  {
   "id": 8899,
   "key": "D0706le.txt:108",
   "file": "D0706le.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "怒ったような、戸惑ったような、恨めしいような瞳で、上目使いに俺のことを睨んでいた。",
   "ko_candidate": "화난 듯､ 당황한 듯､ 원망스러운 듯한 눈동자로 올려다보며 나를 노려보고 있었다｡"
  },
  {
   "id": 8900,
   "key": "D0706le.txt:112",
   "file": "D0706le.txt",
   "line": 112,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うーうーうーっ！　ど、どうして九郎ちゃんがここにぃっ！？」",
   "ko_candidate": "「우우우우웅! 어､ 어째서 쿠로 짱이 여기에!?」"
  },
  {
   "id": 8901,
   "key": "D0706le.txt:117",
   "file": "D0706le.txt",
   "line": 117,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「だ、だって、せ、先客は俺だぞ！？　ライカさんが勝手にこっちに入ってきたんじゃないか！？」",
   "ko_candidate": "「그､ 그래도､ 먼､ 먼저 온 건 나라고! 라이카 씨가 멋대로 이쪽으로 들어온 거 아냐!?」"
  },
  {
   "id": 8902,
   "key": "D0706le.txt:122",
   "file": "D0706le.txt",
   "line": 122,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「こっちを見ないっ！」",
   "ko_candidate": "「이쪽을 보지 마!」"
  },
  {
   "id": 8903,
   "key": "D0706le.txt:126",
   "file": "D0706le.txt",
   "line": 126,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さーいえっさーッッ！」",
   "ko_candidate": "「네에에에에에!」 황급히 뒤를 돌았다｡"
  },
  {
   "id": 8904,
   "key": "D0706le.txt:137",
   "file": "D0706le.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大慌てで後ろを向いた。",
   "ko_candidate": "또다시 침묵이 장소를 지배한다｡"
  },
  {
   "id": 8905,
   "key": "D0706le.txt:138",
   "file": "D0706le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "またしても、沈黙が場を支配する。",
   "ko_candidate": "「……………………」 「……………………」"
  },
  {
   "id": 8906,
   "key": "D0706le.txt:169",
   "file": "D0706le.txt",
   "line": 169,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……………………………………うぅぅっ」",
   "ko_candidate": "「……………………………………」 「……………………………………」"
  },
  {
   "id": 8907,
   "key": "D0706le.txt:176",
   "file": "D0706le.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "沈黙が息苦しくなるほどに、重っ苦しい。",
   "ko_candidate": "「……………………………………………………」 「……………………………………………………우웅」"
  },
  {
   "id": 8908,
   "key": "D0706le.txt:177",
   "file": "D0706le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "背中に突き刺さる視線が、痛い。",
   "ko_candidate": "침묵이 숨 막힐 정도로 무거워진다｡"
  },
  {
   "id": 8909,
   "key": "D0706le.txt:180",
   "file": "D0706le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんな無言の責め苦にしばらく堪えていた。",
   "ko_candidate": "등에 꽂히는 시선이 아프다｡ 그런 무언의 고통을 잠시 견디고 있었다｡"
  },
  {
   "id": 8910,
   "key": "D0706le.txt:184",
   "file": "D0706le.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "やがて、気が抜けたようなライカさんの溜め息が、背中越しに聞こえてきた。",
   "ko_candidate": "이윽고 기가 빠진 듯한 라이카 씨의 한숨이 등 너머로 들려왔다｡"
  },
  {
   "id": 8911,
   "key": "D0706le.txt:188",
   "file": "D0706le.txt",
   "line": 188,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふぅぅ～～～～。そうか…… 忘れてたけど、混浴だったっけ。 ここ」",
   "ko_candidate": "「후우우~~~~~｡ 그렇구나……잊고 있었지만､ 혼탕이었지｡ 여기」"
  },
  {
   "id": 8912,
   "key": "D0706le.txt:195",
   "file": "D0706le.txt",
   "line": 195,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そう……だったみたいだねえ」",
   "ko_candidate": "「그렇……던 것 같네」"
  },
  {
   "id": 8913,
   "key": "D0706le.txt:200",
   "file": "D0706le.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "でも俺が悪いんじゃないのに、何でこんな居心地の悪ィ気分を味わわなきゃならないんだ。納得がいかねえぞ。",
   "ko_candidate": "하지만 왜 내가 잘못한 것도 아닌데 이런 불편한 기분을 맛봐야 하는 거지｡ 납득이 안 가는군｡"
  },
  {
   "id": 8914,
   "key": "D0706le.txt:205",
   "file": "D0706le.txt",
   "line": 205,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「まぁ、仕方ありませんっ。不可抗力ですし、特別に許してあげますっ」",
   "ko_candidate": "「뭐､ 어쩔 수 없죠｡ 불가항력이니까 특별히 용서해 드릴게요」"
  },
  {
   "id": 8915,
   "key": "D0706le.txt:210",
   "file": "D0706le.txt",
   "line": 210,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや、最初に入ってたのは俺だっつーの」",
   "ko_candidate": "「아니､ 그러니까 먼저 들어와 있던 건 내가 먼저라고」 「뭐 불만이라도?」"
  },
  {
   "id": 8916,
   "key": "D0706le.txt:215",
   "file": "D0706le.txt",
   "line": 215,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……何か文句でも？」",
   "ko_candidate": "「아､ 아니오､ 아아아!」"
  },
  {
   "id": 8917,
   "key": "D0706le.txt:220",
   "file": "D0706le.txt",
   "line": 220,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さー、のおぉ、さぁぁぁっ！」",
   "ko_candidate": "세상이란 건 불합리하다｡ 「후후훗」"
  },
  {
   "id": 8918,
   "key": "D0706le.txt:225",
   "file": "D0706le.txt",
   "line": 225,
   "speaker": "ライカ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "世の中って、理不尽だ。 「ふふふっ」",
   "ko_candidate": "돌연 라이카 씨가 웃기 시작했다｡"
  },
  {
   "id": 8919,
   "key": "D0706le.txt:245",
   "file": "D0706le.txt",
   "line": 245,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っ!?　ら、ライカさんっ！？」",
   "ko_candidate": "그리고―― 「……읏!? 라､ 라이카 씨!?」"
  },
  {
   "id": 8920,
   "key": "D0706le.txt:250",
   "file": "D0706le.txt",
   "line": 250,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「こらぁっ、動くなぁ」",
   "ko_candidate": "「이봐､ 움직이지 마」"
  },
  {
   "id": 8921,
   "key": "D0706le.txt:254",
   "file": "D0706le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "背中にぴたりと合わさる肌の感触があった。ライカさんが自分の背中を、俺の背中に預けてきたのだ。",
   "ko_candidate": "등에 딱 붙는 피부의 감촉이 있었다｡ 라이카 씨가 자신의 등을 내 등에 기대온 것이다｡"
  }
 ]
