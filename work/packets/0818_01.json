 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "クトゥグア": "크투가",
  "イタクァ": "이타콰",
  "術式": "술식",
  "魔力": "마력",
  "ティマイオス": "티마이오스",
  "クリティアス": "크리티아스",
  "ロードビヤーキー": "로드 비야키",
  "クラーケン": "크라켄",
  "ネームレス・ワン": "네임리스 원"
 },
 "items": [
  {
   "id": 17153,
   "key": "D0818le.txt:221",
   "file": "D0818le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "荒れ狂う焔を纏った獣を、放電する光として圧縮。",
   "ko_candidate": "광란하는 화염을 두른 짐승을､ 방전하는 빛으로 압축｡"
  },
  {
   "id": 17154,
   "key": "D0818le.txt:222",
   "file": "D0818le.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在力の密度を増し、物質化。",
   "ko_candidate": "존재력의 밀도를 높여､ 물질화｡"
  },
  {
   "id": 17155,
   "key": "D0818le.txt:223",
   "file": "D0818le.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは右手を伸ばす。",
   "ko_candidate": "데몬베인은 오른손을 뻗는다｡"
  },
  {
   "id": 17156,
   "key": "D0818le.txt:233",
   "file": "D0818le.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重厚なる黒。苛烈なる赤。装飾を施されながらも無骨。何より凶暴。",
   "ko_candidate": "중후한 검정｡ 맹렬한 빨강｡ 장식이 되어 있으면서도 투박｡ 무엇보다 흉포｡"
  },
  {
   "id": 17157,
   "key": "D0818le.txt:234",
   "file": "D0818le.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "前面下方に設置された弾倉に闘志を装填する破壊の象徴。",
   "ko_candidate": "전면 하방에 설치된 탄창에 투지를 장전하는 파괴의 상징｡"
  },
  {
   "id": 17158,
   "key": "D0818le.txt:235",
   "file": "D0818le.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自動拳銃『クトゥグア』。",
   "ko_candidate": "자동 권총 『크투가』｡"
  },
  {
   "id": 17159,
   "key": "D0818le.txt:242",
   "file": "D0818le.txt",
   "line": 242,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イタクァ」",
   "ko_candidate": "「이타콰」"
  },
  {
   "id": 17160,
   "key": "D0818le.txt:246",
   "file": "D0818le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き荒む冷気を纏った竜を、沈黙する結晶として圧縮。",
   "ko_candidate": "휘몰아치는 냉기를 두른 용을､ 침묵하는 결정으로 압축｡"
  },
  {
   "id": 17161,
   "key": "D0818le.txt:247",
   "file": "D0818le.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在力の密度を増し、物質化。",
   "ko_candidate": "존재력의 밀도를 높여､ 물질화｡"
  },
  {
   "id": 17162,
   "key": "D0818le.txt:248",
   "file": "D0818le.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは左手を伸ばす。",
   "ko_candidate": "데몬베인은 왼손을 뻗는다｡"
  },
  {
   "id": 17163,
   "key": "D0818le.txt:258",
   "file": "D0818le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "精錬された銀。耽美なる銀。研ぎ澄まされた刃の如く美麗。",
   "ko_candidate": "정련된 은｡ 탐미적인 은｡ 연마된 칼날과 같이 아름다움｡"
  },
  {
   "id": 17164,
   "key": "D0818le.txt:259",
   "file": "D0818le.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何より冷酷。",
   "ko_candidate": "무엇보다 냉혹｡"
  },
  {
   "id": 17165,
   "key": "D0818le.txt:260",
   "file": "D0818le.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "６ある弾倉の最下部より死を吐き出す殺意の象徴。",
   "ko_candidate": "6개의 탄창 중 최하부에서 죽음을 토해내는 살의의 상징｡"
  },
  {
   "id": 17166,
   "key": "D0818le.txt:261",
   "file": "D0818le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "回転式拳銃『イタクァ』。",
   "ko_candidate": "회전식 권총 『이타콰』｡"
  },
  {
   "id": 17167,
   "key": "D0818le.txt:273",
   "file": "D0818le.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２挺の殺意を、今、デモンベインが手に執る。",
   "ko_candidate": "2정의 살의를､ 지금､ 데몬베인이 손에 쥔다｡"
  },
  {
   "id": 17168,
   "key": "D0818le.txt:278",
   "file": "D0818le.txt",
   "line": 278,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……あの魔導銃の術式を解読し、デモンベイン用の魔導兵器として、神獣を収める器として再構成――錬金したのか！」",
   "ko_candidate": "「……저 마도총의 술식을 해독하고､ 데몬베인용 마도병기로서､ 신수를 담는 그릇으로 재구성――연금한 건가!」"
  },
  {
   "id": 17169,
   "key": "D0818le.txt:288",
   "file": "D0818le.txt",
   "line": 288,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「クッ……!? 術種選択：魔砲弾ッ！」",
   "ko_candidate": "「큭……!? 술종선택: 마포탄!」"
  },
  {
   "id": 17170,
   "key": "D0818le.txt:296",
   "file": "D0818le.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再び、高密度の魔力弾が、雄叫びにも似た爆音を轟かせ、",
   "ko_candidate": "다시､ 고밀도의 마력탄이､ 포효와도 같은 폭음을 울리며､"
  },
  {
   "id": 17171,
   "key": "D0818le.txt:297",
   "file": "D0818le.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "飛んでくる。",
   "ko_candidate": "날아온다｡"
  },
  {
   "id": 17172,
   "key": "D0818le.txt:301",
   "file": "D0818le.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊の呪法によって空間が爆砕する――より早く、デモンベインの足元が爆砕する。",
   "ko_candidate": "파괴의 주법으로 공간이 폭쇄되는――그보다 빠르게､ 데몬베인의 발밑이 폭쇄된다｡"
  },
  {
   "id": 17173,
   "key": "D0818le.txt:304",
   "file": "D0818le.txt",
   "line": 304,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「断鎖術式壱号ティマイオス、弐号クリティアス！」",
   "ko_candidate": "「단쇄술식 1호 티마이오스､ 2호 크리티오스!」"
  },
  {
   "id": 17174,
   "key": "D0818le.txt:312",
   "file": "D0818le.txt",
   "line": 312,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――!?」",
   "ko_candidate": "「――!?」"
  },
  {
   "id": 17175,
   "key": "D0818le.txt:318",
   "file": "D0818le.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時空間歪曲エネルギーを一気に開放する。",
   "ko_candidate": "시공간 왜곡 에너지를 단번에 개방한다｡"
  },
  {
   "id": 17176,
   "key": "D0818le.txt:320",
   "file": "D0818le.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラーケンとロードビヤーキーの猛攻を受け、クトゥグアとイタクァの招喚によってダメージを負い、満身創痍のデモンベインは、それでも凄まじい推進力と機動性を発揮した。",
   "ko_candidate": "크라켄과 로드 비야키의 맹공을 받고､ 크투가와 이타콰의 소환으로 데미지를 입어､ 만신창이의 데몬베인은､ 그래도 굉장한 추진력과 기동성을 발휘했다｡"
  },
  {
   "id": 17177,
   "key": "D0818le.txt:323",
   "file": "D0818le.txt",
   "line": 323,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵の目からは消えたようにも見えたかも知れない。",
   "ko_candidate": "적의 눈에서는 사라진 것처럼 보였을지도 모른다｡"
  },
  {
   "id": 17178,
   "key": "D0818le.txt:325",
   "file": "D0818le.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊呪法の爆発は咲いたばかりで、まだ最大範囲まで",
   "ko_candidate": "파괴주법의 폭발은 막 피어난 상태로､ 아직 최대 범위까지"
  },
  {
   "id": 17179,
   "key": "D0818le.txt:326",
   "file": "D0818le.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拡がり切らない。",
   "ko_candidate": "퍼지지 않았다｡"
  },
  {
   "id": 17180,
   "key": "D0818le.txt:330",
   "file": "D0818le.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし既にデモンベインはネームレス・ワンの眼前まで跳躍していた。",
   "ko_candidate": "하지만 이미 데몬베인은 네임리스 원의 눈앞까지 도약해 있었다｡"
  },
  {
   "id": 17181,
   "key": "D0818le.txt:335",
   "file": "D0818le.txt",
   "line": 335,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「速――」",
   "ko_candidate": "「빠르――」"
  },
  {
   "id": 17182,
   "key": "D0818le.txt:342",
   "file": "D0818le.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眼下のネームレス・ワンに向けて、拳銃を水平に並べて突きつける。",
   "ko_candidate": "아래의 네임리스 원을 향해､ 권총을 수평으로 나란히 들이댄다｡"
  },
  {
   "id": 17183,
   "key": "D0818le.txt:344",
   "file": "D0818le.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "距離はほとんどゼロに近い。",
   "ko_candidate": "거리는 거의 제로에 가깝다｡"
  },
  {
   "id": 17184,
   "key": "D0818le.txt:345",
   "file": "D0818le.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶対に、外すことは、ない。",
   "ko_candidate": "절대로､ 빗나갈 리가､ 없다｡"
  },
  {
   "id": 17185,
   "key": "D0818le.txt:347",
   "file": "D0818le.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆炎がデモンベインを、ネームレス・ワンを紅く照らしている――",
   "ko_candidate": "폭염이 데몬베인을､ 네임리스 원을 붉게 비추고 있다――"
  },
  {
   "id": 17186,
   "key": "D0818le.txt:350",
   "file": "D0818le.txt",
   "line": 350,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――散華しろ」",
   "ko_candidate": "「――산화해라」"
  },
  {
   "id": 17187,
   "key": "D0818le.txt:357",
   "file": "D0818le.txt",
   "line": 357,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃口が火を噴いた。",
   "ko_candidate": "총구가 불을 뿜었다｡"
  },
  {
   "id": 17188,
   "key": "D0818le.txt:359",
   "file": "D0818le.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も考える必要はない。",
   "ko_candidate": "아무것도 생각할 필요가 없다｡"
  },
  {
   "id": 17189,
   "key": "D0818le.txt:360",
   "file": "D0818le.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ殺意を込めた弾丸の総てを敵に叩き込むだけで良い。",
   "ko_candidate": "그저 살의를 담은 탄환의 모든 것을 적에게 퍼부으면 된다｡"
  },
  {
   "id": 17190,
   "key": "D0818le.txt:368",
   "file": "D0818le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから攻撃し、",
   "ko_candidate": "그래서 공격하고､"
  },
  {
   "id": 17191,
   "key": "D0818le.txt:368",
   "file": "D0818le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃撃し、",
   "ko_candidate": "총격하고､"
  },
  {
   "id": 17192,
   "key": "D0818le.txt:368",
   "file": "D0818le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "打撃し、",
   "ko_candidate": "타격하고､"
  }
 ]
}