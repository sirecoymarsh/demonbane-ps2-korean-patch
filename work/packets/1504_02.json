 "items": [
  {
   "id": 42210,
   "key": "D1504al.txt:506",
   "file": "D1504al.txt",
   "line": 506,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――ッ！　ああ、頼む！」",
   "ko_candidate": "「…! 응､ 부탁해!」"
  },
  {
   "id": 42211,
   "key": "D1504al.txt:509",
   "file": "D1504al.txt",
   "line": 509,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一も二も無く、俺は頷いた。",
   "ko_candidate": "주저 없이 나는 고개를 끄덕였다｡"
  },
  {
   "id": 42212,
   "key": "D1504al.txt:527",
   "file": "D1504al.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "前方に立ち塞がる、巨大な扉。 ヨグ＝ソトースの門。",
   "ko_candidate": "전방의 수평선을 가로막는､ 광기 어린 거대함의 문｡"
  },
  {
   "id": 42213,
   "key": "D1504al.txt:531",
   "file": "D1504al.txt",
   "line": 531,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あまりにも巨大過ぎて、広大過ぎて、全貌は無論のこと、目標までの距離感も掴めない。",
   "ko_candidate": "요그 소토스의 문｡ 너무나도 거대하고､ 광대해서､ 전모는 물론이고 목표까지의 거리감조차 가늠할 수 없다｡"
  },
  {
   "id": 42214,
   "key": "D1504al.txt:544",
   "file": "D1504al.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その水平線の果てを目指し、デモンベインはただひたすらに翔び続ける。",
   "ko_candidate": "그 수평선의 끝을 향해 데몬베인은 오로지 계속해서 날아간다｡"
  },
  {
   "id": 42215,
   "key": "D1504al.txt:553",
   "file": "D1504al.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふと、背面を映し出すモニターに目を向けた。",
   "ko_candidate": "문득 후방을 비추는 모니터에 시선을 돌렸다｡"
  },
  {
   "id": 42216,
   "key": "D1504al.txt:554",
   "file": "D1504al.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "芥子粒の様に小さくなった、連合軍の艦隊。",
   "ko_candidate": "겨자씨만큼 작아진 연합군의 함대｡"
  },
  {
   "id": 42217,
   "key": "D1504al.txt:557",
   "file": "D1504al.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの芥子粒の一つに、九郎が居るのだ。",
   "ko_candidate": "저 겨자씨 하나에 쿠로가 있는 것이다｡ ――그만둬｡ 미련이다｡"
  },
  {
   "id": 42218,
   "key": "D1504al.txt:566",
   "file": "D1504al.txt",
   "line": 566,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――止めろ。未練だ。",
   "ko_candidate": "스스로를 경계한다｡"
  },
  {
   "id": 42219,
   "key": "D1504al.txt:569",
   "file": "D1504al.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自らを戒める。心の中で別れを告げ、アルは再び前方のヨグ＝ソトースに向き直……ろうとした、ちょうどその時。",
   "ko_candidate": "마음속으로 작별을 고하고 알은 다시 전방의 요그 소토스를 향해 돌아 ……보려 했을 때였다｡"
  },
  {
   "id": 42220,
   "key": "D1504al.txt:579",
   "file": "D1504al.txt",
   "line": 579,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――？」",
   "ko_candidate": "「――――?」"
  },
  {
   "id": 42221,
   "key": "D1504al.txt:590",
   "file": "D1504al.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "艦隊の方角。夜空を裂いて疾る極小の光点が、高速でデモンベインに迫っていた。不審に感じ、モニターの映像を拡大。",
   "ko_candidate": "함대 방향｡ 밤하늘을 가르며 달리는 극소의 광점이 고속으로 데몬베인에 다가오고 있었다｡ 의심스러워 모니터의 영상을 확대했다｡"
  },
  {
   "id": 42222,
   "key": "D1504al.txt:593",
   "file": "D1504al.txt",
   "line": 593,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――凍りついた。",
   "ko_candidate": "――얼어붙었다｡"
  },
  {
   "id": 42223,
   "key": "D1504al.txt:604",
   "file": "D1504al.txt",
   "line": 604,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "モニターの映像も、感知する魔力の気配も同等の解を導き出した。",
   "ko_candidate": "모니터의 영상도､ 감지되는 마력의 기척도 동일한 해답을 도출해냈다｡ 하얀 갑옷을 입고 하늘을 질주하는 메타트론｡"
  },
  {
   "id": 42224,
   "key": "D1504al.txt:607",
   "file": "D1504al.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "白い装甲に身を包み、空を疾走するメタトロン。 そしてその背中には――",
   "ko_candidate": "그리고 그 등에는{SE_PLAY(1,\"メタトロン高速飛行\",0,85,false);}――"
  },
  {
   "id": 42225,
   "key": "D1504al.txt:623",
   "file": "D1504al.txt",
   "line": 623,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……九郎」",
   "ko_candidate": "「……쿠로」"
  },
  {
   "id": 42226,
   "key": "D1504al.txt:628",
   "file": "D1504al.txt",
   "line": 628,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただその名を口にしただけで、アルの心臓は激しく鼓動を打った。",
   "ko_candidate": "그저 그 이름을 입에 담았을 뿐인데､ 알의 심장은 격렬하게 고동쳤다｡ 모니터 안에｡"
  },
  {
   "id": 42227,
   "key": "D1504al.txt:631",
   "file": "D1504al.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "モニターの中。凄まじい風圧に耐えながらも、真っ直ぐにデモンベインを見つめる九郎が居る。",
   "ko_candidate": "엄청난 풍압을 견디면서도 똑바로 데몬베인을 바라보는 쿠로가 있다｡"
  },
  {
   "id": 42228,
   "key": "D1504al.txt:634",
   "file": "D1504al.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の視線がアルを貫いている。",
   "ko_candidate": "쿠로의 시선이 알을 관통하고 있다｡"
  },
  {
   "id": 42229,
   "key": "D1504al.txt:635",
   "file": "D1504al.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸が高鳴る。",
   "ko_candidate": "심장이 난무한다｡"
  },
  {
   "id": 42230,
   "key": "D1504al.txt:636",
   "file": "D1504al.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "締め付けられるような痛みを感じる。",
   "ko_candidate": "땀이 분출한다｡"
  },
  {
   "id": 42231,
   "key": "D1504al.txt:640",
   "file": "D1504al.txt",
   "line": 640,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "翡翠の瞳が揺れた。",
   "ko_candidate": "비취빛 눈동자가 흔들렸다｡"
  },
  {
   "id": 42232,
   "key": "D1504al.txt:641",
   "file": "D1504al.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歓喜が入り混じった躊躇が、瞳の奥で息吹きだした。",
   "ko_candidate": "환희가 뒤섞인 주저함이 눈동자 안쪽에서 숨을 쉬기 시작했다｡"
  },
  {
   "id": 42233,
   "key": "D1504al.txt:649",
   "file": "D1504al.txt",
   "line": 649,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――駄目だ。",
   "ko_candidate": "――안 돼｡"
  },
  {
   "id": 42234,
   "key": "D1504al.txt:652",
   "file": "D1504al.txt",
   "line": 652,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心の内に生じた衝動を無理矢理に封印する。",
   "ko_candidate": "억지로 마음속에 생긴 충동을 봉인한다｡"
  },
  {
   "id": 42235,
   "key": "D1504al.txt:653",
   "file": "D1504al.txt",
   "line": 653,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "首を何度も横に振った。",
   "ko_candidate": "고개를 여러 번 가로저었다｡"
  },
  {
   "id": 42236,
   "key": "D1504al.txt:656",
   "file": "D1504al.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駄目だ。",
   "ko_candidate": "안 돼｡"
  },
  {
   "id": 42237,
   "key": "D1504al.txt:657",
   "file": "D1504al.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処で惑ってはいけない。",
   "ko_candidate": "여기서 망설여선 안 된다｡"
  },
  {
   "id": 42238,
   "key": "D1504al.txt:664",
   "file": "D1504al.txt",
   "line": 664,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うつけが……わざわざ追って来る奴が何処に居るか」",
   "ko_candidate": "「멍청이……일부러 쫓아오는 녀석이 어디 있냐」"
  },
  {
   "id": 42239,
   "key": "D1504al.txt:678",
   "file": "D1504al.txt",
   "line": 678,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "メタトロンを、九郎を、九郎の視線を、自らの想いを振り切るため、アルはシャンタクを加速させる。",
   "ko_candidate": "메타트론을､ 쿠로를､ 쿠로의 시선을､ 자신의 마음을 떨쳐내기 위해"
  },
  {
   "id": 42240,
   "key": "D1504al.txt:693",
   "file": "D1504al.txt",
   "line": 693,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ドちくしょうっ！ あの馬鹿っ、さらにスピードを上げやがった！」",
   "ko_candidate": "알은 샨타크를 더욱 가속시킨다｡ 「젠장! 저 바보가､ 더 속도를 올렸잖아!」"
  },
  {
   "id": 42241,
   "key": "D1504al.txt:697",
   "file": "D1504al.txt",
   "line": 697,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これで分かった。決定的だ。",
   "ko_candidate": "이걸로 알았다｡ 결정적이다｡"
  },
  {
   "id": 42242,
   "key": "D1504al.txt:698",
   "file": "D1504al.txt",
   "line": 698,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あいつの意図ははっきりと知れた。",
   "ko_candidate": "저 녀석의 의도는 확실히 알 수 있었다｡"
  },
  {
   "id": 42243,
   "key": "D1504al.txt:701",
   "file": "D1504al.txt",
   "line": 701,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの女……本当に独りで戦いに向かうつもりだ。",
   "ko_candidate": "저 여자……정말로 혼자서 싸움에 나설 생각이다｡"
  },
  {
   "id": 42244,
   "key": "D1504al.txt:704",
   "file": "D1504al.txt",
   "line": 704,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ムカついた。",
   "ko_candidate": "머릿속이 들끓는다｡"
  },
  {
   "id": 42245,
   "key": "D1504al.txt:705",
   "file": "D1504al.txt",
   "line": 705,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "本気でムカついた。",
   "ko_candidate": "열 받았다｡ 정말로 열 받았다｡"
  },
  {
   "id": 42246,
   "key": "D1504al.txt:706",
   "file": "D1504al.txt",
   "line": 706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心底、ムカついた。",
   "ko_candidate": "뼛속까지 열 받았다｡"
  },
  {
   "id": 42247,
   "key": "D1504al.txt:710",
   "file": "D1504al.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人のこと散々振り回して、散々偉そうなことホザきやがって、だけど結局……何だかんだ言っときながら結局――！",
   "ko_candidate": "뭐야､ 저 녀석……남을 산전수전 끌고 다니더니､ 온갖 잘난 척을 해대더니､ 하지만 결국､ 이러쿵저러쿵 말해놓고 결국――!"
  },
  {
   "id": 42248,
   "key": "D1504al.txt:715",
   "file": "D1504al.txt",
   "line": 715,
   "speaker": "九郎 / メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「俺のこと、信頼してなかった……って、 そーいうことじゃねえかよ！　ザケんな、馬鹿！」 「あまり喋ると舌を噛むぞ」",
   "ko_candidate": "「나를 신뢰하지 않았다……라､ 그런 거 아냐! 「개소리 하지 마､ 바보야!」 「말이 많으면 혀를 깨물 거다」 「부부부부부부욱!?」 「――늦었나」 「~~~~~~~~~~~으으으으으으읍! 에에에에에잇!"
  },
  {
   "id": 42249,
   "key": "D1504al.txt:732",
   "file": "D1504al.txt",
   "line": 732,
   "speaker": "九郎 / メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふぶぐぶぉっ！？」 「――遅かったか」",
   "ko_candidate": "좀 더 속도를 올려줘!」"
  }
 ]
}