{
 "packet": "0801_02",
 "scene": "0801",
 "anchor": {
  "hit": 49,
  "total": 61,
  "rate": 0.803
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "ライカ": "라이카",
  "魔力": "마력",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 11823,
   "key": "D0801al.txt:583",
   "file": "D0801al.txt",
   "line": 583,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クソ生意気で自分勝手で傲岸不遜で傍若無人で",
   "ko_candidate": "오만방자하고､ 제 멋대로고､"
  },
  {
   "id": 11824,
   "key": "D0801al.txt:584",
   "file": "D0801al.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "天上天下唯我独尊で救いようもない人外化生ではあるが――不愉快ではない。",
   "ko_candidate": "천상천하 유아독존이고､ 구제불능의 인외괴물이긴 하지만――불쾌하지는 않다｡"
  },
  {
   "id": 11825,
   "key": "D0801al.txt:587",
   "file": "D0801al.txt",
   "line": 587,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつと一緒にいるのは、そこそこに居心地が良い。",
   "ko_candidate": "이 녀석과 함께 있는 것은､ 그럭저럭 편안하다｡"
  },
  {
   "id": 11826,
   "key": "D0801al.txt:590",
   "file": "D0801al.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "では、こいつは俺にとっての何なのか？",
   "ko_candidate": "그럼､ 이 녀석은 나에게 있어서 무엇인가?"
  },
  {
   "id": 11827,
   "key": "D0801al.txt:591",
   "file": "D0801al.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また、その逆は？",
   "ko_candidate": "또､ 그 반대는?"
  },
  {
   "id": 11828,
   "key": "D0801al.txt:594",
   "file": "D0801al.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……考えたところで仕方ないか。",
   "ko_candidate": "……생각해 봤자 소용없나｡"
  },
  {
   "id": 11829,
   "key": "D0801al.txt:596",
   "file": "D0801al.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "変に鋳型にはめ込もうとするからギクシャクする。",
   "ko_candidate": "이상하게 틀에 맞추려고 하니까 어색해지는 거야｡"
  },
  {
   "id": 11830,
   "key": "D0801al.txt:597",
   "file": "D0801al.txt",
   "line": 597,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうするには、アルとの関係は色々と複雑すぎる。",
   "ko_candidate": "그러려면､ 알과의 관계는 여러모로 너무 복잡해｡"
  },
  {
   "id": 11831,
   "key": "D0801al.txt:600",
   "file": "D0801al.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あるがまま、感じるがままに受け止めていけば良い……そう思う。",
   "ko_candidate": "있는 그대로､ 느끼는 대로 받아들이면 돼… 그렇게 생각해｡"
  },
  {
   "id": 11832,
   "key": "D0801al.txt:605",
   "file": "D0801al.txt",
   "line": 605,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ふぅ」",
   "ko_candidate": "「……후우」"
  },
  {
   "id": 11833,
   "key": "D0801al.txt:613",
   "file": "D0801al.txt",
   "line": 613,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さっきから何なのだ、汝は……」",
   "ko_candidate": "「아까부터 뭐야､ 네놈은……」"
  },
  {
   "id": 11834,
   "key": "D0801al.txt:631",
   "file": "D0801al.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "濡れた身体を拭いて、食卓についた。",
   "ko_candidate": "젖은 몸을 닦고､ 식탁에 앉았다｡"
  },
  {
   "id": 11835,
   "key": "D0801al.txt:633",
   "file": "D0801al.txt",
   "line": 633,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当は着替えたいところだが、アルはともかく俺のサイズに合う服がない。",
   "ko_candidate": "사실은 갈아입고 싶지만､ 알은 그렇다 치고 내 사이즈에 맞는 옷이 없다｡"
  },
  {
   "id": 11836,
   "key": "D0801al.txt:635",
   "file": "D0801al.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仕方がないからとりあえず濡れた服は脱いで乾かしといて、タオルを身体に巻いたまま夕飯を食べた。",
   "ko_candidate": "어쩔 수 없이 일단 젖은 옷은 벗어서 말리고､ 나는 수건을 몸에 두른 채로 저녁을 먹었다｡"
  },
  {
   "id": 11837,
   "key": "D0801al.txt:637",
   "file": "D0801al.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ガキんちょどもに、からかわれたのは言うまでもない。",
   "ko_candidate": "꼬마들에게 놀림 받은 건 말할 것도 없다｡"
  },
  {
   "id": 11838,
   "key": "D0801al.txt:654",
   "file": "D0801al.txt",
   "line": 654,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……止みそうにもないわね」",
   "ko_candidate": "「……그칠 것 같지 않네요」"
  },
  {
   "id": 11839,
   "key": "D0801al.txt:659",
   "file": "D0801al.txt",
   "line": 659,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "外もすっかり暗くなった。",
   "ko_candidate": "밖도 완전히 어두워졌다｡"
  },
  {
   "id": 11840,
   "key": "D0801al.txt:660",
   "file": "D0801al.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんの言うとおり止む気配はまったくない。",
   "ko_candidate": "라이카 씨의 말대로､ 그칠 기미가 전혀 없다｡"
  },
  {
   "id": 11841,
   "key": "D0801al.txt:661",
   "file": "D0801al.txt",
   "line": 661,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どんどん強くなる一方だ。",
   "ko_candidate": "점점 더 강해지기만 한다｡"
  },
  {
   "id": 11842,
   "key": "D0801al.txt:665",
   "file": "D0801al.txt",
   "line": 665,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仕方ない……お暇することにしよう。",
   "ko_candidate": "어쩔 수 없어… 이만 가봐야겠다｡"
  },
  {
   "id": 11843,
   "key": "D0801al.txt:668",
   "file": "D0801al.txt",
   "line": 668,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "服はあまり乾いていない。冷たい服にもう一度、袖を通すのは堪えたが、まさか裸で帰るワケにはいかないので我慢する。",
   "ko_candidate": "옷은 별로 마르지 않았다｡ 차가운 옷에 다시 한 번 소매를 끼우는 건 견디기 힘들었지만､ 설마 벗은 채로 갈 수는 없으니까 참는다｡"
  },
  {
   "id": 11844,
   "key": "D0801al.txt:672",
   "file": "D0801al.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんから傘を借りて、アルと２人並んで、帰路についた。",
   "ko_candidate": "라이카 씨에게서 우산을 빌려 알과 둘이 나란히 귀로에 올랐다｡"
  },
  {
   "id": 11845,
   "key": "D0801al.txt:689",
   "file": "D0801al.txt",
   "line": 689,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……凄まじい雨。",
   "ko_candidate": "……굉장한 비다｡"
  },
  {
   "id": 11846,
   "key": "D0801al.txt:692",
   "file": "D0801al.txt",
   "line": 692,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あらゆる音を掻き消すほどの豪雨は爆音のようで。",
   "ko_candidate": "모든 소리를 지워버릴 정도의 폭우는 폭음 같아서｡"
  },
  {
   "id": 11847,
   "key": "D0801al.txt:693",
   "file": "D0801al.txt",
   "line": 693,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空から降り注ぐ無数の雫は、視界を閉ざすほどだ。",
   "ko_candidate": "하늘에서 쏟아지는 무수한 물방울은 시야를 가릴 정도다｡"
  },
  {
   "id": 11848,
   "key": "D0801al.txt:696",
   "file": "D0801al.txt",
   "line": 696,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――まったく鬱陶しい雨だ。",
   "ko_candidate": "――정말 짜증 나는 비다｡"
  },
  {
   "id": 11849,
   "key": "D0801al.txt:711",
   "file": "D0801al.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雨に打たれて……と言うより叩きつけられ、重くすらある傘をかざしつつ、何とか事務所の前にたどり着いた。",
   "ko_candidate": "비를 맞으며… 라기보다는 맞아가며､ 무겁기까지 한 우산을 쓰면서 어떻게든 사무실 앞에 도착했다｡"
  },
  {
   "id": 11850,
   "key": "D0801al.txt:714",
   "file": "D0801al.txt",
   "line": 714,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傘を差しているのに、ズボンとか、靴の中とかはびしょ濡れだ。",
   "ko_candidate": "우산을 쓰고 있는데도 바지 끝이나 신발 안 같은 곳은 흠뻑 젖었다｡"
  },
  {
   "id": 11851,
   "key": "D0801al.txt:720",
   "file": "D0801al.txt",
   "line": 720,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まったく…… さっさと中に入ってシャワーでも……」",
   "ko_candidate": "「정말… 빨리 안으로 들어가서 샤워라도…」"
  },
  {
   "id": 11852,
   "key": "D0801al.txt:724",
   "file": "D0801al.txt",
   "line": 724,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふと。",
   "ko_candidate": "문득｡"
  },
  {
   "id": 11853,
   "key": "D0801al.txt:738",
   "file": "D0801al.txt",
   "line": 738,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "豪雨に奪われた視界に、だが亡霊か人魂のように、幽幻と揺らめく光が飛び込んできた。",
   "ko_candidate": "폭우에 빼앗긴 시야에､ 하지만 유령이나 인혼처럼､ 유현하게 흔들리는 빛이 뛰어들어왔다｡"
  },
  {
   "id": 11854,
   "key": "D0801al.txt:741",
   "file": "D0801al.txt",
   "line": 741,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光は路地裏の闇の奥、亡……と燃え揺らいでいた。",
   "ko_candidate": "빛은 골목 안쪽의 어둠 속에서 죽… 아니 타오르며 흔들리고 있었다｡"
  },
  {
   "id": 11855,
   "key": "D0801al.txt:746",
   "file": "D0801al.txt",
   "line": 746,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル……あれ」",
   "ko_candidate": "「알… 저거」"
  },
  {
   "id": 11856,
   "key": "D0801al.txt:755",
   "file": "D0801al.txt",
   "line": 755,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……幽かだが、魔力の気配がある」",
   "ko_candidate": "「……희미하지만､ 마력의 기척이 있어」"
  },
  {
   "id": 11857,
   "key": "D0801al.txt:761",
   "file": "D0801al.txt",
   "line": 761,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の正体を確かめるため、路地裏に入った。",
   "ko_candidate": "빛의 정체를 확인하기 위해 골목으로 들어갔다｡"
  },
  {
   "id": 11858,
   "key": "D0801al.txt:780",
   "file": "D0801al.txt",
   "line": 780,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鬼火に魅入られ、引き寄せられる旅人の気分。",
   "ko_candidate": "윌오위스프에 매혹되어 이끌리는 여행자의 기분｡"
  },
  {
   "id": 11859,
   "key": "D0801al.txt:783",
   "file": "D0801al.txt",
   "line": 783,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光を求めて、狭い路を進み……",
   "ko_candidate": "빛을 찾아 좁은 길을 나아가… 「사라졌어?」"
  },
  {
   "id": 11860,
   "key": "D0801al.txt:795",
   "file": "D0801al.txt",
   "line": 795,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「消えた？」",
   "ko_candidate": "「쿠로――저기에」"
  },
  {
   "id": 11861,
   "key": "D0801al.txt:800",
   "file": "D0801al.txt",
   "line": 800,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎――あそこに」",
   "ko_candidate": "「엣?」 ――마주친 것이다｡"
  },
  {
   "id": 11862,
   "key": "D0801al.txt:806",
   "file": "D0801al.txt",
   "line": 806,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えっ？」",
   "ko_candidate": "「……이봐 이봐」"
  }
 ]
}