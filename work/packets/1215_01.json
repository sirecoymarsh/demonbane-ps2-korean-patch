 "items": [
  {
   "id": 30320,
   "key": "D1215le.txt:150",
   "file": "D1215le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然の轟風に吹き飛ばされ、木の葉のように舞う。",
   "ko_candidate": "갑작스러운 돌풍에 날려 나뭇잎처럼 휘날린다｡"
  },
  {
   "id": 30321,
   "key": "D1215le.txt:151",
   "file": "D1215le.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気を破壊するかのような轟音が耳を劈く。",
   "ko_candidate": "대기를 파괴하는 듯한 굉음이 귀를 찢는다｡"
  },
  {
   "id": 30322,
   "key": "D1215le.txt:159",
   "file": "D1215le.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、視界いっぱいに広がる鬼械神の姿――！",
   "ko_candidate": "그리고 시야 가득 펼쳐지는 귀계신의 모습--!"
  },
  {
   "id": 30323,
   "key": "D1215le.txt:160",
   "file": "D1215le.txt",
   "line": 160,
   "speaker": "ちびアル",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "奴め！　こっちに向かって、突っ込んできやがった！ 「――――…………！」",
   "ko_candidate": "이놈! 이쪽을 향해 돌진해 오고 있어!"
  },
  {
   "id": 30324,
   "key": "D1215le.txt:170",
   "file": "D1215le.txt",
   "line": 170,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っ……ぁ！」",
   "ko_candidate": "「--……」 「…윽…아!」"
  },
  {
   "id": 30325,
   "key": "D1215le.txt:172",
   "file": "D1215le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの声はおろか、自分の声すら聴こえない。",
   "ko_candidate": "알의 목소리는커녕 자신의 목소리조차 들리지 않는다｡"
  },
  {
   "id": 30326,
   "key": "D1215le.txt:173",
   "file": "D1215le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "間に合わない、と絶望したときだ。",
   "ko_candidate": "늦었다고 절망했을 때다｡"
  },
  {
   "id": 30327,
   "key": "D1215le.txt:178",
   "file": "D1215le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いきなり別方向に急激なＧがかかる。もの凄いスピードで引っ張られたのだ。",
   "ko_candidate": "갑자기 다른 방향으로 급격한 G가 걸린다｡ 엄청난 속도로 끌려갔다｡"
  },
  {
   "id": 30328,
   "key": "D1215le.txt:179",
   "file": "D1215le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界のすぐ真下、視認できないほどの速度で翔ぶロードビヤーキーが通り過ぎた。",
   "ko_candidate": "시야 바로 아래､ 인식할 수 없을 정도의 속도로 날아가는 로드 비야키가 지나갔다｡"
  },
  {
   "id": 30329,
   "key": "D1215le.txt:185",
   "file": "D1215le.txt",
   "line": 185,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……間に合った！」",
   "ko_candidate": "「…간신히 맞췄어!」"
  },
  {
   "id": 30330,
   "key": "D1215le.txt:194",
   "file": "D1215le.txt",
   "line": 194,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさん！」",
   "ko_candidate": "「라이카 씨!」"
  },
  {
   "id": 30331,
   "key": "D1215le.txt:197",
   "file": "D1215le.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はハンティング・ホラーに乗ったライカさんに腕を掴まれていた。",
   "ko_candidate": "나는 헌팅 호러에 탄 라이카 씨의 팔에 붙들려 있었다｡"
  },
  {
   "id": 30332,
   "key": "D1215le.txt:200",
   "file": "D1215le.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのまま俺を後ろに乗せて、空中で旋回。",
   "ko_candidate": "그대로 나를 뒤에 태우고 공중에서 선회｡"
  },
  {
   "id": 30333,
   "key": "D1215le.txt:201",
   "file": "D1215le.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同じく旋回したロードビヤーキーと対峙する。",
   "ko_candidate": "마찬가지로 선회한 로드 비야키와 대치한다｡"
  },
  {
   "id": 30334,
   "key": "D1215le.txt:206",
   "file": "D1215le.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーが翔ける。",
   "ko_candidate": "로드 비야키가 날아오른다｡"
  },
  {
   "id": 30335,
   "key": "D1215le.txt:211",
   "file": "D1215le.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティング・ホラーが疾る。",
   "ko_candidate": "헌팅 호러가 질주한다｡"
  },
  {
   "id": 30336,
   "key": "D1215le.txt:212",
   "file": "D1215le.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……正面からぶつかり合う気か!?",
   "ko_candidate": "…정면에서 부딪힐 생각인가!?"
  },
  {
   "id": 30337,
   "key": "D1215le.txt:216",
   "file": "D1215le.txt",
   "line": 216,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おいおい！　いくら何でもサイズが違い過ぎるだろう!? 避けた方が……ぶべっ！」",
   "ko_candidate": "「이봐이봐! 아무리 그래도 크기 차이가 너무 심하잖아!? 피하는 게… 부베엣!」"
  },
  {
   "id": 30338,
   "key": "D1215le.txt:221",
   "file": "D1215le.txt",
   "line": 221,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「喋らないで！　舌を噛んじゃうから！」",
   "ko_candidate": "「말하지 마! 혀를 깨물어!」"
  },
  {
   "id": 30339,
   "key": "D1215le.txt:226",
   "file": "D1215le.txt",
   "line": 226,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……っっ。もふ遅ひ」",
   "ko_candidate": "「…윽｡ 벌써 늦었어」"
  },
  {
   "id": 30340,
   "key": "D1215le.txt:230",
   "file": "D1215le.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーが、ロードビヤーキーが音速の壁を超える。",
   "ko_candidate": "헌팅 호러가､ 로드 비야키가 음속의 벽을 넘는다｡"
  },
  {
   "id": 30341,
   "key": "D1215le.txt:231",
   "file": "D1215le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体を護る防護結界。大気との摩擦で光を発し、焔える。",
   "ko_candidate": "기체를 보호하는 방호결계｡ 대기와의 마찰로 빛을 발하며 불타오른다｡"
  },
  {
   "id": 30342,
   "key": "D1215le.txt:232",
   "file": "D1215le.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティング・ホラーは火の弾と化した。",
   "ko_candidate": "헌팅 호러는 불덩이가 되었다｡"
  },
  {
   "id": 30343,
   "key": "D1215le.txt:236",
   "file": "D1215le.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーは兇風の鎌を振るう死神と化した。",
   "ko_candidate": "로드 비야키는 포악한 바람의 낫을 휘두르는 사신이 되었다｡"
  },
  {
   "id": 30344,
   "key": "D1215le.txt:237",
   "file": "D1215le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こちらを呑み込むかの如き巨体が眼前に迫る。",
   "ko_candidate": "이쪽을 삼킬 듯한 거체가 눈앞에 다가온다｡"
  },
  {
   "id": 30345,
   "key": "D1215le.txt:238",
   "file": "D1215le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃が迸った。",
   "ko_candidate": "충격이 튀어나왔다｡"
  },
  {
   "id": 30346,
   "key": "D1215le.txt:246",
   "file": "D1215le.txt",
   "line": 246,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぎるぎるぎるるるる！」",
   "ko_candidate": "「기르기르기르르르르!」"
  },
  {
   "id": 30347,
   "key": "D1215le.txt:251",
   "file": "D1215le.txt",
   "line": 251,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くぅ……！」",
   "ko_candidate": "「크윽…!」"
  },
  {
   "id": 30348,
   "key": "D1215le.txt:254",
   "file": "D1215le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反射的に、全知覚が疾走する。",
   "ko_candidate": "반사적으로 모든 지각이 질주한다｡"
  },
  {
   "id": 30349,
   "key": "D1215le.txt:255",
   "file": "D1215le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那の間、時の流れから取り残され、世界は俺の感覚の後ろに従ってくる。",
   "ko_candidate": "찰나의 순간､ 시간의 흐름에서 뒤처지고 세계는 내 감각의 뒤를 따라온다｡"
  },
  {
   "id": 30350,
   "key": "D1215le.txt:256",
   "file": "D1215le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "スローモーションの世界で、俺は見た。",
   "ko_candidate": "슬로우 모션의 세계에서 나는 보았다｡"
  },
  {
   "id": 30351,
   "key": "D1215le.txt:269",
   "file": "D1215le.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーがロードビヤーキーが纏う兇風を穿ち、貫く。",
   "ko_candidate": "헌팅 호러가 로드 비야키를 감싼 포악한 바람을 뚫고 관통한다｡"
  },
  {
   "id": 30352,
   "key": "D1215le.txt:274",
   "file": "D1215le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂える風が、ハンティング・ホラーの周囲で断末魔を上げ、引き裂かれていった。",
   "ko_candidate": "미쳐 날뛰는 바람이 헌팅 호러 주위에서 단말마를 지르며 찢겨나갔다｡"
  },
  {
   "id": 30353,
   "key": "D1215le.txt:276",
   "file": "D1215le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の層を突破する。",
   "ko_candidate": "바람의 층을 돌파한다｡"
  },
  {
   "id": 30354,
   "key": "D1215le.txt:277",
   "file": "D1215le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "乱気流を抜け、視界が開ける。",
   "ko_candidate": "난기류를 빠져나가 시야가 트인다｡"
  },
  {
   "id": 30355,
   "key": "D1215le.txt:279",
   "file": "D1215le.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の結界の只中にある台風の目。凪の領域。戦いの只中に在って、戦いに対応していない、それは確実な間隙。",
   "ko_candidate": "바람의 결계 한가운데에 있는 태풍의 눈｡ 고요의 영역｡ 전투의 한가운데 있으면서도 전투에 대응하지 않는､ 그것은 확실한 틈새｡"
  },
  {
   "id": 30356,
   "key": "D1215le.txt:281",
   "file": "D1215le.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無防備のロードビヤーキーの頭部が、晒されていた。",
   "ko_candidate": "무방비의 로드 비야키의 머리 부분이 드러나 있었다｡"
  },
  {
   "id": 30357,
   "key": "D1215le.txt:283",
   "file": "D1215le.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吸い込まれるように。",
   "ko_candidate": "빨려 들어가듯이｡"
  },
  {
   "id": 30358,
   "key": "D1215le.txt:286",
   "file": "D1215le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火弾はロードビヤーキーを貫く。",
   "ko_candidate": "불덩이는 로드 비야키를 관통한다｡"
  },
  {
   "id": 30359,
   "key": "D1215le.txt:288",
   "file": "D1215le.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーは、ヒトに喩えるならばちょうど右眼の辺りを。",
   "ko_candidate": "헌팅 호러는 사람에 비유하자면 마침 오른쪽 눈 부근을｡"
  }
 ]
}