{
 "packet": "1205_00",
 "scene": "1205",
 "anchor": {
  "hit": 48,
  "total": 60,
  "rate": 0.8
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ティベリウス": "티베리우스",
  "メタトロン": "메타트론",
  "ライカ": "라이카",
  "九郎ちゃん": "쿠로 군",
  "クラウディウス": "클라우디우스"
 },
 "items": [
  {
   "id": 27501,
   "key": "D1205al.txt:16",
   "file": "D1205al.txt",
   "line": 16,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ゲギャアアアアアァァァァァ――――――ッ!?」 壁を突き破り、ティベリウスの身体は吹き飛んだ。",
   "ko_candidate": "작전사령실｡"
  },
  {
   "id": 27502,
   "key": "D1205al.txt:21",
   "file": "D1205al.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのすぐ後を追って、突進してくる白の影。",
   "ko_candidate": "지하시설의 중추까지 적이 침공해 왔다｡"
  },
  {
   "id": 27503,
   "key": "D1205al.txt:22",
   "file": "D1205al.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "別の通路――基地内の各施設を結ぶ地下線路に、２つの影が躍り出る。",
   "ko_candidate": "외적의 침입을 막기 위해 두껍게 닫혀 있던 게이트가 사람이 통과할 수 있을 정도의 직사각형으로 절단된다｡"
  },
  {
   "id": 27504,
   "key": "D1205al.txt:26",
   "file": "D1205al.txt",
   "line": 26,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アンタは――ッ！」 光が一閃。",
   "ko_candidate": "무거운 소리를 내며 벽이 쓰러졌다｡"
  },
  {
   "id": 27505,
   "key": "D1205al.txt:32",
   "file": "D1205al.txt",
   "line": 32,
   "speaker": "ティベリウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティベリウスの腕が斬り落とされる。 「シャアァァァァァ――――ッ！」",
   "ko_candidate": "그 너머､ 투쟁의 열락을 눈동자 깊숙이 담고 검은 사무라이가 서 있었다｡"
  },
  {
   "id": 27506,
   "key": "D1205al.txt:39",
   "file": "D1205al.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "伸びる触手がメタトロンを迎え撃つ。 だが、光が一閃。二閃。三閃。四閃。五閃――悉く斬り落とされる。",
   "ko_candidate": "「꺄아아아아아아아아아악!?」"
  },
  {
   "id": 27507,
   "key": "D1205al.txt:45",
   "file": "D1205al.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "線路の上で、斬り落とされた触手が、悶えのたうっていた。 ティベリウスが、忌々しきその名を吼える。",
   "ko_candidate": "「――――읏!」"
  },
  {
   "id": 27508,
   "key": "D1205al.txt:50",
   "file": "D1205al.txt",
   "line": 50,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「メタトロンッ！」",
   "ko_candidate": "「안티 크로스!?」"
  },
  {
   "id": 27509,
   "key": "D1205al.txt:56",
   "file": "D1205al.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "白い影は、光の刃の剣先を、 ティベリウスに向けて立っていた。",
   "ko_candidate": "경비병들의 총이 검은 사무라이에게 집중된다｡"
  },
  {
   "id": 27510,
   "key": "D1205al.txt:58",
   "file": "D1205al.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "表情のない仮面の下に、怒りに燃える瞳を隠しながら。 メタトロン。",
   "ko_candidate": "하지만 총구가 포효하기보다 훨씬 빠르게 검은 사무라이가 움직였다｡"
  },
  {
   "id": 27511,
   "key": "D1205al.txt:60",
   "file": "D1205al.txt",
   "line": 60,
   "speaker": "ティベリウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "白い装甲に身を包んだ、武装天使。 「そう、アンタが……」",
   "ko_candidate": "「참」"
  },
  {
   "id": 27512,
   "key": "D1205al.txt:67",
   "file": "D1205al.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ライカ達を追い詰めていたティベリウスの前に突如、メタトロンは出現した。 ビームセイバーで皆を捕らえる触手を斬り、ゾンビ達をカノン砲で殲滅し、ティベリウスを此処まで殴り飛ばした。",
   "ko_candidate": "신속한 움직임으로 경비병들 사이를 스쳐 지나간다｡"
  },
  {
   "id": 27513,
   "key": "D1205al.txt:70",
   "file": "D1205al.txt",
   "line": 70,
   "speaker": "ティベリウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "狂気の道化師は、割れた仮面の下で、剥き出しになった歯を軋らせる。 「面白くないわ…… 不愉快よ、アンタっ！」",
   "ko_candidate": "다음 순간､ 목을 잃은 경비병들의 몸이 그 자리에 멍하니 서 있었다｡"
  },
  {
   "id": 27514,
   "key": "D1205al.txt:78",
   "file": "D1205al.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蠢く臓腑が絡み合い、１本の太い肉の槍となって、メタトロンに襲いかかる。 メタトロンは間合いを詰めるように、前に飛び出した。",
   "ko_candidate": "「크크크크 목이! 목이이이이이잇!」"
  },
  {
   "id": 27515,
   "key": "D1205al.txt:85",
   "file": "D1205al.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目標を失った触手の束が床を抉る。",
   "ko_candidate": "티투스는 튀는 피조차 맞지 않았다｡"
  },
  {
   "id": 27516,
   "key": "D1205al.txt:86",
   "file": "D1205al.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眼前には、光の刃を振り上げる、白い姿。",
   "ko_candidate": "손에 쥔 칼끝을 곧바로 윈필드를 향해 겨눈다｡"
  },
  {
   "id": 27517,
   "key": "D1205al.txt:96",
   "file": "D1205al.txt",
   "line": 96,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぎぃひゃあ あああああぁぁぁぁっ!?」 袈裟斬りに、肩から心臓を経由して、反対側の脇腹から抜ける。",
   "ko_candidate": "「적 중추의 파괴가 소인의 임무지만､ 상관없다｡ 전사 윈필드｡ 이 티투스､ 그대와의 결착을 짓기 위해 찾아왔소」"
  },
  {
   "id": 27518,
   "key": "D1205al.txt:114",
   "file": "D1205al.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "両断された躰を、 ガトリングガンに変形した左腕が撃つ。",
   "ko_candidate": "경비병들이 티투스 앞을 가로막고 벽을 만들었다｡"
  },
  {
   "id": 27519,
   "key": "D1205al.txt:116",
   "file": "D1205al.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティベリウスの躰は原形を失い千切れ飛ぶ。 だが。",
   "ko_candidate": "하지만 그런 그들을 밀어내고 윈필드가 한 걸음 앞으로 나선다｡"
  },
  {
   "id": 27520,
   "key": "D1205al.txt:128",
   "file": "D1205al.txt",
   "line": 128,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……さすがは『ムーンチャイルド計画』の成功例。 大した戦闘能力じゃないのぉ」 飛び散った肉片が急速に収束する。",
   "ko_candidate": "검은 사무라이와 대치한다｡"
  },
  {
   "id": 27521,
   "key": "D1205al.txt:134",
   "file": "D1205al.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "巻き戻しのビデオフィルムのように、臓腑が骨が肉が皮膚が紡がれ組まれ、再生していく。 血と一緒に蛆虫を垂れ流しながら、",
   "ko_candidate": "「……윈필드」"
  },
  {
   "id": 27522,
   "key": "D1205al.txt:137",
   "file": "D1205al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティベリウスは嗤った――嗤ったが、その貌は、 まだ不完全な肉塊に過ぎなかった。",
   "ko_candidate": "「상대는 저를 지명했습니다｡ 그렇다면 응하는 것이 예의라는 것이겠죠」"
  },
  {
   "id": 27523,
   "key": "D1205al.txt:140",
   "file": "D1205al.txt",
   "line": 140,
   "speaker": "メタトロン",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "異形の再生を目の当たりにして、だがメタトロンに動じた様子は無い。 「この程度では殺し切れないか。なら、肉片も残さず消し飛ばしてやる」",
   "ko_candidate": "넥타이를 느슨하게 하고 파이팅 포즈를 취한다｡"
  },
  {
   "id": 27524,
   "key": "D1205al.txt:151",
   "file": "D1205al.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右腕がカノン砲に変形した。",
   "ko_candidate": "티투스 또한 이도류 자세를 취한다｡"
  },
  {
   "id": 27525,
   "key": "D1205al.txt:152",
   "file": "D1205al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "超高熱を宿す光の束が一直線に、ティベリウスに向かい、飛翔する。",
   "ko_candidate": "어찌할 수 없이 작전실의 모든 사람들이 그저 묵묵히 대치하는 두 사람을 지켜보고 있었다｡"
  },
  {
   "id": 27526,
   "key": "D1205al.txt:157",
   "file": "D1205al.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティベリウスは軽業師の様な身のこなしで、ビームを跳び越えた。 線路ごと地面を灼き払う光。",
   "ko_candidate": "「감사하오､ 전사 윈필드｡ 그럼､ 자 가――!」"
  },
  {
   "id": 27527,
   "key": "D1205al.txt:160",
   "file": "D1205al.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ティベリウスは、天井に触手を突き立てて、ぶら下がっている。",
   "ko_candidate": "티투스가 달려나가려는 그 순간에 맞춰 윈필드가 먼저 움직였다｡"
  },
  {
   "id": 27528,
   "key": "D1205al.txt:166",
   "file": "D1205al.txt",
   "line": 166,
   "speaker": "ティベリウス / メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……おおおお～～～。怖い、怖い。どーもアタシの方が不利っぽいわね。 悔しいけど、ここは退かせてもらうわ」 「待て！」",
   "ko_candidate": "티투스가 첫 발을 내딛기보다 빠르게 일순간에 간격을 제로로 좁힌다｡"
  },
  {
   "id": 27529,
   "key": "D1205al.txt:178",
   "file": "D1205al.txt",
   "line": 178,
   "speaker": "ティベリウス / メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アタシなんかに構っていて良いの、メタトロンちゃん？　アンタが贔屓にしている九郎ちゃん、今頃クラウディウスちゃんに……うふふ」 「――!?」",
   "ko_candidate": "「뭐!?」"
  },
  {
   "id": 27530,
   "key": "D1205al.txt:188",
   "file": "D1205al.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "天井に影が生じる。 その影に吸い込まれる様にして、ティベリウスは姿を消した。",
   "ko_candidate": "「슉!」"
  },
  {
   "id": 27531,
   "key": "D1205al.txt:190",
   "file": "D1205al.txt",
   "line": 190,
   "speaker": "ティベリウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "笑い声だけが、地下線路に響き渡る。 「お――――ほっほっほっほっ！　じゃあねぇ、メタトロンちゃん。 まぁぁぁぁぁぁた、会いましょぉぉぉぉねぇぇぇぇぇ！」",
   "ko_candidate": "주먹의 탄막이 티투스의 온몸을 용서 없이 내리친다｡ 그리고 마지막으로 바디블로｡ 티투스의 몸이 공중으로 날아올라 끝까지 날아간다｡"
  },
  {
   "id": 27532,
   "key": "D1205al.txt:200",
   "file": "D1205al.txt",
   "line": 200,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……おのれ！」 作戦司令室。",
   "ko_candidate": "「그윽! ……뭐지!」"
  },
  {
   "id": 27533,
   "key": "D1205le.txt:11",
   "file": "D1205le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地下施設の中枢にまで、敵は侵攻してきた。 外敵の侵入を阻む為、厚く閉ざされたゲートが、人の通れるほどの長方形に切断される。",
   "ko_candidate": "티투스는 공중제비를 돌며 벽을 발판 삼아 도약한다｡ 아니､ 도약이라기보다는 비상에 가깝다｡"
  },
  {
   "id": 27534,
   "key": "D1205le.txt:19",
   "file": "D1205le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "重い音を立てて、壁が倒れた。 その向こう、闘争の愉悦を瞳の奥に湛えて、黒のサムライは立っていた。",
   "ko_candidate": "천장 높이 박혀 있는 진공관 컴퓨터를 차고 윈필드의 바로 위에서 베어 내린다!"
  },
  {
   "id": 27535,
   "key": "D1205le.txt:30",
   "file": "D1205le.txt",
   "line": 30,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃああああぁぁぁぁっ!?」",
   "ko_candidate": "「큿……!」 백스텝｡ 간신히 피했다｡"
  },
  {
   "id": 27536,
   "key": "D1205le.txt:34",
   "file": "D1205le.txt",
   "line": 34,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ！」 警備兵達の銃が黒のサムライに集中する。",
   "ko_candidate": "코끝을 베기가 스쳐 지나간다｡"
  },
  {
   "id": 27537,
   "key": "D1205le.txt:47",
   "file": "D1205le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかし銃口が吼えるよりはるかに速く、黒の侍は動いた。",
   "ko_candidate": "티투스의 공격은 계속된다｡"
  },
  {
   "id": 27538,
   "key": "D1205le.txt:51",
   "file": "D1205le.txt",
   "line": 51,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「斬」",
   "ko_candidate": "「핫!」"
  },
  {
   "id": 27539,
   "key": "D1205le.txt:67",
   "file": "D1205le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "神速の動きで、警備兵たちの間を擦り抜ける。 銀閃が、警備兵たちの首を疾る。",
   "ko_candidate": "착지와 동시에 다시 도약｡ 뒤로 물러난 윈필드의 턱을 겨냥해 왼쪽 칼이 아래에서 덮친다｡"
  },
  {
   "id": 27540,
   "key": "D1205le.txt:69",
   "file": "D1205le.txt",
   "line": 69,
   "speaker": "ソーニャ",
   "kind": "narr",
   "status": "CHECK",
