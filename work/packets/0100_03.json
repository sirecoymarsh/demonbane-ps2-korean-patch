 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {},
 "items": [
  {
   "id": 122,
   "key": "D0100.txt:432",
   "file": "D0100.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数にして１１。",
   "ko_candidate": "수로는 11｡"
  },
  {
   "id": 123,
   "key": "D0100.txt:434",
   "file": "D0100.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇は星の僅かな光すら捻じ曲げ呑み込みながら、鋼の巨人に迫る。",
   "ko_candidate": "어둠은 별의 미약한 빛마저 비틀어 삼키며､ 강철의 거인에게 다가온다｡"
  },
  {
   "id": 124,
   "key": "D0100.txt:436",
   "file": "D0100.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "翼から炎を噴かせて、鋼の巨人は闇の塊をかわす。",
   "ko_candidate": "날개에서 불꽃을 뿜으며､ 강철의 거인은 어둠의 덩어리를 피한다｡"
  },
  {
   "id": 125,
   "key": "D0100.txt:442",
   "file": "D0100.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "半数はかわし切れない。",
   "ko_candidate": "절반은 피하지 못한다｡"
  },
  {
   "id": 126,
   "key": "D0100.txt:445",
   "file": "D0100.txt",
   "line": 445,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼の巨人は光の障壁を展開。",
   "ko_candidate": "강철의 거인은 빛의 장벽을 전개한다｡"
  },
  {
   "id": 127,
   "key": "D0100.txt:445",
   "file": "D0100.txt",
   "line": 445,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３つの闇が障壁を呑み込み、消滅した。",
   "ko_candidate": "3개의 어둠이 장벽을 삼키고､ 소멸했다｡"
  },
  {
   "id": 128,
   "key": "D0100.txt:447",
   "file": "D0100.txt",
   "line": 447,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に１つは手にした銃を囮とする。",
   "ko_candidate": "또 하나는 손에 든 총을 미끼로 삼는다｡"
  },
  {
   "id": 129,
   "key": "D0100.txt:449",
   "file": "D0100.txt",
   "line": 449,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃を歪め、呑み込み、闇は消滅する。",
   "ko_candidate": "총을 일그러뜨리고､ 삼키고､ 어둠은 소멸한다｡"
  },
  {
   "id": 130,
   "key": "D0100.txt:451",
   "file": "D0100.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "残り１つが巨人を捉えた。",
   "ko_candidate": "남은 하나가 거인을 포착했다｡"
  },
  {
   "id": 131,
   "key": "D0100.txt:460",
   "file": "D0100.txt",
   "line": 460,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 132,
   "key": "D0100.txt:467",
   "file": "D0100.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人の腹の半分が抉れる。今度こそ致命傷だった。",
   "ko_candidate": "거인의 배의 절반이 도려내진다｡ 이번에야말로 치명상이었다｡"
  },
  {
   "id": 133,
   "key": "D0100.txt:469",
   "file": "D0100.txt",
   "line": 469,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人の機能は停止しようとしている。",
   "ko_candidate": "거인의 기능이 정지하려 하고 있다｡"
  },
  {
   "id": 134,
   "key": "D0100.txt:480",
   "file": "D0100.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その時、巨人は翼の出力を最大に開放。紅の巨人に特攻する。",
   "ko_candidate": "그때､ 거인은 날개의 출력을 최대로 개방｡ 붉은 거인에게 특공한다｡"
  },
  {
   "id": 135,
   "key": "D0100.txt:481",
   "file": "D0100.txt",
   "line": 481,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人にとってそれは不意討ちだったようだ。",
   "ko_candidate": "붉은 거인에게 그것은 불의의 습격이었던 것 같다｡"
  },
  {
   "id": 136,
   "key": "D0100.txt:486",
   "file": "D0100.txt",
   "line": 486,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……!?」",
   "ko_candidate": "「큭…!?」"
  },
  {
   "id": 137,
   "key": "D0100.txt:497",
   "file": "D0100.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２体の巨人が衝突し、火花を散らす。",
   "ko_candidate": "두 거인이 충돌하며､ 불꽃을 튀긴다｡"
  },
  {
   "id": 138,
   "key": "D0100.txt:499",
   "file": "D0100.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "満身創痍の巨人は片腕だけで、だがしっかりと紅の巨人にしがみ付く。",
   "ko_candidate": "만신창이가 된 거인은 한쪽 팔만으로､ 하지만 확실하게 붉은 거인에게 매달린다｡"
  },
  {
   "id": 139,
   "key": "D0100.txt:501",
   "file": "D0100.txt",
   "line": 501,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "離すまいと全力を込めて締め上げる。",
   "ko_candidate": "놓지 않으려고 전력을 다해 조여 온다｡"
  },
  {
   "id": 140,
   "key": "D0100.txt:503",
   "file": "D0100.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人の装甲が軋みをあげ、背中が罅割れた。",
   "ko_candidate": "붉은 거인의 장갑이 삐걱거리며､ 등이 갈라졌다｡"
  },
  {
   "id": 141,
   "key": "D0100.txt:508",
   "file": "D0100.txt",
   "line": 508,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「貴公……！」",
   "ko_candidate": "「당신…!」"
  },
  {
   "id": 142,
   "key": "D0100.txt:512",
   "file": "D0100.txt",
   "line": 512,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人を掴まえたままで突進し続ける。",
   "ko_candidate": "붉은 거인을 붙잡은 채로 돌진을 계속한다｡"
  },
  {
   "id": 143,
   "key": "D0100.txt:514",
   "file": "D0100.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ある程度の距離を進み、弧を描いて反転。",
   "ko_candidate": "어느 정도 거리를 나아가､ 호를 그리며 반전｡"
  },
  {
   "id": 144,
   "key": "D0100.txt:516",
   "file": "D0100.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眼下の地球に向かって、自らを捉える重力を深く求めるかの様に、全速力で突進する。むしろ墜落する。",
   "ko_candidate": "지상의 지구를 향해､ 자신을 붙잡는 중력을 깊이 갈구하듯이､ 전속력으로 돌진한다｡ 오히려 추락한다｡"
  },
  {
   "id": 145,
   "key": "D0100.txt:524",
   "file": "D0100.txt",
   "line": 524,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「余を道連れにするつもりか！」",
   "ko_candidate": "「나를 도구로 삼으려는 건가!」"
  },
  {
   "id": 146,
   "key": "D0100.txt:528",
   "file": "D0100.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死にかけの巨人は答えない。",
   "ko_candidate": "죽어가는 거인은 대답하지 않는다｡"
  },
  {
   "id": 147,
   "key": "D0100.txt:529",
   "file": "D0100.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ腕の力が更に篭もる。背中の装甲が粉砕される。",
   "ko_candidate": "단지 팔의 힘이 더욱 실린다｡ 등의 장갑이 분쇄된다｡"
  },
  {
   "id": 148,
   "key": "D0100.txt:532",
   "file": "D0100.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの巨体が赤熱する。",
   "ko_candidate": "두 거대한 몸체가 붉게 달아오른다｡"
  },
  {
   "id": 149,
   "key": "D0100.txt:533",
   "file": "D0100.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気圏に突入したのだ。",
   "ko_candidate": "대기권에 돌입한 것이다｡"
  },
  {
   "id": 150,
   "key": "D0100.txt:535",
   "file": "D0100.txt",
   "line": 535,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凶暴な大気が巨人達を燃やし尽くそうと吼え猛る。",
   "ko_candidate": "포악한 대기가 거인들을 태워버리려 으르렁거린다｡"
  },
  {
   "id": 151,
   "key": "D0100.txt:536",
   "file": "D0100.txt",
   "line": 536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "赤熱する巨体が燃える。熔ける。爆ぜる。",
   "ko_candidate": "붉게 달아오른 거대한 몸체가 타오른다｡ 녹는다｡ 터진다｡"
  },
  {
   "id": 152,
   "key": "D0100.txt:538",
   "file": "D0100.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不完全なヒト型は更にカタチを失い、紅のヒト型もまた傷を負う。",
   "ko_candidate": "불완전한 인간형은 더욱 형태를 잃고､ 붉은 인간형 또한 상처를 입는다｡"
  },
  {
   "id": 153,
   "key": "D0100.txt:543",
   "file": "D0100.txt",
   "line": 543,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「往生際が悪いぞ！」",
   "ko_candidate": "「죽을 때까지 버티는구나!」"
  },
  {
   "id": 154,
   "key": "D0100.txt:550",
   "file": "D0100.txt",
   "line": 550,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人が左腕のみを抱擁から振り解き、自由になった掌で窮鼠と化した敵の貌を掴む。",
   "ko_candidate": "붉은 거인이 왼팔만을 포옹에서 풀어내고､ 자유로워진 손바닥으로 쥐 같은 적의 얼굴을 움켜쥔다｡"
  },
  {
   "id": 155,
   "key": "D0100.txt:551",
   "file": "D0100.txt",
   "line": 551,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "手の甲に紋様が浮かび上がった。",
   "ko_candidate": "손등에 문양이 떠오른다｡"
  },
  {
   "id": 156,
   "key": "D0100.txt:560",
   "file": "D0100.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆砕。",
   "ko_candidate": "폭쇄｡"
  },
  {
   "id": 157,
   "key": "D0100.txt:561",
   "file": "D0100.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨人の半分だけ残った貌が完全に砕け散る。",
   "ko_candidate": "거인의 반쪽만 남은 얼굴이 완전히 부서져 흩어진다｡"
  },
  {
   "id": 158,
   "key": "D0100.txt:563",
   "file": "D0100.txt",
   "line": 563,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その衝撃の反動で、縛めが完全に解けた。",
   "ko_candidate": "그 충격의 반동으로､ 속박이 완전히 풀렸다｡"
  },
  {
   "id": 159,
   "key": "D0100.txt:565",
   "file": "D0100.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の巨人を離し、翼を広げたままに墜落する。",
   "ko_candidate": "붉은 거인을 떠나､ 날개를 편 채로 추락한다｡"
  },
  {
   "id": 160,
   "key": "D0100.txt:566",
   "file": "D0100.txt",
   "line": 566,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天を掴もうとするかの様に片腕を伸ばし、墜ちる巨人。",
   "ko_candidate": "하늘을 잡으려는 듯이 한쪽 팔을 뻗고､ 떨어지는 거인｡"
  },
  {
   "id": 161,
   "key": "D0100.txt:568",
   "file": "D0100.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、紅の巨人は差し伸べるかの様に手を伸ばし……",
   "ko_candidate": "그리고､ 붉은 거인은 내밀듯이 손을 뻗고……"
  }
 ]
}