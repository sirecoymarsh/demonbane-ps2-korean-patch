 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "覇道財閥": "하도 재벌",
  "姫さん": "공주님"
 },
 "items": [
  {
   "id": 14250,
   "key": "D0808ru.txt:15",
   "file": "D0808ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかし姫さんは、覇道財閥の総帥様なのであって、何と言うか、俺が行くようなシモジモの店で果たして良いものなのだろうかという疑問が付きまとう。 うぅぅむ……。",
   "ko_candidate": "하지만 공주님은 하도 재벌의 총수님이시니､ 뭐랄까､ 내가 가는 그런 허접한 가게에서 괜찮을지 의문이 든다｡"
  },
  {
   "id": 14251,
   "key": "D0808ru.txt:22",
   "file": "D0808ru.txt",
   "line": 22,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "으음… 「……………」"
  },
  {
   "id": 14252,
   "key": "D0808ru.txt:27",
   "file": "D0808ru.txt",
   "line": 27,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ん？」",
   "ko_candidate": "「…응?」"
  },
  {
   "id": 14253,
   "key": "D0808ru.txt:29",
   "file": "D0808ru.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何やら、姫さんの視線が彷徨っている。",
   "ko_candidate": "뭔가 공주님의 시선이 방황하고 있다｡"
  },
  {
   "id": 14254,
   "key": "D0808ru.txt:30",
   "file": "D0808ru.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線の先を追うと……アイスクリームを食べながら歩く、学生さんらしき一団が。",
   "ko_candidate": "시선의 끝을 따라가 보니… 아이스크림을 먹으며 걷는 학생들로 보이는 무리가 있다｡"
  },
  {
   "id": 14255,
   "key": "D0808ru.txt:32",
   "file": "D0808ru.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……んー。もしかして。",
   "ko_candidate": "…음-｡ 혹시｡"
  },
  {
   "id": 14256,
   "key": "D0808ru.txt:35",
   "file": "D0808ru.txt",
   "line": 35,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「姫さん？」",
   "ko_candidate": "「공주님?」"
  },
  {
   "id": 14257,
   "key": "D0808ru.txt:44",
   "file": "D0808ru.txt",
   "line": 44,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え？　え？　はい？」",
   "ko_candidate": "「엣? 엣? 네?」"
  },
  {
   "id": 14258,
   "key": "D0808ru.txt:48",
   "file": "D0808ru.txt",
   "line": 48,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もしかして……アイスクリームが食べたいのか？」",
   "ko_candidate": "「혹시… 아이스크림이 먹고 싶은 건가?」"
  },
  {
   "id": 14259,
   "key": "D0808ru.txt:54",
   "file": "D0808ru.txt",
   "line": 54,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ!?　えええっ！　えっ!?」",
   "ko_candidate": "「엣!? 에에엣! 엣!?」"
  },
  {
   "id": 14260,
   "key": "D0808ru.txt:57",
   "file": "D0808ru.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いきなり慌てふためく。分かりやすい反応だ。",
   "ko_candidate": "갑자기 당황해한다｡ 알기 쉬운 반응이다｡"
  },
  {
   "id": 14261,
   "key": "D0808ru.txt:58",
   "file": "D0808ru.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、姫さんは全力で首を横に振って",
   "ko_candidate": "하지만 공주님은 전력으로 고개를 좌우로 흔들며"
  },
  {
   "id": 14262,
   "key": "D0808ru.txt:64",
   "file": "D0808ru.txt",
   "line": 64,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ま、まさか！　そんな子どもじゃあるまいし！　そんなこと……！」",
   "ko_candidate": "「마､ 말도 안 돼요! 그런 어린애도 아니고! 그런 거…!」"
  },
  {
   "id": 14263,
   "key": "D0808ru.txt:67",
   "file": "D0808ru.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "と途中まで否定したのは良いが、またアイスクリームを食べてる人達の方を盗み見て、軽く俯き、頬を赤らめながら、恥ずかしそうに、やや上目使いに",
   "ko_candidate": "라고 중간까지 부정했지만､ 또 아이스크림을 먹고 있는 사람들 쪽을 훔쳐보더니､ 살짝 고개를 숙이고 볼을 붉히며 부끄러운 듯이､ 약간 올려다보며"
  },
  {
   "id": 14264,
   "key": "D0808ru.txt:73",
   "file": "D0808ru.txt",
   "line": 73,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの……はい。わたくし、 ああいう食べ方はした事が ありませんでしたので…… その……興味があります……」",
   "ko_candidate": "「저… 네｡ 저는 저런 식으로 먹어본 적이 없어서… 그… 흥미가 있어요…」"
  },
  {
   "id": 14265,
   "key": "D0808ru.txt:79",
   "file": "D0808ru.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今にも消え入りそうな声で呟いた。",
   "ko_candidate": "금방이라도 사라질 것 같은 목소리로 중얼거렸다｡"
  },
  {
   "id": 14266,
   "key": "D0808ru.txt:80",
   "file": "D0808ru.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――正直、かなり可愛いと思った。",
   "ko_candidate": "――솔직히 꽤 귀엽다고 생각했다｡"
  },
  {
   "id": 14267,
   "key": "D0808ru.txt:82",
   "file": "D0808ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か俺まで顔が赤くなってくる。",
   "ko_candidate": "뭔가 나까지 얼굴이 빨개지는 것 같다｡"
  },
  {
   "id": 14268,
   "key": "D0808ru.txt:83",
   "file": "D0808ru.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを誤魔化すように、俺は力強く答えた。",
   "ko_candidate": "그것을 감추려는 듯이 나는 힘차게 대답했다｡"
  },
  {
   "id": 14269,
   "key": "D0808ru.txt:86",
   "file": "D0808ru.txt",
   "line": 86,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「良し！　分かった！　買って来よう！」",
   "ko_candidate": "「좋아! 알겠어! 사 올게!」"
  },
  {
   "id": 14270,
   "key": "D0808ru.txt:92",
   "file": "D0808ru.txt",
   "line": 92,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え？　え？　はい？」",
   "ko_candidate": "「엣? 엣? 네?」"
  },
  {
   "id": 14271,
   "key": "D0808ru.txt:96",
   "file": "D0808ru.txt",
   "line": 96,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちょっとだけ待ってな。すぐ戻る」",
   "ko_candidate": "「잠깐만 기다려｡ 금방 돌아올게」"
  },
  {
   "id": 14272,
   "key": "D0808ru.txt:100",
   "file": "D0808ru.txt",
   "line": 100,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ？　え？　……ええ、はいっ」",
   "ko_candidate": "「아? 엣? …네､ 네」"
  },
  {
   "id": 14273,
   "key": "D0808ru.txt:106",
   "file": "D0808ru.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かこの近くに、わりかし評判の店があったはずだ。",
   "ko_candidate": "분명 이 근처에 꽤 평판 좋은 가게가 있었을 텐데｡"
  },
  {
   "id": 14274,
   "key": "D0808ru.txt:107",
   "file": "D0808ru.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "食べ歩いている人が多いのは、そのせいだろう。",
   "ko_candidate": "먹으면서 걷는 사람이 많은 건 그 때문일 거야｡"
  },
  {
   "id": 14275,
   "key": "D0808ru.txt:108",
   "file": "D0808ru.txt",
   "line": 108,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は早足で、店の方へ向かった。 「…………あ」",
   "ko_candidate": "나는 빠른 걸음으로 가게 쪽으로 향했다｡"
  },
  {
   "id": 14276,
   "key": "D0808ru.txt:125",
   "file": "D0808ru.txt",
   "line": 125,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「よう、お待たせ。はいっ」",
   "ko_candidate": "「…아」 「야､ 기다렸지｡ 자」"
  },
  {
   "id": 14277,
   "key": "D0808ru.txt:127",
   "file": "D0808ru.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さっそく買ってきた２つのアイスクリーム。",
   "ko_candidate": "서둘러 사온 두 개의 아이스크림｡"
  },
  {
   "id": 14278,
   "key": "D0808ru.txt:128",
   "file": "D0808ru.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何段重ねにもなっている、一番人気の豪勢なやつだ。",
   "ko_candidate": "여러 단으로 쌓인､ 가장 인기 있는 호화로운 거다｡"
  },
  {
   "id": 14279,
   "key": "D0808ru.txt:129",
   "file": "D0808ru.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "片方を、姫さんに差し出した。だが――",
   "ko_candidate": "한쪽을 공주님에게 내밀었다｡ 하지만――"
  },
  {
   "id": 14280,
   "key": "D0808ru.txt:135",
   "file": "D0808ru.txt",
   "line": 135,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちょっ……っ！　ちょっと、待って！　待って下さい！ 待ってぇぇぇぇぇ――――――っ！」",
   "ko_candidate": "「잠깐…! 잠깐､ 기다려요! 기다려 주세요! 기다려어어어어――――――!」"
  },
  {
   "id": 14281,
   "key": "D0808ru.txt:144",
   "file": "D0808ru.txt",
   "line": 144,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……………………はい？」",
   "ko_candidate": "「……………네?」"
  },
  {
   "id": 14282,
   "key": "D0808ru.txt:146",
   "file": "D0808ru.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か悲鳴付きで、徹底的に拒絶されてしまった。",
   "ko_candidate": "뭔가 비명과 함께 철저히 거부당해 버렸다｡"
  },
  {
   "id": 14283,
   "key": "D0808ru.txt:147",
   "file": "D0808ru.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "な、何か気に入らないことがあったのだろうか？",
   "ko_candidate": "뭐､ 뭔가 마음에 들지 않는 게 있었던 걸까?"
  },
  {
   "id": 14284,
   "key": "D0808ru.txt:148",
   "file": "D0808ru.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……例えば抹茶が入ってないと駄目だとか。",
   "ko_candidate": "…예를 들어 말차가 들어가 있지 않으면 안 된다거나｡"
  },
  {
   "id": 14285,
   "key": "D0808ru.txt:151",
   "file": "D0808ru.txt",
   "line": 151,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……えーと。 その、気に入らなかったら、別のを……」",
   "ko_candidate": "「아… 저기｡ 그､ 마음에 들지 않으면 다른 걸…」"
  },
  {
   "id": 14286,
   "key": "D0808ru.txt:156",
   "file": "D0808ru.txt",
   "line": 156,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうでなくてっ！　あああああっ！　そんな不注意に扱わないで下さいましっ！　く、崩れてしまいますわっ！」",
   "ko_candidate": "「그게 아니에요! 아아아아! 그렇게 부주의하게 다루지 말아 주세요! 무､ 무너져 버려요!」"
  },
  {
   "id": 14287,
   "key": "D0808ru.txt:159",
   "file": "D0808ru.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……はい？",
   "ko_candidate": "…네?"
  },
  {
   "id": 14288,
   "key": "D0808ru.txt:160",
   "file": "D0808ru.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんはアイスクリームを不安そうに見つめながら、あたふたオロオロしている。",
   "ko_candidate": "공주님은 아이스크림을 불안한 듯이 바라보며 허둥지둥하고 있다｡"
  },
  {
   "id": 14289,
   "key": "D0808ru.txt:162",
   "file": "D0808ru.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩れるってアイスクリームのことか？",
   "ko_candidate": "무너진다는 게 아이스크림 얘기인가?"
  }
 ]
}