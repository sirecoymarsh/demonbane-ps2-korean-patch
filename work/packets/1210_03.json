 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "鬼械神": "귀계신",
  "ベルゼビュート": "벨제뷰트",
  "デウス・マキナ": "데우스 마키나",
  "ティベリウス": "티베리우스",
  "メタトロン": "메타트론",
  "サンダルフォン": "산달폰"
 },
 "items": [
  {
   "id": 29098,
   "key": "D1210al.txt:423",
   "file": "D1210al.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本能めいた直感が、俺を動かした。",
   "ko_candidate": "본능적인 직감이 나를 움직였다｡"
  },
  {
   "id": 29099,
   "key": "D1210al.txt:435",
   "file": "D1210al.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚部シールドを開放して、今立っている場所から一気に飛び退く。",
   "ko_candidate": "다리 부분 실드를 개방하고､ 지금 서 있는 자리에서 단숨에 뛰어 물러난다｡"
  },
  {
   "id": 29100,
   "key": "D1210al.txt:436",
   "file": "D1210al.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――間一髪。",
   "ko_candidate": "――아슬아슬하게｡"
  },
  {
   "id": 29101,
   "key": "D1210al.txt:440",
   "file": "D1210al.txt",
   "line": 440,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ひぇぇぇっ!?」 地の底より、瘴気が噴き出した。",
   "ko_candidate": "「히에에에!?{SE_VOL(1,1000,0);}」"
  },
  {
   "id": 29102,
   "key": "D1210al.txt:450",
   "file": "D1210al.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "血の様に紅いラインが描く、巨大な魔法陣。",
   "ko_candidate": "땅속에서 독기가 뿜어져 나왔다｡"
  },
  {
   "id": 29103,
   "key": "D1210al.txt:451",
   "file": "D1210al.txt",
   "line": 451,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔法円の内に、闇黒の穴が生じた。",
   "ko_candidate": "피처럼 붉은 선이 그리는､ 거대한 마법진｡"
  },
  {
   "id": 29104,
   "key": "D1210al.txt:454",
   "file": "D1210al.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ざわめき。 ざわめき。",
   "ko_candidate": "마법진 안에 암흑의 구멍이 생겼다｡"
  },
  {
   "id": 29105,
   "key": "D1210al.txt:456",
   "file": "D1210al.txt",
   "line": 456,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ざわめき。",
   "ko_candidate": "소란｡ 소란｡"
  },
  {
   "id": 29106,
   "key": "D1210al.txt:458",
   "file": "D1210al.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "亡者の呻き声と、無数の蝿の羽音が、不協和音となって大気を震わせる。",
   "ko_candidate": "소란｡ 망자의 신음 소리와 무수한 파리의 날갯짓이 불협화음이 되어 대기를 진동시킨다｡"
  },
  {
   "id": 29107,
   "key": "D1210al.txt:459",
   "file": "D1210al.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この反吐が出そうな、邪悪な気配は――",
   "ko_candidate": "이 구역질이 날 것 같은､ 사악한 기운은――"
  },
  {
   "id": 29108,
   "key": "D1210al.txt:464",
   "file": "D1210al.txt",
   "line": 464,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――鬼械神ベルゼビュート！ 暴食せよ！」",
   "ko_candidate": "「――귀계신 벨제뷰트! 폭식하라!」"
  },
  {
   "id": 29109,
   "key": "D1210al.txt:473",
   "file": "D1210al.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地の底より。",
   "ko_candidate": "땅속에서｡"
  },
  {
   "id": 29110,
   "key": "D1210al.txt:474",
   "file": "D1210al.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冥府と繋がる深淵より。",
   "ko_candidate": "저승과 이어진 심연에서｡"
  },
  {
   "id": 29111,
   "key": "D1210al.txt:475",
   "file": "D1210al.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ベルゼビュートが這い上がってきた。",
   "ko_candidate": "벨제뷰트가 기어 올라왔다｡"
  },
  {
   "id": 29112,
   "key": "D1210al.txt:477",
   "file": "D1210al.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が鬼械神の機体に纏わり、粘ついていた。",
   "ko_candidate": "어둠이 귀계신의 기체에 감겨 끈적거렸다｡"
  },
  {
   "id": 29113,
   "key": "D1210al.txt:478",
   "file": "D1210al.txt",
   "line": 478,
   "speaker": "ティベリウス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "瘴気が靄となって、醜悪なデウス・マキナの姿を妖しく翳ませる。 「お――ほっほっほっ ほっほっほっ！」",
   "ko_candidate": "독기가 안개가 되어､{SE_VOL(1,1000,0);}추악한 데우스 마키나의 모습을 요염하게 가린다｡"
  },
  {
   "id": 29114,
   "key": "D1210al.txt:490",
   "file": "D1210al.txt",
   "line": 490,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ティベリウス！」",
   "ko_candidate": "「오――호호호호호호!」"
  },
  {
   "id": 29115,
   "key": "D1210al.txt:503",
   "file": "D1210al.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地下線路を全速力で、メタトロンは飛翔する。",
   "ko_candidate": "「티베리우스!」 지하 선로를 전속력으로､ 메타트론은 비행한다｡"
  },
  {
   "id": 29116,
   "key": "D1210al.txt:505",
   "file": "D1210al.txt",
   "line": 505,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その行く手、地下通路の闇に融ける様に、黒い影が佇んでいた。",
   "ko_candidate": "그 앞길､ 지하통로의 어둠에 녹아드는 듯､ 검은 그림자가 서 있었다｡"
  },
  {
   "id": 29117,
   "key": "D1210al.txt:507",
   "file": "D1210al.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "影は拳を腰の横に据えて、 メタトロンを待ち構えている。",
   "ko_candidate": "그림자는 주먹을 허리 옆에 두고､ 메타트론을 기다리고 있다｡"
  },
  {
   "id": 29118,
   "key": "D1210al.txt:512",
   "file": "D1210al.txt",
   "line": 512,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 29119,
   "key": "D1210al.txt:517",
   "file": "D1210al.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その正体に気付いた時、メタトロンは迷わなかった。",
   "ko_candidate": "그 정체를 알아차렸을 때､ 메타트론은 망설이지 않았다｡"
  },
  {
   "id": 29120,
   "key": "D1210al.txt:518",
   "file": "D1210al.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右腕のカノン砲を影に向ける。",
   "ko_candidate": "오른팔의 캐논포를 그림자를 향해 겨눈다｡"
  },
  {
   "id": 29121,
   "key": "D1210al.txt:523",
   "file": "D1210al.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地下の闇を、砲撃の閃光が灼き尽くした。",
   "ko_candidate": "지하의 어둠을､ 포격의 섬광이 태워버렸다｡"
  },
  {
   "id": 29122,
   "key": "D1210al.txt:524",
   "file": "D1210al.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影は迫り来る破壊の光を前にして、まったく怯む様子を見せなかった。ただ飛来するビームに構えた拳を突き出した。",
   "ko_candidate": "그림자는 다가오는 파괴의 빛 앞에서､ 전혀 주저하는 모습을 보이지 않았다｡ 단지 날아오는 빔을 향해 준비한 주먹을 내밀었다｡"
  },
  {
   "id": 29123,
   "key": "D1210al.txt:533",
   "file": "D1210al.txt",
   "line": 533,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「憤ッ！　破ッ！」",
   "ko_candidate": "「분노! 파괴!」"
  },
  {
   "id": 29124,
   "key": "D1210al.txt:537",
   "file": "D1210al.txt",
   "line": 537,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "メタトロンの砲撃は、 拳に撃たれて爆裂、光を散らされた。",
   "ko_candidate": "메타트론의 포격은 주먹에 맞아 폭발하고､ 빛이 흩어졌다｡"
  },
  {
   "id": 29125,
   "key": "D1210al.txt:540",
   "file": "D1210al.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "散りゆく光が、影を照らす。",
   "ko_candidate": "흩어지는 빛이 그림자를 비춘다｡"
  },
  {
   "id": 29126,
   "key": "D1210al.txt:541",
   "file": "D1210al.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光に照らされても影は、なお黒かった。",
   "ko_candidate": "빛에 비춰져도 그림자는 여전히 검었다｡"
  },
  {
   "id": 29127,
   "key": "D1210al.txt:543",
   "file": "D1210al.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒の装甲で武装した戦天使――サンダルフォン。",
   "ko_candidate": "검은 갑옷으로 무장한 전투천사――산달폰｡"
  },
  {
   "id": 29128,
   "key": "D1210al.txt:550",
   "file": "D1210al.txt",
   "line": 550,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「メタトロン！ 餓アアアアアァァァァァ――！」",
   "ko_candidate": "「메타트론! 굶주어어어어어어어어어어――!」"
  },
  {
   "id": 29129,
   "key": "D1210al.txt:555",
   "file": "D1210al.txt",
   "line": 555,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「サンダルフォン！」",
   "ko_candidate": "「산달폰!」"
  },
  {
   "id": 29130,
   "key": "D1210al.txt:559",
   "file": "D1210al.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "サンダルフォンが双翼を展開して、 爆発的な速度で突撃する！",
   "ko_candidate": "산달폰이 양날개를 펼치고､ 폭발적인 속도로 돌진한다!"
  },
  {
   "id": 29131,
   "key": "D1210al.txt:561",
   "file": "D1210al.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンも速度を落とさない。",
   "ko_candidate": "메타트론도 속도를 늦추지 않는다｡"
  },
  {
   "id": 29132,
   "key": "D1210al.txt:562",
   "file": "D1210al.txt",
   "line": 562,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "抜き放つ光刃が闇に軌跡を刻みつけ、奔る。",
   "ko_candidate": "뽑아든 빛의 칼날이 어둠에 궤적을 새기며 달린다｡"
  },
  {
   "id": 29133,
   "key": "D1210al.txt:566",
   "file": "D1210al.txt",
   "line": 566,
   "speaker": "メタトロン＆サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「「うおおおおぉぉぉ ぉぉぉぉぉぉ――――！」」",
   "ko_candidate": "「우오오오오오오오오오오오오오오――――!」"
  },
  {
   "id": 29134,
   "key": "D1210al.txt:570",
   "file": "D1210al.txt",
   "line": 570,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超高速で飛翔する２人の天使。",
   "ko_candidate": "초고속으로 비행하는 두 천사｡"
  },
  {
   "id": 29135,
   "key": "D1210al.txt:571",
   "file": "D1210al.txt",
   "line": 571,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "接触までゼロコンマ一秒。",
   "ko_candidate": "접촉까지 제로 콤마 일 초｡"
  },
  {
   "id": 29136,
   "key": "D1210al.txt:579",
   "file": "D1210al.txt",
   "line": 579,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 29137,
   "key": "D1210al.txt:583",
   "file": "D1210al.txt",
   "line": 583,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  }
 ]
}