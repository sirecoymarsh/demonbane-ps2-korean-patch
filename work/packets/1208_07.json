 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ウィンフィールド": "윈필드",
  "ティトゥス": "티투스"
 },
 "items": [
  {
   "id": 28599,
   "key": "D1208le.txt:220",
   "file": "D1208le.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迅い。",
   "ko_candidate": "신속하다｡"
  },
  {
   "id": 28600,
   "key": "D1208le.txt:221",
   "file": "D1208le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今までで一番。",
   "ko_candidate": "지금까지 중 가장｡"
  },
  {
   "id": 28601,
   "key": "D1208le.txt:223",
   "file": "D1208le.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思考の速度に躰が付いて来てくれるだろうか。",
   "ko_candidate": "사고의 속도를 몸이 따라올 수 있을까｡"
  },
  {
   "id": 28602,
   "key": "D1208le.txt:226",
   "file": "D1208le.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上半身を逸らす。",
   "ko_candidate": "상체를 비틀어 피한다｡"
  },
  {
   "id": 28603,
   "key": "D1208le.txt:227",
   "file": "D1208le.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背広が斬られた。",
   "ko_candidate": "양복이 베어졌다｡"
  },
  {
   "id": 28604,
   "key": "D1208le.txt:228",
   "file": "D1208le.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけだ。かわした。",
   "ko_candidate": "그뿐이다｡ 피했다｡"
  },
  {
   "id": 28605,
   "key": "D1208le.txt:230",
   "file": "D1208le.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "斬られたネクタイが、ゆっくりと、落ちる。 ゆっくりと、",
   "ko_candidate": "베어진 넥타이가 천천히 떨어진다｡"
  },
  {
   "id": 28606,
   "key": "D1208le.txt:232",
   "file": "D1208le.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ゆっくりと、",
   "ko_candidate": "천천히､ 천천히､"
  },
  {
   "id": 28607,
   "key": "D1208le.txt:234",
   "file": "D1208le.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸の位置にあったそれは、",
   "ko_candidate": "가슴 위치에 있던 그것이､"
  },
  {
   "id": 28608,
   "key": "D1208le.txt:235",
   "file": "D1208le.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ゆっくりと、",
   "ko_candidate": "천천히､ 천천히､"
  },
  {
   "id": 28609,
   "key": "D1208le.txt:236",
   "file": "D1208le.txt",
   "line": 236,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゆっくりと、",
   "ko_candidate": "복근 위치로､"
  },
  {
   "id": 28610,
   "key": "D1208le.txt:237",
   "file": "D1208le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "腹筋の位置へ、 其処で２撃目が来た。",
   "ko_candidate": "거기서 2격째가 왔다｡"
  },
  {
   "id": 28611,
   "key": "D1208le.txt:243",
   "file": "D1208le.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左の刀。突き。",
   "ko_candidate": "왼쪽 칼｡ 찌르기｡"
  },
  {
   "id": 28612,
   "key": "D1208le.txt:244",
   "file": "D1208le.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咽喉笛を狙い、風を裂きて迫る兇刃。",
   "ko_candidate": "목구멍을 노리고 바람을 가르며 다가오는 흉칼｡"
  },
  {
   "id": 28613,
   "key": "D1208le.txt:245",
   "file": "D1208le.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "速い。",
   "ko_candidate": "빠르다｡"
  },
  {
   "id": 28614,
   "key": "D1208le.txt:246",
   "file": "D1208le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迅い。",
   "ko_candidate": "신속하다｡"
  },
  {
   "id": 28615,
   "key": "D1208le.txt:248",
   "file": "D1208le.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先程よりも更に。",
   "ko_candidate": "아까보다 더욱｡"
  },
  {
   "id": 28616,
   "key": "D1208le.txt:249",
   "file": "D1208le.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "稲妻の速度で。",
   "ko_candidate": "번개의 속도로｡"
  },
  {
   "id": 28617,
   "key": "D1208le.txt:251",
   "file": "D1208le.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遂にティトゥスの速度は、ウィンフィールドの動体視力を超えた。",
   "ko_candidate": "마침내 티투스의 속도는 윈필드의 동체시력을 넘어섰다｡"
  },
  {
   "id": 28618,
   "key": "D1208le.txt:252",
   "file": "D1208le.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、ウィンフィールドの思考と反射速度は、更にそれを上回る。",
   "ko_candidate": "하지만 윈필드의 사고와 반사 속도는 더욱 그것을 웃돈다｡"
  },
  {
   "id": 28619,
   "key": "D1208le.txt:254",
   "file": "D1208le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷たい剣気が通り過ぎた。",
   "ko_candidate": "차가운 검기가 지나갔다｡"
  },
  {
   "id": 28620,
   "key": "D1208le.txt:255",
   "file": "D1208le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "裂かれたのは頬の皮一枚。",
   "ko_candidate": "베어진 것은 뺨의 살 한 겹｡"
  },
  {
   "id": 28621,
   "key": "D1208le.txt:256",
   "file": "D1208le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血飛沫が舞う。ただそれだけ。",
   "ko_candidate": "피가 튀었다｡ 그뿐이다｡"
  },
  {
   "id": 28622,
   "key": "D1208le.txt:257",
   "file": "D1208le.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、それだけなのだ。",
   "ko_candidate": "단지､ 그뿐인 것이다｡"
  },
  {
   "id": 28623,
   "key": "D1208le.txt:262",
   "file": "D1208le.txt",
   "line": 262,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（――貰いましたよ！）",
   "ko_candidate": "（――받아냈습니다!）"
  },
  {
   "id": 28624,
   "key": "D1208le.txt:265",
   "file": "D1208le.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃の後の、僅かな、僅かな、隙。",
   "ko_candidate": "공격 후의 아주 작은､ 아주 작은 틈｡"
  },
  {
   "id": 28625,
   "key": "D1208le.txt:266",
   "file": "D1208le.txt",
   "line": 266,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ほんの一瞬の、ゼロコンマ秒にも満たない、ほんの刹那。",
   "ko_candidate": "단 일순간의､ 제로 콤마 초에도 미치지 못하는､ 아주 찰나｡"
  },
  {
   "id": 28626,
   "key": "D1208le.txt:268",
   "file": "D1208le.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、完全に無防備を曝した。",
   "ko_candidate": "하지만 완전히 무방비를 드러냈다｡"
  },
  {
   "id": 28627,
   "key": "D1208le.txt:269",
   "file": "D1208le.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神速の領域で、その隙は決定的だった。致命的だった。",
   "ko_candidate": "신속의 영역에서 그 틈은 결정적이었다｡ 치명적이었다｡"
  },
  {
   "id": 28628,
   "key": "D1208le.txt:271",
   "file": "D1208le.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必殺の威力を込めたアッパーが唸りを上げて、ティトゥスに迫る。",
   "ko_candidate": "필살의 위력을 담은 어퍼가 윙윙거리며 티투스에게 다가간다｡"
  },
  {
   "id": 28629,
   "key": "D1208le.txt:273",
   "file": "D1208le.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "かわせない。",
   "ko_candidate": "피할 수 없다｡"
  },
  {
   "id": 28630,
   "key": "D1208le.txt:274",
   "file": "D1208le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "かわせる筈が無い。",
   "ko_candidate": "피할 수 있을 리가 없다｡"
  },
  {
   "id": 28631,
   "key": "D1208le.txt:275",
   "file": "D1208le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度こそ、二度と起き上がる事の出来ない決定打になる――",
   "ko_candidate": "이번에야말로 두 번 다시 일어날 수 없는 결정타가 될 것이다――"
  },
  {
   "id": 28632,
   "key": "D1208le.txt:277",
   "file": "D1208le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "筈だった。",
   "ko_candidate": "그럴 터였다｡"
  },
  {
   "id": 28633,
   "key": "D1208le.txt:281",
   "file": "D1208le.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "銀の光がウィンフィールドの眼前で煌めいた。",
   "ko_candidate": "은빛 광채가 윈필드의 눈앞에서 번쩍였다｡{SE_VOL(1,1000,0);}<br>"
  },
  {
   "id": 28634,
   "key": "D1208le.txt:285",
   "file": "D1208le.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "予期せぬ剣気が、",
   "ko_candidate": "예기치 못한 검기가､"
  },
  {
   "id": 28635,
   "key": "D1208le.txt:286",
   "file": "D1208le.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "予期せぬタイミングで、",
   "ko_candidate": "예기치 못한 타이밍에､"
  },
  {
   "id": 28636,
   "key": "D1208le.txt:287",
   "file": "D1208le.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "予期せぬ方向から、飛来した。",
   "ko_candidate": "예기치 못한 방향에서 날아왔다｡"
  },
  {
   "id": 28637,
   "key": "D1208le.txt:289",
   "file": "D1208le.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その原因に、刹那の世界を走る思考は、即座に気付いた。",
   "ko_candidate": "그 원인을､ 찰나의 세계를 달리는 사고는 즉시 깨달았다｡"
  },
  {
   "id": 28638,
   "key": "D1208le.txt:290",
   "file": "D1208le.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遅過ぎた。",
   "ko_candidate": "너무 늦었다｡"
  }
 ]
}