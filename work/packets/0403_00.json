 },
 "items": [
  {
   "id": 4464,
   "key": "D0403.txt:32",
   "file": "D0403.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……疲れた。",
   "ko_candidate": "……지쳤다｡"
  },
  {
   "id": 4465,
   "key": "D0403.txt:33",
   "file": "D0403.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "主に精神的に疲れ果てた。",
   "ko_candidate": "주로 정신적으로 완전히 지쳤다｡"
  },
  {
   "id": 4466,
   "key": "D0403.txt:36",
   "file": "D0403.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "なんつーか……あんな住む世界がぜんぜん違うっぽい人らと上手くやっていけるのかどうか。",
   "ko_candidate": "뭐랄까､ 저렇게 전혀 사는 세계가 다른 것 같은 사람들과 잘 지낼 수 있을지 모르겠다｡"
  },
  {
   "id": 4467,
   "key": "D0403.txt:38",
   "file": "D0403.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや、メイドさんたちの、あの向こう岸渡り切っちゃっているノリは、住む世界がどうとかそういう次元の問題ではないっぽいが。",
   "ko_candidate": "아니… 메이드 분들의 저 완전히 다른 세계에 있는 듯한 분위기는､ 사는 세계가 다르다거나 그런 차원의 문제가 아닌 것 같지만､ 일단은 제쳐두자｡"
  },
  {
   "id": 4468,
   "key": "D0403.txt:42",
   "file": "D0403.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……何にせよ、もう後戻りは出来ない。",
   "ko_candidate": "뭐､ 어쨌든 이제 돌이킬 수 없다｡"
  },
  {
   "id": 4469,
   "key": "D0403.txt:43",
   "file": "D0403.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "正式に、完全に、『ブラックロッジ』にケンカ売る勢力の仲間入りだ。 やってやる。",
   "ko_candidate": "완전히 공식적으로､ 『블랙로지』에 싸움을 걸 세력의 일원이 되었다｡"
  },
  {
   "id": 4470,
   "key": "D0403.txt:47",
   "file": "D0403.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "トコトンまでやってやるさ！",
   "ko_candidate": "해주마… 끝까지 해주겠어!"
  },
  {
   "id": 4471,
   "key": "D0403.txt:62",
   "file": "D0403.txt",
   "line": 62,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……なんて気合入れても、今んトコは空振りしているワケだが」",
   "ko_candidate": "「……이렇게 의욕을 불태워도､ 지금은 헛돌고 있을 뿐이지만」 그래｡"
  },
  {
   "id": 4472,
   "key": "D0403.txt:66",
   "file": "D0403.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "覇道の姫さんに依頼されるまでもなく、ページ捜しは既に始めている。",
   "ko_candidate": "하도의 공주님에게 부탁받기도 전에､ 알의 파편 찾기는 이미 시작했었다｡"
  },
  {
   "id": 4473,
   "key": "D0403.txt:69",
   "file": "D0403.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だけど、アトラック＝ナチャを回収してから今日まで、ページモンスターが関与していそうな怪事件の気配はない。",
   "ko_candidate": "하지만､ 아틀락 나챠를 회수하고 나서 오늘까지｡ 알의 파편이 관여한 것 같은 괴사건의 기미는 없다｡"
  },
  {
   "id": 4474,
   "key": "D0403.txt:79",
   "file": "D0403.txt",
   "line": 79,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうそう派手な動きは起こらんよ」",
   "ko_candidate": "「그렇게 화려한 움직임은 일어나지 않아」 알이 무뚝뚝한 어조로 말했다｡"
  },
  {
   "id": 4476,
   "key": "D0403.txt:88",
   "file": "D0403.txt",
   "line": 88,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そもそも、実体化している断片が少ないのだろう。妾と切り離されたばかりの断片は、茫洋とした力の塊に過ぎない」",
   "ko_candidate": "「……그렇군」 「아틀락 나챠는… 그 뭐랄까､ 그 경우에는 말이지… 열정이라는､ 강한 욕망을 토대로 삼았었지｡ 그래서 실체화도 빨랐던 거겠지… 콜록」"
  },
  {
   "id": 4477,
   "key": "D0403.txt:92",
   "file": "D0403.txt",
   "line": 92,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そこから自らの性質や場に渦巻く思念に合わせて、容を形成していく……時間がかかるのだ」",
   "ko_candidate": "그때의 일을 떠올렸는지､ 조금 볼을 붉히면서 설명하고 있다｡ 뭐､ 납득은 갔다｡"
  },
  {
   "id": 4478,
   "key": "D0403.txt:98",
   "file": "D0403.txt",
   "line": 98,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……なるほど」 まあ、納得はする。",
   "ko_candidate": "납득은 하지만… 초조하다｡"
  },
  {
   "id": 4479,
   "key": "D0403.txt:108",
   "file": "D0403.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "納得はするが……焦れる。",
   "ko_candidate": "그게 초조하다｡ 꾸물거리고 싶지 않다｡"
  },
  {
   "id": 4480,
   "key": "D0403.txt:111",
   "file": "D0403.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "こうしている間にも、あの金色バケモノが調子づいているのかと思うと、臓腑が煮えくり返る。",
   "ko_candidate": "이렇게 있는 동안에도､ 저 황금 괴물이 기세를 올리고 있을 거라고 생각하면､ 속이 부글부글 끓는다｡"
  },
  {
   "id": 4481,
   "key": "D0403.txt:115",
   "file": "D0403.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一日でも早く力を手にして、奴を――！",
   "ko_candidate": "멈추지 않고､ 단숨에 이대로､ 저 마스터 테리온이 서 있는 높이까지 달려 올라가서――"
  },
  {
   "id": 4482,
   "key": "D0403.txt:124",
   "file": "D0403.txt",
   "line": 124,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「熱くなるな」",
   "ko_candidate": "「흥분하지 마」"
  },
  {
   "id": 4483,
   "key": "D0403.txt:129",
   "file": "D0403.txt",
   "line": 129,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っっ」",
   "ko_candidate": "「……읏」"
  },
  {
   "id": 4484,
   "key": "D0403.txt:134",
   "file": "D0403.txt",
   "line": 134,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「妾が完全になっても、汝の力が及ばなければ何の意味もない。先ずは自らの力を、識を、術を磨く事だ。 それが一番の近道となる」",
   "ko_candidate": "폭주하는 내면을 꿰뚫어 본 듯이､ 알이 무뚝뚝한 채로､ 하지만 날카로운 목소리로 끼어들었다｡ 「내가 완전해져도､ 네 힘이 미치지 못하면､ 아무 의미가 없어｡ 우선은 자신의 힘을､ 지식을､ 술법을 갈고닦는 거야｡ 그게 가장 빠른 지름길이 될 거야」"
  },
  {
   "id": 4485,
   "key": "D0403.txt:141",
   "file": "D0403.txt",
   "line": 141,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……」",
   "ko_candidate": "「아아…」"
  },
  {
   "id": 4486,
   "key": "D0403.txt:145",
   "file": "D0403.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……確かに、焦ったって仕方ない。",
   "ko_candidate": "……확실히､ 초조해한다고 해결되는 게 아니다｡"
  },
  {
   "id": 4487,
   "key": "D0403.txt:146",
   "file": "D0403.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうだ。そうだな。",
   "ko_candidate": "그래｡ 그렇지｡"
  },
  {
   "id": 4488,
   "key": "D0403.txt:147",
   "file": "D0403.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どうも、熱くなり過ぎているようだ。",
   "ko_candidate": "아무래도 너무 흥분한 것 같다｡"
  },
  {
   "id": 4489,
   "key": "D0403.txt:150",
   "file": "D0403.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少し気持ちを落ち着かせよう。",
   "ko_candidate": "조금 마음을 가라앉혀보자｡"
  },
  {
   "id": 4490,
   "key": "D0403.txt:151",
   "file": "D0403.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "やる気も度が過ぎれば、毒にしかならない。",
   "ko_candidate": "의욕도 지나치면 독이 될 뿐이다｡"
  },
  {
   "id": 4491,
   "key": "D0403.txt:154",
   "file": "D0403.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶えず思考し、絶えず実践する。",
   "ko_candidate": "끊임없이 생각하고､ 끊임없이 실천한다｡"
  },
  {
   "id": 4492,
   "key": "D0403.txt:155",
   "file": "D0403.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "自らを刃金の如く鍛え続ける。",
   "ko_candidate": "자신을 칼날처럼 계속 단련한다｡"
  },
  {
   "id": 4493,
   "key": "D0403.txt:157",
   "file": "D0403.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつ如何なるとき怪異と対峙しようと、決して怯まぬように。退かぬように。",
   "ko_candidate": "언제 어떤 때､ 괴이와 맞닥뜨리더라도､ 결코 겁먹지 않도록｡ 물러서지 않도록｡"
  },
  {
   "id": 4494,
   "key": "D0403.txt:160",
   "file": "D0403.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大切な事はそれだ。",
   "ko_candidate": "중요한 건 그거다｡"
  },
  {
   "id": 4495,
   "key": "D0403.txt:161",
   "file": "D0403.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから――",
   "ko_candidate": "그러니까――"
  },
  {
   "id": 4496,
   "key": "D0403.txt:182",
   "file": "D0403.txt",
   "line": 182,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「腹が減っては戦は出来ぬ。常に臨戦態勢を整えておくと言うことで」",
   "ko_candidate": "「배가 고파서는 싸움을 할 수 없지｡ 항상 전투태세를 갖추고 있어야 한다는 의미에서」"
  },
  {
   "id": 4497,
   "key": "D0403.txt:187",
   "file": "D0403.txt",
   "line": 187,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「めし」",
   "ko_candidate": "「밥」"
  },
  {
   "id": 4498,
   "key": "D0403.txt:199",
   "file": "D0403.txt",
   "line": 199,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「わーい、相も変わらずの傍若無人が、一気に２倍と大増殖だぁー」",
   "ko_candidate": "「와아､ 변함없는 제멋대로가 단번에 2배로 대증식이다아―」"
  },
  {
   "id": 4499,
   "key": "D0403.txt:205",
   "file": "D0403.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "失礼な。",
   "ko_candidate": "실례군｡"
  },
  {
   "id": 4500,
   "key": "D0403.txt:206",
   "file": "D0403.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺とこいつを一緒くたにするなんて。",
   "ko_candidate": "나와 이놈을 한통속으로 취급하다니｡"
  },
  {
   "id": 4501,
   "key": "D0403.txt:216",
   "file": "D0403.txt",
   "line": 216,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「穀潰しーっ、根無し草ーっ、寄生虫ーっ、ヒモーっ、ジゴローっ、人間失格ーっ」",
   "ko_candidate": "「밥벌레―､ 뿌리 없는 풀―､ 기생충―､ 히모―､ 지고로―､ 인간실격―」"
  },
  {
   "id": 4502,
   "key": "D0403.txt:223",
   "file": "D0403.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "たたみかけるような罵詈雑言の無呼吸連打。",
   "ko_candidate": "연이어 퍼붓는 듯한 욕설의 연타｡"
  },
  {
   "id": 4503,
   "key": "D0403.txt:224",
   "file": "D0403.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "流石だな、シスター。 相変わらずの容赦なさっぷりだ。",
   "ko_candidate": "역시 대단하군､ 시스터｡ 변함없는 무자비함이다｡"
  },
  {
   "id": 4504,
   "key": "D0403.txt:228",
   "file": "D0403.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、しかし！",
   "ko_candidate": "하지만､ 그러나!"
  }
 ]
}