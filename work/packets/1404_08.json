 },
 "items": [
  {
   "id": 37285,
   "key": "D1404ru.txt:426",
   "file": "D1404ru.txt",
   "line": 426,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「目覚めたようだな」",
   "ko_candidate": "「깨어난 것 같군」"
  },
  {
   "id": 37286,
   "key": "D1404ru.txt:429",
   "file": "D1404ru.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "計測器がピ――――ッ！とけたたましく鳴り響く。",
   "ko_candidate": "측정기가 삐-----! 하고 요란하게 울린다｡"
  },
  {
   "id": 37287,
   "key": "D1404ru.txt:430",
   "file": "D1404ru.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "執事さんは、呼吸器を乱暴に外し、苦痛に身を歪めながら上半身を起こそうとしていた。",
   "ko_candidate": "집사님은 인공호흡기를 거칠게 벗어 던지고､ 고통에 몸을 일그러뜨리면서 상체를 일으키려 하고 있었다｡"
  },
  {
   "id": 37288,
   "key": "D1404ru.txt:435",
   "file": "D1404ru.txt",
   "line": 435,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちょっ……ウィンフィールド！　何を……」",
   "ko_candidate": "「잠깐… 윈필드! 뭘…」"
  },
  {
   "id": 37289,
   "key": "D1404ru.txt:439",
   "file": "D1404ru.txt",
   "line": 439,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おいおい！　無茶すんなよっ!?」",
   "ko_candidate": "「이봐이봐! 무리하지 마!」"
  },
  {
   "id": 37290,
   "key": "D1404ru.txt:441",
   "file": "D1404ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何とか上半身を起こす。",
   "ko_candidate": "어떻게든 상체를 일으킨다｡"
  },
  {
   "id": 37291,
   "key": "D1404ru.txt:442",
   "file": "D1404ru.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、すぐに前倒れに身体が崩れた。",
   "ko_candidate": "하지만 곧바로 앞으로 몸이 무너졌다｡"
  },
  {
   "id": 37292,
   "key": "D1404ru.txt:443",
   "file": "D1404ru.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慌てて、抱き止める。",
   "ko_candidate": "황급히 붙잡는다｡"
  },
  {
   "id": 37293,
   "key": "D1404ru.txt:450",
   "file": "D1404ru.txt",
   "line": 450,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「半死半生の重傷だったんだぜ？　まだ動くのは無理だっ」",
   "ko_candidate": "「반 죽은 중상이었다고? 아직 움직이는 건 무리야」"
  },
  {
   "id": 37294,
   "key": "D1404ru.txt:454",
   "file": "D1404ru.txt",
   "line": 454,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「つ……ッ……大十字様……っ」",
   "ko_candidate": "「크… 큭… 다이쥬지 님…」"
  },
  {
   "id": 37295,
   "key": "D1404ru.txt:457",
   "file": "D1404ru.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の忠告はまったく聞いちゃいない。",
   "ko_candidate": "내 충고는 전혀 듣지 않고 있다｡"
  },
  {
   "id": 37296,
   "key": "D1404ru.txt:458",
   "file": "D1404ru.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歯を食いしばり、苦痛に耐え、遠のく意識を懸命に繋ぎ止め……弱々しい声で、何かを喋ろうとする。",
   "ko_candidate": "이를 악물고 고통을 견디며､ 멀어지는 의식을 필사적으로 붙잡고… 힘없는 목소리로 뭔가를 말하려 한다｡"
  },
  {
   "id": 37297,
   "key": "D1404ru.txt:462",
   "file": "D1404ru.txt",
   "line": 462,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの……男は……私……が…………くっっ！」",
   "ko_candidate": "「그… 남자는… 제가… 크윽!」"
  },
  {
   "id": 37298,
   "key": "D1404ru.txt:465",
   "file": "D1404ru.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが最後まで話し終わる前に、執事さんはまた意識を失った。",
   "ko_candidate": "하지만 끝까지 말을 마치기 전에 집사님은 다시 의식을 잃었다｡"
  },
  {
   "id": 37299,
   "key": "D1404ru.txt:470",
   "file": "D1404ru.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "執事さんの身体から力が抜ける。",
   "ko_candidate": "집사님의 몸에서 힘이 빠진다｡"
  },
  {
   "id": 37300,
   "key": "D1404ru.txt:471",
   "file": "D1404ru.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脱力し、重くなった上半身を、しっかりと支えた。",
   "ko_candidate": "탈력해서 무거워진 상체를 꽉 붙잡았다｡"
  },
  {
   "id": 37301,
   "key": "D1404ru.txt:476",
   "file": "D1404ru.txt",
   "line": 476,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まったく……無理をして……」",
   "ko_candidate": "「정말… 무리해서…」"
  },
  {
   "id": 37302,
   "key": "D1404ru.txt:479",
   "file": "D1404ru.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "執事さんを再びベッドに寝かせた。",
   "ko_candidate": "집사님을 다시 침대에 눕혔다｡"
  },
  {
   "id": 37303,
   "key": "D1404ru.txt:480",
   "file": "D1404ru.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんはシーツをちゃんと掛け直すと、真剣な面持ちでこっちを向いた。",
   "ko_candidate": "공주님은 시트를 제대로 덮어주고는 진지한 표정으로 이쪽을 향했다｡"
  },
  {
   "id": 37304,
   "key": "D1404ru.txt:486",
   "file": "D1404ru.txt",
   "line": 486,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そう言えば、大十字さん。吉報があります。 国連が今回の事態に対して、既に行動を開始しました」 「只今、世界中の艦隊がルルイエの海域に集結しております」",
   "ko_candidate": "「그러고 보니､ 다이쥬지 씨｡ 희소식이 있어요｡ UN이 이번 사태에 대해 이미 행동을 개시했습니다｡ 지금 전 세계의 함대가 르뤼에 해역에 집결하고 있습니다」"
  },
  {
   "id": 37305,
   "key": "D1404ru.txt:494",
   "file": "D1404ru.txt",
   "line": 494,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「へえ……まっ、さすがに無視できる事態じゃねえからな」",
   "ko_candidate": "「헤에… 뭐､ 역시 무시할 수 있는 사태가 아니니까」"
  },
  {
   "id": 37306,
   "key": "D1404ru.txt:500",
   "file": "D1404ru.txt",
   "line": 500,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ですが……邪神を相手に、人類の戦力が如何程、通用するものか」 「決戦の鍵を握るのはやっぱり、大十字さん、アル・アジフ、貴方がただけなのです」",
   "ko_candidate": "「하지만… 사신을 상대로 인류의 전력이 얼마나 통할지｡ 결전의 열쇠를 쥐고 있는 건 역시 다이쥬지 씨､ 알 아지프､ 당신뿐입니다」"
  },
  {
   "id": 37307,
   "key": "D1404ru.txt:506",
   "file": "D1404ru.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は黙って頷き返した。",
   "ko_candidate": "나는 말없이 고개를 끄덕였다｡"
  },
  {
   "id": 37308,
   "key": "D1404ru.txt:507",
   "file": "D1404ru.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの表情が憂いに翳る。",
   "ko_candidate": "공주님의 표정이 근심으로 어두워진다｡"
  },
  {
   "id": 37309,
   "key": "D1404ru.txt:513",
   "file": "D1404ru.txt",
   "line": 513,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「申し訳なく思っております。貴方を、こんな事に巻き込んで……」",
   "ko_candidate": "「죄송스럽게 생각하고 있어요｡ 당신을 이런 일에 휘말리게 해서…」"
  },
  {
   "id": 37310,
   "key": "D1404ru.txt:517",
   "file": "D1404ru.txt",
   "line": 517,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何言ってるんだよ姫さん。俺たちが勝手に居座っただけじゃないか。 『何処ぞの馬の骨』にデモンベインを奪われた姫さんは、被害者だよ」",
   "ko_candidate": "「무슨 소리야 공주님｡ 우리가 멋대로 들어와 살았을 뿐이잖아｡ 『어디서 굴러온 돌멩이』에게 데몬베인을 빼앗긴 공주님은 피해자야」"
  },
  {
   "id": 37311,
   "key": "D1404ru.txt:520",
   "file": "D1404ru.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、笑う。",
   "ko_candidate": "말하고 웃는다｡"
  },
  {
   "id": 37312,
   "key": "D1404ru.txt:525",
   "file": "D1404ru.txt",
   "line": 525,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうだ。自惚れるなよ、小娘。妾は妾の仕事をこなすだけだ。 汝の都合など知った事か」",
   "ko_candidate": "「그래｡ 자만하지 마라､ 꼬마야｡ 나는 나의 일을 할 뿐이다｡ 네 사정 따위 알 바 아니다」"
  },
  {
   "id": 37313,
   "key": "D1404ru.txt:529",
   "file": "D1404ru.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "続いて、アルも笑った。",
   "ko_candidate": "이어서 알도 웃었다｡"
  },
  {
   "id": 37314,
   "key": "D1404ru.txt:530",
   "file": "D1404ru.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんが、弱々しい笑みを返した。",
   "ko_candidate": "공주님이 약한 미소를 지었다｡"
  },
  {
   "id": 37315,
   "key": "D1404ru.txt:536",
   "file": "D1404ru.txt",
   "line": 536,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「わたくしには、もう貴方がたに未来を託すより術はありません」 「これを……ナアカル・コードの解除キーです。これでわたくしの承認無しに、いつでもレムリア・インパクトを撃つ事が出来ます」",
   "ko_candidate": "「저로서는 이제 당신들에게 미래를 맡길 수밖에 없습니다｡ 이것을… 나아칼 코드의 해제 키입니다｡ 이걸로 제 승인 없이도 언제든 레무리아 임팩트를 발사할 수 있습니다」"
  },
  {
   "id": 37316,
   "key": "D1404ru.txt:545",
   "file": "D1404ru.txt",
   "line": 545,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ん……確かに受け取ったよ」",
   "ko_candidate": "「응… 확실히 받았어」"
  },
  {
   "id": 37317,
   "key": "D1404ru.txt:547",
   "file": "D1404ru.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "名の通り、まんま古風な鍵を象った解除キーを受け取る。",
   "ko_candidate": "이름 그대로､ 정말 고풍스러운 열쇠 모양의 해제 키를 받는다｡"
  },
  {
   "id": 37318,
   "key": "D1404ru.txt:549",
   "file": "D1404ru.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの……姫さんの爺さんの、覇道家の願いが込められた鍵。",
   "ko_candidate": "공주님의… 공주님의 할아버지의､ 하도가의 염원이 담긴 열쇠｡"
  },
  {
   "id": 37319,
   "key": "D1404ru.txt:555",
   "file": "D1404ru.txt",
   "line": 555,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「夜明けと同時に、覇道財閥の全戦力を投じて、ルルイエに向かいます。 大十字さん。それに――アル」",
   "ko_candidate": "「새벽과 동시에 하도 재벌의 모든 전력을 투입해 르뤼에로 향합니다｡ 다이쥬지 님｡ 그리고 - 알」"
  },
  {
   "id": 37320,
   "key": "D1404ru.txt:559",
   "file": "D1404ru.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんとアルが、しばし無言で見つめ合った。",
   "ko_candidate": "공주님과 알이 잠시 말없이 서로를 바라보았다｡"
  },
  {
   "id": 37321,
   "key": "D1404ru.txt:560",
   "file": "D1404ru.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それだけで通じ合えたのだろうか。",
   "ko_candidate": "그것만으로 통했던 걸까｡"
  },
  {
   "id": 37322,
   "key": "D1404ru.txt:561",
   "file": "D1404ru.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルが力強く頷いた。",
   "ko_candidate": "알이 힘차게 고개를 끄덕였다｡"
  },
  {
   "id": 37323,
   "key": "D1404ru.txt:562",
   "file": "D1404ru.txt",
   "line": 562,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんが微笑み、そして――",
   "ko_candidate": "공주님이 미소 짓고､ 그리고 -"
  },
  {
   "id": 37324,
   "key": "D1404ru.txt:568",
   "file": "D1404ru.txt",
   "line": 568,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうか、世界の未来をよろしくお願い致します」",
   "ko_candidate": "「부디 세계의 미래를 잘 부탁드립니다」"
  }
 ]
}