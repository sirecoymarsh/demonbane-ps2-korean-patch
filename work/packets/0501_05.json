 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {},
 "items": [
  {
   "id": 6180,
   "key": "D0501.txt:1752",
   "file": "D0501.txt",
   "line": 1752,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "柄の部分を支点に高速で回転する。",
   "ko_candidate": "자루 부분을 지점으로 고속으로 회전한다｡"
  },
  {
   "id": 6181,
   "key": "D0501.txt:1753",
   "file": "D0501.txt",
   "line": 1753,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "回転する偃月刀は、まるで真円を描く満月のようだ。",
   "ko_candidate": "회전하는 언월도는 마치 진원을 그리는 만월 같다｡"
  },
  {
   "id": 6182,
   "key": "D0501.txt:1759",
   "file": "D0501.txt",
   "line": 1759,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「拙いな。どうやら今の機械人形との戦闘で刺激してしまったらしい。興奮しているぞ」",
   "ko_candidate": "「서툴러｡ 아무래도 방금 기계인형과의 전투로 자극해 버린 모양이다｡ 흥분하고 있어」"
  },
  {
   "id": 6183,
   "key": "D0501.txt:1765",
   "file": "D0501.txt",
   "line": 1765,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「興奮しているって……」",
   "ko_candidate": "「흥분하고 있다니…」"
  },
  {
   "id": 6184,
   "key": "D0501.txt:1773",
   "file": "D0501.txt",
   "line": 1773,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "倒壊したビルを見て、俺は思わず呻いた。",
   "ko_candidate": "붕괴된 빌딩을 보고 나는 무심코 신음했다｡"
  },
  {
   "id": 6185,
   "key": "D0501.txt:1779",
   "file": "D0501.txt",
   "line": 1779,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……洒落にならない切れ味なんだが」",
   "ko_candidate": "「…농담이 아닌 예리함이군」 「온다!」"
  },
  {
   "id": 6186,
   "key": "D0501.txt:1784",
   "file": "D0501.txt",
   "line": 1784,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「来るぞ！」",
   "ko_candidate": "「우와아아앗!」"
  },
  {
   "id": 6187,
   "key": "D0501.txt:1789",
   "file": "D0501.txt",
   "line": 1789,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわあああっと！」 偃月刀が風を斬って、吼える。",
   "ko_candidate": "바람을 가르며 포효하는 언월도가 다가온다｡"
  },
  {
   "id": 6188,
   "key": "D0501.txt:1810",
   "file": "D0501.txt",
   "line": 1810,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その場に思いっきりしゃがみ込んだ。",
   "ko_candidate": "나는 있는 힘껏 그 자리에 쪼그려 앉았다｡"
  },
  {
   "id": 6189,
   "key": "D0501.txt:1817",
   "file": "D0501.txt",
   "line": 1817,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "頭上を回転する偃月刀が通り過ぎていく。",
   "ko_candidate": "머리 위로 회전하는 언월도가 지나간다｡"
  },
  {
   "id": 6190,
   "key": "D0501.txt:1818",
   "file": "D0501.txt",
   "line": 1818,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "髪の毛が数本切れて、風に舞った。",
   "ko_candidate": "머리카락이 몇 가닥 잘려 바람에 날렸다｡"
  },
  {
   "id": 6191,
   "key": "D0501.txt:1824",
   "file": "D0501.txt",
   "line": 1824,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くっ……あれには妾の魔術防禦も効かぬぞ！　間違っても触れるな！」",
   "ko_candidate": "「큿… 그것에는 내 마술 방어도 통하지 않아! 절대로 닿지 않도록 해!」"
  },
  {
   "id": 6192,
   "key": "D0501.txt:1829",
   "file": "D0501.txt",
   "line": 1829,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……ってそんな代物、どうやって捕まえれば良いんだよ!?」",
   "ko_candidate": "「…그런 물건､ 어떻게 잡으면 좋다는 거야!?」"
  },
  {
   "id": 6193,
   "key": "D0501.txt:1834",
   "file": "D0501.txt",
   "line": 1834,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「創意工夫あるべし！」",
   "ko_candidate": "「창의력을 발휘해야지!」"
  },
  {
   "id": 6194,
   "key": "D0501.txt:1839",
   "file": "D0501.txt",
   "line": 1839,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「考えてないなっ!? 何も考えてないんだなっ、古本娘っ!?」",
   "ko_candidate": "「생각 안 했구나!? 아무것도 생각 안 했구나､ 고서 아가씨!?」"
  },
  {
   "id": 6195,
   "key": "D0501.txt:1859",
   "file": "D0501.txt",
   "line": 1859,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ボサっとするな！ 次が来るぞ！」",
   "ko_candidate": "「멍하니 있지 마! 다음이 온다!」"
  },
  {
   "id": 6196,
   "key": "D0501.txt:1870",
   "file": "D0501.txt",
   "line": 1870,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ぬわわわわっ!? ……ちっ！　このままじゃ刺身にされちまう！」",
   "ko_candidate": "「누와와와왓!? …칫! 이대로라면 회 감으로 되고 말 거야!」"
  },
  {
   "id": 6197,
   "key": "D0501.txt:1876",
   "file": "D0501.txt",
   "line": 1876,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "弧を描きながら、偃月刀は襲いかかる。",
   "ko_candidate": "호를 그리며 언월도가 덮쳐온다｡"
  },
  {
   "id": 6198,
   "key": "D0501.txt:1879",
   "file": "D0501.txt",
   "line": 1879,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ある程度、動きが規則的なのが救いだが、これでは埒が明かない。",
   "ko_candidate": "움직임이 어느 정도 규칙적인 게 다행이지만､ 이래서는 해결이 안 된다｡"
  },
  {
   "id": 6199,
   "key": "D0501.txt:1882",
   "file": "D0501.txt",
   "line": 1882,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何か奴の動きを止める手立てはないか!?",
   "ko_candidate": "뭔가､ 그놈의 움직임을 멈출 방법은 없을까!?"
  },
  {
   "id": 6200,
   "key": "D0501.txt:1910",
   "file": "D0501.txt",
   "line": 1910,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――イヤな予感がする。",
   "ko_candidate": "――싫은 예감이 든다｡"
  },
  {
   "id": 6201,
   "key": "D0501.txt:1930",
   "file": "D0501.txt",
   "line": 1930,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "両脇にそびえるビルに切れ目が入った。不穏な地響きを起こしながら、こちらに向かって滑り墜ちてくる！",
   "ko_candidate": "양옆에 솟은 빌딩에 절단선이 들어갔다｡ 고고고고…… 하는 불길한 소리를 내며 이쪽으로 미끄러져 떨어져 온다｡"
  },
  {
   "id": 6202,
   "key": "D0501.txt:1932",
   "file": "D0501.txt",
   "line": 1932,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "くそ！　またかよっ！",
   "ko_candidate": "또냐고!"
  },
  {
   "id": 6203,
   "key": "D0501.txt:1939",
   "file": "D0501.txt",
   "line": 1939,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「もう一度飛ぶぞ！　……って、ぶべっ！」",
   "ko_candidate": "「한 번 더 날아볼게! ……어､ 부베!」"
  },
  {
   "id": 6204,
   "key": "D0501.txt:1953",
   "file": "D0501.txt",
   "line": 1953,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "飛ぼうとしたはずが、顔から地面に突っ込んでしまった。うぅっ……鼻血が出てる。",
   "ko_candidate": "날아오르려 했는데､ 얼굴부터 땅에 처박혀 버렸다｡ 젠장､ 코피가 나고 있어｡"
  },
  {
   "id": 6205,
   "key": "D0501.txt:1960",
   "file": "D0501.txt",
   "line": 1960,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うつけ！　背中を見ろ！」",
   "ko_candidate": "「멍청아! 등을 봐!」"
  },
  {
   "id": 6206,
   "key": "D0501.txt:1966",
   "file": "D0501.txt",
   "line": 1966,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………あ゛」",
   "ko_candidate": "「…………아」"
  },
  {
   "id": 6207,
   "key": "D0501.txt:1970",
   "file": "D0501.txt",
   "line": 1970,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さっき、頭上をかすめていった時だろう。",
   "ko_candidate": "아까 머리를 스쳐 갔을 때겠지｡"
  },
  {
   "id": 6208,
   "key": "D0501.txt:1971",
   "file": "D0501.txt",
   "line": 1971,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒翼がバッサリと切断されていた。",
   "ko_candidate": "마기우스 윙의 한쪽 날개가 싹둑 잘려 있었다｡"
  },
  {
   "id": 6209,
   "key": "D0501.txt:1972",
   "file": "D0501.txt",
   "line": 1972,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確かに、これでは飛べない。",
   "ko_candidate": "이거로는 확실히 날 수 없겠어｡"
  },
  {
   "id": 6210,
   "key": "D0501.txt:1978",
   "file": "D0501.txt",
   "line": 1978,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……って、おい！　これじゃ逃げられ……！」",
   "ko_candidate": "「……어이! 이러다간 도망칠 수 없……!」"
  },
  {
   "id": 6211,
   "key": "D0501.txt:1999",
   "file": "D0501.txt",
   "line": 1999,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――最後まで言い終わることなく、俺たちは倒れてきたビルの下敷きになった。",
   "ko_candidate": "――마지막 말을 끝내기도 전에､ 우리는 쓰러져 온 빌딩에 깔려 버렸다｡ 아직 먼지가 자욱한 일대｡"
  },
  {
   "id": 6212,
   "key": "D0501.txt:2016",
   "file": "D0501.txt",
   "line": 2016,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだ土煙が立ち込める一帯。",
   "ko_candidate": "잔해의 산 위를 언월도가 선회한다｡"
  },
  {
   "id": 6214,
   "key": "D0501.txt:2017",
   "file": "D0501.txt",
   "line": 2017,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガレキの山の上を偃月刀が旋回する。",
   "ko_candidate": "근처에 움직이는 것은 아무것도 없다…… 아니｡"
  },
  {
   "id": 6215,
   "key": "D0501.txt:2020",
   "file": "D0501.txt",
   "line": 2020,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やがて地上に降りて静止する。敵は沈黙。近くに動くものは何もない……",
   "ko_candidate": "잔해 아래에서 『나』는 손을 뻗었다｡"
  },
  {
   "id": 6216,
   "key": "D0501.txt:2020",
   "file": "D0501.txt",
   "line": 2020,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "って、甘いんだよ！",
   "ko_candidate": "언월도의 손잡이를 붙잡는다｡"
  },
  {
   "id": 6217,
   "key": "D0501.txt:2036",
   "file": "D0501.txt",
   "line": 2036,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガレキの下から『俺』は手を伸ばし、偃月刀の柄を捕まえた。",
   "ko_candidate": "초조한 듯 날뛰기 시작하는 언월도｡ 양손으로 손잡이를 꽉 잡고 놓치지 않으려 한다｡"
  },
  {
   "id": 6218,
   "key": "D0501.txt:2046",
   "file": "D0501.txt",
   "line": 2046,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ははは！　勝負あり、観念しやがれ！」",
   "ko_candidate": "「하하하! 승부는 끝났어､ 포기해라!」"
  },
  {
   "id": 6219,
   "key": "D0501.txt:2054",
   "file": "D0501.txt",
   "line": 2054,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "偃月刀を捕まえたまま、降り積もったガレキを跳ねのける。",
   "ko_candidate": "언월도를 붙잡은 채､ 몸 위에 쌓인 잔해를 털어냈다｡ 그렇게 무거운 잔해 아래에 숨어 있었기에､ 온몸이 아팠다｡"
  },
  {
   "id": 6220,
   "key": "D0501.txt:2056",
   "file": "D0501.txt",
   "line": 2056,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "手の中の偃月刀が激しく暴れる。",
   "ko_candidate": "손 안의 언월도는 더욱 격렬하게 날뛴다｡"
  }
 ]
}