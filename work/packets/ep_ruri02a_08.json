 },
 "items": [
  {
   "id": 50853,
   "key": "ep_ruri02a.txt:1009",
   "file": "ep_ruri02a.txt",
   "line": 1009,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "今、この一瞬だけは、大十字九郎に戻ることを許して頂きたい。",
   "ko_candidate": ""
  },
  {
   "id": 50854,
   "key": "ep_ruri02a.txt:1010",
   "file": "ep_ruri02a.txt",
   "line": 1010,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何故なら奴は、君との約束を破ったことを、酷く気に病んでいたから。",
   "ko_candidate": ""
  },
  {
   "id": 50855,
   "key": "ep_ruri02a.txt:1011",
   "file": "ep_ruri02a.txt",
   "line": 1011,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そしてようやく、約束を果たせる時がやって来たから。",
   "ko_candidate": ""
  },
  {
   "id": 50856,
   "key": "ep_ruri02a.txt:1017",
   "file": "ep_ruri02a.txt",
   "line": 1017,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だから――今だけは―― 母親の胸に抱かれ――何も知らずに笑う君に――",
   "ko_candidate": "은빛 머리카락을 엮고､ 사지를 조립하고､ 피부는 질감을 얻어､ 인간 형태를 형성"
  },
  {
   "id": 50857,
   "key": "ep_ruri02a.txt:1021",
   "file": "ep_ruri02a.txt",
   "line": 1021,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「生まれてくれて、ありがとう」 という感謝と共に――",
   "ko_candidate": "해 간다｡"
  },
  {
   "id": 50858,
   "key": "ep_ruri02a.txt:1024",
   "file": "ep_ruri02a.txt",
   "line": 1024,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの時の約束を果たす、言葉を――",
   "ko_candidate": ""
  },
  {
   "id": 50859,
   "key": "ep_ruri02a.txt:1026",
   "file": "ep_ruri02a.txt",
   "line": 1026,
   "speaker": "鋼造",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺の、大事な姫さんに―― 「ただいま、瑠璃」",
   "ko_candidate": "소녀가 귀환했다｡"
  },
  {
   "id": 50860,
   "key": "ep_ruri02a.txt:1045",
   "file": "ep_ruri02a.txt",
   "line": 1045,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "自らの躰を抱いて……私はまた泣き出していた。",
   "ko_candidate": ""
  },
  {
   "id": 50861,
   "key": "ep_ruri02a.txt:1046",
   "file": "ep_ruri02a.txt",
   "line": 1046,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だけど、今度は絶望の涙ではない。",
   "ko_candidate": ""
  },
  {
   "id": 50862,
   "key": "ep_ruri02a.txt:1047",
   "file": "ep_ruri02a.txt",
   "line": 1047,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "悲しいけど、苦しいけど、だけど喜びに満ちた、感謝の涙だった。",
   "ko_candidate": ""
  },
  {
   "id": 50863,
   "key": "ep_ruri02a.txt:1052",
   "file": "ep_ruri02a.txt",
   "line": 1052,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの人は――約束を守ってくれた。",
   "ko_candidate": ""
  },
  {
   "id": 50864,
   "key": "ep_ruri02a.txt:1053",
   "file": "ep_ruri02a.txt",
   "line": 1053,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "もうずっとずっと昔に、約束を守ってくれたんだ。",
   "ko_candidate": ""
  },
  {
   "id": 50865,
   "key": "ep_ruri02a.txt:1055",
   "file": "ep_ruri02a.txt",
   "line": 1055,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして、護っていてくれた。",
   "ko_candidate": ""
  },
  {
   "id": 50866,
   "key": "ep_ruri02a.txt:1056",
   "file": "ep_ruri02a.txt",
   "line": 1056,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ずっとずっと、私を護り続けてくれた。",
   "ko_candidate": ""
  },
  {
   "id": 50867,
   "key": "ep_ruri02a.txt:1057",
   "file": "ep_ruri02a.txt",
   "line": 1057,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "あの人は、私が生まれてから、ずっと護ってくれていた。",
   "ko_candidate": ""
  },
  {
   "id": 50868,
   "key": "ep_ruri02a.txt:1058",
   "file": "ep_ruri02a.txt",
   "line": 1058,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "お爺様は、死んだその後もずっと、私を護り続けてくれた。",
   "ko_candidate": ""
  },
  {
   "id": 50869,
   "key": "ep_ruri02a.txt:1060",
   "file": "ep_ruri02a.txt",
   "line": 1060,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ああ、今なら言える。",
   "ko_candidate": ""
  },
  {
   "id": 50870,
   "key": "ep_ruri02a.txt:1061",
   "file": "ep_ruri02a.txt",
   "line": 1061,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ようやく言える。 あの人に。",
   "ko_candidate": "이 기적 속에서､ 재생했다｡"
  },
  {
   "id": 50871,
   "key": "ep_ruri02a.txt:1063",
   "file": "ep_ruri02a.txt",
   "line": 1063,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "傷だらけのあの人に。 それでも戦い続けたあの人に。",
   "ko_candidate": "시시한 듯이 나를 노려보며､ 퉁명스럽게 외친다｡"
  },
  {
   "id": 50872,
   "key": "ep_ruri02a.txt:1065",
   "file": "ep_ruri02a.txt",
   "line": 1065,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ずっとずっと、言いたかった、あの言葉を。",
   "ko_candidate": ""
  },
  {
   "id": 50873,
   "key": "ep_ruri02a.txt:1066",
   "file": "ep_ruri02a.txt",
   "line": 1066,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ずっとずっと、暖め続けていた、あの言葉を。 今、ようやく――",
   "ko_candidate": "「와라! 요그 소토스의 고리를 파괴하자! 이 세계에…… 쿠로에게､ 미래를……!」"
  },
  {
   "id": 50874,
   "key": "ep_ruri02a.txt:1078",
   "file": "ep_ruri02a.txt",
   "line": 1078,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "消え逝く光の塵に、照らされながら――",
   "ko_candidate": ""
  },
  {
   "id": 50875,
   "key": "ep_ruri02a.txt:1079",
   "file": "ep_ruri02a.txt",
   "line": 1079,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "消え逝くアルの残滓に、照らされながら――",
   "ko_candidate": ""
  },
  {
   "id": 50876,
   "key": "ep_ruri02a.txt:1080",
   "file": "ep_ruri02a.txt",
   "line": 1080,
   "speaker": "アル",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの、言葉、 「すまなかった……妾のせいで」",
   "ko_candidate": "「네!」"
  },
  {
   "id": 50877,
   "key": "ep_ruri02a.txt:1091",
   "file": "ep_ruri02a.txt",
   "line": 1091,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "掠れるような囁き。",
   "ko_candidate": ""
  },
  {
   "id": 50878,
   "key": "ep_ruri02a.txt:1092",
   "file": "ep_ruri02a.txt",
   "line": 1092,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だけど、確かに、しっかりと、この耳に聴いた。",
   "ko_candidate": ""
  },
  {
   "id": 50879,
   "key": "ep_ruri02a.txt:1094",
   "file": "ep_ruri02a.txt",
   "line": 1094,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その刹那。 私は、アルの、想いを識った。",
   "ko_candidate": "뻗어진 알의 손을 꽉 잡는다｡"
  },
  {
   "id": 50880,
   "key": "ep_ruri02a.txt:1105",
   "file": "ep_ruri02a.txt",
   "line": 1105,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光が、消え、……、――、 「――まだです」",
   "ko_candidate": "나와 알의 몸이 공중에 떠올라 빛에 휩싸였다｡"
  },
  {
   "id": 50881,
   "key": "ep_ruri02a.txt:1114",
   "file": "ep_ruri02a.txt",
   "line": 1114,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そう、まだ。 まだだ。",
   "ko_candidate": "내 내부를 질주하는 술식｡"
  },
  {
   "id": 50882,
   "key": "ep_ruri02a.txt:1116",
   "file": "ep_ruri02a.txt",
   "line": 1116,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その言葉を言うのは、正しくない。",
   "ko_candidate": ""
  },
  {
   "id": 50883,
   "key": "ep_ruri02a.txt:1117",
   "file": "ep_ruri02a.txt",
   "line": 1117,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "消え逝くのも、間違っている。 「まだ、終わっていません」",
   "ko_candidate": "내 모습은 그 검은 지령복 차림…… 마기우스 스타일로 바뀐다｡"
  },
  {
   "id": 50884,
   "key": "ep_ruri02a.txt:1127",
   "file": "ep_ruri02a.txt",
   "line": 1127,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "終わっていない。",
   "ko_candidate": ""
  },
  {
   "id": 50885,
   "key": "ep_ruri02a.txt:1128",
   "file": "ep_ruri02a.txt",
   "line": 1128,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "まだ、何も終わっていない。",
   "ko_candidate": ""
  },
  {
   "id": 50886,
   "key": "ep_ruri02a.txt:1129",
   "file": "ep_ruri02a.txt",
   "line": 1129,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "終わったと思うのは、私の時間から見てるから。",
   "ko_candidate": ""
  },
  {
   "id": 50887,
   "key": "ep_ruri02a.txt:1130",
   "file": "ep_ruri02a.txt",
   "line": 1130,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "私の主観に過ぎないから。",
   "ko_candidate": ""
  },
  {
   "id": 50888,
   "key": "ep_ruri02a.txt:1132",
   "file": "ep_ruri02a.txt",
   "line": 1132,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "今、この怪異の只中にいて……時間をも空間をも超えた怪異の中に在って、ヨグ＝ソトースの端末に触れて、そんな視点に何の意味があるだろう？",
   "ko_candidate": ""
  },
  {
   "id": 50889,
   "key": "ep_ruri02a.txt:1134",
   "file": "ep_ruri02a.txt",
   "line": 1134,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これからだ。 運命を変えるのは、これからだ。",
   "ko_candidate": "「도약한다!」"
  },
  {
   "id": 50890,
   "key": "ep_ruri02a.txt:1136",
   "file": "ep_ruri02a.txt",
   "line": 1136,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "今ならば……こんな奇蹟に包まれている今ならば、この永遠を終わらせる事が出来る……！",
   "ko_candidate": ""
  },
  {
   "id": 50891,
   "key": "ep_ruri02a.txt:1142",
   "file": "ep_ruri02a.txt",
   "line": 1142,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「アル！　契約を！　今一度、貴女との契約を望みます！」",
   "ko_candidate": ""
  },
  {
   "id": 50892,
   "key": "ep_ruri02a.txt:1145",
   "file": "ep_ruri02a.txt",
   "line": 1145,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "消え逝く光は、",
   "ko_candidate": ""
  }
 ]
}