 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 33664,
   "key": "D1308al.txt:358",
   "file": "D1308al.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溢れ出す。先程の慟哭よりもなお強く激しい、想いの洪水。",
   "ko_candidate": "넘쳐흐른다｡ 아까의 통곡보다도 더 강렬하고 격렬한､ 감정의 홍수｡"
  },
  {
   "id": 33665,
   "key": "D1308al.txt:358",
   "file": "D1308al.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "温もりを以て、悦びを以て、妾の内を埋め尽くす。",
   "ko_candidate": "온기를 담아､ 기쁨을 담아､ 첩의 내면을 가득 채운다｡"
  },
  {
   "id": 33666,
   "key": "D1308al.txt:360",
   "file": "D1308al.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなにも胸が熱い。",
   "ko_candidate": "이렇게나 가슴이 뜨겁다｡"
  },
  {
   "id": 33667,
   "key": "D1308al.txt:361",
   "file": "D1308al.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなにも、こんなにも、彼奴は妾にとって大きな存在だったのか。",
   "ko_candidate": "이렇게나､ 이렇게나､ 그 녀석은 첩에게 큰 존재였던 걸까｡"
  },
  {
   "id": 33668,
   "key": "D1308al.txt:363",
   "file": "D1308al.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――心が繋がった。",
   "ko_candidate": "그리고――마음이 이어졌다｡"
  },
  {
   "id": 33669,
   "key": "D1308al.txt:373",
   "file": "D1308al.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦ってる。",
   "ko_candidate": "싸우고 있다｡"
  },
  {
   "id": 33670,
   "key": "D1308al.txt:374",
   "file": "D1308al.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎が戦っている。",
   "ko_candidate": "쿠로가 싸우고 있다｡"
  },
  {
   "id": 33671,
   "key": "D1308al.txt:376",
   "file": "D1308al.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力を失ってもなお。",
   "ko_candidate": "힘을 잃어도 여전히｡"
  },
  {
   "id": 33672,
   "key": "D1308al.txt:377",
   "file": "D1308al.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深い傷を負ってもなお。",
   "ko_candidate": "깊은 상처를 입어도 여전히｡"
  },
  {
   "id": 33673,
   "key": "D1308al.txt:378",
   "file": "D1308al.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絶望の淵に追いやられてもなお。",
   "ko_candidate": "절망의 나락으로 내몰려도 여전히｡"
  },
  {
   "id": 33674,
   "key": "D1308al.txt:380",
   "file": "D1308al.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎は戦っている。",
   "ko_candidate": "쿠로는 싸우고 있다｡"
  },
  {
   "id": 33675,
   "key": "D1308al.txt:388",
   "file": "D1308al.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "分かる。",
   "ko_candidate": "알겠어｡"
  },
  {
   "id": 33676,
   "key": "D1308al.txt:389",
   "file": "D1308al.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "感じる。",
   "ko_candidate": "느껴져｡"
  },
  {
   "id": 33677,
   "key": "D1308al.txt:390",
   "file": "D1308al.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎の怒りを、悲しみを、苦しみを、痛みを。",
   "ko_candidate": "쿠로의 분노를､ 슬픔을､ 고통을､ 아픔을｡"
  },
  {
   "id": 33678,
   "key": "D1308al.txt:391",
   "file": "D1308al.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "圧倒的な激しさを以て襲う其れに、九郎は全力で 抗っている。",
   "ko_candidate": "압도적인 격렬함으로 덮치는 그것에､ 쿠로는 전력으로 맞서고 있다｡"
  },
  {
   "id": 33679,
   "key": "D1308al.txt:394",
   "file": "D1308al.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もどかしい。 腹立たしい。",
   "ko_candidate": "답답해｡"
  },
  {
   "id": 33680,
   "key": "D1308al.txt:397",
   "file": "D1308al.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんなもの、",
   "ko_candidate": "화가 나｡"
  },
  {
   "id": 33681,
   "key": "D1308al.txt:398",
   "file": "D1308al.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その程度の輩、 本来の力を持っていれば――",
   "ko_candidate": "그런 것､ 그 정도의 무리､ 본래의 힘만 있다면――"
  },
  {
   "id": 33682,
   "key": "D1308al.txt:401",
   "file": "D1308al.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "妾と汝が２人居れば、 何ら怖れるに足らないと云うのに！",
   "ko_candidate": "첩과 너 둘이 있다면､ 전혀 두려워할 것 없다고 하는데!"
  },
  {
   "id": 33683,
   "key": "D1308al.txt:411",
   "file": "D1308al.txt",
   "line": 411,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 33684,
   "key": "D1308al.txt:414",
   "file": "D1308al.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……そうだ。",
   "ko_candidate": "……그래｡"
  },
  {
   "id": 33685,
   "key": "D1308al.txt:415",
   "file": "D1308al.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだった。何故、忘れていたのか。",
   "ko_candidate": "그랬지｡ 왜 잊고 있었던 걸까｡"
  },
  {
   "id": 33686,
   "key": "D1308al.txt:417",
   "file": "D1308al.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あのとき、誓ったでは無いか。",
   "ko_candidate": "그때､ 맹세하지 않았던가｡"
  },
  {
   "id": 33687,
   "key": "D1308al.txt:418",
   "file": "D1308al.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦痛も悲しみも後悔も、我等２人で分かち合おうと。",
   "ko_candidate": "고통도 슬픔도 후회도､ 우리 둘이서 나누자고｡"
  },
  {
   "id": 33688,
   "key": "D1308al.txt:420",
   "file": "D1308al.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何て様だ。",
   "ko_candidate": "뭐하는 꼴이람｡"
  },
  {
   "id": 33689,
   "key": "D1308al.txt:421",
   "file": "D1308al.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなところで手を拱いている場合ではなかろう！",
   "ko_candidate": "이런 곳에서 손 놓고 있을 때가 아니지!"
  },
  {
   "id": 33690,
   "key": "D1308al.txt:422",
   "file": "D1308al.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 33691,
   "key": "D1308al.txt:426",
   "file": "D1308al.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――戦わなければ！",
   "ko_candidate": "――싸워야 해!"
  },
  {
   "id": 33692,
   "key": "D1308al.txt:437",
   "file": "D1308al.txt",
   "line": 437,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ……」",
   "ko_candidate": "「앗……」"
  },
  {
   "id": 33693,
   "key": "D1308al.txt:440",
   "file": "D1308al.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気付けば。",
   "ko_candidate": "정신을 차려보니｡"
  },
  {
   "id": 33694,
   "key": "D1308al.txt:441",
   "file": "D1308al.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "骸達の姿はもう何処にもなかった。",
   "ko_candidate": "시체들의 모습은 이미 어디에도 없었다｡"
  },
  {
   "id": 33695,
   "key": "D1308al.txt:442",
   "file": "D1308al.txt",
   "line": 442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして血塗れの路もまた。",
   "ko_candidate": "그리고 피투성이 길 또한｡"
  },
  {
   "id": 33696,
   "key": "D1308al.txt:443",
   "file": "D1308al.txt",
   "line": 443,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処にあるのは、ただ――",
   "ko_candidate": "여기 있는 것은､ 단지――"
  },
  {
   "id": 33697,
   "key": "D1308al.txt:447",
   "file": "D1308al.txt",
   "line": 447,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「分かっておる。分かっておるとも。もう、大丈夫だ」 「……ありがとう。不甲斐ない妾を、見守っていてくれて」",
   "ko_candidate": "「알고 있어｡ 알고 있다고｡ 이제､ 괜찮아｡ ……고마워｡ 무능한 나를､ 지켜봐 주어서」"
  },
  {
   "id": 33698,
   "key": "D1308al.txt:455",
   "file": "D1308al.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地面に落ちた刃を拾う。 無垢なる刃。",
   "ko_candidate": "땅에 떨어진 칼을 주워든다｡"
  },
  {
   "id": 33699,
   "key": "D1308al.txt:457",
   "file": "D1308al.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔を断つ剣。",
   "ko_candidate": "무구한 칼날｡"
  },
  {
   "id": 33700,
   "key": "D1308al.txt:459",
   "file": "D1308al.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "輝いている。",
   "ko_candidate": "빛나고 있다｡"
  },
  {
   "id": 33701,
   "key": "D1308al.txt:459",
   "file": "D1308al.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誇りに、",
   "ko_candidate": "긍지로､"
  },
  {
   "id": 33702,
   "key": "D1308al.txt:459",
   "file": "D1308al.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛に、",
   "ko_candidate": "사랑으로､"
  },
  {
   "id": 33703,
   "key": "D1308al.txt:459",
   "file": "D1308al.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして正義に。",
   "ko_candidate": "그리고 정의로｡"
  }
 ]
}