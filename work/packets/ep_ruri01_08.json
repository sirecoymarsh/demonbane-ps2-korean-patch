 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "覇道鋼造": "하도 코조",
  "大十字九郎": "다이쥬지 쿠로",
  "デモンベイン": "데몬베인"
 },
 "items": [
  {
   "id": 50458,
   "key": "ep_ruri01.txt:1011",
   "file": "ep_ruri01.txt",
   "line": 1011,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その顔を正面から見つめ返すことが、俺には少し辛い。",
   "ko_candidate": "그 얼굴을 정면에서 마주 보는 것이 나에게는 조금 괴롭다｡"
  },
  {
   "id": 50459,
   "key": "ep_ruri01.txt:1013",
   "file": "ep_ruri01.txt",
   "line": 1013,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、俺の心を騒がせる要因が、もう一つある。",
   "ko_candidate": "그리고 내 마음을 어지럽히는 요인이 하나 더 있다｡"
  },
  {
   "id": 50460,
   "key": "ep_ruri01.txt:1014",
   "file": "ep_ruri01.txt",
   "line": 1014,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "というより、たった今、生まれた。",
   "ko_candidate": "라기보다는､ 방금 생겨났다｡"
  },
  {
   "id": 50461,
   "key": "ep_ruri01.txt:1019",
   "file": "ep_ruri01.txt",
   "line": 1019,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の前を行く、息子の背中を見つめながら、自問する。",
   "ko_candidate": "내 앞을 가는 아들의 등을 바라보며 자문한다｡"
  },
  {
   "id": 50462,
   "key": "ep_ruri01.txt:1021",
   "file": "ep_ruri01.txt",
   "line": 1021,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は――覇道鋼造でいられるか？",
   "ko_candidate": "나는―하도 코조로 있을 수 있을까?"
  },
  {
   "id": 50463,
   "key": "ep_ruri01.txt:1023",
   "file": "ep_ruri01.txt",
   "line": 1023,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "彼女を前にして、育ってゆく彼女を目の当たりにして、それでもずっと、覇道鋼造でいられるのか？",
   "ko_candidate": "그녀를 마주하고､ 자라나는 그녀를 직접 보면서도 계속 하도 코조로 있을 수 있을까?"
  },
  {
   "id": 50464,
   "key": "ep_ruri01.txt:1024",
   "file": "ep_ruri01.txt",
   "line": 1024,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は――戦い続けることが出来るのか？",
   "ko_candidate": "나는―계속 싸울 수 있을까?"
  },
  {
   "id": 50465,
   "key": "ep_ruri01.txt:1026",
   "file": "ep_ruri01.txt",
   "line": 1026,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "瞳を閉じる。",
   "ko_candidate": "눈을 감는다｡"
  },
  {
   "id": 50466,
   "key": "ep_ruri01.txt:1027",
   "file": "ep_ruri01.txt",
   "line": 1027,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "心の中で思い返す。",
   "ko_candidate": "마음속으로 되새긴다｡"
  },
  {
   "id": 50467,
   "key": "ep_ruri01.txt:1028",
   "file": "ep_ruri01.txt",
   "line": 1028,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この時間が始まる前のこと。",
   "ko_candidate": "이 시간이 시작되기 전의 일을｡"
  },
  {
   "id": 50468,
   "key": "ep_ruri01.txt:1029",
   "file": "ep_ruri01.txt",
   "line": 1029,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "輪廻する以前の、世界の出来事だ。",
   "ko_candidate": "윤회하기 이전의 세계의 일이다｡"
  },
  {
   "id": 50469,
   "key": "ep_ruri01.txt:1031",
   "file": "ep_ruri01.txt",
   "line": 1031,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その世界で俺は彼女と出会い――そして。",
   "ko_candidate": "그 세계에서 나는 그녀와 만났고―그리고｡"
  },
  {
   "id": 50470,
   "key": "ep_ruri01.txt:1037",
   "file": "ep_ruri01.txt",
   "line": 1037,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あの世界の覇道鋼造はどうだったのか？",
   "ko_candidate": "그 세계의 하도 코조는 어땠을까?"
  },
  {
   "id": 50471,
   "key": "ep_ruri01.txt:1038",
   "file": "ep_ruri01.txt",
   "line": 1038,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "出会ったことも無い、男のことを思う。",
   "ko_candidate": "만난 적도 없는 남자를 생각한다｡"
  },
  {
   "id": 50472,
   "key": "ep_ruri01.txt:1040",
   "file": "ep_ruri01.txt",
   "line": 1040,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "覇道鋼造。",
   "ko_candidate": "하도 코조｡"
  },
  {
   "id": 50473,
   "key": "ep_ruri01.txt:1041",
   "file": "ep_ruri01.txt",
   "line": 1041,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大十字九郎。",
   "ko_candidate": "다이쥬지 쿠로｡"
  },
  {
   "id": 50474,
   "key": "ep_ruri01.txt:1042",
   "file": "ep_ruri01.txt",
   "line": 1042,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "前回の俺。",
   "ko_candidate": "이전의 나｡"
  },
  {
   "id": 50475,
   "key": "ep_ruri01.txt:1044",
   "file": "ep_ruri01.txt",
   "line": 1044,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "お前は、覇道鋼造で居られたか？",
   "ko_candidate": "너는 하도 코조로 있을 수 있었나?"
  },
  {
   "id": 50476,
   "key": "ep_ruri01.txt:1049",
   "file": "ep_ruri01.txt",
   "line": 1049,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――居られたはずだ。",
   "ko_candidate": "―있을 수 있었을 것이다｡"
  },
  {
   "id": 50477,
   "key": "ep_ruri01.txt:1050",
   "file": "ep_ruri01.txt",
   "line": 1050,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、俺たちが巡り愛った。",
   "ko_candidate": "그래서 우리가 만나게 되었다｡"
  },
  {
   "id": 50478,
   "key": "ep_ruri01.txt:1051",
   "file": "ep_ruri01.txt",
   "line": 1051,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "前回の覇道鋼造は……きっと今までの覇道鋼造と同様、彼女の未来を切り拓く為、気高く戦えたはずなのだ。",
   "ko_candidate": "이전의 하도 코조는… 분명 지금까지의 하도 코조와 마찬가지로､ 그녀의 미래를 개척하기 위해 고귀하게 싸웠을 것이다｡"
  },
  {
   "id": 50479,
   "key": "ep_ruri01.txt:1053",
   "file": "ep_ruri01.txt",
   "line": 1053,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、大丈夫だ。",
   "ko_candidate": "그러니까 괜찮다｡"
  },
  {
   "id": 50480,
   "key": "ep_ruri01.txt:1054",
   "file": "ep_ruri01.txt",
   "line": 1054,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は覇道鋼造で居られる。",
   "ko_candidate": "나는 하도 코조로 있을 수 있다｡"
  },
  {
   "id": 50481,
   "key": "ep_ruri01.txt:1055",
   "file": "ep_ruri01.txt",
   "line": 1055,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "揺らがず、迷わず、覇道鋼造で居られる。",
   "ko_candidate": "흔들리지 않고､ 망설이지 않고､ 하도 코조로 있을 수 있다｡"
  },
  {
   "id": 50482,
   "key": "ep_ruri01.txt:1057",
   "file": "ep_ruri01.txt",
   "line": 1057,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして彼女の未来を切り拓く為、魔を断つ総ての力を蓄える。",
   "ko_candidate": "그리고 그녀의 미래를 개척하기 위해 마를 베는 모든 힘을 모은다｡"
  },
  {
   "id": 50483,
   "key": "ep_ruri01.txt:1059",
   "file": "ep_ruri01.txt",
   "line": 1059,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、託そう。",
   "ko_candidate": "그리고 맡기자｡"
  },
  {
   "id": 50484,
   "key": "ep_ruri01.txt:1060",
   "file": "ep_ruri01.txt",
   "line": 1060,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "未来の戦士達へと。",
   "ko_candidate": "미래의 전사들에게｡"
  },
  {
   "id": 50485,
   "key": "ep_ruri01.txt:1061",
   "file": "ep_ruri01.txt",
   "line": 1061,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いつかは辿り着く勝利を掴む者達へ。",
   "ko_candidate": "언젠가는 도달할 승리를 잡을 자들에게｡"
  },
  {
   "id": 50486,
   "key": "ep_ruri01.txt:1062",
   "file": "ep_ruri01.txt",
   "line": 1062,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の持てる、力の総てを。",
   "ko_candidate": "내가 가진 모든 힘을｡"
  },
  {
   "id": 50487,
   "key": "ep_ruri01.txt:1069",
   "file": "ep_ruri01.txt",
   "line": 1069,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "現在、地下基地建造計画は静かに進行している。",
   "ko_candidate": "현재､ 지하기지 건설 계획은 조용히 진행되고 있다｡"
  },
  {
   "id": 50488,
   "key": "ep_ruri01.txt:1070",
   "file": "ep_ruri01.txt",
   "line": 1070,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして極秘裏に造られた格納庫に――アリゾナから回収したデモンベインが眠っている。",
   "ko_candidate": "그리고 극비리에 만들어진 격납고에―아리조나에서 회수한 데몬베인이 잠들어 있다｡"
  },
  {
   "id": 50489,
   "key": "ep_ruri01.txt:1072",
   "file": "ep_ruri01.txt",
   "line": 1072,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔を断つ剣は彼女に託され――そして彼女の手で、彼女を護る戦士へと手渡されるのだ。",
   "ko_candidate": "마를 베는 검은 그녀에게 맡겨졌고―그리고 그녀의 손으로､ 그녀를 지키는 전사에게 전해지는 것이다｡"
  },
  {
   "id": 50490,
   "key": "ep_ruri01.txt:1077",
   "file": "ep_ruri01.txt",
   "line": 1077,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼女は、そこで大ポカをやらかす。",
   "ko_candidate": "그녀는 거기서 큰 실수를 저지른다｡"
  },
  {
   "id": 50491,
   "key": "ep_ruri01.txt:1084",
   "file": "ep_ruri01.txt",
   "line": 1084,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "剣を渡したのは、よりにもよって、いい加減で自分勝手極まる、どこの馬の骨とも知れぬ小僧なのだ。",
   "ko_candidate": "검을 건넨 상대는 하필이면 대충 살고 제멋대로인 정체불명의 꼬마였다｡"
  },
  {
   "id": 50492,
   "key": "ep_ruri01.txt:1085",
   "file": "ep_ruri01.txt",
   "line": 1085,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そいつは彼女に散々迷惑をかけて、散々怒らせて、それでも懲りずに迷惑をかけ続ける。そういう事になっている。",
   "ko_candidate": "그 녀석은 그녀에게 엄청난 폐를 끼치고､ 엄청나게 화나게 하고､ 그래도 질리지 않고 계속 폐를 끼친다｡ 그렇게 되어 있다｡"
  },
  {
   "id": 50493,
   "key": "ep_ruri01.txt:1091",
   "file": "ep_ruri01.txt",
   "line": 1091,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、どうか勘弁してやって欲しい。",
   "ko_candidate": "하지만 제발 용서해 주었으면 좋겠다｡"
  },
  {
   "id": 50494,
   "key": "ep_ruri01.txt:1098",
   "file": "ep_ruri01.txt",
   "line": 1098,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そいつは、どうしようもなくいい加減で自分勝手でどこの馬の骨とも知らない小僧には違いないが――",
   "ko_candidate": "그 녀석은 어쩔 수 없이 대충 살고 제멋대로이며 정체불명의 꼬마임에 틀림없지만―"
  },
  {
   "id": 50495,
   "key": "ep_ruri01.txt:1098",
   "file": "ep_ruri01.txt",
   "line": 1098,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悪を憎む心は本物だから。",
   "ko_candidate": "악을 미워하는 마음만큼은 진짜니까｡"
  },
  {
   "id": 50496,
   "key": "ep_ruri01.txt:1100",
   "file": "ep_ruri01.txt",
   "line": 1100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "君から未来を奪う邪悪を、決して赦したりはしないから。",
   "ko_candidate": "너에게서 미래를 빼앗는 사악함을 결코 용서하지 않을 테니까｡"
  },
  {
   "id": 50497,
   "key": "ep_ruri01.txt:1101",
   "file": "ep_ruri01.txt",
   "line": 1101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そしていつか必ず、君の未来を切り拓く――俺はそう信じてる。",
   "ko_candidate": "그리고 언젠가 반드시 너의 미래를 개척할 거야―나는 그렇게 믿고 있다｡"
  }
 ]
}