  },
  {
   "id": 11997,
   "key": "D0801le.txt:101",
   "file": "D0801le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白。",
   "ko_candidate": "하양｡"
  },
  {
   "id": 11998,
   "key": "D0801le.txt:103",
   "file": "D0801le.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "混じらない白。近寄らない白。触れ合わない白。",
   "ko_candidate": "섞이지 않는 하양｡ 가까이 가지 않는 하양｡ 맞닿지 않는 하양｡"
  },
  {
   "id": 11999,
   "key": "D0801le.txt:104",
   "file": "D0801le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白の毎日に、私の心は擦り切れていく。",
   "ko_candidate": "하양의 나날에､ 나의 마음은 닳아간다｡"
  },
  {
   "id": 12000,
   "key": "D0801le.txt:106",
   "file": "D0801le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しろのせかいに、わたしのこころが、とけてゆく――",
   "ko_candidate": "하얀 세상에､ 나의 마음이､ 녹아간다――"
  },
  {
   "id": 12001,
   "key": "D0801le.txt:113",
   "file": "D0801le.txt",
   "line": 113,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほら……起きて。早く起きなよ」",
   "ko_candidate": "「자… 일어나｡ 빨리 일어나」"
  },
  {
   "id": 12002,
   "key": "D0801le.txt:115",
   "file": "D0801le.txt",
   "line": 115,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……揺らぐ、しろい、カーテンの向こうがわ。",
   "ko_candidate": "…흔들리는､ 하얀､ 커튼 너머｡"
  },
  {
   "id": 12003,
   "key": "D0801le.txt:118",
   "file": "D0801le.txt",
   "line": 118,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こんなにいいお天気なのに、いつまでも寝ていたらもったいないじゃないか」",
   "ko_candidate": "「이렇게 좋은 날씨인데､ 계속 자고 있으면 아깝잖아」"
  },
  {
   "id": 12004,
   "key": "D0801le.txt:120",
   "file": "D0801le.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "窓の外に広がる、白、以外の世界。",
   "ko_candidate": "창밖으로 펼쳐진､ 하양､ 이외의 세계｡"
  },
  {
   "id": 12005,
   "key": "D0801le.txt:123",
   "file": "D0801le.txt",
   "line": 123,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほら、見てごらん。こんなにも、こんなにも、きれいな青空だよ……」",
   "ko_candidate": "「봐､ 보렴｡ 이렇게도､ 이렇게도､ 아름다운 푸른 하늘이야…」"
  },
  {
   "id": 12006,
   "key": "D0801le.txt:125",
   "file": "D0801le.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 12007,
   "key": "D0801le.txt:126",
   "file": "D0801le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風になびくカーテンの向こう。",
   "ko_candidate": "바람에 나부끼는 커튼 너머｡"
  },
  {
   "id": 12008,
   "key": "D0801le.txt:127",
   "file": "D0801le.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "開け放たれた窓の向こう。",
   "ko_candidate": "활짝 열린 창문 너머｡"
  },
  {
   "id": 12009,
   "key": "D0801le.txt:128",
   "file": "D0801le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雲ひとつない",
   "ko_candidate": "구름 한 점 없는"
  },
  {
   "id": 12010,
   "key": "D0801le.txt:129",
   "file": "D0801le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処までも続く",
   "ko_candidate": "어디까지나 이어지는"
  },
  {
   "id": 12011,
   "key": "D0801le.txt:130",
   "file": "D0801le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あおい　あおい　そら。",
   "ko_candidate": "파란 파란 하늘｡"
  },
  {
   "id": 12012,
   "key": "D0801le.txt:132",
   "file": "D0801le.txt",
   "line": 132,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すべてが白に眩んだ世界で、この蒼い空だけは、何よりも鮮明だ――。",
   "ko_candidate": "모든 것이 하얗게 눈부신 세상에서､ 이 푸른 하늘만은､ 그 무엇보다도 선명하다――｡"
  },
  {
   "id": 12013,
   "key": "D0801le.txt:152",
   "file": "D0801le.txt",
   "line": 152,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ふえ？」",
   "ko_candidate": "「…응?」"
  },
  {
   "id": 12014,
   "key": "D0801le.txt:158",
   "file": "D0801le.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カーテンの隙間から差し込む朝陽と、小鳥の鳴き声に目を覚ます。",
   "ko_candidate": "커튼 틈새로 비치는 아침 햇살과､ 작은 새의 울음소리에 눈을 뜬다｡"
  },
  {
   "id": 12015,
   "key": "D0801le.txt:160",
   "file": "D0801le.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "布団を盛大に跳ね除け、枕を抱き締め、眠っていた。",
   "ko_candidate": "이불을 크게 걷어차고､ 베개를 꼭 안고､ 자고 있었다｡"
  },
  {
   "id": 12016,
   "key": "D0801le.txt:162",
   "file": "D0801le.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ひどい寝相だと、自分でも思う。",
   "ko_candidate": "심한 잠버릇이라고､ 스스로도 생각한다｡"
  },
  {
   "id": 12017,
   "key": "D0801le.txt:163",
   "file": "D0801le.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だいたいにしてどう寝転がれば、上下が逆になるものなのだろうか。",
   "ko_candidate": "대체 어떻게 누워야､ 머리의 위아래가 거꾸로 될 수 있는 걸까｡"
  },
  {
   "id": 12018,
   "key": "D0801le.txt:167",
   "file": "D0801le.txt",
   "line": 167,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はふ……はああああ～～～～っ……」",
   "ko_candidate": "「하후… 하아아아아~~~~~」"
  },
  {
   "id": 12019,
   "key": "D0801le.txt:170",
   "file": "D0801le.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "上半身を起こし、大きな欠伸をしながら、身体を伸ばす。寝ぼけまなこを擦りながら、時計を確かめた。",
   "ko_candidate": "상체를 일으키며､ 크게 하품을 하면서､ 몸을 쭉 편다｡"
  },
  {
   "id": 12020,
   "key": "D0801le.txt:172",
   "file": "D0801le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……少々、寝過ごしてしまったらしい。",
   "ko_candidate": "잠에 취한 눈을 비비며､ 시계를 확인했다｡"
  },
  {
   "id": 12021,
   "key": "D0801le.txt:174",
   "file": "D0801le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "子どもたちがお腹を空かせて待っているだろう。",
   "ko_candidate": "…조금､ 늦잠을 잔 모양이다｡ 아이들이 배고파하며 기다리고 있겠지｡"
  },
  {
   "id": 12022,
   "key": "D0801le.txt:175",
   "file": "D0801le.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "急いで支度しなければ。",
   "ko_candidate": "서둘러 준비해야겠다｡"
  }
 ]
