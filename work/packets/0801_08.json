{
 "packet": "0801_08",
 "scene": "0801",
 "anchor": {
  "hit": 49,
  "total": 61,
  "rate": 0.803
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "覇道鋼造": "하도 코조"
 },
 "items": [
  {
   "id": 12064,
   "key": "D0801ru.txt:34",
   "file": "D0801ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "揺らがぬ心で、待つ。",
   "ko_candidate": "흔들림 없는 마음으로 기다린다｡"
  },
  {
   "id": 12065,
   "key": "D0801ru.txt:37",
   "file": "D0801ru.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正しくは――焦燥を掻き集めて、待つ。",
   "ko_candidate": "정확히는 - 초조함을 긁어모아 기다린다｡"
  },
  {
   "id": 12066,
   "key": "D0801ru.txt:40",
   "file": "D0801ru.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "永きに渡る戦いだった――と回顧するのは過ちだ。",
   "ko_candidate": "오랜 싸움이었다 - 라고 회고하는 것은 잘못이다｡"
  },
  {
   "id": 12067,
   "key": "D0801ru.txt:41",
   "file": "D0801ru.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦いは、彼が彼である以前からの戦いであり、彼が彼として死んでもなお、彼を縛り続ける。",
   "ko_candidate": "싸움은 그가 그 자신이기 이전부터의 싸움이며､ 그가 그로서 죽어도 여전히 그를 구속할 것이다｡"
  },
  {
   "id": 12068,
   "key": "D0801ru.txt:43",
   "file": "D0801ru.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "永きに渡る……では無い。",
   "ko_candidate": "오랜… 것이 아니다｡"
  },
  {
   "id": 12069,
   "key": "D0801ru.txt:44",
   "file": "D0801ru.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限に続く戦いだ。",
   "ko_candidate": "무한히 계속되는 싸움이다｡"
  },
  {
   "id": 12070,
   "key": "D0801ru.txt:45",
   "file": "D0801ru.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "未来永劫。過去永劫。",
   "ko_candidate": "미래영겁｡ 과거영겁｡"
  },
  {
   "id": 12071,
   "key": "D0801ru.txt:48",
   "file": "D0801ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は、此処で果てる。",
   "ko_candidate": "그는 여기서 썩어간다｡"
  },
  {
   "id": 12072,
   "key": "D0801ru.txt:49",
   "file": "D0801ru.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "果てて、次の永劫に囚われる。",
   "ko_candidate": "썩어서 다음 영겁에 사로잡힌다｡"
  },
  {
   "id": 12073,
   "key": "D0801ru.txt:50",
   "file": "D0801ru.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限の中でゆるりゆるりと浸透する、絶望の毒。",
   "ko_candidate": "무한 속에서 서서히 스며드는 절망의 독｡"
  },
  {
   "id": 12074,
   "key": "D0801ru.txt:52",
   "file": "D0801ru.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが彼は抗い続ける。",
   "ko_candidate": "하지만 그는 계속 저항한다｡"
  },
  {
   "id": 12075,
   "key": "D0801ru.txt:53",
   "file": "D0801ru.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝利は、己の為にあるのでは無い。",
   "ko_candidate": "승리는 자신을 위한 것이 아니다｡"
  },
  {
   "id": 12076,
   "key": "D0801ru.txt:55",
   "file": "D0801ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "勝利は、いつか辿り着く、正しい未来の為に。",
   "ko_candidate": "승리는 언젠가 도달할 올바른 미래를 위해｡"
  },
  {
   "id": 12077,
   "key": "D0801ru.txt:56",
   "file": "D0801ru.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今は可能性すら略奪されている未来の為に。",
   "ko_candidate": "지금은 가능성조차 약탈당한 미래를 위해｡"
  },
  {
   "id": 12078,
   "key": "D0801ru.txt:58",
   "file": "D0801ru.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "繋がる事の無い未来の為に。",
   "ko_candidate": "연결될 수 없는 미래를 위해｡"
  },
  {
   "id": 12079,
   "key": "D0801ru.txt:59",
   "file": "D0801ru.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪悪に貪られる世界の為に。",
   "ko_candidate": "사악함에 탐닉되는 세계를 위해｡"
  },
  {
   "id": 12080,
   "key": "D0801ru.txt:60",
   "file": "D0801ru.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理不尽に凌辱される世界の為に。",
   "ko_candidate": "이치에 맞지 않게 능욕당하는 세계를 위해｡"
  },
  {
   "id": 12081,
   "key": "D0801ru.txt:62",
   "file": "D0801ru.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "我が子の明日を奪われた母の為に。",
   "ko_candidate": "내 아이의 내일을 빼앗긴 어머니를 위해｡"
  },
  {
   "id": 12082,
   "key": "D0801ru.txt:63",
   "file": "D0801ru.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "我が子の明日を護れなかった父の為に。",
   "ko_candidate": "내 아이의 내일을 지키지 못한 아버지를 위해｡"
  },
  {
   "id": 12083,
   "key": "D0801ru.txt:65",
   "file": "D0801ru.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "涸れ果てた涙の為に。",
   "ko_candidate": "말라붙은 눈물을 위해｡"
  },
  {
   "id": 12084,
   "key": "D0801ru.txt:66",
   "file": "D0801ru.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "流された血の為に。",
   "ko_candidate": "흘려진 피를 위해｡"
  },
  {
   "id": 12085,
   "key": "D0801ru.txt:68",
   "file": "D0801ru.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――勝利を。",
   "ko_candidate": "- 승리를｡"
  },
  {
   "id": 12086,
   "key": "D0801ru.txt:71",
   "file": "D0801ru.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は刃金を鍛える。",
   "ko_candidate": "그는 칼날을 단련한다｡"
  },
  {
   "id": 12087,
   "key": "D0801ru.txt:72",
   "file": "D0801ru.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの血を炎やして、刃金を鍛える。",
   "ko_candidate": "자신의 피를 불태워 칼날을 단련한다｡"
  },
  {
   "id": 12088,
   "key": "D0801ru.txt:73",
   "file": "D0801ru.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの血に漬して、刃金を鍛える。",
   "ko_candidate": "자신의 피에 담가 칼날을 단련한다｡"
  },
  {
   "id": 12089,
   "key": "D0801ru.txt:76",
   "file": "D0801ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次の戦士に託す為に。",
   "ko_candidate": "다음 전사에게 맡기기 위해｡"
  },
  {
   "id": 12090,
   "key": "D0801ru.txt:77",
   "file": "D0801ru.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次の次の戦士に託す為に。",
   "ko_candidate": "다음 다음 전사에게 맡기기 위해｡"
  },
  {
   "id": 12091,
   "key": "D0801ru.txt:78",
   "file": "D0801ru.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次の次の次の戦士に託す為に。",
   "ko_candidate": "다음 다음 다음 전사에게 맡기기 위해｡"
  },
  {
   "id": 12092,
   "key": "D0801ru.txt:80",
   "file": "D0801ru.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔を断つ戦士の為に。",
   "ko_candidate": "마를 베는 전사를 위해｡"
  },
  {
   "id": 12093,
   "key": "D0801ru.txt:81",
   "file": "D0801ru.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔を絶つ戦士の為に。",
   "ko_candidate": "마를 끊는 전사를 위해｡"
  },
  {
   "id": 12094,
   "key": "D0801ru.txt:83",
   "file": "D0801ru.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は、剣を、無垢なる刃を、鍛え上げる。",
   "ko_candidate": "그는 검을､ 무구한 칼날을､ 단련해낸다｡"
  },
  {
   "id": 12095,
   "key": "D0801ru.txt:88",
   "file": "D0801ru.txt",
   "line": 88,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「老いたな。覇道鋼造」",
   "ko_candidate": "「늙었구나｡ 하도 코조」"
  },
  {
   "id": 12096,
   "key": "D0801ru.txt:97",
   "file": "D0801ru.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色が、夜の闇を裂いた。",
   "ko_candidate": "황금빛이 밤의 어둠을 갈랐다｡"
  },
  {
   "id": 12097,
   "key": "D0801ru.txt:98",
   "file": "D0801ru.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色は、だが、光ではなかった。",
   "ko_candidate": "황금빛은 하지만 빛이 아니었다｡"
  },
  {
   "id": 12098,
   "key": "D0801ru.txt:99",
   "file": "D0801ru.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは金色の闇だった。",
   "ko_candidate": "그것은 황금빛 어둠이었다｡"
  },
  {
   "id": 12099,
   "key": "D0801ru.txt:101",
   "file": "D0801ru.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "如何なる闇黒よりも深い、深い、深い、深い、深い ……深過ぎる闇だった。",
   "ko_candidate": "어떤 암흑보다도 깊은､ 깊은､ 깊은､ 깊은､ 깊은… 너무나 깊은 어둠이었다｡"
  },
  {
   "id": 12100,
   "key": "D0801ru.txt:103",
   "file": "D0801ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の中、見開かれた金色の双眸。",
   "ko_candidate": "어둠 속､ 크게 뜬 황금빛 두 눈동자｡"
  },
  {
   "id": 12101,
   "key": "D0801ru.txt:104",
   "file": "D0801ru.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔人の双眸。",
   "ko_candidate": "마인의 두 눈동자｡"
  },
  {
   "id": 12102,
   "key": "D0801ru.txt:107",
   "file": "D0801ru.txt",
   "line": 107,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「来たか」",
   "ko_candidate": "「왔는가」"
  },
  {
   "id": 12103,
   "key": "D0801ru.txt:109",
   "file": "D0801ru.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "老人が、金色の双眸を見つめる。",
   "ko_candidate": "노인이 황금빛 두 눈동자를 바라본다｡"
  }
 ]
}