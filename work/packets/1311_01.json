 "items": [
  {
   "id": 35026,
   "key": "D1311al.txt:140",
   "file": "D1311al.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瘴気の塊が、慟哭と怨嗟に満ちた断末魔を上げる。",
   "ko_candidate": "장기의 덩어리가 비통과 원한으로 가득 찬 단말마를 지른다｡"
  },
  {
   "id": 35027,
   "key": "D1311al.txt:141",
   "file": "D1311al.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凝結した気配でしかなかったソレの表面に、無数の人間の貌が浮かび上がった。",
   "ko_candidate": "응결된 기척에 불과했던 그것의 표면에 무수한 인간의 얼굴이 떠올랐다｡"
  },
  {
   "id": 35028,
   "key": "D1311al.txt:143",
   "file": "D1311al.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "男の貌があった。女の貌があった。",
   "ko_candidate": "남자의 얼굴이 있었다｡ 여자의 얼굴이 있었다｡"
  },
  {
   "id": 35029,
   "key": "D1311al.txt:144",
   "file": "D1311al.txt",
   "line": 144,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "老いた貌があり、若い貌もあり…… やはり子供の貌もあった。",
   "ko_candidate": "늙은 얼굴이 있고 젊은 얼굴도 있고……역시 아이의 얼굴도 있었다｡"
  },
  {
   "id": 35030,
   "key": "D1311al.txt:147",
   "file": "D1311al.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "共通点は唯一つ。",
   "ko_candidate": "공통점은 단 하나｡"
  },
  {
   "id": 35031,
   "key": "D1311al.txt:148",
   "file": "D1311al.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深く深く刻み込まれた苦悶の表情だけ。",
   "ko_candidate": "깊이 깊이 새겨진 고통스러운 표정뿐｡"
  },
  {
   "id": 35032,
   "key": "D1311al.txt:149",
   "file": "D1311al.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "終わる事のない呪いに囚われ、 永劫の断末魔を上げ続ける。",
   "ko_candidate": "끝나지 않는 저주에 사로잡혀 영겁의 단말마를 계속 지른다｡"
  },
  {
   "id": 35033,
   "key": "D1311al.txt:152",
   "file": "D1311al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨霊呪弾。",
   "ko_candidate": "원령주탄｡"
  },
  {
   "id": 35034,
   "key": "D1311al.txt:153",
   "file": "D1311al.txt",
   "line": 153,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ベルゼビュート』の最強兵器。",
   "ko_candidate": "『벨제뷰트』의 최강 병기｡"
  },
  {
   "id": 35035,
   "key": "D1311al.txt:154",
   "file": "D1311al.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭の中で、またあの声が木霊する。",
   "ko_candidate": "머릿속에서 또 그 목소리가 메아리친다｡"
  },
  {
   "id": 35036,
   "key": "D1311al.txt:159",
   "file": "D1311al.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……ママぁ。",
   "ko_candidate": "……엄마｡"
  },
  {
   "id": 35037,
   "key": "D1311al.txt:162",
   "file": "D1311al.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳の奥で、何かが灼き切れた。",
   "ko_candidate": "뇌의 깊은 곳에서 무언가가 타들어갔다｡"
  },
  {
   "id": 35038,
   "key": "D1311al.txt:166",
   "file": "D1311al.txt",
   "line": 166,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アンタらも、この呪弾の糧にしてあげるわッ！　さあ、汚らしい怨霊に成り果てちゃいなさい！　腐殺ァァァァァァァ――――！」",
   "ko_candidate": "「너희들도 이 주탄의 양식으로 만들어주지! 자､ 더러운 원령이 되어버려라! 부살아아아아아아아――――!」"
  },
  {
   "id": 35039,
   "key": "D1311al.txt:172",
   "file": "D1311al.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蝿の群雲を割いて、怨霊呪弾が放たれた。",
   "ko_candidate": "파리 떼의 구름을 가르며 원령주탄이 발사되었다｡"
  },
  {
   "id": 35040,
   "key": "D1311al.txt:173",
   "file": "D1311al.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを襲う怨念の重撃。",
   "ko_candidate": "데몬베인을 덮치는 원념의 강타｡"
  },
  {
   "id": 35041,
   "key": "D1311al.txt:174",
   "file": "D1311al.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 35042,
   "key": "D1311al.txt:183",
   "file": "D1311al.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの拳を重ねる。",
   "ko_candidate": "데몬베인의 주먹을 겹친다｡"
  },
  {
   "id": 35043,
   "key": "D1311al.txt:184",
   "file": "D1311al.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今にも押し寄せる威力を持った怨嗟。",
   "ko_candidate": "지금이라도 밀려올 것 같은 위력을 지닌 원한｡"
  },
  {
   "id": 35044,
   "key": "D1311al.txt:185",
   "file": "D1311al.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが俺は怖れない。怖れる理由が無い。",
   "ko_candidate": "하지만 나는 두렵지 않다｡ 두려워할 이유가 없다｡"
  },
  {
   "id": 35045,
   "key": "D1311al.txt:192",
   "file": "D1311al.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳から魔力の光が溢れ出す。",
   "ko_candidate": "주먹에서 마력의 빛이 넘쳐흐른다｡"
  },
  {
   "id": 35046,
   "key": "D1311al.txt:193",
   "file": "D1311al.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両の拳で五芒星形を描く。",
   "ko_candidate": "양 주먹으로 오망성 형태를 그린다｡"
  },
  {
   "id": 35047,
   "key": "D1311al.txt:194",
   "file": "D1311al.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拳に纏った光が、吹き荒む闇の中に、軌跡を描いた。",
   "ko_candidate": "주먹에 감긴 빛이 휘몰아치는 어둠 속에 궤적을 그렸다｡"
  },
  {
   "id": 35048,
   "key": "D1311al.txt:197",
   "file": "D1311al.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――『旧き印』。 敵意と脅威を払う結印。",
   "ko_candidate": "――『<RUBY text=\"The Elder Sign\">엘더 사인</RUBY>』｡"
  },
  {
   "id": 35049,
   "key": "D1311al.txt:209",
   "file": "D1311al.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "五芒星形は、デモンベインの前面に展開。",
   "ko_candidate": "적의와 위협을 물리치는 결인｡ 오망성 형태가 데몬베인의 전면에 전개된다｡"
  },
  {
   "id": 35050,
   "key": "D1311al.txt:210",
   "file": "D1311al.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺たちを護る強固な楯となる！",
   "ko_candidate": "우리를 지키는 강고한 방패가 된다!"
  },
  {
   "id": 35051,
   "key": "D1311al.txt:213",
   "file": "D1311al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "断末魔の絶叫が、爆音となって轟く。",
   "ko_candidate": "단말마의 절규가 폭음이 되어 울려 퍼진다｡"
  },
  {
   "id": 35052,
   "key": "D1311al.txt:214",
   "file": "D1311al.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "衝撃を叩きつけてくる。",
   "ko_candidate": "충격이 밀려온다｡"
  },
  {
   "id": 35053,
   "key": "D1311al.txt:216",
   "file": "D1311al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、防禦陣は揺らがない。",
   "ko_candidate": "하지만 방어진은 흔들리지 않는다｡"
  },
  {
   "id": 35054,
   "key": "D1311al.txt:217",
   "file": "D1311al.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "微塵たりとも揺らがない。",
   "ko_candidate": "미진도 흔들리지 않는다｡"
  },
  {
   "id": 35055,
   "key": "D1311al.txt:219",
   "file": "D1311al.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "押し寄せる死。死。死。死。死。死。死。死。死。死。",
   "ko_candidate": "밀려오는 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡ 죽음｡"
  },
  {
   "id": 35056,
   "key": "D1311al.txt:220",
   "file": "D1311al.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾風怒濤の凌辱の只中、だがデモンベインだけが熾烈なまでに清浄だ。",
   "ko_candidate": "질풍노도의 능욕 한가운데､ 하지만 데몬베인만이 치열할 정도로 청정하다｡"
  },
  {
   "id": 35057,
   "key": "D1311al.txt:224",
   "file": "D1311al.txt",
   "line": 224,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「グッ……あ、アアああアアアア悪あああアア！」",
   "ko_candidate": "「크윽……아､ 아아아아아아악!」"
  },
  {
   "id": 35058,
   "key": "D1311al.txt:227",
   "file": "D1311al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの、焦りを窺わせる咆吼が、何処からともなく、この怨霊と蝿に満たされた空間に響き渡った。",
   "ko_candidate": "티베리우스의 초조함이 엿보이는 포효가 어디선가 이 원령과 파리로 가득 찬 공간에 울려 퍼졌다｡"
  },
  {
   "id": 35059,
   "key": "D1311al.txt:230",
   "file": "D1311al.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念が威力を増す。",
   "ko_candidate": "원념이 위력을 더한다｡"
  },
  {
   "id": 35060,
   "key": "D1311al.txt:231",
   "file": "D1311al.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瘴気の黒と防禦陣の白が、せめぎ合い、凌ぎ合う。",
   "ko_candidate": "장기의 검은색과 방어진의 흰색이 맞부딪치고 겨룬다｡"
  },
  {
   "id": 35061,
   "key": "D1311al.txt:232",
   "file": "D1311al.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紫電が迸って空間を灼き、霊気が飛沫を散らして空間を濡らす。",
   "ko_candidate": "자줏빛 번개가 튀어 공간을 태우고､ 영기가 물보라를 일으켜 공간을 적신다｡"
  },
  {
   "id": 35062,
   "key": "D1311al.txt:237",
   "file": "D1311al.txt",
   "line": 237,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「滅びろ……滅びロ…… ホロビロォォォォォォォォォォ！」",
   "ko_candidate": "「멸망해라……멸망하라…… 멸망하라아아아아아아아아아아아!」"
  },
  {
   "id": 35063,
   "key": "D1311al.txt:242",
   "file": "D1311al.txt",
   "line": 242,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 35064,
   "key": "D1311al.txt:245",
   "file": "D1311al.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念が圧縮される。",
   "ko_candidate": "원념이 압축된다｡"
  },
  {
   "id": 35065,
   "key": "D1311al.txt:246",
   "file": "D1311al.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "防御陣の前で、小さな球体となったソレは、臨界を超えて、内側に向いていたエネルギーを掌を返すように外に向けた。",
   "ko_candidate": "방어진 앞에서 작은 구체가 된 그것은 임계를 넘어 안쪽으로 향했던 에너지를 손바닥을 뒤집듯이 밖으로 향했다｡"
  }
 ]
}