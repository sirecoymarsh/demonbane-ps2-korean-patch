   "key": "D1004le.txt:103",
   "file": "D1004le.txt",
   "line": 103,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「至急、救助隊を手配しなさいっ！」",
   "ko_candidate": "「즉시 구조대를 수배하세요!」"
