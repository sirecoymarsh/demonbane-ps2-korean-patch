   "key": "D1515.txt:197",
   "file": "D1515.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はその女をよく知っていた――",
   "ko_candidate": "나는 그 여자를 잘 알고 있었다――"
  },
  {
   "id": 47419,
   "key": "D1515.txt:200",
