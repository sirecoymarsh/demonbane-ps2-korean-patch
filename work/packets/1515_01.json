  {
   "id": 47420,
   "key": "D1515.txt:204",
   "file": "D1515.txt",
   "line": 204,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「否！　此奴は……！」",
   "ko_candidate": "「아니! 이 녀석은……!」"
