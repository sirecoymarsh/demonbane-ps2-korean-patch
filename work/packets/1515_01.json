   "key": "D1515.txt:229",
   "file": "D1515.txt",
   "line": 229,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「宇宙よ、 今こそ……在るべき姿に！」",
   "ko_candidate": "「우주여､ 지금이야말로…… 있어야 할 모습으로!」"
  },
  {
