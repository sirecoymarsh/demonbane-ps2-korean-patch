  {
   "id": 47424,
   "key": "D1515.txt:222",
   "file": "D1515.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無貌の神。 這い寄る混沌。",
   "ko_candidate": "묘사할 수 없는 신｡"
  },
  {
   "id": 47425,
   "key": "D1515.txt:224",
   "file": "D1515.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "外なる神――ナイアルラトホテップ！",
   "ko_candidate": "기어다니는 혼돈｡"
