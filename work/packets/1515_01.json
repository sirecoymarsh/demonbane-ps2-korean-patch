   "key": "D1515.txt:258",
   "file": "D1515.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宇宙は、混沌に、沈んだ。",
   "ko_candidate": "우주는､ 혼돈 속으로､ 가라앉았다｡"
  },
  {
