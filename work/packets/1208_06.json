 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "瑠璃": "루리",
  "ウィンフィールド": "윈필드",
  "ティトゥス": "티투스"
 },
 "items": [
  {
   "id": 28559,
   "key": "D1208le.txt:104",
   "file": "D1208le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃が安堵の溜め息をこぼした。",
   "ko_candidate": "루리가 안도의 한숨을 내쉬었다｡"
  },
  {
   "id": 28560,
   "key": "D1208le.txt:105",
   "file": "D1208le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウィンフィールドは穏やかに微笑み、頷く。",
   "ko_candidate": "윈필드는 온화하게 미소 지으며 고개를 끄덕인다｡"
  },
  {
   "id": 28561,
   "key": "D1208le.txt:109",
   "file": "D1208le.txt",
   "line": 109,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ、呆けている時間はありません。敵はまだ少なくとも２つ。 すぐにでも警備部隊を再結成して――」",
   "ko_candidate": "「자､ 멍하니 있을 시간이 없습니다｡ 적은 아직 적어도 둘｡ 곧바로 경비대를 재결성해서――」"
  },
  {
   "id": 28562,
   "key": "D1208le.txt:112",
   "file": "D1208le.txt",
   "line": 112,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 28563,
   "key": "D1208le.txt:121",
   "file": "D1208le.txt",
   "line": 121,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まだやる気ですか」",
   "ko_candidate": "「아직 할 생각입니까」"
  },
  {
   "id": 28564,
   "key": "D1208le.txt:125",
   "file": "D1208le.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "返事はない。ただ構えた刀が、かちゃりと音を立てた。",
   "ko_candidate": "대답은 없다｡ 다만 들고있는 칼이 찰칵하고 소리를 냈다｡"
  },
  {
   "id": 28565,
   "key": "D1208le.txt:126",
   "file": "D1208le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィンフィールドの貌が引き締まる。",
   "ko_candidate": "윈필드의 얼굴이 긴장된다｡"
  },
  {
   "id": 28566,
   "key": "D1208le.txt:127",
   "file": "D1208le.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度こそ振り返って、ティトゥスと対峙する。",
   "ko_candidate": "이번에야말로 돌아서서 티투스와 대치한다｡"
  },
  {
   "id": 28567,
   "key": "D1208le.txt:129",
   "file": "D1208le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスは立っているのもやっと……と云った風情だった。",
   "ko_candidate": "티투스는 서 있는 것도 겨우……라고 할 정도였다｡"
  },
  {
   "id": 28568,
   "key": "D1208le.txt:130",
   "file": "D1208le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "未だ口端からは血が零れ続け、瞳は泳ぎ、膝は笑い、呼吸はこれ以上に無く乱れている。",
   "ko_candidate": "아직도 입가에서는 피가 흘러내리고､ 눈동자는 흔들리며､ 무릎은 떨리고､ 호흡은 이 이상 없이 어지럽다｡"
  },
  {
   "id": 28569,
   "key": "D1208le.txt:131",
   "file": "D1208le.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがその貌は――",
   "ko_candidate": "하지만 그 얼굴은――"
  },
  {
   "id": 28570,
   "key": "D1208le.txt:135",
   "file": "D1208le.txt",
   "line": 135,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふ……くふふふ……くふふふ……くふはははは」",
   "ko_candidate": "「후후……쿠후후후……쿠후후후……쿠하하하하」"
  },
  {
   "id": 28571,
   "key": "D1208le.txt:138",
   "file": "D1208le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "笑っていた。",
   "ko_candidate": "웃고 있었다｡"
  },
  {
   "id": 28572,
   "key": "D1208le.txt:139",
   "file": "D1208le.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闘いの歓喜に歪んでいた。",
   "ko_candidate": "싸움의 환희에 일그러져 있었다｡"
  },
  {
   "id": 28573,
   "key": "D1208le.txt:140",
   "file": "D1208le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死合いの愉悦に溺れていた。",
   "ko_candidate": "사생결단의 쾌락에 빠져 있었다｡"
  },
  {
   "id": 28574,
   "key": "D1208le.txt:141",
   "file": "D1208le.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飢えた修羅が、此処に居る。",
   "ko_candidate": "굶주린 수라가 여기에 있다｡"
  },
  {
   "id": 28575,
   "key": "D1208le.txt:147",
   "file": "D1208le.txt",
   "line": 147,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……申し訳ございません。もう少しだけ掛かりそうです」",
   "ko_candidate": "「……죄송합니다｡ 조금 더 시간이 걸릴 것 같습니다」"
  },
  {
   "id": 28576,
   "key": "D1208le.txt:150",
   "file": "D1208le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "再び、ウィンフィールドはファイティングポーズを取った。",
   "ko_candidate": "다시､ 윈필드는 파이팅 포즈를 취했다｡ 티투스도 두 자루의 칼을 십자로 교차시킨다｡"
  },
  {
   "id": 28577,
   "key": "D1208le.txt:156",
   "file": "D1208le.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティトゥスも、二刀を十字に重ねて、構える。 ぶつかり合い、弾け合い、混ざり合う２つの闘気が、司令室を震わせた。",
   "ko_candidate": "부딪치고､ 튕겨나고､ 뒤섞이는 두 개의 투기가 사령실을 흔들었다｡{SE_VOL(1,1000,0);}{SE_PLAY(2,\"魔륨짐껏\",0,70,false);}<br>"
  },
  {
   "id": 28578,
   "key": "D1208le.txt:168",
   "file": "D1208le.txt",
   "line": 168,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  },
  {
   "id": 28579,
   "key": "D1208le.txt:172",
   "file": "D1208le.txt",
   "line": 172,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  },
  {
   "id": 28580,
   "key": "D1208le.txt:175",
   "file": "D1208le.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "互いに動かない。",
   "ko_candidate": "서로 움직이지 않는다｡"
  },
  {
   "id": 28581,
   "key": "D1208le.txt:177",
   "file": "D1208le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重く静止した時間の中、闘争を決する総ての要因に神経を巡らせる。",
   "ko_candidate": "무겁게 정지한 시간 속에서 투쟁을 결정짓는 모든 요인에 신경을 곤두세운다｡"
  },
  {
   "id": 28582,
   "key": "D1208le.txt:179",
   "file": "D1208le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "筋肉の動き、",
   "ko_candidate": "근육의 움직임､"
  },
  {
   "id": 28583,
   "key": "D1208le.txt:179",
   "file": "D1208le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心臓の鼓動、",
   "ko_candidate": "심장의 고동､"
  },
  {
   "id": 28584,
   "key": "D1208le.txt:179",
   "file": "D1208le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の流れ、",
   "ko_candidate": "피의 흐름､"
  },
  {
   "id": 28585,
   "key": "D1208le.txt:179",
   "file": "D1208le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呼吸、",
   "ko_candidate": "호흡､"
  },
  {
   "id": 28586,
   "key": "D1208le.txt:179",
   "file": "D1208le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気の流れ、",
   "ko_candidate": "대기의 흐름､"
  },
  {
   "id": 28587,
   "key": "D1208le.txt:179",
   "file": "D1208le.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力の流れ――",
   "ko_candidate": "힘의 흐름――"
  },
  {
   "id": 28588,
   "key": "D1208le.txt:181",
   "file": "D1208le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ティトゥスが、笑った。",
   "ko_candidate": "티투스가 웃었다｡"
  },
  {
   "id": 28589,
   "key": "D1208le.txt:184",
   "file": "D1208le.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の雫を撒き散らしながら、疾走る。",
   "ko_candidate": "피의 방울을 흩뿌리며 질주한다｡"
  },
  {
   "id": 28590,
   "key": "D1208le.txt:188",
   "file": "D1208le.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "走るどころか、まともに動く事すらも怪しい躰が、疾風の如く。",
   "ko_candidate": "달리는 것은커녕 제대로 움직이는 것조차 의심스러운 몸이 질풍과 같이｡"
  },
  {
   "id": 28591,
   "key": "D1208le.txt:189",
   "file": "D1208le.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一気に間合いを詰める。",
   "ko_candidate": "단숨에 간격을 좁힌다｡"
  },
  {
   "id": 28592,
   "key": "D1208le.txt:193",
   "file": "D1208le.txt",
   "line": 193,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（先程よりも速い！）",
   "ko_candidate": "（아까보다 더 빠르다!）"
  },
  {
   "id": 28593,
   "key": "D1208le.txt:206",
   "file": "D1208le.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人だけの時間が始まった。",
   "ko_candidate": "두 사람만의 시간이 시작되었다｡"
  },
  {
   "id": 28594,
   "key": "D1208le.txt:207",
   "file": "D1208le.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは刹那、人の目に留まらぬ刹那に閉ざされた世界。",
   "ko_candidate": "그것은 찰나､ 사람의 눈에 머물지 않는 찰나에 닫힌 세계｡"
  },
  {
   "id": 28595,
   "key": "D1208le.txt:209",
   "file": "D1208le.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那の中、２人の思考もまた同じ速度で疾走する。",
   "ko_candidate": "찰나 속에서 두 사람의 사고 또한 같은 속도로 질주한다｡"
  },
  {
   "id": 28596,
   "key": "D1208le.txt:213",
   "file": "D1208le.txt",
   "line": 213,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（２撃かわせば私の勝ちです！）",
   "ko_candidate": "（2격 피하면 제가 이깁니다!）"
  },
  {
   "id": 28597,
   "key": "D1208le.txt:217",
   "file": "D1208le.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超神速で迫る右の刀。袈裟斬り。",
   "ko_candidate": "초신속으로 다가오는 오른쪽 칼｡ 게사베기｡"
  },
  {
   "id": 28598,
   "key": "D1208le.txt:219",
   "file": "D1208le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "速い。",
   "ko_candidate": "빠르다｡"
  }
 ]
}