 },
 "items": [
  {
   "id": 32726,
   "key": "D1305ru.txt:530",
   "file": "D1305ru.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞳が笑っている様なのは……俺の気のせいか。",
   "ko_candidate": "그 눈동자가 웃고 있는 것 같은 건… 내 착각일까｡"
  },
  {
   "id": 32727,
   "key": "D1305ru.txt:532",
   "file": "D1305ru.txt",
   "line": 532,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狗は一度、吼えた。",
   "ko_candidate": "개는 한 번 짖었다｡"
  },
  {
   "id": 32728,
   "key": "D1305ru.txt:533",
   "file": "D1305ru.txt",
   "line": 533,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そのまま、図書館の外へと飛び出してしまった。",
   "ko_candidate": "그대로 도서관 밖으로 뛰쳐나가 버렸다｡"
  },
  {
   "id": 32729,
   "key": "D1305ru.txt:534",
   "file": "D1305ru.txt",
   "line": 534,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――変化が起こった。",
   "ko_candidate": "그리고――변화가 일어났다｡"
  },
  {
   "id": 32730,
   "key": "D1305ru.txt:536",
   "file": "D1305ru.txt",
   "line": 536,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "化け物の躰が、ウィルバー・ウェイトリイの躰が、縮んでゆく。",
   "ko_candidate": "괴물의 몸이､ 윌버 웨이틀리의 몸이､ 줄어들어 간다｡"
  },
  {
   "id": 32731,
   "key": "D1305ru.txt:538",
   "file": "D1305ru.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩壊してゆく。",
   "ko_candidate": "붕괴되어 간다｡"
  },
  {
   "id": 32732,
   "key": "D1305ru.txt:540",
   "file": "D1305ru.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はその一部始終を、屍体が、単なる白っぽい粘つく塊になるまで、ずっと見守り続けていた。",
   "ko_candidate": "나는 그 모든 과정을､ 시체가 단순한 하얀 끈적이는 덩어리가 될 때까지､ 계속 지켜보고 있었다｡"
  },
  {
   "id": 32733,
   "key": "D1305ru.txt:542",
   "file": "D1305ru.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全部、全部、見てしまった。",
   "ko_candidate": "전부､ 전부､ 보고 말았다｡"
  },
  {
   "id": 32734,
   "key": "D1305ru.txt:544",
   "file": "D1305ru.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は……滅び逝く怪異を目の前に俺は――",
   "ko_candidate": "나는… 멸망해가는 괴이를 눈앞에 두고 나는――"
  },
  {
   "id": 32735,
   "key": "D1305ru.txt:548",
   "file": "D1305ru.txt",
   "line": 548,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわああああああああ!?　ああああああああああああっ!? あがああああああああああああああああああああああああ！」",
   "ko_candidate": "「우와아아아아아아아!? 아아아아아아아아아아앗!? 아가아아아아아아아아아아아아아아아아아아아아아!」 「다이쥬지!? 다이쥬지! 정신 차려､ 다이쥬지――!」"
  },
  {
   "id": 32736,
   "key": "D1305ru.txt:553",
   "file": "D1305ru.txt",
   "line": 553,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大十字!?　大十字！ しっかりしろ、大十字――！」",
   "ko_candidate": "――쓰러진 하도 루리에게 천천히 다가간다｡ 나는… 뭘､ 하고 있는 거지?"
  },
  {
   "id": 32737,
   "key": "D1305ru.txt:565",
   "file": "D1305ru.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――倒れた、覇道瑠璃に、ゆっくりと近づく。",
   "ko_candidate": "――녹아내리는 몸을 끌면서｡ 뭘､ 하려고 하는 거지?"
  },
  {
   "id": 32738,
   "key": "D1305ru.txt:568",
   "file": "D1305ru.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は……何を、やっているんだ？",
   "ko_candidate": "――녹아 형태를 바꾸는 몸을､ 뒤틀면서｡"
  },
  {
   "id": 32739,
   "key": "D1305ru.txt:571",
   "file": "D1305ru.txt",
   "line": 571,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――溶ける躰を引きずって。",
   "ko_candidate": "두 가지 모습을 오가면서｡ 나는､ 뭐지?"
  },
  {
   "id": 32740,
   "key": "D1305ru.txt:574",
   "file": "D1305ru.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何を、しようとしているんだ？",
   "ko_candidate": "――다이쥬지 쿠로의 몸과､ 너는､ 뭐지?"
  },
  {
   "id": 32741,
   "key": "D1305ru.txt:577",
   "file": "D1305ru.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――溶けては容を変える躰を、のたうたせて。",
   "ko_candidate": "――윌버 웨이틀리와､ 왜 이렇게 된 거지｡"
  },
  {
   "id": 32742,
   "key": "D1305ru.txt:578",
   "file": "D1305ru.txt",
   "line": 578,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "２つの姿を行き来して。 俺は、何なんだ？",
   "ko_candidate": "――뒤섞인 두 가지 모습을､ 끊임없이 변화시키면서｡"
  },
  {
   "id": 32743,
   "key": "D1305ru.txt:584",
   "file": "D1305ru.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――大十字九郎の躰と、",
   "ko_candidate": "왜 이런 일을 당해야 하는 거지｡"
  },
  {
   "id": 32744,
   "key": "D1305ru.txt:587",
   "file": "D1305ru.txt",
   "line": 587,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お前は、何なんだ？",
   "ko_candidate": "――손을 뻗는다｡"
  },
  {
   "id": 32745,
   "key": "D1305ru.txt:590",
   "file": "D1305ru.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――ウィルバー・ウェイトリイと、",
   "ko_candidate": "이 악몽에서… 나를 구해줘｡"
  },
  {
   "id": 32746,
   "key": "D1305ru.txt:593",
   "file": "D1305ru.txt",
   "line": 593,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何でこんなことに、なったんだ。",
   "ko_candidate": "――하도 루리의 몸에 닿는다｡ 누군가､"
  },
  {
   "id": 32747,
   "key": "D1305ru.txt:596",
   "file": "D1305ru.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――混ざり合った２つの姿を、絶え間なく変化させる。",
   "ko_candidate": "――부드러운 가슴을 주무른다｡ 누군가…"
  },
  {
   "id": 32748,
   "key": "D1305ru.txt:599",
   "file": "D1305ru.txt",
   "line": 599,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何でこんな目に遭わなきゃ、いけないんだ。",
   "ko_candidate": "――더러운 꼬리를､ 하도 루리의 비부에 기어가게 하면서…"
  },
  {
   "id": 32749,
   "key": "D1305ru.txt:602",
   "file": "D1305ru.txt",
   "line": 602,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――手を伸ばす。",
   "ko_candidate": "공주님이 눈을 떴다｡"
  },
  {
   "id": 32750,
   "key": "D1305ru.txt:605",
   "file": "D1305ru.txt",
   "line": 605,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この悪夢から……俺を助けてくれ。 ――覇道瑠璃の躰に触れる。",
   "ko_candidate": "자신을 유린하려는 괴물을 겁에 질린 눈으로 바라보면서､"
  },
  {
   "id": 32751,
   "key": "D1305ru.txt:614",
   "file": "D1305ru.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "姫さんが、目を覚ました。 自分を蹂躙しようとする化け物を",
   "ko_candidate": "「크으… 아아…읏!」"
  },
  {
   "id": 32752,
   "key": "D1305ru.txt:616",
   "file": "D1305ru.txt",
   "line": 616,
   "speaker": "瑠璃",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怯えた瞳で見つめながら、 「くぅぅ……あぁぁ……っ！」",
   "ko_candidate": "짓눌리는 가슴의 고통에 눈물 흘리며､ 비부를 기어가는 꼬리의 불길한 감촉에 떨면서､ 몸에 쏟아지는 고름과 점액의 악취에､ 구토를 참으면서"
  },
  {
   "id": 32753,
   "key": "D1305ru.txt:624",
   "file": "D1305ru.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――それでも、この汚怪な化け物から目を逸らさず、彼女は言った。",
   "ko_candidate": "――그래도､ 이 더러운 괴물에게서 눈을 돌리지 않고､ 그녀는 말했다｡"
  },
  {
   "id": 32754,
   "key": "D1305ru.txt:626",
   "file": "D1305ru.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "震える声で、だけどはっきりと、強靭な意志を込めて。",
   "ko_candidate": "떨리는 목소리로､ 하지만 분명하게､ 강인한 의지를 담아｡"
  },
  {
   "id": 32755,
   "key": "D1305ru.txt:630",
   "file": "D1305ru.txt",
   "line": 630,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さんの……中から…… 出てゆけ……ぇ！」",
   "ko_candidate": "「다이쥬지 씨의… 안에서… 나가… 줘!」"
  },
  {
   "id": 32756,
   "key": "D1305ru.txt:636",
   "file": "D1305ru.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――俺は、何をやってるんだ？",
   "ko_candidate": "――나는､ 뭘 하고 있는 거지?"
  }
 ]
}