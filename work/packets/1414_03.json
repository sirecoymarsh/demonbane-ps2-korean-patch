  {
   "id": 40375,
   "key": "D1414al.txt:667",
   "file": "D1414al.txt",
   "line": 667,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そう。九郎はもう分かっているはずだよ」",
   "ko_candidate": "「그래｡ 쿠로는 이미 알고 있을 거야」 그것은…"
  },
  {
   "id": 40376,
   "key": "D1414al.txt:672",
   "file": "D1414al.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは――",
   "ko_candidate": "이형의 함…"
  },
  {
   "id": 40377,
   "key": "D1414al.txt:676",
   "file": "D1414al.txt",
   "line": 676,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "異形の匣――",
   "ko_candidate": "7개의 지주…"
  },
  {
   "id": 40378,
   "key": "D1414al.txt:677",
   "file": "D1414al.txt",
   "line": 677,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "７本の支柱――",
   "ko_candidate": "검은 결정체…"
  },
  {
   "id": 40379,
   "key": "D1414al.txt:678",
   "file": "D1414al.txt",
   "line": 678,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "黒い結晶体―― 【Shining　Trapezohedron】",
   "ko_candidate": "【Shining Trapezohedron】"
  },
  {
   "id": 40380,
   "key": "D1414al.txt:698",
   "file": "D1414al.txt",
   "line": 698,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――そして、戦場は異界と化した。",
   "ko_candidate": "…그리고 전장은 이계로 변했다｡"
  },
  {
   "id": 40381,
   "key": "D1414le.txt:12",
   "file": "D1414le.txt",
   "line": 12,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……獲ったか？」",
   "ko_candidate": "「……잡았나?」"
  },
  {
   "id": 40382,
   "key": "D1414le.txt:16",
   "file": "D1414le.txt",
   "line": 16,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 40383,
   "key": "D1414le.txt:22",
   "file": "D1414le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発に吹き飛ばされた血がつくる紅の濃霧の、その向こうを見定めようと目を凝らす。",
   "ko_candidate": "폭발로 날아간 피가 만든 붉은 안개 너머를 가늠하려 눈을 부릅뜬다｡"
  },
  {
   "id": 40384,
   "key": "D1414le.txt:23",
   "file": "D1414le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "直撃のはずだ。それでも仕留め切れないというのなら……。",
   "ko_candidate": "직격이었을 텐데｡ 그래도 완전히 잡지 못했다면……"
  },
  {
   "id": 40385,
   "key": "D1414le.txt:27",
   "file": "D1414le.txt",
   "line": 27,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………！　まだだ！　まだ、生きている！」",
   "ko_candidate": "「…………! 아직이다! 아직 살아있어!」"
  },
  {
   "id": 40386,
   "key": "D1414le.txt:34",
   "file": "D1414le.txt",
   "line": 34,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ――!?」",
   "ko_candidate": "「뭐――!?」 「큿!」"
  },
  {
   "id": 40387,
   "key": "D1414le.txt:38",
   "file": "D1414le.txt",
   "line": 38,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ！」 サンダルフォンの叫びが聴こえると同時、濃霧を割いてビームが飛来する。",
   "ko_candidate": "산달폰의 외침이 들리는 동시에 짙은 안개를 가르며 빔이 날아온다｡"
  },
  {
   "id": 40388,
   "key": "D1414le.txt:49",
   "file": "D1414le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの足元が脚部シールドの開放により、爆裂した。",
   "ko_candidate": "데몬베인의 발밑이 다리 부분 실드 개방으로 폭발했다｡"
  },
  {
   "id": 40389,
   "key": "D1414le.txt:50",
   "file": "D1414le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間反転の反作用エネルギーによる、驚異的な機動力に助けられ、何とかその一撃をかわした。",
   "ko_candidate": "공간 반전의 반작용 에너지에 의한 놀라운 기동력 덕분에 어떻게든 그 일격을 피했다｡"
  },
  {
   "id": 40390,
   "key": "D1414le.txt:52",
   "file": "D1414le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……",
   "ko_candidate": "하지만……"
  },
  {
   "id": 40391,
   "key": "D1414le.txt:63",
   "file": "D1414le.txt",
   "line": 63,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今ので、斃し切れないなんて！」",
   "ko_candidate": "「저걸 맞고도 쓰러뜨리지 못하다니!」"
  },
  {
   "id": 40392,
   "key": "D1414le.txt:68",
   "file": "D1414le.txt",
   "line": 68,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「は……は……ははは……ハッハッ……！ 今のは……今のは危なかったぞ……糞虫どもがぁぁぁぁ！」",
   "ko_candidate": "「하……하……하하하……핫핫……! 방금은…… 방금은 위험했어…… 똥벌레 놈들아아아아!」"
  },
  {
   "id": 40393,
   "key": "D1414le.txt:72",
   "file": "D1414le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発に吹き飛ばされ、霧が晴れた。",
   "ko_candidate": "폭발로 날아가 안개가 걷혔다｡"
  },
  {
   "id": 40394,
   "key": "D1414le.txt:73",
   "file": "D1414le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "レガシー・オブ・ゴールドの姿が、幽玄と紅の視界に浮かび上がる。",
   "ko_candidate": "레거시 오브 골드의 모습이 유현과 붉은 시야에 떠오른다｡"
  },
  {
   "id": 40395,
   "key": "D1414le.txt:75",
   "file": "D1414le.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無傷というワケではなかった。",
   "ko_candidate": "무사하다고는 할 수 없었다｡"
  },
  {
   "id": 40396,
   "key": "D1414le.txt:76",
   "file": "D1414le.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、むしろまだ稼動しているのが不思議でならないほど、徹底的に破壊されていた。",
   "ko_candidate": "아니､ 오히려 아직도 작동하고 있다는 게 이상할 정도로 철저히 파괴되어 있었다｡"
  },
  {
   "id": 40397,
   "key": "D1414le.txt:78",
   "file": "D1414le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体は穿たれ、穴だらけ、あちこちから立ち昇る炎は未だ消えることはない。",
   "ko_candidate": "기체는 뚫리고 구멍투성이에 여기저기서 솟아오르는 불길은 아직도 꺼지지 않는다｡"
  },
  {
   "id": 40398,
   "key": "D1414le.txt:80",
   "file": "D1414le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の煌びやかな装甲は、ある部分は砕け、ある部分は融解している。",
   "ko_candidate": "황금빛 화려한 장갑은 어떤 부분은 부서지고 어떤 부분은 녹아내리고 있다｡"
  },
  {
   "id": 40399,
   "key": "D1414le.txt:82",
   "file": "D1414le.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体の半分以上が原形を留めていない有様だ。",
   "ko_candidate": "기체의 절반 이상이 원형을 알아볼 수 없는 모습이다｡"
  },
  {
   "id": 40400,
   "key": "D1414le.txt:83",
   "file": "D1414le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでもレガシー・オブ・ゴールドは動いている……！",
   "ko_candidate": "그래도 레거시 오브 골드는 움직이고 있다……!"
  },
  {
   "id": 40401,
   "key": "D1414le.txt:87",
   "file": "D1414le.txt",
   "line": 87,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なんて、しぶとい……！」",
   "ko_candidate": "「정말､ 질긴 놈……!」"
  },
  {
   "id": 40402,
   "key": "D1414le.txt:92",
   "file": "D1414le.txt",
   "line": 92,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうだな……このレガシー・オブ・ゴールドが、単なる鬼械神であったなら、跡形も無かったろう。だがしかぁぁぁしっっっ！」",
   "ko_candidate": "「그렇지…… 이 레거시 오브 골드가 단순한 귀계신이었다면 흔적도 없었겠지｡ 하지마아아안!」"
  },
  {
   "id": 40403,
   "key": "D1414le.txt:99",
   "file": "D1414le.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "レガシー・オブ・ゴールドの破損箇所から、水銀の血に塗れた金属的な触手が大量に溢れ出した。",
   "ko_candidate": "레거시 오브 골드의 파손 부위에서 수은 피로 뒤덮인 금속성 촉수가 대량으로 쏟아져 나왔다｡"
  },
  {
   "id": 40404,
   "key": "D1414le.txt:101",
   "file": "D1414le.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不気味に蠢き、破損箇所を埋め尽くしていく。",
   "ko_candidate": "섬뜩하게 꿈틀거리며 파손 부위를 메워간다｡"
  },
  {
   "id": 40405,
   "key": "D1414le.txt:102",
   "file": "D1414le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "みるみると、時間を巻き戻したかのように、レガシー・オブ・ゴールドは再生していた。",
   "ko_candidate": "눈 깜짝할 사이에 시간을 되돌린 듯 레거시 오브 골드는 재생되고 있었다｡"
  },
  {
   "id": 40406,
   "key": "D1414le.txt:112",
   "file": "D1414le.txt",
   "line": 112,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「自己修復機能！　これもクトゥルーの魔力か！」",
   "ko_candidate": "「자기 복구 기능! 이것도 크툴루의 마력인가!」"
  },
  {
   "id": 40407,
   "key": "D1414le.txt:116",
   "file": "D1414le.txt",
   "line": 116,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「糞ッ！　ここまで来て……！」",
   "ko_candidate": "「젠장! 여기까지 와서……!」"
  }
 ]
