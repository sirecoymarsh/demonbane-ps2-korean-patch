   "line": 652,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ただ１つを、除いては」",
   "ko_candidate": "「…단 하나를 제외하고는」"
  },
  {
   "id": 40373,
   "key": "D1414al.txt:657",
   "file": "D1414al.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ、１つを除いては。",
   "ko_candidate": "단､ 하나를 제외하고는｡"
  },
  {
   "id": 40374,
   "key": "D1414al.txt:662",
   "file": "D1414al.txt",
   "line": 662,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……ただ、１つ？",
   "ko_candidate": "…단､ 하나?"
