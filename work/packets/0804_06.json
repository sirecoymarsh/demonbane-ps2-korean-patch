 "items": [
  {
   "id": 12997,
   "key": "D0804ru.txt:386",
   "file": "D0804ru.txt",
   "line": 386,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あの時、大十字様と瑠璃お嬢様の間に何があったのか――それは使用人如きが追求出来るものでは有りませんし、するつもりも御座いません」 「私はただ、主に仕えるのみ。お嬢様のお選びになった道が、私の総てで御座います」",
   "ko_candidate": "심장이 순간 경직되었다｡"
  },
  {
   "id": 12998,
   "key": "D0804ru.txt:392",
   "file": "D0804ru.txt",
   "line": 392,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ですが……もしもお嬢様の心を土足で踏み躙り、あの方の清らかな心に傷を負わせる輩が居るとしたら――」 「不肖、このウィンフィールド、修羅にでも悪鬼にでも堕ちる覚悟で御座います故」",
   "ko_candidate": "「그때､ 다이쥬지 님과 루리 아가씨 사이에 무슨 일이 있었는지――그것은 하인 따위가 추궁할 수 있는 것이 아니며､ 할 생각도 없습니다｡ 저는 단지 주인을 섬길 뿐입니다｡ 아가씨께서 선택하신 길이 저의 전부입니다｡ 하지만…… 만약 아가씨의 마음을 짓밟고､ 그분의 깨끗한 마음에 상처를 입히는 자가 있다면―― 이 윈필드､ 수라도 악귀도 되겠다는 각오로 있사오니」"
  },
  {
   "id": 12999,
   "key": "D0804ru.txt:398",
   "file": "D0804ru.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――この人は、間違いなく本気だ。",
   "ko_candidate": "――이 사람은 틀림없이 진심이다｡"
  },
  {
   "id": 13000,
   "key": "D0804ru.txt:399",
   "file": "D0804ru.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣きそう。",
   "ko_candidate": "울고 싶다｡"
  },
  {
   "id": 13001,
   "key": "D0804ru.txt:400",
   "file": "D0804ru.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "つーかチビりそう。",
   "ko_candidate": "아니 똥 싸고 싶다｡"
  },
  {
   "id": 13002,
   "key": "D0804ru.txt:406",
   "file": "D0804ru.txt",
   "line": 406,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ、それはともかく、最近のお嬢様はお悩みの様子。 大十字様。どうかお嬢様を慰めてあげて下さいませ」",
   "ko_candidate": "「뭐､ 그건 그렇고､ 최근 아가씨께서는 고민하시는 것 같습니다｡ 다이쥬지 님｡ 부디 아가씨를 위로해 주세요」"
  },
  {
   "id": 13003,
   "key": "D0804ru.txt:410",
   "file": "D0804ru.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、執事さんは穏やかに微笑んだ。",
   "ko_candidate": "말하고 집사님은 온화하게 미소 지었다｡"
  },
  {
   "id": 13004,
   "key": "D0804ru.txt:412",
   "file": "D0804ru.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "命の危険を感じさせる程の殺意は、嘘のように一瞬で、霧散してしまった。",
   "ko_candidate": "목숨의 위험을 느낄 정도의 살의는 거짓말처럼 순식간에 사라져 버렸다｡"
  },
  {
   "id": 13005,
   "key": "D0804ru.txt:414",
   "file": "D0804ru.txt",
   "line": 414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……この人、メチャクチャ怖え。",
   "ko_candidate": "……이 사람､ 엄청 무서워｡"
  },
  {
   "id": 13006,
   "key": "D0804ru.txt:415",
   "file": "D0804ru.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はただ何度も頷くしかなかった。",
   "ko_candidate": "나는 그저 여러 번 고개를 끄덕일 수밖에 없었다｡"
  },
  {
   "id": 13007,
   "key": "D0804ru.txt:421",
   "file": "D0804ru.txt",
   "line": 421,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「瑠璃お嬢様」",
   "ko_candidate": "「루리 아가씨」"
  },
  {
   "id": 13008,
   "key": "D0804ru.txt:426",
   "file": "D0804ru.txt",
   "line": 426,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何です……っ？」",
   "ko_candidate": "「무､ 무슨 일이죠……?」"
  },
  {
   "id": 13009,
   "key": "D0804ru.txt:433",
   "file": "D0804ru.txt",
   "line": 433,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大十字様がお嬢様と、ゆっくりお話がしたいそうで」 「ちょうど良い。御二人で息抜きに行かれては如何でしょうか？」",
   "ko_candidate": "「다이쥬지님께서 아가씨와 천천히 이야기를 나누고 싶어 하시더군요｡ 마침 잘됐네요｡ 두 분이서 기분 전환 삼아 다녀오시는 게 어떨까요? 저희는 이만 물러가겠습니다」"
  },
  {
   "id": 13010,
   "key": "D0804ru.txt:439",
   "file": "D0804ru.txt",
   "line": 439,
   "speaker": "ウィンフィールド / 瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「私どもはこれで退散させてもらいます故」 「え？　えええ？　ちょ……ちょっとウィンフィールド！」",
   "ko_candidate": "「에? 에에에? 잠… 잠깐 윈필드!」"
  },
  {
   "id": 13011,
   "key": "D0804ru.txt:449",
   "file": "D0804ru.txt",
   "line": 449,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあさあ、貴女達。撤収しますよ」",
   "ko_candidate": "「자､ 자､ 여러분｡ 철수합시다」 「네!」"
  },
  {
   "id": 13012,
   "key": "D0804ru.txt:455",
   "file": "D0804ru.txt",
   "line": 455,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はいッ！」",
   "ko_candidate": "「――알겠습니다」"
  },
  {
   "id": 13013,
   "key": "D0804ru.txt:460",
   "file": "D0804ru.txt",
   "line": 460,
   "speaker": "マコト / チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――了解しました」 「はいはーい、 分っかりました。じゃ、 九郎ちゃん！　しっかりな！」",
   "ko_candidate": "「네네~ 알겠습니다｡ 그럼､ 쿠로 군! 힘내!」"
  },
  {
   "id": 13014,
   "key": "D0804ru.txt:472",
   "file": "D0804ru.txt",
   "line": 472,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ちょ……ちょっと、皆――」",
   "ko_candidate": "「잠… 잠깐､ 모두들――」"
  },
  {
   "id": 13015,
   "key": "D0804ru.txt:478",
   "file": "D0804ru.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、覇道の面々は、風の如き速やかさで、撤収していった。",
   "ko_candidate": "그리고 하도의 일행은 바람처럼 빠르게 철수해 갔다｡"
  },
  {
   "id": 13016,
   "key": "D0804ru.txt:482",
   "file": "D0804ru.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街の人間の注目を集めながら、ただ２人、俺と姫さんは残される。",
   "ko_candidate": "거리 사람들의 주목을 받으며 단 둘､ 나와 공주님만 남겨졌다｡"
  },
  {
   "id": 13017,
   "key": "D0804ru.txt:484",
   "file": "D0804ru.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お互い、どうしたら良いか分からず、しばらく呆然としていた。",
   "ko_candidate": "서로 어떻게 해야 할지 모르고 잠시 멍하니 있었다｡"
  },
  {
