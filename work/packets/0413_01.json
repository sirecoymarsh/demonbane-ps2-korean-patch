  {
   "id": 5687,
   "key": "D0413.txt:305",
   "file": "D0413.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "終わりは来なかった。",
   "ko_candidate": "조금은 따뜻한 듯한 목소리가､"
