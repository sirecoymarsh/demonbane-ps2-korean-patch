 },
 "items": [
  {
   "id": 23503,
   "key": "D1104ru.txt:75",
   "file": "D1104ru.txt",
   "line": 75,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まさか……九郎ちゃんは……」",
   "ko_candidate": "「설마… 쿠로 군은…」"
  },
  {
   "id": 23504,
   "key": "D1104ru.txt:80",
   "file": "D1104ru.txt",
   "line": 80,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「負傷した。今は覇道の医療施設に居る」",
   "ko_candidate": "「부상을 입었다｡ 지금은 하도의 의료 시설에 있어」"
  },
  {
   "id": 23505,
   "key": "D1104ru.txt:85",
   "file": "D1104ru.txt",
   "line": 85,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………！　そ、それで九郎ちゃんの容態はっ！」",
   "ko_candidate": "「…………! 그､ 그래서 쿠로 군의 상태는!」"
  },
  {
   "id": 23506,
   "key": "D1104ru.txt:90",
   "file": "D1104ru.txt",
   "line": 90,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………しばらく戦うのは無理だ」",
   "ko_candidate": "「………………잠시 동안 싸우는 건 무리다」"
  },
  {
   "id": 23507,
   "key": "D1104ru.txt:94",
   "file": "D1104ru.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しばらく回答を逡巡した後、結局は詳しい説明を避けた。",
   "ko_candidate": "잠시 대답을 망설인 후､ 결국 자세한 설명은 피했다｡"
  },
  {
   "id": 23508,
   "key": "D1104ru.txt:96",
   "file": "D1104ru.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再び重たい空気が、辺りに垂れ込めてくる。",
   "ko_candidate": "다시 무거운 공기가 주위에 감돈다｡"
  },
  {
   "id": 23509,
   "key": "D1104ru.txt:102",
   "file": "D1104ru.txt",
   "line": 102,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……本当に、あの子は」",
   "ko_candidate": "「…정말､ 그 아이는」"
  },
  {
   "id": 23510,
   "key": "D1104ru.txt:105",
   "file": "D1104ru.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "震える声……込み上げてくる衝動を無理矢理に堪えているかのような声で、誰にともなく、ライカは呟く。",
   "ko_candidate": "떨리는 목소리… 솟구치는 충동을 억지로 참고 있는 듯한 목소리로､ 누구에게랄 것도 없이 라이카가 중얼거린다｡"
  },
  {
   "id": 23511,
   "key": "D1104ru.txt:107",
   "file": "D1104ru.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無理矢理、閉じ込めた様々な感情。滲み出たのは僅かな苛立ちだった。",
   "ko_candidate": "억지로 가둔 여러 감정｡ 배어 나온 것은 약간의 짜증이었다｡"
  },
  {
   "id": 23512,
   "key": "D1104ru.txt:111",
   "file": "D1104ru.txt",
   "line": 111,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何でこう、無茶をしてまで戦うのかなぁ……！」",
   "ko_candidate": "「왜 이렇게 무리를 해가면서까지 싸우는 걸까…!」"
  },
  {
   "id": 23513,
   "key": "D1104ru.txt:116",
   "file": "D1104ru.txt",
   "line": 116,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 23514,
   "key": "D1104ru.txt:127",
   "file": "D1104ru.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――無茶をさせてまで戦わせているのは、いったい誰なのだろうか。",
   "ko_candidate": "――무리를 하면서까지 싸우게 하는 건､ 도대체 누구일까｡"
  },
  {
   "id": 23515,
   "key": "D1104ru.txt:131",
   "file": "D1104ru.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの胸がまた、じわり、と痛んだ。",
   "ko_candidate": "알의 가슴이 또 찌릿하고 아팠다｡"
  },
  {
   "id": 23516,
   "key": "D1104ru.txt:140",
   "file": "D1104ru.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アル達の様子を、遠くから見守る瑠璃の視線。",
   "ko_candidate": "알 일행의 모습을 멀리서 지켜보는 루리의 시선｡"
  },
  {
   "id": 23517,
   "key": "D1104ru.txt:141",
   "file": "D1104ru.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸が痛む。",
   "ko_candidate": "가슴이 아프다｡"
  },
  {
   "id": 23518,
   "key": "D1104ru.txt:149",
   "file": "D1104ru.txt",
   "line": 149,
   "speaker": "アル（回想）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝のせいだ、小娘」",
   "ko_candidate": "「네 탓이다､ 꼬마 아가씨」"
  },
  {
   "id": 23519,
   "key": "D1104ru.txt:153",
   "file": "D1104ru.txt",
   "line": 153,
   "speaker": "アル（回想）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝が足を引っ張ったからだ……汝さえ居なければ、九郎はあのような目に遭わずに済んだ……！」",
   "ko_candidate": "「네가 발목을 잡았기 때문이다… 네만 없었다면 쿠로는 그런 일을 당하지 않았을 텐데…!」"
  },
  {
   "id": 23520,
   "key": "D1104ru.txt:159",
   "file": "D1104ru.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの言葉が突き刺さる。",
   "ko_candidate": "알의 말이 가슴에 꽂힌다｡"
  },
  {
   "id": 23521,
   "key": "D1104ru.txt:161",
   "file": "D1104ru.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分が九郎を殺しかけたという事実に、胸を掻き毟りたくなる程の罪悪感が乱舞する。",
   "ko_candidate": "자신이 쿠로를 죽일 뻔했다는 사실에､ 가슴을 할퀴고 싶을 정도의 죄책감이 난무한다｡"
  },
  {
   "id": 23522,
   "key": "D1104ru.txt:163",
   "file": "D1104ru.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "また涙が溢れてきた。",
   "ko_candidate": "또 눈물이 흘러나왔다｡"
  },
  {
   "id": 23523,
   "key": "D1104ru.txt:165",
   "file": "D1104ru.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これ以上、アルの顔を見るのがどうにも辛くて、視線を周囲に巡らせる。",
   "ko_candidate": "더 이상 알의 얼굴을 보는 게 도저히 괴로워서 시선을 주위로 돌린다｡"
  },
  {
   "id": 23524,
   "key": "D1104ru.txt:171",
   "file": "D1104ru.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "避難シェルターに押し詰められた老若男女、誰もが不安と恐怖をその表情に滲ませて、それでも今日を生きようとする強さを失わない。",
   "ko_candidate": "대피 쉘터에 빽빽이 들어찬 노소남녀､ 누구나 불안과 공포를 그 표정에 배어나게 하면서도､ 그래도 오늘을 살아가려는 강인함을 잃지 않는다｡"
  },
  {
   "id": 23525,
   "key": "D1104ru.txt:175",
   "file": "D1104ru.txt",
   "line": 175,
   "speaker": "子供１",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ママ……ママ……」",
   "ko_candidate": "「엄마… 엄마…」"
  },
  {
   "id": 23526,
   "key": "D1104ru.txt:179",
   "file": "D1104ru.txt",
   "line": 179,
   "speaker": "母親",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「怖くない、怖くないからね。坊や」",
   "ko_candidate": "「무섭지 않아､ 무섭지 않으니까｡ 아가야」"
  },
  {
   "id": 23527,
   "key": "D1104ru.txt:184",
   "file": "D1104ru.txt",
   "line": 184,
   "speaker": "ボランティア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「この食糧を隣りの避難所まで送ってくれ。 あと赤ん坊のいる家族には、こっちの……」",
   "ko_candidate": "「이 식량을 옆 대피소까지 보내줘｡ 그리고 갓난아기가 있는 가족에게는 이쪽의…」"
  },
  {
   "id": 23528,
   "key": "D1104ru.txt:190",
   "file": "D1104ru.txt",
   "line": 190,
   "speaker": "ボランティア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……怪我人が多くて、医療スタッフの手が回ってないんだ！ そこら中から医療経験者を掻き集めてくれ！　至急だ！」",
   "ko_candidate": "「…부상자가 많아서 의료 스태프의 손이 모자라! 여기저기서 의료 경험자를 긁어모아 줘! 긴급이야!」"
  },
  {
   "id": 23529,
   "key": "D1104ru.txt:196",
   "file": "D1104ru.txt",
   "line": 196,
   "speaker": "子供２",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「びえええーん！　びえええーん！」",
   "ko_candidate": "「으앙~! 으앙~!」"
  },
  {
   "id": 23530,
   "key": "D1104ru.txt:200",
   "file": "D1104ru.txt",
   "line": 200,
   "speaker": "警官Ａ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おいおい、迷子かあ。ほら、泣くな。男の子だろ。 おじさんが一緒にお母さん捜してやるから。なっ？」",
   "ko_candidate": "「이런이런､ 미아구나｡ 자､ 울지 마｡ 남자애잖아｡ 아저씨가 같이 엄마 찾아줄 테니까｡ 그렇지?」"
  },
  {
   "id": 23531,
   "key": "D1104ru.txt:205",
   "file": "D1104ru.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……大十字九郎は言った。",
   "ko_candidate": "…다이쥬지 쿠로는 말했다｡"
  },
  {
   "id": 23532,
   "key": "D1104ru.txt:206",
   "file": "D1104ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "後味の悪ィ思いはしたくないと。",
   "ko_candidate": "찝찝한 기분은 하고 싶지 않다고｡"
  },
  {
   "id": 23533,
   "key": "D1104ru.txt:207",
   "file": "D1104ru.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから戦うと。",
   "ko_candidate": "그래서 싸운다고｡"
  },
  {
   "id": 23534,
   "key": "D1104ru.txt:209",
   "file": "D1104ru.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覇道瑠璃は考える。",
   "ko_candidate": "하도 루리는 생각한다｡"
  },
  {
   "id": 23535,
   "key": "D1104ru.txt:210",
   "file": "D1104ru.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼が、戦わなければ後味が悪ィと考えるのは何故か。",
   "ko_candidate": "그가 싸우지 않으면 찝찝하다고 생각하는 이유는 무엇일까｡"
  },
  {
   "id": 23536,
   "key": "D1104ru.txt:212",
   "file": "D1104ru.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦うことが、彼に出来ることだったから。",
   "ko_candidate": "싸우는 것이 그가 할 수 있는 일이었기 때문에｡"
  },
  {
   "id": 23537,
   "key": "D1104ru.txt:213",
   "file": "D1104ru.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼の全力だから。",
   "ko_candidate": "그의 전력이었기 때문에｡"
  },
  {
   "id": 23538,
   "key": "D1104ru.txt:215",
   "file": "D1104ru.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だったら何故、そうまでして、彼は全力を尽くそうと思ったのか。",
   "ko_candidate": "그렇다면 왜 그렇게까지 해서 그는 전력을 다하려고 했을까｡"
  },
  {
   "id": 23539,
   "key": "D1104ru.txt:217",
   "file": "D1104ru.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "つまり彼は、なんてことはない。",
   "ko_candidate": "즉 그는 별것 아니다｡"
  },
  {
   "id": 23540,
   "key": "D1104ru.txt:218",
   "file": "D1104ru.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は要するに、やっぱりアーカムシティを守りたいのだ。",
   "ko_candidate": "그는 요컨대 역시 아캄시티를 지키고 싶은 것이다｡"
  },
  {
   "id": 23541,
   "key": "D1104ru.txt:220",
   "file": "D1104ru.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこに暮らすこの人達を守りたいのだ。",
   "ko_candidate": "거기서 살아가는 이 사람들을 지키고 싶은 것이다｡"
  },
  {
   "id": 23542,
   "key": "D1104ru.txt:221",
   "file": "D1104ru.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "簡単な答えだ。",
   "ko_candidate": "간단한 답이다｡"
  }
 ]
}