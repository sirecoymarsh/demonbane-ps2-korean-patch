 "items": [
  {
   "id": 31312,
   "key": "D1302le.txt:265",
   "file": "D1302le.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は１人でさっさと進む。",
   "ko_candidate": "나는 혼자서 서둘러 나아간다｡"
  },
  {
   "id": 31313,
   "key": "D1302le.txt:270",
   "file": "D1302le.txt",
   "line": 270,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん！」",
   "ko_candidate": "「다이쥬지 씨!」"
  },
  {
   "id": 31314,
   "key": "D1302le.txt:274",
   "file": "D1302le.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その背中に、姫さんが声をかけた。",
   "ko_candidate": "그 등에､ 공주님이 말을 걸었다｡"
  },
  {
   "id": 31315,
   "key": "D1302le.txt:275",
   "file": "D1302le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一度だけ振り返る。",
   "ko_candidate": "한 번만 돌아본다｡"
  },
  {
   "id": 31316,
   "key": "D1302le.txt:276",
   "file": "D1302le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真剣な瞳と視線が重なった。",
   "ko_candidate": "진지한 눈동자와 시선이 마주쳤다｡"
  },
  {
   "id": 31317,
   "key": "D1302le.txt:287",
   "file": "D1302le.txt",
   "line": 287,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……我々、覇道財閥も全力を尽くします。決して、大十字さんやライカさんだけに総てを背負わせたりはしません。ですから……どうか無理はなさらないで」",
   "ko_candidate": "「……저희､ 하도 재벌도 전력을 다하겠습니다｡ 결코､ 다이쥬지 씨나 라이카 씨에게만 모든 걸 짊어지게 하지 않겠습니다｡ 그러니……부디 무리하지 마세요」"
  },
  {
   "id": 31318,
   "key": "D1302le.txt:292",
   "file": "D1302le.txt",
   "line": 292,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ありがとう」",
   "ko_candidate": "「……고마워」"
  },
  {
   "id": 31319,
   "key": "D1302le.txt:294",
   "file": "D1302le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの心遣いが伝わる。",
   "ko_candidate": "공주님의 배려가 전해진다｡"
  },
  {
   "id": 31320,
   "key": "D1302le.txt:295",
   "file": "D1302le.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深く感謝する。",
   "ko_candidate": "깊이 감사한다｡"
  },
  {
   "id": 31321,
   "key": "D1302le.txt:296",
   "file": "D1302le.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気休めじゃない。こういう人たちが居るからこそ、俺は戦える。",
   "ko_candidate": "위로가 아니다｡ 이런 사람들이 있기에､ 나는 싸울 수 있다｡"
  },
  {
   "id": 31322,
   "key": "D1302le.txt:297",
   "file": "D1302le.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだ、戦える。",
   "ko_candidate": "아직､ 싸울 수 있다｡"
  },
  {
   "id": 31323,
   "key": "D1302ru.txt:8",
   "file": "D1302ru.txt",
   "line": 8,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何故、マギウス・スタイルで無いのに、あれ程の力が……!?」",
   "ko_candidate": "「어째서､ 마기우스 스타일이 아닌데도､ 저 정도의 힘이……!?」"
  },
  {
   "id": 31324,
   "key": "D1302ru.txt:12",
   "file": "D1302ru.txt",
   "line": 12,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 31325,
   "key": "D1302ru.txt:15",
   "file": "D1302ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎が、ゆっくりと振り返る。",
   "ko_candidate": "쿠로가 천천히 돌아선다｡"
  },
  {
   "id": 31326,
   "key": "D1302ru.txt:17",
   "file": "D1302ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その眸を覗き込んで――眸の奥の深淵を覗きこんで、瑠璃達もまた冷たく烈しい畏怖に震えた。",
   "ko_candidate": "그 눈동자를 들여다보고――눈동자 속 심연을 들여다보며､ 루리 일행도 차갑고 격렬한 외경에 떨었다｡"
  },
  {
   "id": 31327,
   "key": "D1302ru.txt:19",
   "file": "D1302ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎から湧き立つ闇が、わななく。",
   "ko_candidate": "쿠로에게서 솟아오르는 어둠이 떨린다｡"
  },
  {
   "id": 31328,
   "key": "D1302ru.txt:23",
   "file": "D1302ru.txt",
   "line": 23,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だ、ダーリン？」",
   "ko_candidate": "「다､ 달링?」"
  },
  {
   "id": 31329,
   "key": "D1302ru.txt:27",
   "file": "D1302ru.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何も映さぬ瞳、揺らぎもしない深淵をそのままに、一歩、瑠璃達に向かって近寄った。",
   "ko_candidate": "아무것도 비치지 않는 눈동자､ 흔들림 없는 심연 그대로､ 한 걸음､ 루리 일행을 향해 다가왔다｡"
  },
  {
   "id": 31330,
   "key": "D1302ru.txt:29",
   "file": "D1302ru.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "踏み締めた一歩と共に、足許から闇が噴き出る。",
   "ko_candidate": "내디딘 한 걸음과 함께､ 발밑에서 어둠이 뿜어져 나온다｡"
  },
  {
   "id": 31331,
   "key": "D1302ru.txt:34",
   "file": "D1302ru.txt",
   "line": 34,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ああ……っ」",
   "ko_candidate": "「……아아……」"
  },
  {
   "id": 31332,
   "key": "D1302ru.txt:38",
   "file": "D1302ru.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に一歩。",
   "ko_candidate": "한 걸음 더｡"
  },
  {
   "id": 31333,
   "key": "D1302ru.txt:40",
   "file": "D1302ru.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が吹き荒れる。",
   "ko_candidate": "어둠이 휘몰아친다｡"
  },
  {
   "id": 31334,
   "key": "D1302ru.txt:42",
   "file": "D1302ru.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界の脆さを嘲笑う様に、雪崩れ込む。",
   "ko_candidate": "세계의 취약함을 조롱하듯､ 눈사태처럼 무너져 내린다｡"
  },
  {
   "id": 31335,
   "key": "D1302ru.txt:43",
   "file": "D1302ru.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖が牙を剥いて、襲いかかる。",
   "ko_candidate": "공포가 이빨을 드러내고､ 덮쳐온다｡"
  },
  {
   "id": 31336,
   "key": "D1302ru.txt:47",
   "file": "D1302ru.txt",
   "line": 47,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぅぅ……ああ……っ！」",
   "ko_candidate": "「으으……아아……!」"
  },
  {
   "id": 31337,
   "key": "D1302ru.txt:52",
   "file": "D1302ru.txt",
   "line": 52,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……ああああああッ！」",
   "ko_candidate": "「아……아아아아아!」"
  },
  {
   "id": 31338,
   "key": "D1302ru.txt:55",
   "file": "D1302ru.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "起き上がらなければ。",
   "ko_candidate": "일어나야 한다｡"
  },
  {
   "id": 31339,
   "key": "D1302ru.txt:56",
   "file": "D1302ru.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起きて、逃げなければ。",
   "ko_candidate": "일어나서､ 도망가야 한다｡"
  },
  {
   "id": 31340,
   "key": "D1302ru.txt:58",
   "file": "D1302ru.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "直感がそう告げていた。",
   "ko_candidate": "직감이 그렇게 말하고 있었다｡"
  },
  {
   "id": 31341,
   "key": "D1302ru.txt:60",
   "file": "D1302ru.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが、クラウディウスに痛め付けられた躰は思うように動いてくれない。",
   "ko_candidate": "하지만､ 클라우디우스에게 상처 입은 몸은 마음대로 움직여 주지 않는다｡"
  },
  {
   "id": 31342,
   "key": "D1302ru.txt:62",
   "file": "D1302ru.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に、このプレッシャー。",
   "ko_candidate": "게다가､ 이 압박감｡"
  },
  {
   "id": 31343,
   "key": "D1302ru.txt:63",
   "file": "D1302ru.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "激痛に苛まれる躰を、恐怖に硬直する躰を引きずる様に、這いずる。",
   "ko_candidate": "격통에 시달리는 몸을､ 공포에 경직된 몸을 끌듯이､ 기어간다｡"
  },
  {
   "id": 31344,
   "key": "D1302ru.txt:66",
   "file": "D1302ru.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に一歩。",
   "ko_candidate": "한 걸음 더｡"
  },
  {
   "id": 31345,
   "key": "D1302ru.txt:71",
   "file": "D1302ru.txt",
   "line": 71,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――！」",
   "ko_candidate": "「――――――――!」"
  },
  {
   "id": 31346,
   "key": "D1302ru.txt:74",
   "file": "D1302ru.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖が爆発する。",
   "ko_candidate": "공포가 폭발한다｡"
  },
  {
   "id": 31347,
   "key": "D1302ru.txt:75",
   "file": "D1302ru.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲鳴すら声にならない。",
   "ko_candidate": "비명조차 목소리가 되지 않는다｡"
  },
  {
   "id": 31348,
   "key": "D1302ru.txt:76",
   "file": "D1302ru.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が弾け飛ぶ。何も感じられなくなる。",
   "ko_candidate": "의식이 튕겨나간다｡ 아무것도 느껴지지 않는다｡"
  },
  {
   "id": 31349,
   "key": "D1302ru.txt:78",
   "file": "D1302ru.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "恐怖で充たされているが、恐怖しか存在しない故に、恐怖を認識出来ない、そんな矛盾した精神状態。",
   "ko_candidate": "공포로 가득 차 있지만､ 공포밖에 존재하지 않기에､ 공포를 인식 할 수 없는､ 그런 모순된 정신 상태｡"
  },
  {
   "id": 31350,
   "key": "D1302ru.txt:79",
   "file": "D1302ru.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖の烈しさに、自我が崩壊し始めていた。",
   "ko_candidate": "공포의 격렬함에､ 자아가 붕괴되기 시작했다｡"
  },
  {
   "id": 31351,
   "key": "D1302ru.txt:86",
   "file": "D1302ru.txt",
   "line": 86,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「しっかりしろ、小娘！　プレッシャーに呑み込まれるなッ！」",
   "ko_candidate": "「정신 차려､ 꼬마야! 압박감에 휩쓸리지 마!」"
  }
 ]
}