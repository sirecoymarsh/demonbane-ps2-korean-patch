{
 "packet": "ep_ruri02a_06",
 "scene": "ep_ruri02a",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "姫さん": "공주님",
  "アーカム": "아컴",
  "アーカムシティ": "아컴시티",
  "覇道鋼造": "하도 코조",
  "鋼造": "코조",
  "ブラックロッジ": "블랙로지",
  "覇道財閥": "하도 재벌",
  "大十字九郎": "다이쥬지 쿠로",
  "マスターテリオン": "마스터 테리온"
 },
 "items": [
  {
   "id": 50773,
   "key": "ep_ruri02a.txt:816",
   "file": "ep_ruri02a.txt",
   "line": 816,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "哄笑だけを残して。",
   "ko_candidate": ""
  },
  {
   "id": 50774,
   "key": "ep_ruri02a.txt:818",
   "file": "ep_ruri02a.txt",
   "line": 818,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺はその場に崩れ落ちるようにして、しゃがみ込んだ。",
   "ko_candidate": ""
  },
  {
   "id": 50775,
   "key": "ep_ruri02a.txt:819",
   "file": "ep_ruri02a.txt",
   "line": 819,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "乾いた砂が舞う。",
   "ko_candidate": ""
  },
  {
   "id": 50776,
   "key": "ep_ruri02a.txt:820",
   "file": "ep_ruri02a.txt",
   "line": 820,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "途方に暮れて……無人の荒野を見渡した。",
   "ko_candidate": ""
  },
  {
   "id": 50777,
   "key": "ep_ruri02a.txt:824",
   "file": "ep_ruri02a.txt",
   "line": 824,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……姫さん」",
   "ko_candidate": ""
  },
  {
   "id": 50778,
   "key": "ep_ruri02a.txt:834",
   "file": "ep_ruri02a.txt",
   "line": 834,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "３ヶ月を費やして、俺はアーカムに戻った。",
   "ko_candidate": ""
  },
  {
   "id": 50779,
   "key": "ep_ruri02a.txt:835",
   "file": "ep_ruri02a.txt",
   "line": 835,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "目に映る街の光景は、俺の知るアーカムシティなど見る影も無い、ただの寂れた、旧い田舎町だった。",
   "ko_candidate": ""
  },
  {
   "id": 50780,
   "key": "ep_ruri02a.txt:837",
   "file": "ep_ruri02a.txt",
   "line": 837,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "覇道鋼造の遺言を叶えるべく、俺は問題の女性を捜した。",
   "ko_candidate": ""
  },
  {
   "id": 50781,
   "key": "ep_ruri02a.txt:838",
   "file": "ep_ruri02a.txt",
   "line": 838,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だが、その女性に会うことは出来なかった。",
   "ko_candidate": ""
  },
  {
   "id": 50782,
   "key": "ep_ruri02a.txt:839",
   "file": "ep_ruri02a.txt",
   "line": 839,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "鋼造がアリゾナの辺境で彷徨っている間に、彼の愛したその女性は、病によって亡くなっていたのだ。",
   "ko_candidate": ""
  },
  {
   "id": 50783,
   "key": "ep_ruri02a.txt:840",
   "file": "ep_ruri02a.txt",
   "line": 840,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "鋼造の時と引き続いて、何とも後味の悪い思いをする。",
   "ko_candidate": ""
  },
  {
   "id": 50784,
   "key": "ep_ruri02a.txt:842",
   "file": "ep_ruri02a.txt",
   "line": 842,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だが朗報――と言って良いのだろうか。",
   "ko_candidate": ""
  },
  {
   "id": 50785,
   "key": "ep_ruri02a.txt:843",
   "file": "ep_ruri02a.txt",
   "line": 843,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "一つ分かったことがある。",
   "ko_candidate": ""
  },
  {
   "id": 50786,
   "key": "ep_ruri02a.txt:844",
   "file": "ep_ruri02a.txt",
   "line": 844,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その女性は、鋼造と別れた後で、彼には知られず、彼の子を産んでいたのだ。",
   "ko_candidate": ""
  },
  {
   "id": 50787,
   "key": "ep_ruri02a.txt:845",
   "file": "ep_ruri02a.txt",
   "line": 845,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その子どもは、女性の死後、どこにも身寄りがなくて、ある孤児院に引き取られていたらしい。",
   "ko_candidate": ""
  },
  {
   "id": 50788,
   "key": "ep_ruri02a.txt:847",
   "file": "ep_ruri02a.txt",
   "line": 847,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺は、その子どもに逢いに行った。",
   "ko_candidate": ""
  },
  {
   "id": 50789,
   "key": "ep_ruri02a.txt:848",
   "file": "ep_ruri02a.txt",
   "line": 848,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そしてその瞬間、次の戦いは決定された。",
   "ko_candidate": ""
  },
  {
   "id": 50790,
   "key": "ep_ruri02a.txt:849",
   "file": "ep_ruri02a.txt",
   "line": 849,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "人生を賭して行う、この時はまだ存在すらしない、悪との戦い。",
   "ko_candidate": ""
  },
  {
   "id": 50791,
   "key": "ep_ruri02a.txt:850",
   "file": "ep_ruri02a.txt",
   "line": 850,
   "speaker": null,
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "『ブラックロッジ』との闘争の日々が。",
   "ko_candidate": ""
  },
  {
   "id": 50792,
   "key": "ep_ruri02a.txt:852",
   "file": "ep_ruri02a.txt",
   "line": 852,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "不安そうに見つめるその子に向かって、俺は、欺瞞に満ちた微笑みを浮かべ、棘のように刺さる罪悪感を呑み込み、こう話しかけた……。",
   "ko_candidate": ""
  },
  {
   "id": 50793,
   "key": "ep_ruri02a.txt:857",
   "file": "ep_ruri02a.txt",
   "line": 857,
   "speaker": "九郎",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「初めまして、坊や。 私が――君のお父さんだよ」",
   "ko_candidate": ""
  },
  {
   "id": 50794,
   "key": "ep_ruri02a.txt:862",
   "file": "ep_ruri02a.txt",
   "line": 862,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "俺は――覇道鋼造に成り代わった。",
   "ko_candidate": ""
  },
  {
   "id": 50795,
   "key": "ep_ruri02a.txt:865",
   "file": "ep_ruri02a.txt",
   "line": 865,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "事実を述べると、覇道鋼造から託された地図は、まったくもって正しかった。",
   "ko_candidate": ""
  },
  {
   "id": 50796,
   "key": "ep_ruri02a.txt:866",
   "file": "ep_ruri02a.txt",
   "line": 866,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "彼が目をつけたあの一角こそが、誰も辿り着けなかった黄金郷、巨大な金脈に違いなかった。",
   "ko_candidate": ""
  },
  {
   "id": 50797,
   "key": "ep_ruri02a.txt:867",
   "file": "ep_ruri02a.txt",
   "line": 867,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "冒険家としての彼は、間違いなく、一流だったのだろう。",
   "ko_candidate": ""
  },
  {
   "id": 50798,
   "key": "ep_ruri02a.txt:868",
   "file": "ep_ruri02a.txt",
   "line": 868,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "その金脈こそが、資金源となった。",
   "ko_candidate": ""
  },
  {
   "id": 50799,
   "key": "ep_ruri02a.txt:870",
   "file": "ep_ruri02a.txt",
   "line": 870,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "寝る間を惜しみ、命を削る勢いで、俺は経営学、経済学、帝王学……必要なありとあらゆる教養を身に着けていった。",
   "ko_candidate": ""
  },
  {
   "id": 50800,
   "key": "ep_ruri02a.txt:871",
   "file": "ep_ruri02a.txt",
   "line": 871,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "それでも足りない分は、魔術を駆使した。",
   "ko_candidate": ""
  },
  {
   "id": 50801,
   "key": "ep_ruri02a.txt:873",
   "file": "ep_ruri02a.txt",
   "line": 873,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "魔術に加えて、俺には未来の知識があった。",
   "ko_candidate": ""
  },
  {
   "id": 50802,
   "key": "ep_ruri02a.txt:874",
   "file": "ep_ruri02a.txt",
   "line": 874,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "時代の流れを読むもクソも無い。",
   "ko_candidate": ""
  },
  {
   "id": 50803,
   "key": "ep_ruri02a.txt:875",
   "file": "ep_ruri02a.txt",
   "line": 875,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただシナリオに沿って、動けば良いだけのことだ。 そうやって俺が率いる覇道は、世界を呑み込む勢いで、巨大化し――世界の頂点に立つ覇道財閥として完成した。",
   "ko_candidate": "「언제까지 멍하니 있을 생각이에요! 꾸물거리지 말고 빨리 하세요 서두르세요! 싸우지 않는 당신에게 무슨 존재 의의가 있나요!? 재생지 재료도 안 될 벌레 먹은 헌 책 아가씨 주제에!」"
  },
  {
   "id": 50804,
   "key": "ep_ruri02a.txt:878",
   "file": "ep_ruri02a.txt",
   "line": 878,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だが、それは俺の目的の、単なる過程に過ぎないのだ。",
   "ko_candidate": ""
  },
  {
   "id": 50805,
   "key": "ep_ruri02a.txt:880",
   "file": "ep_ruri02a.txt",
   "line": 880,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "世界一の大都市となったアーカムシティに、突如として――俺からすれば、運命に定められている通り――",
   "ko_candidate": ""
  },
  {
   "id": 50806,
   "key": "ep_ruri02a.txt:881",
   "file": "ep_ruri02a.txt",
   "line": 881,
   "speaker": null,
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "『ブラックロッジ』を名乗る、悪の魔術結社が現れる。",
   "ko_candidate": ""
  },
  {
   "id": 50807,
   "key": "ep_ruri02a.txt:893",
   "file": "ep_ruri02a.txt",
   "line": 893,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「久しいな……大十字九郎。いや、失礼。覇道鋼造よ。 約束通り、再び相まみえる為に戻ってきたぞ。この、絶望と闘争の街に」",
   "ko_candidate": ""
  },
  {
   "id": 50808,
   "key": "ep_ruri02a.txt:900",
   "file": "ep_ruri02a.txt",
   "line": 900,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "第２ラウンドの幕が切って下ろされたのだ。",
   "ko_candidate": ""
  },
  {
   "id": 50809,
   "key": "ep_ruri02a.txt:903",
   "file": "ep_ruri02a.txt",
   "line": 903,
   "speaker": null,
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "『ブラックロッジ』との闘争は熾烈を増した。",
   "ko_candidate": ""
  },
  {
   "id": 50810,
   "key": "ep_ruri02a.txt:904",
   "file": "ep_ruri02a.txt",
   "line": 904,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "互いに未来を知る者同士……しかも、未来に関する智慧は、何度も歴史を繰り返しているだろうマスターテリオンに軍配が上がる。",
   "ko_candidate": ""
  },
  {
   "id": 50811,
   "key": "ep_ruri02a.txt:905",
   "file": "ep_ruri02a.txt",
   "line": 905,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "辛い、戦いだった。",
   "ko_candidate": ""
  },
  {
   "id": 50812,
   "key": "ep_ruri02a.txt:906",
   "file": "ep_ruri02a.txt",
   "line": 906,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして正面から奴等に立ち向かうには……俺の躰は老いぼれ過ぎていた。",
   "ko_candidate": ""
  }
 ]
}