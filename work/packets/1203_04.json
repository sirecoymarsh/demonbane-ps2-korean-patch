 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ウィンフィールド": "윈필드",
  "ティトゥス": "티투스",
  "ソーニャ": "소냐",
  "マコト": "마코토"
 },
 "items": [
  {
   "id": 27109,
   "key": "D1203ru.txt:433",
   "file": "D1203ru.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ツッコミはまたしても黙殺される。",
   "ko_candidate": "지적은 또다시 무시된다｡"
  },
  {
   "id": 27110,
   "key": "D1203ru.txt:435",
   "file": "D1203ru.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "睨み合ったまま、互いの挙動を探り続ける。",
   "ko_candidate": "노려보며 서로의 행동을 계속 살핀다｡"
  },
  {
   "id": 27111,
   "key": "D1203ru.txt:437",
   "file": "D1203ru.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先の後か、後の先か、それとも先の先か――高まり、ぶつかり合う２つの闘気。",
   "ko_candidate": "선의 후인가､ 후의 선인가､ 아니면 선의 선인가――고조되어 부딪치는 두 개의 투기｡"
  },
  {
   "id": 27112,
   "key": "D1203ru.txt:438",
   "file": "D1203ru.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緊張は極限まで張り詰めていた。",
   "ko_candidate": "긴장감은 극한까지 팽팽해졌다｡"
  },
  {
   "id": 27113,
   "key": "D1203ru.txt:440",
   "file": "D1203ru.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まさに一触即発。",
   "ko_candidate": "말 그대로 일촉즉발｡"
  },
  {
   "id": 27114,
   "key": "D1203ru.txt:441",
   "file": "D1203ru.txt",
   "line": 441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、その状況下で不意にウィンフィールドは――微笑んだ。",
   "ko_candidate": "하지만 그런 상황에서 불현듯 윈필드는――미소 지었다｡"
  },
  {
   "id": 27115,
   "key": "D1203ru.txt:445",
   "file": "D1203ru.txt",
   "line": 445,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………？」",
   "ko_candidate": "「…………?」"
  },
  {
   "id": 27116,
   "key": "D1203ru.txt:454",
   "file": "D1203ru.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身の力を抜き、構えを解く。",
   "ko_candidate": "온몸의 힘을 빼고 자세를 풀었다｡"
  },
  {
   "id": 27117,
   "key": "D1203ru.txt:459",
   "file": "D1203ru.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だらんと、両腕をぶら下げた様な格好。",
   "ko_candidate": "축 늘어진 채､ 양팔을 늘어뜨린 듯한 자세｡"
  },
  {
   "id": 27118,
   "key": "D1203ru.txt:460",
   "file": "D1203ru.txt",
   "line": 460,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "叩き付けられる闘気も、総ていなしてしまう。",
   "ko_candidate": "내리꽂히는 투기도 모두 무효화시켜 버린다｡"
  },
  {
   "id": 27119,
   "key": "D1203ru.txt:462",
   "file": "D1203ru.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの表情が一瞬、怒りに翳った。",
   "ko_candidate": "티투스의 표정이 순간 분노로 물들었다｡"
  },
  {
   "id": 27120,
   "key": "D1203ru.txt:466",
   "file": "D1203ru.txt",
   "line": 466,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「拙者を愚弄しているのか……否、これは無為の構え」",
   "ko_candidate": "「소인을 우롱하는 것인가… 아니､ 이는 무위의 자세」"
  },
  {
   "id": 27121,
   "key": "D1203ru.txt:470",
   "file": "D1203ru.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが、すぐに思い当たったようだ。",
   "ko_candidate": "하지만 곧 깨달은 듯하다｡"
  },
  {
   "id": 27122,
   "key": "D1203ru.txt:472",
   "file": "D1203ru.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう。これもまた、闘法の一つ。",
   "ko_candidate": "그렇다｡ 이 또한 투법의 하나｡"
  },
  {
   "id": 27123,
   "key": "D1203ru.txt:473",
   "file": "D1203ru.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "構えを解き、闘志を消すことで、相手に次の行動を予測させない。",
   "ko_candidate": "자세를 풀고 투지를 지워 상대방에게 다음 행동을 예측하지 못하게 한다｡"
  },
  {
   "id": 27124,
   "key": "D1203ru.txt:475",
   "file": "D1203ru.txt",
   "line": 475,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "武術を突き詰めた者が辿り着く、究極の構えだ。",
   "ko_candidate": "무술을 극한까지 파고든 자가 도달하는 궁극의 자세다｡"
  },
  {
   "id": 27125,
   "key": "D1203ru.txt:485",
   "file": "D1203ru.txt",
   "line": 485,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「この国にもそのような戦法を執る者が居るとはな。面白い、誘いに乗ろう」",
   "ko_candidate": "「이 나라에도 그런 전법을 쓰는 자가 있다니｡ 재밌군､ 유도에 응하지」"
  },
  {
   "id": 27126,
   "key": "D1203ru.txt:491",
   "file": "D1203ru.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの闘気が冷たく研ぎ澄まされる。",
   "ko_candidate": "티투스의 투기가 차갑게 연마된다｡"
  },
  {
   "id": 27127,
   "key": "D1203ru.txt:492",
   "file": "D1203ru.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "濃密になっていく闘気に中てられて、気絶寸前に追い込まれる者も出てきた。",
   "ko_candidate": "짙어지는 투기에 맞아 기절 직전으로 몰리는 자들도 나왔다｡"
  },
  {
   "id": 27128,
   "key": "D1203ru.txt:494",
   "file": "D1203ru.txt",
   "line": 494,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "よろめくソーニャの躰を、マコトが支える。",
   "ko_candidate": "비틀거리는 소냐의 몸을 마코토가 받쳐준다｡"
  },
  {
   "id": 27129,
   "key": "D1203ru.txt:501",
   "file": "D1203ru.txt",
   "line": 501,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……大丈夫ですか？」",
   "ko_candidate": "「…괜찮으세요?」"
  },
  {
   "id": 27130,
   "key": "D1203ru.txt:506",
   "file": "D1203ru.txt",
   "line": 506,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ……どうもありがとうございます～」",
   "ko_candidate": "「아아… 정말 감사합니다~」"
  },
  {
   "id": 27131,
   "key": "D1203ru.txt:516",
   "file": "D1203ru.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "負けじと気を強く持って、二人の闘いを見守る。",
   "ko_candidate": "지지 않으려 마음을 다잡고 두 사람의 싸움을 지켜본다｡"
  },
  {
   "id": 27132,
   "key": "D1203ru.txt:518",
   "file": "D1203ru.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闘気が今、凶器へと凝縮された。",
   "ko_candidate": "투기가 지금､ 흉기로 응축되었다｡"
  },
  {
   "id": 27133,
   "key": "D1203ru.txt:519",
   "file": "D1203ru.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "解き放たれる。",
   "ko_candidate": "해방된다｡"
  },
  {
   "id": 27134,
   "key": "D1203ru.txt:524",
   "file": "D1203ru.txt",
   "line": 524,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「御首級！　頂戴！」",
   "ko_candidate": "「귀하의 목! 받겠소!」"
  },
  {
   "id": 27135,
   "key": "D1203ru.txt:528",
   "file": "D1203ru.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "神速の走法と神速の斬撃！",
   "ko_candidate": "신속한 주법과 신속한 참격!"
  },
  {
   "id": 27136,
   "key": "D1203ru.txt:530",
   "file": "D1203ru.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかしウィンフィールドは微動だにせず――",
   "ko_candidate": "하지만 윈필드는 미동도 하지 않고――"
  },
  {
   "id": 27137,
   "key": "D1203ru.txt:538",
   "file": "D1203ru.txt",
   "line": 538,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「奥義――全休符・無音」",
   "ko_candidate": "「오의――전휴부?무음」"
  }
 ]
}