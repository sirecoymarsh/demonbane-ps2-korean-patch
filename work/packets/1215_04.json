 },
 "items": [
  {
   "id": 30440,
   "key": "D1215le.txt:558",
   "file": "D1215le.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんは――嗤っている。",
   "ko_candidate": "라이카 씨는--웃고 있다｡"
  },
  {
   "id": 30441,
   "key": "D1215le.txt:559",
   "file": "D1215le.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昏く兇暴な衝動に嗤っている。",
   "ko_candidate": "어둡고 포악한 충동에 웃고 있다｡"
  },
  {
   "id": 30442,
   "key": "D1215le.txt:561",
   "file": "D1215le.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かが、間違っていた。",
   "ko_candidate": "뭔가가､ 잘못되고 있었다｡"
  },
  {
   "id": 30443,
   "key": "D1215le.txt:562",
   "file": "D1215le.txt",
   "line": 562,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは、いけない。",
   "ko_candidate": "이건､ 안 된다｡"
  },
  {
   "id": 30444,
   "key": "D1215le.txt:564",
   "file": "D1215le.txt",
   "line": 564,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは、危険すぎる。",
   "ko_candidate": "이건､ 너무 위험하다｡"
  },
  {
   "id": 30445,
   "key": "D1215le.txt:565",
   "file": "D1215le.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ようやく俺の第六感は迫る脅威に反応し、悲鳴を上げる。",
   "ko_candidate": "드디어 내 제6감은 다가오는 위협에 반응해 비명을 지른다｡"
  },
  {
   "id": 30446,
   "key": "D1215le.txt:567",
   "file": "D1215le.txt",
   "line": 567,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今頃になって、ようやく両脚と左腕は地表に激突し、ゆっくりと少しずつ土煙を巻き起こす。",
   "ko_candidate": "이제야 겨우 양 다리와 왼팔이 지표면에 격돌해 천천히 조금씩 먼지를 일으킨다｡"
  },
  {
   "id": 30447,
   "key": "D1215le.txt:568",
   "file": "D1215le.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傍から見れば、ロードビヤーキーが独りでに崩壊しているように見えることだろう。",
   "ko_candidate": "옆에서 보면 로드 비야키가 저절로 붕괴되고 있는 것처럼 보일 것이다｡"
  },
  {
   "id": 30448,
   "key": "D1215le.txt:570",
   "file": "D1215le.txt",
   "line": 570,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティング・ホラーのスピードは、もはや異形の領域に在った。",
   "ko_candidate": "헌팅 호러의 속도는 이미 이형의 영역에 있었다｡"
  },
  {
   "id": 30449,
   "key": "D1215le.txt:573",
   "file": "D1215le.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――何故だろう。",
   "ko_candidate": "--왜일까｡"
  },
  {
   "id": 30450,
   "key": "D1215le.txt:574",
   "file": "D1215le.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い少女の、嗤い声を聴いた気がする。",
   "ko_candidate": "검은 소녀의 웃음소리가 들리는 것 같다｡"
  },
  {
   "id": 30451,
   "key": "D1215le.txt:575",
   "file": "D1215le.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は吼えた。",
   "ko_candidate": "나는 포효했다｡"
  },
  {
   "id": 30452,
   "key": "D1215le.txt:578",
   "file": "D1215le.txt",
   "line": 578,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさん止めろ！　こいつはヤバイものだ！ 我に返れ！」",
   "ko_candidate": "「라이카 씨 멈춰! 이놈은 위험한 거야! 정신 차려!」"
  },
  {
   "id": 30453,
   "key": "D1215le.txt:581",
   "file": "D1215le.txt",
   "line": 581,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが静止の声は届かない。",
   "ko_candidate": "하지만 정지하라는 목소리는 닿지 않는다｡"
  },
  {
   "id": 30454,
   "key": "D1215le.txt:582",
   "file": "D1215le.txt",
   "line": 582,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハンティング・ホラーは、トドメ、ロードビヤーキーの『心臓』を貫くため、一直線に疾走する……！",
   "ko_candidate": "헌팅 호러는 마지막 일격､ 로드 비야키의 『심장』을 관통하기 위해 일직선으로 질주한다…!"
  },
  {
   "id": 30455,
   "key": "D1215le.txt:588",
   "file": "D1215le.txt",
   "line": 588,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「殺ァァァァ――――――――――――――――――ッッッッッ！」",
   "ko_candidate": "「죽여어어어어--!」"
  },
  {
   "id": 30456,
   "key": "D1215le.txt:591",
   "file": "D1215le.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那。",
   "ko_candidate": "찰나｡"
  },
  {
   "id": 30457,
   "key": "D1215le.txt:592",
   "file": "D1215le.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスがコクピットから翔び出した。",
   "ko_candidate": "클라우디우스가 콕핏에서 뛰쳐나왔다｡"
  },
  {
   "id": 30458,
   "key": "D1215le.txt:593",
   "file": "D1215le.txt",
   "line": 593,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風を纏い、躰が崩れ落ちるのにも構わず、全速力で特攻してくる。",
   "ko_candidate": "바람을 두르고 몸이 무너져 내리는 것도 아랑곳하지 않고 전속력으로 특공해 온다｡"
  },
  {
   "id": 30459,
   "key": "D1215le.txt:595",
   "file": "D1215le.txt",
   "line": 595,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかもその角度は、ハンティング・ホラーとぶつかる事のないよう、斜め上から。",
   "ko_candidate": "게다가 그 각도는 헌팅 호러와 부딪히지 않도록 비스듬히 위에서｡"
  },
  {
   "id": 30460,
   "key": "D1215le.txt:596",
   "file": "D1215le.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "直接、騎手である俺たちを狙ってくる！",
   "ko_candidate": "직접 기수인 우리를 노리고 오고 있어!"
  },
  {
   "id": 30461,
   "key": "D1215le.txt:598",
   "file": "D1215le.txt",
   "line": 598,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦慄が心臓を震わせ、炎をくべる。",
   "ko_candidate": "전율이 심장을 떨게 하고 불을 지핀다｡"
  },
  {
   "id": 30462,
   "key": "D1215le.txt:599",
   "file": "D1215le.txt",
   "line": 599,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を爆発的なエネルギーが駈け巡った。",
   "ko_candidate": "전신을 폭발적인 에너지가 달린다｡"
  },
  {
   "id": 30463,
   "key": "D1215le.txt:600",
   "file": "D1215le.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は超音速で疾る、ハンティング・ホラーの上に立つ。",
   "ko_candidate": "나는 초음속으로 질주하는 헌팅 호러 위에 선다｡"
  },
  {
   "id": 30464,
   "key": "D1215le.txt:604",
   "file": "D1215le.txt",
   "line": 604,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎!?」",
   "ko_candidate": "「쿠로!?」"
  },
  {
   "id": 30465,
   "key": "D1215le.txt:610",
   "file": "D1215le.txt",
   "line": 610,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狂暴なＧを全身に受けても、俺の身体は微塵にも揺らぐ事はない。",
   "ko_candidate": "광포한 G를 온몸에 받아도 내 몸은 조금도 흔들리지 않는다｡"
  },
  {
   "id": 30466,
   "key": "D1215le.txt:611",
   "file": "D1215le.txt",
   "line": 611,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀を構える。",
   "ko_candidate": "바르자이의 언월도를 구사한다｡"
  },
  {
   "id": 30467,
   "key": "D1215le.txt:612",
   "file": "D1215le.txt",
   "line": 612,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もはやヒトの形を留めず、血風の刃と化したクラウディウスが迫る。",
   "ko_candidate": "이제 사람의 형태를 유지하지 못하고 피바람의 칼날이 된 클라우디우스가 다가온다｡"
  },
  {
   "id": 30468,
   "key": "D1215le.txt:615",
   "file": "D1215le.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、翔んだ。",
   "ko_candidate": "나는､ 날아올랐다｡"
  },
  {
   "id": 30469,
   "key": "D1215le.txt:617",
   "file": "D1215le.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "弾丸の如く、ハンティング・ホラーから翔び出す。",
   "ko_candidate": "탄환처럼､ 헌팅 호러에서 튀어나온다｡"
  },
  {
   "id": 30470,
   "key": "D1215le.txt:618",
   "file": "D1215le.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "躰をバラバラに引き裂くような衝撃波。",
   "ko_candidate": "몸을 산산조각 내는 듯한 충격파｡"
  },
  {
   "id": 30471,
   "key": "D1215le.txt:619",
   "file": "D1215le.txt",
   "line": 619,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身から血が噴き出る。肉が音速の刃に削られ、皮が剥がされていく。",
   "ko_candidate": "온몸에서 피가 분출된다｡ 살이 음속의 칼날에 깎이고､ 피부가 벗겨져 간다｡"
  },
  {
   "id": 30472,
   "key": "D1215le.txt:620",
   "file": "D1215le.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが全ては、この一撃に――！",
   "ko_candidate": "하지만 모든 것은､ 이 일격에――!"
  },
  {
   "id": 30473,
   "key": "D1215le.txt:624",
   "file": "D1215le.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無音。",
   "ko_candidate": "무음｡"
  },
  {
   "id": 30474,
   "key": "D1215le.txt:625",
   "file": "D1215le.txt",
   "line": 625,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃の嵐の向こうには、死んだような静寂の領域。",
   "ko_candidate": "충격의 폭풍 너머에는､ 죽은 듯한 정적의 영역｡"
  },
  {
   "id": 30475,
   "key": "D1215le.txt:626",
   "file": "D1215le.txt",
   "line": 626,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迫る血風に、俺は偃月刀を振り下ろす。",
   "ko_candidate": "다가오는 피바람에､ 나는 언월도를 내리친다｡"
  },
  {
   "id": 30476,
   "key": "D1215le.txt:630",
   "file": "D1215le.txt",
   "line": 630,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字九郎！　メタトロン！　カリグラを殺した報いを！　何としても、与えてやるッッ！」",
   "ko_candidate": "「다이쥬지 쿠로! 메타트론! 칼리굴라를 죽인 대가를! 어떻게든､ 치르게 해주마!」"
  },
  {
   "id": 30477,
   "key": "D1215le.txt:634",
   "file": "D1215le.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無音であるはずの世界に、その聲だけが響いた。",
   "ko_candidate": "무음이어야 할 세계에､ 그 목소리만이 울렸다｡"
  },
  {
   "id": 30478,
   "key": "D1215le.txt:635",
   "file": "D1215le.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "音速の壁に遮られているはずの、聲が。",
   "ko_candidate": "음속의 벽에 가로막혀야 할､ 목소리가｡"
  },
  {
   "id": 30479,
   "key": "D1215le.txt:643",
   "file": "D1215le.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "手応えは無かった。",
   "ko_candidate": "손맛은 없었다｡"
  }
 ]
}