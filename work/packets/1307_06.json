  },
  {
   "id": 33263,
   "key": "D1307le.txt:361",
   "file": "D1307le.txt",
   "line": 361,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も誰も！　誰も阻めはしない！",
   "ko_candidate": "누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도 누구도! 누구도 막을 수 없어!"
  },
  {
   "id": 33264,
   "key": "D1307le.txt:363",
   "file": "D1307le.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僕は、僕の大切なものを連れて、あの青空へ翔び立つ！",
   "ko_candidate": "나는､ 내 소중한 것을 데리고 저 푸른 하늘로 날아오를 거야!"
  },
  {
   "id": 33265,
   "key": "D1307le.txt:365",
   "file": "D1307le.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "大丈夫だ！",
   "ko_candidate": "괜찮아!"
  },
  {
   "id": 33266,
   "key": "D1307le.txt:366",
   "file": "D1307le.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫大丈夫……！",
   "ko_candidate": "괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아 괜찮아…!"
  },
  {
   "id": 33267,
   "key": "D1307le.txt:368",
   "file": "D1307le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――大丈夫、なんだ！",
   "ko_candidate": "――괜찮아､ 야!"
  },
  {
   "id": 33268,
   "key": "D1307le.txt:370",
   "file": "D1307le.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛いぐらいの力で僕を抱き締める腕。",
   "ko_candidate": "아플 정도로 나를 꽉 끌어안는 팔｡"
  },
  {
   "id": 33269,
   "key": "D1307le.txt:371",
   "file": "D1307le.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僕は彼女を見上げて――",
   "ko_candidate": "나는 그녀를 올려다보며――"
  },
  {
   "id": 33270,
   "key": "D1307le.txt:375",
   "file": "D1307le.txt",
   "line": 375,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だいじょうぶ。だいじょうぶだよ」",
   "ko_candidate": "「괜찮아｡ 괜찮아」"
  },
  {
   "id": 33271,
   "key": "D1307le.txt:378",
   "file": "D1307le.txt",
   "line": 378,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いつかボクが、ここから――」",
   "ko_candidate": "「언젠가 내가､ 여기서――」"
  },
  {
   "id": 33272,
   "key": "D1307le.txt:381",
   "file": "D1307le.txt",
   "line": 381,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あの青空へ――」",
   "ko_candidate": "「저 푸른 하늘로――」"
  },
  {
   "id": 33273,
   "key": "D1307le.txt:384",
   "file": "D1307le.txt",
   "line": 384,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やくそく――」",
   "ko_candidate": "「약속――」"
  },
  {
   "id": 33274,
   "key": "D1307le.txt:387",
   "file": "D1307le.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女の顔がすぐ側に――",
   "ko_candidate": "그녀의 얼굴이 바로 옆에――"
  },
  {
   "id": 33275,
   "key": "D1307le.txt:401",
   "file": "D1307le.txt",
   "line": 401,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ウオオォォォォオオオオオオオォォォォォアアアアアアア！」",
   "ko_candidate": "「우오오오오오오오오오오오오오오오오아아아아아아아!」"
  },
  {
   "id": 33276,
   "key": "D1307le.txt:404",
   "file": "D1307le.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間中の魔力の素粒子――字祷子をダイナモの臨界を超えて、体内に取り込む。機械の心臓はオーバーヒート。行き場の失った魔力がリューガの内部で爆砕、外界へと放射される。",
   "ko_candidate": "공간 중의 마력의 소립자――자도자를 다이나모의 임계를 넘어 체내에 흡수한다｡ 기계의 심장은 과열｡ 갈 곳을 잃은 마력이 류가의 내부에서 폭쇄되어 외계로 방사된다｡"
  },
  {
   "id": 33277,
   "key": "D1307le.txt:409",
   "file": "D1307le.txt",
   "line": 409,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "辛うじて残っていたビルは、完全にただの瓦礫となった。",
   "ko_candidate": "겨우 남아있던 빌딩은 완전히 그저 잔해가 되었다｡"
  },
  {
   "id": 33278,
   "key": "D1307le.txt:410",
   "file": "D1307le.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫の山に蹲り、全身から血を噴射させ、リューガは息を荒げる。",
   "ko_candidate": "잔해의 산에 쪼그리고 앉아 온몸에서 피를 분출하며 류가는 거친 숨을 내쉰다｡"
  },
  {
   "id": 33279,
   "key": "D1307le.txt:417",
   "file": "D1307le.txt",
   "line": 417,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハァ……ハァ……ハァ……そうか……そうかぁぁぁ！」",
   "ko_candidate": "「하아… 하아… 하아… 그렇군… 그렇구나아아아!」"
  },
  {
   "id": 33280,
   "key": "D1307le.txt:420",
   "file": "D1307le.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "右瞼と頬を走る傷痕が炎えている。",
   "ko_candidate": "오른쪽 눈꺼풀과 뺨을 가로지르는 상흔이 타오르고 있다｡"
  },
  {
   "id": 33281,
   "key": "D1307le.txt:421",
   "file": "D1307le.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血を滲ませる紅の刻印。",
   "ko_candidate": "피를 배어나오게 하는 붉은 각인｡"
  },
  {
   "id": 33282,
   "key": "D1307le.txt:422",
   "file": "D1307le.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃れられない過去の証。",
   "ko_candidate": "벗어날 수 없는 과거의 증거｡"
  },
  {
   "id": 33283,
   "key": "D1307le.txt:424",
   "file": "D1307le.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この眸に灼きついている、彼女の面影。",
   "ko_candidate": "이 눈동자에 새겨진 그녀의 모습｡"
  },
  {
   "id": 33284,
   "key": "D1307le.txt:425",
   "file": "D1307le.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この脳裏から離れない、彼女の幻影。",
   "ko_candidate": "이 뇌리에서 떠나지 않는 그녀의 환영｡"
  },
  {
   "id": 33285,
   "key": "D1307le.txt:427",
   "file": "D1307le.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この世で唯一、血の絆に結ばれた女性。",
   "ko_candidate": "이 세상에서 유일하게 피의 유대로 맺어진 여성｡"
  },
  {
   "id": 33286,
   "key": "D1307le.txt:428",
   "file": "D1307le.txt",
   "line": 428,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "唯ひとりの姉。",
   "ko_candidate": "단 한 명의 누나｡"
  },
  {
   "id": 33287,
   "key": "D1307le.txt:430",
   "file": "D1307le.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この世で唯一、我が道を阻む、逃れられない過去。",
   "ko_candidate": "이 세상에서 유일하게 내 길을 막는､ 벗어날 수 없는 과거｡"
  },
  {
   "id": 33288,
   "key": "D1307le.txt:431",
   "file": "D1307le.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "唯ひとりの敵。",
   "ko_candidate": "단 한 명의 적｡"
  },
  {
   "id": 33289,
   "key": "D1307le.txt:433",
   "file": "D1307le.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傷痕に、指を突き刺し、掻き毟る。",
   "ko_candidate": "상흔에 손가락을 찔러 넣어 할퀸다｡"
  },
  {
   "id": 33290,
   "key": "D1307le.txt:434",
   "file": "D1307le.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉を千切る柔らかな感触。顔を伝う血の熱さ。",
   "ko_candidate": "살을 찢는 부드러운 감촉｡ 얼굴을 타고 흐르는 피의 뜨거움｡"
  },
  {
   "id": 33291,
   "key": "D1307le.txt:435",
   "file": "D1307le.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "流れ落ちる血は、まるで血涙の様で――",
   "ko_candidate": "흘러내리는 피는 마치 피눈물 같아서――"
  },
  {
   "id": 33292,
   "key": "D1307le.txt:440",
   "file": "D1307le.txt",
   "line": 440,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「貴様か……！　やはり貴様か！　貴様さえ！　貴様さえ滅びれば、己は解放される！　おのれ……おのれ、おのれ、おのれ！」 「滅ぼしてやる……必ず滅ぼしてやる！」",
   "ko_candidate": "「네 놈이냐…! 역시 네 놈이냐! 네 놈만 없다면! 네 놈만 사라진다면 내가 해방될 수 있어! 이 몸이… 이 몸이､ 이 몸이､ 이 몸이! 없애주마… 반드시 없애주마! 누구도 아닌! 이 내가! 이 내 손으로! 라이카! 네 놈을 없애주마! 그래… 누구에게도… 누구에게도 넘겨줄 수 없어!」"
  },
  {
   "id": 33293,
   "key": "D1307le.txt:446",
   "file": "D1307le.txt",
   "line": 446,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「誰でもない！　この己が！　この己の手で！　ライカ！　貴様を滅ぼしてやる！　そうだ……誰にも……誰にも渡してなるものか！」 立ち上がる。",
   "ko_candidate": "일어선다｡"
  },
  {
   "id": 33294,
   "key": "D1307le.txt:453",
   "file": "D1307le.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去の刃は、いまだ彼を苛み続けている。",
   "ko_candidate": "과거의 칼날은 여전히 그를 괴롭히고 있다｡"
  },
  {
   "id": 33295,
   "key": "D1307le.txt:454",
   "file": "D1307le.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがその激痛すら、尽きる事の無い憎悪と代えて、煮え滾る血潮と変える。",
   "ko_candidate": "하지만 그 격통조차 다함이 없는 증오로 바꾸어 끓어오르는 피로 변한다｡"
  },
  {
   "id": 33296,
   "key": "D1307le.txt:455",
   "file": "D1307le.txt",
   "line": 455,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無尽蔵の力が、臓腑の底から湧き上がっていた。",
   "ko_candidate": "무진장의 힘이 장부의 밑바닥에서 솟아오르고 있었다｡"
  }
 ]
}