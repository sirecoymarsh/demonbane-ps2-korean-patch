   "ko_candidate": "괜찮아… 나는 저 하늘에 갈 거야!"
  },
  {
   "id": 33261,
   "key": "D1307le.txt:358",
   "file": "D1307le.txt",
   "line": 358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空に届くんだ……！",
   "ko_candidate": "하늘에 닿을 거야…!"
  },
  {
   "id": 33262,
   "key": "D1307le.txt:360",
   "file": "D1307le.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰も。",
