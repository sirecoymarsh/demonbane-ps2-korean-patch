 "items": [
  {
   "id": 25038,
   "key": "D1108le.txt:11",
   "file": "D1108le.txt",
   "line": 11,
   "speaker": "コリン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ねえ……あれ！」",
   "ko_candidate": "「저기… 저거 봐!」"
  },
  {
   "id": 25039,
   "key": "D1108le.txt:16",
   "file": "D1108le.txt",
   "line": 16,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカ姉ちゃん！」",
   "ko_candidate": "「라이카 누나!」"
  },
  {
   "id": 25040,
   "key": "D1108le.txt:21",
   "file": "D1108le.txt",
   "line": 21,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っ！　ライカお姉ちゃん！　九郎お兄ちゃん！」",
   "ko_candidate": "「…앗! 라이카 누나! 쿠로 오빠!」"
  },
  {
   "id": 25041,
   "key": "D1108le.txt:25",
   "file": "D1108le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一斉に駈け寄り、ライカさんの胸に飛び込むガキんちょども。",
   "ko_candidate": "일제히 달려와 라이카 씨의 가슴에 뛰어드는 꼬마들｡"
  },
  {
   "id": 25042,
   "key": "D1108le.txt:26",
   "file": "D1108le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣きじゃくるみんなを、ライカさんは優しく抱き締めた。",
   "ko_candidate": "흐느끼는 모두를 라이카 씨는 부드럽게 안아주었다｡"
  },
  {
   "id": 25043,
   "key": "D1108le.txt:35",
   "file": "D1108le.txt",
   "line": 35,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「心配したんだからぁ……心配したんだからぁ！」",
   "ko_candidate": "「걱정했단 말이야… 정말 걱정했다고!」"
  },
  {
   "id": 25044,
   "key": "D1108le.txt:41",
   "file": "D1108le.txt",
   "line": 41,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うん、ごめんねぇ……みんな、ごめんねぇ……」",
   "ko_candidate": "「응､ 미안해… 모두들､ 미안해…」"
  },
  {
   "id": 25045,
   "key": "D1108le.txt:44",
   "file": "D1108le.txt",
   "line": 44,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "やれやれ。",
   "ko_candidate": "휴우｡"
  },
  {
   "id": 25046,
   "key": "D1108le.txt:45",
   "file": "D1108le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これでとりあえずは、問題解決だ。",
   "ko_candidate": "이걸로 일단은 문제 해결이군｡"
  },
  {
   "id": 25047,
   "key": "D1108le.txt:47",
   "file": "D1108le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どんな過去が圧し掛かろうと、どんな運命が待ち構えようと……みんなは家族だ。それだけは間違いない。血の繋がりも何も関係ない。",
   "ko_candidate": "어떤 과거가 짓눌러오든､ 어떤 운명이 기다리고 있든… 모두는 가족이다｡ 그것만은 틀림없어｡ 혈연 관계 같은 건 아무 상관없다｡"
  },
  {
   "id": 25048,
   "key": "D1108le.txt:55",
   "file": "D1108le.txt",
   "line": 55,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎お兄ちゃん……ありがとう ……っ！」",
   "ko_candidate": "「쿠로 오빠… 고마워 …앗!」"
  },
  {
   "id": 25049,
   "key": "D1108le.txt:60",
   "file": "D1108le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつの間にか俺のところまで寄ってきたアリスンに礼を言われる。",
   "ko_candidate": "어느새 내 곁으로 다가온 앨리슨에게 감사 인사를 받는다｡"
  },
  {
   "id": 25050,
   "key": "D1108le.txt:62",
   "file": "D1108le.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ほんの少し、こそばゆい。",
   "ko_candidate": "조금은 간지럽다｡"
  },
  {
   "id": 25051,
   "key": "D1108le.txt:64",
   "file": "D1108le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "照れ臭さをごまかすというワケではないが、アリスンの頭をクシャクシャと撫でてやる。",
   "ko_candidate": "부끄러움을 감추려는 건 아니지만､ 앨리슨의 머리를 헝클어뜨리며 쓰다듬어 준다｡"
  },
  {
   "id": 25052,
   "key": "D1108le.txt:65",
   "file": "D1108le.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アリスンは悲鳴を上げながら、嬉しそうにしている。",
   "ko_candidate": "앨리슨은 비명을 지르면서도 기뻐하는 듯하다｡"
  },
  {
   "id": 25053,
   "key": "D1108le.txt:68",
   "file": "D1108le.txt",
   "line": 68,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だから言っただろ？　心配いらないって」",
   "ko_candidate": "「그래서 말했잖아? 걱정하지 말라고」"
  },
  {
   "id": 25054,
   "key": "D1108le.txt:73",
   "file": "D1108le.txt",
   "line": 73,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……うんっ！」",
   "ko_candidate": "「…응!」"
  },
  {
   "id": 25055,
   "key": "D1108le.txt:77",
   "file": "D1108le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さて、となると後の問題は『ブラックロッジ』だ。",
   "ko_candidate": "자､ 그렇다면 남은 문제는 『블랙로지』다｡"
  },
  {
   "id": 25056,
   "key": "D1108le.txt:78",
   "file": "D1108le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "つーか、こっちは絶望的な戦況は何も変わっちゃいねえ。",
   "ko_candidate": "아니､ 이쪽은 절망적인 전황이 전혀 바뀌지 않았잖아｡"
  },
  {
   "id": 25057,
   "key": "D1108le.txt:80",
   "file": "D1108le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "さあ……どうする。",
   "ko_candidate": "자… 어떻게 하지｡"
  },
  {
   "id": 25058,
   "key": "D1108le.txt:81",
   "file": "D1108le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "果たしてデモンベインを失った俺たちに、勝ち目はあるのか？",
   "ko_candidate": "과연 데몬베인을 잃은 우리에게 승산이 있을까?"
  },
  {
   "id": 25059,
   "key": "D1108le.txt:83",
   "file": "D1108le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――何とかなる。",
   "ko_candidate": "――어떻게든 되겠지｡"
  },
  {
   "id": 25060,
   "key": "D1108le.txt:84",
   "file": "D1108le.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は自分に言い聞かせた。",
   "ko_candidate": "나는 스스로에게 다짐했다｡"
  },
  {
   "id": 25061,
   "key": "D1108le.txt:86",
   "file": "D1108le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦いは独りで背負い込むものじゃない。自分でさんざん繰り返した言葉だ。",
   "ko_candidate": "싸움은 혼자서 짊어지는 게 아니야｡ 내가 수없이 되풀이한"
  },
  {
   "id": 25062,
   "key": "D1108le.txt:88",
   "file": "D1108le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そう。俺にはライカさんが、メタトロンがついている。",
   "ko_candidate": "말이다｡ 그래｡ 나에겐 라이카 씨가､ 메타트론이 있어｡"
  },
  {
   "id": 25063,
   "key": "D1108le.txt:90",
   "file": "D1108le.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "姫さんたち、覇道財閥だって、この程度で観念するほど往生際が良いはずがない。",
   "ko_candidate": "공주님들､ 하도 재벌도 이 정도로 포기할 만큼 체념이 빠를 리가 없어｡"
  },
  {
   "id": 25064,
   "key": "D1108le.txt:92",
   "file": "D1108le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "未だ目を覚まさないとはいえ、アルもまだ健在だ。",
   "ko_candidate": "아직 깨어나지 않았다고는 해도､ 알도 여전히 건재하다｡"
  },
  {
   "id": 25065,
   "key": "D1108le.txt:93",
   "file": "D1108le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺自身は依然、マギウスとしての力を失ってはいない。",
   "ko_candidate": "나 자신은 여전히 마기우스로서의 힘을 잃지 않았어｡"
  },
  {
   "id": 25066,
   "key": "D1108le.txt:95",
   "file": "D1108le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "諦めるには、全然早すぎる。",
   "ko_candidate": "포기하기엔 아직 너무 이르다｡"
  },
  {
   "id": 25067,
   "key": "D1108le.txt:96",
   "file": "D1108le.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クトゥルーだか海神様だか知ったこっちゃあない。",
   "ko_candidate": "크툴루든 해신님이든 상관없어｡"
  },
  {
   "id": 25068,
   "key": "D1108le.txt:97",
   "file": "D1108le.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人間の強さってのを思い知らせてやる。",
   "ko_candidate": "인간의 강함이란 걸 똑똑히 보여주겠어｡"
  },
  {
   "id": 25069,
   "key": "D1108le.txt:99",
   "file": "D1108le.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……さて、アルの様子でも見に行くかな。",
   "ko_candidate": "…자､ 알의 상태나 보러 갈까｡"
  },
  {
   "id": 25070,
   "key": "D1108le.txt:100",
   "file": "D1108le.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう思って、避難所を後にしようとしたときだ。",
   "ko_candidate": "그렇게 생각하고 대피소를 나서려던 찰나였다｡"
  },
  {
   "id": 25071,
   "key": "D1108le.txt:104",
   "file": "D1108le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いきなりのギター演奏が、耳を劈いたのは。",
   "ko_candidate": "갑작스러운 기타 연주가 귀를 찢을 듯이 울려 퍼졌다｡"
  },
  {
   "id": 25072,
   "key": "D1108le.txt:105",
   "file": "D1108le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "こ、このパターンは……",
   "ko_candidate": "이､ 이 패턴은…"
  },
  {
   "id": 25073,
   "key": "D1108le.txt:110",
   "file": "D1108le.txt",
   "line": 110,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きっとあの人は来てくれるー！ あたしの愛しい人ー♪」 「きっと大きくっ、強くなって帰ってくるぅぅぅぅ！　あたしのダーリンっ♪」",
   "ko_candidate": "「분명 그 사람은 와줄 거야-! 내가 사랑하는 사람-♪ 분명 크고､ 강해져서 돌아올 거야아아아! 내 달링♪ 내게로 돌아온다면 이제 절대로 놓치지 않을 거야-!」"
  },
  {
   "id": 25074,
   "key": "D1108le.txt:117",
   "file": "D1108le.txt",
   "line": 117,
   "speaker": "ウェスト / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あたしのところに帰ってきたらっ、もうっ決して離しはしないっちゃー！」 「なっ……お前……！」",
   "ko_candidate": "「뭐… 너…!」"
  },
  {
   "id": 25075,
   "key": "D1108le.txt:127",
   "file": "D1108le.txt",
   "line": 127,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あっ、へんたい、だ」",
   "ko_candidate": "「아､ 변태､ 다」"
  },
  {
   "id": 25076,
   "key": "D1108le.txt:135",
   "file": "D1108le.txt",
   "line": 135,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「へ、へ、変態ッ!?」",
   "ko_candidate": "「변､ 변､ 변태!?」"
  },
  {
   "id": 25077,
   "key": "D1108le.txt:138",
   "file": "D1108le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "出鼻を挫かれた模様。",
   "ko_candidate": "기선을 제압당한 모양이다｡"
  }
 ]
}