 },
 "items": [
  {
   "id": 14862,
   "key": "D0809al.txt:2295",
   "file": "D0809al.txt",
   "line": 2295,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「チィッ！ キレるとすぐこれだ……」",
   "ko_candidate": "「치잇! 화나면 바로 이거야……」"
  },
  {
   "id": 14863,
   "key": "D0809al.txt:2300",
   "file": "D0809al.txt",
   "line": 2300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつの間にか、空に逃れていたクラウディウスが毒づいた。",
   "ko_candidate": "어느새 하늘로 도망쳐 있던 클라우디우스가 욕설을 내뱉었다｡"
  },
  {
   "id": 14864,
   "key": "D0809al.txt:2301",
   "file": "D0809al.txt",
   "line": 2301,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがすぐにその表情に、邪悪な笑みが浮かぶ。",
   "ko_candidate": "하지만 곧 그 표정에 사악한 미소가 떠오른다｡"
  },
  {
   "id": 14865,
   "key": "D0809al.txt:2306",
   "file": "D0809al.txt",
   "line": 2306,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まあ、良いさ……大十字九郎！」",
   "ko_candidate": "「뭐､ 좋아……다이쥬지 쿠로!」"
  },
  {
   "id": 14866,
   "key": "D0809al.txt:2311",
   "file": "D0809al.txt",
   "line": 2311,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 14867,
   "key": "D0809al.txt:2313",
   "file": "D0809al.txt",
   "line": 2313,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが俺を睨みつけ、叫ぶ。",
   "ko_candidate": "클라우디우스가 나를 노려보며 외친다｡"
  },
  {
   "id": 14868,
   "key": "D0809al.txt:2314",
   "file": "D0809al.txt",
   "line": 2314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少年の周りで、瘴気を孕んだ風が、唸りを上げていた。",
   "ko_candidate": "소년의 주위로 독기를 품은 바람이 으르렁거리고 있었다｡"
  },
  {
   "id": 14869,
   "key": "D0809al.txt:2319",
   "file": "D0809al.txt",
   "line": 2319,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今のカリグラは見境が無くなってる……さっさとしねえと、街が根こそぎ踏み潰されちまうぜ？　ヒャーハッハッハッハッ！」",
   "ko_candidate": "「지금의 칼리굴라는 분별력을 잃었어……빨리 죽이지 않으면 거리가 뿌리째 짓밟혀버릴 거야? 히야하하하하!」"
  },
  {
   "id": 14870,
   "key": "D0809al.txt:2324",
   "file": "D0809al.txt",
   "line": 2324,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てめえッ！」",
   "ko_candidate": "「이 자식!」"
  },
  {
   "id": 14871,
   "key": "D0809al.txt:2329",
   "file": "D0809al.txt",
   "line": 2329,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イア！　イア！　ハスター！ ハスター　クフアヤク　ブルグトム　ブグトラグルン　ブルグトム……」 「アイ！　アイ！　ハスタァァァァ――――！」",
   "ko_candidate": "「이야! 이야! 하스터! 하스터 크프아야크 부르그틈 부그트라그릉 부르그틈…… 아이! 아이! 하스터어어어어!」"
  },
  {
   "id": 14872,
   "key": "D0809al.txt:2345",
   "file": "D0809al.txt",
   "line": 2345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが纏う瘴気の風が、一気に膨れ上がった。",
   "ko_candidate": "클라우디우스를 감싼 독기의 바람이 단숨에 부풀어 올랐다｡"
  },
  {
   "id": 14873,
   "key": "D0809al.txt:2346",
   "file": "D0809al.txt",
   "line": 2346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い風は巨大な竜巻となり、周囲のビルをミキサーのように噛み砕く。",
   "ko_candidate": "검은 바람은 거대한 회오리가 되어 주변의 빌딩을 믹서처럼 갈아버린다｡"
  },
  {
   "id": 14874,
   "key": "D0809al.txt:2352",
   "file": "D0809al.txt",
   "line": 2352,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ロードビヤーキー！」",
   "ko_candidate": "「로드 비야키!」"
  },
  {
   "id": 14875,
   "key": "D0809al.txt:2361",
   "file": "D0809al.txt",
   "line": 2361,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜巻の中で雷光が輝いた。",
   "ko_candidate": "회오리 속에서 번개가 빛났다｡"
  },
  {
   "id": 14876,
   "key": "D0809al.txt:2370",
   "file": "D0809al.txt",
   "line": 2370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その光に照らされ、デウス・マキナのシルエットが浮かび上がる――！",
   "ko_candidate": "그 빛에 비추어 데우스 마키나의 실루엣이 떠오른다――!"
  },
  {
   "id": 14877,
   "key": "D0809al.txt:2372",
   "file": "D0809al.txt",
   "line": 2372,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜巻は真空刃を、全方位に飛ばしながら吹き飛んだ。",
   "ko_candidate": "회오리는 진공 칼날을 사방으로 날리며 날아갔다｡"
  },
  {
   "id": 14878,
   "key": "D0809al.txt:2373",
   "file": "D0809al.txt",
   "line": 2373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "細身の、鳥のようなヒトのような姿のデウス・マキナが顕現する。",
   "ko_candidate": "날씬한､ 새와 같은 사람과 같은 모습의 데우스 마키나가 현현한다｡"
  },
  {
   "id": 14879,
   "key": "D0809al.txt:2378",
   "file": "D0809al.txt",
   "line": 2378,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「デウス・マキナが２体……！」",
   "ko_candidate": "「데우스 마키나가 2체……!」"
  },
  {
   "id": 14880,
   "key": "D0809al.txt:2383",
   "file": "D0809al.txt",
   "line": 2383,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……洒落になんねえな、おい」",
   "ko_candidate": "「……농담이 아니군､ 이봐」"
  },
  {
   "id": 14881,
   "key": "D0809al.txt:2386",
   "file": "D0809al.txt",
   "line": 2386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両腕を下ろすと、手に持った二挺魔銃が、光になって霧散した。",
   "ko_candidate": "양팔을 내리자 손에 들고 있던 두 자루의 마총이 빛이 되어 흩어졌다｡"
  },
  {
   "id": 14882,
   "key": "D0809al.txt:2387",
   "file": "D0809al.txt",
   "line": 2387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が両手の甲に吸い込まれていく。",
   "ko_candidate": "빛이 양손 등으로 빨려 들어간다｡"
  },
  {
   "id": 14883,
   "key": "D0809al.txt:2388",
   "file": "D0809al.txt",
   "line": 2388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この魔銃……クトゥグア、イタクァと関係があるのだろうか？",
   "ko_candidate": "이 마총……크투가､ 이타콰와 관계가 있는 걸까?"
  },
  {
   "id": 14884,
   "key": "D0809al.txt:2390",
   "file": "D0809al.txt",
   "line": 2390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、それは今、考えても仕方ないことだ。",
   "ko_candidate": "아니､ 그건 지금 생각해봐야 소용없는 일이다｡"
  },
  {
   "id": 14885,
   "key": "D0809al.txt:2399",
   "file": "D0809al.txt",
   "line": 2399,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「デウス・マキナ２体を敵には回せん……逃げるぞ！」",
   "ko_candidate": "「데우스 마키나 2체를 적으로 상대할 순 없어……도망치자!」"
  },
  {
   "id": 14886,
   "key": "D0809al.txt:2404",
   "file": "D0809al.txt",
   "line": 2404,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いや……デモンベインを喚ぶ」",
   "ko_candidate": "「아니……데몬베인을 부른다」"
  },
  {
   "id": 14887,
   "key": "D0809al.txt:2409",
   "file": "D0809al.txt",
   "line": 2409,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎!?」",
   "ko_candidate": "「쿠로!?」"
  },
  {
   "id": 14888,
   "key": "D0809al.txt:2413",
   "file": "D0809al.txt",
   "line": 2413,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルが驚愕の声を上げた。",
   "ko_candidate": "알이 경악의 목소리를 냈다｡"
  },
  {
   "id": 14889,
   "key": "D0809al.txt:2414",
   "file": "D0809al.txt",
   "line": 2414,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は２体のデウス・マキナを睨みつける。",
   "ko_candidate": "나는 2체의 데우스 마키나를 노려본다｡"
  },
  {
   "id": 14890,
   "key": "D0809al.txt:2416",
   "file": "D0809al.txt",
   "line": 2416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "陰湿で強大な邪気が機体から発せられていた。",
   "ko_candidate": "음습하고 강대한 사기가 기체에서 뿜어져 나오고 있었다｡"
  },
  {
   "id": 14891,
   "key": "D0809al.txt:2417",
   "file": "D0809al.txt",
   "line": 2417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭の中が、怒りに灼けつく。",
   "ko_candidate": "머릿속이 분노로 타오른다｡"
  },
  {
   "id": 14892,
   "key": "D0809al.txt:2419",
   "file": "D0809al.txt",
   "line": 2419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思い出されるのは――理不尽に殺された、一般人たち。",
   "ko_candidate": "떠오르는 것은――이유 없이 살해당한 일반인들｡"
  },
  {
   "id": 14893,
   "key": "D0809al.txt:2422",
   "file": "D0809al.txt",
   "line": 2422,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「奴らは絶対許さねえ……！」",
   "ko_candidate": "「저놈들은 절대 용서 못 해……!」"
  },
  {
   "id": 14894,
   "key": "D0809al.txt:2427",
   "file": "D0809al.txt",
   "line": 2427,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「無謀だ！」",
   "ko_candidate": "「무모해!」"
  },
  {
   "id": 14895,
   "key": "D0809al.txt:2432",
   "file": "D0809al.txt",
   "line": 2432,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それだけじゃない。今の奴らを放っておいたら、何をしでかすか分かんねえぜ……！」",
   "ko_candidate": "「그것뿐만이 아니야｡ 지금의 저놈들을 내버려두면 무슨 짓을 저지를지 모른다고……!」"
  },
  {
   "id": 14896,
   "key": "D0809al.txt:2437",
   "file": "D0809al.txt",
   "line": 2437,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……」",
   "ko_candidate": "「큿……」"
  },
  {
   "id": 14897,
   "key": "D0809al.txt:2441",
   "file": "D0809al.txt",
   "line": 2441,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは歯噛みした。",
   "ko_candidate": "알은 이를 갈았다｡"
  },
  {
   "id": 14898,
   "key": "D0809al.txt:2442",
   "file": "D0809al.txt",
   "line": 2442,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苦々しい声で、訊いてくる。",
   "ko_candidate": "쓴 목소리로 물어온다｡"
  },
  {
   "id": 14899,
   "key": "D0809al.txt:2447",
   "file": "D0809al.txt",
   "line": 2447,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「戦力差は圧倒的だぞ……」",
   "ko_candidate": "「전력 차이는 압도적이야……」"
  },
  {
   "id": 14900,
   "key": "D0809al.txt:2452",
   "file": "D0809al.txt",
   "line": 2452,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やるしかない」",
   "ko_candidate": "「할 수밖에 없어」"
  },
  {
   "id": 14901,
   "key": "D0809al.txt:2457",
   "file": "D0809al.txt",
   "line": 2457,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……やれやれ」",
   "ko_candidate": "「……참나」"
  }
 ]
}