 "items": [
  {
   "id": 27765,
   "key": "D1206al.txt:212",
   "file": "D1206al.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――曲がれ。",
   "ko_candidate": "――휘어져라｡"
  },
  {
   "id": 27766,
   "key": "D1206al.txt:224",
   "file": "D1206al.txt",
   "line": 224,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「かっ……はっ……！」",
   "ko_candidate": "「캑… 핫…!」"
  },
  {
   "id": 27767,
   "key": "D1206al.txt:227",
   "file": "D1206al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの背中から右脇腹を、イタクァの弾丸が貫通した。",
   "ko_candidate": "클라우디우스의 등에서 오른쪽 옆구리를 이타콰의 탄환이 관통했다｡"
  },
  {
   "id": 27768,
   "key": "D1206al.txt:228",
   "file": "D1206al.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……心臓を狙いたかったが、今の俺ではこれくらいのコントロール、しかも１発の弾丸を操るのが精一杯だ。",
   "ko_candidate": "…심장을 노리고 싶었지만 지금의 나로서는 이 정도의 컨트롤､ 게다가 1발의 탄환을 조종하는 것이 정말 힘들다｡"
  },
  {
   "id": 27769,
   "key": "D1206al.txt:230",
   "file": "D1206al.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それでも重傷には違いない。",
   "ko_candidate": "그래도 중상임에는 틀림없다｡"
  },
  {
   "id": 27770,
   "key": "D1206al.txt:237",
   "file": "D1206al.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスは血を吐いて、その場に倒れた。",
   "ko_candidate": "클라우디우스는 피를 토하며 그 자리에 쓰러졌다｡"
  },
  {
   "id": 27771,
   "key": "D1206al.txt:242",
   "file": "D1206al.txt",
   "line": 242,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぶっは……っ！　糞ッ……！」",
   "ko_candidate": "「으부욱… 악! 젠장…!」"
  },
  {
   "id": 27772,
   "key": "D1206al.txt:245",
   "file": "D1206al.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺はのたうつクラウディウスの頭に、 クトゥグアを向ける。",
   "ko_candidate": "나는 몸부림치는 클라우디우스의 머리에 크투가를 겨눈다｡"
  },
  {
   "id": 27773,
   "key": "D1206al.txt:247",
   "file": "D1206al.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザもまた魔砲を向ける。",
   "ko_candidate": "엘자도 마포를 겨눈다｡"
  },
  {
   "id": 27774,
   "key": "D1206al.txt:249",
   "file": "D1206al.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――ガキだからと言って一片の同情もしない。",
   "ko_candidate": "――애송이라고 해서 일말의 동정도 하지 않는다｡"
  },
  {
   "id": 27775,
   "key": "D1206al.txt:250",
   "file": "D1206al.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術師相手に、そんな自惚れは決して持ち合わせない。",
   "ko_candidate": "마술사를 상대로 그런 자만은 절대 품지 않는다｡"
  },
  {
   "id": 27776,
   "key": "D1206al.txt:251",
   "file": "D1206al.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そもそも、こいつらがアルを……！",
   "ko_candidate": "애초에 이놈들이 알을…!"
  },
  {
   "id": 27777,
   "key": "D1206al.txt:256",
   "file": "D1206al.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――殺してやる。",
   "ko_candidate": "――죽여주마｡"
  },
  {
   "id": 27778,
   "key": "D1206al.txt:258",
   "file": "D1206al.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "膨れ上がる殺意は、クトゥグアに凝縮された。",
   "ko_candidate": "부풀어 오르는 살의는 크투가에 응축되었다｡"
  },
  {
   "id": 27779,
   "key": "D1206al.txt:259",
   "file": "D1206al.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、この場で確実に仕留める。",
   "ko_candidate": "지금､ 이 자리에서 확실히 처치한다｡"
  },
  {
   "id": 27780,
   "key": "D1206al.txt:261",
   "file": "D1206al.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は引鉄に力を込めた。",
   "ko_candidate": "나는 방아쇠에 힘을 실었다｡"
  },
  {
   "id": 27781,
   "key": "D1206al.txt:264",
   "file": "D1206al.txt",
   "line": 264,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――終わりだっ！」",
   "ko_candidate": "「――끝이다!」"
  },
  {
   "id": 27782,
   "key": "D1206al.txt:268",
   "file": "D1206al.txt",
   "line": 268,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シィィィィットッッッッ！」",
   "ko_candidate": "「시이이이이잇!」"
  },
  {
   "id": 27783,
   "key": "D1206al.txt:278",
   "file": "D1206al.txt",
   "line": 278,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「っ!?　うわああっと!?」",
   "ko_candidate": "「윽!? 우와아아악!?」"
  },
  {
   "id": 27784,
   "key": "D1206al.txt:282",
   "file": "D1206al.txt",
   "line": 282,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボぉぉぉぉぉぉっ!?」",
   "ko_candidate": "「로보오오오오오옷!?」"
  },
  {
   "id": 27785,
   "key": "D1206al.txt:294",
   "file": "D1206al.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が爆ぜた。",
   "ko_candidate": "바람이 폭발했다｡"
  },
  {
   "id": 27786,
   "key": "D1206al.txt:295",
   "file": "D1206al.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺達の身体は舞い上げられ、１０メートル以上後ろに飛ばされる。",
   "ko_candidate": "우리의 몸은 휘날려 10미터 이상 뒤로 날아갔다｡"
  },
  {
   "id": 27787,
   "key": "D1206al.txt:299",
   "file": "D1206al.txt",
   "line": 299,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐがっ！　かあぁぁっ！」",
   "ko_candidate": "「으갓! 카아아악!」"
  },
  {
   "id": 27788,
   "key": "D1206al.txt:303",
   "file": "D1206al.txt",
   "line": 303,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボっっ!? い、痛いロボ～～～～」",
   "ko_candidate": "「로봇!? 아､ 아파 로봇~~~~~」"
  },
  {
   "id": 27789,
   "key": "D1206al.txt:308",
   "file": "D1206al.txt",
   "line": 308,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「～～～～～ッ！　……くそったれ！」",
   "ko_candidate": "「~~~~~! …젠장!」"
  },
  {
   "id": 27790,
   "key": "D1206al.txt:312",
   "file": "D1206al.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "息が出来ないほど激しく背中を打ったが、それでも俺は身を起こした。",
   "ko_candidate": "숨을 쉴 수 없을 정도로 격렬하게 등을 부딪혔지만､ 그래도 나는 몸을 일으켰다｡"
  },
  {
   "id": 27791,
   "key": "D1206al.txt:318",
   "file": "D1206al.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線の先にクラウディウスはいない。",
   "ko_candidate": "시선 끝에 클라우디우스는 없다｡"
  },
  {
   "id": 27792,
   "key": "D1206al.txt:319",
   "file": "D1206al.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通路のずっと奥、風を纏って逃げるクラウディウスの背中が見えた。",
   "ko_candidate": "통로 저 멀리､ 바람을 두른 채 도망치는 클라우디우스의 등이 보였다｡"
  },
  {
   "id": 27793,
   "key": "D1206al.txt:319",
   "file": "D1206al.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クソッ！",
   "ko_candidate": "젠장!"
  },
  {
   "id": 27794,
   "key": "D1206al.txt:322",
   "file": "D1206al.txt",
   "line": 322,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「逃がすか！　往くぞ、エルザ！」",
   "ko_candidate": "「놓칠 순 없어! 가자､ 엘자!」"
  },
  {
   "id": 27795,
   "key": "D1206al.txt:326",
   "file": "D1206al.txt",
   "line": 326,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボ！」",
   "ko_candidate": "「로봇!」"
  },
  {
   "id": 27796,
   "key": "D1206le.txt:11",
   "file": "D1206le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が、弾けた。",
   "ko_candidate": "바람이 터졌다｡"
  },
  {
   "id": 27797,
   "key": "D1206le.txt:13",
   "file": "D1206le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "四散する風の刃が、身体を掠る。",
   "ko_candidate": "사방으로 흩어지는 바람의 칼날이 몸을 스친다｡"
  },
  {
   "id": 27798,
   "key": "D1206le.txt:14",
   "file": "D1206le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数に出来た裂傷から、血飛沫を上げる。",
   "ko_candidate": "무수히 생긴 열상에서 피가 튀어 오른다｡"
  },
  {
   "id": 27799,
   "key": "D1206le.txt:15",
   "file": "D1206le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋭く走る痛みを無理矢理に抑えつけ、無視する。",
   "ko_candidate": "날카롭게 달리는 통증을 억지로 억누르고 무시한다｡"
  },
  {
   "id": 27800,
   "key": "D1206le.txt:16",
   "file": "D1206le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識はあくまで、クラウディウスだけに向ける。",
   "ko_candidate": "의식은 어디까지나 클라우디우스에게만 향한다｡"
  },
  {
   "id": 27801,
   "key": "D1206le.txt:21",
   "file": "D1206le.txt",
   "line": 21,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 27802,
   "key": "D1206le.txt:24",
   "file": "D1206le.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "竜巻が砕け散り、凪となった空間の中心に、クラウディウスは呆然と立ち尽くす。時折、残留していた微風が渦を巻き、髪の毛を揺らす。",
   "ko_candidate": "회오리바람이 부서져 흩어지고 잔잔해진 공간의 중심에 클라우디우스가 멍하니 서 있다｡ 때때로 남아있던 미풍이 소용돌이치며 머리카락을 흔든다｡"
  },
  {
   "id": 27803,
   "key": "D1206le.txt:26",
   "file": "D1206le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけが、動くものの全てだった。",
   "ko_candidate": "그것만이 움직이는 것의 전부였다｡"
  },
  {
   "id": 27804,
   "key": "D1206le.txt:28",
   "file": "D1206le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの時間は、凍りついたみたいに動かない。",
   "ko_candidate": "클라우디우스의 시간은 얼어붙은 듯이 움직이지 않는다｡"
  }
 ]
}