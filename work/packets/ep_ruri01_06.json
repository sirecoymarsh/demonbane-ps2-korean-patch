 },
 "items": [
  {
   "id": 50378,
   "key": "ep_ruri01.txt:754",
   "file": "ep_ruri01.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "目も完全に見えなくなった。",
   "ko_candidate": "눈도 완전히 보이지 않게 되었다｡"
  },
  {
   "id": 50379,
   "key": "ep_ruri01.txt:755",
   "file": "ep_ruri01.txt",
   "line": 755,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "独りになる――死ぬってのは、こんなにも寂しいものなのか。",
   "ko_candidate": "혼자가 된다――죽는다는 건､ 이렇게나 외로운 것인가｡"
  },
  {
   "id": 50380,
   "key": "ep_ruri01.txt:757",
   "file": "ep_ruri01.txt",
   "line": 757,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ああ……嫌だ嫌だ……。",
   "ko_candidate": "아아… 싫어 싫어…"
  },
  {
   "id": 50381,
   "key": "ep_ruri01.txt:761",
   "file": "ep_ruri01.txt",
   "line": 761,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 50382,
   "key": "ep_ruri01.txt:764",
   "file": "ep_ruri01.txt",
   "line": 764,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ、最期に。",
   "ko_candidate": "다만､ 마지막으로｡"
  },
  {
   "id": 50383,
   "key": "ep_ruri01.txt:765",
   "file": "ep_ruri01.txt",
   "line": 765,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の死を看取るそいつが訊いてきた質問は、しっかりと耳に届いた。",
   "ko_candidate": "내 죽음을 지켜보는 그자가 물어온 질문은､ 확실히 귀에 들렸다｡"
  },
  {
   "id": 50384,
   "key": "ep_ruri01.txt:766",
   "file": "ep_ruri01.txt",
   "line": 766,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それが俺の意識をギリギリまで繋ぎ止める。",
   "ko_candidate": "그것이 내 의식을 간신히 붙들어 맨다｡"
  },
  {
   "id": 50385,
   "key": "ep_ruri01.txt:768",
   "file": "ep_ruri01.txt",
   "line": 768,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうだ……これは教えておかないと。",
   "ko_candidate": "그래… 이건 알려줘야 해｡"
  },
  {
   "id": 50386,
   "key": "ep_ruri01.txt:769",
   "file": "ep_ruri01.txt",
   "line": 769,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "誰も知られずに死ぬことに変わりなくなっちまう。",
   "ko_candidate": "아무도 모르게 죽는 것으로 변해버릴 테니까｡"
  },
  {
   "id": 50387,
   "key": "ep_ruri01.txt:770",
   "file": "ep_ruri01.txt",
   "line": 770,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "全力を振り絞って、何とか咽喉を震わせ、息も絶え絶えに声を出す。",
   "ko_candidate": "전력을 다해､ 어떻게든 목구멍을 떨며､ 숨도 가쁘게 소리를 낸다｡"
  },
  {
   "id": 50388,
   "key": "ep_ruri01.txt:772",
   "file": "ep_ruri01.txt",
   "line": 772,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の最期の言葉は、ちゃんとそいつの耳に届いただろうか？",
   "ko_candidate": "내 마지막 말은､ 제대로 그자의 귀에 닿았을까?"
  },
  {
   "id": 50389,
   "key": "ep_ruri01.txt:775",
   "file": "ep_ruri01.txt",
   "line": 775,
   "speaker": "鋼造",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「俺の名前は――――」",
   "ko_candidate": "「내 이름은――――」"
  },
  {
   "id": 50390,
   "key": "ep_ruri01.txt:780",
   "file": "ep_ruri01.txt",
   "line": 780,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "覇道　鋼造。",
   "ko_candidate": "하도 코조｡"
  },
  {
   "id": 50391,
   "key": "ep_ruri01.txt:786",
   "file": "ep_ruri01.txt",
   "line": 786,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――――――何だって？」",
   "ko_candidate": "「――――――――――뭐라고?」"
  },
  {
   "id": 50392,
   "key": "ep_ruri01.txt:797",
   "file": "ep_ruri01.txt",
   "line": 797,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「見えたか？　絡繰が」",
   "ko_candidate": "「보였나? 장치가」"
  },
  {
   "id": 50393,
   "key": "ep_ruri01.txt:801",
   "file": "ep_ruri01.txt",
   "line": 801,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……マスターテリオン」",
   "ko_candidate": "「……마스터 테리온」"
  },
  {
   "id": 50394,
   "key": "ep_ruri01.txt:806",
   "file": "ep_ruri01.txt",
   "line": 806,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "声に振り返る。",
   "ko_candidate": "소리에 뒤돌아본다｡"
  },
  {
   "id": 50395,
   "key": "ep_ruri01.txt:807",
   "file": "ep_ruri01.txt",
   "line": 807,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "宙に浮く紅の機体。その掌にマスターテリオンは立っている。",
   "ko_candidate": "공중에 떠 있는 붉은 기체｡ 그 손바닥 위에 마스터 테리온이 서 있다｡"
  },
  {
   "id": 50396,
   "key": "ep_ruri01.txt:808",
   "file": "ep_ruri01.txt",
   "line": 808,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "亀裂の笑みに頬を引き裂いて、澱む金色の眸を愉悦で歪ませて、俺を見下ろしている。",
   "ko_candidate": "균열의 미소로 뺨을 일그러뜨리고､ 탁한 금색 눈동자를 쾌락으로 일그러뜨리며､ 나를 내려다보고 있다｡"
  },
  {
   "id": 50397,
   "key": "ep_ruri01.txt:812",
   "file": "ep_ruri01.txt",
   "line": 812,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これが始まりだ。大十字九郎。 余は再び、貴公の前に現れる。 再び、あの『ブラックロッジ』を引き連れて」 「それまでに何をすれば良いか……貴公には解かる筈だ」",
   "ko_candidate": "「이것이 시작이다｡ 다이쥬지 쿠로｡ 나는 다시､ 그대 앞에 나타날 것이다｡ 다시､ 그 『블랙로지』를 이끌고서｡ 그때까지 무엇을 해야 할지… 그대는 알고 있을 터다」"
  },
  {
   "id": 50398,
   "key": "ep_ruri01.txt:820",
   "file": "ep_ruri01.txt",
   "line": 820,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "靄のような闇が、心の奥にわだかまり、重く圧し掛かる。",
   "ko_candidate": "안개 같은 어둠이､ 마음 속 깊이 응어리져､ 무겁게 짓누른다｡"
  },
  {
   "id": 50399,
   "key": "ep_ruri01.txt:821",
   "file": "ep_ruri01.txt",
   "line": 821,
   "speaker": "マスターテリオン",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "呆然と突っ立つ俺の姿に、マスターテリオンは哄笑する。 「あはははははは！　そうだ！ その貌だ！」",
   "ko_candidate": "멍하니 서 있는 내 모습에､ 마스터 테리온은 크게 웃는다｡"
  },
  {
   "id": 50400,
   "key": "ep_ruri01.txt:829",
   "file": "ep_ruri01.txt",
   "line": 829,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「少しずつ絶望に貪られてゆく貴公の姿が！　この永劫を生きる余の、唯一の糧なのだ！　さあ、今度も愉しませろよ！」 「今度の貴公は何処までやれるのか？　何処まで運命の裏をかけるのか？」",
   "ko_candidate": "「아하하하하하! 그래! 그 표정이다! 조금씩 절망에 잠식되어 가는 그대의 모습이! 이 영겁을 사는 나의､ 유일한 양식이라고! 자､ 이번에도 즐겁게 해 주어라! 이번의 그대는 어디까지 할 수 있을까? 어디까지 운명을 뒤집을 수 있을까? 『알 아지프』를 잃은 그대가! 도대체 어디까지 나에게 다가올 수 있을까!? 아하하하､ 이렇게 자극적인 유희는 없어!」"
  },
  {
   "id": 50401,
   "key": "ep_ruri01.txt:835",
   "file": "ep_ruri01.txt",
   "line": 835,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「『アル・アジフ』を失った貴公が！　いったい何処まで余に迫れるか!?」 「あははは、こんなに刺激的な遊戯は無い！」",
   "ko_candidate": "「……네 놈아아아아아아아아!」"
  },
  {
   "id": 50402,
   "key": "ep_ruri01.txt:842",
   "file": "ep_ruri01.txt",
   "line": 842,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……貴様アアアァァァァァァ！」 雄叫びを上げ、魔銃を招喚しようとする――",
   "ko_candidate": "포효를 지르며､ 마총을 소환하려 한다――"
  },
  {
   "id": 50403,
   "key": "ep_ruri01.txt:845",
   "file": "ep_ruri01.txt",
   "line": 845,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "が、マギウスになれない今の俺にその力は振るえない。",
   "ko_candidate": "하지만､ 마기우스가 되지 못하는 지금의 나에겐 그 힘을 발휘할 수 없다｡"
  },
  {
   "id": 50404,
   "key": "ep_ruri01.txt:846",
   "file": "ep_ruri01.txt",
   "line": 846,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空っぽの手が、虚しく突き出されるだけだ。",
   "ko_candidate": "텅 빈 손이､ 허무하게 내밀어질 뿐이다｡"
  },
  {
   "id": 50405,
   "key": "ep_ruri01.txt:850",
   "file": "ep_ruri01.txt",
   "line": 850,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははははは！　あははははははは！　あはははははははは！」",
   "ko_candidate": "「아하하하하하! 아하하하하하하! 아하하하하하하하!」"
  },
  {
   "id": 50406,
   "key": "ep_ruri01.txt:856",
   "file": "ep_ruri01.txt",
   "line": 856,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "リベル・レギスが光になる。",
   "ko_candidate": "리베르 레기스가 빛이 된다｡"
  },
  {
   "id": 50407,
   "key": "ep_ruri01.txt:857",
   "file": "ep_ruri01.txt",
   "line": 857,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光となって砕けてゆく。",
   "ko_candidate": "빛이 되어 부서져 간다｡"
  },
  {
   "id": 50408,
   "key": "ep_ruri01.txt:858",
   "file": "ep_ruri01.txt",
   "line": 858,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "砕けゆく光に、マスターテリオンの姿が消えてゆく。",
   "ko_candidate": "부서져 가는 빛 속에､ 마스터 테리온의 모습이 사라져 간다｡"
  },
  {
   "id": 50409,
   "key": "ep_ruri01.txt:860",
   "file": "ep_ruri01.txt",
   "line": 860,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――瞬間転移。",
   "ko_candidate": "――순간이동｡"
  },
  {
   "id": 50410,
   "key": "ep_ruri01.txt:866",
   "file": "ep_ruri01.txt",
   "line": 866,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「待ちやがれ！　ちくしょおぉぉぉぉぉぉぉぉぉ！」",
   "ko_candidate": "「기다려! 이 자식아아아아아아아아아!」"
  },
  {
   "id": 50411,
   "key": "ep_ruri01.txt:872",
   "file": "ep_ruri01.txt",
   "line": 872,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははははははははははははははははははははははははははははははははははは！」",
   "ko_candidate": "「아하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하!」"
  },
  {
   "id": 50412,
   "key": "ep_ruri01.txt:878",
   "file": "ep_ruri01.txt",
   "line": 878,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光は、掻き消す様に、消滅した。",
   "ko_candidate": "빛은､ 긁어 지우듯이､ 소멸했다｡"
  },
  {
   "id": 50413,
   "key": "ep_ruri01.txt:879",
   "file": "ep_ruri01.txt",
   "line": 879,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "哄笑だけを残して。",
   "ko_candidate": "폭소만을 남기고｡"
  },
  {
   "id": 50414,
   "key": "ep_ruri01.txt:881",
   "file": "ep_ruri01.txt",
   "line": 881,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺はその場に崩れ落ちるようにして、しゃがみ込んだ。",
   "ko_candidate": "나는 그 자리에 무너지듯 쪼그려 앉았다｡"
  },
  {
   "id": 50415,
   "key": "ep_ruri01.txt:882",
   "file": "ep_ruri01.txt",
   "line": 882,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "乾いた砂が舞う。",
   "ko_candidate": "마른 모래가 날린다｡"
  },
  {
   "id": 50416,
   "key": "ep_ruri01.txt:883",
   "file": "ep_ruri01.txt",
   "line": 883,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "途方に暮れて……無人の荒野を見渡した。",
   "ko_candidate": "어찌할 바를 모르고… 무인의 황야를 둘러보았다｡"
  },
  {
   "id": 50417,
   "key": "ep_ruri01.txt:887",
   "file": "ep_ruri01.txt",
   "line": 887,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……姫さん」",
   "ko_candidate": "「……공주님」"
  }
 ]
}