 "items": [
  {
   "id": 16682,
   "key": "D0814le.txt:178",
   "file": "D0814le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "渾身の威力で拳を振るう。",
   "ko_candidate": "혼신의 위력으로 주먹을 휘두른다｡"
  },
  {
   "id": 16683,
   "key": "D0814le.txt:185",
   "file": "D0814le.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし拳は敵を捉えることなく、空を切った。",
   "ko_candidate": "하지만 주먹은 적을 포착하지 못하고､ 허공을 갈랐다｡"
  },
  {
   "id": 16684,
   "key": "D0814le.txt:187",
   "file": "D0814le.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バーニアの炎が闇を灼く。突風が吹いた。",
   "ko_candidate": "버니어의 불꽃이 어둠을 태운다｡ 돌풍이 불었다｡"
  },
  {
   "id": 16685,
   "key": "D0814le.txt:197",
   "file": "D0814le.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーが上空へと舞い上がる。",
   "ko_candidate": "로드 비야키가 상공으로 날아오른다｡"
  },
  {
   "id": 16686,
   "key": "D0814le.txt:204",
   "file": "D0814le.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして空中で停止。",
   "ko_candidate": "그리고 공중에서 정지｡"
  },
  {
   "id": 16687,
   "key": "D0814le.txt:206",
   "file": "D0814le.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつ……空を飛べるのか!?",
   "ko_candidate": "이놈…… 하늘을 날 수 있는 건가!?"
  },
  {
   "id": 16688,
   "key": "D0814le.txt:211",
   "file": "D0814le.txt",
   "line": 211,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヒャーハッハッハッ！」",
   "ko_candidate": "「히야하하하하!」"
  },
  {
   "id": 16689,
   "key": "D0814le.txt:221",
   "file": "D0814le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空のロードビヤーキーがライフルを取り出す。",
   "ko_candidate": "상공의 로드 비야키가 라이플을 꺼낸다｡"
  },
  {
   "id": 16690,
   "key": "D0814le.txt:223",
   "file": "D0814le.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眼下のデモンベインに標準を合わせて、発砲。",
   "ko_candidate": "눈 아래의 데몬베인에 조준을 맞추고､ 발포｡"
  },
  {
   "id": 16691,
   "key": "D0814le.txt:227",
   "file": "D0814le.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "降り注ぐエネルギー弾の雨。",
   "ko_candidate": "쏟아지는 에너지탄의 비｡"
  },
  {
   "id": 16692,
   "key": "D0814le.txt:230",
   "file": "D0814le.txt",
   "line": 230,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「チィィィッ！」",
   "ko_candidate": "「치이이이잇!」"
  },
  {
   "id": 16693,
   "key": "D0814le.txt:233",
   "file": "D0814le.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚部シールドを連続開放。",
   "ko_candidate": "다리 부분 실드를 연속 개방｡"
  },
  {
   "id": 16694,
   "key": "D0814le.txt:239",
   "file": "D0814le.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾雨を掻い潜って跳ぶ。着地ざまに跳ぶ。",
   "ko_candidate": "탄우를 뚫고 뛴다｡ 착지하자마자 뛴다｡"
  },
  {
   "id": 16695,
   "key": "D0814le.txt:241",
   "file": "D0814le.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳ぶ。跳ぶ。跳ぶ。",
   "ko_candidate": "뛴다｡ 뛴다｡ 뛴다｡"
  },
  {
   "id": 16696,
   "key": "D0814le.txt:243",
   "file": "D0814le.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エネルギー弾によって地面が爆ぜ、時空歪曲によって紫電が疾る。",
   "ko_candidate": "에너지탄에 의해 지면이 터지고､ 시공 왜곡에 의해 자색 번개가 달린다｡"
  },
  {
   "id": 16697,
   "key": "D0814le.txt:246",
   "file": "D0814le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛行能力の無いデモンベインでは、上空の敵は鬼門だ。",
   "ko_candidate": "비행 능력이 없는 데몬베인에게는､ 상공의 적은 귀문이다｡"
  },
  {
   "id": 16698,
   "key": "D0814le.txt:247",
   "file": "D0814le.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げ回るより他ない。",
   "ko_candidate": "도망치는 것 말고는 방법이 없다｡"
  },
  {
   "id": 16699,
   "key": "D0814le.txt:252",
   "file": "D0814le.txt",
   "line": 252,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ウルアアアアアア！　ミンチだァァァァァァ！」",
   "ko_candidate": "「우루아아아아아아! 다져버리겠다아아아아아아!」"
  },
  {
   "id": 16700,
   "key": "D0814le.txt:257",
   "file": "D0814le.txt",
   "line": 257,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「っ!?」",
   "ko_candidate": "「읏!?」"
  },
  {
   "id": 16701,
   "key": "D0814le.txt:260",
   "file": "D0814le.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラーケンの突き出した両腕が蛇のようにうねり伸びる。",
   "ko_candidate": "크라켄의 뻗은 양팔이 뱀처럼 꿈틀거리며 늘어난다｡"
  },
  {
   "id": 16702,
   "key": "D0814le.txt:267",
   "file": "D0814le.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の爪で武装された鋼鉄の手が、大気を裂いて飛ぶ。",
   "ko_candidate": "강철 발톱으로 무장된 강철 손이､ 대기를 가르며 날아온다｡"
  },
  {
   "id": 16703,
   "key": "D0814le.txt:269",
   "file": "D0814le.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クローは喩えるならば大蛇の牙。",
   "ko_candidate": "클로는 비유하자면 큰 뱀의 이빨｡"
  },
  {
   "id": 16704,
   "key": "D0814le.txt:270",
   "file": "D0814le.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを噛み砕こうと迫り来る。",
   "ko_candidate": "데몬베인을 물어뜯으려 다가온다｡"
  },
  {
   "id": 16705,
   "key": "D0814le.txt:272",
   "file": "D0814le.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それをかわしても、伸びた腕、大蛇の胴体がデモンベインを捕らえ、締め潰すべく、しつこく纏わる。",
   "ko_candidate": "그것을 피해도､ 늘어난 팔､ 큰 뱀의 몸통이 데몬베인을 붙잡고､ 짓눌러 부수려고､ 끈질기게 달라붙는다｡"
  },
  {
   "id": 16706,
   "key": "D0814le.txt:275",
   "file": "D0814le.txt",
   "line": 275,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「邪魔だ！　ブッタ斬ってやる！　バルザイの偃月刀！」",
   "ko_candidate": "「방해돼! 베어버리겠어! 바르자이의 언월도!」"
  },
  {
   "id": 16707,
   "key": "D0814le.txt:277",
   "file": "D0814le.txt",
   "line": 277,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、何も反応が無い。",
   "ko_candidate": "하지만､ 아무런 반응이 없다｡"
  },
  {
   "id": 16708,
   "key": "D0814le.txt:278",
   "file": "D0814le.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これは……",
   "ko_candidate": "이건……"
  },
  {
   "id": 16709,
   "key": "D0814le.txt:286",
   "file": "D0814le.txt",
   "line": 286,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うつけ！　街での戦いのとき、破壊されてしまったろうに！」 「魔導器の偃月刀を失えば、デモンベインも武装を失う！」",
   "ko_candidate": "「멍청아! 거리에서 싸울 때､ 파괴되어 버렸잖느냐! 마도기의 언월도를 잃으면､ 데몬베인도 무장을 잃는다!」"
  },
  {
   "id": 16710,
   "key": "D0814le.txt:293",
   "file": "D0814le.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……しまった。",
   "ko_candidate": "……제기랄｡"
  },
  {
   "id": 16711,
   "key": "D0814le.txt:294",
   "file": "D0814le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そいつは誤算だった。",
   "ko_candidate": "그건 오산이었다｡"
  },
  {
   "id": 16712,
   "key": "D0814le.txt:303",
   "file": "D0814le.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーのライフル射撃と、クラーケンの大蛇攻撃。",
   "ko_candidate": "로드 비야키의 라이플 사격과､ 크라켄의 큰 뱀 공격｡"
  },
  {
   "id": 16713,
   "key": "D0814le.txt:305",
   "file": "D0814le.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これがなかなかに絶妙なコンビネーションだ。",
   "ko_candidate": "이게 꽤나 절묘한 콤비네이션이다｡"
  },
  {
   "id": 16714,
   "key": "D0814le.txt:307",
   "file": "D0814le.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エネルギー弾の爆撃によって、クラーケンの攻撃の軌道に誘導されたり、エネルギー弾から逃れる道をクラーケンの腕に阻まれたりもする。",
   "ko_candidate": "에너지탄의 폭격으로 인해､ 크라켄의 공격 궤도로 유도되거나､ 에너지탄에서 벗어날 길을 크라켄의 팔에 막히기도 한다｡"
  },
  {
   "id": 16715,
   "key": "D0814le.txt:309",
   "file": "D0814le.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こうやって、徐々に徐々に行動範囲を狭められているのだ。",
   "ko_candidate": "이렇게､ 서서히 서서히 행동 범위를 좁혀지고 있는 거다｡"
  },
  {
   "id": 16716,
   "key": "D0814le.txt:311",
   "file": "D0814le.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……かなりマズイ状況だ。",
   "ko_candidate": "……상당히 좋지 않은 상황이다｡"
  },
  {
   "id": 16717,
   "key": "D0814le.txt:312",
   "file": "D0814le.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちぃぃっ、少しばかし面倒なことになってきやがったぜ……！",
   "ko_candidate": "치이이잇､ 조금 귀찮은 일이 되어버렸군……!"
  },
  {
   "id": 16718,
   "key": "D0814ru.txt:8",
   "file": "D0814ru.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処は祭壇にして玉座。",
   "ko_candidate": "여기는 제단이자 옥좌｡"
  },
  {
   "id": 16719,
   "key": "D0814ru.txt:16",
   "file": "D0814ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄暗闇を照らすのは松明の灯り。",
   "ko_candidate": "어스름한 어둠을 밝히는 것은 횃불의 불빛｡"
  },
  {
   "id": 16720,
   "key": "D0814ru.txt:18",
   "file": "D0814ru.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衰えることなく燃え盛るその聖火の中に時折、何か異形の存在の影を垣間見るのは、それは果たして錯覚なのだろうか。",
   "ko_candidate": "쇠약함 없이 타오르는 그 성화 속에서 때때로 무언가 기괴한 존재의 그림자를 엿보는 것은､ 과연 착각일까｡"
  },
  {
   "id": 16721,
   "key": "D0814ru.txt:20",
   "file": "D0814ru.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "玉座に座りながらエセルドレーダを愛でるマスターテリオンの前に、『ブラックロッジ』の重鎮、アンチクロスの面々が並ぶ。",
   "ko_candidate": "옥좌에 앉아 에셀드레다를 애무하는 마스터 테리온 앞에､ 『블랙로지』의 중진､ 안티 크로스의 면면이 늘어서 있다｡"
  }
 ]
}