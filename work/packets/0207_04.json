 },
 "items": [
  {
   "id": 2448,
   "key": "D0207.txt:1230",
   "file": "D0207.txt",
   "line": 1230,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「!?　――否！　まだだ！」",
   "ko_candidate": "「!? …아니! 아직이다!」"
  },
  {
   "id": 2449,
   "key": "D0207.txt:1235",
   "file": "D0207.txt",
   "line": 1235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆発が止んだとき、俺はとんでもないものを見た。",
   "ko_candidate": "폭발과 섬광이 멎었을 때､ 나는 엄청난 것을 보았다｡"
  },
  {
   "id": 2450,
   "key": "D0207.txt:1250",
   "file": "D0207.txt",
   "line": 1250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインの拳を受け止める、巨大な掌――。",
   "ko_candidate": "데몬베인의 주먹을 받아내는 거대한 손바닥…"
  },
  {
   "id": 2451,
   "key": "D0207.txt:1253",
   "file": "D0207.txt",
   "line": 1253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何も無い空間に、巨大な腕がただ一本だけ存在して",
   "ko_candidate": "아무것도 없는 공간에 강철의 팔이 단 하나､ 존재하고 있었다｡"
  },
  {
   "id": 2452,
   "key": "D0207.txt:1254",
   "file": "D0207.txt",
   "line": 1254,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いた。腕を鎧う刃金は血の彩よりも生々しく、紅い。",
   "ko_candidate": "팔을 감싸는 칼날은 석양보다도 붉다｡"
  },
  {
   "id": 2453,
   "key": "D0207.txt:1259",
   "file": "D0207.txt",
   "line": 1259,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「な……何だ、これ……」",
   "ko_candidate": "「뭐……뭐야､ 이거……」"
  },
  {
   "id": 2454,
   "key": "D0207.txt:1262",
   "file": "D0207.txt",
   "line": 1262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鋼鉄の掌に護られて、マスターテリオンは嗤う。",
   "ko_candidate": "강철의 손바닥에 보호받으며､ 마스터 테리온은 비웃는다｡"
  },
  {
   "id": 2455,
   "key": "D0207.txt:1263",
   "file": "D0207.txt",
   "line": 1263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その前方に、小さな闇。",
   "ko_candidate": "그 앞에､ 작은 어둠｡"
  },
  {
   "id": 2456,
   "key": "D0207.txt:1265",
   "file": "D0207.txt",
   "line": 1265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "否。",
   "ko_candidate": "아니｡"
  },
  {
   "id": 2457,
   "key": "D0207.txt:1272",
   "file": "D0207.txt",
   "line": 1272,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――見事だ。よくぞ余に魔導書を使わせた！　紹介しよう…… 我が魔導書『ナコト写本』！」",
   "ko_candidate": "「――훌륭해｡ 잘도 나에게 마도서를 사용하게 했군! 소개하지……나의 마도서 『나코트 사본』!」"
  },
  {
   "id": 2458,
   "key": "D0207.txt:1294",
   "file": "D0207.txt",
   "line": 1294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "闇の正体は、黒の少女だった。",
   "ko_candidate": "어둠의 정체는､ 검은 소녀였다｡"
  },
  {
   "id": 2459,
   "key": "D0207.txt:1296",
   "file": "D0207.txt",
   "line": 1296,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "墨を流したような黒い髪。黒曜石のような瞳。",
   "ko_candidate": "먹물을 흘린 듯한 검은 머리｡ 흑요석 같은 눈동자｡"
  },
  {
   "id": 2460,
   "key": "D0207.txt:1297",
   "file": "D0207.txt",
   "line": 1297,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして、黒いドレス。",
   "ko_candidate": "그리고､ 검은 드레스｡"
  },
  {
   "id": 2461,
   "key": "D0207.txt:1298",
   "file": "D0207.txt",
   "line": 1298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ肌だけが、闇に浮かび上がるように、白い。",
   "ko_candidate": "단지 피부만이､ 어둠에 떠오르듯이､ 하얗다｡"
  },
  {
   "id": 2462,
   "key": "D0207.txt:1300",
   "file": "D0207.txt",
   "line": 1300,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "黒と白のコントラスト。",
   "ko_candidate": "흑과 백의 대비｡"
  },
  {
   "id": 2463,
   "key": "D0207.txt:1302",
   "file": "D0207.txt",
   "line": 1302,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "少女はこっちに向かって左腕を突き出している。 まるで何かを受け止めるように。",
   "ko_candidate": "소녀는 이쪽을 향해 왼팔을 내밀고 있다｡ 하지만､ 그 관절에서 앞이 존재하지 않는다｡ 마치 공간에 삼켜진 것처럼｡"
  },
  {
   "id": 2464,
   "key": "D0207.txt:1305",
   "file": "D0207.txt",
   "line": 1305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少女は夢幻じみた雰囲気が在った。",
   "ko_candidate": "소녀에게는 몽환적인 분위기가 있었다｡"
  },
  {
   "id": 2465,
   "key": "D0207.txt:1306",
   "file": "D0207.txt",
   "line": 1306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これに良く似た気配を知っている。",
   "ko_candidate": "이와 매우 비슷한 기운을 알고 있다｡"
  },
  {
   "id": 2466,
   "key": "D0207.txt:1309",
   "file": "D0207.txt",
   "line": 1309,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――アル・アジフ。",
   "ko_candidate": "알 아지프｡"
  },
  {
   "id": 2467,
   "key": "D0207.txt:1311",
   "file": "D0207.txt",
   "line": 1311,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そう、少女は魔導書『アル・アジフ』の精霊である彼女に良く似ている。",
   "ko_candidate": "그래､ 소녀는 『알 아지프』의 정령과 매우 닮았다｡"
  },
  {
   "id": 2468,
   "key": "D0207.txt:1314",
   "file": "D0207.txt",
   "line": 1314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今、マスターテリオンは言っていた。",
   "ko_candidate": "지금､ 마스터 테리온이 말했다｡"
  },
  {
   "id": 2469,
   "key": "D0207.txt:1315",
   "file": "D0207.txt",
   "line": 1315,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "『ナコト写本』……つまり、この少女も魔導書!?",
   "ko_candidate": "『나코트 사본』……즉､ 이 소녀도 마도서!?"
  },
  {
   "id": 2470,
   "key": "D0207.txt:1320",
   "file": "D0207.txt",
   "line": 1320,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「返礼してやれ、エセルドレーダ」",
   "ko_candidate": "「답례해 줘라､ 에셀드레다」"
  },
  {
   "id": 2471,
   "key": "D0207.txt:1325",
   "file": "D0207.txt",
   "line": 1325,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「イエス、マイ・マスター」",
   "ko_candidate": "「예스､ 마이 마스터」"
  },
  {
   "id": 2472,
   "key": "D0207.txt:1330",
   "file": "D0207.txt",
   "line": 1330,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エセルドレーダと呼ばれたその少女は、突き出した 左手に力を込めた。存在しないはずの何かを握り潰そうとしている。",
   "ko_candidate": "에셀드레다라고 불린 그 소녀는､ 존재하지 않아야 할 왼손에 힘을 주었다｡"
  },
  {
   "id": 2473,
   "key": "D0207.txt:1334",
   "file": "D0207.txt",
   "line": 1334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何故か、俺にはそれが理解できた。",
   "ko_candidate": "왠지､ 나는 그것을 이해할 수 있었다｡"
  },
  {
   "id": 2474,
   "key": "D0207.txt:1341",
   "file": "D0207.txt",
   "line": 1341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確信を裏付けるかのように、デモンベインの拳を掴む鋼鉄の掌がギシリと軋む。デモンベインの拳を握り潰そうと、力を込めている――！",
   "ko_candidate": "확신을 뒷받침하듯이､ 데몬베인의 주먹을 잡고 있는 강철의 손바닥이､ 끼긱하고 삐걱거린다｡ 데몬베인의 주먹을 으스러뜨리려고､ 힘을 주고 있어――!"
  },
  {
   "id": 2475,
   "key": "D0207.txt:1346",
   "file": "D0207.txt",
   "line": 1346,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ＡＢＲＡＨＡＤＡＢＲＡ」",
   "ko_candidate": "「ABRAHADABRA」"
  },
  {
   "id": 2476,
   "key": "D0207.txt:1367",
   "file": "D0207.txt",
   "line": 1367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "昂ぶる魔力が、鋼鉄の掌より迸った。",
   "ko_candidate": "고조되는 마력이､ 강철의 손바닥에서 뿜어져 나왔다｡"
  },
  {
   "id": 2477,
   "key": "D0207.txt:1368",
   "file": "D0207.txt",
   "line": 1368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "雷光が世界を舐め尽くす。",
   "ko_candidate": "번개가 세상을 핥아먹는다｡"
  },
  {
   "id": 2478,
   "key": "D0207.txt:1369",
   "file": "D0207.txt",
   "line": 1369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光に呑まれ、光に満たされ、世界は白い闇に沈む。",
   "ko_candidate": "빛에 삼켜지고､ 빛으로 가득 차며､ 세계는 하얀 어둠에 잠긴다｡"
  },
  {
   "id": 2479,
   "key": "D0207.txt:1380",
   "file": "D0207.txt",
   "line": 1380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "爆音は、俺の耳には届かなかった――",
   "ko_candidate": "폭음은､ 내 귀에는 들리지 않았다――"
  }
 ]
}