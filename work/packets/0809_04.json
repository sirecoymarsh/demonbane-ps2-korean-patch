 },
 "items": [
  {
   "id": 14501,
   "key": "D0809al.txt:859",
   "file": "D0809al.txt",
   "line": 859,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほらよっ！　こいつで解体して一丁あがりだっ！」",
   "ko_candidate": "「자､ 받아라! 이걸로 해체하면 끝이다!」"
  },
  {
   "id": 14502,
   "key": "D0809al.txt:868",
   "file": "D0809al.txt",
   "line": 868,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アトラック＝ナチャ！」",
   "ko_candidate": "「아틀락 나챠!」"
  },
  {
   "id": 14503,
   "key": "D0809al.txt:875",
   "file": "D0809al.txt",
   "line": 875,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の髪の毛が何倍にも伸びて、クラウディウスに迫る。",
   "ko_candidate": "내 머리카락이 몇 배로 늘어나 클라우디우스에게 다가간다｡"
  },
  {
   "id": 14504,
   "key": "D0809al.txt:876",
   "file": "D0809al.txt",
   "line": 876,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "風の刃を放つ前に全身を絡め取られ、クラウディウスは暴れ、悶えた。だがその程度では捕縛結界を破れはしない！",
   "ko_candidate": "바람의 칼날을 날리기 전에 온몸이 얽매이고､ 클라우디우스는 몸부림치며 괴로워했다｡ 하지만 그 정도로는 포박 결계를 깰 수 없다!"
  },
  {
   "id": 14505,
   "key": "D0809al.txt:881",
   "file": "D0809al.txt",
   "line": 881,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、なんだこりゃ!?」",
   "ko_candidate": "「뭐､ 뭐야 이거!?」"
  },
  {
   "id": 14506,
   "key": "D0809al.txt:886",
   "file": "D0809al.txt",
   "line": 886,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おらぁぁぁぁっ！」",
   "ko_candidate": "「으라아아아아!」"
  },
  {
   "id": 14507,
   "key": "D0809al.txt:888",
   "file": "D0809al.txt",
   "line": 888,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "髪の毛に絡まったクラウディウスを引き寄せ、一気に宙に放り上げる。",
   "ko_candidate": "머리카락에 얽힌 클라우디우스를 끌어당겨､ 단숨에 공중으로 던져 올린다｡"
  },
  {
   "id": 14508,
   "key": "D0809al.txt:894",
   "file": "D0809al.txt",
   "line": 894,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぬああああああ！　糞っ！」",
   "ko_candidate": "「으아아아아아! 젠장!」"
  },
  {
   "id": 14509,
   "key": "D0809al.txt:899",
   "file": "D0809al.txt",
   "line": 899,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「……………｡」"
  },
  {
   "id": 14510,
   "key": "D0809al.txt:903",
   "file": "D0809al.txt",
   "line": 903,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "カリグラが拳を振り被る。俺はその上にクラウディウスの身体を叩き落した。",
   "ko_candidate": "칼리굴라가 주먹을 휘두른다｡ 나는 그 위에 클라우디우스의 몸을 내리쳤다｡"
  },
  {
   "id": 14511,
   "key": "D0809al.txt:910",
   "file": "D0809al.txt",
   "line": 910,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐおおおオおオ!?」",
   "ko_candidate": "「으오오오오오!?」"
  },
  {
   "id": 14512,
   "key": "D0809al.txt:916",
   "file": "D0809al.txt",
   "line": 916,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ガハッ……あっ！」",
   "ko_candidate": "「가핫… 악!」"
  },
  {
   "id": 14513,
   "key": "D0809al.txt:920",
   "file": "D0809al.txt",
   "line": 920,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人は衝突し、もつれ合い、無様にその場に転がった。",
   "ko_candidate": "둘은 충돌하고､ 뒤엉켜서､ 볼품없이 그 자리에 나뒹굴었다｡"
  },
  {
   "id": 14514,
   "key": "D0809al.txt:921",
   "file": "D0809al.txt",
   "line": 921,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――隙あり！",
   "ko_candidate": "――틈이다!"
  },
  {
   "id": 14515,
   "key": "D0809al.txt:924",
   "file": "D0809al.txt",
   "line": 924,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「２匹まとめて貰ったァッ！　バルザイの偃月刀！」",
   "ko_candidate": "「두 마리 한꺼번에 잡았다! 바르자이의 언월도!」"
  },
  {
   "id": 14516,
   "key": "D0809al.txt:943",
   "file": "D0809al.txt",
   "line": 943,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔が宙を奔り、バルザイの偃月刀が顕現する。",
   "ko_candidate": "불꽃이 허공을 달리고､ 바르자이의 언월도가 현현한다｡"
  },
  {
   "id": 14517,
   "key": "D0809al.txt:944",
   "file": "D0809al.txt",
   "line": 944,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一足飛びに間合いを詰めて、２人に偃月刀を振り下ろした。",
   "ko_candidate": "단숨에 간격을 좁혀 두 사람에게 언월도를 내리쳤다｡"
  },
  {
   "id": 14518,
   "key": "D0809al.txt:946",
   "file": "D0809al.txt",
   "line": 946,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……！",
   "ko_candidate": "하지만…!"
  },
  {
   "id": 14519,
   "key": "D0809al.txt:949",
   "file": "D0809al.txt",
   "line": 949,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 14520,
   "key": "D0809al.txt:951",
   "file": "D0809al.txt",
   "line": 951,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの身体が、目の前で掻き消える。",
   "ko_candidate": "클라우디우스의 몸이 눈앞에서 사라진다｡"
  },
  {
   "id": 14521,
   "key": "D0809al.txt:952",
   "file": "D0809al.txt",
   "line": 952,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして残るカリグラは――",
   "ko_candidate": "그리고 남은 칼리굴라는――"
  },
  {
   "id": 14522,
   "key": "D0809al.txt:968",
   "file": "D0809al.txt",
   "line": 968,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なあっ!?」",
   "ko_candidate": "「흐으아아아아!」"
  },
  {
   "id": 14523,
   "key": "D0809al.txt:970",
   "file": "D0809al.txt",
   "line": 970,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自らの拳をバルザイの偃月刀に叩き込んだ。",
   "ko_candidate": "「뭐야!?」 자신의 주먹을 바르자이의 언월도에 내리쳤다｡"
  },
  {
   "id": 14524,
   "key": "D0809al.txt:971",
   "file": "D0809al.txt",
   "line": 971,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しまった――と思ったときはもう遅い。",
   "ko_candidate": "큰일났다――고 생각했을 때는 이미 늦었다｡"
  },
  {
   "id": 14525,
   "key": "D0809al.txt:977",
   "file": "D0809al.txt",
   "line": 977,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界が爆破の閃光で真っ白に染まる。俺は宙を舞った。",
   "ko_candidate": "시야가 폭발의 섬광으로 새하얗게 물든다｡ 나는 공중으로 날아갔다｡"
  },
  {
   "id": 14526,
   "key": "D0809al.txt:982",
   "file": "D0809al.txt",
   "line": 982,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐわあああああああ！」",
   "ko_candidate": "「으와아아아아아아!」"
  },
  {
   "id": 14527,
   "key": "D0809al.txt:987",
   "file": "D0809al.txt",
   "line": 987,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅぅぅっ！　翼よ！」",
   "ko_candidate": "「크으으윽! 날개여!」"
  },
  {
   "id": 14528,
   "key": "D0809al.txt:1004",
   "file": "D0809al.txt",
   "line": 1004,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒翼を広げて慣性を制御し、膝を突きながらも何とか着地する。",
   "ko_candidate": "검은 날개를 펼쳐 관성을 제어하고､ 무릎을 꿇으면서도 어떻게든 착지한다｡"
  },
  {
   "id": 14529,
   "key": "D0809al.txt:1005",
   "file": "D0809al.txt",
   "line": 1005,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "チィッ……ぬかった。再びバルザイの偃月刀を構え――",
   "ko_candidate": "칫… 방심했군｡ 다시 바르자이의 언월도를 구사하려고 하다가――"
  },
  {
   "id": 14530,
   "key": "D0809al.txt:1009",
   "file": "D0809al.txt",
   "line": 1009,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ゲゲッ」",
   "ko_candidate": "「헉」"
  },
  {
   "id": 14531,
   "key": "D0809al.txt:1011",
   "file": "D0809al.txt",
   "line": 1011,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "我が目を疑う。バルザイの偃月刀のちょうど真ん中から、先が砕け散って無くなっていた。",
   "ko_candidate": "내 눈을 의심한다｡ 바르자이의 언월도의 정확히 중간부터 끝이 산산조각 나 사라져 있었다｡"
  },
  {
   "id": 14532,
   "key": "D0809al.txt:1013",
   "file": "D0809al.txt",
   "line": 1013,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして――焦る俺の耳元で、囁く声。",
   "ko_candidate": "그리고――당황하는 내 귓가에 속삭이는 목소리｡"
  },
  {
   "id": 14533,
   "key": "D0809al.txt:1021",
   "file": "D0809al.txt",
   "line": 1021,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「甘ぇんだよ、ボケ」",
   "ko_candidate": "「너무 순진해､ 바보야」"
  },
  {
   "id": 14534,
   "key": "D0809al.txt:1025",
   "file": "D0809al.txt",
   "line": 1025,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……！」",
   "ko_candidate": "「뭐…!」"
  },
  {
   "id": 14535,
   "key": "D0809al.txt:1035",
   "file": "D0809al.txt",
   "line": 1035,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咄嗟に身を低く屈める。",
   "ko_candidate": "순간 몸을 낮게 숙인다｡"
  },
  {
   "id": 14536,
   "key": "D0809al.txt:1036",
   "file": "D0809al.txt",
   "line": 1036,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "真空の刃が俺の背中を裂いた。血飛沫が舞う。",
   "ko_candidate": "진공의 칼날이 내 등을 갈랐다｡ 피가 튀었다｡ 「쿠로!」"
  },
  {
   "id": 14537,
   "key": "D0809al.txt:1042",
   "file": "D0809al.txt",
   "line": 1042,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎っ！」",
   "ko_candidate": "「으악! 이､ 이놈…!」"
  },
  {
   "id": 14538,
   "key": "D0809al.txt:1046",
   "file": "D0809al.txt",
   "line": 1046,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐあっ！　こ、このぉぉぉ……！」 しゃがんだと同時に蹴りを繰り出して、すぐ目の前にあるクラウディウスの足を払おうとした。",
   "ko_candidate": "쪼그리고 앉음과 동시에 발차기를 날려､{SE_PLAY(1,\"갖郎かわす\",0,100,false);}바로 눈앞에 있는 클라우디우스의 다리를 쳐내려고 했다｡"
  },
  {
   "id": 14539,
   "key": "D0809al.txt:1060",
   "file": "D0809al.txt",
   "line": 1060,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがクラウディウスは軽々と俺の脚を跳び越え、少し離れた場所に着地する。",
   "ko_candidate": "하지만 클라우디우스는 가볍게 내 다리를 뛰어넘어 조금 떨어진 곳에 착지한다｡"
  },
  {
   "id": 14540,
   "key": "D0809al.txt:1064",
   "file": "D0809al.txt",
   "line": 1064,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はんっ……アクビが出ちゃうぜぇ、九郎ちゃんよぉ？」",
   "ko_candidate": "「흥… 하품이 나오네､ 쿠로 짱?」"
  }
 ]
}