 },
 "items": [
  {
   "id": 17258,
   "key": "D0819le.txt:183",
   "file": "D0819le.txt",
   "line": 183,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「でも、ね……はははは…… まだ、だよ」",
   "ko_candidate": "「하지만､ 말이야……하하하하……아직､ 이야」"
  },
  {
   "id": 17259,
   "key": "D0819le.txt:188",
   "file": "D0819le.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺は何だかこの『暴君』が……",
   "ko_candidate": "나는 왠지 이 『폭군』이……"
  },
  {
   "id": 17260,
   "key": "D0819le.txt:193",
   "file": "D0819le.txt",
   "line": 193,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……受け止めて、 もらう……九郎には、 この『暴君』の存在を…… 心を、憎悪を、絶望を……」 「……受け止めてもらう…… そのくらいは、 して貰わないとね……っ！」",
   "ko_candidate": "「……받아들여……줘……쿠로에게는､ 이 『폭군』의 존재를……마음을､ 증오를､ 절망을……받아들여 줘……그 정도는､ 해줘야지……읏!」"
  },
  {
   "id": 17261,
   "key": "D0819le.txt:205",
   "file": "D0819le.txt",
   "line": 205,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――酷く滑稽で、哀れに思えてならなかった。",
   "ko_candidate": "――몹시 우스꽝스럽고､ 가련하게 느껴졌다｡"
  },
  {
   "id": 17262,
   "key": "D0819le.txt:207",
   "file": "D0819le.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "雨の雫が、暴君の頬を打つ。",
   "ko_candidate": "빗방울이､ 폭군의 뺨을 친다｡"
  },
  {
   "id": 17263,
   "key": "D0819le.txt:209",
   "file": "D0819le.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ついに降り出してきた。",
   "ko_candidate": "드디어 내리기 시작했다｡"
  },
  {
   "id": 17264,
   "key": "D0819le.txt:211",
   "file": "D0819le.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "最初の一雫が落ちると、すぐだった。どんどんと雨は強くなり、ついには天をひっくり返したかのような土砂降りとなる。",
   "ko_candidate": "첫 방울이 떨어지자､ 곧이었다｡ 점점 비는 강해지고､ 마침내는 하늘을 뒤집은 것 같은 폭우가 된다｡"
  },
  {
   "id": 17265,
   "key": "D0819le.txt:213",
   "file": "D0819le.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その間、デモンベインも、ネームレス・ワンも微動だにしない。",
   "ko_candidate": "그 사이､ 데몬베인도､ 네임리스 원도 미동도 하지 않는다｡"
  },
  {
   "id": 17266,
   "key": "D0819le.txt:215",
   "file": "D0819le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "雨が『暴君』の血を洗い流す。",
   "ko_candidate": "비가 『폭군』의 피를 씻어낸다｡"
  },
  {
   "id": 17267,
   "key": "D0819le.txt:219",
   "file": "D0819le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ネームレス・ワンがその腕を、まっすぐに伸ばす。",
   "ko_candidate": "네임리스 원이 그 팔을､ 똑바로 뻗는다｡"
  },
  {
   "id": 17268,
   "key": "D0819le.txt:221",
   "file": "D0819le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "手を差し伸べるように。",
   "ko_candidate": "손을 내미는 것처럼｡"
  },
  {
   "id": 17269,
   "key": "D0819le.txt:223",
   "file": "D0819le.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "救いを求めるように。",
   "ko_candidate": "구원을 구하는 것처럼｡"
  },
  {
   "id": 17270,
   "key": "D0819le.txt:228",
   "file": "D0819le.txt",
   "line": 228,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「これが、最後の術…… さあ、どう出る、大十字九郎？ 術種選択――」",
   "ko_candidate": "「이것이､ 마지막 술식……자､ 어떻게 나올 거지､ 다이쥬지 쿠로? 술종선택――」"
  },
  {
   "id": 17271,
   "key": "D0819le.txt:237",
   "file": "D0819le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――ッ!?",
   "ko_candidate": "――읏!?"
  },
  {
   "id": 17272,
   "key": "D0819le.txt:238",
   "file": "D0819le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "脳天から背筋を通り、 股先を貫通するような鋭い危機感。",
   "ko_candidate": "정수리에서 등줄기를 통해､ 가랑이를 관통하는 듯한 날카로운 위기감｡"
  },
  {
   "id": 17273,
   "key": "D0819le.txt:241",
   "file": "D0819le.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いや、これは……むしろ絶望感に近い。",
   "ko_candidate": "아니､ 이건……오히려 절망감에 가깝다｡"
  },
  {
   "id": 17274,
   "key": "D0819le.txt:243",
   "file": "D0819le.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何だ……!?",
   "ko_candidate": "뭐지……!?"
  },
  {
   "id": 17275,
   "key": "D0819le.txt:244",
   "file": "D0819le.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何だ何だ何だっ!?",
   "ko_candidate": "뭐지 뭐지 뭐지!?"
  },
  {
   "id": 17276,
   "key": "D0819le.txt:245",
   "file": "D0819le.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この……この圧倒的な『否定』の気配は！",
   "ko_candidate": "이……이 압도적인 『부정』의 기척은!"
  },
  {
   "id": 17277,
   "key": "D0819le.txt:250",
   "file": "D0819le.txt",
   "line": 250,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……九郎！」",
   "ko_candidate": "「……쿠로!」"
  },
  {
   "id": 17278,
   "key": "D0819le.txt:254",
   "file": "D0819le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルも気付いたらしい。",
   "ko_candidate": "알도 눈치챘나 보다｡"
  },
  {
   "id": 17279,
   "key": "D0819le.txt:256",
   "file": "D0819le.txt",
   "line": 256,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何も理解出来ないが、この状況から一刻も早く逃れなければならない。",
   "ko_candidate": "아무것도 이해할 수 없지만､ 이 상황에서 한시라도 빨리 벗어나야 한다｡"
  },
  {
   "id": 17280,
   "key": "D0819le.txt:258",
   "file": "D0819le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、デモンベインを呪縛する魔法陣の効力は、まったく弱まることがない。",
   "ko_candidate": "하지만､ 데몬베인을 주박하는 마법진의 효력은､ 전혀 약해지지 않는다｡"
  },
  {
   "id": 17281,
   "key": "D0819le.txt:260",
   "file": "D0819le.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶体絶命だ。",
   "ko_candidate": "절체절명이다｡"
  },
  {
   "id": 17282,
   "key": "D0819le.txt:262",
   "file": "D0819le.txt",
   "line": 262,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "『暴君』の口元が愉悦に歪む――",
   "ko_candidate": "『폭군』의 입가가 열락으로 일그러진다――"
  },
  {
   "id": 17283,
   "key": "D0819le.txt:267",
   "file": "D0819le.txt",
   "line": 267,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……解読が間に合わ……！」",
   "ko_candidate": "「큿……해독이 미처……!」"
  },
  {
   "id": 17284,
   "key": "D0819le.txt:272",
   "file": "D0819le.txt",
   "line": 272,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 17285,
   "key": "D0819le.txt:276",
   "file": "D0819le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その口元が呪文を紡ぐ、",
   "ko_candidate": "그 입가가 주문을 짓는､"
  },
  {
   "id": 17286,
   "key": "D0819le.txt:281",
   "file": "D0819le.txt",
   "line": 281,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――ッ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 17287,
   "key": "D0819le.txt:289",
   "file": "D0819le.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その直前。",
   "ko_candidate": "그 직전｡"
  },
  {
   "id": 17288,
   "key": "D0819le.txt:290",
   "file": "D0819le.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "静かに速やかに一条の光が、ビーム砲の一撃が、 『暴君』を貫いた。",
   "ko_candidate": "조용히 신속하게 한 줄기 빛이､ 빔포의 일격이､ 『폭군』을 관통했다｡"
  },
  {
   "id": 17289,
   "key": "D0819le.txt:302",
   "file": "D0819le.txt",
   "line": 302,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……!?」",
   "ko_candidate": "「엣……!?」"
  },
  {
   "id": 17290,
   "key": "D0819le.txt:304",
   "file": "D0819le.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ビームが飛んで来た方角。",
   "ko_candidate": "빔이 날아온 방향｡"
  },
  {
   "id": 17291,
   "key": "D0819le.txt:309",
   "file": "D0819le.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光の翼を展開する白い影。",
   "ko_candidate": "빛의 날개를 펼치는 하얀 그림자｡"
  },
  {
   "id": 17292,
   "key": "D0819le.txt:310",
   "file": "D0819le.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白い仮面と、白い装甲に身を包む、天使の姿。",
   "ko_candidate": "하얀 가면과､ 하얀 갑옷에 몸을 감싼､ 천사의 모습｡"
  },
  {
   "id": 17293,
   "key": "D0819le.txt:315",
   "file": "D0819le.txt",
   "line": 315,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「メタトロン！」",
   "ko_candidate": "「메타트론!」"
  },
  {
   "id": 17294,
   "key": "D0819le.txt:321",
   "file": "D0819le.txt",
   "line": 321,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「出遅れてしまったようだな…… 大丈夫か、大十字九郎？」",
   "ko_candidate": "「늦어버렸군……괜찮나､ 다이쥬지 쿠로?」"
  },
  {
   "id": 17295,
   "key": "D0819le.txt:326",
   "file": "D0819le.txt",
   "line": 326,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああ……俺はな……だけど……」",
   "ko_candidate": "「아아……나는 괜찮아……하지만……」"
  },
  {
   "id": 17296,
   "key": "D0819le.txt:332",
   "file": "D0819le.txt",
   "line": 332,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あはははははは！」",
   "ko_candidate": "「아하하하하하!」"
  },
  {
   "id": 17297,
   "key": "D0819le.txt:336",
   "file": "D0819le.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の言葉を遮って、『暴君』の哄笑が響く。",
   "ko_candidate": "내 말을 가로막고､ 『폭군』의 폭소가 울린다｡"
  }
 ]
}