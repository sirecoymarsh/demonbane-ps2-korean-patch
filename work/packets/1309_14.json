 "items": [
  {
   "id": 34451,
   "key": "D1309ru.txt:299",
   "file": "D1309ru.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうも俺がぶっ倒れている間に、２人の間にはある種の共通認識が芽生えたようだ。",
   "ko_candidate": "아무래도 내가 쓰러져 있는 동안 둘 사이에 어떤 공통된 인식이 생긴 것 같다｡"
  },
  {
   "id": 34452,
   "key": "D1309ru.txt:300",
   "file": "D1309ru.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば……こいつと姫さんを信じるとしよう。",
   "ko_candidate": "그렇다면… 이 녀석과 공주님을 믿기로 하자｡"
  },
  {
   "id": 34453,
   "key": "D1309ru.txt:306",
   "file": "D1309ru.txt",
   "line": 306,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何か余計なこと企んでいるじゃないんでしょうねぇ？」",
   "ko_candidate": "「…뭔가 쓸데없는 짓을 꾸미고 있는 건 아니겠죠?」"
  },
  {
   "id": 34454,
   "key": "D1309ru.txt:310",
   "file": "D1309ru.txt",
   "line": 310,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあなぁ……？」",
   "ko_candidate": "「글쎄에…?」"
  },
  {
   "id": 34455,
   "key": "D1309ru.txt:313",
   "file": "D1309ru.txt",
   "line": 313,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘯きながら、幾重にも迷彩を施した術を、ゆっくり焦らず……だが、大急ぎで編んでゆく。",
   "ko_candidate": "허세를 부리며 여러 겹으로 위장한 술을 천천히 서두르지 않고… 하지만 아주 급하게 짜 나간다｡"
  },
  {
   "id": 34456,
   "key": "D1309ru.txt:315",
   "file": "D1309ru.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "フードの中でティベリウスの頭が回った。",
   "ko_candidate": "후드 안에서 티베리우스의 머리가 돌아갔다｡"
  },
  {
   "id": 34457,
   "key": "D1309ru.txt:316",
   "file": "D1309ru.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一回転した時には、ティベリウスの仮面は憤怒のソレに変わっていた。",
   "ko_candidate": "한 바퀴 돌았을 때는 티베리우스의 가면이 분노의 그것으로 바뀌어 있었다｡"
  },
  {
   "id": 34458,
   "key": "D1309ru.txt:320",
   "file": "D1309ru.txt",
   "line": 320,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「気に喰わないわねぇ……さっさと銃を捨てなさいよ。本当に瑠璃ちゃんの首をヘシ折るわよ？」",
   "ko_candidate": "「마음에 안 들어… 빨리 총을 버려｡ 정말로 루리쨩의 목을 꺾어버릴 거야? 나로서는 시간도 전혀 OK니까…」"
  },
  {
   "id": 34459,
   "key": "D1309ru.txt:324",
   "file": "D1309ru.txt",
   "line": 324,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「…………」 양손을 펼쳤다｡"
  },
  {
   "id": 34460,
   "key": "D1309ru.txt:327",
   "file": "D1309ru.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "両掌を開いた。 二挺の魔銃が床に落ちる――その瞬間、バラバラに砕け散る魔銃の虚像。",
   "ko_candidate": "두 자루의 마총이 바닥에 떨어진다--{SE_PLAY(1,\"鏡砕ける\",0,100,false);}그 순간､ 산산조각 나는 마총의 허상｡"
  },
  {
   "id": 34461,
   "key": "D1309ru.txt:330",
   "file": "D1309ru.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "消える幻像。床に散らばる鏡の破片。",
   "ko_candidate": "사라지는 환영｡ 바닥에 흩어지는 거울 파편｡"
  },
  {
   "id": 34462,
   "key": "D1309ru.txt:334",
   "file": "D1309ru.txt",
   "line": 334,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ！」",
   "ko_candidate": "「………큭!」"
  },
  {
   "id": 34463,
   "key": "D1309ru.txt:337",
   "file": "D1309ru.txt",
   "line": 337,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの触手が、姫さんの首を折るはずだった。",
   "ko_candidate": "티베리우스의 촉수가 공주님의 목을 꺾으려 했다｡"
  },
  {
   "id": 34464,
   "key": "D1309ru.txt:339",
   "file": "D1309ru.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが無論、それを許す俺たちではない。",
   "ko_candidate": "하지만 물론､ 그걸 허락할 우리가 아니다｡"
  },
  {
   "id": 34465,
   "key": "D1309ru.txt:342",
   "file": "D1309ru.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ひたすらに隠していた術を今こそ発動させる。",
   "ko_candidate": "오로지 숨기고 있던 술을 지금이야말로 발동시킨다｡"
  },
  {
   "id": 34466,
   "key": "D1309ru.txt:343",
   "file": "D1309ru.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティベリウスの躰が硬直した。",
   "ko_candidate": "티베리우스의 몸이 경직됐다｡"
  },
  {
   "id": 34467,
   "key": "D1309ru.txt:347",
   "file": "D1309ru.txt",
   "line": 347,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な……動かな……っ!?」",
   "ko_candidate": "「뭐… 움직이지… 않…!?」"
  },
  {
   "id": 34468,
   "key": "D1309ru.txt:350",
   "file": "D1309ru.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ニトクリスの鏡による迷彩が剥がれた術が、姿を明らかにする。",
   "ko_candidate": "니토크리스의 거울로 위장했던 술이 모습을 드러낸다｡"
  },
  {
   "id": 34469,
   "key": "D1309ru.txt:352",
   "file": "D1309ru.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通路いっぱいに張り巡らされた糸、糸、糸。",
   "ko_candidate": "통로 가득 펼쳐진 실､ 실､ 실｡"
  },
  {
   "id": 34470,
   "key": "D1309ru.txt:353",
   "file": "D1309ru.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "六角形を編み上げ、ティベリウスの躰を拘束している。",
   "ko_candidate": "육각형을 짜 올려 티베리우스의 몸을 구속하고 있다｡"
  },
  {
   "id": 34471,
   "key": "D1309ru.txt:355",
   "file": "D1309ru.txt",
   "line": 355,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "糸は全て、俺の髪の毛へと続いていた。",
   "ko_candidate": "실은 모두 내 머리카락으로 이어져 있었다｡"
  },
  {
   "id": 34472,
   "key": "D1309ru.txt:359",
   "file": "D1309ru.txt",
   "line": 359,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――!? アトラック＝ナチャの力！　い、いつの間に……！」",
   "ko_candidate": "「----!? 아틀락 나챠의 힘! 언､ 언제…!」"
  },
  {
   "id": 34473,
   "key": "D1309ru.txt:369",
   "file": "D1309ru.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度こそ、引鉄を引いた。",
   "ko_candidate": "이번엔 정말로 방아쇠를 당겼다｡"
  },
  {
   "id": 34474,
   "key": "D1309ru.txt:373",
   "file": "D1309ru.txt",
   "line": 373,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぎゃはあぁぁぁぁっ！」",
   "ko_candidate": "「그갸하아아아아악!」"
  },
  {
   "id": 34475,
   "key": "D1309ru.txt:376",
   "file": "D1309ru.txt",
   "line": 376,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "イタクァの弾丸がティベリウスの両目を抉り、クトゥグアの弾丸が触手を吹き飛ばす。",
   "ko_candidate": "이타콰의 탄환이 티베리우스의 양눈을 파고들고､ 크투가의 탄환이 촉수를 날려버린다｡"
  },
  {
   "id": 34476,
   "key": "D1309ru.txt:380",
   "file": "D1309ru.txt",
   "line": 380,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃん……っ！」",
   "ko_candidate": "「꺄앗…!」"
  },
  {
   "id": 34477,
   "key": "D1309ru.txt:383",
   "file": "D1309ru.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "解放された姫さんが床に落ちた。",
   "ko_candidate": "풀려난 공주님이 바닥에 떨어졌다｡"
  },
  {
   "id": 34478,
   "key": "D1309ru.txt:384",
   "file": "D1309ru.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが。",
   "ko_candidate": "하지만｡"
  },
  {
   "id": 34479,
   "key": "D1309ru.txt:388",
   "file": "D1309ru.txt",
   "line": 388,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「っっっっっ！　舐めてんじゃねえええぇぇわよっ！」",
   "ko_candidate": "「크크크크큭! 얕보지 마아아아아!」 로브가 펼쳐지고 시체의 복부가 찢어진다｡"
  },
  {
   "id": 34480,
   "key": "D1309ru.txt:395",
   "file": "D1309ru.txt",
   "line": 395,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ローブが広がり、腹部が裂け、黄ばんだ肋骨が姿をのぞかせる。 「――――っっっっ!?」",
   "ko_candidate": "넘쳐나는 시커먼 혈액､ 내장､ 누런 갈비뼈--!"
  },
  {
   "id": 34481,
   "key": "D1309ru.txt:406",
   "file": "D1309ru.txt",
   "line": 406,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「----큭큭큭!?」"
  },
  {
   "id": 34482,
   "key": "D1309ru.txt:410",
   "file": "D1309ru.txt",
   "line": 410,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ！」",
   "ko_candidate": "「------」 「………큭!」"
  },
  {
   "id": 34483,
   "key": "D1309ru.txt:414",
   "file": "D1309ru.txt",
   "line": 414,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そこまでお嬢様を死なせたいのね!?　分かったわぁぁぁっ！ ブッ殺してあげるわよっっっっっ！」",
   "ko_candidate": "「그렇게까지 아가씨를 죽이고 싶은 거야!? 알았어어어! 확 죽여주마아아아아!」"
  },
  {
   "id": 34484,
   "key": "D1309ru.txt:420",
   "file": "D1309ru.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目は見えずとも、姫さんのいる辺りに目星をつけて、肋骨の矢を発射する！",
   "ko_candidate": "눈은 보이지 않아도 공주님이 있는 쪽을 가늠해 갈비뼈 화살을 발사한다!"
  },
  {
   "id": 34485,
   "key": "D1309ru.txt:422",
   "file": "D1309ru.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肋骨の雨が姫さんの立つ地面一帯を嘗め尽くす。",
   "ko_candidate": "갈비뼈 비가 공주님이 서 있는 지면 일대를 휩쓴다｡"
  },
  {
   "id": 34486,
   "key": "D1309ru.txt:424",
   "file": "D1309ru.txt",
   "line": 424,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "床を砕いて、突き刺さる肋骨。",
   "ko_candidate": "바닥을 부수고 꽂히는 갈비뼈｡"
  },
  {
   "id": 34487,
   "key": "D1309ru.txt:425",
   "file": "D1309ru.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静寂が場を支配した。",
   "ko_candidate": "정적이 장소를 지배했다｡"
  },
  {
   "id": 34488,
   "key": "D1309ru.txt:429",
   "file": "D1309ru.txt",
   "line": 429,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………っ」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 34489,
   "key": "D1309ru.txt:432",
   "file": "D1309ru.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "潰れたティベリウスの眼が再生する。",
   "ko_candidate": "으스러진 티베리우스의 눈이 재생된다｡"
  },
  {
   "id": 34490,
   "key": "D1309ru.txt:434",
   "file": "D1309ru.txt",
   "line": 434,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "緑色によどんだ眼球がグリグリと回る。 拡大と縮小を繰り返す瞳孔。",
   "ko_candidate": "녹색으로 탁해진 안구가 빙글빙글 돈다｡ 확대와 축소를 반복하는 동공｡"
  }
 ]
