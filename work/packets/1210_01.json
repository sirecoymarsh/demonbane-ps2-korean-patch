 "items": [
  {
   "id": 29018,
   "key": "D1210al.txt:160",
   "file": "D1210al.txt",
   "line": 160,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……鬼械神」",
   "ko_candidate": "「……귀계신」"
  },
  {
   "id": 29019,
   "key": "D1210al.txt:164",
   "file": "D1210al.txt",
   "line": 164,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なっ……ネームレス・ワン！ 『暴君』……ネロ！ てめえかぁぁぁっ！」",
   "ko_candidate": "「뭐……네임리스 원! 『폭군』……네로! 네 녀석이냐아아아!」"
  },
  {
   "id": 29020,
   "key": "D1210al.txt:169",
   "file": "D1210al.txt",
   "line": 169,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『暴君』？",
   "ko_candidate": "『폭군』?"
  },
  {
   "id": 29021,
   "key": "D1210al.txt:170",
   "file": "D1210al.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの時も――エンネアと一緒に襲撃された時も、こいつらは同じ言葉を口にしていた。",
   "ko_candidate": "그때도――엔네아와 함께 습격당했을 때도 이 녀석들은 같은 말을 했었다｡"
  },
  {
   "id": 29022,
   "key": "D1210al.txt:172",
   "file": "D1210al.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして……ネロ？",
   "ko_candidate": "그리고……네로?"
  },
  {
   "id": 29023,
   "key": "D1210al.txt:179",
   "file": "D1210al.txt",
   "line": 179,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ネロ!?」",
   "ko_candidate": "「……네로!?」"
  },
  {
   "id": 29024,
   "key": "D1210al.txt:183",
   "file": "D1210al.txt",
   "line": 183,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……？　エルザ、知っているのか？」",
   "ko_candidate": "「……? 엘자､ 알고 있는 거야?」"
  },
  {
   "id": 29025,
   "key": "D1210al.txt:187",
   "file": "D1210al.txt",
   "line": 187,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ドクターに教えてもらったロボ。『暴君』ネロ。アンチクロスの１人にして、マスターテリオンと肩を並べる、最強の魔術師」",
   "ko_candidate": "「닥터한테 들은 로봇이야｡ 『폭군』 네로｡ 안티 크로스의 일원이자 마스터 테리온과 어깨를 나란히 하는 최강의 마술사」"
  },
  {
   "id": 29026,
   "key": "D1210al.txt:191",
   "file": "D1210al.txt",
   "line": 191,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アンチクロス!?」",
   "ko_candidate": "「안티 크로스!?」"
  },
  {
   "id": 29027,
   "key": "D1210al.txt:193",
   "file": "D1210al.txt",
   "line": 193,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『暴君』がアンチクロスの１人!?",
   "ko_candidate": "『폭군』이 안티 크로스의 일원!?"
  },
  {
   "id": 29028,
   "key": "D1210al.txt:194",
   "file": "D1210al.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの拘束具の少女が……か？",
   "ko_candidate": "그 구속구의 소녀가……인가?"
  },
  {
   "id": 29029,
   "key": "D1210al.txt:196",
   "file": "D1210al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの時、あいつらはその『暴君』を追っていた？",
   "ko_candidate": "그때､ 그들은 그 『폭군』을 쫓고 있었어?"
  },
  {
   "id": 29030,
   "key": "D1210al.txt:197",
   "file": "D1210al.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アンチクロスの……仲間の１人を？",
   "ko_candidate": "안티 크로스의…… 동료 중 한 명을?"
  },
  {
   "id": 29031,
   "key": "D1210al.txt:199",
   "file": "D1210al.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いや、でも、どうして――ワケが分からない。",
   "ko_candidate": "아니､ 하지만､ 왜――이해가 안 된다｡"
  },
  {
   "id": 29032,
   "key": "D1210al.txt:202",
   "file": "D1210al.txt",
   "line": 202,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何でアンチクロス同士がやり合ってんだよ!?」",
   "ko_candidate": "「왜 안티 크로스끼리 싸우고 있는 거야!?」"
  },
  {
   "id": 29033,
   "key": "D1210al.txt:206",
   "file": "D1210al.txt",
   "line": 206,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ネロは裏切り者ロボ。その狂暴さゆえ、『夢幻心母』牢獄結界の最下層に幽閉されていたロボ。以前に脱走して大騒ぎになったけど……」",
   "ko_candidate": "「네로는 배신자 로봇｡ 그 광포함 때문에､ 『몽환심모』 감옥결계의 최하층에 유폐되어 있던 로봇｡ 이전에 탈출해서 큰 소동이 났었지만……」"
  },
  {
   "id": 29034,
   "key": "D1210al.txt:210",
   "file": "D1210al.txt",
   "line": 210,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……裏切り者」",
   "ko_candidate": "「……배신자」"
  },
  {
   "id": 29035,
   "key": "D1210al.txt:212",
   "file": "D1210al.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なら、アンチクロスでありながら『ブラックロッジ』と敵対する理由には納得がいく。",
   "ko_candidate": "그렇다면､ 안티 크로스이면서 『블랙로지』와 적대하는 이유는 납득이 간다｡"
  },
  {
   "id": 29036,
   "key": "D1210al.txt:214",
   "file": "D1210al.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど――それなら俺を助けた理由は？",
   "ko_candidate": "하지만――그렇다면 나를 도운 이유는?"
  },
  {
   "id": 29037,
   "key": "D1210al.txt:215",
   "file": "D1210al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今もそう。",
   "ko_candidate": "지금도 그렇고｡"
  },
  {
   "id": 29038,
   "key": "D1210al.txt:216",
   "file": "D1210al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに魔銃を与えたのも……。",
   "ko_candidate": "게다가 마총을 준 것도……"
  },
  {
   "id": 29039,
   "key": "D1210al.txt:224",
   "file": "D1210al.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の困惑は余所に、ネームレス・ワンはロードビヤーキーの上半身に向けて、腕を突きつけた。",
   "ko_candidate": "내 당혹감은 아랑곳하지 않고､ 네임리스 원은 로드 비야키의 상반신을 향해 팔을 들이댔다｡"
  },
  {
   "id": 29040,
   "key": "D1210al.txt:226",
   "file": "D1210al.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "急速に膨れ上がっていく魔力。",
   "ko_candidate": "급속도로 부풀어 오르는 마력｡"
  },
  {
   "id": 29041,
   "key": "D1210al.txt:227",
   "file": "D1210al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今の俺には解読できないが、おそらくは複雑な術式が展開されているはず。",
   "ko_candidate": "지금의 나로서는 해독할 수 없지만､ 아마도 복잡한 술식이 전개되고 있을 것이다｡"
  },
  {
   "id": 29042,
   "key": "D1210al.txt:229",
   "file": "D1210al.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの怒りと恐怖に満ちた絶叫が響き渡る。",
   "ko_candidate": "클라우디우스의 분노와 공포에 찬 절규가 울려 퍼진다｡"
  },
  {
   "id": 29043,
   "key": "D1210al.txt:233",
   "file": "D1210al.txt",
   "line": 233,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「糞ッ！　糞糞糞ッ！　許されると思ってんのか！　ボクを滅ぼしてただで済むって思ってんのかオラァ！　ぶっ殺す！　ぶっ殺す！ 糞糞糞ッ！」 「動け！　動け、 ロードビヤーキー！　……糞！ 糞！　便所蟲の分際が！」",
   "ko_candidate": "「젠장! 젠장젠장젠장! 용서받을 수 있다고 생각하는 거야! 날 멸망시키고 그냥 넘어갈 수 있다고 생각하는 거냐! 죽여버릴 거야! 죽여버릴 거라고! 젠장젠장젠장! 움직여! 움직이라고､ 로드 비야키! ……젠장! 젠장! 변소벌레 주제에! 젠장아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 29044,
   "key": "D1210al.txt:242",
   "file": "D1210al.txt",
   "line": 242,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちくしょおおおおおおおおおおおおぉぉぉぉぉぉ！」 錯乱するクラウディウスを嘲笑うように、無慈悲にも術は完成した。",
   "ko_candidate": "제정신이 아닌 클라우디우스를 조롱하듯이､ 무자비하게도 술식이 완성되었다｡"
  },
  {
   "id": 29045,
   "key": "D1210al.txt:249",
   "file": "D1210al.txt",
   "line": 249,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「術種選択：魔砲弾」",
   "ko_candidate": "「술종선택: 마포탄」"
  },
  {
   "id": 29046,
   "key": "D1210al.txt:255",
   "file": "D1210al.txt",
   "line": 255,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 29047,
   "key": "D1210al.txt:268",
   "file": "D1210al.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "文字通り、粉微塵だった。",
   "ko_candidate": "말 그대로､ 산산조각이었다｡"
  },
  {
   "id": 29048,
   "key": "D1210al.txt:269",
   "file": "D1210al.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーは、細かい細かい破片に噛み砕かれて、四散した。",
   "ko_candidate": "로드 비야키는 아주 작은 파편으로 갈갈이 찢겨 사방으로 흩어졌다｡"
  },
  {
   "id": 29049,
   "key": "D1210al.txt:273",
   "file": "D1210al.txt",
   "line": 273,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ粉砕する事だけに特化した、愛想も糞もない、淡々とした一撃だった。",
   "ko_candidate": "오로지 분쇄하는 것에만 특화된､ 정이라고는 찾아볼 수 없는､ 담담한 일격이었다｡"
  },
  {
   "id": 29050,
   "key": "D1210al.txt:281",
   "file": "D1210al.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滅ぼした相手には露ほどにも興味がないと言った風に、ネームレス・ワンはデモンベインに向き直った。",
   "ko_candidate": "멸망시킨 상대에게는 조금의 관심도 없다는 듯이､ 네임리스 원은 데몬베인을 향해 돌아섰다｡"
  },
  {
   "id": 29051,
   "key": "D1210al.txt:284",
   "file": "D1210al.txt",
   "line": 284,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……ああ……あ……ッ！」",
   "ko_candidate": "「아……아아……아……읏!」"
  },
  {
   "id": 29052,
   "key": "D1210al.txt:286",
   "file": "D1210al.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦慄が脳を、臓腑を掻き混ぜながら、乱舞する。",
   "ko_candidate": "전율이 뇌를､ 장기를 헤집으며､ 난무한다｡"
  },
  {
   "id": 29053,
   "key": "D1210al.txt:287",
   "file": "D1210al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "似ている……この感覚、マスターテリオンの時と！",
   "ko_candidate": "닮았어…… 이 감각､ 마스터 테리온 때와!"
  },
  {
   "id": 29054,
   "key": "D1210al.txt:290",
   "file": "D1210al.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――――――――――――。",
   "ko_candidate": "――――――――――――｡"
  },
  {
   "id": 29055,
   "key": "D1210al.txt:293",
   "file": "D1210al.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "沈黙が訪れた。",
   "ko_candidate": "침묵이 찾아왔다｡"
  },
  {
   "id": 29056,
   "key": "D1210al.txt:295",
   "file": "D1210al.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "張り詰める緊張の糸。",
   "ko_candidate": "팽팽하게 당겨진 긴장의 실｡"
  },
  {
   "id": 29057,
   "key": "D1210al.txt:296",
   "file": "D1210al.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凍る時間。",
   "ko_candidate": "얼어붙은 시간｡"
  }
 ]
}