  {
   "id": 17250,
   "key": "D0819le.txt:150",
   "file": "D0819le.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ネームレス・ワンの頭頂部で『暴君』が笑う。",
   "ko_candidate": "네임리스 원의 정상부에서 『폭군』이 웃는다｡"
