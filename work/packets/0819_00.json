  {
   "id": 17251,
   "key": "D0819le.txt:152",
   "file": "D0819le.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "重症を負っているようだった。拘束具のあちこちから血を流している。",
   "ko_candidate": "중상을 입은 것 같았다｡ 구속구 여기저기에서 피를 흘리고 있다｡"
  },
  {
   "id": 17252,
   "key": "D0819le.txt:154",
   "file": "D0819le.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "血塗れだ。",
   "ko_candidate": "피투성이다｡"
  },
  {
   "id": 17253,
   "key": "D0819le.txt:159",
   "file": "D0819le.txt",
   "line": 159,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「な、るほどね…… これ、が…… 九郎の力、か……」 「こんなにも、 強く……なったんだ。 これな、ら……終われる」",
   "ko_candidate": "「그､ 렇구나……이게……쿠로의 힘､ 인가…… 이렇게나､ 강해……졌구나｡ 이러면､ 끝낼 수 있어｡ 끝낼 수 있을 것 같아……하하하하……」"
  },
  {
   "id": 17254,
   "key": "D0819le.txt:169",
   "file": "D0819le.txt",
   "line": 169,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「終われそうだよ…… はははは……」 血塗れのまま、笑っている。",
   "ko_candidate": "피투성이인 채로､ 웃고 있다｡"
  },
  {
