 },
 "items": [
  {
   "id": 40020,
   "key": "D1413al.txt:146",
   "file": "D1413al.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "限界まで高まった緊張。 ふとした拍子で全員が恐慌に陥りかねない。",
   "ko_candidate": "한계까지 고조된 긴장｡ 사소한 박자에 모두가 공황에 빠질 수 있다｡"
  },
  {
   "id": 40021,
   "key": "D1413al.txt:149",
   "file": "D1413al.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "原初の恐怖の前には、 人間の小賢しい理性も知恵も倫理も無力だ。",
   "ko_candidate": "원초의 공포 앞에서는 인간의 소리한 이성도 지혜도 윤리도 무력하다｡"
  },
  {
   "id": 40022,
   "key": "D1413al.txt:151",
   "file": "D1413al.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "出来ることはただ、崩壊を待つだけの、 脆弱な忍耐のみ。",
   "ko_candidate": "할 수 있는 것은 단지 붕괴를 기다리는 것뿐인 취약한 인내뿐｡"
  },
  {
   "id": 40023,
   "key": "D1413al.txt:154",
   "file": "D1413al.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "立っていられないほどに膝が笑っている。",
   "ko_candidate": "서 있을 수 없을 정도로 무릎이 떨리고 있다｡"
  },
  {
   "id": 40024,
   "key": "D1413al.txt:155",
   "file": "D1413al.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遂に瑠璃は限界に達していた。",
   "ko_candidate": "마침내 루리는 한계에 도달했다｡"
  },
  {
   "id": 40025,
   "key": "D1413al.txt:157",
   "file": "D1413al.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あと一押しで、全てが決壊する。",
   "ko_candidate": "한 번만 더 밀어붙이면 모든 것이 결괴할 것이다｡"
  },
  {
   "id": 40026,
   "key": "D1413al.txt:158",
   "file": "D1413al.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてそれは瞬く間に全員に伝播するだろう。",
   "ko_candidate": "그리고 그것은 눈 깜짝할 사이에 모두에게 전파될 것이다｡"
  },
  {
   "id": 40027,
   "key": "D1413al.txt:159",
   "file": "D1413al.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……",
   "ko_candidate": "하지만……"
  },
  {
   "id": 40028,
   "key": "D1413al.txt:165",
   "file": "D1413al.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼は瑠璃の傍らに立った。",
   "ko_candidate": "그가 루리의 곁에 섰다｡"
  },
  {
   "id": 40029,
   "key": "D1413al.txt:166",
   "file": "D1413al.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつもと同じように、それが当たり前だと、 朝日が東から昇るのと同様、それがごくごく自然な",
   "ko_candidate": "언제나와 같이､ 그것이 당연하다고､ 아침 해가 동쪽에서 뜨는 것과 마찬가지로､ 그것이 지극히 자연스러운 일이라고 알리듯이､ 거기에 서 있었다｡"
  },
  {
   "id": 40030,
   "key": "D1413al.txt:168",
   "file": "D1413al.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ことであると告げるように、そこに立っていた。 しかしそこから次の行動がほんの少しだけ違っていた。",
   "ko_candidate": "하지만 거기서 다음 행동이 아주 조금만 달랐다｡"
  },
  {
   "id": 40031,
   "key": "D1413al.txt:172",
   "file": "D1413al.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あくまで優しく、静かに、穏やかに、 彼の包帯まみれの手が瑠璃の肩に置かれる。",
   "ko_candidate": "어디까지나 부드럽게､ 조용히､ 온화하게､ 그의 붕대 투성이의 손이 루리의 어깨에 놓인다｡"
  },
  {
   "id": 40032,
   "key": "D1413al.txt:178",
   "file": "D1413al.txt",
   "line": 178,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ！」",
   "ko_candidate": "「…………읏!」"
  },
  {
   "id": 40033,
   "key": "D1413al.txt:183",
   "file": "D1413al.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "振り向けば――怪我を押してルルイエまで付いて来た、 ウィンフィールドの顔があった。",
   "ko_candidate": "돌아보면―― 부상을 무릅쓰고 르뤼에까지 따라온 윈필드의 얼굴이 있었다｡"
  },
  {
   "id": 40034,
   "key": "D1413al.txt:185",
   "file": "D1413al.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "余計なことは何も言わない。",
   "ko_candidate": "쓸데없는 말은 아무것도 하지 않는다｡"
  },
  {
   "id": 40035,
   "key": "D1413al.txt:187",
   "file": "D1413al.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "長いこと一緒に居続けたのだ。 主人として、従者として。",
   "ko_candidate": "오랫동안 함께 있었다｡ 주인으로서､ 종복으로서｡"
  },
  {
   "id": 40036,
   "key": "D1413al.txt:189",
   "file": "D1413al.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから分かる。",
   "ko_candidate": "그래서 안다｡"
  },
  {
   "id": 40037,
   "key": "D1413al.txt:191",
   "file": "D1413al.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その雄弁な瞳を覗くだけで分かる。 瑠璃は頷いた。",
   "ko_candidate": "그 웅변적인 눈동자를 들여다보는 것만으로도 안다｡"
  },
  {
   "id": 40038,
   "key": "D1413al.txt:193",
   "file": "D1413al.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自分でも驚くくらいにぴたりと震えは止まっていた。",
   "ko_candidate": "루리는 고개를 끄덕였다｡ 스스로도 놀랄 정도로 딱 떨림이 멈췄다｡"
  },
  {
   "id": 40039,
   "key": "D1413al.txt:195",
   "file": "D1413al.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何の揺らぎも無い、落ち着いた声で指示を飛ばす。",
   "ko_candidate": "어떤 흔들림도 없는 침착한 목소리로 지시를 내린다｡"
  },
  {
   "id": 40040,
   "key": "D1413al.txt:196",
   "file": "D1413al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一同の目が彼女に集中した。",
   "ko_candidate": "일동의 눈이 그녀에게 집중되었다｡"
  },
  {
   "id": 40041,
   "key": "D1413al.txt:200",
   "file": "D1413al.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皆が見たのは恐怖に竦む少女瑠璃ではない。",
   "ko_candidate": "모두가 본 것은 공포에 움츠러든 소녀 루리가 아니다｡"
  },
  {
   "id": 40042,
   "key": "D1413al.txt:201",
   "file": "D1413al.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "世界に名立たる覇道財閥の総帥、世界経済の頂点に 立つ人類の王。",
   "ko_candidate": "세계에 이름을 날리는 하도 재벌의 총수､ 세계 경제의 정점에 선 인류의 왕｡"
  },
  {
   "id": 40043,
   "key": "D1413al.txt:203",
   "file": "D1413al.txt",
   "line": 203,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『覇道瑠璃』がそこに立っていた。",
   "ko_candidate": "『하도 루리』가 거기에 서 있었다｡"
  },
  {
   "id": 40044,
   "key": "D1413al.txt:209",
   "file": "D1413al.txt",
   "line": 209,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ありがとう……大丈夫です。わたくしは大十字さんを、アルを……そしてお爺様のデモンベインを信じます」",
   "ko_candidate": "「고마워요…… 괜찮습니다｡ 저는 다이쥬지 씨를､ 알을…… 그리고 할아버지의 데몬베인을 믿습니다」"
  },
  {
   "id": 40045,
   "key": "D1413le.txt:12",
   "file": "D1413le.txt",
   "line": 12,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおおおおおお！」",
   "ko_candidate": "「우오오오오오오오오!」"
  },
  {
   "id": 40046,
   "key": "D1413le.txt:16",
   "file": "D1413le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空薬莢が派手な水飛沫を上げながら、血の海に落ちる。",
   "ko_candidate": "빈 탄피가 화려한 물보라를 일으키며 피바다에 떨어진다｡"
  },
  {
   "id": 40047,
   "key": "D1413le.txt:18",
   "file": "D1413le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マズル・フラッシュが視界を灼いた。",
   "ko_candidate": "머즐 플래시가 시야를 태웠다｡"
  },
  {
   "id": 40048,
   "key": "D1413le.txt:19",
   "file": "D1413le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴の鬼械神に、銃弾の雨を降らせる。",
   "ko_candidate": "놈의 귀계신에 총알비를 퍼붓는다｡"
  },
  {
   "id": 40049,
   "key": "D1413le.txt:20",
   "file": "D1413le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 40050,
   "key": "D1413le.txt:30",
   "file": "D1413le.txt",
   "line": 30,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……その程度で、このレガシー・オブ・ゴールドを撃ち破れるとでも？」",
   "ko_candidate": "「……그 정도로 이 레거시 오브 골드를 격파할 수 있다고?」"
  },
  {
   "id": 40051,
   "key": "D1413le.txt:34",
   "file": "D1413le.txt",
   "line": 34,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「なっ……!?」",
   "ko_candidate": "「뭐……!?」"
  },
  {
   "id": 40052,
   "key": "D1413le.txt:40",
   "file": "D1413le.txt",
   "line": 40,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何だって!?」",
   "ko_candidate": "「뭐라고!?」"
  },
  {
   "id": 40053,
   "key": "D1413le.txt:43",
   "file": "D1413le.txt",
   "line": 43,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『クトゥグア』と『イタクァ』の大火力を浴びながら、だが金色の鬼械神は傷一つ負う事なく、燦々と輝いていた。",
   "ko_candidate": "『크투가』와 『이타콰』의 대화력을 맞으면서도､ 하지만 황금빛 귀계신은 상처 하나 입지 않고 찬란히 빛나고 있었다｡"
  },
  {
   "id": 40054,
   "key": "D1413le.txt:46",
   "file": "D1413le.txt",
   "line": 46,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「馬鹿な！　いくら何でも無傷ってことは……！」",
   "ko_candidate": "「말도 안 돼! 아무리 그래도 무상처라니……!」"
  },
  {
   "id": 40055,
   "key": "D1413le.txt:51",
   "file": "D1413le.txt",
   "line": 51,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「つくづく御目出度い連中だな――」",
   "ko_candidate": "「정말 눈 뜨고 볼 수 없는 녀석들이군――」"
  },
  {
   "id": 40056,
   "key": "D1413le.txt:55",
   "file": "D1413le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アウグストゥスの言葉を、エグゾーストの咆吼が掻き消した。",
   "ko_candidate": "아우구스투스의 말을 배기음의 포효가 지워버렸다｡"
  },
  {
   "id": 40057,
   "key": "D1413le.txt:56",
   "file": "D1413le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――サンダルフォン!?",
   "ko_candidate": "――산달폰!?"
  },
  {
   "id": 40058,
   "key": "D1413le.txt:60",
   "file": "D1413le.txt",
   "line": 60,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「疾ィィッ――――！」",
   "ko_candidate": "「가아아앗――――!」"
  },
  {
   "id": 40059,
   "key": "D1413le.txt:67",
   "file": "D1413le.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アウグストゥスと交わす言葉も無かったサンダルフォンが、敢然と自らの数十倍の巨体に襲いかかる。",
   "ko_candidate": "아우구스투스와 말을 나눌 틈도 없었던 산달폰이 과감하게 자신의 수십 배 거대한 몸체에 달려든다｡"
  }
 ]
}