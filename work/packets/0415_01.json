   "file": "D0415.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の心臓が高鳴る。",
   "ko_candidate": "내 심장이 고동친다｡"
  },
  {
   "id": 5955,
   "key": "D0415.txt:296",
