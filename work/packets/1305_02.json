   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無駄　無駄だよ",
   "ko_candidate": "헛수고 헛수고야"
  },
  {
   "id": 32288,
   "key": "D1305al.txt:203",
   "file": "D1305al.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黙れ",
   "ko_candidate": "닥쳐"
  },
  {
   "id": 32289,
   "key": "D1305al.txt:204",
   "file": "D1305al.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "病が、病が来る、あの混沌",
   "ko_candidate": "병이､ 병이 온다､ 저 혼돈"
  },
  {
   "id": 32290,
   "key": "D1305al.txt:206",
   "file": "D1305al.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "お前に　いつか届く事を",
   "ko_candidate": "너에게 언젠가 닿기를"
  },
  {
   "id": 32291,
   "key": "D1305al.txt:207",
   "file": "D1305al.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それもまた台本",
   "ko_candidate": "그것 또한 대본"
  },
  {
   "id": 32292,
   "key": "D1305al.txt:208",
   "file": "D1305al.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "信じ",
   "ko_candidate": "믿어"
  },
  {
   "id": 32293,
   "key": "D1305al.txt:209",
   "file": "D1305al.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "道化芝居　三文芝居",
   "ko_candidate": "광대극 삼류극"
  },
  {
   "id": 32294,
   "key": "D1305al.txt:210",
   "file": "D1305al.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黙れ。黙れ。黙れ。遮断。遮断。遮断。",
   "ko_candidate": "닥쳐｡ 닥쳐｡ 닥쳐｡ 차단｡ 차단｡ 차단｡"
  },
  {
   "id": 32295,
   "key": "D1305al.txt:211",
   "file": "D1305al.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "君は舞台裏の雑用だ",
   "ko_candidate": "너는 무대 뒤의 잡일꾼이야"
  },
  {
   "id": 32296,
   "key": "D1305al.txt:213",
   "file": "D1305al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔物の咆吼！",
   "ko_candidate": "마물의 포후!"
  },
  {
   "id": 32297,
   "key": "D1305al.txt:214",
   "file": "D1305al.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔物の咆吼！",
   "ko_candidate": "마물의 포후!"
  },
  {
   "id": 32298,
   "key": "D1305al.txt:215",
   "file": "D1305al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔物の咆吼！",
   "ko_candidate": "마물의 포후!"
  },
  {
   "id": 32299,
   "key": "D1305al.txt:216",
   "file": "D1305al.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "役者を揃えてもらわねば",
   "ko_candidate": "배우들을 모아야 해"
  },
  {
   "id": 32300,
   "key": "D1305al.txt:217",
   "file": "D1305al.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これより　パパの　伝える　話でちゅ――黙れ！",
   "ko_candidate": "이제부터 아빠가 전하는 이야기예요―― 닥쳐!"
  },
  {
   "id": 32301,
   "key": "D1305al.txt:233",
   "file": "D1305al.txt",
   "line": 233,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『魔物の咆吼！』",
   "ko_candidate": "『마물의 포후!』"
  },
  {
   "id": 32302,
   "key": "D1305al.txt:240",
   "file": "D1305al.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――お前はその瞬間に対峙するとき、",
   "ko_candidate": "――넌 그 순간에 맞닥뜨릴 때､"
  },
  {
   "id": 32303,
   "key": "D1305al.txt:241",
   "file": "D1305al.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正しく真実に辿り着かなければならない。",
   "ko_candidate": "올바르게 진실에 도달해야만 해｡"
  },
  {
   "id": 32304,
   "key": "D1305al.txt:254",
   "file": "D1305al.txt",
   "line": 254,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何が……起こっておる!?」",
   "ko_candidate": "「무슨 일이… 일어나고 있는 거지!?」"
  },
  {
   "id": 32305,
   "key": "D1305al.txt:257",
   "file": "D1305al.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "膨大な情報（神様へ　この章は検閲済みです。御安心して彼女にお与え下さい）が疾走する。",
   "ko_candidate": "방대한 정보(신님께 이 장은 검열 완료되었습니다｡ 안심하시고 그녀에게 주시기 바랍니다)가 질주한다｡"
  },
  {
   "id": 32306,
   "key": "D1305al.txt:279",
   "file": "D1305al.txt",
   "line": 279,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あああああああああああああ！」 「頭が……頭が割れる……ッ！ 何が……ッ！」",
   "ko_candidate": "「아아아아아아아아아아아아! 머리가… 머리가 깨질 것 같아…! 뭐가… 이거!」"
  },
  {
   "id": 32307,
   "key": "D1305al.txt:289",
   "file": "D1305al.txt",
   "line": 289,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "【獣について】",
   "ko_candidate": "【짐승에 대해】"
  },
  {
   "id": 32308,
   "key": "D1305al.txt:292",
   "file": "D1305al.txt",
   "line": 292,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "獣は王なり。",
   "ko_candidate": "짐승은 왕이다｡"
  },
  {
   "id": 32309,
   "key": "D1305al.txt:293",
   "file": "D1305al.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒き王なり。",
   "ko_candidate": "검은 왕이다｡"
  },
  {
   "id": 32310,
   "key": "D1305al.txt:294",
   "file": "D1305al.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "運命の輪を廻す者なり。",
   "ko_candidate": "운명의 수레바퀴를 돌리는 자다｡"
  },
  {
   "id": 32311,
   "key": "D1305al.txt:295",
   "file": "D1305al.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "輪廻の蛇を繋ぐ者なり。",
   "ko_candidate": "윤회의 뱀을 잇는 자다｡"
  },
  {
   "id": 32312,
   "key": "D1305al.txt:296",
   "file": "D1305al.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其はそれは単に一つの時猫の瞳念が持銃弾つ最も包解体括的で無制約な領玩具――",
   "ko_candidate": "그것은 단순히 하나의 시간고양이의 눈념이 가진 가장 포해체괄적이고 무제약한 영장난감――"
  },
  {
   "id": 32313,
   "key": "D1305al.txt:297",
   "file": "D1305al.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "停止。",
   "ko_candidate": "정지｡"
  },
  {
   "id": 32314,
   "key": "D1305al.txt:298",
   "file": "D1305al.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "獣が獣を生む矛盾の螺旋を――",
   "ko_candidate": "짐승이 짐승을 낳는 모순의 나선을――"
  },
  {
   "id": 32315,
   "key": "D1305al.txt:299",
   "file": "D1305al.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは矛盾では無い。",
   "ko_candidate": "그것은 모순이 아니다｡"
  },
  {
   "id": 32316,
   "key": "D1305al.txt:300",
   "file": "D1305al.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否、獣の親は獣であり獣の子は獣である矛盾。",
   "ko_candidate": "아니､ 짐승의 부모는 짐승이고 짐승의 자식은 짐승인 모순｡"
  },
  {
   "id": 32317,
   "key": "D1305al.txt:302",
   "file": "D1305al.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは矛盾では無――やはり検閲されている。 即ち――",
   "ko_candidate": "그것은 모순이 아――역시 검열되고 있다｡ 즉――"
  },
  {
   "id": 32318,
   "key": "D1305al.txt:304",
   "file": "D1305al.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ヒトはヒトを生む当然。",
   "ko_candidate": "인간은 인간을 낳는 당연｡"
  },
  {
   "id": 32319,
   "key": "D1305al.txt:305",
   "file": "D1305al.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "つまりヒトの親はヒトであり ヒトの子はヒトである当然。",
   "ko_candidate": "즉 인간의 부모는 인간이고 인간의 자식은 인간인 당연｡"
  },
  {
   "id": 32320,
   "key": "D1305al.txt:307",
   "file": "D1305al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否。停止。",
   "ko_candidate": "아니｡ 정지｡"
  },
  {
   "id": 32321,
   "key": "D1305al.txt:308",
   "file": "D1305al.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……中枢域まで汚染が拡大している。",
   "ko_candidate": "…중추 영역까지 오염이 확대되고 있다｡"
  },
  {
   "id": 32322,
   "key": "D1305al.txt:310",
   "file": "D1305al.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "忌々しい、あの混――否？　サルがヒトを生む？",
   "ko_candidate": "괘씸하군､ 저 혼――아니? 원숭이가 인간을 낳는다?"
  },
  {
   "id": 32323,
   "key": "D1305al.txt:311",
   "file": "D1305al.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "即ちヒトの親はサルであり サルの子はヒ――妨害が激しい――",
   "ko_candidate": "즉 인간의 부모는 원숭이고 원숭이의 자식은 인――방해가 심하다――"
  },
  {
   "id": 32324,
   "key": "D1305al.txt:313",
   "file": "D1305al.txt",
   "line": 313,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "えーと、卵が先か鶏が先かの話だっけ？――ここまで。",
   "ko_candidate": "음､ 달걀이 먼저냐 닭이 먼저냐 하는 얘기였나?――여기까지｡"
  },
  {
   "id": 32325,
   "key": "D1305al.txt:314",
   "file": "D1305al.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これ以上は無理だ――最後のはヒン――ともかく",
   "ko_candidate": "이 이상은 무리다――마지막은 힌――어쨌든 유의해야 한다｡"
  }
 ]
}