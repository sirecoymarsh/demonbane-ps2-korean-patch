 "items": [
  {
   "id": 50613,
   "key": "ep_ruri02a.txt:320",
   "file": "ep_ruri02a.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "擦り切れていく心が怖い。",
   "ko_candidate": ""
  },
  {
   "id": 50614,
   "key": "ep_ruri02a.txt:324",
   "file": "ep_ruri02a.txt",
   "line": 324,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「わたくし……そんなに我慢強い方ではありませんよ？」",
   "ko_candidate": ""
  },
  {
   "id": 50615,
   "key": "ep_ruri02a.txt:327",
   "file": "ep_ruri02a.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "指先でペンを転がしながら、拗ねてみる。",
   "ko_candidate": ""
  },
  {
   "id": 50616,
   "key": "ep_ruri02a.txt:331",
   "file": "ep_ruri02a.txt",
   "line": 331,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「わたくしを何処の誰だと思っていますか？　覇道財閥の総帥、覇道瑠璃ですわよ？　とっても偉いんですわよ？　畏れ多いですわよ？　それを、それを、こんなにも待たせてしまうなんて……本当、怖いもの知らずですね。九郎？」",
   "ko_candidate": ""
  },
  {
   "id": 50617,
   "key": "ep_ruri02a.txt:334",
   "file": "ep_ruri02a.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "独りぼやいていると、沸々と怒りが湧いてきた。 そうよ。",
   "ko_candidate": "아직이다｡"
  },
  {
   "id": 50618,
   "key": "ep_ruri02a.txt:336",
   "file": "ep_ruri02a.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "なんで私ばかり、こんな想いをしなければならないの。",
   "ko_candidate": ""
  },
  {
   "id": 50619,
   "key": "ep_ruri02a.txt:340",
   "file": "ep_ruri02a.txt",
   "line": 340,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「帰ってきたら、じっくりと教育して差し上げませんと。 あの人は……こっちが、しおらしくしていれば、何処までも調子に乗ってっ。 ……そうそう。そうでした。そうでしたわ。九郎は初めて出会った頃から、自分勝手な人でしたわ。 わたくしに逆らう事がどれだけ恐ろしい事なのか、思い知らせてあげますっ」",
   "ko_candidate": ""
  },
  {
   "id": 50620,
   "key": "ep_ruri02a.txt:348",
   "file": "ep_ruri02a.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ペンを強く強く……腕が震えるほど、強く握り締めていた。",
   "ko_candidate": ""
  },
  {
   "id": 50621,
   "key": "ep_ruri02a.txt:350",
   "file": "ep_ruri02a.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ベキッと嫌な音を立てる。",
   "ko_candidate": ""
  },
  {
   "id": 50622,
   "key": "ep_ruri02a.txt:352",
   "file": "ep_ruri02a.txt",
   "line": 352,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ひとしきり怒ると、何だか力が抜けてきた。",
   "ko_candidate": ""
  },
  {
   "id": 50623,
   "key": "ep_ruri02a.txt:353",
   "file": "ep_ruri02a.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "壊れたペンは手のひらから落ちて、机の上を転がる。",
   "ko_candidate": ""
  },
  {
   "id": 50624,
   "key": "ep_ruri02a.txt:360",
   "file": "ep_ruri02a.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "――何を熱くなっているんだ、私は。",
   "ko_candidate": ""
  },
  {
   "id": 50625,
   "key": "ep_ruri02a.txt:362",
   "file": "ep_ruri02a.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何故、あんな薄情な男に其処まで拘る必要がある？",
   "ko_candidate": ""
  },
  {
   "id": 50626,
   "key": "ep_ruri02a.txt:363",
   "file": "ep_ruri02a.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そうだ、馬鹿馬鹿しい。",
   "ko_candidate": ""
  },
  {
   "id": 50627,
   "key": "ep_ruri02a.txt:364",
   "file": "ep_ruri02a.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "九郎のことなど、忘れて、人生を楽しめば良いではないか。",
   "ko_candidate": ""
  },
  {
   "id": 50628,
   "key": "ep_ruri02a.txt:371",
   "file": "ep_ruri02a.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "机を両手で叩いて、一気に身を起こす。",
   "ko_candidate": ""
  },
  {
   "id": 50629,
   "key": "ep_ruri02a.txt:372",
   "file": "ep_ruri02a.txt",
   "line": 372,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "自らを奮い立たせるように、握り拳を振り上げながら、誰に向けてでもなく宣言する。",
   "ko_candidate": ""
  },
  {
   "id": 50630,
   "key": "ep_ruri02a.txt:376",
   "file": "ep_ruri02a.txt",
   "line": 376,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そうですわ！　あんな程度の男に縛られて、この美貌と才覚を腐らせておくのは人類の損失ですもの！ ええ！　もう九郎なんて知りません！　あんな男、ゴミのようにポポーイッと棄ててやりますわ！」",
   "ko_candidate": ""
  },
  {
   "id": 50631,
   "key": "ep_ruri02a.txt:380",
   "file": "ep_ruri02a.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "回れ右。 背後の窓に向かって、歩き出す。",
   "ko_candidate": "그 말을 하는 것은､ 옳지 않다｡"
  },
  {
   "id": 50632,
   "key": "ep_ruri02a.txt:382",
   "file": "ep_ruri02a.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "街を見下ろしながら、大声で",
   "ko_candidate": ""
  },
  {
   "id": 50633,
   "key": "ep_ruri02a.txt:386",
   "file": "ep_ruri02a.txt",
   "line": 386,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「九郎の馬鹿ぁぁぁぁぁぁぁぁぁぁぁぁぁぁぁぁぁぁ――――――っ！」",
   "ko_candidate": ""
  },
  {
   "id": 50634,
   "key": "ep_ruri02a.txt:389",
   "file": "ep_ruri02a.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "叫んだ。 力の限り叫んだ。",
   "ko_candidate": "사라져가는 것도､ 잘못됐다｡"
  },
  {
   "id": 50635,
   "key": "ep_ruri02a.txt:392",
   "file": "ep_ruri02a.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "誰かに聴かれていたら、脳の心配されるのは間違いなしだったけど、構わず叫んだ。",
   "ko_candidate": ""
  },
  {
   "id": 50636,
   "key": "ep_ruri02a.txt:394",
   "file": "ep_ruri02a.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "息が続く限り叫んだ。",
   "ko_candidate": ""
  },
  {
   "id": 50637,
   "key": "ep_ruri02a.txt:395",
   "file": "ep_ruri02a.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "息が途切れても、無理矢理に振り絞って叫んだ。",
   "ko_candidate": ""
  },
  {
   "id": 50638,
   "key": "ep_ruri02a.txt:397",
   "file": "ep_ruri02a.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "力の限り、叫んだ。",
   "ko_candidate": ""
  },
  {
   "id": 50639,
   "key": "ep_ruri02a.txt:398",
   "file": "ep_ruri02a.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "叫んで、叫んで、叫び尽くして――だけど。",
   "ko_candidate": ""
  },
  {
   "id": 50640,
   "key": "ep_ruri02a.txt:402",
   "file": "ep_ruri02a.txt",
   "line": 402,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………うぅ」 何だか目頭が熱い。",
   "ko_candidate": "「아직､ 끝나지 않았습니다」"
  },
  {
   "id": 50641,
   "key": "ep_ruri02a.txt:409",
   "file": "ep_ruri02a.txt",
   "line": 409,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「うぐ……うぅ……ぁぁ……」",
   "ko_candidate": ""
  },
  {
   "id": 50642,
   "key": "ep_ruri02a.txt:412",
   "file": "ep_ruri02a.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "視界がぼやけて、何も見えない。",
   "ko_candidate": ""
  },
  {
   "id": 50643,
   "key": "ep_ruri02a.txt:416",
   "file": "ep_ruri02a.txt",
   "line": 416,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「うあぁ……うわああぁ……あああぁぁ……っ！」",
   "ko_candidate": ""
  },
  {
   "id": 50644,
   "key": "ep_ruri02a.txt:419",
   "file": "ep_ruri02a.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "熱い雫が頬を伝う。",
   "ko_candidate": ""
  },
  {
   "id": 50645,
   "key": "ep_ruri02a.txt:420",
   "file": "ep_ruri02a.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "一滴伝えば、あとは崩れるように、ぼろぼろぼろぼろ、と。",
   "ko_candidate": ""
  },
  {
   "id": 50646,
   "key": "ep_ruri02a.txt:424",
   "file": "ep_ruri02a.txt",
   "line": 424,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ああああぁぁぁ！　わあぁぁぁぁぁ！　うわああぁぁぁぁんっ！」",
   "ko_candidate": ""
  },
  {
   "id": 50647,
   "key": "ep_ruri02a.txt:427",
   "file": "ep_ruri02a.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "泣き声が、嗄れたはずの咽喉から、迸る。",
   "ko_candidate": ""
  },
  {
   "id": 50648,
   "key": "ep_ruri02a.txt:429",
   "file": "ep_ruri02a.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "泣いた。 泣いた。",
   "ko_candidate": "끝나지 않았다｡"
  },
  {
   "id": 50649,
   "key": "ep_ruri02a.txt:431",
   "file": "ep_ruri02a.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "泣き崩れた。",
   "ko_candidate": ""
  },
  {
   "id": 50650,
   "key": "ep_ruri02a.txt:433",
   "file": "ep_ruri02a.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "まるで子どものように、形振り構わず、泣き続けた。",
   "ko_candidate": ""
  },
  {
   "id": 50651,
   "key": "ep_ruri02a.txt:435",
   "file": "ep_ruri02a.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "――忘れられるはずがなかった。",
   "ko_candidate": ""
  },
  {
   "id": 50652,
   "key": "ep_ruri02a.txt:439",
