{
 "packet": "ep_leica01_05",
 "scene": "ep_leica01",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "九郎ちゃん": "쿠로 군"
 },
 "items": [
  {
   "id": 49869,
   "key": "ep_leica01.txt:716",
   "file": "ep_leica01.txt",
   "line": 716,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "決してその場所に行ってしまうことはないだろう。",
   "ko_candidate": "결코 그 장소로 가버리지는 않을 거라고｡"
  },
  {
   "id": 49870,
   "key": "ep_leica01.txt:718",
   "file": "ep_leica01.txt",
   "line": 718,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "遠い何かを閉じ込めながら、 それでも九郎ちゃんの瞳は、",
   "ko_candidate": "먼 무언가를 가두면서､ 그래도 쿠로 군의 눈동자는､"
  },
  {
   "id": 49871,
   "key": "ep_leica01.txt:720",
   "file": "ep_leica01.txt",
   "line": 720,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "未来へと向けられている。",
   "ko_candidate": "미래를 향하고 있다｡"
  },
  {
   "id": 49872,
   "key": "ep_leica01.txt:723",
   "file": "ep_leica01.txt",
   "line": 723,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "来るべき明日を愛している。",
   "ko_candidate": "다가올 내일을 사랑하고 있다｡"
  },
  {
   "id": 49873,
   "key": "ep_leica01.txt:724",
   "file": "ep_leica01.txt",
   "line": 724,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "目に映る世界の総てを愛している。",
   "ko_candidate": "눈에 비치는 세상의 모든 것을 사랑하고 있다｡"
  },
  {
   "id": 49874,
   "key": "ep_leica01.txt:726",
   "file": "ep_leica01.txt",
   "line": 726,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎ちゃんは、きっと、私たちのいるこの世界を、 愛して守り続ける。",
   "ko_candidate": "쿠로 군은､ 분명､ 우리가 있는 이 세상을､ 사랑하며 지켜나갈 거야｡"
  },
  {
   "id": 49875,
   "key": "ep_leica01.txt:729",
   "file": "ep_leica01.txt",
   "line": 729,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ついでに、ふと夢想する。",
   "ko_candidate": "덧붙여､ 문득 상상한다｡"
  },
  {
   "id": 49876,
   "key": "ep_leica01.txt:730",
   "file": "ep_leica01.txt",
   "line": 730,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "突拍子もない夢想だ。",
   "ko_candidate": "터무니없는 상상이다｡"
  },
  {
   "id": 49877,
   "key": "ep_leica01.txt:732",
   "file": "ep_leica01.txt",
   "line": 732,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "九郎ちゃんが背負う遠い何か、それは私の内にも在るものだとしたら？",
   "ko_candidate": "쿠로 군이 짊어진 먼 무언가､ 그것이 내 안에도 있는 것"
  },
  {
   "id": 49878,
   "key": "ep_leica01.txt:734",
   "file": "ep_leica01.txt",
   "line": 734,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただそれを忘れ去ってしまったのだとしたら？",
   "ko_candidate": "이라면? 만약 그걸 잊어버렸다면?"
  },
  {
   "id": 49879,
   "key": "ep_leica01.txt:735",
   "file": "ep_leica01.txt",
   "line": 735,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "九郎ちゃんだけが忘れずに、独り背負い続けているのだとしたら――",
   "ko_candidate": "쿠로 군만이 잊지 않고､ 혼자서 계속 짊어지고 있다면――"
  },
  {
   "id": 49880,
   "key": "ep_leica01.txt:742",
   "file": "ep_leica01.txt",
   "line": 742,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だとしたら――",
   "ko_candidate": "그렇다면――"
  },
  {
   "id": 49881,
   "key": "ep_leica01.txt:742",
   "file": "ep_leica01.txt",
   "line": 742,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私は、多分、罪を背負った。",
   "ko_candidate": "나는､ 아마도､ 죄를 짊어졌다｡"
  },
  {
   "id": 49882,
   "key": "ep_leica01.txt:743",
   "file": "ep_leica01.txt",
   "line": 743,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "決して償い切れない罪を背負った。",
   "ko_candidate": "결코 갚을 수 없는 죄를 짊어졌다｡"
  },
  {
   "id": 49883,
   "key": "ep_leica01.txt:745",
   "file": "ep_leica01.txt",
   "line": 745,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だったら、一生をかけて彼に償い続けよう。",
   "ko_candidate": "그렇다면､ 평생을 바쳐 그에게 속죄해야겠다｡"
  },
  {
   "id": 49884,
   "key": "ep_leica01.txt:746",
   "file": "ep_leica01.txt",
   "line": 746,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "九郎ちゃんがそうするように、私も彼を愛して守り続けよう。",
   "ko_candidate": "쿠로 군이 그러듯이､ 나도 그를 사랑하고 계속 지켜야겠다｡"
  },
  {
   "id": 49885,
   "key": "ep_leica01.txt:748",
   "file": "ep_leica01.txt",
   "line": 748,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "もしもまた、遠い何かが融け出して、九郎ちゃんを苛むのなら、私はまた彼を抱き締めれば良い。",
   "ko_candidate": "만약 또다시､ 먼 무언가가 녹아내려､ 쿠로 군을 괴롭힌다면､ 나는 다시 그를 꼭 안으면 된다｡"
  },
  {
   "id": 49886,
   "key": "ep_leica01.txt:749",
   "file": "ep_leica01.txt",
   "line": 749,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "静かに泣き続ける九郎ちゃんを、決して手離さずに、抱き締めていれば良い。",
   "ko_candidate": "조용히 계속 울고 있는 쿠로 군을､ 결코 놓치지 않고､ 꼭 안고"
  },
  {
   "id": 49887,
   "key": "ep_leica01.txt:751",
   "file": "ep_leica01.txt",
   "line": 751,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうしながら生きてゆこう。",
   "ko_candidate": "있으면 된다｡ 그렇게 하면서 살아가자｡"
  },
  {
   "id": 49888,
   "key": "ep_leica01.txt:752",
   "file": "ep_leica01.txt",
   "line": 752,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎ちゃんと一緒に歩いてゆこう。",
   "ko_candidate": "쿠로 군과 함께 걸어가자｡"
  },
  {
   "id": 49889,
   "key": "ep_leica01.txt:754",
   "file": "ep_leica01.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この青空の下を",
   "ko_candidate": "이 푸른 하늘 아래를"
  },
  {
   "id": 49890,
   "key": "ep_leica01.txt:755",
   "file": "ep_leica01.txt",
   "line": 755,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "必死に",
   "ko_candidate": "필사적으로"
  },
  {
   "id": 49891,
   "key": "ep_leica01.txt:756",
   "file": "ep_leica01.txt",
   "line": 756,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "泣いて",
   "ko_candidate": "울면서"
  },
  {
   "id": 49892,
   "key": "ep_leica01.txt:757",
   "file": "ep_leica01.txt",
   "line": 757,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "笑って",
   "ko_candidate": "웃으면서"
  },
  {
   "id": 49893,
   "key": "ep_leica01.txt:759",
   "file": "ep_leica01.txt",
   "line": 759,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "生き足掻いて",
   "ko_candidate": "발버둥 치면서"
  },
  {
   "id": 49894,
   "key": "ep_leica01.txt:768",
   "file": "ep_leica01.txt",
   "line": 768,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――たとえ、 地べたを這いずり回ってでも。",
   "ko_candidate": "――설령､ 땅바닥을 기어다니면서라도｡"
  }
 ]
}