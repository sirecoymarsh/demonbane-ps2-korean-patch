  "rate": 0.81
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ベルゼビュート": "벨제뷰트",
  "大十字九郎": "다이쥬지 쿠로",
  "ティベリウス": "티베리우스",
  "クトゥグア": "크투가",
  "クトゥルー": "크툴루",
  "瑠璃": "루리",
  "メタトロン": "메타트론",
  "サンダルフォン": "산달폰"
 },
 "items": [
  {
   "id": 34642,
   "key": "D1310al.txt:240",
   "file": "D1310al.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ベルゼビュートの機体を左右対称、正確に両断する。",
   "ko_candidate": "벨제뷰트의 기체를 좌우대칭､ 정확하게 양단한다｡"
  },
  {
   "id": 34643,
   "key": "D1310al.txt:245",
   "file": "D1310al.txt",
   "line": 245,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「また……っ！　またもや…… 大十字九郎ッッッッ！ おのれがぁぁぁぁぁぁぁぁぁぁ！」",
   "ko_candidate": "「또……! 또다시…… 다이쥬지 쿠로! 네 녀석이이이이이이이이이이!」"
  },
  {
   "id": 34644,
   "key": "D1310al.txt:251",
   "file": "D1310al.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "両断されたベルゼビュートからティベリウスが飛び降りる。",
   "ko_candidate": "양단된 벨제뷰트에서 티베리우스가 뛰어내린다｡"
  },
  {
   "id": 34645,
   "key": "D1310al.txt:257",
   "file": "D1310al.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれよりも早く、クトゥグアを招喚――巨大な銃口をティベリウスに合わせた。",
   "ko_candidate": "하지만 그보다 더 빨리､ 크투가를 소환――거대한 총구를 티베리우스에게 겨눴다｡"
  },
  {
   "id": 34646,
   "key": "D1310al.txt:262",
   "file": "D1310al.txt",
   "line": 262,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「へっ……？」",
   "ko_candidate": "「헛……?」"
  },
  {
   "id": 34647,
   "key": "D1310al.txt:267",
   "file": "D1310al.txt",
   "line": 267,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「成仏しろよ」",
   "ko_candidate": "「극락에나 가라고」"
  },
  {
   "id": 34648,
   "key": "D1310al.txt:284",
   "file": "D1310al.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔弾は軌道上のティベリウスを巻き込んで、地面に着弾、爆音と共に土煙を巻き上げた。",
   "ko_candidate": "마탄은 궤도상의 티베리우스를 휘감아 지면에 착탄､ 폭음과 함께 흙먼지를 일으켰다｡"
  },
  {
   "id": 34649,
   "key": "D1310al.txt:284",
   "file": "D1310al.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遅れてベルゼビュートが大地に斃れる。",
   "ko_candidate": "뒤이어 벨제뷰트가 대지에 쓰러진다｡"
  },
  {
   "id": 34650,
   "key": "D1310al.txt:285",
   "file": "D1310al.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クトゥグアの銃口からは今だ硝煙が立ち昇っている。",
   "ko_candidate": "크투가의 총구에서는 아직도 화약 연기가 피어오르고 있다｡"
  },
  {
   "id": 34651,
   "key": "D1310al.txt:293",
   "file": "D1310al.txt",
   "line": 293,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これで跡形もねえだろ。 借りは返したぜ、ティベリウス」",
   "ko_candidate": "「이걸로 흔적도 없겠지｡ 빚은 갚았다､ 티베리우스」"
  },
  {
   "id": 34652,
   "key": "D1310al.txt:299",
   "file": "D1310al.txt",
   "line": 299,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「上出来だ。だが一息ついている場合ではないな」 「一刻も空の穢らわしい肉塊を処分せんことには」",
   "ko_candidate": "「잘했다｡ 하지만 한숨 돌릴 때가 아니야｡ 하루빨리 하늘의 더러운 살덩어리를 처분하지 않으면」"
  },
  {
   "id": 34653,
   "key": "D1310al.txt:309",
   "file": "D1310al.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "上空を見上げる。",
   "ko_candidate": "상공을 올려다본다｡"
  },
  {
   "id": 34654,
   "key": "D1310al.txt:311",
   "file": "D1310al.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "旧支配者クトゥルー。",
   "ko_candidate": "그레이트 올드 원 크툴루｡"
  },
  {
   "id": 34655,
   "key": "D1310al.txt:312",
   "file": "D1310al.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今は眠っているが、いつ動き出すか分からない。",
   "ko_candidate": "지금은 자고 있지만､ 언제 움직일지 모른다｡"
  },
  {
   "id": 34656,
   "key": "D1310al.txt:314",
   "file": "D1310al.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして一度。目を醒ませば地球はお終いなのだ。",
   "ko_candidate": "그리고 한 번｡ 눈을 뜨면 지구는 끝장이다｡"
  },
  {
   "id": 34657,
   "key": "D1310al.txt:315",
   "file": "D1310al.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "手をこまねいて待っているワケにはいかない。",
   "ko_candidate": "손을 놓고 기다릴 수는 없다｡"
  },
  {
   "id": 34658,
   "key": "D1310al.txt:318",
   "file": "D1310al.txt",
   "line": 318,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああ、もちろん分かっているさ」",
   "ko_candidate": "「아아､ 물론 알고 있어」"
  },
  {
   "id": 34659,
   "key": "D1310al.txt:321",
   "file": "D1310al.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頷いて、ふと違和感に気付いた。",
   "ko_candidate": "고개를 끄덕이고､ 문득 위화감을 느꼈다｡"
  },
  {
   "id": 34660,
   "key": "D1310al.txt:322",
   "file": "D1310al.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "違和感はすぐ悪寒へ。",
   "ko_candidate": "위화감은 곧 오한으로｡"
  },
  {
   "id": 34661,
   "key": "D1310al.txt:324",
   "file": "D1310al.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悪寒は確信となって警鐘を鳴らし、 俺の全身を緊張させる。",
   "ko_candidate": "오한은 확신이 되어 경종을 울리고､ 내 온몸을 긴장시킨다｡"
  },
  {
   "id": 34662,
   "key": "D1310al.txt:332",
   "file": "D1310al.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反射的にその場から飛び退く。",
   "ko_candidate": "반사적으로 그 자리에서 뛰어든다｡"
  },
  {
   "id": 34663,
   "key": "D1310al.txt:337",
   "file": "D1310al.txt",
   "line": 337,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうした!?」",
   "ko_candidate": "「왜 그래!?」"
  },
  {
   "id": 34664,
   "key": "D1310al.txt:344",
   "file": "D1310al.txt",
   "line": 344,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッ!?」",
   "ko_candidate": "「…………읏!?」"
  },
  {
   "id": 34665,
   "key": "D1310al.txt:360",
   "file": "D1310al.txt",
   "line": 360,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦場から離れた街中、避難シェルターの入り口近く、メタトロンはそこに着地した。瑠璃を磔たままの十字架を地面に刺す。",
   "ko_candidate": "전장에서 떨어진 시내､ 대피 셸터의 입구 근처､ 메타트론은 그곳에 착지했다｡ 루리를 십자가에 매단 채로 지면에 꽂는다｡"
  },
  {
   "id": 34666,
   "key": "D1310al.txt:362",
   "file": "D1310al.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃を縛る拘束具にビームセイバーを走らせる。解き放たれ、落ちる瑠璃の身体をメタトロンは抱きとめた。",
   "ko_candidate": "루리를 묶은 구속구에 빔 세이버를 달린다｡ 풀려나 떨어지는 루리의 몸을 메타트론이 받아냈다｡"
  },
  {
   "id": 34667,
   "key": "D1310al.txt:366",
   "file": "D1310al.txt",
   "line": 366,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ、ありがとうございます……」",
   "ko_candidate": "「아､ 감사합니다……」"
  },
  {
   "id": 34668,
   "key": "D1310al.txt:370",
   "file": "D1310al.txt",
   "line": 370,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「例には及ばん。此処からならシェルターに戻れるはずだ。 ……さあ、早く私から離れろ」",
   "ko_candidate": "「예의는 필요 없다｡ 여기서라면 셸터로 돌아갈 수 있을 거다｡ ……자､ 빨리 나에게서 떨어져라」"
  },
  {
   "id": 34669,
   "key": "D1310al.txt:376",
   "file": "D1310al.txt",
   "line": 376,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣……?」"
  },
  {
   "id": 34670,
   "key": "D1310al.txt:379",
   "file": "D1310al.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "メタトロンが瑠璃の身体を静かに下ろした そのときだった。",
   "ko_candidate": "메타트론이 루리의 몸을 조용히 내려놓은 그때였다｡"
  },
  {
   "id": 34671,
   "key": "D1310al.txt:390",
   "file": "D1310al.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "電柱の上に黒い翼を広げたサンダルフォンが",
   "ko_candidate": "전신주 위에 검은 날개를 펼친 산달폰이 내려온다｡"
  },
  {
   "id": 34672,
   "key": "D1310al.txt:391",
   "file": "D1310al.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "舞い降りる。 腕を組み、メタトロンを見下ろしている。",
   "ko_candidate": "팔짱을 끼고 메타트론을 내려다보고 있다｡"
  },
  {
   "id": 34673,
   "key": "D1310al.txt:396",
   "file": "D1310al.txt",
   "line": 396,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いい加減、気は済んだか」",
   "ko_candidate": "「이제 충분히 만족했나」"
  },
  {
   "id": 34674,
   "key": "D1310al.txt:399",
   "file": "D1310al.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かな声だった。だが、それ故にその内に秘められた殺意に身も凍える気分を瑠璃は味わった。",
   "ko_candidate": "조용한 목소리였다｡ 하지만､ 그렇기에 그 안에 숨겨진 살의에 몸이 얼어붙는 기분을 루리는 맛보았다｡"
  },
  {
   "id": 34675,
   "key": "D1310al.txt:405",
   "file": "D1310al.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "硬直する瑠璃の背中を優しくメタトロンは押す。",
   "ko_candidate": "굳어버린 루리의 등을 부드럽게 메타트론이 밀어준다｡"
  },
  {
   "id": 34676,
   "key": "D1310al.txt:407",
   "file": "D1310al.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "安心させるように１つ頷くと、サンダルフォンを正面に見据え、向かい合う。",
   "ko_candidate": "안심시키듯 한 번 끄덕이고는､ 산달폰을 정면으로 바라보며 마주선다｡"
  },
  {
   "id": 34677,
   "key": "D1310al.txt:411",
   "file": "D1310al.txt",
   "line": 411,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ、これで良い。待たせたな」",
   "ko_candidate": "「그래､ 이걸로 됐다｡ 기다리게 했군」"
  },
  {
   "id": 34678,
   "key": "D1310al.txt:422",
   "file": "D1310al.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンの装甲が音を立て、変形する。",
   "ko_candidate": "메타트론의 장갑이 소리를 내며 변형된다｡"
  },
  {
   "id": 34679,
   "key": "D1310al.txt:423",
   "file": "D1310al.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身の至る所から武装が出現した。更に翼を広げる。",
   "ko_candidate": "온몸 곳곳에서 무장이 출현했다｡ 더욱이 날개를 펼친다｡"
  },
  {
   "id": 34680,
   "key": "D1310al.txt:425",
   "file": "D1310al.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "溢れる光は、 後光となってメタトロンの身体を輝かせる。",
   "ko_candidate": "넘치는 빛은 후광이 되어 메타트론의 몸을 빛나게 한다｡"
  },
  {
   "id": 34681,
   "key": "D1310al.txt:428",
   "file": "D1310al.txt",
   "line": 428,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まさしく天使王さながらに。",
   "ko_candidate": "마치 천사왕과도 같이｡"
  }
 ]
}