 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "ロードビヤーキー": "로드 비야키"
 },
 "items": [
  {
   "id": 15404,
   "key": "D0810al.txt:615",
   "file": "D0810al.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脚部シールドを開放。跳躍。",
   "ko_candidate": "다리부 실드를 개방｡ 도약｡"
  },
  {
   "id": 15405,
   "key": "D0810al.txt:622",
   "file": "D0810al.txt",
   "line": 622,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の爪は目標を失い、大地を砕く。",
   "ko_candidate": "강철의 발톱은 목표를 잃고 대지를 부순다｡"
  },
  {
   "id": 15406,
   "key": "D0810al.txt:627",
   "file": "D0810al.txt",
   "line": 627,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかしこれでかわし切れたワケではない。",
   "ko_candidate": "하지만 이것으로 완전히 피한 것은 아니다｡"
  },
  {
   "id": 15407,
   "key": "D0810al.txt:628",
   "file": "D0810al.txt",
   "line": 628,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "着地地点を狙って、もう１本の腕が振り下ろされる。",
   "ko_candidate": "착지 지점을 노리고 또 다른 팔이 내리꽂힌다｡"
  },
  {
   "id": 15408,
   "key": "D0810al.txt:631",
   "file": "D0810al.txt",
   "line": 631,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くそっ！」",
   "ko_candidate": "「젠장!」"
  },
  {
   "id": 15409,
   "key": "D0810al.txt:642",
   "file": "D0810al.txt",
   "line": 642,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間髪置かず、脚部シールドを再開放してこれをかわす。",
   "ko_candidate": "잠깐의 틈도 없이 다리부 실드를 재개방하여 이를 피한다｡"
  },
  {
   "id": 15410,
   "key": "D0810al.txt:643",
   "file": "D0810al.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "連発した負担に、デモンベインの脚が軋む。",
   "ko_candidate": "연발한 부담에 데몬베인의 다리가 삐걱거린다｡"
  },
  {
   "id": 15411,
   "key": "D0810al.txt:646",
   "file": "D0810al.txt",
   "line": 646,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り下ろされた腕は、デモンベインの胴をわずかにかすった。",
   "ko_candidate": "내리꽂힌 팔이 데몬베인의 몸통을 살짝 스쳤다｡"
  },
  {
   "id": 15412,
   "key": "D0810al.txt:647",
   "file": "D0810al.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただそれだけで装甲はへこみ、カタチを歪め、ひび割れる。",
   "ko_candidate": "그것만으로도 장갑은 찌그러지고 모양이 일그러지며 금이 간다｡"
  },
  {
   "id": 15413,
   "key": "D0810al.txt:656",
   "file": "D0810al.txt",
   "line": 656,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕を叩きつけられた大地が爆砕した。",
   "ko_candidate": "팔이 내리꽂힌 대지가 폭발했다｡"
  },
  {
   "id": 15414,
   "key": "D0810al.txt:657",
   "file": "D0810al.txt",
   "line": 657,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫や土砂と一緒に、デモンベインもまた宙を舞う。",
   "ko_candidate": "잔해와 토사와 함께 데몬베인도 공중으로 날아오른다｡"
  },
  {
   "id": 15415,
   "key": "D0810al.txt:663",
   "file": "D0810al.txt",
   "line": 663,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なんて、ふざけたパワーだ……ッ！」",
   "ko_candidate": "「뭐야､ 이 말도 안 되는 파워는…!」"
  },
  {
   "id": 15416,
   "key": "D0810al.txt:666",
   "file": "D0810al.txt",
   "line": 666,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなの一発もらっただけでも、致命傷だ。",
   "ko_candidate": "이런 건 한 방만 맞아도 치명상이다｡"
  },
  {
   "id": 15417,
   "key": "D0810al.txt:667",
   "file": "D0810al.txt",
   "line": 667,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何とか脚部シールドがもたらす超機動力のお陰で逃れてはいるが――。",
   "ko_candidate": "어떻게든 다리부 실드가 가져다주는 초기동력 덕분에 벗어나고는 있지만"
  },
  {
   "id": 15418,
   "key": "D0810al.txt:680",
   "file": "D0810al.txt",
   "line": 680,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「があああああっ！」",
   "ko_candidate": "――｡ 「가아아아아!」"
  },
  {
   "id": 15419,
   "key": "D0810al.txt:686",
   "file": "D0810al.txt",
   "line": 686,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……ぁぁあ！」",
   "ko_candidate": "「큿… 아아아!」"
  },
  {
   "id": 15420,
   "key": "D0810al.txt:694",
   "file": "D0810al.txt",
   "line": 694,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても、ロードビヤーキーの砲撃が降り注ぐ。",
   "ko_candidate": "또다시 로드 비야키의 포격이 쏟아진다｡"
  },
  {
   "id": 15421,
   "key": "D0810al.txt:695",
   "file": "D0810al.txt",
   "line": 695,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は――かわし切れない！",
   "ko_candidate": "이번에는―― 피할 수 없어!"
  },
  {
   "id": 15422,
   "key": "D0810al.txt:709",
   "file": "D0810al.txt",
   "line": 709,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔弾が、デモンベインの装甲の上で弾けた。",
   "ko_candidate": "마탄이 데몬베인의 장갑 위에서 터졌다｡"
  },
  {
   "id": 15423,
   "key": "D0810al.txt:710",
   "file": "D0810al.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焼け焦げた銃創がいくつも穿たれる。",
   "ko_candidate": "그을린 총창이 여러 개 뚫린다｡"
  },
  {
   "id": 15424,
   "key": "D0810al.txt:718",
   "file": "D0810al.txt",
   "line": 718,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットに響く爆音。",
   "ko_candidate": "콕핏에 폭음이 울린다｡"
  },
  {
   "id": 15425,
   "key": "D0810al.txt:721",
   "file": "D0810al.txt",
   "line": 721,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐ……ッッ！　――――ッ！」",
   "ko_candidate": "「크… ! ――――!」"
  },
  {
   "id": 15426,
   "key": "D0810al.txt:724",
   "file": "D0810al.txt",
   "line": 724,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "危機感が、雷撃のように脳天を貫き、爆撃のように意識を弾けさせた。",
   "ko_candidate": "위기감이 번개처럼 정수리를 꿰뚫고 폭격처럼 의식을 터뜨렸다｡"
  },
  {
   "id": 15427,
   "key": "D0810al.txt:726",
   "file": "D0810al.txt",
   "line": 726,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は危機感の命じるがまま、その場から飛び退こうとして――",
   "ko_candidate": "나는 위기감이 명하는 대로 그 자리에서 뛰어나가려 했지만――"
  },
  {
   "id": 15428,
   "key": "D0810al.txt:739",
   "file": "D0810al.txt",
   "line": 739,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッッッ!?」",
   "ko_candidate": "「――――!!!?」"
  },
  {
   "id": 15429,
   "key": "D0810al.txt:743",
   "file": "D0810al.txt",
   "line": 743,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 15430,
   "key": "D0810al.txt:746",
   "file": "D0810al.txt",
   "line": 746,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬、ロードビヤーキーの影を見たような気がした。",
   "ko_candidate": "순간､ 로드 비야키의 그림자를 본 것 같은 기분이 들었다｡"
  },
  {
   "id": 15431,
   "key": "D0810al.txt:755",
   "file": "D0810al.txt",
   "line": 755,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがそれを認識するよりも早く、遥かに迅く、一瞬刹那の内に衝撃がデモンベインを襲った。",
   "ko_candidate": "하지만 그것을 인식하기도 전에､ 훨씬 더 빠르게､ 순식간에 충격이 데몬베인을 덮쳤다｡"
  },
  {
   "id": 15432,
   "key": "D0810al.txt:757",
   "file": "D0810al.txt",
   "line": 757,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発的な衝撃。",
   "ko_candidate": "폭발적인 충격｡"
  },
  {
   "id": 15433,
   "key": "D0810al.txt:758",
   "file": "D0810al.txt",
   "line": 758,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "破壊の波紋がコクピットを揺さぶり、掻き乱していく。",
   "ko_candidate": "파괴의 파문이 콕핏을 흔들고 뒤흔들었다｡"
  },
  {
   "id": 15434,
   "key": "D0810al.txt:759",
   "file": "D0810al.txt",
   "line": 759,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いくつもの機器類が爆発し、紫電を散らした。",
   "ko_candidate": "여러 기기들이 폭발하며 자줏빛 전기를 흩뿌렸다｡"
  },
  {
   "id": 15435,
   "key": "D0810al.txt:762",
   "file": "D0810al.txt",
   "line": 762,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぐわああああああああ！」",
   "ko_candidate": "「으와아아아아아아아아!」"
  },
  {
   "id": 15436,
   "key": "D0810al.txt:766",
   "file": "D0810al.txt",
   "line": 766,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああああああ――――！」",
   "ko_candidate": "「아아아아아아――――!」"
  },
  {
   "id": 15437,
   "key": "D0810al.txt:769",
   "file": "D0810al.txt",
   "line": 769,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大気を弾き飛ばすかのような爆音は、後からやってきた。",
   "ko_candidate": "대기를 튕겨내는 듯한 폭음은 나중에 들려왔다｡"
  },
  {
   "id": 15438,
   "key": "D0810al.txt:781",
   "file": "D0810al.txt",
   "line": 781,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き飛ばされたデモンベインの巨体が、宙を軽々と舞う。",
   "ko_candidate": "날려버린 데몬베인의 거대한 몸체가 공중을 가볍게 날아다닌다｡"
  },
  {
   "id": 15439,
   "key": "D0810al.txt:782",
   "file": "D0810al.txt",
   "line": 782,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "叩きつけられたような勢いで、大地に墜落する。",
   "ko_candidate": "내던져진 듯한 기세로 대지에 추락한다｡"
  },
  {
   "id": 15440,
   "key": "D0810al.txt:784",
   "file": "D0810al.txt",
   "line": 784,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "むしろ激突する。",
   "ko_candidate": "오히려 충돌한다｡"
  },
  {
   "id": 15441,
   "key": "D0810al.txt:792",
   "file": "D0810al.txt",
   "line": 792,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……な、何が……ッ!?」",
   "ko_candidate": "「크윽… 뭐､ 뭐가…!?」"
  },
  {
   "id": 15442,
   "key": "D0810al.txt:801",
   "file": "D0810al.txt",
   "line": 801,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちんたらしてるから、思わず轢いちまったじゃないの！ ヒャーハッハッハッ！」",
   "ko_candidate": "「꾸물거리고 있으니까 그만 치어버렸잖아! 히야하하하!」"
  },
  {
   "id": 15443,
   "key": "D0810al.txt:806",
   "file": "D0810al.txt",
   "line": 806,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『セラエノ断章』……！」",
   "ko_candidate": "「『세라에노 단장』…!」"
  }
 ]
}