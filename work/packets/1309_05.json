 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "ベルゼビュート": "벨제뷰트",
  "ティベリウス": "티베리우스",
  "姫さん": "공주님",
  "瑠璃": "루리"
 },
 "items": [
  {
   "id": 34091,
   "key": "D1309al.txt:864",
   "file": "D1309al.txt",
   "line": 864,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……やれやれだ。",
   "ko_candidate": "…참 난감하군｡"
  },
  {
   "id": 34092,
   "key": "D1309al.txt:871",
   "file": "D1309al.txt",
   "line": 871,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、デモンベインの周りには、不可視の兵器が取り囲んでいるのだろう。",
   "ko_candidate": "지금 데몬베인 주위에는 보이지 않는 병기가 둘러싸고 있겠지｡"
  },
  {
   "id": 34093,
   "key": "D1309al.txt:871",
   "file": "D1309al.txt",
   "line": 871,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、俺は動じない。",
   "ko_candidate": "하지만､ 나는 동요하지 않는다｡"
  },
  {
   "id": 34094,
   "key": "D1309al.txt:872",
   "file": "D1309al.txt",
   "line": 872,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ静かに精神を集中する。",
   "ko_candidate": "그저 조용히 정신을 집중한다｡"
  },
  {
   "id": 34095,
   "key": "D1309al.txt:880",
   "file": "D1309al.txt",
   "line": 880,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「憎悪の空より来たりて――」",
   "ko_candidate": "「증오의 하늘로부터 내려와――」"
  },
  {
   "id": 34096,
   "key": "D1309al.txt:882",
   "file": "D1309al.txt",
   "line": 882,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思考が疾走を開始する。",
   "ko_candidate": "사고가 질주를 시작한다｡"
  },
  {
   "id": 34097,
   "key": "D1309al.txt:883",
   "file": "D1309al.txt",
   "line": 883,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、その瞬間の世界の法則を演算し、導き出された式に、自らの理論を書き加え、自分の世界を創造する。",
   "ko_candidate": "지금､ 그 순간의 세계의 법칙을 연산하고､ 도출된 식에 자신의 이론을 덧붙여 자신의 세계를 창조한다｡"
  },
  {
   "id": 34098,
   "key": "D1309al.txt:894",
   "file": "D1309al.txt",
   "line": 894,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「正しき怒りを胸に……」",
   "ko_candidate": "「올바른 분노를 가슴에……」"
  },
  {
   "id": 34099,
   "key": "D1309al.txt:897",
   "file": "D1309al.txt",
   "line": 897,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが魔術。",
   "ko_candidate": "그것이 마술｡"
  },
  {
   "id": 34100,
   "key": "D1309al.txt:898",
   "file": "D1309al.txt",
   "line": 898,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真実の眼を以て、世界と繋がる秘術。",
   "ko_candidate": "진실의 눈으로 세계와 연결되는 비술｡"
  },
  {
   "id": 34101,
   "key": "D1309al.txt:908",
   "file": "D1309al.txt",
   "line": 908,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「我等は魔を断つ剣を執る……！」",
   "ko_candidate": "「우리는 마를 베는 검을 든다……!」"
  },
  {
   "id": 34102,
   "key": "D1309al.txt:917",
   "file": "D1309al.txt",
   "line": 917,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――視えた。",
   "ko_candidate": "――보였다｡"
  },
  {
   "id": 34103,
   "key": "D1309al.txt:919",
   "file": "D1309al.txt",
   "line": 919,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不可視の脅威はすぐ直前、瞬き一回の距離にまで接近している。",
   "ko_candidate": "불가시의 위협은 바로 눈앞､ 눈 깜빡할 거리까지 접근해 있다｡"
  },
  {
   "id": 34104,
   "key": "D1309al.txt:920",
   "file": "D1309al.txt",
   "line": 920,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてそれを俺ははっきりと認識している。",
   "ko_candidate": "그리고 그것을 나는 분명히 인식하고 있다｡"
  },
  {
   "id": 34105,
   "key": "D1309al.txt:922",
   "file": "D1309al.txt",
   "line": 922,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "世界に神経を張り巡らせている疾走状態の俺に、その刹那は欠伸が出るほどに緩慢な時の流れに在る。",
   "ko_candidate": "세계에 신경을 곤두세우고 있는 질주 상태의 나에게､ 그 찰나는 하품이 나올 정도로 느린 시간의 흐름 속에 있다｡"
  },
  {
   "id": 34106,
   "key": "D1309al.txt:924",
   "file": "D1309al.txt",
   "line": 924,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力を振るうには、あまりにも充分。",
   "ko_candidate": "힘을 휘두르기에는 너무나도 충분한 시간｡"
  },
  {
   "id": 34107,
   "key": "D1309al.txt:932",
   "file": "D1309al.txt",
   "line": 932,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「汝、無垢なる刃デモンベイン！」",
   "ko_candidate": "「그대､ 무구한 칼날 데몬베인!」"
  },
  {
   "id": 34108,
   "key": "D1309al.txt:943",
   "file": "D1309al.txt",
   "line": 943,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃が走った。",
   "ko_candidate": "섬광이 스쳤다｡"
  },
  {
   "id": 34109,
   "key": "D1309al.txt:952",
   "file": "D1309al.txt",
   "line": 952,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの周囲で、十数の爆発が連続した。",
   "ko_candidate": "데몬베인 주위에서 십여 번의 폭발이 연속했다｡"
  },
  {
   "id": 34110,
   "key": "D1309al.txt:954",
   "file": "D1309al.txt",
   "line": 954,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう、総て叩き斬ってやったのだ。",
   "ko_candidate": "그래､ 모두 베어버린 것이다｡"
  },
  {
   "id": 34111,
   "key": "D1309al.txt:958",
   "file": "D1309al.txt",
   "line": 958,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「バルザイの偃月刀!? 馬鹿な、ただの一振りで……!?」",
   "ko_candidate": "「바르자이의 언월도!? 말도 안 돼､ 단 한 번의 휘두름으로……!?」"
  },
  {
   "id": 34112,
   "key": "D1309al.txt:969",
   "file": "D1309al.txt",
   "line": 969,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "偃月刀の剣先をベルゼビュートに突きつける。",
   "ko_candidate": "언월도의 검끝을 벨제뷰트에게 들이댄다｡"
  },
  {
   "id": 34113,
   "key": "D1309al.txt:970",
   "file": "D1309al.txt",
   "line": 970,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度はこっちが嘲笑ってやる番だ。",
   "ko_candidate": "이번엔 이쪽이 비웃어줄 차례다｡"
  },
  {
   "id": 34114,
   "key": "D1309al.txt:972",
   "file": "D1309al.txt",
   "line": 972,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "見えはしないだろうが、 俺は不敵に口の端を吊り上げる。",
   "ko_candidate": "보이진 않겠지만､ 나는 뻔뻔하게 입꼬리를 올린다｡"
  },
  {
   "id": 34115,
   "key": "D1309al.txt:977",
   "file": "D1309al.txt",
   "line": 977,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「思い出したろう？ そうだ、 これがこの機体の意味……」",
   "ko_candidate": "「기억났겠지? 그래､ 이것이 이 기체의 의미……」"
  },
  {
   "id": 34116,
   "key": "D1309al.txt:983",
   "file": "D1309al.txt",
   "line": 983,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「魔を断つ剣さ。 さあ、ゾンビ野郎。死体は死体らしく墓に帰りな！」",
   "ko_candidate": "「마를 베는 검이라고｡ 자､ 좀비 녀석｡ 시체는 시체답게 무덤으로 돌아가!」"
  },
  {
   "id": 34117,
   "key": "D1309al.txt:989",
   "file": "D1309al.txt",
   "line": 989,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、偃月刀を上段に構える。",
   "ko_candidate": "말하고는 언월도를 상단에 놓는다｡"
  },
  {
   "id": 34118,
   "key": "D1309al.txt:991",
   "file": "D1309al.txt",
   "line": 991,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "デモンベインが一歩前に出ると、気圧されているのかベルゼビュートは一歩下がる。 ふん、",
   "ko_candidate": "데몬베인이 한 걸음 앞으로 나서자､ 기가 눌렸는지 벨제뷰트는 한 걸음 물러선다｡"
  },
  {
   "id": 34119,
   "key": "D1309al.txt:994",
   "file": "D1309al.txt",
   "line": 994,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうせデモンベインの間合いからは逃れられない。",
   "ko_candidate": "흥､ 어차피 데몬베인의 간합에서는 벗어날 수 없어｡"
  },
  {
   "id": 34120,
   "key": "D1309al.txt:996",
   "file": "D1309al.txt",
   "line": 996,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緊張も高まった頃、突然、ティベリウスが笑い出した。",
   "ko_candidate": "긴장감도 고조된 즈음､ 갑자기 티베리우스가 웃음을 터뜨렸다｡"
  },
  {
   "id": 34121,
   "key": "D1309al.txt:1003",
   "file": "D1309al.txt",
   "line": 1003,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ひひ……ひひゃひゃ…… ひーひひひひひひっ！　アンタ たち、大切なこと忘れてなぁい？ こっちには人質がいるのよっ！」",
   "ko_candidate": "「히히……히햐햐…… 히-히히히히히힛! 너희들､ 중요한 걸 잊고 있지 않아? 이쪽엔 인질이 있다고!」"
  },
  {
   "id": 34122,
   "key": "D1309al.txt:1010",
   "file": "D1309al.txt",
   "line": 1010,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再びティベリウスは、姫さんの傍らに立った。",
   "ko_candidate": "다시 티베리우스는 공주님 곁에 섰다｡"
  },
  {
   "id": 34123,
   "key": "D1309al.txt:1015",
   "file": "D1309al.txt",
   "line": 1015,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "動けない姫さんの首に触手を巻きつけ、締め上げる。",
   "ko_candidate": "움직일 수 없는 공주님의 목에 촉수를 감아 조여온다｡"
  },
  {
   "id": 34124,
   "key": "D1309al.txt:1019",
   "file": "D1309al.txt",
   "line": 1019,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「か……っ！」",
   "ko_candidate": "「크……읏!」"
  },
  {
   "id": 34125,
   "key": "D1309al.txt:1024",
   "file": "D1309al.txt",
   "line": 1024,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほらほらぁ！　このまま瑠璃お嬢ちゃんの首をヘシ折られたくなければ、大人しくすんのよ！」",
   "ko_candidate": "「자､ 어때! 이대로 루리 아가씨의 목이 부러지는 걸 보고 싶지 않다면､ 얌전히 있어야 해!」"
  },
  {
   "id": 34126,
   "key": "D1309al.txt:1028",
   "file": "D1309al.txt",
   "line": 1028,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう言うティベリウスの脅しには、以前のような余裕は無い。",
   "ko_candidate": "그렇게 말하는 티베리우스의 협박에는 이전과 같은 여유가 없다｡"
  },
  {
   "id": 34127,
   "key": "D1309al.txt:1028",
   "file": "D1309al.txt",
   "line": 1028,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "追い詰められているのはモロバレだ。",
   "ko_candidate": "궁지에 몰린 것이 뻔히 보인다｡"
  },
  {
   "id": 34128,
   "key": "D1309al.txt:1030",
   "file": "D1309al.txt",
   "line": 1030,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だからと言って、人質が捕られている以上、こっちも 迂闊に手が出せないのは事実だ。",
   "ko_candidate": "하지만 그렇다고 해도､ 인질이 잡혀 있는 이상 이쪽도 경솔하게 손을 쓸 수 없는 것도 사실이다｡"
  },
  {
   "id": 34129,
   "key": "D1309al.txt:1036",
   "file": "D1309al.txt",
   "line": 1036,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……つくづくあの娘は人の足を引っ張ることしかせんの」",
   "ko_candidate": "「……정말이지 저 아이는 남의 발목을 잡는 일밖에 안 하는군」"
  },
  {
   "id": 34130,
   "key": "D1309al.txt:1041",
   "file": "D1309al.txt",
   "line": 1041,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お姫様属性っぽいって言えば、っぽいけどな」",
   "ko_candidate": "「공주님 속성 같다고 하면､ 그렇긴 하지」"
  }
 ]
}