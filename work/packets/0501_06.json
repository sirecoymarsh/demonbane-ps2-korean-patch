   "key": "D0501.txt:2198",
   "file": "D0501.txt",
   "line": 2198,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だから待てぇぇぇぇぇぇぇぇ！」",
   "ko_candidate": "「아니､ 도망가아아아아아――――앗!」 무자비하게도 방아쇠가 당겨졌다｡"
  },
  {
   "id": 6242,
   "key": "D0501.txt:2204",
