  {
   "id": 6233,
   "key": "D0501.txt:2149",
   "file": "D0501.txt",
   "line": 2149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "背後を振り返る……",
