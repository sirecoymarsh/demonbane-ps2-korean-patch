  {
   "id": 6239,
   "key": "D0501.txt:2190",
   "file": "D0501.txt",
   "line": 2190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "えらく物騒なことをホザきやがった。",
