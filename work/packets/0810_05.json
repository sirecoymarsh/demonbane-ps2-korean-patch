{
 "packet": "0810_05",
 "scene": "0810",
 "anchor": {
  "hit": 56,
  "total": 59,
  "rate": 0.949
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "ロードビヤーキー": "로드 비야키",
  "九郎": "쿠로",
  "エンネア": "엔네아"
 },
 "items": [
  {
   "id": 15444,
   "key": "D0810al.txt:809",
   "file": "D0810al.txt",
   "line": 809,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仰向けに倒れるデモンベインを上空から見下ろす、ロードビヤーキー。",
   "ko_candidate": "뒤로 넘어진 데몬베인을 상공에서 내려다보는 로드 비야키｡"
  },
  {
   "id": 15445,
   "key": "D0810al.txt:809",
   "file": "D0810al.txt",
   "line": 809,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まさか……こいつの体当たりを喰らったのか？",
   "ko_candidate": "설마… 이놈의 몸통박치기를 당한 건가?"
  },
  {
   "id": 15446,
   "key": "D0810al.txt:811",
   "file": "D0810al.txt",
   "line": 811,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……ほとんど視認できなかった。とんでもないスピードだ。",
   "ko_candidate": "…거의 볼 수 없었다｡ 엄청난 속도다｡"
  },
  {
   "id": 15447,
   "key": "D0810al.txt:814",
   "file": "D0810al.txt",
   "line": 814,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……」",
   "ko_candidate": "「크윽…」"
  },
  {
   "id": 15448,
   "key": "D0810al.txt:826",
   "file": "D0810al.txt",
   "line": 826,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起き上がろうとするが、動くたびに関節部分が何度も小爆発を起こす。",
   "ko_candidate": "일어나려고 하지만 움직일 때마다 관절 부분에서 여러 번 작은 폭발이 일어난다｡"
  },
  {
   "id": 15449,
   "key": "D0810al.txt:826",
   "file": "D0810al.txt",
   "line": 826,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マズイ……こいつは相当のダメージだ。",
   "ko_candidate": "좋지 않아… 이건 상당한 데미지다｡"
  },
  {
   "id": 15450,
   "key": "D0810al.txt:827",
   "file": "D0810al.txt",
   "line": 827,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何とか機体を立たせ、周囲を見渡す。",
   "ko_candidate": "어떻게든 기체를 세우고 주위를 둘러본다｡"
  },
  {
   "id": 15451,
   "key": "D0810al.txt:836",
   "file": "D0810al.txt",
   "line": 836,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お、おい……九郎ッ！　あれを！」",
   "ko_candidate": "「어､ 어이… 쿠로! 저걸!」"
  },
  {
   "id": 15452,
   "key": "D0810al.txt:840",
   "file": "D0810al.txt",
   "line": 840,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？　何だ、よ……」",
   "ko_candidate": "「엣…? 뭐야､ 저…」"
  },
  {
   "id": 15453,
   "key": "D0810al.txt:848",
   "file": "D0810al.txt",
   "line": 848,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの視線が下に向く。それに合わせてメインモニターも、足元を映し出す。",
   "ko_candidate": "데몬베인의 시선이 아래로 향한다｡ 그에 맞춰 메인 모니터도 발밑을 비춘다｡"
  },
  {
   "id": 15454,
   "key": "D0810al.txt:849",
   "file": "D0810al.txt",
   "line": 849,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心臓が止まりそうになるくらい、驚く。",
   "ko_candidate": "심장이 멎을 것 같을 정도로 놀란다｡"
  },
  {
   "id": 15455,
   "key": "D0810al.txt:851",
   "file": "D0810al.txt",
   "line": 851,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目の前に聳え立つ鋼鉄の巨人を、ゆっくりと見上げる瞳。",
   "ko_candidate": "눈앞에 우뚝 선 강철의 거인을 천천히 올려다보는 눈동자｡"
  },
  {
   "id": 15456,
   "key": "D0810al.txt:852",
   "file": "D0810al.txt",
   "line": 852,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの眸を介して、視線が交差する。",
   "ko_candidate": "데몬베인의 눈동자를 통해 시선이 교차한다｡"
  },
  {
   "id": 15457,
   "key": "D0810al.txt:855",
   "file": "D0810al.txt",
   "line": 855,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――エンネア!?」",
   "ko_candidate": "「――엔네아!?」"
  },
  {
   "id": 15458,
   "key": "D0810al.txt:857",
   "file": "D0810al.txt",
   "line": 857,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何でまだこんなところに!?",
   "ko_candidate": "왜 아직도 이런 곳에!?"
  },
  {
   "id": 15459,
   "key": "D0810al.txt:858",
   "file": "D0810al.txt",
   "line": 858,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "逃げたんじゃなかったのか!?",
   "ko_candidate": "도망가지 않은 거야!?"
  },
  {
   "id": 15460,
   "key": "D0810al.txt:860",
   "file": "D0810al.txt",
   "line": 860,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "混乱と焦燥が、胸の中で荒れ狂った。",
   "ko_candidate": "혼란과 초조함이 가슴 속에서 거칠게 날뛰었다｡"
  },
  {
   "id": 15461,
   "key": "D0810al.txt:861",
   "file": "D0810al.txt",
   "line": 861,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが当のエンネアには――巨大ロボット同士の戦いをすぐ目の前にしてもなお、何の恐怖を見せはしない。",
   "ko_candidate": "하지만 정작 엔네아는――거대 로봇들의 전투를 바로 눈앞에 두고도 아무런 공포를 보이지 않는다｡"
  },
  {
   "id": 15462,
   "key": "D0810al.txt:863",
   "file": "D0810al.txt",
   "line": 863,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ感情の無い、温度の無い瞳だけが、デモンベインの眸を覗き込んでいる。",
   "ko_candidate": "그저 감정 없는､ 온기 없는 눈동자만이 데몬베인의 눈동자를 들여다보고 있다｡"
  },
  {
   "id": 15463,
   "key": "D0810al.txt:864",
   "file": "D0810al.txt",
   "line": 864,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの雨の日と同じように――",
   "ko_candidate": "그 비 오던 날과 똑같이――"
  },
  {
   "id": 15464,
   "key": "D0810al.txt:866",
   "file": "D0810al.txt",
   "line": 866,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ぽつり。",
   "ko_candidate": "뚝｡"
  },
  {
   "id": 15465,
   "key": "D0810al.txt:868",
   "file": "D0810al.txt",
   "line": 868,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ロードビヤーキーの竜巻が、喚んだのだろうか？",
   "ko_candidate": "로드 비야키의 회오리바람이 불러온 걸까?"
  },
  {
   "id": 15466,
   "key": "D0810al.txt:869",
   "file": "D0810al.txt",
   "line": 869,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつの間にか垂れ込めた雨雲。",
   "ko_candidate": "어느새 드리워진 먹구름｡"
  },
  {
   "id": 15467,
   "key": "D0810al.txt:870",
   "file": "D0810al.txt",
   "line": 870,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初の雨が、エンネアの頬に落ちる。",
   "ko_candidate": "첫 빗방울이 엔네아의 뺨에 떨어진다｡"
  },
  {
   "id": 15468,
   "key": "D0810al.txt:874",
   "file": "D0810al.txt",
   "line": 874,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あのうつけ……！」",
   "ko_candidate": "「저 멍청이…!」"
  },
  {
   "id": 15469,
   "key": "D0810al.txt:878",
   "file": "D0810al.txt",
   "line": 878,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何をやっているんだ、エンネア!?　さっさと逃げるんだ！」",
   "ko_candidate": "「뭐하고 있는 거야､ 엔네아!? 어서 도망가!」"
  },
  {
   "id": 15470,
   "key": "D0810al.txt:880",
   "file": "D0810al.txt",
   "line": 880,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拡声器を通して、力一杯の大声で俺は叫ぶ。",
   "ko_candidate": "확성기를 통해 온 힘을 다해 큰 소리로 나는 외친다｡"
  },
  {
   "id": 15471,
   "key": "D0810al.txt:881",
   "file": "D0810al.txt",
   "line": 881,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかしエンネアは動かない。",
   "ko_candidate": "하지만 엔네아는 움직이지 않는다｡"
  },
  {
   "id": 15472,
   "key": "D0810al.txt:882",
   "file": "D0810al.txt",
   "line": 882,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なおも黙ってデモンベインを――俺を、見つめ返す。",
   "ko_candidate": "여전히 말없이 데몬베인을――나를､ 바라본다｡"
  },
  {
   "id": 15473,
   "key": "D0810al.txt:886",
   "file": "D0810al.txt",
   "line": 886,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おいおい！　ヨソ見ったぁ、余裕かましてくれんじゃん！」",
   "ko_candidate": "「어이어이! 딴 데 보고､ 여유 부리고 있네!」"
  },
  {
   "id": 15474,
   "key": "D0810al.txt:893",
   "file": "D0810al.txt",
   "line": 893,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再び、空に舞い上がったロードビヤーキーが、ライフルを構える。",
   "ko_candidate": "다시 공중으로 날아오른 로드 비야키가 라이플을 겨눈다｡"
  },
  {
   "id": 15475,
   "key": "D0810al.txt:895",
   "file": "D0810al.txt",
   "line": 895,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "おいおい……待てよ。",
   "ko_candidate": "어이어이… 잠깐만｡"
  },
  {
   "id": 15476,
   "key": "D0810al.txt:896",
   "file": "D0810al.txt",
   "line": 896,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "待て……待てって！",
   "ko_candidate": "잠깐… 잠깐만!"
  },
  {
   "id": 15477,
   "key": "D0810al.txt:897",
   "file": "D0810al.txt",
   "line": 897,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この状況はヤバ過ぎるだろう！",
   "ko_candidate": "이 상황은 너무 위험하잖아!"
  },
  {
   "id": 15478,
   "key": "D0810al.txt:900",
   "file": "D0810al.txt",
   "line": 900,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「止め……ぐああああ！」",
   "ko_candidate": "「멈춰… 으아아아아!」"
  },
  {
   "id": 15479,
   "key": "D0810al.txt:908",
   "file": "D0810al.txt",
   "line": 908,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声が轟いた。",
   "ko_candidate": "총성이 울렸다｡"
  },
  {
   "id": 15480,
   "key": "D0810al.txt:918",
   "file": "D0810al.txt",
   "line": 918,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの周辺を舐め尽くす砲撃。",
   "ko_candidate": "데몬베인 주변을 핥듯이 휩쓰는 포격｡"
  },
  {
   "id": 15481,
   "key": "D0810al.txt:928",
   "file": "D0810al.txt",
   "line": 928,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無抵抗に撃たれ続けるデモンベイン。",
   "ko_candidate": "무저항으로 계속 맞는 데몬베인｡"
  },
  {
   "id": 15482,
   "key": "D0810al.txt:929",
   "file": "D0810al.txt",
   "line": 929,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ステータスに無数のエラーが、表示されてはもの凄いスピードで流れていく。",
   "ko_candidate": "상태창에 무수한 에러가 표시되고는 엄청난 속도로 흘러간다｡"
  },
  {
   "id": 15483,
   "key": "D0810al.txt:942",
   "file": "D0810al.txt",
   "line": 942,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「きゃああああああ！」",
   "ko_candidate": "「꺄아아아아아아!」"
  }
 ]
}