 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "九郎": "쿠로",
  "エンネア": "엔네아",
  "マスターテリオン": "마스터 테리온"
 },
 "items": [
  {
   "id": 13592,
   "key": "D0807al.txt:132",
   "file": "D0807al.txt",
   "line": 132,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「まさか……知って……」",
   "ko_candidate": "「설마…… 알고 있었어……」"
  },
  {
   "id": 13593,
   "key": "D0807al.txt:136",
   "file": "D0807al.txt",
   "line": 136,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「傷だらけだったよ、九郎の身体。それも、どれもまだ新しい傷――九郎は今も戦っている」",
   "ko_candidate": "「목욕할 때 알아챘어｡ 상처투성이였어､ 쿠로의 몸｡ 그것도 전부 새로운 상처―― 쿠로는 지금도 싸우고 있어」"
  },
  {
   "id": 13594,
   "key": "D0807al.txt:140",
   "file": "D0807al.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……いつの間に見られたんだ。",
   "ko_candidate": "그렇구나｡ 그런 거였군｡"
  },
  {
   "id": 13595,
   "key": "D0807al.txt:141",
   "file": "D0807al.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だけど、なるほど。そういうことか。 わざわざ教えることではないが、かと言って隠しておくことでもない。",
   "ko_candidate": "굳이 알려줄 일은 아니지만､ 그렇다고 숨겨둘 일도 아니다｡"
  },
  {
   "id": 13596,
   "key": "D0807al.txt:147",
   "file": "D0807al.txt",
   "line": 147,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まっ……正義の味方の真似事っていったところだ」",
   "ko_candidate": "나는 고개를 끄덕였다｡ 「뭐…… 정의의 편 흉내내기라고나 할까」"
  },
  {
   "id": 13597,
   "key": "D0807al.txt:151",
   "file": "D0807al.txt",
   "line": 151,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何で……？」",
   "ko_candidate": "「왜……?」"
  },
  {
   "id": 13598,
   "key": "D0807al.txt:155",
   "file": "D0807al.txt",
   "line": 155,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「？」",
   "ko_candidate": "「?」"
  },
  {
   "id": 13599,
   "key": "D0807al.txt:159",
   "file": "D0807al.txt",
   "line": 159,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何で九郎は戦っているの？」",
   "ko_candidate": "「왜 쿠로는 싸우고 있는 거야?」"
  },
  {
   "id": 13600,
   "key": "D0807al.txt:163",
   "file": "D0807al.txt",
   "line": 163,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何でって……そうだな。そりゃあ、やれることやらないと後味悪ィから――かな？」",
   "ko_candidate": "「왜냐고…… 그렇지｡ 뭐､ 할 수 있는 일을 안 하면 찝찝하니까―― 그런 거겠지?」"
  },
  {
   "id": 13601,
   "key": "D0807al.txt:165",
   "file": "D0807al.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少しだけ考えて、そう答えた。",
   "ko_candidate": "잠깐 생각하고 그렇게 대답했다｡"
  },
  {
   "id": 13602,
   "key": "D0807al.txt:166",
   "file": "D0807al.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうとしか答えようがなかった。",
   "ko_candidate": "그렇게밖에 대답할 수 없었다｡"
  },
  {
   "id": 13603,
   "key": "D0807al.txt:170",
   "file": "D0807al.txt",
   "line": 170,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「後味悪い？」",
   "ko_candidate": "「찝찝해?」"
  },
  {
   "id": 13604,
   "key": "D0807al.txt:173",
   "file": "D0807al.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "エンネアが、きょとんと首を傾げる。",
   "ko_candidate": "엔네아가 어리둥절한 표정으로 고개를 갸웃거린다｡"
  },
  {
   "id": 13605,
   "key": "D0807al.txt:175",
   "file": "D0807al.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まあ、そうだな……さすがに曖昧過ぎるか。",
   "ko_candidate": "그래､ 그렇지…… 역시 너무 애매한가｡"
  },
  {
   "id": 13606,
   "key": "D0807al.txt:176",
   "file": "D0807al.txt",
   "line": 176,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ実際、俺の中に確固たる信念や思想があるワケでもなし。",
   "ko_candidate": "다만 실제로 내 안에 확고한 신념이나 사상이 있는 것도 아니고｡"
  },
  {
   "id": 13607,
   "key": "D0807al.txt:177",
   "file": "D0807al.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どう説明したら、良いものやら……。",
   "ko_candidate": "어떻게 설명하면 좋을까……"
  },
  {
   "id": 13608,
   "key": "D0807al.txt:180",
   "file": "D0807al.txt",
   "line": 180,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ほら……反吐が出るような下衆野郎が、好き勝手暴れてるのって、すっげームカつくだろう？」",
   "ko_candidate": "「있잖아…… 구역질 나는 쓰레기 같은 놈들이 마음대로 날뛰는 거､ 엄청 열 받지 않아?」"
  },
  {
   "id": 13609,
   "key": "D0807al.txt:184",
   "file": "D0807al.txt",
   "line": 184,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ん？　う、うん…… そりゃあ、ねえ」",
   "ko_candidate": "「응? 으､ 응…… 그야､ 그렇지」"
  },
  {
   "id": 13610,
   "key": "D0807al.txt:189",
   "file": "D0807al.txt",
   "line": 189,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ピンチでヤバそうな奴を放っておくのも、何だか気が引けるし……要するにそういうことだよ」",
   "ko_candidate": "「위기에 처한 사람을 그냥 내버려 두는 것도 뭔가 찜찜하고…… 요컨대 그런 거야」"
  },
  {
   "id": 13611,
   "key": "D0807al.txt:193",
   "file": "D0807al.txt",
   "line": 193,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……よくわからない」",
   "ko_candidate": "「……잘 모르겠어」"
  },
  {
   "id": 13612,
   "key": "D0807al.txt:196",
   "file": "D0807al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "駄目か。",
   "ko_candidate": "안 되나｡"
  },
  {
   "id": 13613,
   "key": "D0807al.txt:197",
   "file": "D0807al.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "うぅむ、もっと単純に言うとなると……",
   "ko_candidate": "으음､ 더 단순하게 말하자면……"
  },
  {
   "id": 13614,
   "key": "D0807al.txt:200",
   "file": "D0807al.txt",
   "line": 200,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そのさ……自分に何とか出来るんなら、何とかしたいつーのが人情なんでないの？」",
   "ko_candidate": "「그게 말이야…… 자기가 어떻게든 할 수 있다면､ 어떻게든 하고 싶은 게 인지상정 아닐까?」"
  },
  {
   "id": 13615,
   "key": "D0807al.txt:204",
   "file": "D0807al.txt",
   "line": 204,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……それだけ？」",
   "ko_candidate": "「……그게 전부?」"
  },
  {
   "id": 13616,
   "key": "D0807al.txt:208",
   "file": "D0807al.txt",
   "line": 208,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「それだけ……だな。さすがに世界中の人間全部救うとか、この世の全ての不幸を無くすってえのは無理だ。こちとら神様じゃない。手に余る」",
   "ko_candidate": "「그게 전부…… 겠지｡ 아무리 그래도 전 세계 사람들을 전부 구한다거나､ 이 세상의 모든 불행을 없앤다는 건 무리야｡ 난 신이 아니니까｡ 역부족이지」"
  },
  {
   "id": 13617,
   "key": "D0807al.txt:212",
   "file": "D0807al.txt",
   "line": 212,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そうじゃなくて……そんな、『後味が悪い』って理由だけで、どうして戦うことが出来るの？」",
   "ko_candidate": "「그게 아니라…… 그런､ '찝찝하다'는 이유만으로 어떻게 싸울 수 있는 거야?」"
  },
  {
   "id": 13618,
   "key": "D0807al.txt:216",
   "file": "D0807al.txt",
   "line": 216,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いや、だから……」",
   "ko_candidate": "「아니､ 그러니까……」"
  },
  {
   "id": 13619,
   "key": "D0807al.txt:220",
   "file": "D0807al.txt",
   "line": 220,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「九郎、傷だらけだよ？　いっぱいいっぱい痛い思いをしたんでしょ？ それなのに、そんな曖昧な理由で、どうしてそんなに戦うの？」",
   "ko_candidate": "「쿠로､ 상처투성이잖아? 엄청 아팠겠지? 그런데도 그런 애매한 이유로 어떻게 그렇게 싸울 수 있어?」"
  },
  {
   "id": 13620,
   "key": "D0807al.txt:225",
   "file": "D0807al.txt",
   "line": 225,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」 やっぱり曖昧なのか……。",
   "ko_candidate": "「………………」"
  },
  {
   "id": 13621,
   "key": "D0807al.txt:230",
   "file": "D0807al.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どうしてだろう？",
   "ko_candidate": "역시 애매한 건가……"
  },
  {
   "id": 13622,
   "key": "D0807al.txt:231",
   "file": "D0807al.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どうして俺は戦っているのだろう？",
   "ko_candidate": "왜일까? 왜 나는 싸우고 있는 걸까?"
  },
  {
   "id": 13623,
   "key": "D0807al.txt:233",
   "file": "D0807al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "元々の動機は、奴が――『マスターテリオン』が赦せないからだった。",
   "ko_candidate": "원래의 동기는 그 녀석이―― '마스터 테리온'이 용서할 수 없어서였다｡"
  },
  {
   "id": 13624,
   "key": "D0807al.txt:234",
   "file": "D0807al.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あんな邪悪がこの世に存在することを、認めたくなかったからだ。",
   "ko_candidate": "그런 악이 이 세상에 존재한다는 걸 인정하고 싶지 않아서였다｡"
  },
  {
   "id": 13625,
   "key": "D0807al.txt:235",
   "file": "D0807al.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは今だって変わらない。",
   "ko_candidate": "그건 지금도 변함없다｡"
  },
  {
   "id": 13626,
   "key": "D0807al.txt:237",
   "file": "D0807al.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、それだけなのか――と言われれば、違うと思う。",
   "ko_candidate": "하지만 그게 전부냐고 하면 아니라고 생각한다｡"
  },
  {
   "id": 13627,
   "key": "D0807al.txt:239",
   "file": "D0807al.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それは大きい理由だけど、それだけじゃない。",
   "ko_candidate": "그건 큰 이유지만､ 그것뿐만은 아니다｡"
  },
  {
   "id": 13628,
   "key": "D0807al.txt:241",
   "file": "D0807al.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だったら他に何が――と考え出すと、今度は途端に全ての理由が、曖昧の海に埋もれてしまうのだ。",
   "ko_candidate": "그렇다면 다른 건 뭐가―― 라고 생각하기 시작하면 이번엔 갑자기 모든 이유가 애매모호한 바다에 묻혀버리고 만다｡"
  },
  {
   "id": 13629,
   "key": "D0807al.txt:243",
   "file": "D0807al.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "色々と悩んだ末、俺は答えた。",
   "ko_candidate": "여러모로 고민한 끝에 나는 대답했다｡"
  },
  {
   "id": 13630,
   "key": "D0807al.txt:246",
   "file": "D0807al.txt",
   "line": 246,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんなもんなんじゃねえの？」",
   "ko_candidate": "「그런 거 아닐까?」"
  },
  {
   "id": 13631,
   "key": "D0807al.txt:250",
   "file": "D0807al.txt",
   "line": 250,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣……?」"
  }
 ]
}