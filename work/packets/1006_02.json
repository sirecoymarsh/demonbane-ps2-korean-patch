{
 "packet": "1006_02",
 "scene": "1006",
 "anchor": {
  "hit": 17,
  "total": 17,
  "rate": 1.0
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "エルザ": "엘자",
  "破壊ロボ": "파괴 로봇",
  "エセルドレーダ": "에셀드레다",
  "マスターテリオン": "마스터 테리온",
  "クトゥルー": "크툴루",
  "魔導書": "마도서",
  "ナコト写本": "나코트 사본"
 },
 "items": [
  {
   "id": 21668,
   "key": "D1006le.txt:31",
   "file": "D1006le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焦燥がエルザを襲う。",
   "ko_candidate": "초조함이 엘자를 덮친다｡"
  },
  {
   "id": 21669,
   "key": "D1006le.txt:36",
   "file": "D1006le.txt",
   "line": 36,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こなくそぉぉぉぉぉロボ！」",
   "ko_candidate": "「이 빌어먹을 로봇들아아아아아!」"
  },
  {
   "id": 21670,
   "key": "D1006le.txt:40",
   "file": "D1006le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怪異が牙を振るったのは、その時だった。",
   "ko_candidate": "괴이가 이빨을 드러낸 것은 그때였다｡"
  },
  {
   "id": 21671,
   "key": "D1006le.txt:45",
   "file": "D1006le.txt",
   "line": 45,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ロボ？」",
   "ko_candidate": "「로봇?」"
  },
  {
   "id": 21672,
   "key": "D1006le.txt:49",
   "file": "D1006le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊ロボ達の前方。",
   "ko_candidate": "파괴 로봇들의 전방에｡"
  },
  {
   "id": 21673,
   "key": "D1006le.txt:50",
   "file": "D1006le.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空間に穿たれた穴の如く、夜闇よりもなお深い暗黒が生じた。",
   "ko_candidate": "공간에 뚫린 구멍처럼､ 밤의 어둠보다 더 깊은 암흑이 생겼다｡"
  },
  {
   "id": 21674,
   "key": "D1006le.txt:54",
   "file": "D1006le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "たゆたい、揺らぎながら、滞空する闇黒の奥に、光が奔った。",
   "ko_candidate": "흔들리고 요동치며､ 공중에 떠 있는 암흑의 안쪽에서 빛이 달렸다｡"
  },
  {
   "id": 21675,
   "key": "D1006le.txt:55",
   "file": "D1006le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザの第六感回路にパルスが生じる。",
   "ko_candidate": "엘자의 제6감 회로에 펄스가 생긴다｡"
  },
  {
   "id": 21676,
   "key": "D1006le.txt:56",
   "file": "D1006le.txt",
   "line": 56,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛行の軌道を大きく逸らし、闇黒の前から退く。",
   "ko_candidate": "비행 궤도를 크게 벗어나 암흑의 앞에서 물러난다｡"
  },
  {
   "id": 21677,
   "key": "D1006le.txt:61",
   "file": "D1006le.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が乱舞した。",
   "ko_candidate": "빛이 난무했다｡"
  },
  {
   "id": 21678,
   "key": "D1006le.txt:63",
   "file": "D1006le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒の奥から放たれる雷光。",
   "ko_candidate": "암흑의 안쪽에서 방출되는 번개｡"
  },
  {
   "id": 21679,
   "key": "D1006le.txt:64",
   "file": "D1006le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "叫び、荒れ狂いながら、後方の破壊ロボ群を、根こそぎ撃ち砕いていく。",
   "ko_candidate": "외치고 날뛰면서 뒤쪽의 파괴 로봇 무리를 뿌리째 부숴버린다｡"
  },
  {
   "id": 21680,
   "key": "D1006le.txt:72",
   "file": "D1006le.txt",
   "line": 72,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こ、これは……」",
   "ko_candidate": "「이､ 이건…」"
  },
  {
   "id": 21681,
   "key": "D1006le.txt:76",
   "file": "D1006le.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雷光が止み――闇黒が晴れた。",
   "ko_candidate": "번개가 멈추고―암흑이 걷혔다｡"
  },
  {
   "id": 21682,
   "key": "D1006le.txt:77",
   "file": "D1006le.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒い霧が夜の闇に溶けてゆく。",
   "ko_candidate": "검은 안개가 밤의 어둠에 녹아들어간다｡"
  },
  {
   "id": 21683,
   "key": "D1006le.txt:78",
   "file": "D1006le.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして闇黒の霧が全て払われた其処に、その、黒の少女の姿はあった。",
   "ko_candidate": "그리고 암흑의 안개가 모두 걷힌 그곳에､ 그 검은 소녀의 모습이 있었다｡"
  },
  {
   "id": 21684,
   "key": "D1006le.txt:86",
   "file": "D1006le.txt",
   "line": 86,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「エセルドレーダ!? なぜロボっ!?」",
   "ko_candidate": "「에셀드레다!? 왜 여기에 있는 거야!?」"
  },
  {
   "id": 21685,
   "key": "D1006le.txt:91",
   "file": "D1006le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墨を流した様な髪を靡かせる少女は、確かにマスターテリオンの忠実なる従者のものだった。",
   "ko_candidate": "먹물을 흘린 듯한 머리카락을 휘날리는 소녀는 분명 마스터 테리온의 충실한 종복이었다｡"
  },
  {
   "id": 21686,
   "key": "D1006le.txt:92",
   "file": "D1006le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女は、エルザの乗る破壊ロボには全く興味を示した様子を見せず、ただ天空のクトゥルーを睨み続けていた。",
   "ko_candidate": "소녀는 엘자가 탄 파괴 로봇에는 전혀 관심을 보이지 않고､ 그저 하늘의 크툴루를 노려보고 있었다｡"
  },
  {
   "id": 21687,
   "key": "D1006le.txt:94",
   "file": "D1006le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、その表情は苦痛に歪んでいる。",
   "ko_candidate": "하지만 그 표정은 고통으로 일그러져 있다｡"
  },
  {
   "id": 21688,
   "key": "D1006le.txt:95",
   "file": "D1006le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの全力を賭して、この場に存在していると云う、そんな切実な苦痛。",
   "ko_candidate": "자신의 전력을 다해 이 자리에 존재하고 있다는､ 그런 절실한 고통｡"
  },
  {
   "id": 21689,
   "key": "D1006le.txt:96",
   "file": "D1006le.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宙に浮かぶその姿は、酷く危うく、儚げだった。",
   "ko_candidate": "공중에 떠 있는 그 모습은 몹시 위태롭고 덧없어 보였다｡"
  },
  {
   "id": 21690,
   "key": "D1006le.txt:103",
   "file": "D1006le.txt",
   "line": 103,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……く……ッ」",
   "ko_candidate": "「…크…읏」"
  },
  {
   "id": 21691,
   "key": "D1006le.txt:106",
   "file": "D1006le.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エセルドレーダの躰が傾いだ。",
   "ko_candidate": "에셀드레다의 몸이 기울었다｡"
  },
  {
   "id": 21692,
   "key": "D1006le.txt:107",
   "file": "D1006le.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身から力が抜け、いや脱け落ち、その躰は落下を始める。",
   "ko_candidate": "온몸에서 힘이 빠지고､ 아니 빠져나가 그 몸은 낙하하기 시작한다｡"
  },
  {
   "id": 21693,
   "key": "D1006le.txt:112",
   "file": "D1006le.txt",
   "line": 112,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――――ッ!?　エセルドレーダ！」",
   "ko_candidate": "「――――읏!? 에셀드레다!」"
  },
  {
   "id": 21694,
   "key": "D1006le.txt:116",
   "file": "D1006le.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故かは自分でも分からなかった。",
   "ko_candidate": "왜인지는 자신도 알 수 없었다｡"
  },
  {
   "id": 21695,
   "key": "D1006le.txt:117",
   "file": "D1006le.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "分からなかったが、気付けばエルザはエセルドレーダを追っていた。",
   "ko_candidate": "알 수 없었지만､ 정신을 차려보니 엘자는 에셀드레다를 쫓고 있었다｡"
  },
  {
   "id": 21696,
   "key": "D1006le.txt:118",
   "file": "D1006le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一気に加速して、エセルドレーダに追いつく。",
   "ko_candidate": "단숨에 가속해서 에셀드레다를 따라잡는다｡"
  },
  {
   "id": 21697,
   "key": "D1006le.txt:119",
   "file": "D1006le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女を掴まえようと、掌を伸ばして――",
   "ko_candidate": "그녀를 붙잡으려고 손바닥을 뻗어서――"
  },
  {
   "id": 21698,
   "key": "D1006le.txt:130",
   "file": "D1006le.txt",
   "line": 130,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 21699,
   "key": "D1006le.txt:134",
   "file": "D1006le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紙吹雪が散った。",
   "ko_candidate": "종이 조각이 흩날렸다｡"
  },
  {
   "id": 21700,
   "key": "D1006le.txt:135",
   "file": "D1006le.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女の躰が、魔導書のページと化して崩れてゆく。",
   "ko_candidate": "소녀의 몸이 마도서의 페이지로 변해 무너져 간다｡"
  },
  {
   "id": 21701,
   "key": "D1006le.txt:137",
   "file": "D1006le.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風に乗って舞う紙片――だが、破壊ロボの掌からは離れずに、渦を巻いた。",
   "ko_candidate": "바람을 타고 날아가는 종이 조각――하지만 파괴 로봇의 손바닥에서 떨어지지 않고 소용돌이쳤다｡"
  },
  {
   "id": 21702,
   "key": "D1006le.txt:138",
   "file": "D1006le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その渦の中心、鋼鉄の掌の上に、それは遺されていた。",
   "ko_candidate": "그 소용돌이의 중심､ 강철 손바닥 위에 그것이 남겨져 있었다｡"
  },
  {
   "id": 21703,
   "key": "D1006le.txt:141",
   "file": "D1006le.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一冊の魔導書――『ナコト写本』が。",
   "ko_candidate": "한 권의 마도서――『나코트 사본』이｡"
  },
  {
   "id": 21704,
   "key": "D1006le.txt:150",
   "file": "D1006le.txt",
   "line": 150,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「痛ぅぅぅ……ッッ！」",
   "ko_candidate": "「아파아아아…읏읏!」"
  },
  {
   "id": 21705,
   "key": "D1006le.txt:152",
   "file": "D1006le.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意識が覚醒するのと同時に、全身を激痛が駆け巡った。",
   "ko_candidate": "의식이 깨어나는 동시에 온몸에 격통이 달렸다｡"
  },
  {
   "id": 21706,
   "key": "D1006le.txt:153",
   "file": "D1006le.txt",
   "line": 153,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歯を食い縛って、それに堪える。",
   "ko_candidate": "이를 악물고 그것을 견딘다｡"
  },
  {
   "id": 21707,
   "key": "D1006le.txt:156",
   "file": "D1006le.txt",
   "line": 156,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「く……っ……ぐぐ……ッ」",
   "ko_candidate": "「크…읏…으으…읏」"
  }
 ]
}