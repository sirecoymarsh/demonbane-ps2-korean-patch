 },
 "items": [
  {
   "id": 22332,
   "key": "D1101le.txt:305",
   "file": "D1101le.txt",
   "line": 305,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……破壊ロボ！」",
   "ko_candidate": "「……파괴 로봇!」"
  },
  {
   "id": 22333,
   "key": "D1101le.txt:309",
   "file": "D1101le.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線を砲口の先へと向ける。",
   "ko_candidate": "시선을 포구 앞으로 향한다｡"
  },
  {
   "id": 22334,
   "key": "D1101le.txt:314",
   "file": "D1101le.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの飛行型の破壊ロボだ。俺たちを追ってきたのか？",
   "ko_candidate": "저 비행형 파괴 로봇이다｡ 우리를 쫓아온 건가?"
  },
  {
   "id": 22335,
   "key": "D1101le.txt:315",
   "file": "D1101le.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、それなら何で破壊ロボ……しかもたったの一機なんだ？",
   "ko_candidate": "하지만 그렇다면 왜 파괴 로봇… 그것도 단 한 대뿐인 거지?"
  },
  {
   "id": 22336,
   "key": "D1101le.txt:317",
   "file": "D1101le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵の思惑は分からないが、油断は出来ない。",
   "ko_candidate": "적의 의도는 알 수 없지만 방심할 수는 없다｡"
  },
  {
   "id": 22337,
   "key": "D1101le.txt:318",
   "file": "D1101le.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慎重に破壊ロボの動きを窺う。",
   "ko_candidate": "신중하게 파괴 로봇의 움직임을 살핀다｡"
  },
  {
   "id": 22338,
   "key": "D1101le.txt:325",
   "file": "D1101le.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがてプシューと閉じ込められていた空気を噴き出すような音を立てて、ハッチが開いた。有人機のようだ。",
   "ko_candidate": "이윽고 프슈 하고 갇혀 있던 공기를 내뿜는 듯한 소리를 내며 해치가 열렸다｡ 유인기인 것 같다｡"
  },
  {
   "id": 22339,
   "key": "D1101le.txt:327",
   "file": "D1101le.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、中から出てきたのは――",
   "ko_candidate": "그리고 안에서 나온 것은――"
  },
  {
   "id": 22340,
   "key": "D1101le.txt:331",
   "file": "D1101le.txt",
   "line": 331,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「!?　ら、ライカさん！ う、撃つの待ったぁぁぁぁ！」",
   "ko_candidate": "「!? 라､ 라이카 씨! 쏘､ 쏘지 마세요오오오오!」"
  },
  {
   "id": 22341,
   "key": "D1101le.txt:337",
   "file": "D1101le.txt",
   "line": 337,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――え？」",
   "ko_candidate": "「――어?」"
  },
  {
   "id": 22342,
   "key": "D1101le.txt:341",
   "file": "D1101le.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "止める俺を訝しげに見るライカさん。",
   "ko_candidate": "말리는 나를 의아하게 보는 라이카 씨｡"
  },
  {
   "id": 22343,
   "key": "D1101le.txt:342",
   "file": "D1101le.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ハッチから出てきた人物が、俺たちに向かって手を振った。",
   "ko_candidate": "해치에서 나온 인물이 우리를 향해 손을 흔들었다｡"
  },
  {
   "id": 22344,
   "key": "D1101le.txt:347",
   "file": "D1101le.txt",
   "line": 347,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ダーリンっっ！　生きていたロボか！」",
   "ko_candidate": "「달링~! 살아 있었로봇!」"
  },
  {
   "id": 22345,
   "key": "D1101le.txt:352",
   "file": "D1101le.txt",
   "line": 352,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「エルザか！」",
   "ko_candidate": "「엘자인가!」"
  },
  {
   "id": 22346,
   "key": "D1101le.txt:357",
   "file": "D1101le.txt",
   "line": 357,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待て！　動くな、『ブラックロッジ』！ いったい何を企んでいる！」",
   "ko_candidate": "「멈춰! 움직이지 마､ 『블랙로지』! 도대체 무슨 꿍꿍이야!」"
  },
  {
   "id": 22347,
   "key": "D1101le.txt:362",
   "file": "D1101le.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "厳しく警告するライカさん。",
   "ko_candidate": "엄하게 경고하는 라이카 씨｡"
  },
  {
   "id": 22348,
   "key": "D1101le.txt:363",
   "file": "D1101le.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがエルザは怯まなかった。",
   "ko_candidate": "하지만 엘자는 겁먹지 않았다｡"
  },
  {
   "id": 22349,
   "key": "D1101le.txt:364",
   "file": "D1101le.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "泣き出しそうな、深刻な表情で俺に訴える。",
   "ko_candidate": "울음을 터뜨릴 것 같은 심각한 표정으로 나에게 호소한다｡"
  },
  {
   "id": 22350,
   "key": "D1101le.txt:369",
   "file": "D1101le.txt",
   "line": 369,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ダーリン！　敵同士なのは承知の上でお願いするロボ！ 博士を、博士を助けて欲しいロボ！」",
   "ko_candidate": "「달링! 적끼리라는 걸 알면서도 부탁하는 로봇! 박사를､ 박사를 도와주었으면 하는 로봇!」"
  },
  {
   "id": 22351,
   "key": "D1101le.txt:374",
   "file": "D1101le.txt",
   "line": 374,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何だって？」",
   "ko_candidate": "「……뭐라고?」"
  },
  {
   "id": 22352,
   "key": "D1101le.txt:379",
   "file": "D1101le.txt",
   "line": 379,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこで、ようやくエルザが誰かを担いでいるのに気づいた。",
   "ko_candidate": "그제서야 엘자가 누군가를 부축하고 있는 것을 알아챘다｡"
  },
  {
   "id": 22353,
   "key": "D1101le.txt:381",
   "file": "D1101le.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔面は蒼白、意識も失っている様子だったが、間違いない。",
   "ko_candidate": "얼굴은 창백하고 의식도 잃은 것 같았지만､ 틀림없다｡"
  },
  {
   "id": 22354,
   "key": "D1101le.txt:382",
   "file": "D1101le.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "知っている顔だった。",
   "ko_candidate": "아는 얼굴이었다｡"
  },
  {
   "id": 22355,
   "key": "D1101le.txt:385",
   "file": "D1101le.txt",
   "line": 385,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ど、ドクター・ウェスト!?」",
   "ko_candidate": "「닥､ 닥터 웨스트!?」"
  },
  {
   "id": 22356,
   "key": "D1101le.txt:390",
   "file": "D1101le.txt",
   "line": 390,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どういうこと……」",
   "ko_candidate": "「어떻게 된 거지…」"
  },
  {
   "id": 22357,
   "key": "D1101le.txt:398",
   "file": "D1101le.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても会話に割り込んで、車のブレーキ音が鳴り響いた。",
   "ko_candidate": "또다시 대화에 끼어들어 자동차 브레이크 소리가 울려 퍼졌다｡"
  },
  {
   "id": 22358,
   "key": "D1101le.txt:399",
   "file": "D1101le.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐ側に装甲車が止まる。",
   "ko_candidate": "바로 옆에 장갑차가 멈춘다｡"
  },
  {
   "id": 22359,
   "key": "D1101le.txt:401",
   "file": "D1101le.txt",
   "line": 401,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "中から出てきたのは、覇道家のメイドさん一行だった。",
   "ko_candidate": "안에서 나온 것은 하도가의 메이드 일행이었다｡"
  },
  {
   "id": 22360,
   "key": "D1101le.txt:406",
   "file": "D1101le.txt",
   "line": 406,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なんでこんなトコに破壊ロボがっ！」",
   "ko_candidate": "「왜 이런 곳에 파괴 로봇이!」"
  },
  {
   "id": 22361,
   "key": "D1101le.txt:411",
   "file": "D1101le.txt",
   "line": 411,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あっ！　大十字さん！　大十字さんも居ますよ！」",
   "ko_candidate": "「앗! 다이쥬지 씨! 다이쥬지 씨도 계시네요!」"
  },
  {
   "id": 22362,
   "key": "D1101le.txt:416",
   "file": "D1101le.txt",
   "line": 416,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――あ、アルたんは？　おろおろおろおろおろおろおろ……」",
   "ko_candidate": "「――아､ 알 양은? 오로오로오로오로오로오로오로……」"
  },
  {
   "id": 22363,
   "key": "D1101le.txt:421",
   "file": "D1101le.txt",
   "line": 421,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それに……あれはメタトロン？ おーい……」",
   "ko_candidate": "「그리고… 저건 메타트론? 어이…」"
  },
  {
   "id": 22364,
   "key": "D1101le.txt:427",
   "file": "D1101le.txt",
   "line": 427,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――っ!?」",
   "ko_candidate": "「――읏!?」"
  },
  {
   "id": 22365,
   "key": "D1101le.txt:431",
   "file": "D1101le.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔を隠し、機械の翼を広げる。",
   "ko_candidate": "얼굴을 가리고 기계의 날개를 펼친다｡"
  },
  {
   "id": 22366,
   "key": "D1101le.txt:432",
   "file": "D1101le.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "噴き出すフレアの閃光が一瞬、辺りを灼く。",
   "ko_candidate": "뿜어져 나오는 플레어의 섬광이 순간 주변을 태운다｡"
  },
  {
   "id": 22367,
   "key": "D1101le.txt:433",
   "file": "D1101le.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆風に煽られ、危うく転びそうになった。",
   "ko_candidate": "폭풍에 휩쓸려 위태롭게 넘어질 뻔했다｡"
  },
  {
   "id": 22368,
   "key": "D1101le.txt:438",
   "file": "D1101le.txt",
   "line": 438,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？　ええっ？　ライ――」",
   "ko_candidate": "「엣? 에엣? 라이――」"
  },
  {
   "id": 22369,
   "key": "D1101le.txt:440",
   "file": "D1101le.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "顔を見られそうだったからか、止める暇もなく、ライカさんは超高速で、逃げるように翔び去ってしまう。",
   "ko_candidate": "얼굴을 보일 뻔했기 때문인지､ 말릴 틈도 없이 라이카 씨는 초고속으로 도망치듯 날아가 버렸다｡"
  },
  {
   "id": 22370,
   "key": "D1101le.txt:446",
   "file": "D1101le.txt",
   "line": 446,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何や？　いったい……」",
   "ko_candidate": "「뭐､ 뭐야? 도대체…」"
  },
  {
   "id": 22371,
   "key": "D1101le.txt:453",
   "file": "D1101le.txt",
   "line": 453,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それよりも早く博士をぉぉぉぉ～～～～！」",
   "ko_candidate": "「그보다 빨리 박사를 어어어어~~~~~!」"
  }
 ]
}