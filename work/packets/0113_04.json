 "items": [
  {
   "id": 1477,
   "key": "D0113.txt:1491",
   "file": "D0113.txt",
   "line": 1491,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どうしようってんだよ。こんな……",
   "ko_candidate": "어쩌자는 거야｡ 이런……"
  },
  {
   "id": 1478,
   "key": "D0113.txt:1502",
   "file": "D0113.txt",
   "line": 1502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――こんな破壊神！",
   "ko_candidate": "――이런 파괴신!"
  },
  {
   "id": 1479,
   "key": "D0113.txt:1512",
   "file": "D0113.txt",
   "line": 1512,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「冗談じゃねえよ……ったく」",
   "ko_candidate": "「농담이 아니라고……정말」"
  },
  {
   "id": 1480,
   "key": "D0113.txt:1515",
   "file": "D0113.txt",
   "line": 1515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "思えば、このとき総ては決定されたのだろう。",
   "ko_candidate": "생각해보면､ 이때､ 모든 것이 결정되었던 것일까｡"
  },
  {
   "id": 1481,
   "key": "D0113.txt:1518",
   "file": "D0113.txt",
   "line": 1518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺がアル・アジフに出逢ったことも。",
   "ko_candidate": "내가 알 아지프를 만난 것도､"
  },
  {
   "id": 1482,
   "key": "D0113.txt:1519",
   "file": "D0113.txt",
   "line": 1519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "地下でデモンベインを見つけたことも。",
   "ko_candidate": "지하에서 데몬베인을 발견한 것도､"
  },
  {
   "id": 1483,
   "key": "D0113.txt:1521",
   "file": "D0113.txt",
   "line": 1521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "全部――この少女に言わせるなら、運命が俺に戦うべき道を指し示したからだ。",
   "ko_candidate": "전부､ 이 소녀의 말을 빌리자면､ 운명이 나에게 싸워야 할 길을 가리켰기 때문이다｡"
  },
  {
   "id": 1484,
   "key": "D0113.txt:1524",
   "file": "D0113.txt",
   "line": 1524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう、それはこのアーカムシティの命運を賭けた――いや、この地球の、もしかしたら全宇宙の命運をも決定するかのような、大きな戦いの道。",
   "ko_candidate": "그래､ 그것은､ 이 아캄시티의 운명을 건―― 아니､ 이 지구의､ 어쩌면 전 우주의 운명마저 결정할 것 같은､ 거대한 싸움의 길｡"
  },
  {
   "id": 1485,
   "key": "D0113.txt:1527",
   "file": "D0113.txt",
   "line": 1527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、このときの俺はまだそのことを知らない――",
   "ko_candidate": "하지만､ 이때의 나는､ 아직 그것을 알지 못한다――"
  },
  {
   "id": 1486,
   "key": "D0113.txt:1545",
   "file": "D0113.txt",
   "line": 1545,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一部始終を、少年は見届けていた。",
   "ko_candidate": "전말을､ 소년은 지켜보고 있었다｡"
  },
  {
   "id": 1487,
   "key": "D0113.txt:1558",
   "file": "D0113.txt",
   "line": 1558,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アーカムシティ上空。",
   "ko_candidate": "아캄시티 상공｡"
  },
  {
   "id": 1488,
   "key": "D0113.txt:1559",
   "file": "D0113.txt",
   "line": 1559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "高度１０００メートル。",
   "ko_candidate": "고도 1000미터｡"
  },
  {
   "id": 1489,
   "key": "D0113.txt:1561",
   "file": "D0113.txt",
   "line": 1561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少年は月を背負い、夜空に浮いていた。",
   "ko_candidate": "소년은 달을 등지고､ 밤하늘에 떠 있었다｡"
  },
  {
   "id": 1490,
   "key": "D0113.txt:1568",
   "file": "D0113.txt",
   "line": 1568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "強風が少年を叩きつける。",
   "ko_candidate": "강풍이 소년을 때린다｡"
  },
  {
   "id": 1491,
   "key": "D0113.txt:1569",
   "file": "D0113.txt",
   "line": 1569,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "長い金色の髪が、月の光を照り返しながら靡いていた。",
   "ko_candidate": "긴 금색 머리카락이､ 달빛을 반사하며､ 휘날리고 있었다｡"
  },
  {
   "id": 1492,
   "key": "D0113.txt:1571",
   "file": "D0113.txt",
   "line": 1571,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それでも少年は、微塵にも揺らがない。",
   "ko_candidate": "그래도 소년은､ 조금도 흔들리지 않는다｡"
  },
  {
   "id": 1493,
   "key": "D0113.txt:1573",
   "file": "D0113.txt",
   "line": 1573,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "口許には冷たく凄惨な、亀裂の様な微笑を浮かべて。金色の眸で――金色でありながら一切の光を放たない闇色の眸で、街に穿たれた穴を見下ろしながら。",
   "ko_candidate": "입가에는 차갑고 처참한､ 균열 같은 미소를 띠고｡ 금색 눈동자로―― 금색이면서도 일체의 빛을 내지 않는 어둠색 눈동자로､ 거리에 뚫린 구멍을 내려다보며｡"
  },
  {
   "id": 1494,
   "key": "D0113.txt:1576",
   "file": "D0113.txt",
   "line": 1576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少年の名はマスターテリオン。",
   "ko_candidate": "소년의 이름은 마스터 테리온｡"
  },
  {
   "id": 1495,
   "key": "D0113.txt:1577",
   "file": "D0113.txt",
   "line": 1577,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『ブラックロッジ』を束ねる大導師。 「やはり今回もこうなったか。そうだ、総ては運命の輪の内に」",
   "ko_candidate": "『블랙로지』를 총괄하는 그랜드 마스터｡"
  },
  {
   "id": 1497,
   "key": "D0113.txt:1585",
   "file": "D0113.txt",
   "line": 1585,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ、踊ろうではないか。 あの忌まわしきフルートが奏でる、狂った輪舞曲の調べに乗って」 「ヒロインは貴公だ ――アル・アジフ」",
   "ko_candidate": "【File01:I AM PROVIDENCE】closed<PRE>."
  }
 ]
}