{
 "packet": "1102_04",
 "scene": "1102",
 "anchor": {
  "hit": 9,
  "total": 10,
  "rate": 0.9
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "瑠璃": "루리",
  "アル": "알",
  "デモンベイン": "데몬베인",
  "クトゥルー": "크툴루",
  "アーカムシティ": "아컴시티",
  "アンチクロス": "안티크로스",
  "鬼械神": "귀계신",
  "ウィンフィールド": "윈필드",
  "破壊ロボ": "파괴 로봇"
 },
 "items": [
  {
   "id": 22664,
   "key": "D1102ru.txt:24",
   "file": "D1102ru.txt",
   "line": 24,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それで、九郎の容態は？」",
   "ko_candidate": "「그래서､ 쿠로의 상태는?」"
  },
  {
   "id": 22665,
   "key": "D1102ru.txt:35",
   "file": "D1102ru.txt",
   "line": 35,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「危険な状態が続いています。今日明日いっぱいが峠でしょう」",
   "ko_candidate": "「위험한 상태가 계속되고 있습니다｡ 오늘 내일이 고비가 될 거예요」"
  },
  {
   "id": 22666,
   "key": "D1102ru.txt:40",
   "file": "D1102ru.txt",
   "line": 40,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……そうか」",
   "ko_candidate": "「……그렇군」"
  },
  {
   "id": 22667,
   "key": "D1102ru.txt:46",
   "file": "D1102ru.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呟き、窓の方を盗み見る。",
   "ko_candidate": "중얼거리며 창문 쪽을 훔쳐본다｡"
  },
  {
   "id": 22668,
   "key": "D1102ru.txt:48",
   "file": "D1102ru.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視線の先に、凝っと九郎を見守り続ける瑠璃が見えた。",
   "ko_candidate": "시선 끝에 쿠로를 뚫어지게 지켜보고 있는 루리가 보였다｡"
  },
  {
   "id": 22669,
   "key": "D1102ru.txt:50",
   "file": "D1102ru.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先程から微動だにせず、一言も喋らず、窓に張りついている。",
   "ko_candidate": "아까부터 미동도 않고 한마디도 하지 않은 채 창문에 붙어 있다｡"
  },
  {
   "id": 22670,
   "key": "D1102ru.txt:55",
   "file": "D1102ru.txt",
   "line": 55,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ふん」",
   "ko_candidate": "「……흥」"
  },
  {
   "id": 22671,
   "key": "D1102ru.txt:59",
   "file": "D1102ru.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "苛立たしく、鼻を鳴らして視線を逸らす。",
   "ko_candidate": "짜증 나는 듯 콧방귀를 뀌며 시선을 돌린다｡"
  },
  {
   "id": 22672,
   "key": "D1102ru.txt:61",
   "file": "D1102ru.txt",
   "line": 61,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心配や怒りを心の奥に押し込め、アルはこれからの事を思案する。",
   "ko_candidate": "걱정과 분노를 마음속 깊이 밀어 넣고 알은 앞으로의 일을 생각한다｡"
  },
  {
   "id": 22673,
   "key": "D1102ru.txt:63",
   "file": "D1102ru.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは破壊され、九郎は重体。",
   "ko_candidate": "데몬베인은 파괴되고 쿠로는 중태｡"
  },
  {
   "id": 22674,
   "key": "D1102ru.txt:65",
   "file": "D1102ru.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アーカムシティ上空では、顕現したクトゥルーがいつ醒めるやも知れない、浅い眠りについている。",
   "ko_candidate": "아캄시티 상공에서는 현현한 크툴루가 언제 깰지 모르는 얕은 잠에 빠져 있다｡"
  },
  {
   "id": 22675,
   "key": "D1102ru.txt:67",
   "file": "D1102ru.txt",
   "line": 67,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――状況は最悪だ。",
   "ko_candidate": "――상황은 최악이다｡"
  },
  {
   "id": 22676,
   "key": "D1102ru.txt:68",
   "file": "D1102ru.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これから、どうやって戦う？",
   "ko_candidate": "앞으로 어떻게 싸울 것인가?"
  },
  {
   "id": 22677,
   "key": "D1102ru.txt:69",
   "file": "D1102ru.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もし九郎がこのまま復活しなければ――",
   "ko_candidate": "만약 쿠로가 이대로 회복하지 못한다면――"
  },
  {
   "id": 22678,
   "key": "D1102ru.txt:74",
   "file": "D1102ru.txt",
   "line": 74,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "（……ッ。……落ち着け）",
   "ko_candidate": "（……｡ ……진정해）"
  },
  {
   "id": 22679,
   "key": "D1102ru.txt:78",
   "file": "D1102ru.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思考が悪い方向に進むのを、必死で振り払う。",
   "ko_candidate": "생각이 나쁜 방향으로 흐르는 것을 필사적으로 떨쳐낸다｡"
  },
  {
   "id": 22680,
   "key": "D1102ru.txt:80",
   "file": "D1102ru.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今は九郎を信じる。それしかない。",
   "ko_candidate": "지금은 쿠로를 믿는 수밖에 없다｡"
  },
  {
   "id": 22681,
   "key": "D1102ru.txt:82",
   "file": "D1102ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、どちらにせよ、あれだけの重傷を負っているのだ。",
   "ko_candidate": "하지만 어쨌든 저만큼의 중상을 입은 것이다｡"
  },
  {
   "id": 22682,
   "key": "D1102ru.txt:84",
   "file": "D1102ru.txt",
   "line": 84,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎無しで戦う覚悟も決める必要があるだろう。",
   "ko_candidate": "쿠로 없이 싸울 각오도 해야 할 것이다｡"
  },
  {
   "id": 22683,
   "key": "D1102ru.txt:86",
   "file": "D1102ru.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベイン自体は、今、修理が進んでいる。",
   "ko_candidate": "데몬베인 자체는 지금 수리가 진행되고 있다｡"
  },
  {
   "id": 22684,
   "key": "D1102ru.txt:88",
   "file": "D1102ru.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、術者無しでアンチクロスの鬼械神を相手にする――それは余りにも無謀だ。何か策を用意しなければならない。",
   "ko_candidate": "하지만 술자 없이 안티 크로스의 귀계신을 상대하는 것은 너무나 무모하다｡ 무언가 대책을 마련해야 한다｡"
  },
  {
   "id": 22685,
   "key": "D1102ru.txt:90",
   "file": "D1102ru.txt",
   "line": 90,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どのような、策を？",
   "ko_candidate": "어떤 대책을?"
  },
  {
   "id": 22686,
   "key": "D1102ru.txt:91",
   "file": "D1102ru.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "生半可な小細工が通用する相手ではない。",
   "ko_candidate": "생반가한 꼼수가 통할 상대가 아니다｡"
  },
  {
   "id": 22687,
   "key": "D1102ru.txt:93",
   "file": "D1102ru.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "加えて、格納庫内への空間転移――この現象については、未だもって謎だった――によって生じた衝撃波は、虚数展開カタパルトに壊滅的なダメージを与えてしまった。こちらの復旧の目途は、まったく立たないらしい。",
   "ko_candidate": "게다가 격납고 내로의 공간전이――이 현상에 대해서는 아직도 수수께끼였다――로 인해 발생한 충격파는 허수전개 카타펄트에 치명적인 데미지를 주고 말았다｡ 이쪽의 복구 전망은 전혀 서지 않는 모양이다｡"
  },
  {
   "id": 22688,
   "key": "D1102ru.txt:95",
   "file": "D1102ru.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空を飛べないデモンベイン。",
   "ko_candidate": "하늘을 날 수 없는 데몬베인｡"
  },
  {
   "id": 22689,
   "key": "D1102ru.txt:96",
   "file": "D1102ru.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "壊れた虚数展開カタパルト。",
   "ko_candidate": "부서진 허수전개 카타펄트｡"
  },
  {
   "id": 22690,
   "key": "D1102ru.txt:98",
   "file": "D1102ru.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "つまり現状に於いて、上空のクトゥルーに対抗する手段は何一つない。",
   "ko_candidate": "즉 현 상황에서 상공의 크툴루에 대항할 수단은 하나도 없다｡"
  },
  {
   "id": 22691,
   "key": "D1102ru.txt:100",
   "file": "D1102ru.txt",
   "line": 100,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クトゥルーが覚醒する前に、神の中枢、移動要塞たる 『夢幻心母』に侵入出来れば、まだ勝算もあるのだが――",
   "ko_candidate": "크툴루가 각성하기 전에 신의 중추､ 이동요새인 『몽환심모』에 침입할 수 있다면 아직 승산도 있겠지만――"
  },
  {
   "id": 22692,
   "key": "D1102ru.txt:103",
   "file": "D1102ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "出口の見えない思考に陥ったその時だった。",
   "ko_candidate": "출구가 보이지 않는 생각에 빠진 그때였다｡"
  },
  {
   "id": 22693,
   "key": "D1102ru.txt:107",
   "file": "D1102ru.txt",
   "line": 107,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "基地内に、けたたましいアラームが鳴り響く。",
   "ko_candidate": "기지 내에 요란한 경보음이 울려 퍼진다｡"
  },
  {
   "id": 22694,
   "key": "D1102ru.txt:109",
   "file": "D1102ru.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一同は緊張に顔を強張らせた。",
   "ko_candidate": "일동은 긴장으로 얼굴을 굳혔다｡"
  },
  {
   "id": 22695,
   "key": "D1102ru.txt:111",
   "file": "D1102ru.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウィンフィールドが、すぐさま司令室に通信を繋ぐ。",
   "ko_candidate": "윈필드가 곧바로 사령실에 통신을 연결한다｡"
  },
  {
   "id": 22696,
   "key": "D1102ru.txt:117",
   "file": "D1102ru.txt",
   "line": 117,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何事です！」",
   "ko_candidate": "「무슨 일입니까!」"
  },
  {
   "id": 22697,
   "key": "D1102ru.txt:122",
   "file": "D1102ru.txt",
   "line": 122,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――上空の『夢幻心母』より飛行型の破壊ロボが降下して来ました」",
   "ko_candidate": "「――상공의 『몽환심모』에서 비행형 파괴 로봇이 하강하고 있습니다」"
  },
  {
   "id": 22698,
   "key": "D1102ru.txt:128",
   "file": "D1102ru.txt",
   "line": 128,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「数は!?」",
   "ko_candidate": "「숫자는!?」"
  },
  {
   "id": 22699,
   "key": "D1102ru.txt:133",
   "file": "D1102ru.txt",
   "line": 133,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、それが……一機だけですっ」",
   "ko_candidate": "「그､ 그게……한 대뿐입니다」"
  },
  {
   "id": 22700,
   "key": "D1102ru.txt:138",
   "file": "D1102ru.txt",
   "line": 138,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……一機だけだと？」",
   "ko_candidate": "「……한 대뿐이라고?」"
  },
  {
   "id": 22701,
   "key": "D1102ru.txt:142",
   "file": "D1102ru.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何の罠だ？",
   "ko_candidate": "무슨 함정이지?"
  },
  {
   "id": 22702,
   "key": "D1102ru.txt:143",
   "file": "D1102ru.txt",
   "line": 143,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰もがそう思った。",
   "ko_candidate": "모두가 그렇게 생각했다｡"
  },
  {
   "id": 22703,
   "key": "D1102ru.txt:145",
   "file": "D1102ru.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが誰一人として、敵の意図が掴めなかった。",
   "ko_candidate": "하지만 누구도 적의 의도를 파악하지 못했다｡"
  }
 ]
}