 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카",
  "九郎": "쿠로",
  "魔導書": "마도서",
  "姫さん": "공주님",
  "執事さん": "집사님",
  "覇道鋼造": "하도 코조",
  "覇道財閥": "하도 재벌",
  "デモンベイン": "데몬베인"
 },
 "items": [
  {
   "id": 15142,
   "key": "D0809le.txt:892",
   "file": "D0809le.txt",
   "line": 892,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕を縛り、足を縛り、身体を腰を入念に何度も縛りつける。",
   "ko_candidate": "팔을 묶고､ 다리를 묶고､ 몸과 허리를 꼼꼼히 여러 번 묶는다｡"
  },
  {
   "id": 15143,
   "key": "D0809le.txt:894",
   "file": "D0809le.txt",
   "line": 894,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "芋虫のように地面に転がるライカさんを、脱獄囚は軽々と担ぎ上げた。",
   "ko_candidate": "애벌레처럼 바닥을 구르는 라이카 씨를 탈옥수는 가볍게 들어 올렸다｡"
  },
  {
   "id": 15144,
   "key": "D0809le.txt:899",
   "file": "D0809le.txt",
   "line": 899,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……しまった！」",
   "ko_candidate": "「크윽……아차!」"
  },
  {
   "id": 15145,
   "key": "D0809le.txt:903",
   "file": "D0809le.txt",
   "line": 903,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拘束されつつも、ライカさんはまだ喋り続ける。",
   "ko_candidate": "구속당하면서도 라이카 씨는 아직 말을 계속한다｡"
  },
  {
   "id": 15146,
   "key": "D0809le.txt:905",
   "file": "D0809le.txt",
   "line": 905,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつもどおりのライカさんの声で。",
   "ko_candidate": "언제나처럼 라이카 씨의 목소리로｡"
  },
  {
   "id": 15147,
   "key": "D0809le.txt:906",
   "file": "D0809le.txt",
   "line": 906,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんのものではない言葉を。",
   "ko_candidate": "라이카 씨의 것이 아닌 말을｡"
  },
  {
   "id": 15148,
   "key": "D0809le.txt:911",
   "file": "D0809le.txt",
   "line": 911,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こうすれば九郎は本気で怒る。そうじゃなくちゃ意味が無い」 「１３番封鎖区画と１４番区の境界の、一番大きい建物の中で待っている」",
   "ko_candidate": "「이렇게 하면 쿠로는 진심으로 화낼 거야｡ 그렇지 않으면 의미가 없어｡ 13번 봉쇄구역과 14번 구역의 경계에 있는 가장 큰 건물 안에서 기다리고 있을게｡ 자､ 쿠로｡ 실망시키지 말아줘」"
  },
  {
   "id": 15149,
   "key": "D0809le.txt:917",
   "file": "D0809le.txt",
   "line": 917,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さあ、九郎。がっかりさせないでね」",
   "ko_candidate": "「기다려!」"
  },
  {
   "id": 15150,
   "key": "D0809le.txt:922",
   "file": "D0809le.txt",
   "line": 922,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「待ちやがれ！」 間に合わない。脱獄囚は生物の限界を遥かに超えた跳躍力で、空に舞う。",
   "ko_candidate": "미처 따라잡지 못한다｡ 탈옥수는 생물의 한계를 훨씬 뛰어넘는 도약력으로 하늘로 날아오른다｡"
  },
  {
   "id": 15151,
   "key": "D0809le.txt:931",
   "file": "D0809le.txt",
   "line": 931,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔術の発動。",
   "ko_candidate": "마술의 발동｡"
  },
  {
   "id": 15152,
   "key": "D0809le.txt:933",
   "file": "D0809le.txt",
   "line": 933,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宙にある脱獄囚の周囲を取り囲み、魔導書のページが吹き荒れた。",
   "ko_candidate": "공중에 있는 탈옥수의 주위를 둘러싸고 마도서의 페이지가 휘몰아쳤다｡"
  },
  {
   "id": 15153,
   "key": "D0809le.txt:938",
   "file": "D0809le.txt",
   "line": 938,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紙吹雪の向こうに、脱獄囚とライカさんの姿が消える。",
   "ko_candidate": "종이 조각 너머로 탈옥수와 라이카 씨의 모습이 사라진다｡"
  },
  {
   "id": 15154,
   "key": "D0809le.txt:941",
   "file": "D0809le.txt",
   "line": 941,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……っ!?」",
   "ko_candidate": "「……!?」"
  },
  {
   "id": 15155,
   "key": "D0809le.txt:943",
   "file": "D0809le.txt",
   "line": 943,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最後に脱獄囚が、俺の口を乗っ取って、呟いた。",
   "ko_candidate": "마지막으로 탈옥수가 내 입을 빼앗아 중얼거렸다｡"
  },
  {
   "id": 15156,
   "key": "D0809le.txt:947",
   "file": "D0809le.txt",
   "line": 947,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だって、九郎だけがこの『暴君』を滅ぼし得る。 ねっ、神殺しの刃」",
   "ko_candidate": "「왜냐하면､ 쿠로만이 이 『폭군』을 멸망시킬 수 있으니까｡ 그렇지､ 신을 죽이는 칼」"
  },
  {
   "id": 15157,
   "key": "D0809ru.txt:10",
   "file": "D0809ru.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "楽しい時間は経つのが早い。",
   "ko_candidate": "즐거운 시간은 빨리 지나간다｡"
  },
  {
   "id": 15158,
   "key": "D0809ru.txt:11",
   "file": "D0809ru.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あっという間に日が暮れてしまった。",
   "ko_candidate": "눈 깜짝할 사이에 해가 저물어 버렸다｡"
  },
  {
   "id": 15159,
   "key": "D0809ru.txt:13",
   "file": "D0809ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あちこち歩いて、さすがに疲れきった俺たちは、公園で休むことにした。",
   "ko_candidate": "이곳저곳 걸어다니느라 역시나 지친 우리는 공원에서 쉬기로 했다｡"
  },
  {
   "id": 15160,
   "key": "D0809ru.txt:15",
   "file": "D0809ru.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夕陽が、空を紅く染める。",
   "ko_candidate": "석양이 하늘을 붉게 물들인다｡"
  },
  {
   "id": 15161,
   "key": "D0809ru.txt:17",
   "file": "D0809ru.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遠くを見つめる姫さんの顔も、綺麗な紅で染められている。",
   "ko_candidate": "멀리 바라보는 공주의 얼굴도 아름다운 붉은빛으로 물들어 있다｡"
  },
  {
   "id": 15162,
   "key": "D0809ru.txt:23",
   "file": "D0809ru.txt",
   "line": 23,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふふ……こんなに歩き回ったのは、初めてかも知れませんわ」",
   "ko_candidate": "「후후… 이렇게 많이 걸어다닌 건 처음일지도 모르겠어요」"
  },
  {
   "id": 15163,
   "key": "D0809ru.txt:27",
   "file": "D0809ru.txt",
   "line": 27,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちょっと頑張り過ぎたかもな……悪ィ」",
   "ko_candidate": "「좀 무리했나… 미안」"
  },
  {
   "id": 15164,
   "key": "D0809ru.txt:31",
   "file": "D0809ru.txt",
   "line": 31,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いえ、そんな！　とても楽しかったですからっ！」",
   "ko_candidate": "「아니에요､ 그런 말씀 마세요! 정말 즐거웠으니까요!」"
  },
  {
   "id": 15165,
   "key": "D0809ru.txt:35",
   "file": "D0809ru.txt",
   "line": 35,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そうか……そりゃあ良かった」",
   "ko_candidate": "「그래… 다행이다」"
  },
  {
   "id": 15166,
   "key": "D0809ru.txt:39",
   "file": "D0809ru.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、お互い微笑み合った。",
   "ko_candidate": "말하고 서로 미소 지었다｡"
  },
  {
   "id": 15167,
   "key": "D0809ru.txt:40",
   "file": "D0809ru.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど、姫さんの笑顔に僅かに寂しい陰が覗いたのを、俺は見逃さなかった。",
   "ko_candidate": "하지만 공주의 미소에 살짝 슬픈 그림자가 비친 것을 나는 놓치지 않았다｡"
  },
  {
   "id": 15168,
   "key": "D0809ru.txt:43",
   "file": "D0809ru.txt",
   "line": 43,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ん……？　どうかしたか？」",
   "ko_candidate": "「음…? 무슨 일 있어?」"
  },
  {
   "id": 15169,
   "key": "D0809ru.txt:49",
   "file": "D0809ru.txt",
   "line": 49,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「え……？」",
   "ko_candidate": "「에…?」"
  },
  {
   "id": 15170,
   "key": "D0809ru.txt:53",
   "file": "D0809ru.txt",
   "line": 53,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今……少し、寂しそうだった」",
   "ko_candidate": "「방금… 조금 쓸쓸해 보였어」"
  },
  {
   "id": 15171,
   "key": "D0809ru.txt:57",
   "file": "D0809ru.txt",
   "line": 57,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……」",
   "ko_candidate": "「아…」"
  },
  {
   "id": 15172,
   "key": "D0809ru.txt:60",
   "file": "D0809ru.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんは心底、驚いた顔で、俺のことを見つめ返す。",
   "ko_candidate": "공주는 정말 놀란 얼굴로 나를 바라본다｡"
  },
  {
   "id": 15173,
   "key": "D0809ru.txt:62",
   "file": "D0809ru.txt",
   "line": 62,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しばし、無言。",
   "ko_candidate": "잠시 침묵｡"
  },
  {
   "id": 15174,
   "key": "D0809ru.txt:64",
   "file": "D0809ru.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……まずいことを言ってしまったか。何か居心地が悪い。",
   "ko_candidate": "…실수한 말을 한 걸까｡ 뭔가 어색하다｡"
  },
  {
   "id": 15175,
   "key": "D0809ru.txt:67",
   "file": "D0809ru.txt",
   "line": 67,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あー、その、ごめん。気に障ったかな……？」",
   "ko_candidate": "「아-､ 그､ 미안｡ 기분 상했어…?」"
  },
  {
   "id": 15176,
   "key": "D0809ru.txt:73",
   "file": "D0809ru.txt",
   "line": 73,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……いえ、違いますわ。ただ少し、昔を思い出してしまいまして」",
   "ko_candidate": "「아… 아니에요､ 그게 아니에요｡ 그저 잠깐 옛날 생각이 나서요」"
  },
  {
   "id": 15177,
   "key": "D0809ru.txt:77",
   "file": "D0809ru.txt",
   "line": 77,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「昔？」",
   "ko_candidate": "「옛날?」"
  },
  {
   "id": 15178,
   "key": "D0809ru.txt:83",
   "file": "D0809ru.txt",
   "line": 83,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ええ……子どもの頃。 お爺様は、よくわたくしを遊びに連れ出してくれたなと」",
   "ko_candidate": "「네… 어릴 때요｡ 할아버지께서 자주 저를 놀러 데려가 주셨다고요」"
  },
  {
   "id": 15179,
   "key": "D0809ru.txt:88",
   "file": "D0809ru.txt",
   "line": 88,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……なるほど」",
   "ko_candidate": "「아아… 그렇구나」"
  },
  {
   "id": 15180,
   "key": "D0809ru.txt:92",
   "file": "D0809ru.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "執事さんから聞いたことがある。",
   "ko_candidate": "집사님에게 들은 적이 있다｡"
  },
  {
   "id": 15181,
   "key": "D0809ru.txt:94",
   "file": "D0809ru.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覇道鋼造――覇道財閥の初代総帥にしてデモンベインの製造者。",
   "ko_candidate": "하도 코조 - 하도 재벌의 초대 총수이자 데몬베인의 제조자｡"
  }
 ]
}