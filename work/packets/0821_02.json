 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "テリオン": "테리온"
 },
 "items": [
  {
   "id": 17575,
   "key": "D0821le.txt:212",
   "file": "D0821le.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何を、いったい何を求めているのだろう。",
   "ko_candidate": "무엇을､ 도대체 무엇을 바라고 있는 걸까｡"
  },
  {
   "id": 17576,
   "key": "D0821le.txt:214",
   "file": "D0821le.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この苦痛の只中で",
   "ko_candidate": "이 고통의 한가운데서"
  },
  {
   "id": 17577,
   "key": "D0821le.txt:215",
   "file": "D0821le.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冒涜の只中で",
   "ko_candidate": "모독의 한가운데서"
  },
  {
   "id": 17578,
   "key": "D0821le.txt:216",
   "file": "D0821le.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "凌辱の只中で",
   "ko_candidate": "능욕의 한가운데서"
  },
  {
   "id": 17579,
   "key": "D0821le.txt:218",
   "file": "D0821le.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いったい何を。",
   "ko_candidate": "도대체 무엇을｡"
  },
  {
   "id": 17580,
   "key": "D0821le.txt:219",
   "file": "D0821le.txt",
   "line": 219,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何を、こんなに、焦がれている？",
   "ko_candidate": "무엇을 이렇게나 갈망하고 있는 거지?"
  },
  {
   "id": 17581,
   "key": "D0821le.txt:221",
   "file": "D0821le.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛すら見つからない、この世界に――",
   "ko_candidate": "사랑조차 찾을 수 없는 이 세상에서――"
  },
  {
   "id": 17582,
   "key": "D0821le.txt:225",
   "file": "D0821le.txt",
   "line": 225,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――あ」",
   "ko_candidate": "「――아」"
  },
  {
   "id": 17583,
   "key": "D0821le.txt:228",
   "file": "D0821le.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "気付いて、しまった。",
   "ko_candidate": "깨달아 버렸다｡"
  },
  {
   "id": 17584,
   "key": "D0821le.txt:232",
   "file": "D0821le.txt",
   "line": 232,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あぁぁ……あああああ……ああああああああああああああ！ あああああああああああああああああああああッッッッッ！」",
   "ko_candidate": "「아아… 아아아아… 아아아아아아아아아아아아아! 아아아아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 17585,
   "key": "D0821le.txt:237",
   "file": "D0821le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛されたことが、無い。",
   "ko_candidate": "사랑받은 적이 없다｡"
  },
  {
   "id": 17586,
   "key": "D0821le.txt:238",
   "file": "D0821le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛したことさえ、無い。",
   "ko_candidate": "사랑해본 적조차 없다｡"
  },
  {
   "id": 17587,
   "key": "D0821le.txt:242",
   "file": "D0821le.txt",
   "line": 242,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「独りだ！　独りなんだ！ 独りきりなんだ！ うわああああああああああああああああああああああああああ！」",
   "ko_candidate": "「혼자야! 혼자라고! 혼자뿐이라고! 우와아아아아아아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 17588,
   "key": "D0821le.txt:248",
   "file": "D0821le.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなにも、こんなにも恐ろしい世界に、独りきり。",
   "ko_candidate": "이렇게나､ 이렇게나 무서운 세상에 혼자뿐｡"
  },
  {
   "id": 17589,
   "key": "D0821le.txt:249",
   "file": "D0821le.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ独りきりで、死んでゆく。",
   "ko_candidate": "그저 혼자뿐으로 죽어간다｡"
  },
  {
   "id": 17590,
   "key": "D0821le.txt:250",
   "file": "D0821le.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰にも知られることなく、死んでゆく。",
   "ko_candidate": "누구에게도 알려지지 않은 채 죽어간다｡"
  },
  {
   "id": 17591,
   "key": "D0821le.txt:254",
   "file": "D0821le.txt",
   "line": 254,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「誰か！　誰か！　誰か誰か誰か 誰か誰かっ！　誰かぁぁぁぁぁ！」",
   "ko_candidate": "「누가! 누가! 누구누구누구 누구누구! 누구아아아아아!」"
  },
  {
   "id": 17592,
   "key": "D0821le.txt:258",
   "file": "D0821le.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰か名前を呼んでくれ。",
   "ko_candidate": "누군가 이름을 불러줘｡"
  },
  {
   "id": 17593,
   "key": "D0821le.txt:259",
   "file": "D0821le.txt",
   "line": 259,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが確かに在るという証。",
   "ko_candidate": "그것이 확실히 존재한다는 증거｡"
  },
  {
   "id": 17594,
   "key": "D0821le.txt:261",
   "file": "D0821le.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "優しい声で",
   "ko_candidate": "상냥한 목소리로"
  },
  {
   "id": 17595,
   "key": "D0821le.txt:262",
   "file": "D0821le.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暖かい声で",
   "ko_candidate": "따뜻한 목소리로"
  },
  {
   "id": 17596,
   "key": "D0821le.txt:263",
   "file": "D0821le.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰か名前を呼んでくれ。",
   "ko_candidate": "누군가 이름을 불러줘｡"
  },
  {
   "id": 17597,
   "key": "D0821le.txt:275",
   "file": "D0821le.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "誰か抱き締めてくれ。",
   "ko_candidate": "누군가 안아줘｡"
  },
  {
   "id": 17598,
   "key": "D0821le.txt:276",
   "file": "D0821le.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが確かに居るという証。",
   "ko_candidate": "그것이 확실히 있다는 증거｡"
  },
  {
   "id": 17599,
   "key": "D0821le.txt:278",
   "file": "D0821le.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力強い腕の中に",
   "ko_candidate": "강한 팔 안에"
  },
  {
   "id": 17600,
   "key": "D0821le.txt:279",
   "file": "D0821le.txt",
   "line": 279,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暖かい胸の中に",
   "ko_candidate": "따뜻한 가슴 안에"
  },
  {
   "id": 17601,
   "key": "D0821le.txt:280",
   "file": "D0821le.txt",
   "line": 280,
   "speaker": "エンネア",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "誰か抱き締めてくれ。 「痛いよっ！　苦しいよっ！ 寒いよっ！」",
   "ko_candidate": "누군가 안아줘｡"
  },
  {
   "id": 17602,
   "key": "D0821le.txt:288",
   "file": "D0821le.txt",
   "line": 288,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「怖い……怖いんだっ！ 誰か……誰か……ぁぁぁ……」",
   "ko_candidate": "「아파! 괴로워! 추워! 무서워… 무서워! 누가… 누가… 아아…」"
  },
  {
   "id": 17603,
   "key": "D0821le.txt:301",
   "file": "D0821le.txt",
   "line": 301,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――呼んだか」",
   "ko_candidate": "「――부르셨나요」"
  },
  {
   "id": 17604,
   "key": "D0821le.txt:304",
   "file": "D0821le.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "穏やかな声。",
   "ko_candidate": "온화한 목소리｡"
  },
  {
   "id": 17605,
   "key": "D0821le.txt:305",
   "file": "D0821le.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "柔らかな声。",
   "ko_candidate": "부드러운 목소리｡"
  },
  {
   "id": 17606,
   "key": "D0821le.txt:306",
   "file": "D0821le.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それなのに、何の温もりもない聲。",
   "ko_candidate": "그런데도 온기라곤 전혀 없는 목소리｡"
  },
  {
   "id": 17607,
   "key": "D0821le.txt:308",
   "file": "D0821le.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "魂を凍えさせる、刃のように滑り込み、抉り、貫き、引き裂き、熱を奪う、そんな異形の聲。",
   "ko_candidate": "영혼을 얼어붙게 하는､ 칼날처럼 미끄러져 들어와 파고들고 꿰뚫고 찢어내며 열기를 빼앗는､ 그런 기괴한 목소리｡"
  },
  {
   "id": 17608,
   "key": "D0821le.txt:312",
   "file": "D0821le.txt",
   "line": 312,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ――――」",
   "ko_candidate": "「아――――」"
  },
  {
   "id": 17609,
   "key": "D0821le.txt:315",
   "file": "D0821le.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見下ろしている。",
   "ko_candidate": "내려다보고 있다｡"
  },
  {
   "id": 17610,
   "key": "D0821le.txt:317",
   "file": "D0821le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の眸が、覗き込んでいる。",
   "ko_candidate": "황금빛 눈동자가 들여다보고 있다｡"
  },
  {
   "id": 17611,
   "key": "D0821le.txt:318",
   "file": "D0821le.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの光の無い金色が。",
   "ko_candidate": "그 빛 없는 황금빛이｡"
  },
  {
   "id": 17612,
   "key": "D0821le.txt:320",
   "file": "D0821le.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘲りも無く、憧憬も無く、ただ虚無を閉じ込めた、金色の闇。",
   "ko_candidate": "조롱도 없고 동경도 없이 그저 허무를 가두어 놓은 황금빛 어둠｡"
  },
  {
   "id": 17613,
   "key": "D0821le.txt:336",
   "file": "D0821le.txt",
   "line": 336,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――テリオン」",
   "ko_candidate": "「――테리온」"
  },
  {
   "id": 17614,
   "key": "D0821le.txt:339",
   "file": "D0821le.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞬間、総ての感情が止まった。",
   "ko_candidate": "그 순간 모든 감정이 멈췄다｡"
  }
 ]
}