 },
 "items": [
  {
   "id": 36437,
   "key": "D1401ru.txt:270",
   "file": "D1401ru.txt",
   "line": 270,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、悩んでいる場合じゃない。",
   "ko_candidate": "하지만､ 고민하고 있을 때가 아니다｡"
  },
  {
   "id": 36438,
   "key": "D1401ru.txt:272",
   "file": "D1401ru.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖している暇も絶望している暇もない。",
   "ko_candidate": "공포에 빠져있을 시간도 절망하고 있을 시간도 없다｡"
  },
  {
   "id": 36439,
   "key": "D1401ru.txt:274",
   "file": "D1401ru.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんなのん気な、のどかな気持ちでいる余裕なんて微塵も無い。",
   "ko_candidate": "그런 한가한､ 평온한 마음으로 있을 여유 따위는 조금도 없다｡"
  },
  {
   "id": 36440,
   "key": "D1401ru.txt:276",
   "file": "D1401ru.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何でも良いから、何をやったって、奇蹟を起こしたって、止めなきゃならないッ！",
   "ko_candidate": "뭐든 좋으니까､ 뭘 해도 좋으니까､ 기적을 일으켜서라도､ 멈춰야만 해!"
  },
  {
   "id": 36441,
   "key": "D1401ru.txt:284",
   "file": "D1401ru.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触手の一本、竜頭の一つが、デモンベインに牙を剥けた。",
   "ko_candidate": "촉수 하나､ 용두 하나가､ 데몬베인에 이빨을 드러냈다｡"
  },
  {
   "id": 36442,
   "key": "D1401ru.txt:286",
   "file": "D1401ru.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大きく開け放たれた顎が、純然な破壊の劫火を、今まさに開放しようとしている――！",
   "ko_candidate": "크게 벌어진 턱이､ 순수한 파괴의 겁화를､ 지금 막 해방하려 하고 있다――!"
  },
  {
   "id": 36443,
   "key": "D1401ru.txt:289",
   "file": "D1401ru.txt",
   "line": 289,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッ!?」",
   "ko_candidate": "「…………!?」"
  },
  {
   "id": 36444,
   "key": "D1401ru.txt:296",
   "file": "D1401ru.txt",
   "line": 296,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「チィィィィッ！」",
   "ko_candidate": "「치이이이이!」"
  },
  {
   "id": 36445,
   "key": "D1401ru.txt:306",
   "file": "D1401ru.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体を回転させて迫り来る顎を避ける。",
   "ko_candidate": "기체를 회전시켜 다가오는 턱을 피한다｡"
  },
  {
   "id": 36446,
   "key": "D1401ru.txt:309",
   "file": "D1401ru.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "巨大な牙が、僅かに掠める。コクピットが激震した。",
   "ko_candidate": "거대한 이빨이､ 간신히 스친다｡ 콕핏이 격렬하게 흔들렸다｡"
  },
  {
   "id": 36447,
   "key": "D1401ru.txt:311",
   "file": "D1401ru.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "火花を盛大に散らしながらも、デモンベインは弧を描くように飛翔。",
   "ko_candidate": "불꽃을 한껏 뿌리면서도､ 데몬베인은 호를 그리듯"
  },
  {
   "id": 36448,
   "key": "D1401ru.txt:312",
   "file": "D1401ru.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "触手から何とか逃れた。",
   "ko_candidate": "비행｡ 촉수에서 어떻게든 벗어났다｡"
  },
  {
   "id": 36449,
   "key": "D1401ru.txt:314",
   "file": "D1401ru.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、破壊の劫火は……",
   "ko_candidate": "하지만､ 파괴의 겁화는……"
  },
  {
   "id": 36450,
   "key": "D1401ru.txt:323",
   "file": "D1401ru.txt",
   "line": 323,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やめろぉぉぉぉぉ――――！」",
   "ko_candidate": "「그만둬어어어어어――――!」"
  },
  {
   "id": 36451,
   "key": "D1401ru.txt:328",
   "file": "D1401ru.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雷鳴が世界中の静寂を埋め尽くした。",
   "ko_candidate": "천둥소리가 세계 전체의 정적을 가득 채웠다｡"
  },
  {
   "id": 36452,
   "key": "D1401ru.txt:331",
   "file": "D1401ru.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇夜に無数の太陽が生まれた。",
   "ko_candidate": "어둠 속에 무수한 태양이 태어났다｡"
  },
  {
   "id": 36453,
   "key": "D1401ru.txt:332",
   "file": "D1401ru.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "邪神の吐息が、街を薙ぎ払う。",
   "ko_candidate": "사신의 숨결이､ 거리를 쓸어버린다｡"
  },
  {
   "id": 36454,
   "key": "D1401ru.txt:338",
   "file": "D1401ru.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アーカムシティを貫く、天空の劫火。",
   "ko_candidate": "아캄시티를 관통하는､ 천공의 겁화｡"
  },
  {
   "id": 36455,
   "key": "D1401ru.txt:339",
   "file": "D1401ru.txt",
   "line": 339,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜闇が駆逐され、世界が白く塗り潰された。",
   "ko_candidate": "밤의 어둠이 쫓겨나고､ 세계가 하얗게 칠해졌다｡"
  },
  {
   "id": 36456,
   "key": "D1401ru.txt:341",
   "file": "D1401ru.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "上空から見上げるその光景は、まるでアーカムシティに無数の光柱が建ち並んでいるようだった。",
   "ko_candidate": "상공에서 올려다보는 그 광경은､ 마치 아캄시티에 무수한 광주가 늘어서 있는 것 같았다｡"
  },
  {
   "id": 36457,
   "key": "D1401ru.txt:343",
   "file": "D1401ru.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の柱が内側から膨れ上がる。",
   "ko_candidate": "빛의 기둥이 안쪽에서 부풀어 오른다｡"
  },
  {
   "id": 36458,
   "key": "D1401ru.txt:344",
   "file": "D1401ru.txt",
   "line": 344,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆裂して、街を光で塗り潰す。",
   "ko_candidate": "폭발해서､ 거리를 빛으로 칠해버린다｡"
  },
  {
   "id": 36459,
   "key": "D1401ru.txt:346",
   "file": "D1401ru.txt",
   "line": 346,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音と呼ぶのも馬鹿らしかった。",
   "ko_candidate": "폭음이라고 부르기도 바보 같았다｡"
  },
  {
   "id": 36460,
   "key": "D1401ru.txt:347",
   "file": "D1401ru.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは世界を粉砕する、音の洪水、音の蹂躙だった。",
   "ko_candidate": "그것은 세계를 분쇄하는､ 소리의 홍수､ 소리의 유린이었다｡"
  },
  {
   "id": 36461,
   "key": "D1401ru.txt:351",
   "file": "D1401ru.txt",
   "line": 351,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「姫さぁぁぁぁぁぁぁんッッ！」",
   "ko_candidate": "「공주님아아아아아아아아!」"
  },
  {
   "id": 36462,
   "key": "D1401ru.txt:367",
   "file": "D1401ru.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃が基地全体を襲った。",
   "ko_candidate": "충격이 기지 전체를 덮쳤다｡"
  },
  {
   "id": 36463,
   "key": "D1401ru.txt:369",
   "file": "D1401ru.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "天空の劫火は、地表に広がる街を、いとも容易く蒸発させ、大地を抉り、基地までをも貫き、浄火せんとしていた。",
   "ko_candidate": "천공의 겁화는､ 지표에 펼쳐진 거리를､ 아주 쉽게 증발시키고､ 대지를 파내고､ 기지까지도 관통해､ 정화하려 하고 있었다｡"
  },
  {
   "id": 36464,
   "key": "D1401ru.txt:371",
   "file": "D1401ru.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃は無論、メタトロンとサンダルフォンが戦う地下線路も襲う。",
   "ko_candidate": "충격은 물론､ 메타트론과 산달폰이 싸우는 지하 선로도 덮친다｡"
  },
  {
   "id": 36465,
   "key": "D1401ru.txt:373",
   "file": "D1401ru.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通路全体を殴りつけるような激震、二人の戦いによって唯でさえ脆くなっていた壁は、もはや完全に崩壊が始まっていた。",
   "ko_candidate": "통로 전체를 때리는 듯한 격진､ 두 사람의 싸움으로 인해 그렇지 않아도 약해진 벽은､ 이제 완전히 붕괴가 시작되고 있었다｡"
  },
  {
   "id": 36466,
   "key": "D1401ru.txt:374",
   "file": "D1401ru.txt",
   "line": 374,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瓦礫が降り注ぎ、地面が波打つ。",
   "ko_candidate": "잔해가 쏟아지고､ 지면이 물결친다｡"
  },
  {
   "id": 36467,
   "key": "D1401ru.txt:379",
   "file": "D1401ru.txt",
   "line": 379,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「真逆……！　アウグストゥスめ！　己達ごと覇道の基地を吹き飛ばすつもりか！」",
   "ko_candidate": "「진짜……! 아우구스투스 놈! 자기들까지 하도의 기지를 날려버릴 작정인가!」"
  },
  {
   "id": 36468,
   "key": "D1401ru.txt:384",
   "file": "D1401ru.txt",
   "line": 384,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何だと!?」",
   "ko_candidate": "「뭐라고!?」"
  },
  {
   "id": 36469,
   "key": "D1401ru.txt:387",
   "file": "D1401ru.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "命の危険を切実に感じる。",
   "ko_candidate": "생명의 위험을 절실히 느낀다｡"
  },
  {
   "id": 36470,
   "key": "D1401ru.txt:388",
   "file": "D1401ru.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが街全体が襲われている今、逃げ場は何処にも無かった。",
   "ko_candidate": "하지만 거리 전체가 덮쳐지고 있는 지금､ 도망갈 곳은 어디에도 없었다｡"
  },
  {
   "id": 36471,
   "key": "D1401ru.txt:390",
   "file": "D1401ru.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃は、ついに基地を包む結界を破り、内部に迸らんとする。",
   "ko_candidate": "충격은､ 마침내 기지를 감싸는 결계를 깨고､ 내부로 터져 들어가려 한다｡"
  },
  {
   "id": 36472,
   "key": "D1401ru.txt:392",
   "file": "D1401ru.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その獰猛な破滅の牙を、脆弱な基地に突き立てる。",
   "ko_candidate": "그 사나운 파멸의 이빨을､ 취약한 기지에 박으려 한다｡"
  },
  {
   "id": 36473,
   "key": "D1401ru.txt:397",
   "file": "D1401ru.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通路を、閃光が呑み込んだ。",
   "ko_candidate": "통로를､ 섬광이 삼켰다｡"
  },
  {
   "id": 36474,
   "key": "D1401ru.txt:402",
   "file": "D1401ru.txt",
   "line": 402,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 36475,
   "key": "D1401ru.txt:407",
   "file": "D1401ru.txt",
   "line": 407,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「く……ウオオオォォォォォォォォ！」",
   "ko_candidate": "「크……우오오오오오오오오오오오오!」"
  },
  {
   "id": 36476,
   "key": "D1401ru.txt:420",
   "file": "D1401ru.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破滅の劫火が、遂に地下基地まで到達した。",
   "ko_candidate": "파멸의 겁화가､ 마침내 지하 기지까지 도달했다｡"
  }
 ]
}