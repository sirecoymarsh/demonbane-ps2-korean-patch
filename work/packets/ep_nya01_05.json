 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {},
 "items": [
  {
   "id": 50095,
   "key": "ep_nya01.txt:797",
   "file": "ep_nya01.txt",
   "line": 797,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "熱くて冷たい何かが、俺に絡みついた。",
   "ko_candidate": "뜨겁고 차가운 무언가가 나를 휘감았다｡"
  },
  {
   "id": 50096,
   "key": "ep_nya01.txt:798",
   "file": "ep_nya01.txt",
   "line": 798,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "粘つく、揺らめく、のたうつ、這いずり回る、不浄で、清浄な、無明の光と眩い闇。",
   "ko_candidate": "끈적이고､ 흔들리고､ 뒤틀리고､ 기어 다니는､ 부정하고､ 청정한､ 무명의 빛과 눈부신 어둠｡"
  },
  {
   "id": 50097,
   "key": "ep_nya01.txt:799",
   "file": "ep_nya01.txt",
   "line": 799,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の躰を呑み込んでいく。",
   "ko_candidate": "내 몸을 삼켜 들이고 있다｡"
  },
  {
   "id": 50098,
   "key": "ep_nya01.txt:802",
   "file": "ep_nya01.txt",
   "line": 802,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――、…………、――、………＞，．………、――＜￥――！!?＋：；－＝――――!?」",
   "ko_candidate": "「――――､ …………､ ――､ ………＞，．………、――＜￥――！！？＋：；－＝――――！？」"
  },
  {
   "id": 50099,
   "key": "ep_nya01.txt:806",
   "file": "ep_nya01.txt",
   "line": 806,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「さあ、堕ちよう……僕の――花嫁」",
   "ko_candidate": "「자､ 타락하자… 내―― 신부」"
  },
  {
   "id": 50100,
   "key": "ep_nya01.txt:814",
   "file": "ep_nya01.txt",
   "line": 814,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空白が、俺を満たす。",
   "ko_candidate": "공백이 나를 채운다｡"
  },
  {
   "id": 50101,
   "key": "ep_nya01.txt:829",
   "file": "ep_nya01.txt",
   "line": 829,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――音楽が、聴こえる。",
   "ko_candidate": "――음악이 들린다｡"
  },
  {
   "id": 50102,
   "key": "ep_nya01.txt:831",
   "file": "ep_nya01.txt",
   "line": 831,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "吐き気を催す、異形の唄。",
   "ko_candidate": "구역질나는､ 기괴한 노래｡"
  },
  {
   "id": 50103,
   "key": "ep_nya01.txt:832",
   "file": "ep_nya01.txt",
   "line": 832,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "くぐもった、狂おしい太鼓の連打。",
   "ko_candidate": "웅웅거리는､ 미친 듯한 북소리의 연타｡"
  },
  {
   "id": 50104,
   "key": "ep_nya01.txt:833",
   "file": "ep_nya01.txt",
   "line": 833,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "単調な、冒涜的なフルートの音色。",
   "ko_candidate": "단조로운､ 모독적인 플루트 음색｡"
  },
  {
   "id": 50105,
   "key": "ep_nya01.txt:834",
   "file": "ep_nya01.txt",
   "line": 834,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何もかもが糜爛していた。",
   "ko_candidate": "모든 것이 발광하고 있었다｡"
  },
  {
   "id": 50106,
   "key": "ep_nya01.txt:844",
   "file": "ep_nya01.txt",
   "line": 844,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その忌まわしい音楽に合わせて、ソレは踊る。",
   "ko_candidate": "그 광기의 음악에 맞춰､ 그것이 춤춘다｡"
  },
  {
   "id": 50107,
   "key": "ep_nya01.txt:846",
   "file": "ep_nya01.txt",
   "line": 846,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "緩慢に、",
   "ko_candidate": "느릿하게､"
  },
  {
   "id": 50108,
   "key": "ep_nya01.txt:847",
   "file": "ep_nya01.txt",
   "line": 847,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ぎこちなく、",
   "ko_candidate": "어색하게､"
  },
  {
   "id": 50109,
   "key": "ep_nya01.txt:848",
   "file": "ep_nya01.txt",
   "line": 848,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "愚かしく、",
   "ko_candidate": "어리석게､"
  },
  {
   "id": 50110,
   "key": "ep_nya01.txt:849",
   "file": "ep_nya01.txt",
   "line": 849,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "穢らわしく、",
   "ko_candidate": "더럽게､"
  },
  {
   "id": 50111,
   "key": "ep_nya01.txt:854",
   "file": "ep_nya01.txt",
   "line": 854,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "時も、",
   "ko_candidate": "시간도､"
  },
  {
   "id": 50112,
   "key": "ep_nya01.txt:855",
   "file": "ep_nya01.txt",
   "line": 855,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空間も、",
   "ko_candidate": "공간도､"
  },
  {
   "id": 50113,
   "key": "ep_nya01.txt:856",
   "file": "ep_nya01.txt",
   "line": 856,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "想いすら超えた領域で、",
   "ko_candidate": "생각조차 초월한 영역에서､"
  },
  {
   "id": 50114,
   "key": "ep_nya01.txt:857",
   "file": "ep_nya01.txt",
   "line": 857,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界の中心であり、最果てである領域で、",
   "ko_candidate": "세계의 중심이자､ 최후의 영역에서､"
  },
  {
   "id": 50115,
   "key": "ep_nya01.txt:863",
   "file": "ep_nya01.txt",
   "line": 863,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "盲目の不定形、",
   "ko_candidate": "맹목의 부정형､"
  },
  {
   "id": 50116,
   "key": "ep_nya01.txt:865",
   "file": "ep_nya01.txt",
   "line": 865,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "零知の完全、",
   "ko_candidate": "영지의 완전､"
  },
  {
   "id": 50117,
   "key": "ep_nya01.txt:867",
   "file": "ep_nya01.txt",
   "line": 867,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "煮え滾る核、",
   "ko_candidate": "들끓는 핵､"
  },
  {
   "id": 50118,
   "key": "ep_nya01.txt:869",
   "file": "ep_nya01.txt",
   "line": 869,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "其れは――",
   "ko_candidate": "그것은――"
  },
  {
   "id": 50119,
   "key": "ep_nya01.txt:879",
   "file": "ep_nya01.txt",
   "line": 879,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――神？」",
   "ko_candidate": "「――신?」"
  },
  {
   "id": 50120,
   "key": "ep_nya01.txt:889",
   "file": "ep_nya01.txt",
   "line": 889,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺の、タマシイが、砕け、散った",
   "ko_candidate": "내､ 영혼이､ 부서지고､ 흩어졌다"
  },
  {
   "id": 50121,
   "key": "ep_nya01.txt:891",
   "file": "ep_nya01.txt",
   "line": 891,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "崩れる",
   "ko_candidate": "무너진다"
  },
  {
   "id": 50122,
   "key": "ep_nya01.txt:893",
   "file": "ep_nya01.txt",
   "line": 893,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "崩れ落ちる",
   "ko_candidate": "무너져 내린다"
  },
  {
   "id": 50123,
   "key": "ep_nya01.txt:895",
   "file": "ep_nya01.txt",
   "line": 895,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何もかも、忘れてゆく",
   "ko_candidate": "모든 것을､ 잊어간다"
  },
  {
   "id": 50124,
   "key": "ep_nya01.txt:897",
   "file": "ep_nya01.txt",
   "line": 897,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "君を、忘れる",
   "ko_candidate": "너를､ 잊는다"
  },
  {
   "id": 50125,
   "key": "ep_nya01.txt:900",
   "file": "ep_nya01.txt",
   "line": 900,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "君？",
   "ko_candidate": "너?"
  },
  {
