   "line": 904,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "君は、",
   "ko_candidate": "너는､"
  },
  {
   "id": 50129,
   "key": "ep_nya01.txt:906",
   "file": "ep_nya01.txt",
   "line": 906,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "誰、だったろう？",
   "ko_candidate": "누구､ 였더라?"
  },
  {
   "id": 50130,
   "key": "ep_nya01.txt:910",
   "file": "ep_nya01.txt",
   "line": 910,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "女の嗤い声が聴こえる、",
   "ko_candidate": "여자의 웃음소리가 들린다､"
  },
  {
