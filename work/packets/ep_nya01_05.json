   "key": "ep_nya01.txt:902",
   "file": "ep_nya01.txt",
   "line": 902,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "君は、",
   "ko_candidate": "너는､"
  },
  {
   "id": 50127,
   "key": "ep_nya01.txt:903",
   "file": "ep_nya01.txt",
   "line": 903,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "君は、",
   "ko_candidate": "너는､"
  },
  {
