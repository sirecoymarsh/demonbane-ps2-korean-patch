 "items": [
  {
   "id": 26827,
   "key": "D1202al.txt:601",
   "file": "D1202al.txt",
   "line": 601,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「マギウスに変身しねえわ、あのウザってえ古本女の姿もねえとなると……そうか、そうかぁ？」 「やっぱり、アルちゃんは あんときにご臨終ーってワケですか、 ヒィヒャヒャヒャ！」",
   "ko_candidate": "「햐하하하핫! 하지만 이걸로 말이 맞아떨어졌어｡ 마기우스로 변신하지 않고､ 그 짜증 나는 고서 여자의 모습도 없다면…… 그렇구나､ 그렇구나? 역시､ 알 짱은 그때 운명을 달리했다―― 이런 거구나､ 히히햐햐햐!」"
  },
  {
   "id": 26828,
   "key": "D1202al.txt:612",
   "file": "D1202al.txt",
   "line": 612,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！　てめえぇぇぇぇぇ！」",
   "ko_candidate": "「――――! 네노오오오오오오옴!」"
  },
  {
   "id": 26829,
   "key": "D1202al.txt:614",
   "file": "D1202al.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怒りに頭の中が真っ白になった。",
   "ko_candidate": "분노로 머릿속이 새하얘졌다｡"
  },
  {
   "id": 26830,
   "key": "D1202al.txt:616",
   "file": "D1202al.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を苛む痛みを、無視して跳ね起きる。",
   "ko_candidate": "온몸을 괴롭히는 고통을､ 무시하고 벌떡 일어난다｡"
  },
  {
   "id": 26831,
   "key": "D1202al.txt:629",
   "file": "D1202al.txt",
   "line": 629,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "起き上がりざまに、偃月刀を振るった。",
   "ko_candidate": "일어나자마자､ 언월도를 휘둘렀다｡"
  },
  {
   "id": 26832,
   "key": "D1202al.txt:631",
   "file": "D1202al.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの鼻を掠める。",
   "ko_candidate": "클라우디우스의 코를 스친다｡"
  },
  {
   "id": 26833,
   "key": "D1202al.txt:635",
   "file": "D1202al.txt",
   "line": 635,
   "speaker": "クラウディウス / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ッッ！　ウゼぇな！　ボクはそーゆー熱血ノリが大嫌いなんだよ！」 「ぐぶっあああっ！」",
   "ko_candidate": "「……읏! 짜증 나네! 난 그런 열혈 노리가 정말 싫다고!」{SE_PLAY(1,\"クラウディけん玉\",0,85,false);}<br>"
  },
  {
   "id": 26834,
   "key": "D1202al.txt:647",
   "file": "D1202al.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ケンダマから玉が放たれ、俺の腹を撃った。",
   "ko_candidate": "「그붓아아앗!」 켄다마에서 구슬이 발사되어､ 내 배를 쏘았다｡"
  },
  {
   "id": 26835,
   "key": "D1202al.txt:648",
   "file": "D1202al.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃が内臓を掻き混ぜる。",
   "ko_candidate": "충격이 내장을 뒤섞는다｡"
  },
  {
   "id": 26836,
   "key": "D1202al.txt:649",
   "file": "D1202al.txt",
   "line": 649,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吐瀉物を撒き散らして、堪らず膝を突いた。",
   "ko_candidate": "토사물을 뿌리면서､ 어쩔 수 없이 무릎을 꿇었다｡"
  },
  {
   "id": 26837,
   "key": "D1202al.txt:651",
   "file": "D1202al.txt",
   "line": 651,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くっ……力が、入らねえ！",
   "ko_candidate": "큿…… 힘이､ 들어가지 않아!"
  },
  {
   "id": 26838,
   "key": "D1202al.txt:658",
   "file": "D1202al.txt",
   "line": 658,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「てめーもアル・アジフと同じ場所に送ってやるよ！」",
   "ko_candidate": "「너도 알 아지프와 같은 곳으로 보내주지!」"
  },
  {
   "id": 26839,
   "key": "D1202al.txt:661",
   "file": "D1202al.txt",
   "line": 661,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クソ……っ！",
   "ko_candidate": "젠장……!"
  },
  {
   "id": 26840,
   "key": "D1202le.txt:18",
   "file": "D1202le.txt",
   "line": 18,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「侵入者……それも複数」",
   "ko_candidate": "「침입자……그것도 복수」"
  },
  {
   "id": 26841,
   "key": "D1202le.txt:22",
   "file": "D1202le.txt",
   "line": 22,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アンチクロスが複数かも知れないな。ちっ……覇道邸の時と一緒か」",
   "ko_candidate": "「안티 크로스가 여럿일지도 모르겠군｡ 칫……하도 저택 때와 똑같나」"
  },
  {
   "id": 26842,
   "key": "D1202le.txt:26",
   "file": "D1202le.txt",
   "line": 26,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「全くもって不甲斐無いばかりです。お恥ずかしい」",
   "ko_candidate": "「정말이지 한심하기 짝이 없습니다｡ 부끄럽기 그지없군요」"
  },
  {
   "id": 26843,
   "key": "D1202le.txt:30",
   "file": "D1202le.txt",
   "line": 30,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「連中が相手なら仕方がねえ。場所のデータを送ってくれ。 俺たちも迎撃する」",
   "ko_candidate": "「그놈들이 상대라면 어쩔 수 없지｡ 장소 데이터를 보내줘｡ 우리도 요격하겠다」"
  },
  {
   "id": 26844,
   "key": "D1202le.txt:36",
   "file": "D1202le.txt",
   "line": 36,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はっ。我々も出来るだけ進行を食い止めるよう、戦力を結集させます。 では御武運を」",
   "ko_candidate": "「네｡ 저희도 최대한 진행을 저지하도록 전력을 집중하겠습니다｡ 그럼 무운을 빕니다」"
  },
  {
   "id": 26845,
   "key": "D1202le.txt:40",
   "file": "D1202le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通信が切れる。",
   "ko_candidate": "통신이 끊긴다｡"
  },
  {
   "id": 26846,
   "key": "D1202le.txt:41",
   "file": "D1202le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手に執ったバルザイの偃月刀を、強く固く握り締める。",
   "ko_candidate": "손에 쥔 바르자이의 언월도를 강하고 단단하게 움켜쥔다｡"
  },
  {
   "id": 26847,
   "key": "D1202le.txt:42",
   "file": "D1202le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り返って、みんなに告げた。",
   "ko_candidate": "뒤돌아보며 모두에게 말했다｡"
  },
  {
   "id": 26848,
   "key": "D1202le.txt:45",
   "file": "D1202le.txt",
   "line": 45,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「聴いたとおりだ。打って出るよ」",
   "ko_candidate": "「들은 대로다｡ 나가자」"
  },
  {
   "id": 26849,
   "key": "D1202le.txt:50",
   "file": "D1202le.txt",
   "line": 50,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あわよくば鬼械神を招喚する間も与えず、屠りたいところだな」",
   "ko_candidate": "「가능하다면 귀계신을 소환할 틈도 주지 않고 도륙하고 싶은데」"
  },
  {
   "id": 26850,
   "key": "D1202le.txt:54",
   "file": "D1202le.txt",
   "line": 54,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「なかなか、そう上手くはいかないだろうけどな。 ドクター・ウェスト。そっちの方は」",
   "ko_candidate": "「그렇게 순조롭게 되진 않겠지만 말이야｡ 닥터 웨스트｡ 그쪽은 어떻습니까」"
  },
  {
   "id": 26851,
   "key": "D1202le.txt:60",
   "file": "D1202le.txt",
   "line": 60,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もう少しである。もう少しで完璧に仕上げてやるのである」",
   "ko_candidate": "「조금만 더다｡ 조금만 더 있으면 완벽하게 완성시켜 주겠다」"
  },
  {
   "id": 26852,
   "key": "D1202le.txt:65",
   "file": "D1202le.txt",
   "line": 65,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――急いで下さい。とりあえず先に出ますから」",
   "ko_candidate": "「――서둘러 주세요｡ 일단 먼저 나가겠습니다」"
  },
  {
   "id": 26853,
   "key": "D1202le.txt:69",
   "file": "D1202le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ハンティングホラーから降りて、翼を展開する。",
   "ko_candidate": "헌팅 호러에서 내려 날개를 펼친다｡"
  },
  {
   "id": 26854,
   "key": "D1202le.txt:70",
   "file": "D1202le.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐにでも飛び出すつもりだ。",
   "ko_candidate": "당장이라도 뛰쳐나갈 작정이다｡"
  },
  {
   "id": 26855,
   "key": "D1202le.txt:73",
   "file": "D1202le.txt",
   "line": 73,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……さすがに今回はシンドそうだぜ」",
   "ko_candidate": "「……역시 이번엔 힘들 것 같군」"
  },
  {
   "id": 26856,
   "key": "D1202le.txt:79",
   "file": "D1202le.txt",
   "line": 79,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ええ……決して負ける訳にはいきませんが。 それに、きっと――リューガも来る」",
   "ko_candidate": "「네……절대 질 수는 없지만요｡ 게다가 분명――류가도 올 거예요」"
  },
  {
   "id": 26857,
   "key": "D1202le.txt:84",
   "file": "D1202le.txt",
   "line": 84,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 26858,
   "key": "D1202le.txt:86",
   "file": "D1202le.txt",
   "line": 86,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの憎しみに狂った男は、何をしでかすか分からない。",
   "ko_candidate": "저 증오에 미친 남자는 무슨 짓을 저지를지 모른다｡"
  },
  {
   "id": 26859,
   "key": "D1202le.txt:87",
   "file": "D1202le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんと戦わせるのは、酷く不安だ。",
   "ko_candidate": "라이카 씨와 싸우게 하는 건 몹시 불안하다｡"
  },
  {
   "id": 26860,
   "key": "D1202le.txt:89",
   "file": "D1202le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがライカさんは退かない。必ず自分で決着をつけようとして、聞かないだろう。",
   "ko_candidate": "하지만 라이카 씨는 물러서지 않을 것이다｡ 반드시 스스로 결착을 지으려 할 테니 말을 듣지 않을 거다｡"
  },
  {
   "id": 26861,
   "key": "D1202le.txt:92",
   "file": "D1202le.txt",
   "line": 92,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヤバいときは、助けを求めてくれよ。 今の俺にだって、背中を守ることくらい出来るさ」",
   "ko_candidate": "「위험할 땐 도움을 요청해｡ 지금의 나라도 등 정도는 지킬 수 있어」"
  },
  {
   "id": 26862,
   "key": "D1202le.txt:97",
   "file": "D1202le.txt",
   "line": 97,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ええ」",
   "ko_candidate": "「……네」"
  },
  {
   "id": 26863,
   "key": "D1202le.txt:103",
   "file": "D1202le.txt",
   "line": 103,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「頑張れ若者！　我輩には此処で貴様の為に曲を贈るのが精一杯！ 旋律に乗って貴様に届け、我輩の淡く切ない想い！」",
   "ko_candidate": "「힘내라 젊은이! 이 몸은 여기서 자네를 위해 곡을 바치는 게 최선! 선율에 실려 자네에게 전하리라､ 이 몸의 담담하고 애절한 마음을!」"
  },
  {
   "id": 26864,
   "key": "D1202le.txt:109",
   "file": "D1202le.txt",
   "line": 109,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「届けロボー」",
   "ko_candidate": "「전해줘 로봇」"
  },
  {
   "id": 26865,
   "key": "D1202le.txt:116",
   "file": "D1202le.txt",
   "line": 116,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「呪われそうだ」",
   "ko_candidate": "「저주받을 것 같아」"
  },
  {
   "id": 26866,
   "key": "D1202le.txt:128",
   "file": "D1202le.txt",
   "line": 128,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「敵はＡ２６、Ｊ０１、Ｎ１６の３方より侵入！　警備兵は、ＥＳ装備にて迎撃せよ、ですッ！　繰り返す……！」",
   "ko_candidate": "「적은 A26､ J01､ N16의 3방향에서 침입! 경비병은 ES 장비로 요격하라､ 입니다! 반복합니다……!」"
  }
 ]
}