  {
   "id": 29550,
   "key": "D1210ru.txt:126",
   "file": "D1210ru.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マントの表面に浮かび上がる五芒星形。瑠璃を堅固に防禦する。",
   "ko_candidate": "망토의 표면에 떠오르는 오망성형｡ 루리를 견고하게 방어한다｡"
