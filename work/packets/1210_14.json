  },
  {
   "id": 29540,
   "key": "D1210ru.txt:81",
   "file": "D1210ru.txt",
   "line": 81,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もう一回だ！　撃て！」",
