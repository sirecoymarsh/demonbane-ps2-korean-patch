 "items": [
  {
   "id": 48397,
   "key": "D1518.txt:331",
   "file": "D1518.txt",
   "line": 331,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ありがとう」",
   "ko_candidate": "「……고마워」"
  },
  {
   "id": 48398,
   "key": "D1518.txt:334",
   "file": "D1518.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "なんて、何だか知らないがお礼を言ってきたりする。",
   "ko_candidate": "라며､ 무슨 영문인지 모르겠지만 감사 인사를 해왔다｡"
  },
  {
   "id": 48399,
   "key": "D1518.txt:336",
   "file": "D1518.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それが何とも可笑しくて 俺は思わず吹き出してしまった。",
   "ko_candidate": "그게 무척이나 우스워서 나는 무심코 웃음을 터뜨리고 말았다｡"
  },
  {
   "id": 48400,
   "key": "D1518.txt:341",
   "file": "D1518.txt",
   "line": 341,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……何が可笑しい？」",
   "ko_candidate": "「……뭐가 우스워?」"
  },
  {
   "id": 48401,
   "key": "D1518.txt:345",
   "file": "D1518.txt",
   "line": 345,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「いや、別に何も…… さてと、今回はさすがにしんどかったな」",
   "ko_candidate": "「아니､ 별로 아무것도…… 자､ 이번에는 정말 힘들었구나」"
  },
  {
   "id": 48402,
   "key": "D1518.txt:348",
   "file": "D1518.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今更ながらに、身体が疲労を訴えてくる。",
   "ko_candidate": "이제 와서 몸에 피로가 밀려온다｡"
  },
  {
   "id": 48403,
   "key": "D1518.txt:349",
   "file": "D1518.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それに気づくと急激に睡魔が襲ってきた。",
   "ko_candidate": "그걸 깨닫자 갑자기 졸음이 몰려왔다｡"
  },
  {
   "id": 48404,
   "key": "D1518.txt:350",
   "file": "D1518.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "瞼が重い。",
   "ko_candidate": "눈꺼풀이 무겁다｡"
  },
  {
   "id": 48405,
   "key": "D1518.txt:353",
   "file": "D1518.txt",
   "line": 353,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「俺……ちょっとの間だけ眠るわ。 アルも疲れたんなら好きなだけ眠っとけ。 どうせ時間なんて、 これからは腐るほどあるんだからな」",
   "ko_candidate": "「나…… 잠깐만 자볼게｡ 알도 피곤하면 마음껏 자｡ 어차피 시간은 이제부터 얼마든지 있으니까」"
  },
  {
   "id": 48406,
   "key": "D1518.txt:360",
   "file": "D1518.txt",
   "line": 360,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うん……ああ。 汝の寝顔を見届けてからな」",
   "ko_candidate": "「응…… 그래｡ 네 잠든 얼굴을 확인하고 나서」"
  },
  {
   "id": 48407,
   "key": "D1518.txt:365",
   "file": "D1518.txt",
   "line": 365,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……んなもん見て、何が楽しいよ」",
   "ko_candidate": "「……그런 거 보고 뭐가 재밌어」"
  },
  {
   "id": 48408,
   "key": "D1518.txt:369",
   "file": "D1518.txt",
   "line": 369,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふふ…… 安心しきって、無防備晒して 眠りこけておるのだぞ？ 何となく嬉しいではないか」",
   "ko_candidate": "「후후…… 안심하고 무방비하게 잠들어 있구나? 왠지 모르게 기쁘지 않은가」"
  },
  {
   "id": 48409,
   "key": "D1518.txt:376",
   "file": "D1518.txt",
   "line": 376,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふん……アホ面、笑いたいだけだろうに」",
   "ko_candidate": "「흥…… 바보 같은 얼굴､ 그냥 웃고 싶은 거겠지」"
  },
  {
   "id": 48410,
   "key": "D1518.txt:380",
   "file": "D1518.txt",
   "line": 380,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「迂闊なことを寝言で云うなよ？」",
   "ko_candidate": "「경솔한 소리 잠꼬대로 하지 마?」"
  },
  {
   "id": 48411,
   "key": "D1518.txt:384",
   "file": "D1518.txt",
   "line": 384,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ケッ……まあ、良いや……じゃ、おやすみな……」 アルに見守られながら、眠りに堕ちる。",
   "ko_candidate": "「켓…… 뭐､ 됐어…… 자､ 잘 자……」"
  },
  {
   "id": 48412,
   "key": "D1518.txt:387",
   "file": "D1518.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "深い深い翡翠の瞳に見つめられて、",
   "ko_candidate": "알에게 지켜보며 잠에 빠진다｡"
  },
  {
   "id": 48413,
   "key": "D1518.txt:388",
   "file": "D1518.txt",
   "line": 388,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺の心は安らぎに満たされる。 次目覚めたときも、",
   "ko_candidate": "깊고 깊은 비취빛 눈동자에 바라보며､ 내 마음은 평온함으로 가득 찬다｡"
  },
  {
   "id": 48414,
   "key": "D1518.txt:391",
   "file": "D1518.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "側にアルが居る幸せを噛み締めながら、 俺の意識は闇に閉ざされた。",
   "ko_candidate": "다음에 깨어났을 때도､ 옆에 알이 있는 행복을 되새기며､ 내 의식은 어둠에 잠겼다｡"
  },
  {
   "id": 48415,
   "key": "D1518.txt:403",
   "file": "D1518.txt",
   "line": 403,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎の幸せそうな寝顔を眺めながら、 アルは穏やかに微笑む。",
   "ko_candidate": "쿠로의 행복해 보이는 잠든 얼굴을 바라보며､ 알은 평온하게 미소 짓는다｡"
  },
  {
   "id": 48416,
   "key": "D1518.txt:406",
   "file": "D1518.txt",
   "line": 406,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "確かに……この男となら、 如何なる永遠も苦痛足りえないだろう。",
   "ko_candidate": "확실히…… 이 남자라면､ 어떤 영원도 고통스럽지 않을 것이다｡"
  },
  {
   "id": 48417,
   "key": "D1518.txt:408",
   "file": "D1518.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ愛する男が傍に居るだけで、アルは満たされる。",
   "ko_candidate": "단지 사랑하는 남자가 곁에 있는 것만으로도､ 알은 만족한다｡"
  },
  {
   "id": 48418,
   "key": "D1518.txt:410",
   "file": "D1518.txt",
   "line": 410,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "千年の戦いを生きたアルにとって、 こんなにも穏やかな永遠は、むしろ完全な幸福であり、",
   "ko_candidate": "천 년의 싸움을 살아온 알에게､ 이렇게 평온한 영원은 오히려 완전한 행복이며､ 약속된 낙원이다｡"
  },
  {
   "id": 48419,
   "key": "D1518.txt:412",
   "file": "D1518.txt",
   "line": 412,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "約束された楽園だ。 いつまでも、２人こうして抱き合っていられる。",
   "ko_candidate": "언제까지나､ 둘이서 이렇게 껴안고 있을 수 있다｡"
  },
  {
   "id": 48420,
   "key": "D1518.txt:415",
   "file": "D1518.txt",
   "line": 415,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それはどんなに幸せなことだろう。",
   "ko_candidate": "그것이 얼마나 행복한 일일까｡"
  },
  {
   "id": 48421,
   "key": "D1518.txt:416",
   "file": "D1518.txt",
   "line": 416,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それほどまでに、アルは大十字九郎を愛している。",
   "ko_candidate": "그만큼､ 알은 다이쥬지 쿠로를 사랑하고 있다｡"
  },
  {
   "id": 48422,
   "key": "D1518.txt:418",
   "file": "D1518.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だからこそ問う。",
   "ko_candidate": "그렇기에 묻는다｡"
  },
  {
   "id": 48423,
   "key": "D1518.txt:419",
   "file": "D1518.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "本当にこれで良いのかと。",
   "ko_candidate": "정말 이대로 괜찮은 것인지｡"
  },
  {
   "id": 48424,
   "key": "D1518.txt:421",
   "file": "D1518.txt",
   "line": 421,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悠久を生きる自分の幸福に、 太陽の下で精一杯に毎日を生きるこの男を",
   "ko_candidate": "영원을 사는 자신의 행복에､ 태양 아래에서 열심히 매일을 사는"
  },
  {
   "id": 48425,
   "key": "D1518.txt:423",
   "file": "D1518.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "巻き込んで良いのかと。",
   "ko_candidate": "이 남자를 끌어들여도 되는 것인지｡"
  },
  {
   "id": 48426,
   "key": "D1518.txt:425",
   "file": "D1518.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ヒトはやはり、 ヒトの世界で生きるべきではないのかと。",
   "ko_candidate": "인간은 역시､ 인간의 세계에서 살아야 하는 것은 아닌지｡"
  },
  {
   "id": 48427,
   "key": "D1518.txt:428",
   "file": "D1518.txt",
   "line": 428,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルは自らに問う。",
   "ko_candidate": "알은 스스로에게 묻는다｡"
  },
  {
   "id": 48428,
   "key": "D1518.txt:429",
   "file": "D1518.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "本当に良いのか。",
   "ko_candidate": "정말 괜찮은 것인가｡"
  },
  {
   "id": 48429,
   "key": "D1518.txt:430",
   "file": "D1518.txt",
   "line": 430,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "九郎を永遠の庭に閉じ込める…… そんなことを赦して良いものなのか？",
   "ko_candidate": "쿠로를 영원의 정원에 가두는…… 그런 일을 용서해도 괜찮은"
  },
  {
   "id": 48430,
   "key": "D1518.txt:433",
   "file": "D1518.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルは――",
   "ko_candidate": "것인가? 알은――"
  },
  {
   "id": 48431,
   "key": "D1518le.txt:11",
   "file": "D1518le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空へ。",
   "ko_candidate": "하늘로｡"
  },
  {
   "id": 48432,
   "key": "D1518le.txt:12",
   "file": "D1518le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空へ。",
   "ko_candidate": "하늘로｡"
  },
  {
   "id": 48433,
   "key": "D1518le.txt:13",
   "file": "D1518le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "青い空へ。",
   "ko_candidate": "푸른 하늘로｡"
  },
  {
   "id": 48434,
   "key": "D1518le.txt:15",
   "file": "D1518le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "飛行機は、飛んでゆく。",
   "ko_candidate": "비행기가 날아간다｡"
  },
  {
   "id": 48435,
   "key": "D1518le.txt:16",
   "file": "D1518le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "空の青に吸い込まれそうなくらい、遠くまで飛んでゆく。",
   "ko_candidate": "하늘의 푸른빛에 빨려들 것만 같을 정도로､ 멀리까지 날아간다｡"
  },
  {
   "id": 48436,
   "key": "D1518le.txt:17",
   "file": "D1518le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リューガのつくった、飛行機が。",
   "ko_candidate": "류가가 만든 비행기가｡"
  }
 ]
