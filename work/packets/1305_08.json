  {
   "id": 32531,
   "key": "D1305ru.txt:93",
   "file": "D1305ru.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いけない……！",
   "ko_candidate": "안 돼……!"
  },
  {
   "id": 32532,
   "key": "D1305ru.txt:105",
   "file": "D1305ru.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "慌てて飛び退いた私の胸元を、刃がかすめてゆく。",
   "ko_candidate": "당황해서 뒤로 물러난 내 가슴팍을 칼날이 스쳐 지나간다｡ 착지｡"
