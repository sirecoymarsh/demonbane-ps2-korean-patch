  {
   "id": 32555,
   "key": "D1305ru.txt:187",
   "file": "D1305ru.txt",
   "line": 187,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "激痛に苦しむ私を、愉快そうに、怪物は見下ろしている。",
   "ko_candidate": "격통에 시달리는 나를 유쾌한 듯이 괴물은 내려다보고 있다｡"
  },
  {
   "id": 32556,
   "key": "D1305ru.txt:188",
   "file": "D1305ru.txt",
   "line": 188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "心の中で何かの激情が沸騰した。",
   "ko_candidate": "마음속에서 무언가의 격정이 끓어올랐다｡"
  },
  {
   "id": 32557,
   "key": "D1305ru.txt:192",
   "file": "D1305ru.txt",
   "line": 192,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああああああああああああ！」",
   "ko_candidate": "「아아아아아아아아아아아!」"
  },
  {
   "id": 32558,
   "key": "D1305ru.txt:195",
   "file": "D1305ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しゃがみ込んだまま、偃月刀を突き上げる。",
   "ko_candidate": "쪼그리고 앉은 채로 언월도를 찔러 올린다｡"
