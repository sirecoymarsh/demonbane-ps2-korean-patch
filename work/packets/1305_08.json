  {
   "id": 32530,
   "key": "D1305ru.txt:92",
   "file": "D1305ru.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刀が空を切った。",
   "ko_candidate": "칼이 허공을 갈랐다｡"
