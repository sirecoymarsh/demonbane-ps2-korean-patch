  {
   "id": 32550,
   "key": "D1305ru.txt:171",
   "file": "D1305ru.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "歩きながら再び、その容が崩れてゆく。 悶える粘液が、大十字九郎と山羊顔の怪物の間を、彷徨っている。",
