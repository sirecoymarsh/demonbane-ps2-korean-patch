  {
   "id": 32544,
   "key": "D1305ru.txt:145",
   "file": "D1305ru.txt",
   "line": 145,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "弾丸のように吹き飛ばされる。",
