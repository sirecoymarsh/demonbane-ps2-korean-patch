  {
   "id": 32542,
   "key": "D1305ru.txt:140",
   "file": "D1305ru.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "火花が閃光となって拡がる。",
   "ko_candidate": "불꽃이 섬광이 되어 퍼진다｡"
  },
  {
   "id": 32543,
   "key": "D1305ru.txt:142",
   "file": "D1305ru.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "斬撃を偃月刀越しに受け止めた両腕は、骨が砕けそうなくらいの激痛が襲った。",
   "ko_candidate": "참격을 언월도로 받아낸 양팔은 뼈가 부서질 것 같은"
