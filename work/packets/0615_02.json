 "items": [
  {
   "id": 8054,
   "key": "D0615.txt:505",
   "file": "D0615.txt",
   "line": 505,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……んなこと言われてもなぁ」",
   "ko_candidate": "「……그런 말 들어도 말이지」"
  },
  {
   "id": 8055,
   "key": "D0615.txt:510",
   "file": "D0615.txt",
   "line": 510,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ん……」",
   "ko_candidate": "「음……」"
  },
  {
   "id": 8056,
   "key": "D0615.txt:516",
   "file": "D0615.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺とアルの声で目を覚ましたのか、姫さんが身動きした。身体を起こして、こっちを見つめてくる。",
   "ko_candidate": "내 목소리와 알의 목소리에 눈을 뜬 건지､ 공주님이 몸을 움직였다｡ 몸을 일으키더니 이쪽을 바라본다｡"
  },
  {
   "id": 8057,
   "key": "D0615.txt:523",
   "file": "D0615.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初は寝ぼけているのかただ黙っているだけだったが、やがて驚いたように俺の肩を掴んで揺さぶってきた。",
   "ko_candidate": "처음에는 잠에서 덜 깬 듯 그저 말없이 있었지만､ 이내 놀란 듯 내 어깨를 잡고 흔들어댔다｡"
  },
  {
   "id": 8058,
   "key": "D0615.txt:531",
   "file": "D0615.txt",
   "line": 531,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大十字さん！？　気付いたのですか！？　身体は！？　身体は大丈夫ですか！？」",
   "ko_candidate": "「다이쥬지 씨!? 정신이 드셨나요!? 몸은!? 몸은 괜찮으세요!?」"
  },
  {
   "id": 8059,
   "key": "D0615.txt:537",
   "file": "D0615.txt",
   "line": 537,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちょ、ちょい待ったっ！ まだ頭がフラフラしているんだって！」",
   "ko_candidate": "「잠､ 잠깐만! 아직 머리가 핑핑 돌고 있다고!」"
  },
  {
   "id": 8060,
   "key": "D0615.txt:543",
   "file": "D0615.txt",
   "line": 543,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あっ……申し訳ございません」",
   "ko_candidate": "「아… 죄송합니다」"
  },
  {
   "id": 8061,
   "key": "D0615.txt:550",
   "file": "D0615.txt",
   "line": 550,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手を離して気まずそうに、姫さんは目を背けた。",
   "ko_candidate": "손을 떼고 어색한 듯 공주님은 눈을 돌렸다｡"
  },
  {
   "id": 8062,
   "key": "D0615.txt:551",
   "file": "D0615.txt",
   "line": 551,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "会話の切り出し方が分からず、お互い黙ってしまう。",
   "ko_candidate": "대화를 어떻게 시작해야 할지 몰라 서로 침묵해버렸다｡"
  },
  {
   "id": 8063,
   "key": "D0615.txt:554",
   "file": "D0615.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "うーん、どうしたものか……。",
   "ko_candidate": "음､ 어떻게 해야 하나…"
  },
  {
   "id": 8064,
   "key": "D0615.txt:559",
   "file": "D0615.txt",
   "line": 559,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん」",
   "ko_candidate": "「…다이쥬지 씨」"
  },
  {
   "id": 8065,
   "key": "D0615.txt:564",
   "file": "D0615.txt",
   "line": 564,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ？　は、はいっ！？」",
   "ko_candidate": "「엣? 네､ 네!?」"
  },
  {
   "id": 8066,
   "key": "D0615.txt:570",
   "file": "D0615.txt",
   "line": 570,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悩んでいると向こうから話しかけてきた。",
   "ko_candidate": "고민하고 있으니 저쪽에서 말을 걸어왔다｡"
  },
  {
   "id": 8067,
   "key": "D0615.txt:573",
   "file": "D0615.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意を決したかのようにこっちを見つめると、姫さんは深々と頭を下げた。",
   "ko_candidate": "결심한 듯 이쪽을 바라보더니 공주님은 깊숙이 고개를 숙였다｡"
  },
  {
   "id": 8068,
   "key": "D0615.txt:579",
   "file": "D0615.txt",
   "line": 579,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今回は……ありがとうございました。貴方に助けて頂かなければ、今頃、わたくしは……」",
   "ko_candidate": "「이번에는… 감사합니다｡ 당신께서 도와주시지 않았다면 지금쯤 저는…」"
  },
  {
   "id": 8069,
   "key": "D0615.txt:584",
   "file": "D0615.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "身震いを抑えようと、自らの肩を抱く。",
   "ko_candidate": "몸서리를 억누르려는 듯 자신의 어깨를 감싼다｡"
  },
  {
   "id": 8070,
   "key": "D0615.txt:585",
   "file": "D0615.txt",
   "line": 585,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは、その……何といえば良いものか。",
   "ko_candidate": "이건､ 그러니까… 뭐라고 하면 좋을까｡"
  },
  {
   "id": 8071,
   "key": "D0615.txt:591",
   "file": "D0615.txt",
   "line": 591,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ……いや、まあ、うん。あっ、そうだ！ デモンベインは！？　敵のデウス・マキナと戦ってからの記憶がないんだけど……」",
   "ko_candidate": "「아… 아니､ 뭐､ 응｡ 아､ 그래! 데몬베인은!? 적의 데우스 마키나와 싸운 이후의 기억이 없는데…」"
  },
  {
   "id": 8072,
   "key": "D0615.txt:598",
   "file": "D0615.txt",
   "line": 598,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「装甲の一部が腐食したのと、魔術回路に多少の狂いが生じた以外では、大きな被害はありません」",
   "ko_candidate": "「장갑의 일부가 부식된 것과 마술 회로에 약간의 이상이 생긴 것 외에는 큰 피해는 없습니다」"
  },
  {
   "id": 8073,
   "key": "D0615.txt:604",
   "file": "D0615.txt",
   "line": 604,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうか……すまねえ。また壊しちまったようで」",
   "ko_candidate": "「그렇구나… 미안해｡ 또 부숴버린 것 같아」"
  },
  {
   "id": 8074,
   "key": "D0615.txt:608",
   "file": "D0615.txt",
   "line": 608,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いえ、構いません」",
   "ko_candidate": "「아뇨､ 괜찮습니다」"
  },
  {
   "id": 8075,
   "key": "D0615.txt:614",
   "file": "D0615.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今までとは打って変わった返答だった。",
   "ko_candidate": "지금까지와는 180도 다른 대답이었다｡"
  },
  {
   "id": 8076,
   "key": "D0615.txt:615",
   "file": "D0615.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "びっくりして姫さんの顔をまじまじと見つめる。",
   "ko_candidate": "놀라서 공주님의 얼굴을 뚫어지게 바라본다｡"
  },
  {
   "id": 8077,
   "key": "D0615.txt:618",
   "file": "D0615.txt",
   "line": 618,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんは穏やかな笑顔で、こっちを見つめ返した。",
   "ko_candidate": "공주님은 온화한 미소로 이쪽을 마주 바라봤다｡"
  },
  {
   "id": 8078,
   "key": "D0615.txt:624",
   "file": "D0615.txt",
   "line": 624,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「わたくし、あれから色々と考えました。大十字さん……デモンベインはまだしばらく貴方に預けておきたいと」",
   "ko_candidate": "「저､ 그 이후로 여러 가지를 생각해봤어요｡ 다이쥬지 씨… 데몬베인은 아직 당분간 당신께 맡겨두고 싶어요」"
  },
  {
   "id": 8079,
   "key": "D0615.txt:629",
   "file": "D0615.txt",
   "line": 629,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ……？」",
   "ko_candidate": "「엣…?」"
  },
  {
   "id": 8080,
   "key": "D0615.txt:634",
   "file": "D0615.txt",
   "line": 634,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大十字さんの戦いを初めて全部見て思いました。貴方のような人こそお爺様は求めていたのかも知れない」 「小さな、だけど確かにある正義を信じて、魔を断つ剣を振るう者――それが貴方なのかも知れない」",
   "ko_candidate": "「다이쥬지 씨의 싸움을 처음으로 전부 보고 생각했어요｡ 당신 같은 사람을 할아버지께서 찾고 계셨던 게 아닐까요｡ 작지만 확실히 존재하는 정의를 믿고､ 마를 베는 검을 휘두르는 자―― 그게 당신일지도 모릅니다」"
  },
  {
   "id": 8081,
   "key": "D0615.txt:645",
   "file": "D0615.txt",
   "line": 645,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か一転して、買い被られている気がするが……。",
   "ko_candidate": "뭔가､ 갑자기 과대평가받는 느낌이 들지만…"
  },
  {
   "id": 8082,
   "key": "D0615.txt:648",
   "file": "D0615.txt",
   "line": 648,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の戸惑いもよそに、姫さんはもう一度頭を下げた。",
   "ko_candidate": "내가 당황하는 것도 아랑곳하지 않고 공주님은 다시 한 번 고개를 숙였다｡"
  },
  {
   "id": 8083,
   "key": "D0615.txt:654",
   "file": "D0615.txt",
   "line": 654,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大十字さん、これからもデモンベインのことをよろしくお願い致します」",
   "ko_candidate": "「다이쥬지 씨､ 앞으로도 데몬베인을 잘 부탁드립니다」"
  },
  {
   "id": 8084,
   "key": "D0615.txt:660",
   "file": "D0615.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの態度に戸惑ったままの自分だが、こう言われては返事はただ１つだ。俺はゆっくりと強く頷く。",
   "ko_candidate": "공주님의 태도에 당황한 채로 있던 나지만､ 이렇게 말해오니 대답은 단 하나뿐이다｡ 나는 천천히 그리고 강하게 고개를 끄덕인다｡"
  },
  {
   "id": 8085,
   "key": "D0615.txt:665",
   "file": "D0615.txt",
   "line": 665,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……分かったよ、姫さん。不肖、大十字九郎！ 尽力させてもらいますッ！」",
   "ko_candidate": "「…알겠어요､ 공주님｡ 부족하지만､ 다이쥬지 쿠로! 최선을 다하겠습니다!」"
  },
  {
   "id": 8086,
   "key": "D0615.txt:676",
   "file": "D0615.txt",
   "line": 676,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ふん……最初からそういう謙虚な態度でいれば良かったのだ。目先しか見えない、人間の小娘が」",
   "ko_candidate": "「흥… 처음부터 그런 겸손한 태도였으면 좋았을 것을｡ 눈앞밖에 보지 못하는､ 인간 꼬마가」"
  },
  {
   "id": 8087,
   "key": "D0615.txt:681",
   "file": "D0615.txt",
   "line": 681,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……貴女は本ッッッッ気で不愉快な女ですわね!?」",
   "ko_candidate": "「…당신은 정말로 불쾌한 여자군요!?」"
  },
  {
   "id": 8088,
   "key": "D0615.txt:689",
   "file": "D0615.txt",
   "line": 689,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルと姫さんの口喧嘩がまた始まった。",
   "ko_candidate": "알과 공주님의 말다툼이 또 시작됐다｡"
  },
  {
   "id": 8089,
   "key": "D0615.txt:690",
   "file": "D0615.txt",
   "line": 690,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……毎回毎回、同じ展開だな。おい。",
   "ko_candidate": "…매번 매번､ 똑같은 전개네｡ 이봐｡"
  },
  {
   "id": 8090,
   "key": "D0615.txt:696",
   "file": "D0615.txt",
   "line": 696,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あらあらあら……九郎ちゃん、お目覚めですかー」",
   "ko_candidate": "「어머어머어머… 쿠로 씨､ 깨어나셨나요~」"
  },
  {
   "id": 8091,
   "key": "D0615.txt:702",
   "file": "D0615.txt",
   "line": 702,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "病室に、お見舞いの果物かごを提げたライカさんが入ってきた。当然、ガキんちょどもも一緒だ。",
   "ko_candidate": "그런 와중에 병문안용 과일 바구니를 든 라이카 씨가 들어왔다｡ 당연히 꼬맹이들도 함께다｡"
  },
  {
   "id": 8092,
   "key": "D0615.txt:707",
   "file": "D0615.txt",
   "line": 707,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おー！　九郎復活ーっ！」",
   "ko_candidate": "「오! 쿠로 부활!」"
  },
  {
   "id": 8093,
   "key": "D0615.txt:712",
   "file": "D0615.txt",
   "line": 712,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やったー！」",
   "ko_candidate": "「야호!」"
  }
 ]
}