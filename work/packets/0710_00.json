 },
 "items": [
  {
   "id": 9196,
   "key": "D0710al.txt:22",
   "file": "D0710al.txt",
   "line": 22,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……九郎……」",
   "ko_candidate": "「……쿠로……」"
  },
  {
   "id": 9197,
   "key": "D0710al.txt:27",
   "file": "D0710al.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "………………………………。",
   "ko_candidate": "………………………………。"
  },
  {
   "id": 9198,
   "key": "D0710al.txt:32",
   "file": "D0710al.txt",
   "line": 32,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……九郎……九郎！ 目を覚ませ、九郎！」",
   "ko_candidate": "「……쿠로……쿠로! 눈을 떠､ 쿠로!」"
  },
  {
   "id": 9199,
   "key": "D0710al.txt:39",
   "file": "D0710al.txt",
   "line": 39,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………ん……あ……？」",
   "ko_candidate": "「…………음……아……?」"
  },
  {
   "id": 9200,
   "key": "D0710al.txt:56",
   "file": "D0710al.txt",
   "line": 56,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「気づいたか」",
   "ko_candidate": "「정신이 들었나」"
  },
  {
   "id": 9201,
   "key": "D0710al.txt:61",
   "file": "D0710al.txt",
   "line": 61,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああ……えっと……ここは？」",
   "ko_candidate": "「아아……저기……여긴 어디지?」"
  },
  {
   "id": 9202,
   "key": "D0710al.txt:70",
   "file": "D0710al.txt",
   "line": 70,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あの島だ。上手いこと流れ着くことが出来た」",
   "ko_candidate": "「그 섬이다｡ 잘 흘러 들어올 수 있었어」"
  },
  {
   "id": 9203,
   "key": "D0710al.txt:79",
   "file": "D0710al.txt",
   "line": 79,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "身を起こして、周囲を見渡す。",
   "ko_candidate": "몸을 일으켜 주위를 둘러본다｡"
  },
  {
   "id": 9204,
   "key": "D0710al.txt:80",
   "file": "D0710al.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確かに目指していた島のようだ。",
   "ko_candidate": "확실히 목표로 했던 섬인 것 같다｡"
  },
  {
   "id": 9205,
   "key": "D0710al.txt:82",
   "file": "D0710al.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は砂浜に打ち上げられたような形で倒れていたらしい。",
   "ko_candidate": "나는 해변에 떠밀려온 듯한 모습으로 쓰러져 있었던 모양이다｡ 옆에는 알만 있을 뿐｡"
  },
  {
   "id": 9206,
   "key": "D0710al.txt:85",
   "file": "D0710al.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "横にはアルがいるだけ。姫さんと執事さん、それにライカさんの姿は見えない。",
   "ko_candidate": "공주님과 집사님､ 그리고 라이카 씨의 모습은 보이지 않는다｡ 「……모두는?」"
  },
  {
   "id": 9207,
   "key": "D0710al.txt:90",
   "file": "D0710al.txt",
   "line": 90,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……みんなは？」",
   "ko_candidate": "「떨어진 것 같다」 「……읏!」"
  },
  {
   "id": 9208,
   "key": "D0710al.txt:99",
   "file": "D0710al.txt",
   "line": 99,
   "speaker": "アル / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はぐれたようだ」 「……ッッ！」",
   "ko_candidate": "그런 위험한 상황에서……모두 무사할까?"
  },
  {
   "id": 9209,
   "key": "D0710al.txt:111",
   "file": "D0710al.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あんな危険な状況で……みんな無事なのだろうか？",
   "ko_candidate": "어찌할 도리 없이､ 초조함이 마음을 어지럽힌다｡"
  },
  {
   "id": 9210,
   "key": "D0710al.txt:113",
   "file": "D0710al.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "姫さんの方は、間際に執事さんが庇ったのを見たが、ライカさんの方は――",
   "ko_candidate": "공주님 쪽은 마지막에 집사님이 감싸는 걸 봤지만､ 라이카 씨 쪽은――"
  },
  {
   "id": 9211,
   "key": "D0710al.txt:122",
   "file": "D0710al.txt",
   "line": 122,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「一応、命の心配だけは無いと思うが」",
   "ko_candidate": "「일단､ 생명의 걱정만은 없다고 생각하지만」"
  },
  {
   "id": 9212,
   "key": "D0710al.txt:127",
   "file": "D0710al.txt",
   "line": 127,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……？　何で断言できるんだよ？」",
   "ko_candidate": "「……? 어떻게 단언할 수 있는 거야?」"
  },
  {
   "id": 9213,
   "key": "D0710al.txt:136",
   "file": "D0710al.txt",
   "line": 136,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「見ろ」",
   "ko_candidate": "「봐라」"
  },
  {
   "id": 9214,
   "key": "D0710al.txt:151",
   "file": "D0710al.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そう言ってアルが差し出したのはダウジングの道具だった。振り子が重力に逆らって宙を浮かび、ある方角を指している。",
   "ko_candidate": "그렇게 말하며 알이 내민 것은､ 다우징 끈이었다｡ 매달린 추가 중력을 거슬러 공중에 떠서､ 어떤 방향을 가리키고 있다｡"
  },
  {
   "id": 9215,
   "key": "D0710al.txt:157",
   "file": "D0710al.txt",
   "line": 157,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「彼奴等の気配を探ってみた。 このように反応はある」",
   "ko_candidate": "「그들의 기척을 탐지해봤다｡ 이렇게 반응은 있어」"
  },
  {
   "id": 9216,
   "key": "D0710al.txt:163",
   "file": "D0710al.txt",
   "line": 163,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じゃあ！」",
   "ko_candidate": "「그럼!」"
  },
  {
   "id": 9217,
   "key": "D0710al.txt:174",
   "file": "D0710al.txt",
   "line": 174,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あくまで反応だけ……『生きてはいる』と云うだけの保証だぞ。依然、危険な状況には変わりあるまい」",
   "ko_candidate": "「어디까지나 반응일 뿐……『살아는 있다』라고 하는 정도의 보증일 뿐이다｡ 여전히 위험한 상황에는 변함이 없을 거야」"
  },
  {
   "id": 9218,
   "key": "D0710al.txt:180",
   "file": "D0710al.txt",
   "line": 180,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……急ぐぞ、アル！」",
   "ko_candidate": "「……서두르자､ 알!」"
  },
  {
   "id": 9219,
   "key": "D0710al.txt:189",
   "file": "D0710al.txt",
   "line": 189,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そうだな。一気に駈けるぞ」",
   "ko_candidate": "「그래｡ 한 번에 달리자」"
  },
  {
   "id": 9220,
   "key": "D0710al.txt:208",
   "file": "D0710al.txt",
   "line": 208,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "マギウス・スタイルに変身すると、ダウジングが指す方角に向かって駈け出した。",
   "ko_candidate": "다시 마기우스 슈트로 변신하고､ 나는 다우징이 가리키는 방향을 향해 달려나갔다｡"
  },
  {
   "id": 9221,
   "key": "D0710al.txt:222",
   "file": "D0710al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "行く手には鬱蒼と茂る森。",
   "ko_candidate": "앞에는 울창하게 우거진 숲｡"
  },
  {
   "id": 9222,
   "key": "D0710al.txt:225",
   "file": "D0710al.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "木々の間を抜け、枝から枝へと飛び移り、可能な限りのスピードで森の中を稲妻のように疾走する。",
   "ko_candidate": "나무 사이를 빠져나가고､ 가지에서 가지로 뛰어넘으며､ 가능한 한 빠른 속도로 숲 속을 번개처럼 질주한다｡"
  },
  {
   "id": 9223,
   "key": "D0710al.txt:228",
   "file": "D0710al.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ぽつり。",
   "ko_candidate": "똑｡"
  },
  {
   "id": 9224,
   "key": "D0710al.txt:229",
   "file": "D0710al.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "雨の最初の一雫が頬に落ちた。",
   "ko_candidate": "비의 첫 방울이 뺨에 떨어졌다｡"
  },
  {
   "id": 9225,
   "key": "D0710al.txt:232",
   "file": "D0710al.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それを皮切りに次々と雨の雫が、地面を濡らしていく。",
   "ko_candidate": "그것을 시작으로 잇달아 빗방울이 땅을 적시기 시작한다｡"
  },
  {
   "id": 9226,
   "key": "D0710al.txt:252",
   "file": "D0710al.txt",
   "line": 252,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くそ……降り出してきやがった」",
   "ko_candidate": "「젠장……비가 오기 시작했군」"
  },
  {
   "id": 9227,
   "key": "D0710al.txt:258",
   "file": "D0710al.txt",
   "line": 258,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだ勢いは弱いものの、雨足は少しずつ強くなっていく。",
   "ko_candidate": "아직 세기는 약하지만､ 빗줄기는 조금씩 강해지고 있다｡"
  },
  {
   "id": 9228,
   "key": "D0710al.txt:261",
   "file": "D0710al.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まあ……どのみち海に落ちてずぶ濡れなので、いまさら雨に降られようと大したことはないのだが。",
   "ko_candidate": "뭐……어차피 바다에 빠져서 흠뻑 젖었으니､ 이제 와서 비에 맞는다고 해서 큰일은 아니지만｡"
  },
  {
   "id": 9229,
   "key": "D0710al.txt:267",
   "file": "D0710al.txt",
   "line": 267,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「嵐になるぞ」",
   "ko_candidate": "「폭풍이 될 거야」"
  },
  {
   "id": 9230,
   "key": "D0710al.txt:272",
   "file": "D0710al.txt",
   "line": 272,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「分かるのか？」",
   "ko_candidate": "「알 수 있어?」"
  },
  {
   "id": 9231,
   "key": "D0710al.txt:277",
   "file": "D0710al.txt",
   "line": 277,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「闇が嵐を喚んでいるのだ」",
   "ko_candidate": "「어둠이 폭풍을 부르고 있어」"
  },
  {
   "id": 9232,
   "key": "D0710al.txt:282",
   "file": "D0710al.txt",
   "line": 282,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 9233,
   "key": "D0710al.txt:287",
   "file": "D0710al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "嵐になったら、さすがにたまったもんではない。",
   "ko_candidate": "폭풍이 되면､ 아무래도 견디기 힘들 것이다｡"
  },
  {
   "id": 9234,
   "key": "D0710al.txt:288",
   "file": "D0710al.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さらにスピードを上げ、疾る。疾る。疾る。",
   "ko_candidate": "더욱 속도를 올려､ 달린다｡ 달린다｡ 달린다｡"
  },
  {
   "id": 9235,
   "key": "D0710al.txt:300",
   "file": "D0710al.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しかし……不気味なくらいに静かな森だ。",
   "ko_candidate": "하지만……불길할 정도로 조용한 숲이다｡"
  }
 ]
}