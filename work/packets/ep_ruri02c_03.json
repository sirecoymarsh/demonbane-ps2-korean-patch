 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "覇道瑠璃": "하도 루리",
  "覇道": "하도"
 },
 "items": [
  {
   "id": 51212,
   "key": "ep_ruri02c.txt:347",
   "file": "ep_ruri02c.txt",
   "line": 347,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃっ……ごめんあそばせ……」",
   "ko_candidate": "「꺄……죄송합니다……」"
  },
  {
   "id": 51213,
   "key": "ep_ruri02c.txt:350",
   "file": "ep_ruri02c.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "気合と緊張で、前しか見えなくなっていた。",
   "ko_candidate": "기합과 긴장으로､ 앞밖에 보이지 않았어｡"
  },
  {
   "id": 51214,
   "key": "ep_ruri02c.txt:351",
   "file": "ep_ruri02c.txt",
   "line": 351,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "うっかり通行人とぶつかってしまう。",
   "ko_candidate": "부주의하게 행인과 부딪혀 버렸다｡"
  },
  {
   "id": 51215,
   "key": "ep_ruri02c.txt:357",
   "file": "ep_ruri02c.txt",
   "line": 357,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 51216,
   "key": "ep_ruri02c.txt:362",
   "file": "ep_ruri02c.txt",
   "line": 362,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その人はすぐに雑踏に埋もれてしまった。",
   "ko_candidate": "그 사람은 곧 잡답 속에 묻혀버렸다｡"
  },
  {
   "id": 51217,
   "key": "ep_ruri02c.txt:363",
   "file": "ep_ruri02c.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "子供だったのだろうか？　随分と小さい人だったと思う。",
   "ko_candidate": "아이였을까? 꽤 작은 사람이었다고 생각해｡"
  },
  {
   "id": 51218,
   "key": "ep_ruri02c.txt:364",
   "file": "ep_ruri02c.txt",
   "line": 364,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "顔は見えなかったが、流れる銀色の髪が印象的だった。",
   "ko_candidate": "얼굴은 보이지 않았지만､ 흐르는 은색 머리카락이 인상적이었어｡"
  },
  {
   "id": 51219,
   "key": "ep_ruri02c.txt:365",
   "file": "ep_ruri02c.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "少しの間、心を奪われて……すぐ我に返る。",
   "ko_candidate": "잠시 동안､ 마음을 빼앗겼다가……곧 정신을 차린다｡"
  },
  {
   "id": 51220,
   "key": "ep_ruri02c.txt:367",
   "file": "ep_ruri02c.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうだ。私にはやるべきことが、倒すべき敵がいる。",
   "ko_candidate": "그래｡ 나에겐 해야 할 일이､ 물리쳐야 할 적이 있어｡"
  },
  {
   "id": 51221,
   "key": "ep_ruri02c.txt:368",
   "file": "ep_ruri02c.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私は再び、お店に向かって歩き出した。",
   "ko_candidate": "나는 다시､ 가게를 향해 걸어갔다｡"
  },
  {
   "id": 51222,
   "key": "ep_ruri02c.txt:377",
   "file": "ep_ruri02c.txt",
   "line": 377,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "たくさんの人が並んでいて、かなりの時間待たされたが、何とか目的のものを手に入れた。",
   "ko_candidate": "많은 사람들이 줄 서 있어서､ 꽤 오랜 시간 기다려야 했지만､ 어떻게든 목적한 것을 손에 넣었다｡"
  },
  {
   "id": 51223,
   "key": "ep_ruri02c.txt:378",
   "file": "ep_ruri02c.txt",
   "line": 378,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いざ買う段階になっても色々とトラブルがあったりはしたが。",
   "ko_candidate": "막상 사는 단계에서도 여러 가지 문제가 있었지만｡"
  },
  {
   "id": 51224,
   "key": "ep_ruri02c.txt:380",
   "file": "ep_ruri02c.txt",
   "line": 380,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どれを選んで良いか分からなかったし、まさかカードが使えないとは思わなかった。",
   "ko_candidate": "어떤 걸 고르면 좋을지 몰랐고､ 설마 카드를 쓸 수 없을 줄은 몰랐어｡"
  },
  {
   "id": 51225,
   "key": "ep_ruri02c.txt:381",
   "file": "ep_ruri02c.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "でも、そんなトラブルもまた、危険な冒険には付きものなのだ。",
   "ko_candidate": "하지만､ 그런 문제들도 또한､ 위험한 모험에는 따라오는 법이지｡"
  },
  {
   "id": 51226,
   "key": "ep_ruri02c.txt:383",
   "file": "ep_ruri02c.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして今もまた、新しい危険が差し迫っている……。",
   "ko_candidate": "그리고 지금 또다시､ 새로운 위험이 다가오고 있어……"
  },
  {
   "id": 51227,
   "key": "ep_ruri02c.txt:389",
   "file": "ep_ruri02c.txt",
   "line": 389,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……どこから、どうやって食べれば良いのですか、これは？」",
   "ko_candidate": "「……어디서부터､ 어떻게 먹으면 좋을까요､ 이건?」"
  },
  {
   "id": 51228,
   "key": "ep_ruri02c.txt:392",
   "file": "ep_ruri02c.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "結局、一番人気らしいものを店員さんに選んでもらったのだが……これが凄い。何だかヤケクソ気味にアイスが積み上げられている。",
   "ko_candidate": "결국､ 가장 인기 있는 것을 점원에게 골라달라고 했는데…… 이게 대단해｡ 뭔가 막무가내로 아이스크림이 쌓여 있어｡"
  },
  {
   "id": 51229,
   "key": "ep_ruri02c.txt:393",
   "file": "ep_ruri02c.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "絶妙なバランスだった。芸術的ですらあった。",
   "ko_candidate": "절묘한 균형이었다｡ 예술적이기까지 했다｡"
  },
  {
   "id": 51230,
   "key": "ep_ruri02c.txt:395",
   "file": "ep_ruri02c.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――何かあったら崩れる。",
   "ko_candidate": "――뭔가 있으면 무너진다｡"
  },
  {
   "id": 51231,
   "key": "ep_ruri02c.txt:397",
   "file": "ep_ruri02c.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それはもう、物凄いプレッシャーだ。",
   "ko_candidate": "그것은 정말､ 엄청난 압박감이다｡"
  },
  {
   "id": 51232,
   "key": "ep_ruri02c.txt:398",
   "file": "ep_ruri02c.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "進む事も戻る事も出来ず、私は硬直していた。",
   "ko_candidate": "나아갈 수도 돌아갈 수도 없어､ 나는 굳어버렸다｡"
  },
  {
   "id": 51233,
   "key": "ep_ruri02c.txt:400",
   "file": "ep_ruri02c.txt",
   "line": 400,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "………………………………………………………………駄目だ。",
   "ko_candidate": "…………………………………………………안 돼｡"
  },
  {
   "id": 51234,
   "key": "ep_ruri02c.txt:402",
   "file": "ep_ruri02c.txt",
   "line": 402,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "このままでは、いけません。",
   "ko_candidate": "이대로는､ 안 됩니다｡"
  },
  {
   "id": 51235,
   "key": "ep_ruri02c.txt:403",
   "file": "ep_ruri02c.txt",
   "line": 403,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "勇気を出すのです、覇道瑠璃。",
   "ko_candidate": "용기를 내세요､ 하도 루리｡"
  },
  {
   "id": 51236,
   "key": "ep_ruri02c.txt:404",
   "file": "ep_ruri02c.txt",
   "line": 404,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ここで逃げたら……覇道の名折れではありませんか！",
   "ko_candidate": "여기서 도망치면……하도의 이름에 먹칠이 되지 않겠어요!"
  },
  {
   "id": 51237,
   "key": "ep_ruri02c.txt:408",
   "file": "ep_ruri02c.txt",
   "line": 408,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ええい！　ままよっ！」",
   "ko_candidate": "「에잇! 됐어!」"
  },
  {
   "id": 51238,
   "key": "ep_ruri02c.txt:413",
   "file": "ep_ruri02c.txt",
   "line": 413,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "意を決し、全ての勇気をフル動員させて、私はバベルの塔の如きアイスクリームに口を近づけ……",
   "ko_candidate": "결심하고､ 모든 용기를 총동원해서､ 나는 바벨탑 같은 아이스크림에 입을 가까이 대고……"
  },
  {
   "id": 51239,
   "key": "ep_ruri02c.txt:417",
   "file": "ep_ruri02c.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "どん。",
   "ko_candidate": "쿵｡"
  },
  {
   "id": 51240,
   "key": "ep_ruri02c.txt:418",
   "file": "ep_ruri02c.txt",
   "line": 418,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "べちゃっ。",
   "ko_candidate": "철썩｡"
  },
  {
   "id": 51241,
   "key": "ep_ruri02c.txt:423",
   "file": "ep_ruri02c.txt",
   "line": 423,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あぁぁぁ――――――――！」",
   "ko_candidate": "「아아아아――――――――!」"
  },
  {
   "id": 51242,
   "key": "ep_ruri02c.txt:426",
   "file": "ep_ruri02c.txt",
   "line": 426,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "突然の衝撃に、哀れアイスクリームは地面に落ちる。",
   "ko_candidate": "갑작스러운 충격에､ 불쌍한 아이스크림은 바닥에 떨어진다｡"
  },
  {
   "id": 51243,
   "key": "ep_ruri02c.txt:427",
   "file": "ep_ruri02c.txt",
   "line": 427,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "渦巻く悲しみ、絶望、そして怒り。",
   "ko_candidate": "소용돌이치는 슬픔､ 절망､ 그리고 분노｡"
  },
  {
   "id": 51244,
   "key": "ep_ruri02c.txt:428",
   "file": "ep_ruri02c.txt",
   "line": 428,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "緊張に張り詰めていた感情が、一気に爆発する。",
   "ko_candidate": "긴장으로 팽팽했던 감정이､ 한꺼번에 폭발한다｡"
  },
  {
   "id": 51245,
   "key": "ep_ruri02c.txt:434",
   "file": "ep_ruri02c.txt",
   "line": 434,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「貴方……何てことを……ッ！」",
   "ko_candidate": "「당신……뭐 하는 짓이에요……!」"
  },
  {
   "id": 51246,
   "key": "ep_ruri02c.txt:437",
   "file": "ep_ruri02c.txt",
   "line": 437,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ぶつかってきたその男を、私は睨みつけた。",
   "ko_candidate": "부딪혀 온 그 남자를､ 나는 노려보았다｡"
  },
  {
   "id": 51247,
   "key": "ep_ruri02c.txt:438",
   "file": "ep_ruri02c.txt",
   "line": 438,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "多分、今の私は悪鬼の如き形相だと思う。",
   "ko_candidate": "아마､ 지금의 나는 악귀 같은 형상일 거야｡"
  },
  {
   "id": 51248,
   "key": "ep_ruri02c.txt:440",
   "file": "ep_ruri02c.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "身を引き、たじろぐその人の――",
   "ko_candidate": "몸을 뒤로 빼고､ 주춤거리는 그 사람의――"
  },
  {
   "id": 51249,
   "key": "ep_ruri02c.txt:447",
   "file": "ep_ruri02c.txt",
   "line": 447,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あ、いや、その……ごめんなさい」",
   "ko_candidate": "「아､ 저､ 그러니까……죄송합니다」"
  },
  {
   "id": 51250,
   "key": "ep_ruri02c.txt:450",
   "file": "ep_ruri02c.txt",
   "line": 450,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "黒い瞳と目が合った。",
   "ko_candidate": "검은 눈동자와 눈이 마주쳤다｡"
  },
  {
   "id": 51251,
   "key": "ep_ruri02c.txt:454",
   "file": "ep_ruri02c.txt",
   "line": 454,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――――――――」",
   "ko_candidate": "「――――――――」"
  }
 ]
}