 "items": [
  {
   "id": 37366,
   "key": "D1405_6al.txt:162",
   "file": "D1405_6al.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "海底で揺らめく海藻にも似た触手の群れに埋まって、『ルルイエ異本』の少女もまた、躰を揺らして、たゆたっている。",
   "ko_candidate": "소녀의 가는 손가락이 네로의 몸을 더듬는다｡ 얇은 가슴을 누르고､ 유두를 긁어대고､ 배꼽을 파고､ 그대로 곧장 아랫배로｡ 겹쳐진 은밀한 부분으로｡"
  },
  {
   "id": 37367,
   "key": "D1405_6al.txt:163",
   "file": "D1405_6al.txt",
   "line": 163,
   "speaker": "ネロ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ゆらゆら。ゆらゆら。 「あ……ぐ……」",
   "ko_candidate": "「하아아아아……읏읏!」"
  },
  {
   "id": 37368,
   "key": "D1405_6al.txt:171",
   "file": "D1405_6al.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少女の横でネロは苦痛に喘ぐ。",
   "ko_candidate": "비렬을 가르고 안쪽으로 들어가는 손가락｡"
  },
  {
   "id": 37369,
   "key": "D1405_6al.txt:172",
   "file": "D1405_6al.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その呻きに合わせるように『ルルイエ異本』は歌を唄う。",
   "ko_candidate": "질내를 긁어댄다｡ 후벼 판다｡ 애액의 근원을 파내듯이､ 난폭하게｡"
  },
  {
   "id": 37370,
   "key": "D1405_6al.txt:176",
   "file": "D1405_6al.txt",
   "line": 176,
   "speaker": "ルルイエ異本 / ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「星は正しい位置に……巫女を……生贄を……花嫁を……いあ、いあ」 「はぁぁぁぁ……ッッ！」",
   "ko_candidate": "손가락을 꽉꽉 조이는 질벽｡ 얽혀드는 주름｡ 끈적이는 애액｡"
  },
  {
   "id": 37371,
   "key": "D1405_6al.txt:190",
   "file": "D1405_6al.txt",
   "line": 190,
   "speaker": "ルルイエ異本",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「でも、違う」",
   "ko_candidate": "「하지만､ 틀려」"
  },
  {
   "id": 37372,
   "key": "D1405_6al.txt:193",
   "file": "D1405_6al.txt",
   "line": 193,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "歌が止まった。",
   "ko_candidate": "손가락의 움직임이 멈췄다｡"
  },
  {
   "id": 37373,
   "key": "D1405_6al.txt:194",
   "file": "D1405_6al.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この世ならざる夢を見る『ルルイエ異本』の、酷く冷めた瞳がネロを見下ろしていた。",
   "ko_candidate": "치매처럼 쾌락에 취해 있던 『르뤼에 이본』의 몹시도 차가운 눈동자가 네로를 내려다보고 있었다｡"
  },
  {
   "id": 37374,
   "key": "D1405_6al.txt:201",
   "file": "D1405_6al.txt",
   "line": 201,
   "speaker": "ルルイエ異本",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あなたは、ちがう……あなたは、だれ？　だぁれ？」",
   "ko_candidate": "얼굴을 가까이 대고 뺨에 입을 맞춘다｡ 마도서의 정령은 네로에게 묻는다｡"
  },
  {
   "id": 37375,
   "key": "D1405_6al.txt:204",
   "file": "D1405_6al.txt",
   "line": 204,
   "speaker": "ルルイエ異本",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「だれ……だれだれだれ誰誰誰誰誰誰誰誰誰誰誰誰誰誰誰誰だれだれだぁぁれ？」 「だれ……だれの……あなたは――誰のもの？」",
   "ko_candidate": "「당신은､ 틀려……당신은､ 누구? 누구? 누구……누구누구누구누구누구누구누구누구누구누구누구누구누구누구누구누구? 누구……누구의…… 당신은――누구의 것?」"
  },
  {
   "id": 37376,
   "key": "D1405_6al.txt:210",
   "file": "D1405_6al.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "小動物の様に愛らしく小首を傾げる、少女。",
   "ko_candidate": "작은 동물처럼 사랑스럽게 고개를 갸웃거리는 소녀｡"
  },
  {
   "id": 37377,
   "key": "D1405_6al.txt:212",
   "file": "D1405_6al.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネロは答えない。",
   "ko_candidate": "네로는 대답하지 않는다｡"
  },
  {
   "id": 37378,
   "key": "D1405_6al.txt:213",
   "file": "D1405_6al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だが涎にまみれた口が、舌をだらしなく垂らす口が、歪に吊り上がっていた。",
   "ko_candidate": "단지 일방적으로 주어지는 쾌락에 교성을 지를 뿐이다｡ 하지만 침으로 범벅이 된 입이､ 혀를 늘어뜨린 입이 일그러지게 올라가 있었다｡"
  },
  {
   "id": 37379,
   "key": "D1405_6al.txt:215",
   "file": "D1405_6al.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嘲笑の様だった。",
   "ko_candidate": "조소하는 것 같았다｡"
  },
  {
   "id": 37380,
   "key": "D1405le.txt:7",
   "file": "D1405le.txt",
   "line": 7,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "想いの容はそれぞれだ。",
   "ko_candidate": "생각의 형태는 각자 다르다｡"
  },
  {
   "id": 37381,
   "key": "D1405le.txt:8",
   "file": "D1405le.txt",
   "line": 8,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "想いの方向も様々だ。",
   "ko_candidate": "생각의 방향도 다양하다｡"
  },
  {
   "id": 37382,
   "key": "D1405le.txt:9",
   "file": "D1405le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最終戦争を前に、人々の想いは、数多の色彩を放ち、交差し、入り乱れる。",
   "ko_candidate": "최종전쟁을 앞두고､ 사람들의 생각은 수많은 색채를 발하며 교차하고 뒤엉킨다｡"
  },
  {
   "id": 37383,
   "key": "D1405le.txt:20",
   "file": "D1405le.txt",
   "line": 20,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ふぅ」",
   "ko_candidate": "「……후우」"
  },
  {
   "id": 37384,
   "key": "D1405le.txt:24",
   "file": "D1405le.txt",
   "line": 24,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「瑠璃お嬢様……お疲れでしたら休まれた方が」",
   "ko_candidate": "「루리 아가씨… 피곤하시다면 쉬시는 게」"
  },
  {
   "id": 37385,
   "key": "D1405le.txt:30",
   "file": "D1405le.txt",
   "line": 30,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふふ……それはわたくしの台詞ですわよ、ウィンフィールド。 わたくしは、まだ大丈夫です」",
   "ko_candidate": "「후후… 그건 제가 할 말이에요､ 윈필드｡ 저는 아직 괜찮아요」"
  },
