   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 37389,
   "key": "D1405le.txt:51",
   "file": "D1405le.txt",
   "line": 51,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……果たして、勝てるのかしら」",
   "ko_candidate": "「……과연､ 이길 수 있을까」"
  },
  {
   "id": 37390,
   "key": "D1405le.txt:55",
   "file": "D1405le.txt",
   "line": 55,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「勝たなければ――世界は終わります」",
   "ko_candidate": "「이겨야만 합니다―― 세계가 끝납니다」"
  },
  {
   "id": 37391,
   "key": "D1405le.txt:59",
   "file": "D1405le.txt",
   "line": 59,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
