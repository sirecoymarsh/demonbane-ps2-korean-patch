   "ko_candidate": "「네」"
  },
  {
   "id": 37387,
   "key": "D1405le.txt:41",
   "file": "D1405le.txt",
   "line": 41,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
