 },
 "items": [
  {
   "id": 28639,
   "key": "D1208le.txt:302",
   "file": "D1208le.txt",
   "line": 302,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "其処に何かしらの感慨が生まれるよりも速く、ウィンフィールドの意識は、断絶した。",
   "ko_candidate": "거기에 무언가의 감회가 생겨나기보다 빠르게､ 윈필드의 의식은 단절되었다｡"
  },
  {
   "id": 28640,
   "key": "D1208ru.txt:9",
   "file": "D1208ru.txt",
   "line": 9,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やぁぁぁぁぁ！　面っっ！」",
   "ko_candidate": "「야아아아아! 정면이이잇!」"
  },
  {
   "id": 28641,
   "key": "D1208ru.txt:12",
   "file": "D1208ru.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の、意外にも堂に入った一撃が振り下ろされる。",
   "ko_candidate": "루리의 의외로 제법 그럴듯한 일격이 내리꽂힌다｡"
  },
  {
   "id": 28642,
   "key": "D1208ru.txt:13",
   "file": "D1208ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に側面からは、",
   "ko_candidate": "게다가 측면에서는､"
  },
  {
   "id": 28643,
   "key": "D1208ru.txt:17",
   "file": "D1208ru.txt",
   "line": 17,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「でぇぇぇいロボ――っ！」",
   "ko_candidate": "「데에에에에잇 로봇――읏!」"
  },
  {
   "id": 28644,
   "key": "D1208ru.txt:20",
   "file": "D1208ru.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エルザのトンファー。",
   "ko_candidate": "엘자의 통파｡"
  },
  {
   "id": 28645,
   "key": "D1208ru.txt:21",
   "file": "D1208ru.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舌打ちして、クラウディウスは風を、自分の足許で編み上げる。",
   "ko_candidate": "혀를 차며､ 클라우디우스는 바람을､ 자신의 발밑에서 엮어 올린다｡"
  },
  {
   "id": 28646,
   "key": "D1208ru.txt:22",
   "file": "D1208ru.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風が爆裂した。",
   "ko_candidate": "바람이 폭발했다｡"
  },
  {
   "id": 28647,
   "key": "D1208ru.txt:27",
   "file": "D1208ru.txt",
   "line": 27,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ロボっ!?」",
   "ko_candidate": "「로봇!?」"
  },
  {
   "id": 28648,
   "key": "D1208ru.txt:31",
   "file": "D1208ru.txt",
   "line": 31,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃっ!?」",
   "ko_candidate": "「꺄악!?」"
  },
  {
   "id": 28649,
   "key": "D1208ru.txt:34",
   "file": "D1208ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスが天井へと舞い上がり、宙返りして、２人の背後に着地した。",
   "ko_candidate": "클라우디우스가 천장으로 날아올라､ 공중제비를 돌며､ 두 사람의 뒤에 착지했다｡"
  },
  {
   "id": 28650,
   "key": "D1208ru.txt:35",
   "file": "D1208ru.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両手の指、その間、間に挟まれたベーゴマ。",
   "ko_candidate": "양손의 손가락､ 그 사이사이에 끼워진 팽이｡"
  },
  {
   "id": 28651,
   "key": "D1208ru.txt:39",
   "file": "D1208ru.txt",
   "line": 39,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「嘗めんな！」",
   "ko_candidate": "「얕보지 마!」"
  },
  {
   "id": 28652,
   "key": "D1208ru.txt:43",
   "file": "D1208ru.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "投げつける。",
   "ko_candidate": "던진다｡"
  },
  {
   "id": 28653,
   "key": "D1208ru.txt:45",
   "file": "D1208ru.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸の如く、風を纏って翔ぶ。",
   "ko_candidate": "총알처럼､ 바람을 두르고 날아간다｡"
  },
  {
   "id": 28654,
   "key": "D1208ru.txt:47",
   "file": "D1208ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃は反応できない。だがエルザが即座に、迫り来るベーゴマの前に立った。",
   "ko_candidate": "루리는 반응할 수 없다｡ 하지만 엘자가 즉시､ 다가오는 팽이 앞에 섰다｡"
  },
  {
   "id": 28655,
   "key": "D1208ru.txt:54",
   "file": "D1208ru.txt",
   "line": 54,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「天羅地網！」",
   "ko_candidate": "「천라지망!」"
  },
  {
   "id": 28656,
   "key": "D1208ru.txt:57",
   "file": "D1208ru.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左右のトンファーが高速で空間を走る。",
   "ko_candidate": "좌우의 통파가 고속으로 공간을 달린다｡"
  },
  {
   "id": 28657,
   "key": "D1208ru.txt:58",
   "file": "D1208ru.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛来するベーゴマの悉くを弾き落とした。",
   "ko_candidate": "날아오는 팽이를 모조리 튕겨냈다｡"
  },
  {
   "id": 28658,
   "key": "D1208ru.txt:63",
   "file": "D1208ru.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間髪入れず、クラウディウスに向かって飛び込む。",
   "ko_candidate": "잠시의 틈도 없이､ 클라우디우스를 향해 뛰어든다｡"
  },
  {
   "id": 28659,
   "key": "D1208ru.txt:64",
   "file": "D1208ru.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トンファーの掬い上げる一撃が、脇腹を狙って振るわれた。",
   "ko_candidate": "통파로 떠올리는 일격이､ 옆구리를 노리고 휘둘러졌다｡"
  },
  {
   "id": 28660,
   "key": "D1208ru.txt:68",
   "file": "D1208ru.txt",
   "line": 68,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ガンメェェェェェェン！」",
   "ko_candidate": "「가드어어어어어어엇!」"
  },
  {
   "id": 28661,
   "key": "D1208ru.txt:75",
   "file": "D1208ru.txt",
   "line": 75,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐうおあッ！」",
   "ko_candidate": "「그우오앗!」"
  },
  {
   "id": 28662,
   "key": "D1208ru.txt:78",
   "file": "D1208ru.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "命中の瞬間、トンファーの柄にある引鉄を引いた。",
   "ko_candidate": "명중하는 순간､ 통파의 손잡이에 있는 방아쇠를 당겼다｡"
  },
  {
   "id": 28663,
   "key": "D1208ru.txt:85",
   "file": "D1208ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "トンファーより光が溢れて、魔力が爆発する。",
   "ko_candidate": "통파에서 빛이 넘쳐나고､ 마력이 폭발한다｡"
  },
  {
   "id": 28664,
   "key": "D1208ru.txt:87",
   "file": "D1208ru.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力の衝撃はクラウディウスの防禦陣を突破して、クラウディウスの脇腹に炸裂。クラウディウスは崩れ落ちるように膝を突く。",
   "ko_candidate": "마력의 충격은 클라우디우스의 방어진을 뚫고､ 클라우디우스의 옆구리에 작렬했다｡ 클라우디우스는 무너지듯 무릎을 꿇었다｡"
  },
  {
   "id": 28665,
   "key": "D1208ru.txt:93",
   "file": "D1208ru.txt",
   "line": 93,
   "speaker": "エルザ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「もらったロボ！」",
   "ko_candidate": "「잡았다 로봇!」"
  },
  {
   "id": 28666,
   "key": "D1208ru.txt:97",
   "file": "D1208ru.txt",
   "line": 97,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「嘗めんなって言っただろうが！」",
   "ko_candidate": "「얕보지 말라고 했잖아!」"
  },
  {
   "id": 28667,
   "key": "D1208ru.txt:106",
   "file": "D1208ru.txt",
   "line": 106,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "脳天狙って、振り下ろされるトンファー。",
   "ko_candidate": "정수리를 노리고､ 내리꽂히는 통파｡"
  },
  {
   "id": 28668,
   "key": "D1208ru.txt:108",
   "file": "D1208ru.txt",
   "line": 108,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがその一撃は、クラウディウスが懐から取り出したケンダマによって、受け止められた。",
   "ko_candidate": "하지만 그 일격은､ 클라우디우스가 품에서 꺼낸 켄다마로､ 받아냈다｡"
  },
  {
   "id": 28669,
   "key": "D1208ru.txt:110",
   "file": "D1208ru.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同時にケンダマの『玉』が発射される。",
   "ko_candidate": "동시에 켄다마의 『구슬』이 발사된다｡"
  },
  {
   "id": 28670,
   "key": "D1208ru.txt:112",
   "file": "D1208ru.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザの眉間に命中して、爆発した。",
   "ko_candidate": "엘자의 미간에 명중하여､ 폭발했다｡"
  },
  {
   "id": 28671,
   "key": "D1208ru.txt:118",
   "file": "D1208ru.txt",
   "line": 118,
   "speaker": "エルザ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぎにゃああああぁぁぁロボ――っ！」",
   "ko_candidate": "「기냐아아아아아아로봇――읏!」"
  },
  {
   "id": 28672,
   "key": "D1208ru.txt:122",
   "file": "D1208ru.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仰け反って、転倒するエルザ。",
   "ko_candidate": "뒤로 젖혀지며､ 넘어지는 엘자｡"
  },
  {
   "id": 28673,
   "key": "D1208ru.txt:124",
   "file": "D1208ru.txt",
   "line": 124,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ゴツン。",
   "ko_candidate": "쿵｡"
  },
  {
   "id": 28674,
   "key": "D1208ru.txt:125",
   "file": "D1208ru.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭を床にぶつけた鈍い音が響いた。",
   "ko_candidate": "머리를 바닥에 부딪치는 둔탁한 소리가 울렸다｡"
  },
  {
   "id": 28675,
   "key": "D1208ru.txt:127",
   "file": "D1208ru.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ダメージが大きいのか、起き上がれない。",
   "ko_candidate": "데미지가 큰 건지､ 일어나지 못한다｡"
  },
  {
   "id": 28676,
   "key": "D1208ru.txt:131",
   "file": "D1208ru.txt",
   "line": 131,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やぁぁぁ――――ッ！」",
   "ko_candidate": "「야아아아――――앗!」"
  },
  {
   "id": 28677,
   "key": "D1208ru.txt:135",
   "file": "D1208ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "倒れたエルザを飛び越えて、瑠璃はクラウディウスに斬りかかる。",
   "ko_candidate": "쓰러진 엘자를 뛰어넘어､ 루리는 클라우디우스에게 베어 들어간다｡"
  },
  {
   "id": 28678,
   "key": "D1208ru.txt:138",
   "file": "D1208ru.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肩口を狙って振り下ろされるそれを、クラウディウスはケンダマの鎚の部分で弾いた。",
   "ko_candidate": "어깨를 노리고 내리꽂히는 그것을､ 클라우디우스는 켄다마의 망치 부분으로 튕겼다｡"
  }
 ]
}