 },
 "items": [
  {
   "id": 36072,
   "key": "D1401al.txt:552",
   "file": "D1401al.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど……",
   "ko_candidate": "하지만……"
  },
  {
   "id": 36073,
   "key": "D1401al.txt:563",
   "file": "D1401al.txt",
   "line": 563,
   "speaker": "九郎（回想）",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「じゃあさ……全部無駄だったとしてだ。それで何もしないでいられるかな？」 「何もしないで我慢できるのかな？　んー……俺には無理っぽいな」",
   "ko_candidate": "「그럼 말이야……전부 헛수고였다고 치자고｡ 그래서 아무것도 안 하고 있을 수 있을까? 아무것도 안 하고 참을 수 있을까? 음……나로서는 무리일 것 같은데」"
  },
  {
   "id": 36074,
   "key": "D1401al.txt:568",
   "file": "D1401al.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……おそらく君はそれを知っても、なお戦うだろう。なお足掻くだろう。",
   "ko_candidate": "……아마도 너는 그것을 알아도 여전히 싸울 거야｡ 여전히 발버둥 칠 거야｡"
  },
  {
   "id": 36075,
   "key": "D1401al.txt:570",
   "file": "D1401al.txt",
   "line": 570,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今なら分かる。",
   "ko_candidate": "이제는 알겠어｡"
  },
  {
   "id": 36076,
   "key": "D1401al.txt:571",
   "file": "D1401al.txt",
   "line": 571,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "君と触れ合った、今ならはっきりと。",
   "ko_candidate": "너와 접촉한 지금이라면 분명히｡"
  },
  {
   "id": 36077,
   "key": "D1401al.txt:573",
   "file": "D1401al.txt",
   "line": 573,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "運命を知らないとか、絶望を知らないとかは関係ない。",
   "ko_candidate": "운명을 모른다거나 절망을 모른다거나 하는 건 상관없어｡"
  },
  {
   "id": 36078,
   "key": "D1401al.txt:574",
   "file": "D1401al.txt",
   "line": 574,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "君は今為すべきことを選択できる人間なんだ。",
   "ko_candidate": "너는 지금 해야 할 일을 선택할 수 있는 인간이야｡"
  },
  {
   "id": 36079,
   "key": "D1401al.txt:576",
   "file": "D1401al.txt",
   "line": 576,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迷おうと怖れようと、それでも君は必ず選択する。",
   "ko_candidate": "망설이든 두려워하든 그래도 너는 반드시 선택해｡"
  },
  {
   "id": 36080,
   "key": "D1401al.txt:577",
   "file": "D1401al.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それがきっと強いと言うことだ。",
   "ko_candidate": "그게 분명 강하다는 거야｡"
  },
  {
   "id": 36081,
   "key": "D1401al.txt:578",
   "file": "D1401al.txt",
   "line": 578,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "私にはその強さが無かった。",
   "ko_candidate": "나에게는 그 강함이 없었어｡"
  },
  {
   "id": 36082,
   "key": "D1401al.txt:580",
   "file": "D1401al.txt",
   "line": 580,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――だが、今ならまだ、間に合う。",
   "ko_candidate": "――하지만 지금이라면 아직 늦지 않았어｡"
  },
  {
   "id": 36083,
   "key": "D1401al.txt:586",
   "file": "D1401al.txt",
   "line": 586,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "シャイニング・トラペゾヘドロン。",
   "ko_candidate": "샤이닝 트라페조헤드론｡"
  },
  {
   "id": 36084,
   "key": "D1401al.txt:587",
   "file": "D1401al.txt",
   "line": 587,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "忌まわしい禁忌の武装。",
   "ko_candidate": "저주받은 금기의 무장｡"
  },
  {
   "id": 36085,
   "key": "D1401al.txt:588",
   "file": "D1401al.txt",
   "line": 588,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは奴等にとっても諸刃の剣だ。",
   "ko_candidate": "그것은 놈들에게도 양날의 검이야｡"
  },
  {
   "id": 36086,
   "key": "D1401al.txt:590",
   "file": "D1401al.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なればこそ、この運命に僅かな綻びを生むことが出来る。",
   "ko_candidate": "그렇기에 이 운명에 작은 틈을 만들 수 있어｡"
  },
  {
   "id": 36087,
   "key": "D1401al.txt:591",
   "file": "D1401al.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その僅かな綻びに、総てを賭けよう。",
   "ko_candidate": "그 작은 틈에 모든 것을 걸자｡"
  },
  {
   "id": 36088,
   "key": "D1401al.txt:592",
   "file": "D1401al.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必要なのは、恐れを知らない決意。",
   "ko_candidate": "필요한 건 두려움을 모르는 결의｡"
  },
  {
   "id": 36089,
   "key": "D1401al.txt:594",
   "file": "D1401al.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎。君の強さを分けてもらう。",
   "ko_candidate": "다이쥬지 쿠로｡ 너의 강함을 나눠줘｡"
  },
  {
   "id": 36090,
   "key": "D1401al.txt:595",
   "file": "D1401al.txt",
   "line": 595,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから――",
   "ko_candidate": "그러니까――"
  },
  {
   "id": 36091,
   "key": "D1401al.txt:604",
   "file": "D1401al.txt",
   "line": 604,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「早く来て九郎……ネロは此処に居るよ……」",
   "ko_candidate": "「빨리 와 쿠로……네로는 여기 있어……」"
  },
  {
   "id": 36092,
   "key": "D1401al.txt:630",
   "file": "D1401al.txt",
   "line": 630,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………ッッ！」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 36093,
   "key": "D1401al.txt:634",
   "file": "D1401al.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然、凄まじいＧが、俺の全身をあらゆる角度から殴りつけた。",
   "ko_candidate": "갑자기 엄청난 G가 내 온몸을 모든 각도에서 때렸다｡"
  },
  {
   "id": 36094,
   "key": "D1401al.txt:636",
   "file": "D1401al.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か凄まじい神気の嵐が、機体のスレスレを掠めてゆくのが分かった。",
   "ko_candidate": "뭔가 엄청난 신기의 폭풍이 기체의 바로 옆을 스치고 지나가는 게 느껴졌다｡"
  },
  {
   "id": 36095,
   "key": "D1401al.txt:637",
   "file": "D1401al.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あれに捕まっていたら、跡形も無く消滅していただろう。",
   "ko_candidate": "저것에 잡혔다면 흔적도 없이 소멸했을 거다｡"
  },
  {
   "id": 36096,
   "key": "D1401al.txt:642",
   "file": "D1401al.txt",
   "line": 642,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "閃光に灼かれた眼が、ほんの少し回復した。",
   "ko_candidate": "섬광에 타버린 눈이 조금 회복됐다｡"
  },
  {
   "id": 36097,
   "key": "D1401al.txt:643",
   "file": "D1401al.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白い霞む視界、劫火に消し飛ばされる街を見渡す。",
   "ko_candidate": "하얗게 흐릿한 시야､ 겁화에 날아가 버린 거리를 둘러본다｡"
  },
  {
   "id": 36098,
   "key": "D1401al.txt:646",
   "file": "D1401al.txt",
   "line": 646,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え？」",
   "ko_candidate": "「어?」"
  },
  {
   "id": 36099,
   "key": "D1401al.txt:655",
   "file": "D1401al.txt",
   "line": 655,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くぅぅぅぅぅ――っ！」",
   "ko_candidate": "「크으으으으으――!」"
  },
  {
   "id": 36100,
   "key": "D1401al.txt:658",
   "file": "D1401al.txt",
   "line": 658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "街はみるみる小さくなっていく。",
   "ko_candidate": "거리가 눈 깜짝할 사이에 작아져 간다｡"
  },
  {
   "id": 36101,
   "key": "D1401al.txt:659",
   "file": "D1401al.txt",
   "line": 659,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強烈なＧは、未だに俺を、機体を苛んでいる。",
   "ko_candidate": "강렬한 G가 아직도 나를､ 기체를 괴롭히고 있다｡"
  },
  {
   "id": 36102,
   "key": "D1401al.txt:660",
   "file": "D1401al.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "これは、もしかして――",
   "ko_candidate": "이건 혹시――"
  },
  {
   "id": 36103,
   "key": "D1401al.txt:663",
   "file": "D1401al.txt",
   "line": 663,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「翔んでいる!?」",
   "ko_candidate": "「날고 있어!?」"
  },
  {
   "id": 36104,
   "key": "D1401al.txt:667",
   "file": "D1401al.txt",
   "line": 667,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「凍てつく荒野より翔び立つ翼を我に――シャンタク！」",
   "ko_candidate": "「얼어붙은 황야에서 날아오르는 날개를 나에게――샨타크!」"
  },
  {
   "id": 36105,
   "key": "D1401al.txt:674",
   "file": "D1401al.txt",
   "line": 674,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強大な魔力が、デモンベインの内部を駈け巡っていた。",
   "ko_candidate": "강대한 마력이 데몬베인의 내부를 휘몰아치고 있었다｡"
  },
  {
   "id": 36106,
   "key": "D1401al.txt:675",
   "file": "D1401al.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その力流はデモンベインの背面へと集中している。",
   "ko_candidate": "그 힘의 흐름은 데몬베인의 등 쪽으로 집중되고 있다｡"
  },
  {
   "id": 36107,
   "key": "D1401al.txt:678",
   "file": "D1401al.txt",
   "line": 678,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「背中？　……ッッ！　こ、こいつはっ！」",
   "ko_candidate": "「등? ……읏! 이､ 이놈은!」"
  },
  {
   "id": 36108,
   "key": "D1401al.txt:683",
   "file": "D1401al.txt",
   "line": 683,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アイオーン用の飛行ユニット『シャンタク』。完全に力を取り戻した今、ようやく招喚できるようになった」",
   "ko_candidate": "「아이온용 비행 유닛 『샨타크』｡ 완전히 힘을 되찾은 지금､ 드디어 소환할 수 있게 되었다」"
  },
  {
   "id": 36109,
   "key": "D1401al.txt:687",
   "file": "D1401al.txt",
   "line": 687,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……シャンタク」",
   "ko_candidate": "「……샨타크」"
  },
  {
   "id": 36110,
   "key": "D1401al.txt:689",
   "file": "D1401al.txt",
   "line": 689,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは鋼鉄の鱗を、幾重にも重ねたような形状の物質だった。",
   "ko_candidate": "그것은 강철 비늘을 여러 겹 겹친 듯한 형상의 물질이었다｡"
  },
  {
   "id": 36111,
   "key": "D1401al.txt:690",
   "file": "D1401al.txt",
   "line": 690,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの背中から、マントか翼の如く広がっている。",
   "ko_candidate": "데몬베인의 등에서 망토나 날개처럼 펼쳐져 있다｡"
  }
 ]
}