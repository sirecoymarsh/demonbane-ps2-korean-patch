 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 50258,
   "key": "ep_ruri01.txt:425",
   "file": "ep_ruri01.txt",
   "line": 425,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "叫んで、叫んで、叫び尽くして――だけど。",
   "ko_candidate": "외치고､ 외치고､ 다 외치고 나서――하지만｡"
  },
  {
   "id": 50259,
   "key": "ep_ruri01.txt:429",
   "file": "ep_ruri01.txt",
   "line": 429,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………うぅ」",
   "ko_candidate": "「…………으으」"
  },
  {
   "id": 50260,
   "key": "ep_ruri01.txt:432",
   "file": "ep_ruri01.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何だか目頭が熱い。",
   "ko_candidate": "왠지 눈가가 뜨겁다｡"
  },
  {
   "id": 50261,
   "key": "ep_ruri01.txt:437",
   "file": "ep_ruri01.txt",
   "line": 437,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うぐ……うぅ……ぁぁ……」",
   "ko_candidate": "「우그……우우……아아……」"
  },
  {
   "id": 50262,
   "key": "ep_ruri01.txt:440",
   "file": "ep_ruri01.txt",
   "line": 440,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "視界がぼやけて、何も見えない。",
   "ko_candidate": "시야가 흐릿해져서 아무것도 보이지 않는다｡"
  },
  {
   "id": 50263,
   "key": "ep_ruri01.txt:444",
   "file": "ep_ruri01.txt",
   "line": 444,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うあぁ……うわああぁ……あああぁぁ……っ！」",
   "ko_candidate": "「우아아……우와아아아……아아아아 ……읏!」"
  },
  {
   "id": 50264,
   "key": "ep_ruri01.txt:447",
   "file": "ep_ruri01.txt",
   "line": 447,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "熱い雫が頬を伝う。",
   "ko_candidate": "뜨거운 물방울이 뺨을 타고 흐른다｡"
  },
  {
   "id": 50265,
   "key": "ep_ruri01.txt:448",
   "file": "ep_ruri01.txt",
   "line": 448,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一滴伝えば、あとは崩れるように、ぼろぼろぼろぼろ、と。",
   "ko_candidate": "한 방울 흐르자 그 뒤로는 무너지듯이､ 줄줄줄줄､ 하고｡"
  },
  {
   "id": 50266,
   "key": "ep_ruri01.txt:452",
   "file": "ep_ruri01.txt",
   "line": 452,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ああああぁぁぁ！　わあぁぁぁぁぁ！ うわああぁぁぁぁんっ！」",
   "ko_candidate": "「아아아아아아! 와아아아아아아! 우와아아아아아앙!」"
  },
  {
   "id": 50267,
   "key": "ep_ruri01.txt:456",
   "file": "ep_ruri01.txt",
   "line": 456,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "泣き声が、嗄れたはずの咽喉から、迸る。",
   "ko_candidate": "울음소리가 쉬어버렸을 목구멍에서 터져 나온다｡"
  },
  {
   "id": 50268,
   "key": "ep_ruri01.txt:458",
   "file": "ep_ruri01.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "泣いた。",
   "ko_candidate": "울었다｡"
  },
  {
   "id": 50269,
   "key": "ep_ruri01.txt:459",
   "file": "ep_ruri01.txt",
   "line": 459,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "泣いた。",
   "ko_candidate": "울었다｡"
  },
  {
   "id": 50270,
   "key": "ep_ruri01.txt:460",
   "file": "ep_ruri01.txt",
   "line": 460,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "泣き崩れた。",
   "ko_candidate": "울며 무너졌다｡"
  },
  {
   "id": 50271,
   "key": "ep_ruri01.txt:462",
   "file": "ep_ruri01.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まるで子どものように、形振り構わず、泣き続けた。",
   "ko_candidate": "마치 어린아이처럼､ 체면 따위는 신경 쓰지 않고 계속 울었다｡"
  },
  {
   "id": 50272,
   "key": "ep_ruri01.txt:464",
   "file": "ep_ruri01.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――忘れられるはずがなかった。",
   "ko_candidate": "――잊을 리가 없었다｡"
  },
  {
   "id": 50273,
   "key": "ep_ruri01.txt:468",
   "file": "ep_ruri01.txt",
   "line": 468,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「嘘つき！　嘘つき！　嘘つきっ！ ……嘘つきぃぃぃ――――っ！」",
   "ko_candidate": "「거짓말쟁이! 거짓말쟁이! 거짓말쟁이! ……거짓말쟁이이이이――――읏!」"
  },
  {
   "id": 50274,
   "key": "ep_ruri01.txt:472",
   "file": "ep_ruri01.txt",
   "line": 472,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "憎かった。",
   "ko_candidate": "미웠다｡"
  },
  {
   "id": 50275,
   "key": "ep_ruri01.txt:473",
   "file": "ep_ruri01.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "心底、憎かった。",
   "ko_candidate": "진심으로 미웠다｡"
  },
  {
   "id": 50276,
   "key": "ep_ruri01.txt:474",
   "file": "ep_ruri01.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ここまで私の心を壊した、あの人が憎かった。",
   "ko_candidate": "이렇게까지 내 마음을 망가뜨린 그 사람이 미웠다｡"
  },
  {
   "id": 50277,
   "key": "ep_ruri01.txt:476",
   "file": "ep_ruri01.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "憎くて、",
   "ko_candidate": "미워서､"
  },
  {
   "id": 50278,
   "key": "ep_ruri01.txt:477",
   "file": "ep_ruri01.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "憎くて、",
   "ko_candidate": "미워서､"
  },
  {
   "id": 50279,
   "key": "ep_ruri01.txt:478",
   "file": "ep_ruri01.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "憎くて――",
   "ko_candidate": "미워서――"
  },
  {
   "id": 50280,
   "key": "ep_ruri01.txt:478",
   "file": "ep_ruri01.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "愛しかった。",
   "ko_candidate": "사랑스러웠다｡"
  },
  {
   "id": 50281,
   "key": "ep_ruri01.txt:480",
   "file": "ep_ruri01.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どうしようもないほど、愛しかった。",
   "ko_candidate": "어쩔 수 없이 사랑스러웠다｡"
  },
  {
   "id": 50282,
   "key": "ep_ruri01.txt:482",
   "file": "ep_ruri01.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "もう自分を制御できない。",
   "ko_candidate": "이제 자신을 제어할 수 없다｡"
  },
  {
   "id": 50283,
   "key": "ep_ruri01.txt:483",
   "file": "ep_ruri01.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、壊れるのに、身を任せるしかなかった。",
   "ko_candidate": "그래서 무너지는 대로 내버려 둘 수밖에 없었다｡"
  },
  {
   "id": 50284,
   "key": "ep_ruri01.txt:492",
   "file": "ep_ruri01.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無限に湧いて出てくると思った涙も、止まってしまう。",
   "ko_candidate": "무한히 솟아나올 것 같던 눈물도 멈춰버린다｡"
  },
  {
   "id": 50285,
   "key": "ep_ruri01.txt:493",
   "file": "ep_ruri01.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "涙は涸れ、心も空っぽで、私はただ呆……と、床に座り込んで、天井を見つめている。",
   "ko_candidate": "눈물은 마르고､ 마음도 텅 비어､ 나는 그저 멍……하니 바닥에 주저앉아､ 천장을 바라보고 있다｡"
  },
  {
   "id": 50286,
   "key": "ep_ruri01.txt:495",
   "file": "ep_ruri01.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "見つめていながら……実際は何も視界に入ってこない。",
   "ko_candidate": "바라보고 있으면서도……실제로는 아무것도 시야에 들어오지 않는다｡"
  },
  {
   "id": 50287,
   "key": "ep_ruri01.txt:496",
   "file": "ep_ruri01.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ただ疲労だけが、今の自分を満たす全てだった。",
   "ko_candidate": "단지 피로감만이 지금의 나를 채우는 전부였다｡"
  },
  {
   "id": 50288,
   "key": "ep_ruri01.txt:500",
   "file": "ep_ruri01.txt",
   "line": 500,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……もう、堪えられないよぉ……九郎……」",
   "ko_candidate": "「……이제､ 견딜 수 없어…… 쿠로……」"
  },
  {
   "id": 50289,
   "key": "ep_ruri01.txt:503",
   "file": "ep_ruri01.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "決定的な何かが崩れ去ろうとしていた――その時。",
   "ko_candidate": "결정적인 무언가가 무너져 내리려고 하고 있었다――그때｡"
  },
  {
   "id": 50290,
   "key": "ep_ruri01.txt:504",
   "file": "ep_ruri01.txt",
   "line": 504,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何も映さないはずの視界の隅に、光を認めた。",
   "ko_candidate": "아무것도 비치지 않을 시야의 구석에서 빛을 발견했다｡"
  },
  {
   "id": 50291,
   "key": "ep_ruri01.txt:505",
   "file": "ep_ruri01.txt",
   "line": 505,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "思わず光を視線で追う。",
   "ko_candidate": "무의식중에 빛을 시선으로 쫓는다｡"
  },
  {
   "id": 50292,
   "key": "ep_ruri01.txt:510",
   "file": "ep_ruri01.txt",
   "line": 510,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「え……？」",
   "ko_candidate": "「어……?」"
  },
  {
   "id": 50293,
   "key": "ep_ruri01.txt:515",
   "file": "ep_ruri01.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "奇妙な光景だった。",
   "ko_candidate": "기묘한 광경이었다｡"
  },
  {
   "id": 50294,
   "key": "ep_ruri01.txt:516",
   "file": "ep_ruri01.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "微細な光の塵が、螺旋を描くように、舞っていた。",
   "ko_candidate": "미세한 빛의 먼지가 나선을 그리듯이 춤추고 있었다｡"
  },
  {
   "id": 50295,
   "key": "ep_ruri01.txt:517",
   "file": "ep_ruri01.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "渦巻く光の塵は徐々に、数と輝きを増してゆく。",
   "ko_candidate": "소용돌이치는 빛의 먼지는 점점 수와 광채를 더해간다｡"
  },
  {
   "id": 50296,
   "key": "ep_ruri01.txt:519",
   "file": "ep_ruri01.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "光が部屋の明かりを圧倒するほど輝きを増して、私はそれが意味するものを知った。",
   "ko_candidate": "빛이 방의 조명을 압도할 정도로 밝아지자､ 나는 그것이 의미 하는 바를 알았다｡"
  },
  {
   "id": 50297,
   "key": "ep_ruri01.txt:521",
   "file": "ep_ruri01.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光の一つ一つは魔術文字。",
   "ko_candidate": "빛의 하나하나는 마술 문자｡"
  }
 ]
}