 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "姫さん": "공주님",
  "覇道": "하도",
  "瑠璃": "루리"
 },
 "items": [
  {
   "id": 42611,
   "key": "D1504ru.txt:345",
   "file": "D1504ru.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの拳が、俺の胸を殴った。",
   "ko_candidate": "공주님의 주먹이 내 가슴을 때렸다｡"
  },
  {
   "id": 42612,
   "key": "D1504ru.txt:347",
   "file": "D1504ru.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛くはない。",
   "ko_candidate": "아프지는 않다｡"
  },
  {
   "id": 42613,
   "key": "D1504ru.txt:348",
   "file": "D1504ru.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが感情を剥き出しに殴りかかってくる姫さんに驚いて、思わず硬直してしまった。",
   "ko_candidate": "하지만 감정을 드러내며 때려오는 공주님에 놀라､ 무심코 굳어버렸다｡"
  },
  {
   "id": 42614,
   "key": "D1504ru.txt:350",
   "file": "D1504ru.txt",
   "line": 350,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんは俺の胸を殴り続ける。",
   "ko_candidate": "공주님은 내 가슴을 계속 때린다｡"
  },
  {
   "id": 42615,
   "key": "D1504ru.txt:354",
   "file": "D1504ru.txt",
   "line": 354,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どの口が……どの口が言いますかっ！　貴方、何もっ！　何も分かってないじゃないっ！」",
   "ko_candidate": "「무슨 말을… 무슨 말을 하는 거예요! 당신､ 아무것도! 아무것도 모르고 있잖아요!」"
  },
  {
   "id": 42616,
   "key": "D1504ru.txt:358",
   "file": "D1504ru.txt",
   "line": 358,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「姫さんっ!?」",
   "ko_candidate": "「공주님!?」"
  },
  {
   "id": 42617,
   "key": "D1504ru.txt:365",
   "file": "D1504ru.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拭ったはずの涙が、また零れ出した。",
   "ko_candidate": "닦았을 터인 눈물이 다시 흘러나왔다｡"
  },
  {
   "id": 42618,
   "key": "D1504ru.txt:367",
   "file": "D1504ru.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最後の、心の防壁が決壊したらしい。",
   "ko_candidate": "마지막 마음의 방벽이 무너진 모양이다｡"
  },
  {
   "id": 42619,
   "key": "D1504ru.txt:368",
   "file": "D1504ru.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "後はただ心が壊れるままに、暴走するだけだった。",
   "ko_candidate": "이제는 그저 마음이 부서지는 대로､ 폭주할 뿐이었다｡"
  },
  {
   "id": 42620,
   "key": "D1504ru.txt:370",
   "file": "D1504ru.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滂沱と流れる涙。咽喉の奥から迸るような、罵声と慟哭。",
   "ko_candidate": "폭포수처럼 흐르는 눈물｡ 목구멍 깊은 곳에서 터져 나오는 듯한､ 욕설과 통곡｡"
  },
  {
   "id": 42621,
   "key": "D1504ru.txt:370",
   "file": "D1504ru.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "止まらず殴り続ける拳。",
   "ko_candidate": "멈추지 않고 계속 때리는 주먹｡"
  },
  {
   "id": 42622,
   "key": "D1504ru.txt:374",
   "file": "D1504ru.txt",
   "line": 374,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「わたくしを置いて！　わたくしを独りにして、行ってしまう癖にっ！」",
   "ko_candidate": "「저를 두고! 저를 혼자 남겨두고､ 가버리면서!」"
  },
  {
   "id": 42623,
   "key": "D1504ru.txt:378",
   "file": "D1504ru.txt",
   "line": 378,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 42624,
   "key": "D1504ru.txt:381",
   "file": "D1504ru.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その叫びは、俺の心も壊してしまった。",
   "ko_candidate": "그 외침은 내 마음마저 부숴버렸다｡"
  },
  {
   "id": 42625,
   "key": "D1504ru.txt:383",
   "file": "D1504ru.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……結局、バレてしまっていたか。",
   "ko_candidate": "…결국､ 들켜버렸나｡"
  },
  {
   "id": 42626,
   "key": "D1504ru.txt:387",
   "file": "D1504ru.txt",
   "line": 387,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「このぉっ！　この、このぉ！ このぉぉ……っ！」",
   "ko_candidate": "「이 자식! 이､ 이 자식! 이 자식…읏!」"
  },
  {
   "id": 42627,
   "key": "D1504ru.txt:391",
   "file": "D1504ru.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姫さんの拳が、胸を殴り続ける。",
   "ko_candidate": "공주님의 주먹이 계속해서 가슴을 때린다｡"
  },
  {
   "id": 42628,
   "key": "D1504ru.txt:393",
   "file": "D1504ru.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……全然、痛くない。",
   "ko_candidate": "…전혀､ 아프지 않다｡"
  },
  {
   "id": 42629,
   "key": "D1504ru.txt:394",
   "file": "D1504ru.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "指は弱々しく握られていて、拳は震えていて。",
   "ko_candidate": "손가락은 약하게 쥐어져 있고､ 주먹은 떨리고 있어｡"
  },
  {
   "id": 42630,
   "key": "D1504ru.txt:396",
   "file": "D1504ru.txt",
   "line": 396,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ポカポカと、それでも、殴るのを止めない。",
   "ko_candidate": "퍽퍽하고､ 그래도､ 때리는 걸 멈추지 않는다｡"
  },
  {
   "id": 42631,
   "key": "D1504ru.txt:397",
   "file": "D1504ru.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "痛くはないけど……だけど胸の奥が、心が酷く痛んでいた。",
   "ko_candidate": "아프지는 않지만… 하지만 가슴 속이､ 마음이 몹시 아팠다｡"
  },
  {
   "id": 42632,
   "key": "D1504ru.txt:401",
   "file": "D1504ru.txt",
   "line": 401,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……姫さん」",
   "ko_candidate": "「…공주님」"
  },
  {
   "id": 42633,
   "key": "D1504ru.txt:405",
   "file": "D1504ru.txt",
   "line": 405,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「馬鹿……馬鹿ぁぁぁ……っ！」",
   "ko_candidate": "「바보… 바보오오…읏!」"
  },
  {
   "id": 42634,
   "key": "D1504ru.txt:410",
   "file": "D1504ru.txt",
   "line": 410,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「姫さんッ！」",
   "ko_candidate": "「공주님!」"
  },
  {
   "id": 42635,
   "key": "D1504ru.txt:414",
   "file": "D1504ru.txt",
   "line": 414,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……っ」",
   "ko_candidate": "「아…읏」"
  },
  {
   "id": 42636,
   "key": "D1504ru.txt:417",
   "file": "D1504ru.txt",
   "line": 417,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "有無を言わさず、抱き締めた。",
   "ko_candidate": "말릴 새도 없이､ 꼭 안아버렸다｡"
  },
  {
   "id": 42637,
   "key": "D1504ru.txt:419",
   "file": "D1504ru.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕から逃れようとする姫さん。",
   "ko_candidate": "팔에서 벗어나려는 공주님｡"
  },
  {
   "id": 42638,
   "key": "D1504ru.txt:420",
   "file": "D1504ru.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど俺は力を込めて、それを許さない。",
   "ko_candidate": "하지만 나는 힘을 주어､ 그걸 허락하지 않는다｡"
  },
  {
   "id": 42639,
   "key": "D1504ru.txt:422",
   "file": "D1504ru.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがて諦めた姫さんは、俺の胸に顔を埋めて――",
   "ko_candidate": "이윽고 포기한 공주님은 내 가슴에 얼굴을 묻고――"
  },
  {
   "id": 42640,
   "key": "D1504ru.txt:426",
   "file": "D1504ru.txt",
   "line": 426,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ああぁぁぁ……！　うわあああぁぁぁ！　うわああああぁぁぁぁ！」",
   "ko_candidate": "「아아아… 으아아아아! 으아아아아아아!」"
  },
  {
   "id": 42641,
   "key": "D1504ru.txt:429",
   "file": "D1504ru.txt",
   "line": 429,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ついには子どものように、無防備に、泣き叫んだ。",
   "ko_candidate": "마침내 아이처럼､ 무방비하게､ 울부짖었다｡"
  },
  {
   "id": 42642,
   "key": "D1504ru.txt:431",
   "file": "D1504ru.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "彼女を覆い、護り、あるいは縛した、覇道という鎧はもう何処にも無い。",
   "ko_candidate": "그녀를 감싸고､ 지키고､ 혹은 속박했던､ 하도라는 갑옷은 이제 어디에도 없다｡"
  },
  {
   "id": 42643,
   "key": "D1504ru.txt:433",
   "file": "D1504ru.txt",
   "line": 433,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "剥き出しの、生身の心の姫さん――いや、ただの『瑠璃』が泣いているだけだ。",
   "ko_candidate": "벌거벗은､ 날것의 마음의 공주님――아니､ 그저 '루리'가 울고 있을 뿐이다｡"
  },
  {
   "id": 42644,
   "key": "D1504ru.txt:435",
   "file": "D1504ru.txt",
   "line": 435,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は彼女が泣き止むまで、ずっと抱き締めていた。",
   "ko_candidate": "나는 그녀가 울음을 그칠 때까지､ 계속 안고 있었다｡"
  },
  {
   "id": 42645,
   "key": "D1504ru.txt:436",
   "file": "D1504ru.txt",
   "line": 436,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "抱き締めることしか、出来なかった。",
   "ko_candidate": "안고 있는 것 말고는､ 아무것도 할 수 없었다｡"
  }
 ]
}