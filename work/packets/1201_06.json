  "hit": 41,
  "total": 41,
  "rate": 1.0
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "アル": "알",
  "瑠璃": "루리",
  "大十字": "다이쥬지",
  "大十字九郎": "다이쥬지 쿠로"
 },
 "items": [
  {
   "id": 26622,
   "key": "D1201ru.txt:195",
   "file": "D1201ru.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理由は自分でも解からない。",
   "ko_candidate": "이유는 자신도 모르겠다｡"
  },
  {
   "id": 26623,
   "key": "D1201ru.txt:196",
   "file": "D1201ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲痛な九郎の姿が、見るに堪えないのか。",
   "ko_candidate": "비통한 쿠로의 모습이､ 보기에 견딜 수 없는 것인가｡"
  },
  {
   "id": 26624,
   "key": "D1201ru.txt:197",
   "file": "D1201ru.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "良心の呵責が、九郎を避けさせるのか。",
   "ko_candidate": "양심의 가책이､ 쿠로를 피하게 하는 것인가｡"
  },
  {
   "id": 26625,
   "key": "D1201ru.txt:199",
   "file": "D1201ru.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それもある。",
   "ko_candidate": "그것도 있다｡"
  },
  {
   "id": 26626,
   "key": "D1201ru.txt:200",
   "file": "D1201ru.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それもあるが――",
   "ko_candidate": "그것도 있지만――"
  },
  {
   "id": 26627,
   "key": "D1201ru.txt:210",
   "file": "D1201ru.txt",
   "line": 210,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………ッッ」",
   "ko_candidate": "「…………!!」"
  },
  {
   "id": 26628,
   "key": "D1201ru.txt:217",
   "file": "D1201ru.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸に小さな棘が刺さったような、痛み。",
   "ko_candidate": "가슴에 작은 가시가 박힌 듯한､ 통증｡"
  },
  {
   "id": 26629,
   "key": "D1201ru.txt:218",
   "file": "D1201ru.txt",
   "line": 218,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幽かな、だが決して無視できない、心のざわめき。",
   "ko_candidate": "희미한､ 하지만 결코 무시할 수 없는､ 마음의 동요｡"
  },
  {
   "id": 26630,
   "key": "D1201ru.txt:220",
   "file": "D1201ru.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは気付いていない。",
   "ko_candidate": "알은 깨닫지 못하고 있다｡"
  },
  {
   "id": 26631,
   "key": "D1201ru.txt:221",
   "file": "D1201ru.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "千年の悠久を生きた少女は、その感情が何であるかを理解してない。",
   "ko_candidate": "천 년의 유구를 살아온 소녀는､ 그 감정이 무엇인지를 이해하지 못하고 있다｡"
  },
  {
   "id": 26632,
   "key": "D1201ru.txt:223",
   "file": "D1201ru.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、医務室には瑠璃がいる。",
   "ko_candidate": "지금､ 의무실에는 루리가 있다｡"
  },
  {
   "id": 26633,
   "key": "D1201ru.txt:224",
   "file": "D1201ru.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃がずっと、九郎の様態を見守り続けている。",
   "ko_candidate": "루리가 계속､ 쿠로의 상태를 지켜보고 있다｡"
  },
  {
   "id": 26634,
   "key": "D1201ru.txt:227",
   "file": "D1201ru.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――アルは、瑠璃の九郎を見つめる瞳、その奥に秘められた感情が怖かった。",
   "ko_candidate": "――알은､ 루리의 쿠로를 바라보는 눈동자､ 그 안에 숨겨진 감정이 두려웠다｡"
  },
  {
   "id": 26635,
   "key": "D1201ru.txt:238",
   "file": "D1201ru.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "集中治療室。",
   "ko_candidate": "집중치료실｡"
  },
  {
   "id": 26636,
   "key": "D1201ru.txt:239",
   "file": "D1201ru.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "病的に白い、清潔な空間。",
   "ko_candidate": "병적으로 하얀､ 청결한 공간｡"
  },
  {
   "id": 26637,
   "key": "D1201ru.txt:241",
   "file": "D1201ru.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "点滴の袋。",
   "ko_candidate": "링거 주사액 봉지｡"
  },
  {
   "id": 26638,
   "key": "D1201ru.txt:242",
   "file": "D1201ru.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "小康状態ではあるものの、相変わらず危険な状態を示すステータス。",
   "ko_candidate": "소강상태이기는 하지만､ 여전히 위험한 상태를 나타내는 상태 표시기｡"
  },
  {
   "id": 26639,
   "key": "D1201ru.txt:248",
   "file": "D1201ru.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "静かに眠り続ける九郎の貌。",
   "ko_candidate": "조용히 잠들어 있는 쿠로의 얼굴｡"
  },
  {
   "id": 26640,
   "key": "D1201ru.txt:249",
   "file": "D1201ru.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怖いくらいに、青白い貌。",
   "ko_candidate": "무서울 정도로､ 창백한 얼굴｡"
  },
  {
   "id": 26641,
   "key": "D1201ru.txt:250",
   "file": "D1201ru.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを窓越しに見つめる、自分。",
   "ko_candidate": "그것을 창밖에서 바라보는､ 자신｡"
  },
  {
   "id": 26642,
   "key": "D1201ru.txt:251",
   "file": "D1201ru.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ見つめているしか術を持たない、自分。",
   "ko_candidate": "그저 바라보고 있을 뿐 방법이 없는､ 자신｡"
  },
  {
   "id": 26643,
   "key": "D1201ru.txt:253",
   "file": "D1201ru.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もどかしさが、罪の重さを喚起させる。",
   "ko_candidate": "안타까움이､ 죄의 무게를 일깨운다｡"
  },
  {
   "id": 26644,
   "key": "D1201ru.txt:261",
   "file": "D1201ru.txt",
   "line": 261,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん」",
   "ko_candidate": "「……다이쥬지 씨」"
  },
  {
   "id": 26645,
   "key": "D1201ru.txt:264",
   "file": "D1201ru.txt",
   "line": 264,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦わなければ。",
   "ko_candidate": "싸워야 한다｡"
  },
  {
   "id": 26646,
   "key": "D1201ru.txt:265",
   "file": "D1201ru.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦わなければ。",
   "ko_candidate": "싸워야 한다｡"
  },
  {
   "id": 26647,
   "key": "D1201ru.txt:267",
   "file": "D1201ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自分が戦わなければならない。",
   "ko_candidate": "자신이 싸워야만 한다｡"
  },
  {
   "id": 26648,
   "key": "D1201ru.txt:268",
   "file": "D1201ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分が償わなくちゃいけない。",
   "ko_candidate": "자신이 속죄해야만 한다｡"
  },
  {
   "id": 26649,
   "key": "D1201ru.txt:269",
   "file": "D1201ru.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼の戦いを無に帰してはいけない。",
   "ko_candidate": "그의 싸움을 헛되이 해서는 안 된다｡"
  },
  {
   "id": 26650,
   "key": "D1201ru.txt:271",
   "file": "D1201ru.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何としても。",
   "ko_candidate": "어떻게든｡"
  },
  {
   "id": 26651,
   "key": "D1201ru.txt:272",
   "file": "D1201ru.txt",
   "line": 272,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何としても、だ。",
   "ko_candidate": "어떻게든､ 그래｡"
  },
  {
   "id": 26652,
   "key": "D1201ru.txt:274",
   "file": "D1201ru.txt",
   "line": 274,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "悲壮な覚悟が、瑠璃を締めつける。",
   "ko_candidate": "비장한 각오가､ 루리를 옥죄어 온다｡"
  },
  {
   "id": 26653,
   "key": "D1201ru.txt:275",
   "file": "D1201ru.txt",
   "line": 275,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女もまた、はっきりとは気付いていない。",
   "ko_candidate": "그녀 또한､ 분명히는 깨닫지 못하고 있다｡"
  },
  {
   "id": 26654,
   "key": "D1201ru.txt:276",
   "file": "D1201ru.txt",
   "line": 276,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分を此処まで追い立てる焦燥の正体を。",
   "ko_candidate": "자신을 여기까지 몰아세우는 초조함의 정체를｡"
  },
  {
   "id": 26655,
   "key": "D1201ru.txt:278",
   "file": "D1201ru.txt",
   "line": 278,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "罪悪感、だけではない。",
   "ko_candidate": "죄책감､ 뿐만이 아니다｡"
  },
  {
   "id": 26656,
   "key": "D1201ru.txt:280",
   "file": "D1201ru.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんなにも、こんなにも大きくなってしまった大十字九郎の存在。",
   "ko_candidate": "이렇게도､ 이렇게도 커져 버린 다이쥬지 쿠로의 존재｡"
  },
  {
   "id": 26657,
   "key": "D1201ru.txt:281",
   "file": "D1201ru.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは、それが意味する事は――",
   "ko_candidate": "그것은､ 그것이 의미하는 것은――"
  },
  {
   "id": 26658,
   "key": "D1201ru.txt:285",
   "file": "D1201ru.txt",
   "line": 285,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の視線に見守られて、大十字九郎は眠り続ける。",
   "ko_candidate": "루리의 시선에 지켜보며､ 다이쥬지 쿠로는 잠들어 있다｡"
  },
  {
   "id": 26659,
   "key": "D1201ru.txt:286",
   "file": "D1201ru.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眠る意識は、迫り来る死への恐怖に怯えているのか。",
   "ko_candidate": "잠든 의식은､ 다가오는 죽음에 대한 공포에 떨고 있는 것일까｡"
  },
  {
   "id": 26660,
   "key": "D1201ru.txt:287",
   "file": "D1201ru.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それとも。",
   "ko_candidate": "아니면｡"
  },
  {
   "id": 26661,
   "key": "D1201ru.txt:295",
   "file": "D1201ru.txt",
   "line": 295,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突然、赤く明滅する照明。",
   "ko_candidate": "갑자기､ 붉게 명멸하는 조명｡"
  }
 ]
}