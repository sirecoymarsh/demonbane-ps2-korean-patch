 },
 "items": [
  {
   "id": 33704,
   "key": "D1308al.txt:461",
   "file": "D1308al.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は剣を構えた。",
   "ko_candidate": "나는 검을 겨누었다｡"
  },
  {
   "id": 33705,
   "key": "D1308al.txt:462",
   "file": "D1308al.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、",
   "ko_candidate": "그리고､"
  },
  {
   "id": 33706,
   "key": "D1308al.txt:474",
   "file": "D1308al.txt",
   "line": 474,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ハッ！」",
   "ko_candidate": "「핫!」"
  },
  {
   "id": 33707,
   "key": "D1308al.txt:486",
   "file": "D1308al.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何も無いはずの空間に斬りかかる。",
   "ko_candidate": "아무것도 없어야 할 공간을 베어 간다｡"
  },
  {
   "id": 33708,
   "key": "D1308al.txt:487",
   "file": "D1308al.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何かがその場所から飛び退いた。",
   "ko_candidate": "무언가가 그 자리에서 뛰어 물러났다｡"
  },
  {
   "id": 33709,
   "key": "D1308al.txt:488",
   "file": "D1308al.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その何かに向けて、妾は問いかける。",
   "ko_candidate": "그 무언가를 향해､ 나는 물었다｡"
  },
  {
   "id": 33710,
   "key": "D1308al.txt:494",
   "file": "D1308al.txt",
   "line": 494,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「妾の精神領域に踏み込んでくるとは……汝、何者だ？」",
   "ko_candidate": "「내 정신 영역에 들어오다니……너는 누구냐?」"
  },
  {
   "id": 33711,
   "key": "D1308al.txt:501",
   "file": "D1308al.txt",
   "line": 501,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さすがに気付かれちゃったか。 いやいや失敗、失敗」",
   "ko_candidate": "「역시 눈치챘구나｡ 아이고 실패､ 실패」"
  },
  {
   "id": 33712,
   "key": "D1308al.txt:506",
   "file": "D1308al.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "軽い口調で笑うのは、背の高い女だった。",
   "ko_candidate": "가벼운 말투로 웃는 것은､ 키 큰 여자였다｡"
  },
  {
   "id": 33713,
   "key": "D1308al.txt:507",
   "file": "D1308al.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もっとも、この領域で外見などに意味は無い。",
   "ko_candidate": "다만､ 이 영역에서 외모 따위에 의미는 없다｡"
  },
  {
   "id": 33714,
   "key": "D1308al.txt:509",
   "file": "D1308al.txt",
   "line": 509,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんなものよりも、この気配……怖気がする。 吐き気がする。",
   "ko_candidate": "그런 것보다도､ 이 기척……소름 끼친다｡ 구역질이 난다｡"
  },
  {
   "id": 33715,
   "key": "D1308al.txt:511",
   "file": "D1308al.txt",
   "line": 511,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強烈な闇の気配。闇の腐臭。",
   "ko_candidate": "강렬한 어둠의 기척｡ 어둠의 악취｡"
  },
  {
   "id": 33716,
   "key": "D1308al.txt:513",
   "file": "D1308al.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――ヒトではない。",
   "ko_candidate": "――인간이 아니다｡"
  },
  {
   "id": 33717,
   "key": "D1308al.txt:514",
   "file": "D1308al.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この女、まったく底が知れない。",
   "ko_candidate": "이 여자､ 전혀 속을 알 수 없다｡"
  },
  {
   "id": 33718,
   "key": "D1308al.txt:515",
   "file": "D1308al.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全神経を研ぎ澄ませる。僅かばかりでも気を緩めたら、魂を持っていかれるやも知れない。",
   "ko_candidate": "모든 신경을 곤두세운다｡ 조금이라도 방심하면､ 영혼을 빼앗길지도 모른다｡"
  },
  {
   "id": 33719,
   "key": "D1308al.txt:517",
   "file": "D1308al.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……こんなところで、やられてなるものか。",
   "ko_candidate": "……이런 곳에서､ 당할 순 없어｡"
  },
  {
   "id": 33720,
   "key": "D1308al.txt:523",
   "file": "D1308al.txt",
   "line": 523,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あーあー、そんなに緊張しないで。僕はただ迎えに来ただけだ」",
   "ko_candidate": "「아-아-､ 그렇게 긴장하지 마｡ 난 그저 마중 나왔을 뿐이야」"
  },
  {
   "id": 33721,
   "key": "D1308al.txt:528",
   "file": "D1308al.txt",
   "line": 528,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「迎えに来ただと？」",
   "ko_candidate": "「마중 나왔다고?」"
  },
  {
   "id": 33722,
   "key": "D1308al.txt:532",
   "file": "D1308al.txt",
   "line": 532,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そう。君は君の戦場に、九郎君の隣に戻るつもりなんだろう？」",
   "ko_candidate": "「그래｡ 너는 네 전장으로､ 쿠로 군의 곁으로 돌아갈 생각이지?」"
  },
  {
   "id": 33723,
   "key": "D1308al.txt:537",
   "file": "D1308al.txt",
   "line": 537,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どこまで知って……!?」 言いかけて、言葉を失った。",
   "ko_candidate": "「어디까지 알고……!?」"
  },
  {
   "id": 33724,
   "key": "D1308al.txt:545",
   "file": "D1308al.txt",
   "line": 545,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "女の周りを無数の紙切れが舞っている。 その紙片に妾は無論のこと、覚えがあった。",
   "ko_candidate": "말하려다 말을 잃었다｡"
  },
  {
   "id": 33725,
   "key": "D1308al.txt:548",
   "file": "D1308al.txt",
   "line": 548,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「覚えがある」と表現するのも馬鹿馬鹿しい。 あれは妾の分身だ。",
   "ko_candidate": "여자의 주위를 무수한 종잇조각이 날고 있다｡"
  },
  {
   "id": 33726,
   "key": "D1308al.txt:550",
   "file": "D1308al.txt",
   "line": 550,
   "speaker": "ナイア",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "つまりは―― 「あのとき、君から抜け落ちた最後の断章」",
   "ko_candidate": "그 종잇조각에 나는 물론､ 기억이 있었다｡"
  },
  {
   "id": 33727,
   "key": "D1308al.txt:559",
   "file": "D1308al.txt",
   "line": 559,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「外なる神々に関する記述。これで君は完全に復元されるはずだ」",
   "ko_candidate": "'기억이 있다'고 표현하는 것도 어리석다｡ 저것은 나의 분신이다｡ 즉――"
  },
  {
   "id": 33728,
   "key": "D1308al.txt:564",
   "file": "D1308al.txt",
   "line": 564,
   "speaker": "アル / ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「何故だ!?　何故、汝がそれを手にしておる!?」 「詮索は無意味だろう？　大切なことは、完全となった君に、それを操る九郎君に、そして君達が駆るデモンベインに、もはや敵は居ないということだ」",
   "ko_candidate": "「그때､ 네게서 빠져나간 마지막 단장｡ 「어째서냐!? 어째서 네놈이 그것을 손에 넣었느냐!?」 「자세한 추궁은 무의미하지 않을까? 중요한 건､ 완전해진 너와､ 그것을 다루는 쿠로 군과､ 그리고 너희들이 조종하는 데몬베인에게 이제 적수가 없다는 거야」 「……무엇을 꾸미고 있나?」 「그러니까 자세한 추궁은 무의미하다니까? 단지 이해관계가 일치한다고만 대답해두지｡"
  },
  {
   "id": 33729,
   "key": "D1308al.txt:573",
   "file": "D1308al.txt",
   "line": 573,
   "speaker": "アル / ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……何を企んでいる？」 「だから詮索は無意味だよ？　ただ利害が一致しているとだけ答えておこう」",
   "ko_candidate": "지금은 그걸로 충분할 거야｡ 자､ 그의 곁으로 돌아가렴｡"
  },
  {
   "id": 33730,
   "key": "D1308al.txt:582",
   "file": "D1308al.txt",
   "line": 582,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「今はそれで充分なはずだ。さあ、彼の元に帰っておやり」 「君が居なくなって随分と寂しい想いをしているんだから。ふふ、少し妬けるかな？」",
   "ko_candidate": "네가 없어져서 꽤나 외로워하고 있으니까｡ 후후､ 조금 질투나려나?」"
  },
  {
   "id": 33731,
   "key": "D1308al.txt:596",
   "file": "D1308al.txt",
   "line": 596,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ページが飛んでくる。妾の躰に融合し、１つになるのを感じた。",
   "ko_candidate": "페이지가 날아온다｡ 내 몸에 융합되어 하나가 되는 것을 느꼈다｡"
  },
  {
   "id": 33732,
   "key": "D1308al.txt:598",
   "file": "D1308al.txt",
   "line": 598,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力が満ち溢れるのが分かる。最強の魔導書に相応しい、あらゆる外道の知識を駆る存在を、更なる外道の知識を以て滅ぼし尽くすに充分足る力。",
   "ko_candidate": "힘이 가득 차오르는 게 느껴진다｡ 최강의 마도서에 걸맞은､ 온갖 외도의 지식을 다루는 존재를､ 더욱 강력한 외도의 지식으로 완전히 멸망시키기에 충분한 힘｡"
  },
  {
   "id": 33733,
   "key": "D1308al.txt:600",
   "file": "D1308al.txt",
   "line": 600,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾本来の力。",
   "ko_candidate": "내 본래의 힘｡"
  },
  {
   "id": 33734,
   "key": "D1308al.txt:601",
   "file": "D1308al.txt",
   "line": 601,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かに今、重要なことはその事実だ……。",
   "ko_candidate": "확실히 지금､ 중요한 건 그 사실이다……"
  },
  {
   "id": 33735,
   "key": "D1308al.txt:606",
   "file": "D1308al.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界が薄れていく。",
   "ko_candidate": "시야가 흐려진다｡"
  },
  {
   "id": 33736,
   "key": "D1308al.txt:607",
   "file": "D1308al.txt",
   "line": 607,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逆に意識は覚醒していく。",
   "ko_candidate": "반대로 의식은 각성해간다｡"
  },
  {
   "id": 33737,
   "key": "D1308al.txt:608",
   "file": "D1308al.txt",
   "line": 608,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夢から醒めるのだ。",
   "ko_candidate": "꿈에서 깨어나는 것이다｡"
  },
  {
   "id": 33738,
   "key": "D1308al.txt:610",
   "file": "D1308al.txt",
   "line": 610,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夢の終演。",
   "ko_candidate": "꿈의 종연｡"
  },
  {
   "id": 33739,
   "key": "D1308al.txt:611",
   "file": "D1308al.txt",
   "line": 611,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覚醒の光の中。",
   "ko_candidate": "각성의 빛 속에서｡"
  },
  {
   "id": 33740,
   "key": "D1308al.txt:613",
   "file": "D1308al.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最後に、妾は女を見た。",
   "ko_candidate": "마지막으로､ 나는 여자를 보았다｡"
  },
  {
   "id": 33741,
   "key": "D1308al.txt:614",
   "file": "D1308al.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否、それは女などではなかった。",
   "ko_candidate": "아니､ 그것은 여자 따위가 아니었다｡"
  },
  {
   "id": 33742,
   "key": "D1308al.txt:615",
   "file": "D1308al.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その姿は、闇を纏う、その異形の姿は――",
   "ko_candidate": "그 모습은､ 어둠을 두른､ 그 기괴한 모습은――"
  },
  {
   "id": 33743,
   "key": "D1308al.txt:619",
   "file": "D1308al.txt",
   "line": 619,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それではご機嫌麗しゅう、 『死霊秘法』。 また運命の瞬間にお逢いしよう」",
   "ko_candidate": "「그럼 안녕히､ 『네크로노미콘』｡ 다시 운명의 순간에 만나지」"
  }
 ]
}