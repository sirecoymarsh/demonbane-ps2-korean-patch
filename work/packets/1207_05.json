 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ジョージ": "조지",
  "サンダルフォン": "산달폰",
  "アリスン": "앨리슨"
 },
 "items": [
  {
   "id": 28187,
   "key": "D1207le.txt:290",
   "file": "D1207le.txt",
   "line": 290,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩れ落ち、紅い大輪を瓦礫の下に閉じ込める。",
   "ko_candidate": "무너져 내려､ 붉은 대륜을 잔해 아래에 가둔다｡"
  },
  {
   "id": 28188,
   "key": "D1207le.txt:291",
   "file": "D1207le.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幸運にも逃げ遅れ、破壊の波紋から逃れられた人々の悲鳴が轟いた。",
   "ko_candidate": "운 좋게 도망치지 못하고､ 파괴의 파문에서 벗어난 사람들의 비명이 울려 퍼졌다｡"
  },
  {
   "id": 28189,
   "key": "D1207le.txt:293",
   "file": "D1207le.txt",
   "line": 293,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一瞬の出来事だった。",
   "ko_candidate": "순간의 일이었다｡"
  },
  {
   "id": 28190,
   "key": "D1207le.txt:294",
   "file": "D1207le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがその一瞬は、一瞬の開花と散華は、子ども達の瞳にしっかりと灼きついて離れない。",
   "ko_candidate": "하지만 그 순간은､ 순간의 개화와 산화는､ 아이들의 눈동자에 확실히 새겨져 떨어지지 않는다｡"
  },
  {
   "id": 28191,
   "key": "D1207le.txt:302",
   "file": "D1207le.txt",
   "line": 302,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「醜い華だ。何の感動も、無い」",
   "ko_candidate": "「추한 꽃이군｡ 어떤 감동도､ 없어」"
  },
  {
   "id": 28192,
   "key": "D1207le.txt:305",
   "file": "D1207le.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機械仕掛けの眸が、子ども達を見つめる。",
   "ko_candidate": "기계 장치의 눈동자가､ 아이들을 바라본다｡"
  },
  {
   "id": 28193,
   "key": "D1207le.txt:306",
   "file": "D1207le.txt",
   "line": 306,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その奥に、青年本来の眸は、見えない。",
   "ko_candidate": "그 안쪽에서､ 청년 본연의 눈동자는 보이지 않는다｡"
  },
  {
   "id": 28194,
   "key": "D1207le.txt:307",
   "file": "D1207le.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの優しさも狂気も、一切は仮面の下に封印されている。",
   "ko_candidate": "그 상냥함도 광기도､ 모든 것은 가면 아래에 봉인되어 있다｡"
  },
  {
   "id": 28195,
   "key": "D1207le.txt:313",
   "file": "D1207le.txt",
   "line": 313,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お前達が咲かせろ。命の華を。それが彼女への献花となる」",
   "ko_candidate": "「너희들이 피워라｡ 생명의 꽃을｡ 그것이 그녀에 대한 헌화가 될 것이다」"
  },
  {
   "id": 28196,
   "key": "D1207le.txt:316",
   "file": "D1207le.txt",
   "line": 316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３人とも動けない。",
   "ko_candidate": "3명 모두 움직일 수 없다｡"
  },
  {
   "id": 28197,
   "key": "D1207le.txt:317",
   "file": "D1207le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げ惑う事はおろか、泣き叫ぶ事も出来はしない。",
   "ko_candidate": "도망치는 것은 고사하고､ 울부짖을 수조차 없다｡"
  },
  {
   "id": 28198,
   "key": "D1207le.txt:319",
   "file": "D1207le.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てを凍てつかせる、絶対的な恐怖。",
   "ko_candidate": "모든 것을 얼어붙게 하는､ 절대적인 공포｡"
  },
  {
   "id": 28199,
   "key": "D1207le.txt:320",
   "file": "D1207le.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その圧力に、子ども達は曝されていた。",
   "ko_candidate": "그 압력에､ 아이들은 노출되어 있었다｡"
  },
  {
   "id": 28200,
   "key": "D1207le.txt:325",
   "file": "D1207le.txt",
   "line": 325,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あ……あ……あああ……っ」",
   "ko_candidate": "「아… 아… 아아아…」"
  },
  {
   "id": 28201,
   "key": "D1207le.txt:329",
   "file": "D1207le.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ジョージが失禁する。",
   "ko_candidate": "죠지가 실금한다｡"
  },
  {
   "id": 28202,
   "key": "D1207le.txt:330",
   "file": "D1207le.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ズボンを濡らし、足元に水溜まりを作った。",
   "ko_candidate": "바지를 적시고､ 발밑에 물웅덩이를 만들었다｡"
  },
  {
   "id": 28203,
   "key": "D1207le.txt:335",
   "file": "D1207le.txt",
   "line": 335,
   "speaker": "コリン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「い、いやだよ……」",
   "ko_candidate": "「싫､ 싫어…」"
  },
  {
   "id": 28204,
   "key": "D1207le.txt:339",
   "file": "D1207le.txt",
   "line": 339,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「人は皆死ぬ。ならば少しは意味のある死に方をしろ」",
   "ko_candidate": "「사람은 모두 죽는다｡ 그렇다면 조금은 의미 있는 죽음을 맞이해라」"
  },
  {
   "id": 28205,
   "key": "D1207le.txt:342",
   "file": "D1207le.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの黒い手が、アリスンの額に触れた。",
   "ko_candidate": "산달폰의 검은 손이､ 앨리슨의 이마에 닿았다｡"
  },
  {
   "id": 28206,
   "key": "D1207le.txt:343",
   "file": "D1207le.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖の臨界に達し、暴発する。",
   "ko_candidate": "공포의 임계에 도달하여､ 폭발한다｡"
  },
  {
   "id": 28207,
   "key": "D1207le.txt:349",
   "file": "D1207le.txt",
   "line": 349,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いやあああああああああああああ！」",
   "ko_candidate": "「싫어어어어어어어어어어어어!」"
  },
  {
   "id": 28208,
   "key": "D1207le.txt:353",
   "file": "D1207le.txt",
   "line": 353,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くぅっ!?」",
   "ko_candidate": "「크윽!?」"
  },
  {
   "id": 28209,
   "key": "D1207le.txt:363",
   "file": "D1207le.txt",
   "line": 363,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃波がサンダルフォンを撃つ。",
   "ko_candidate": "충격파가 산달폰을 강타한다｡"
  },
  {
   "id": 28210,
   "key": "D1207le.txt:365",
   "file": "D1207le.txt",
   "line": 365,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掌の装甲が砕け、生身の肌を晒す。",
   "ko_candidate": "손바닥의 장갑이 부서지고､ 맨살을 드러낸다｡"
  },
  {
   "id": 28211,
   "key": "D1207le.txt:366",
   "file": "D1207le.txt",
   "line": 366,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕けた破片が、肉にめり込んだ。",
   "ko_candidate": "부서진 파편이､ 살에 박혔다｡"
  },
  {
   "id": 28212,
   "key": "D1207le.txt:368",
   "file": "D1207le.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "指もあらぬ方向に圧し折れる。",
   "ko_candidate": "손가락도 엉뚱한 방향으로 꺾인다｡"
  },
  {
   "id": 28213,
   "key": "D1207le.txt:369",
   "file": "D1207le.txt",
   "line": 369,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃波の勢いはそれだけでは留まらず、サンダルフォンの躰を十数メートルも後退させた。",
   "ko_candidate": "충격파의 기세는 그것만으로 멈추지 않고､ 산달폰의 몸을 십여 미터나 후퇴시켰다｡"
  },
  {
   "id": 28214,
   "key": "D1207le.txt:374",
   "file": "D1207le.txt",
   "line": 374,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうか。能力持ちが居たんだったな。 だが……無駄な足掻きだ」",
   "ko_candidate": "「그렇군｡ 능력자가 있었지｡ 하지만… 헛된 발버둥이다」"
  },
  {
   "id": 28215,
   "key": "D1207le.txt:382",
   "file": "D1207le.txt",
   "line": 382,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ち、近寄るなぁぁぁぁぁぁ！」",
   "ko_candidate": "「가､ 가까이 오지 마아아아아아!」"
  },
  {
   "id": 28216,
   "key": "D1207le.txt:385",
   "file": "D1207le.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一歩を踏み出すサンダルフォン。",
   "ko_candidate": "한 걸음을 내딛는 산달폰｡"
  },
  {
   "id": 28217,
   "key": "D1207le.txt:389",
   "file": "D1207le.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見えない爆発がサンダルフォンの胸で弾けた。",
   "ko_candidate": "보이지 않는 폭발이 산달폰의 가슴에서 터졌다｡"
  },
  {
   "id": 28218,
   "key": "D1207le.txt:390",
   "file": "D1207le.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、黒い天使は気にも留めない。",
   "ko_candidate": "하지만､ 검은 천사는 신경 쓰지 않는다｡"
  },
  {
   "id": 28219,
   "key": "D1207le.txt:391",
   "file": "D1207le.txt",
   "line": 391,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に一歩。",
   "ko_candidate": "다시 한 걸음｡"
  },
  {
   "id": 28220,
   "key": "D1207le.txt:394",
   "file": "D1207le.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの顔面を撃つ。",
   "ko_candidate": "산달폰의 얼굴을 강타한다｡"
  },
  {
   "id": 28221,
   "key": "D1207le.txt:395",
   "file": "D1207le.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面に罅が入る程の衝撃。",
   "ko_candidate": "가면에 금이 갈 정도의 충격｡"
  },
  {
   "id": 28222,
   "key": "D1207le.txt:397",
   "file": "D1207le.txt",
   "line": 397,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意に介さず。",
   "ko_candidate": "개의치 않는다｡"
  },
  {
   "id": 28223,
   "key": "D1207le.txt:398",
   "file": "D1207le.txt",
   "line": 398,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に一歩。",
   "ko_candidate": "다시 한 걸음｡"
  },
  {
   "id": 28224,
   "key": "D1207le.txt:399",
   "file": "D1207le.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更に一歩……。",
   "ko_candidate": "다시 한 걸음…"
  },
  {
   "id": 28225,
   "key": "D1207le.txt:404",
   "file": "D1207le.txt",
   "line": 404,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うあああ……ああああ……あああああ……っ！」",
   "ko_candidate": "「우아아아… 아아아아… 아아아아아…!」"
  },
  {
   "id": 28226,
   "key": "D1207le.txt:408",
   "file": "D1207le.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発に撃たれ、時に仰け反りながらも、子ども達に無言で迫る。",
   "ko_candidate": "폭발에 맞아､ 때로는 뒤로 젖혀지면서도､ 아이들에게 무언으로 다가온다｡"
  }
 ]
}