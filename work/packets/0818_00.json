 "items": [
  {
   "id": 17113,
   "key": "D0818le.txt:9",
   "file": "D0818le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "尖塔の上、ウェスパシアヌスはあからさまに落胆した表情で、眼下の戦いを見守っていた。",
   "ko_candidate": "첨탑 위에서 베스파시아누스는 노골적으로 실망한 표정으로､ 아래의 전투를 지켜보고 있었다｡"
  },
  {
   "id": 17114,
   "key": "D0818le.txt:13",
   "file": "D0818le.txt",
   "line": 13,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やれやれ…… あれでは自滅するのがオチだな。 これでは到底、今の『暴君』の力を計れまい。 つまらん。 つまらんなあ、大十字九郎君。 だが……」",
   "ko_candidate": "「참 나……저러다간 자멸하고 말겠군｡ 이래서야 도저히 지금의 『폭군』의 힘을 가늠할 수 없겠어｡ 재미없군｡ 재미없어､ 다이쥬지 쿠로 군｡ 하지만……」"
  },
  {
   "id": 17115,
   "key": "D0818le.txt:19",
   "file": "D0818le.txt",
   "line": 19,
   "speaker": "ウェスパシアヌス",
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そもそも『暴君』の力をある程度引きずり出せる存在など、この世には居ないのかも知れない。",
   "ko_candidate": "애초에 『폭군』의 힘을 어느 정도 끌어낼 수 있는 존재 따위､ 이 세상에는 없을지도 모른다｡"
  },
  {
   "id": 17116,
   "key": "D0818le.txt:19",
   "file": "D0818le.txt",
   "line": 19,
   "speaker": "ウェスパシアヌス",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それこそ、大導師以外には誰も。 「それだけ恐るべき存在ということか。己が持つ圧倒的暴力の総てを理解し、思うがままに扱いこなす者」",
   "ko_candidate": "그야말로､ <RUBY text=\"그랜드 마스터\">대도사</RUBY> 외에는 아무도｡"
  },
  {
   "id": 17117,
   "key": "D0818le.txt:28",
   "file": "D0818le.txt",
   "line": 28,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「他の総ての価値を排除し、 自らの望むがままに魔術という 権力を行使する者。 まさに『暴君』。 これこそ『暴君』」 「素晴らしい。素晴らしいぞ」",
   "ko_candidate": "「그만큼 두려운 존재라는 건가｡ 자신이 가진 압도적인 폭력의 모든 것을 이해하고､ 마음대로 다룰 줄 아는 자｡ 다른 모든 가치를 배제하고､ 자신의 뜻대로 마술이라는 권력을 행사하는 자｡ 정말로 『폭군』｡ 이야말로 『폭군』｡ 훌륭해｡ 정말 훌륭하군」"
  },
  {
   "id": 17118,
   "key": "D0818le.txt:38",
   "file": "D0818le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――『暴君』ですらこれなのだ。",
   "ko_candidate": "――『폭군』조차도 이 정도인데｡"
  },
  {
   "id": 17119,
   "key": "D0818le.txt:39",
   "file": "D0818le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だとしたら、アレはいったいどんなのだろう。",
   "ko_candidate": "그렇다면､ 그것은 도대체 어떤 모습일까｡"
  },
  {
   "id": 17120,
   "key": "D0818le.txt:41",
   "file": "D0818le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アレに思いを馳せるだけで心が躍る。",
   "ko_candidate": "그것을 생각하는 것만으로도 가슴이 뛴다｡"
  },
  {
   "id": 17121,
   "key": "D0818le.txt:42",
   "file": "D0818le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウェスパシアヌスにとってアレは……",
   "ko_candidate": "베스파시아누스에게 그것은……어쩌면 C계획보다도 더 마음을"
  },
  {
   "id": 17122,
   "key": "D0818le.txt:43",
   "file": "D0818le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あるいはＣ計画よりも心を占めるものかも知れない。",
   "ko_candidate": "사로잡는 것일지도 모른다｡"
  },
  {
   "id": 17123,
   "key": "D0818le.txt:50",
   "file": "D0818le.txt",
   "line": 50,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「問題は……あのお転婆を どうやって大人しくさせるかだが。 はてさて……」",
   "ko_candidate": "「문제는……저 말괄량이를 어떻게 얌전하게 만들 것인가인데｡ 어떻게 하면 좋을까……」"
  },
  {
   "id": 17124,
   "key": "D0818le.txt:58",
   "file": "D0818le.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――ただならぬ、気配を感じる。",
   "ko_candidate": "――심상치 않은 기운을 느낀다｡"
  },
  {
   "id": 17125,
   "key": "D0818le.txt:59",
   "file": "D0818le.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "物思いに耽ていた思考を、再び戦いへと戻す。",
   "ko_candidate": "생각에 잠겨 있던 사고를､ 다시 전투로 돌린다｡"
  },
  {
   "id": 17126,
   "key": "D0818le.txt:60",
   "file": "D0818le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして……絶句した。",
   "ko_candidate": "그리고……할말을 잃었다｡"
  },
  {
   "id": 17127,
   "key": "D0818le.txt:64",
   "file": "D0818le.txt",
   "line": 64,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何を…… 何をしているのだ、彼は？」",
   "ko_candidate": "「무엇을……무엇을 하고 있는 거지､ 그는?」"
  },
  {
   "id": 17128,
   "key": "D0818le.txt:76",
   "file": "D0818le.txt",
   "line": 76,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「霊圧値１万３千…… １万５千…… に、２万っ！　うそっ、 まだ上昇するの……!?」 「２万５千……２万、８千…… さ、３万……駄目っ！ 臨界突破してしまいます！」",
   "ko_candidate": "「영압값 1만 3천……1만 5천…… 2､ 2만! 거짓말､ 아직도 상승하는 거야……!? 2만 5천……2만､ 8천…… 3､ 3만……안 돼! 임계를 돌파해 버립니다!」"
  },
  {
   "id": 17129,
   "key": "D0818le.txt:89",
   "file": "D0818le.txt",
   "line": 89,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「…………っ！」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 17130,
   "key": "D0818le.txt:93",
   "file": "D0818le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "このまま暴走が止まらなければ、１４区画が吹き飛ぶどころか、周囲は致命的な呪的汚染に見舞われることになる。",
   "ko_candidate": "이대로 폭주가 멈추지 않으면､ 14구역이 날아가는 정도가 아니라､"
  },
  {
   "id": 17131,
   "key": "D0818le.txt:93",
   "file": "D0818le.txt",
   "line": 93,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ちょうど永久封鎖された１３区画と同じように。",
   "ko_candidate": "주변은 치명적인 주술적 오염에 휩싸이게 될 것이다｡"
  },
  {
   "id": 17132,
   "key": "D0818le.txt:95",
   "file": "D0818le.txt",
   "line": 95,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それだけは避けなければならない。",
   "ko_candidate": "마치 영구 봉쇄된 13구역과 똑같이｡"
  },
  {
   "id": 17133,
   "key": "D0818le.txt:96",
   "file": "D0818le.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、どうやって？",
   "ko_candidate": "그것만은 피해야만 한다｡"
  },
  {
   "id": 17134,
   "key": "D0818le.txt:98",
   "file": "D0818le.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "悩んでいるうちにも、霊圧値は臨界突破――破滅へと向かって上昇し続けている……！",
   "ko_candidate": "하지만､ 어떻게? 고민하는 사이에도､ 영압값은 임계를 돌파――파멸을 향해"
  },
  {
   "id": 17135,
   "key": "D0818le.txt:103",
   "file": "D0818le.txt",
   "line": 103,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「３万８千…… り、臨界突……え？」",
   "ko_candidate": "계속 상승하고 있다……! 「3만 8천……임､ 임계 돌……어?」"
  },
  {
   "id": 17136,
   "key": "D0818le.txt:116",
   "file": "D0818le.txt",
   "line": 116,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうしたのです!?」",
   "ko_candidate": "「무슨 일입니까!?」"
  },
  {
   "id": 17137,
   "key": "D0818le.txt:121",
   "file": "D0818le.txt",
   "line": 121,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「え、えーと、その……」",
   "ko_candidate": "「어､ 음､ 그게……」"
  },
  {
   "id": 17138,
   "key": "D0818le.txt:126",
   "file": "D0818le.txt",
   "line": 126,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――字祷子圧縮、情報化。新術式を構成。神獣内の術式に介入し、情報を書き換えます。神獣、情報体へと分解、再結晶」 「超高密度の字祷子を内包したまま、まったく新たな魔導物質へと顕在化します」",
   "ko_candidate": "「――인과율자 압축､ 정보화｡ 새로운 술식을 구성｡ 신수 내의 술식에 개입하여 정보를 다시 씁니다｡ 신수､ 정보체로 분해､ 재결정｡ 초고밀도의 인과율자를 내포한 채､ 완전히 새로운 마도물질로 현재화합니다」"
  },
  {
   "id": 17139,
   "key": "D0818le.txt:136",
   "file": "D0818le.txt",
   "line": 136,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……はあ？」",
   "ko_candidate": "「……네?」"
  },
  {
   "id": 17140,
   "key": "D0818le.txt:142",
   "file": "D0818le.txt",
   "line": 142,
   "speaker": "チアキ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こ、これは……！」",
   "ko_candidate": "「이､ 이것은……!」"
  },
  {
   "id": 17141,
   "key": "D0818le.txt:156",
   "file": "D0818le.txt",
   "line": 156,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……九郎。九郎って、いったい。 九郎は……九郎は……」",
   "ko_candidate": "「……쿠로｡ 쿠로는､ 도대체｡ 쿠로는……쿠로는……」"
  },
  {
   "id": 17142,
   "key": "D0818le.txt:161",
   "file": "D0818le.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "殺意を――もっと――殺意を――",
   "ko_candidate": "살의를――더――살의를――"
  },
  {
   "id": 17143,
   "key": "D0818le.txt:166",
   "file": "D0818le.txt",
   "line": 166,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いったい、九郎は…… 何者なんだい？」",
   "ko_candidate": "「도대체､ 쿠로는…… 무엇인 거지?」"
  },
  {
   "id": 17144,
   "key": "D0818le.txt:178",
   "file": "D0818le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "より強く、強く、強く、強く認識しろ。",
   "ko_candidate": "더 강하게､ 강하게､ 강하게､ 강하게 인식해라｡"
  },
  {
   "id": 17145,
   "key": "D0818le.txt:180",
   "file": "D0818le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "殺意の容を捉えろ。",
   "ko_candidate": "살의의 형태를 포착해라｡"
  },
  {
   "id": 17146,
   "key": "D0818le.txt:181",
   "file": "D0818le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "殺意を精錬しろ。",
   "ko_candidate": "살의를 정련해라｡"
  },
  {
   "id": 17147,
   "key": "D0818le.txt:182",
   "file": "D0818le.txt",
   "line": 182,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "確かなる、実在なる殺意を以って、 実体なる殺意を精製しろ。",
   "ko_candidate": "확실한､ 실재하는 살의로써､ 실체 있는 살의를 정제해라｡"
  },
  {
   "id": 17148,
   "key": "D0818le.txt:185",
   "file": "D0818le.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真に敵を滅ぼし得る、確かな質量を。確かな物質を。",
   "ko_candidate": "진정으로 적을 멸할 수 있는､ 확실한 질량을｡ 확실한 물질을｡"
  },
  {
   "id": 17149,
   "key": "D0818le.txt:186",
   "file": "D0818le.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もっとも単純な容で。",
   "ko_candidate": "가장 단순한 형태로｡"
  },
  {
   "id": 17150,
   "key": "D0818le.txt:187",
