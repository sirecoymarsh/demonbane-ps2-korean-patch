 "items": [
  {
   "id": 15062,
   "key": "D0809le.txt:549",
   "file": "D0809le.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……ちっ。どうする？　どうすれば良い？",
   "ko_candidate": "…칫｡ 어떡하지? 어떻게 하면 좋을까?"
  },
  {
   "id": 15063,
   "key": "D0809le.txt:554",
   "file": "D0809le.txt",
   "line": 554,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん！」",
   "ko_candidate": "「쿠로 군!」"
  },
  {
   "id": 15064,
   "key": "D0809le.txt:560",
   "file": "D0809le.txt",
   "line": 560,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――!?」",
   "ko_candidate": "「――――!?」"
  },
  {
   "id": 15065,
   "key": "D0809le.txt:562",
   "file": "D0809le.txt",
   "line": 562,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "沈黙を破ったのはライカさんの叫び声だった。",
   "ko_candidate": "침묵을 깬 것은 라이카 씨의 외침이었다｡"
  },
  {
   "id": 15066,
   "key": "D0809le.txt:564",
   "file": "D0809le.txt",
   "line": 564,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "騒ぎを聞きつけて、戻ってきたのか？",
   "ko_candidate": "소란을 듣고､ 돌아온 건가?"
  },
  {
   "id": 15067,
   "key": "D0809le.txt:566",
   "file": "D0809le.txt",
   "line": 566,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最悪のタイミングだ。",
   "ko_candidate": "최악의 타이밍이다｡"
  },
  {
   "id": 15068,
   "key": "D0809le.txt:570",
   "file": "D0809le.txt",
   "line": 570,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ＢＡＮＧ！」",
   "ko_candidate": "「BANG!」"
  },
  {
   "id": 15069,
   "key": "D0809le.txt:578",
   "file": "D0809le.txt",
   "line": 578,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの銃口が火を噴くのを、俺は確かに見た。",
   "ko_candidate": "두 개의 총구에서 불이 뿜어져 나오는 것을､ 나는 분명히 보았다｡"
  },
  {
   "id": 15070,
   "key": "D0809le.txt:580",
   "file": "D0809le.txt",
   "line": 580,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "考えるよりも遥かに速く、跳ぶ。",
   "ko_candidate": "생각하는 것보다 훨씬 빠르게､ 뛴다｡"
  },
  {
   "id": 15071,
   "key": "D0809le.txt:588",
   "file": "D0809le.txt",
   "line": 588,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刹那、足元の地面は消滅していた。",
   "ko_candidate": "찰나､ 발밑의 지면은 소멸해 있었다｡"
  },
  {
   "id": 15072,
   "key": "D0809le.txt:590",
   "file": "D0809le.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆風を浴び、空を舞い上げられながら、次に備える。",
   "ko_candidate": "폭풍을 맞으며､ 하늘로 날려 올라가면서､ 다음을 대비한다｡"
  },
  {
   "id": 15073,
   "key": "D0809le.txt:592",
   "file": "D0809le.txt",
   "line": 592,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――来た！",
   "ko_candidate": "――왔다!"
  },
  {
   "id": 15074,
   "key": "D0809le.txt:602",
   "file": "D0809le.txt",
   "line": 602,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆煙を貫き、３発の弾丸が軌道を自在に刻みながら迫る。",
   "ko_candidate": "폭연을 뚫고､ 3발의 총알이 궤도를 자유자재로 그리며 다가온다｡"
  },
  {
   "id": 15075,
   "key": "D0809le.txt:609",
   "file": "D0809le.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "加えて真っ直ぐに飛来する、１発のゴツイ弾丸……黒い拳銃の弾丸だ。",
   "ko_candidate": "게다가 똑바로 날아오는､ 1발의 굵직한 총알… 검은 권총의 총알이다｡"
  },
  {
   "id": 15076,
   "key": "D0809le.txt:611",
   "file": "D0809le.txt",
   "line": 611,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度は前みたく防禦するワケにはいかない。",
   "ko_candidate": "이번엔 전처럼 방어할 수는 없다｡"
  },
  {
   "id": 15077,
   "key": "D0809le.txt:613",
   "file": "D0809le.txt",
   "line": 613,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "追尾弾を防いだ途端、黒い拳銃の弾丸に風穴を開けられてしまう。",
   "ko_candidate": "추적탄을 막는 순간､ 검은 권총의 총알에 구멍이 뚫려버릴 거다｡"
  },
  {
   "id": 15078,
   "key": "D0809le.txt:615",
   "file": "D0809le.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力の流れをマギウス・ウィングへと集中させる。",
   "ko_candidate": "마력의 흐름을 마기우스 윙으로 집중시킨다｡"
  },
  {
   "id": 15079,
   "key": "D0809le.txt:621",
   "file": "D0809le.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発的な推進力を、下方に向けた。",
   "ko_candidate": "폭발적인 추진력을､ 아래쪽으로 향했다｡"
  },
  {
   "id": 15080,
   "key": "D0809le.txt:630",
   "file": "D0809le.txt",
   "line": 630,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸が頭上を通り過ぎる。そのまま地面に衝突しそうな勢いで着地する。",
   "ko_candidate": "총알이 머리 위를 지나간다｡ 그대로 지면에 충돌할 것 같은 기세로 착지한다｡"
  },
  {
   "id": 15081,
   "key": "D0809le.txt:632",
   "file": "D0809le.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "追尾弾は執拗に追いかけてくる。",
   "ko_candidate": "추적탄은 집요하게 쫓아온다｡"
  },
  {
   "id": 15082,
   "key": "D0809le.txt:636",
   "file": "D0809le.txt",
   "line": 636,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度こそマギウス・ウィングで防ごうとして……戦慄した。",
   "ko_candidate": "이번에야말로 마기우스 윙으로 막으려고 하다가… 전율했다｡"
  },
  {
   "id": 15083,
   "key": "D0809le.txt:638",
   "file": "D0809le.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸はウィングが楯になることを予測して、それを避けるように軌道を変えて、別の角度から襲ってきた――！",
   "ko_candidate": "총알은 윙이 방패가 될 것을 예측하고､ 그것을 피하듯이 궤도를 바꾸어､ 다른 각도에서 덮쳐왔다――!"
  },
  {
   "id": 15084,
   "key": "D0809le.txt:643",
   "file": "D0809le.txt",
   "line": 643,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そ、そんな――っ！」",
   "ko_candidate": "「그､ 그런――읏!」"
  },
  {
   "id": 15085,
   "key": "D0809le.txt:647",
   "file": "D0809le.txt",
   "line": 647,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間に合わないっ……！",
   "ko_candidate": "제시간에 맞출 수 없어…!"
  },
  {
   "id": 15086,
   "key": "D0809le.txt:652",
   "file": "D0809le.txt",
   "line": 652,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えぇぇぇぇぇぇいっ！」",
   "ko_candidate": "「에에에에에에잇!」"
  },
  {
   "id": 15087,
   "key": "D0809le.txt:658",
   "file": "D0809le.txt",
   "line": 658,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "横からの不意な力に、俺は押し倒された。",
   "ko_candidate": "옆에서 갑작스러운 힘에､ 나는 밀려 넘어졌다｡"
  },
  {
   "id": 15088,
   "key": "D0809le.txt:669",
   "file": "D0809le.txt",
   "line": 669,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間一髪、弾丸から逃れられる。",
   "ko_candidate": "간발의 차로､ 총알에서 벗어난다｡"
  },
  {
   "id": 15089,
   "key": "D0809le.txt:671",
   "file": "D0809le.txt",
   "line": 671,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつの間にか……本当に、ズバ抜けた足の速さで、ライカさんが俺のところまで駈けつけ、庇ってくれたのだ。",
   "ko_candidate": "어느새… 정말로､ 뛰어난 발 속도로､ 라이카 씨가 내게로 달려와､ 감싸 주었던 것이다｡"
  },
  {
   "id": 15090,
   "key": "D0809le.txt:673",
   "file": "D0809le.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし――",
   "ko_candidate": "하지만――"
  },
  {
   "id": 15091,
   "key": "D0809le.txt:681",
   "file": "D0809le.txt",
   "line": 681,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああああああああっ！」",
   "ko_candidate": "「아아아아아아아앗!」"
  },
  {
   "id": 15092,
   "key": "D0809le.txt:685",
   "file": "D0809le.txt",
   "line": 685,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんを掠める弾丸。",
   "ko_candidate": "라이카 씨를 스치는 총알｡"
  },
  {
   "id": 15093,
   "key": "D0809le.txt:687",
   "file": "D0809le.txt",
   "line": 687,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "服が破け、肩から血が噴き出した。",
   "ko_candidate": "옷이 찢어지고､ 어깨에서 피가 솟구쳤다｡"
  },
  {
   "id": 15094,
   "key": "D0809le.txt:689",
   "file": "D0809le.txt",
   "line": 689,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の雫が俺の頬にかかる。",
   "ko_candidate": "피의 방울이 내 뺨에 튄다｡"
  },
  {
   "id": 15095,
   "key": "D0809le.txt:691",
   "file": "D0809le.txt",
   "line": 691,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――冷たい怒りが、躰を燃焼させる。",
   "ko_candidate": "――차가운 분노가､ 몸을 연소시킨다｡"
  },
  {
   "id": 15096,
   "key": "D0809le.txt:696",
   "file": "D0809le.txt",
   "line": 696,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「っ!?」",
   "ko_candidate": "「읏!?」"
  },
  {
   "id": 15097,
   "key": "D0809le.txt:708",
   "file": "D0809le.txt",
   "line": 708,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "またしても迫っていた弾丸が、俺の目前に止まる。",
   "ko_candidate": "또다시 다가오고 있던 총알이､ 내 눈앞에서 멈춘다｡"
  },
  {
   "id": 15098,
   "key": "D0809le.txt:710",
   "file": "D0809le.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３発全て。",
   "ko_candidate": "3발 모두｡"
  },
  {
   "id": 15099,
   "key": "D0809le.txt:719",
   "file": "D0809le.txt",
   "line": 719,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "髪の毛で絡めて、捕獲した。",
   "ko_candidate": "머리카락으로 얽어매어､ 포획했다｡"
  },
  {
   "id": 15100,
   "key": "D0809le.txt:721",
   "file": "D0809le.txt",
   "line": 721,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸は自由になろうと暴れているが、むろん離してやるはずがない。",
   "ko_candidate": "총알은 자유가 되려고 날뛰고 있지만､ 물론 놓아줄 리가 없다｡"
  },
  {
   "id": 15101,
   "key": "D0809le.txt:726",
   "file": "D0809le.txt",
   "line": 726,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……アトラック＝ナチャの 魔力！」",
   "ko_candidate": "「…아틀락 나챠의 마력!」"
  }
 ]
}