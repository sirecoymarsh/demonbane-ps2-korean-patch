 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "シャンタク": "샨타크",
  "魔力": "마력",
  "アル": "알",
  "サンダルフォン": "산달폰",
  "デモンベイン": "데몬베인",
  "ライカ": "라이카",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 39859,
   "key": "D1412le.txt:37",
   "file": "D1412le.txt",
   "line": 37,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言われるまでもない。",
   "ko_candidate": "말할 필요도 없다｡"
  },
  {
   "id": 39860,
   "key": "D1412le.txt:38",
   "file": "D1412le.txt",
   "line": 38,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "身体の方が勝手に臨戦態勢を整えてしまっている。",
   "ko_candidate": "몸이 알아서 임전태세를 갖추고 있다｡"
  },
  {
   "id": 39861,
   "key": "D1412le.txt:40",
   "file": "D1412le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "圧倒的な邪気に対抗するため、俺の細胞の一つ一つが烈しく燃焼している。",
   "ko_candidate": "압도적인 사기에 대항하기 위해 내 세포 하나하나가 격렬하게 연소하고 있다｡"
  },
  {
   "id": 39862,
   "key": "D1412le.txt:41",
   "file": "D1412le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖はあるが、闘志に満ちている。",
   "ko_candidate": "공포는 있지만 투지로 가득 차 있다｡"
  },
  {
   "id": 39863,
   "key": "D1412le.txt:43",
   "file": "D1412le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔のプレッシャーに潰されそうだが、溢れる命のエネルギーも感じている。",
   "ko_candidate": "마의 압박감에 짓눌릴 것 같지만 넘치는 생명의 에너지도 느끼고 있다｡"
  },
  {
   "id": 39864,
   "key": "D1412le.txt:45",
   "file": "D1412le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして何より――守りたい女性の存在が、無限の活力を生み出してくれる。",
   "ko_candidate": "그리고 무엇보다―― 지키고 싶은 여성의 존재가 무한한 활력을 만들어내 준다｡"
  },
  {
   "id": 39865,
   "key": "D1412le.txt:46",
   "file": "D1412le.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "戦うには絶好のコンディションだ。",
   "ko_candidate": "싸우기에는 최고의 컨디션이다｡"
  },
  {
   "id": 39866,
   "key": "D1412le.txt:48",
   "file": "D1412le.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "更なる下層へと通じるシャフトに出た。",
   "ko_candidate": "더 아래층으로 통하는 샤프트에 도착했다｡"
  },
  {
   "id": 39867,
   "key": "D1412le.txt:50",
   "file": "D1412le.txt",
   "line": 50,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『シャンタク』を操り、ゆっくりと下に降りる。",
   "ko_candidate": "『샨타크』를 조종해 천천히 아래로 내려간다｡"
  },
  {
   "id": 39868,
   "key": "D1412le.txt:51",
   "file": "D1412le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今まで以上に、広大なシャフトだ。",
   "ko_candidate": "지금까지 이상으로 광대한 샤프트다｡"
  },
  {
   "id": 39869,
   "key": "D1412le.txt:58",
   "file": "D1412le.txt",
   "line": 58,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ん……？」",
   "ko_candidate": "「음……?」"
  },
  {
   "id": 39870,
   "key": "D1412le.txt:62",
   "file": "D1412le.txt",
   "line": 62,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どうした？」",
   "ko_candidate": "「왜 그래?」"
  },
  {
   "id": 39871,
   "key": "D1412le.txt:66",
   "file": "D1412le.txt",
   "line": 66,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何か……強大な魔力が爆発した痕跡がある」",
   "ko_candidate": "「뭔가…… 강대한 마력이 폭발한 흔적이 있어」"
  },
  {
   "id": 39872,
   "key": "D1412le.txt:71",
   "file": "D1412le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルに言われて、周囲の様子を調べる。",
   "ko_candidate": "알의 말에 주변 상황을 살펴본다｡"
  },
  {
   "id": 39873,
   "key": "D1412le.txt:73",
   "file": "D1412le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かに……魔力の残滓が、未だ空間中に漂っている。",
   "ko_candidate": "확실히…… 마력의 잔재가 아직 공간 속에 떠돌고 있다｡"
  },
  {
   "id": 39874,
   "key": "D1412le.txt:75",
   "file": "D1412le.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "よく見れば、周囲の壁も傷つき、緑色の血を垂れ流していた。",
   "ko_candidate": "자세히 보니 주변 벽도 상처 입어 녹색 피를 흘리고 있었다｡"
  },
  {
   "id": 39875,
   "key": "D1412le.txt:76",
   "file": "D1412le.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それも徐々に修復していっているようだが。",
   "ko_candidate": "그것도 점점 복구되고 있는 것 같지만｡"
  },
  {
   "id": 39876,
   "key": "D1412le.txt:80",
   "file": "D1412le.txt",
   "line": 80,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「爆発の痕……何かがここで交戦したのか？」",
   "ko_candidate": "「폭발의 흔적…… 뭔가가 여기서 교전한 건가?」"
  },
  {
   "id": 39877,
   "key": "D1412le.txt:84",
   "file": "D1412le.txt",
   "line": 84,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「サンダルフォンの事もある。気をつけろ」",
   "ko_candidate": "「산달폰의 일도 있어｡ 조심해」"
  },
  {
   "id": 39878,
   "key": "D1412le.txt:88",
   "file": "D1412le.txt",
   "line": 88,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ」",
   "ko_candidate": "「응」"
  },
  {
   "id": 39879,
   "key": "D1412le.txt:94",
   "file": "D1412le.txt",
   "line": 94,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "どれほどの時間が経ったろうか。",
   "ko_candidate": "얼마나 시간이 지났을까｡"
  },
  {
   "id": 39880,
   "key": "D1412le.txt:102",
   "file": "D1412le.txt",
   "line": 102,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "十数キロの距離を降って、ようやく最下層に辿り着いた。",
   "ko_candidate": "십여 킬로미터의 거리를 내려가 마침내 최하층에 도착했다｡"
  },
  {
   "id": 39881,
   "key": "D1412le.txt:104",
   "file": "D1412le.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眼下に広がるのは、何処までも紅い海。",
   "ko_candidate": "눈 아래로 펼쳐지는 것은 어디까지나 붉은 바다｡"
  },
  {
   "id": 39882,
   "key": "D1412le.txt:105",
   "file": "D1412le.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの爪先が水面に触れ、波紋を広げた。",
   "ko_candidate": "데몬베인의 발끝이 수면에 닿아 파문을 일으켰다｡"
  },
  {
   "id": 39883,
   "key": "D1412le.txt:109",
   "file": "D1412le.txt",
   "line": 109,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……！　邪気が桁違いに濃い……！ おそらくは中枢はこの奥に……！」",
   "ko_candidate": "「큭…… ! 사기가 차원이 다르게 짙어…… ! 아마도 중추는 이 안쪽에…… !」"
  },
  {
   "id": 39884,
   "key": "D1412le.txt:114",
   "file": "D1412le.txt",
   "line": 114,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさんもそこに……」",
   "ko_candidate": "「라이카 씨도 거기에……」"
  },
  {
   "id": 39885,
   "key": "D1412le.txt:118",
   "file": "D1412le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血の海のすぐ真上に沿って、飛行する。",
   "ko_candidate": "피의 바다 바로 위를 따라 비행한다｡"
  },
  {
   "id": 39886,
   "key": "D1412le.txt:123",
   "file": "D1412le.txt",
   "line": 123,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "濃度を増す邪気は遂には空間を歪ませるほどになっていた。",
   "ko_candidate": "농도를 더해가는 사기는 마침내 공간을 왜곡시킬 정도가 되어 있었다｡"
  },
  {
   "id": 39887,
   "key": "D1412le.txt:125",
   "file": "D1412le.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分が今、真っ直ぐ進んでいるのか、曲がっているのか、更には昇っているか降っているのか逆様なのか、それすらも見失いそうになる。",
   "ko_candidate": "자신이 지금 똑바로 가고 있는지､ 휘어져 가고 있는지､ 더 나아가 올라가고 있는지 내려가고 있는지 거꾸로인지､ 그조차도 헷갈릴 것 같다｡"
  },
  {
   "id": 39888,
   "key": "D1412le.txt:127",
   "file": "D1412le.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全神経を研ぎ澄まして、幻覚に対抗する。",
   "ko_candidate": "모든 신경을 곤두세워 환각에 대항한다｡"
  },
  {
   "id": 39889,
   "key": "D1412le.txt:128",
   "file": "D1412le.txt",
   "line": 128,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "冷汗が全身から噴き出した。",
   "ko_candidate": "식은땀이 온몸에서 뿜어져 나왔다｡"
  },
  {
   "id": 39890,
   "key": "D1412le.txt:130",
   "file": "D1412le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがて紅く煙る視界の向こう、巨大な……デモンベインの全長の何倍にも及ぶ巨大な扉がそびえ立つのを認めた。",
   "ko_candidate": "이윽고 붉게 연기 나는 시야 너머､ 거대한…… 데몬베인의 전장의 몇 배에 달하는 거대한 문이 우뚝 솟아 있는 것을 알아챘다｡"
  },
  {
   "id": 39891,
   "key": "D1412le.txt:139",
   "file": "D1412le.txt",
   "line": 139,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「間違いない……あの扉の向こうだ。邪気はあの奥から吹き荒れている」",
   "ko_candidate": "「틀림없어…… 저 문 너머야｡ 사기는 저 안쪽에서 휘몰아치고 있어」"
  },
  {
   "id": 39892,
   "key": "D1412le.txt:143",
   "file": "D1412le.txt",
   "line": 143,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……良し！」",
   "ko_candidate": "「…… 좋아!」"
  },
  {
   "id": 39893,
   "key": "D1412le.txt:146",
   "file": "D1412le.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "待っていろ、ライカさん！",
   "ko_candidate": "기다려요､ 라이카 씨!"
  },
  {
   "id": 39894,
   "key": "D1412le.txt:147",
   "file": "D1412le.txt",
   "line": 147,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺が今、助けて――！",
   "ko_candidate": "내가 지금 구하러――!"
  },
  {
   "id": 39895,
   "key": "D1412le.txt:151",
   "file": "D1412le.txt",
   "line": 151,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――!?　待て、九郎！」",
   "ko_candidate": "「――!? 기다려､ 쿠로!」"
  },
  {
   "id": 39896,
   "key": "D1412le.txt:155",
   "file": "D1412le.txt",
   "line": 155,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわっとと！　な、何だよいきなり！」",
   "ko_candidate": "「우와! 뭐､ 뭐야 갑자기!」"
  },
  {
   "id": 39897,
   "key": "D1412le.txt:159",
   "file": "D1412le.txt",
   "line": 159,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……扉の前だ。注意深く見ろ」",
   "ko_candidate": "「…… 문 앞이야｡ 주의 깊게 봐」"
  },
  {
   "id": 39898,
   "key": "D1412le.txt:163",
   "file": "D1412le.txt",
   "line": 163,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………？」",
   "ko_candidate": "「…………?」"
  }
 ]
}