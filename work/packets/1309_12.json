 "items": [
  {
   "id": 34371,
   "key": "D1309ru.txt:65",
   "file": "D1309ru.txt",
   "line": 65,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……大十字さん。本当にもう大丈夫なのですか？ その……身体の方とか……」",
   "ko_candidate": "「…다이쥬지 씨｡ 정말 이제 괜찮은 건가요? 그… 몸 상태라든가…」"
  },
  {
   "id": 34372,
   "key": "D1309ru.txt:70",
   "file": "D1309ru.txt",
   "line": 70,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ん……？」",
   "ko_candidate": "「음…?」"
  },
  {
   "id": 34373,
   "key": "D1309ru.txt:73",
   "file": "D1309ru.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の身体は包帯まみれだった。",
   "ko_candidate": "내 몸은 붕대투성이였다｡"
  },
  {
   "id": 34374,
   "key": "D1309ru.txt:74",
   "file": "D1309ru.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まあ、デウス・マキナの一撃を喰らったからだろう。だが……。",
   "ko_candidate": "뭐､ 데우스 마키나의 일격을 맞았으니까겠지｡ 하지만…"
  },
  {
   "id": 34375,
   "key": "D1309ru.txt:75",
   "file": "D1309ru.txt",
   "line": 75,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は包帯を外した。",
   "ko_candidate": "나는 붕대를 벗었다｡"
  },
  {
   "id": 34376,
   "key": "D1309ru.txt:79",
   "file": "D1309ru.txt",
   "line": 79,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何か……すっかり治ったみたいだな」",
   "ko_candidate": "「뭔가… 완전히 나은 것 같네」"
  },
  {
   "id": 34377,
   "key": "D1309ru.txt:82",
   "file": "D1309ru.txt",
   "line": 82,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "薄っすらと残っている傷痕を撫でる。少し、こそばゆい。",
   "ko_candidate": "희미하게 남아있는 상처 자국을 쓰다듬는다｡ 조금 간지럽다｡"
  },
  {
   "id": 34378,
   "key": "D1309ru.txt:83",
   "file": "D1309ru.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕を回したり、身体を捻ってみたりして、調子を確かめる。",
   "ko_candidate": "팔을 돌리거나 몸을 비틀어보며 상태를 확인한다｡"
  },
  {
   "id": 34379,
   "key": "D1309ru.txt:85",
   "file": "D1309ru.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少し引き攣る感覚があるが、ほとんど気にならない。",
   "ko_candidate": "약간 당기는 느낌은 있지만､ 거의 신경 쓰이지 않는다｡"
  },
  {
   "id": 34380,
   "key": "D1309ru.txt:89",
   "file": "D1309ru.txt",
   "line": 89,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うむ、良好だ」",
   "ko_candidate": "「음､ 양호해」"
  },
  {
   "id": 34381,
   "key": "D1309ru.txt:93",
   "file": "D1309ru.txt",
   "line": 93,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「まったく……大十字さんったら、心配かけて……」",
   "ko_candidate": "「정말… 다이쥬지 씨도 참､ 걱정 끼치고…」"
  },
  {
   "id": 34382,
   "key": "D1309ru.txt:96",
   "file": "D1309ru.txt",
   "line": 96,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "少し涙の浮かぶ目尻を指で拭いながら、姫さんは微笑んだ。",
   "ko_candidate": "눈가에 맺힌 눈물을 손가락으로 닦으며 공주님은 미소 지었다｡"
  },
  {
   "id": 34383,
   "key": "D1309ru.txt:97",
   "file": "D1309ru.txt",
   "line": 97,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺も、もう一度、微笑み返そうとして――",
   "ko_candidate": "나도 다시 한 번 미소를 지으려다가-"
  },
  {
   "id": 34384,
   "key": "D1309ru.txt:101",
   "file": "D1309ru.txt",
   "line": 101,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……って、んな呑気に構えてる場合じゃない！　姫さんっ、今どういう状況だっ!?　……こら、アルも早く起きろ！」",
   "ko_candidate": "「…이런､ 한가하게 있을 때가 아니야! 공주님､ 지금 어떤 상황이에요!? …이봐､ 알도 빨리 일어나!」"
  },
  {
   "id": 34385,
   "key": "D1309ru.txt:105",
   "file": "D1309ru.txt",
   "line": 105,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――っ！　そうです！ 今、基地はアンチクロスの襲撃を受けていて……！」",
   "ko_candidate": "「아…! 맞아요! 지금､ 기지가 안티 크로스의 습격을 받고 있어서…!」"
  },
  {
   "id": 34386,
   "key": "D1309ru.txt:111",
   "file": "D1309ru.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そのとき、アルが目を醒ました。",
   "ko_candidate": "그때､ 알이 눈을 떴다｡"
  },
  {
   "id": 34387,
   "key": "D1309ru.txt:112",
   "file": "D1309ru.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳をぱっちりと開き、いきなり起き上がる。",
   "ko_candidate": "눈을 번쩍 뜨더니 갑자기 일어난다｡"
  },
  {
   "id": 34388,
   "key": "D1309ru.txt:118",
   "file": "D1309ru.txt",
   "line": 118,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うわわっと！　……アル？」",
   "ko_candidate": "「우와왓! …알?」"
  },
  {
   "id": 34389,
   "key": "D1309ru.txt:122",
   "file": "D1309ru.txt",
   "line": 122,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「------」"
  },
  {
   "id": 34390,
   "key": "D1309ru.txt:125",
   "file": "D1309ru.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "反応が無い。",
   "ko_candidate": "반응이 없다｡"
  },
  {
   "id": 34391,
   "key": "D1309ru.txt:126",
   "file": "D1309ru.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "呆然と、遠い何処かを見つめているような、そんな表情。",
   "ko_candidate": "멍하니 먼 어딘가를 바라보는 듯한 그런 표정｡"
  },
  {
   "id": 34392,
   "key": "D1309ru.txt:127",
   "file": "D1309ru.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの肩を掴み、揺さぶった。",
   "ko_candidate": "알의 어깨를 잡고 흔들었다｡"
  },
  {
   "id": 34393,
   "key": "D1309ru.txt:131",
   "file": "D1309ru.txt",
   "line": 131,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「おい、どうした？　何か変なのか？」",
   "ko_candidate": "「이봐､ 왜 그래? 뭔가 이상한 거야?」"
  },
  {
   "id": 34394,
   "key": "D1309ru.txt:135",
   "file": "D1309ru.txt",
   "line": 135,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――妾はあの時……否、違うのか？　あの時の妾は別の……」",
   "ko_candidate": "「--첩은 그때… 아니､ 다른 건가? 그때의 첩은 다른…」"
  },
  {
   "id": 34395,
   "key": "D1309ru.txt:139",
   "file": "D1309ru.txt",
   "line": 139,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アル！」",
   "ko_candidate": "「알!」"
  },
  {
   "id": 34396,
   "key": "D1309ru.txt:146",
   "file": "D1309ru.txt",
   "line": 146,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――来るぞ、九郎」",
   "ko_candidate": "「--온다､ 쿠로」"
  },
  {
   "id": 34397,
   "key": "D1309ru.txt:150",
   "file": "D1309ru.txt",
   "line": 150,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「へっ!?」",
   "ko_candidate": "「헉!?」"
  },
  {
   "id": 34398,
   "key": "D1309ru.txt:154",
   "file": "D1309ru.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目覚めたときと同じ唐突さで、アルの瞳に焦点が戻った。",
   "ko_candidate": "눈을 떴을 때와 같은 갑작스러움으로 알의 눈동자에 초점이 돌아왔다｡"
  },
  {
   "id": 34399,
   "key": "D1309ru.txt:155",
   "file": "D1309ru.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "短い、だが緊迫した声。",
   "ko_candidate": "짧지만 긴박한 목소리｡"
  },
  {
   "id": 34400,
   "key": "D1309ru.txt:157",
   "file": "D1309ru.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "既にアルの気配は、闘争の空気に順応している。",
   "ko_candidate": "이미 알의 기색은 전투의 공기에 적응하고 있다｡"
  },
  {
   "id": 34401,
   "key": "D1309ru.txt:158",
   "file": "D1309ru.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、俺はそうじゃなかった。",
   "ko_candidate": "그리고 나는 그렇지 않았다｡"
  },
  {
   "id": 34402,
   "key": "D1309ru.txt:163",
   "file": "D1309ru.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭上から襲い来る肉鞭の嵐。",
   "ko_candidate": "머리 위에서 덮쳐오는 육편의 폭풍｡"
  },
  {
   "id": 34403,
   "key": "D1309ru.txt:164",
   "file": "D1309ru.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "慌てて見上げても、遅い。遅すぎる。",
   "ko_candidate": "황급히 올려다봐도 늦다｡ 너무 늦다｡"
  },
  {
   "id": 34404,
   "key": "D1309ru.txt:165",
   "file": "D1309ru.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "肉鞭は汚穢な花弁を、天井いっぱいに拡げて、わななき、うねりながら迫る。",
   "ko_candidate": "육편은 더러운 꽃잎을 천장 가득 펼치고､ 떨리며 꿈틀거리며 다가온다｡"
  },
  {
   "id": 34405,
   "key": "D1309ru.txt:169",
   "file": "D1309ru.txt",
   "line": 169,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎！」",
   "ko_candidate": "「쿠로!」"
  },
  {
   "id": 34406,
   "key": "D1309ru.txt:174",
   "file": "D1309ru.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺とアルを包み込む光。魔導書のページになって崩れるアルの躰。",
   "ko_candidate": "나와 알을 감싸는 빛｡ 마도서의 페이지가 되어 무너지는 알의 몸｡"
  },
  {
   "id": 34407,
   "key": "D1309ru.txt:175",
   "file": "D1309ru.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ぺージの一枚一枚が、俺の躰に纏わりつき、黒いスーツと化す。",
   "ko_candidate": "페이지 한 장 한 장이 내 몸에 감겨들어 검은 슈트로 변한다｡"
  },
  {
   "id": 34408,
   "key": "D1309ru.txt:177",
   "file": "D1309ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奔る術式。無尽蔵に漲る力。限りなく澄み渡る思考。",
   "ko_candidate": "달리는 술식｡ 무진장하게 넘치는 힘｡ 한없이 맑아지는 사고｡"
  },
  {
   "id": 34409,
   "key": "D1309ru.txt:178",
   "file": "D1309ru.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マギウス・スタイルへの変身。",
   "ko_candidate": "마기우스 스타일로의 변신｡"
  },
  {
   "id": 34410,
   "key": "D1309ru.txt:181",
   "file": "D1309ru.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "床を転がり、落ちていたクトゥグアを拾い、仰向けの状態で天井向けて、発砲した。",
   "ko_candidate": "바닥을 구르며 떨어져 있던 크투가를 주워 들고､ 누운 채로 천장을 향해 발사했다｡"
  }
 ]
}