 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アリスン": "앨리슨"
 },
 "items": [
  {
   "id": 4691,
   "key": "D0404.txt:243",
   "file": "D0404.txt",
   "line": 243,
   "speaker": "アリスン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「きゃっ!?」",
   "ko_candidate": "「꺄악!?」"
  },
  {
   "id": 4692,
   "key": "D0404.txt:260",
   "file": "D0404.txt",
   "line": 260,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつの間にか……本当にいつの間にか、アリスンのすぐ背後にその女性は立っていた。長身の美女。",
   "ko_candidate": "놀라서 뒤를 돌아본다｡ 어느새……정말 어느새､ 앨리슨의 바로 뒤에 그 여성이 서 있었다｡ 키 큰 미녀｡"
  },
  {
   "id": 4693,
   "key": "D0404.txt:262",
   "file": "D0404.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アリスンは身構えて、後ずさりする。",
   "ko_candidate": "앨리슨은 경계하며 뒷걸음질 친다｡"
  },
  {
   "id": 4694,
   "key": "D0404.txt:263",
   "file": "D0404.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その様子を見て、美女は優しく微笑んだ。",
   "ko_candidate": "그 모습을 보고 미녀는 부드럽게 미소 지었다｡"
  },
  {
   "id": 4695,
   "key": "D0404.txt:284",
   "file": "D0404.txt",
   "line": 284,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そんなに怯えなくても良いよ。 僕はただ、君にプレゼントがしたいだけなんだ」",
   "ko_candidate": "「그렇게 겁먹지 않아도 돼｡ 나는 그저 너에게 선물을 주고 싶을 뿐이야」"
  },
  {
   "id": 4696,
   "key": "D0404.txt:295",
   "file": "D0404.txt",
   "line": 295,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………？」",
   "ko_candidate": "「…………?」"
  },
  {
   "id": 4697,
   "key": "D0404.txt:301",
   "file": "D0404.txt",
   "line": 301,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ワケの分からないことを言う。",
   "ko_candidate": "무슨 말인지 모르겠다｡"
  },
  {
   "id": 4698,
   "key": "D0404.txt:303",
   "file": "D0404.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アリスンは逃げようと思った。",
   "ko_candidate": "앨리슨은 도망가려고 했다｡"
  },
  {
   "id": 4699,
   "key": "D0404.txt:304",
   "file": "D0404.txt",
   "line": 304,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、何故か足は動いてくれない。",
   "ko_candidate": "하지만 왜인지 발이 움직여 주지 않는다｡"
  },
  {
   "id": 4700,
   "key": "D0404.txt:307",
   "file": "D0404.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "惹きつけられるように美女の瞳を覗き込んでしまう。",
   "ko_candidate": "이끌리듯 미녀의 눈동자를 들여다보게 된다｡"
  },
  {
   "id": 4701,
   "key": "D0404.txt:308",
   "file": "D0404.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "たゆたう闇を閉じ込めた瞳――",
   "ko_candidate": "어둠이 흔들리는 눈동자｡"
  },
  {
   "id": 4702,
   "key": "D0404.txt:309",
   "file": "D0404.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その闇は、昏過ぎて、深過ぎて、底が知れない。",
   "ko_candidate": "그 어둠은 너무나 어둡고､ 너무나 깊어서 바닥을 알 수 없다｡"
  },
  {
   "id": 4703,
   "key": "D0404.txt:319",
   "file": "D0404.txt",
   "line": 319,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「君にこれをあげよう」",
   "ko_candidate": "「너에게 이걸 줄게」"
  },
  {
   "id": 4704,
   "key": "D0404.txt:333",
   "file": "D0404.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "美女が渡してきたのは小さなコンパクトだった。",
   "ko_candidate": "미녀가 건넨 것은 작은 콤팩트였다｡"
  },
  {
   "id": 4705,
   "key": "D0404.txt:334",
   "file": "D0404.txt",
   "line": 334,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "花を象った細工が施されているのが、可愛らしい。",
   "ko_candidate": "꽃 모양의 세공이 되어 있어 귀여워 보인다｡"
  },
  {
   "id": 4706,
   "key": "D0404.txt:336",
   "file": "D0404.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "蓋を開けば、曇り一つ傷一つない美しい鏡に、アリスンの顔が映る。",
   "ko_candidate": "뚜껑을 열면 흐림 하나 상처 하나 없는 아름다운 거울에 앨리슨의 얼굴이 비친다｡"
  },
  {
   "id": 4707,
   "key": "D0404.txt:342",
   "file": "D0404.txt",
   "line": 342,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うわあ……」",
   "ko_candidate": "「우와아……」"
  },
  {
   "id": 4708,
   "key": "D0404.txt:349",
   "file": "D0404.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アリスンはたちまち鏡の虜となった。",
   "ko_candidate": "앨리슨은 순식간에 거울에 매료되었다｡"
  },
  {
   "id": 4709,
   "key": "D0404.txt:353",
   "file": "D0404.txt",
   "line": 353,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "警戒心や疑問はもう湧いてこない。",
   "ko_candidate": "미녀에 대한 경계심이나 의문은 이제 생기지 않는다｡"
  },
  {
   "id": 4710,
   "key": "D0404.txt:354",
   "file": "D0404.txt",
   "line": 354,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魅入られたアリスンに美女は優しく語りかける。",
   "ko_candidate": "매료된 앨리슨에게 미녀는 부드럽게 말을 건넨다｡"
  },
  {
   "id": 4711,
   "key": "D0404.txt:360",
   "file": "D0404.txt",
   "line": 360,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「その鏡はね、魔法の鏡なんだ」",
   "ko_candidate": "「그 거울은 말이야､ 마법의 거울이야」"
  },
  {
   "id": 4712,
   "key": "D0404.txt:365",
   "file": "D0404.txt",
   "line": 365,
   "speaker": "アリスン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「へえ……」",
   "ko_candidate": "「헤에……」"
  },
  {
   "id": 4713,
   "key": "D0404.txt:371",
   "file": "D0404.txt",
   "line": 371,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アリスンの返事も上の空だ。うっとりと鏡を覗き込んでいる。鏡の向こうには、左右さかしまの、自分の貌が在る。",
   "ko_candidate": "앨리슨의 대답도 건성이다｡ 황홀하게 거울을 들여다보고 있다｡"
  },
  {
   "id": 4714,
   "key": "D0404.txt:377",
   "file": "D0404.txt",
   "line": 377,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「むかしむかし、遠い遠い国の、女王様が持っていた鏡。その鏡なら、君の願いを叶えてくれる筈だよ……」",
   "ko_candidate": "거울 너머에는 좌우가 뒤바뀐 자신의 얼굴이 있다｡ 「옛날옛날､ 아주 먼 나라의 여왕님이 가지고 있던 거울｡ 그 거울이라면 네 소원을 이뤄줄 거야……」"
  },
  {
   "id": 4715,
   "key": "D0404.txt:383",
   "file": "D0404.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔法の鏡。",
   "ko_candidate": "마법의 거울｡"
  },
  {
   "id": 4716,
   "key": "D0404.txt:384",
   "file": "D0404.txt",
   "line": 384,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確かに、魔法の鏡。",
   "ko_candidate": "정말로 마법의 거울｡"
  },
  {
   "id": 4717,
   "key": "D0404.txt:386",
   "file": "D0404.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "御伽の国へ。夢の国へ。",
   "ko_candidate": "동화의 나라로｡ 꿈의 나라로｡"
  },
  {
   "id": 4718,
   "key": "D0404.txt:387",
   "file": "D0404.txt",
   "line": 387,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "不思議への扉を開く、素敵な魔法。",
   "ko_candidate": "신비로의 문을 여는 멋진 마법｡"
  },
  {
   "id": 4719,
   "key": "D0404.txt:389",
   "file": "D0404.txt",
   "line": 389,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鏡の中の、アリスンが――微笑った。",
   "ko_candidate": "거울 속의 앨리슨이――미소 지었다｡"
  },
  {
   "id": 4720,
   "key": "D0404.txt:390",
   "file": "D0404.txt",
   "line": 390,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "引き攣った、歪んだ、邪悪な微笑だった。",
   "ko_candidate": "경련하듯 일그러진 사악한 미소였다｡"
  },
  {
   "id": 4721,
   "key": "D0404.txt:392",
   "file": "D0404.txt",
   "line": 392,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど、アリスンは気づかない。",
   "ko_candidate": "하지만 앨리슨은 눈치채지 못한다｡"
  },
  {
   "id": 4722,
   "key": "D0404.txt:393",
   "file": "D0404.txt",
   "line": 393,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "魔法に魅入られ、気づかない。",
   "ko_candidate": "마법에 매료되어 눈치채지 못한다｡"
  },
  {
   "id": 4723,
   "key": "D0404.txt:399",
   "file": "D0404.txt",
   "line": 399,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うふふふ……」",
   "ko_candidate": "「우후후후……」"
  },
  {
   "id": 4724,
   "key": "D0404.txt:407",
   "file": "D0404.txt",
   "line": 407,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "御伽の国へ。夢の国へ。",
   "ko_candidate": "동화의 나라로｡ 꿈의 나라로｡"
  },
  {
   "id": 4725,
   "key": "D0404.txt:408",
   "file": "D0404.txt",
   "line": 408,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "不思議へ繋がる素敵な魔法。",
   "ko_candidate": "신비로 이어지는 멋진 마법｡"
  },
  {
   "id": 4726,
   "key": "D0404.txt:419",
   "file": "D0404.txt",
   "line": 419,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 4727,
   "key": "D0404.txt:420",
   "file": "D0404.txt",
   "line": 420,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悪夢と云えども、凶夢と云えども、夢は夢。",
   "ko_candidate": "악몽이라 해도､ 흉몽이라 해도､ 꿈은 꿈｡"
  }
 ]
}