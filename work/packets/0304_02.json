 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アル": "알"
 },
 "items": [
  {
   "id": 3073,
   "key": "D0304.txt:569",
   "file": "D0304.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "首を傾げてそれをかわすナイトゴーント。",
   "ko_candidate": "고개를 기울여 그것을 피하는 나이트건트｡"
  },
  {
   "id": 3074,
   "key": "D0304.txt:575",
   "file": "D0304.txt",
   "line": 575,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "続けて左肘を繰り出す。 弧を描く肘の軌道上にナイトゴーントの頭。",
   "ko_candidate": "이어서 왼쪽 팔꿈치를 내지른다｡ 호를 그리는 팔꿈치의 궤도상에 나이트건트의 머리｡"
  },
  {
   "id": 3075,
   "key": "D0304.txt:577",
   "file": "D0304.txt",
   "line": 577,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だが、それは右掌によって受け止められる。",
   "ko_candidate": "하지만 그것은 오른손바닥으로 받아낸다｡"
  },
  {
   "id": 3076,
   "key": "D0304.txt:579",
   "file": "D0304.txt",
   "line": 579,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怯んでいる暇はない。 畳みかけるように右膝を腹に決めようとして――",
   "ko_candidate": "주저할 틈이 없다｡ 연이어 오른쪽 무릎을 배에 꽂아넣으려고 하는데……"
  },
  {
   "id": 3077,
   "key": "D0304.txt:597",
   "file": "D0304.txt",
   "line": 597,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うなぁおうっ!?」",
   "ko_candidate": "「우와아앗!?」"
  },
  {
   "id": 3078,
   "key": "D0304.txt:599",
   "file": "D0304.txt",
   "line": 599,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "左足を払われた。 倒れるのをすぐ側の机に寄りかかることで何とか防ぐ。",
   "ko_candidate": "왼발을 휘둘렸다｡ 쓰러지는 몸을 바로 옆의 책상에 기대어 겨우 막는다｡"
  },
  {
   "id": 3079,
   "key": "D0304.txt:606",
   "file": "D0304.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ナイトゴーントの踵落とし。 慌ててしゃがみ込む。",
   "ko_candidate": "나이트건트의 발꿈치 내려찍기｡ 황급히 웅크린다｡"
  },
  {
   "id": 3080,
   "key": "D0304.txt:608",
   "file": "D0304.txt",
   "line": 608,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "背後にあったスチール製の机が盛大にヘシ折れた。",
   "ko_candidate": "발꿈치는 책상에 작렬하고､ 스틸 제 판은 요란하게 구부러졌다｡"
  },
  {
   "id": 3081,
   "key": "D0304.txt:613",
   "file": "D0304.txt",
   "line": 613,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うわ！　うわわわわわっ！」",
   "ko_candidate": "「우와! 우와와와와왓!」"
  },
  {
   "id": 3082,
   "key": "D0304.txt:616",
   "file": "D0304.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "床を這って、その場から離れる。",
   "ko_candidate": "바닥을 기어､ 그 자리에서 멀어진다｡"
  },
  {
   "id": 3083,
   "key": "D0304.txt:617",
   "file": "D0304.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "肩の上でアルが呆れたような溜息をついた。",
   "ko_candidate": "어깨 위에서 알이 어이없다는 듯 한숨을 쉬었다｡"
  },
  {
   "id": 3084,
   "key": "D0304.txt:622",
   "file": "D0304.txt",
   "line": 622,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「はぁぁぁぁ～。 何だ、その屁っ放り腰は。 魔術以前の問題だな」",
   "ko_candidate": "「하아아아아~｡ 뭐야､ 그 엉거주춤한 자세는｡ 마술 이전의 문제로군」"
  },
  {
   "id": 3085,
   "key": "D0304.txt:629",
   "file": "D0304.txt",
   "line": 629,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うるせえよ！」",
   "ko_candidate": "「시끄러워!」"
  },
  {
   "id": 3086,
   "key": "D0304.txt:634",
   "file": "D0304.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "窓際まで逃げて起き上がる。",
   "ko_candidate": "창가까지 도망쳐 일어선다｡"
  },
  {
   "id": 3087,
   "key": "D0304.txt:635",
   "file": "D0304.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ナイトゴーントの追撃はなかった。",
   "ko_candidate": "나이트건트의 추격은 없었다｡"
  },
  {
   "id": 3088,
   "key": "D0304.txt:641",
   "file": "D0304.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "野郎、俺が起き上がるのを見ると、人差し指をくいくいっと動かし、挑発してきやがる。 ぷつんっ。",
   "ko_candidate": "이 자식､ 내가 일어서는 걸 보더니 검지를 꾸욱꾸욱 움직이며 도발해 온다｡"
  },
  {
   "id": 3089,
   "key": "D0304.txt:649",
   "file": "D0304.txt",
   "line": 649,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お、面白れぇぇぇ！　こんのぉ黒子野郎ぉぉぉ！ 舞台裏まで吹き飛ばしてやらぁぁぁぁぁぁ！」",
   "ko_candidate": "머리의 혈관이 터지는 소리가 들리는 것 같았다｡ 「재､ 재밌네에에에! 이 까만 자식아아아! 무대 뒤까지 날려버리겠어어어어어어어어!」"
  },
  {
   "id": 3090,
   "key": "D0304.txt:655",
   "file": "D0304.txt",
   "line": 655,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……血の昇り易い奴だな、汝は。そんな事では……」",
   "ko_candidate": "「……피가 쉽게 오르는 녀석이구나､ 너는｡ 그런 식으로는……」 「자､ 오의! 사망유희! 호아챠아아아――!」"
  },
  {
   "id": 3091,
   "key": "D0304.txt:665",
   "file": "D0304.txt",
   "line": 665,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いざ！　奥義！　死亡遊戯ッ！ ほぁちゃあああ――！」",
   "ko_candidate": "퍽｡ 크로스 카운터를 맞았습니다(오의 실패)｡"
  },
  {
   "id": 3092,
   "key": "D0304.txt:677",
   "file": "D0304.txt",
   "line": 677,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "（奥義敗れる） 「は、鼻の骨がすげぇ嫌な音立てたんだが……」",
   "ko_candidate": "하､ 코뼈가 엄청 싫은 소리를 냈는데……"
  },
  {
   "id": 3093,
   "key": "D0304.txt:687",
   "file": "D0304.txt",
   "line": 687,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……話にもならん」",
   "ko_candidate": "「……말이 되지 않는군」"
  },
  {
   "id": 3094,
   "key": "D0304.txt:692",
   "file": "D0304.txt",
   "line": 692,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「く、くっそぉぉぉ！　……えっ？」",
   "ko_candidate": "「이､ 이자식아아아――! ……엣?」"
  },
  {
   "id": 3095,
   "key": "D0304.txt:699",
   "file": "D0304.txt",
   "line": 699,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ナイトゴーントの背中が見えた。",
   "ko_candidate": "문득 갑자기､ 나이트건트가 등을 보였다｡"
  },
  {
   "id": 3096,
   "key": "D0304.txt:700",
   "file": "D0304.txt",
   "line": 700,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "迫り来る黒い翼。",
   "ko_candidate": "다가오는､ 나이트건트의 검은 날개｡"
  },
  {
   "id": 3097,
   "key": "D0304.txt:702",
   "file": "D0304.txt",
   "line": 702,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あっ……何かヤバイ。",
   "ko_candidate": "앗……이건 위험해｡"
  },
  {
   "id": 3098,
   "key": "D0304.txt:710",
   "file": "D0304.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悪寒に身体が何とか追いついた。",
   "ko_candidate": "불길한 예감에 몸이 겨우 따라붙었다｡"
  },
  {
   "id": 3099,
   "key": "D0304.txt:713",
   "file": "D0304.txt",
   "line": 713,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "一歩退く。胸をかするナイトゴーントの翼。",
   "ko_candidate": "한 걸음 물러선다｡ 가슴을 스치는 나이트건트의 날개｡"
  },
  {
   "id": 3100,
   "key": "D0304.txt:716",
   "file": "D0304.txt",
   "line": 716,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ボディスーツが裂かれ、胸元から一筋の血がつつーと流れた。",
   "ko_candidate": "찢어지는 바디슈트｡ 일직선으로 그어진 상처에서 한 줄기 피가 주르륵 흐른다｡"
  },
  {
   "id": 3101,
   "key": "D0304.txt:721",
   "file": "D0304.txt",
   "line": 721,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「なっ」",
   "ko_candidate": "「뭐」"
  },
  {
   "id": 3102,
   "key": "D0304.txt:728",
   "file": "D0304.txt",
   "line": 728,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "驚く暇もない。",
   "ko_candidate": "놀랄 틈도 없다｡"
  },
  {
   "id": 3103,
   "key": "D0304.txt:729",
   "file": "D0304.txt",
   "line": 729,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "既にナイトゴーントは正面を向いていた。",
   "ko_candidate": "이미 나이트건트는 정면을 향하고 있었다｡"
  },
  {
   "id": 3104,
   "key": "D0304.txt:731",
   "file": "D0304.txt",
   "line": 731,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "回転の勢いを乗せた拳が俺の胸に迫る。",
   "ko_candidate": "회전의 기세를 실은 주먹이 내 가슴을 친다｡ 순간의 무중력 상태｡ 그리고｡"
  },
  {
   "id": 3105,
   "key": "D0304.txt:749",
   "file": "D0304.txt",
   "line": 749,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「げぶぅぐごぉっ!?」 一瞬の無重力状態。",
   "ko_candidate": "「게부아아아아아아아아아아――――꾸꼬!?」"
  },
  {
   "id": 3106,
   "key": "D0304.txt:761",
   "file": "D0304.txt",
   "line": 761,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "窓ガラスを粉砕する感覚。",
   "ko_candidate": "창문 유리를 분쇄하는 감각｡"
  },
  {
   "id": 3107,
   "key": "D0304.txt:762",
   "file": "D0304.txt",
   "line": 762,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "浮遊感。",
   "ko_candidate": "부유감｡"
  },
  {
   "id": 3108,
   "key": "D0304.txt:773",
   "file": "D0304.txt",
   "line": 773,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地面に叩きつけられた衝撃が全身を駆け巡ると同時、俺は意識を手離した。",
   "ko_candidate": "추락감｡ 땅에 내동댕이쳐지는 충격이 온몸을 휘감음과 동시에､ 나는 의식을 놓았다｡"
  }
 ]
