 },
 "items": [
  {
   "id": 28939,
   "key": "D1209ru.txt:196",
   "file": "D1209ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その一言で、司令室はまた慌しげに動き始めた。",
   "ko_candidate": "그 한마디에 사령실은 다시 분주하게 움직이기 시작했다｡"
  },
  {
   "id": 28940,
   "key": "D1209ru.txt:197",
   "file": "D1209ru.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンはモニターで基地の被害状況を確認しながら、マコトに訊ねた。",
   "ko_candidate": "메타트론은 모니터로 기지의 피해 상황을 확인하면서 마코토에게 물었다｡"
  },
  {
   "id": 28941,
   "key": "D1209ru.txt:202",
   "file": "D1209ru.txt",
   "line": 202,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「援護に向かう。他に敵は？」",
   "ko_candidate": "「지원하러 가겠다｡ 다른 적은?」"
  },
  {
   "id": 28942,
   "key": "D1209ru.txt:206",
   "file": "D1209ru.txt",
   "line": 206,
   "speaker": "マコト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――はい。医療施設区画での戦闘が続いております」 「治療中の大十字様や瑠璃お嬢様も、巻き込まれている可能性が高いです。メタトロン様、どうかお嬢様達を……」",
   "ko_candidate": "「――네｡ 의료시설 구역 쪽에서 전투가 계속되고 있습니다｡ 치료 중인 다이쥬지 님이나 루리 아가씨도 휘말릴 가능성이 높습니다｡ 메타트론 님､ 부디 아가씨들을……」"
  },
  {
   "id": 28943,
   "key": "D1209ru.txt:214",
   "file": "D1209ru.txt",
   "line": 214,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「分かった」",
   "ko_candidate": "「알겠다」"
  },
  {
   "id": 28944,
   "key": "D1209ru.txt:217",
   "file": "D1209ru.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "皆まで言う必要は無かった。",
   "ko_candidate": "더 말할 필요는 없었다｡"
  },
  {
   "id": 28945,
   "key": "D1209ru.txt:224",
   "file": "D1209ru.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "展開された双翼から閃光を放ち、メタトロンの躰が宙を浮く。",
   "ko_candidate": "펼쳐진 양날개에서 섬광을 발하며 메타트론의 몸이 공중에 떠오른다｡"
  },
  {
   "id": 28946,
   "key": "D1209ru.txt:228",
   "file": "D1209ru.txt",
   "line": 228,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………！」",
   "ko_candidate": "「…………!」"
  },
  {
   "id": 28947,
   "key": "D1209ru.txt:232",
   "file": "D1209ru.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突風が吹いた。",
   "ko_candidate": "돌풍이 불었다｡"
  },
  {
   "id": 28948,
   "key": "D1209ru.txt:233",
   "file": "D1209ru.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風を裂く轟音を残して、メタトロンは司令室から飛び出した。",
   "ko_candidate": "바람을 가르는 굉음을 남기고 메타트론은 사령실에서 날아갔다｡"
  },
  {
   "id": 28949,
   "key": "D1209ru.txt:245",
   "file": "D1209ru.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地下線路を全速力で、メタトロンは飛翔する。",
   "ko_candidate": "지하 선로를 전속력으로 메타트론은 비행한다｡"
  },
  {
   "id": 28950,
   "key": "D1209ru.txt:247",
   "file": "D1209ru.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目指すは医療施設区画。",
   "ko_candidate": "목표는 의료시설 구역｡"
  },
  {
   "id": 28951,
   "key": "D1209ru.txt:249",
   "file": "D1209ru.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが線路の先。",
   "ko_candidate": "하지만 선로 저편｡"
  },
  {
   "id": 28952,
   "key": "D1209ru.txt:250",
   "file": "D1209ru.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地下通路の闇に融ける様に、黒い影が佇んでいた。",
   "ko_candidate": "지하 통로의 어둠에 녹아드는 듯 검은 그림자가 서 있었다｡"
  },
  {
   "id": 28953,
   "key": "D1209ru.txt:252",
   "file": "D1209ru.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影は拳を腰の横に据えて、メタトロンを待ち構えている。",
   "ko_candidate": "그림자는 주먹을 허리 옆에 대고 메타트론을 기다리고 있다｡"
  },
  {
   "id": 28954,
   "key": "D1209ru.txt:256",
   "file": "D1209ru.txt",
   "line": 256,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――！」",
   "ko_candidate": "「――――!」"
  },
  {
   "id": 28955,
   "key": "D1209ru.txt:261",
   "file": "D1209ru.txt",
   "line": 261,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その正体に気付いた時、メタトロンは迷わなかった。",
   "ko_candidate": "그 정체를 알아차렸을 때 메타트론은 망설이지 않았다｡"
  },
  {
   "id": 28956,
   "key": "D1209ru.txt:262",
   "file": "D1209ru.txt",
   "line": 262,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右腕のカノン砲を影に向ける。",
   "ko_candidate": "오른팔의 캐논포를 그림자를 향해 겨눈다｡"
  },
  {
   "id": 28957,
   "key": "D1209ru.txt:267",
   "file": "D1209ru.txt",
   "line": 267,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地下の闇を、砲撃の閃光が灼き尽くした。",
   "ko_candidate": "지하의 어둠을 포격의 섬광이 태워버렸다｡"
  },
  {
   "id": 28958,
   "key": "D1209ru.txt:268",
   "file": "D1209ru.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "影は迫り来る破壊の光を前にして、まったく怯む様子を見せなかった。",
   "ko_candidate": "그림자는 다가오는 파괴의 빛 앞에서 전혀 주저하는 기색을 보이지 않았다｡"
  },
  {
   "id": 28959,
   "key": "D1209ru.txt:269",
   "file": "D1209ru.txt",
   "line": 269,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ飛来するビームに構えた拳を突き出した。",
   "ko_candidate": "단지 날아오는 빔에 주먹을 내질렀다｡"
  },
  {
   "id": 28960,
   "key": "D1209ru.txt:278",
   "file": "D1209ru.txt",
   "line": 278,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「憤ッ！　破ッ！」",
   "ko_candidate": "「분노하라! 부숴라!」"
  },
  {
   "id": 28961,
   "key": "D1209ru.txt:281",
   "file": "D1209ru.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンの砲撃は、拳に撃たれて爆裂、光を散らされた。",
   "ko_candidate": "메타트론의 포격은 주먹에 맞아 폭발하고 빛을 흩뿌렸다｡"
  },
  {
   "id": 28962,
   "key": "D1209ru.txt:282",
   "file": "D1209ru.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "散りゆく光が、影を照らす。",
   "ko_candidate": "흩어지는 빛이 그림자를 비춘다｡"
  },
  {
   "id": 28963,
   "key": "D1209ru.txt:283",
   "file": "D1209ru.txt",
   "line": 283,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光に照らされても影は、なお黒かった。",
   "ko_candidate": "빛에 비춰져도 그림자는 여전히 검었다｡"
  },
  {
   "id": 28964,
   "key": "D1209ru.txt:284",
   "file": "D1209ru.txt",
   "line": 284,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒の装甲で武装した戦天使――サンダルフォン。",
   "ko_candidate": "검은 갑옷으로 무장한 전천사――산달폰｡"
  },
  {
   "id": 28965,
   "key": "D1209ru.txt:290",
   "file": "D1209ru.txt",
   "line": 290,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「メタトロン！　餓アアアアアァァァァァ――！」",
   "ko_candidate": "「메타트론! 굶주렸다아아아아아아아아아――!」"
  },
  {
   "id": 28966,
   "key": "D1209ru.txt:294",
   "file": "D1209ru.txt",
   "line": 294,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「サンダルフォン！」",
   "ko_candidate": "「산달폰!」"
  },
  {
   "id": 28967,
   "key": "D1209ru.txt:298",
   "file": "D1209ru.txt",
   "line": 298,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンが双翼を展開して、爆発的な速度で突撃する！",
   "ko_candidate": "산달폰이 양날개를 펼치고 폭발적인 속도로 돌격한다!"
  },
  {
   "id": 28968,
   "key": "D1209ru.txt:299",
   "file": "D1209ru.txt",
   "line": 299,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンも速度を落とさない。",
   "ko_candidate": "메타트론도 속도를 늦추지 않는다｡"
  },
  {
   "id": 28969,
   "key": "D1209ru.txt:300",
   "file": "D1209ru.txt",
   "line": 300,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "抜き放つ光刃が闇に軌跡を刻みつけ、奔る。",
   "ko_candidate": "뽑아든 빛의 칼날이 어둠에 궤적을 새기며 달린다｡"
  },
  {
   "id": 28970,
   "key": "D1209ru.txt:304",
   "file": "D1209ru.txt",
   "line": 304,
   "speaker": "メタトロン＆サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「うおおおおぉぉぉぉぉぉぉぉぉ――――！」",
   "ko_candidate": "「우오오오오오오오오오오오오――――!」"
  },
  {
   "id": 28971,
   "key": "D1209ru.txt:307",
   "file": "D1209ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "超高速で飛翔する２人の天使。",
   "ko_candidate": "초고속으로 비행하는 2명의 천사｡"
  },
  {
   "id": 28972,
   "key": "D1209ru.txt:308",
   "file": "D1209ru.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "接触までゼロコンマ一秒。",
   "ko_candidate": "접촉까지 제로 콤마 일 초｡"
  },
  {
   "id": 28973,
   "key": "D1209ru.txt:315",
   "file": "D1209ru.txt",
   "line": 315,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 28974,
   "key": "D1209ru.txt:319",
   "file": "D1209ru.txt",
   "line": 319,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――！」",
   "ko_candidate": "「――――――!」"
  },
  {
   "id": 28975,
   "key": "D1209ru.txt:327",
   "file": "D1209ru.txt",
   "line": 327,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の刃が迸った。",
   "ko_candidate": "빛의 칼날이 튀어올랐다｡"
  },
  {
   "id": 28976,
   "key": "D1209ru.txt:328",
   "file": "D1209ru.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇の拳が爆ぜた。",
   "ko_candidate": "어둠의 주먹이 터졌다｡"
  },
  {
   "id": 28977,
   "key": "D1209ru.txt:331",
   "file": "D1209ru.txt",
   "line": 331,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃が世界を激震させる。",
   "ko_candidate": "충격이 세계를 격진시킨다｡"
  }
 ]
}