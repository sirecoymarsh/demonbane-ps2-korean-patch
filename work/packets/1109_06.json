 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "破壊ロボ": "파괴 로봇",
  "瑠璃": "루리",
  "術式": "술식",
  "お嬢様": "아가씨"
 },
 "items": [
  {
   "id": 25512,
   "key": "D1109ru.txt:678",
   "file": "D1109ru.txt",
   "line": 678,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔は三日月の軌跡を描き、デモンベインの右掌へと伸びる。",
   "ko_candidate": "불꽃은 초승달의 궤적을 그리며 데몬베인의 오른손바닥으로 뻗어간다｡"
  },
  {
   "id": 25513,
   "key": "D1109ru.txt:681",
   "file": "D1109ru.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインは焔を掴んだ。",
   "ko_candidate": "데몬베인은 불꽃을 움켜쥐었다｡"
  },
  {
   "id": 25514,
   "key": "D1109ru.txt:687",
   "file": "D1109ru.txt",
   "line": 687,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔が重量を、厚みを、実体を獲得する。",
   "ko_candidate": "불꽃이 무게를､ 두께를､ 실체를 얻는다｡"
  },
  {
   "id": 25515,
   "key": "D1109ru.txt:689",
   "file": "D1109ru.txt",
   "line": 689,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何重にも刃を束ねた、巨大な三日月の刃が顕現した。",
   "ko_candidate": "여러 겹으로 칼날을 묶은 거대한 초승달 모양의 칼날이 나타났다｡"
  },
  {
   "id": 25516,
   "key": "D1109ru.txt:691",
   "file": "D1109ru.txt",
   "line": 691,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだ焔えるバルザイの偃月刀を、握り締める鋼鉄の掌。",
   "ko_candidate": "아직 타오르는 바르자이의 언월도를 움켜쥐는 강철의 손바닥｡"
  },
  {
   "id": 25517,
   "key": "D1109ru.txt:693",
   "file": "D1109ru.txt",
   "line": 693,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "剣を振るう。",
   "ko_candidate": "검을 휘두른다｡"
  },
  {
   "id": 25518,
   "key": "D1109ru.txt:700",
   "file": "D1109ru.txt",
   "line": 700,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夜を裂いて、刃が疾った。",
   "ko_candidate": "밤을 가르며 칼날이 질주했다｡"
  },
  {
   "id": 25519,
   "key": "D1109ru.txt:701",
   "file": "D1109ru.txt",
   "line": 701,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刀身に纏われた焔が、爆ぜて散る。",
   "ko_candidate": "도신을 감싼 불꽃이 터져 흩어진다｡"
  },
  {
   "id": 25520,
   "key": "D1109ru.txt:706",
   "file": "D1109ru.txt",
   "line": 706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そこに突撃してくる破壊ロボたちの群れ。",
   "ko_candidate": "그곳으로 돌격해오는 파괴 로봇들의 무리｡"
  },
  {
   "id": 25521,
   "key": "D1109ru.txt:710",
   "file": "D1109ru.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "滑空しながら、バルカンが火を噴く。",
   "ko_candidate": "활공하면서 발칸포가 불을 뿜는다｡"
  },
  {
   "id": 25522,
   "key": "D1109ru.txt:711",
   "file": "D1109ru.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃弾の雨が降り注ぐ。",
   "ko_candidate": "총알비가 쏟아진다｡"
  },
  {
   "id": 25523,
   "key": "D1109ru.txt:724",
   "file": "D1109ru.txt",
   "line": 724,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えっ……？　あああああ！」",
   "ko_candidate": "「엣……? 아아아아아!」"
  },
  {
   "id": 25524,
   "key": "D1109ru.txt:728",
   "file": "D1109ru.txt",
   "line": 728,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "招喚によるショックから立ち直る間もなく、瑠璃の腕は脳内を駆ける術式に従って反射的に……独りでに動いた。",
   "ko_candidate": "소환으로 인한 충격에서 정신을 차릴 틈도 없이､ 루리의 팔은 뇌내를 달리는 술식에 따라 반사적으로…… 저절로 움직였다｡"
  },
  {
   "id": 25525,
   "key": "D1109ru.txt:730",
   "file": "D1109ru.txt",
   "line": 730,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もはやデモンベインを操るのではなく、デモンベインに操られていた。",
   "ko_candidate": "이제 데몬베인을 조종하는 것이 아니라､ 데몬베인에 조종당하고 있었다｡"
  },
  {
   "id": 25526,
   "key": "D1109ru.txt:737",
   "file": "D1109ru.txt",
   "line": 737,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインはバルザイの偃月刀を扇状に展開。",
   "ko_candidate": "데몬베인은 바르자이의 언월도를 부채꼴로 펼쳤다｡"
  },
  {
   "id": 25527,
   "key": "D1109ru.txt:744",
   "file": "D1109ru.txt",
   "line": 744,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "扇型の偃月刀を猛スピードで、舞う様に振るい、降り注ぐ数千、数万発の銃弾の悉くを弾いた。",
   "ko_candidate": "부채꼴의 언월도를 맹렬한 속도로､ 춤추듯 휘둘러 쏟아지는 수천､ 수만 발의 총알을 모조리 튕겨냈다｡"
  },
  {
   "id": 25528,
   "key": "D1109ru.txt:752",
   "file": "D1109ru.txt",
   "line": 752,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舞いは止まらず、その場で大きく一回転、その勢いに乗せて、偃月刀を投擲する。",
   "ko_candidate": "춤은 멈추지 않고､ 그 자리에서 크게 한 바퀴 돌며､ 그 기세를 타고 언월도를 던진다｡"
  },
  {
   "id": 25529,
   "key": "D1109ru.txt:754",
   "file": "D1109ru.txt",
   "line": 754,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "高速回転し、ブーメランに似た軌跡を描いて、偃月刀は飛翔する。",
   "ko_candidate": "고속 회전하며 부메랑과 비슷한 궤적을 그리며 언월도가 날아간다｡"
  },
  {
   "id": 25530,
   "key": "D1109ru.txt:756",
   "file": "D1109ru.txt",
   "line": 756,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "軌跡上に存在する破壊ロボは両断され、無数の爆発が夜空に華を咲かせた。",
   "ko_candidate": "궤적상에 있는 파괴 로봇은 양단되어 무수한 폭발이 밤하늘에 꽃을 피웠다｡"
  },
  {
   "id": 25531,
   "key": "D1109ru.txt:758",
   "file": "D1109ru.txt",
   "line": 758,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弧を描き返って来る偃月刀をデモンベインはしっかりと掴まえ――",
   "ko_candidate": "호를 그리며 돌아오는 언월도를 데몬베인은 확실히 잡아――"
  },
  {
   "id": 25532,
   "key": "D1109ru.txt:765",
   "file": "D1109ru.txt",
   "line": 765,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「うあああぁぁ……んんっ！」",
   "ko_candidate": "「으아아아아……응읏!」"
  },
  {
   "id": 25533,
   "key": "D1109ru.txt:773",
   "file": "D1109ru.txt",
   "line": 773,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぐぅぅっ!?」",
   "ko_candidate": "「크으읏!?」"
  },
  {
   "id": 25534,
   "key": "D1109ru.txt:778",
   "file": "D1109ru.txt",
   "line": 778,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "掴まえ損ねた。",
   "ko_candidate": "잡지 못했다｡"
  },
  {
   "id": 25535,
   "key": "D1109ru.txt:779",
   "file": "D1109ru.txt",
   "line": 779,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "偃月刀はデモンベインから離れた、 遠くの地面に突き刺さる。",
   "ko_candidate": "언월도는 데몬베인에서 멀어져 먼 곳의 지면에 꽂혔다｡"
  },
  {
   "id": 25536,
   "key": "D1109ru.txt:788",
   "file": "D1109ru.txt",
   "line": 788,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何をやっている！」",
   "ko_candidate": "「뭘 하는 거냐!」"
  },
  {
   "id": 25537,
   "key": "D1109ru.txt:793",
   "file": "D1109ru.txt",
   "line": 793,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「う……すみませ……っ」",
   "ko_candidate": "「으……죄송합니……읏」"
  },
  {
   "id": 25538,
   "key": "D1109ru.txt:800",
   "file": "D1109ru.txt",
   "line": 800,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「チッ……次が来る！　集中しろ！」",
   "ko_candidate": "「치……다음 놈이 온다! 집중해라!」"
  },
  {
   "id": 25539,
   "key": "D1109ru.txt:803",
   "file": "D1109ru.txt",
   "line": 803,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突撃してくる破壊ロボを間一髪、飛び退いてかわす。",
   "ko_candidate": "돌격해오는 파괴 로봇을 간발의 차로 뛰어올라 피한다｡"
  },
  {
   "id": 25540,
   "key": "D1109ru.txt:805",
   "file": "D1109ru.txt",
   "line": 805,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それを狙っていたかのように、 着地地点で破壊ビームが爆発する。",
   "ko_candidate": "마치 그것을 노리고 있었다는 듯이､ 착지 지점에서 파괴 빔이 폭발한다｡"
  },
  {
   "id": 25541,
   "key": "D1109ru.txt:817",
   "file": "D1109ru.txt",
   "line": 817,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「きゃあああああ！」",
   "ko_candidate": "「꺄아아아아아!」"
  },
  {
   "id": 25542,
   "key": "D1109ru.txt:822",
   "file": "D1109ru.txt",
   "line": 822,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……小賢しい真似を！」",
   "ko_candidate": "「크……영악한 짓을!」"
  },
  {
   "id": 25543,
   "key": "D1109ru.txt:826",
   "file": "D1109ru.txt",
   "line": 826,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足を止めたデモンベインに向けて一斉に破壊ビームが発射される。",
   "ko_candidate": "멈춰 선 데몬베인을 향해 일제히 파괴 빔이 발사된다｡"
  },
  {
   "id": 25544,
   "key": "D1109ru.txt:836",
   "file": "D1109ru.txt",
   "line": 836,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の連続。",
   "ko_candidate": "폭발의 연속｡"
  },
  {
   "id": 25545,
   "key": "D1109ru.txt:837",
   "file": "D1109ru.txt",
   "line": 837,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの姿はあっという間に、爆炎に包まれた。",
   "ko_candidate": "데몬베인의 모습은 순식간에 폭염에 휩싸였다｡"
  },
  {
   "id": 25546,
   "key": "D1109ru.txt:842",
   "file": "D1109ru.txt",
   "line": 842,
   "speaker": "ソーニャ（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いやぁぁぁぁぁっ！ お嬢様ぁぁぁぁぁっ!?」",
   "ko_candidate": "「으아아아아아앗! 아가씨이이이이잇!?」"
  },
  {
   "id": 25547,
   "key": "D1109ru.txt:849",
   "file": "D1109ru.txt",
   "line": 849,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "直接に止めを刺すべく、爆炎に飛び込む破壊ロボ。",
   "ko_candidate": "직접 마무리를 지으려 폭염 속으로 뛰어드는 파괴 로봇｡"
  },
  {
   "id": 25548,
   "key": "D1109ru.txt:853",
   "file": "D1109ru.txt",
   "line": 853,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが爆炎を裂いて、鋼鉄の腕が伸びた。",
   "ko_candidate": "하지만 폭염을 가르고 강철의 팔이 뻗어나왔다｡"
  },
  {
   "id": 25549,
   "key": "D1109ru.txt:860",
   "file": "D1109ru.txt",
   "line": 860,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鉄拳が破壊ロボを粉砕する。再び爆発。",
   "ko_candidate": "철권이 파괴 로봇을 분쇄한다｡ 다시 폭발｡"
  },
  {
   "id": 25550,
   "key": "D1109ru.txt:864",
   "file": "D1109ru.txt",
   "line": 864,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "うねる爆炎の中から、鋼鉄の巨体が飛び出した。",
   "ko_candidate": "요동치는 폭염 속에서 강철의 거체가 튀어나왔다｡"
  },
  {
   "id": 25551,
   "key": "D1109ru.txt:865",
   "file": "D1109ru.txt",
   "line": 865,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "炎を纏わせながら、跳躍するデモンベイン。",
   "ko_candidate": "불꽃을 두르며 도약하는 데몬베인｡"
  }
 ]
}