 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "デモンベイン": "데몬베인",
  "リベル・レギス": "리베르 레기스",
  "ティマイオス": "티마이오스",
  "術式": "술식",
  "クリティアス": "크리티아스"
 },
 "items": [
  {
   "id": 45407,
   "key": "D1508ru.txt:524",
   "file": "D1508ru.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――怖れるものは端から無い。 余は独り。無限の牢獄に独り。",
   "ko_candidate": "――두려워할 것은 애초부터 없다｡ 나는 홀로｡ 무한의 감옥에 홀로｡"
  },
  {
   "id": 45408,
   "key": "D1508ru.txt:527",
   "file": "D1508ru.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖の只中に在って、余は恐怖そのものとなる。",
   "ko_candidate": "공포의 한가운데에 있어､ 나는 공포 그 자체가 된다｡"
  },
  {
   "id": 45409,
   "key": "D1508ru.txt:541",
   "file": "D1508ru.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――あの暖かい世界を護る為に。",
   "ko_candidate": "――저 따뜻한 세계를 지키기 위해｡"
  },
  {
   "id": 45410,
   "key": "D1508ru.txt:552",
   "file": "D1508ru.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――あのおぞましき世界を呪う為に。",
   "ko_candidate": "――저 끔찍한 세계를 저주하기 위해｡"
  },
  {
   "id": 45411,
   "key": "D1508ru.txt:593",
   "file": "D1508ru.txt",
   "line": 593,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『運命に導かれ 我等は此処に対峙する』",
   "ko_candidate": "운명에 이끌려 우리는 여기서 대치한다｡ 붉은 기신｡"
  },
  {
   "id": 45412,
   "key": "D1508ru.txt:604",
   "file": "D1508ru.txt",
   "line": 604,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "紅の機神。 翼を折り畳んだ、紅の蝙蝠。",
   "ko_candidate": "날개를 접은､ 붉은 박쥐｡"
  },
  {
   "id": 45413,
   "key": "D1508ru.txt:606",
   "file": "D1508ru.txt",
   "line": 606,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "外套で身を包んだ、紅の幽鬼。",
   "ko_candidate": "외투로 몸을 감싼､ 붉은 유령｡"
  },
  {
   "id": 45414,
   "key": "D1508ru.txt:608",
   "file": "D1508ru.txt",
   "line": 608,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この巨大な階段の最上段。",
   "ko_candidate": "이 거대한 계단의 최상단｡"
  },
  {
   "id": 45415,
   "key": "D1508ru.txt:609",
   "file": "D1508ru.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "玉座に鎮座し、デモンベインを見下ろす紅の帝王。",
   "ko_candidate": "옥좌에 앉아､ 데몬베인을 내려다보는 붉은 제왕｡"
  },
  {
   "id": 45416,
   "key": "D1508ru.txt:618",
   "file": "D1508ru.txt",
   "line": 618,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待ち草臥れたぞ、デモンベイン」",
   "ko_candidate": "「기다리다 지쳤다､ 데몬베인」"
  },
  {
   "id": 45417,
   "key": "D1508ru.txt:621",
   "file": "D1508ru.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聲が響く。",
   "ko_candidate": "목소리가 울린다｡"
  },
  {
   "id": 45418,
   "key": "D1508ru.txt:622",
   "file": "D1508ru.txt",
   "line": 622,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "木霊する時を刻む音、その音の洪水を貫いて",
   "ko_candidate": "메아리치는 시간을 새기는 소리､ 그 소리의 홍수를 뚫고"
  },
  {
   "id": 45419,
   "key": "D1508ru.txt:623",
   "file": "D1508ru.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの美しい聲が。",
   "ko_candidate": "저 아름다운 목소리가｡"
  },
  {
   "id": 45420,
   "key": "D1508ru.txt:624",
   "file": "D1508ru.txt",
   "line": 624,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの忌まわしい聲が。",
   "ko_candidate": "저 불길한 목소리가｡"
  },
  {
   "id": 45421,
   "key": "D1508ru.txt:628",
   "file": "D1508ru.txt",
   "line": 628,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足を止めた。",
   "ko_candidate": "발을 멈췄다｡"
  },
  {
   "id": 45422,
   "key": "D1508ru.txt:629",
   "file": "D1508ru.txt",
   "line": 629,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "延々と連なる階段、深淵に呑み込まれる階段を背後に、デモンベインは紅の機神を、機械仕掛けの眸で真っ直ぐに見上げる。",
   "ko_candidate": "끝없이 이어지는 계단､ 심연에 삼켜지는 계단을 뒤로하고､ 데몬베인은 붉은 기신을､ 기계 장치의 눈동자로 똑바로 올려다본다｡"
  },
  {
   "id": 45423,
   "key": "D1508ru.txt:634",
   "file": "D1508ru.txt",
   "line": 634,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「よう、お待ちかねだな。獣」",
   "ko_candidate": "「어이､ 기다리고 있었지｡ 짐승」"
  },
  {
   "id": 45424,
   "key": "D1508ru.txt:640",
   "file": "D1508ru.txt",
   "line": 640,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスが玉座から立ち上がる。",
   "ko_candidate": "리베르 레기스가 옥좌에서 일어선다｡"
  },
  {
   "id": 45425,
   "key": "D1508ru.txt:641",
   "file": "D1508ru.txt",
   "line": 641,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "歌うが如く、謳うが如く、受け入れるが如く、抱きとめるが如く、終末を告げる預言者の如く、両手を広げる。",
   "ko_candidate": "노래하듯이､ 읊조리듯이､ 받아들이듯이､ 끌어안듯이､ 종말을 고하는 예언자처럼､ 두 팔을 벌린다｡"
  },
  {
   "id": 45426,
   "key": "D1508ru.txt:645",
   "file": "D1508ru.txt",
   "line": 645,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「では、始めようか。終わりの始まりを。始まりの終わりを。永劫の終焉を。永劫の開演を――」",
   "ko_candidate": "「자､ 시작하자｡ 끝의 시작을｡ 시작의 끝을｡ 영겁의 종언을｡ 영겁의 개막을――」"
  },
  {
   "id": 45427,
   "key": "D1508ru.txt:660",
   "file": "D1508ru.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身を覆う紅の翼が、ゆっくりと啓かれた。",
   "ko_candidate": "온몸을 덮은 붉은 날개가､ 천천히 펼쳐졌다｡"
  },
  {
   "id": 45428,
   "key": "D1508ru.txt:661",
   "file": "D1508ru.txt",
   "line": 661,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の目の前で初めて、リベル・レギスがその真の姿を現す。",
   "ko_candidate": "내 눈앞에서 처음으로､ 리베르 레기스가 그 진정한 모습을 드러낸다｡"
  },
  {
   "id": 45429,
   "key": "D1508ru.txt:670",
   "file": "D1508ru.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の天使。",
   "ko_candidate": "붉은 천사｡"
  },
  {
   "id": 45430,
   "key": "D1508ru.txt:671",
   "file": "D1508ru.txt",
   "line": 671,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅の悪魔。",
   "ko_candidate": "붉은 악마｡"
  },
  {
   "id": 45431,
   "key": "D1508ru.txt:672",
   "file": "D1508ru.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "紅翼の下から現れた貌。機械仕掛けの眸がデモンベインを射抜く。",
   "ko_candidate": "붉은 날개 아래에서 나타난 얼굴｡ 기계 장치의 눈동자가 데몬베인을 꿰뚫는다｡"
  },
  {
   "id": 45432,
   "key": "D1508ru.txt:676",
   "file": "D1508ru.txt",
   "line": 676,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「クライマックスだ」",
   "ko_candidate": "「클라이맥스다」"
  },
  {
   "id": 45433,
   "key": "D1508ru.txt:680",
   "file": "D1508ru.txt",
   "line": 680,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスの右手に光。",
   "ko_candidate": "리베르 레기스의 오른손에 빛｡"
  },
  {
   "id": 45434,
   "key": "D1508ru.txt:681",
   "file": "D1508ru.txt",
   "line": 681,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の光。",
   "ko_candidate": "황금빛 빛｡"
  },
  {
   "id": 45435,
   "key": "D1508ru.txt:684",
   "file": "D1508ru.txt",
   "line": 684,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の粒子が収束し、収縮し、結晶する。",
   "ko_candidate": "빛의 입자가 수렴하고､ 수축하고､ 결정화된다｡"
  },
  {
   "id": 45436,
   "key": "D1508ru.txt:692",
   "file": "D1508ru.txt",
   "line": 692,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の宝剣が握られていた。",
   "ko_candidate": "황금빛 보검이 쥐어져 있었다｡"
  },
  {
   "id": 45437,
   "key": "D1508ru.txt:702",
   "file": "D1508ru.txt",
   "line": 702,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――力を与えよ。力を与えよ。力を与えよ」",
   "ko_candidate": "「――힘을 주어라｡ 힘을 주어라｡ 힘을 주어라」"
  },
  {
   "id": 45438,
   "key": "D1508ru.txt:712",
   "file": "D1508ru.txt",
   "line": 712,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの右掌に焔。",
   "ko_candidate": "데몬베인의 오른손바닥에 불꽃｡"
  },
  {
   "id": 45439,
   "key": "D1508ru.txt:713",
   "file": "D1508ru.txt",
   "line": 713,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焔は直線を描き、閃光を発し、結晶する。",
   "ko_candidate": "불꽃은 직선을 그리고､ 섬광을 발하고､ 결정화된다｡"
  },
  {
   "id": 45440,
   "key": "D1508ru.txt:714",
   "file": "D1508ru.txt",
   "line": 714,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "バルザイの偃月刀を、その掌に執る。",
   "ko_candidate": "바르자이의 언월도를､ 그 손바닥에 쥔다｡"
  },
  {
   "id": 45441,
   "key": "D1508ru.txt:718",
   "file": "D1508ru.txt",
   "line": 718,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「征くぜ」",
   "ko_candidate": "「가자」"
  },
  {
   "id": 45442,
   "key": "D1508ru.txt:727",
   "file": "D1508ru.txt",
   "line": 727,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「参れ」",
   "ko_candidate": "「오너라」"
  },
  {
   "id": 45443,
   "key": "D1508ru.txt:733",
   "file": "D1508ru.txt",
   "line": 733,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――断鎖術式壱号ティマイオス。",
   "ko_candidate": "――단쇄술식 1호 티마이오스｡"
  },
  {
   "id": 45444,
   "key": "D1508ru.txt:734",
   "file": "D1508ru.txt",
   "line": 734,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――断鎖術式弐号クリティアス。",
   "ko_candidate": "――단쇄술식 2호 크리티오스｡"
  },
  {
   "id": 45445,
   "key": "D1508ru.txt:735",
   "file": "D1508ru.txt",
   "line": 735,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――全術式開放。",
   "ko_candidate": "――전 술식 개방｡"
  },
  {
   "id": 45446,
   "key": "D1508ru.txt:736",
   "file": "D1508ru.txt",
   "line": 736,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――時空間歪曲。",
   "ko_candidate": "――시공간 왜곡｡"
  }
 ]
}