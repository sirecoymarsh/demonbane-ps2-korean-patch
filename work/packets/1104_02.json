 "items": [
  {
   "id": 23263,
   "key": "D1104al.txt:320",
   "file": "D1104al.txt",
   "line": 320,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてナビゲート席には――",
   "ko_candidate": "그리고 내비게이트 좌석에는――"
  },
  {
   "id": 23264,
   "key": "D1104al.txt:326",
   "file": "D1104al.txt",
   "line": 326,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「エルザ!?」",
   "ko_candidate": "「엘자!?」"
  },
  {
   "id": 23265,
   "key": "D1104al.txt:328",
   "file": "D1104al.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エルザが、これまたナビゲート席の周囲に設置された機械類とコードで繋げられていた。",
   "ko_candidate": "엘자가 이번에는 내비게이트 좌석 주위에 설치된 기계류와 코드로 연결되어 있었다｡"
  },
  {
   "id": 23266,
   "key": "D1104al.txt:329",
   "file": "D1104al.txt",
   "line": 329,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この風景、どこかで見覚えがある。確か――",
   "ko_candidate": "이 광경､ 어디서 본 적이 있다｡ 맞아――"
  },
  {
   "id": 23267,
   "key": "D1104al.txt:332",
   "file": "D1104al.txt",
   "line": 332,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――っ！　あのバッタモンのときの！」",
   "ko_candidate": "「――! 그 짝퉁 때의!」"
  },
  {
   "id": 23268,
   "key": "D1104al.txt:336",
   "file": "D1104al.txt",
   "line": 336,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そのとーりである！　スーパーウェスト無敵ロボ２８號ＤＸ――通称デモンペインのときの理論をそのまま応用させてもらったのである」 「『アル・アジフ』の本体である魔導書はまだ残っているのであるな？」",
   "ko_candidate": "「그렇다네! 슈퍼 웨스트 무적 로봇 28호 DX――통칭 데몬페인 때의 이론을 그대로 응용한 거지｡ 『알 아지프』의 본체인 마도서는 아직 남아있지?」"
  },
  {
   "id": 23269,
   "key": "D1104al.txt:343",
   "file": "D1104al.txt",
   "line": 343,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「あ、ああ……」",
   "ko_candidate": "「아､ 응……」"
  },
  {
   "id": 23270,
   "key": "D1104al.txt:348",
   "file": "D1104al.txt",
   "line": 348,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は脇に抱えていた魔導書を前に出した。",
   "ko_candidate": "나는 옆구리에 끼고 있던 마도서를 앞으로 내밀었다｡"
  },
  {
   "id": 23271,
   "key": "D1104al.txt:349",
   "file": "D1104al.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それを見て、ドクター・ウェストは 満足したように頷く。",
   "ko_candidate": "그것을 보고､ 닥터 웨스트는 만족한 듯이 고개를 끄덕였다｡"
  },
  {
   "id": 23272,
   "key": "D1104al.txt:354",
   "file": "D1104al.txt",
   "line": 354,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「デモンペインのときはページの断片を利用したであるが、今度は『アル・アジフ』の書そのものを利用する」 「書の情報はエルザを通して、デモンベインに伝達される」",
   "ko_candidate": "「데몬페인 때는 페이지의 단편을 이용했지만､ 이번에는 『알 아지프』의 책 그 자체를 이용한다｡ 책의 정보는 엘자를 통해 데몬베인에 전달된다｡ 이렇게 하면 데몬베인을 기동할 수 있을 것이다!」"
  },
  {
   "id": 23273,
   "key": "D1104al.txt:360",
   "file": "D1104al.txt",
   "line": 360,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「これならばデモンベインを起動することが出来るであろう！」 ……まさか、こんな意外な形で逆襲のチャンスが巡ってくるなんて。",
   "ko_candidate": "……설마､ 이런 뜻밖의 형태로 반격의 기회가 올 줄이야｡"
  },
  {
   "id": 23274,
   "key": "D1104al.txt:367",
   "file": "D1104al.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "なんて奇跡的な巡り合わせなんだ。",
   "ko_candidate": "정말 기적 같은 우연이군｡"
  },
  {
   "id": 23275,
   "key": "D1104al.txt:373",
   "file": "D1104al.txt",
   "line": 373,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ドクター・ウェストが不敵な笑みを浮かべて、 訊いてきた。",
   "ko_candidate": "닥터 웨스트가 뻔뻔한 미소를 지으며 물어왔다｡"
  },
  {
   "id": 23276,
   "key": "D1104al.txt:378",
   "file": "D1104al.txt",
   "line": 378,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「さあ、後は貴様次第であるぞ、大十字九郎」",
   "ko_candidate": "「자､ 이제 나머지는 네 차례다､ 다이쥬지 쿠로」"
  },
  {
   "id": 23277,
   "key": "D1104al.txt:381",
   "file": "D1104al.txt",
   "line": 381,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "………………。",
   "ko_candidate": "………………。"
  },
  {
   "id": 23278,
   "key": "D1104al.txt:382",
   "file": "D1104al.txt",
   "line": 382,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は手に持った魔導書を胸に抱いた。",
   "ko_candidate": "나는 손에 든 마도서를 가슴에 안았다｡"
  },
  {
   "id": 23279,
   "key": "D1104al.txt:383",
   "file": "D1104al.txt",
   "line": 383,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アル……またもう一度、お前と一緒に戦うことが出来るんだな。",
   "ko_candidate": "알…… 또 다시 한 번､ 너와 함께 싸울 수 있게 되는구나｡"
  },
  {
   "id": 23280,
   "key": "D1104al.txt:385",
   "file": "D1104al.txt",
   "line": 385,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "返事など考えるまでもなかった。",
   "ko_candidate": "대답 따위 고민할 필요도 없었다｡"
  },
  {
   "id": 23281,
   "key": "D1104al.txt:386",
   "file": "D1104al.txt",
   "line": 386,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は黙って腕を突き出す。",
   "ko_candidate": "나는 말없이 팔을 내밀었다｡"
  },
  {
   "id": 23282,
   "key": "D1104al.txt:395",
   "file": "D1104al.txt",
   "line": 395,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ドクター・ウェストは頷いて、 自分の腕をクロスさせた。",
   "ko_candidate": "닥터 웨스트는 고개를 끄덕이며 자신의 팔을 교차시켰다｡"
  },
  {
   "id": 23283,
   "key": "D1104al.txt:399",
   "file": "D1104al.txt",
   "line": 399,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――反撃開始だ！",
   "ko_candidate": "――반격 개시다!"
  },
  {
   "id": 23284,
   "key": "D1104le.txt:13",
   "file": "D1104le.txt",
   "line": 13,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 23285,
   "key": "D1104le.txt:17",
   "file": "D1104le.txt",
   "line": 17,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 23286,
   "key": "D1104le.txt:19",
   "file": "D1104le.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リューガが去ってから、だいぶ経つ。",
   "ko_candidate": "류가가 떠난 지 꽤 시간이 지났다｡"
  },
  {
   "id": 23287,
   "key": "D1104le.txt:20",
   "file": "D1104le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "だけど俺もライカさんも、 あれからまったく動いていない。",
   "ko_candidate": "하지만 나도 라이카 씨도 그 이후로 전혀 움직이지 않았다｡"
  },
  {
   "id": 23288,
   "key": "D1104le.txt:23",
   "file": "D1104le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "固まっていた。凍りついていた。呪縛されていた。",
   "ko_candidate": "굳어 있었다｡ 얼어붙어 있었다｡ 주박되어 있었다｡"
  },
  {
   "id": 23289,
   "key": "D1104le.txt:24",
   "file": "D1104le.txt",
   "line": 24,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "沈黙の重さに。",
   "ko_candidate": "침묵의 무게에｡"
  },
  {
   "id": 23290,
   "key": "D1104le.txt:25",
   "file": "D1104le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "過去の冷たさに。",
   "ko_candidate": "과거의 차가움에｡"
  },
  {
   "id": 23291,
   "key": "D1104le.txt:26",
   "file": "D1104le.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人を隔てる距離に。",
   "ko_candidate": "둘을 가로막는 거리에｡"
  },
  {
   "id": 23292,
   "key": "D1104le.txt:28",
   "file": "D1104le.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……このままじゃいけない。",
   "ko_candidate": "……이대로는 안 된다｡"
  },
  {
   "id": 23293,
   "key": "D1104le.txt:29",
   "file": "D1104le.txt",
   "line": 29,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ここまで知ってしまった以上、 無視することなんて出来ない。",
   "ko_candidate": "여기까지 알게 된 이상､ 무시할 수는 없다｡"
  },
  {
   "id": 23294,
   "key": "D1104le.txt:32",
   "file": "D1104le.txt",
   "line": 32,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見なかったことにして、聞かなかったことにして、ライカさんをこんな呪縛の中に置き去りにはしておけない。",
   "ko_candidate": "보지 않은 척하고､ 듣지 않은 척하고､ 라이카 씨를 이런 주박 속에 내버려 둘 수는 없다｡"
  },
  {
   "id": 23295,
   "key": "D1104le.txt:34",
   "file": "D1104le.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "たとえライカさんがそれを望んでなかったとしても……俺は後味悪いのを、わだかまらせてはいられないのだ。",
   "ko_candidate": "설령 라이카 씨가 그걸 원하지 않았다 해도……나는 찜찜한 기분을､ 응어리진 채로 있을 수 없다｡"
  },
  {
   "id": 23296,
   "key": "D1104le.txt:36",
   "file": "D1104le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "決意して、声をかけようとしたその時だった。",
   "ko_candidate": "결심하고 말을 걸려고 한 그때였다｡"
  },
  {
   "id": 23297,
   "key": "D1104le.txt:41",
   "file": "D1104le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンを包む白い鎧が光に溶ける。",
   "ko_candidate": "메타트론을 감싼 하얀 갑옷이 빛에 녹아든다｡"
  },
  {
   "id": 23298,
   "key": "D1104le.txt:42",
   "file": "D1104le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の粒子が散って、闇に薄れていく。",
   "ko_candidate": "빛의 입자가 흩어지며 어둠 속으로 희미해진다｡"
  },
  {
   "id": 23299,
   "key": "D1104le.txt:43",
   "file": "D1104le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "白の天使は、再びライカさんの姿に戻った。",
   "ko_candidate": "하얀 천사는 다시 라이카 씨의 모습으로 돌아왔다｡"
  },
  {
   "id": 23300,
   "key": "D1104le.txt:51",
   "file": "D1104le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんが振り返る。",
   "ko_candidate": "라이카 씨가 돌아본다｡"
  },
  {
   "id": 23301,
   "key": "D1104le.txt:52",
   "file": "D1104le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その瞳の彩に、俺の胸は締めつけられる。",
   "ko_candidate": "그 눈동자의 색채에 내 가슴이 조여든다｡"
  },
  {
   "id": 23302,
   "key": "D1104le.txt:53",
   "file": "D1104le.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがて、淡い色の唇が、ゆっくりと開かれた。",
   "ko_candidate": "이윽고 옅은 색의 입술이 천천히 열렸다｡"
  }
 ]
}