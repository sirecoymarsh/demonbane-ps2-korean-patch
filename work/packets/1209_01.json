 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "瑠璃": "루리",
  "九郎ちゃん": "쿠로 군",
  "アンチクロス": "안티크로스",
  "アル": "알",
  "ティベリウス": "티베리우스"
 },
 "items": [
  {
   "id": 28819,
   "key": "D1209al.txt:137",
   "file": "D1209al.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "やがて、哄笑へ。",
   "ko_candidate": "이윽고､ 폭소로｡"
  },
  {
   "id": 28820,
   "key": "D1209al.txt:141",
   "file": "D1209al.txt",
   "line": 141,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お――――――ほほほほほほほほほほほほほほほほほほほ！」 「……虫……蟲……妖蛆！」",
   "ko_candidate": "「오――――――호호호호호호호호호호호호호호호호호호호! ……벌레……벌레……요충!」"
  },
  {
   "id": 28821,
   "key": "D1209al.txt:148",
   "file": "D1209al.txt",
   "line": 148,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「こ、この声は……っ！」",
   "ko_candidate": "「이､ 이 목소리는……읏!」"
  },
  {
   "id": 28822,
   "key": "D1209al.txt:151",
   "file": "D1209al.txt",
   "line": 151,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の脳裏に恐怖の記憶が甦る。",
   "ko_candidate": "루리의 뇌리에 공포의 기억이 되살아난다｡"
  },
  {
   "id": 28823,
   "key": "D1209al.txt:152",
   "file": "D1209al.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、その瑠璃が悲鳴を上げるよりも早く――",
   "ko_candidate": "하지만､ 그 루리가 비명을 지르기도 전에――"
  },
  {
   "id": 28824,
   "key": "D1209al.txt:156",
   "file": "D1209al.txt",
   "line": 156,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ごめんねぇ……本当はじっくりと遊んであげたいんだけど、九郎ちゃんの相手もしなくちゃいけないのよぉん。だから、ちゃっちゃと済ませちゃうわよ？」",
   "ko_candidate": "「미안해……사실은 천천히 놀아주고 싶지만､ 쿠로 군의 상대도 해야 하거든｡ 그러니까､ 빨리 끝내버릴게?」"
  },
  {
   "id": 28825,
   "key": "D1209al.txt:160",
   "file": "D1209al.txt",
   "line": 160,
   "speaker": "マコト",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――アンチクロスの……ッ！」",
   "ko_candidate": "「――안티 크로스의……읏!」"
  },
  {
   "id": 28826,
   "key": "D1209al.txt:167",
   "file": "D1209al.txt",
   "line": 167,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "業――ッッ！",
   "ko_candidate": "업――읏!"
  },
  {
   "id": 28827,
   "key": "D1209al.txt:169",
   "file": "D1209al.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "司令室に『闇』が流れ込んできた。",
   "ko_candidate": "사령실에 『어둠』이 흘러들어왔다｡"
  },
  {
   "id": 28828,
   "key": "D1209al.txt:170",
   "file": "D1209al.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは荒れ狂う瘴気の波濤。",
   "ko_candidate": "그것은 거칠게 날뛰는 장기의 파도｡"
  },
  {
   "id": 28829,
   "key": "D1209al.txt:171",
   "file": "D1209al.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "司令室を呑み込んでゆく闇。",
   "ko_candidate": "사령실을 삼켜가는 어둠｡"
  },
  {
   "id": 28830,
   "key": "D1209al.txt:172",
   "file": "D1209al.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、その粘つく闇の中から姿を顕すのが――",
   "ko_candidate": "그리고､ 그 끈적이는 어둠 속에서 모습을 드러내는 것이――"
  },
  {
   "id": 28831,
   "key": "D1209al.txt:177",
   "file": "D1209al.txt",
   "line": 177,
   "speaker": "ティベリウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ベルゼビュートォォォォォォ！」",
   "ko_candidate": "「벨제뷰트어어어어어어어!」"
  },
  {
   "id": 28832,
   "key": "D1209al.txt:181",
   "file": "D1209al.txt",
   "line": 181,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「えっ？　えええ!?　……きゃあああああああああああああ!?」",
   "ko_candidate": "「엣? 에에에!? ……꺄아아아아아아아아아아아아!?」"
  },
  {
   "id": 28833,
   "key": "D1209al.txt:194",
   "file": "D1209al.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒と爆炎が、司令室を粉砕する――。",
   "ko_candidate": "암흑과 폭염이 사령실을 분쇄한다――｡"
  },
  {
   "id": 28834,
   "key": "D1209le.txt:11",
   "file": "D1209le.txt",
   "line": 11,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰も居ない通路を駈ける。",
   "ko_candidate": "아무도 없는 통로를 달린다｡"
  },
  {
   "id": 28835,
   "key": "D1209le.txt:12",
   "file": "D1209le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燃える回廊を疾る。",
   "ko_candidate": "불타는 회랑을 질주한다｡"
  },
  {
   "id": 28836,
   "key": "D1209le.txt:13",
   "file": "D1209le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "屍山血河の広間を越える。",
   "ko_candidate": "시산혈하의 광간을 넘는다｡"
  },
  {
   "id": 28837,
   "key": "D1209le.txt:15",
   "file": "D1209le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "襲撃を受けている基地内の惨状は目を覆うばかりだ。",
   "ko_candidate": "습격을 받고 있는 기지 내의 참상은 눈을 가릴 정도다｡"
  },
  {
   "id": 28838,
   "key": "D1209le.txt:16",
   "file": "D1209le.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……敵はかなり深くまで侵攻してきている。",
   "ko_candidate": "……적은 상당히 깊숙이까지 진입해 있다｡"
  },
  {
   "id": 28839,
   "key": "D1209le.txt:19",
   "file": "D1209le.txt",
   "line": 19,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「急がないと……！」",
   "ko_candidate": "「서둘러야 해……!」"
  },
  {
   "id": 28840,
   "key": "D1209le.txt:21",
   "file": "D1209le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "焦りもあった。",
   "ko_candidate": "초조함도 있었다｡"
  },
  {
   "id": 28841,
   "key": "D1209le.txt:22",
   "file": "D1209le.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、こうも敵の存在を見逃してしまったのは、ソレらの『生』の気配が希薄だったからだ。",
   "ko_candidate": "하지만､ 이렇게 적의 존재를 놓친 것은､ 그것들의 『생』의 기척이 희박했기 때문이다｡"
  },
  {
   "id": 28842,
   "key": "D1209le.txt:28",
   "file": "D1209le.txt",
   "line": 28,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「危ない！」",
   "ko_candidate": "「위험해!」"
  },
  {
   "id": 28843,
   "key": "D1209le.txt:34",
   "file": "D1209le.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの言葉に立ち止まる。頬を弾丸が掠める。",
   "ko_candidate": "알의 말에 멈춰 선다｡ 뺨을 총알이 스친다｡"
  },
  {
   "id": 28844,
   "key": "D1209le.txt:39",
   "file": "D1209le.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "弾丸が飛んできた先を見た。",
   "ko_candidate": "총알이 날아온 쪽을 보았다｡ 경비병의､ 시체｡"
  },
  {
   "id": 28845,
   "key": "D1209le.txt:40",
   "file": "D1209le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "警備兵の屍体だ。",
   "ko_candidate": "그렇게밖에 말할 수 없다｡"
  },
  {
   "id": 28846,
   "key": "D1209le.txt:41",
   "file": "D1209le.txt",
   "line": 41,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "警備兵の屍体が小銃を構えて、立っていた。 「こいつは……」",
   "ko_candidate": "설령 일어나 소총을 겨누고 있다 해도､ 목이 꺾이고 몸의 절반이 없어 내장을 쏟아내고 있는 인간은､ 이미 시체일 뿐이다｡"
  },
  {
   "id": 28847,
   "key": "D1209le.txt:51",
   "file": "D1209le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "１体だけではない。通路に転がる屍体の全て――中にはヒトの原形を留めていないモノもある、ソレらの全てが起き上がった。",
   "ko_candidate": "「이놈은……」 1구뿐만이 아니다｡ 통로에 널브러진 시체 전부――중에는 사람의 원형을 유지하고 있지 않은 것도 있다､ 그것들 전부가 일어섰다｡"
  },
  {
   "id": 28848,
   "key": "D1209le.txt:52",
   "file": "D1209le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "緩慢な動きで、それぞれ得物を執り、俺の周囲を取り囲む。",
   "ko_candidate": "느릿한 움직임으로､ 각자 무기를 들고､ 나를 둘러싼다｡"
  },
  {
   "id": 28849,
   "key": "D1209le.txt:55",
   "file": "D1209le.txt",
   "line": 55,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ゾンビか」",
   "ko_candidate": "「……좀비인가」"
  },
  {
   "id": 28850,
   "key": "D1209le.txt:57",
   "file": "D1209le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意思の無い眸が、俺を睨む。",
   "ko_candidate": "의지 없는 눈동자가､ 나를 노려본다｡"
  },
  {
   "id": 28851,
   "key": "D1209le.txt:59",
   "file": "D1209le.txt",
   "line": 59,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "意思が無いはずなのに……その眸の奥には生者への嫉妬、怨嗟が渦巻いているようにも見える。",
   "ko_candidate": "의지가 없어야 할 텐데……그 눈동자 깊숙한 곳에는 성자에 대한 질투､ 원한이 소용돌이치고 있는 것처럼 보인다｡"
  },
  {
   "id": 28852,
   "key": "D1209le.txt:60",
   "file": "D1209le.txt",
   "line": 60,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "一斉に銃口を突きつけられた。",
   "ko_candidate": "일제히 총구를 들이댔다｡"
  },
  {
   "id": 28853,
   "key": "D1209le.txt:65",
   "file": "D1209le.txt",
   "line": 65,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「生ける屍者を操る術……『妖蛆の秘密』の力」",
   "ko_candidate": "「살아있는 시체를 조종하는 술법……『벌레의 신비』의 힘」"
  },
  {
   "id": 28854,
   "key": "D1209le.txt:70",
   "file": "D1209le.txt",
   "line": 70,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ティベリウスか……！」",
   "ko_candidate": "「티베리우스인가……!」"
  },
  {
   "id": 28855,
   "key": "D1209le.txt:72",
   "file": "D1209le.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの下衆野郎も攻めて来ているのか。",
   "ko_candidate": "그 비열한 놈도 공격해 오고 있는 건가｡"
  },
  {
   "id": 28856,
   "key": "D1209le.txt:73",
   "file": "D1209le.txt",
   "line": 73,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "なおのこと急がなければならない。",
   "ko_candidate": "더더욱 서둘러야 한다｡"
  },
  {
   "id": 28857,
   "key": "D1209le.txt:74",
   "file": "D1209le.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奴を野放しにしておいたら、とんでもないことになる！",
   "ko_candidate": "놈을 그대로 놔두면､ 엄청난 일이 벌어질 거야!"
  },
  {
   "id": 28858,
   "key": "D1209le.txt:80",
   "file": "D1209le.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゾンビたちの銃が火を噴いた。",
   "ko_candidate": "좀비들의 총이 불을 뿜었다｡"
  }
 ]
}