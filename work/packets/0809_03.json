 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "クラウディウス": "클라우디우스",
  "カリグラ": "칼리굴라",
  "エンネア": "엔네아",
  "九郎": "쿠로",
  "覇道財閥": "하도 재벌",
  "アンチクロス": "안티크로스"
 },
 "items": [
  {
   "id": 14461,
   "key": "D0809al.txt:623",
   "file": "D0809al.txt",
   "line": 623,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺たちがさっきまで立っていたところも飲み込んでの大爆発。しかし舞い上がる土砂の中から猛スピードでクラウディウスが飛び出す。",
   "ko_candidate": "우리가 방금 전까지 서 있던 곳도 삼켜버리는 대폭발｡ 하지만 날아오르는 토사 속에서､ 맹렬한 속도로 클라우디우스가 튀어나온다｡"
  },
  {
   "id": 14462,
   "key": "D0809al.txt:628",
   "file": "D0809al.txt",
   "line": 628,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ケッ、 やるってのかよデカブツ！」",
   "ko_candidate": "「켓､ 해보자는 거냐 덩치야!」"
  },
  {
   "id": 14463,
   "key": "D0809al.txt:642",
   "file": "D0809al.txt",
   "line": 642,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラウディウスが突き出した右腕を払う。生じたカマイタチがアスファルトを刻みながら、カリグラを襲った。",
   "ko_candidate": "클라우디우스가 내민 오른팔을 휘두른다｡ 생긴 카마이타치가 아스팔트를 깎아내며､ 칼리굴라를 덮쳤다｡"
  },
  {
   "id": 14464,
   "key": "D0809al.txt:648",
   "file": "D0809al.txt",
   "line": 648,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「喝ァァァァァァァァァァァ！」",
   "ko_candidate": "「갓아아아아아아아아아아!」"
  },
  {
   "id": 14465,
   "key": "D0809al.txt:654",
   "file": "D0809al.txt",
   "line": 654,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "水妖の気がほとばしった。迫り来るカマイタチをカリグラは気合だけで打ち消した。",
   "ko_candidate": "수요의 기가 뿜어져 나왔다｡ 다가오는 카마이타치를､ 칼리굴라는 기합만으로 쳐냈다｡"
  },
  {
   "id": 14466,
   "key": "D0809al.txt:663",
   "file": "D0809al.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "刹那、黒い風が奔った。目にも留まらぬ速度でクラウディウスはカリグラの懐に潜り込んでいた。",
   "ko_candidate": "찰나､ 검은 바람이 달렸다｡ 눈 깜짝할 사이에､ 클라우디우스는 칼리굴라의 품에 파고들어 있었다｡"
  },
  {
   "id": 14467,
   "key": "D0809al.txt:667",
   "file": "D0809al.txt",
   "line": 667,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「イアャハァァッ！」",
   "ko_candidate": "「이야하아앗!」"
  },
  {
   "id": 14468,
   "key": "D0809al.txt:672",
   "file": "D0809al.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の刃を纏った手刀が疾る。",
   "ko_candidate": "바람의 칼날을 두른 수도가 날아간다｡"
  },
  {
   "id": 14469,
   "key": "D0809al.txt:673",
   "file": "D0809al.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まるで手加減の無い、零距離からの斬撃。",
   "ko_candidate": "마치 봐주는 것 없는､ 제로 거리에서의 참격｡"
  },
  {
   "id": 14470,
   "key": "D0809al.txt:682",
   "file": "D0809al.txt",
   "line": 682,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがカリグラはかわそうともしない。",
   "ko_candidate": "하지만 칼리굴라는 피하려고도 하지 않는다｡"
  },
  {
   "id": 14471,
   "key": "D0809al.txt:686",
   "file": "D0809al.txt",
   "line": 686,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「こぉぉォォォぉぉ……ハッッッ！」",
   "ko_candidate": "「코오오오오오……핫읏!」"
  },
  {
   "id": 14472,
   "key": "D0809al.txt:699",
   "file": "D0809al.txt",
   "line": 699,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ!?」",
   "ko_candidate": "「――――읏!?」"
  },
  {
   "id": 14473,
   "key": "D0809al.txt:704",
   "file": "D0809al.txt",
   "line": 704,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "手刀はカリグラの服を、裂くだけに留まった。",
   "ko_candidate": "수도는 칼리굴라의 옷을､ 찢는 데 그쳤다｡"
  },
  {
   "id": 14474,
   "key": "D0809al.txt:705",
   "file": "D0809al.txt",
   "line": 705,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "裂けた服の下から覗ける躰……甲殻で覆われているように見えたのは、気のせいだったのだろうか。",
   "ko_candidate": "찢어진 옷 아래로 보이는 몸……갑각으로 덮여 있는 것처럼 보인 것은､ 기분 탓이었을까｡"
  },
  {
   "id": 14475,
   "key": "D0809al.txt:707",
   "file": "D0809al.txt",
   "line": 707,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "攻撃を弾き返したカリグラは、クラウディウスを掴まえようと腕を伸ばす。",
   "ko_candidate": "공격을 튕겨낸 칼리굴라는､ 클라우디우스를 붙잡으려고 팔을 뻗는다｡"
  },
  {
   "id": 14476,
   "key": "D0809al.txt:717",
   "file": "D0809al.txt",
   "line": 717,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがクラウディウスは黒風となって疾り、カリグラの腕から逃れた。",
   "ko_candidate": "하지만 클라우디우스는 검은 바람이 되어 달려､ 칼리굴라의 팔에서 벗어났다｡"
  },
  {
   "id": 14477,
   "key": "D0809al.txt:725",
   "file": "D0809al.txt",
   "line": 725,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「トロいんだよ、デブ！」",
   "ko_candidate": "「느리다고､ 뚱보!」"
  },
  {
   "id": 14478,
   "key": "D0809al.txt:729",
   "file": "D0809al.txt",
   "line": 729,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ネズミのようにちょこまかト……！」",
   "ko_candidate": "「쥐새끼처럼 꼬물거리지……!」"
  },
  {
   "id": 14479,
   "key": "D0809al.txt:733",
   "file": "D0809al.txt",
   "line": 733,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……何なんだ、あいつらは!?　いきなり仲間割れなんか始めやがって！　しかも……！",
   "ko_candidate": "……뭐야､ 저 녀석들은!? 갑자기 동료끼리 싸움이나 시작하고!"
  },
  {
   "id": 14480,
   "key": "D0809al.txt:737",
   "file": "D0809al.txt",
   "line": 737,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「おらぁっ！」",
   "ko_candidate": "게다가……! 「오라앗!」"
  },
  {
   "id": 14481,
   "key": "D0809al.txt:744",
   "file": "D0809al.txt",
   "line": 744,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狙いの逸れたカマイタチが逃げ惑う人々を切り刻む。",
   "ko_candidate": "빗나간 카마이타치가 도망치는 사람들을 토막 낸다｡"
  },
  {
   "id": 14482,
   "key": "D0809al.txt:757",
   "file": "D0809al.txt",
   "line": 757,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ガァァァッ！」",
   "ko_candidate": "「가아악!」"
  },
  {
   "id": 14483,
   "key": "D0809al.txt:768",
   "file": "D0809al.txt",
   "line": 768,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "外れた爆砕拳が逃げ遅れた人々を消し飛ばす。",
   "ko_candidate": "빗나간 폭쇄 펀치가 도망치지 못한 사람들을 날려버린다｡"
  },
  {
   "id": 14484,
   "key": "D0809al.txt:777",
   "file": "D0809al.txt",
   "line": 777,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「～～～～～～～～～～ッッッッ！」",
   "ko_candidate": "「～～～～～～～～～～읏읏읏읏!」"
  },
  {
   "id": 14485,
   "key": "D0809al.txt:779",
   "file": "D0809al.txt",
   "line": 779,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まだ……！　まだやるのか、貴様ら！",
   "ko_candidate": "아직도……! 아직도 하는 거냐､ 이 자식들!"
  },
  {
   "id": 14486,
   "key": "D0809al.txt:781",
   "file": "D0809al.txt",
   "line": 781,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "駄目だ。もう駄目だ。",
   "ko_candidate": "안 돼｡ 이제 끝장이다｡"
  },
  {
   "id": 14487,
   "key": "D0809al.txt:782",
   "file": "D0809al.txt",
   "line": 782,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ついに怒りが我慢の限界を超えた。",
   "ko_candidate": "드디어 분노가 참을 수 있는 한계를 넘어섰다｡"
  },
  {
   "id": 14488,
   "key": "D0809al.txt:787",
   "file": "D0809al.txt",
   "line": 787,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「逃げろ……エンネア」",
   "ko_candidate": "「도망쳐… 엔네아」"
  },
  {
   "id": 14489,
   "key": "D0809al.txt:794",
   "file": "D0809al.txt",
   "line": 794,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「九郎？」",
   "ko_candidate": "「쿠로?」"
  },
  {
   "id": 14490,
   "key": "D0809al.txt:800",
   "file": "D0809al.txt",
   "line": 800,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「適当なシェルターに逃げ込め。そこからなら地下施設を管理している覇道財閥と内線が繋がる。そしたら、俺の名前を出すんだ。良いな？　連中は――俺が引きつける！」",
   "ko_candidate": "「적당한 대피소로 도망가｡ 거기서라면 지하시설을 관리하고 있는 하도 재벌과 내선이 연결될 거야｡ 그러면 내 이름을 대｡ 알겠지? 놈들은… 내가 끌어당기겠어!」"
  },
  {
   "id": 14491,
   "key": "D0809al.txt:806",
   "file": "D0809al.txt",
   "line": 806,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "言って、俺は争う２人に向かって駆け出した。",
   "ko_candidate": "말하고､ 나는 싸우는 두 사람을 향해 달려갔다｡"
  },
  {
   "id": 14492,
   "key": "D0809al.txt:811",
   "file": "D0809al.txt",
   "line": 811,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「お、おい、九郎！」",
   "ko_candidate": "「어､ 이봐､ 쿠로!」"
  },
  {
   "id": 14493,
   "key": "D0809al.txt:815",
   "file": "D0809al.txt",
   "line": 815,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「俺たちには構うな！　行けっっっっ！」",
   "ko_candidate": "「우리는 신경 쓰지 마! 가라고오오오!」"
  },
  {
   "id": 14494,
   "key": "D0809al.txt:819",
   "file": "D0809al.txt",
   "line": 819,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「…………………………」",
   "ko_candidate": "「………………………」"
  },
  {
   "id": 14495,
   "key": "D0809al.txt:823",
   "file": "D0809al.txt",
   "line": 823,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分かっているような分かっていないような瞳で俺を見返す。彼女を１人にするのは不安だが、だからと言ってアンチクロス２人を相手に守り通せる保証も自信もない。",
   "ko_candidate": "알 듯 모를 듯한 눈동자로 나를 바라본다｡ 그녀를 혼자 두는 것은 불안하지만､ 그렇다고 안티 크로스 두 명을 상대로 지켜낼 수 있다는 보장도 자신도 없다｡"
  },
  {
   "id": 14496,
   "key": "D0809al.txt:835",
   "file": "D0809al.txt",
   "line": 835,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ン？」",
   "ko_candidate": "「……응?」"
  },
  {
   "id": 14497,
   "key": "D0809al.txt:843",
   "file": "D0809al.txt",
   "line": 843,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハハ……飛んで火にいる、か」",
   "ko_candidate": "「하하… 불난 집에 부채질하는 격이군」"
  },
  {
   "id": 14498,
   "key": "D0809al.txt:850",
   "file": "D0809al.txt",
   "line": 850,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突撃する俺に２人は気づいた。",
   "ko_candidate": "돌진하는 나를､ 두 사람은 알아챘다｡"
  },
  {
   "id": 14499,
   "key": "D0809al.txt:851",
   "file": "D0809al.txt",
   "line": 851,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "同時に振り向き、嘲るような視線を向ける。",
   "ko_candidate": "동시에 돌아보며､ 조롱하는 듯한 시선을 보낸다｡"
  },
  {
   "id": 14500,
   "key": "D0809al.txt:852",
   "file": "D0809al.txt",
   "line": 852,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラウディウスの顔がより一層、凶悪に歪んだ。",
   "ko_candidate": "클라우디우스의 얼굴이 더욱 더 흉악하게 일그러졌다｡"
  }
 ]
}