 },
 "items": [
  {
   "id": 9436,
   "key": "D0710le.txt:110",
   "file": "D0710le.txt",
   "line": 110,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あいつが居ないと、俺は一般人と大差ない。",
   "ko_candidate": "그녀가 없으면 나는 일반인과 다를 바 없다｡"
  },
  {
   "id": 9437,
   "key": "D0710le.txt:111",
   "file": "D0710le.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そんな状態で、敵に出くわしたら……",
   "ko_candidate": "그런 상태로 적과 마주치면……"
  },
  {
   "id": 9438,
   "key": "D0710le.txt:118",
   "file": "D0710le.txt",
   "line": 118,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……みんなもこの島に着いているかも知れない。 捜そう」",
   "ko_candidate": "「……모두도 이 섬에 도착했을지도 몰라｡ 찾아보자」"
  },
  {
   "id": 9439,
   "key": "D0710le.txt:124",
   "file": "D0710le.txt",
   "line": 124,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「う、うん……でも、どうやって？」",
   "ko_candidate": "「으､ 응……하지만 어떻게?」"
  },
  {
   "id": 9440,
   "key": "D0710le.txt:129",
   "file": "D0710le.txt",
   "line": 129,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 9441,
   "key": "D0710le.txt:134",
   "file": "D0710le.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確かに、闇雲に探しても効率が悪すぎる。",
   "ko_candidate": "확실히 무작정 찾아봐도 효율이 너무 나쁘다｡"
  },
  {
   "id": 9442,
   "key": "D0710le.txt:135",
   "file": "D0710le.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "天気の方も不安だ。間違いなく一雨くる。",
   "ko_candidate": "날씨도 불안하다｡ 틀림없이 비가 올 것이다｡"
  },
  {
   "id": 9443,
   "key": "D0710le.txt:137",
   "file": "D0710le.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そんな中で捜すのは、なおのこと困難だ。",
   "ko_candidate": "그런 상황에서 찾는 건 더욱 어려울 거야｡"
  },
  {
   "id": 9444,
   "key": "D0710le.txt:138",
   "file": "D0710le.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど他に方法が――",
   "ko_candidate": "하지만 다른 방법이――"
  },
  {
   "id": 9445,
   "key": "D0710le.txt:143",
   "file": "D0710le.txt",
   "line": 143,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……？」",
   "ko_candidate": "「……?」"
  },
  {
   "id": 9446,
   "key": "D0710le.txt:148",
   "file": "D0710le.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そのとき、閃くものがあった。",
   "ko_candidate": "그때､ 번뜩이는 것이 있었다｡"
  },
  {
   "id": 9447,
   "key": "D0710le.txt:149",
   "file": "D0710le.txt",
   "line": 149,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ポケットに手を突っ込んで、目的のものを探す。",
   "ko_candidate": "주머니에 손을 넣어 목적의 물건을 찾는다｡"
  },
  {
   "id": 9448,
   "key": "D0710le.txt:152",
   "file": "D0710le.txt",
   "line": 152,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "あった……何となく入れっぱなしにしておいて良かった。",
   "ko_candidate": "있었다……왠지 넣어둔 채로 있어서 다행이었어｡"
  },
  {
   "id": 9449,
   "key": "D0710le.txt:161",
   "file": "D0710le.txt",
   "line": 161,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それは？」",
   "ko_candidate": "「그건?」"
  },
  {
   "id": 9450,
   "key": "D0710le.txt:166",
   "file": "D0710le.txt",
   "line": 166,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「探し物をするときに使う、一種の魔術さ」",
   "ko_candidate": "「찾는 물건을 찾을 때 쓰는 일종의 마술이야」"
  },
  {
   "id": 9451,
   "key": "D0710le.txt:173",
   "file": "D0710le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "紐に吊るされた重石。",
   "ko_candidate": "줄에 매달린 추｡"
  },
  {
   "id": 9452,
   "key": "D0710le.txt:174",
   "file": "D0710le.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう、ダウジングで使う道具だ。",
   "ko_candidate": "그래､ 다우징에 쓰는 도구다｡"
  },
  {
   "id": 9453,
   "key": "D0710le.txt:177",
   "file": "D0710le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "前の時はマギウス・スタイルで使っていたが、今の俺ならこの程度の魔術、何とか行使できるかも知れない。アルの奴にもさんざんドヤされたからな……。",
   "ko_candidate": "전에는 마기우스 스타일로 사용했지만……지금의 나라면 이 정도의 마술은 어떻게든 행사할 수 있을지도 모른다｡ 알한테도 산뜻하게 당했으니까 말이야……"
  },
  {
   "id": 9454,
   "key": "D0710le.txt:182",
   "file": "D0710le.txt",
   "line": 182,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「何も無いよりはマシだろう。こいつでみんなを捜すぞ」",
   "ko_candidate": "「아무것도 없는 것보단 낫겠지｡ 이걸로 모두를 찾아보자」"
  },
  {
   "id": 9455,
   "key": "D0710le.txt:191",
   "file": "D0710le.txt",
   "line": 191,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「分かった」",
   "ko_candidate": "「알겠어」"
  },
  {
   "id": 9456,
   "key": "D0710le.txt:196",
   "file": "D0710le.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "適当な方角に顔を向けて、振り子の動きを調べる。",
   "ko_candidate": "적당한 방향으로 얼굴을 돌리고 추의 움직임을 살핀다｡"
  },
  {
   "id": 9457,
   "key": "D0710le.txt:197",
   "file": "D0710le.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "振り子が時計回りに振れればＹＥＳ。逆ならＮＯ。",
   "ko_candidate": "추가 시계 방향으로 움직이면 YES｡ 반대면 NO｡"
  },
  {
   "id": 9458,
   "key": "D0710le.txt:199",
   "file": "D0710le.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "意識を集中させ、術式を編む。",
   "ko_candidate": "의식을 집중시켜 술식을 짜낸다｡"
  },
  {
   "id": 9459,
   "key": "D0710le.txt:216",
   "file": "D0710le.txt",
   "line": 216,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「森……島の奥の方ね」",
   "ko_candidate": "「숲……섬 안쪽이네」"
  },
  {
   "id": 9460,
   "key": "D0710le.txt:222",
   "file": "D0710le.txt",
   "line": 222,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「行ってみよう」",
   "ko_candidate": "「가보자」"
  },
  {
   "id": 9461,
   "key": "D0710le.txt:237",
   "file": "D0710le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ダウジングに従って、森の中を進む。",
   "ko_candidate": "다우징을 따라 숲 속으로 들어간다｡"
  },
  {
   "id": 9462,
   "key": "D0710le.txt:238",
   "file": "D0710le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "たまに樹に傷を付けて、目印とした。",
   "ko_candidate": "가끔 나무에 상처를 내어 표시로 삼았다｡"
  },
  {
   "id": 9463,
   "key": "D0710le.txt:240",
   "file": "D0710le.txt",
   "line": 240,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ダウジングは、森の奥へ奥へと俺たちを導く。",
   "ko_candidate": "다우징은 숲 안쪽으로 안쪽으로 우리를 인도한다｡"
  },
  {
   "id": 9464,
   "key": "D0710le.txt:242",
   "file": "D0710le.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ぽつり。",
   "ko_candidate": "똑｡"
  },
  {
   "id": 9465,
   "key": "D0710le.txt:243",
   "file": "D0710le.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "雨の最初の一雫が頬に落ちた。",
   "ko_candidate": "비의 첫 방울이 뺨에 떨어졌다｡"
  },
  {
   "id": 9466,
   "key": "D0710le.txt:245",
   "file": "D0710le.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それを皮切りに次々と雨の雫が、地面を濡らしていく。",
   "ko_candidate": "그것을 시작으로 연이어 빗방울이 땅을 적신다｡"
  },
  {
   "id": 9467,
   "key": "D0710le.txt:264",
   "file": "D0710le.txt",
   "line": 264,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くそ……降り出してきやがった」",
   "ko_candidate": "「젠장……비가 오기 시작했군」"
  },
  {
   "id": 9468,
   "key": "D0710le.txt:268",
   "file": "D0710le.txt",
   "line": 268,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだ勢いは弱いものの、雨足は少しずつ強くなっていく。",
   "ko_candidate": "아직 세기는 약하지만､ 빗줄기는 점점 강해지고 있다｡"
  },
  {
   "id": 9469,
   "key": "D0710le.txt:271",
   "file": "D0710le.txt",
   "line": 271,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まあ……どのみち海に落ちて、散々にずぶ濡れなので、いまさら雨に降られようと、大したことはないのだが。",
   "ko_candidate": "뭐……어차피 바다에 빠져서 흠뻑 젖었으니 이제 와서 비를 맞아도 별거 아니지만｡"
  },
  {
   "id": 9470,
   "key": "D0710le.txt:282",
   "file": "D0710le.txt",
   "line": 282,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「でも……何だか凄く冥い雲……」",
   "ko_candidate": "「하지만……왠지 굉장히 어두운 구름……」"
  },
  {
   "id": 9471,
   "key": "D0710le.txt:287",
   "file": "D0710le.txt",
   "line": 287,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 9472,
   "key": "D0710le.txt:291",
   "file": "D0710le.txt",
   "line": 291,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確かに、空を覆い尽くす暗雲は、墜ちて来そうなくらいに重く垂れ込めている。ただの雨雲って感じではない。",
   "ko_candidate": "확실히 하늘을 뒤덮은 먹구름은 떨어질 것 같을 정도로 무겁게 드리워져 있다｡ 단순한 비구름……같지는 않아｡"
  },
  {
   "id": 9473,
   "key": "D0710le.txt:294",
   "file": "D0710le.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……嵐になるかも知れないな。",
   "ko_candidate": "폭풍이 올지도 모른다｡"
  },
  {
   "id": 9474,
   "key": "D0710le.txt:299",
   "file": "D0710le.txt",
   "line": 299,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「急ぐか……」",
   "ko_candidate": "「서두르자……」"
  },
  {
   "id": 9475,
   "key": "D0710le.txt:310",
   "file": "D0710le.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "しばらく、そうやって森の中を歩き続けていた。",
   "ko_candidate": "잠시 그렇게 숲 속을 걸어 계속했다｡"
  }
 ]
}