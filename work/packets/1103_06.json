 "items": [
  {
   "id": 22968,
   "key": "D1103le.txt:461",
   "file": "D1103le.txt",
   "line": 461,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームセイバーを掴まえる手。黒い光沢を見せる。",
   "ko_candidate": "빔 세이버를 움켜쥔 손｡ 검은 광택을 보인다｡"
  },
  {
   "id": 22969,
   "key": "D1103le.txt:462",
   "file": "D1103le.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "装甲……右腕右手が、黒い装甲に包まれている。",
   "ko_candidate": "장갑…… 오른팔 오른손이 검은 장갑에 싸여 있다｡"
  },
  {
   "id": 22970,
   "key": "D1103le.txt:464",
   "file": "D1103le.txt",
   "line": 464,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――!?　まさか、こいつは……！",
   "ko_candidate": "――!? 설마 이 녀석은……!"
  },
  {
   "id": 22971,
   "key": "D1103le.txt:470",
   "file": "D1103le.txt",
   "line": 470,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そいつは、ライカ・クルセイドは 『ブラックロッジ』を裏切ったのだ！」",
   "ko_candidate": "「그 녀석은 라이카 크루세이드는 『블랙로지』를 배신했다!」"
  },
  {
   "id": 22972,
   "key": "D1103le.txt:478",
   "file": "D1103le.txt",
   "line": 478,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が靄になって湧き出した。結晶化し、黒い鎧となって、パーツごとに装着されていく。",
   "ko_candidate": "어둠이 안개가 되어 솟아오른다｡ 결정화되어 검은 갑옷이 되어 부품별로 장착되어 간다｡"
  },
  {
   "id": 22973,
   "key": "D1103le.txt:480",
   "file": "D1103le.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "黒の天使が降臨する――",
   "ko_candidate": "흑의 천사가 강림한다――"
  },
  {
   "id": 22974,
   "key": "D1103le.txt:489",
   "file": "D1103le.txt",
   "line": 489,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「サンダルフォンだって!?」",
   "ko_candidate": "「산달폰이라고!?」"
  },
  {
   "id": 22975,
   "key": "D1103le.txt:493",
   "file": "D1103le.txt",
   "line": 493,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「呼ォォォォォ……破ッ！」",
   "ko_candidate": "「후오오오오오…… 파앗!」"
  },
  {
   "id": 22976,
   "key": "D1103le.txt:496",
   "file": "D1103le.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "空いている左手が拳を作る。",
   "ko_candidate": "비어있는 왼손이 주먹을 만든다｡"
  },
  {
   "id": 22977,
   "key": "D1103le.txt:497",
   "file": "D1103le.txt",
   "line": 497,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "仮面の下から零れる呼気。",
   "ko_candidate": "가면 아래에서 새어 나오는 숨결｡"
  },
  {
   "id": 22978,
   "key": "D1103le.txt:500",
   "file": "D1103le.txt",
   "line": 500,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全身に漲る力を、気合と共に鳩尾へ叩き込む。",
   "ko_candidate": "온몸에 넘치는 힘을 기합과 함께 명치에 내리꽂는다｡"
  },
  {
   "id": 22979,
   "key": "D1103le.txt:502",
   "file": "D1103le.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃は背中へと貫通し、メタトロンの身体が宙を舞い、床に叩きつけられる。",
   "ko_candidate": "충격은 등을 관통하고 메타트론의 몸이 공중에 떠올랐다가 바닥에 내동댕이쳐진다｡"
  },
  {
   "id": 22980,
   "key": "D1103le.txt:505",
   "file": "D1103le.txt",
   "line": 505,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ライカさん！」",
   "ko_candidate": "「라이카 씨!」"
  },
  {
   "id": 22981,
   "key": "D1103le.txt:510",
   "file": "D1103le.txt",
   "line": 510,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「グゥゥゥ……ッ！」",
   "ko_candidate": "「그우우우……읏!」"
  },
  {
   "id": 22982,
   "key": "D1103le.txt:514",
   "file": "D1103le.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンの装甲の重みで、木造の床が圧し折れた。",
   "ko_candidate": "메타트론의 장갑의 무게로 목조 바닥이 압사 부러졌다｡"
  },
  {
   "id": 22983,
   "key": "D1103le.txt:515",
   "file": "D1103le.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すぐさま膝を突いて起き上がる。",
   "ko_candidate": "곧바로 무릎을 꿇고 일어난다｡"
  },
  {
   "id": 22984,
   "key": "D1103le.txt:517",
   "file": "D1103le.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "追撃はない。拳を突き出したポーズのまま、メタトロンと睨み合う。",
   "ko_candidate": "추격은 없다｡ 주먹을 내민 자세 그대로 메타트론과 노려본다｡"
  },
  {
   "id": 22985,
   "key": "D1103le.txt:519",
   "file": "D1103le.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こいつが……あのハーモニカの青年がサンダルフォンだったのか。",
   "ko_candidate": "이 녀석이…… 그 하모니카 청년이 산달폰이었던 건가｡"
  },
  {
   "id": 22986,
   "key": "D1103le.txt:520",
   "file": "D1103le.txt",
   "line": 520,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『ブラックロッジ』に組する黒天使。",
   "ko_candidate": "『블랙로지』에 가담하는 흑천사｡"
  },
  {
   "id": 22987,
   "key": "D1103le.txt:521",
   "file": "D1103le.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンと同じ姿を持つ戦天使。",
   "ko_candidate": "메타트론과 같은 모습을 한 전천사｡"
  },
  {
   "id": 22988,
   "key": "D1103le.txt:523",
   "file": "D1103le.txt",
   "line": 523,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "メタトロンと同じ姿の――",
   "ko_candidate": "메타트론과 같은 모습의――"
  },
  {
   "id": 22989,
   "key": "D1103le.txt:526",
   "file": "D1103le.txt",
   "line": 526,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「『ブラックロッジ』……同じ姿……？」",
   "ko_candidate": "「『블랙로지』…… 같은 모습……?」"
  },
  {
   "id": 22990,
   "key": "D1103le.txt:532",
   "file": "D1103le.txt",
   "line": 532,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「納得出来たか？　そうだ。己とそいつとは『ブラックロッジ』の同胞だ」 「いや……そんな言い方は水臭いか。 なあ……？」",
   "ko_candidate": "「납득이 갔나? 그래｡ 나와 그 녀석은 『블랙로지』의 동료다｡ 아니…… 그런 말은 너무 남 같군｡ 그렇지……?」"
  },
  {
   "id": 22991,
   "key": "D1103le.txt:541",
   "file": "D1103le.txt",
   "line": 541,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……っ！　止めて……」",
   "ko_candidate": "「……읏! 그만해……」"
  },
  {
   "id": 22992,
   "key": "D1103le.txt:545",
   "file": "D1103le.txt",
   "line": 545,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの言わんとしていることが分かったのか、ライカさんは息を呑み、拒絶する。",
   "ko_candidate": "산달폰이 말하려는 것을 알아차린 건지 라이카 씨는 숨을 삼키고 거부한다｡"
  },
  {
   "id": 22993,
   "key": "D1103le.txt:546",
   "file": "D1103le.txt",
   "line": 546,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "拒絶の声は、怯えているように弱々しい。",
   "ko_candidate": "거부의 목소리는 두려워하는 것처럼 약하다｡"
  },
  {
   "id": 22994,
   "key": "D1103le.txt:548",
   "file": "D1103le.txt",
   "line": 548,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "嗜虐の悦びを含んだ声で、サンダルフォンが決定的な一言を発する。",
   "ko_candidate": "가학의 기쁨을 담은 목소리로 산달폰이 결정적인 한마디를 내뱉는다｡"
  },
  {
   "id": 22995,
   "key": "D1103le.txt:552",
   "file": "D1103le.txt",
   "line": 552,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――ライカ姉さん」",
   "ko_candidate": "「――라이카 누나」"
  },
  {
   "id": 22996,
   "key": "D1103le.txt:555",
   "file": "D1103le.txt",
   "line": 555,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初、言っていることの意味が分からなかった。",
   "ko_candidate": "처음에는 말하는 것의 의미를 이해할 수 없었다｡"
  },
  {
   "id": 22997,
   "key": "D1103le.txt:557",
   "file": "D1103le.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカ姉さん？",
   "ko_candidate": "라이카 누나?"
  },
  {
   "id": 22998,
   "key": "D1103le.txt:558",
   "file": "D1103le.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "姉さんだって？",
   "ko_candidate": "누나라고?"
  },
  {
   "id": 22999,
   "key": "D1103le.txt:560",
   "file": "D1103le.txt",
   "line": 560,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンの言葉に、メタトロンは視線を逸らして俯いた。",
   "ko_candidate": "산달폰의 말에 메타트론은 시선을 돌려 고개를 숙였다｡"
  },
  {
   "id": 23000,
   "key": "D1103le.txt:561",
   "file": "D1103le.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "表情は読み取れない。だが、その姿は重すぎる事実に堪え忍んでいるように見えた。",
   "ko_candidate": "표정은 읽을 수 없다｡ 하지만 그 모습은 너무나 무거운 사실을 견디고 있는 것처럼 보였다｡"
  },
  {
   "id": 23001,
   "key": "D1103le.txt:566",
   "file": "D1103le.txt",
   "line": 566,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "サンダルフォンが、黒い天使の仮面を外す。",
   "ko_candidate": "산달폰이 검은 천사의 가면을 벗는다｡"
  },
  {
   "id": 23002,
   "key": "D1103le.txt:570",
   "file": "D1103le.txt",
   "line": 570,
   "speaker": "リューガ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "リューガの貌で、決して隠せない憎悪と、その憎悪を僅かに癒す愉悦に歪んだ貌で、あのとき子どもたちに向けていたと同じ、優しい微笑を浮かべる。 「そうだよ、姉さん。己達は姉弟じゃないか、姉さん。たった２人の姉弟じゃないか」",
   "ko_candidate": "류가의 얼굴로､ 결코 숨길 수 없는 증오와 그 증오를 약간 치유하는 쾌락에 일그러진 얼굴로､ 그때 아이들에게 보여주었던 것과 같은 상냥한 미소를 짓는다｡"
  },
  {
   "id": 23003,
   "key": "D1103le.txt:577",
   "file": "D1103le.txt",
   "line": 577,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「たとえ別々になっても、己達が姉弟である事実だけは変わらない。変えられたりはしないさ」 「なあ、ライカ姉さん？ そうだろ、ライカ姉さん？ どうしたんだいライカ姉さん？ 何か言ったらどうだい、ライカ姉さん？」",
   "ko_candidate": "「그래 누나｡ 우리는 남매잖아､ 누나｡ 단 둘뿐인 남매잖아｡ 설령 따로 떨어져 있어도 우리가 남매라는 사실만은 변하지 않아｡ 바꿀 수도 없지｡ 그렇지､ 라이카 누나? 그렇지､ 라이카 누나? 왜 그래 라이카 누나? 뭐라고 말해봐､ 라이카 누나?」"
  },
  {
   "id": 23004,
   "key": "D1103le.txt:584",
   "file": "D1103le.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――姉弟？",
   "ko_candidate": "――남매?"
  },
  {
   "id": 23005,
   "key": "D1103le.txt:585",
   "file": "D1103le.txt",
   "line": 585,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "メタトロンとサンダルフォンが？ アーカムシティの守護天使と、『ブラックロッジ』の破壊天使が？",
   "ko_candidate": "메타트론과 산달폰이?"
  },
  {
   "id": 23006,
   "key": "D1103le.txt:588",
   "file": "D1103le.txt",
   "line": 588,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんと、ハーモニカの青年……リューガが？",
   "ko_candidate": "아캄시티의 수호천사와 『블랙로지』의 파괴천사가?"
  },
  {
   "id": 23007,
   "key": "D1103le.txt:589",
   "file": "D1103le.txt",
   "line": 589,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ライカさんと――サンダルフォンが。",
   "ko_candidate": "라이카 씨와 하모니카 청년…… 류가가?"
  }
 ]
}