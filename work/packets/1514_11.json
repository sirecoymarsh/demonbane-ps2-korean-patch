 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "姫さん": "공주님",
  "マスターテリオン": "마스터 테리온"
 },
 "items": [
  {
   "id": 47343,
   "key": "D1514ru.txt:563",
   "file": "D1514ru.txt",
   "line": 563,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もしくは……不自然な時空の『角度』に滑り落ちてしまったか。",
   "ko_candidate": "아니면……부자연스러운 시공의 『각도』로 미끄러져 떨어진 걸까｡"
  },
  {
   "id": 47344,
   "key": "D1514ru.txt:565",
   "file": "D1514ru.txt",
   "line": 565,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どちらにしても、救われない状況だ。",
   "ko_candidate": "어느 쪽이든､ 구원받을 수 없는 상황이다｡"
  },
  {
   "id": 47345,
   "key": "D1514ru.txt:567",
   "file": "D1514ru.txt",
   "line": 567,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "くそ……こんなところで彷徨っている場合ではないのに！",
   "ko_candidate": "젠장……이런 곳에서 방황하고 있을 때가 아닌데!"
  },
  {
   "id": 47346,
   "key": "D1514ru.txt:568",
   "file": "D1514ru.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は約束したんだ……姫さんの許に、必ず帰るって！",
   "ko_candidate": "나는 약속했잖아……공주님에게､ 반드시 돌아가겠다고!"
  },
  {
   "id": 47347,
   "key": "D1514ru.txt:569",
   "file": "D1514ru.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "なのに……こんな、情けない……！",
   "ko_candidate": "그런데……이렇게､ 한심하게……!"
  },
  {
   "id": 47348,
   "key": "D1514ru.txt:573",
   "file": "D1514ru.txt",
   "line": 573,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――死んではいない。堕ちる角度なら既に決定している。 そうとも。ここが肝心な部分なのに、そんな簡単な終らせ方があってなるものか。余はもっともっと情熱的だぞ？」",
   "ko_candidate": "「――죽지 않았다｡ 떨어지는 각도라면 이미 결정되어 있다｡ 그렇고말고｡ 여기가 중요한 부분인데､ 그런 간단한 끝맺음이 있을 리가 없지｡ 나는 더욱더 열정적이라고?」"
  },
  {
   "id": 47349,
   "key": "D1514ru.txt:580",
   "file": "D1514ru.txt",
   "line": 580,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「マスターテリオン!?」",
   "ko_candidate": "「마스터 테리온!?」"
  },
  {
   "id": 47350,
   "key": "D1514ru.txt:583",
   "file": "D1514ru.txt",
   "line": 583,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "聴こえないはずの聲が聴こえた。",
   "ko_candidate": "들리지 않아야 할 목소리가 들렸다｡"
  },
  {
   "id": 47351,
   "key": "D1514ru.txt:585",
   "file": "D1514ru.txt",
   "line": 585,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "堪え切れない嘲笑をぼろぼろと零れ落とすような、歪んだ響きが、俺の心を撫で回す。",
   "ko_candidate": "견딜 수 없는 조소를 줄줄 흘리듯이､ 일그러진 울림이､ 내 마음을 어루만진다｡"
  },
  {
   "id": 47352,
   "key": "D1514ru.txt:587",
   "file": "D1514ru.txt",
   "line": 587,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "嫌悪が胸の中で荒れ狂い、だがその憎しみこそが、皮肉なことに世界に繋がる手懸かりとなった。",
   "ko_candidate": "혐오가 가슴속에서 거칠게 날뛰고､ 하지만 그 증오야말로､ 아이러니하게도 세계와 연결되는 실마리가 되었다｡"
  },
  {
   "id": 47353,
   "key": "D1514ru.txt:589",
   "file": "D1514ru.txt",
   "line": 589,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの容を強く認識しながら、俺は怨敵の姿を追う。",
   "ko_candidate": "자신의 모습을 강하게 인식하면서､ 나는 원수의 모습을 쫓는다｡"
  },
  {
   "id": 47354,
   "key": "D1514ru.txt:590",
   "file": "D1514ru.txt",
   "line": 590,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "極彩色の闇に、金色の闇がわだかまっていた。",
   "ko_candidate": "극채색의 어둠 속에､ 황금빛 어둠이 웅크리고 있었다｡"
  },
  {
   "id": 47355,
   "key": "D1514ru.txt:591",
   "file": "D1514ru.txt",
   "line": 591,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の、獣。",
   "ko_candidate": "황금빛의､ 짐승｡"
  },
  {
   "id": 47356,
   "key": "D1514ru.txt:595",
   "file": "D1514ru.txt",
   "line": 595,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……マスタァァァァテリオンッッッッ！」",
   "ko_candidate": "「……마스터어어어어 테리온!」"
  },
  {
   "id": 47357,
   "key": "D1514ru.txt:599",
   "file": "D1514ru.txt",
   "line": 599,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「これから我等は同じ場所に堕ちる。 そして……貴公はようやく神の絡繰を知るのだ」",
   "ko_candidate": "「이제부터 우리는 같은 곳으로 떨어진다｡ 그리고…… 당신은 마침내 신의 장치를 알게 되는 것이다」"
  },
  {
   "id": 47358,
   "key": "D1514ru.txt:604",
   "file": "D1514ru.txt",
   "line": 604,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「絡繰だと……？」",
   "ko_candidate": "「장치라고……?」"
  },
  {
   "id": 47359,
   "key": "D1514ru.txt:608",
   "file": "D1514ru.txt",
   "line": 608,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「絶望の恍惚と共に……癒える事の無い、闘争の疲弊を迎えて。 さあ……始めよう」",
   "ko_candidate": "「절망의 황홀함과 함께…… 치유될 수 없는､ 투쟁의 피로를 맞이하며｡ 자､ …… 시작하자」"
  },
  {
   "id": 47360,
   "key": "D1514ru.txt:612",
   "file": "D1514ru.txt",
   "line": 612,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両腕を広げて、わざと胸を晒し、金色の獣は微笑む。",
   "ko_candidate": "양팔을 벌리고､ 일부러 가슴을 드러내며､ 황금빛 짐승은 미소 짓는다｡"
  },
  {
   "id": 47361,
   "key": "D1514ru.txt:614",
   "file": "D1514ru.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "夢を見るような瞳で。",
   "ko_candidate": "꿈을 꾸는 듯한 눈동자로｡"
  },
  {
   "id": 47362,
   "key": "D1514ru.txt:615",
   "file": "D1514ru.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛おしむように。",
   "ko_candidate": "사랑스럽게 여기듯이｡"
  },
  {
   "id": 47363,
   "key": "D1514ru.txt:616",
   "file": "D1514ru.txt",
   "line": 616,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "穏やかに。",
   "ko_candidate": "온화하게｡"
  },
  {
   "id": 47364,
   "key": "D1514ru.txt:617",
   "file": "D1514ru.txt",
   "line": 617,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "優しく……",
   "ko_candidate": "상냥하게……"
  },
  {
   "id": 47365,
   "key": "D1514ru.txt:619",
   "file": "D1514ru.txt",
   "line": 619,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怖気が走った。",
   "ko_candidate": "소름이 돋았다｡"
  },
  {
   "id": 47366,
   "key": "D1514ru.txt:620",
   "file": "D1514ru.txt",
   "line": 620,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気付けば俺は極彩色の空間を、疾走していた。",
   "ko_candidate": "정신을 차려보니 나는 극채색의 공간을､ 질주하고 있었다｡"
  },
  {
   "id": 47367,
   "key": "D1514ru.txt:621",
   "file": "D1514ru.txt",
   "line": 621,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の闇を呑み込むかのような、怒濤の勢いで。",
   "ko_candidate": "황금빛 어둠을 삼켜버릴 듯한､ 격렬한 기세로｡"
  },
  {
   "id": 47368,
   "key": "D1514ru.txt:622",
   "file": "D1514ru.txt",
   "line": 622,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マスターテリオンの微笑に亀裂が広がり、哄笑が轟いた。",
   "ko_candidate": "마스터 테리온의 미소에 균열이 번지고､ 폭소가 울려 퍼졌다｡"
  },
  {
   "id": 47369,
   "key": "D1514ru.txt:626",
   "file": "D1514ru.txt",
   "line": 626,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「あはははは！　あはははは！　あははははははははは！」 「あははははははははははははははははははははははははははははははははははは！」",
   "ko_candidate": "「아하하하하! 아하하하하! 아하하하하하하하하! 아하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하하!」"
  },
  {
   "id": 47370,
   "key": "D1514ru.txt:637",
   "file": "D1514ru.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして世界は砕け――",
   "ko_candidate": "그리고 세계는 부서지고――"
  },
  {
   "id": 47371,
   "key": "D1514ru.txt:637",
   "file": "D1514ru.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限への扉が、開け放たれる。",
   "ko_candidate": "무한으로의 문이､ 활짝 열린다｡"
  },
  {
   "id": 47372,
   "key": "D1514ru.txt:643",
   "file": "D1514ru.txt",
   "line": 643,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は――",
   "ko_candidate": "나는――"
  }
 ]
}