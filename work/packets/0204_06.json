   "line": 872,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "独楽の様に運命が回る。",
   "ko_candidate": "장기말처럼 운명이 돈다｡"
  },
  {
   "id": 2019,
   "key": "D0204ab.txt:875",
