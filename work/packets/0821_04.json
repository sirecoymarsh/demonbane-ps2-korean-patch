 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ウェスパシアヌス": "베스파시아누스",
  "マスターテリオン": "마스터 테리온",
  "エセルドレーダ": "에셀드레다",
  "ナイア": "나이아",
  "九郎": "쿠로",
  "大十字九郎": "다이쥬지 쿠로",
  "メタトロン": "메타트론"
 },
 "items": [
  {
   "id": 17655,
   "key": "D0821le.txt:480",
   "file": "D0821le.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "逃げられな――――",
   "ko_candidate": "도망칠 수 없――――"
  },
  {
   "id": 17656,
   "key": "D0821le.txt:494",
   "file": "D0821le.txt",
   "line": 494,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「帰るぞ」",
   "ko_candidate": "「돌아가자」"
  },
  {
   "id": 17657,
   "key": "D0821le.txt:498",
   "file": "D0821le.txt",
   "line": 498,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……？　まさか、このまま放っておくつもりですか？」",
   "ko_candidate": "「…? 설마 이대로 내버려 두실 생각입니까?」"
  },
  {
   "id": 17658,
   "key": "D0821le.txt:502",
   "file": "D0821le.txt",
   "line": 502,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああ……心配あるまい。あの事なら、ウェスパシアヌスに委ねておけ。奴の事だ。丁重に扱ってくれるだろう」",
   "ko_candidate": "「그래… 걱정 말게｡ 그 일이라면 베스파시아누스에게 맡겨 두었어｡ 그 녀석이라면 정중하게 다뤄줄 거야」"
  },
  {
   "id": 17659,
   "key": "D0821le.txt:506",
   "file": "D0821le.txt",
   "line": 506,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「しかし……」",
   "ko_candidate": "「하지만…」"
  },
  {
   "id": 17660,
   "key": "D0821le.txt:510",
   "file": "D0821le.txt",
   "line": 510,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「それに」",
   "ko_candidate": "「게다가」"
  },
  {
   "id": 17661,
   "key": "D0821le.txt:514",
   "file": "D0821le.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "マスターテリオンは、 辛うじてヒト型を保っている肉塊を、依然、",
   "ko_candidate": "마스터 테리온은 겨우 인간의 형태를 유지하고 있는 살덩어리를"
  },
  {
   "id": 17662,
   "key": "D0821le.txt:516",
   "file": "D0821le.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "見下ろしたまま続ける。",
   "ko_candidate": "여전히 내려다보며 계속한다｡"
  },
  {
   "id": 17663,
   "key": "D0821le.txt:519",
   "file": "D0821le.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "陶然とする愛と、陶然とする憎悪を、 眸の奥に宿したままに。",
   "ko_candidate": "도취된 사랑과 도취된 증오를 눈동자 깊숙이 담은 채로｡"
  },
  {
   "id": 17664,
   "key": "D0821le.txt:522",
   "file": "D0821le.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "口元に亀裂が出来た。異形の微笑み。",
   "ko_candidate": "입가에 균열이 생겼다｡ 기괴한 미소｡"
  },
  {
   "id": 17665,
   "key": "D0821le.txt:527",
   "file": "D0821le.txt",
   "line": 527,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「何より、 この方がより皮肉的で愉快だ」",
   "ko_candidate": "「무엇보다도､ 이쪽이 더 아이러니하고 유쾌하군」"
  },
  {
   "id": 17666,
   "key": "D0821le.txt:533",
   "file": "D0821le.txt",
   "line": 533,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……御意に」",
   "ko_candidate": "「……알겠습니다」"
  },
  {
   "id": 17667,
   "key": "D0821le.txt:537",
   "file": "D0821le.txt",
   "line": 537,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エセルドレーダもまた肉塊を見下ろす。",
   "ko_candidate": "에셀드레다도 역시 살덩어리를 내려다본다｡"
  },
  {
   "id": 17668,
   "key": "D0821le.txt:538",
   "file": "D0821le.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "愛おしむ様に、夢を見る様な表情で。",
   "ko_candidate": "사랑스럽게 바라보듯､ 꿈을 꾸는 듯한 표정으로｡"
  },
  {
   "id": 17669,
   "key": "D0821le.txt:544",
   "file": "D0821le.txt",
   "line": 544,
   "speaker": "ナイア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「さて…… 今回もまた、そろそろ始まるね。」 「今度はもっと忌まわしく、致命的だと素敵だね……」",
   "ko_candidate": "「자… 이번에도 또､ 슬슬 시작되겠지｡ 이번엔 더 불길하고､ 치명적이라니 멋지군…」"
  },
  {
   "id": 17670,
   "key": "D0821le.txt:555",
   "file": "D0821le.txt",
   "line": 555,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ナイアが嗤いながら、闇に消える。",
   "ko_candidate": "나이아가 웃으며､ 어둠 속으로 사라진다｡"
  },
  {
   "id": 17671,
   "key": "D0821le.txt:557",
   "file": "D0821le.txt",
   "line": 557,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "マスターテリオンもまた、闇に溶ける。",
   "ko_candidate": "마스터 테리온도 역시､ 어둠 속에 녹아든다｡"
  },
  {
   "id": 17672,
   "key": "D0821le.txt:559",
   "file": "D0821le.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "最後にエセルドレーダが胸に手を置き、 恭しく頭を下げて、告げた。",
   "ko_candidate": "마지막으로 에셀드레다가 가슴에 손을 얹고､ 공손히 고개를 숙이며､ 말했다｡"
  },
  {
   "id": 17673,
   "key": "D0821le.txt:565",
   "file": "D0821le.txt",
   "line": 565,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「では、いずれまた……」",
   "ko_candidate": "「그럼､ 언젠가 또…」"
  },
  {
   "id": 17674,
   "key": "D0821le.txt:569",
   "file": "D0821le.txt",
   "line": 569,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、消える。",
   "ko_candidate": "그리고､ 사라진다｡"
  },
  {
   "id": 17675,
   "key": "D0821le.txt:570",
   "file": "D0821le.txt",
   "line": 570,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "雨降る夜空の下には、冷たくなっていくただの肉が、 残される――",
   "ko_candidate": "비 내리는 밤하늘 아래에는､ 차가워져 가는 단순한 살덩어리만이､ 남겨진다――"
  },
  {
   "id": 17676,
   "key": "D0821le.txt:581",
   "file": "D0821le.txt",
   "line": 581,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "焦がれていた。",
   "ko_candidate": "갈망했다｡"
  },
  {
   "id": 17677,
   "key": "D0821le.txt:582",
   "file": "D0821le.txt",
   "line": 582,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "恐怖よりも激しく",
   "ko_candidate": "공포보다도 격렬하게"
  },
  {
   "id": 17678,
   "key": "D0821le.txt:583",
   "file": "D0821le.txt",
   "line": 583,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "憎悪よりも熱く",
   "ko_candidate": "증오보다도 뜨겁게"
  },
  {
   "id": 17679,
   "key": "D0821le.txt:584",
   "file": "D0821le.txt",
   "line": 584,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "怨念にも似た切実さで――",
   "ko_candidate": "원념에도 비할 절실함으로――"
  },
  {
   "id": 17680,
   "key": "D0821le.txt:586",
   "file": "D0821le.txt",
   "line": 586,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何故だろう。",
   "ko_candidate": "왜일까｡"
  },
  {
   "id": 17681,
   "key": "D0821le.txt:587",
   "file": "D0821le.txt",
   "line": 587,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何故、最期に彼を想うのだろう。",
   "ko_candidate": "왜､ 마지막에 그를 생각하는 걸까｡"
  },
  {
   "id": 17682,
   "key": "D0821le.txt:591",
   "file": "D0821le.txt",
   "line": 591,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――九郎」",
   "ko_candidate": "「――쿠로」"
  },
  {
   "id": 17683,
   "key": "D0821le.txt:594",
   "file": "D0821le.txt",
   "line": 594,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分からない。",
   "ko_candidate": "모르겠다｡"
  },
  {
   "id": 17684,
   "key": "D0821le.txt:595",
   "file": "D0821le.txt",
   "line": 595,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "分かる術も無い。",
   "ko_candidate": "알 방법도 없다｡"
  },
  {
   "id": 17685,
   "key": "D0821le.txt:597",
   "file": "D0821le.txt",
   "line": 597,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが喩え、どれほど強い想いだったとしても",
   "ko_candidate": "그것이 비유하자면､ 아무리 강한 감정이었다 해도――죽음이 신속하게"
  },
  {
   "id": 17686,
   "key": "D0821le.txt:598",
   "file": "D0821le.txt",
   "line": 598,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――死が速やかに総てを奪い去っていく。 『暴君』の物語は、此処で、終わる。",
   "ko_candidate": "모든 것을 앗아가 버린다｡"
  },
  {
   "id": 17687,
   "key": "D0821le.txt:615",
   "file": "D0821le.txt",
   "line": 615,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……既に息絶えていたか」",
   "ko_candidate": "『폭군』의 이야기는､ 여기서､ 끝난다｡"
  },
  {
   "id": 17688,
   "key": "D0821le.txt:618",
   "file": "D0821le.txt",
   "line": 618,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「まさかまさか大十字九郎とメタトロン……奴ら如きにこの『暴君』が敗れようとは」 「だが―― 肝心なコレは無事であった」",
   "ko_candidate": "「……이미 숨이 끊어졌나｡ 설마설마 다이쥬지 쿠로와 메타트론… 그놈 따위에게 이 『폭군』이 패할 줄이야｡ 하지만――중요한 이것은 무사했다｡ 그걸로 됐어｡ 그것만으로 충분해｡ 실패는 몇 번이고 반복하면 되지｡ 그렇게 하면 돼｡ 그래｡"
  },
  {
   "id": 17689,
   "key": "D0821le.txt:625",
   "file": "D0821le.txt",
   "line": 625,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「それで良い。それだけで良い。 失敗など何度でも繰り返してやるさ。やるともさ。そう」",
   "ko_candidate": "그리고 언젠가 도달한다――지고의 예술에」 ――일단､ 이번에는｡"
  },
  {
   "id": 17690,
   "key": "D0821le.txt:628",
   "file": "D0821le.txt",
   "line": 628,
   "speaker": "ウェスパシアヌス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そしていつか辿り着く ――至高の芸術に」 ――とりあえず、今回は。",
   "ko_candidate": "【File09:QUO VADIS】closed<PRE>."
  }
 ]
}