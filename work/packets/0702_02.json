   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……えーと。 お知り合い……ですかぁ？」",
   "ko_candidate": "「우와아아아아! 보스우우우우! 보스우우우우우!」"
  },
  {
