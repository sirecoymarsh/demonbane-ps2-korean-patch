  "rate": 0.88
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ティトゥス": "티투스",
  "ウィンフィールド": "윈필드",
  "アトランティス": "아틀란티스",
  "破壊ロボ": "파괴 로봇",
  "デモンベイン": "데몬베인",
  "クトゥグア": "크투가",
  "イタクァ": "이타콰"
 },
 "items": [
  {
   "id": 38850,
   "key": "D1410le.txt:502",
   "file": "D1410le.txt",
   "line": 502,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……何も在りはしない。ただ、更に救い難い渇きが待っていただけだ。",
   "ko_candidate": "…아무것도 없었다｡ 단지 더욱 구원받기 힘든 갈증만이 기다리고 있었을 뿐｡"
  },
  {
   "id": 38851,
   "key": "D1410le.txt:503",
   "file": "D1410le.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "致命的な渇きは魂をも枯渇させ、怠惰が身を蝕んだ。",
   "ko_candidate": "치명적인 갈증은 영혼마저 고갈시키고 나태함이 몸을 좀먹었다｡"
  },
  {
   "id": 38852,
   "key": "D1410le.txt:505",
   "file": "D1410le.txt",
   "line": 505,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その渇きを一時とはいえ潤してくれたのが、あの拳闘士……皮肉なことに、自分が唾棄していた「人」そのものだった。",
   "ko_candidate": "그 갈증을 잠시나마 적셔준 것이 저 권투선수… 아이러니하게도 자신이 경멸했던 '인간' 그 자체였다｡"
  },
  {
   "id": 38853,
   "key": "D1410le.txt:507",
   "file": "D1410le.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "愉しかった。",
   "ko_candidate": "즐거웠다｡"
  },
  {
   "id": 38854,
   "key": "D1410le.txt:508",
   "file": "D1410le.txt",
   "line": 508,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "久々に魂が震えた。",
   "ko_candidate": "오랜만에 영혼이 떨렸다｡"
  },
  {
   "id": 38855,
   "key": "D1410le.txt:509",
   "file": "D1410le.txt",
   "line": 509,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遂に求めていた境地を手に入れたとさえ思った。",
   "ko_candidate": "마침내 추구하던 경지를 손에 넣었다고까지 생각했다｡"
  },
  {
   "id": 38856,
   "key": "D1410le.txt:511",
   "file": "D1410le.txt",
   "line": 511,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、その総ては、まるで砂の様にこの掌から零れていった。",
   "ko_candidate": "하지만 그 모든 것이 마치 모래처럼 이 손바닥에서 흘러내렸다｡"
  },
  {
   "id": 38857,
   "key": "D1410le.txt:513",
   "file": "D1410le.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何故だろう？",
   "ko_candidate": "왜일까?"
  },
  {
   "id": 38858,
   "key": "D1410le.txt:514",
   "file": "D1410le.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何が間違っていたのだろう？",
   "ko_candidate": "무엇이 잘못되었던 걸까?"
  },
  {
   "id": 38859,
   "key": "D1410le.txt:515",
   "file": "D1410le.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスは己の掌を見つめる。",
   "ko_candidate": "티투스는 자신의 손바닥을 바라본다｡"
  },
  {
   "id": 38860,
   "key": "D1410le.txt:516",
   "file": "D1410le.txt",
   "line": 516,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "４つの掌をじっと見つめる。",
   "ko_candidate": "네 개의 손바닥을 뚫어지게 바라본다｡"
  },
  {
   "id": 38861,
   "key": "D1410le.txt:520",
   "file": "D1410le.txt",
   "line": 520,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……そうか。単純なことであったな」",
   "ko_candidate": "「…그렇군｡ 단순한 일이었구나」"
  },
  {
   "id": 38862,
   "key": "D1410le.txt:526",
   "file": "D1410le.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィンフィールド。",
   "ko_candidate": "윈필드｡"
  },
  {
   "id": 38863,
   "key": "D1410le.txt:527",
   "file": "D1410le.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの強さは「人としての」強さだったのだ。",
   "ko_candidate": "저 강함은 '인간으로서의' 강함이었던 것이다｡"
  },
  {
   "id": 38864,
   "key": "D1410le.txt:528",
   "file": "D1410le.txt",
   "line": 528,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの闘いは「人としての」闘いだったのだ。",
   "ko_candidate": "저 싸움은 '인간으로서의' 싸움이었던 것이다｡"
  },
  {
   "id": 38865,
   "key": "D1410le.txt:530",
   "file": "D1410le.txt",
   "line": 530,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人の身で在りながら、戦士の路を突き進む者こそを、闘いの神は祝福する。",
   "ko_candidate": "인간의 몸으로 있으면서 전사의 길을 돌진하는 자야말로 싸움의 신이 축복하는 것이다｡"
  },
  {
   "id": 38866,
   "key": "D1410le.txt:531",
   "file": "D1410le.txt",
   "line": 531,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを捨て、安易な路を選択した自分が、一体どうしてその恩恵を授かろうか。",
   "ko_candidate": "그것을 버리고 안이한 길을 선택한 자신이 도대체 어떻게 그 은혜를 받을 수 있겠는가｡"
  },
  {
   "id": 38867,
   "key": "D1410le.txt:538",
   "file": "D1410le.txt",
   "line": 538,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ははははは……何たる間抜けよ」",
   "ko_candidate": "「하하하하… 얼마나 어리석었던가」"
  },
  {
   "id": 38868,
   "key": "D1410le.txt:541",
   "file": "D1410le.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……疲れた。だるい。",
   "ko_candidate": "…피곤하다｡ 나른하다｡"
  },
  {
   "id": 38869,
   "key": "D1410le.txt:542",
   "file": "D1410le.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう休もう。",
   "ko_candidate": "이제 쉬자｡"
  },
  {
   "id": 38870,
   "key": "D1410le.txt:543",
   "file": "D1410le.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "もう休める。",
   "ko_candidate": "이제 쉴 수 있다｡"
  },
  {
   "id": 38871,
   "key": "D1410le.txt:544",
   "file": "D1410le.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こんな渇きに、苛まれずに済む。",
   "ko_candidate": "이런 갈증에 시달리지 않아도 된다｡"
  },
  {
   "id": 38872,
   "key": "D1410le.txt:546",
   "file": "D1410le.txt",
   "line": 546,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。",
   "ko_candidate": "그래｡"
  },
  {
   "id": 38873,
   "key": "D1410le.txt:547",
   "file": "D1410le.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この慈悲深い無限の灼熱が、総てを終わらせてくれる。",
   "ko_candidate": "이 자비로운 무한의 작열이 모든 것을 끝내줄 것이다｡"
  },
  {
   "id": 38874,
   "key": "D1410le.txt:553",
   "file": "D1410le.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分がこの世界に存在していた、そんな痕跡を一切遺さずに――",
   "ko_candidate": "자신이 이 세상에 존재했다는､ 그런 흔적조차 남기지 않고――"
  },
  {
   "id": 38875,
   "key": "D1410le.txt:554",
   "file": "D1410le.txt",
   "line": 554,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てを無かったことにしてくれる。",
   "ko_candidate": "모든 것을 없었던 일로 만들어줄 것이다｡"
  },
  {
   "id": 38876,
   "key": "D1410ru.txt:9",
   "file": "D1410ru.txt",
   "line": 9,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アトランティス・トルネード・ストライク！」",
   "ko_candidate": "「아틀란티스 토네이도 스트라이크!」"
  },
  {
   "id": 38877,
   "key": "D1410ru.txt:13",
   "file": "D1410ru.txt",
   "line": 13,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『夢幻心母』に到着してすぐ、破壊ロボを出撃させる巨大なゲートを発見した。躊躇うことなく突貫する。",
   "ko_candidate": "『몽환심모』에 도착하자마자 파괴 로봇을 출격시키는 거대한 게이트를 발견했다｡ 주저 없이 돌진한다｡"
  },
  {
   "id": 38878,
   "key": "D1410ru.txt:16",
   "file": "D1410ru.txt",
   "line": 16,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを回転させながらドリルのような蹴りを、出てくる破壊ロボにぶちかます。",
   "ko_candidate": "데몬베인을 회전시키며 드릴 같은 킥을 나오는 파괴 로봇에게 날린다｡"
  },
  {
   "id": 38879,
   "key": "D1410ru.txt:18",
   "file": "D1410ru.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最初の破壊ロボを粉微塵にして、さらに空間反転エネルギーの竜巻は後続の破壊ロボ達を巻き込み、掻き混ぜ、噛み砕く。",
   "ko_candidate": "첫 번째 파괴 로봇을 산산조각 내고､ 더 나아가 공간 반전 에너지의 회오리는 후속 파괴 로봇들을 휘말리게 하고､ 뒤섞고､ 씹어 부순다｡"
  },
  {
   "id": 38880,
   "key": "D1410ru.txt:19",
   "file": "D1410ru.txt",
   "line": 19,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊ロボをことごとく粉砕しながら、墜ち続ける。",
   "ko_candidate": "파괴 로봇을 모조리 분쇄하면서 계속 떨어진다｡"
  },
  {
   "id": 38881,
   "key": "D1410ru.txt:25",
   "file": "D1410ru.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゲートの底に着地した。",
   "ko_candidate": "게이트의 바닥에 착지했다｡"
  },
  {
   "id": 38882,
   "key": "D1410ru.txt:26",
   "file": "D1410ru.txt",
   "line": 26,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭上からは残骸となった破壊ロボのパーツが雨のように降ってくる。",
   "ko_candidate": "머리 위로는 잔해가 된 파괴 로봇의 부품들이 비처럼 쏟아진다｡"
  },
  {
   "id": 38883,
   "key": "D1410ru.txt:28",
   "file": "D1410ru.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲を見渡す。ここは、格納庫か。",
   "ko_candidate": "주위를 둘러본다｡ 여기는 격납고인가｡"
  },
  {
   "id": 38884,
   "key": "D1410ru.txt:33",
   "file": "D1410ru.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "広大な空間を埋め尽くす破壊ロボの群れ。",
   "ko_candidate": "광대한 공간을 가득 메운 파괴 로봇의 무리｡"
  },
  {
   "id": 38885,
   "key": "D1410ru.txt:34",
   "file": "D1410ru.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、どれだけ数を揃えたところで、もはやデモンベインの敵ではない。",
   "ko_candidate": "하지만 아무리 수를 모아봤자 이제는 데몬베인의 적수가 되지 못한다｡"
  },
  {
   "id": 38886,
   "key": "D1410ru.txt:42",
   "file": "D1410ru.txt",
   "line": 42,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『クトゥグア』と『イタクァ』を連射する。",
   "ko_candidate": "『크투가』와 『이타콰』를 연사한다｡"
  },
  {
   "id": 38887,
   "key": "D1410ru.txt:46",
   "file": "D1410ru.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次々と粉砕される破壊ロボ。",
   "ko_candidate": "차례차례 분쇄되는 파괴 로봇｡"
  },
  {
   "id": 38888,
   "key": "D1410ru.txt:47",
   "file": "D1410ru.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "弾丸を逃れた機体がデモンベインに接近し、殴りかかってきた。",
   "ko_candidate": "총알을 피한 기체가 데몬베인에 접근해 주먹을 날려왔다｡"
  },
  {
   "id": 38889,
   "key": "D1410ru.txt:53",
   "file": "D1410ru.txt",
   "line": 53,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２挺拳銃を仕舞い、バルザイの偃月刀を招喚。両断する。",
   "ko_candidate": "권총 두 자루를 집어넣고 바르자이의 언월도를 소환한다｡ 양단한다｡"
  }
 ]
}