  {
   "id": 1019,
   "key": "D0109.txt:586",
   "file": "D0109.txt",
   "line": 586,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「くそっ、メタトロンはどうしたんだ!? まさか、やられちまったのか!?」",
   "ko_candidate": "「젠장､ 메타트론은 어떻게 된 거야!? 설마 당해버린 건가!?」"
