   "key": "D0109.txt:635",
   "file": "D0109.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地盤が脆かったのか、ミサイルによって着地地点が崩れ落ちた。 そしてそこにぽっかりと",
