  {
   "id": 1023,
   "key": "D0109.txt:605",
   "file": "D0109.txt",
   "line": 605,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふははははは！　ほら、ミサイルのシャワーである！」",
   "ko_candidate": "「후하하하하! 자､ 미사일 샤워다!」"
