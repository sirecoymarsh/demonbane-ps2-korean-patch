   "file": "D0109.txt",
   "line": 439,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "周囲を震撼させる気配は、闘気か殺意か。",
   "ko_candidate": "다시 두 천사는 정면에서 노려보았다｡"
  },
  {
   "id": 1008,
   "key": "D0109.txt:447",
