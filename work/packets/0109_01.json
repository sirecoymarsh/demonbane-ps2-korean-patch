   "key": "D0109.txt:470",
   "file": "D0109.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "白の天使が、夜を裂く光刃を十字に構える。",
