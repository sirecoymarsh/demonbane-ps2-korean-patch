  },
  {
   "id": 1026,
   "key": "D0109.txt:639",
   "file": "D0109.txt",
   "line": 639,
   "speaker": "九郎",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "地の底まで続いていそうな巨大な―― 「穴ぁぁぁぁぁぁぁぁぁぁ――――っ!?」",
   "ko_candidate": "「뭐､ 뭐야 이런 곳에 구멍이 있다니이이이잇!?!」"
  },
  {
   "id": 1027,
   "key": "D0109.txt:655",
   "file": "D0109.txt",
   "line": 655,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
