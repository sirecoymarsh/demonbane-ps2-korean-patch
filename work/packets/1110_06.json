 "items": [
  {
   "id": 25794,
   "key": "D1110ru.txt:664",
   "file": "D1110ru.txt",
   "line": 664,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "灼きついて、消えなくて、いつしか大きくなっていた。",
   "ko_candidate": "새겨져서､ 지워지지 않고､ 어느새 커져 있었다｡"
  },
  {
   "id": 25795,
   "key": "D1110ru.txt:665",
   "file": "D1110ru.txt",
   "line": 665,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の心を埋め尽くすくらいに。",
   "ko_candidate": "루리의 마음을 가득 채울 만큼｡"
  },
  {
   "id": 25796,
   "key": "D1110ru.txt:670",
   "file": "D1110ru.txt",
   "line": 670,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瞳を開ける。",
   "ko_candidate": "눈을 뜬다｡"
  },
  {
   "id": 25797,
   "key": "D1110ru.txt:672",
   "file": "D1110ru.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つの瞳ではっきりと見据える。",
   "ko_candidate": "두 눈으로 분명히 바라본다｡"
  },
  {
   "id": 25798,
   "key": "D1110ru.txt:674",
   "file": "D1110ru.txt",
   "line": 674,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵の姿を。",
   "ko_candidate": "적의 모습을｡"
  },
  {
   "id": 25799,
   "key": "D1110ru.txt:675",
   "file": "D1110ru.txt",
   "line": 675,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大十字九郎が戦っている、敵の姿を。",
   "ko_candidate": "다이쥬지 쿠로가 싸우고 있는､ 적의 모습을｡"
  },
  {
   "id": 25800,
   "key": "D1110ru.txt:679",
   "file": "D1110ru.txt",
   "line": 679,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だからわたくしも戦わないと。大十字さんは逃げないと言ってました。後味の悪い思いをしたくないと。自分に出来る事をやらなければと。 ――わたくしも、逃げません」",
   "ko_candidate": "「그래서 저도 싸워야 해요｡ 다이쥬지 씨는 도망가지 않겠다고 했어요｡ 찝찝한 기분을 느끼고 싶지 않다고｡ 자신이 할 수 있는 일을 해야 한다고｡ ――저도､ 도망가지 않겠습니다」"
  },
  {
   "id": 25801,
   "key": "D1110ru.txt:686",
   "file": "D1110ru.txt",
   "line": 686,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「………………」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 25802,
   "key": "D1110ru.txt:690",
   "file": "D1110ru.txt",
   "line": 690,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットの中を、重い沈黙が満たしていた。",
   "ko_candidate": "콕핏 안을､ 무거운 침묵이 채우고 있었다｡"
  },
  {
   "id": 25803,
   "key": "D1110ru.txt:692",
   "file": "D1110ru.txt",
   "line": 692,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルは何も喋らない。",
   "ko_candidate": "알은 아무 말도 하지 않는다｡"
  },
  {
   "id": 25804,
   "key": "D1110ru.txt:694",
   "file": "D1110ru.txt",
   "line": 694,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "瑠璃の言葉に呆れたのか、それとも……気圧されたのか。",
   "ko_candidate": "루리의 말에 어이없어 한 건지､ 아니면…… 기가 죽은 건지｡"
  },
  {
   "id": 25805,
   "key": "D1110ru.txt:696",
   "file": "D1110ru.txt",
   "line": 696,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ただ黙って瑠璃から視線を外し、通信機に向かって応じた。",
   "ko_candidate": "그저 말없이 루리에게서 시선을 돌려､ 통신기를 향해 응답했다｡"
  },
  {
   "id": 25806,
   "key": "D1110ru.txt:701",
   "file": "D1110ru.txt",
   "line": 701,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「執事、撤退は無しだ。このまま敵を迎え撃つ」",
   "ko_candidate": "「집사､ 철수는 없다｡ 이대로 적을 맞이하겠다」"
  },
  {
   "id": 25807,
   "key": "D1110ru.txt:705",
   "file": "D1110ru.txt",
   "line": 705,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "通信機の向こうからは悲鳴が聴こえ、瑠璃の驚いた視線がアルを捉える。",
   "ko_candidate": "통신기 너머에서 비명이 들리고､ 루리의 놀란 시선이 알을 포착한다｡"
  },
  {
   "id": 25808,
   "key": "D1110ru.txt:706",
   "file": "D1110ru.txt",
   "line": 706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "振り向かずにアルは言った。",
   "ko_candidate": "돌아보지 않고 알이 말했다｡"
  },
  {
   "id": 25809,
   "key": "D1110ru.txt:711",
   "file": "D1110ru.txt",
   "line": 711,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「今度、無様を曝してみろ。コクピットから外に投げ捨ててやる」",
   "ko_candidate": "「이번에､ 볼품없는 모습을 보여봐라｡ 콕핏에서 밖으로 내던져 버리겠다」"
  },
  {
   "id": 25810,
   "key": "D1110ru.txt:716",
   "file": "D1110ru.txt",
   "line": 716,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……はいっ！」",
   "ko_candidate": "「……네!」"
  },
  {
   "id": 25811,
   "key": "D1110ru.txt:719",
   "file": "D1110ru.txt",
   "line": 719,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力強く、瑠璃は頷いた。",
   "ko_candidate": "힘차게､ 루리는 고개를 끄덕였다｡"
  },
  {
   "id": 25812,
   "key": "D1110ru.txt:729",
   "file": "D1110ru.txt",
   "line": 729,
   "speaker": "ソーニャ（通信）",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「そんなぁぁぁ！　なんてことホザきやがりますですか、古新聞にも劣る二束三文の古本娘さんはぁぁっ!?」",
   "ko_candidate": "「그럴 순 없어요! 무슨 미친 소리를 하시는 겁니까､ 헌 신문만도 못한､ 이푼어치도 안 되는 고서 아가씨는!? 마침내 매독이 뇌까지 퍼졌습니까､ 성도착자 전용 창녀 양반!」"
  },
  {
   "id": 25813,
   "key": "D1110ru.txt:738",
   "file": "D1110ru.txt",
   "line": 738,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「色々な意味で黙ってろ」",
   "ko_candidate": "「여러 가지 의미로 입 다물어라」"
  },
  {
   "id": 25814,
   "key": "D1110ru.txt:742",
   "file": "D1110ru.txt",
   "line": 742,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ですが……！」",
   "ko_candidate": "「하지만……!」"
  },
  {
   "id": 25815,
   "key": "D1110ru.txt:746",
   "file": "D1110ru.txt",
   "line": 746,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ヲヲをヲヲヲヲおヲヲおおおヲヲヲおヲヲをヲヲォォォォ！」",
   "ko_candidate": "「오오를오오오오오오오오오오오오오오오오오오오오오오오오오!」"
  },
  {
   "id": 25816,
   "key": "D1110ru.txt:753",
   "file": "D1110ru.txt",
   "line": 753,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラの咆吼が轟いた。",
   "ko_candidate": "칼리굴라의 포효가 울려 퍼졌다｡"
  },
  {
   "id": 25817,
   "key": "D1110ru.txt:755",
   "file": "D1110ru.txt",
   "line": 755,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大蛇の腕がのたうち、とぐろを巻き、大地を抉る。",
   "ko_candidate": "대사의 팔이 꿈틀거리며､ 똬리를 틀고､ 대지를 파헤친다｡"
  },
  {
   "id": 25818,
   "key": "D1110ru.txt:760",
   "file": "D1110ru.txt",
   "line": 760,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――来る！　切るぞ！」",
   "ko_candidate": "「――온다! 베겠다!」"
  },
  {
   "id": 25819,
   "key": "D1110ru.txt:765",
   "file": "D1110ru.txt",
   "line": 765,
   "speaker": "ウィンフィールド（通信）",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ちょっ……！」",
   "ko_candidate": "「잠깐……!」"
  },
  {
   "id": 25820,
   "key": "D1110ru.txt:769",
   "file": "D1110ru.txt",
   "line": 769,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轟オオオォォォォォッ！",
   "ko_candidate": "쾅오오오오오오오오!"
  },
  {
   "id": 25821,
   "key": "D1110ru.txt:775",
   "file": "D1110ru.txt",
   "line": 775,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "まるで津波の様に、倒壊して波打つビルの群れ。",
   "ko_candidate": "마치 쓰나미처럼､ 무너져 물결치는 빌딩의 무리｡"
  },
  {
   "id": 25822,
   "key": "D1110ru.txt:776",
   "file": "D1110ru.txt",
   "line": 776,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舞い上がる瓦礫と土煙の向こう、鋼鉄の大蛇が迫り来る。",
   "ko_candidate": "날아오르는 잔해와 먼지 구름 너머､ 강철의 대사가 다가온다｡"
  },
  {
   "id": 25823,
   "key": "D1110ru.txt:778",
   "file": "D1110ru.txt",
   "line": 778,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鋼鉄の爪は蛇の牙の如く、獲物を噛み砕かんと兇悪な光を湛える。",
   "ko_candidate": "강철 발톱은 뱀의 이빨처럼､ 먹이를 물어뜯으려는 듯 흉악한 빛을 머금고 있다｡"
  },
  {
   "id": 25824,
   "key": "D1110ru.txt:785",
   "file": "D1110ru.txt",
   "line": 785,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やるぞ！」",
   "ko_candidate": "「간다!」"
  },
  {
   "id": 25825,
   "key": "D1110ru.txt:793",
   "file": "D1110ru.txt",
   "line": 793,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「はい……！　断鎖術式、 壱号ティマイオス！ 弐号クリティアス！　解放！」 「くぅぅぅぅぅぅ……ッ！」",
   "ko_candidate": "「네……! 단쇄술식､ 1호 티마이오스! 2호 크리티오스! 해방! 크으으으으으으……읏!」"
  },
  {
   "id": 25826,
   "key": "D1110ru.txt:802",
   "file": "D1110ru.txt",
   "line": 802,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "体内で暴れる衝動と衝撃を、歯を食い縛って堪える。",
   "ko_candidate": "체내에서 날뛰는 충동과 충격을､ 이를 악물고 견딘다｡"
  },
  {
   "id": 25827,
   "key": "D1110ru.txt:804",
   "file": "D1110ru.txt",
   "line": 804,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重力が無くなった。",
   "ko_candidate": "중력이 사라졌다｡"
  },
  {
   "id": 25828,
   "key": "D1110ru.txt:806",
   "file": "D1110ru.txt",
   "line": 806,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラーケンの爪をかわして、デモンベインが跳躍する。",
   "ko_candidate": "크라켄의 발톱을 피해､ 데몬베인이 도약한다｡"
  },
  {
   "id": 25829,
   "key": "D1110ru.txt:812",
   "file": "D1110ru.txt",
   "line": 812,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "クラーケンの上空。",
   "ko_candidate": "크라켄의 상공｡"
  },
  {
   "id": 25830,
   "key": "D1110ru.txt:813",
   "file": "D1110ru.txt",
   "line": 813,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "跳躍の頂点に達したところで、脚部シールドは再びエネルギーを解放した。",
   "ko_candidate": "도약의 정점에 도달한 순간､ 다리 부분의 실드가 다시 에너지를 방출했다｡"
  },
  {
   "id": 25831,
   "key": "D1110ru.txt:815",
   "file": "D1110ru.txt",
   "line": 815,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "シールドから紫電が迸り、空間が捩れ、デモンベインは鮮やかな宙返りを決めて、クラーケンに向かって降下する。",
   "ko_candidate": "실드에서 번개가 튀어나와 공간이 뒤틀리며､ 데몬베인은 화려한 공중제비를 결정적으로 성공시키고 크라켄을 향해 하강한다｡"
  },
  {
   "id": 25832,
   "key": "D1110ru.txt:825",
   "file": "D1110ru.txt",
   "line": 825,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「はぁぁぁぁぁぁ……ッ！ 面ッッッッッッ！」",
   "ko_candidate": "「하아아아아아아……읏! 얼굴이다아아아아!」"
  },
  {
   "id": 25833,
   "key": "D1110ru.txt:831",
   "file": "D1110ru.txt",
   "line": 831,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぬおおおあっ！」",
   "ko_candidate": "「누오오오앗!」"
  }
 ]
}