{
 "packet": "1515_02",
 "scene": "1515",
 "anchor": {
  "hit": 10,
  "total": 11,
  "rate": 0.909
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ライカ": "라이카"
 },
 "items": [
  {
   "id": 47453,
   "key": "D1515le.txt:68",
   "file": "D1515le.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "時空の狭間から抜け、再び現実空間に顕現する。",
   "ko_candidate": "시공의 틈새에서 빠져나와､ 다시 현실 공간에 나타난다｡"
  },
  {
   "id": 47454,
   "key": "D1515le.txt:69",
   "file": "D1515le.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光が、溢れた。",
   "ko_candidate": "빛이､ 넘쳐났다｡"
  },
  {
   "id": 47455,
   "key": "D1515le.txt:76",
   "file": "D1515le.txt",
   "line": 76,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……ああ」",
   "ko_candidate": "「……아아」"
  },
  {
   "id": 47456,
   "key": "D1515le.txt:81",
   "file": "D1515le.txt",
   "line": 81,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "視界を覆い尽くす、圧倒的な蒼。荘厳な蒼。",
   "ko_candidate": "시야를 뒤덮는､ 압도적인 푸름｡ 장엄한 푸름｡"
  },
  {
   "id": 47457,
   "key": "D1515le.txt:83",
   "file": "D1515le.txt",
   "line": 83,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――地球。",
   "ko_candidate": "――지구｡"
  },
  {
   "id": 47458,
   "key": "D1515le.txt:85",
   "file": "D1515le.txt",
   "line": 85,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蒼い母なる星が、まるで手を伸ばせば届きそうな程の距離で、輝いている。",
   "ko_candidate": "푸른 어머니별이､ 마치 손을 뻗으면 닿을 것 같은 거리에서､ 빛나고 있다｡"
  },
  {
   "id": 47459,
   "key": "D1515le.txt:87",
   "file": "D1515le.txt",
   "line": 87,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あの蒼だ。",
   "ko_candidate": "저 푸름이다｡"
  },
  {
   "id": 47460,
   "key": "D1515le.txt:88",
   "file": "D1515le.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己が、求めた蒼だ。",
   "ko_candidate": "자신이､ 갈망했던 푸름이다｡"
  },
  {
   "id": 47461,
   "key": "D1515le.txt:89",
   "file": "D1515le.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "深い深い、空の蒼だ。",
   "ko_candidate": "깊고 깊은､ 하늘의 푸름이다｡"
  },
  {
   "id": 47462,
   "key": "D1515le.txt:91",
   "file": "D1515le.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ。何を見失うものがある？",
   "ko_candidate": "그래｡ 무엇을 잃어버릴 게 있나?"
  },
  {
   "id": 47463,
   "key": "D1515le.txt:92",
   "file": "D1515le.txt",
   "line": 92,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己はようやく、あの蒼を――",
   "ko_candidate": "자신은 드디어､ 저 푸름을――"
  },
  {
   "id": 47464,
   "key": "D1515le.txt:103",
   "file": "D1515le.txt",
   "line": 103,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「いつかボクが、ライカをあの青空に連れていくから」",
   "ko_candidate": "「언젠가 내가､ 라이카를 저 푸른 하늘로 데려갈 테니까」"
  },
  {
   "id": 47465,
   "key": "D1515le.txt:107",
   "file": "D1515le.txt",
   "line": 107,
   "speaker": "リューガ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「やくそく、するよ――」",
   "ko_candidate": "「약속､ 할게――」"
  },
  {
   "id": 47466,
   "key": "D1515le.txt:115",
   "file": "D1515le.txt",
   "line": 115,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アアア嗚呼アアアアアあああアアああああアア！」",
   "ko_candidate": "「아아아아아아아아아아아아아아아아아아아!」"
  },
  {
   "id": 47467,
   "key": "D1515le.txt:118",
   "file": "D1515le.txt",
   "line": 118,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "傷が――炎える。",
   "ko_candidate": "상처가――불타오른다｡"
  },
  {
   "id": 47468,
   "key": "D1515le.txt:119",
   "file": "D1515le.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "炎が、己を、灼き尽くす――",
   "ko_candidate": "불꽃이､ 자신을､ 태워버린다――"
  },
  {
   "id": 47469,
   "key": "D1515le.txt:123",
   "file": "D1515le.txt",
   "line": 123,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――――――――――」",
   "ko_candidate": "「――――――――――――――」"
  },
  {
   "id": 47470,
   "key": "D1515le.txt:126",
   "file": "D1515le.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ふと。",
   "ko_candidate": "문득｡"
  },
  {
   "id": 47471,
   "key": "D1515le.txt:127",
   "file": "D1515le.txt",
   "line": 127,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処までも蒼い光に、違和感を見つけた。",
   "ko_candidate": "끝없이 푸른 빛에､ 위화감을 발견했다｡"
  },
  {
   "id": 47472,
   "key": "D1515le.txt:129",
   "file": "D1515le.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僅かに歪み、揺らぐ蒼い光。",
   "ko_candidate": "약간 일그러지고､ 흔들리는 푸른 빛｡"
  },
  {
   "id": 47473,
   "key": "D1515le.txt:130",
   "file": "D1515le.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは本当に些細な、だが確実に存在する怪異。",
   "ko_candidate": "그것은 정말 사소한､ 하지만 확실히 존재하는 괴이｡"
  },
  {
   "id": 47474,
   "key": "D1515le.txt:131",
   "file": "D1515le.txt",
   "line": 131,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "歪みは次第に止め処と無く大きくなり――",
   "ko_candidate": "일그러짐은 점점 걷잡을 수 없이 커져가고――"
  },
  {
   "id": 47475,
   "key": "D1515le.txt:136",
   "file": "D1515le.txt",
   "line": 136,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何だ？　これは？」",
   "ko_candidate": "「……뭐지? 이건?」"
  },
  {
   "id": 47476,
   "key": "D1515le.txt:140",
   "file": "D1515le.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燦々と輝く闇が、無明の光が、溢れ出す。",
   "ko_candidate": "찬란하게 빛나는 어둠이､ 무명의 빛이､ 넘쳐흐른다｡"
  },
  {
   "id": 47477,
   "key": "D1515le.txt:148",
   "file": "D1515le.txt",
   "line": 148,
   "speaker": "リューガ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――ッッッッッ!?」",
   "ko_candidate": "「――――――읏읏읏읏읏!?」"
  },
  {
   "id": 47478,
   "key": "D1515le.txt:160",
   "file": "D1515le.txt",
   "line": 160,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇黒。",
   "ko_candidate": "암흑｡"
  },
  {
   "id": 47479,
   "key": "D1515le.txt:161",
   "file": "D1515le.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "完全な無明の闇。",
   "ko_candidate": "완전한 무명의 어둠｡"
  },
  {
   "id": 47480,
   "key": "D1515le.txt:162",
   "file": "D1515le.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "纏わりつく、粘つく闇の中に、俺は浮かんでいる。",
   "ko_candidate": "휘감기는､ 끈적이는 어둠 속에､ 나는 떠 있다｡"
  },
  {
   "id": 47481,
   "key": "D1515le.txt:164",
   "file": "D1515le.txt",
   "line": 164,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "沈んでいる。",
   "ko_candidate": "가라앉고 있다｡"
  },
  {
   "id": 47482,
   "key": "D1515le.txt:165",
   "file": "D1515le.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "墜ちている。",
   "ko_candidate": "추락하고 있다｡"
  },
  {
   "id": 47483,
   "key": "D1515le.txt:166",
   "file": "D1515le.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昇っている。",
   "ko_candidate": "상승하고 있다｡"
  },
  {
   "id": 47484,
   "key": "D1515le.txt:168",
   "file": "D1515le.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いずれの感覚も正しくはなかった。",
   "ko_candidate": "어느 감각도 정확하지는 않았다｡"
  },
  {
   "id": 47485,
   "key": "D1515le.txt:170",
   "file": "D1515le.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無理に喩えるとするなら、それは何か異常な角度、三次元に生きる存在には、認識出来ない在り得ざる角度へと、進んでいるようだった。",
   "ko_candidate": "억지로 비유하자면､ 그것은 무언가 이상한 각도､ 3차원에 사는 존재로는 인식할 수 없는 있을 수 없는 각도로 나아가고 있는 것 같았다｡"
  },
  {
   "id": 47486,
   "key": "D1515le.txt:172",
   "file": "D1515le.txt",
   "line": 172,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この異常な闇は何処まで続くのだろうか。",
   "ko_candidate": "이 이상한 어둠은 어디까지 이어지는 걸까｡"
  },
  {
   "id": 47487,
   "key": "D1515le.txt:173",
   "file": "D1515le.txt",
   "line": 173,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつまで続くのだろうか。",
   "ko_candidate": "언제까지 계속될까｡"
  },
  {
   "id": 47488,
   "key": "D1515le.txt:175",
   "file": "D1515le.txt",
   "line": 175,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分からない。",
   "ko_candidate": "모르겠다｡"
  },
  {
   "id": 47489,
   "key": "D1515le.txt:177",
   "file": "D1515le.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "此処は空間も時間も理解できない領域だ。",
   "ko_candidate": "여기는 공간도 시간도 이해할 수 없는 영역이다｡"
  },
  {
   "id": 47490,
   "key": "D1515le.txt:178",
   "file": "D1515le.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何もかもが鎖されている。",
   "ko_candidate": "모든 것이 속박되어 있다｡"
  },
  {
   "id": 47491,
   "key": "D1515le.txt:180",
   "file": "D1515le.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光も音も空気も気配も生も死も創造も破滅も刹那も永劫も。",
   "ko_candidate": "빛도 소리도 공기도 기척도 삶도 죽음도 창조도 파멸도 찰나도 영겁도｡"
  },
  {
   "id": 47492,
   "key": "D1515le.txt:181",
   "file": "D1515le.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺は、混沌の闇に囚われている。",
   "ko_candidate": "나는､ 혼돈의 어둠에 사로잡혀 있다｡"
  }
 ]
}