 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アル": "알",
  "大十字九郎": "다이쥬지 쿠로",
  "九郎": "쿠로"
 },
 "items": [
  {
   "id": 4084,
   "key": "D0401.txt:22",
   "file": "D0401.txt",
   "line": 22,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの主となってから、けっこう経った。",
   "ko_candidate": "알의 주인이 된 지 꽤 오래되었다｡"
  },
  {
   "id": 4085,
   "key": "D0401.txt:23",
   "file": "D0401.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "この人外娘が俺にもたらしたものは、何も戦いの人生ばかりではない。",
   "ko_candidate": "이 비인간 소녀가 내게 가져다준 것은 전투의 인생만이 아니었다｡ 끊임없이 이어지는 하찮은 일상생활｡"
  },
  {
   "id": 4086,
   "key": "D0401.txt:34",
   "file": "D0401.txt",
   "line": 34,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "連綿と続く他愛もない日々の生活。その領域にすら怪異は侵食し、日常を平穏から隔絶し、変化を強制する。俺の時間は魔に囚われている。",
   "ko_candidate": "그 영역에조차 괴이가 침식하여 일상을 평온에서 격리시키고 변화를 강요한다｡ 내 시간은 마에 사로잡혀 있다｡"
  },
  {
   "id": 4087,
   "key": "D0401.txt:46",
   "file": "D0401.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "人がシャワーを浴びに行っている時間。",
   "ko_candidate": "「………………」 사람이 샤워를 하러 간 시간｡"
  },
  {
   "id": 4088,
   "key": "D0401.txt:47",
   "file": "D0401.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ほんの十数分。",
   "ko_candidate": "겨우 십여 분｡"
  },
  {
   "id": 4089,
   "key": "D0401.txt:48",
   "file": "D0401.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "その、わずかな間隙を縫って、怪異は襲ってきた。",
   "ko_candidate": "그 정말 짧은 틈을 타서 괴이가 습격해 왔다｡"
  },
  {
   "id": 4090,
   "key": "D0401.txt:61",
   "file": "D0401.txt",
   "line": 61,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」 風呂場から帰ってきた俺の目に飛び込んできたものは――",
   "ko_candidate": "욕실에서 돌아온 내 눈에 들어온 것은――"
  },
  {
   "id": 4091,
   "key": "D0401.txt:78",
   "file": "D0401.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "粘液まみれの事務所だった。",
   "ko_candidate": "점액 투성이의 사무실이었다｡"
  },
  {
   "id": 4092,
   "key": "D0401.txt:84",
   "file": "D0401.txt",
   "line": 84,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………ふう」",
   "ko_candidate": "「…………휴우」"
  },
  {
   "id": 4093,
   "key": "D0401.txt:91",
   "file": "D0401.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "わざとらしく溜息をつき、瞳を閉じる。",
   "ko_candidate": "일부러 한숨을 쉬며 눈을 감는다｡"
  },
  {
   "id": 4094,
   "key": "D0401.txt:98",
   "file": "D0401.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "眉間を揉みほぐしながら、気持ちを落ち着かせるべく深呼吸。",
   "ko_candidate": "미간을 문지르며 마음을 가라앉히려 심호흡｡"
  },
  {
   "id": 4095,
   "key": "D0401.txt:101",
   "file": "D0401.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……最近、疲れているからなあ。",
   "ko_candidate": "……최근에 피곤해서 그런가｡"
  },
  {
   "id": 4096,
   "key": "D0401.txt:104",
   "file": "D0401.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "良し。もう大丈夫だ。",
   "ko_candidate": "좋아｡ 이제 괜찮아｡"
  },
  {
   "id": 4097,
   "key": "D0401.txt:105",
   "file": "D0401.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "再び目を開き、現実と対峙する。",
   "ko_candidate": "다시 눈을 뜨고 현실과 마주한다｡"
  },
  {
   "id": 4098,
   "key": "D0401.txt:116",
   "file": "D0401.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――やっぱり、粘液まみれだった。",
   "ko_candidate": "――역시 점액 투성이였다｡"
  },
  {
   "id": 4099,
   "key": "D0401.txt:119",
   "file": "D0401.txt",
   "line": 119,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "床もソファーも机も壁も天井も、どこもかしこも万遍なく徹底的に微塵の容赦もなく、まみれにまみれまくっていた。まみれ過ぎていた。",
   "ko_candidate": "바닥도 소파도 책상도 벽도 천장도､ 어디나 할 것 없이 빠짐없이 철저하게 조금의 용서도 없이 점액 투성이였다｡ 너무 심하게 점액 투성이였다｡"
  },
  {
   "id": 4100,
   "key": "D0401.txt:122",
   "file": "D0401.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ゼリーをぶちまけられたかのような事務所内をしばし呆然と見つめていた。",
   "ko_candidate": "젤리를 쏟아부은 것 같은 사무실 내부를 잠시 멍하니 바라보고 있었다｡"
  },
  {
   "id": 4101,
   "key": "D0401.txt:125",
   "file": "D0401.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……ふと、ソファーの後ろ。ここからはちょうど死角になっているその位置に蠢く何かの気配を感じる。",
   "ko_candidate": "……문득､ 소파 뒤｡ 여기서는 마침 사각지대가 되는 그 위치에서 꿈틀거리는 무언가의 기척을 느낀다｡"
  },
  {
   "id": 4102,
   "key": "D0401.txt:130",
   "file": "D0401.txt",
   "line": 130,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うぬぬぬ！　おのれぇぇぇっ！ 大人しくせんかぁぁぁぁっ！」",
   "ko_candidate": "「으느느느느! 이 자식아아아아! 얌전히 있지 못해애애애애!」"
  },
  {
   "id": 4103,
   "key": "D0401.txt:137",
   "file": "D0401.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……そうか、そうか、成程な。",
   "ko_candidate": "같은 장소에서 알의 외침이 들려왔다｡"
  },
  {
   "id": 4104,
   "key": "D0401.txt:140",
   "file": "D0401.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そうだったな。そうだろうとも。",
   "ko_candidate": "……그렇구나､ 그렇구나､ 과연｡"
  },
  {
   "id": 4105,
   "key": "D0401.txt:141",
   "file": "D0401.txt",
   "line": 141,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうに決まっている。",
   "ko_candidate": "그랬지｡ 그럴 거야｡ 당연히 그렇겠지｡"
  },
  {
   "id": 4106,
   "key": "D0401.txt:142",
   "file": "D0401.txt",
   "line": 142,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "いやはや、今さら確認する必要なんかなかったよ。",
   "ko_candidate": "아이고､ 이제 와서 확인할 필요도 없었어｡"
  },
  {
   "id": 4107,
   "key": "D0401.txt:146",
   "file": "D0401.txt",
   "line": 146,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――やはり貴様か。古本娘。",
   "ko_candidate": "――역시 너였구나｡ 고서 소녀｡"
  },
  {
   "id": 4108,
   "key": "D0401.txt:150",
   "file": "D0401.txt",
   "line": 150,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "憩いの我が家にまで邪悪の手を伸ばして下さりやがります君のサービス精神に、この大十字九郎、愛すら感じる。いわゆる殺意混じりの。",
   "ko_candidate": "휴식의 우리 집에까지 사악한 손길을 뻗치시다니､ 당신의 서비스 정신에 이 다이쥬지 쿠로､ 사랑마저 느낍니다｡ 이른바 살의 섞인｡"
  },
  {
   "id": 4109,
   "key": "D0401.txt:155",
   "file": "D0401.txt",
   "line": 155,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アル――ッ！　いったい何してやがる――ッッ!?」",
   "ko_candidate": "「알――! 도대체 뭘 하고 있는 거야――!?」"
  },
  {
   "id": 4110,
   "key": "D0401.txt:161",
   "file": "D0401.txt",
   "line": 161,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「にゃあああ……っ！ ん？　何だ、九郎か」",
   "ko_candidate": "「냐아아아……! 응? 뭐야､ 쿠로구나」"
  },
  {
   "id": 4111,
   "key": "D0401.txt:170",
   "file": "D0401.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ソファーの陰からアルがひょっこりと顔を出した。",
   "ko_candidate": "소파 그림자에서 알이 슬쩍 얼굴을 내밀었다｡"
  },
  {
   "id": 4112,
   "key": "D0401.txt:171",
   "file": "D0401.txt",
   "line": 171,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルの顔もまた同様に、粘液にまみれていた。",
   "ko_candidate": "알의 얼굴 역시 마찬가지로 점액 투성이였다｡"
  },
  {
   "id": 4113,
   "key": "D0401.txt:174",
   "file": "D0401.txt",
   "line": 174,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……その、なんだ。このまみれ具合が何ともまた、こう実にアレというか。",
   "ko_candidate": "……그､ 뭐랄까｡ 이 점액 투성이 정도가 어쩐지 또 이렇게 실로 그거랄까｡"
  },
  {
   "id": 4114,
   "key": "D0401.txt:180",
   "file": "D0401.txt",
   "line": 180,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……何故、赤くなる？」",
   "ko_candidate": "「……왜 얼굴이 빨개지는 거지?」"
  },
  {
   "id": 4115,
   "key": "D0401.txt:185",
   "file": "D0401.txt",
   "line": 185,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……病気だ。そういうことにしとけ」",
   "ko_candidate": "「……병이야｡ 그렇게 생각해 두라고」"
  },
  {
   "id": 4116,
   "key": "D0401.txt:190",
   "file": "D0401.txt",
   "line": 190,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……邪な妄想を抱いたのではあるまいな」",
   "ko_candidate": "「……부적절한 망상을 품은 건 아니겠지」"
  },
  {
   "id": 4117,
   "key": "D0401.txt:196",
   "file": "D0401.txt",
   "line": 196,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「んなことより！　何だよ、このザマは!? 納涼ゼリーぶっかけ大収穫祭か何かか!?」",
   "ko_candidate": "「그런 것보다! 이게 뭐야､ 이 꼴은!? 납량 젤리 뿌리기 대수확제라도 하는 거야!?」"
  },
  {
   "id": 4118,
   "key": "D0401.txt:203",
   "file": "D0401.txt",
   "line": 203,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「夏だか秋だか季節が微妙な祭りだな、それは」",
   "ko_candidate": "「여름인지 가을인지 계절이 애매한 축제네､ 그건」"
  },
  {
   "id": 4119,
   "key": "D0401.txt:208",
   "file": "D0401.txt",
   "line": 208,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「アイダホ辺りの風習だ」",
   "ko_candidate": "「아이다호 쯤의 풍습이야」"
  },
  {
   "id": 4120,
   "key": "D0401.txt:213",
   "file": "D0401.txt",
   "line": 213,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「そうか」",
   "ko_candidate": "「그렇구나」"
  },
  {
   "id": 4121,
   "key": "D0401.txt:220",
   "file": "D0401.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "納得されてしまった。",
   "ko_candidate": "납득해 버렸다｡"
  },
  {
   "id": 4122,
   "key": "D0401.txt:226",
   "file": "D0401.txt",
   "line": 226,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「とにかく！　何の真似だよ、これは？」",
   "ko_candidate": "「어쨌든! 이게 무슨 짓이야､ 이건?」"
  },
  {
   "id": 4123,
   "key": "D0401.txt:231",
   "file": "D0401.txt",
   "line": 231,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ふむ。手懐けるのに少々苦戦してな。まあ良い、汝にも紹介しよう」",
   "ko_candidate": "「흠｡ 길들이는 데 좀 고전해서 말이야｡ 뭐 좋아｡ 너에게도 소개하지」"
  }
 ]
}