 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "アル・アジフ": "알 아지프",
  "九郎": "쿠로",
  "デモンベイン": "데몬베인",
  "リベル・レギス": "리베르 레기스",
  "魔力": "마력",
  "魔導書": "마도서"
 },
 "items": [
  {
   "id": 47023,
   "key": "D1514al.txt:718",
   "file": "D1514al.txt",
   "line": 718,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「我は闇　染まらぬ揺らがぬ迷わぬ 不変と愛」",
   "ko_candidate": "「나는 어둠 물들지 않고 흔들리지 않고 헤매지 않는 불변과 사랑」"
  },
  {
   "id": 47024,
   "key": "D1514al.txt:726",
   "file": "D1514al.txt",
   "line": 726,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「愛は苦く　烈しく　我を苛む」",
   "ko_candidate": "「사랑은 쓰고 격렬하게 나를 괴롭힌다」"
  },
  {
   "id": 47025,
   "key": "D1514al.txt:734",
   "file": "D1514al.txt",
   "line": 734,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「憎しみは甘く　重く　我を蝕む」",
   "ko_candidate": "「증오는 달콤하고 무겁게 나를 좀먹는다」"
  },
  {
   "id": 47026,
   "key": "D1514al.txt:741",
   "file": "D1514al.txt",
   "line": 741,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「其れは善」",
   "ko_candidate": "「그것은 선」"
  },
  {
   "id": 47027,
   "key": "D1514al.txt:748",
   "file": "D1514al.txt",
   "line": 748,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「其れは悪」",
   "ko_candidate": "「그것은 악」"
  },
  {
   "id": 47028,
   "key": "D1514al.txt:755",
   "file": "D1514al.txt",
   "line": 755,
   "speaker": "エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「其れは享受」",
   "ko_candidate": "「그것은 향유」"
  },
  {
   "id": 47029,
   "key": "D1514al.txt:762",
   "file": "D1514al.txt",
   "line": 762,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「其れは拒絶」",
   "ko_candidate": "「그것은 거부」"
  },
  {
   "id": 47030,
   "key": "D1514al.txt:770",
   "file": "D1514al.txt",
   "line": 770,
   "speaker": "九郎＆アル＆マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「其れは　純潔な　醜悪な　交配の儀式 結ばれるまま融け合うままに産み落とす 堕胎される　出来損ないの世界の――」",
   "ko_candidate": "「그것은 순결한 추악한 교배의 의식 맺어지는 대로 녹아드는 대로 낳아버리는 낙태되는 실패작 세계의――」"
  },
  {
   "id": 47031,
   "key": "D1514al.txt:786",
   "file": "D1514al.txt",
   "line": 786,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "唄い舞いながら、 アルは違和感と焦燥感に囚われていた。",
   "ko_candidate": "노래하고 춤추면서､ 알은 위화감과 초조함에 사로잡혀 있었다｡"
  },
  {
   "id": 47032,
   "key": "D1514al.txt:788",
   "file": "D1514al.txt",
   "line": 788,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何か――致命的な何かに気づかなければならない。",
   "ko_candidate": "무언가―― 치명적인 무언가를 깨달아야만 한다｡"
  },
  {
   "id": 47033,
   "key": "D1514al.txt:789",
   "file": "D1514al.txt",
   "line": 789,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに気づかねば、総てが手遅れとなる。",
   "ko_candidate": "그것을 깨닫지 않으면､ 모든 것이 때늦어진다｡"
  },
  {
   "id": 47034,
   "key": "D1514al.txt:791",
   "file": "D1514al.txt",
   "line": 791,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今この時を除いて、救いへの光明は無い。",
   "ko_candidate": "지금 이 순간을 제외하고､ 구원으로의 광명은 없다｡"
  },
  {
   "id": 47035,
   "key": "D1514al.txt:792",
   "file": "D1514al.txt",
   "line": 792,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが……それが何かが分からない。思い出せない。",
   "ko_candidate": "하지만…… 그것이 무엇인지 모르겠다｡ 떠올릴 수 없다｡"
  },
  {
   "id": 47036,
   "key": "D1514al.txt:793",
   "file": "D1514al.txt",
   "line": 793,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何ものかが、その記憶を禁忌として 鍵を掛けたかの様に。",
   "ko_candidate": "무언가가､ 그 기억을 금기로 삼아 자물쇠를 채운 것처럼｡"
  },
  {
   "id": 47037,
   "key": "D1514al.txt:799",
   "file": "D1514al.txt",
   "line": 799,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――検閲されているのだ――",
   "ko_candidate": "――검열되고 있는 것이다――"
  },
  {
   "id": 47038,
   "key": "D1514al.txt:802",
   "file": "D1514al.txt",
   "line": 802,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思い出せ！",
   "ko_candidate": "기억해내!"
  },
  {
   "id": 47039,
   "key": "D1514al.txt:803",
   "file": "D1514al.txt",
   "line": 803,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "思い出せ、アル・アジフ！",
   "ko_candidate": "기억해내､ 알 아지프!"
  },
  {
   "id": 47040,
   "key": "D1514al.txt:804",
   "file": "D1514al.txt",
   "line": 804,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何としても…… 何としても、彼奴の思い通りにさせてはいけない！",
   "ko_candidate": "어떻게든…… 어떻게든､ 그자의 뜻대로 되게 해서는 안 돼!"
  },
  {
   "id": 47041,
   "key": "D1514al.txt:807",
   "file": "D1514al.txt",
   "line": 807,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "九郎を救えるのは、自分だけなのだ。",
   "ko_candidate": "쿠로를 구할 수 있는 건､ 자신뿐이다｡"
  },
  {
   "id": 47042,
   "key": "D1514al.txt:808",
   "file": "D1514al.txt",
   "line": 808,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は……妾は……",
   "ko_candidate": "첩은…… 첩은……"
  },
  {
   "id": 47043,
   "key": "D1514al.txt:810",
   "file": "D1514al.txt",
   "line": 810,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――その瞬間に対峙するとき、",
   "ko_candidate": "――그 순간과 대치할 때､"
  },
  {
   "id": 47044,
   "key": "D1514al.txt:811",
   "file": "D1514al.txt",
   "line": 811,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正しく真実に辿り着かなければならない！",
   "ko_candidate": "올바르게 진실에 도달해야만 한다!"
  },
  {
   "id": 47045,
   "key": "D1514al.txt:820",
   "file": "D1514al.txt",
   "line": 820,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "血戦の儀式はクライマックスに差し掛かっていた。",
   "ko_candidate": "혈전의 의식은 클라이맥스에 다다르고 있었다｡"
  },
  {
   "id": 47046,
   "key": "D1514al.txt:821",
   "file": "D1514al.txt",
   "line": 821,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２つのトラペゾヘドロンの、デモンベインとリベル・レギスの魔力はもはや限界にまで膨れ上がっている。",
   "ko_candidate": "2개의 트라페조헤드론､ 데몬베인과 리베르 레기스의 마력은 이미 한계까지 부풀어 오르고 있다｡"
  },
  {
   "id": 47047,
   "key": "D1514al.txt:823",
   "file": "D1514al.txt",
   "line": 823,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "後はこれを爆発させ、叩きつけるだけだ。",
   "ko_candidate": "이제 이것을 폭발시켜 내리치기만 하면 된다｡"
  },
  {
   "id": 47048,
   "key": "D1514al.txt:824",
   "file": "D1514al.txt",
   "line": 824,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "小細工も計算も無意味だ。",
   "ko_candidate": "잔재주도 계산도 무의미하다｡"
  },
  {
   "id": 47049,
   "key": "D1514al.txt:831",
   "file": "D1514al.txt",
   "line": 831,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その深き昏き怨讐を胸に」",
   "ko_candidate": "「그 깊고 어두운 원한을 가슴에」"
  },
  {
   "id": 47050,
   "key": "D1514al.txt:838",
   "file": "D1514al.txt",
   "line": 838,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その切実なる命の叫びを胸に」",
   "ko_candidate": "「그 절실한 생명의 외침을 가슴에」"
  },
  {
   "id": 47051,
   "key": "D1514al.txt:844",
   "file": "D1514al.txt",
   "line": 844,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "舞が止まる。",
   "ko_candidate": "춤이 멈춘다｡"
  },
  {
   "id": 47052,
   "key": "D1514al.txt:845",
   "file": "D1514al.txt",
   "line": 845,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "再びトラペゾヘドロンの剣先を 突きつけ合う体勢で静止。",
   "ko_candidate": "다시 트라페조헤드론의 검끝을 겨누는 자세로 정지｡"
  },
  {
   "id": 47053,
   "key": "D1514al.txt:847",
   "file": "D1514al.txt",
   "line": 847,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "最後の口上。",
   "ko_candidate": "마지막 구호｡"
  },
  {
   "id": 47054,
   "key": "D1514al.txt:854",
   "file": "D1514al.txt",
   "line": 854,
   "speaker": "マスターテリオン＆エセルドレーダ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「埋葬の華に誓って」",
   "ko_candidate": "「매장의 꽃에 맹세하여」"
  },
  {
   "id": 47055,
   "key": "D1514al.txt:862",
   "file": "D1514al.txt",
   "line": 862,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「祝福の華に誓って」",
   "ko_candidate": "「축복의 꽃에 맹세하여」"
  },
  {
   "id": 47056,
   "key": "D1514al.txt:865",
   "file": "D1514al.txt",
   "line": 865,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして今、総てを終わらせる為に……",
   "ko_candidate": "그리고 지금､ 모든 것을 끝내기 위해……"
  },
  {
   "id": 47057,
   "key": "D1514al.txt:898",
   "file": "D1514al.txt",
   "line": 898,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――我は世界を紡ぐ者なり！」",
   "ko_candidate": "「――나는 세계를 짜는 자라!」"
  },
  {
   "id": 47058,
   "key": "D1514al.txt:911",
   "file": "D1514al.txt",
   "line": 911,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――ッ！」",
   "ko_candidate": "「――――읏!」"
  },
  {
   "id": 47059,
   "key": "D1514al.txt:940",
   "file": "D1514al.txt",
   "line": 940,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鍵が外され、検閲されていた最後の記述が甦る。",
   "ko_candidate": "자물쇠가 풀리고､ 검열되었던 마지막 기술이 되살아난다｡"
  },
  {
   "id": 47060,
   "key": "D1514al.txt:941",
   "file": "D1514al.txt",
   "line": 941,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、この瞬間を以て、魔導書『アル・アジフ』は真に完全となった。",
   "ko_candidate": "지금､ 이 순간을 기해､ 마도서 『알 아지프』는 진정으로 완전해졌다｡"
  },
  {
   "id": 47061,
   "key": "D1514al.txt:943",
   "file": "D1514al.txt",
   "line": 943,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "彼女の著者アブドゥル・アルハザードが我が身を蝕む狂気の中、最期の力を振り絞り書き遺した、世界に訴える必死の警告。",
   "ko_candidate": "그녀의 저자 압둘 알하자드가 자신을 좀먹는 광기 속에서､ 마지막 힘을 짜내어 써 남긴､ 세계에 호소하는 필사의 경고｡"
  },
  {
   "id": 47062,
   "key": "D1514al.txt:944",
   "file": "D1514al.txt",
   "line": 944,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ありったけの人間の叫び。",
   "ko_candidate": "있는 힘껏 외치는 인간의 절규｡"
  }
 ]
}