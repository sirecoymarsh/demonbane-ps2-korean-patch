 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ブラックロッジ": "블랙로지",
  "サンダルフォン": "산달폰",
  "九郎ちゃん": "쿠로 군"
 },
 "items": [
  {
   "id": 17406,
   "key": "D0820le.txt:198",
   "file": "D0820le.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "俺も助けられた。海のときといい、ここんとこ世話になりっぱなしだ。",
   "ko_candidate": "나도 도움을 받았지｡ 바다에서도 그렇고､ 요즘 들어 신세만 지고 있어｡"
  },
  {
   "id": 17407,
   "key": "D0820le.txt:200",
   "file": "D0820le.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "礼を言おうと周囲を見渡す。",
   "ko_candidate": "인사를 하려고 주위를 둘러본다｡"
  },
  {
   "id": 17408,
   "key": "D0820le.txt:203",
   "file": "D0820le.txt",
   "line": 203,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あれ……？」",
   "ko_candidate": "「어라……?」"
  },
  {
   "id": 17409,
   "key": "D0820le.txt:208",
   "file": "D0820le.txt",
   "line": 208,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……居ないな」",
   "ko_candidate": "「……없네」"
  },
  {
   "id": 17410,
   "key": "D0820le.txt:215",
   "file": "D0820le.txt",
   "line": 215,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 17411,
   "key": "D0820le.txt:223",
   "file": "D0820le.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "これで、私の悪夢に片は付いたのか？",
   "ko_candidate": "이걸로､ 내 악몽에 종지부를 찍은 건가?"
  },
  {
   "id": 17412,
   "key": "D0820le.txt:224",
   "file": "D0820le.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "否。まだだ。",
   "ko_candidate": "아니｡ 아직이다｡"
  },
  {
   "id": 17413,
   "key": "D0820le.txt:226",
   "file": "D0820le.txt",
   "line": 226,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "『Ｃ計画』。",
   "ko_candidate": "『C계획』｡"
  },
  {
   "id": 17414,
   "key": "D0820le.txt:230",
   "file": "D0820le.txt",
   "line": 230,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "悪夢の始まり。総ての元凶。",
   "ko_candidate": "악몽의 시작｡ 모든 것의 원흉｡"
  },
  {
   "id": 17415,
   "key": "D0820le.txt:231",
   "file": "D0820le.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まだ、続いているのか。",
   "ko_candidate": "아직､ 계속되고 있는 건가｡"
  },
  {
   "id": 17416,
   "key": "D0820le.txt:237",
   "file": "D0820le.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……それもそうだろう。",
   "ko_candidate": "……그럴 수밖에 없겠지｡"
  },
  {
   "id": 17417,
   "key": "D0820le.txt:238",
   "file": "D0820le.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "連中は――『ブラックロッジ』は",
   "ko_candidate": "그들은――『블랙로지』는 결코 그 광기를 포기하지 않는다｡"
  },
  {
   "id": 17418,
   "key": "D0820le.txt:239",
   "file": "D0820le.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "決してあの凶夢を諦めない。",
   "ko_candidate": "반드시 실현하려 할 것이다｡"
  },
  {
   "id": 17419,
   "key": "D0820le.txt:245",
   "file": "D0820le.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、終わるはずがない。",
   "ko_candidate": "그러니､ 끝날 리가 없다｡"
  },
  {
   "id": 17420,
   "key": "D0820le.txt:246",
   "file": "D0820le.txt",
   "line": 246,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "奴等を根絶やしにしない限り、悪夢は醒めない。",
   "ko_candidate": "놈들을 뿌리째 멸망시키지 않는 한､ 악몽은 깨어나지 않는다｡"
  },
  {
   "id": 17421,
   "key": "D0820le.txt:249",
   "file": "D0820le.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それに――サンダルフォン。",
   "ko_candidate": "게다가――산달폰｡"
  },
  {
   "id": 17422,
   "key": "D0820le.txt:250",
   "file": "D0820le.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "彼もまた、同じ場所から始まった悪夢。",
   "ko_candidate": "그 또한､ 같은 곳에서 시작된 악몽｡"
  },
  {
   "id": 17423,
   "key": "D0820le.txt:251",
   "file": "D0820le.txt",
   "line": 251,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私の悪夢。そして――私の罪。",
   "ko_candidate": "내 악몽｡ 그리고――내 죄｡"
  },
  {
   "id": 17424,
   "key": "D0820le.txt:254",
   "file": "D0820le.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……終わらない。終われない。",
   "ko_candidate": "……끝나지 않는다｡ 끝낼 수 없다｡"
  },
  {
   "id": 17425,
   "key": "D0820le.txt:255",
   "file": "D0820le.txt",
   "line": 255,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "加速していく。 狂った螺旋が加速していく。昇っていく。",
   "ko_candidate": "가속해간다｡ 미친 나선이 가속해간다｡ 올라간다｡"
  },
  {
   "id": 17426,
   "key": "D0820le.txt:257",
   "file": "D0820le.txt",
   "line": 257,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "取り返しのつかない、致命的な何かを求めて。",
   "ko_candidate": "돌이킬 수 없는､ 치명적인 무언가를 향해｡"
  },
  {
   "id": 17427,
   "key": "D0820le.txt:265",
   "file": "D0820le.txt",
   "line": 265,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――私は、赦されないかも、知れない。",
   "ko_candidate": "――나는､ 용서받지 못할지도､ 모르겠다｡"
  },
  {
   "id": 17428,
   "key": "D0820le.txt:284",
   "file": "D0820le.txt",
   "line": 284,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぶぇっくしっ！」",
   "ko_candidate": "「에취!」"
  },
  {
   "id": 17429,
   "key": "D0820le.txt:290",
   "file": "D0820le.txt",
   "line": 290,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎ちゃん、大丈夫？ 風邪とか引かないように」 「……くしゅっ！」",
   "ko_candidate": "「쿠로 군､ 괜찮아요? 감기 같은 거 걸리지 않도록 ……에취!」"
  },
  {
   "id": 17430,
   "key": "D0820le.txt:301",
   "file": "D0820le.txt",
   "line": 301,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……汝もな」",
   "ko_candidate": "「……너도 말이다」"
  },
  {
   "id": 17431,
   "key": "D0820le.txt:307",
   "file": "D0820le.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "２人揃ってクシャミか……まあ、無理もない。",
   "ko_candidate": "둘이 함께 재채기라니……뭐､ 어쩔 수 없지｡"
  },
  {
   "id": 17432,
   "key": "D0820le.txt:309",
   "file": "D0820le.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの雨の中、外に出てたもんだから、 お互い濡れネズミだ。",
   "ko_candidate": "저 비 속에､ 밖에 나가 있었으니까､ 서로 젖은 쥐 꼴이다｡"
  },
  {
   "id": 17433,
   "key": "D0820le.txt:312",
   "file": "D0820le.txt",
   "line": 312,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "もちろん荷物も台無し。今日は大凶だ。",
   "ko_candidate": "물론 짐도 엉망이 됐고｡ 오늘은 대흉이다｡"
  },
  {
   "id": 17434,
   "key": "D0820le.txt:314",
   "file": "D0820le.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それでも、あんな状況を切り抜けて、こうして無事、教会まで戻って来れた。",
   "ko_candidate": "그래도､ 저런 상황을 빠져나와､ 이렇게 무사히､ 교회까지 돌아올 수 있었다｡"
  },
  {
   "id": 17435,
   "key": "D0820le.txt:314",
   "file": "D0820le.txt",
   "line": 314,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "それだけで良しとしよう。",
   "ko_candidate": "그것만으로도 좋다고 하자｡"
  },
  {
   "id": 17436,
   "key": "D0820le.txt:315",
   "file": "D0820le.txt",
   "line": 315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今日の埋め合わせはまた別の機会にすれば良い。",
   "ko_candidate": "오늘의 보상은 또 다른 기회에 하면 된다｡"
  },
  {
   "id": 17437,
   "key": "D0820le.txt:317",
   "file": "D0820le.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そんなことを考えながら、教会の扉を開いた。",
   "ko_candidate": "그런 생각을 하며､ 교회의 문을 열었다｡"
  },
  {
   "id": 17438,
   "key": "D0820le.txt:325",
   "file": "D0820le.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まず聴こえてきたのはハーモニカの音。",
   "ko_candidate": "먼저 들려온 것은 하모니카 소리｡"
  },
  {
   "id": 17439,
   "key": "D0820le.txt:326",
   "file": "D0820le.txt",
   "line": 326,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "軽快な、綺麗な音色だった。",
   "ko_candidate": "경쾌하고､ 아름다운 음색이었다｡"
  },
  {
   "id": 17440,
   "key": "D0820le.txt:328",
   "file": "D0820le.txt",
   "line": 328,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "礼拝堂の一角に、みんなが集まって、その音色に聞き惚れている。",
   "ko_candidate": "예배당 한쪽에､ 모두가 모여､ 그 음색에 귀를 기울이고 있다｡"
  },
  {
   "id": 17441,
   "key": "D0820le.txt:330",
   "file": "D0820le.txt",
   "line": 330,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そんなガキんちょどもに囲まれて、 ハーモニカを吹く青年。",
   "ko_candidate": "그런 꼬마들에게 둘러싸여､ 하모니카를 부는 청년｡"
  },
  {
   "id": 17442,
   "key": "D0820le.txt:336",
   "file": "D0820le.txt",
   "line": 336,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "まるで武芸家のような道着っぽい服装。ボサボサに伸びた髪は、それでもだらしない印象はない。",
   "ko_candidate": "마치 무예가 같은 도복 같은 옷차림｡ 부스스하게 자란 머리는､ 그래도 지저분한 인상은 아니다｡"
  },
  {
   "id": 17443,
   "key": "D0820le.txt:338",
   "file": "D0820le.txt",
   "line": 338,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "瞼を閉じ、穏やかな表情でハーモニカを演奏している。",
   "ko_candidate": "눈꺼풀을 감고､ 온화한 표정으로 하모니카를 연주하고 있다｡"
  },
  {
   "id": 17444,
   "key": "D0820le.txt:340",
   "file": "D0820le.txt",
   "line": 340,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "右瞼を縦に横断する古傷が痛々しい。",
   "ko_candidate": "오른쪽 눈꺼풀을 세로로 가로지르는 옛 상처가 아프게 보인다｡"
  },
  {
   "id": 17445,
   "key": "D0820le.txt:342",
   "file": "D0820le.txt",
   "line": 342,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "鋭く険しい気を放っているくせに、同時に優しく穏やかな気配をも併せ持つ。",
   "ko_candidate": "날카롭고 험한 기를 내뿜으면서도､ 동시에 상냥하고 온화한 기색도 함께 지니고 있다｡"
  }
 ]
}