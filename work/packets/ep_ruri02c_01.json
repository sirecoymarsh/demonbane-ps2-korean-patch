{
 "packet": "ep_ruri02c_01",
 "scene": "ep_ruri02c",
 "anchor": {
  "hit": null,
  "total": null,
  "rate": null
 },
 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "アル": "알",
  "九郎": "쿠로",
  "瑠璃": "루리",
  "覇道瑠璃": "하도 루리",
  "アーカムシティ": "아컴시티",
  "ミスカトニック": "미스캐토닉"
 },
 "items": [
  {
   "id": 51132,
   "key": "ep_ruri02c.txt:154",
   "file": "ep_ruri02c.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "総てが、光に埋め尽くされる。",
   "ko_candidate": "모든 것이 빛으로 가득 차버린다｡"
  },
  {
   "id": 51133,
   "key": "ep_ruri02c.txt:155",
   "file": "ep_ruri02c.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世界は何処までも白く、白く。",
   "ko_candidate": "세계는 어디까지나 하얗고､ 하얗다｡"
  },
  {
   "id": 51134,
   "key": "ep_ruri02c.txt:156",
   "file": "ep_ruri02c.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "アルが両手を伸ばす。",
   "ko_candidate": "알이 양손을 뻗는다｡"
  },
  {
   "id": 51135,
   "key": "ep_ruri02c.txt:157",
   "file": "ep_ruri02c.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まるで光を掴もうとするように。",
   "ko_candidate": "마치 빛을 잡으려는 것처럼｡"
  },
  {
   "id": 51136,
   "key": "ep_ruri02c.txt:161",
   "file": "ep_ruri02c.txt",
   "line": 161,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「意志は確かに存在するのだ。そしてその意志が、未来を創っていく。 此奴等の様に――」",
   "ko_candidate": "「의지는 분명히 존재하는 거야｡ 그리고 그 의지가 미래를 만들어 나가｡ 이놈들처럼――」"
  },
  {
   "id": 51137,
   "key": "ep_ruri02c.txt:168",
   "file": "ep_ruri02c.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光を掴かむ指が、光に崩れる。",
   "ko_candidate": "빛을 잡으려는 손가락이 빛 속에서 무너진다｡"
  },
  {
   "id": 51138,
   "key": "ep_ruri02c.txt:169",
   "file": "ep_ruri02c.txt",
   "line": 169,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "伸ばした手が、光に融ける。",
   "ko_candidate": "뻗은 손이 빛 속에 녹아든다｡"
  },
  {
   "id": 51139,
   "key": "ep_ruri02c.txt:175",
   "file": "ep_ruri02c.txt",
   "line": 175,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――九郎」",
   "ko_candidate": "「――쿠로」"
  },
  {
   "id": 51140,
   "key": "ep_ruri02c.txt:180",
   "file": "ep_ruri02c.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "躰が揮発する。",
   "ko_candidate": "몸이 증발한다｡"
  },
  {
   "id": 51141,
   "key": "ep_ruri02c.txt:181",
   "file": "ep_ruri02c.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "因果律が、少女の千年――どれほど積み重ねたかも判らぬ、千年をも分解する。",
   "ko_candidate": "인과율이 소녀의 천 년――얼마나 쌓였는지도 모를 천 년마저 분해한다｡"
  },
  {
   "id": 51142,
   "key": "ep_ruri02c.txt:181",
   "file": "ep_ruri02c.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "其処に恐怖は、無い。",
   "ko_candidate": "거기에 공포는 없다｡"
  },
  {
   "id": 51143,
   "key": "ep_ruri02c.txt:185",
   "file": "ep_ruri02c.txt",
   "line": 185,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――瑠璃」",
   "ko_candidate": "「――루리」"
  },
  {
   "id": 51144,
   "key": "ep_ruri02c.txt:190",
   "file": "ep_ruri02c.txt",
   "line": 190,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今は総てを失うが、其処からもう一度、取り戻してゆく。",
   "ko_candidate": "지금은 모든 것을 잃지만､ 거기서부터 다시 한 번 되찾아 나갈 거야｡"
  },
  {
   "id": 51145,
   "key": "ep_ruri02c.txt:191",
   "file": "ep_ruri02c.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "正しい世界を創り上げてゆく。",
   "ko_candidate": "올바른 세계를 만들어 나갈 거야｡"
  },
  {
   "id": 51146,
   "key": "ep_ruri02c.txt:195",
   "file": "ep_ruri02c.txt",
   "line": 195,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "存在の総てが霧散する。",
   "ko_candidate": "존재의 모든 것이 안개처럼 흩어진다｡"
  },
  {
   "id": 51147,
   "key": "ep_ruri02c.txt:196",
   "file": "ep_ruri02c.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "もう光さえも見えない。",
   "ko_candidate": "이제 빛조차 보이지 않는다｡"
  },
  {
   "id": 51148,
   "key": "ep_ruri02c.txt:200",
   "file": "ep_ruri02c.txt",
   "line": 200,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「汝等が創る未来――楽しみにしておるぞ」",
   "ko_candidate": "「너희들이 만들어갈 미래――기대하고 있겠다」"
  },
  {
   "id": 51149,
   "key": "ep_ruri02c.txt:203",
   "file": "ep_ruri02c.txt",
   "line": 203,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "光の洪水に、アルの声が響き渡る。",
   "ko_candidate": "빛의 홍수 속에 알의 목소리가 울려 퍼진다｡"
  },
  {
   "id": 51150,
   "key": "ep_ruri02c.txt:204",
   "file": "ep_ruri02c.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "聴くものの居ない声が、拡がってゆく。",
   "ko_candidate": "들을 이 없는 목소리가 퍼져 나간다｡"
  },
  {
   "id": 51151,
   "key": "ep_ruri02c.txt:211",
   "file": "ep_ruri02c.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "――世界最後の、言葉だった。",
   "ko_candidate": "――세계 최후의 말이었다｡"
  },
  {
   "id": 51152,
   "key": "ep_ruri02c.txt:225",
   "file": "ep_ruri02c.txt",
   "line": 225,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "大冒険だ。",
   "ko_candidate": "대모험이다｡"
  },
  {
   "id": 51153,
   "key": "ep_ruri02c.txt:226",
   "file": "ep_ruri02c.txt",
   "line": 226,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "世紀の大冒険だ。",
   "ko_candidate": "세기의 대모험이다｡"
  },
  {
   "id": 51154,
   "key": "ep_ruri02c.txt:228",
   "file": "ep_ruri02c.txt",
   "line": 228,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "知られざる、未だ暴かれぬ未踏の地へ。",
   "ko_candidate": "알려지지 않은､ 아직 밝혀지지 않은 미지의 땅으로｡"
  },
  {
   "id": 51155,
   "key": "ep_ruri02c.txt:229",
   "file": "ep_ruri02c.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "人類の叡智の及ばない、禁断の地へ挑む、私は探索者なのだ。",
   "ko_candidate": "인류의 지혜가 미치지 못하는､ 금단의 땅에 도전하는､ 나는 탐험가인 것이다｡"
  },
  {
   "id": 51156,
   "key": "ep_ruri02c.txt:231",
   "file": "ep_ruri02c.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "冒険家である祖父の血を継いだ私の、それが宿命、生きる道なのだ。",
   "ko_candidate": "모험가인 할아버지의 피를 이어받은 나의､ 그것이 숙명､ 살아갈 길인 것이다｡"
  },
  {
   "id": 51157,
   "key": "ep_ruri02c.txt:233",
   "file": "ep_ruri02c.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "やってやる。",
   "ko_candidate": "해내고 말겠어｡"
  },
  {
   "id": 51158,
   "key": "ep_ruri02c.txt:234",
   "file": "ep_ruri02c.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "今日こそやってやる。",
   "ko_candidate": "오늘이야말로 해내고 말겠어｡"
  },
  {
   "id": 51159,
   "key": "ep_ruri02c.txt:235",
   "file": "ep_ruri02c.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "我が道を阻む恐ろしい罠の数々を踏破し、夜な夜な若い乙女を悪魔の生贄に捧げる邪教集団に、十字軍の如く挑みかかるのだ。",
   "ko_candidate": "내 길을 가로막는 무서운 함정들을 뚫고､ 밤마다 젊은 처녀를 악마의 제물로 바치는 사교 집단에､ 십자군처럼 도전하는 것이다｡"
  },
  {
   "id": 51160,
   "key": "ep_ruri02c.txt:237",
   "file": "ep_ruri02c.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そう。やらなければ、ならないのだ。",
   "ko_candidate": "그래｡ 하지 않으면､ 안 되는 것이다｡"
  },
  {
   "id": 51161,
   "key": "ep_ruri02c.txt:238",
   "file": "ep_ruri02c.txt",
   "line": 238,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私がやらなければ、ならないのだ。",
   "ko_candidate": "내가 하지 않으면､ 안 되는 것이다｡"
  },
  {
   "id": 51162,
   "key": "ep_ruri02c.txt:239",
   "file": "ep_ruri02c.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "私じゃなければ、ならないのだ。",
   "ko_candidate": "나가 아니면､ 안 되는 것이다｡"
  },
  {
   "id": 51163,
   "key": "ep_ruri02c.txt:241",
   "file": "ep_ruri02c.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さもないと邪悪な儀式で邪神が復活して世界は永久の闇に閉ざされてしまうのだ。",
   "ko_candidate": "그렇지 않으면 사악한 의식으로 사신이 부활해서 세계는 영원한 어둠에 닫혀버리고 말 것이다｡"
  },
  {
   "id": 51164,
   "key": "ep_ruri02c.txt:243",
   "file": "ep_ruri02c.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "この勇者たる私、覇道瑠璃以外に、地球を救える者はいないのだ。",
   "ko_candidate": "이 용사인 나､ 하도 루리 외에는､ 지구를 구할 수 있는 자는 없는 것이다｡"
  },
  {
   "id": 51165,
   "key": "ep_ruri02c.txt:244",
   "file": "ep_ruri02c.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だから、たとえ誰に止められようと、私は征かねばならない。",
   "ko_candidate": "그래서､ 누가 말려도､ 나는 나아가야만 한다｡"
  },
  {
   "id": 51166,
   "key": "ep_ruri02c.txt:245",
   "file": "ep_ruri02c.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "優しい人々の手を振り払い、私は修羅の道を往く。",
   "ko_candidate": "상냥한 사람들의 손을 뿌리치고､ 나는 수라의 길을 간다｡"
  },
  {
   "id": 51167,
   "key": "ep_ruri02c.txt:247",
   "file": "ep_ruri02c.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……途中から身分が、探索者から勇者にインフレーションしているけど、別に良いのです。",
   "ko_candidate": "……중간부터 신분이､ 탐험가에서 용사로 인플레이션되고 있지만､ 별로 상관없어요｡"
  },
  {
   "id": 51168,
   "key": "ep_ruri02c.txt:248",
   "file": "ep_ruri02c.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "きっと見つけ出した財宝が、邪神を斃す鍵なのです。",
   "ko_candidate": "틀림없이 발견한 보물이､ 사신을 물리칠 열쇠일 거예요｡"
  },
  {
   "id": 51169,
   "key": "ep_ruri02c.txt:250",
   "file": "ep_ruri02c.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "間抜けな妄想を武器に、私は肩で風を切りながら、正門へと向かった。",
   "ko_candidate": "어리석은 망상을 무기로､ 나는 어깨로 바람을 가르며､ 정문으로 향했다｡"
  },
  {
   "id": 51170,
   "key": "ep_ruri02c.txt:253",
   "file": "ep_ruri02c.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "構内に鐘の音が轟き渡る。",
   "ko_candidate": "교내에 종소리가 울려 퍼진다｡"
  },
  {
   "id": 51171,
   "key": "ep_ruri02c.txt:254",
   "file": "ep_ruri02c.txt",
   "line": 254,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何を考えて作ったのやら、馬鹿みたいに巨大な時計塔……このアーカムシティ最大の建造物こそ、ミスカトニック大学の校舎なのだ。",
   "ko_candidate": "무슨 생각으로 만들었는지､ 바보같이 거대한 시계탑……이 아캄시티 최대의 건조물이야말로､ 미스카토닉 대학의 교사인 것이다｡"
  }
 ]
}