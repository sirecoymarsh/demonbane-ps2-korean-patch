 },
 "items": [
  {
   "id": 23635,
   "key": "D1105al.txt:202",
   "file": "D1105al.txt",
   "line": 202,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "機体内部から新たな爆弾が姿を現す。",
   "ko_candidate": "기체 내부에서 새로운 폭탄이 모습을 드러낸다｡"
  },
  {
   "id": 23636,
   "key": "D1105al.txt:204",
   "file": "D1105al.txt",
   "line": 204,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "奇妙な紋様が弾殻に刻まれた、 不気味な爆弾――魔力付与型だ。",
   "ko_candidate": "기묘한 문양이 탄각에 새겨진､ 불길한 폭탄――마력 부여형이다｡"
  },
  {
   "id": 23637,
   "key": "D1105al.txt:207",
   "file": "D1105al.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "必殺の一撃を今まさに投下せんと破壊ロボ達は一斉に動き出し――状況の変化を察知して、行動を中断した。",
   "ko_candidate": "필살의 일격을 지금 막 투하하려 파괴 로봇들이 일제히 움직이기 시작하고――상황의 변화를 감지하고､ 행동을 중단했다｡"
  },
  {
   "id": 23638,
   "key": "D1105al.txt:212",
   "file": "D1105al.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "百のセンサーが、眼下のとある一点に集中する。",
   "ko_candidate": "백 개의 센서가､ 아래쪽의 어떤 한 점에 집중한다｡"
  },
  {
   "id": 23639,
   "key": "D1105al.txt:221",
   "file": "D1105al.txt",
   "line": 221,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――何事か。",
   "ko_candidate": "――무슨 일이지｡"
  },
  {
   "id": 23640,
   "key": "D1105al.txt:222",
   "file": "D1105al.txt",
   "line": 222,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの視線もそちらを向いた。距離にして約１０００メートルあまり。",
   "ko_candidate": "티투스의 시선도 그쪽을 향했다｡ 고도로 약 1000미터 정도｡"
  },
  {
   "id": 23641,
   "key": "D1105al.txt:224",
   "file": "D1105al.txt",
   "line": 224,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが人間の規格から外れたティトゥスの眸は、状況をはっきりと視認する事が出来る。",
   "ko_candidate": "하지만 인간의 규격에서 벗어난 티투스의 눈동자에는､ 상황을 확실히 시인할 수 있다｡"
  },
  {
   "id": 23642,
   "key": "D1105al.txt:227",
   "file": "D1105al.txt",
   "line": 227,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして、見た。",
   "ko_candidate": "그리고､ 보았다｡"
  },
  {
   "id": 23643,
   "key": "D1105al.txt:229",
   "file": "D1105al.txt",
   "line": 229,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "未だ倒壊を免れているビルの一つが縦に割けて、左右に展開。",
   "ko_candidate": "{SE_PLAY(1,\"ビル료れる\",0,100,false);}"
  },
  {
   "id": 23644,
   "key": "D1105al.txt:231",
   "file": "D1105al.txt",
   "line": 231,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その下から巨大な孔が姿を現した。",
   "ko_candidate": "아직 붕괴를 면한 빌딩 중 하나가 세로로 갈라져､ 좌우로 전개｡"
  },
  {
   "id": 23645,
   "key": "D1105al.txt:233",
   "file": "D1105al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アーカムシティに点在する、デモンベインの回収口の一つだ。",
   "ko_candidate": "그 아래에서 거대한 구멍이 모습을 드러냈다｡ 아캄시티에 점재하는､ 데몬베인의 회수구 중 하나다｡"
  },
  {
   "id": 23646,
   "key": "D1105al.txt:235",
   "file": "D1105al.txt",
   "line": 235,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それが……稼動している？",
   "ko_candidate": "그것이……가동하고 있다{SE_VOL(1,1000,0);}？"
  },
  {
   "id": 23647,
   "key": "D1105al.txt:244",
   "file": "D1105al.txt",
   "line": 244,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……莫迦な」",
   "ko_candidate": "「……바보 같군」"
  },
  {
   "id": 23648,
   "key": "D1105al.txt:248",
   "file": "D1105al.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "信じられないものを見た。",
   "ko_candidate": "믿을 수 없는 것을 보았다｡"
  },
  {
   "id": 23649,
   "key": "D1105al.txt:249",
   "file": "D1105al.txt",
   "line": 249,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "在り得る筈の無いものを見た。",
   "ko_candidate": "있을 리 없는 것을 보았다｡"
  },
  {
   "id": 23650,
   "key": "D1105al.txt:250",
   "file": "D1105al.txt",
   "line": 250,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そいつは――昇降機に載って地上に姿を現すそいつは、確かに跡形も無く消滅した筈なのだ。",
   "ko_candidate": "그놈은――승강기에 실려 지상에 모습을 드러내는 그놈은､ 분명 흔적도 없이 소멸했을 터인데｡"
  },
  {
   "id": 23651,
   "key": "D1105al.txt:252",
   "file": "D1105al.txt",
   "line": 252,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、そいつは確かにティトゥスの視界に捉えられている。",
   "ko_candidate": "하지만､ 그놈은 분명 티투스의 시야에 포착되고 있다｡"
  },
  {
   "id": 23652,
   "key": "D1105al.txt:253",
   "file": "D1105al.txt",
   "line": 253,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不敵な笑みが浮かんだ。",
   "ko_candidate": "뻔뻔한 미소가 떠올랐다｡"
  },
  {
   "id": 23653,
   "key": "D1105al.txt:261",
   "file": "D1105al.txt",
   "line": 261,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……皆の者。見ろ。外を見てみろ。面白いものが見れるぞ」",
   "ko_candidate": "「……여러분｡ 보라｡ 밖을 보라｡ 재미있는 것을 볼 수 있을 것이다」"
  },
  {
   "id": 23654,
   "key": "D1105al.txt:273",
   "file": "D1105al.txt",
   "line": 273,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ほ、報告します！　１２番区画の昇降機が勝手に起動していますです！」",
   "ko_candidate": "「보､ 보고합니다! 12번 구획의 승강기가 멋대로 작동하고 있습니다!」"
  },
  {
   "id": 23655,
   "key": "D1105al.txt:277",
   "file": "D1105al.txt",
   "line": 277,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――ッ！　どういうこと!?　チアキは……！」",
   "ko_candidate": "「――읏! 어떻게 된 거지!? 치아키는……!」"
  },
  {
   "id": 23656,
   "key": "D1105al.txt:280",
   "file": "D1105al.txt",
   "line": 280,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "格納庫に通信が繋がる。",
   "ko_candidate": "격납고에 통신이 연결된다｡"
  },
  {
   "id": 23657,
   "key": "D1105al.txt:281",
   "file": "D1105al.txt",
   "line": 281,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "が、画面に映し出されたチアキは荒縄で縛られ、床に転がされていた。",
   "ko_candidate": "하지만､ 화면에 비친 치아키는 거친 밧줄로 묶여､ 바닥에 쓰러져 있었다｡"
  },
  {
   "id": 23658,
   "key": "D1105al.txt:285",
   "file": "D1105al.txt",
   "line": 285,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な、何を遊んでいるのです、 チアキ！」",
   "ko_candidate": "「뭐､ 뭘 장난치고 있는 거예요､ 치아키!」"
  },
  {
   "id": 23659,
   "key": "D1105al.txt:290",
   "file": "D1105al.txt",
   "line": 290,
   "speaker": "チアキ（通信）",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ん――――っ！　んんんっ！ ん――――っ！」",
   "ko_candidate": "「음――――읏! 으으으읏! 음――――읏!」"
  },
  {
   "id": 23660,
   "key": "D1105al.txt:294",
   "file": "D1105al.txt",
   "line": 294,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "格納庫に繋がった通信機から、チアキの抗議してるっぽい呻き声が聴こえるが、その時にはもう、誰も構ってはいなかった。",
   "ko_candidate": "격납고에 연결된 통신기에서､ 치아키의 항의하는 듯한 신음 소리가 들리지만､ 그때는 이미､ 아무도 신경 쓰지 않았다｡"
  },
  {
   "id": 23661,
   "key": "D1105al.txt:296",
   "file": "D1105al.txt",
   "line": 296,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "誰もが外の光景に釘付けになっていた。",
   "ko_candidate": "모두가 바깥의 광경에 못 박힌 듯 집중하고 있었다｡"
  },
  {
   "id": 23662,
   "key": "D1105al.txt:297",
   "file": "D1105al.txt",
   "line": 297,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３３番区画に、あの機体が、姿を現したから。",
   "ko_candidate": "33번 구획에､ 그 기체가､ 모습을 드러냈기 때문에｡"
  },
  {
   "id": 23663,
   "key": "D1105al.txt:307",
   "file": "D1105al.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３３番区画。",
   "ko_candidate": "33번 구획｡"
  },
  {
   "id": 23664,
   "key": "D1105al.txt:308",
   "file": "D1105al.txt",
   "line": 308,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "破壊を免れた高層ビルの１つが縦に分かれる。",
   "ko_candidate": "파괴를 면한 고층 빌딩 중 하나가 세로로 갈라진다｡"
  },
  {
   "id": 23665,
   "key": "D1105al.txt:309",
   "file": "D1105al.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "高層ビルが建っていたその場所には、ゲートがあった。",
   "ko_candidate": "고층 빌딩이 서 있던 그 장소에는､ 게이트가 있었다｡"
  },
  {
   "id": 23666,
   "key": "D1105al.txt:310",
   "file": "D1105al.txt",
   "line": 310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ゲートが開き、地響きを伴って、轟音が迫る。",
   "ko_candidate": "게이트가 열리고､ 땅울림을 동반하여､ 굉음이 다가온다｡"
  },
  {
   "id": 23667,
   "key": "D1105al.txt:311",
   "file": "D1105al.txt",
   "line": 311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "朝陽の煌めきの元に、それは現れた。",
   "ko_candidate": "아침 햇살의 반짝임 아래､ 그것은 나타났다｡"
  },
  {
   "id": 23668,
   "key": "D1105al.txt:317",
   "file": "D1105al.txt",
   "line": 317,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "陽を浴びて輝く巨体。",
   "ko_candidate": "햇살을 받아 빛나는 거체｡"
  },
  {
   "id": 23669,
   "key": "D1105al.txt:318",
   "file": "D1105al.txt",
   "line": 318,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "雄々しく聳える巨体。",
   "ko_candidate": "웅장하게 솟아오른 거체｡"
  },
  {
   "id": 23670,
   "key": "D1105al.txt:319",
   "file": "D1105al.txt",
   "line": 319,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その内に秘められたパワーを誇示する巨体。",
   "ko_candidate": "그 안에 숨겨진 파워를 과시하는 거체｡"
  },
  {
   "id": 23671,
   "key": "D1105al.txt:321",
   "file": "D1105al.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "正義の代行者。",
   "ko_candidate": "정의의 대행자｡"
  },
  {
   "id": 23672,
   "key": "D1105al.txt:322",
   "file": "D1105al.txt",
   "line": 322,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アーカムシティの守護神。",
   "ko_candidate": "아캄시티의 수호신｡"
  },
  {
   "id": 23673,
   "key": "D1105al.txt:324",
   "file": "D1105al.txt",
   "line": 324,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――デモンベイン。",
   "ko_candidate": "――데몬베인｡"
  },
  {
   "id": 23674,
   "key": "D1105al.txt:325",
   "file": "D1105al.txt",
   "line": 325,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔を断つ剣。",
   "ko_candidate": "마를 베는 검｡"
  }
 ]
}