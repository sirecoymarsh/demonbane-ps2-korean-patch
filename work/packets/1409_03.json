 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ウィンフィールド": "윈필드",
  "ティトゥス": "티투스"
 },
 "items": [
  {
   "id": 38653,
   "key": "D1409ru.txt:103",
   "file": "D1409ru.txt",
   "line": 103,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "拳士ウィンフィールド、剣士ティトゥス。",
   "ko_candidate": "권사 윈필드､ 검사 티투스｡"
  },
  {
   "id": 38654,
   "key": "D1409ru.txt:104",
   "file": "D1409ru.txt",
   "line": 104,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これで、三度目の対峙。",
   "ko_candidate": "이것으로､ 세 번째 대치｡"
  },
  {
   "id": 38655,
   "key": "D1409ru.txt:105",
   "file": "D1409ru.txt",
   "line": 105,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして恐らくは――最終決戦。",
   "ko_candidate": "그리고 아마도―― 최종결전｡"
  },
  {
   "id": 38656,
   "key": "D1409ru.txt:111",
   "file": "D1409ru.txt",
   "line": 111,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「その躰で拙者と渡り合うつもりか？」",
   "ko_candidate": "「그 몸으로 나와 맞서려는 건가?」"
  },
  {
   "id": 38657,
   "key": "D1409ru.txt:114",
   "file": "D1409ru.txt",
   "line": 114,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刀を十字に構えて、ティトゥスは不敵に笑う。",
   "ko_candidate": "칼을 십자로 교차시키며､ 티투스는 뻔뻔하게 웃는다｡"
  },
  {
   "id": 38658,
   "key": "D1409ru.txt:118",
   "file": "D1409ru.txt",
   "line": 118,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「丁度良いハンデかと」",
   "ko_candidate": "「딱 좋은 핸디캡이군」"
  },
  {
   "id": 38659,
   "key": "D1409ru.txt:121",
   "file": "D1409ru.txt",
   "line": 121,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウィンフィールドの刻むステップが、速度を増す。",
   "ko_candidate": "윈필드의 새기는 스텝이､ 속도를 높인다｡"
  },
  {
   "id": 38660,
   "key": "D1409ru.txt:126",
   "file": "D1409ru.txt",
   "line": 126,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「手加減は出来んぞ」",
   "ko_candidate": "「봐주지 않겠다」"
  },
  {
   "id": 38661,
   "key": "D1409ru.txt:130",
   "file": "D1409ru.txt",
   "line": 130,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「手加減して差し上げましょうか？」",
   "ko_candidate": "「봐드려야 할까요?」"
  },
  {
   "id": 38662,
   "key": "D1409ru.txt:133",
   "file": "D1409ru.txt",
   "line": 133,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――お互い。",
   "ko_candidate": "―― 서로｡"
  },
  {
   "id": 38663,
   "key": "D1409ru.txt:134",
   "file": "D1409ru.txt",
   "line": 134,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "切り札は曝してしまっている。",
   "ko_candidate": "결정타는 이미 드러내 버렸다｡"
  },
  {
   "id": 38664,
   "key": "D1409ru.txt:135",
   "file": "D1409ru.txt",
   "line": 135,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "奇策はもう通用しない。",
   "ko_candidate": "기책은 이제 통하지 않는다｡"
  },
  {
   "id": 38665,
   "key": "D1409ru.txt:137",
   "file": "D1409ru.txt",
   "line": 137,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両者とも、互いの手の内は、知り尽くしている。",
   "ko_candidate": "양쪽 다､ 서로의 속내는､ 알아버렸다｡"
  },
  {
   "id": 38666,
   "key": "D1409ru.txt:138",
   "file": "D1409ru.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば勝負を決するのは――",
   "ko_candidate": "그렇다면 승부를 결정짓는 것은――"
  },
  {
   "id": 38667,
   "key": "D1409ru.txt:146",
   "file": "D1409ru.txt",
   "line": 146,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ははは……」",
   "ko_candidate": "「하하하…」"
  },
  {
   "id": 38668,
   "key": "D1409ru.txt:151",
   "file": "D1409ru.txt",
   "line": 151,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」",
   "ko_candidate": "「…………」"
  },
  {
   "id": 38669,
   "key": "D1409ru.txt:154",
   "file": "D1409ru.txt",
   "line": 154,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝突する高密度の闘気。",
   "ko_candidate": "충돌하는 고밀도의 투기｡"
  },
  {
   "id": 38670,
   "key": "D1409ru.txt:155",
   "file": "D1409ru.txt",
   "line": 155,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲の光景が、陽炎の様に揺らぎ、歪み、捩れるかと錯覚する程の。",
   "ko_candidate": "주위의 광경이､ 아지랑이처럼 흔들리고､ 일그러지고､ 뒤틀릴 것 같은 착각이 들 정도의｡"
  },
  {
   "id": 38671,
   "key": "D1409ru.txt:157",
   "file": "D1409ru.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人の熱気が、冷え切った大気を燃やし、蒸気となって立ち昇る。",
   "ko_candidate": "두 사람의 열기가､ 차가워진 대기를 태우고､ 증기가 되어 피어오른다｡"
  },
  {
   "id": 38672,
   "key": "D1409ru.txt:159",
   "file": "D1409ru.txt",
   "line": 159,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "２人の間、闘気の衝突点――氷に亀裂が走った。",
   "ko_candidate": "두 사람 사이､ 투기의 충돌점―― 얼음에 균열이 갔다｡"
  },
  {
   "id": 38673,
   "key": "D1409ru.txt:161",
   "file": "D1409ru.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それが合図だった。",
   "ko_candidate": "그것이 신호였다｡"
  },
  {
   "id": 38674,
   "key": "D1409ru.txt:165",
   "file": "D1409ru.txt",
   "line": 165,
   "speaker": "ティトゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「吼ォォォォォォォォォォォォ！」",
   "ko_candidate": "「으어어어어어어어어어어어어!」"
  },
  {
   "id": 38675,
   "key": "D1409ru.txt:174",
   "file": "D1409ru.txt",
   "line": 174,
   "speaker": "ウィンフィールド",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ハァァァァァアアアアアアア！」",
   "ko_candidate": "「하아아아아아아아아아아아아!」"
  },
  {
   "id": 38676,
   "key": "D1409ru.txt:177",
   "file": "D1409ru.txt",
   "line": 177,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾走る。",
   "ko_candidate": "질주한다｡"
  },
  {
   "id": 38677,
   "key": "D1409ru.txt:178",
   "file": "D1409ru.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "疾走る。",
   "ko_candidate": "질주한다｡"
  },
  {
   "id": 38678,
   "key": "D1409ru.txt:180",
   "file": "D1409ru.txt",
   "line": 180,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "氷を無数に穿つ、ウィンフィールドのフットワーク。",
   "ko_candidate": "얼음을 무수히 뚫는､ 윈필드의 풋워크｡"
  },
  {
   "id": 38679,
   "key": "D1409ru.txt:181",
   "file": "D1409ru.txt",
   "line": 181,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "亀裂はみるみる拡がる。",
   "ko_candidate": "균열은 눈 깜짝할 사이에 퍼진다｡"
  },
  {
   "id": 38680,
   "key": "D1409ru.txt:183",
   "file": "D1409ru.txt",
   "line": 183,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "間合いに入った。",
   "ko_candidate": "간합에 들어갔다｡"
  },
  {
   "id": 38681,
   "key": "D1409ru.txt:184",
   "file": "D1409ru.txt",
   "line": 184,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "先を打つのは、ティトゥスの斬撃。",
   "ko_candidate": "먼저 치는 것은､ 티투스의 참격｡"
  },
  {
   "id": 38682,
   "key": "D1409ru.txt:185",
   "file": "D1409ru.txt",
   "line": 185,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地面を這う様に、煌く刀が疾る。",
   "ko_candidate": "지면을 기듯이､ 번쩍이는 칼이 질주한다｡"
  },
  {
   "id": 38683,
   "key": "D1409ru.txt:186",
   "file": "D1409ru.txt",
   "line": 186,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "氷を両断しながら、疾る。",
   "ko_candidate": "얼음을 양단하며､ 질주한다｡"
  },
  {
   "id": 38684,
   "key": "D1409ru.txt:189",
   "file": "D1409ru.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "刀の軌跡上に、ウィンフィールドの首。",
   "ko_candidate": "칼의 궤적 위에､ 윈필드의 목｡"
  },
  {
   "id": 38685,
   "key": "D1409ru.txt:196",
   "file": "D1409ru.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――消えた。",
   "ko_candidate": "―― 사라졌다｡"
  },
  {
   "id": 38686,
   "key": "D1409ru.txt:197",
   "file": "D1409ru.txt",
   "line": 197,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ティトゥスの動体視力を以てしても、見えなかった。",
   "ko_candidate": "티투스의 동체시력으로도､ 보이지 않았다｡"
  },
  {
   "id": 38687,
   "key": "D1409ru.txt:198",
   "file": "D1409ru.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だからただ直感で２撃目を振り下ろした。",
   "ko_candidate": "그래서 그저 직감으로 2격째를 내리쳤다｡"
  },
  {
   "id": 38688,
   "key": "D1409ru.txt:206",
   "file": "D1409ru.txt",
   "line": 206,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "衝撃が爆砕する。",
   "ko_candidate": "충격이 폭쇄한다｡"
  },
  {
   "id": 38689,
   "key": "D1409ru.txt:207",
   "file": "D1409ru.txt",
   "line": 207,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "遂に耐え切れなくなった氷が、粉微塵に砕けた。",
   "ko_candidate": "마침내 견디지 못한 얼음이､ 산산조각으로 부서졌다｡"
  },
  {
   "id": 38690,
   "key": "D1409ru.txt:209",
   "file": "D1409ru.txt",
   "line": 209,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "崩れ落ちる足場。",
   "ko_candidate": "무너져 내리는 발판｡"
  },
  {
   "id": 38691,
   "key": "D1409ru.txt:210",
   "file": "D1409ru.txt",
   "line": 210,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "溢れ出す冷たい海水。",
   "ko_candidate": "넘쳐나는 차가운 바닷물｡"
  },
  {
   "id": 38692,
   "key": "D1409ru.txt:212",
   "file": "D1409ru.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "海水が氷の地表を呑み込もうとする中、衝突した拳と刀、粉砕された刃の破片が陽光を照り返して、綺羅綺羅と輝く。",
   "ko_candidate": "바닷물이 얼음 지표를 삼키려 하는 가운데､ 충돌한 주먹과 칼､ 분쇄된 칼날의 파편이 양광을 반사하여､ 반짝반짝 빛난다｡"
  }
 ]
}