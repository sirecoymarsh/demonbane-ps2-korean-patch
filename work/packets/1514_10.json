 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "ナイア": "나이아",
  "リベル・レギス": "리베르 레기스",
  "デモンベイン": "데몬베인",
  "アル": "알"
 },
 "items": [
  {
   "id": 47303,
   "key": "D1514ru.txt:473",
   "file": "D1514ru.txt",
   "line": 473,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「待て！」",
   "ko_candidate": "「기다려!」"
  },
  {
   "id": 47304,
   "key": "D1514ru.txt:477",
   "file": "D1514ru.txt",
   "line": 477,
   "speaker": "ナイア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「君はまた、あの場所からやり直すが良い。 君が生まれる前から――あのロバ・エル・カリイエから、再び此処まで歩んでおいで……」",
   "ko_candidate": "「너는 다시､ 그 장소에서 다시 시작하는 게 좋겠다｡ 네가 태어나기 전부터――그 로바 엘 카리이에부터､ 다시 여기까지 걸어와 보거라……」"
  },
  {
   "id": 47305,
   "key": "D1514ru.txt:482",
   "file": "D1514ru.txt",
   "line": 482,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「くっ……あああああ！」",
   "ko_candidate": "「크윽……아아아아아!」"
  },
  {
   "id": 47306,
   "key": "D1514ru.txt:487",
   "file": "D1514ru.txt",
   "line": 487,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇が嗤う。",
   "ko_candidate": "어둠이 비웃는다｡"
  },
  {
   "id": 47307,
   "key": "D1514ru.txt:488",
   "file": "D1514ru.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蠢く闇が。",
   "ko_candidate": "꿈틀거리는 어둠이｡"
  },
  {
   "id": 47308,
   "key": "D1514ru.txt:489",
   "file": "D1514ru.txt",
   "line": 489,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吼える闇が。",
   "ko_candidate": "포효하는 어둠이｡"
  },
  {
   "id": 47309,
   "key": "D1514ru.txt:491",
   "file": "D1514ru.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "這い寄る闇が。",
   "ko_candidate": "기어오는 어둠이｡"
  },
  {
   "id": 47310,
   "key": "D1514ru.txt:495",
   "file": "D1514ru.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "姿を変え、容を変える闇黒の、炎える眸が愉悦に歪む。",
   "ko_candidate": "모습을 바꾸고､ 형태를 바꾸는 어둠의､ 불타오르는 눈동자가 쾌락에 일그러진다｡"
  },
  {
   "id": 47311,
   "key": "D1514ru.txt:496",
   "file": "D1514ru.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そう、炎える三つの眸――",
   "ko_candidate": "그래､ 불타오르는 세 개의 눈동자――"
  },
  {
   "id": 47312,
   "key": "D1514ru.txt:498",
   "file": "D1514ru.txt",
   "line": 498,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうだ……何故、思い出せなんだ。",
   "ko_candidate": "그렇구나……왜､ 기억해내지 못했지｡"
  },
  {
   "id": 47313,
   "key": "D1514ru.txt:499",
   "file": "D1514ru.txt",
   "line": 499,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "汝は混沌の――",
   "ko_candidate": "너는 혼돈의――"
  },
  {
   "id": 47314,
   "key": "D1514ru.txt:503",
   "file": "D1514ru.txt",
   "line": 503,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ナイア、ル……ラ……ト……！」",
   "ko_candidate": "「나이아､ 르……라……토……!」"
  },
  {
   "id": 47315,
   "key": "D1514ru.txt:506",
   "file": "D1514ru.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうか。",
   "ko_candidate": "그렇구나｡"
  },
  {
   "id": 47316,
   "key": "D1514ru.txt:507",
   "file": "D1514ru.txt",
   "line": 507,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この絡繰は……この神の絡繰は……",
   "ko_candidate": "이 장치는……이 신의 장치는……"
  },
  {
   "id": 47317,
   "key": "D1514ru.txt:508",
   "file": "D1514ru.txt",
   "line": 508,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総て総て総て、この混沌の仕業。",
   "ko_candidate": "모든 모든 모든 것이､ 이 혼돈의 소행｡"
  },
  {
   "id": 47318,
   "key": "D1514ru.txt:514",
   "file": "D1514ru.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絡繰の総てを見た。",
   "ko_candidate": "장치의 모든 것을 보았다｡"
  },
  {
   "id": 47319,
   "key": "D1514ru.txt:515",
   "file": "D1514ru.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "絡繰の総てを識った。",
   "ko_candidate": "장치의 모든 것을 알았다｡"
  },
  {
   "id": 47320,
   "key": "D1514ru.txt:517",
   "file": "D1514ru.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが総ては、間に合わない。",
   "ko_candidate": "하지만 모든 것이､ 늦었다｡"
  },
  {
   "id": 47321,
   "key": "D1514ru.txt:518",
   "file": "D1514ru.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "再び、妾は輪廻の蛇に囚われる。",
   "ko_candidate": "다시､ 첩은 윤회의 뱀에 사로잡힌다｡"
  },
  {
   "id": 47322,
   "key": "D1514ru.txt:519",
   "file": "D1514ru.txt",
   "line": 519,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てを失う。",
   "ko_candidate": "모든 것을 잃는다｡"
  },
  {
   "id": 47323,
   "key": "D1514ru.txt:521",
   "file": "D1514ru.txt",
   "line": 521,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "妾は……",
   "ko_candidate": "첩은……"
  },
  {
   "id": 47324,
   "key": "D1514ru.txt:526",
   "file": "D1514ru.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "己の弱さを憎んだ。",
   "ko_candidate": "자신의 약함을 증오했다｡"
  },
  {
   "id": 47325,
   "key": "D1514ru.txt:538",
   "file": "D1514ru.txt",
   "line": 538,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "またしても、時空震に呑み込まれた。",
   "ko_candidate": "또다시､ 시공진에 삼켜졌다｡"
  },
  {
   "id": 47326,
   "key": "D1514ru.txt:539",
   "file": "D1514ru.txt",
   "line": 539,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "次元の狭間、時間の奔流を、俺は漂っている。",
   "ko_candidate": "차원의 틈새､ 시간의 급류를､ 나는 떠다니고 있다｡"
  },
  {
   "id": 47327,
   "key": "D1514ru.txt:541",
   "file": "D1514ru.txt",
   "line": 541,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……戦いはどうなった？",
   "ko_candidate": "……전투는 어떻게 됐지?"
  },
  {
   "id": 47328,
   "key": "D1514ru.txt:542",
   "file": "D1514ru.txt",
   "line": 542,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "リベル・レギスはどうした？",
   "ko_candidate": "리베르 레기스는 어떻게 됐지?"
  },
  {
   "id": 47329,
   "key": "D1514ru.txt:543",
   "file": "D1514ru.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの状態は？",
   "ko_candidate": "데몬베인의 상태는?"
  },
  {
   "id": 47330,
   "key": "D1514ru.txt:544",
   "file": "D1514ru.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はどうなっている？",
   "ko_candidate": "나는 어떻게 되고 있지?"
  },
  {
   "id": 47331,
   "key": "D1514ru.txt:546",
   "file": "D1514ru.txt",
   "line": 546,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確認を取ろうにも、視界は極彩色の闇に塞がれ、音は聴こえず、",
   "ko_candidate": "확인하려 해도､ 시야는 극채색의 어둠에 가로막히고､ 소리는 들리지 않으며､"
  },
  {
   "id": 47332,
   "key": "D1514ru.txt:547",
   "file": "D1514ru.txt",
   "line": 547,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "躰の感覚すら無い。",
   "ko_candidate": "몸의 감각조차 없다｡"
  },
  {
   "id": 47333,
   "key": "D1514ru.txt:548",
   "file": "D1514ru.txt",
   "line": 548,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "存在の手懸かりが何もない。",
   "ko_candidate": "존재의 단서가 아무것도 없다｡"
  },
  {
   "id": 47334,
   "key": "D1514ru.txt:550",
   "file": "D1514ru.txt",
   "line": 550,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それは酷い孤独と不安だった。",
   "ko_candidate": "그것은 끔찍한 고독과 불안이었다｡"
  },
  {
   "id": 47335,
   "key": "D1514ru.txt:552",
   "file": "D1514ru.txt",
   "line": 552,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ちくしょう……アル……どこに居る、アル？",
   "ko_candidate": "젠장……알……어디 있어､ 알?"
  },
  {
   "id": 47336,
   "key": "D1514ru.txt:553",
   "file": "D1514ru.txt",
   "line": 553,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何が、どうなっているんだ？",
   "ko_candidate": "무엇이､ 어떻게 되고 있는 거야?"
  },
  {
   "id": 47337,
   "key": "D1514ru.txt:555",
   "file": "D1514ru.txt",
   "line": 555,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "応えは、返ってこない。",
   "ko_candidate": "대답은､ 돌아오지 않는다｡"
  },
  {
   "id": 47338,
   "key": "D1514ru.txt:556",
   "file": "D1514ru.txt",
   "line": 556,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "気配も、感じない。",
   "ko_candidate": "기척도､ 느껴지지 않는다｡"
  },
  {
   "id": 47339,
   "key": "D1514ru.txt:558",
   "file": "D1514ru.txt",
   "line": 558,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それに応えがあったとして、多分、確かめる手段がない。",
   "ko_candidate": "게다가 대답이 있다고 해도､ 아마､ 확인할 방법이 없다｡"
  },
  {
   "id": 47340,
   "key": "D1514ru.txt:559",
   "file": "D1514ru.txt",
   "line": 559,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……ったく、いったい何なんだよ。",
   "ko_candidate": "……젠장､ 도대체 뭐란 말이야｡"
  },
  {
   "id": 47341,
   "key": "D1514ru.txt:561",
   "file": "D1514ru.txt",
   "line": 561,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……まさか俺は、既に死んでいるのだろうか？",
   "ko_candidate": "……설마 나는､ 이미 죽어 있는 걸까?"
  },
  {
   "id": 47342,
   "key": "D1514ru.txt:562",
   "file": "D1514ru.txt",
   "line": 562,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だとしたら、辻褄が合わないでもない。",
   "ko_candidate": "그렇다면､ 앞뒤가 맞지 않는 것도 아니다｡"
  }
 ]
}