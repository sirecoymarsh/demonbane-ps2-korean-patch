 "items": [
  {
   "id": 26056,
   "key": "D1111le.txt:600",
   "file": "D1111le.txt",
   "line": 600,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「くっ……！」",
   "ko_candidate": "「큿…!」"
  },
  {
   "id": 26057,
   "key": "D1111le.txt:605",
   "file": "D1111le.txt",
   "line": 605,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ヲデをバカにするデねえええええェェェェぇぇぇぇぇぇっっっ！」",
   "ko_candidate": "「나를 바보취급하는 거냐아아아아아아아아앗!」"
  },
  {
   "id": 26058,
   "key": "D1111le.txt:614",
   "file": "D1111le.txt",
   "line": 614,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "クラーケンの機体から魔力の衝撃波が吹き荒れた。",
   "ko_candidate": "크라켄의 기체에서 마력의 충격파가 휘몰아쳤다｡"
  },
  {
   "id": 26059,
   "key": "D1111le.txt:615",
   "file": "D1111le.txt",
   "line": 615,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ライカさんとハンティングホラーは弾かれ、宙を舞う。",
   "ko_candidate": "라이카 씨와 헌팅 호러는 튕겨나가 공중을 날았다｡"
  },
  {
   "id": 26060,
   "key": "D1111le.txt:620",
   "file": "D1111le.txt",
   "line": 620,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ああああああああああああ！」",
   "ko_candidate": "「아아아아아아아아아아아!」"
  },
  {
   "id": 26061,
   "key": "D1111le.txt:628",
   "file": "D1111le.txt",
   "line": 628,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「グソっ！　グソっ！　グソぉぉぉっ！　オメえら、皆殺シだぁぁぁアアアあああああああああアアアアっっっっ！」",
   "ko_candidate": "「죽어! 죽어! 죽어어어! 너희들､ 모조리 죽여버리겠어어어어어어어어어어어어어어어어어어어엇!」"
  },
  {
   "id": 26062,
   "key": "D1111le.txt:631",
   "file": "D1111le.txt",
   "line": 631,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラは理性を失っている。",
   "ko_candidate": "칼리굴라는 이성을 잃었다｡"
  },
  {
   "id": 26063,
   "key": "D1111le.txt:632",
   "file": "D1111le.txt",
   "line": 632,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "魔力の嵐はまだ収まらない。",
   "ko_candidate": "마력의 폭풍은 아직 가라앉지 않는다｡"
  },
  {
   "id": 26064,
   "key": "D1111le.txt:634",
   "file": "D1111le.txt",
   "line": 634,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "野郎……暴走しちまってるのか！",
   "ko_candidate": "이 자식… 폭주해버린 건가!"
  },
  {
   "id": 26065,
   "key": "D1111le.txt:635",
   "file": "D1111le.txt",
   "line": 635,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今、止めなければ、とんでもない被害が出てしまうかも知れない。",
   "ko_candidate": "지금 멈추지 않으면､ 엄청난 피해가 날지도 모른다｡"
  },
  {
   "id": 26066,
   "key": "D1111le.txt:637",
   "file": "D1111le.txt",
   "line": 637,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、どうする!?",
   "ko_candidate": "하지만､ 어떻게 해야 해!?"
  },
  {
   "id": 26067,
   "key": "D1111le.txt:638",
   "file": "D1111le.txt",
   "line": 638,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "どうやって止める？",
   "ko_candidate": "어떻게 멈춰야 하지?"
  },
  {
   "id": 26068,
   "key": "D1111le.txt:648",
   "file": "D1111le.txt",
   "line": 648,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎！　クラーケンのコクピットを見ろ！」",
   "ko_candidate": "「쿠로! 크라켄의 콕핏을 봐!」"
  },
  {
   "id": 26069,
   "key": "D1111le.txt:652",
   "file": "D1111le.txt",
   "line": 652,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「えっ!?」",
   "ko_candidate": "「엣!?」"
  },
  {
   "id": 26070,
   "key": "D1111le.txt:660",
   "file": "D1111le.txt",
   "line": 660,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルに言われて、気付く。",
   "ko_candidate": "알에게 말해져서､ 깨닫는다｡"
  },
  {
   "id": 26071,
   "key": "D1111le.txt:661",
   "file": "D1111le.txt",
   "line": 661,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピット部分を覆う装甲には僅かな亀裂が生じていた。",
   "ko_candidate": "콕핏 부분을 덮고 있는 장갑에 약간의 균열이 생겼다｡"
  },
  {
   "id": 26072,
   "key": "D1111le.txt:661",
   "file": "D1111le.txt",
   "line": 661,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "さっきハンティングホラーによって、傷つけられたものだ。",
   "ko_candidate": "아까 헌팅 호러에 의해 상처 입은 것이다｡"
  },
  {
   "id": 26073,
   "key": "D1111le.txt:663",
   "file": "D1111le.txt",
   "line": 663,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……そうか！",
   "ko_candidate": "…그렇구나!"
  },
  {
   "id": 26074,
   "key": "D1111le.txt:671",
   "file": "D1111le.txt",
   "line": 671,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "理解したときには、既に行動を開始している。",
   "ko_candidate": "이해했을 때는 이미 행동을 시작하고 있었다｡"
  },
  {
   "id": 26075,
   "key": "D1111le.txt:672",
   "file": "D1111le.txt",
   "line": 672,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の手には魔導拳銃が――イタクァが握られていた。",
   "ko_candidate": "내 손에는 마도권총이―― 이타콰가 쥐어져 있었다｡"
  },
  {
   "id": 26076,
   "key": "D1111le.txt:673",
   "file": "D1111le.txt",
   "line": 673,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――そう！　このイタクァならば！",
   "ko_candidate": "――그래! 이 이타콰라면!"
  },
  {
   "id": 26077,
   "key": "D1111le.txt:676",
   "file": "D1111le.txt",
   "line": 676,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ジャスティス＆ヴァニシング！」",
   "ko_candidate": "「저스티스 & 배니싱!」"
  },
  {
   "id": 26078,
   "key": "D1111le.txt:685",
   "file": "D1111le.txt",
   "line": 685,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "暗闇を灼くマズル・フラッシュ。",
   "ko_candidate": "어둠을 태우는 머즐 플래시｡"
  },
  {
   "id": 26079,
   "key": "D1111le.txt:686",
   "file": "D1111le.txt",
   "line": 686,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "銃声はきっかり６発、迷わず全弾。",
   "ko_candidate": "총성은 정확히 6발､ 망설임 없이 전탄｡"
  },
  {
   "id": 26080,
   "key": "D1111le.txt:698",
   "file": "D1111le.txt",
   "line": 698,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "複雑な軌跡を描き、６発の弾丸は全て、亀裂の中へと吸い込まれていった。",
   "ko_candidate": "복잡한 궤적을 그리며､ 6발의 탄환은 모두 균열 속으로 빨려 들어갔다｡"
  },
  {
   "id": 26081,
   "key": "D1111le.txt:703",
   "file": "D1111le.txt",
   "line": 703,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぬふ？　……ッ！　ぶぎャらああアアアああああっ！」",
   "ko_candidate": "「느후? …읏! 부갸라아아아아아아아앗!」"
  },
  {
   "id": 26082,
   "key": "D1111le.txt:706",
   "file": "D1111le.txt",
   "line": 706,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットの中に姿を消した弾丸の制御は失われる。",
   "ko_candidate": "콕핏 안으로 모습을 감춘 탄환의 제어는 상실된다｡"
  },
  {
   "id": 26083,
   "key": "D1111le.txt:707",
   "file": "D1111le.txt",
   "line": 707,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "しかし、問題ない。",
   "ko_candidate": "하지만､ 문제없다｡"
  },
  {
   "id": 26084,
   "key": "D1111le.txt:710",
   "file": "D1111le.txt",
   "line": 710,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "出口のない、狭いコクピットの中に解き放たれた６発の弾丸は、内部で縦横無尽に跳弾する。",
   "ko_candidate": "출구 없는 좁은 콕핏 안에 풀려난 6발의 총알은 내부에서 종횡무진으로 튀어다닌다｡"
  },
  {
   "id": 26085,
   "key": "D1111le.txt:711",
   "file": "D1111le.txt",
   "line": 711,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カリグラの絶叫が響き渡った。",
   "ko_candidate": "칼리굴라의 절규가 울려 퍼졌다｡"
  },
  {
   "id": 26086,
   "key": "D1111le.txt:713",
   "file": "D1111le.txt",
   "line": 713,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だが、まだだ。",
   "ko_candidate": "하지만 아직이다｡"
  },
  {
   "id": 26087,
   "key": "D1111le.txt:714",
   "file": "D1111le.txt",
   "line": 714,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "敵はアンチクロス。防禦結界が致命傷を防ぐかもしれない。",
   "ko_candidate": "적은 안티 크로스｡ 방어 결계가 치명상을 막을지도 모른다｡"
  },
  {
   "id": 26088,
   "key": "D1111le.txt:715",
   "file": "D1111le.txt",
   "line": 715,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "特にカリグラの場合は、あの分厚い筋肉の壁がある……！",
   "ko_candidate": "특히 칼리굴라의 경우는 저 두꺼운 근육의 벽이 있어……!"
  },
  {
   "id": 26089,
   "key": "D1111le.txt:720",
   "file": "D1111le.txt",
   "line": 720,
   "speaker": "ちびアル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「トドメを！」",
   "ko_candidate": "「마지막 일격을!」"
  },
  {
   "id": 26090,
   "key": "D1111le.txt:724",
   "file": "D1111le.txt",
   "line": 724,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "イタクァを術式に変換し、手の甲の紋章に戻す。",
   "ko_candidate": "이타콰를 술식으로 변환해 손등의 문장으로 되돌린다｡"
  },
  {
   "id": 26091,
   "key": "D1111le.txt:730",
   "file": "D1111le.txt",
   "line": 730,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "今度はクトゥグアを招喚した。",
   "ko_candidate": "이번엔 크투가를 소환했다｡"
  },
  {
   "id": 26092,
   "key": "D1111le.txt:731",
   "file": "D1111le.txt",
   "line": 731,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "カートリッジに入っている弾種は爆裂魔導弾。",
   "ko_candidate": "카트리지에 들어있는 탄종은 폭렬 마도탄｡"
  },
  {
   "id": 26093,
   "key": "D1111le.txt:734",
   "file": "D1111le.txt",
   "line": 734,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「遠慮は無しだ……全部くれてやる！」",
   "ko_candidate": "「사양은 없다……전부 줘버리겠어!」"
  },
  {
   "id": 26094,
   "key": "D1111le.txt:742",
   "file": "D1111le.txt",
   "line": 742,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆音の如き銃声。",
   "ko_candidate": "폭음과 같은 총성｡"
  },
  {
   "id": 26095,
   "key": "D1111le.txt:750",
   "file": "D1111le.txt",
   "line": 750,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "コクピットに降り注ぐクトゥグアの弾丸が亀裂をさらに拡げ、ついには粉微塵に吹き飛ばす。",
   "ko_candidate": "콕핏에 쏟아지는 크투가의 총알이 균열을 더욱 넓히고､ 마침내 산산조각 내버린다｡"
  }
 ]
}