 },
 "items": [
  {
   "id": 1437,
   "key": "D0113.txt:1188",
   "file": "D0113.txt",
   "line": 1188,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインの巨体が、街を疾駆する――！",
   "ko_candidate": "압도적인 존재감을 뿜어내는 거대한 칼날의 존재를｡"
  },
  {
   "id": 1438,
   "key": "D0113.txt:1193",
   "file": "D0113.txt",
   "line": 1193,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ぬおああああああああああああああああ――――――っっっっ！」 一瞬で、破壊ロボを間合いに捉える。",
   "ko_candidate": "「뭐… 뭐뭐뭐뭐뭣이이이이이――――!?」"
  },
  {
   "id": 1439,
   "key": "D0113.txt:1201",
   "file": "D0113.txt",
   "line": 1201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "右掌を振りかぶる。",
   "ko_candidate": "폭연이 완전히 걷혔다｡"
  },
  {
   "id": 1440,
   "key": "D0113.txt:1204",
   "file": "D0113.txt",
   "line": 1204,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「レムリアァァァァァァ――――ッ！」 右掌の咆吼が最高潮に達した。",
   "ko_candidate": "붉은 불꽃에 물들고 은색 달빛에 비춰져 어떤 상처 하나 입지 않은 채 그것은 유유히 서 있었다｡"
  },
  {
   "id": 1441,
   "key": "D0113.txt:1208",
   "file": "D0113.txt",
   "line": 1208,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "咆吼。",
   "ko_candidate": "――데몬베인｡"
  },
  {
   "id": 1442,
   "key": "D0113.txt:1209",
   "file": "D0113.txt",
   "line": 1209,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "咆吼。 咆吼。",
   "ko_candidate": "『블랙로지』에 대항하기 위한 수단｡"
  },
  {
   "id": 1443,
   "key": "D0113.txt:1212",
   "file": "D0113.txt",
   "line": 1212,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それは純然たる叫び。魔を断つ為の、滅ぼす為の、弔う為の、それは爆音が歌う破壊の咆吼！ 空間を引き裂く光を靡かせ、吼える右掌は、吸い込まれるように破壊ロボに伸びる……！",
   "ko_candidate": "「대단해… 완전히 무상처잖아」"
  },
  {
   "id": 1444,
   "key": "D0113.txt:1217",
   "file": "D0113.txt",
   "line": 1217,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「インパクトォォォォォ――――――ッ！」 輝く掌が破壊ロボに押し付けられた。",
   "ko_candidate": "「후훗… 점점 더 마음에 들었어､ 데몬베인｡ ――자! 이번엔 우리 차례다! 쿠로!」"
  },
  {
   "id": 1445,
   "key": "D0113.txt:1230",
   "file": "D0113.txt",
   "line": 1230,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……？　な……」 必滅の術式を流し込む。",
   "ko_candidate": "「아아… 아니､ 그러니까 나는 조종 같은 건…!」"
  },
  {
   "id": 1446,
   "key": "D0113.txt:1235",
   "file": "D0113.txt",
   "line": 1235,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "其れは猛毒のように、破壊ロボ内部に浸透する。 侵略する。",
   "ko_candidate": "「뭐든 좋으니까 언령을 뱉어! 나머지는 이쪽에서 의역할 테니!」"
  },
  {
   "id": 1447,
   "key": "D0113.txt:1241",
   "file": "D0113.txt",
   "line": 1241,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "蹂躙する。 凌辱する。",
   "ko_candidate": "에잇､ 젠장｡ 뭐란 말이야…"
  },
  {
   "id": 1448,
   "key": "D0113.txt:1244",
   "file": "D0113.txt",
   "line": 1244,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして そして",
   "ko_candidate": "아아､ 이제 됐어! 알았다고!"
  },
  {
   "id": 1449,
   "key": "D0113.txt:1246",
   "file": "D0113.txt",
   "line": 1246,
   "speaker": "ウェスト",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そして―― 「なっ!?　なななななななななな、なぁぁぁぁぁにぃぃぃぃぃぃぃぃ!?」",
   "ko_candidate": "이제､ 되는 대로 되라고! 간다…!"
  },
  {
   "id": 1450,
   "key": "D0113.txt:1263",
   "file": "D0113.txt",
   "line": 1263,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――昇華！」 世界は、閃光と沈黙の中に、閉ざされる。",
   "ko_candidate": "「그놈을 때려눕혀서 이를 덜덜 떨게 해주자고! 데몬베인!」"
  },
  {
   "id": 1451,
   "key": "D0113.txt:1276",
   "file": "D0113.txt",
   "line": 1276,
   "speaker": "サンダルフォン",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "昇滅の劫火に、呑み込まれる。 「何という威力……此れではまるで鬼械神ではないか!?」",
   "ko_candidate": "「어떤 위력인가……이것은 마치 데우스 마키나가 아닌가!」"
  },
  {
   "id": 1452,
   "key": "D0113.txt:1310",
   "file": "D0113.txt",
   "line": 1310,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "デモンベインが破壊ロボを昇滅させるその瞬間を、メタトロンとサンダルフォンはしかと見た。",
   "ko_candidate": "데몬베인이 파괴 로봇을 승멸시키는 그 순간을､ 메타트론과 산달폰은､ 똑똑히 보았다｡"
  },
  {
   "id": 1453,
   "key": "D0113.txt:1311",
   "file": "D0113.txt",
   "line": 1311,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "２人とも己の身体を震わせる戦慄を隠し得ない。",
   "ko_candidate": "둘 다､ 자신의 몸을 떨게 하는 전율을 감출 수 없다｡"
  },
  {
   "id": 1454,
   "key": "D0113.txt:1315",
   "file": "D0113.txt",
   "line": 1315,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "慄くサンダルフォンの脳内に聲が響き渡る。",
   "ko_candidate": "전율하는 산달폰의 뇌리에 목소리가 울려 퍼진다｡"
  },
  {
   "id": 1455,
   "key": "D0113.txt:1316",
   "file": "D0113.txt",
   "line": 1316,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "冷たく澄んだ、少年の聲。",
   "ko_candidate": "차갑고 맑은､ 소년의 목소리｡"
  },
  {
   "id": 1456,
   "key": "D0113.txt:1319",
   "file": "D0113.txt",
   "line": 1319,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "間違えるべくもない。 サンダルフォンの良く知る声だった。",
   "ko_candidate": "틀릴 리 없다｡ 산달폰이 잘 아는 목소리였다｡"
  },
  {
   "id": 1457,
   "key": "D0113.txt:1326",
   "file": "D0113.txt",
   "line": 1326,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――ドクターは敗北したようだな。サンダルフォン、撤退せよ」",
   "ko_candidate": "「――닥터는 패배한 것 같군｡ 산달폰､ 철수하라」"
  },
  {
   "id": 1458,
   "key": "D0113.txt:1331",
   "file": "D0113.txt",
   "line": 1331,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「――大導師。 しかし、まだメタトロンが」",
   "ko_candidate": "「――그랜드 마스터｡ 하지만､ 아직 메타트론이」"
  },
  {
   "id": 1459,
   "key": "D0113.txt:1337",
   "file": "D0113.txt",
   "line": 1337,
   "speaker": "マスターテリオン",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「命令だ」",
   "ko_candidate": "「명령이다」"
  },
  {
   "id": 1460,
   "key": "D0113.txt:1342",
   "file": "D0113.txt",
   "line": 1342,
   "speaker": "サンダルフォン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……了解。メタトロン―― 貴様の命、預けておく」 白の天使に一瞥だけくれて、サンダルフォンは昏い闇の軌跡を描き、翔び去っていた。",
   "ko_candidate": "이의를 허용하지 않는 목소리｡"
  },
  {
   "id": 1461,
   "key": "D0113.txt:1358",
   "file": "D0113.txt",
   "line": 1358,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "メタトロンは追わなかった。",
   "ko_candidate": "산달폰은 마지못해､ 고개를 끄덕였다｡"
  },
  {
   "id": 1462,
   "key": "D0113.txt:1360",
   "file": "D0113.txt",
   "line": 1360,
   "speaker": "メタトロン",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ただ取り憑かれたように、昇滅の焔を前に佇むデモンベインを見つめ続ける。 「デモンベイン…… これ程までとは」",
   "ko_candidate": "「……알겠습니다｡ 메타트론――네놈의 목숨､ 맡겨두지」"
  },
  {
   "id": 1463,
   "key": "D0113.txt:1370",
   "file": "D0113.txt",
   "line": 1370,
   "speaker": "メタトロン",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや、これ程までの化物でなければ『ブラックロッジ』と互角に渡り合えない。そう言いたいのか、覇道鋼造――」",
   "ko_candidate": "하얀 천사에게 한 번 힐끗 보고､ 산달폰은 밤에､ 더 어두운 어둠의 궤적을 그리며､ 날아가 버렸다｡ 메타트론은 쫓지 않았다｡"
  },
  {
   "id": 1464,
   "key": "D0113.txt:1386",
   "file": "D0113.txt",
   "line": 1386,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――レムリア・インパクト」 「敵の字祷子構成を崩壊させる、必滅の術式」",
   "ko_candidate": "단지 홀린 듯이､ 불길을 내려다보며 서 있는 데몬베인을 계속 바라본다｡"
  },
  {
   "id": 1465,
   "key": "D0113.txt:1392",
   "file": "D0113.txt",
   "line": 1392,
   "speaker": "チアキ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「存在崩壊を喚起させられた敵対象 の内宇宙に特異点を発現させ、 質量零、重力無限大、熱量無限大 の状況を生み出し、昇滅せしめる 究極の奥義……」 「って、まあ理屈は一応解かるんやけど……何ちゅーか、実際、目の当たりにすると何も言えんわ……」",
   "ko_candidate": "「데몬베인……이 정도일 줄이야｡ 아니､ 이 정도의 괴물이 아니면 『블랙로지』와 대등하게 맞설 수 없다｡ 그렇게 말하고 싶은 거냐､ 하도 코조――」"
  },
  {
   "id": 1466,
   "key": "D0113.txt:1404",
   "file": "D0113.txt",
   "line": 1404,
   "speaker": "ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「す、すごい……」",
   "ko_candidate": "「………………」"
  },
  {
   "id": 1467,
   "key": "D0113.txt:1409",
   "file": "D0113.txt",
   "line": 1409,
   "speaker": "マコト / ソーニャ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――昇華術式の対昇滅を確認。若干の制御誤差がありましたが、被害は予測範囲内です」 「若干って!? で、でもアレ……！」",
   "ko_candidate": "나는……그저 멍하니､ 그 광경을 바라볼 수밖에 없었다｡"
  },
  {
   "id": 1468,
   "key": "D0113.txt:1420",
   "file": "D0113.txt",
   "line": 1420,
   "speaker": "マコト / ウィンフィールド",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「――だから、予測範囲内。あの区画は避難済みだから死傷者もいない」 「ヒラニプラ・システムの再調整が必要ですね。ですが期待以上の戦果です」",
   "ko_candidate": "마음은 완전히 마비되어 있고､ 머릿속도 완전히 혼란스럽다｡"
  },
  {
   "id": 1469,
   "key": "D0113.txt:1435",
   "file": "D0113.txt",
   "line": 1435,
   "speaker": "瑠璃 / 九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「………………」 「………………」",
   "ko_candidate": "눈앞의 현실을､ 받아들일 수가 없었다｡"
  },
  {
   "id": 1470,
   "key": "D0113.txt:1463",
   "file": "D0113.txt",
   "line": 1463,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は……ただ呆然と、 その光景を眺め続けるしかなかった。",
   "ko_candidate": "「훗……뭐､ 처음치고는 잘했다고 할까｡ 그렇지､ 쿠로?」"
  },
  {
   "id": 1471,
   "key": "D0113.txt:1467",
   "file": "D0113.txt",
   "line": 1467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "心は完全に麻痺していて頭ん中も完全に混乱している。",
   "ko_candidate": "인외소녀는 태연한 어조로､ 그렇게 말을 건넨다｡"
  },
  {
   "id": 1472,
   "key": "D0113.txt:1468",
   "file": "D0113.txt",
   "line": 1468,
   "speaker": "アル",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "目の前の現実を受け入れることが出来なかった。 「ふっ……まあ、最初にしては 上出来か。のぅ、九郎？」",
   "ko_candidate": "나는 아무 대답도 할 수 없었다｡"
  },
  {
   "id": 1473,
   "key": "D0113.txt:1480",
   "file": "D0113.txt",
   "line": 1480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "人外娘はしれっとした口調で、そう語りかける。",
   "ko_candidate": "그저 입을 벌린 채 멍청한 표정을 짓고 있을 뿐이다｡"
  },
  {
   "id": 1474,
   "key": "D0113.txt:1482",
   "file": "D0113.txt",
   "line": 1482,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "俺は何も答えられなかった。ただ口をぽかんと開けたマヌケづらをぶら下げるばかりだ。 だって……これって……洒落になってねえぞ？",
   "ko_candidate": "왜냐하면……이건……농담이 아니잖아?"
  },
  {
   "id": 1475,
   "key": "D0113.txt:1486",
   "file": "D0113.txt",
   "line": 1486,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……何なんだよ、このロボット？",
   "ko_candidate": "……뭐야､ 이 로봇?"
  },
  {
   "id": 1476,
   "key": "D0113.txt:1487",
   "file": "D0113.txt",
   "line": 1487,
   "speaker": null,
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "『ブラックロッジ』の破壊ロボなんかより、 こいつの方がよっぽど危険じゃないか！",
