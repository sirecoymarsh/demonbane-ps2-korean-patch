 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アル": "알",
  "エンネア": "엔네아",
  "九郎": "쿠로",
  "アーカムシティ": "아컴시티"
 },
 "items": [
  {
   "id": 14050,
   "key": "D0808al.txt:332",
   "file": "D0808al.txt",
   "line": 332,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "不貞腐れるアルを見て、エンネアが笑う。",
   "ko_candidate": "뾰로통해 있는 알을 보고 엔네아가 웃는다｡"
  },
  {
   "id": 14051,
   "key": "D0808al.txt:333",
   "file": "D0808al.txt",
   "line": 333,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いつもと同じ、意地悪な眼差し。",
   "ko_candidate": "언제나와 같은 심술궂은 눈빛｡"
  },
  {
   "id": 14052,
   "key": "D0808al.txt:338",
   "file": "D0808al.txt",
   "line": 338,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「大丈夫、大丈夫だよ。 優しいエンネアちゃんは、寂しいアルちゃんを仲間外れになんかしないよぉ？」 「……まあ、ホントは九郎と２人きりでデートを楽しみたいところなんだけど、しょーがないっ！」",
   "ko_candidate": "「괜찮아､ 괜찮다고｡ 상냥한 엔네아 쨩은 외로운 알 쨩을 따돌리지 않을 거야? …뭐､ 사실은 쿠로랑 둘이서 데이트를 즐기고 싶은 거지만､ 어쩔 수 없지! 알이 너무 불쌍하고 처량해서 제대로 같이 데려갈 테니까｡ 응､ 감사하도록 해」"
  },
  {
   "id": 14053,
   "key": "D0808al.txt:346",
   "file": "D0808al.txt",
   "line": 346,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「アルが哀れで惨め過ぎるから、ちゃんと一緒に連れていってあげるから」 「うん、感謝するよーに」",
   "ko_candidate": "「네에에에…!」"
  },
  {
   "id": 14054,
   "key": "D0808al.txt:355",
   "file": "D0808al.txt",
   "line": 355,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「汝ぇぇぇ……っ！」 ふぅ～～～～～～～～…………。",
   "ko_candidate": "후우~~~~~~~…………。"
  },
  {
   "id": 14055,
   "key": "D0808al.txt:359",
   "file": "D0808al.txt",
   "line": 359,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……やれやれ。",
   "ko_candidate": "……정말이지。"
  },
  {
   "id": 14056,
   "key": "D0808al.txt:380",
   "file": "D0808al.txt",
   "line": 380,
   "speaker": "クラウディウス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 14057,
   "key": "D0808al.txt:387",
   "file": "D0808al.txt",
   "line": 387,
   "speaker": "カリグラ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――――――」",
   "ko_candidate": "「――――――」"
  },
  {
   "id": 14058,
   "key": "D0808al.txt:394",
   "file": "D0808al.txt",
   "line": 394,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――主は、私を広い場所に導き出し、私をお救いなされた。主が私を喜びとされたから。",
   "ko_candidate": "――주님은 나를 넓은 곳으로 인도하시어 구원하셨다｡ 주님이 나를 기뻐하셨기 때문에｡"
  },
  {
   "id": 14059,
   "key": "D0808al.txt:403",
   "file": "D0808al.txt",
   "line": 403,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ちょうど日曜とあってか、街は人で溢れかえっていた。",
   "ko_candidate": "마침 일요일이라 그런지 거리는 사람들로 넘쳐났다｡"
  },
  {
   "id": 14060,
   "key": "D0808al.txt:405",
   "file": "D0808al.txt",
   "line": 405,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人の波を器用に抜けながら、エンネアはスカートを翻しつつ、元気に駆け回る。だが、その速度に付き合わされる俺たちは、たまったもんではない。",
   "ko_candidate": "사람들의 물결을 능숙하게 빠져나가며 엔네아는 치마를 휘날리며 힘차게 뛰어다닌다｡ 하지만 그 속도에 맞춰야 하는 우리로서는 견디기 힘들다｡"
  },
  {
   "id": 14061,
   "key": "D0808al.txt:410",
   "file": "D0808al.txt",
   "line": 410,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「にゃははは！　九郎――っ！　はやくはやく――ぅ！」",
   "ko_candidate": "「냐하하하! 쿠로――! 빨리빨리――!」"
  },
  {
   "id": 14062,
   "key": "D0808al.txt:414",
   "file": "D0808al.txt",
   "line": 414,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「って……速すぎるっての！　こっちのペースにも合わせてくれっ！」",
   "ko_candidate": "「아니……너무 빠르다고! 우리 페이스에도 맞춰줘!」"
  },
  {
   "id": 14063,
   "key": "D0808al.txt:419",
   "file": "D0808al.txt",
   "line": 419,
   "speaker": "エンネア",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「にゃはははははは！」",
   "ko_candidate": "「냐하하하하하!」"
  },
  {
   "id": 14064,
   "key": "D0808al.txt:422",
   "file": "D0808al.txt",
   "line": 422,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "毒づく俺には構わず、エンネアはどんどん先に進む。",
   "ko_candidate": "투덜거리는 나를 무시하고 엔네아는 계속 앞으로 나아간다｡"
  },
  {
   "id": 14065,
   "key": "D0808al.txt:423",
   "file": "D0808al.txt",
   "line": 423,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……まったく。",
   "ko_candidate": "……정말이지｡"
  },
  {
   "id": 14066,
   "key": "D0808al.txt:428",
   "file": "D0808al.txt",
   "line": 428,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ぶすっ」",
   "ko_candidate": "「……흥」"
  },
  {
   "id": 14067,
   "key": "D0808al.txt:431",
   "file": "D0808al.txt",
   "line": 431,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺の後ろから、仏頂面でアルが付いてくる。",
   "ko_candidate": "내 뒤에서 무뚝뚝한 표정으로 알이 따라온다｡"
  },
  {
   "id": 14068,
   "key": "D0808al.txt:432",
   "file": "D0808al.txt",
   "line": 432,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "こっちはこっちで相変わらず、剣呑な雰囲気だ。",
   "ko_candidate": "여기는 여기대로 여전히 살벌한 분위기다｡"
  },
  {
   "id": 14069,
   "key": "D0808al.txt:435",
   "file": "D0808al.txt",
   "line": 435,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アル……今日は見ての通り、人が多いんだからな。 あんましエンネアと派手にやらかすんじゃねえぞ」",
   "ko_candidate": "「알……오늘은 보다시피 사람이 많으니까｡ 엔네아랑 너무 눈에 띄게 행동하지 마」"
  },
  {
   "id": 14070,
   "key": "D0808al.txt:441",
   "file": "D0808al.txt",
   "line": 441,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「知るか」",
   "ko_candidate": "「알게 뭐야」"
  },
  {
   "id": 14071,
   "key": "D0808al.txt:446",
   "file": "D0808al.txt",
   "line": 446,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「ぶーぶー！　遅いと置いてっちゃうぞ～～～～～～っ！」",
   "ko_candidate": "「부우부우! 느리면 놔두고 갈 거야~~~~~!」"
  },
  {
   "id": 14072,
   "key": "D0808al.txt:451",
   "file": "D0808al.txt",
   "line": 451,
   "speaker": "アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ふんっ」",
   "ko_candidate": "「……흥」"
  },
  {
   "id": 14073,
   "key": "D0808al.txt:455",
   "file": "D0808al.txt",
   "line": 455,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……………………」",
   "ko_candidate": "「……………………」"
  },
  {
   "id": 14074,
   "key": "D0808al.txt:457",
   "file": "D0808al.txt",
   "line": 457,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――狂おしく不安だ。",
   "ko_candidate": "――미칠 듯이 불안하다｡"
  },
  {
   "id": 14075,
   "key": "D0808al.txt:471",
   "file": "D0808al.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンネアは俺たちを散々引っぱり回し、遊び回った。",
   "ko_candidate": "엔네아는 우리를 이리저리 끌고 다니며 놀아댔다｡"
  },
  {
   "id": 14076,
   "key": "D0808al.txt:473",
   "file": "D0808al.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "映画を見た後で、ショッピング。",
   "ko_candidate": "영화를 본 후에 쇼핑｡"
  },
  {
   "id": 14077,
   "key": "D0808al.txt:474",
   "file": "D0808al.txt",
   "line": 474,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "洋服やら小物やら人形やら本やら。",
   "ko_candidate": "옷이며 소품이며 인형이며 책이며｡"
  },
  {
   "id": 14078,
   "key": "D0808al.txt:476",
   "file": "D0808al.txt",
   "line": 476,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それこそ露店の一つも洩らさずに徹底的に。",
   "ko_candidate": "노점상 하나도 빠뜨리지 않고 철저하게｡"
  },
  {
   "id": 14079,
   "key": "D0808al.txt:477",
   "file": "D0808al.txt",
   "line": 477,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "……女ってえのはつくづく買い物が好きだと思う。",
   "ko_candidate": "……여자란 정말 쇼핑을 좋아한다고 생각한다｡"
  },
  {
   "id": 14080,
   "key": "D0808al.txt:479",
   "file": "D0808al.txt",
   "line": 479,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "しかし……何でだろう？",
   "ko_candidate": "하지만……왜일까?"
  },
  {
   "id": 14081,
   "key": "D0808al.txt:480",
   "file": "D0808al.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無邪気にはしゃぐエンネアの顔に、ときおり……ほんの一瞬、誰にも気付かせないほどに一瞬……虚しさのような寂しさのような、そんな哀しい表情が浮かんでは消えてゆく。",
   "ko_candidate": "천진난만하게 들떠있는 엔네아의 얼굴에､ 때때로……아주 잠깐､ 누구도 눈치채지 못할 만큼 짧은 순간……공허함이나 외로움 같은､ 그런 슬픈 표정이 스쳐 지나갔다가 사라진다｡"
  },
  {
   "id": 14082,
   "key": "D0808al.txt:482",
   "file": "D0808al.txt",
   "line": 482,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そしてそのたびに、必要以上に騒ぎ、はしゃぐ。",
   "ko_candidate": "그리고 그때마다 필요 이상으로 떠들고 들뜬다｡"
  },
  {
   "id": 14083,
   "key": "D0808al.txt:483",
   "file": "D0808al.txt",
   "line": 483,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "力の限りを尽くして、今、この瞬間を楽しもうとしている。",
   "ko_candidate": "온 힘을 다해 지금､ 이 순간을 즐기려 하고 있다｡"
  },
  {
   "id": 14084,
   "key": "D0808al.txt:484",
   "file": "D0808al.txt",
   "line": 484,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "今、この瞬間に、かけがえの無いものを見い出そうとしているように。",
   "ko_candidate": "지금､ 이 순간에 소중한 무언가를 찾으려는 것처럼｡"
  },
  {
   "id": 14085,
   "key": "D0808al.txt:486",
   "file": "D0808al.txt",
   "line": 486,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だから俺は、何の文句も言えなかった。",
   "ko_candidate": "그래서 나는 아무 말도 할 수 없었다｡"
  },
  {
   "id": 14086,
   "key": "D0808al.txt:488",
   "file": "D0808al.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "休日のアーカムシティ。",
   "ko_candidate": "휴일의 아캄시티｡"
  },
  {
   "id": 14087,
   "key": "D0808al.txt:489",
   "file": "D0808al.txt",
   "line": 489,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "家族連れやカップルで賑わう、ショッピング街。",
   "ko_candidate": "가족들과 연인들로 북적이는 쇼핑가｡"
  },
  {
   "id": 14088,
   "key": "D0808al.txt:490",
   "file": "D0808al.txt",
   "line": 490,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "幸福を、喜びを謡う街を、エンネアは駆ける。",
   "ko_candidate": "행복과 기쁨을 노래하는 거리를 엔네아는 달린다｡"
  },
  {
   "id": 14089,
   "key": "D0808al.txt:491",
   "file": "D0808al.txt",
   "line": 491,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "全力で、笑い、楽しみ、喜び、遊ぶ。",
   "ko_candidate": "전력으로 웃고､ 즐기고､ 기뻐하고､ 논다｡"
  }
 ]
}