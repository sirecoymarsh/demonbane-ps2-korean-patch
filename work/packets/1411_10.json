   "line": 839,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……相変わらず無謀だな、汝は」",
   "ko_candidate": "「……여전히 무모하구나､ 너는」"
  },
  {
   "id": 39460,
   "key": "D1411ru.txt:843",
   "file": "D1411ru.txt",
   "line": 843,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やりたくて、無謀やってんじゃねえよ……多分」",
   "ko_candidate": "「하고 싶어서 무모한 짓 하는 게 아니라고…… 아마도」"
  },
  {
   "id": 39461,
   "key": "D1411ru.txt:845",
   "file": "D1411ru.txt",
   "line": 845,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "術式を構築して、演算して、魔術を編み上げる。",
   "ko_candidate": "술식을 구축하고､ 연산하고､ 마술을 짜올린다｡"
  },
  {
   "id": 39462,
   "key": "D1411ru.txt:846",
   "file": "D1411ru.txt",
   "line": 846,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自らの望む現象をこの場に顕現する。",
   "ko_candidate": "자신이 원하는 현상을 이 자리에 현현시킨다｡"
  },
  {
   "id": 39463,
   "key": "D1411ru.txt:847",
   "file": "D1411ru.txt",
   "line": 847,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲の変化にアウグストゥスが訝しげな声を上げた。",
   "ko_candidate": "주위의 변화에 아우구스투스가 의아한 목소리를 냈다｡"
  },
  {
   "id": 39464,
   "key": "D1411ru.txt:853",
   "file": "D1411ru.txt",
   "line": 853,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「……何だ？」",
   "ko_candidate": "「……뭐지?」"
  },
  {
   "id": 39465,
   "key": "D1411ru.txt:859",
   "file": "D1411ru.txt",
   "line": 859,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光。",
   "ko_candidate": "빛｡"
  },
  {
   "id": 39466,
   "key": "D1411ru.txt:860",
   "file": "D1411ru.txt",
   "line": 860,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインの周囲を囲う、無数の光。",
   "ko_candidate": "데몬베인 주위를 둘러싼 무수한 빛｡"
  },
  {
   "id": 39467,
   "key": "D1411ru.txt:861",
   "file": "D1411ru.txt",
   "line": 861,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それ自体が光を放っているのではない。この大広間にある光源を跳ね返しているだけだ。",
   "ko_candidate": "그 자체가 빛을 내는 게 아니다｡ 이 대광간에 있는 광원을 반사하고 있을 뿐이다｡"
  },
  {
   "id": 39468,
   "key": "D1411ru.txt:863",
   "file": "D1411ru.txt",
   "line": 863,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即ち――鏡。",
   "ko_candidate": "즉―― 거울｡"
  },
  {
   "id": 39469,
   "key": "D1411ru.txt:866",
   "file": "D1411ru.txt",
   "line": 866,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ニトクリスの鏡の招喚。",
   "ko_candidate": "니토크리스의 거울 소환｡"
  },
  {
   "id": 39470,
   "key": "D1411ru.txt:868",
   "file": "D1411ru.txt",
   "line": 868,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の鏡を周囲の空間に浮遊させた。",
   "ko_candidate": "무수한 거울을 주위 공간에 떠다니게 했다｡"
  },
  {
   "id": 39471,
   "key": "D1411ru.txt:870",
   "file": "D1411ru.txt",
   "line": 870,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鏡の中に幾重にも映し出される、鏡の数を越えた無数の、デモンベインの姿。",
   "ko_candidate": "거울 속에 겹겹이 비치는､ 거울 수를 넘어선 무수한 데몬베인의 모습｡"
  },
  {
   "id": 39472,
   "key": "D1411ru.txt:872",
   "file": "D1411ru.txt",
   "line": 872,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限に広がった光景の、デモンベインの大軍の只中に、俺は立つ。",
   "ko_candidate": "무한히 펼쳐진 광경의､ 데몬베인 대군의 한가운데에 내가 서 있다｡"
  },
  {
   "id": 39473,
   "key": "D1411ru.txt:874",
   "file": "D1411ru.txt",
   "line": 874,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それを見たアウグストゥスが、俺の意図に気づいたのか、嘲りを含んだ声で笑う。",
   "ko_candidate": "그것을 본 아우구스투스가 내 의도를 눈치챘는지 조롱을 담은 목소리로 웃는다｡"
  },
  {
   "id": 39474,
   "key": "D1411ru.txt:884",
   "file": "D1411ru.txt",
   "line": 884,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ふはははははは！　そんなものでこのレガシー・オブ・ゴールドの攻撃を防ぎ切るつもりかね!?　面白い！　付き合ってあげようではないか！」",
   "ko_candidate": "「후하하하하하! 그런 걸로 이 레거시 오브 골드의 공격을 막아낼 생각인가!? 재밌군! 상대해주지!」"
  },
  {
   "id": 39475,
   "key": "D1411ru.txt:889",
   "file": "D1411ru.txt",
   "line": 889,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "レガシー・オブ・ゴールドの砲口が一斉に、兇暴な破壊の光を湛える。 ――来るか！",
   "ko_candidate": "레거시 오브 골드의 포구가 일제히 흉포한 파괴의 빛을 머금는다｡"
  },
  {
   "id": 39476,
   "key": "D1411ru.txt:894",
   "file": "D1411ru.txt",
   "line": 894,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「シャンタク！」",
   "ko_candidate": "――온다! 「샨타크!」"
  },
  {
   "id": 39477,
   "key": "D1411ru.txt:900",
   "file": "D1411ru.txt",
   "line": 900,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "レガシー・オブ・ゴールドが次の行動に入るよりも迅く、俺はデモンベインを疾走させる。",
   "ko_candidate": "레거시 오브 골드가 다음 행동에 들어가기보다 빠르게 나는 데몬베인을 질주시킨다｡"
  },
  {
   "id": 39478,
   "key": "D1411ru.txt:902",
   "file": "D1411ru.txt",
   "line": 902,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "周囲の鏡もデモンベインに並行して飛翔する。",
   "ko_candidate": "주위의 거울도 데몬베인과 나란히 비행한다｡"
  },
  {
   "id": 39479,
   "key": "D1411ru.txt:904",
   "file": "D1411ru.txt",
   "line": 904,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無数の鏡を引き連れ、駆ける。駆ける。翔ける。",
   "ko_candidate": "무수한 거울을 이끌고 달린다｡ 달린다｡ 날아간다｡"
  },
  {
   "id": 39480,
   "key": "D1411ru.txt:906",
   "file": "D1411ru.txt",
   "line": 906,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "金色の爆光が迸った。",
   "ko_candidate": "황금빛 폭광이 터져 나왔다｡"
  },
  {
   "id": 39481,
   "key": "D1411ru.txt:912",
   "file": "D1411ru.txt",
   "line": 912,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "デモンベインを、その兇悪な破壊の牙の餌食とすべく飛来する、ビームの群れ！　ビームの雨！　ビームの嵐……！",
   "ko_candidate": "데몬베인을 그 흉악한 파괴의 이빨의 먹잇감으로 삼고자 날아오는 빔의 무리! 빔의 비! 빔의 폭풍……!"
  },
  {
   "id": 39482,
   "key": "D1411ru.txt:915",
   "file": "D1411ru.txt",
   "line": 915,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ミラー・シールド！」",
   "ko_candidate": "「미러 실드!」"
  },
  {
   "id": 39483,
   "key": "D1411ru.txt:917",
   "file": "D1411ru.txt",
   "line": 917,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "数枚の鏡を操り、デモンベインの前方に飛び出させた。",
   "ko_candidate": "몇 장의 거울을 조종해 데몬베인 전방으로 날려보냈다｡"
  },
  {
   "id": 39484,
   "key": "D1411ru.txt:926",
   "file": "D1411ru.txt",
   "line": 926,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ビームを反射させ砕け散る鏡。別のビームをまた別の鏡で受け止める。",
   "ko_candidate": "빔을 반사시키며 부서지는 거울｡ 다른 빔을 또 다른 거울로 받아낸다｡"
  },
  {
   "id": 39485,
   "key": "D1411ru.txt:928",
   "file": "D1411ru.txt",
   "line": 928,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その絶え間ない繰り返し。",
   "ko_candidate": "그 끊임없는 반복｡"
  },
  {
   "id": 39486,
   "key": "D1411ru.txt:930",
   "file": "D1411ru.txt",
   "line": 930,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "果たして奴に接近するまでに、鏡の枚数がもつか……！",
   "ko_candidate": "과연 놈에게 접근할 때까지 거울의 개수가 버틸 수 있을까……!"
  },
  {
   "id": 39487,
   "key": "D1411ru.txt:939",
   "file": "D1411ru.txt",
   "line": 939,
   "speaker": "アウグストゥス",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「最後の秘策がそれかね!?　哀しいなぁ、デモンベイン！」",
   "ko_candidate": "「마지막 비책이 그것이냐!? 슬프구나､ 데몬베인!」"
  },
  {
   "id": 39488,
   "key": "D1411ru.txt:949",
   "file": "D1411ru.txt",
   "line": 949,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "飛来する光、光、光の束。",
   "ko_candidate": "날아오는 빛､ 빛､ 빛의 다발｡"
  },
  {
   "id": 39489,
   "key": "D1411ru.txt:951",
   "file": "D1411ru.txt",
   "line": 951,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "砕け散る鏡の破片。",
   "ko_candidate": "부서져 흩어지는 거울의 파편｡"
  },
  {
   "id": 39490,
   "key": "D1411ru.txt:953",
   "file": "D1411ru.txt",
   "line": 953,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "照り返された光が、紅の水面で踊る。",
   "ko_candidate": "반사된 빛이 붉은 수면에서 춤춘다｡"
  },
  {
   "id": 39491,
   "key": "D1411ru.txt:955",
   "file": "D1411ru.txt",
   "line": 955,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そんな眩く、幻想的ですらある光景の中を、デモンベインは疾走る。",
   "ko_candidate": "그런 눈부시고､ 환상적이기까지 한 광경 속을 데몬베인은 질주한다｡"
  },
  {
   "id": 39492,
   "key": "D1411ru.txt:957",
   "file": "D1411ru.txt",
   "line": 957,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして最後の一枚が――",
   "ko_candidate": "그리고 마지막 한 장이――"
  },
  {
   "id": 39493,
   "key": "D1411ru.txt:962",
   "file": "D1411ru.txt",
   "line": 962,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「駄目……なのか！」",
   "ko_candidate": "「안 돼……인가!」"
  },
  {
   "id": 39494,
   "key": "D1411ru.txt:973",
   "file": "D1411ru.txt",
   "line": 973,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "割れた。",
   "ko_candidate": "깨졌다｡"
  },
  {
   "id": 39495,
   "key": "D1411ru.txt:975",
   "file": "D1411ru.txt",
   "line": 975,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "距離は……もう少しなのに。",
   "ko_candidate": "거리는…… 조금만 더 가면 되는데｡"
  },
  {
   "id": 39496,
   "key": "D1411ru.txt:977",
   "file": "D1411ru.txt",
   "line": 977,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あと少しなのに。",
   "ko_candidate": "조금만 더인데｡"
  },
  {
   "id": 39497,
   "key": "D1411ru.txt:982",
   "file": "D1411ru.txt",
   "line": 982,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "でも、これじゃあ届かない。",
   "ko_candidate": "하지만､ 이래서는 닿지 않아｡"
  },
  {
   "id": 39498,
   "key": "D1411ru.txt:984",
   "file": "D1411ru.txt",
   "line": 984,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "とてもじゃないが届かない。",
   "ko_candidate": "도저히 닿지 않아｡"
  }
 ]
}