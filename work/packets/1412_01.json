 "items": [
  {
   "id": 39739,
   "key": "D1412al.txt:165",
   "file": "D1412al.txt",
   "line": 165,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目に映るものが信じられない。",
   "ko_candidate": "눈에 보이는 것을 믿을 수가 없다｡"
  },
  {
   "id": 39740,
   "key": "D1412al.txt:166",
   "file": "D1412al.txt",
   "line": 166,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何で彼女がそこに居るんだ？ そこに居るのは裏切り者のアンチクロスのはずなのに。",
   "ko_candidate": "왜 그녀가 거기에 있는 거지? 거기에 있는 건 배신자인 안티 크로스여야 하는데｡"
  },
  {
   "id": 39741,
   "key": "D1412al.txt:168",
   "file": "D1412al.txt",
   "line": 168,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "いやそれ以前に……何で彼女が生きているんだ!?",
   "ko_candidate": "아니 그보다도……왜 그녀가 살아있는 거지!?"
  },
  {
   "id": 39742,
   "key": "D1412al.txt:172",
   "file": "D1412al.txt",
   "line": 172,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「やっほー、九郎元気ー？」",
   "ko_candidate": "「안녕~ 쿠로 잘 지냈어?」"
  },
  {
   "id": 39743,
   "key": "D1412al.txt:178",
   "file": "D1412al.txt",
   "line": 178,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「大バビロン――地上の淫婦と憎むべき者との母」",
   "ko_candidate": "「큰 바빌론――지상의 음녀와 증오스러운 것들의 어미」"
  },
  {
   "id": 39744,
   "key": "D1412al.txt:186",
   "file": "D1412al.txt",
   "line": 186,
   "speaker": "九郎＆アル",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「エンネア！」",
   "ko_candidate": "「엔네아!」"
  },
  {
   "id": 39745,
   "key": "D1412al.txt:189",
   "file": "D1412al.txt",
   "line": 189,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "出てきたのは、間違いない、 どこか猫を連想させる愛嬌を持ったあの少女だ。",
   "ko_candidate": "나온 것은 틀림없이 어딘가 고양이를 연상시키는 애교를 가진 그 소녀다｡"
  },
  {
   "id": 39746,
   "key": "D1412al.txt:191",
   "file": "D1412al.txt",
   "line": 191,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "僅かながらも俺達と同じ時間を過ごしたあの少女だ。",
   "ko_candidate": "잠시나마 우리와 같은 시간을 보냈던 그 소녀다｡"
  },
  {
   "id": 39747,
   "key": "D1412al.txt:192",
   "file": "D1412al.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だけど彼女はあのとき……",
   "ko_candidate": "하지만 그녀는 그때……"
  },
  {
   "id": 39748,
   "key": "D1412al.txt:194",
   "file": "D1412al.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "エンネアが笑いながら、 ぱたぱたと手と首を横に振った。",
   "ko_candidate": "엔네아가 웃으면서 파닥파닥 손과 목을 옆으로 흔들었다｡"
  },
  {
   "id": 39749,
   "key": "D1412al.txt:196",
   "file": "D1412al.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "否定の意味。",
   "ko_candidate": "부정의 의미｡"
  },
  {
   "id": 39750,
   "key": "D1412al.txt:200",
   "file": "D1412al.txt",
   "line": 200,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「違う違う。ごめん。 その名前、嘘」 「ネロは本当は ネロって呼ばれているんだ」",
   "ko_candidate": "「아니 아니｡ 미안｡ 그 이름､ 거짓말이야｡ 네로는 사실 네로라고 불리고 있어」"
  },
  {
   "id": 39751,
   "key": "D1412al.txt:209",
   "file": "D1412al.txt",
   "line": 209,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「な――――？」",
   "ko_candidate": "「뭐――――?」"
  },
  {
   "id": 39752,
   "key": "D1412al.txt:211",
   "file": "D1412al.txt",
   "line": 211,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ネロ。",
   "ko_candidate": "네로｡"
  },
  {
   "id": 39753,
   "key": "D1412al.txt:212",
   "file": "D1412al.txt",
   "line": 212,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "その名が意味するのは１人。",
   "ko_candidate": "그 이름이 의미하는 건 한 사람｡"
  },
  {
   "id": 39754,
   "key": "D1412al.txt:213",
   "file": "D1412al.txt",
   "line": 213,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "分かっている。 分かっているが……何で彼女が!?",
   "ko_candidate": "알고 있다｡ 알고 있지만…… 왜 그녀가!?"
  },
  {
   "id": 39755,
   "key": "D1412al.txt:217",
   "file": "D1412al.txt",
   "line": 217,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「どういうことだッ！ いったい、これはどういうことなんだよエンネア！」",
   "ko_candidate": "「도대체､ 이게 어떻게 된 거야! 대체､ 이게 무슨 일이야 엔네아!」"
  },
  {
   "id": 39756,
   "key": "D1412al.txt:223",
   "file": "D1412al.txt",
   "line": 223,
   "speaker": "ネロ",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「だからエンネアじゃないんだよ。それとどういうことって言われてもネロはネロだからネロだとしか答えようがないよ」",
   "ko_candidate": "「그러니까 엔네아가 아니라니까｡ 그리고 무슨 일이냐고 해도 네로는 네로니까 네로라고밖에 대답할 수 없어」"
  },
  {
   "id": 39757,
   "key": "D1412al.txt:228",
   "file": "D1412al.txt",
   "line": 228,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「そうか、妾が汝から感じた不吉の気配はそういう事であったか。 アンチクロス……それも最強の罪人、『暴君』ネロよ」",
   "ko_candidate": "「그렇군､ 내가 너에게서 느낀 불길한 기운은 그런 거였구나｡ 안티 크로스…… 그것도 최강의 죄인､ 『폭군』 네로로군」"
  },
  {
   "id": 39758,
   "key": "D1412al.txt:233",
   "file": "D1412al.txt",
   "line": 233,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "エンネアが薄く笑う。",
   "ko_candidate": "엔네아가 옅게 웃는다｡"
  },
  {
   "id": 39759,
   "key": "D1412al.txt:234",
   "file": "D1412al.txt",
   "line": 234,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その笑顔は……俺に見せた、 あの明るい無邪気な笑顔ではなかった。",
   "ko_candidate": "그 미소는…… 나에게 보여준､ 그 밝고 천진난만한 미소가 아니었다｡"
  },
  {
   "id": 39760,
   "key": "D1412al.txt:237",
   "file": "D1412al.txt",
   "line": 237,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "吐き気を催す、異形じみた、 邪悪の根源たる魔性の微笑。",
   "ko_candidate": "구역질을 일으키는､ 기괴한､ 악의 근원인 마성의 미소｡"
  },
  {
   "id": 39761,
   "key": "D1412al.txt:239",
   "file": "D1412al.txt",
   "line": 239,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "あのマスターテリオンと同類のそれだった。",
   "ko_candidate": "그 마스터 테리온과 같은 부류의 그것이었다｡"
  },
  {
   "id": 39762,
   "key": "D1412al.txt:241",
   "file": "D1412al.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "本当だ……エンネアではない。",
   "ko_candidate": "정말이다…… 엔네아가 아니다｡"
  },
  {
   "id": 39763,
   "key": "D1412al.txt:242",
   "file": "D1412al.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "彼女は、ネロ、なんだ。",
   "ko_candidate": "그녀는､ 네로､ 였다｡"
  },
  {
   "id": 39764,
   "key": "D1412al.txt:243",
   "file": "D1412al.txt",
   "line": 243,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭が眩み、目の前が真っ暗になる。",
   "ko_candidate": "머리가 어지럽고､ 눈앞이 캄캄해진다｡"
  },
  {
   "id": 39765,
   "key": "D1412al.txt:245",
   "file": "D1412al.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ネロが、デモンベインの手の中、 クトゥグアを見て、満足げに頷く。",
   "ko_candidate": "네로가 데몬베인의 손 안에 있는 크투가를 보고 만족스럽게 끄덕인다｡"
  },
  {
   "id": 39766,
   "key": "D1412al.txt:247",
   "file": "D1412al.txt",
   "line": 247,
   "speaker": "ネロ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "異形の笑顔もそのままに、語りかけてきた。 「どうやらネロの渡した魔銃、２挺とも使いこなしているみたいだね」",
   "ko_candidate": "기괴한 미소를 그대로 지으며 말을 걸어왔다｡"
  },
  {
   "id": 39767,
   "key": "D1412al.txt:257",
   "file": "D1412al.txt",
   "line": 257,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どう？　なかなかに優れものでしょ？　ホントはネロのとっておきだけど、九郎にあげたんだ」 「九郎、大変そうだったし……何よりそれくらいのものを渡しておかないと闘いが愉しめない」",
   "ko_candidate": "「아무래도 네로가 건넨 마총､ 두 자루 모두 잘 다루고 있는 것 같네｡ 어때? 꽤나 뛰어난 물건이지? 사실은 네로의 비장의 무기였지만､ 쿠로에게 줬어｡ 쿠로､ 힘들어 보였고…… 무엇보다 그 정도는 건네줘야 싸움이 재밌잖아」"
  },
  {
   "id": 39768,
   "key": "D1412al.txt:263",
   "file": "D1412al.txt",
   "line": 263,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闘いが愉しめない……どういうことだ？",
   "ko_candidate": "싸움이 재밌잖아…… 무슨 소리지?"
  },
  {
   "id": 39769,
   "key": "D1412al.txt:264",
   "file": "D1412al.txt",
   "line": 264,
   "speaker": "ネロ",
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "怪訝としている俺の気配に気づいたのか、ネロは満面の笑みを作って、言葉を続ける。 「そうだよ。今ここで九郎とネロは滅ぼし愛うんだよ」",
   "ko_candidate": "의아해하는 내 기색을 눈치챘는지､ 네로는 만면에 미소를 지으며 말을 이었다｡"
  },
  {
   "id": 39770,
   "key": "D1412al.txt:271",
   "file": "D1412al.txt",
   "line": 271,
   "speaker": "ネロ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「九郎はアーカムシティを護る 『せーぎの味方』として。ネロは 世界滅亡を目論む悪のまほー使い として」 「自分の総てを賭して、相手の総てを全力で否定し愛うの。素敵でしょ？」",
   "ko_candidate": "「그래｡ 지금 여기서 쿠로와 네로는 멸망의 사랑을 나누는 거야｡ 쿠로는 아캄시티를 지키는 『정의의 편』으로서｡ 네로는 세계 멸망을 꾀하는 악의 마법사로서｡ 자신의 모든 것을 걸고､ 상대의 모든 것을 전력으로 부정하며 사랑하는 거야｡ 멋지지 않아?」"
  },
  {
   "id": 39771,
   "key": "D1412al.txt:286",
   "file": "D1412al.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "頭痛に苛まれる。",
   "ko_candidate": "두통에 시달린다｡"
  },
  {
   "id": 39772,
   "key": "D1412al.txt:286",
   "file": "D1412al.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "咽喉が渇く。",
   "ko_candidate": "목이 마른다｡"
  },
  {
   "id": 39773,
   "key": "D1412al.txt:286",
   "file": "D1412al.txt",
   "line": 286,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "うなじが焼ける。",
   "ko_candidate": "목덜미가 타오른다｡"
  },
  {
   "id": 39774,
   "key": "D1412al.txt:287",
   "file": "D1412al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鳥肌が総毛立つ。",
   "ko_candidate": "소름이 돋는다｡"
  },
  {
   "id": 39775,
   "key": "D1412al.txt:287",
   "file": "D1412al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "背筋が凍る。",
   "ko_candidate": "등골이 오싹해진다｡"
  },
  {
   "id": 39776,
   "key": "D1412al.txt:287",
   "file": "D1412al.txt",
   "line": 287,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胸がむかつく。",
   "ko_candidate": "가슴이 메스껍다｡"
  },
  {
   "id": 39777,
   "key": "D1412al.txt:288",
   "file": "D1412al.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "胃が軋む。",
   "ko_candidate": "위가 뒤틀린다｡"
  },
  {
   "id": 39778,
   "key": "D1412al.txt:288",
   "file": "D1412al.txt",
   "line": 288,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "足下がぐらつく。",
   "ko_candidate": "발밑이 흔들린다｡"
  }
 ]
}