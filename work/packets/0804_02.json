{
 "packet": "0804_02",
 "scene": "0804",
 "anchor": {
  "hit": 24,
  "total": 27,
  "rate": 0.889
 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {},
 "items": [
  {
   "id": 12837,
   "key": "D0804al.txt:557",
   "file": "D0804al.txt",
   "line": 557,
   "speaker": "店員３",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「お客様。ご会計の方、 宜しいでしょうか？」",
   "ko_candidate": "「손님｡ 계산은 괜찮으시겠습니까?」"
  },
  {
   "id": 12838,
   "key": "D0804al.txt:563",
   "file": "D0804al.txt",
   "line": 563,
   "speaker": "九郎",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「いや、だから気絶しているんだって」",
   "ko_candidate": "「아니､ 그러니까 기절했다고」"
  },
  {
   "id": 12839,
   "key": "D0804le.txt:9",
   "file": "D0804le.txt",
   "line": 9,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "シティ４９番区郊外不法住宅地。",
   "ko_candidate": "시티 49번구 교외 불법주택지｡"
  },
  {
   "id": 12840,
   "key": "D0804le.txt:10",
   "file": "D0804le.txt",
   "line": 10,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "すえたアンモニア臭漂う空気を裂いて、昏い路地を駈ける。",
   "ko_candidate": "묵은 암모니아 냄새 떠도는 공기를 가르며､ 어두운 골목을 달린다｡"
  },
  {
   "id": 12841,
   "key": "D0804le.txt:12",
   "file": "D0804le.txt",
   "line": 12,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "駈けて、跳ぶ。",
   "ko_candidate": "달리고､ 뛴다｡"
  },
  {
   "id": 12842,
   "key": "D0804le.txt:13",
   "file": "D0804le.txt",
   "line": 13,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "迫る建物の壁面を蹴る。",
   "ko_candidate": "다가오는 건물의 벽면을 찬다｡"
  },
  {
   "id": 12843,
   "key": "D0804le.txt:14",
   "file": "D0804le.txt",
   "line": 14,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "蹴って、翔ぶ。",
   "ko_candidate": "차고､ 날아오른다｡"
  },
  {
   "id": 12844,
   "key": "D0804le.txt:15",
   "file": "D0804le.txt",
   "line": 15,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "昏い空に、影が舞う。",
   "ko_candidate": "어두운 하늘에､ 그림자가 춤춘다｡"
  },
  {
   "id": 12845,
   "key": "D0804le.txt:17",
   "file": "D0804le.txt",
   "line": 17,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "小柄で華奢な人影。",
   "ko_candidate": "작고 가녀린 인영｡"
  },
  {
   "id": 12846,
   "key": "D0804le.txt:18",
   "file": "D0804le.txt",
   "line": 18,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "両足に嵌る枷。鎖。",
   "ko_candidate": "양 발에 끼워진 족쇄｡ 사슬｡"
  },
  {
   "id": 12847,
   "key": "D0804le.txt:20",
   "file": "D0804le.txt",
   "line": 20,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "袖の無い、黒いレザースーツ。",
   "ko_candidate": "소매 없는､ 검은 가죽 슈트｡"
  },
  {
   "id": 12848,
   "key": "D0804le.txt:21",
   "file": "D0804le.txt",
   "line": 21,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "腕は組んだ状態で、スーツの中に固定。",
   "ko_candidate": "팔은 교차한 상태로､ 슈트 안에 고정｡"
  },
  {
   "id": 12849,
   "key": "D0804le.txt:23",
   "file": "D0804le.txt",
   "line": 23,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "眸と口元だけを覗かせる仮面。口に嵌められた轡。",
   "ko_candidate": "눈동자와 입술만 드러내는 가면｡ 입에 물린 재갈｡"
  },
  {
   "id": 12850,
   "key": "D0804le.txt:25",
   "file": "D0804le.txt",
   "line": 25,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして幾重にも貼られた呪符。呪符。呪符。",
   "ko_candidate": "그리고 겹겹이 붙여진 부적｡ 부적｡ 부적｡"
  },
  {
   "id": 12851,
   "key": "D0804le.txt:26",
   "file": "D0804le.txt",
   "line": 26,
   "speaker": null,
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "『呪縛』を意味する魔術文字。",
   "ko_candidate": "『주박』을 의미하는 마술 문자｡"
  },
  {
   "id": 12852,
   "key": "D0804le.txt:30",
   "file": "D0804le.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "即ち、拘束されている。",
   "ko_candidate": "즉､ 구속되어 있다｡"
  },
  {
   "id": 12853,
   "key": "D0804le.txt:31",
   "file": "D0804le.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "イメージされるものは、囚人。",
   "ko_candidate": "연상되는 것은､ 죄수｡"
  },
  {
   "id": 12854,
   "key": "D0804le.txt:33",
   "file": "D0804le.txt",
   "line": 33,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "だがこれは拘束の堅固さ、苛烈さよりむしろ――封じられた者の強大さを予感させはしないだろうか。",
   "ko_candidate": "하지만 이는 구속의 견고함､ 가혹함보다는 오히려―― 봉인된 자의 강대함을 예감케 하지 않을까｡"
  },
  {
   "id": 12855,
   "key": "D0804le.txt:35",
   "file": "D0804le.txt",
   "line": 35,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "厳重過ぎる拘束は、囚人に対する畏れの顕れ。",
   "ko_candidate": "지나치게 엄중한 구속은､ 죄수에 대한 두려움의 표현｡"
  },
  {
   "id": 12856,
   "key": "D0804le.txt:36",
   "file": "D0804le.txt",
   "line": 36,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "現に拘束の幾つかは突破され、囚人の自由を許してしまっている。",
   "ko_candidate": "실제로 구속의 일부는 뚫려､ 죄수의 자유를 허용해 버렸다｡"
  },
  {
   "id": 12857,
   "key": "D0804le.txt:40",
   "file": "D0804le.txt",
   "line": 40,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "突風が吹き荒れる。",
   "ko_candidate": "돌풍이 휘몰아친다｡"
  },
  {
   "id": 12858,
   "key": "D0804le.txt:41",
   "file": "D0804le.txt",
   "line": 41,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人ひとりを軽々と舞い上げる程の風。",
   "ko_candidate": "사람 하나를 가볍게 날려 보낼 정도의 바람｡"
  },
  {
   "id": 12859,
   "key": "D0804le.txt:42",
   "file": "D0804le.txt",
   "line": 42,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "吹き飛ばされたその先で、合わせたように爆発。",
   "ko_candidate": "날려간 그 앞에서､ 맞춘 듯이 폭발｡"
  },
  {
   "id": 12860,
   "key": "D0804le.txt:43",
   "file": "D0804le.txt",
   "line": 43,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "近くの家屋を抉り、囚人を撃つ。",
   "ko_candidate": "근처의 가옥을 파내고､ 죄수를 친다｡"
  },
  {
   "id": 12861,
   "key": "D0804le.txt:45",
   "file": "D0804le.txt",
   "line": 45,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爆発の中心で、囚人は翔ぶ。",
   "ko_candidate": "폭발의 중심에서､ 죄수는 날아오른다｡"
  },
  {
   "id": 12862,
   "key": "D0804le.txt:46",
   "file": "D0804le.txt",
   "line": 46,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "木の葉の如く舞い散る瓦礫を足場に、囚人は跳ぶ。",
   "ko_candidate": "나뭇잎처럼 흩날리는 잔해를 발판 삼아､ 죄수는 뛴다｡"
  },
  {
   "id": 12863,
   "key": "D0804le.txt:47",
   "file": "D0804le.txt",
   "line": 47,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "囚人は別の建物の屋上へと着地した。",
   "ko_candidate": "죄수는 다른 건물의 옥상으로 착지했다｡"
  },
  {
   "id": 12864,
   "key": "D0804le.txt:49",
   "file": "D0804le.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "追って跳躍する２つの影。",
   "ko_candidate": "뒤따라 뛰어오르는 두 개의 그림자｡"
  },
  {
   "id": 12865,
   "key": "D0804le.txt:51",
   "file": "D0804le.txt",
   "line": 51,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "右より迫る。",
   "ko_candidate": "오른쪽에서 다가온다｡"
  },
  {
   "id": 12866,
   "key": "D0804le.txt:52",
   "file": "D0804le.txt",
   "line": 52,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "地響きを引き連れる巨躯。",
   "ko_candidate": "땅울림을 동반하는 거구｡"
  },
  {
   "id": 12867,
   "key": "D0804le.txt:54",
   "file": "D0804le.txt",
   "line": 54,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "左より迫る。",
   "ko_candidate": "왼쪽에서 다가온다｡"
  },
  {
   "id": 12868,
   "key": "D0804le.txt:55",
   "file": "D0804le.txt",
   "line": 55,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "風の音を纏う矮躯。",
   "ko_candidate": "바람 소리를 두른 왜구｡"
  },
  {
   "id": 12869,
   "key": "D0804le.txt:57",
   "file": "D0804le.txt",
   "line": 57,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "轡を嵌められた口元が歪む。",
   "ko_candidate": "재갈 물린 입술이 일그러진다｡"
  },
  {
   "id": 12870,
   "key": "D0804le.txt:58",
   "file": "D0804le.txt",
   "line": 58,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "それはまるで……嗤っているかのようだった。",
   "ko_candidate": "그것은 마치… 웃고 있는 것 같았다｡"
  },
  {
   "id": 12871,
   "key": "D0804le.txt:63",
   "file": "D0804le.txt",
   "line": 63,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "引き千切れるレザースーツ。",
   "ko_candidate": "찢어지는 가죽 슈트｡"
  },
  {
   "id": 12872,
   "key": "D0804le.txt:64",
   "file": "D0804le.txt",
   "line": 64,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "燃え上がる呪符。",
   "ko_candidate": "불타오르는 부적｡"
  },
  {
   "id": 12873,
   "key": "D0804le.txt:65",
   "file": "D0804le.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "細い、２本の腕が、拘束具を裂いて現れた。",
   "ko_candidate": "가느다란､ 두 팔이､ 구속구를 찢고 나타났다｡"
  },
  {
   "id": 12874,
   "key": "D0804le.txt:66",
   "file": "D0804le.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そして。",
   "ko_candidate": "그리고｡"
  },
  {
   "id": 12875,
   "key": "D0804le.txt:70",
   "file": "D0804le.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "伸ばした右手。その先に握られている鉄塊。",
   "ko_candidate": "뻗은 오른손｡ 그 끝에 쥐어진 철괴｡"
  },
  {
   "id": 12876,
   "key": "D0804le.txt:71",
   "file": "D0804le.txt",
   "line": 71,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "重厚なる黒。苛烈なる赤。装飾を施されながらも無骨。何より凶暴。",
   "ko_candidate": "중후한 검정｡ 가혹한 붉은색｡ 장식이 되어 있으면서도 투박｡ 무엇보다 흉폭｡"
  }
 ]
}