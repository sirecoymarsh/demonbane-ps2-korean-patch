 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "九郎": "쿠로",
  "アル": "알"
 },
 "items": [
  {
   "id": 48655,
   "key": "D1519al_b.txt:116",
   "file": "D1519al_b.txt",
   "line": 116,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "試験管の中の宇宙。",
   "ko_candidate": "시험관 안의 우주｡"
  },
  {
   "id": 48656,
   "key": "D1519al_b.txt:117",
   "file": "D1519al_b.txt",
   "line": 117,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ガムの包装紙にくるまれた宇宙。",
   "ko_candidate": "껌 포장지에 싸인 우주｡"
  },
  {
   "id": 48657,
   "key": "D1519al_b.txt:125",
   "file": "D1519al_b.txt",
   "line": 125,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宇宙の外に宇宙が広がっていると云うお話。",
   "ko_candidate": "우주 밖에 우주가 펼쳐져 있다는 이야기｡"
  },
  {
   "id": 48658,
   "key": "D1519al_b.txt:126",
   "file": "D1519al_b.txt",
   "line": 126,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "宇宙の内に宇宙が広がっていると云うお話。",
   "ko_candidate": "우주 안에 우주가 펼쳐져 있다는 이야기｡"
  },
  {
   "id": 48659,
   "key": "D1519al_b.txt:129",
   "file": "D1519al_b.txt",
   "line": 129,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "永劫を呑み込んだ刹那のお話。",
   "ko_candidate": "영겁을 삼켜버린 찰나의 이야기｡"
  },
  {
   "id": 48660,
   "key": "D1519al_b.txt:130",
   "file": "D1519al_b.txt",
   "line": 130,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "無限大を閉じ込めた極細塵のお話。",
   "ko_candidate": "무한대를 가두어 버린 극미진의 이야기｡"
  },
  {
   "id": 48661,
   "key": "D1519al_b.txt:138",
   "file": "D1519al_b.txt",
   "line": 138,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "宇宙の外に広がる宇宙の、宇宙の外に広がる宇宙の外",
   "ko_candidate": "우주 밖에 펼쳐진 우주의､ 우주 밖에 펼쳐진 우주 밖에 펼쳐진 우주의､"
  },
  {
   "id": 48662,
   "key": "D1519al_b.txt:139",
   "file": "D1519al_b.txt",
   "line": 139,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "に広がる宇宙の、宇宙の外に広がる宇宙の外に広がる宇",
   "ko_candidate": "우주 밖에 펼쳐진 우주 밖에 펼쳐진 우주 밖에 펼쳐진 우주의､"
  },
  {
   "id": 48663,
   "key": "D1519al_b.txt:140",
   "file": "D1519al_b.txt",
   "line": 140,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "宙の外に広がる宇宙の……無限に連なる宇宙のお話。 総ては無限でありながら零であると云うお話だ。",
   "ko_candidate": "우주 밖에 펼쳐진 우주 밖에 펼쳐진 우주 밖에 펼쳐진 우주 밖에 펼쳐진 우주의… 무한히 이어지는 우주의 이야기｡"
  },
  {
   "id": 48664,
   "key": "D1519al_b.txt:148",
   "file": "D1519al_b.txt",
   "line": 148,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "無限と零が溶け合って、輪廻の蛇が腐り堕ちて、煮え滾る混沌のスープを造るのだ。",
   "ko_candidate": "모든 것은 무한하면서도 제로라는 이야기다｡ 무한과 제로가 녹아들어 윤회의 뱀이 썩어 무너지고 끓어오르는 혼돈의 수프를 만드는 것이다｡"
  },
  {
   "id": 48665,
   "key": "D1519al_b.txt:156",
   "file": "D1519al_b.txt",
   "line": 156,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総ては泡沫。",
   "ko_candidate": "모든 것은 물거품｡"
  },
  {
   "id": 48666,
   "key": "D1519al_b.txt:157",
   "file": "D1519al_b.txt",
   "line": 157,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "万物の王様が見る、盲目にして零知の神様が見る、 泡沫の夢。",
   "ko_candidate": "만물의 왕이､ 맹목이며 무지의 신이 보는 물거품의 꿈｡"
  },
  {
   "id": 48667,
   "key": "D1519al_b.txt:158",
   "file": "D1519al_b.txt",
   "line": 158,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "微睡みに浮かぶ、一瞬の夢だ。",
   "ko_candidate": "선잠에 떠오르는 한순간의 꿈이다｡"
  },
  {
   "id": 48668,
   "key": "D1519al_b.txt:161",
   "file": "D1519al_b.txt",
   "line": 161,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "覚醒れば、終わる。",
   "ko_candidate": "깨어나면 끝난다｡"
  },
  {
   "id": 48669,
   "key": "D1519al_b.txt:162",
   "file": "D1519al_b.txt",
   "line": 162,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "終わりとも知れず、ただ消える。",
   "ko_candidate": "끝이라고도 모르고 그저 사라진다｡"
  },
  {
   "id": 48670,
   "key": "D1519al_b.txt:163",
   "file": "D1519al_b.txt",
   "line": 163,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "むしろ、最初から存在しないだけの事か。",
   "ko_candidate": "오히려 처음부터 존재하지 않았을 뿐인 것인가｡"
  },
  {
   "id": 48671,
   "key": "D1519al_b.txt:170",
   "file": "D1519al_b.txt",
   "line": 170,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ならば世界は、何処までも、ただただ、虚ろなだけなのだろうか。",
   "ko_candidate": "그렇다면 세계는 어디까지나 그저 공허할 뿐인 것일까｡"
  },
  {
   "id": 48672,
   "key": "D1519al_b.txt:178",
   "file": "D1519al_b.txt",
   "line": 178,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "これは喩え噺なのだが――",
   "ko_candidate": "이건 비유 이야기인데――"
  },
  {
   "id": 48673,
   "key": "D1519al_b.txt:179",
   "file": "D1519al_b.txt",
   "line": 179,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうは想わない存在は居たらしい。",
   "ko_candidate": "그렇게 생각하지 않는 존재가 있었던 모양이다｡"
  },
  {
   "id": 48674,
   "key": "D1519al_b.txt:192",
   "file": "D1519al_b.txt",
   "line": 192,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光。",
   "ko_candidate": "빛｡"
  },
  {
   "id": 48675,
   "key": "D1519al_b.txt:194",
   "file": "D1519al_b.txt",
   "line": 194,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "眠りの闇も、瞼の裏の闇も貫いて圧倒的な光の気配を感じた。俺の心を打った。",
   "ko_candidate": "잠의 어둠도､ 눈꺼풀 안쪽의 어둠도 꿰뚫고､ 압도적인 빛의 기척을 느꼈다｡ 내 마음을 울렸다｡"
  },
  {
   "id": 48676,
   "key": "D1519al_b.txt:196",
   "file": "D1519al_b.txt",
   "line": 196,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "目を覚まし、瞳を開ける。",
   "ko_candidate": "눈을 뜨고､ 눈동자를 연다｡"
  },
  {
   "id": 48677,
   "key": "D1519al_b.txt:198",
   "file": "D1519al_b.txt",
   "line": 198,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "闇。",
   "ko_candidate": "어둠｡"
  },
  {
   "id": 48678,
   "key": "D1519al_b.txt:199",
   "file": "D1519al_b.txt",
   "line": 199,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何処までも眩い、白い闇。",
   "ko_candidate": "어디까지나 눈부신､ 하얀 어둠｡"
  },
  {
   "id": 48679,
   "key": "D1519al_b.txt:200",
   "file": "D1519al_b.txt",
   "line": 200,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "烈しい闇。",
   "ko_candidate": "격렬한 어둠｡"
  },
  {
   "id": 48680,
   "key": "D1519al_b.txt:201",
   "file": "D1519al_b.txt",
   "line": 201,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "自分すらも見失ってしまうほどの。",
   "ko_candidate": "자신조차 잃어버릴 것만 같은｡"
  },
  {
   "id": 48681,
   "key": "D1519al_b.txt:211",
   "file": "D1519al_b.txt",
   "line": 211,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「――九郎」",
   "ko_candidate": "「――쿠로」"
  },
  {
   "id": 48682,
   "key": "D1519al_b.txt:215",
   "file": "D1519al_b.txt",
   "line": 215,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの声が聴こえた。",
   "ko_candidate": "알의 목소리가 들렸다｡"
  },
  {
   "id": 48683,
   "key": "D1519al_b.txt:216",
   "file": "D1519al_b.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "強く抱き締める。",
   "ko_candidate": "강하게 끌어안는다｡"
  },
  {
   "id": 48684,
   "key": "D1519al_b.txt:217",
   "file": "D1519al_b.txt",
   "line": 217,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "確かに、俺の腕の中に在る。",
   "ko_candidate": "분명히､ 내 팔 안에 있다｡"
  },
  {
   "id": 48685,
   "key": "D1519al_b.txt:220",
   "file": "D1519al_b.txt",
   "line": 220,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "総てが消え逝きそうな光の中でも総てが融け込みそうな闇の中でも、この温もりと柔らかさは確かなものだ。",
   "ko_candidate": "모든 것이 사라져 갈 것만 같은 빛 속에서도､ 모든 것이 녹아들 것만 같은 어둠 속에서도､ 이 온기와 부드러움은 확실한 것이다｡"
  },
  {
   "id": 48686,
   "key": "D1519al_b.txt:223",
   "file": "D1519al_b.txt",
   "line": 223,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "アルを世界の手懸かりとして、 光の正体を見極めようとする。",
   "ko_candidate": "알을 세계의 실마리로 삼아､ 빛의 정체를 가늠해 보려 한다｡"
  },
  {
   "id": 48687,
   "key": "D1519al_b.txt:230",
   "file": "D1519al_b.txt",
   "line": 230,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「アル……何が起こってるんだ？」",
   "ko_candidate": "「알……무슨 일이 일어나고 있는 거야?」"
  },
  {
   "id": 48688,
   "key": "D1519al_b.txt:235",
   "file": "D1519al_b.txt",
   "line": 235,
   "speaker": "アル",
   "kind": "say",
   "status": "OK",
   "work": false,
   "jp": "「妾にも解らぬ。 しかし、此れは――」",
   "ko_candidate": "「첩도 모르겠소｡ 하지만､ 이것은――」"
  },
  {
   "id": 48689,
   "key": "D1519al_b.txt:241",
   "file": "D1519al_b.txt",
   "line": 241,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アルの言いたいことは分かる。",
   "ko_candidate": "알이 하고 싶은 말을 알겠다｡"
  },
  {
   "id": 48690,
   "key": "D1519al_b.txt:242",
   "file": "D1519al_b.txt",
   "line": 242,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この光は圧倒的で、苛烈だったが――決して暴虐では無かった。",
   "ko_candidate": "이 빛은 압도적이고､ 격렬했지만――결코 포악하지는 않았다｡"
  },
  {
   "id": 48691,
   "key": "D1519al_b.txt:244",
   "file": "D1519al_b.txt",
   "line": 244,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光の烈しさは、力強い生命の力だった。",
   "ko_candidate": "빛의 격렬함은 강력한 생명의 힘이었다｡"
  },
  {
   "id": 48692,
   "key": "D1519al_b.txt:245",
   "file": "D1519al_b.txt",
   "line": 245,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "光には、熱くとも優しい生命の息吹が宿っているのだ。",
   "ko_candidate": "빛에는 뜨겁지만 부드러운 생명의 숨결이 깃들어 있는 것이다｡"
  },
  {
   "id": 48693,
   "key": "D1519al_b.txt:247",
   "file": "D1519al_b.txt",
   "line": 247,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "何だろう、この光は？",
   "ko_candidate": "뭘까､ 이 빛은?"
  },
  {
   "id": 48694,
   "key": "D1519al_b.txt:248",
   "file": "D1519al_b.txt",
   "line": 248,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "この時の狭間、世界の狭間に、永遠を漂う俺たちの許に、いったい何が迫っているんだ？",
   "ko_candidate": "이 시간의 틈새､ 세계의 틈새에､ 영원을 떠도는 우리에게､ 도대체 무엇이 다가오고 있는 거지?"
  }
 ]
}