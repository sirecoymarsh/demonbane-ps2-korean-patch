{
 "packet": "1107_03",
 "scene": "1107",
 "anchor": {
  "hit": 14,
  "total": 14,
  "rate": 1.0
 },
 "trusted": true,
 "note": "후보(팬패치)가 이 구간에서는 전혀 다른 장면 텍스트라 비웠다. 원문(jp)만 보고 새로 확정할 것.",
 "glossary": {
  "アル": "알",
  "ドクター・ウェスト": "닥터 웨스트",
  "アンチクロス": "안티크로스",
  "エルザ": "엘자",
  "覇道財閥": "하도 재벌",
  "デモンベイン": "데몬베인",
  "チアキ": "치아키",
  "覇道": "하도",
  "覇道瑠璃": "하도 루리",
  "瑠璃": "루리"
 },
 "items": [
  {
   "id": 24810,
   "key": "D1107ru.txt:214",
   "file": "D1107ru.txt",
   "line": 214,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "とぼける様な態度に、アルの目つきはより一層、険しくなった。",
   "ko_candidate": ""
  },
  {
   "id": 24811,
   "key": "D1107ru.txt:216",
   "file": "D1107ru.txt",
   "line": 216,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "油断の無い視線が、ドクター・ウェストを射抜く。",
   "ko_candidate": ""
  },
  {
   "id": 24812,
   "key": "D1107ru.txt:221",
   "file": "D1107ru.txt",
   "line": 221,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「韜晦するな。妾と汝は敵同士。何故、妾に手を貸す？」",
   "ko_candidate": ""
  },
  {
   "id": 24818,
   "key": "D1107ru.txt:228",
   "file": "D1107ru.txt",
   "line": 228,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ふむ……」",
   "ko_candidate": ""
  },
  {
   "id": 24824,
   "key": "D1107ru.txt:232",
   "file": "D1107ru.txt",
   "line": 232,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ドクター・ウェストはギターを止め、彼らしからぬ真剣な表情で、アルを見つめ返した。",
   "ko_candidate": ""
  },
  {
   "id": 24829,
   "key": "D1107ru.txt:238",
   "file": "D1107ru.txt",
   "line": 238,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「我輩がアンチクロスに刃向かって、追われる羽目になったのは、エルザから聞いておるな？」",
   "ko_candidate": ""
  },
  {
   "id": 24830,
   "key": "D1107ru.txt:243",
   "file": "D1107ru.txt",
   "line": 243,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「うむ」",
   "ko_candidate": ""
  },
  {
   "id": 24831,
   "key": "D1107ru.txt:248",
   "file": "D1107ru.txt",
   "line": 248,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「つまりであるな。我輩にとっても、アンチクロスの連中は憎むべき怨敵」",
   "ko_candidate": ""
  },
  {
   "id": 24832,
   "key": "D1107ru.txt:251",
   "file": "D1107ru.txt",
   "line": 251,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「そこで貴様達と共同戦線を張ろうと、そういうワケである」",
   "ko_candidate": ""
  },
  {
   "id": 24835,
   "key": "D1107ru.txt:255",
   "file": "D1107ru.txt",
   "line": 255,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「今のところ、我々の目的は同じなのであるからな」",
   "ko_candidate": ""
  },
  {
   "id": 24837,
   "key": "D1107ru.txt:260",
   "file": "D1107ru.txt",
   "line": 260,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「汝が連中のスパイでは無いという保障は？」",
   "ko_candidate": ""
  },
  {
   "id": 24844,
   "key": "D1107ru.txt:270",
   "file": "D1107ru.txt",
   "line": 270,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「くらっしゅ！　ざうぉーる！　ないといずぶりーでぃんぐ！ ゆーれふと！　ゆあすめる！　いんでっとえんどすとりーぃぃぃと！」",
   "ko_candidate": ""
  },
  {
   "id": 24845,
   "key": "D1107ru.txt:278",
   "file": "D1107ru.txt",
   "line": 278,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「済まぬ。疑った妾が愚かだった」",
   "ko_candidate": ""
  },
  {
   "id": 24846,
   "key": "D1107ru.txt:282",
   "file": "D1107ru.txt",
   "line": 282,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "何より、雄弁で説得力ある返答だった。",
   "ko_candidate": ""
  },
  {
   "id": 24847,
   "key": "D1107ru.txt:288",
   "file": "D1107ru.txt",
   "line": 288,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ふん……それにだ。我輩の頭脳と技術は貴様にとって決して損になるものではないと思うが？」",
   "ko_candidate": ""
  },
  {
   "id": 24849,
   "key": "D1107ru.txt:291",
   "file": "D1107ru.txt",
   "line": 291,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「見よ！　覇道財閥の凡人どもに、これほどまで機能美を発揮する事が出来るであるか！　否！　否、否、否、否！　否であるっ！」",
   "ko_candidate": ""
  },
  {
   "id": 24850,
   "key": "D1107ru.txt:294",
   "file": "D1107ru.txt",
   "line": 294,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「これぞ……これこそが天才の業！ 嗚呼…… 我輩の才能が怖ろしい……」",
   "ko_candidate": ""
  },
  {
   "id": 24852,
   "key": "D1107ru.txt:300",
   "file": "D1107ru.txt",
   "line": 300,
   "speaker": "チアキ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「んん～～～～～～～～～ッッ！」",
   "ko_candidate": ""
  },
  {
   "id": 24856,
   "key": "D1107ru.txt:303",
   "file": "D1107ru.txt",
   "line": 303,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "修復されたデモンベインを指して、うっとりとするドクター・ウェスト。",
   "ko_candidate": ""
  },
  {
   "id": 24857,
   "key": "D1107ru.txt:305",
   "file": "D1107ru.txt",
   "line": 305,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "チアキが何やら、怒りの呻き声を上げているが、誰も気にしていない。",
   "ko_candidate": ""
  },
  {
   "id": 24859,
   "key": "D1107ru.txt:307",
   "file": "D1107ru.txt",
   "line": 307,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "確かに――この男、人格面では致命的な欠陥があるが、実力ではその欠点を埋めて余りある。",
   "ko_candidate": ""
  },
  {
   "id": 24860,
   "key": "D1107ru.txt:309",
   "file": "D1107ru.txt",
   "line": 309,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "味方に付けられると言うのなら、それに越した事は無い。",
   "ko_candidate": ""
  },
  {
   "id": 24864,
   "key": "D1107ru.txt:314",
   "file": "D1107ru.txt",
   "line": 314,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「汝の言う事、一理ある。 覇道の連中に口添えくらいはしてやろうじゃないか」",
   "ko_candidate": ""
  },
  {
   "id": 24865,
   "key": "D1107ru.txt:321",
   "file": "D1107ru.txt",
   "line": 321,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "答えつつ、アルはドクター・ウェストの横を通り抜ける。",
   "ko_candidate": ""
  },
  {
   "id": 24867,
   "key": "D1107ru.txt:326",
   "file": "D1107ru.txt",
   "line": 326,
   "speaker": "ウェスト",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ぬおっ？　おいおいである。貴様、何処に行くであるか？」",
   "ko_candidate": ""
  },
  {
   "id": 24870,
   "key": "D1107ru.txt:331",
   "file": "D1107ru.txt",
   "line": 331,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「デモンベインはもう少しで直るだろう？　ならば決まっている。 あの忌々しい邪神ごと彼奴等を……」",
   "ko_candidate": ""
  },
  {
   "id": 24876,
   "key": "D1107ru.txt:337",
   "file": "D1107ru.txt",
   "line": 337,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「なっ…… 何なのですか、これはっ!?」",
   "ko_candidate": ""
  },
  {
   "id": 24878,
   "key": "D1107ru.txt:341",
   "file": "D1107ru.txt",
   "line": 341,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "突然、格納庫に響き渡る悲鳴に、アルの言葉は掻き消された。",
   "ko_candidate": ""
  },
  {
   "id": 24881,
   "key": "D1107ru.txt:343",
   "file": "D1107ru.txt",
   "line": 343,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "全員が一斉に振り返る。",
   "ko_candidate": ""
  },
  {
   "id": 24882,
   "key": "D1107ru.txt:345",
   "file": "D1107ru.txt",
   "line": 345,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "アルは「こんな時に厄介な」と言いたげに顔を顰め、ドクター・ウェストは逆に「ちょうど良いところに」といった感じ、縛られたチアキは地獄で仏に逢った様な表情を浮かべ、エルザは何も考えてないっぽい。",
   "ko_candidate": ""
  },
  {
   "id": 24883,
   "key": "D1107ru.txt:347",
   "file": "D1107ru.txt",
   "line": 347,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そして振り返った全員が――その視線の先にあるものを見て、硬直した。",
   "ko_candidate": ""
  },
  {
   "id": 24884,
   "key": "D1107ru.txt:349",
   "file": "D1107ru.txt",
   "line": 349,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "だが問題の人物はそんな事には気付かず、ドクター・ウェストの姿を認めるや否や、詰め寄ってくる。",
   "ko_candidate": ""
  },
  {
   "id": 24886,
   "key": "D1107ru.txt:354",
   "file": "D1107ru.txt",
   "line": 354,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ドクター・ウェスト!?　貴方、こんな所でいったい何を!?」",
   "ko_candidate": ""
  },
  {
   "id": 24887,
   "key": "D1107ru.txt:357",
   "file": "D1107ru.txt",
   "line": 357,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……チアキ！　貴方も何を遊んでいるのです!?」",
   "ko_candidate": ""
  },
  {
   "id": 24888,
   "key": "D1107ru.txt:362",
   "file": "D1107ru.txt",
   "line": 362,
   "speaker": "チアキ",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「ん――ッ!? ん――――んんっ！ ん――――――っっ！」",
   "ko_candidate": ""
  },
  {
   "id": 24891,
   "key": "D1107ru.txt:367",
   "file": "D1107ru.txt",
   "line": 367,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "抗議の呻き声。やはり誰も気にしない。",
   "ko_candidate": ""
  },
  {
   "id": 24892,
   "key": "D1107ru.txt:368",
   "file": "D1107ru.txt",
   "line": 368,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "そんな事よりも全員が全員、たった今入って来た人物――覇道瑠璃の格好に釘付けになっていて、声も出せなかった。",
   "ko_candidate": ""
  },
  {
   "id": 24895,
   "key": "D1107ru.txt:370",
   "file": "D1107ru.txt",
   "line": 370,
   "speaker": null,
   "kind": "narr",
   "status": "MISSING",
   "work": true,
   "jp": "ようやく奇異に視線に気付いたか、怯んだように瑠璃は訊ねる。",
   "ko_candidate": ""
  },
  {
   "id": 24897,
   "key": "D1107ru.txt:374",
   "file": "D1107ru.txt",
   "line": 374,
   "speaker": "瑠璃",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「な、何ですか……？　みんな揃って、人のことをジロジロと……」",
   "ko_candidate": ""
  },
  {
   "id": 24898,
   "key": "D1107ru.txt:379",
   "file": "D1107ru.txt",
   "line": 379,
   "speaker": "アル",
   "kind": "say",
   "status": "MISSING",
   "work": true,
   "jp": "「……そう言う汝こそ。何だ、その格好は？」",
   "ko_candidate": ""
  }
 ]
}