 "trusted": false,
 "note": "앵커 일치율이 낮거나 판정 불가인 씬 = 콘솔 개작 의심. **status=OK 도 믿지 말고 전부 원문 기준으로 확정할 것.**",
 "glossary": {
  "ライカ": "라이카",
  "ジョージ": "조지"
 },
 "items": [
  {
   "id": 49669,
   "key": "ep_leica01.txt:14",
   "file": "ep_leica01.txt",
   "line": 14,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ライカ姉ちゃーん！ おきろー！」",
   "ko_candidate": "「라이카 누나~! 일어나~!」"
  },
  {
   "id": 49670,
   "key": "ep_leica01.txt:19",
   "file": "ep_leica01.txt",
   "line": 19,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「…………………………ふえ？」",
   "ko_candidate": "「………………………………후에?」"
  },
  {
   "id": 49671,
   "key": "ep_leica01.txt:27",
   "file": "ep_leica01.txt",
   "line": 27,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ドンドンと乱暴にドアを叩く音。",
   "ko_candidate": "쾅쾅 하고 문을 거칠게 두드리는 소리｡"
  },
  {
   "id": 49672,
   "key": "ep_leica01.txt:28",
   "file": "ep_leica01.txt",
   "line": 28,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ついでに聴き慣れた目覚まし時計の音。",
   "ko_candidate": "거기에 익숙한 알람 소리까지｡"
  },
  {
   "id": 49673,
   "key": "ep_leica01.txt:30",
   "file": "ep_leica01.txt",
   "line": 30,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さすがにこれで、寝ていられるほどには、図太い神経をしてない。",
   "ko_candidate": "아무리 그래도 이 정도면､ 잠들어 있을 만큼 뻔뻔한 신경은 아니다｡"
  },
  {
   "id": 49674,
   "key": "ep_leica01.txt:31",
   "file": "ep_leica01.txt",
   "line": 31,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "薄っすらと目蓋を開けて……",
   "ko_candidate": "살짝 눈꺼풀을 열고……"
  },
  {
   "id": 49675,
   "key": "ep_leica01.txt:39",
   "file": "ep_leica01.txt",
   "line": 39,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ちょうどカーテンの隙間から差す朝陽に目が眩んだ。",
   "ko_candidate": "마침 커튼 틈새로 들어오는 아침 햇살에 눈이 부셨다｡"
  },
  {
   "id": 49676,
   "key": "ep_leica01.txt:43",
   "file": "ep_leica01.txt",
   "line": 43,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ライカ姉ちゃーん！ 朝ごはーん！ おなかすいたー！」",
   "ko_candidate": "「라이카 누나~! 아침밥~! 배고파~!」"
  },
  {
   "id": 49677,
   "key": "ep_leica01.txt:48",
   "file": "ep_leica01.txt",
   "line": 48,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "朝陽から逃げつつ、時計を確認する。",
   "ko_candidate": "아침 햇살을 피하면서 시계를 확인한다｡"
  },
  {
   "id": 49678,
   "key": "ep_leica01.txt:49",
   "file": "ep_leica01.txt",
   "line": 49,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "うわぁ、もうこんな時間。",
   "ko_candidate": "우와､ 벌써 이런 시간이네｡"
  },
  {
   "id": 49679,
   "key": "ep_leica01.txt:50",
   "file": "ep_leica01.txt",
   "line": 50,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確かにいろいろと急がないと。",
   "ko_candidate": "확실히 여러모로 서둘러야겠어｡"
  },
  {
   "id": 49680,
   "key": "ep_leica01.txt:54",
   "file": "ep_leica01.txt",
   "line": 54,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「ごめんね――っ。 すぐ準備するから、 もう少し待っていてねえ――っ」",
   "ko_candidate": "「미안해~｡ 금방 준비할 테니까､ 조금만 더 기다려 줘~」"
  },
  {
   "id": 49681,
   "key": "ep_leica01.txt:60",
   "file": "ep_leica01.txt",
   "line": 60,
   "speaker": "ジョージ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うー、早く来てよー！」",
   "ko_candidate": "「으~､ 빨리 와~!」"
  },
  {
   "id": 49682,
   "key": "ep_leica01.txt:65",
   "file": "ep_leica01.txt",
   "line": 65,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "ジョージが扉から遠ざかるのを、足音に聴いた。",
   "ko_candidate": "조지가 문에서 멀어지는 걸 발소리로 들었다｡"
  },
  {
   "id": 49683,
   "key": "ep_leica01.txt:66",
   "file": "ep_leica01.txt",
   "line": 66,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "さて、本当に慌てないと。",
   "ko_candidate": "자､ 정말로 서둘러야겠어｡"
  },
  {
   "id": 49684,
   "key": "ep_leica01.txt:68",
   "file": "ep_leica01.txt",
   "line": 68,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "お布団をどけようとして……抱きしめているのが、",
   "ko_candidate": "이불을 치우려고 하다가… 내가 안고 있는 게 그 이불"
  },
  {
   "id": 49685,
   "key": "ep_leica01.txt:69",
   "file": "ep_leica01.txt",
   "line": 69,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "その布団であることに気付く。",
   "ko_candidate": "이라는 걸 깨닫는다｡"
  },
  {
   "id": 49686,
   "key": "ep_leica01.txt:70",
   "file": "ep_leica01.txt",
   "line": 70,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "枕は遠くの床に転がっていた。",
   "ko_candidate": "베개는 멀리 바닥에 굴러 떨어져 있었다｡"
  },
  {
   "id": 49687,
   "key": "ep_leica01.txt:72",
   "file": "ep_leica01.txt",
   "line": 72,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "パジャマの胸元は盛大に肌蹴ているし、そもそも下半身にはパンツしか履いてない。",
   "ko_candidate": "파자마 가슴팍은 크게 벌어져 있고､ 애초에 하반신에는 팬티밖에 안 입고 있다｡"
  },
  {
   "id": 49688,
   "key": "ep_leica01.txt:74",
   "file": "ep_leica01.txt",
   "line": 74,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……パジャマのズボンは、頭に被っていた。",
   "ko_candidate": "……파자마 바지는 머리에 뒤집어쓰고 있었다｡"
  },
  {
   "id": 49689,
   "key": "ep_leica01.txt:76",
   "file": "ep_leica01.txt",
   "line": 76,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まったく……我ながら、どんな寝相なんだか。",
   "ko_candidate": "정말…… 내 자신도 어떤 잠버릇인지 모르겠어｡"
  },
  {
   "id": 49690,
   "key": "ep_leica01.txt:77",
   "file": "ep_leica01.txt",
   "line": 77,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "寝相の悪さだけは、一向に直りそうもない。",
   "ko_candidate": "잠버릇의 나쁨만큼은 좀처럼 고쳐질 것 같지 않아｡"
  },
  {
   "id": 49691,
   "key": "ep_leica01.txt:78",
   "file": "ep_leica01.txt",
   "line": 78,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "お嫁さんの貰い手がないかも……しくしく。",
   "ko_candidate": "신부감으로 안 받아줄지도…… 훌쩍훌쩍｡"
  },
  {
   "id": 49692,
   "key": "ep_leica01.txt:80",
   "file": "ep_leica01.txt",
   "line": 80,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "――とか、 独りで泣き真似なんかしてふざけていたら、",
   "ko_candidate": "――이런 식으로 혼자서 울상 짓는 척하며 장난치고 있었는데､"
  },
  {
   "id": 49693,
   "key": "ep_leica01.txt:85",
   "file": "ep_leica01.txt",
   "line": 85,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「……あれ？」",
   "ko_candidate": "「……어라?」"
  },
  {
   "id": 49694,
   "key": "ep_leica01.txt:88",
   "file": "ep_leica01.txt",
   "line": 88,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "両頬が濡れていることに気付いた。",
   "ko_candidate": "양 볼이 젖어 있다는 걸 깨달았다｡"
  },
  {
   "id": 49695,
   "key": "ep_leica01.txt:89",
   "file": "ep_leica01.txt",
   "line": 89,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "鏡を覗き込むと、目も真っ赤だった。",
   "ko_candidate": "거울을 들여다보니 눈도 새빨개져 있었다｡"
  },
  {
   "id": 49696,
   "key": "ep_leica01.txt:91",
   "file": "ep_leica01.txt",
   "line": 91,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "……泣いてたの、私？",
   "ko_candidate": "……울고 있었던 거야､ 나?"
  },
  {
   "id": 49697,
   "key": "ep_leica01.txt:95",
   "file": "ep_leica01.txt",
   "line": 95,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……どうして？」",
   "ko_candidate": "「……왜지?」"
  },
  {
   "id": 49698,
   "key": "ep_leica01.txt:98",
   "file": "ep_leica01.txt",
   "line": 98,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何か悲しい夢でも見ていたんだろうか？",
   "ko_candidate": "뭔가 슬픈 꿈이라도 꿨나?"
  },
  {
   "id": 49699,
   "key": "ep_leica01.txt:99",
   "file": "ep_leica01.txt",
   "line": 99,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "でも、よく思い出せない。",
   "ko_candidate": "하지만 잘 기억이 나지 않아｡"
  },
  {
   "id": 49700,
   "key": "ep_leica01.txt:101",
   "file": "ep_leica01.txt",
   "line": 101,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "確かに…… 色んな夢を見ていたような気もするけど……",
   "ko_candidate": "분명…… 여러 가지 꿈을 꾼 것 같기도 한데……"
  },
  {
   "id": 49701,
   "key": "ep_leica01.txt:106",
   "file": "ep_leica01.txt",
   "line": 106,
   "speaker": "ライカ",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「あれ？」",
   "ko_candidate": "「어라?」"
  },
  {
   "id": 49702,
   "key": "ep_leica01.txt:109",
   "file": "ep_leica01.txt",
   "line": 109,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "まただ。",
   "ko_candidate": "또다｡"
  },
  {
   "id": 49703,
   "key": "ep_leica01.txt:111",
   "file": "ep_leica01.txt",
   "line": 111,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "また、ほろりと涙が頬を伝う。",
   "ko_candidate": "또 눈물이 볼을 타고 흐른다｡"
  },
  {
   "id": 49704,
   "key": "ep_leica01.txt:112",
   "file": "ep_leica01.txt",
   "line": 112,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "何故だか、自分でも分からない。",
   "ko_candidate": "왜인지 나 자신도 모르겠어｡"
  },
  {
   "id": 49705,
   "key": "ep_leica01.txt:113",
   "file": "ep_leica01.txt",
   "line": 113,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "だけど涙は次々と、止め処なく零れ落ちてくる。",
   "ko_candidate": "하지만 눈물은 계속해서 멈출 줄 모르고 흘러내린다｡"
  },
  {
   "id": 49706,
   "key": "ep_leica01.txt:117",
   "file": "ep_leica01.txt",
   "line": 117,
   "speaker": "ライカ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「どうして？　どうして？」",
   "ko_candidate": "「왜지? 왜지?」"
  },
  {
   "id": 49707,
   "key": "ep_leica01.txt:120",
   "file": "ep_leica01.txt",
   "line": 120,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "何か……胸にぽっかりと穴の開いたような、 喪失感がある。",
   "ko_candidate": "뭔가…… 가슴에 구멍이 뻥 뚫린 것 같은 상실감이 있어｡"
  },
  {
   "id": 49708,
   "key": "ep_leica01.txt:122",
   "file": "ep_leica01.txt",
   "line": 122,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "自分の気持ちを抑えることが出来ない。 理由も分からず、",
   "ko_candidate": "내 감정을 억누를 수가 없어｡"
  }
 ]
}