 },
 "trusted": true,
 "note": "앵커 일치율이 높은 씬. status=OK 는 대체로 맞다.",
 "glossary": {
  "アーミティッジ": "아미티지",
  "ウィルバー・ウェイトリイ": "윌버 웨이틀리"
 },
 "items": [
  {
   "id": 32686,
   "key": "D1305ru.txt:453",
   "file": "D1305ru.txt",
   "line": 453,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "３メートルに届こうかという巨体が、膿と粘液の溜まりに横たわった。",
   "ko_candidate": "3미터에 달할 듯한 거대한 몸이 고름과 점액의 웅덩이에 누워있었다｡"
  },
  {
   "id": 32687,
   "key": "D1305ru.txt:454",
   "file": "D1305ru.txt",
   "line": 454,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "獣に噛み千切られ、息も絶え絶えに、音も無く痙攣する。",
   "ko_candidate": "짐승에게 물어뜯겨､ 숨이 끊어질 듯 소리 없이 경련하고 있다｡"
  },
  {
   "id": 32688,
   "key": "D1305ru.txt:456",
   "file": "D1305ru.txt",
   "line": 456,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺はその手前で、腰を抜かして座り込んでいた。",
   "ko_candidate": "나는 그 앞에서 허리가 빠져 주저앉아 있었다｡"
  },
  {
   "id": 32689,
   "key": "D1305ru.txt:458",
   "file": "D1305ru.txt",
   "line": 458,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "いつの間にか失禁していたらしい。股間がぬれて、床に水溜まりが広がっていた。",
   "ko_candidate": "어느새 실금을 했는지 가랑이가 젖어 바닥에 물웅덩이가 퍼져 있었다｡ 움직일 수 없다｡"
  },
  {
   "id": 32690,
   "key": "D1305ru.txt:460",
   "file": "D1305ru.txt",
   "line": 460,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "動けない。 声も出ない。",
   "ko_candidate": "목소리도 나오지 않는다｡"
  },
  {
   "id": 32691,
   "key": "D1305ru.txt:462",
   "file": "D1305ru.txt",
   "line": 462,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ちょっとでも身じろぎしたら、音を立ててしまったら、俺の中の何かが壊れてしまいそうだった。",
   "ko_candidate": "조금이라도 몸을 움직이거나 소리를 내면､ 내 안의 무언가가 부서질 것만 같았다｡"
  },
  {
   "id": 32692,
   "key": "D1305ru.txt:465",
   "file": "D1305ru.txt",
   "line": 465,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "外が、酷く五月蝿い。",
   "ko_candidate": "밖이 몹시 시끄럽다｡"
  },
  {
   "id": 32693,
   "key": "D1305ru.txt:467",
   "file": "D1305ru.txt",
   "line": 467,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "鳥が啼いている。",
   "ko_candidate": "새가 울고 있다｡"
  },
  {
   "id": 32694,
   "key": "D1305ru.txt:468",
   "file": "D1305ru.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "あの忌まわしい夜鷹が、ウィップアーウィルが、けたたましく啼いている。",
   "ko_candidate": "그 불길한 밤매가､ 휘푸어윌이､ 귀청이 터질 듯이 울어"
  },
  {
   "id": 32695,
   "key": "D1305ru.txt:468",
   "file": "D1305ru.txt",
   "line": 468,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "死にかけの化け物の呼吸に合わせて、不気味に唄っている。",
   "ko_candidate": "대고 있다｡ 죽어가는 괴물의 숨소리에 맞춰 불길하게 노래하고 있다｡"
  },
  {
   "id": 32696,
   "key": "D1305ru.txt:470",
   "file": "D1305ru.txt",
   "line": 470,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "騒ぎを聞きつけた大学の関係者が、図書館に飛び込んできた。",
   "ko_candidate": "소란을 듣고 대학 관계자들이 도서관으로 뛰어들어왔다｡"
  },
  {
   "id": 32697,
   "key": "D1305ru.txt:471",
   "file": "D1305ru.txt",
   "line": 471,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "アーミティッジの爺さんもいる。",
   "ko_candidate": "아미티지 할아버지도 있다｡"
  },
  {
   "id": 32698,
   "key": "D1305ru.txt:473",
   "file": "D1305ru.txt",
   "line": 473,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "爺さんは倒れる化け物を見て、震える声で呟いた。",
   "ko_candidate": "할아버지는 쓰러진 괴물을 보고 떨리는 목소리로 중얼거렸다｡"
  },
  {
   "id": 32699,
   "key": "D1305ru.txt:477",
   "file": "D1305ru.txt",
   "line": 477,
   "speaker": "アーミティッジ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「ウィルバー・ウェイトリイ……！」",
   "ko_candidate": "「윌버 웨이틀리…!」"
  },
  {
   "id": 32700,
   "key": "D1305ru.txt:480",
   "file": "D1305ru.txt",
   "line": 480,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そいつが、この化け物の名前。",
   "ko_candidate": "그게 이 괴물의 이름｡"
  },
  {
   "id": 32701,
   "key": "D1305ru.txt:481",
   "file": "D1305ru.txt",
   "line": 481,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人間の世界を侵す、怪異のおぞましい名前。",
   "ko_candidate": "인간 세계를 침범하는､ 괴이의 끔찍한 이름｡"
  },
  {
   "id": 32702,
   "key": "D1305ru.txt:485",
   "file": "D1305ru.txt",
   "line": 485,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「……ァ……ァァ……」",
   "ko_candidate": "「…아…아아…」"
  },
  {
   "id": 32703,
   "key": "D1305ru.txt:488",
   "file": "D1305ru.txt",
   "line": 488,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "死にかけの化け物の口から、呟きが洩れた。",
   "ko_candidate": "죽어가는 괴물의 입에서 중얼거림이 새어 나왔다｡"
  },
  {
   "id": 32704,
   "key": "D1305ru.txt:490",
   "file": "D1305ru.txt",
   "line": 490,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "俺も、爺さんも思わず、身体をビクつかせてしまう。",
   "ko_candidate": "나도､ 할아버지도 무심코 몸을 움찔거리고 말았다｡"
  },
  {
   "id": 32705,
   "key": "D1305ru.txt:492",
   "file": "D1305ru.txt",
   "line": 492,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "化け物の呟きは、やはり人間の言葉ではなかった。",
   "ko_candidate": "괴물의 중얼거림은 역시 인간의 말이 아니었다｡"
  },
  {
   "id": 32706,
   "key": "D1305ru.txt:493",
   "file": "D1305ru.txt",
   "line": 493,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "人間以外の世界の、地球以外の何処かの、断絶された異界の言葉だった。",
   "ko_candidate": "인간 이외의 세계의､ 지구 이외의 어딘가의､ 단절된 이계의 말이었다｡"
  },
  {
   "id": 32707,
   "key": "D1305ru.txt:495",
   "file": "D1305ru.txt",
   "line": 495,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "そうに決まっている。",
   "ko_candidate": "그럴 수밖에 없다｡"
  },
  {
   "id": 32708,
   "key": "D1305ru.txt:496",
   "file": "D1305ru.txt",
   "line": 496,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "そうじゃなきゃいけない。",
   "ko_candidate": "그래야만 한다｡"
  },
  {
   "id": 32709,
   "key": "D1305ru.txt:500",
   "file": "D1305ru.txt",
   "line": 500,
   "speaker": "ウィルバー・ウェイトリイ",
   "kind": "say",
   "status": "CHECK",
   "work": true,
   "jp": "「んがいんぐあぐああぶぐ、しょごぐいはあぁ……よおうぐそととよおうぐそとと」",
   "ko_candidate": "「은가이은가아그아아부그､ 쇼그그이하아아… 요오그소토토요오그소토토」 목소리가 점점 가늘어져 간다｡"
  },
  {
   "id": 32710,
   "key": "D1305ru.txt:503",
   "file": "D1305ru.txt",
   "line": 503,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "声がだんだん、か細くなってゆく。",
   "ko_candidate": "그에 반비례하듯이､ 밖의 휘푸어윌들이 날카로운"
  },
  {
   "id": 32711,
   "key": "D1305ru.txt:506",
   "file": "D1305ru.txt",
   "line": 506,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "それに反比例するように、外のウィップアーウィルたちが、甲高い啼き声をさらに不快に高めてゆく。",
   "ko_candidate": "울음소리를 더욱 불쾌하게 높여간다｡"
  },
  {
   "id": 32712,
   "key": "D1305ru.txt:509",
   "file": "D1305ru.txt",
   "line": 509,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――喘ぎが止まった。",
   "ko_candidate": "――숨소리가 멈췄다｡"
  },
  {
   "id": 32713,
   "key": "D1305ru.txt:510",
   "file": "D1305ru.txt",
   "line": 510,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "――啼き声も止んだ。",
   "ko_candidate": "――울음소리도 멈췄다｡"
  },
  {
   "id": 32714,
   "key": "D1305ru.txt:513",
   "file": "D1305ru.txt",
   "line": 513,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "豪雨のような、翼のはためき。",
   "ko_candidate": "폭우 같은 날개 소리｡"
  },
  {
   "id": 32715,
   "key": "D1305ru.txt:514",
   "file": "D1305ru.txt",
   "line": 514,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "ウィップアーウィルが一斉に羽ばたいた。",
   "ko_candidate": "휘푸어윌이 일제히 날갯짓했다｡ 창밖이 어두워진다｡"
  },
  {
   "id": 32716,
   "key": "D1305ru.txt:515",
   "file": "D1305ru.txt",
   "line": 515,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "窓の外が暗くなる。",
   "ko_candidate": "달을 가리는 암흑의 구름｡"
  },
  {
   "id": 32717,
   "key": "D1305ru.txt:517",
   "file": "D1305ru.txt",
   "line": 517,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "月を覆い隠す、闇黒の雲。",
   "ko_candidate": "휘푸어윌 무리｡ 시선을 느낀다｡"
  },
  {
   "id": 32718,
   "key": "D1305ru.txt:518",
   "file": "D1305ru.txt",
   "line": 518,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "ウィップアーウィルの群れ。",
   "ko_candidate": "아미티지 할아버지의 것이 아니다｡"
  },
  {
   "id": 32719,
   "key": "D1305ru.txt:520",
   "file": "D1305ru.txt",
   "line": 520,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "視線に気付く。 アーミティッジの爺さんのじゃない。",
   "ko_candidate": "할아버지는 더러운､ 방금 전에 시체가 되어버린 누워있는 괴물에서"
  },
  {
   "id": 32720,
   "key": "D1305ru.txt:522",
   "file": "D1305ru.txt",
   "line": 522,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "爺さんは、汚怪な、たった今、屍と成り果てた横たわる化け物から目が離せないでいる。",
   "ko_candidate": "눈을 떼지 못하고 있다｡"
  },
  {
   "id": 32721,
   "key": "D1305ru.txt:524",
   "file": "D1305ru.txt",
   "line": 524,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狗だ。",
   "ko_candidate": "개다｡"
  },
  {
   "id": 32722,
   "key": "D1305ru.txt:525",
   "file": "D1305ru.txt",
   "line": 525,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "真っ黒な狗が居た。",
   "ko_candidate": "새까만 개가 있었다｡"
  },
  {
   "id": 32723,
   "key": "D1305ru.txt:526",
   "file": "D1305ru.txt",
   "line": 526,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "大学で飼っている番犬だろうか？",
   "ko_candidate": "대학에서 기르는 번견일까?"
  },
  {
   "id": 32724,
   "key": "D1305ru.txt:527",
   "file": "D1305ru.txt",
   "line": 527,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "……こんな犬、居ただろうか？",
   "ko_candidate": "…이런 개가 있었던가?"
  },
  {
   "id": 32725,
   "key": "D1305ru.txt:529",
   "file": "D1305ru.txt",
   "line": 529,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": false,
   "jp": "狗は、俺を凝っと見つめている。",
   "ko_candidate": "개는 나를 뚫어지게 쳐다보고 있다｡"
  }
 ]
}