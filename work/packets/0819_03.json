  {
   "id": 17358,
   "key": "D0819le.txt:568",
   "file": "D0819le.txt",
   "line": 568,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "無限の熱量が解き放たれる。",
   "ko_candidate": "무한한 열량이 풀려난다｡"
