  },
  {
   "id": 17344,
   "key": "D0819le.txt:534",
   "file": "D0819le.txt",
   "line": 534,
   "speaker": "九郎",
   "kind": "say",
   "status": "OK",
   "work": true,
   "jp": "「うおおおおおおおおおおおおお！」",
   "ko_candidate": "「우오오오오오오오오오오오오오!」"
  },
  {
   "id": 17345,
   "key": "D0819le.txt:537",
   "file": "D0819le.txt",
   "line": 537,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "一撃必滅の意味を与えられた術式が、 右掌の魔術回路を高速で駆け巡る。",
   "ko_candidate": "일격필멸의 의미를 부여받은 술식이､ 오른손바닥의 마술 회로를 고속으로 달린다｡"
  },
  {
   "id": 17346,
   "key": "D0819le.txt:540",
   "file": "D0819le.txt",
   "line": 540,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "紋様を浮かび上がらせ、 魔力の光を纏わせ、空間を灼く。",
   "ko_candidate": "문양을 떠오르게 하고､ 마력의 빛을 두르고､ 공간을 태운다｡"
  },
  {
   "id": 17347,
   "key": "D0819le.txt:543",
   "file": "D0819le.txt",
   "line": 543,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "吼える。",
   "ko_candidate": "포효한다｡"
  },
  {
   "id": 17348,
   "key": "D0819le.txt:544",
   "file": "D0819le.txt",
   "line": 544,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "吼える吼える吼える！",
   "ko_candidate": "포효하고 포효하고 포효한다!"
  },
  {
   "id": 17349,
   "key": "D0819le.txt:546",
   "file": "D0819le.txt",
   "line": 546,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "臨界まで稼動する鋼鉄の咆吼。 臨界まで疾走する魔力の咆吼。",
   "ko_candidate": "임계까지 가동하는 강철의 포효｡ 임계까지 질주하는 마력의 포효｡"
  },
  {
   "id": 17350,
   "key": "D0819le.txt:549",
   "file": "D0819le.txt",
   "line": 549,
   "speaker": null,
   "kind": "narr",
   "status": "CHECK",
   "work": true,
   "jp": "昇華に充分な力が右掌に蓄えられたとき、 既にネームレス・ワンは間合いの中に居た。",
   "ko_candidate": "승화에 충분한 힘이 오른손바닥에 축적되었을 때､ 이미 네임리스 원은 간격 안에 있었다｡"
  },
  {
   "id": 17351,
   "key": "D0819le.txt:551",
   "file": "D0819le.txt",
   "line": 551,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "そして――",
   "ko_candidate": "그리고――"
  },
  {
   "id": 17352,
   "key": "D0819le.txt:556",
   "file": "D0819le.txt",
   "line": 556,
   "speaker": "エンネア",
   "kind": "say",
   "status": "OK",
   "work": true,
