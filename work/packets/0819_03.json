   "key": "D0819le.txt:609",
   "file": "D0819le.txt",
   "line": 609,
   "speaker": null,
   "kind": "narr",
   "status": "OK",
   "work": true,
   "jp": "確実にその存在を灼き尽くされ、消し尽くされる。",
   "ko_candidate": "확실히 그 존재가 불태워지고､ 지워진다｡"
